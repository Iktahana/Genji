        "examples": {
          "standard": [
            {
              "text": "SNSでは打ち言葉特有の省略表現がよく使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "メールで相手に送る際は、打ち言葉の表現に注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼のチャットは打ち言葉で満ちあふれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そうして聞く方でも一々表情で相槌を打ち言葉の内容通りの顔をするから、女と女の話は聾が見ていても筋だけは分るそうだ。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
