    "definitions": [
      {
        "index": 1,
        "gloss": "year of one's birth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖父の生まれ年に仕込まれたワインを、還暦の祝いに家族でそっと開けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "履歴書には生まれ年と生まれ月日を正確に記入する欄がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼の生まれ年は戦争が終わった翌年で、激動の時代の幕開けでもあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "気候の変化が人間の生理にも若干の影響があるかもしれないとすると、それが胎児の特異性に多少の効果を印銘することが全然ないとも限らないし、そうなると生まれ年の干支とその人の特性とが、少なくもある期間については多少の相関を示す場合がないとも言われないような気がして来るのである。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お金は帰りにここへも寄って、外記の生まれ年月をいって判断を頼んだ。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はい、若いおかみさんの生まれ年を知っていますので……」「生まれ年……」「親分さんの前ですから申し上げますが、おかみさんは生まれた年を隠しているのでございます」と、かれは思い切ったように云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "松茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで表向きは先ず巳年で通るのであるが、土地の者は皆ほんとうの生まれ年を知っているので、親たちもいろいろに心配して、結局その嫁入り先を、遠い江戸に求めたのであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "松茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして文永四年の八十二歳まで生き、歿年から逆算すると、生まれ年は、ちょうど、文治二年静が鎌倉へ召された年に当り、その点、全く符合する。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御亭主が暦を披いて十干十二支を調べながら産婦に対つて、「丁度好い日だぞ上何で生れ年月の如何に因りませう。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "九日　また雨（水）ホテルへ行ってフランス語一時食事ペレールで　　　女中兎を出す　このひとの生れ年だからいやなの寿江子の兄への感情夕飯二人　　　〔欄外に〕九時前に Gold Rush を見る　　　　十日　降るみ降らずみ。",
              "citation": {
                "source": "「道標」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あら本当よ、この間夜いらしった時だって雨だったわ――何の生れ年？",
              "citation": {
                "source": "九月の或る日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただスエ子が　このひとの生れ年だから何だかいやなの。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまた生れ年は勿論、名前を書いた紙もついていない。",
              "citation": {
                "source": "捨児",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "このひとの生れ年だから、いやだ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御生れ年も御存知かな？",
              "citation": {
                "source": "奇怪な再会",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "更級日記の作者は、あんな風だつたけれども、よい事には、生れ年が訣つてゐる。",
              "citation": {
                "source": "『かげろふの日記』解説",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "繁女の生れ年は知れない。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、私の運勢をみていただけましょうか」「まず、お生れ年と、月日を」「本年三十二歳、甲子ノ年、乙丑ノ月、丙寅ノ日、丁卯ノ時刻に生れました。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "芦屋の福渡竜氏は私と同じ村、しかも家が近く親類の続きでもあるのだが、僅か二十年足らずの生れ年のちがいの為に、今まではまるで知らずにいた。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうか長く一族の好誼をむすんで下さい」　と、兄弟の盃を乞い、なお生れ年をたずねたりした。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
