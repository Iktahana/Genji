        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コノ問題ハ活字ト関係ガナサソウデアルガ、原稿ヲ書ク場合ニ関係ガ生ジテクルノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚人々ノ話ヲ綜合スルト田中町小學校ニ旋風ガ發シタト云ハレ、又今戸公園ニ旋風ガ襲ツタトキ待乳山邊迄大イニ荒レタサウデアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ観ルトコロデハ、実際、彼等ハ愉快サウデアル。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「陸子ガ何カオ爺チャンニオ願イガアルンデスッテ」陸子ノオ願イト云ウノハコウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日虎ノ門病院デ断層写真ヲ撮ラレタ時、癌カモ知レナイト云ワレテ附添ノ婆サンヤ看護婦ハ色ヲ失ッタヨウデアルガ、予ハマッタク平気ダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ顔ノ女ヲ見ルト、顔ダケデナク、性質モ残虐デアルカノヨウニ思イ、又ソウデアルコトヲ希望スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ幸イニ一時快方ニ向ッテイタノダガ、昨夜ノ失敗デ又ブリ返シタヨウデアルカラ、当分用心シタ方ガイヽ、シノミンハ餘リ連用スルト副作用ガアルカラ一回四錠ズツ日ニ三回、三日以上ハ続ケナイデ下サイ、毎朝怠ラズ尿ノ検査ヲシ、雑菌ガアッタラ、ウバウルシヲオ飲ミナサイト云ワレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスルト颯子ノタメニイロ／＼ト好都合ナコトガ起リソウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ家ノ経済ハ彼モ幾分カ負担シテイルヨウデアルガ、依然トシテ大部分ハ予ノ不動産所得ト配当所得ニ依ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ト二人キリノ時ニモ、嘗テ愛情コマヤカナリシ時代ニハソンナ風ダッタデアロウガ、今デハソウデモナサソウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ書ハ昔或ル美術商カラ手ニ入レタモノダガ、荷風ノ書ハ非常ニ偽筆ヲ上手ニ書ク男ガイタソウデアルカラ、コノ幅モ真偽ハサダカデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手ハ又今夜アタリカラ痛ミ出スニ決マッテイル、―――痛ミ出スノヲ期待シテイルヨウデアルガ、―――ソノ最モ痛イ時ヲ狙ッテ颯子ヲ呼ビ入レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ僕ノ嫉妬カラソンナ風ニ気ガ廻ルノカト思ッテ、ソノ考エヲ努メテ打チ消シテイタノデアルガ、ヤハリソウデハナサソウデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来古風ナ身ナリガ好キデ、当世風ノ流行ヲ追ウデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
