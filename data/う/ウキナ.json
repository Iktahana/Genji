    },
    "definitions": [
      {
        "index": 1,
        "gloss": "rumour (of a love affair)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の浮き名をまた聞きした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "有名な俳優には常に浮き名がつきまとう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "浮き名を立てられて、本人は困っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「お母様の御息所はきわめて聡明な人だったのですが、私の若気のあやまちから浮き名を流させることになりました上、私は一生恨めしい者と思われることになったのですが、私は心苦しく思っているのでございます。",
              "citation": {
                "source": "源氏物語",
                "author": "澪標",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらは権田原心中の浮き名を流す機会を失って、おめおめと庄太に追い立てられて行った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "青山の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "その紅い口びるを吸わして首席を占めたんだと、厳格で通っている米国人の老校長に、思いもよらぬ浮き名を負わせたのも彼女である。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがもとになって浮き名を立てることになり、私との関係をにがい経験だったように思って、くやしがったままで亡くなられたが、必ずしもそうではなかったのだ。",
              "citation": {
                "source": "源氏物語",
                "author": "梅が枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日までは尊貴な親の娘として尊敬されていた人が、つまらぬ男にだまされて浮き名を立て、ある者は死んだ親の名誉をそこなうという類の話は幾つもあるから、姫宮であっても女であれば同じことで、宿命などということはことにわからぬものだから、私が配偶者を選ばずに捨てておくことは不安だとも一方では考えられる。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            },
            {
              "text": "神聖な方としてお守り立てしていきたかった宮様も、世間の女並みに浮き名を立てられておしまいになることがもってのほかに思われてならなかった。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は不断ごく慎ましくて、幸いに只の一度もそんな浮き名を立てられたことがなかったけれど、今度はけちがつくだろうと思って、慄然としました。",
              "citation": {
                "source": "麻酔剤",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺が酒を飲まんことは、母上も知っておるはずじゃが、なぜ酒をくだされたろう」「何時も貴方がお堅くしておられますから、すこしは、浮うきなされるようにと、それで奥様からくだされたものでございましょう」　婢はこう云いながら盃を持ってそれを平三郎の前へだした。",
              "citation": {
                "source": "水面に浮んだ女",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "波のうえにうきながら、おねえさまたちは、かなしそうにうたいました。",
              "citation": {
                "source": "人魚のひいさま",
                "author": "DEN LILLE HAVFRUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど、にんげんが、ずつうでくるしむように、木にとっては、このかわのいたいのは、かなりこまるびょうきなのでした。",
              "citation": {
                "source": "もみの木",
                "author": "GRANTRAEET",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ちやんと、小ちやい子は、びようきなんだもの。",
              "citation": {
                "source": "乞食の子",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへかおを出したお妙ちゃんは、「マアマアほんまにようきなはった早う御上り、まってたのやから」こう云って私の手をひっぱった。",
              "citation": {
                "source": "ひな勇はん",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恨みなはてぞ世の運命、無限の未來後にひき無限の過去を前に見て我いまこゝに惑ありはたいまこゝに望あり、笑、たのしみ、うきなやみ暗と光と織りなして歌ふ浮世の一ふしもいざ響かせむ暮の鐘、先だつ魂に、來ん魂にかくて思をかはしつゝ流一筋大川の泉と海とつなぐごと。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひこうきなかまは、ぼくのかおをみて、ぶじにかえってきたことをよろこんでくれた。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、もうきなさる時分だよ。",
              "citation": {
                "source": "二番めの娘",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポケット小僧は、手さぐりで、それにつかまり、足をはなして、水にうきながら、井上君のからだに、だきつきました。",
              "citation": {
                "source": "怪人と少年探偵",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "みどり色の手が、ぜんぶあらわれると、つぎには、むらさきとみどりと黄色の、ふといしまになった肩が見え、それから、れいのぶきみな大トカゲのからだが、水の中にフラフラうきながら、あらわれました。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る時、沢庵は三斎から蓮花を贈られて、うきなからあはれことしの花もみつ　これも蓮のいけるかひかな　と詠んだ。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見る目は人の咎にして、有るまじき事と思ひながらも、立ちし浮名の消ゆる時なくば、可惜白玉の瑕に成りて、其身一生の不幸のみか、あれ見よ伯母そだてにて投げやりなれば、薄井の娘が不品行さ、両親あれば彼の様にも成らじ物と、云ひたきは人の口ぞかし、思ふも涙は其方が母、臨終の枕に我れを拝がみて。",
              "citation": {
                "source": "雪の日",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「派手な浮名が嬉しうて」の言葉でもわかる。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、日が経つに従うて、見もせず聞きもせぬけれど、浮名が立って濡衣着た、その明さんが何となく、慕わしく、懐かしく、果は恋しく、憧憬れる。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "藍染川と、忍川の、晴れて逢っても浮名の流れる、茅町あたりの借屋に帰って、吉原がえりの外套を、今しがた脱いだところ。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "月夜の利左という浮名を流し、それこそ男振りはよし、金はあり、この三粋人と共に遊んで四天王と呼ばれ、数年前に吉州という評判の名妓を請出し、ふっと姿をかくした利左衛門、それが、まさか、と思えども見れば見るほど、よく似ている。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花婿姿の紋服を着てお茶屋へも行き嘗てわたしと浮名を謡われ、而かもわたしを直ぐ袖にしてしまった商売女にそれを見せつけてもやりたい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の毒に、その婿は放蕩者で家を外に四谷、赤坂と浮名を流して廻った。",
              "citation": {
                "source": "家霊",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一夜の縁のみならず、そこは、自分とあの人とがために浮名を流した、浜田の水の源ぞと聞くからに、顔を知らぬ許婚に初めて逢いに行く気もすれば、神仙の園へ招待されたようでもあって、いざ、立出づる門口から、早や天の一方に、蒼沼の名にし負う、緑の池の水の色、峰続きの松の梢に、髣髴として瑠璃を湛える。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "心中の命は卯辰山に消えたが、はかない魂は浮名とともに、城下の町を憚って、海づたいに波に流れたのかも知れません。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論深草を尋ねても鐙はなくって、片鐙の浮名だけが金八の利得になったのである。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論深草を尋ねても鐙は無くつて、片鐙の浮名だけが金八の利得になつたのである。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾て心にだに留めざりし人と、ゆくりなく浮名立てらるゝときは、その人はそもいかなる人にかと疑ふより、これに心付くるやうになり、心付けて見るに隨ひて、美しくもおもはれ慕はしくもおもはるゝことありと聞く。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
