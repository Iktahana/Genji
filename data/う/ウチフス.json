        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "疲れ果てた旅人は宿に着くやいなや、床に打ち伏した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "激しい腹痛に見舞われ、彼は畳の上に打ち伏したまま動けなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "悲しみに耐えかねた彼女はベッドに打ち伏して泣き崩れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
