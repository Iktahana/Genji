        "examples": {
          "standard": [
            {
              "text": "あまりに斬新すぎるデザインの広告は、年配の層には受けが悪かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冗談のつもりが、彼の毒舌はパーティーの参加者全員に受けが悪かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会議で一方的に自説を唱える彼の態度は、部下たちの間でも非常に受けが悪い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "見ろ、だから借金しないと、給料も上がらないし、受けが悪いじゃないか。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内で世間の評判を聞くと血達磨の九州旅行が最も受けが善くて、この徒歩旅行は最も受けが悪いようであった。",
              "citation": {
                "source": "徒歩旅行を読む",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも私は文部省の展覧会に反対をしたり、博士を辞したり、甚だ文部省に受けが悪い人間でありますが今度の文展も公には書きませんでしたが、どうも大変面白くありませんでした。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その仲間に入らないと受けが悪いから、相当の家の者共がみんないっぱしの貧窮人らしい面をして粥を食い歩く。",
              "citation": {
                "source": "大菩薩峠",
                "author": "市中騒動の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は目方が重いから、どこへ行っても車屋さんには受けが悪い。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
