        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ウオーッ」と唸る熊の声がした。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ「ウオーッ」と唸るだけであった。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウオーッ」と熊は初めて吠えた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウオーッ」と狼群も吠え声を上げた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウオーッという豹の吠え声がした。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "猛獣の群は塔を見上げ、ウオーッ、ウオーッと咆吼した。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウオーッ、ウオーッと侶を呼んだ。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして誘うようにウオーッと吠えた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしまた、今にも一声ウオーッと怒号して、函の中から躍り出しそうな気配にも見えた。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　叫ぶ声々が一つに集まり、ウオーッというような吠え声となった。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウオーッという群衆の吠え声が、その瞬間ひときわ高くなり、ムラムラと三人の犠牲者を、おっとり囲んだと見る間もなく、その一団は真ん丸となり、中へ三人の犠牲者を囲み、真ん丸のままで雑草の原を、一軒の廃屋の背後の方へ、一直線に縦断し出した。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂気したような群衆の叫びが、例のウオーッという吠え声となり、廃屋の蔭から上がったが、忽ち例の一団が、盆地へ姿を現わした。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山県大蔵が先頭に立ち、　ウオーッ！",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、たちまち、右手の藪がガサ／＼と音がしたので、急いで銃を取り直すひまもなく、いきなり目の前に、牡牛のやうな大きな羆があらはれ、後ろ脚でスクッと立上がり、まつかな口に、氷のやうな牙をあらはし、ウオーッと吼えました。",
              "citation": {
                "source": "熊捕り競争",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おりの中のクマが、いきなり、あと足で立ちあがって、まっかな口をひらいて、ウオーッとうなりました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、大グマは、前足でおりのとびらを、ガチャガチャいわせていましたが、またウオーッとうなって、大きなからだを、とびらにぶっつけたかとおもうと、それが、パッとひらいたのです。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "目にはガラスをはめ、口には牙をうえ、耳がぴんと立ち、いまにも、ウオーッとほえるのではないかと思われるほど、よくできています。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、いきなり長イスの上からとびおりると、ガッと、まっ赤な口を開いて、「ウオーッ。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからともなく、「ウオーッ。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴリラは「ウオーッ。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴリラのけらいたち　ゴリラは、勝ちほこったように立ちあがって、「ウオーッ、ウオーッ。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴリラは、それに答えるように、もう一度、「ウオーッ。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガアアッ、ウオーッ……。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからか、「ウオーッ……。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガア……ウオーッ……。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、一メートルほどに近よったかと思うと、「ウオーッ……。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつは、ノソノソと木のしげみから、はいだしてきて、ウオーッと、ものすごいうなり声をたてるのでした。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
