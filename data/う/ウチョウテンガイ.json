          "standard": [
            {
              "text": "彼の喜びぶりは有頂天外で、止まらない笑いが続いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その報告を聞いて、一同は有頂天外になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "合格発表の瞬間、受験生たちは有頂天外の喜びに包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "臍の下を住家として魂が何時の間にか有頂天外へ宿替をすれば、静かには坐ッてもいられず、ウロウロ座舗を徘徊いて、舌を吐たり肩を縮めたり思い出し笑いをしたり、又は変ぽうらいな手附きを為たりなど、よろずに瘋癲じみるまで喜びは喜んだが、しかしお勢の前ではいつも四角四面に喰いしばって猥褻がましい挙動はしない。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            }
          ]
        }
