          "literary": [
            {
              "text": "作家ドウシハ、片言満了。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お馬のお耳お馬のお耳は　何故長い青い草をたべたくつて　動くのよお馬にかねの靴　なぜはかすくろい爪がへるから　はかすのよお馬のお耳は　なぜ長い桶の水飲むから　ながいのよ黒ンぼと斑ンぼサキノ　ウシハクロンボアトノ　ウシハアメンボクロンボノツノトアメンボノツノトツノト　ツノトソロツタ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "一種ウシハコベという者がある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このウシハコベは金糸雀には遣らない。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の人はハコベもウシハコベも一緒にしてハコベと通称しているが、昔はまずそんな状態であって後世始めてこれを二種に区別したものであろう。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
