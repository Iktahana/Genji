        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "沖合から押し寄せてくる大きなうねりが、防波堤を激しく叩いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "サーファーたちは、遠くから近づいてくるうねりに期待を寄せている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "穏やかな海でも、深い場所からは時折力強いうねりが届くことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
