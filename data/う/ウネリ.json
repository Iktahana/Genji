    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何ものにも捉はれない野蛮人めいた狂暴無智の感情の大浪と、そのうねりくねる所の狂的なリズム。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪のうねりと白歯が見える。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間を、諏訪湖に、源を発した天竜河が、うねりくねって流れている。",
              "citation": {
                "source": "信濃の山女魚の魅力",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は大うねりに乗って、心持ちよく泳いで行く。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "波は、本船の船腹を蛇の泳ぐように、最高と最低との差を三間ぐらいに、うねりくねっていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒青い、大うねりのある海には、外には一｜艘の船もなかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きいうねりが絶えまなく起きては崩れている。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "波は絶え間なく、うねり、崩れる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "波のうねりも大きくなつて来て、海岸伝ひの細い路を歩いてゐる私たちの頬にしぶきがかかる。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦畑の麦の穂のうねりを見るたびごとに思い出す。",
              "citation": {
                "source": "玩具",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "提燈をもって、三百いくつの石の段々を、ひい、ふう、みい、と小声でかぞえながら降りていって、谷間の底の野天風呂にたどりつき、提燈を下に置いたら、すぐ傍を滔々と流れている谷川の白いうねりが見えて、古い水車がぼっと鼻のさきに浮んだ。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "提燈をもつて、三百いくつの石の段々を、ひい、ふう、みい、と小声でかぞへながら降りていつて、谷間の底の野天風呂にたどりつき、提燈を下に置いたら、すぐ傍を滔々と流れてゐる谷川の白いうねりが見えて、古い水車がぼつと鼻のさきに浮んだ。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、かれの歿したる直後に、この数行の文章に接し、はっと凝視し、再読、三読、さらに持ち直して見つめたのだが、どうにも眼が曇って、ついには、歔欷の波うねり、一字をも読む能わず、四つに折り畳んで、ふところへ、仕舞い込んだものであるが、内心、塩でもまれて焼き焦がされる思いであった。",
              "citation": {
                "source": "狂言の神",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "足あとは血を引いて、一町ばかり行って、そこで樹々の間を右に折れ、左に曲り、うねりうねってある白樺の下で全く途絶えていた。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒竜江は、どこまでも海のような豊潤さと、悠々さをたたえて、遠く、ザバイガル州と呼倫湖から、シベリアと支那との、国境をうねうねとうねり二千里に渡って流れていた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから水の澄み渡った小川がこの防風林の右の方からうねり出て屋敷の前を流れる。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし大洋のうねりのように高低起伏している。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には数百里も遠い大洋のまん中であばれている台風のために起こった波のうねりが、ここらの海岸まで寄せて来て、暴風雨の先ぶれをする事もあります。",
              "citation": {
                "source": "夏の小半日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は防波堤を掠めて、油を流したやうな穩かな海にうねりを殘しながら進んでゐた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "船と船とが行き合ふと、緩かな汽笛が響いて、よどんだ水がうねりとうねりの間でせせ笑ふやうに白い泡沫を立てたりした。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただきらきらと潮流に乘つて動いて行く浪のうねりが限りなく續いてゐる。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見渡せば、見まはせば、赤土の道幅せまく、うねりうねり果しなきに、両側つづきの躑躅の花、遠き方は前後を塞ぎて、日かげあかく咲込めたる空のいろの真蒼き下に、彳むはわれのみなり。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて目も、口も、鼻も、眉も、一様普通のものにてはこれなく、いづれも、ゆがみ、ひそみ、まがり、うねりなど仕り、なかには念入にて、酔狂にも、真赤な舌を吐かせたるが見え候。",
              "citation": {
                "source": "凱旋祭",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三度、陣痛のようにうねりの慄えが強く、彼女の指先から私の肩の肉に噛み込まれ、同時に、彼女から放射する電気のようなものを私は感じた。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くに寄せる浪のうねりは琅※の練りもののように、悠揚と伸び上って来ては、そこで青葉の丘のようなポーズをしばらく取り、容易には崩れない。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の裏側の若蔦の群は扉を横匍ひに匍ひ進み、崎と崎にせかれて、その間に干潮を急ぐ海流の形のやうでもあり、大きくうねりを見せて動いてゐる潮のやうでもある。",
              "citation": {
                "source": "蔦の門",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間ばかり前までカラカラに晴れ渡っていた空が、いつの間にか蒸し暑い灰色に掻き曇って来て、油を流したように光る大ウネリが水平線の処まで重なり合っている。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもバクゲキが終ると、まず穴から首をだして形勢を眺め、つづいて隣りの被害を見物し、規則正しい大きな波のウネリのようなバクダンの穴ボコの行列と、その四周の吹きとばされ、なぎ倒された家々のウネリと、壁や柱や屋根やハメ板のゴチャマゼの中の首や足などを見て歩く。",
              "citation": {
                "source": "もう軍備はいらない",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して大島に寄港した翌日からは、晝は中城貴族院議員の氣焔に聞入り、モンスーンの大ウネリに惱まされつゝ、夜は樂しかつた沖繩の旅に夢路を馳せた。",
              "citation": {
                "source": "沖繩の旅",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎　……今日は、だいぶウネリがある。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
