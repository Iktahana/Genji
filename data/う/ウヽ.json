        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然も、打たれた男に齒向いて、ウヽと爪を磨ぐのでない。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……一しきり、一しきり、たゞ、辛き息をつかせては、ウヽヽヽ、ヒユーとうなりを立てる。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつは、だれにでも、ウヽ／＼うなつてとびかゝります。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウヽ」と聲がしたので、電氣に打たれた樣に、全身の毛を逆立てた。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『失礼な事を申す様ですが……』『ウヽ……何故でせう？",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がホウヽホケキョとやると、隣の家のほうでもホウヽホケキョとやる。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親のない子は様子で知れるウ――、　　　　　指を銜へて門に立つウヽウ、」　平三が鎮守の森などに進んで居ると、お桐は妹のお夏を背負つて守しながら、よくこの当てつけた様な唄を子守唄の節で歌つた。",
              "citation": {
                "source": "厄年",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウヽ、芳賀君の今日あることを、わしは夙に知つとつた。",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウヽ、この中で、誰が第二の芳賀になる？",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "「見給え、こういうものさ」　酒のまわり始めたポリニャークは、テーブルに向ってかけている椅子の上で胸をはって上体を立て、顎をカラーの上にひきつけて、正面をにらみ、腕をそろそろと大きい曲線でもち上げながら、「ウーウ、ウウウウヽヽヽヽ」と、どこやら謡曲らしくなくもない太い呻声を発した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　狐は口を開けては遁げられると思ひますから、口を閉ぢたまゝで、「鶉のウヽウ……。",
              "citation": {
                "source": "孝行鶉の話",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あだねつき染め木が汁に染め　衣を……（シムルトコロノ衣シメタル衣）上つ毛野いかほの沼に栽ゑ　小水葱……（ウヽルトコロノ小水葱ウヱタル小水葱）右の例における接続点は、前代の文法及び、其形式を襲ふものでは問題にならないが、やはり次第に、整頓せられて来る。",
              "citation": {
                "source": "形容詞の論",
                "author": "――語尾「し」の発生――",
                "note": "青空文庫"
              }
            },
            {
              "text": "林「ウワー」　と悶掻く所を乗掛って、大「ウヽーン」　と突貫く、林藏は苦紛れに柄元へ手を掛けたなり、林「ウヽーン」　と息が止りました。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "織「ウヽーム」　と残念ながら大刀の柄へ手を掛けたまゝ息は絶えました。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "早「あゝ」　と悲鳴を上げるのを、ウヽーンと※りました。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸くお竹に水を飲ませ、頻りと介抱を致しましたが、中々｜烈しい事で、竹「ウヽーン」　と河原の中へ其の儘｜反かえりました。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "放善坊はイマイマしげに女中の後姿を睨んでいたが、「ウヽム。",
              "citation": {
                "source": "決戦川中島　上杉謙信の巻",
                "author": "――越後守安吾将軍の奮戦記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "街を歩いてゐる時は左程でもないが、自宅へ辿りつくとグッタリ疲れてしまふらしく、食堂の内部ではウヽウヽウヽと唸りで調子をとりながらうろつき廻り、新聞だの煙草だの部屋の中の離れた場所にあるものを取りに出掛けて行く時には、坐つた場所から這ひはじめて、又這ひ戻つてくるのである。",
              "citation": {
                "source": "孤独閑談",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウヽ廣瀬亭か」と言つて又一寸默つてゐたが「この先の四ツ角を右へ曲つて行くとすぐ右側」と餘所見をし乍ら低い聲で言ふ。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　妹は口を閉ぢたまゝ、喉でウヽンと云つて首を振つた。",
              "citation": {
                "source": "新婚旅行",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "師イヽかアヽラ、芸イ引イク、ウヽ、ウヽ、ウヽヽヽヽ……」「馬鹿ね」「ハッハヽヽヽ」　当時、銀太夫君は入門｜未だ日が浅かった。",
              "citation": {
                "source": "心のアンテナ",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その念を押し返してやると、　――ウヽムいゝ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
