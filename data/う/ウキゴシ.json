[
  {
    "uuid": "bf0e8263-0faa-58b2-ad4e-ef03f2324de6",
    "entry": "浮腰",
    "reading": {
      "primary": "うきごし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
