        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "道場で浮腰の練習を繰り返し、ようやく試合で使えるほど技が身についた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "体格差のある相手に浮腰を決め、会場から大きな歓声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "師範は「浮腰は腰の位置が命だ」と言って、弟子たちに正しい姿勢を繰り返し指導した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
