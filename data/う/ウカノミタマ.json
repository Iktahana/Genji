        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "以下スサノヲの命の子孫の系譜であるが大年の神とウカノミタマの神とは穀物の神で下の五二頁に出る系譜の準備になる。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "このうち、オホトシの神とウカノミタマとは穀物の神で、二三〇頁に出る系譜に連絡する。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またオホヤマツミの神の女のカムオホチ姫と結婚をして生んだ子は、オホトシの神、次にウカノミタマです。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
