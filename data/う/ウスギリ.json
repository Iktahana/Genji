        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大根を薄切りにして、大根おろしを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "牛肉の薄切りが、すぐに火が通る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "薄切りにしたニンジンを、炒めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それから大きな褌盥に極上井戸水を一パイ張りまして、その中でその赤肝の薄切りを両手で丸めて揉みますと、盥一面に山のごと泡が浮きます。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ女中が薄切りのスモーキングの鮭を持って顕れ、空いた皿と取り替えた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "御覧の通り雁皮みたいに薄切りした奴を、二時間以上も谷川の水でサラシた斯界極上の珍味なんだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "｜鵞鳥の肝たらいうものは薄切りにして氷で冷やし、シャンペン酒ももう氷槽に漬けてございます」　美人は恥かしそうにニッコリと笑い、「そんなら無駄口をきいていないで、もうさっさと帰ってちょうだい。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵を料理して薄切りのパンと一緒に食べながら、彼は猫が細切れの肉を忙しくぱくつくのを見つめ、食事が終わると流しのバケツからコップ一杯の水を汲んで飲んだ。",
              "citation": {
                "source": "四風の街",
                "author": "The Street of Four Winds",
                "note": "青空文庫"
              }
            },
            {
              "text": "他に色の好いシャンピニヨンを、十二個薄切にしてバタで半焼にする。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂へ入るとき化粧室で脱ぎすてるシミイズの汚れも目に立ったが、ストッキングの踵も薄切れていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして其の丹念なことは、片の薄切れたところや、薄くなつてゐる部分を、どんなに手間がかゝつても、綴らなければ気がすまないといふ風であつた。",
              "citation": {
                "source": "余震の一夜",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今じき何か出来るそうだが、それまでのつなぎに一つ珍らしいもんがあるよ」　その人は、焜炉の網に白い平べったい餅の薄切れのようなものをのせ、箸で返しながら焙った。",
              "citation": {
                "source": "一太と母",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○雑煮を作る時は汁の中へ薄切の大根を加うべし。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い絹の裏地など、薄切れのしたのに継を当てて細かに刺すのです。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "みそ汁には松茸の薄切が浮んでゝ、帯をした海苔、生卵一つ、飯は軽く二杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
