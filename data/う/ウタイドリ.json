        "examples": {
          "standard": [
            {
              "text": "山あいに分け入ると、歌い鳥の透き通った声が木々の間に響いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "野鳥観察会の講師は「今聞こえているのが歌い鳥ですよ」と参加者に向けて双眼鏡を構えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "歌い鳥はその名の通り、夏になると山間部でよく通る声を響かせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それは時にはわたしに音楽と歌い鳥とを思いださせる。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずしい漁師のやどへも、お百姓のやねへも、陛下から、またこのお宮から、とおくはなれてすまっておりますひとたちの所へも、この小さな歌うたいどりは、とんで行くのでございます。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
