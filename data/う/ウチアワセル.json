    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to knock together",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "役者は舞台上で木刀を激しく打ち合わせ、迫力ある立ち回りを演じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "職人が二本の石を打ち合わせて火花を散らし、火起こしの実演を見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "盆踊りの場面で、踊り手たちが竹を打ち合わせながらリズムを刻んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "……………………さも嬉しそうに両手を打ち合わせる。",
              "citation": {
                "source": "涙のアリバイ",
                "author": "――手先表情映画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、シムバルを打ち合わせる音のように突如として私の胸の中に恐怖が湧きおこった。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミリガン氏は父親と打ち合わせる仕事があるとすれば、たぶんまたうちへ来るだろう。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人はごくそうっと平手を打ち合わせるのだから、まるでなんの音も出ないのである……　この巧者なこわっぱが、喝采を引き延ばす術を心得ていることはどうだ。",
              "citation": {
                "source": "神童",
                "author": "DAS WUNDERKIND",
                "note": "青空文庫"
              }
            },
            {
              "text": "パーヴェル・パーヴロヴィチははっとわれに返って、兩手を打ち合わせると、一目散に駈け出して行った。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "メアリがトリガーセンの前から席を外し、カットリス技師といくつかの改善提案について少し真剣に打ち合わせるという。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちレックミア侍従が戻って来て、最新事情を女王と詳細に打ち合わせることになっている。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、寝そべって両足をうしろへ立てて、ときどき足の裏をうちあわせる芸当をしたのである。",
              "citation": {
                "source": "おじいさんのランプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "青写真の用事がすむと、「さ、出かけましょうか」　顎のところに大きいほくろのある人に、来客のことをうちあわせると、泰造はさっさと事務所を出て、エレベーターのところへ行った。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "支廳の戸川に打合せる話なら俺の事ぢやない。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "支庁の戸川に打合せる話なら俺の事ぢやない。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "君、今更嘘を云ったって仕方がないじゃないか、ほんとうの事を云って呉れ給え」「全く打合せなんかしてはありません」「ではどうして届けるのだい」「その都度打合せをしているのです」「打合せると云うと、支倉のいる所が分ってる訳だね」「いゝえ、そうじゃないのです」　浅田はあわてゝ云った。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おけいが外に泊る時には、どこでどう打合せるものか、宮崎を引入れて遅くまで飲み明す。",
              "citation": {
                "source": "別れの辞",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "行長と打合せる余裕すらも失ひ、単独鄭揆に交渉したが、軽蔑しきつて返事もくれぬ。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もそつと引返して、塀の外から見張つて居て貰ひたいんだ」「宜いとも」　二人は打合せると、「サア、これから家探しだ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "謎の鍵穴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにフランシスコ会士は、ヤソ会と打合せるでもなく、ヤソ会士が潜伏している機会に、大っぴらに日本の布教事業を奪い取ろうとしたのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっともそっと引返して、塀の外から見張っていて貰いたいんだ」「いいとも」　二人は打合せると、「サア、これから家探しだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "謎の鍵穴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしさらに驚くべきことは午後になってから、その夜うたう歌をオーケストラと打合せるために、根来八千代が舞台へ立ったときのできごとである。",
              "citation": {
                "source": "溜息の部屋",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、いまはもう寸分、君たち三名の義を疑ってはいない」「どういうご相談事なので」「くわしくは、その晁蓋と君たちが、義の杯を結んだうえで打合せるが、かいつまンでいえば、一世の大金儲けと、悪政府の大官を膺懲しようという快事だ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "川口と将来のことは打合せることにする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤山も来り、打合せる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一回の終りに、ビクターから青砥、小野巡・佐藤千夜子等来り、打合せる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "都と読売のラヂオ面記者に逢ひ、八日の放送のことを話し、四階で十月の出し物について打合せる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビクターの青砥が「ガラマサ」の非常時演説をレコードにしたいからと打合せる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガラマサ」を一寸打合せる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつけても一度先方の人たちに逢っておくことが望ましいのでその日どりを打合せるうちにも目前の必要に迫られて幾度かきてもらった。",
              "citation": {
                "source": "結婚",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "王と王子と剣を打ち合せる。",
              "citation": {
                "source": "三つの宝",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、二匹とも、静かに右足の蹄を打ち合せると、代る／″＼五六度いなゝきました。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しヂアコヌスの背後で、余り際立たないやうに、謂はば二本指を打ち合せるやうな拍手をしたのである。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "場所と時刻とを打ち合せるのが、私共の任務でありました。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to arrange (e.g. a meeting)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
