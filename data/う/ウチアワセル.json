          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先方と詳細を打ち合わせてから、正式な契約書を作成する予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "納期と仕様について事前に打ち合わせておいたおかげで、トラブルなく進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "会議の日程を打ち合わせるため、関係者全員に連絡を取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
