        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『すみれ軒』のウエートレスたちがいっせいに二人を見たことによって、充分想像されようではないか。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の五",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼なほ手さぐりを要するやうな暗さの中で、コーヒーか紅茶一杯に，ものゝ三時間｜乃至五時間も、ウエートレスと饒舌にふける気分は、到底筆者などの、及びもつかぬ感覚であり心境であるのだ。",
              "citation": {
                "source": "名古屋スケツチ",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ウエートレスや看護婦助手などのパートタイム・ジョッブをもって働きつづけた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウエートレスに注文を告げ、煙草を取り出し、一本抜いて、火をつけた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オートバイにまたがってばっかりだから」　ウエートレスが、麻里の注文したものを持ってきた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺もそのひとりだけど」　とおりかかった制服のウエートレスをつかまえ、彼は、オニオン・スライスのおかわりを注文した。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、もし彼がもっと別のカフェを選ぶか、そこのウエートレスと恋をするほども足しげく通よわなかったなら、あのような身の毛もよだつ恐ろしい運命にもてあそばれなくてすんだに違いない。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "神谷はまたしてもカフェ・アフロディテの片隅のテーブルに腰をすえて、ウィスキーをチビチビとなめながら、ウエートレスの弘子とさし向かいで、もう三、四時間ほども、意味もない会話を取りかわしていた。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、弘ちゃん、あたし困っちゃったわ」　怪しい客の相手をしていたウエートレスが、まっ赤に酔った顔をして、二人のテーブルに近づくと、声を落として言った。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐずぐず言ったら僕が行ってやるよ」　すると、ウエートレスは一度帰って行ったが、すぐ引っ返してきて、「じゃあ、そのお客さんに会いたいっていうのよ。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "弘ちゃんともう一人のウエートレスも、ちゃんとそれに気づいていて、あとでまっ青になって話し合ったことであった。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "神谷はいつかの晩のウエートレスをとらえて、あいつはその後やってこなかったかと尋ねてみたが、一度もこないという返事であった。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "××開始、ウェートレスの英国の少女、メリーをからかってしたたか膝を折られ泣面をしている男。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年の八月、イラクがクウェートに侵攻して中東の緊張が高まりました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一匹で穀六十ポンド、またハンドレッド・ウェートの豆を備えたもあるという（ウッドの『動物図譜』一）。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "インドの「愛経」によると、脣のキッスのみで八種あるが、少くもウェートレスは、それ位のことを心得ていて貰いたい。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "○ノーヴィ・スウェート通りを歩く。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェートレッスが食事の迎えにやって来た。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "キー・パンチャーとかウェートレスとかの仕事をやりながらブルースをうたい、恋愛のはてにテキサス州のオースティンまでひきかえし、そこからチェット・ヘルムズとともに再びサンフランシスコに出た。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
