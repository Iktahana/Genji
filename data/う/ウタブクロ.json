        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は歌袋という号を用いて、独自の歌学を世に広める活動に尽力した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "江戸時代の国学者、富士谷御杖は歌袋と称して多くの歌論を残した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歌袋と署名された古い写本が、神社の蔵から発見された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
