        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「一箇所だけ文字が間違っていたから、活字を植え替えておいたよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "印刷の直前に、見出しのフォントを別のものに植え替える。",
