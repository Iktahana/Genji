    "definitions": [
      {
        "index": 1,
        "gloss": "thin soup of fish or shellfish boiled in seawater",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "蛤の旨みがたっぷりと溶け出した潮汁は、お祝いの席に欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "潮汁の表面に浮かべた三つ葉が、彩りと爽やかな香りを添えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "飲みすぎた翌朝には、温かい潮汁が体を優しく整えてくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "黒鯛の潮汁旨しと雖ども、大船の艫に附て人の糞を喰ひし魚なり。",
              "citation": {
                "source": "肉食之説",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩で味をつけるから鯛の潮汁に似て味は十倍も佳い。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "刺身、塩焼き、照り焼き、潮汁、うま煮など。",
              "citation": {
                "source": "魔味洗心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
