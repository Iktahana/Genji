        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕はバビコック博士夫婦と今夜ライシアム座にウェルシ嬢の演じたトルストイの「復活」を見物しました。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェルシ嬢の演じた女主人公は真に迫りすぎているくらいでした。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェルシイニンを賞揚した、前田河広一郎氏が筆を呵して、探偵小説を作ったなら、きっと素晴らしいものが出来るだろうと、僕は常に思っている。",
              "citation": {
                "source": "探偵小説を作って貰い度い人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし小酒井不木氏とか松本泰氏、江戸川乱歩氏、横溝正史氏、アーサー、リーヴ、チェスタトン、ビーストン、ウェルシーニンというような、代表的作家の人物批評は、是又大いに必要である。",
              "citation": {
                "source": "マイクロフォン",
                "author": "「新青年」一九二六年二月",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　ウェルシーニンの「死の爆弾」を、喝采謳歌しないような、探偵小説家はヤクザである。",
              "citation": {
                "source": "マイクロフォン―雑感―",
                "author": "「新青年」一九二五年一二月",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに前田河広一郎氏は、ウェルシーニンを認めていた。",
              "citation": {
                "source": "マイクロフォン―雑感―",
                "author": "「新青年」一九二五年一二月",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿素の炭素が直接に二酸化炭素から供給されることは放射性二酸化炭素を使ったエヴァンスとスローティン(50)および安定同位元素 13C を使ったリッテンバーグとウェルシュ(51)の組織スライスを使う実験によって示された。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            }
          ]
