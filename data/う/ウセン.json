        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨線が近づいてくるのが見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "衛星画像には強い雨線が映っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この雨線は台風の前兆だろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "拝さばこの胸寸断になりて、常の決心の消えうせん覚束なさ。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しょうせんかく」「朝鮮閣？",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ううん、しょうせんかく」「朝鮮閣？",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして勝子から「しょうせんかく」といい出した。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとたび歩を急にせんか、八田は疾に渠らを通り越し得たりしならん、あるいはことさらに歩をゆるうせんか、眼界の外に渠らを送遣し得たりしならん。",
              "citation": {
                "source": "夜行巡査",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝のために彼の詩を全うせんと。",
              "citation": {
                "source": "花間文字",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうせんお婆さんのいたお邸の屋根の三本煙突の真中の一本は、何時でも煙を吐かなかったわねえ……」　――煙突でございますって？",
              "citation": {
                "source": "赤い煙突",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、早うせんと、病人の生命が無いぞ……」「ヘーッ……」　と文作は今一度畳の上に額をすりつけると、フラフラになったような気もちで方丈を出た。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "またそのむらがる枝の葉かげに　ぞくぞくと繁茂するところの植物およそ　しだ　わらび　ぜんまい　もうせんごけの類地べたいちめんに重なりあつて這ひまはるそれら青いものの生命それら青いもののさかんな生活。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうせんから、とりかかっていたおツルちゃん（姪）のモンペが出来あがったので、あの日、学校の帰り、それをとどけに中野の叔母さんのうちに寄ったの。",
              "citation": {
                "source": "雪の夜の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三男　　もうせん、ねえちゃんと花のかくしっこしたろう。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ汝らを高うせんために自己を卑うし、価なくして神の福音を伝えたるは罪なりや。",
              "citation": {
                "source": "パウロの混乱",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三たび登ると　九たび到ると、古徳と与に同じうせんと欲す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "古徳と同じゅうせんと欲するは、是れ仮にして、淮楚浙東に往来せるも、修行の為なりしや游覧の為なりしや知る可からず。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも朝は、過ぎ去ったこと、もうせんの人たちの事が、いやに身近に、おタクワンの臭いのように味気なく思い出されて、かなわない。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾人は完全なる努力の充実を全うせんがために、吾人の民族的理想の基礎を牢固ならしめむがために、勝てる者の天与の権威を、大胆に、赤裸々に、充分に発揮せしめざるべからず。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の芝居で、あの事がなかったら、幾ら私が無理云うたかて、丸官はんにこの祝言を承知さす事はようせんもの。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうせんから柳吉はげてもの料理を食べ過ぎたせいか胃腸が悪くて、二ツ井戸の実費医院へ通い通いしていたが、こんどは尿に血がまじって、小用の時泣声を立てた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "区々たる一身を潔うせんとして大倫を紊るのは、人間の道ではない。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "新協なんか、もうせんから、シーズンになれば欠かさないのよ。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれなら、たしかもうせん、きいたことがあるぞ。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂドは無情なる夫のせめては啓行の日を緩うせんことを願へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし多分Ａ・Ｂ・デーヴィッドソン氏の言う如く、肉を以て肉に換うというと等しく、人は己が生命を全うせんためには骨肉の生命を犠牲に供するを厭わぬとの意であろう。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "故にサタンのこの語は「人は己が生命を全うせんためには何物をも犠牲にせんとする者にして、生命は彼の最貴重物なればもし神ヨブの生命を脅すあらば彼必ず神を詛わん」という意味に解すべきものであろう。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前の心は能く解つた」　今ははや言ふも益無ければ、重ねて口を開かざらんかと打按じつつも、彼は乱るる胸を寛うせんが為に、強ひて目を放ちて海の方を眺めたりしが、なほ得堪へずやありけん、又言はんとして顧れば、宮は傍に在らずして、六七間｜後なる波打際に面を掩ひて泣けるなり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "抑も友とは楽を共にせんが為の友にして、若し憂を同うせんとには、別に金銭ありて、人の助を用ゐず、又決して用ゐるに足らずと信じたり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は己の今日あるを致せし辛抱と苦労とは、未だ如此くにして足るものならずとて、屡ばその例を挙げては貫一を※し、飽くまで彼の意を強うせんと勉めき。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は別れし後の貫一をばさばかり慕ひて止まざりしかど、過を改め、操を守り、覚悟してその恋を全うせんとは計らざりけるよ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "久く垂籠めて友欲き宮は、拯を得たるやうに覚えて、有るまじき事ながら、或は密に貫一の報を齎せるにはあらずやなど、枉げても念じつつ、せめては愁に閉ぢたる胸を姑くも寛うせんとするなり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その罪を※れんが為か、その苦と憂とを忘れんが為か、或はその愛を全うせんが為か、明に彼等は夫婦ならず、又は、女の芸者風なるも、決して尋常の隠遊にあらずして、自から穂に露るるところ有り。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
