        "examples": {
          "standard": [
            {
              "text": "優勝パレードは、チームにとって街中を巡る最高のウイニングランとなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はゴールラインを越えた後、国旗を背負って競技場を一周するウイニングランを行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "試合終了のホイッスルとともに、選手たちはサポーターの前でウイニングランを開始した。",
