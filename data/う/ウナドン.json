  {
    "uuid": "2b80c179-f8a5-5dc9-b03c-ebd2dc148607",
    "entry": "鰻丼",
    "reading": {
      "primary": "うなどん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
