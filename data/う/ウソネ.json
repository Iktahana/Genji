        "examples": {
          "standard": [
            {
              "text": "叱られるのが怖くて、父が部屋に来た瞬間に布団を被って嘘寝をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女が嘘寝をしているのは、まぶたがピクピク動いているのでバレバレだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "修学旅行の夜、先生が見回りに来たので全員で一斉に嘘寝を決め込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一つの大きい時代に生きた人を語るには、よくよくその時代の性格がつかまれないとうそね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうそねえな話は、これくらいで、止めといてくれ、血を分けた弟から、こねえなことばかり聞かれるのは、わしも我慢がならねえけえ」　と兄は、不快げにスタスタと、戻りかけました。",
              "citation": {
                "source": "仁王門",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
