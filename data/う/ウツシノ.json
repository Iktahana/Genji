          "literary": [
            {
              "text": "年、月、日、西岡時彦｜写之、お貞殿へさ。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「治安元年八月廿八日　以石泉御本写之已了　康平六年七月　於平等院　奉受此経　仏子快算」とあり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏には、陸軍通訳官正七位勲六等｜鬼頭源之丞、明治四十一年正月写之と達筆な署名がしてあつた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大正二年秋日写之」の奥書あり。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "卷尾には「享保八年｜癸卯七月七日於京都、里村昌億翁以本書、乾正豪寫之」と云ふ奧書があつて、其次の餘白に、「先師次第」と題した略系と「玄川先祖より次第」と題した略系とが書き添へてある。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
