    },
    "definitions": [
      {
        "index": 1,
        "gloss": "attacking party",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "逃亡者を捕らえるため、代官所から屈強な討っ手が村に差し向けられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "討っ手が背後に迫っていることを知り、一行は険しい峠道を急いで越えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は討っ手を迎え撃つため、一人で抜刀して橋の袂に立ち塞がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「近々に討っ手を差し向けらるるとか申しまするが……。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「して、その討っ手はいつごろ差し向けられると聞きましたか。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩冶どのに討っ手を向けられまするか。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「塩冶殿謀叛によって討っ手を差し向けらるるとか聞きましたが、それはまことでござりまするか。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「塩冶殿に討っ手を向けること、兄上も御同意でござりまするか。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「塩冶の館へ討っ手かと存じまする。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「塩冶どのへ討っ手のことか。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "親を裏切る不孝の娘は容赦なしに引っくくれ、主人にそむく不忠の家来は討ち果たせ、それも館へ帰るを待つまでもなく、途中に待ち受けて成敗せよ、塩冶へはすぐに討っ手を向けよと、大床を踏み破るるばかりに跳り上がって下知を伝えた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "足弱を連れた塩冶の家来どもは目ざす所まで落ち延び得ないで、ここで都の討っ手に追い付かれて、とても叶わぬところとは知りながらも、必死に防ぎ闘っているのではあるまいか。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「のう、采女、塩冶の人々が討っ手に囲まれたのではあるまいか。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "討っ手もおそらく奥方に眼をかけるに相違ない。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "闘いはその大木の二、三本を前にした小さい家の内そとを足場にして、追いつ追われつ挑み合っているらしく、小勢ながらも必死の敵をあしらいかねて、討っ手も少しく攻めあぐんでいるようにも見られた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍義教を弑した赤松満祐はこの城に籠って都の討っ手を引き受けたのであるが、結局は滅亡の悲運に陥って、逆臣の城は焚かれてしまった。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとかねてから為朝のゆくえをさがしていた平家の討っ手が向かって、為朝の油断をねらって、大勢一｜度におそいかかってつかまえてしまいました。",
              "citation": {
                "source": "鎮西八郎",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも直接の討っ手といえば木曽義明ではございますが、命を下したは足利将軍、されば妾の身にとっては、不倶戴天の父の仇。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう時の夜などに、ヘルンの書斎から法螺貝の音が聞えて来ると、それが広い家中に響き渡って、ボオボオと余韻の浪をうって伝って来る。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへ俺は行こうってんだ」　樫の盆見たいな顔を持った、セコンドメイトは、私と並んで、少し後れようと試みながら歩いていた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "手は所在なさそうに、摘み取った桔梗の枝の莟で、群る渚の秋花を軽くうっている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やめようって」「あたしは死んでしまったら、この男にはよかろうが、あとに残る旦那が可哀想だという気がして来てね。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時がうってしばらくたったころ、ジョバンニは拾った活字をいっぱいに入れた平たい箱をもういちど手にもった紙きれと引き合せてから、さっきの卓子の人へ持って来ました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして誰にも聞えないやうに窓の外へからだを乗り出して力いっぱいはげしく胸をうって叫びそれからもう咽喉いっぱい泣きだしました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっから来たろうって云ったら風で飛ばされて参りましたでしょうて云やいいや。",
              "citation": {
                "source": "二人の役人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "来年の話をすると鬼が笑うって言うじゃねえか。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "今もね、お静坊と石松はもう帰って来ねえンだろうって話して居たんですよ」　「帰って来ねえッ？",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「半次行こう」と今しも大吉、　表の戸開けた時「御用」と一人の役人うって来る。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "急に重くなって来た気圧で、息苦しく、むし暑く、寝返りばかりうっていたせいでもあるが、とてもじっとしていられない悲しい精力が眠気を内部からしきりに小突き覚ました。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "踏むものが一巡するごとに、人々がなだれをうって台場台場をうずめた。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてはげしく胸をうって叫びました。",
              "citation": {
                "source": "〔「銀河鉄道の夜」初期形一〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しそんな悪戯はもう時代おくれで、天保以後の江戸の世界には、相当の物種をつかって世間をさわがせて、蔭で手をうって喜んでいるような悠長な人間は少なくなった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "――病人まで人殺しに使うって法があるか！",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
