[
  {
    "uuid": "9f228549-8929-5eb2-aea0-468c60919ce3",
    "entry": "歌詠み",
    "reading": {
      "primary": "うたよみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
