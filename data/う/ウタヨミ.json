    "definitions": [
      {
        "index": 1,
        "gloss": "tanka composer",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は現代の歌詠みとして何度も全国大会で入賞している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "江戸時代の名高い歌詠みたちの作品は今も愛読されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その歌詠みの作風は伝統と革新を見事に融合させている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そのまじめくさつた歌にはをかしくて堪へられなかつたが、無理に我慢して歌詠み仲間の礼儀に歌の遣り取りをしたものだつた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三回、四回と試みてゐるうちに、プールの組は歸つてしまつて、そのあとへ義雄の仙臺遊學時代の後輩だが、渠よりはずつと先きに冒險小説で世間に名を賣つた男と、歌詠みから株屋の番頭に轉職した最も若い男とがやつて來た。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "当年二十四歳の男で歌詠みである。",
              "citation": {
                "source": "正岡子規君",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある歌詠みの話ですが、その標準はぐんぐん変つて行くさうですからね。",
              "citation": {
                "source": "小説への二つの道",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は単に一個の柔弱な歌詠みに過ぎない。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この難題には当代の歌詠みと知られた堀川や安芸や小大進の才女たちも、うつむいた白い頸を見せて、当座の思案に打ち傾いていた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の歌詠みから株屋の番頭に轉じた男だ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "思のままに歌詠みたらんには、国家治教などいへる事に関係なき歌も出来る訳なり。",
              "citation": {
                "source": "人々に答ふ",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "また太田道灌が歌を作りて「かかる言葉の花もありけり」と誉められたるが如き、歌の善き事が人を感ぜしめたるよりも、むしろ意外の人が歌詠みたりとの一事は人を驚かしたる者ありしなるべし。",
              "citation": {
                "source": "人々に答ふ",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "此は、歌会・歌合せには、古く五位の文官・武官などの歌詠みと聞えた者の、召される習はしがあつた為である。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、武将にして歌詠みであるといふやうな事実からではない。",
              "citation": {
                "source": "『ハイカラ』といふこと",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "良寛様が、料理人のつくった料理、書家の書、歌詠みの歌はいけないと言っておられるが、料理人が自分の庖丁の冴えを忘れて料理をつくるのも、書家が色を忘れてただ墨一色で書くのも、帰するところはひとつである。",
              "citation": {
                "source": "家庭料理の話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "表の客間は、もっと格式のある偉い人のために用い、真澄のような旅の歌詠みが来ても中の間に泊めたわけである。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし時には契沖のような人もあったらしく、私の父の友人の石坂素道さんという歌詠みの坊さんもそうであった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしなどは、いわゆる和歌詠みの風流僧にとどまるのだから、そうした心境に、小さい安住を見つけているのじゃ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大鷲の鎖一　うわべは歌詠みの法師か、きらくな雲水と見せかけてこころはゆだんもすきもなく、武田伊那丸のあとをたずねて、きょうは東、あすは南と、血眼の旅をつづけている加賀見忍剣。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして都の歌詠みたちも、幾名か連れて来ておろうな」鬮　歌道や茶の友には、礼儀のほかに、階級を超えた心と心の親しいものがある。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "師賢は、馬を拾って、大津の方へ駈けたが、いつか前後に味方もみえず、夜も白みかけて来る心ぼそさに、思ふこと無くてぞ見まし　ほのぼのとあり明けの月の志賀の浦なみ　などと、日ごろの歌詠み癖は、口をついて出たが、ついに石山寺の同勢へは落ち合えなかった。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "其たねつたへて景樹といふうたよみの処にゆきたれば、かかるたねあること知らで朝顔をはかなきものとおもひけるかなとよみ候よし。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって、こんなの、まるで河のほとりに立って何か唄っているようなの……ねえ、その気持ち判るでしょう」「判らないねえ、僕はうたよみじゃないから……」「そう、そうなの……」　本当を云えば、初め、僕は彼女を愛しているのでも何でもなかったのだ。",
              "citation": {
                "source": "魚の序文",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（そうだ、勝山さん煽いでお上げ、）とお夏が直に命を奉ぜぬのを、歌詠の大人は寛仁大度、柔かに教えるがごとく仰せられる。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「歌詠学成仙府調、薬丹伝得杏林方」は蘭軒が贈つた詩の頷聯である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌詠の句の下に蘭軒は「翁嘗学国歌于亜相冷泉公」と註してゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これではならぬと、仲間の歌詠や画家に塗つて貰つた短冊を五六枚と、茶菓子一皿を景品のつもりで、最後まで聴いて呉れた人に送ることにしたが、短冊と茶菓子の人並外れて好きな京都人も、矢張り最後まで居残る人は一人も無かつたので、折角の名案も何の役にも立たなかつた事がある。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "『将門記』に、平貞盛と源扶敗軍してその妻妾｜将門の兵に凌辱せられ、恥じて歌詠んだと出づ。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "三句切の歌詠むべからずなどいふは守株の論にて論ずるに足らず候へども、三句切の歌は尻軽くなるの弊有之候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "国家治教とかを目的として歌詠まんには、思のままには詠まれぬ訳なり。",
              "citation": {
                "source": "人々に答ふ",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "三句の歌詠むべからずなどいふは守株の〈論〉にて論ずるに足らず候へども三句切の歌は尻輕くなるの弊有之候。",
              "citation": {
                "source": "歌よみに與ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "再びこれをその歌詠に徴せん。",
              "citation": {
                "source": "曙覧の歌",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "三句切の歌詠むべからずなどいうは守株の論にて論ずるに足らず候えども三句切の歌は尻軽くなるの弊有之候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
