    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be buried",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "膨大な書類の中に重要な契約書が埋もれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "駅の雑踏の中で、彼の呼びかけの声は埋もれてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の大きな功績は、後の歴史の中に埋もれてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "山岸外史氏の、すぐれた著書も、やや、それに似てゐるが、これは、後日、きつと讀者に、ひろく頑強に支持されるにちがひない要素を持つてゐて、決して埋もれる本ではない。",
              "citation": {
                "source": "「人間キリスト記」その他",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、ここに一つ、ささやかな、ともすると埋もれるのではないかとさへ思はせる、あまりにも謙讓の良書が在る。",
              "citation": {
                "source": "「人間キリスト記」その他",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪に埋もれる六ヶ月は成程短いということは出来ない。",
              "citation": {
                "source": "北海道に就いての印象",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の場末から、橋を一つ渡って、山の麓を、五町ばかり川添に、途中、家のない処を行くので、雪にはいうまでもなく埋もれる。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "木材の多い地方ではあるが雪に埋もれる期間が長いので、露台はコンクリートでできていた。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それなので、人が人に優れて学問を行い、徳を修め、他と異なる見解を懐き、他を超える情意や見識を持つようになると、凡庸の人に理解されないことは無論で、そのため優秀な人が凡人の土地に埋もれることがある。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は彼自身の社会に対する一切の野心と慾望を擲って、美人の妻と一所に田舎に埋もれるという、涙ぐましいほどに甘美な夢を、安心して、夜となく昼となく逐い続けているところであった。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "埋もれる天才と環境との問題へ目をひらかれ、ひいては女の社会条件とその関係へと心をひろげられて行った過程。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、僕は身も世もなかった、死体に取りすがって埋もれる程泣きたかった――」　ふたりの間には、ながい間言葉がなかった。",
              "citation": {
                "source": "自殺を買う話",
                "author": "橋本五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心の好い叔父は唯訳も無く身を祝つて、顔の薄痘痕も喜悦の為に埋もれるかのやう。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、物凄くも奇怪のことには、それら殺された獣の屍は、眼に見えぬ手で持ち去られるものか、それとも雪に埋もれるのか、瞬間間に消え去って、後には斑々たる生血ばかりが雪を紅に染めている。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪に埋もれる法恩寺橋の橋上、ぱったりぶつかりそうになった雲竜の両士、「やッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも口をそろえて、かかる才能が長く埋もれるはずはないと公言し、その真価を世に紹介しようと約した。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、来るべき年の春まで、深雪の下に埋もれる、この峡谷の絶底の孤つ屋には、豆腐造りの中年夫婦が、乳呑子とただ三人、留守居を勤めるのだという――繩や草鞋の手細工などをやりながら。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "古き制度のなお永続せんとする頑固さは、臭き油のなお人の頭髪につけられんことを求むる頑強さにも似、腐った魚肉のなお食せられんことを求むる主張にも似、子供の衣服のなお大人にまとわれんことを求むる執拗さにも似、埋もれる死骸のなお生きたる人々を抱擁しに戻りきたらんとする情愛にも似ている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い木造の民家が、深い熱帯樹林に埋もれるようにして、そこかしこに見えた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹿之介と苦労を共にして来た三十余名の郎党のなかに、彼の妻や幼い子も、埋もれるように船の中に乗せられていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ていた幸村は、何思ったのか、佐助に呼びかけて、あたら幻妙の腕を持ちながら、山中に埋れるのは惜しいと仕官を口説くと元来自惚れの尠くない佐助は脆かった。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏口の柿の葉は一時に落ちて、道も埋れるばかりであった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それに、残念ですのは、三月の間苦労しまして、実は漸くある親友の世話で、衣食の道が開けましたで、……田舎に埋れるには忍びまへんで」　三人は猶語った。",
              "citation": {
                "source": "蒲団",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あの仏壇の抽斗は「永久に開かぬもの」といふ、家の伝来の掟であつたから、この私の行為が今、他人の眼にさへ触れなければ、永遠に私の所業は秘密の裡に埋れる筈である。",
              "citation": {
                "source": "変装綺譚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「当時の文壇の実状として、私たちは、どんなに苦しくても既成文壇に順応して行っては、その亜流として埋れる他はないのだから降参するわけには行かなかったのである」けれども、この新感覚派の運動は「敗北した。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その天稟の能力なるものは、あたかも土の中に埋れる種の如く、早晩萌芽を出すの性質は天然自然に備えたるものなり。",
              "citation": {
                "source": "家庭習慣の教えを論ず",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しこれで埋れるなら、それ限りの人なのだからとは矢張り思えない。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "番頭は敷居外にうずくまって、額が畳へ埋れるほどにお辞儀をしました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼と嘴と額との国境のような凹んだ三角地帯に、剛い毛に半ば埋れるように鼻孔がこの辺のこなしを引締めている。",
              "citation": {
                "source": "木彫ウソを作った時",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春は青葉で暗く冬は雪に埋れる田舎町で、一人の息子の成功を神に祈っているのだ。",
              "citation": {
                "source": "蝋人形",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "）が蟠屈し、片方は雲に埋れる遠嶺で、山上の感がまざまざと表現されている。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつけても、清盛の仕打ちの口惜しさが、又想い返されてきて、母子は又涙に埋れるのであった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が前にコングロメレートから聞きましたがどうも僕らはこのまま又土の中にうずもれるかそうでなければ砂か粘土かにわかれてしまうだけなようですよ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
