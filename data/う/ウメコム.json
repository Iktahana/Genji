        "examples": {
          "standard": [
            {
              "text": "庭の隅に古い瓶を埋め込んで、子どもたちとのタイムカプセルを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "職人が石畳の隙間にモルタルを埋め込み、ぐらつきをなくした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "設計者は基板の中にセキュリティチップを埋め込む方針を決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "額の真中を、井戸のはね釣瓶で牡丹餅大にばっくりと食って取られたそのあとが、相当に癒着しているとはいえ、塗り隠すことも、埋め込むこともできない――親の産み成した両眼のほかに、縦に一つの眼が出来ている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根瓦は暗色のねばねばする泥土の中に埋め込むが、この泥はこねて球にまるめて、屋根に達する迄、一人から一人へと手渡す（図614）。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "その作業が終わったなら、今度は握り拳ほどのサイズの石を敷いていき、これもよく叩いて固く埋め込む。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ただわしという者と、お身という者との感情を一時しのぎになだめてみるに過ぎないことだ」「…………」覚明はその逞しい肩を大地へ埋め込むように、顔を俯伏せたまま、声をあげて哭いた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……お酒を取って来るんですから」「酒などは」「お母あさんに叱られます」「お甲は、あちらで、藤次と仲よく話しおるわ」　埋め込む朱実の顔へ顔をすり寄せると、ぱっと火でもついたような熱い頬が必死に横を向いて、「――誰か来てえっ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムーヴィ・カメラのファインダー・アイピースを目のなかに埋めこむようにして、僕は絶体絶命の悲鳴をあげた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
