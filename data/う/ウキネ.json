    "definitions": [
      {
        "index": 1,
        "gloss": "sobbing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の憂哭が聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "憂哭のような泣き声が暗い部屋から聞こえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "憂哭しながら、彼は部屋を出て行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "鴛鴦の鳴いているのを聞いて、源氏は、かきつめて昔恋しき雪もよに哀れを添ふる鴛鴦のうきねか　と言っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "朝顔",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰か　うきねの袖絞るらむ月にうつ大城の鼓しばし待て。",
              "citation": {
                "source": "歌の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにも、うきねといふ言葉に憂きといふ厭な、情ない悲觀すべき意味の言葉が、音から感じられる習慣になつてゐます。",
              "citation": {
                "source": "歌の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "颶風はここにわが漂浪の目醒に祝別す、身はコルクの栓よりも輕く波に跳りて、永久にその牲を轉ばすといふ海の上にうきねの十日、燈臺の空けたる眼は顧みず。",
              "citation": {
                "source": "醉ひどれ船",
                "author": "LE BATEAU IVRE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
