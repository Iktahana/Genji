        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日一日うだうだして、何も成し遂げなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "休日はソファでうだうだしながら過ごすのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "うだうだしている時間があったら、読書でもしたらどうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
