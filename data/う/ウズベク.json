        "examples": {
          "standard": [
            {
              "text": "彼はウズベクの伝統的な民族衣装を身にまとって踊った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ウズベクの食卓には、必ずと言っていいほど大きなナンが並ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ソ連崩壊後、ウズベクの人々は独自のアイデンティティを再構築してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この表でも分るように、例えば婦人の文盲率の最も高いトルクメン、キルギース、ウズベクでさえ、一九三〇年の夏、モスクワで演劇オリムピアードが開催された時はどうだったろう。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウズベクスキー〔ウズベク人〕の芝居を見た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "法隆寺壁画の西方浄土の脇仏の顔は、パミールに近い僻地に残っているウズベクの女の顔であるという説まで出ている。",
              "citation": {
                "source": "雷神",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
