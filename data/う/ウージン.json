        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "後、二人で出かけ、昨夕食事した家で食事をし、モストルグで、ウージン〔夕食〕の仕度をしてかえった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しそんな工合でどの位仕事出来るかやって見よと、ウージン〔夕食〕までやった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、Ｙは家で仕事したいというので、自分いやだったがオリガさんのところへ行ってかえったら、Ｙ、もうウージンして居た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月三十日　木　午後一時ニージェニウージンスクへ止る一寸前ひどい音がして自分のわきの窓硝子が破れた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後一時、ニージュニウージンスクへ止る一寸前、ひどい音がして思わず首をちぢめたら自分の坐っていたすぐよこの窓ガラスの外一枚が破れている。",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
