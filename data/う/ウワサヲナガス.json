        "examples": {
          "standard": [
            {
              "text": "彼は面白半分で、友人の悪口の「噂を流した」。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "インターネットでデマの「噂を流す」のはやめるべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "根拠のない「噂を流す」行為は、人を傷つける可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが大トンネルの難工事が漸く不吉な噂を流すころになるに従つて、彼等の所謂「世界的不景気」なるものゝ暴風が次第に逞しく荒れ始めるに伴れて、地価などゝいふものは忽ちスロープを降下する橇のやうにもんどりを打つて滑り落ちた。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "航海の仕事によって張り込みが中断されるので、エリエイザー・スミスという名の同宿人に不在時の調査を依頼することにし、その気になれば二人掛かりで驚くべき噂を流すこともできた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
