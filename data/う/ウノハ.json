        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コンナツマラナイ素描帳ヲ見テクダサイト言ウノハタイヘンツライノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ痛ミガアルト云ウノハ脳ノ方ノ病気デハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「陸子ガ何カオ爺チャンニオ願イガアルンデスッテ」陸子ノオ願イト云ウノハコウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナマメカシイト云ッタライヽノカ、色ッポイト云ッタライヽノカ、己ハ今マデニアンナ妖艶ナ女ヲ見タコトガナイ、妖婦ト云ウノハ正シクアンナ女ノコトヲ云ウンダロウナ、アンナ女ニナラ殺サレタッテイヽト思ッタト、湿ノ父親ハイツモ忰ヲ掴マエテヨク／＼感ニ耐エタヨウニ云イ暮ラシタソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ト云ウノハ、タイルニシテ見タラ濡レテイル時ツル／＼滑リ易クッテ、老人ハ危クテ仕方ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「興奮サセルトイケナイカラ、アダリンヲ飲マセタゲマショウカ」颯子ガ予ニコウ云ウ種類ノコケトリーヲ云ウノハ始メテデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春久ガシャワーヲ浴ビニ来サセテクレト云ウノハ、タヾソレダケノコトデナク、何カ魂胆ガアルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不便ト思ウノハイヽケレド、オ爺チャンヲ楽シマセルタメニ、アタシガ犠牲ニサレルノハ嫌ダワ」「犠牲ト云ウコトハナイデショウ、僕ヲ楽シマセルト同時ニ、君自身モ楽シムンジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鑿ト云ウノハアノコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ウノハ、五子モ暫ク奈良ヘ行ッタコトガナイノデ、コノ機会ニ行ッタラドウカト予ガ勧メタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――アタシガ颯チャンヲ立タセルヨウニ仕向ケタト云ウノハ、全ク根モ葉モナイ冤罪デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイウノハ、木村ノ学校ガ始マッテ、ソロソロ昼間ノ逢引ガ不可能ニナルカラデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "郁子ハ僕ヲ欺クヲ云ウノハ止セ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイウノハ、眩暈ガヒドクテ歩行ニ困難ヲ伴ウモ始終デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ウノハ、イツゾヤ東京ヘ行ッタ時弘君ニ話シテシマッタノデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
