    "definitions": [
      {
        "index": 1,
        "gloss": "slow-paced style of shamisen music with vocal accompaniment (popular during the late Edo period)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "うた沢の落ち着いた調べが、座敷の雰囲気にしっとりと馴染む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "派手な長唄とは対照的に、うた沢は静かで繊細な表現が持ち味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "稽古場で師匠のうた沢を聴きながら、江戸の情緒に思いを馳せる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "……うた沢をうたうんで、時おり、そのお相手を仰せつかるだけ。",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ことに相手が、うた沢の如きをたしなむタマだったら、たちまち、それからそれ口がほぐれて、雪のあしたの煙草の火、寒いにせめてお茶一ぷく、それが高じて酒一つ……　――何、それ？",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……うた沢だけ、それも稽古したゞけのことをうたわしてさえ置けば、それでいゝタマだということがハッキリ分ったの。",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
