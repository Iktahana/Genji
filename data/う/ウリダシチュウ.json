        "examples": {
          "standard": [
            {
              "text": "冬物が売り出し中だから今がチャンスだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "売り出し中の品物は交換できないと注意書きがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "あの百貨店は常に何かが売り出し中だ。",
              "citation": {
