        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "階段から転げ落ちた拍子に、脚に大きな打ち傷を作ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ボクシングの試合後、選手の顔には激しい攻防を物語る打ち傷が残っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "打ち傷の痛みを和らげるために、冷たいタオルで患部を冷やした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "長三郎は直ぐにその死骸をひきおこして身内をあらためたが、どこにも斬り傷または打ち傷らしい痕も見いだされなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしいずれも致命傷ではなくて、ほんの浅い切り傷であり、骨にまで達しない打ち傷であった。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "政吉　　（岩の角にて頭を打ち傷ついている）あ、痛え。",
              "citation": {
                "source": "中山七里　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "「顔にひどい打ち傷がある。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "町役人の手を借りて、なほも調べて行くと、死骸には突き傷の外に打ち傷があり、腰から肩のあたりを餘つ程ひどく打たれた樣子です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "色若衆",
                "note": "青空文庫"
              }
            },
            {
              "text": "「打ち傷にはこの方がいいだろう。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "表面にはかすり傷も打ち傷も見えなかったし、そのために坐りもしなければ休みもしなかったが、それから五、六時間たって卒中で死んだ。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "五体のあらゆるところに、摺り傷だの打ち傷を作っていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思えば、ここへ帰って来たときの姫の玉のような真白の肌には、痣や打ち傷が紫いろに腫れあがっていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもかれには言うに言われぬ無念がまだ折り折り古い打傷のようにかれの髄を悩ますかと思うとたまらなくなってくる。",
              "citation": {
                "source": "まぼろし",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "大概の打傷、擦傷、筋を違えなどは、内分にして、膏薬も焼酎も夜があけてから隠密という了簡。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "多寡が打傷ですから。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は大きい方の二つの袋を地べたへ抛り出しておいて――それ故、その中に入つてゐた補祭は打傷のために悲鳴をあげ、村長は思ひきり逆吃をした――小さい方の袋を担いだまま、今オクサーナの声がしたやうに思はれる娘つ子の群れの後を追ふ若者たちに加はつて歩き出した。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲馬の馬の爛れて癒ゆる間なき打傷と何れぞ。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は打傷をこしらえ、ぐったり弱って、荒廃した建物の破片の山の間に横たわっていた。",
              "citation": {
                "source": "秘密礼拜式",
                "author": "アルジャナン・ブラックウッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ところが、おふくろの罰があたったのか、朱実の奴が、瓜生山で辷った時の打傷が痛いといいだし、それからこの茶店でずっと寝込んでしまったというわけ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
