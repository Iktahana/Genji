        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "難民キャンプの憂わしい生活環境が世界的な問題となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この会社の経営状況は実に憂わしい状態が続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "戦地での憂わしい日々を記録したドキュメンタリーが公開された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "微かながら絶間のないピチ、ピチ、と云う音をきき乍ら、私は、寂しい、憂わしい心持に襲われた。",
              "citation": {
                "source": "餌",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょいと五右衛門は主殿の方を見たが、「相変わらず今夜も盛んだの」「うん」と云ったものの常陸介の声には、憂わしい不安な響きがあった。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し今か今かと待っていてくれる友のことを想像したり、その晴やかな而も憂わしい笑顔を思い浮べたりすると、たとい遅くなってもその日のうちに行きたかった。",
              "citation": {
                "source": "道連",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんで、あなたは、そんなに憂わしい顔つきをしているのじゃ。",
              "citation": {
                "source": "笑わない娘",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "その憂わしい顔色はまだ残っていたが、ゆうべほどではない。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "鏡中の美女",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマ人の夫婦墓が道に沿って並んでいて、その憂わしい顔と忠実な握手とを、木の葉がくれに示していた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーグル・ド・モーは前々日法律学校でふりかかったくだらない失策のことを考えていたが、別に憂わしいふうもなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "もはや見られぬそれらの場合、おそらく永久に再び見ることのないそれらの場所、しかも心のうちにだきしめているそれらの場所、それは一種のうれわしい魅力を帯び、夢幻の憂愁をもって浮かんでき、目に見得る聖地のごとき趣を呈し、言わばフランスそれ自身の形となるのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "白糸の愁わしかりし眼はにわかに清く輝きて、「そんなら事実を申しましょうか」　裁判長はしとやかに、「うむ、隠さずに申せ」「実は奪られました」　ついに白糸は自白せり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸外は立迷う人の足、往来も何となく騒がしく、そよとの風も渡らぬのに、街頭に満ちた露店の灯は、おりおり下さまに靡いて、すわや消えんとしては燃え出づる、その都度｜夜商人は愁わしげなる眉を仰向けに打見遣る、大空は雲低く、あたかも漆で固めたよう。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "物思わしさを源氏は極力おさえていたが、時々には忍びがたい様子もうかがわれるのを、宮もお感じになって、さすがにその人にまつわるものの愁わしさをお覚えになった。",
              "citation": {
                "source": "源氏物語",
                "author": "若紫",
                "note": "青空文庫"
              }
            },
            {
              "text": "右兵衛督、右大弁で参議にならないため太政官の政務に携わらないのを夫人は愁わしがっていた。",
              "citation": {
                "source": "源氏物語",
                "author": "竹河",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡素に僧のように八の宮の暮らしておいでになった昔を思うと、その方の恋しく思われる薫は、改築したことさえ後悔される気になり、平生よりも愁わしいふうであたりをながめていた。",
              "citation": {
                "source": "源氏物語",
                "author": "東屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "中将は何かほかにも愁わしいことがあるのか、ひどく歎息をして、笛を鳴らしながら「鹿の鳴く音に」（山里は秋こそことにわびしけれ鹿の鳴く音に目をさましつつ）などと口ずさんでいる様子は相当な男と見えた。",
              "citation": {
                "source": "源氏物語",
                "author": "手習",
                "note": "青空文庫"
              }
            },
            {
              "text": "「尤も、僅か一週間ばかりの故だとは言いますけれど……」と復た曾根は愁わしげに言った。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「母親さん、そこどころじゃ有りませんよ……」　と豊世が愁わしげに言出した。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「叔父さん、どうしたら宜う御座んしょうね」と豊世は愁わしげに答えた。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊世は愁わしげに立っていた。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂人に刄物という奴さ、不祥のことだが尾張様に、ご謀叛のお心などあった時、多額の軍用資金の貯えがあると、ちと事がむずかしくなる」「ご尤もにございます」今迄じっと黙っていた三十四五の一人の男が、愁わしそうに合槌を打った。",
              "citation": {
                "source": "天主閣の音",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう貝十郎が見ているとも知らず、お品は何んとなく愁わしそうな様子で、暮れて行く空を仰いでいたが、にわかに活々と眼を躍らせた。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには思い做しか、愁わしげな様子で、じっと舞台を見下している彼女の横顔が真紅のカーテンを背景に美しい線を描いていた。",
              "citation": {
                "source": "日蔭の街",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "元カーテンに使ってあったから片側は、はげているところもあるんだけれど」　千代は、同じ愁わしげな眼差しでその青い布を見た。",
              "citation": {
                "source": "或る日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「行ってみる時刻でしょう」と妻は愁わしげに云う。",
              "citation": {
                "source": "秋日記",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな会話をするようになったのかと、ふと彼には重苦しく愁わしいものがつけ加えられるようだった。",
              "citation": {
                "source": "美しき死の岸に",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の落ちた大原野に、濡れたる星は愁わしげにまたたけば、幾千万の木葉はそよぎを収めて、死んだように静まり返る。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の正月は、全くわたしもすがすがしい気分が主潮をなしていて、清朗であり、そこに光りもとおして居りますけれど、思えば思えば御苦労さま、というところもひとしおで、そのすがすがしい清朗さに、云うに云えないニュアンスを優しく愁わしく添えて居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "碧く、高く、晴れ晴れと、まるで空に浮いて居る雲を追って起伏して居るような山々の下に、重い愁わしげに金色の耕地が続いて居る。",
              "citation": {
                "source": "麦畑",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "長く引っぱって呻くように唄う言葉は分らないが、震えながら身を揉むようなマンドリンの音と、愁わしげに優しい低い音で絡み合うギターの響は、せきの凋びた胸にも一種の心持をかき立てるようであった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「今日はお父様珍しいのね」「ああ」　泰造は宏子の片方の腕をとって自身は道の外側を暫くだまって歩いていたが、やがて、「丁度いいところで逢ったから話すがね」　おだやかな、圧しつけるところのない、寧ろ心配りで愁わしげな調子さえ響く声で云った。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "じっと落着いていて、愁わしげに――でも陰気でないくらいの程度に、何かを思い沈んでいた。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
