        "examples": {
          "standard": [
            {
              "text": "パンの表面の上っ側だけをカリッとトーストする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "箱の上っ側に貼られたラベルを確認して、中身を判断する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "棚の上っ側に埃が溜まっているから、掃除機をかけておいて。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
