        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お城のガイドが、内堀の深さと防御力の高さについて熱心に語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "満開の桜が散り、内堀の水面がピンク色の絨毯で覆われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "内堀に沿ってジョギングをしていると、爽やかな風が吹き抜けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その夕がたに文字友は内堀端の家を出て広小路の武蔵屋へたずねて行くと、その途中から町人風の二人づれが番傘をさして付いて来る。",
              "citation": {
                "source": "鯉",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "△内堀勉氏――褒状をもらつてゐる、この新しがりに、褒状をくれる会の方針が判らぬ。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "この内堀は東西南北の四面に在ったらしいが、東南の角だけは、後に埋め立てられて築山になった。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その理由は『実隆公記』に、「修繕手廻りかぬるため」とあって、その跡が用心のため、西内堀に直されたのである。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "内堀の二の門へかかる。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも巌がくれの裏に、どうどうと落ちたぎる水の音の凄じく響くのは、大樋を伏せて二重に城の用水を引いた、敵に対する要害で、地下を城の内濠に灌ぐと聞く、戦国の余残だそうである。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "然も巌がくれの裏に、どうどうと落ちたぎる水の音の凄じく響くのは、大樋を伏せて二重に城の用水を引いた、敵に対する要害で、地下を城の内濠に灌ぐと聞く、戦国の余残ださうである。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "２　石高はわずか三万石の小藩ではありましたが、さすがは天下の執権松平伊豆守の居城だけあって、とわに栄える松の緑は夜目にもそれと青み、水は満々と外濠内濠の兵備の深さを示して、下馬門、二の門、内の門と見付け見付けの張り番もきびしく、内外ともに水ももらさぬ厳重な警備でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸城、内濠の牛ガ淵。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、どちらであるにしても、内濠とある以上は、たとい天下、波風一つ起こらぬ泰平のご時勢であったとて、濠は城の鎧兜、このあたり一帯の警戒警備に怠りのあるはずはない。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "特にお濠方という番士の備えがあって、この内濠だけが百二十人、十隊に分かれて日に三度ずつ、すなわち暮れ六つに一回、深夜に一回、夜あけに一回。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「城中、内濠にていぶかしき変事｜出来、即刻おん越し待ちあげ候。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸大城の関門とも言うべき十五、六の見附をめぐりにめぐる内濠はこの都会にある橋々の下へ流れ続いて来ている。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田倉橋から一つ橋の方へ、内濠に添うて平坦な道路を帰って行った。",
              "citation": {
                "source": "並木",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "外濠といつても三十六見附の役人の目があつて、今日のやうに、無暗に埃などは投げこめなかつたのですが、丸橋忠彌が石を投り込んだ内濠と違つて、二十や三十の乾菓子なら、夜陰ひそかに投り込めないことでは無かつたでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "御落胤殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨年は昔の内濠の跡、今は用水堀になって居る所で、一人の老人が石垣の中から抜け出したとも見える、大石に打たれて死んで居りました。",
              "citation": {
                "source": "古城の真昼",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "外濠と言っても三十六見附の役人の目があって、今日のように、無暗に埃などは投り込めなかったのですが、丸橋忠弥が石を投り込んだ内濠と違って、二十や三十の乾菓子なら、夜陰ひそかに投り込めないことではなかったでしょう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "御落胤殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "かなり強い北風で、道から砂埃が舞いあがり、内濠の水は波立って、頻りに石垣を打つ音が聞えた。",
              "citation": {
                "source": "はたし状",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "城の内濠外濠の水量を監視したり、泥を浚ったり、石垣の崩れを修理したりするものらしい。",
              "citation": {
                "source": "ひとごろし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、遠く走せていた目を、すぐ真下の作事場――内濠のところにうつすと、そこには数千の人夫や工匠が、朝顔のかこいのように縦横に組まれた丸太足場で、エイヤエイヤと、諸声あわせて働いているのが見られた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "運河をつくり、内濠をめぐらすなど、工事監督一切は、杜選とそして陶宗旺の任とする。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "城内にも一すじの内濠があったが、そこは溝渠のような幅しかない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "……内濠、外濠を掘るだけでも。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "内濠、外濠、幾つもの御門を通らなければ、江戸城の外へは出られませぬ」「それは分っておる」「はっ」と、剛兵衛は言い過ぎたかと、少し冷やりとして金吾の方を向いた。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "平河門、三の丸、丑寅櫓のこう三ツで、カギの手を作った内濠の水です。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "城下をめぐる幾筋もの川は、自然の外濠や内濠のかたちをなし、まず平城としては申し分のない地相、阿波二十五万石の中府としても、決して、他国に遜色のない城廓。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
