[
  {
    "uuid": "4fbc1a41-7cc2-5111-86f6-15a0010810d2",
    "entry": "海がめ",
    "reading": {
      "primary": "うみがめ",
      "alternatives": [
        "うみガメ",
        "ウミガメ"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sea turtle",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "深夜の海岸で、大きな海がめが産卵のために上陸してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "海がめが優雅に水中を泳ぐ姿は、見ていて飽きない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プラスチックゴミを食べてしまう海がめのニュースに胸が痛む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "かと思うと、月夜に、海の底から砂地に這上って、砂に卵を産みにくる海がめもいる。",
              "citation": {
                "source": "海の青と空の青",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "海がめをとらえる道具も、小笠原島方面と、南洋原住民の使うものとを用意し、また、かめの油をしぼる釜もそなえた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよ水がなくなったら、この島々にたくさんいる、海がめの水を飲もう。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海がめは、腹のなかに、一リットルから二リットルぐらいの、清水を持っているのだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、これらの無人島では、大きな海がめ、背の甲が一メートルぐらいの正覚坊（アオウミガメ）が手あたりしだいにとらえられ、おまけにその肉は、牛肉よりもおいしく、また、どの島のちかくでも、二メートル以上のふかが、いくらでもつれた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと、龍睡丸の持主の報効義金は、貧乏な団体であるため、冬の間、南の海で、ふかや海がめ、海鳥をうんととらえて、できればまっこう鯨もとって、利益をえようというのが、この航海の目的であったのだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――まさか、自分たちもそんなことに――　と、思うのではなかったが……海がめの島、海鳥の島　いま、われらの龍睡丸は、波をけたてて、ハワイ諸島にそって、北西に進んで行く。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんであろうかと近づいてみると、それは、甲羅の大きさが一メートルもある、海がめの正覚坊が、のそのそしているのであった。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よし、みんなつかまえてしまえ」　一同は、海がめをかたっぱしから、あおむけにひっくりかえした。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この、海がめの珊瑚礁をあとに、本船はさらに北西に進んだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "リシャンスキー島は、ひくい砂の島で、草も、小さな木も生えていて、海鳥、海がめ、魚がたくさんいた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "石油｜缶に、海がめやふかの油を入れ、小さなあなをいくつかあけて、二缶も三缶も、海に投げこんだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海がめの牧場　鳥の大群が、島から飛びさったら、まもなく、海がめが、卵を生みに島にやってきた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月になると、海がめが、ぼつぼつ、島へあがってくるようになった。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海がめの産卵がはじまってから、練習生と会員は、漁業長の指導で、これについての研究をはじめた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "正覚坊のことを、一名アオウミガメというのは、暗緑色で、暗黄色の斑点があるからで、大きさも、形もよくにた海がめにアカウミガメというのがある。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで、たきぎと海がめの、倉庫のような島だ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その荷物が、ふうがわりなもので、引っこし荷物のほかに、的矢丸の糧食にするため、たくさんの海がめと、石油｜缶につめた貴重な雨水が、三十缶、料理用たきぎとして、流木をまきにしたものが、八十五束もあった。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ等の食物は鰻、うみがめ、鯰、鯉、野鴨、鵞鳥、葱、それから葱と同じような野菜の一種である。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
