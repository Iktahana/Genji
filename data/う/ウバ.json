  {
    "uuid": "296304bc-d5f3-59a0-a146-4a3ec02e9169",
    "entry": "ウバ",
    "reading": {
      "primary": "うば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
