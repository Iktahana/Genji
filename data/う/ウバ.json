      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "同じ太平洋岸でも、有名な航海者「ヴァンクウバア」が、フッド火山や、ベエカア火山や、レイニーア火山を発見してから、三十四年も後に、シャスタは、やっと存在を認められた。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　シツカリト　カナヅチヲ　ニギリシメテ、コウババカリノ　マチヘ　マツスグ　アルイテ　ユキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサン新美南吉　ミチコサンガ、コトリヤノ　マヘマデ　クルト、シラナイ　オバサンガ、ウバグルマノ　ナカノ　ニモツヲ　ナホシテ　ヰマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　ウチニ　オバサンハ　スツカリ　ウバグルマノ　ナカヲ　カタヅケテ、「スミマセンデシタ、ホントウニ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンハ　マタ　ウバグルマニ　ノツケラレテ、イツテ　シマヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日、フウバア大統領の前を、颯爽と、分列行進をしていった女子選手達のうちに、あなたのりりしい晴れ姿をちらっと垣間見ました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "またミカウバーと住んでおったデヴィッド・カッパーフィールドのような感じもする。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロウバが生ひ繁つてゐる初夏の丘の芝生である。",
              "citation": {
                "source": "競馬の日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、正ちやんのお母さんは御殿の草とりに雇はれてゐて、正ちやんは弁当を運ぶので、いつもそのついでに、三本の尾が躯の六倍も長いウマノヲバチや、鼈甲色のベツコウバチや、怖ろしいクマバチや、トクリバチの巣などを採つて来て呉れるのであつた。",
              "citation": {
                "source": "魚籃坂にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウバツサンが一面、実際の方から、一面さういふ方から、あゝいふ末期を得たことなども、私は深い意味があると思つてゐる。",
              "citation": {
                "source": "脱却の工夫",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウバツサンも矢張さうだ。",
              "citation": {
                "source": "自からを信ぜよ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　矢代はブリュウバールの方に日本があると思うらしく、傾いたその道路の方を見ながら暫く黙っていてから、また云った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルは、柱につながれたままグルグル巻きの自縛の縄に悶えて、バウバウと吠えたててゐた。",
              "citation": {
                "source": "創作生活にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌てゝ水際の草の中へ眼を転じ、怕るゝ胸をさすらうとすると、おゝ俺は観た――一個のベツコウバチと一体の脚長蜘蛛とが、今や孔雀歯朶の葉裏で、死もの狂ひの大格闘を演じつゝある惨状を！",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、もう息の根が止るかと見えるベツコウバチの力は容易に尽きる気合ひもなく、またもや翅に鞭を加へたかと見ると脚の自由を奮ひ返して、巨大な怪物の胸を滅茶苦茶に引つ掻いた。",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おゝ、その間に二個の格闘体は（確と観察は出来なかつたが、遂ひにベツコウバチの突き出した槍の先が、アシナガグモの団子のやうな腹部に命中したらしかつた。",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベッコウバチの標本写真は五枚も撮つた。",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "と倉市は、僕の頭上の壁に懸つた標本箱に、ベッコウバチを指さした。",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラビア人は太陰（ワッド Wadd ホバル Hobal またはハウバス Haubas）を父として、太陽（シャムシュ Shamsh）を母、また金星（アッタール Atthar）をその子として礼拝した。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "また「シヤウバイ」とも言ひ「アキナヒ」ともいふを見れば、この時代から既に両方の言葉が用ゐられて居つたのが分る。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンヤハンドレペイジチヨウジユウバクゲキキ五ダイトウチヤクシタ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ヒメシャクナゲ　ミツバオウレン　ツルコケモモ　イワゼキショウ　ショウジョウバカマ　ワレモコウ（小形の一種）　ツバメオモト　ヤチスギラン　此の他疑問中にあるもの二種。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤ※ンヌのマルセイユを描いた二枚の壁画、古い所でペルヂノやリユウバンスの作品が目を惹いた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "美術館では和蘭の古画と併せてリユウバンスとンダイクの」］作品に注意すべき物が少し有つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "後で或絵葉書屋を漁つて居ると、此処の王立博物館にあるリユウバンスの諸作中で僕の好きな「火神の工場を訪へる※ヌス」の絵葉書と並んで此童子の噴水の絵葉書もあつたので早速併せて買収めた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ手近なリユウバンス町へ曲つて画家が晩年を其処に送つて終焉を遂げた旧宅を訪うたが、今は其れが私人の有に帰して二戸に分れ、一戸の方は住む人も無く常に門を閉ぢて居るが、右の方の一戸は商会に成つて居て門を入つた内玄関の上にリユウバンスの石膏像が据ゑられて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "疎らなマロニエの樹立の中央に例の寛衣を着けて劔を帯び庇の広い帽を少し逸反らして被つた風姿の颯爽としたリユウバンスの銅像が立つて、其前にバナナや桜実を堆く盛つた果物屋の車が其れを輓かせて来た頸に綱を附けた三匹の犬と一人の老婆とに由つて店を出して居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
