[
  {
    "uuid": "4397e9be-ed32-5afa-901f-b04f1d52b16e",
    "entry": "乳母",
    "reading": {
      "primary": "うば",
      "alternatives": [
        "めのと",
        "おんば",
        "にゅうぼ",
        "ちうば",
        "ちおも",
        "ちも",
        "にゅうも",
