    },
    "definitions": [
      {
        "index": 1,
        "gloss": "trying one's luck",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今回は運試しのつもりで参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は宝くじで運試しをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "試しに一度運試しをしてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ずっと決めていたのです、やつに命がけの運試しをさせてやると。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、大将にたいへんなお願いだがね、俺は、ここでいちばん運試しをしようと思う。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後多忙を極めてゐて、実はまだその作品の載つた雑誌を手にしないでゐるが、実物を読まぬさきに運試しのやうな心持で、このノオトを書きつけておきたいのである。",
              "citation": {
                "source": "プログラム",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は賜暇を利用して外遊して、パリにたくさんある公営の賭博場へ行って運試しをやろうと考えた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを見た王子は、心の中で、「あれが梯子になって、人が登って行かれるなら、おれも一つ運試しをやって見よう」と思って、その翌日、日が暮れかかった頃に、塔の下へ行って「ラプンツェルや！",
              "citation": {
                "source": "ラプンツェル",
                "author": "グリム",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからして、山師のスティーフンが、芝居の一役を演ずる愉快さやら、すわり心地の悪くない俄か公爵の待遇に対する恋々たる執着心やら、悪漢に似つかわしい糞度胸のよい運試し根性やら、剣術にかけての自信やらからして本当の事はまさか打ち明けないと安心しきっておったんだ。",
              "citation": {
                "source": "サレーダイン公爵の罪業",
                "author": "THE SINS OF PRINCE SARADINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思われてまで苦労をするなんて」「いいやな、今度の五千さえ出来れば、俺も一かばちかの運試しをして、すっぱり止めるからな」　ミチは返事をしなかった。",
              "citation": {
                "source": "刺青",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "運試しです」「矢っ張り買でしょうな、こゝ当分は」「僕も然ういう直観です」「早速ながら、証拠金を戴いて置きましょう」「お客さまのと一緒に立て替えて置いて下さい」「お父さんが御承知ですか？",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "運試しとしてはこの上ありません」「百やって置けば三百円でした」「千やって置けば三千円。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はまさに起ち上りてまたさらに運だめし（ただし銃猟の事で）をしようとして、フト端然と坐している人の姿を認めた。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしたはいよいよお城へでかけて、みごとになぞをいいあてて、運だめしをするのだといって、もうそればかり待ちこがれていました。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウイリイは、そのまま世の中に出て、運だめしをして来たくなりました。",
              "citation": {
                "source": "黄金鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、試験というものは一種の運だめしで、実力の優ったものが必ず勝つとも限らないのですが、それも一回や二回ではなく、三回も四回もおなじ失敗をくり返すというのは、どう考えても判りかねます。",
              "citation": {
                "source": "白髪鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも彼でも運だめしだから、このまま行けるだけ行って見よう」　と勇気を奮い起こしてなおも底深く沈み入りました。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つい一昨日の晩も悪魔の夢を見ましたが、寝しなにお祈りをした後で、ふと思いついて骨牌で運だめしなどしたので、たしかにその罰で、神様があんな悪魔をお遣わしになっただね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一つ運だめしをやろう。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉凶いずれか、いわば、その運だめしともいえる城南の興行の瀬ぶみに、房枝は新団長の黒川とつれだち、横浜をあとに、東京へ出かけたのであった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と心の中で思って、家来もつれずたった一人、どこというあてもなく運だめしに出かけました。",
              "citation": {
                "source": "鎮西八郎",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはそこへ行って、運だめしをしてみようと思います。",
              "citation": {
                "source": "一寸法師",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると彼は硝子窓の下に人一倍細い頸を曲げながら、いつもトランプの運だめしをしていた。",
              "citation": {
                "source": "彼",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「軍隊の方をやめてこうしてこの町へやって来たのは、一つ自由の身になって運だめしをしてみよう、一ところに根のすわった生活をしてみようという考えからなんです。",
              "citation": {
                "source": "可愛い女",
                "author": "DUSHECHKA",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の運だめしと云つて、病院の医者を誘惑に行き、すげなく追ひかへされて戻つてきた。",
              "citation": {
                "source": "いづこへ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の運だめしと云って、病院の医者を誘惑に行き、すげなく追いかえされて戻ってきた。",
              "citation": {
                "source": "いずこへ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "桑田は今夜こそ是が非にも運だめしをする決心であつたので、片足を出入口の土間に踏み入れると共に、わざとらしく声を張上げ、「奥さん。",
              "citation": {
                "source": "人妻",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "重吉の家は新潟の旅館で、両親は早く死し兄が家督を取っていたが、経費ばかりかかって借財も年々｜嵩むばかりなので、いよいよ財産整理をした上家族をつれて朝鮮の京城へ移住し運だめしに一奮発するというのである。",
              "citation": {
                "source": "ひかげの花",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚ほ又少し心に餘裕のある場合にはこの自分の生命の繋がつてゐる――もうこれが最後の運だめしだと心得てゐる――下宿屋即ちこの粗末な古びた建物を飾ることを以て慰藉とした。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、二人はその運だめしに父Ｚ伯の邸へ行くことになった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "廃宅",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしどもは、それをもって、船にのってまいり、運だめしをすることにいたしましょう。",
              "citation": {
                "source": "忠義者のヨハネス",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "（あれをはしごがわりにしてのぼっていけるのなら、ぼくもひとつ運だめしをしてみよう。",
              "citation": {
                "source": "ラプンツェル",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "運だめしでもしようと思ってね。",
              "citation": {
                "source": "いさましい　ちびの仕立屋さん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
