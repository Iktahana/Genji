[
  {
    "uuid": "76338de8-baaf-56f0-8436-ce05cae34900",
    "entry": "運試し",
    "reading": {
      "primary": "うんだめし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
