      {
        "index": 1,
        "gloss": "to be launched (e.g. rocket)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "探査機が無事に打ち上がったと知らせが届き、管制室に拍手が広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ロケットが轟音とともに打ち上がり、見学していた人々から歓声が沸いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "花火が次々と夜空に打ち上がり、川沿いを埋めた人々が一斉に見上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "月光の谿緑ヶ丘夜景角の月黄にしめる横雲のうへ、燦爛とうちあがる青きぬがさ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "角の月黄にしめる横雲のうへ、燦爛とうちあがる青きぬがさ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日の昼頃まで静穏だった海が急に夕方から荒れだし、浅瀬の高波が中甲板までうちあがるようになった。",
              "citation": {
                "source": "海難記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to be washed up (on the shore)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
