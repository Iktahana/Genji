          "literary": [
            {
              "text": "土地の人は此所を「ウタレ」というて居る。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がぶら／＼と歩いて居ると私の後から「ウタレ」を伝うて来るものがある。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると「ウタレ」に近い暗礁の上に一人釣をして居るものがある。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "弓なりの網を持つた人はもう遥かに「ウタレ」を走りつゝ小さくなつて居る。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "だん／＼行くと「ウタレ」に近く大きな棚があつた。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダウタレのタイプがあるんだ。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
