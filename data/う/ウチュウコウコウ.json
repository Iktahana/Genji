        "examples": {
          "standard": [
            {
              "text": "長期間の宇宙航行において、乗組員の精神的な健康をいかに維持するかが大きな課題だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "恒星間を渡る宇宙航行を実現するには、現在の技術を遥かに超える推進装置が必要となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "宇宙航行中の緊急事態に備え、船内では毎日入念な避難訓練が行われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "宇宙航行用の高速通路建設のために、ある日突然、乱暴な工事主任によって地球が取り壊しの目に遭う――。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
