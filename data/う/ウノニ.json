        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナルホド　マルイ　トコロヲ　ミルト　ケイキキユウノニ　チガヒ　アリマセン。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハソンナニ子供ガ好キジャゴザイマセンノ」トカ、「死ノ灰ガ降ルッテ云ウノニ沢山生ンダッテ仕様ガナイジャアリマセンカ」トカ云ッタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月モ中旬ダト云ウノニコノ暑サハ異常デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻走感ト云ウノニ似テイルガ、アンナ生ヤサシイモノデハナク、モット強ク激シイ痛ミデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガ云ウノニ、自分ハ昔ＰＱ病院ニ勤務シテイタコトガアッタガ、昨日午後一時間ノオ暇ヲ戴イテ歯ノ治療ノタメ品川マデ参リマシタラ、ソノ歯科医院デ偶然ＰＱ病院時代ノ福島博士ト云ウ整形外科ノ先生ニ出会ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………木村ハ試験デ忙シイトイウノニ、僕以上ニ熱心デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ私カニ思ウノニ、却ッテ僕ガソウシタ方ガ「気ガ楽ニナリ」ハシナイデスカ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チキュウノニンゲン、アレＲスイセイトイウ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノホシデハ、ウチュウノコト、ミナ、シラベテ、ワカッテイルノデス、ワタシ、チキュウノニンゲンヨリ、百バイ、カシコイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "チキュウノニンゲンノ、デキナイコト、デキル。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
