  {
    "uuid": "b3f8252e-ff67-58c2-9abb-cff9f750fc5e",
    "entry": "熟れ",
    "reading": {
      "primary": "うれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
