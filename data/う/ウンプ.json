    },
    "definitions": [
      {
        "index": 1,
        "gloss": "good and bad fortune",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人生は運否によって左右される部分も大きいと、祖父がよく言っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "成功者たちも運否に恵まれていたと謙虚に語っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "運否が同じでも、努力する人としない人では結果が違う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "世界や國家や團體や個人に取つての好運否運といふが如きは、實は運命の一小斷片であつて、そしてそれに對して人間の私の評價を附したるに過ぎぬのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、銀行などで事をきめるのは、運否天賦というものですからね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうして運否天賦なんだい？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちっとも運否天賦なんてことはないぜ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあこれからは、おれたちの運否天賦だ。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "書類が無くなるかどうかは運否天賦の賭けだったのです。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "運否天賦、なんとか自家用車でフェアフォードに着き、夕食会に間に合った。",
              "citation": {
                "source": "鉄面皮",
                "author": "A Front of Brass",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでゐて、いつのまにかそれぞれ私の心の中にまでもはひつて来て、そこいら一杯にしなやかな枝葉を拡げ、ぎごちない幹をくねらせ、また咲きこぼれた花の匂をうんぷんと撒き散らしてゐる。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
