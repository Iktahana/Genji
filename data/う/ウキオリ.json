        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "浮き織りの帯は光沢のある模様が立体的に浮かび上がり、晴れ着によく合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "祖母が嫁入り道具として持ってきた浮き織りの着物は、今も鮮やかな色を保っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その洋服店では浮き織り生地を使ったジャケットが一番人気だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "支那の浮き織りの綾でできた袋で、上という字が書かれてあった。",
              "citation": {
                "source": "源氏物語",
                "author": "橋姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤に白く唐草を浮き織りにした絹紐を輪に結んで、額から髪の上へすぽりと嵌めた間に、海棠と思われる花を青い葉ごと、ぐるりと挿した。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "水のおもてのかがやきは浮き織りにした銀の糸のどかなのどかな五月です。",
              "citation": {
                "source": "歌時計",
                "author": "童謠集",
                "note": "青空文庫"
              }
            },
            {
              "text": "その広いすそ野のふちを、青黒い色の海が、うねりをあげ、そして、もやのかかる松林や、白い砂の浜辺は、浮き織りの模様のように見えるので、さすがに天女も、しばらくはわれを忘れて、見とれずにはいられませんでした。",
              "citation": {
                "source": "羽衣物語",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "けんかたばみの紋服に、浮き織りの野袴を裾短かに穿き、金銀ちりばめた大小を、そりだかに差した人品は、旗本衆の遊山旅か、千石以上の若殿の、気随の微行とも想われたが、それにしてはお供がない。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、お初にお目に懸りまする、いかがでごわりまするか、ますます御翻訳で、とさぞ食うに困って切々稼ぐだろう、と謂わないばかりな言を、けろりとして世辞に云って、衣兜から御殿持の煙草入、薄色の鉄の派手な塩瀬に、鉄扇かずらの浮織のある、近頃行わるる洋服持。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "豐岡から來る間、夕雲の低迷して小浪に浮織の紋を敷いた、漫々たる練絹に、汽車の窓から手をのばせば、蘆の葉越に、觸ると搖れさうな思で通つた。",
              "citation": {
                "source": "城崎を憶ふ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の末にもなりたれば、籐筵に代うるに秋野の錦を浮織にせる、花毛氈をもってして、いと華々しく敷詰めたり。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄紅色の浮織りのクッション、白い蒲団のカバー。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "零時二十三分、日の光はヴエニス模様の色硝子を透かして※掛の浮織を悩まし、人も居ない珈琲店の空椅子には、今恰度真白な猫がまるで乳酪の塊のやうにとろみかけてゐる。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "白地に孔雀を浮織にした唐織の帯には、帯止めの大きい真珠が光つてゐた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "白地に孔雀を浮織にした唐織の帯には、帯止めの大きい真珠が光っていた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "深雪は、涙ぐみながら、大久保小紋の正月着、浮織の帯、小太夫鹿子の長襦袢、朧染の振袖と、つづらから出して、積み上げた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "金ぶちに浮織絹をはった長椅子のある立派な広い室で、藤堂駿平は多勢の人にかこまれながら立って、葉巻をくゆらしていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "清らかな、純白な、野菊に似た無数のマルゲリトは、柔かい青芝生の広庭一面に、浮織の様に咲き揃ふて居る。",
              "citation": {
                "source": "土民生活",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュレキュは椅子に掛けながらふと見ると、椅子の背にバロック模様の彫刻の中にＭという字が組み合せてあり、卓布にもＭという花文字が浮織になっていた。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色い菜の花が織物の地で、白い梨子の花は高く浮織りになつてゐるやうだ。",
              "citation": {
                "source": "斑鳩物語",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "梨子の花は其等に頓着なく浮織りになつて遠く彼方に続いて居る。",
              "citation": {
                "source": "斑鳩物語",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "果してこの異国の花卉を浮織にした絨毯はその後あまり役に立ったとは見えなかった。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "風は紋羅の浮織に人と草との舞のあや――ほのに映れる花姿、弱肩、それとさだめなく。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち武田伊那丸は、眉目をあさく藺笠にかくし、浮織琥珀の膝行袴に、肩からななめへ武者結びの包みをかけ、木隠龍太郎は白衣白鞘のいつもの風姿、また加賀見忍剣もありのままな雲水すがた、手には例の禅杖をつっ立てている。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かに仕度を済ませて式台に現われた姿を見るに、鎖着込みは下に隠し、浮織万字の黒羽二重に緞子の野袴、白鮫柄の脇差｜金象嵌角鍔の大小をぶッちがえに差し、曳き寄せた駒にひらりと跨って、時刻を待つほどに目付奉行の伝令が来たので、一同はそれッとばかり長蛇の陣をなして、威風凜々、由良川の上流指して出発した。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その粧いはとみれば、髪には垂鬘をつけて紅白の葛の根がけを用い、打掛は、白無垢の丸生絹に幸菱の浮織――それを諸肩からぬいで帯のあたりに腰袴のように巻いていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "西陣だが浮織だが知らねえが、このあでやかな女の帯を、谷底へ抛っておけば、どこへ引ッ懸っても夜でも目につくにちがいない」「だが、途中で風に攫われないように」「おっ、心得た」　と金右衛門は、断崖の這い松に引ッかかっていた月江の帯を輪に巻き、谷底を目がけてポーンとそこから真っすぐ下へ抛り投げました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "織方も様々で、浮織といって、模様の部分を浮き糸にさせるものや、綾織や絽織や、変化が多いのであります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いては浮織の類なのです。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "素晴らしい絣や縞や浮織の着物が色々と茣蓙の上に拡げてあります。",
              "citation": {
                "source": "沖縄の思い出",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "巌流は、浮織の白絹の小袖に、眼のさめるような、猩々緋の袖無羽織をかさね、葡萄色の染革の裁附袴を穿いていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "見るとそれは、ところどころ火に焦がされた女の被布、浮織唐草の江戸紫は、まぎれもなく、お綱の着ていたものである。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
