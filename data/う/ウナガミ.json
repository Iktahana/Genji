          "literary": [
            {
              "text": "兄のオホマタの王の子はアケタツの王・ウナガミの王の二人です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウナガミの王は、比賣陀の君の祖先です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かようにしてアケタツの王とウナガミの王とお二方をその御子に副えてお遣しになる時に、奈良の道から行つたならば、跛だの盲だのに遇うだろう。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで天皇がお歡びになつて、ウナガミの王を返して神宮を造らしめました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
