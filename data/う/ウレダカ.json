    "definitions": [
      {
        "index": 1,
        "gloss": "sales",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先月の売れ高は前月比で15パーセント増加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "店舗の売れ高を集計するのが営業報告の重要な業務だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "製品の売れ高が目標を上回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それから酒屋の主人に帳簿を出さしてしらべて見ましたが酒の売れ高がこのごろ毎年減って行くやうであります。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にはあの村はみんな濁り酒ばかり呑んでゐたのにこのごろ検挙が厳しくてだんだん密造が減るならば清酒の売れ高はいくらかづつ増さなければいけない。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "▼出品者にむかつて、号数の制限といふ進歩的団体にふさはしからぬ規定をつくつたなどは、明らかに独立内部の弱化面を曝け出した、出品画の大きさの制限によつて、どれだけ出品者がそれによつて内容的な実質的な絵を描いたかは問題だ、カンバスの枠の大きさの制限は、絵具屋の絵具の売れ高を幾分減らした位のものであらう。",
              "citation": {
                "source": "小熊秀雄全集-20",
                "author": "大波小波",
                "note": "青空文庫"
              }
            },
            {
              "text": "文芸時評の売れ高の少ないのは当人の自白したとおりであるのに、麗々しく彼のいわゆる大論文を掲げて得意がるのは、虚栄心の満足以外になんのためになるだろうと疑っていたが、これでみると活版の勢力はやはりたいしたものである。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞の小説の噂、文壇のゴシップ、円本の売れ高、等々。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "老奥方のお辞儀は段々ふえて、売れ高はグングン減ってゆくが、そんな事に頓着のない老媼は隣店の売行きを感嘆して眺め、ホクホクしていう。",
              "citation": {
                "source": "木魚の配偶",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は聊か恐縮しながら、止むを得ず「傀儡師」の売れ高を答へた。",
              "citation": {
                "source": "岩野泡鳴氏",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕よりも著書の売れ高の多い新進作家は大勢ある。",
              "citation": {
                "source": "岩野泡鳴氏",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――僕は二三の小説を挙げて、僕の仄聞する売れ高を答へた。",
              "citation": {
                "source": "岩野泡鳴氏",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　先生の文章は其売れ高より言えば決して偉大なる者ではなかった。",
              "citation": {
                "source": "文士としての兆民先生",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "文芸時評の売れ高の少ないのは当人の自白した通であるのに、例々しく彼の所謂大論文を掲げて得意がるのは、虚栄心の満足以外に何の為になるだらうと疑つてゐたが、是で見ると活版の勢力は矢張り大したものである。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "売れ高、東京随一の実利的名声は、遂に黒光女史の名声までを圧してしまった。",
              "citation": {
                "source": "四谷、赤坂",
                "author": "宮島資夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "同業者中にはここまで辛抱が出来ず、原料高に堪えかねて材料を落し、あるいは分量を減じて赤字から免れることに腐心するうち、次第に得意の信用を失い、ようやく平和となって利益の見られる時分には売れ高著しく減じて、とうとう破産したものも少なくない。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の語彙は政治家が減らしつつあるものを、小説家がいくらかふやしている現状であるが、小説家には都会の中流以上の人たちが共鳴してくれればそれで売れ高が上るという考えがあって、どうも田舎者を馬鹿にする傾向が多い。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな人のが売れ高はいいらしい。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはどこの蓄音器屋でも一致した現象で、どんな名曲名演があっても、ピアノやヴァイオリンや歌のレコードは、売れ高において管弦楽の足下にも寄りつくことではない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術家としての彼は己れに篤き作品を自然の気乗りで作り上げようとするに反して、職業家としての彼は評判のよきもの、売高の多いものを公けにしなくてはならぬからである。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、数ある本屋のなかで、チヤーチル物の売高にかけては、いつの月も記録を取つてゐるのはこの本屋だ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "文士某がこの地の名妓仇国と心中したる時の遺書は一巻の小説として出版せられその売高は以てその生前の負債を償ひたる事あり。",
              "citation": {
                "source": "四百年後の東京",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "熟柿くさい息をハーハー吸きながら売上りの銭を目の前にならべて今日の売高がすくないと小さい娘を叱かりつけて居る恐しげな父親の様子が思い出されて、娘が可哀そうだと思う心は尚々まして来る。",
              "citation": {
                "source": "同じ娘でも",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治五年二月より明治十年十月まで学問ノ勧メ発売高合して五十九万八百四十六部、彼れが明治の開化史に於て偉大なる影響を及ぼしたるや知るべきのみ。",
              "citation": {
                "source": "明治文学史",
                "author": "山路愛山",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを米国百貨店の販売高の一割六分、独逸百貨店の同じく一割三分五厘に比すれば、その半額にも足らぬのである。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "販売の均一　商売はその種類により、季節により、また晴雨その他のいろいろの事情によって繁閑がありますので、販売高を毎日平均せしむる事は不可能でありますが、経営上の理想と致しましては、毎日平均の売行きを望むものであります。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "一小売商人の一年の平均販売高は五千円に満たず、その利益千円に足らざる収入で、どうして、高い家賃を支払い、高率の営業税を払って生活して行けるだろうか。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに百貨店の一年の販売高は五千万円にも上るものがある。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、パン、和洋菓子、喫茶、食事等にわたって各部門ごとに一人当りの製造高や販売高を調べると、製造高から見ると従来の日本菓子の職人は一日一人二十円くらいのものだがうちではその二倍四十三円くらいこさえている。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がロンドンの某百貨店支配人に会った時、ついうっかりして「商品切手の御発売高は」ときいたので、この人は不思議そうな顔をして、「商品券とは何ですか」とあべこべに質問されました。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしメルキオルは、書物の売高でその償いは取れてあまりあるものだと、少しも疑わなかった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにも拘らず、素人の人気は非常で、会期中この像の前は観客の黒山を築き、絵ハガキの売高はレコードを作ったと言われて居ります。",
              "citation": {
                "source": "踊る美人像",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば世界の一年の商売高が五百億あるとすると、この中｜英吉利が幾ら、亜米利加が幾許、日本が幾らという事を見、更に亜米利加は日本の何倍に当り、英吉利は亜米利加と幾らの差があるというような事を考え、それからまた十年前とか二十年前とかと比較を取ってみる。",
              "citation": {
                "source": "我輩は何故いつまでもすべてに於て衰えぬか",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
