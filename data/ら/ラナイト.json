          "literary": [
            {
              "text": "聖ピーター君ガ私ニ三度モ知ラナイト云フ　ヤ否ヤ　鶏が羽搏ク……　　　　　オツト　お湯ヲ　コボシチヤ　タイヘン――",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ一生懸命ニ気ヲ静メヨウ、興奮シテハナラナイト自分デ自分ニ云イ聞カセタガ、オカシナコトニ、ソウ思イナガラ、彼女ノ足ヲシャブルコトハ一向ニ止メナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………アレカラ既ニ二時間以上経ッテイル筈ダガ、マダ血壓ガ下ラナイト見エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルヘ戻ッテ何シテタンダ」「寒クナリソウダカラ着換エテ来タノヨ、オ爺チャンモ気ヲオ付ケニナラナイト風邪ヲ引クワヨ」四条通リデ買ッテ来タノヲ早速着テ見タカッタノダロウ、白ノブラウスニ、ブリューニ銀ノラメガ繍イ込ンデアルセーターヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "足ノ下ノモロ／＼ノ虫ドモハ七日間危害ヲ蒙ムラナイトシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
