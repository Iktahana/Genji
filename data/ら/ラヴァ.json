        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "下り坂の茶店で休んだときにそこのお神さんが色々の火山噴出物の標本やラヴァやカメーの細工物などを売付けようとしたが、こしらえもののいかものだけはわが地質学者を欺く訳に行かないのがおかしかった。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "じっさい、トーイズの〈ラヴァーズ・コンチェルト〉なんて、ギターコードでゴリゴリとは、およそ無関係な曲も好きだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "之等は、合図の下に、ラヴァラヴァを褌ほども短く着けた数人の若者によって、食物群中から運び出される。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど噴火山が破裂してラヴァが顔の上を流れたようなもので、親が生んでくれた顔を台なしにしてしまった。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "佛教の毘沙門は一切の夜叉の王たるに、印度教のはラヴァナに寶車を奪はるゝ程弱い者なれば是れ亦同じからず。",
              "citation": {
                "source": "再び毘沙門に就て",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「相変わらずご熱心さ」「もうエンゲージができたのか」「当人同士はできてるんだろうけれど、家では両方ともむずかしいという話だ」「おもしろいことになったものだねえ」と清三は考えて、「ＹはいったいＶのラヴァだったんだろう。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆は五合目の観測所の小屋に泊るので、僕はそこをスキー・デポとしてアイゼンを履き、中食ののち、宝永山の尾根へトラヴァースした。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは、エルカラとコラヴァとカスワとイルラの四つの姓閥からできあがっていた。",
              "citation": {
                "source": "ヤトラカン・サミ博士の椅子",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二十六日（土曜）　ヴィシー政府首相ラヴァル以下東部フランスへ逃亡、二十日朝、ペタン、ヴィシーを脱出す、夫人と共に。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の前にいた若者は、無視しようとしても耳に入る文句にいらいらし、靴の爪先をばたばたやっていたが、遂にくるりと窓の方を向いて濠を見下しながら、トラヴァトウレを口笛で吹き出した。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小官吏の娘アンナ・カラヴァーエ※は中学を卒業し、農村小学校の教師として赴任した頃だった。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ・カラヴァーエ※は率直に書いている。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十月」にはびっくりした若い女教師アンナ・カラヴァーエ※だって、いつまでも呆然としてはいなかった。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "党員となったアンナ・カラヴァーエに「岸」という小説を書かせている。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラヴァーエ※の作品はどちらかというと事務的で、文章に性格がなく新しい味わいにとぼしい。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ・カラヴァーエ※は一九三〇年にオソアビアヒムの文学サークル指導をしていたし、同じ年赤軍の文学サークルの作った戯曲「第一騎兵隊」を完成上演させるために努力した。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナチスの侵略に対してソヴェトの全人民が、世界の平和と社会主義の祖国を防衛した第二次世界大戦の防衛戦において、ヴェラ・インベルもカラヴァーエ※も飛躍的な経験をした。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人の作家――もとは小学校の女教師で党員作家であるアンナ・カラヴァーエヴァも出かけた。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その風味を、ひょいと味って見ようとした者に、サラヴァンという男がいる。",
              "citation": {
                "source": "奇怪な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラヴァンは、ジョルジュ・デュアメルの小説中の人物だが、或る商事会社に勤めていて、社長の前で事務の説明をしている時、ふと社長の左の耳に眼をとめる。",
              "citation": {
                "source": "奇怪な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラヴァンはそっと手を差出す。",
              "citation": {
                "source": "奇怪な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラヴァンは気抜けがしたように、ぼんやりしてしまう。",
              "citation": {
                "source": "奇怪な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "社長にとっては、サラヴァンは一人の狂人であったろう。",
              "citation": {
                "source": "奇怪な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その神経衰弱者の最もよいタイプを、吾々はジョルジュ・デュアメルのサラヴァンに見出す。",
              "citation": {
                "source": "意欲の窒息",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラヴァンはまだ生きて動いている。",
              "citation": {
                "source": "意欲の窒息",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "がサラヴァンの前半生、「深夜の告白」や「新らしき邂逅」の中のサラヴァンは、神経衰弱以外の何物でもない。",
              "citation": {
                "source": "意欲の窒息",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラヴァンは貧困ではあるが饑えてはいなかった。",
              "citation": {
                "source": "意欲の窒息",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当の意欲を窒息さして現実から遊離した想念のうちに人を駆り立てる神経衰弱は、社会の各方面に、各種のサラヴァンを作り出している。",
              "citation": {
                "source": "意欲の窒息",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
