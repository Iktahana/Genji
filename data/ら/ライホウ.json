[
  {
    "uuid": "50ec5064-f48a-5da6-9d80-737e9180cb43",
    "entry": "来訪",
    "reading": {
      "primary": "らいほう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "visit (from someone)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "遠方からの来訪者があり、一日中観光案内をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "首相の突然の来訪に、住民は驚きを隠せない様子だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お客様が来訪される前に、会議室の準備を整えておこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "来訪客と話すことも、昔のように苦しくなく、時に却って歓迎するほどでさえもある。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つは端書で「今朝ハ失敬、今日午後四時頃夏目来訪只今（九時）帰申候。",
              "citation": {
                "source": "子規自筆の根岸地図",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関のベルが鳴ると女中は吉田敏子の来訪を告げた。",
              "citation": {
                "source": "かれいの贈物",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡単平凡な例を取れば、対話中に来訪者のベルを響かせて、次に現われて来る人間を紹介する類である。",
              "citation": {
                "source": "耳と目",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターリングの家の来訪者名簿には、内外の一流の学者の名前の外に英国一流政治家の名前も見える。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはとにかく、自分らの教室にとっては誠に思いがけない遠来の珍客なので、自分は急いで教室主任のＮ教授やＴ老教授にもその来訪を知らせ引き合わせをしたのであったが、両先生ともにいずれも全然予期していなかったこの碩学の来訪に驚きもしまた喜ばれもされたのはもちろんである。",
              "citation": {
                "source": "Ｂ教授の死",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "来訪の諱五路の骨董屋と、母が話相手をしていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬賊上りの、つわものゝ、中津の来訪は、この不安と恐怖に、若干の、主観的な緩和剤となったのである。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のところへ来る客は、自分もまあこれでも、小説家の端くれなので、小説家が多くならなければならぬ筈なのに、画家や音楽家の来訪はあっても、小説家は少かった。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "掟三章（其中庵来訪者の）を書いて貼つて置いた。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑石君はまだ見ぬ友のなかでは最も親しい最も好きな友であつた、一度来訪してもらふ約束もあつたし、一度徃訪する心組でもあつた。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹明君徃訪（学校に）、大村君来訪（午後半日）。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は独壺君来訪、三人で飲みながら話した、とても愉快な一夜だつた。",
              "citation": {
                "source": "行乞記",
                "author": "広島・尾道",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は若い巨村君来訪、奥さんも仲間入、朝からのほろ酔機で、夜の更けるのも忘れて行乞漫談。",
              "citation": {
                "source": "行乞記",
                "author": "広島・尾道",
                "note": "青空文庫"
              }
            },
            {
              "text": "多賀さん来訪、生れて初めて蓴菜をよばれる、横旗さん来訪、葡萄をよばれる、波田さんら二人来訪。",
              "citation": {
                "source": "行乞記",
                "author": "広島・尾道",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹明君来訪、積る話は尽きなかつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "めづらしや女性来訪、Ｆ屋のおばさんとちいちやん、水仙もらひに寄つたのです、紅茶を御馳走する。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこの家へ行くのは、どうも大儀だ、窮屈だ、と思ひながら渋々出かけて行く時には、案外その家で君たちの来訪をしんから喜んでゐるものである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころには私も或る無学な田舎女と結婚していたし、いまさら汐田のその出来事に胸をときめかすような、そんな若やいだ気持を次第にうしないかけていた矢先であったから、汐田のだしぬけな来訪に幾分まごつきはしたが、彼のその訪問の底意を見抜く事を忘れなかった。",
              "citation": {
                "source": "列車",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく私にとって、そのような優雅な礼儀正しい酒客の来訪は、はじめてであった。",
              "citation": {
                "source": "酒の追憶",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "来訪客と話すことも、昔のやうに苦しくなく、時に却つて歓迎するほどでさへもある。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二博士が余の意見を当局に伝えたる結果として、同日午後に、余はまた福原専門学務局長の来訪を受けた。",
              "citation": {
                "source": "博士問題の成行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな親しい人ならば、どんな貧しい肴でも恥ずかしくないし、家の者に聞かせたくないような話題も出る筈はないのであるから、私は大威張りで実に、たのしく、それこそ痛飲できるのであるが、そんな好機会は、二月に一度くらいのもので、あとは、たいてい突然の来訪にまごつき、つい、外へ出ることになるのである。",
              "citation": {
                "source": "酒ぎらい",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから約二箇月間、静子夫人の来訪はなかったが、草田惣兵衛氏からは、その間に五、六回、手紙をもらった。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と私は、この久し振りの周さんの来訪に胸を躍らせ、玄関に飛んで出て歓迎したが、周さんは、へんに尻込みして、「いいの？",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまたこの家の主人に対して先輩たる情愛と貫禄とをもって臨んでいる綽々として余裕ある態度は、いかにもここの細君をしてその来訪を需めさせただけのことは有る。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メッチェンの来訪です。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時くらいほうほう鳥を嬉しく思ったことはない。",
              "citation": {
                "source": "霧の中",
                "author": "――「正夫の世界」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これだって、石の一つぐらいほうれらアね。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時過、和木清三郎、倉島竹二郎來訪。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
