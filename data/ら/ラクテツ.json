        "examples": {
          "standard": [
            {
              "text": "最終コーナーで馬が落鉄してしまい、惜しくも入賞を逃してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "レース前に蹄鉄のチェックを怠ったことが、今回の落鉄の原因かもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "落鉄した馬の脚を保護するために、装蹄師が手際よく新しい蹄鉄を打ち直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "『つらくてつらくて、言葉にできないくらいです。",
              "citation": {
                "source": "患者兼同居人",
                "author": "THE RESIDENT PATIENT",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしが断ったのが、つらくてつらくてたまらなくなったのでございます。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
