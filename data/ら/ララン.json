    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近世の科学者中にてもニュートンの如き敬虔なる信仰家ありといえども、その多くは仏の天文学者ラランドの類である。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れラランドは一生涯を天体観察に献げた人であるが、彼は言うた「余の望遠鏡に神の映りし事なし、故に神は在る者に非ず」と。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝ころがってひざを立てたまま、慶一は右足で一、三拍を叩き、高志は右ひざをシンバル、左ひざをスネアにして、二、四拍を叩き、その音はしだいに大きくなり、フェイドアウトのギター・リフを、「パラララン」と口ずさんだころには、右足で柱を蹴っていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その条路の突き当りで、カラカラランと云う音がした。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後のカラランは底の底から出て、出るにはよほど手間がかかる。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て日本へ來た佛蘭西の植物學者、ブラランゲン教授が、學校の庭に咲き盛つてゐる躑躅の花を見て説明された事が思ひ出される。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "講師はソルボンヌ大学の植物学者として有名な、ブラランゲ氏と私とただ二人だ。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラランラ、ララ……。",
              "citation": {
                "source": "鍵から抜け出した女",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラランララ、ラランララ」「うわーイ。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラランララ、ラランララ。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分古い昔のこと、ヱヴェレストのはるか麓に、ラランとよぶ一｜羽の鴉が棲んでゐた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラランの悪知慧は有名なもので、ほかの鳥がうまく飛んでるのを見ると、近寄つては自分の尖つた嘴先でチクリと刺して墜落させてしまふのだ。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもあのヱヴェレストの頂上だけは、見上げたゞけでも目が眩んで、何度もそこまで飛んで見ようとしては、半分もゆかないうちに、疲れてしまつたラランはゾグゾクしながら、その度に羽を縮めて残念さうに顔をしかめるのだつた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　柄にもなくこんなことを考えて、西蔵に棲んでる仲間の鴉を一々たづねて話したが、皆は日頃ラランの悪知慧をよく知つてゐるので、誰も一緒に飛ばうとするものがなかつた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラランは不気嫌だつた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　ラランはかう答へるや否や、もう、羽をひろげた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラランに続いてペンペがサッと密林の上に飛び出した。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラランよ、ヱヴェレストのてつぺんはまだ遠いか。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラランよ、何かたべるものはないか。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フト気がつくと、先に飛んでゐるラランが何が旨味いものでもたべてゐるやうな音をたてゝ、喉を気持よく鳴してゐる。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペンペはもう我慢ができないで、『ラランよ、たべるものがあるなら分けてくれ。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、疲れてきた羽にバサバサと力を罩めて、追ひつかうとするけれど、ラランのやつはさつさと先へ飛びながら、着ち｜ついたもので、『おい、ペンペよ。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらか元気も出てきたので、ラランについて上へ上へと飛んでゐた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると間もなく先にゆくラランが前のやうに喉を鳴らしはじめた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ラランよ、今度は何をたべてるのか。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹が減つて僕はもう目が廻りそうだ』　ラランはすまして答へた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "たうとう盲目になつたペンペは、ラランの姿を見失ひ、方角も何もわからなくなつて、あわてはじめたがもう遅かつた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ラランよ、ラランよ、』と叫ぶ。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
