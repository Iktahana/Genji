  {
    "uuid": "8bd027d1-f70d-5649-a99c-92967b1e943b",
    "entry": "ララン",
    "reading": {
      "primary": "ららん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
