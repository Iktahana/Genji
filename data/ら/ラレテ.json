        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "常ニ幸セラレテ従フ。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ミルト　カジヤノ　テニハ、カナヅチガ　ニギラレテ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フエフキハ、タカイ　トコロデ　ハタライテ　ヰル　ダイクノ　テニ　カナヅチガ　ニギラレテ　ヰルノニ、ハジメテ　キガ　ツイタヤウニ　オドロキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イクラ　シカラレテモ、ヒトツノ　タケノコハ　ドンドン　トホクヘ　モグツテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコガ　メヲ　サマシテ　ミルト、コレハ　マタ　ドウシタ　コトデセウ、メノ　マエノ　オ花バタケガ　ムチヤクチヤニ　フミニヂラレテ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "バシヤハ　キリキリト、キシリナガラ　ヒツパラレテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "バシヤハ、キリクルト　ナリナガラ、カイドウヲ　ヒツパラレテ、イキマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンハ　マタ　ウバグルマニ　ノツケラレテ、イツテ　シマヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ投票神權説ニ累セラレテ、鮮人ニ先ヅ參政權ヲ與ヘテ政治的訓練ヲナスベシト考フルハ、其ノ權利ノ根本タル覺醒的生長ヲ閑却シタル愚人ノ云爲ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ愚昧ナル善人ガ斯ル惡魔ノ喇叭卒ニ使役セラレテ其レヲ日本ニ向ツテ吹キシコトハ米國史上空前ノ恥辱ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "獨逸ノ敗因實ニ其ノ始メニ於テ背後ニ迫レル露軍ノ爲メニ巴里占領ノ好機ヲ逸シ、更ニ英國艦隊全部ヲ本國ニ集中セシメタルガ爲メニ一擧根本ヲ屠ル能ハザルノミナラズ、却テ其ノ艦隊ヲ「キール」軍港ニ封鎖セラレテ國内物質ノ空乏ヲ來シ僅カニ潛航艇戰ノ窮策ニ訴フルヤ、又却テ米國ヲ脅威シテ之ヲ敵ニ驅リシニ基ク。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜多流宗家｜六平太氏未ダ壮ナラズ、嘱セラレテ之ヲ輔導ス。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "身体ハ押エラレテ動ケマセヌ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ勿論権利ガアルトハ思イマセンケレ共、余リ乱暴ナ言イ方ナノデ私モ二言三言申シマスト、　「一体アナタハホントニ私ニ可愛ガラレテ居タト思ウノ？",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミズガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリッタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボロウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行っただろうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミヅガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリツタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボラウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行つただらうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル未知電波ノウチノアルモノハ、時ニ雑音トイウ名ノモトニワレワレニ知ラレテイル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "借金スルノハツライモノ鍋釜マデモミンナ取ラレテスツテンテンと、途方もない自暴を飛ばしたのもある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先ヅ槍ヲ以テ敵ニ向ヒ、切折ラレテ後、棒トナル、又棒切折ラレテ半棒トナル……」　そこで彼は独流の型を使いはじめました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラブラドンドン　トユラレテカラダヂウガイタミマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ミンナカラタイソウ　ホメラレテヲリマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ母サン　ニツレラレテ学校ヘ行ツタノヨ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨガ　アケルト　ブチト　シロハ　オユニイレラレテ　ゴシゴシト　アラハレマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなにウルサガラレテゐながら、この溌溂とした美少女が私のやうな痩せ衰へたやくざ者の身辺を立ち去らないのは実に一種の不合理である、と、私はいはば厭がらせのやうにこうお世辞を言ふのです。",
              "citation": {
                "source": "帆影",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "乍チニシテ島原ノ妓楼廃止セラレテ那ノ輩這ノ地ニ転ジ、新古互ニ其ノ栄誉ヲ競フニオヨンデ、好声一時ニ騰々タルコトヲ得タリ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "与田準一李箱海兵ガ氾濫シタ　海兵ガ――――軍艦ガ靴ノ様ニ　脱ギ捨テラレテアツタ",
              "citation": {
                "source": "与田準一",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアノ揚巻ノ顔ヲ見テルダケデモイクラカ痛ミヲ忘レルンダ」予ハ婆サンニ窘メラレテ一層｜依怙地ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
