          "literary": [
            {
              "text": "結局、アイウエオの各行中に一行全部が使われているのは「ラリルレロ」だけ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラリルレロが駄目ね」　と田鶴子さんが僕に囁いた。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "小鳥も我々の見なれないのがいろいろあるが、皆、ラリルレロの気持のいい音を高く囀る。",
              "citation": {
                "source": "蝗の大旅行",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
