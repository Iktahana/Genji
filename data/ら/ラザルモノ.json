          "literary": [
            {
              "text": "若シ然ラズシテ長ク毒水ノ横流ニ任セバ臣ハ恐ル其禍ノ及ブ所将サニ測ル可ラザルモノアランコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ花鈿委地ノ惨禍亦深ク哀シムニ足ラザルモノ有リ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "即チ其通義トハ人ノ自カラ生命ヲ保シ自由ヲ求メ幸福ヲ祈ルノ類ニテ、他ヨリ之ヲ如何トモス可ラザルモノナリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ時勢ノ変ニシテ兵法ノ一定シテ論ズベカラザルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ然ラズシテ長ク毒水ノ横流ニ任セバ、臣ハ恐ル、其禍ノ及ブ所将ニ測ル可ラザルモノアランコトヲ」　最後はまた、次のような哀切極まる文字をもって結んであった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
