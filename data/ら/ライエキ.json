[
  {
    "uuid": "8e157bd0-4b8f-5353-a7b6-146ab264c752",
    "entry": "来益",
    "reading": {
      "primary": "らいえき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
