[
  {
    "uuid": "af0f1e2b-b65d-55fe-bda2-236dfd064482",
    "entry": "来宗",
    "reading": {
      "primary": "らいたかし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
