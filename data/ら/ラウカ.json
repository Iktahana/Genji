        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "女房達『やや中納言殿、軍のさまは如何にや、如何に』と問ひ給へば『只今珍らしき吾妻男をこそ、御覧ぜられ候はんずらめ』とて、からからと笑はれければ」などといふところでも、やはり白いお歯をちらと覗かせてお笑ひになり、アカルサハ、ホロビノ姿デアラウカ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに彼がラウカの戦線で味方の負傷兵と重砲とを救った語は、ほとんど全軍に知れた話である。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ハ二人ガ眠テ居ルラシイ事ヲ室ノ外カラウカガッタ後、障子ヲソット開ケテ中ヘ入リマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱気ニ刺サレタ網膜ヲズリ墜チテ　何トイフ莫大ナ旅程デアラウカ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその次に「硝子ガ破レルダラウカ。",
              "citation": {
                "source": "「光線の圧力」の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "漱石先生はこの手記の直ぐ後に「苦学ヲシテ卒業シタ人ガ嫁ヲ貰フ時ニ富豪カラ貰ヒタガルダラウカ。",
              "citation": {
                "source": "「光線の圧力」の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ハ同程度ノ家カラ貰ヒタガルダラウカ云々　人事問題ノ解釈ハ硝子ヲワル砲丸ヨリ余程複雑デアル。",
              "citation": {
                "source": "「光線の圧力」の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
