        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ビートルズの新作『ラバー・ソウル』、そして、ラディックのドラム・スティックをもちながら、慶一は、さらにシングルの棚で三〇分ほど逡巡した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、ラディックでもなければ、ロジャースでもなく、スネアとも呼べない、ただの日本製の「小太鼓」だから、どうでもいいのだが。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一は、ラディックの刻印がついたスティックをロッカーにしまい、となりの片桐のベッドを見た。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラディックのスティックとかな」　と、慶一が笑う。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらラディックでも、慶一だって小遣いで買ったくらいで、スティックなんて、たいしたことはない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ラディックのスネアと、ジルジャンの一八か二〇インチ、それにハイハットぐらいは買おうと思ってさ」　服部は、慶一の嫌みには気づかなかったように、すましていう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ラディックのスネア？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラディックのスネアに、ジルジャンのシンバル！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
