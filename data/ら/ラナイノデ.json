        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドコヘノツテヨイノヤラ　ワカラナイノデ、ヤネニノリマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハボンコチヤンノクシヤミガドウシテモ、トマラナイノデ、町デ、有名ナ「モノシリウササン」トイフ、オイシヤサマヲヨビマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクンガアンマリサワグノデ、マタタロー　　サンニシカラレマシタ、ガマタ　スグウレシクテタマラナイノデサワギダシマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "レスリーモ颯子ノ寵愛ヲ蒙ムルコトクーパーニ劣ラナイノデアルガ、陸子アタリガ密カニ婆サンニ焚キツケタト見エテ、コリーノヨウナ大キナ犬ハ飼ワナイ方ガイヽト云ウ意見ガ、二三年前カラ家庭内ニポツ／＼擡頭シ始メテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアニ、明日日曜ナンデミンナ遊ンデイルンデスヨ」京都駅ハ下リノ時ハブリッジヲ沢山登ラナケレバナラナイノデ、コレガ甚ダ億劫デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレデ結局墓石ノ形式ハドレニオ決メナサイマスカナ、実ニイロ／＼ト専門家モ及バヌホド御存知デイラッシャイマスノデ、私ナゾハ何トモ申シ上ゲヨウガゴザイマセンガ」「僕自身モドウシテイヽカ分ラナイノデ迷ッテルンデスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体妻ハ来客ニ対シテハ不愛想デ、コトニ男ノ客人ニハ会イタガラナイノデアルガ、木村ニダケハ親シムノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夕食後、二人ガ妻ヲ映画ニ誘ウト称シテ連レ出シニ来、十一時過ギテモ戻ラナイノデ、アルイハソンナデ掴マエテ来マシタ」彼女ハ独得ノ意地ノ悪イ眼デ僕ノ眼ヲ覗イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテガミクダサラナイノデ……ワタクシタチ……マイニチシンパイシテオリマス……ドウナサツタノ……デスカ……」と判じ判じ読んで、オホホホホホホホと、母は笑い出しました。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙デハナク、新サンカ、ワタシカガ、出カケナクテハナラナイノデスケド、マダ宴会ハスンデ居ランシ、後始末モアルノデ、手紙デ、許シテ下サイ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
