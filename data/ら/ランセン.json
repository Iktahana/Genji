[
  {
    "uuid": "fbd0246f-cb34-5a23-aaf7-6e759464dd30",
    "entry": "乱戦",
    "reading": {
      "primary": "らんせん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
