  {
    "uuid": "0e4f023b-ec05-5b3c-a48e-9fea8ef82603",
    "entry": "ランマ",
    "reading": {
      "primary": "らんま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
