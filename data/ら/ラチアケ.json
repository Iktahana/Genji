        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "墓参りもし、法事も済み、わざとの振舞は叔母が手料理の精進で埒明けて、さて漸く疲労が出た頃は、叔父も叔母も安心の胸を撫下した。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「方なしじゃ、」　思いの他、声だけは確であったが、悪寒がするか、いじけた小児がいやいやをすると同一に縮めた首を破れた寝ン寝子の襟に擦って、「埒明かんで、久しい風邪でな、稼業は出来ず、段々弱るばっかりじゃ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（閉い言うて、云わしゃれても、な、埒明かん。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（いずれも猶予するを見て）埒明かんな、伝吉ども来い。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで十年前に北国へお立退きの際、お預けなされた三井寺の方へ此の間じゅうからさいさい掛合われなされたけれど、一向取戻しは埒明かんと言うことじゃ』信徒二『そりゃ初耳じゃ。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "堪らん、こりゃ、立っとッちゃあ埒明かん、さあ前へ行ね、貴公。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "声を立てて、助かろうと思うても埒明かんよ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "人形使　そ、そんな、尻べたや、土性骨ばかりでは埒明かねえ、頭も耳も構わずと打叩くんだ。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あぶれた手合が欲しそうに見ちゃあ指をくわえるやつでね、そいつばッかりゃ塩を浴びせたって埒明きませぬじゃ、おッぽり出してしまわっせえよ。",
              "citation": {
                "source": "清心庵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "長次はやがて思案の末、新八、太七の買つけの薬舗に行つて薬を調べたりして腐心するのであつたが、一向その秘法も埒明かず、果ては病人のやうに幼な心を痛めるのを、母親はとかくに慰め訓へて無駄な労力を止めようとするのであつた。",
              "citation": {
                "source": "名工出世譚",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで使いなれた智識感情といえる語を用いていわんには、大凡世の中万端の事智識ばかりでもゆかねば又感情ばかりでも埒明かず。",
              "citation": {
                "source": "小説総論",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ことしももう余日がないので、来春になったらばいよいよお蝶を輿入れさせるということに取りきめて、まずこの一件も一埒明いたのでした。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一向｜埒明かずとあってカリブ人、また鼠を遣わすとこやつ小賢しく立ち廻ってたちまち獏の居所を見付けたが、獏もさる者、鼠に向いわれと同類の汝がわが食物を得る場を垢の他人の人間に告げたって、人間ほど薄情な者なければ、トドの詰まりは狡兎死して良狗煮らるだ。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "生川氏、結論にいわく、右のごときはただ埒明的合祀にて、神社の整理か縮少か将破壊か、かかる神社と神職とに地方自治の中枢たらんことを望むは間違いもはなはだし、これを神道全体の衰頽と言うべしと断ぜられたるは、まことに末を見透せし明ありと嘆息の外なし。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々は遠からぬ新宿へなりと人知れず遊びに出掛けたき心持にも相なり候へども、これまた同様にて埒明き申さず。",
              "citation": {
                "source": "榎物語",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "依之村方親類は不及申、脇より違乱妨申旨御座候はゞ、請人の者罷出、急度埒明可申、貴殿に少も御苦労掛申間敷候。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "依て村方諸親類得心の故に御座候処、若違乱妨申者御座候はゞ、連印者罷出急度埒明可申候。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "依之村方諸親類は不及申、他所よりも違乱申者有之候得ば、請人之者罷出急度埒明可申、貴殿に少も御苦労掛申間敷候。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづれも最早や埒明き候へば暇乞ひして在所へ罷越候にや。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ口先で「死ぬ、死ぬ」いうたぐらいでは威嚇し利けへんさかい、いっそ早よ埒明くように、それもあんまりえらい騒ぎにならんように、奈良とか京都とか、何処ぞ近いとこへ逃げたらどやろ。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
