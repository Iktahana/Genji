  {
    "uuid": "2b201fcb-6267-5ac0-963a-f29d773b44f7",
    "entry": "来戯",
    "reading": {
      "primary": "らいぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
