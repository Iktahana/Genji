          "literary": [
            {
              "text": "以来渡部は、調整という名の仕上げ作業を仙台で半年以上も続けた★。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時節与八郎家来渡辺金太夫、伊達与兵衛、中山是非介働き殊に勝れ候て三人共に権現様より御感状下され候。",
              "citation": {
                "source": "姉川合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来渡辺子は疳癖ありて、往々常軌を逸する行動あり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "（い）　其行來渡海詣中國より持衰不謹に至る一節。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "元來渡邊子は疳癖ありて、往々常軌を逸する行動あり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            }
          ]
        }
