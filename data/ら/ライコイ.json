          "literary": [
            {
              "text": "男子　男子は由来恋愛よりも仕事を尊重するものである。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "男女の愛情がそう単純なものならば古来恋愛から起った悲劇があれほど沢山にないはずです。",
              "citation": {
                "source": "離婚について",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇多手比日（同巻十一）何時はなも、恋ひずありとはあらねども、得田直比来恋ひの繁しも（同巻十二）あげるもこと／″＼しいが、此が今まで知れて居る、万葉集における用例の総計であらう。",
              "citation": {
                "source": "副詞表情の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "されども予は、元来恋には無経験なるものなれば。",
              "citation": {
                "source": "一青年異様の述懐",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
