          "literary": [
            {
              "text": "最初は、あのように荘厳美麗に感ぜられた七重の羅網も、七重の行樹も、何の感銘をも、おかんの心に与えなかった。",
              "citation": {
                "source": "極楽",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "天蓋には、瓔珞、羅網、花鬘、幢旛、仏殿旛等。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "彫刻修行のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊ちゃんは格子戸につかまって昇り降りするが、その格子戸が因陀羅網に見えて来る。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            }
          ]
        }
