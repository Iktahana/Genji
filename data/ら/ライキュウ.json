[
  {
    "uuid": "5ab08a43-a88c-52b1-9428-47414ef47e33",
    "entry": "来給",
    "reading": {
      "primary": "らいきゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君は、こっちへ来給え」　と言って、さっさと松林のほうへ歩いて行き、私が不安と恐怖で胸をどきどきさせながら、その後について行くと、林の奥に製材所から来たばかりの板が積んであって、将校はその前まで行って立ちどまり、くるりと私のほうに向き直って、「毎日、つらいでしょう。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「安心して行って来給え」私は大きい声で言った。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、僕と一緒に来給え。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大学へはいって、くるしい事が起ったら相談に来給え。",
              "citation": {
                "source": "みみずく通信",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋは自分に、喧嘩を避けてどこかで脱けてやって来給え。",
              "citation": {
                "source": "小さき良心",
                "author": "断片",
                "note": "青空文庫"
              }
            },
            {
              "text": "――じゃ、まあ、僕と一緒に来給え。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、その前にひざまずきさんげするほどの価値も親しみも人間のうちに見出せないならば南無、み仏よと呼び掛けなさい必ず必ずみ仏は来給うさんげなさい、み仏の前にそして心のよごれを拭ってお貰いなさい。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「じゃ、ついて来給え」　渋々承知した。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "水くさいのは会計だけや」背中で言って、「さあ、編輯長に挨拶して来給え。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "明後日午後に来給え、取寄せて置こう」　トいうから文三は喜びを述べた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それじゃこれで別れよう、些と遊びに遣ッて来給え。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "『いいから僕について二階へ来給え。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっと僕の処へも遊びに来給え」　こう云って長屋隣の内へ帰って行く。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで君達は、その青年を伴れて、別の自動車で来給え、儂は岡埜先生と御一緒に先きに行くから」　署長はそう云って、岡埜博士と一緒に、喚き立てる気狂いをそこに残して門の方へ歩いて行った。",
              "citation": {
                "source": "三稜鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助は、出立の当時、新夫婦を新橋の停車場に送つて、愉快さうに、直帰つて来給へと平岡の手を握つた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "近いうちに本店に帰る番に中つてゐるから、其時は一所に来給へ抔と冗談半分に約束迄した。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "人が叮寧に辞令を見せたら見向きもせず、やあ君が新任の人か、些と遊びに来給へアハヽヽヽと云つた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉川君と二人ぎりぢや、淋しいから、来給へとしきりに勧める。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助は、出立の当時、新夫婦を新橋の停車場に送って、愉快そうに、直帰って来給えと平岡の手を握った。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "近いうちに本店に帰る番に中っているから、その時は一所に来給えなどと冗談半分に約束までした。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "人が叮寧に辞令を見せたら見向きもせず、やあ君が新任の人か、ちと遊びに来給えアハハハと云った。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると獅子は安楽椅子に横になつたまゝで『穴熊君、わしが煙草に火をつけてやらう』　と言つたので、穴熊は飛びあがるほど心の中で嬉しがつた、しかし獅子は椅子から立ちあがらうともしないで、頤で先方をしやくつてから『向ふの棚にライターがあるから、君こゝへ持つて来給へ―』と命令的に言つた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰り際には『君、外套を着せてやらう、外套をこゝへ持つて来給へ―』といつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度、ぜひ伺わせて貰うからね」「来給えな」と言ったのも、上の空。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかれば老いたる御方のいかに心もとなく歩み苦しうおぼすらむと見やるに、手拭被りつつ、脛あらはに端折りて、ささやかなるものを負ひつつ来給ふさま苦しげにもあらず、常の道歩み給ふさまなるがいと怜し。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど老たる人々の、待てど／＼来給はねば、心おちゐで、などかくは遅き、心もとなきことかなと繰返し／＼云へば、さおもひ給はば迎へに人遣らばやとて、人など呼ぶ程に、二人の老人娘と共に恙もあらで到り着きぬれば、怜しさ譬へむに物なかりき。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は今から新聞社に行くから、又遊びに来給え。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩にお遊びにいらっしゃいましな」言い棄てて、夫人が歩き出すと、それまで二王立に立って、巨人が小人島の人間を見るように、純一を見ていた岡村画伯は、「晩に来給え」と、谺響のように同じ事を言って、夫人の跡に続いた。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ぢや今夜から私の旅籠へ來給へ。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "盾銀二十枚をば、われこゝに持ち居れば、フラア・マルチノの來給ふまで、決して他人に渡さじといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
