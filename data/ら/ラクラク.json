    "definitions": [
      {
        "index": 1,
        "gloss": "comfortably",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日頃からハードなトレーニングを積んでいる彼にとって、フルマラソン完走も楽々だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最新のAI翻訳ツールを使いこなすことで、難解な論文も楽々と読み進めることができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "朝早くに家を出たおかげで、連休中の渋滞に巻き込まれることもなく、目的地に楽々到着した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかしともかく、それらの音楽によつて多くの人々が、好い気持にされてゐるのだから文句はないのだが、然しもと／＼気分の暈縁なぞといふオボコイものを聴いて喜んでゐる連中が取引のこととなると俄然骨ばつてくるし、而も楽々骨ばれるやうに前以て備へてゐるので、「音楽と世態」なぞと今並べてみたくなるのである。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが作家等が昔日のやうに、楽々と筆を執つてゐないことだけは事実である。",
              "citation": {
                "source": "近頃芸術の不振を論ず",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬上を住家とした古人の旅を思いながらも、樹下石上に眠らずに、木口新しく、畳障子の備わった室とはいえない屋根の下に、楽々と足を延ばし、椎の葉に盛った飯でなく、御膳つきで食事の出来る贅沢を、山中の気分にそぐわぬと思いながらも、その便利を享楽した。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり何時でも楽々と画かれているように見えるせいかとも思う。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また捻った……また捻った……すると思考がだんだん脱落していって頭が闇の底の方へ楽々と沈んで行った。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし二人は、兎をうつ時のように、微笑むような心持で、楽々と発射する訳には行かなかった。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽々園で車を降りて入場しようとすると、向うから来る酔っぱらいの二人連れが何かしら不機嫌でいきなり出入口のターンパイクを引っこ抜いて投げ出して行った。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "席を片側へ十五ぐらゐ一杯に劃つた、たゞ両側に成つて居て、居ながらだと楽々と肘が掛けられる。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日に十里を楽々と走破しうる健脚を有し、獅子をも斃す白光鋭利の牙を持ちながら、懶惰無頼の腐りはてたいやしい根性をはばからず発揮し、一片の矜持なく、てもなく人間界に屈服し、隷属し、同族互いに敵視して、顔つきあわせると吠えあい、噛みあい、もって人間の御機嫌をとり結ぼうと努めている。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間、田島は、十貫を楽々とかつぐキヌ子のあの怪力を思い出し、慄然として、「ゆるしてくれえ。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆やはそのすぐあとから楽々と跟いていくことができた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は静かに楽々と眠りつづけた。",
              "citation": {
                "source": "赤い煙突",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうすると四斗樽は、楽々と担げた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思えばもう少し池上をあやなし返し、また自分の背負い荷になっている葛岡の生活も保証させ自分も楽々と栄耀栄華に飽こうかなど思う捨鉢な慾も出て参ります。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めはこの古い家柄を衷心から尊敬するスコッチの大蔵大臣の肝煎りで手堅い公債ばかり買い入れ、その利息で楽々生活費が支弁出来た。",
              "citation": {
                "source": "バットクラス",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると人民は、もう十分にたくわえもできていましたので、お納物をするにも、使い働きにあがるのにも、それこそ楽々とご用を承ることができました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしまあ少ない方に間違っているのは結構、殊に暑いときには至極結構だと思って、僕は楽々と一方の腰掛けを占領していると、向う側に腰をおろしているのは、僕とおなじ年頃かと思われる二十四五の男と、十九か二十歳ぐらいの若い女で、その顔付きから察するに彼等はたしかに兄妹らしく見られた。",
              "citation": {
                "source": "水鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも翁の謡振りの或る一部分を伝えたものであったらしいが、それ等の謡い盛りの一同の地謡の中に高齢の只圓翁が一人座り込むと、ほかの声は何の苦もなく翁の楽々とした調子の中に消え込んで行った。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは両足を重い荷物のようにひきずり歩いていたのが、おしまいには、両足が立派な独立の存在となって自分で自分を運搬するばかりか、楽々とからだのほうをかつぎ歩くようになって来た。",
              "citation": {
                "source": "軽井沢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "金谷完治氏の※惑――（同上）は或る気の弱い青年の男女関係を描き、微笑を誘はれるところもあつて次々へ楽々と読めたが、それだけに安易に走つてゐるかたむきで、またわたしは不覚にも題名の意味が解らず興味を殺がれた。",
              "citation": {
                "source": "浪曼的月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、三上は、実際直江津の漁夫を笑うかのように、楽々とおもてへ漕ぎ寄せた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれなら俺達五人がいち時に楽々と乗り込めるからね。",
              "citation": {
                "source": "馬車の歌",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに大才厚徳の人であっても、やはり楽々とした好適の状態だけで終始する事は出来ない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "人情味のある源氏であったから、すぐに返歌が書かれた、非常に楽々と、かへさんと言ふにつけても片しきの夜の衣を思ひこそやれごもっともです。",
              "citation": {
                "source": "源氏物語",
                "author": "玉鬘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これが若し楽々と乗つて居られる車であつたならば、俺は屹度途中で飛び降りて仕舞ふだらう。",
              "citation": {
                "source": "白明",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何なる大破壊も如何なる大建設も二十五年間には優に楽々と仕遂げ得られる。",
              "citation": {
                "source": "二十五年間の文人の社会的地位の進歩",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でこそ写楽々々と猫も杓子も我が物顔に感嘆するが、外国人が折紙を附けるまでは日本人はかなりな浮世絵好きでも写楽の写の字も知らなかったものだ。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉山は三月越しの旅で顔の色が煤けて日に焼けていたが、真白な長身は汗ばんで赤味を帯び、棹は上手か下手か知らぬが流れに従って下りるんだから楽々として如何にも威勢が好く、とても旅路に放浪して今帰ったばかりの家なき人とは思われなかった。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその多作の点において、いかにも楽々と大作を次から次へと発表してゆくエネルギーにおいて私たちを驚嘆させるが、やはり一作ずつをとってみると、ゆるみがある。",
              "citation": {
                "source": "ヴアン・ダインの作風",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なあ、ペーター・ヤコレウイチ、二人の若いのをのせてやりゃ、金はらくらくと儲るじゃないか。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
