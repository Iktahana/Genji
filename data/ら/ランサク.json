        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "同種の内容の安易なビジネス書が乱作され、書店の棚を埋め尽くしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "短期間にヒット作を出し続けた結果、無理な乱作がたたって彼の筆は止まってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "粗悪なコピー商品が市場に乱作され、ブランドのイメージが著しく損なわれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "○長谷川利行氏――彼は乱作家である、しかし自己主張もこれまでに徹底すれば、少くも憎むことはできまい、何か一種の風格を場中に漂はしてゐた、観念の分裂と痛々しく闘ふ生活的な画家といふところだらう。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "乱作で作家は生長しないのだから。",
              "citation": {
                "source": "討論に即しての感想",
                "author": "――新日本文学会第四回大会最終日に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九二八年の秋を見るなら、我々は立ちどころに彼等の擾乱作用を理解するであろう。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし「公職」という観念が、文筆活動そのものを内容としないかぎり、これらの戦争協力作家のいなおった民主化攪乱作業はつづけられるであろう。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、まるで大洪水に逢ったように、売るあてもない原稿の乱作をしました。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時代ほど乱作した事はありません。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先、乱作をしないこと、多作をしないこと、又は制限を受けて創作をしないことを、自分の（半ば）無力、微弱な材料に対する庇護物、並に、外から注ぎ込まれた既成概念として知って、又云って居たのだろう。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸川君ら、探偵小説界は外国礼讃であるが、外国の探偵小説で、乱作して読ませる作家は、クリスチィ、クイーンぐらいで、あとはもう、バカらしくて読むに堪えないものばかり。",
              "citation": {
                "source": "「刺青殺人事件」を評す",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは精神の奴隷となり、認識で乱作をおこない、まくべき種子をひいてつぶし、秘｜訣を放棄し、才能に容疑をかけ、芸術を裏切った。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は幸、乱作ではない多産の時期に入って来たらしい様子です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと気軽に、乱作でいいから、どしどし書いてくれたら、こっちは助かるのだが。",
              "citation": {
                "source": "乱歩分析",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            },
            {
              "text": "――今日は近来にない濫作駄作だつた、これではまるで俳句製造者だ、警戒々々、自重々々、駄作千句よりも佳作一句だ。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは彫刻というような特殊の芸術を需要の多いのに任せて濫作する弊……拙速を尚んで、間に合せをして、代金を唯一目的にする……すなわち余りに商品的に彫刻物を取り扱い過ぎるところの悪習ともいえましょう。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "「木寄せ」その他のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "濫作ではなくたっぷり作品化して行ける発露を心に感じる状態はうれしいこと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌麿は余り売れて、濫作の結果、井戸を汲みつくしてしまったように消耗涸渇して、あの位晩年下らない作をつくった大天才は絵画史にも例が少い由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧の為ならば兎に角も、慎むべきものは濫作である。",
              "citation": {
                "source": "漱石山房の冬",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "）或は休みない制作の為に、（世界に日本の文壇ほど濫作を強ひる所はない。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――この作者早くも濫作をなすか。",
              "citation": {
                "source": "MENSURA ZOILI",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それなら物質的に迫られて、此上｜濫作をしなくちやならなくなつたり、通俗小説を書かなくちやならなかつたりしても、君のために損ぢやないと云ふのかね。",
              "citation": {
                "source": "良友悪友",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一家の扶養と学資かせぎが本来の目的であったが、勿論この濫作には惰性やジャーナリズムの要求が有力に働らいていたことは疑えない。",
              "citation": {
                "source": "チェーホフ試論",
                "author": "――チェーホフ序説の一部として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "学資かせぎと一家の扶養が本来の目的であったが、勿論この濫作には惰性やジャーナリズムの要求が有力に働らいていたことは疑えない。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "濫作して、マンネリズムにおちいっては、ゲームの妙味が失せてしまう。",
              "citation": {
                "source": "推理小説論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに濫作しても、謎ときのゲームに堪えうるだけの工夫と確実さを失わないという作家である。",
              "citation": {
                "source": "推理小説論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれほどの濫作をして、一作毎に工夫があり、トリックにマンネリズムが殆どなく、常に軽快な転身は驚くばかりである。",
              "citation": {
                "source": "推理小説論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "クイーンも亦、クリスチー女史につぐ天才であり、筆も軽く、謎ときゲームの妙味に終始し、濫作しつつ、駄作のすくない才人であるが、トリックや推理の確実性、合理性という点で、クリスチー女史に一歩をゆずる。",
              "citation": {
                "source": "推理小説論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近の長篇小説といへば、一列一体に書きなぐり気分の多い濫作物の横行の中で、この作品は完璧の相を示して光り輝いてゐる。",
              "citation": {
                "source": "長篇小説時評",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（談）　東京新聞「放射線」欄の宮本竹蔵先生の所説は、ジャーナリズムだけが悪人ではなくって、過度の要求を承知でひきうけて濫作する作家の側にも罪がある、ジャーナリズムには女流作家を殺す力がない、ということを言いたかったのであろう。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その五　衆生開眼",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はお金がとれる愉快さに濫作に昼夜を上げて書いていたから、金では萩原に負け目はなかった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "濫作を重ねた私の頭はただれた疲れがあったが、疲れは花札の繚乱たるひらめきを見ると、すぐ恢復するかに思われたが、事実はその反対で一層ふかく疲労したけれど、これを停めるわけに行かなかった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はりょうらんたる花札の絵模様に頭を掻き乱されていて、また、同時に小説の中でも濫作のただれが救えなくて、もだえていたからだ、けれどもいつも金は賭けていなかったし、せいぜい三年も続けて打つと私はへとへとになった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
