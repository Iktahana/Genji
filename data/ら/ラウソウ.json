        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「塵袋」に、子細知らぬ者はラウソウと云ふ乞食等の、沙門の形なれども、その行儀僧にもあらぬを濫僧と名づけて、施行ひかるゝをば濫僧供と云ふ。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "仔細知らぬ者はラウソウ（濫僧）ともいふ。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランソウと云ふべきをラウソウといふ。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "子細しらぬものはラウソウとも云ふ。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランソウと呼ぶべきをラウソウと云ふ。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
