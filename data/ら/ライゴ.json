    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十五日、庚午、聖徳太子の十七箇条の憲法、並びに守屋逆臣の跡の収公の田の員数在所、及び天王寺法隆寺に納め置かるる所の重宝等の記、将軍家日来御尋ね有り、広元朝臣相触れて之を尋ね、今日進覧すと云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝が近く譲位をあそばしたい思召しがあって、藤壺の宮のお生みになった若宮を東宮にしたくお思いになったが将来御後援をするのに適当な人がない。",
              "citation": {
                "source": "源氏物語",
                "author": "紅葉賀",
                "note": "青空文庫"
              }
            },
            {
              "text": "将来御不安なことなどは決してございませんよ」「まああとのことはわかりませんが、現在はまあこうした御親切をお見せくださるものですから、最初いろいろとお骨を折ってくださいましたあなたの御恩が思われます。",
              "citation": {
                "source": "源氏物語",
                "author": "浮舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには、第一に着京以来御世話になつて難有いと云ふ礼が述べてあつた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには、第一に着京以来御世話になって難有いと云う礼が述べてあった。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "上に引いた文の前に、猶「春以来御入湯いかゞ」の句もある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「失敬な、――甘木さんへ行って聞いて見ろ――元来御前がこんな皺苦茶な黒木綿の羽織や、つぎだらけの着物を着せておくから、あんな女に馬鹿にされるんだ。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三百円やそこらの端金で貴方の御名誉を傷けて、後来御出世の妨碍にもなるやうな事を為るのは、私の方でも決して可好くはないのです。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はあ、は、さやうですかな」「先程から伺ひますれば、年来御懇意でゐらつしやるのを人違だとか申して、大相失礼を致してをるやうでございますが、やつぱり熱の加減で前後が解りませんのでございますから、どうぞお気にお懸け遊ばしませんやうに。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "将来御許の片腕となって家運挽回をはげむにも今の世の中に小学きりではと思い、私は泣いて行ってくれと申せど、悌二は兄さんには僕の心持がきっと分ってもらえると申して承知しません。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中でもこの私なぞは、大殿様にも二十年来御奉公申して居りましたが、それでさへ、あのやうな凄じい見物に出遇つた事は、ついぞ又となかつた位でございます。",
              "citation": {
                "source": "地獄変",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "過日来御約束の被害土壌四種調査致候処、悉く銅の化合物を含有致し、被害の原因全く銅の化合物にあるが如く候、別紙は分析の結果及被害圃の処理法に御座候、不具。",
              "citation": {
                "source": "政治の破産者・田中正造",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのところへゴキゲン伺いは今日がはじめて、御降嫁以来御無沙汰していたが、うん、こうして御対面、シミジミ拝顔すると、さすがに正司君は目が高い。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "その騎士（じつは諸君も先刻来御承知のように、彼は幽霊ではなかったのである）はヘルマン・フォン・シュタルケンファウスト卿と名乗った。",
              "citation": {
                "source": "幽霊花婿",
                "author": "ある旅人の話",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし御都合もつき候えば御入来御両人にて一番御謡あらまほしく候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナリン太子殿下横浜御出航以来御不例｜予テ船医ニ於テ流行性｜脳脊髄膜炎ト診断船中ニ於テ御加療中ノ処病勢御険悪発熱三十九度五分｜囈言アラセラレ、嘔吐数回嗜眠状態ニアラセラルル旨イキトス号船長ヨリノ無電ニ接ス。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、その節はどうも……」「以来御無沙汰申上げております」「君、知っているのかい？",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "久しぶりだ」「毎日お世話になっていながら、正月以来御無沙汰申上げています」「少しひどいぜ」「恐れ入りました」　と中島さんは額に手を当てた。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『お殿様｜御事年来御放蕩の結果お鼻御落滅。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "以来御無沙汰していたが、佳子さんと安達君の縁談がイヨ／＼纒まったと聞き知って、お祝いに罷り出たのである。",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山下君は好い青年です」「私はあの人のお父さんと同僚で年来御懇意に願っています」「然ういう御関係ですか？",
              "citation": {
                "source": "嫁取婿取",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "拙者儀は、吉良家の中小姓｜清水一｜学と申す者、輿中のまま往来御免くだされたい』　と、明瞭な音吐で云った。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエスはおもむろに口を開いて、前日来御心を痛められている最大問題を切り出し給うた。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵からのその内容はまた、至って簡明なもので、こう書いてある――以来御健在ナリヤ約ニ依而、茲ニ書ヲ呈ス貴剣サダメシ御鍛養ト被存候、貧生マタ些カ鍛腕ヲ撫シテ罷リアリ候御見ニ入ル場所ハ何処、日ハ何日、時ハ如何ニ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "年來御恩をきて居りながら、かやうな時に御意見のひと言も申上げることか、却て駈落の女を隱まふなどとは、言語道斷、憎い奴。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾來御聖徳益々盛にましますのに、其麓の村々の鑛毒のある處に案内をして來る人がある。",
              "citation": {
                "source": "公益に有害の鑛業を停止せざる儀に付質問書",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "親父も喜んで私に話す元來御目附といへば天下の樞機に與る人。",
              "citation": {
                "source": "兵馬倥偬の人",
                "author": "塚原蓼洲",
                "note": "青空文庫"
              }
            },
            {
              "text": "中でもこの私なぞは、大殿樣にも二十年來御奉公申して居りましたが、それでさへ、あのやうな凄じい見物に出遇つた事は、ついぞ又となかつた位でございます。",
              "citation": {
                "source": "地獄變",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "又うるさい物貰ひなら去年の暮以來御難だとでも言つて歸せ」　平次は讀み耽けつてゐる『源氏物語｜忍草』から顏をあげました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女護の島異變",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
