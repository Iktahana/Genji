[
  {
    "uuid": "997cd6fb-07c7-5849-b494-67668cd59246",
    "entry": "乱射",
    "reading": {
      "primary": "らんしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
