        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ツカレノ銀ヲクユラシテ、　　　モロ人谷ヲイデキタリ、ココニ二タビ口ソソギ、　　　　セナナル荷ヲバトトノヘヌ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマデハ　ヤマキチ　ノ　ナカヨシ　ノ　イロイロ　ノ、トリ　ヤ　ケモノ　ガ、ヤマキチ　ノ　カエリ　ヲ、タイソウ　ヨロコビマシテ、ウタ　ヲ　ウタウヤラ、オドリ　ヲ　オドルヤラシテ　カンゲイ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラツパ新美南吉　オヂイサンハ　イナカニ　ヒトリボツチデ　クラシテ　ヰマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ農業發達ノ程度ニ於テハ婦人ヲ炎天ニ晒ラシテ其ノ美ヲ破リ、又ハ貧困者多キ近キ將來ニ於テハ婦人ヲ工場ニ驅使シテ其ノ樂ヲ奪フコトモ止ムヲ得ザル人間生活ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクタチ兄ダイハ、ナカヨク、タッシャニ、コノシマニ、クラシテイマス。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鞭ヲ鳴ラシテ酒肆ヲ過リ服ヲアザヤカニシテ倡門ニ遊ブ――」　他の者は世話ものを歌つたが、雷音は人々の聞き慣れぬ類ひの漢詩ばかりを次々に朗吟するのが癖だつた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは交川博士の筆蹟だ」　帆村は「密航者一名ヲ法規ニ照ラシテ処理ス云々」のところを指した。",
              "citation": {
                "source": "断層顔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコノオバアサンハ、マイニチ、コンナフウニクラシテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「ワンコヤ、イタヅラシテハイケマセン。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　ミナサンモ　ゴランニナルヤウニ　カメサンハ　ミンナ　イマダニ　ハダカデ　クラシテイルト　イフワケデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピイ……トフヱヲ　ナラシテ、シロイ　ケムリヲ　　　　ダシタリ、クロイ　ケムリヲハイタリ、テッキヨウヲ　ワタッテ、トンネルヲ　ヌケテ、マタトンネルヘ　ハイッテ、ドンドン　ハシッテ　ユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼガ　ホヲフクラシテ、フネハ　ナミヲ　　　タテテハシリマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハ溜リカネテソノコトヲ浄吉ニ訴エルコト再三ニ及ンダラシイガ、「ソンナコトハアリマセンヨ」ト、浄吉ハ笑イニマギラシテ相手ニシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ニ算盤ヲ弾カセテイルコトモアルガ、大概ハ颯子ガ自ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ直グ脈ヲ取ッテ見テ、「プルスガ九十以上ゴザイマスネ、ドウカナサイマシタンデスカ」「イヽヤ別ニ」「血壓ヲ測ラシテ戴キマショウ」否応ナシニ書斎ノソファニ寝カサレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君、コノ音ガ何ダカ分ルカネ」ト、予ハ又喉ヲ鳴ラシテミセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヽ小サイ目ニ締メテ、垂レヲ普通ヨリ長イ目ニ垂ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（地味ナスーツヲ着テイルガ、ブラウスガ派手ナノト、フランス製ラシイ模造宝石ノ五聯ノネックレスヲ頸カラ胸ヘ垂ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈図ランヤ彼女ハソノ頃ハイヤヲ走ラシテ伊丹ニ向ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一眼ガチラチラシテモノガ非常ニ読ミニクイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その葉書には、いつものように、ゼヒゼヒイラシテクダサイ、オマチシテオリマス……と書いてあったのです。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その瞬間、また突然頭に閃いたのは、ゼヒゼヒイラシテクダサイ、オマチシテオリマスという葉書も、そのまた前の葉書も手紙も、ことごとく東京で、ジーナやスパセニアの姿を見た以前のものばかりで、それ以来は何にも受け取っていないということだったのです。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
