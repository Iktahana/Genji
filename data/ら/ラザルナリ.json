          "literary": [
            {
              "text": "十歳許ノ小兒ハ英ノ小兒ヨリ一層敏捷ナレドモ、唯高キ能力ヲ發達スルニハ英兒ト均シク教授ス可ラザルナリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡ニアツテ繁ニアラザルナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令同一人民ニシテ青銅器ト鐵器トヲ用ヰタル事有リトスルモ、鐵器ノ用ハ常ニ青銅器ノ用ニ後ルト定マリタルモノニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利器原料ノ如何ハ未ダ以テ之ヲ使用スル者ノ開否ヲ判斷スルニ足ラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同一地方ニ於テモ時代ヲ異ニスレバ固ヨリノ事、假令同一時代ナリトモ、種族ヲ異ニスル石器時代人民ノ棲息スル事有リ得ベカラザル事ニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○日本石器時代人民ニ關スル研究ハ啻ニ日本ノ古事ヲ明カニスルニ於テ有力ナルノミナラズ、人類學上益スル所又决シテ少カラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
