        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "茶席で供された楽焼きの茶碗には、機械で作られたものにはない手に馴染む温かみがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "週末の陶芸体験クラスで初めて楽焼きに挑戦し、自分だけの色合いの茶碗を焼き上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "楽焼き特有の素朴で力強い質感が、和室の床の間を飾る季節の花を引き立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それでたぶん、年じゅう胃が悪くて時々神経衰弱に見舞われる自分のような人間には楽焼きの明るさも恋しいがまた同時に青磁にも自然の同情があるのかもしれない。",
              "citation": {
                "source": "青磁のモンタージュ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日の午後、庸三と葉子はまだ秋草には少し早い百花園を逍遙していたが、楽焼きに二人で句や歌を書きなどしてから、すぐ近くの鳥金へ飯を食べに寄ってみた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに田楽焼きの魅惑的な味は、晩酌の膳に山の酒でも思わず一献を過ごす。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "新火山のことだから、土の締まりは、しッくりしていない、むしろ危ッかしいほど、柔脆の肉つきではあるが、楽焼の陶器のような、粗朴な釉薬を、うッすり刷いた赤る味と、火力の衰えた痕のほてりを残して、内へ内へと熱を含むほど、外へ外へと迫って来る力が、十方無障碍に放射することを感ずる。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳句は、楽焼や墨流しに似ているところがあって、人意のままにならぬところがあるものだ。",
              "citation": {
                "source": "天狗",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽焼の煎茶道具｜一揃ひに、茶の湯用の漆塗りの棗や、竹の茶筅が埃を冠つてゐた。",
              "citation": {
                "source": "蔦の門",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その隣に楽焼の都鳥など売る店あり。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "小供はセルロイドの玩器を持つ、年寄は楽焼の玩器を持つ、と小学｜読本に書いて置いても差支ない位だ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "小供はセルロイドの玩器を持つ、年寄は楽焼の玩器を持つ、と小学読本に書いて置いても差支無い位だ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、樹明兄来庵、ちよんびり飲んでから呂竹居へ、呂竹老は温厚そのものといへるほど、落ちついた好々人である、楽焼数点を頂戴する、それからまた二人で、何とかいふ食堂で飲む、性慾、遊蕩癖、自棄病が再発して困つた、やつと抑へつけて、戻つて、寝たけれど。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、彼に画才のあるであらうことは常々その文章の筆致などから想像もし、また、私の眼前で作成した楽焼なども貰つたこともあるので一応は点頭いたが「小説よりも――」は可笑しいと首を傾けた。",
              "citation": {
                "source": "彼に就いての挿話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故ならば彼の楽焼は、私には感心出来なかつたから――。",
              "citation": {
                "source": "彼に就いての挿話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽焼主義ノンコ趣味を以て鳥羽僧正の画を律せんとするは瓢箪を以て鯰を押ふるの類か。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "池を繞るのは粗末な幾軒かの日本建築の喫茶店、芸妓の手｜踊、越後獅子を初め、錦絵、小間物、日光細工、楽焼、饅頭屋、易者などの店である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おや、しゃれたものを描くんだね、三十一文字かい」　楽焼の絵筆を手に持ったままわざわざ立って来、床几にあがって皿にかがみこんでいる仲間をのぞき込んだ。",
              "citation": {
                "source": "百花園",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきから、あっちの小高い亭にも、鳥打帽をかぶった若者が頻りに楽焼の下絵を描いている。",
              "citation": {
                "source": "百花園",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○山の方に楽焼やがある。",
              "citation": {
                "source": "日記",
                "author": "一九三一年（昭和六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひるまで楽焼して来た。",
              "citation": {
                "source": "日記",
                "author": "一九三一年（昭和六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一二年前のある文芸雑誌に、ばかに大きな湯呑で茶を飲んでいる芳本の体躯が、その湯呑で蔽われているようなカリケチュアが載ったことがあるが、ちょうど今もきゃしゃな小さな体躯に角帯などしめて、その大きな楽焼の湯呑で茶を飲んでいた。",
              "citation": {
                "source": "贋物",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "下婢に茶菓を持運ばせた後、その蔵幅中の二三品を示し、また楽焼の土器に俳句を請いなどしたが、辞して来路を堤に出た。",
              "citation": {
                "source": "百花園",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "百花園に憩ひ楽焼に句を書す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "乾山の陶器は人も知る如く、楽焼角皿鉢のようなものが、最も多く遺されている。",
              "citation": {
                "source": "乾山の陶器",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "備前焼、瀬戸焼、信楽焼、九谷焼、織部焼、伊万里焼、有田焼等々、日本には、各地方に、それぞれの土地に固有の型と技術とをもつ陶磁器が発達しているが、これらの窯場の特定の産物には、各々素晴らしく、芸術上時に高い作品が見出されている。",
              "citation": {
                "source": "日本のやきもの",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でも夏の鎌倉海岸あたりに行くと、楽焼に絵を描いたりするのをあちこちで見かけるでしょう。",
              "citation": {
                "source": "私の作陶体験は先人をかく観る",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵が上手だったから、四角い皿などに達者に描いておるのですが、楽焼なのです。",
              "citation": {
                "source": "私の作陶体験は先人をかく観る",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "やらぬことはないが本焼きはやっていないで、たいがいは楽焼です。",
              "citation": {
                "source": "私の作陶体験は先人をかく観る",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、その上に、釉が厚く不透明でボヤッとした感じが、恰も楽焼の感じに似て温かく具合のいいものである。",
              "citation": {
                "source": "古器観道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に風情としては、楽焼の窯の中で出来た窯樋というのも実は不思議で、その上に疵口が光悦あるいはのんこう作に於てしばしば見られるように、喰い違って段をなしているなどは、ますます以て面白いのである。",
              "citation": {
                "source": "古器観道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――そのために室内がもや／＼と翳つて、薄暗くなつてゐる中に、信楽焼のナマコの火鉢が置いてあつて、なつかしいリヽーはその傍に、座布団を重ねて敷いて、前脚を腹の下へ折り込んで、背を円くしながらうつら／＼眼をつぶつてゐた。",
              "citation": {
                "source": "猫と庄造と二人のをんな",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
