          "standard": [],
          "literary": [
            {
              "text": "言われた通り、彼等はいっさい兵馬に挨拶なしで、兵馬もこれ以来註文なしで、ひたすら甲州街道を走るようです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、生來註釋書などを讀むことは大嫌ひなので、いつになつたら讀めるやうになるのだか自分にも分りません。",
              "citation": {
                "source": "更級日記など",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
