    "definitions": [
      {
        "index": 1,
        "gloss": "Rago",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古代インド神話において羅睺は、太陽と月を飲み込んで食を引き起こす恐ろしい神とされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "羅睺の執念が天体現象に結びつけられた伝説は、アジア各地の信仰に根深く残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "占星術において羅睺（ラーフ）は、運命に急激な変化をもたらす象徴として扱われることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "校庭宮沢賢治さ霧する白き木柵幹彫れる桐のいくもと剥げそめし白きペンキの木柵に人人は倚りそのペンキあるいは剥げあるものは庭をのぞめり一鐘のラッパが鳴りて急ぎ行く港先生白堊城秋のガラスはひらごとにうつろなりけり",
              "citation": {
                "source": "校庭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのかたは、これからご自分のお部屋に歸るのでせう。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれの考へてゐるのは対称はとりながらごく不規則なモザイクにしてその境を一尺のみちに練瓦をジグザグに埋めてそこへまっ白な石灰をつめこむ。",
              "citation": {
                "source": "花壇工作",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽春ああ、春は遠くからけぶつて来る、ぽつくりふくらんだ柳の芽のしたに、やさしいくちびるをさしよせ、をとめのくちづけを吸ひこみたさに、春は遠くからごむ輪のくるまにのつて来る。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央アジアの旅行中シナの大官からごちそうになったある西洋人の紀行中の記事に、数十種を算する献立のどれもこれもみんな一様な黴のにおいで統括されていた、といったようなことを書いている。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "中尊寺〔二〕宮沢賢治白きそらいと近くしてみねの方鐘さらに鳴り青葉もて埋もる堂のひそけくも暮れにまぢかし僧ひとり縁にうちゐてふくれたるうなじめぐらし義経の彩ある像をゆびさしてそらごとを云ふ",
              "citation": {
                "source": "中尊寺〔二〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の中の貴族でも、金持でも、又私のような、中産階級でも、それからごくつまらない乞食でもね。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそのなかから魚のはららごに似た憂鬱な紋々があらわれて来るのを見る。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」二十「さて、それからご飯の時じゃ、膳には山家の香の物、生姜の漬けたのと、わかめを茹でたの、塩漬の名も知らぬ蕈の味噌汁、いやなかなか人参と干瓢どころではござらぬ。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくたちはぼくたちのからだだって考えだって、天の川だって汽車だって歴史だって、ただそう感じているのなんだから、そらごらん、ぼくといっしょにすこしこころもちをしずかにしてごらん。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからご飯をやりました。",
              "citation": {
                "source": "革トランク",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからご文に入るぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何も仰っしゃったんではございませんがちょっとしたらご存知かと思ひましたので。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、もう鳥どものよろこびやうと云ったらございません。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "望みのとほりみんな背嚢の中に納めてやりたいことはもちろんだったが、それでは僕も身動きもできなくなるのだから気の毒だったがその中からごくいゝやつだけ撰んださ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三人は汗をふいてしゃがんで、まっ白な岩からごぼごぼ噴きだす冷たい水を何べんもすくってのみました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そらごらん、とうとう風車などを言っちゃったろう。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくたちはぼくたちのからだだつて考へだつて、天の川だつて汽車だつて歴史だつて、たださう感じてゐるだけなんだから、そらごらん、ぼくといつしよにすこしこころもちをしづかにしてごらん。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからご文に入るじゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何も仰っしゃったんではございませんがちょっとしたらご存知かと思いましたので。",
              "citation": {
                "source": "土神ときつね",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "望みのとおりみんな背嚢の中に納めてやりたいことはもちろんだったが、それでは僕も身動きもできなくなるのだから気の毒だったがその中からごくいいやつだけ撰んださ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでもいたしますからごえんりょなくおおせつけてくださいまし」と申し上げました。",
              "citation": {
                "source": "燕と王子",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからご飯にしよう、ね」　こどもはこんなにも巴里に馴れて来たのかとあきれたような心嬉しさだった。",
              "citation": {
                "source": "オペラの辻",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、こんな中に先刻にからござらせえたか。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども熊もいろいろだから気の烈しいやつならごうごう咆えて立ちあがって、犬などはまるで踏みつぶしそうにしながら小十郎の方へ両手を出してかかって行く。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうらごらん、とうとう風車などを云っちゃった。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビジテリアンの主張は全然誤謬である、今これを比較解剖学の立場からごく通俗的に説明しよう。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は私の方でもあの通り速記者もたのんであります、ご答弁は私の方の機関雑誌畜産｜之友に載せますからご承知を願います。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからごくしずかに何か云いそうに口をしましたがその語はなかなか出て来ませんでした。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちのまわりにいるやつはみんなばかですね、のろまですね、僕のとこのぶっきりこが僕が何をあなたに言ってるのかと思って、そらごらんなさい、一生けん命、目をパチパチやってますよ、こいつときたら全くチョークよりも形がわるいんですからね、そら、こんどはあんなに口を曲げていますよ。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
