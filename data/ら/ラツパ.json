        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "へんな形をしたラツパの口から音がきれぎれにもれるのである。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにへんな形をしたラツパといふのも、蓄音機の電気拡声器として、以前から使はれてゐたものである。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはラツパで聴くのでなく、受話機を耳に当てて聴くのである。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に悪い印象を受けたのは、拡声機のラツパで聴いた為であることが、ここに於て始めてわかつた。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」新兵「ラツパは何でありますか。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ちラツパを勇ましく吹き立てゝ車は傾斜を飛ぶやうに滑る。",
              "citation": {
                "source": "湯ヶ原より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」明るくたのしくみんなの聲はひびき、みんなはそのそらの遠くから、つめたいそらの遠くから、すきとほつた何とも云へずさわやかなラツパの聲をききました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは誰も気にかけず、店を掃いたりしてゐたが、朝めしすこしすぎたころ、だんだんそれが近づいて、みんな立派なチヤルメラや、ラツパの音だとわかつてくると、町ぢゆうにはかにざわざわした。",
              "citation": {
                "source": "北守将軍と三人兄弟の医者",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠き下町の夕とどろき、豆腐屋のラツパ、長く曳く小さき汽笛、鉄板の音。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "都影君から貰つた正宗をラツパのみしたのはおもしろかつた。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――魚売の声よそにふけ青嵐――これは也有翁の閑居吟であるが、私の場では、豆腐屋のラツパも寄らない青葉若葉である、呵々。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い函の横に供へられた桔梗二三輪、鳩が二三羽飛んで来て、空にひるがへる、すすり泣きの声が聞える、弔銃のつゝましさ、ラツパの哀音、――行列はしゆく／＼として群集の間を原隊へ帰つて行つた。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテ、コンナ　ウツクシイ　花バタヲ　ダレガ　アラシタノダラウ」ト　ヲトコガ　タホサレタ　イツポンノ　ケシノ　花ヲ　オコシテ　ヤラウト　スルト、ソノ　ネモトニ　シンチユウノ　ラツパガ　ヒトツ　オチテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　ラツパヲ　ミルト　花ヲ　オコシテ　ヤル　コトモ　ワスレテ、「アア、コレダ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンハ　ラツパシユニ　ナラウ」ト　タイヘン　ヨロコビマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ラツパシユニ　ナツテ　リツパニ　ハタラキマス」ト　ワカイ　ヲトコハ　コタヘテ、トシヨリタチノ　マエデ　イサマシイ　ラツパヲ　フイテ　キカセマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　ヒノ　デナイ　ウチカラ　ヲトコハ　ハタケノ　マンナカノ　ヲカノ　上ニ　ノボツテ、ラツパヲ　フクノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラツパ新美南吉　オヂイサンハ　イナカニ　ヒトリボツチデ　クラシテ　ヰマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ、イロイロ　サガシタガ、アマリ　ヨイ　キカイガ　ナイノデ、ラツパヲ　カツテ、「コレヲ　サカサマニ　シテ　ミミニ　ツケテ、ラツパノ　シリカラ　キキナサイ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ、ソノ　ラツパヲ　ヨロコンデ　ツカツテ　ヰマシタガ、ミミハ　ドンドン　トホク　ナツテ、トウトウ　ツンボニ　ナリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　オヂイサンハ、「アノ　ラツパデハ　キコエナク　ナツタカラ、モツト　ヨク　キコエルノヲ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ　イロイロ　カンガヘテカラ、マタ　マエノ　ラツパト　オナジ　ラツパヲ　オクツテ、「コノ　ラツパヲ　ミミニ　ツケルト　ワタシノ　コヱガ　キコエマス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ、ソノ　ラツパヲ　ミミニ　アテテ　ミマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さればこそ、七偏人は百物語を催ほして大愚大人を脅かさんと巧み、和合人の土場六先生はヅーフラ（註：オランダ渡来の、ラツパのような形状をした呼筒。",
              "citation": {
                "source": "雨夜の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、中学の時分にラツパ吹きの選手であつた。",
              "citation": {
                "source": "毒気",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
