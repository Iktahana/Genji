        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　実に、気の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　實に、氣の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして向き直ると、両足をブランブランさした。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "氷罅のなかでブランブランに揺れていたのだ。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の部屋へ帰ってみると、事件の発端を作った小太郎が、所在なさそうに、大きな椅子に、足をブランブランさせながら、悄気かえって、父をむかえた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の水夫は上半裸体の胴体を、寝床の手摺に結び付けたまま、床の方へ横筋違いにブラ下っていたが、左手の関節が脱臼するか折れるかしたらしく、ブランブランになって揺れていた。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何もかも先刻の通りの姿で、しかも一人の水夫の片腕がブランブランになっているのが幽霊以上の恐ろしいものに見えた。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この松浦愚と自分は大の仲好しで、二人で醤油買いに行くのに、わざと二本の太い荒縄で樽を釣下げて、その二本の縄の端を左右に長々と二人で引っぱって樽をブランブランさせながら往来一パイになって行くと往来の町人でも肥料車でも皆、恐ろしがって片わきに小さくなって行く。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の内側には、花をいけた壺と、籠の中で金環を嘴でくわえて躯をブランブランさせている鸚鵡と、日向ぼっこをしながら寝こんでいる二匹の小犬とが仄見えている。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから横ポケットにブランブランしている金槌を取って、仕事にかかった。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まだかな」　啓吉は悄気て大きな傘をブランブラン振った。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "康雄は尻にブランブランするカバンを情なく思ひながら、橋の欄干をトントンと掌で叩いて、河のまん中に唾吐いた。",
              "citation": {
                "source": "焔",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの青二才から捲き上げた金を五十両ほど黙って俺に貸せッ」　松吉は、顔一杯を顰めて、グニャリとした手をブランブランと振りながら、「こら化助。",
              "citation": {
                "source": "雷",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "宅ではあんまりよろこばなかったが、彼女たちは私の短かい毛をひっぱって、練油と色元結でくくりつけるのを悦んだ――あたしは店さきに腰をかけて、足をブランブランさせたり、片っぽ飛ばした下駄を足さぐりしたりして、首だけ凝と据えている。",
              "citation": {
                "source": "西洋の唐茄子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "それの片足を攫んでブラ提げながら、ブランブランと打振り打振り、果てはお綾の懐中に入れようとするのであった。",
              "citation": {
                "source": "備前天一坊",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……風にふかれて、ブランブランしているというんです」四十、死体批評会の事　　　並に紅唇の紋章の事　場面一転いたしまして、ここは警視庁の屍体置場。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだか妙にこうブランブランして、まるで他人の手みたいだ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "年に一度のお祭だというのに、今まで家で何をしていたのか、頭から木屑だらけになり、強い薬品で焼焦げになった古帷子を前下りに着て、妙なふうに両手をブランブランさせながら、「ねえ、伝兵衛さん、実に、わしは迷惑なんだ。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "山王祭の大象",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻耶子は高い窓枠に腰をかけ、心配そうに唇をへの字に曲げながら足をブランブランさせていた。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその一端に腰掛け、足をブランブランさせていたが、もう灯台を見あきたので、そこを去りヒョイとその一方から今腰かけたところを望んだら私の腰かけた所が薄い岩のふちだったのでゾッとした。",
              "citation": {
                "source": "若き日の思い出",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっこさんたち、いまはブランブランととぶけいこをしているのさ。",
              "citation": {
                "source": "こわいことを知りたくて旅にでかけた男の話",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランブランの珈琲店は皇帝派をもって立ち、ブールボン派をもって立っているヴァロア珈琲店と対抗していた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "最もよい珈琲はランブラン珈琲店にあり、最もよい撞球台はヴォルテール珈琲店にあることを知っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "二百呎の氷の裂目を、ブランブランと上るのは、危険至極である。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "籠渡しは太い針金に滑車をかけ、滑車から縄でぶら下げた板に乗って、ブランブランと向う岸へ渡るのである。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "北沢はブランブランと針金を伝い始めた。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブランブランと風にゆれる。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "我国の駅馬車も田舎道はブランブランと進むが、村にさしかかると疾駆して通過するではないか。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙突の頂上に腰をかけ、二本の金属の足をブランブランさせ、両手を空ざまにひろげて、おどかしつけるようなかっこうで下界をにらみつけ、例のキーッ、キーッという、いやな叫び声をたてています。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
