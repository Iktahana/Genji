[
  {
    "uuid": "cf9c7ce1-3002-5939-86a7-61f3e06b6d16",
    "entry": "乱交",
    "reading": {
      "primary": "らんこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
