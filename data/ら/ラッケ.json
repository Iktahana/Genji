        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミスタンゲット、――ダミヤ、――ジョセフィン・ベーカー、――ラッケル・メレール。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "西班牙の美女ラッケ・メレの舞踊を見ての礼讃。",
              "citation": {
                "source": "オペラの辻",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "犯人は隠微な手段を藉らずに、堂々と姿を現わして、ブラッケンベルグ火術の精華を打ち放すだろう。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラッケットをさばいて校庭に立っているかれのやせぎすな姿を人々はつねに見た。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニスをやるものもないとみえて、網もラッケットも縁側の隅にいたずらに束ねられてある。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここへお房が入院したばかりの時は、よく私も勧められてテニスの仲間入をしたものだが、最早ラッケットを握る気にも成れなかった。",
              "citation": {
                "source": "芽生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "――と、こんな風にして、私はラッケットこそ手に持たないが、村のパブリック・コオトの傍を通るときなどは、ともすると人々から選手の一人に間違へられさうだつた。",
              "citation": {
                "source": "手紙",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
