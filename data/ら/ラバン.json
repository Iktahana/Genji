      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カバレットのキャラバン、酒場から酒場へ近道の建札、夜の美粧院に吊された青蛙の料理写真にしたらんたん、足の化粧法、日本人を日本人らしく見せない整型学、醜いものをグロテスクにするための進歩主義、あわただしい木馬競走に見惚れる観衆の喝采。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーチになった祭壇のすぐ下には、スナイダーを楽長とするオーケストラバンドが、半円陣を採り、その左には唱歌隊の席がありました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが祭壇の下オーケストラバンドの右側に、「異教徒席」「異派席」という二つの陶製の標札が出て、どちらにも二十人ばかりの礼装をした人たちが座って居りました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その左に小さな演壇、右手にオーケストラバンド、指揮者と楽手二名だけ見える。",
              "citation": {
                "source": "ポランの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのレコード止してくれない」聴き手の方の青年はウエイトレスがまたかけはじめた「キャラバン」の方を向いてそう言った。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞う粉塵が二人の遭難者の休んでいた孤独な断崖にさしかかったとき、もやの中から馬車の帆布と武装した騎手が現れ、それが西部に向かう大きなキャラバンであるということがわかった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ものすごい規模のキャラバンだった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とモルモン教徒の一群は叫び、その言葉はさざ波のように長いキャラバンを口から口へと伝わっていき、隊列の遠くの方で、小さなざわめきとなって消えていった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "「時々キヤラバンが通るばかりで、さぞ淋しいことだろう。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりさ、おまえ、ブラバンなんかやめて、うちへこないか。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、やっぱ、ブラバンやめたくない」　高志は、がっかりして天井を見あげ、それから、思いなおしたように、慶一の顔を見た。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんだよ」「ブラバンは、学園祭、なんにもしないんだろ」「するよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃあ、ブラバンの練習なんか、出なくたっていいだろ」「そうはいかないよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二四〇〇円て計算か」　陳、広岡、峰岸、慶一の四人はブラバンの部員で、峰岸をのぞく三人は、四月から、寮長の鶴の一声で設立が決まった、軽音楽部に移ることになっている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここのところ、バンドのあいまに、またブラバンにも顔をだしてるんだ」「へえ、大いそがしなんですね」「令子は知らないけど、去年、慶一があの先生に夢中になって、エラい騒ぎでな」「へえ、そんなことがあったの」　と、令子は高志に顔をむけたまま、目だけを慶一のほうにはねあげた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバン節破れ銅鑼を、敲かうよ。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバンのバン壁の施條銃、何撃つ銃。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバンのバン破れ銅鑼を、敲かうよ。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバンのバン月はぼんやり、街の上やけのやんパチ、酒場の扉、酔ふて、もたれりや、ギイとあく。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバンのバン波は太平洋の、腐れ波浮世ドブロク、この世は地獄、心中しよにも、相手なし。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバンのバン一万三千尺、富士の山せまい日本が、一眼に見える、お花畑で、カルモチン。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバンのバン白い雀花崗岩の上に樹がある、それは美しい桜の花であつた。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
