  {
    "uuid": "974aa1b5-f201-524e-955e-25b6cf465381",
    "entry": "ラバン",
    "reading": {
      "primary": "らばん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
