[
  {
    "uuid": "08893fac-7f3a-5fc2-96f7-279fd4c52ba7",
    "entry": "蘭人",
    "reading": {
      "primary": "らんじん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Dutchman",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔、長崎には多くの蘭人が住んでいたと聞く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "蘭人との貿易を通じて、日本には新しい文化が流入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その絵画は、江戸時代に日本を訪れた蘭人の手によるものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その時一人の家来があはたゞしく王の前に参り「たゞ今二人の蘭人がこれに見えて、王に戦勝の祝の品を持つて来たと申して居ます。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "謝源には二人の蘭人とは誰と誰であるかゞわかつて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八年前に謝源がこの沖合で難破した蘭人の二人を家来の救ふて来たのを、世話してやつたことがあつた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キツトその蘭人があれから先づ己の国に帰つて又日本に来る途中で自分の戦勝を聞き、取り敢へず祝の品を持つて来たのだらうと思つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその蘭人の恩を忘れぬ美しい心が又となく嬉しく思はれた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "果してあの蘭人であつた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭人はやがて紫の布に包んだ祝の品を恭しく差し出した。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "謝源はその地図を蘭人に示して「もそつと、前に進んでこれを説明して呉れぬか」と言つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "謝源は地図を下に置いて蘭人の説明を待つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈の高い方の蘭人はスラスラ説明をして行つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈の高い蘭人は尚説明をし続けて行つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "謝源はやがて蘭人が指さして呉れる大きな国を想像して居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭人は少しためらつて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその蘭人の為に土足のまゝで鼻柱を挫かれたやうな思ひがした。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の蘭人の言葉は彼にとつては致命的な侮辱であつた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてキツト二人の蘭人を見つめた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭人達はあまりに変つた王の様子にタヾ恐ろしさの為に震つてばかり居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "血ばしつたまなこで蘭人をヂツとにらめつけて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やゝあつて謝源は何と思つたか丈の高い方の蘭人に彼の大杯をグイツと差しのべて「飲んで見ろ」と言つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蘭人はさすがに狼狽した。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際蘭人達は日本酒、殊にアルコール分の強い泡盛は飲めなかつたのである。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わしのやうな小国の王の杯は受けぬと言ふのか、恩知らず奴ツ」彼はこう叫ぶやいなや、その大杯を丈の高い蘭人の額にハツシとぶつけた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭人二人の首は飛んだ。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "椰子、檳榔子の生え茂つた山に添つて、城のやうに築上げた、煉瓦造がづらりと並んで、矢間を切つた黒い窓から、弩の口がづん、と出て、幾つも幾つも仰向けに、星を呑まうとして居るのよ……　和蘭人の館なんです。",
              "citation": {
                "source": "印度更紗",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはね……そのラマンさんという和蘭人のお医者の話によると、ジキタリスという草を、何とかいう六ヶしい名前の石と一緒に煮詰めた昔から在る毒薬で、支那人が大切にする『鴆の羽根』と『猫の頭』と『虎の肝臓』と『狼の涎』という四つの毒薬の中で『鴆の羽根』という白い粉と、おんなじものになっているんですってよ。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時佛國の上下には、露國政府の殘酷な壓制に苦しんでゐる同國の自由主義者及び波蘭人に對する同情が非常に盛んであつた。",
              "citation": {
                "source": "A LETTER FROM PRISON",
                "author": "‘V NAROD’ SERIES’",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜子（西瓜のたね）　烏秋（台湾烏）　　赤嵌楼（蘭人の所謂プロヒレンチヤ城なり）蕃童蕃童は※仔を射る。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜子（西瓜のたね）烏秋（臺灣烏）赤嵌樓（蘭人の所謂プロヒレンチヤ城なり）鴛鴦飛ぶ禽としも、幽かだに思ひかけずておろかさよ、こずゑの雪に鴛鴦のたつる羽音を觀しや君。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、外国商人が裏面で布教し、国内のキリスト教信者の反抗も意外に強かつたので、三代将軍家光は、数度にわたつて、外国商船の往来を禁じ、遂に、寛永十六年（紀元二二九九西暦一六三九）七月、和蘭人と支那人を除く他の外国人との貿易を一切禁止したのである。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "英人リチャード・コックス『江戸日本日記』一六二二年（元和八年）二月二十一日の条、コックス江戸にあり芝居に之く途上オランダ館に入り肥後か肥前の王に邂逅す、武勇な若い人で年々五十万石を領す、今蘭人に事え居る僕一人、先にかの王に事えた縁によりオランダ館を訪ねたのだ。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
