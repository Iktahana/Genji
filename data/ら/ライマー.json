        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ロック・クライマーはただ人が見ているだけで独りで登るときよりはずっと気持が違うというではないか。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か名のあるクライマーであろうと、私は返答の心構えを改めた。",
              "citation": {
                "source": "一つのエチケット",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八一三年にはフイラデルフイアのジヨージ・クライマーが「コロムビア・プレス」を作り、一八二一年には紐育のラストとスミスが「ワシントン・プレス」を作り、一八二〇年にはボストンのダニエル・トリードウエルが世界最初の足踏印刷機を發明した。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラードに良いものがあり、スレザークの歌った「トム・デア・ライマー」などは名演だが日本にはプレスされてない。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポール・ライマーと歌った『セレナーデ』などは腹を立てて打ち割りたくなったものだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本にはないがレーヴェのバラード『トム・デア・ライマー』も、少し劇的ではあるが立派なレコードの一つだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
