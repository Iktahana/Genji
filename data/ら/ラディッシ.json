          "literary": [
            {
              "text": "ダイコンと呼ばれるラディッシの奇妙な一種は重要な食物である。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホースラディッシュは附いていたが、ヨークシャープディングは添えてない。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ヨークシャープディングと迄は行かず、ホース・ラディッシュのみ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "４日目に新生児の臍帯の上にモクサを載せるか、ホースラディッシュで焼灼する。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
