          "literary": [
            {
              "text": "清流釣りのヤマベの瀬釣りに使うラッキョウウキは、何のためにあるかと考えてみた。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラッキョウウキを使わず、五分の玉ウキを使う人がある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは初めからラッキョウウキは使わず、五分玉ウキを使っていたが、からだを低くして打ち込むと、いきなりヤマベが何と間違えたのか、この玉ウキに向かってとびついてきた。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
