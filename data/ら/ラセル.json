        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "満洲ハタダ大資本家大地主ヲ太ラセルダケダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "逆上とは読んで字のごとく逆かさに上るのである、この点に関してはゲーレンもパラセルサスも旧弊なる扁鵲も異議を唱うる者は一人もない。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ、龍宮城デ千年ノ間、若イママデ暮ラセルカ、阿弥陀様ノ極楽浄土ヘ行カセテモラエルナラ、別デスガネ」と答えました。",
              "citation": {
                "source": "手紙",
                "author": "一八九三年七月二二日付　チェンバレン　宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイヤモンドも同様にある場合には毒と考へられ、かの文芸復興期に出た鬼才パラセルズスはダイヤモンド中毒で死んだと伝へられて居る。",
              "citation": {
                "source": "毒と迷信",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから西洋中世の有名な学者達はいずれも「哲学者の石」の発見に浮き身を窶し、中にはそれを捜し当てたといい、パラセルズスはルビー色をしたものだと告げ、ワン・ヘルモントは硝子のような光沢をしたサフランのようなものだと記述した。",
              "citation": {
                "source": "錬金詐欺",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを説明するために、パラセルサス（スイスの医師、博物学者、十六世紀初年の人）の著作『文学上の奇観』の一節を申し上げましょう。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "貸家",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯子、コレ」四阿デ休ンダ時、予ハ袂カラ小サクタヽンダ札束ヲ取リ出シテ手ニ握ラセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手ノストレートガ這入ルト、普通ハ上体ヲ右カ左ヘウイービングスルンダケレド、エスピノザハ上体ヲグット後ロニ反ラセルノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「医者ガ内診スルミタイダ」「馬鹿ネ」「舌ヲ使ワズニ接吻シロナンテ、随分無理ナ註文ダナ」「接吻ジャナイモノ、タヾ唇デ触ラセルダケダモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ首ッ玉ヘ齧リ着キ、頬ヲ擦リ寄セテ走ラセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ彼ガ、イクラ親父ノ髯ダカラト云ッテ、大事ナ女房ニ本気デ剃ラセル気ガアルンダロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女ノ人ニコンナ所ヲ触ラセルノハイヤダヨ」予ハワザトソウ云ッテヤッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノミナラズ、モデルガ誰デアルカト云ウコトヲ彫リ手ニ知ラセズニ彫ラセルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ必ズシモ睡ラセルノガ目的デ飲マシタノデハナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洞院ヲ超エタトコロデ、僕ハ彼女ニモウ尾行シテイナイ※ヲ知ラセルタメニ電車通リヲ北側ヘ渡ッテ、ワザト彼女ニ見エルヨウニ彼女ヲ追イ越シテ進ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "徒ラニ悲シミヲ増サセルニ過ギナイノナラ知ラセルノハ無駄ナノダカラ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンクール兄弟は1861年の「フィロメヌ姉妹」で病院と診療所における生活を1865年の「ジェルミニ・ラセルトゥ」においては下層階級の一夫人の生活を描写した。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
