        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは何故かといふに、元來賦は風、即ち諷刺を目的となすもので、縱令如何に麗靡の辭を極め、麗なりし故、却つて帝をして縹々として雲を陵ぐの志を起さしめた。",
              "citation": {
                "source": "楊雄と法言",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくの如く、彼れは後に賦家たりしことを悔いたのであるが、元來賦を以て立つた人であるから、其結習を容易に除去することは出來ぬ。",
              "citation": {
                "source": "楊雄と法言",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
