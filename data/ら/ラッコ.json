[
  {
    "uuid": "29258bfb-d0ad-5af1-8c01-a426136a673f",
    "entry": "海獺",
    "reading": {
      "primary": "らっこ",
      "alternatives": [
        "ラッコ"
      ],
      "is_heteronym": false
    },
    "grammar": {
