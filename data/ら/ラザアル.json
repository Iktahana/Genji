          "literary": [
            {
              "text": "投獄されたのは、聖ラザアル刑務所だった。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "各方面からの命｜乞いは猛烈をきわめたもので、本人はすっかりその効果を信じているから、聖ラザアルの刑務所で悠々閑々、あの嘘八百の告白体自伝はここで書いたのだ。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸本は連と一緒に旅の荷物を辻待の自動車に載せ、サン・ラザアルの停車場を指して急いだ。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・ラザアルの停車場から汽車に乗つたのは十時であつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョリエットや聖ラザアルの貧民街から出て来る船乗りの遺族たち。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "この、灯のつき初めた巴里の雑沓へ、北停車場なり聖ラザアルなりから吐き出される瞬間の処女のような君のときめき、それほど溌剌たる愉悦はほかにあり得まい。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            }
          ]
        }
