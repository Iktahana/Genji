        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "海ノカナタノ諸々ノ国ノ者ドモニモ知ラセテヤリタイ　ともおつしやつて居られました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく金がないのに高い煙草を吸い、高いマロン・グラセーをかじったのが祟ったと見えて、今日でも時々、西洋に居て金が無くなって困る夢を見る。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "満洲ハタダ大資本家大地主ヲ太ラセルダケダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供が学校が引けると小舟に乗りこんでやって行って、「マイラセ」という小籠に一っぱいか半ばい位いの鰯を貰って来るのだ。",
              "citation": {
                "source": "自伝",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "溝淵氏は自分等の中学時代に『ラセラス伝』を教わった先生であって、その後ずっと高等学校長を勤めておられたがこれもついごく最近に亡くなられた。",
              "citation": {
                "source": "埋もれた漱石伝記資料",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "聲自慢の男がゐて、一段と張り上げた聲で、「アー圓くなれ圓くなれ、一寸圓くなれ、コラセ、十五夜のあの月のやうに。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おつぎは、見るもかわいらしいアラセイトウとカーネーションです。",
              "citation": {
                "source": "イーダちゃんのお花",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロイロナモノガ私ノ心ヲオドラセマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖地パレスティーヌで、サラセン人をほろぼしつくしたのはリシャールです。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスの日がさはサラセン人をきりたふし、よろひへうちこみ、または、そのときのリシャールの王家の旗じるしのやうに空中にゆらめきました。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これではサラセン人も気のどくです。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "剛勇なサラセン人はスパルタ人なの。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソノ　トキ　マドカラ　ミテ　ヰタ　オウマノ　ヲバサンガ、「テフテフデスヨ」ト　花タチニ　シラセマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オネガヒダ、ワタシニ　キラセテ　クレ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナント　イフ　イサマシイ　オトダラウ」　ヲトコノ　ヒトハ　ムネヲ　オドラセナガラ　アシヲ　ハヤメテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただラセンに曲げて描いた水草は常套的であるし、新味を感じられない。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論当時のサラセン嫌悪の風潮で、ゲルベルトをまるで妖術師扱いにしているのだが、とにかくその一節を抜萃してみよう。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラセウムとは、岩狸が尿所へする尿の水分が、蒸発した残りのねばねばした粘液で、カークはこのヒラセウムのある樹洞のまえに、陥穽を仕掛けようとしたのであった。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "逆上とは読んで字のごとく逆かさに上るのである、この点に関してはゲーレンもパラセルサスも旧弊なる扁鵲も異議を唱うる者は一人もない。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "顏は忽ち燻んで、喉がセラセラする程胸が苛立つ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔は忽ち燻んで、喉がセラセラする程胸が苛立つ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コチラノオクサマガ、サクバンオナクナリニ、ナリマシタカラ、オシラセシマス』彼は、こうした文句から激動を受けながら、差出人の名を探ったが、夫は何処にも書いてなかった。",
              "citation": {
                "source": "大島が出来る話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわくマルサスのバラセ町へ貧僧来り、富家に宿を求めると、主婦無情で亭主｜慳貪の由言って謝絶した。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス……ノ……チチ……ニ……テガミ……デ……シラセ……マス……」　という無邪気な日本語が殿下の唇から洩れた。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ私ハ別ノ手段デ、モットモット皆サンニ、思イ知ラセマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつてフランスの旅にあつたころ、パリの郊外にペエル・ラセエズの墓地を訪ねたことがある。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
