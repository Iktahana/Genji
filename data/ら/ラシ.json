[
  {
    "uuid": "9ce9d27d-8d8c-527f-be4a-cb92a42886b2",
    "entry": "螺子",
    "reading": {
      "primary": "らし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
