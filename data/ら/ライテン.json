[
  {
    "uuid": "f8a6806b-6ae3-5909-a603-db2a3a3193b4",
    "entry": "来店",
    "reading": {
      "primary": "らいてん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "coming to a store (restaurant, bar, shop, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎週末に大勢の来店客で店内は賑わっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新しい店舗への来店が予想以上に好調だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "来店キャンペーンで割引を提供して客足を増やした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "諸方の商店は、浅虫家の未亡人御来店とあればたくさん品々を前に並べ、存分に万引していただくことになっている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前はあっちへ引っ込んでなさい――はいはい、ええ、どなた様かまた何の御用か存じませぬが、このとおり夜更けでございますから明朝改めて御来店を願いたいんで、へい。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "お茶漬音頭",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾来十年、大雨大雪の後には、ラスクが出来ているかと言ってわざわざ来店されるお客があるほどで、私の方でも心楽しくこれを店頭に出すことが出来るのである。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち毎年四月一日から八日まで開扉して店でお祭りし、来店されたお客様にも拝んで頂いています。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私は、来店される客の増加に応じて徐々に拡張し、店内は常に相応の賑いを失わぬようにすべきであるという見地から、建築費の節減を計らんがために一挙に大拡張をして、店内が急に淋しみを感ずるようでは、決して策を得たものではないという考えを捨てなかったのです。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、開店以来店に坐っていた番頭の肥田が、恭一が熊本にたつ間際に、売掛代金や何かをさらって、急に姿を消してしまったことである。",
              "citation": {
                "source": "次郎物語",
                "author": "第三部",
                "note": "青空文庫"
              }
            },
            {
              "text": "たったいま大公妃が来店され、この話をされたとき、私は……」　ジェシが激しく反発した。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝早くの来店で、事務所は小僧一人の店番だったので、紳士自ら見に行かれました」　警部補が先回りして言った。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギルレイ氏を少し知っている程度、時々紙幣を金塊に変えに来店したからという。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも一人で食事し、常に正装で来店し、誰とも話さなかった。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
