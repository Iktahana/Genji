        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "石油会社の支配人を……ラルサンという老人です」「その時にあの女を連れて行かれましたか」「行くもんですか。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのホテルでラルサンという毛唐と一緒に食事はしましたがね。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この外に、水夫のフランソアとラルサンの二人。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前ら、海へはいってボートを、リーフから下ろしてくれ」「とんでもないことでございますよ」　と、水夫のラルサンが、かぶりをふった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "えへへ、なんでしたら閣下が鱶へ食糧をおあたえなすっては……」　ラルサンは皮肉をとばす。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐竜といったが、それはラルサンたちの胸へ、ぎくりと大きくひびいた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはゆだんがならないぞ」　このざわめき話に、水夫のフランソアとラルサンの二人は、絞首台の前に立った死刑囚のように青くなった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアとラルサンの二人はしめしあわせて、こそこそ後じさりをはじめた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その横には、水夫のラルサンがよいつぶれて、テーブルがわりの空箱に顔をおしつけたまま、なにやら文句の分らない歌を、豚のような声でうたっている。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "分ったか、フランソアにラルサン」　と、二人の肩を、いくどもたたいた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴかぴか光っていらあ」「ほんとに、あれは金貨らしい光だ」　フランソアとラルサンが、小さい暗礁の上に光るものを見つけて、感心している。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の水夫フランソアとラルサンも、モレロをこのように昂奮させた岩の上の黄金色まばゆき何物かを見つけてしまった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "たたきのめしてやる」「何を、とんちきめ」　フランソアがつかみかかると、ラルサンも負けてはいなかった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアとラルサンは、水夫になって以来はじめて命じられたこの仕事を、とにかくはじめたのだった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モレロと二人の水夫フランソアとラルサンは行方不明だ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアとラルサンの二人の水夫はモレロの指揮にしたがって、丸木舟を作っていたことは読者のすでに承知のとおりだ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つべこべいうと、どてっ腹に風穴をあけるぞ」「へい、へい、やりますよ、やりますよ、何も海まで運ばないというんじゃありませんやね」　フランソアもラルサンも親分格のモレロにかかると、まるで赤ん坊だ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しっ、大きな声を出すな」　ラルサンも眼玉が飛び出るように眸をひらいていた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっ、モレロ親分」「どうした」「セキストン伯爵です」「何」「ほら、あすこに倒れているのは」「うん」　ラルサンが指さす岩の上に、長い綱をつけたまま、両手をのばして倒れているのは正しくセキストン団長だった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアは、後のラルサンに手渡した。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここはパリーじゃないよ、コーヒーなんかあるものか」「あ、そうでしたな」「恐竜の朝飯は何んでしょうね」「そんなこと俺が知るものか、恐竜にきいてみろ」「へーい、もしもし恐竜さん」「こら、だまれ」　モレロの一喝で、ラルサンは首をちぢめた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼をさませよ、お前は、何か夢でも見てるんじゃねえのか」　云われて、ラルサンは、あ、あーとあくびをしようとした。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラルサン、フランソアの勇士も、もちろん大将モレロにしたがって、小さくなった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい兄貴」「なんだラルサン」「あれはいいな、金の卵もいいが、卵よりあの方が高く売れるぜ」「うん、俺も今、それを考えたところだ」「どうだい、ちょうど二匹ずつに分けようじゃないか、恨みっこなしとゆこう」「うん」　二人がそんな相談をしている間に、モレロはあたりをかぎまわすように探しものをしていた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、フランソア、ラルサン、来てくれ、ちょっと手をかしてくれ」　モレロは岩肌をたたいた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのすきにラルサンとフランソアが穴からころがるように逃げて出た。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モレロ、フランソア、ラルサンの身体は、三匹の恐竜の口から、ぼとん、ぼとんと海の中にすてられた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モレロ、フランソア、ラルサンの三人は、気の毒ながら生きかえらなかった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
