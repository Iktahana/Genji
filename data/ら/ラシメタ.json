          "literary": [
            {
              "text": "日本人兵士諸君　日本帝国主義ブルジョアジーハ、諸君ヲシテ、銃ヲ携エ砲ヲ持チ、急速ニ山東ノ地ニ来ラシメタ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本帝国主義ハ、真先ニ掠奪スルタメニ有利ナル戦略的状勢ヲ利用シテ、諸君ヲコノ地ヘ来ラシメタ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語ガ日本人ノ思想ニ與ヘツツアル害毒ハ英國人ガ支那人ヲ亡國民タラシメタル阿片輸入ト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米國ノ十三洲獨立戰ハ其ノ始メ常ニ英兵ニ敗ラレツツ幾年ヲ經過シタル後、最キ有力ナル實力援助ヲ與ヘタル佛蘭西海軍ガ英國海軍ヲ「メーン」岬ニ決定的ニ撃破シテ陸兵輸送ヲ不可能ナラシメタルコトニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
