        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "当の患者はアラレヌ眼付きで。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不正トハ其ノ侵害ガ法律上許容セラレヌモノデアルコトヲ意味スル。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は仕方ナク床ニ戻ッタノデスガ、ドウ考エテモ余リニ無札ナ仕打デハアリ、私が今更ソンナ事ヲイエタワケデハナイノデスガ、道子ガ人妻トシテ余リニヒドイ乱行ヲシテ居ルノヲ見テ、モウ堪エラレヌ、イッソ道子ヲ殺シテ自分モ自殺シヨウト決心シタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国ナドハ埃及ヤ羅馬ノ古物ハ言フ迄モ無ク、印度ノ古物ノミニテモ一館ヲ建テ、今ハ印度ニテ見ラレヌ物マデモ、其ノ中ニハ堆積セリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "喉ガ渇クカラトボーイニ茶ヲ持ッテ来サセ、コンナ時ノ用意ニポケットニ忍バセテ来タセデスヲ二錠、颯子ニモ佐々木ニモ見ラレヌヨウニ、ソット口ヘ放リ込ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ、モウ出ラレヌ。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妹より兄へ）　ウルシド、シンダ、サジ、ケイサツヘツレテユカレタ、コチラヘコラレヌカ。",
              "citation": {
                "source": "偽悪病患者",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
