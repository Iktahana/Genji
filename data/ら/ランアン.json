          "literary": [
            {
              "text": "外国人向きの日本遊覧案内だ。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "驛前の賣店で簡單な鎌倉江の島の巡覽案内を買ひ、私とユキとは地圖の上に額と額とを突き合せて、圓覺寺の所在をさがしても分らなかつた。",
              "citation": {
                "source": "滑川畔にて",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠い昔、新聞の遊覽案内をみて、くみ子と二人で多摩川へ遊びに行つたことを彼はふつと思ひ出してゐた。",
              "citation": {
                "source": "多摩川",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊豆バスの遊覽案内にも、頼朝遺蹟は少くない。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
