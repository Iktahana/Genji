[
  {
    "uuid": "fbcb2c66-7fc1-531b-a426-c2ed2af49785",
    "entry": "卵塊",
    "reading": {
      "primary": "らんかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "egg sack (frog, spider, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "池のほとりには、カエルの卵塊がいくつも浮かんでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "クモの巣の隅に、白い小さな卵塊を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は珍しい昆虫の卵塊を発見し、慎重に観察を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "コロンブス時代以前のペルーミイラの頭皮に大量のシラミの卵塊を見つけたがミイラになった成虫を見つけることができなかった。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちの３人の頭皮には卵塊だけでなく発生のすべての段階のシラミが得られた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵は一種のセメント様物質で衣服の繊維に付着し卵塊を形成する。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、俺ら、初めからそんなこた皆目知らんじゃが、なんとかならんかいのう。",
              "citation": {
                "source": "砂糖泥棒",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（誰でもないよ、バキチだよ、もと巡査だよ、知らんかい。",
              "citation": {
                "source": "バキチの仕事",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが解らんかいな。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも旅の衆の愛嬌じゃ言うて、豪い評判の好い旅籠屋ですがな、……お前様、この土地はまだ何も知りなさらんかい。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生も少し極って、「もっとこれへ寄らんかい。",
              "citation": {
                "source": "朱日記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　――私が息を切つて、頭を掉ると、（分らんかい、白痴めが。",
              "citation": {
                "source": "人魚の祠",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ前なる橋の上に、頬被した山家の年増が、苞を開いて、一人行く人のあとを通つた、私を呼んで、手を擧げて、「大な自然薯買うておくれなはらんかいなア。",
              "citation": {
                "source": "城崎を憶ふ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕がもし蕪村ならこう作るね、ひともとの梅に遅速を愛すかなこれでいゝ」　聴いていたわたくしは、なぜかぷっと吹き出しまして、「あんたの独り合点の発句じゃない」　と言いますと、池上は、「これが判らんかい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっとは恥かしいいうことを知らんかい。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでタッタ一つ解らん事がある」「何が解らんかい。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は出来ませんと云うて、何故最初から遠慮しなさらんかいな。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、あっちからはいらんかいな」叱りつけるように言った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「うちでもさっさと作らんかい」とどやしつけられた開発担当者、製造担当者の顔は、その後の徹夜続きで黒くなった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何がわからんかい」　しばらくしてから、倉地は葉子の肩越しに杯を取り上げながらこう尋ねた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃ、きょう一日おじさんの子どもにならんかい」「いちんちだけなの……？",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその翌日から母親はもう、「繁はまだ帰つて来やはらんかいな。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そない言はんと、せめて秋まで延ばしなはらんかいな。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そやつたら止めなはらんかいな。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、轢きやがれ、轢きやがらんかい。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ上らんかいの。",
              "citation": {
                "source": "恭三の父",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……火事がいく、何処が焼けますのや、……しようもない、確かりしなはらんかいな。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小剣",
                "note": "青空文庫"
              }
            },
            {
              "text": "……火事がいく、何處が燒けますのや、……しようもない、確かりしなはらんかいな。",
              "citation": {
                "source": "鱧の皮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "「學校の戻りに遊んでるんやおまへん、ちやんと家へ戻つて、『只今』をしてから遊びに行きなはらんかいな。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」と、この時始めて二重はしを旦那に着せて、「確乎しなはらんかいな。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "「饅頭はまだ蒸さらんかいのう？",
              "citation": {
                "source": "蠅",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「糸ッ、何を泣いてるのや、早出してやらんかい。",
              "citation": {
                "source": "十姉妹",
                "author": "山本勝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前も一しょに帰らんかい。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
