          "literary": [
            {
              "text": "舶来鉄砲には、第一に三つぼんど筒というのがある。",
              "citation": {
                "source": "近藤勇と科学",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は元来鉄砲組の組頭をしていた軽輩じゃ。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レールの幅は狭軌で能率のわるい鉄道ながら、ともかく日本には明治以来鉄道が普及しているし、それと同じに天皇制軍国主義的国民教育というものが、明治以来全国にしみとおっています。",
              "citation": {
                "source": "新しい抵抗について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は生れて以来鉄拳をふるったのは始めてだが、さいわい、相手の学生がだらしなくノサレて、三人ながら、ひっくりかえった。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "水神丸が、正にその舶来鉄屑を満載しているので六さんはにこにこしているのである。",
              "citation": {
                "source": "ダルマ船日記",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            }
          ]
        }
