        "examples": {
          "standard": [
            {
              "text": "大量の帳票を印刷するため、会社では高速なラインプリンタが導入されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古いコンピュータ室には、常にガタガタと音を立てるラインプリンタがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ラインプリンタは、ドットインパクトプリンタの一種で、耐久性に優れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "大学時代に専攻した「機械」が考慮され、配属先は府中の周辺端末機器事業部となり、ここでラインプリンターの開発に携わった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "大型コンピューター用の高速印字装置であるラインプリンターには、大きな音が付き物だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
