          "literary": [
            {
              "text": "乱山重畳、草鞋の穿けぬ人の通るべき道ではない。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "近時僧癩可これを用ひて云ふ、乱山争落日と。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（老学庵筆記、巻四）○放翁六十歳の時の詩に、「独り立つ柴荊の外、頽然たる一禿翁、乱山落日を呑み、野水寒空を倒にす」といふ句がある。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "乱山堆裡に茅蘆を結んでゐても、恩給証書に貯金の通帳位は持つてゐたのだらうと思つてゐる。",
              "citation": {
                "source": "野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "天風捲海動乾坤、万丈浪花檣上翻、探句試題此光景、乱山堆裏一船奔。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
