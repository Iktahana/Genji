        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今夜はまたとても高踏的な漢籍の列子の中にあるという淵の話を持ち出して父は娘に対する感情をカモフラージュした。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ぴきの雌に対する三びきの雄の候補者であることを自他の意識から完全にカムフラージュしていた。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミラージュも見えた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アフリカのほうにははるかに兀とした岩山の懸崖が見え、そのはずれのほうはミラージュで浮き上がって見えた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリに滞在中下宿の人達がある夜集まって遊んでいたとき「ノーフラージュ」をやろうと云い出したものがあった。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長がいきなり「ノーフラージュ（難船）」と怒鳴ると、移動がぴたりと止まるのである。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これについてはベーロ・ボラージュの「映画の精神」（〔Be'la Bala'zs : Der Geist des Films, 1930〕）を読むことをすすめたい。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際プドーフキンでもエイゼンシュテインでも、ボラージュでもそれらの人々のモンタージュに関する論述を読むに当たって、その記述の表面に現われた具象的なものを適当にムタティス・ムタンディスに置き換えさえすればそれはほとんど完全に他の芸術の分野に適用されうることを見いだすであろう。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベーロ・ボラージュ、映画美学と映画社会学（前掲「映画の精神」の邦訳、佐々木能理男訳）。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年の七月に発表し、十二月から出荷を始めたばかりのＮ５２００用のアプリケーションをあわせて担当していたことも、カムフラージュには有利な条件だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "創刊号にはこれもなぜか、入れ歯をむき出しにしたカーク・ダグラスの頭を裸のランナーの首の上に載せたコラージュが掲載されている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここからは音のコラージュだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "小柄な・眼鏡をかけた看護婦のラージュ嬢が、今日は大変頼もしく見えた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "△藤岡一氏――『マンドリン』『花甘藍』と題をつけるのはあまりにシャバ気がある、無題とまで徹底できなかつたら、かうしたコラージュ的な仕事を廃した方がいい。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "上述通りウーズ州にもっとも狼害多いが、ここのジャンワール、ラージュプット族は狼と厚縁あり、その児女狼に食われず、時としてその※に養わると信ぜらるというから、突厥狼種と等しく、狼育人児の一件に基づいて狼を霊物としたのが少なからじ（一八九六年版、クルックの『北印度俗宗および俚俗』二巻一五二―三頁。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくそれから後というもの私は、その記者某から指導されるまにまに、自分自身の過去を、すっかりカモフラージュしておりました……。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに我が同胞諸君は、服装をもつて唯一の思想的表現なりと勘違いしたか、そうでなかつたら思想をカムフラージュする最も簡易な隠れ蓑としてそれを愛用したのであろう。",
              "citation": {
                "source": "戦争責任者の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂ミラージュとか蜃気楼とかって奴さ。",
              "citation": {
                "source": "石塀幽霊",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも敵影は巧みにカムフラージュされて、我々はその覘いどころが見付からないのです。",
              "citation": {
                "source": "国際殺人団の崩壊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがその異様ないでたちの彼を何と思って眺めたであろうか、スカートの短いところでカムフラージュされるとしても、生憎彼にしなだれかかっていたコケットのおキミを見落す筈はなかった。",
              "citation": {
                "source": "国際殺人団の崩壊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "用意万端ととのえたが、敵機は仲々来らず（後で考えると、敵はカムフラージュに錫箔をまいたらしい、そしてそのかげに集結するためかなり時刻がたったらしい）やっと九時半頃百機ばかりの大編隊となって南より北へとぶ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとから白木の弁解するところによると、これも重要なる作戦の一つで、われらの旅行目的をカムフラージュし、且つはメントール侯の日常を知っている娘さんたちを味方につけて、翌日以後大いに利用しようという魂胆だったということである。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ身嗜みで不器量をカムフラージュしているという方だ。",
              "citation": {
                "source": "獏鸚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの図太い老耄奴、鼠の輸入なんてどうも可笑しいと思っていたがなんのこと真珠の密輸をカムフラージュするためだったのか、よし今日こそ、のっぴきならぬ証拠を抑えて、監視失敗を取りかえさなければならない。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは貴下を煩わした方が、巧みにカムフラージュにもなるし、またお手際も私どもより遥かに美事であろうと思うのです。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "特務機関をつとめる僕にとっては、このカムフラージュの八時間の生活は、休憩時間として作用してくれる。",
              "citation": {
                "source": "人造人間殺害事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからあんたの出来る限りのカモフラージュはね。",
              "citation": {
                "source": "罠を跳び越える女",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
