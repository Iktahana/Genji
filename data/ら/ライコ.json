[
  {
    "uuid": "b61c869e-0419-56a7-ad42-47626b5e8d8b",
    "entry": "雷鈷",
    "reading": {
      "primary": "らいこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
