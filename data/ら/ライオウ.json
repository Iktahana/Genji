    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "武装兵の行進、諸｜酋長の来往、漸く繁し。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方の大豪族である処から京の公卿衆が来往することが屡々であったらしく、義元の風体も自から雅かに、髪は総髪に、歯は鉄漿で染めると云う有様であった。",
              "citation": {
                "source": "桶狭間合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "――廬を結ぶ古城の下、時に登る古城の上、古城｜疇昔に非ず、今人自ら来往す――一九三二年、秋ちかきころ、私はそんな古詩を愛誦しながら、愛国の詩をつくりたきものよ！",
              "citation": {
                "source": "私の万年筆",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ唯だ海辺の一漁村、人烟稀にして家少なく、数屋の茅檐、燕来往し、一匹の小犬全里を護る。",
              "citation": {
                "source": "客居偶録",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "此日は之れ当年第一の夏漁、頓て見る村童頻々として来往し、人々一尾を携へざるなく、家々鮮肉を味はざるなし。",
              "citation": {
                "source": "客居偶録",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月元旦憶亡友吉川泰嶽居士來往風塵學古狂　　風塵に来往して古狂を学び、長忘嶽麓蘭の芳を忘る。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう男女の落ち行く先は、古来往来同一である。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜動に巍々たる大廈石室なり、その市街に来往する肥馬軽車なり、公園の壮麗、寺院の宏大、これを作りてこれを維持するその費用の一部分は、遠く野蛮未開の国土より来りしものならん。",
              "citation": {
                "source": "教育の目的",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "警護の者が往来往来と人を払ってくるうちに、だんだんと曳いて来る三十番雉子町の花車、それに続いて踊り屋台と順に乗りくみ、そこへ神田橋のほうからも御上覧がすんで三十五番三十六番とワッショイワッショイ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧亜間の海に至っては五拾哩で、南路の広い所を迂回しても弐百哩位なもので、その間は幾多の島つづきであって、小舟を以て自由に来往される。",
              "citation": {
                "source": "東西相触れて",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十二年は、小芝居と大芝居との間を、天下晴れて来往してゐる。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "月あれども地上の光天をかすめて無きが如く、来往の船は自ら点す燈におのが形を示し、棹に砕けてちらめく火影櫓行く跡に白く引く波、見る者として皆な暑さを忘るる物なるに、まして川風の肌に心地よき、汗に濡れたる単衣をここに始めて乾かしたり。",
              "citation": {
                "source": "良夜",
                "author": "饗庭篁村",
                "note": "青空文庫"
              }
            },
            {
              "text": "でつまりカントにとっては、弁証法なるものは、アリストテレスなどでもそうであり、又その言葉自身が元来往々そう使われて来たように、論理の云わば消極面、否定的な面を云い表わすもので、夫は論理学の正面に位置するものではなかった。",
              "citation": {
                "source": "辞典",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "上帝を信ずるものと信ぜざるものと、苦楽の境裏を来往するに寸分の差等あることなし。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしてその線下に来往する人は、蟻のごとく見ゆるなり。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨過春風入野塘、烟濃水暖百花香、寒喧来往何其急、昨日冬衣今夏装。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "また会堂のほかに、停車場内および郵便局内をはじめとし、市街いたるところにヤソ像を安置し、その前を来往するもの貴賤を問わず、車中にありても馬上にありても、必ず礼拝して過ぐ。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "早朝、歩を市街に散ずるに、救世軍の一行（みな婦人）、各街角に銭函を携えて佇立し、来往の人に一ペンスずつ恵与を請う。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　この間、汽船来往はなはだ頻繁なり。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、ベルリン街路には自動靴をうがちて来往するものあるも、はじめてこれを見る。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩に至り納涼の客湖畔を徘徊し、橋上の来往織るがごとし。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "街上の婦人を見るに、頭に風呂布をかぶり、その上に物貨をいただき、前に前垂れをしめて来往す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペルナンブコ港は人口十九万人を有し、南米の最東端にあり、その市街は小舟にて来往するを得るをもって、西半球のベニスの称ありという。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "市街は矮屋小店のみなるも、汽車の来往頻繁なるは、石炭輸送のためなり。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　帰路、中央街たるアラメダ街を一過するに、その道三十五間ないし四十間の広さを有し、※樹陰を成し、樹下来往織るがごとし。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆえに、街上を見るに日本服を着たる婦人、列をなして来往す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "）巴里三春日、満城来往譁、珈琲店頭客、深夜未帰家。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "之れを大隈伯が、久しく政権と近接せざるに拘らず、常に夫の終始順境を来往する伊藤山県両公と盛名を※うし、既に政党の総理を辞任したる後すらも、尚ほ且つ生気溌溂たる政治家たるを失はざるに比すれば、其の差果して奈何と為すや。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラックの来往はげしく、活気が溢れている。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "廬を結ぶ古城の下　　時に登る古城の上　　古城は疇昔にあらず　　今人おのずから来往す　年老い、ひとり古都の地に結廬して往昔をしのび物思いにふけり憂さを酒にまぎらすにしても、往昔泰西の地に於て、城主夫人の柳腰をいだき古城のほとりを歩いた花の時代あって、何の不足かあるべき。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
