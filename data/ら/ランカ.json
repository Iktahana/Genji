  {
    "uuid": "8efab7ee-94c8-54d5-bc45-d8e7f51d10fb",
    "entry": "覧可",
    "reading": {
      "primary": "らんか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "兄御許にアメリカ沙汰申上候に付、御覧可被成候。",
              "citation": {
                "source": "手紙",
