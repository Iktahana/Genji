        "examples": {
          "standard": [
            {
              "text": "打球は高々と上がり、ライトのフェンスを越えるホームランになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼は今シーズンからライトのレギュラーに抜擢された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "センターへ抜けそうな当たりをライトが好捕した。",
              "citation": {
