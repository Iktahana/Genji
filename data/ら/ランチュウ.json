[
  {
    "uuid": "f244d8aa-b47d-5d0f-a6a7-3dd7a1e920ca",
    "entry": "蘭虫",
    "reading": {
      "primary": "らんちゅう",
      "alternatives": [
        "ランチュウ"
      ],
      "is_heteronym": false
    },
    "grammar": {
