      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "ranchu",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "品評会で金賞をとることを目標に、専用の大きな水槽で水質やエサにこだわり抜き、毎日丹精込めて数年間育て上げた見事な肉瘤を持つ立派な蘭虫を、ついに出品する予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "近所の神社の夏祭りの縁日で子供と一緒に金魚すくいをやっていたら、普通の和金に混ざって、背びれがなく丸っこい体型をした珍しい小さな蘭虫が元気に泳いでいるのを偶然見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "田舎に住む金魚の愛好家である祖父の家の広い庭には、赤や白の更紗模様が美しい色鮮やかな蘭虫がゆったりと優雅にたくさん泳ぐ、コンクリートで作られた立派な飼育用の大きな水槽がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "明日からは土塀の方の手が足らんちゅうから、あちらの手伝いに廻ったろかい』信徒二『そやそや。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「老先生は十日ばかりしたら帰る、それも能くは解らんちゅうて……」「そうか……」と校長は嘆息をしていたが、「また来る」と細川は突然富岡を出て、その足で直ぐ村長を訪うた。",
              "citation": {
                "source": "富岡先生",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、粘土細工、積木細工、絵草紙、メンコ、びいどろのおはじき、花火、河豚の提灯、奥州斎川孫太郎虫、扇子、暦、らんちゅう、花緒、風鈴……さまざまな色彩とさまざまな形がアセチリン瓦斯やランプの光の中にごちゃごちゃと、しかし一種の秩序を保って並んでいる風景は、田舎で育ってきた私にはまるで夢の世界です。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、私がもう一度引きかえしてみたいといいだす前に、浜子はふたたび明るい方へ戻って行き、植木屋、風鈴、花緒、らんちゅう、暦、扇子、奥州斎川孫太郎虫、河豚の提灯、花火、びいどろのおはじき……いい母親だと思った。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出入って、博徒の仲間にはいったのか、女出入か、縄張りか」　それならまだしも浮浪者より気が利いていると思ったが、「闇屋の天婦羅屋イはいって食べたら、金が足らんちゅうて、袋叩きに会いましてん。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "クヤクヤ貴様は何じゃ、往来で大声放歌はならんちゅう位の事は心得て居るじゃろう。",
              "citation": {
                "source": "煩悶",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る箱の葭簀の下では支那らんちゅうの目の醒めるようなのが魁偉な尾鰭を重々しく動かしていた。",
              "citation": {
                "source": "高台寺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはね、らんちゅうというんだよ。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勉強がすむと、さっそく金井君はらんちゅうのうたをつくりました。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "はでなおじさんだなァ黙っているから変だよ君はぬれたきものをいつかわかすのどこへでも水をもって旅行しているらんちゅうのおじさんどこから来たの君はだまっているからみんなが君を笑っているよ。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の上の水の光にらんちゅうはきわまり燃ゆる四囲ながめぬ「これはねえ、空襲最中のらんちゅうだよ」　そういって、おとうさんはおかしそうに笑いました。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "家が焼けている最中に、らんちゅうなんか持って逃げる人はないでしょう。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水がにえて来る時のらんちゅうはどんなに悲しかったでしょう。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はそのころ、おかあさんとふるえながら、壕の中で、一面火の海になったのを見ていましたけれども、らんちゅうのことなんか気がつきませんでした。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けンど、所謂情況証拠ちゅう奴が、大分揃うていますさかい、私はえらい大胆な判断やけど、ひょっとしたら、今の和武は偽者やないかしらんちゅう事を砂山さんに報告しました。",
              "citation": {
                "source": "黄鳥の嘆き",
                "author": "――二川家殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩のさした盃を受け取らんちゅう法があるか！",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ犯人はつかまらんちゅう話だす。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ嫁かさらんちゅうことだてば、判官様に、嫁様が来ただら、化けて来べえて、ハッハッハッ。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まだ帰えらしゃらんちゅうだか。",
              "citation": {
                "source": "越後の冬",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつらはらんちゅうとか獅子頭とか云うので、育て方がひじょうにむずかしく、父の丹精は誰にもまねのできないものだったそうだ。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それはらんちゅうとか獅子頭とかいう例のぶざまなやつで、父の献上したものだということがすぐにわかった。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お前はいらんちゅうし、おれも、持っとっても、碌なこたないけ、思いきって、海の中に投げこんでしもうたよ」「ほんとですよ」と、また、マンがいった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "街光と騒音をあびながら、女将は、人浪に押されながら、らんちゅうのように泳ぎたがる彼女たちを、「迷子になっても知らないよ。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
