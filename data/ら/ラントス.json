          "literary": [
            {
              "text": "大正十二年五月北一輝緒言　今ヤ大日本帝國ハ内憂外患並ビ到ラントスル有史未曾有ノ國難ニ臨メリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "經濟的組織ヨリ見タルトキ現時ノ國家ハ統一國家ニ非ズシテ經濟的戰國時代タリ經濟的封建制タラントス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ヲ機トシテ國家ガ收得ヲ計ラントスル社會政策者流ノ人權的思想ニ不徹底ナルヲ思考スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那ハ亦大戰ノ結果ニヨリテ急轉直下純然タル印度タラントス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "早ク已ニ揚子江流域ハ英國ノ勢力範圍ナリト云ハルル今日、日本ヲ相手方トシテ英獨協商ヲ日英協商トシテ支那ニ臨ム時、明治大帝ハ何ノ爲メニ日露大戰ヲ戰ヒシカヲ解スベカラザラントス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "文明推移ノ歴史ヲ只過去ノ西洋史ニ認メテ而モ二十世紀ニ至リテ漸ク眞ニ融合統一シタル全世界史ノ編纂ガ始マラントスル時、獨リ世界史ト將來トニ於テノミ其ノ推移ヲ思考スル能ハズトスルカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "計略ハ密ナルヲ良シトスだの、敵ヲ図ラントスレバ先ズ味方ヲ図レなどという格言は紅国軍部といえどもよく心得ているのであった――というような結末まで、ゆっくり探偵小説に書いていると、いくら枚数があっても……。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭髪同ク種々タラントス。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾レ且ツ汝ニ謝スルノ暇有ラザラントスルナリ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "○蓋シ其趣旨ヲ察スルニ、斯ノ如クシテ我国内ニ大兵ヲ送ラントスル為メナリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠キハ招クガ如ク近キハ語ラントス。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今秋マサニ鎌倉移住ノ命アラントス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余｜乃携ル所ノ巨玉巵ヲ出シ自ラ酌ムコト三タビニシテ、コレヲ属シ即チ辞シテ去ラントス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪ナラントスルノ天。",
              "citation": {
                "source": "『雪華図説』の研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夙夜、憂思シテ恐ル、将ニ天下危ウカラントスルヲ。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル秋ニ意ワザリキ、将星｜墜チントシテ、我｜今生ノ命スデニ終ラントスルヲ天ノ告ゲ給ウアラントハ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
