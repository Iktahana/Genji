        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オトウサンハ　クルツト　コチラヲ　ムイテ　タキクンヲ　ヒザノ　上ニ　ノツケマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「フーン」小サイ　デンデン蟲ハ、オカアサマデモ　ワカラナイ　フシギナ　トホイ　ソラヲ、ホソイ　メヲ　一パイ　ノバシテ　イツマデモ　ミテ　ヰマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ　キイタ　コノ　マヅシイ　ヲトコノ　ヒトハ、「ヨシ、ソレデハ　ジブンモ　センサウノ　アル　トコロヘ　イツテ、リツパナ　テガラヲ　タテ　タイシヨウニ　ナラウ」ト　ヒトリゴトヲ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレサヘ　アレバ　ジブンハ　テガラヲ　タテル　コトガ　デキル。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タウトウ　チヤウサンハ　ハラヲ　タテテ　シマヒマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニカト　マウシマスト、ホカデモ　アリマセン、オホキナ　ハゲシイ　オナラヲ　スル　コトデ　アリマス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチガ　オナラヲ　シナカツタカラデ　アリマス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレハ、イタチサンガ、オナラヲ　シタイノヲ　アマリ　ガマンシテ　ヰタノデ　コンナ　コトニ　ナツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ　ナホスニハ、イタチサンニ　オモヒキリ　オナラヲ　サセルヨリ　シカタハ　アリマセン」　ヤレヤレ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "告　皆サンモ知ッテイル通リ、本日何者カヾ当工場ニ「失業者大会」ノビラヲ撒イテ行キマシタ。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、ヒラガナトイウモノハ、元来毛筆ナラビニ和紙トイウモノトトモニ育ツテキタモノデ、ソレラヲ離レテハホトンド生命ノナイモノト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オソラヲ　ミレバズンズントオ山ノ　上ヲワタノヨニウイテル　クモモトビマシタ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "スベテ渦巻ケル地平ノ向背カラ　自ラヲ標的トスル虚妄デハナイカ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ハラヲタテテ　ソノママオ家ヘモドリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　マイニチマイニチ　フタリハ　カウシテ　コウラヲ　ホシナガラ　ネムツテシマヒマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "部署既ニ畢ルヤ出デヽ朝廷｜頒ツ所ノ府県奉職規則ヲ示シカツコレニ告ゲテ曰ク、余東京ヲ発スルノ前幾日、皇上｜便殿ニ宣光ラヲ引見シ詔シテ曰ク民ハ国ノ本ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コカコラヲ飲ムト間モナク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ガコレラヲ撮ッタ目的ハ何ニアルカトイウト、第一ハ撮ルニ愉悦ヲ覚エタカラダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ目的ハ、コレラヲ僕ノ日記帳ニ貼付シテオクハ希有ノニヨッテ彼女ヲ極度ニ辱カシメ、彼女ガドコマデシラヲ切ッテイラレルカヲ試シテヤリタイノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシソウナラバソレハ誤リデ、僕ハ彼女ラヲ同等ニ愛シテイルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右ノ足ガ二ツ、左ノ足ガ二ツ、水中ニアルヨウニ浮遊シテイルノガ、ソノ肌ノ白カッタノアル、アノ通リノ形状ヲシテ真正面ニコチラヲ向イテイル臀ガアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシタラコレ以上情慾ヲ駆リ立テルナシニ、彼ラヲコレ以上接触サセルニハドウイウ方法ガ残ッテイルカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かように申す間にアメノコヤネの命とフトダマの命とが、かの鏡をさし出して天照らす大神にお見せ申し上げる時に天照らす大神はいよいよ不思議にお思いになつて、少し戸からお出かけになる所を、隱れて立つておられたタヂカラヲの神がその御手を取つて引き出し申し上げました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時に先に天の石戸の前で天照らす大神をお迎えした大きな勾玉、鏡また草薙の劒、及びオモヒガネの神・タヂカラヲの神・アメノイハトワケの神をお副えになつて仰せになるには、「この鏡こそはもつぱらわたしの魂として、わたしの前を祭るようにお祭り申し上げよ。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヂカラヲの神はサナの地においでになります。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦とは――豆ヲ煮ルニ豆ノ豆ガラヲ燃ク――ようなもの。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
