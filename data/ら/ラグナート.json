        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いつも哀れなインドのプロレタリアートのために親切な医者として働いているヨーロッパ人のチャンドラナート・パープの息子、ラグナートとウペシュは友達になった。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラグナートが、左手の隅のカーテンの中へ一寸入ると、室じゅうが急に真暗になった。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "観衆の少年少女はラグナートの緊張を自分の心に感じて息をころしている。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラグナートの声の方を見ていると、細長い箱みたいなところがボーッと明るくなって、人間の形が浮き出たかと思うと、　――ヒヤーッ！",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラグナートは今度ウペシュをカーテンの中に入れ、　――そこんところへ手を出してたまえ。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物の子供たちと日本女とはラグナートと一緒にハアハア大笑いし、同時に、実はそっと一安心する。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
