        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "哲学ハ、知ヘノ愛デハナクテ、真実ノ知トシテ成立セシムベキ様ノ体系知デアル、ヘエゲル先生ノコノ言葉、一学兄ニ教エラレタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサデス　ツユノ　ヒカルミチコブヲ　トラレタ　オヂイサンツマラナサウニ　ホホヲ　ナデオヤマヲ　オリテ　ユキマシタ　瘤は孤独のお爺さんにとつて、唯一の話相手だつたのだから、その瘤を取られて、お爺さんは少し淋しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサデス　ツユノ　ヒカルミチコブヲ　トラレタ　オヂイサンツマラナサウニ　ホホヲ　ナデオヤマヲ　オリテ　ユキマシタ　瘤は孤獨のお爺さんにとつて、唯一の話相手だつたのだから、その瘤を取られて、お爺さんは少し淋しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ、支那ノ軍事的分割ハ、既ニ始メラレタ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモハ　ナカヨシダツタノデスケレド、アンマリ　マンナカノ　ホシガ　サムイ　サムイト　イフノデ　ホカノ　二ツノ　ホシニ　イジメラレタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヌスビトハ　パント　コヒツジト　トリカヘツコ　シマシタガ、ヒヤクシヨウノ　テニ　ブラサゲラレタ　コヒツジガ　カワイソウニ　ナツタノデ、トリカヘツコヲ　ヤメテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "固ヨリ削除セラレタル一行一句ト雖モ日本ノ法律ニ違反セル文字ニ非ルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ元首が賣名的多辯ヲ弄シ下級俳優ノ如キ身振ヲ晒シテ當選ヲ爭フ制度ハ、沈默ハ金ナリヲ信條トシ謙遜ハ美徳ヲ教養セラレタル日本民族ニ取リテハ一ニ奇異ナル風俗トシテ傍觀スレバ足ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ如何ナル國民モ間接税ノ負擔者ナラサルハナシト云フ納税資格ノ擴張セラレタル普通選擧ノ義ニ非ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "無償ヲ以テ徴集スル所以ハ、現時大資本家大地主等ノ富ハ其實社會共同ノ進歩ト共同ノ生産ニヨル富が惡制度ノ爲メ彼等少數者ニ停滯シ蓄積セラレタル者ニ係ハルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ都市ノ私有地ヲ許サザルガ故ニ、設定セラレタル地上權ヨリ利得ヲ計ルコトヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ此ノ二者ノ制限ハ現今マデ放任セラレタル道徳性ヲ國家ノ根本法トシテ法律化スルニ過ギザルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又今囘ノ大戰ニ暴露セラレタル如ク日本ハ自營自給スル能ハザル幾多ノ工業アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現今ニ於テハ資本制度ノ壓迫ニヨリテ勞働者ハ自由契約ノ名ノ下ニ全然自由ヲ拘束セラレタル賃銀契約ヲナシツツアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父生存シテ而モ父ニ遺棄セラレタル兒童亦同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父生存シテ遺棄セラレタル兒童亦同ジキハ凡テ此ノ理由ニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只英語ホド普及セズシテ而モ英語思想以上ニ影響ヲ與ヘタル獨乙語ニ依リテ其ノ害毒ノ緩和セラレタル天裕ヲ有スルノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ニ示サルル如ク印度ニ起リタル亞細亞文明ハ世界ヨリ封鎖セラレタル日本ヲ選ビテ天ノ保存シタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ニ對シ又ハ世界ニ對シテ勳功アル者ハ、戰爭政治學術發明生産藝術ヲ差別セズ、一律ニ勳位ヲ受ケ、審議院議員ノ互選資格ヲ得、著シク増額セラレタル年金ヲ給付セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ革命黨ハ依然トシテ志ヲ得ズ、露國又依然トシテ強大ヲ維持シ講和條約ハ單ナル休戰條約トシテ調印セラレタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ亞細亞ニ與ヘラレタル使命ハ英人ノ罪惡ヲ再ビスルヲ許サズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ日本々國ニ於テ先ヅ此ノ三大原則ヲ確立シテ擴張セラレタル領土ニ臨ムトキ、眞ノ公平無私ハ自ラニシテ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ日本々國ヨリ派遣セラレタル改造執行機關ニヨリテ改造セラルル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ東西文明ノ融合ヲ促進スルタメニ特ニ日本ノ思想制度ニ感化セラレタル彼等ノ移住ヲ急トスルガ故ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ獨逸ノ實戰シタル軍隊ハ徴兵制ノ佛蘭西ト露西亞ニシテ、甲ノ徴兵國ガ乙ノ徴兵國ニ破ラレタリト云ヒ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ傭兵ト獨逸ノ徴兵トノ優劣ハ實戰ニヨリテ立證セラレタルモノニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只退却將軍ノ報告文トシテ古今獨歩ノ文豪「ヘーグ」元帥ニヨリテ英國傭兵ノ光榮ハ十分ニ認知セラレタルハ周知ノ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "生死ノ煩悶ヲ天空ニ求ムル如キ低級極マル小乘的信仰ヲ以テ、印度文明ノ密封セラレタル寶庫トシテ漸ク將ニ二十世紀ノ今日ヲ待チテ開カレントスル日本民族ノ大乘的信仰ニ對セントスル如キハ、實ニ龍車ニ向フ蟷螂ノ斧。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ンヤ學者文士輩ノ口耳ヨリ濫造セラレタル思想ナル者ノ自由ヲヤ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
