        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "では、どこから脱け出したのだろうと見廻すと、なるほど、監房の窓がバランバランになっている。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私ユーランバに住んでゐた嘉村由子といふ者ですの。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "お忘れでせうね」　ユーランバ。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーランバは、遊覧場とあてるのかも知れない。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーランバは、ポプラに囲まれた千坪ほどの極めて小さな住宅地だつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユーランバのことですか」と彼はきいた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "カトリック教会堂は即ちユーランバに隣接してゐる。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから少し上に昇ったところでロン・ランバという駅がある。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士の階級　年々このモンラムの間に三大学から十六人ずつ選抜してラハ・ランバのゲーセー（特別の博士号）になる。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは第二流の学僧が出るので、これをツォー・ランバというて居る。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "これにも二通りあって一つをドー・ランバといい、一つをリンシーという。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "このドー・ランバの中にはなかなかの学者があって、時によるとラハ・ランバよりもなお立派な学者があります。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり名誉高きラハ・ランバになろうとすると金が沢山かかる。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしいったんドー・ランバになってそれからラハ・ランバの大問答試験を受けるようになると金が沢山かからない。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで大変立派な学者ではありながら、金の上からどうもラハ・ランバの候補者に選ばれても応ずることが出来ないという事情があって、しばらくここに辛抱して居るのでほとんど玉石混淆の観があるけれども、リンシーに至ってはほとんど学力のない事にきまって居る。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "またサン・バルテルミーにおける虐殺・九月（一七九二年）の斬殺、アヴィニョンにおける殺戮、コリニーの殺害、ランバル夫人の殺害、ブリュヌの殺害（訳者注　後の三人は皆それぞれ前の三つの虐殺のおりの犠牲者である）ミクレー山賊の難、青リボン党の難、弁髪党の難、ゼユの仲間の難、腕章騎士の難などは皆暴動である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九一三年シュヴァイツァー博士は、バイブルとオルガンと、メスとを持って、アフリカのランバレーネに渡った。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『南部方言集』によれば、かの地方では荒地のことをソランバタケと言うとある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯爽と乗り込んだものの、ランバード街でむなしく過ごすばかり。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて、おばあさんが杖あげて、きれいなおじょうさんをちょいと打ちゃ、すぐにその子もはやがわり、それこそかわいい＊＊コランバイン。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊＊　コランバイン。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、畳の無いかなしさ、ハランバヒになれない、此の辛さ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "テキヤがすっかりイタについた丸万しか知らなかった俺は、りゅうとしたその背広姿のランバリ（立派なみなり）に眼を見はっていると、溲瓶を洗いに行っていた波子が、その不恰好な醜態なガラス瓶をぶらさげてはいってきた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "その死んだ時、ランバン Lambin は「ヨーロッパ第一の文学者」を失ったと嘆いた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
