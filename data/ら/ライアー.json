        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古代ギリシャの詩人は、ライアーを弾きながら詩を詠んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "博物館には、美しい装飾が施されたライアーが展示されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はライアーの優しい音色に魅了された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
