        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何ゾ我ニ乏シキ者ナルカノ如ク彼ノ「デモクラシー」ノ直譯輸入ノ要アランヤ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一英語ノ能否ヲ以テ浮薄輕佻ナル知識階級ナル者ヲ作リ、店頭ニ書册ニ談話ニ其ノ單語ヲ捜入シテ得々恬々トシテ恥無キ國民ニ何ノ自主的人格アランヤ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "アニ、ダイコウノミナランヤ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "設シ之ヲ名ヅケテ黒塚ト云フガ如キ有ラバ、則チ是レ鬼女ノ窟ニ適当スルモノ、何ゾ絶代ノ麗※ガ艶魂ヲ葬ルノ地ト認ル者有ランヤ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈啻黒白青黄ノ其ノ色ヲ失スルガ如キ而已ナランヤ噫。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼于偲男子ガ蛍雪多年ノ業ニシテ猶斯クノ如キハ、豈絃三腔一ノ紋左ニ対シテ深ク愧ルコト莫カランヤ。",
              "citation": {
                "source": "他山の石",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈一時ノ惨禍ヲ受ケシガ為メニ汝ト絶ツノ心有ランヤ。",
              "citation": {
                "source": "祭舌文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾ガ汝ヲ眷愛スルノ念、豈ニ我ガ子弟ニ異ナランヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝豈ニ冥頑ナル死物ナランヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、ヨノナカハヒトノキヲシランヤツガオホクテコマル。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其不義惨酷、往古ノ夷狄ト雖ドモ為ザル所ニテ、豈文明ノ世ニ出テ人ノ上ニ立ツ者ノ挙動ナランヤ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "会スヤ　明月清風　自己ノ三昧青山緑水　打成一片モト自カラ地獄ナシアニ又　天堂アランヤモシ未ダ会セズンバ山僧ガ提携シ去ルヲ看ヨ……　洪天さんの右肩が、ぐいとあがる。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトヨリ何ノ趣アランヤ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼翠嵐清流ノ勝ヲ樂シミ妓ヲ拉シ酒ヲ載セテ以テ傲遊スル者豈翅ニ蕩子冶郎ノ色ヲ漁シ香ヲ竊ム一輩ノ人ノミナランヤ。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔竹渓書院竹渓ノ傍リ／又新年ニ値ヒテ此ニ觴ヲ挙グ／魏闕只言フ聊カ世ヲ玩ブト／并州豈｜料ランヤ竟ニ郷ト為ルヲ／官情一片春氷薄シ／旅思千重烟柳長シ／江戸東風三十度／空シク吹ク愁夢南張ニ到ルヲ〕この詩は竹渓の生涯を窺うに最必要のものである。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "箕裘ノ業誰カソノ盛ナルヲ知ラザランヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔六幅ノ蒲帆浪ヲ破リテ行ク／帰烏没スル処是レ金城／喜心何ゾ啻坡翁ノ鐸ノミナランヤ／耳ニ到ル逢逢タリ暮鼓ノ声〕　枕山は星巌の東遊中ひとり芝山内の学頭寮に留っていたらしい。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔別レニ臨ンデ誰カ能ク黯然タラザランヤ／無情ノ花竹モ亦纏綿タリ／空桑一宿人猶恋フ／況ヤ我ノ淹留スルコト十五年ナルヲヤ〕　枕山は横山湖山その他の詩人と共に星巌を送って板橋駅に到って袂を分った。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈今人ノ韻ヲ逐ヒ字ヲ填メテ動モスレバ千百言ヲ成スノ比ナランヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ノコレニ銘スルニ非ラザレバ誰カ与カランヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆皆｜稽首シテ曰ク敢テ謹ンデ命ヲ承ケザランヤト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ヲ以テ吾人ノ心情ヲ慰スルニ足ランヤ」というごとき荘厳簡浄の文体からなっているので、いまだ少年であった私がいたく感動して、著者である呉先生の名を今でもよくおぼえていることは、極めて自然的な心の過程であったような気がしてならない。",
              "citation": {
                "source": "呉秀三先生",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈図ランヤ彼女ハソノ頃ハイヤヲ走ラシテ伊丹ニ向ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖賢の語にも“背後ノ言、豈ヨク信ナランヤ”とあるではないか。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間誰カ母ノ子ナラザル者アランヤ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ故ニ、仏道ヲ修メ、往生ヲ願ウモノ、如何ゾコノ心ナクシテ可ナランヤ」「――なるほど、そう聞くと、人間が安心を得たいために、仏教に耳を傾ける発心のはじめは、やはり菩提心が先だろうな」「けれど、吾々の教えをうけている法然上人の仰せには、菩提心も仏果の助けにはなるが、頼みにはならぬと仰っしゃるのだ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと続けて」「……同ニ長干ノ里ニ居リ両小｜嫌猜ナシ十四、君ノ婦トナッテ羞顔未ダ嘗テ開カズ頭ヲ低レテ暗壁ニ向イ千｜喚一トシテ廻ラズ十五、始メテ眉ヲ展ベ願ワクハ塵ト灰ヲ同ニセン常ニ存ス抱柱ノ信豈上ランヤ望夫台十六、君遠クヘ行ク……」　城太郎はふいに起って、じっと聞き入っていたお通を促した。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……十四｜君ノ婦ト為ッテ羞顔未ダ嘗テ開カズ十五初メテ眉を展ベ願ワクバ塵ト灰トヲ共ニセン常ニ抱柱ノ信ヲ存シ豈上ランヤ望夫台十六｜君遠クヘ行ク　近所に住む少女であった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "困シテ荊襄ヲ守ルスデニ数年眼前｜空シク旧山川ニ対ス蛟龍豈コレ池中ノ物ナランヤ臥シテ風雷ヲ聴キ飛ンデ天ニ上ル「……？",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
