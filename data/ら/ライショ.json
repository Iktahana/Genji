[
  {
    "uuid": "96652af3-be59-5561-b610-344179bd79dc",
    "entry": "来書",
    "reading": {
      "primary": "らいしょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
