        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『僕のラヴアはもう死んで、この世には居ない』なんて。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その人を自分のラヴアとして考えることはどうしても出来ないと言うんだそうです。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊藤君の説では、米国はラヴアルに全力をつくしているようだ。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラヴアルが落されれば、第一線にクサビを打ち込まれるものである。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者Ａ　　すると、あの方は、なんですか、あなたの……ラヴアアといふんでもないんですか。",
              "citation": {
                "source": "喧嘩上手",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿の群を引連れた一人の人間ラーマが、ランカの怒濤によつて保護されてゐる傲慢な十個の頭を有つたラヴアンの力に反抗するといふ聖典中の物語は何を意味してゐるか。",
              "citation": {
                "source": "劒の教義",
                "author": "エム・ケー・ガンヂー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
