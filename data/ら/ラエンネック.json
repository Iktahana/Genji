        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしコルヴィザールの弟子でブルターニュ人であるパリのラエンネック（1781-1826）の聴診法の導入は大きな効果を産んだ。",
              "citation": {
                "source": "簡約医学史",
                "author": "A Concise History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしビシャ、コルヴィザール、ラエンネック、ルイ、その他のようなフランスの研究者たちがこの世紀の最初の四半世紀に高名になり、アメリカのますます多くの学生たちがフランスに行くようになり、彼らが持ち帰った新しい精神はアメリカの医療にしばらくのあいだ革命を起こした。",
              "citation": {
                "source": "簡約医学史",
                "author": "A Concise History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "第102図　ラエンネックの間接聴診参考書の扉（1819）　現代の臨床医学の基礎を創ったのはコルヴィザールの弟子レネ・テオフィル・ラエンネックであった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "つい最近になってナントのルゾー教授によって魅力的な本「1806年前のラエンネック」が刊行されてこの努力が知られるようになった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックの前に患者の検査は主として眼を使うことによって行い、体温または脈拍を触れることによって助けていた。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしラエンネックによる聴診の発見おおび彼の著書「間接聴診法について（De l'Auscultation Mediate）」（1819）は医学研究の新しい時代を画した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックの本は医学の科学への貢献した８冊から10冊の本の１つに入る(*2)。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "第103図　ラエンネック像　コルヴィザールの弟子および後継者たちの、ベール、アンドラール、ブイヨー、シャメル、ピオリー、ブレトノー、レイヤー、クリュヴェイエ、トルソーは、新しい精神を医学に導入した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "学派の創立者ではなかったが多くの優れた弟子を訓練しその中にはラエンネック、ベイル、デュピュイトラン、ブルトノーがいて、彼らはコルヴィザールの方針に沿って研究を行い彼の仕事を続けた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルヴィザールの弟子の１人だったラエンネックは心音を聴くことの重要性を主張した先覚者であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックが世話をしている患者に心臓病の肥満した女性がいた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはラエンネックに着想を与えた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "聴診器で聴くことができる種々の音の本性およびそれらが何を意味するかラエンネックは確かめなければならなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "３年にわたってラエンネックは熱心に研究を行い1819年に２巻の「間接聴診法および肺と心臓の病気の概論」を刊行した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックはブルターニュと密接な関係を持っていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "若いラエンネックが医師になるのは自然のことであった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯父は軍隊に召集され子供のラエンネックも一緒に行って戦場で医学初歩および外科の実際を学んだ。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックは最初からこの会の活動とくに病理解剖学および寄生虫学の分野に活発に関与した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "健康が不良になったのでラエンネックは２年のあいだブルターニュに留まり1822年には充分に健康が元に戻りパリに帰った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "全世界から医師たちはパリに来てシャリテ病院でラエンネックの指導のもとで新しい方法を学んだ。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックは聴診法の発見者以上であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし医師の第一の任務は患者の福祉促進であることをラエンネックは常に完全に気がついていて経験によって最も有効な方法を使ってこの目的を果たすように試みた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピネルがコルヴィサールと並んだのと同じようにブルセーはラエンネックと並んでいた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックとブルセーはコルヴィザールとピネルよりもっと明白に違っていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックは痩せていて肺結核のタイプであった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックは静かに話して言うことは要領を得ていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックはカトリック信者であり王党派であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラエンネックより１年早く彼はパリに行き、ビシャ、コルヴィザールおよび特にピネの下で働いた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピネルは老年だったので論争を好まず従ってラエンネックが講義の中で「いわゆる生理学的医学」に対して反対運動を行った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
