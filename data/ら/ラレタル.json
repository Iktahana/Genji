        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "固ヨリ削除セラレタル一行一句ト雖モ日本ノ法律ニ違反セル文字ニ非ルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ元首が賣名的多辯ヲ弄シ下級俳優ノ如キ身振ヲ晒シテ當選ヲ爭フ制度ハ、沈默ハ金ナリヲ信條トシ謙遜ハ美徳ヲ教養セラレタル日本民族ニ取リテハ一ニ奇異ナル風俗トシテ傍觀スレバ足ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ如何ナル國民モ間接税ノ負擔者ナラサルハナシト云フ納税資格ノ擴張セラレタル普通選擧ノ義ニ非ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "無償ヲ以テ徴集スル所以ハ、現時大資本家大地主等ノ富ハ其實社會共同ノ進歩ト共同ノ生産ニヨル富が惡制度ノ爲メ彼等少數者ニ停滯シ蓄積セラレタル者ニ係ハルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ都市ノ私有地ヲ許サザルガ故ニ、設定セラレタル地上權ヨリ利得ヲ計ルコトヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ此ノ二者ノ制限ハ現今マデ放任セラレタル道徳性ヲ國家ノ根本法トシテ法律化スルニ過ギザルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又今囘ノ大戰ニ暴露セラレタル如ク日本ハ自營自給スル能ハザル幾多ノ工業アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現今ニ於テハ資本制度ノ壓迫ニヨリテ勞働者ハ自由契約ノ名ノ下ニ全然自由ヲ拘束セラレタル賃銀契約ヲナシツツアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父生存シテ而モ父ニ遺棄セラレタル兒童亦同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父生存シテ遺棄セラレタル兒童亦同ジキハ凡テ此ノ理由ニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只英語ホド普及セズシテ而モ英語思想以上ニ影響ヲ與ヘタル獨乙語ニ依リテ其ノ害毒ノ緩和セラレタル天裕ヲ有スルノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ニ示サルル如ク印度ニ起リタル亞細亞文明ハ世界ヨリ封鎖セラレタル日本ヲ選ビテ天ノ保存シタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ニ對シ又ハ世界ニ對シテ勳功アル者ハ、戰爭政治學術發明生産藝術ヲ差別セズ、一律ニ勳位ヲ受ケ、審議院議員ノ互選資格ヲ得、著シク増額セラレタル年金ヲ給付セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ亞細亞ニ與ヘラレタル使命ハ英人ノ罪惡ヲ再ビスルヲ許サズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ日本々國ニ於テ先ヅ此ノ三大原則ヲ確立シテ擴張セラレタル領土ニ臨ムトキ、眞ノ公平無私ハ自ラニシテ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ日本々國ヨリ派遣セラレタル改造執行機關ニヨリテ改造セラルル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ東西文明ノ融合ヲ促進スルタメニ特ニ日本ノ思想制度ニ感化セラレタル彼等ノ移住ヲ急トスルガ故ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ傭兵ト獨逸ノ徴兵トノ優劣ハ實戰ニヨリテ立證セラレタルモノニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只退却將軍ノ報告文トシテ古今獨歩ノ文豪「ヘーグ」元帥ニヨリテ英國傭兵ノ光榮ハ十分ニ認知セラレタルハ周知ノ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "生死ノ煩悶ヲ天空ニ求ムル如キ低級極マル小乘的信仰ヲ以テ、印度文明ノ密封セラレタル寶庫トシテ漸ク將ニ二十世紀ノ今日ヲ待チテ開カレントスル日本民族ノ大乘的信仰ニ對セントスル如キハ、實ニ龍車ニ向フ蟷螂ノ斧。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ンヤ學者文士輩ノ口耳ヨリ濫造セラレタル思想ナル者ノ自由ヲヤ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "合理化セラレタル民主社會主義其者ノ名ニ於テモ日本ハ濠洲ト極東西比利亞トヲ要求ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只獨逸ノ社會主義ニ此ノ國際的理解ナク、且ツ中世組織ノ「カイゼル」政府ニ支配セラレタルガ爲ニ、英領分配ノ合理的要求ガ中世的組織ノ破滅ニ殉ジテ不義ノ名ヲ頒チタルコトヲ注意スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "改造セラレタル合理的國家、革命的大帝國ガ國際的正義ヲ叫ブトキ之ニ對抗シ得ベキ一學説ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ニ加冠セラレタル軍國主義トハ印度獨立ノ「エホバ」ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ講和會議ニ於テ英國ノ保護ヲ蒙リテ獨逸ノ利權ヲ繼承スルコトヲ認容セラレタルトキ相賀シテ「國難去レリ」ト云ヘリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇ニ指揮セラレタル全日本國民ノ超法律的運動ヲ以テ先ヅ今ノ政治的經濟的特權階級ヲ切開シテ棄ツルヲ急トスル所以ノ者、内憂ヲ痛ミ外患ニ惱マシムル凡テノ禍因只コノ一大腫物ニ發スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ舊時代ニ生レ其ノ見ル所歐米ノ小天地ニ限ラレタルノミナラズ、淺薄極マル哲學ニ立脚シタルガ故ニ、躍進セル現代日本ヨリ視ル時單ニ分科的價値ヲ有スル一二先哲ニ過ギザルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "全世界ニ與ヘラレタル現實ノ理想ハ何ノ國家何ノ民族ガ豐臣徳川タリ神聖皇帝タルカノ一事アルノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
