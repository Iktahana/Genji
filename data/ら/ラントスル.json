          "literary": [
            {
              "text": "大正十二年五月北一輝緒言　今ヤ大日本帝國ハ内憂外患並ビ到ラントスル有史未曾有ノ國難ニ臨メリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ヲ機トシテ國家ガ收得ヲ計ラントスル社會政策者流ノ人權的思想ニ不徹底ナルヲ思考スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "文明推移ノ歴史ヲ只過去ノ西洋史ニ認メテ而モ二十世紀ニ至リテ漸ク眞ニ融合統一シタル全世界史ノ編纂ガ始マラントスル時、獨リ世界史ト將來トニ於テノミ其ノ推移ヲ思考スル能ハズトスルカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾レ且ツ汝ニ謝スルノ暇有ラザラントスルナリ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "○蓋シ其趣旨ヲ察スルニ、斯ノ如クシテ我国内ニ大兵ヲ送ラントスル為メナリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪ナラントスルノ天。",
              "citation": {
                "source": "『雪華図説』の研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夙夜、憂思シテ恐ル、将ニ天下危ウカラントスルヲ。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル秋ニ意ワザリキ、将星｜墜チントシテ、我｜今生ノ命スデニ終ラントスルヲ天ノ告ゲ給ウアラントハ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
