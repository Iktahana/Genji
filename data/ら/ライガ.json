  {
    "uuid": "f3cba5a3-0850-511f-a7eb-c81d0177226f",
    "entry": "来我",
    "reading": {
      "primary": "らいが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
