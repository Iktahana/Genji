      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "your coming",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「本日は遠方よりご来賀いただき、新郎新婦に代わりまして厚く御礼申し上げます」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長寿の祝いの席に多くの親族が来賀し、祖父は終始にこやかな表情を浮かべていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "叙勲の知らせを聞きつけた教え子たちが次々と来賀し、恩師の自宅は華やいだ雰囲気に包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "シワの妻｜烏摩后、子なきを憂え、千人の梵士を供養してヴィシュヌに祈り、美妙の男子を生み諸神来賀した。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "是は十月の半以来賀客が絡繹として絶えなかつたので、夫人が日夜酒杯に親んだことを謂つたのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい気の毒や調子の悪さを超越しなければ、大きな仕事は出来っこないだろう、「黄銅時代」の第壱を書なおしに着手、　島田清次郎氏より来賀、あの若さで、あれ丈俗なのは何故か、自分の広告並年賀は自分に非常にいやな印象を与えた。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月下旬、千種有文の家来賀川｜肇を襲撃した中にもいたというし、つい先頃の足利尊氏の木像｜梟首事件にも、関わっていたという風説がある。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは言ふのもつらいが、飮んだくれのならず者でね、おれはもう恥づかしくて、面目なくて、生れて三十何年間、いや、兄がだよ、兄が生れて三十何年間といふもの、このおれに、迷惑のかけどほしさ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は主人に引き留めれられて居るうちどんなに窮屈であり、旅が、さすらいが恋しかったか知れないのです。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「痛いくらいが何だい！",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本では、土壁の外側に羽目板を張ったくらいが防寒防暑と湿度調節とを両立させるという点から見てもほぼ適度な妥協点をねらったものではないかという気がする。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そだら、うなぃの爺んごど俺ぁの爺んごど、爺んご取っ換へだらいがべぢゃぃ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此頃のことでした、観行院様にお前は何を仕て居たいかと問われたとき、芋を喰って本を読んで居ればそれで沢山だと答えたそうですが、芋ぐらいが好物であったと見えます、ハハハハ。",
              "citation": {
                "source": "少年時代",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在の怪奇を基調とした漫画は少しねらいがはずれているのではないか。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿や鳥などが、その食料とするいろいろの昆虫の種類によって著しい好ききらいがあって、その見分けをある程度までは視覚によってつけるらしいということが知られている。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはとにかく、年を取るに従っていろいろな毛ぎらいがだんだんにその強度を減じてくることは事実である。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふりむくと、刀をさしたさむらいが、夏木立の青い日影を浴びて立っていた。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たらいが、バチャンといいました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "きゅうに、たらいが、速くなったように思われました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そだら、うなぃの爺ごど、爺※ご取っ換ぇだらいがべじゃぃ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある年の十二月末つ方、年は迫れども童はいつも気楽なる風の子、十三歳を頭に、九ツまでくらいが七八人、砂山の麓に集まりて何事をか評議まちまち、立てるもあり、砂に肱を埋めて頬杖つけるもあり。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくたちが戦ごっこをしに山に遊びに行って、その乞食を遠くにでも見つけたら最後、大急ぎで、「人さらいが来たぞ」といいながらにげるのだった。",
              "citation": {
                "source": "火事とポチ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は主人に引き留められているうちどんなに窮屈であり、旅が、さすらいが恋しかったか知れないのです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……鳶、鳶、」　と茶色な歯、尖った口も見えると思うと、「鳶につつかれるくらいが落なんだよ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "じいさんは、ていねいにおじぎをして行き過ぎようとしましたら、さむらいがピタリととまって、ちょっとそらを見上げて、それからあごを引いて、六平を呼び留めました。",
              "citation": {
                "source": "とっこべとら子",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はて、王子さま」　と、年よりのけらいが、室の中であっちを向いたりこっちを向いたりして叫んでいるようすでした。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この位になって、だんだん枯れはじめです、なじょにしたらいが、教えてくな※せ。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」農民一「はあ、別段濃いど思わなぃがったが、全体なんぼ位に薄めたらいがべす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」農民一「曇ってまず、土のさっと湿けだずぎだら、なんぼこりゃにすたらいがべす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」農民一「はあ、それで、その根切虫、無ぐするになじょにすたらいがべす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんぼ上げだらいがべす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」農民二「なじょにすたらいがべす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」農民二「なんぼお礼上げだらいがべす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
