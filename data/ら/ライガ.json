[
  {
    "uuid": "7c901384-e138-50e7-8db1-71ed32b80e01",
    "entry": "来賀",
    "reading": {
      "primary": "らいが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
