          "literary": [
            {
              "text": "ところが上智大学のラウレス教授から痛烈な抗議が来た。",
              "citation": {
                "source": "美しい日本の歴史",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのさい感じたのは、ラウレス氏のような学究でもカソリックではおよそ性の問題となると、これを頭からひんしゅくする傾向が強い。",
              "citation": {
                "source": "美しい日本の歴史",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっそく、上智大学のラウレス教授などを初め、多くのクリスチャン読者から抗議が出ました。",
              "citation": {
                "source": "小説のタネ",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラウレス氏などは、新聞を見ますと、はるばる奥多摩の吉野村の僕の家までやって来て、『絶対に、デウス右近さまは、そういうお人ではない』　というんですな。",
              "citation": {
                "source": "小説のタネ",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
