        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "少し下りた処の洗濯屋の看板を見ると何某プラチェシナヤと露文字で書いてある。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつきのルーベンスの『ドライ・グラチェン』に気がついたかい。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてラチェットのところへ行って、鼠を二十八匹売った。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜酒場でラチェットさんに会ったら、丁度いい機会だと思って、貴様が鼠を幾匹売りつけていったかと訊ねたんだ。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は老人レッドから盛んに鼠を買いあげるラチェットなる人物は、この軍用鼠の研究家であった。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "真珠の密輸は、生れつきの密輸趣味者レッドが鼠をラチェットに売る片手間にこれに托して真珠密輸を企てたのであって、その所得は悉くレッドのものとなっていた。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラチェットはその真珠事件に無関係であった。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば、リザ・グラチェヴァ――なんと変った人物ではねえか？",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィレンツェの市民が私慾の爲に公職を貪るを罵れるなり一三九―一四四【ラチェデーモナ】ラケダイモン。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルバでも、グラチェフカでも、優美を極めた舞踏会でも、どこにいても、女は常にさようなものとして現われています。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "メフィストフェレス小さい奴を書入にしようと思うと、ラチェルタ奴、手を摩り抜けて行きゃあがる。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに類似の租税はそれほど重くはないが、ミラノ公国や、ジェノア共和国や、モデナ公国やパルマ、プラチェンティア、及びグァスタルラの諸公国や、法王領にある。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "「紳士の雑誌」1753年９月号はトレ・デラ・アヌンチアタで一例を見て患者のためにタランテラを奏したイタリアの音楽学生ストラチェの手紙をのせている(38)。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラチェニの模写をやっているんだがね、あの楽を奏でている天使に、僕はほれちゃったのさ。",
              "citation": {
                "source": "幸福への意志",
                "author": "DER WILLE ZUM GLUCK",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　シロッケのことお、アイヌ語でわ「へるラチェ※」herer-us-chep〔ピカピカ光っている・魚〕とも言う。",
              "citation": {
                "source": "和人わ舟お食う",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
