        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "泰西の夜会の例に見ても、由来仮装は夜のものであるらしい。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来仮面を持たなかつた民族なのか、持つて居たが、早く外来の優秀な仮面に気圧されてしまつたものか。",
              "citation": {
                "source": "日本文学における一つの象徴",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも、面の説をなす人の考への底には、本土元来仮面無しと言つた信念に似たものが拡つてゐるやうな気がする。",
              "citation": {
                "source": "日本文学における一つの象徴",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "性格はまた本來假定である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "一體古來假名遣と云ふものは少數のものであつたかも知れぬ。",
              "citation": {
                "source": "假名遣意見",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
