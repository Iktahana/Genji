        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「利門名路両ナガラ何ゾ憑ラン、百歳ハ風前短焔ノ燈、只恐ラクハ僧ト為テ心了セザルコトヲ、僧ト為テ心了セバ総テ僧ニ輸セン――どうじゃな、これが杜荀鶴の詩じゃ。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "只恐ラクハ僧ト為テ心了セザルコトヲ、私は若い時この詩を読んで一生の目的を定めたのじゃ。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ陛下深仁深慈臣ガ［狂→至］愚ヲ憐レミテ少シク乙夜ノ覧ヲ垂レ給ハンコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ聖明矜察ヲ垂レ給ハンコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ如クナラザレバ、學ブ所ノ學術恐ラクハ生硬事實ニ切ナラズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔江亭春寂寂トシテ／山路樹重重タリ／酒ニ対ヒテ交ハリノ歓ビ薄ク／花ヲ看テ別レノ恨ミ濃シ／依遅トシテ故国ヲ辞シ／迢逓トシテ遥峰ニ向フ／京洛ノ旧朋友／恐ラクハ憔悴ノ容ニ驚カン〕天明五年乙巳には幽林は齢既に六十に達している。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤田東湖藤森弘庵窃ニ君ニ謀ツテ曰ク幕吏因循ニシテ恐ラクハ膺懲ノ任ヲ尽スコト能ハザラン。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ知ル者ハ恐ラクハ弟ニ若クハナカラン。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "恨ムラクハイマダコレヲ刻スルニ及バズシテ瞑スト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダケド恐ラクハ婆サンカ佐々木ガ知ラシタニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、気味ガ悪イカラ忘レヨウト思ッテモ、容易ニ、恐ラクハ一生涯、ソノ記憶ヲ拭イ去ルコトハ出来ナイデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ陛下深仁深慈、臣ガ狂愚ヲ憐レミテ、少シク乙夜ノ覧ヲ垂レ給ワン事ヲ」　正造はここで「狂愚」の「狂」に縦線を引いて傍に「至」と書き入れ、捺印して次へ移った。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ、聖明矜察ヲ垂レ給ワン事ヲ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏シテ望ムラクハ、丞相ノ謀リ遠キヲ慮リテ、早ク良図ヲ施シテ怠リヲ欲スルコトナカランコトヲ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝瞻今スデニ八歳、聡慧愛スベシ、タダソノ早成、恐ラクハ重器タラザルヲ嫌ウノミ　彼は八歳の児を見るにさえ、国家的見地からこれを観ていた。",
              "citation": {
                "source": "三国志",
                "author": "篇外余録",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
