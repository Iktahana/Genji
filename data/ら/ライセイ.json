[
  {
    "uuid": "c65ac36c-7405-5ef6-9562-62198dcafb7e",
    "entry": "雷声",
    "reading": {
      "primary": "らいせい",
      "alternatives": [
        "かみなりごえ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
