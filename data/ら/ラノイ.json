        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "医に見せしに、過劇なる心労にて急に起りし「パラノイア」といふ病なれば、治癒の見込なしといふ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "医に見せしに、過劇なる心労にて急に起こりし「パラノイア」という病なれば、治癒の見込みなしという。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "醫に見せしに、過劇なる心勞にて急に起りし「パラノイア」といふ病なれば、治癒の見込なしといふ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ、その相手の、先に一人で自殺したと言う娘さんの方に一種のパラノイヤのような――つまりセックス・フォビヤがあったのではないかな。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私　しかし、どんな冷静な科学者にもパラノイアは有り得る。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……軍国主義と、資本主義の『パラノイア』に悩まされて居る、地球大の脳病院である。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇帝軍の将軍のうちで最も活発なラノイはローマに進軍すると脅迫していた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマで起きたのと同じ病気が皇帝軍の将軍ラノイを殺した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "何度となくこれはとんでもない妄想の大系なのだ、パラノイア患者の悪夢の集積なのだと決めつけながら、その度に心の隅ではどうしても棄去できずに温めてきた秘密の思想。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "君が心を閉ざしているかぎり、僕の話はただのパラノイアのたわ言になってしまう。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の話をパラノイアのたわ言で終わらせるか、それとも僕が今命がけで訴えようとしているこの血だらけの叫びの本当の意味を理解するかはすべて君自身が決めることなのだ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
