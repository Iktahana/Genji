          "literary": [
            {
              "text": "僕はバビコック博士夫婦と今夜ライシアム座にウェルシ嬢の演じたトルストイの「復活」を見物しました。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ライシアム」で「アーヴィング」が「シェクスピヤ」の「コリオラナス」をやると出ている。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その横を川伝いにまっ直行けば、左へ曲る横町に、ライシアム・シアタアも見えるであろう。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
