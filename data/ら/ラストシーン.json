        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "映画のラストシーンで二人が再会する場面には、劇場中の観客が涙した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あの小説のラストシーン、救いがなくて最高に切なかったよね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ドラマの撮影は、もっとも重要なラストシーンから逆算してスケジュールが組まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "要するにラストシーンがダレると困りますから、三四郎の立廻りをなるべく簡単にやって頂きたい）Ｔ「空晴れて風そよぐ――」Ｓ＝垂れ下った柳　静かな川の流れ。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラストシーンの人物の構成など特にそう思われた。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほこりっぽい、乾苦しい、塩っ辛い汗と涙の葬礼行列の場面が続いたあとでの、沛然として降り注ぐ果樹園の雨のラストシーンもまた実に心ゆくばかり美しいものである。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラストシーンでは少年がジェットホイルを作って文明国に帰ってみると、核戦争で人類は全滅しているなんて、現実離れしているけどなかなか面白い。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は江村弥左衛門の宅第二日、やり出すと少しでもいゝものをと思ふので、ラストシーンは三四カット増して貰ひ、たっぷり芝居をする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校の運動会で六さんとおかみさんがめぐり合ひ、二人三脚の競争で結びつき、「愛国行進曲」の合唱といふラストシーン迄、三時すぎにオールチョン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後は、ラストシーンを撮り三時半にアガる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスが行くのを追っかける、ラストシーン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時すぎの薄い陽で、ラストシーンを了る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラストシーンは、泣いて、しめた如し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "西部劇は当時も相当な流行で、二挺拳銃をさっそうとかまえる、ウイリァム・Ｓ・ハートの勇姿、アリゾナやユーコン河を背景に、西部の荒男が娘の純情と誠実に自分の恋をあきらめ悪人をたおし、彼女の好きな男と手を握らし、夕日をあびてトボトボと愛馬を引き小さく消えて行くフェード・アウトのラスト・シーン。",
              "citation": {
                "source": "私の洋画経歴",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、走ってる様子を、いろんなふうに撮る」「ラスト・シーンは？",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを探しています」「映画だとラスト・シーンを初日に撮ったりしたわ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の書きましたつたない「新・平家物語」のなかに、阿部の麻鳥という人と、妻の蓬という人を晩年まで書いておりますが、「新・平家物語」の一番のラスト・シーンに、吉野雛として書きました一章は、実はその老夫婦がモデルなんです。",
              "citation": {
                "source": "親鸞聖人について",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
