          "literary": [
            {
              "text": "「……さあ、名誉あるラヴィーザ・イヴァーノヴナ、これが貴様に聞かしてやるおれの最後のお説教だ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラヴィーザの所へも、あの男と二度ばかり行って見たよ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラヴィーザを覚えてるかね、ラヴィーザ・イヴァーノヴナを？",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "君はあの男と一緒に、ラヴィーザ・イヴァーノヴナの所へ行ったそうですね。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラヴィーザのところであったことなんだ――しかし、今日という今日こそ、すべてが明瞭になった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
