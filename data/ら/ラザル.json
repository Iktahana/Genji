        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「爾ノ知ラザル所ハ、人ソレ諸ヲ舎テンヤ」である。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケサノコノ走リ書モマタ、純粋ノ主観的表白ニアラザルコトハ、皆様承知。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿ニ似テ非ナル猿面冠者ハオノガ立身出世ノタメニハ、主人ヨリ猿々ト呼ビ捨テラレルモ、ヘイヘイト追従笑ヒナド泛ベタルハ、即チ羞恥ヲ知ラザル者ト言フガ如シ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サレバ、書ハ読ミタル者ヲ聰明ニ成ストハ限ラザルモ、読マザル者ハ必ズ阿呆ニナラン」「夕ニ武道ノ稽古ヲ成ス所以ハ」「サレバ、今ヤ天下麻ノ如ク紊レ、武ヲ知ラザレバ皆目知ラザルニ等シキ世ナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "敬ニシテ礼ニ中ラザルヲ野トイヒ、勇ニシテ礼ニ中ラザルヲ逆トイフ　とか、信ヲ好ンデ学ヲ好マザレバソノ蔽ヤ賊、直ヲ好ンデ学ヲ好マザレバソノ蔽ヤ絞　などというのも、結局は、個人としての子路に対してよりも、いわば塾頭格としての子路に向っての叱言である場合が多かった。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「極祕」ヲ印シ謄寫ニ附シテ未ダ公刊ニ至ラザル時、九年一月發賣頒布ヲ禁ゼラル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二十世紀ノ人類ハ聰明ト情意ヲ増進シテ「然リ然リ」「否ナ否ナ」ニテ足ル者ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本改造法案ノ起草者ハ當然ニ革命的大帝國建設ノ一實行者タラザルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大破壞ノ後ニ狂亂狼狽スル者ニ完備セル建築圖ヲ求ム可ラザルハ勿論ノ事、之ト相反シテ、我ガ日本ハ彼ニ於テ破壞ノ五ヶ年ヲ充實ノ五ヶ年トシテ惠マレタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（兩者ノ救フベカラザル迷妄ヲ戒シム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人一百萬圓ヲ有セバ物質的享樂及ビ活動ニ於テ至ラザル所ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テニ平等ナラザル個々人ハ其經濟的能力享樂及經濟的運命ニ於テモ劃一ナラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ動カスベカラザル原理ハ、都市ノ住宅地ト異ナリテ農業者ノ土地ハ資本ト等シク其經濟生活ノ基本タルヲ以テ、資本ガ限度以内ニ於テ各人ノ所有權ヲ認メラルル如ク、土地亦其限度内ニ於テ確實ナル所有權ヲ設定サルルコトハ國民的人權ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ日本ニ於テハ國民生活ノ基礎タル土地ノ國際的分配ニ於テ將來大領土ヲ取得セザルベカラザル運命ニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞理ハ一社會主義ノ專有ニ非ズシテ自由主義經濟學ノ理想ニ亦犯スベカラザル者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ又生産方針ニ干與スルノ權ハ國家全局ノ生産成績ヲ達觀シ得ベキ衆議院ニ於テセザルベカラザル所以トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻トシテ男子ヲ助クル家政勞働ノ外ニ、母トシテ保姆ノ勞働ヲナシ、小學教師ニ劣ラザル教育的勞働ヲナシツツアル者ハ婦人ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ賠償ヲ別途ニ命ジテ同居ヲ父ニ強ヒザル所以ハ、遺棄シタル事情ガ背徳ニセヨ又ハ積極的活動ノ爲ニセヨ干渉スベカラザル別事ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國語問題ハ文字又ハ單語ノミノ問題ニ非ズシテ言語ノ組織根底ヨリノ革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "終局ハ國民精神ノ神的革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度以下ノ私有財産ハ國家又ハ他ノ國民ノ犯スベカラザル國民ノ權利ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母ノ愛ノ百千分ノ一ニ足ラザル長子ノ愛情利害ニ一切弟妹ノ運命ヲ盲從セシムルハ沒人情ノ極。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮其者ノ歴史ガ示ス如ク、又清國ガ此レヲ屬國トセンガ爲ニ起リタル日清戰爭、及ビ滿洲ニ來タレル露西亞ガ其ヲ侵略セントセシガタメニ破レタル日露戰爭ニ示ス如ク、其ノ亡國タルベキ内外呼應ノ原因ハ統治者ガ日本タラザル時ハ露支兩國ノ焉レカナリシハ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亞ノ脅威ガ「ツアール」ノ亡ビタルヲ以テ去レリト考フル如キハ齒牙ニ足ラザル淺慮。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾多ノ民族ノ中ニ於テ自決スルヲ得ル覺醒的民族ト然ラザル者トアルハ、恰モ等シキ人間ノ中ニ於テ自決スル能ハザル八十歳ノ老婆アリ十歳ノ少女アルガ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ凡テニ於テ惡模倣ヨリ蝉脱シテ其ノ本ニ返ラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大領土ヲ有スル名實具足ノ大日本帝國ヲ考フル者此ノ三大原則を確立スル日本自ラノ改造ガ實ニ將來ノ建設ニ避ク可カラザル準備ナルヲ悟得スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ根本原因ハ日本資産家ノ侵略ガ官憲ト相結ビテ彼等ノ土地ヲ奪ヒ財産ヲ掠メテ不安ヲ生活ニ加ヘ怨恨ヲ糊口ノ資ニ結ビタルコトニ存スルヲ知ラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
