          "literary": [
            {
              "text": "名前を「ラサハ倶楽部」という。",
              "citation": {
                "source": "小指一本の大試合",
                "author": "山中峯太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ラサハ」というのは、ギリシャのことばで、「友だちの愛」という意味だ。",
              "citation": {
                "source": "小指一本の大試合",
                "author": "山中峯太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは、和歌山中学を卒業してから、このカリフォルニヤ大学へはいって、そして、ラサハ倶楽部に、寄宿してたのだ。",
              "citation": {
                "source": "小指一本の大試合",
                "author": "山中峯太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思うと、「きみはラサハ倶楽部の救い主だ！",
              "citation": {
                "source": "小指一本の大試合",
                "author": "山中峯太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポールはおとなしくなって、ラサハ倶楽部は「友だちの愛」でさかんになるし、倶楽部長フランクは大よろこびさ。",
              "citation": {
                "source": "小指一本の大試合",
                "author": "山中峯太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
