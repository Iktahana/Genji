          "literary": [
            {
              "text": "「どうも近来首が痛い」「それはどうも困りましたな」「ナーニ、ちっとも困りゃしないよ。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし元来首を添えてやるのだから、決して悧巧な人のすることでない。",
              "citation": {
                "source": "負けない男",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年生以来首席で通して来た。",
              "citation": {
                "source": "村の成功者",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この乾鮭のやうな老學者は、凄まじい耻を掻かされたにしても、五年來首つ玉に噛り付いて離れなかつた、厄介な女妖の手から逃れて、聊かホツとした形ちでもあるやうです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "軍學者の妾",
                "note": "青空文庫"
              }
            }
          ]
        }
