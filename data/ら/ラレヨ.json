          "literary": [
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十四日に間に合うように和一郎と小枝との結婚を祝う電報をうったなかに伸子はハハノケンコウノタメアメリカケイユデコラレヨと云ってやった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ニハ、諸君ノ努力と愛情ニヨルホカ、コノ世ノ幸福ニ恵マレ得ヌ家族ガアルコトニ想ヒ到ラレヨ。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンデカラ後ドンナ形ノ石ノ下ニ葬ムラレヨウト差支エナイヨウナモノダガ、予ハ矢張気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サラニ又　愕クヲ要セズ　孝子　仁者　純朴ノ善民　マタ清廉ノ吏ニ至リテハ　是ヲ敬イ愛スルモ　誓ッテ是ヲ困苦セシメズ　乞ウ善大衆ヨ　御身等ハタダソノ天誅ヲ見　ソノ職ニ安ンジ居ラレヨ「さーて？",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ貴意ウゴカバ、身ヲ以ツテ、本船ニ投ゼラレヨ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "冥々滅々、霊アラバ我心ヲ鑑ラレヨ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "新田｜右衛門佐義貞誅伐セズンバ有ル可カラズ一族相催シ急ギ馳セ参ジラレヨ　と、すべて同文で、また、はなはだ簡である。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            }
          ]
        }
