          "literary": [
            {
              "text": "これはライナア・マリア・リルケがモオリス・ド・ゲランの「サントオル」を譯したとき（一九一一年）その卷末に附せられた註（Anmerkung）である。",
              "citation": {
                "source": "モオリス・ド・ゲラン",
                "author": "「そしてこの稀有で、偉大で、しかも果敢ないもの、一個の詩人」",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリイヴ・シユライナア女史の書いたものに、その製作のために段々痩せ衰へる画家があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            }
          ]
        }
