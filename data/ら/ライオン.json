[
  {
    "uuid": "71fbf653-740d-55ed-b515-ff21503a22af",
    "entry": "ライオン",
    "reading": {
      "primary": "ライオン",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "lion (Panthera leo)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "サバンナでライオンの群れが獲物を追いかけていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "動物園で大きなライオンの咆哮が聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ライオンは「百獣の王」と呼ばれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "首のない大きなライオンが北向きに坐っているような姿をしている。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋人の曲馬師らしいのが居てそれが先ずセロを弾く、それから妙な懸稲のようにかけ渡した麻糸を操るとそれがライオンのように見えて来る。",
              "citation": {
                "source": "夢判断",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちにライオンとも虎ともつかぬ動物がやって来て自分に近寄り、そうして自分の顔のすぐ前に鼻面を接近させる。",
              "citation": {
                "source": "夢判断",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻糸の簾がライオンになる件だけは解釈の糸口が見付からない。",
              "citation": {
                "source": "夢判断",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳独秀、貴方はライオン・ロックの高嶺のように赤裸々な方だから正義と自己の信念を愛したのです。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばライオンと風になびく草原との取り合わせなどがそうである。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このいかにも水に渇したように風にそよぐ草によって始めてほんとうに生きたアフリカのライオンが眼前に現われる。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばわれわれが自身でライオン狩りの現場に臨んだとしたら、どうして草原のそよぎなどを味わうことができるであろうか。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライオンへ入って食事をする。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　ライオンを出てからは唐物屋で石鹸を買った。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三越の玄関の両側にあるライオンは、丸善の入り口にある手長と足長の人形と同様に、むしろないほうがよいように思われる。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大概の場合はＡＢＣやライオンの民衆的なる紅茶で我慢するほかはなかった。",
              "citation": {
                "source": "コーヒー哲学序説",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは近ごろ来朝したエシオピアの大使が、ライオンを見て珍しがらずに、金魚を見て驚いた話ともどこか似たところのある話である。",
              "citation": {
                "source": "ラジオ・モンタージュ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "酋長のむすこがライオンに食われる場面がある。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "A life for a life というタイトルが出たから映画師が殺されるかと思ったら、そうでなくてやはりライオンが一匹やられるのである。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしライオンなどは少しも芝居しないから愉快である。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライオンが自動車のタイアを草原に見いだして前足でつついてみては腹を立ててうなる場面は傑作である。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライオンがふきげんであればあるほど観客は笑うのである。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしか自分がライオンだったら、この不都合な侵入者らに対してどんなに腹の立つことであろう。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一部が偶然にライオンの背景の中に出ているのも実写映画の妙味である。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ響いて来る歌の声が、たとえライオンのような声であっても、それはやはりその映画の犬の歌らしくしか聞かれないであろう。",
              "citation": {
                "source": "生ける人形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な「ポチョムキン」の市街砲撃の場面で、石のライオンが立ち上がって哮吼するのでも、実は三か所で撮った三つの石のライオンの組み合わせに過ぎないということである。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆらぐ石門」「石のライオンが目をさまし吼えておどり上がる」という連鎖と比べてどこに本質的の差違があるか。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "花王歯磨、ライオン象印、クラブ梅香散……ざっと算えた処で五十種以上に及ぶです。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ぢゃ、ライオン堂へ行ってこれでウ※スキーを一本買ってねそれから広告をくばってやるからと云って何かのちらしを二百枚も貰ひたまへ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾張町の角に、ライオンというカフエが出来、七人組の美人を給仕女に傭って、慶応ボオイの金持の子息や華族の若様などを相手にしていたのもそう遠いことではなかった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりの黒人は買ってきたライオンの子を綱で引いています。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっ、らいおんです。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "たてがみのある、大きならいおんが、いまにも、女の子にとびつきそうにしているのです。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして、らいおんなど、いるはずがない。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
