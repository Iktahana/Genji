        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "防波堤からのおかづりで、アジが入れ食い状態になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "おかづりなら道具も少なくて済むから、初心者でも気軽に楽しめる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼は毎週末、近くの河川でおかづりを楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "百本杭といつて、われわれ子供にはこれは願つても無い陸釣りや蟹つりのスタヂアムだつた。",
              "citation": {
                "source": "両国橋の欄干",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸小ばなしに、師直、家来を連れて陸釣りに出たが、何も釣れぬに中っ腹。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸釣りにミミズ、海釣りにゴカイは何魚にも使うが、三十四年のハゼ釣りに、どうしたことかゴカイがとれない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸釣りでも、土地の観光、私鉄の宣伝と数え出せばきりがない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸釣りのうしろ姿や秋のくれ　　　　　　　　　其角　ぼくは釣り師仲間から、悪物食いだのゲテモノ釣り師だのといわれるが、釣るということ自体が何かいたずら気のあるもので、竿先に止まるトンボ、ウキを見つめるカエルなどを、一度は誰しも釣ってみようと思う。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "――この水路や沼や池には、鮒、鯉、鮠、鯰などがよく繁殖するため、陸釣りを好む人たちの取って置きの場所のようであった。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸釣で海にさらわれるのは、多く荒磯の釣にゆくからである。",
              "citation": {
                "source": "荒磯の興味",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
