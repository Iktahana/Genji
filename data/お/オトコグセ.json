        "examples": {
          "standard": [
            {
              "text": "彼女の男癖の悪さには、親友の僕でもさすがに愛想が尽きた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "結婚直前になって男癖が災いし、婚約破棄されることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "男癖さえ直れば彼女は完璧なんだけどな、と彼はため息をついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「その女は何處の者でせう」「親分、――これは言つて宜いか惡いかわかりませんが、一、二年前、丁子屋にそんな下女が居りましたよ、房州女で」「今でも居るでせうか」「いえ、男癖が惡いので、出してしまひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "碁敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その女はどこの者でしょう」「親分、――これは言っていいか悪いかわかりませんが、一、二年前、丁子屋にそんな下女が居ましたよ、房州女で」「今でも居るでしょうか」「いえ、男癖が悪いので、出してしまいました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "碁敵",
                "note": "青空文庫"
              }
            }
          ]
        }
