        "examples": {
          "standard": [
            {
              "text": "「おたんこなす！何度言ったらわかるんだ！」と上司が怒鳴り散らしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "あいつ、また同じミスをして、本当におたんこなすだな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「そんな簡単なこともできないなんて、おたんこなすもいいところだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「にっぽんかいびゃく以来、あんなお人好しのおたんこなすは見たこともねえ」と男たちは云った、「おれっちがかいびゃくこのかた生きて来たわけじゃねえにしろさ」　けれどもときたま、良さんはつくづくと子供たちを眺めることがあった。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボーボラナンキン」といふのは「オタンコナス奴」といふやうな意味だ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "事情あって、拙者は一命を大切に……」「オタンコナスめ」　白拍子が打ってかかろうとすると、軽くその肩を押えた五郎。",
              "citation": {
                "source": "曾我の暴れん坊",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オタンコナス」　と大姐さんにアグラをかゝれてタンカをきられる始末。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "このオタンコナスめ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オタンコナスめ」　と、漬物屋のオカミサンは怒って帰って行ったが、一時間ほどすると、浮かない顔でやってきた。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな奴ぁ、情無しの、我利々々野郎のオタンコナスの、だら野郎つうだ！",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "笠太　あにをつ※　あにが、此のオタンコナスめ、貴様の亭主にならうと云ふ男ば迎へに出るが、あにが慾だ！",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オタンコナスめ、あんにでもケチを附けるたあ、貴様あ、六平太の小父きにソツクリぢや。",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
