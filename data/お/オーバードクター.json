          "standard": [
            {
              "text": "博士号を取得したものの就職先が見つからず、彼はオーバードクターとして研究室でアルバイトを続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "オーバードクター問題は大学院の定員増加とともに深刻化していると、学会のシンポジウムで報告された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "三十代半ばになってもオーバードクターのままでいる友人を、同窓会で久しぶりに見かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
