        "examples": {
          "standard": [
            {
              "text": "「ぜひ先生に教えを請いたい」と、勇気を出して研究室を訪ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "専門家の知見が必要だったので、専門家に教えを請うことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は常に謙虚な姿勢で、先輩たちに教えを請うていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "この事について幸田露伴博士の教えを請うたが、同博士がいろいろシナの書物を渉猟された結果によると釁るという文字は犠牲の血をもって祭典を挙行するという意味に使われた場合が多いようであるが、しかしとにかく、一書には鐘を鋳た後に羊の血をもってその裂罅に塗るという意味に使われているそうである。",
              "citation": {
                "source": "鐘に釁る",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「宰相の占は、しるしがあったかな」　曾はますます驚いて、僧を拝して教えを請うた。",
              "citation": {
                "source": "続黄梁",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔の色は灰のようになってひざまずいてどうしたなら罪を免れることができるだろうかと言って教えを請うた。",
              "citation": {
                "source": "西湖主",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分より才能・学識の低い人にも教えを請うところに、学を好む熱烈さを看る。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "さぞかし先生も自分より才能・学識の低い人にも教えを請うたことであろう。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
