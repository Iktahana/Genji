[
  {
    "uuid": "8f23a3ef-5346-5fc6-9ab5-0c807be99051",
    "entry": "降り口",
    "reading": {
      "primary": "おりぐち",
      "alternatives": [
        "おりくち"
      ],
      "is_heteronym": false
    },
    "grammar": {
