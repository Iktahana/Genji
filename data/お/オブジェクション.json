          "standard": [
            {
              "text": "裁判所でオブジェクションが出され、証人の発言が記録から削除されることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "契約交渉の場でクライアントからオブジェクションが提出されたため、条項の一部を修正した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このマーケティング計画に対してオブジェクションがあれば、明日の会議で述べてください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それで此方のオブジェクションが除かれた訳でも何んでもなかつたが、当時の私には美事に除り去られたもののやうな気がしたと見えて、それぢやといふので、愈よ会ひに行く事にする。",
              "citation": {
                "source": "吉右衛門の第一印象",
                "author": "小宮豊隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
