        "examples": {
          "standard": [
            {
              "text": "講義の終わりに、学生たちが一斉におっ立つ音が聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "突然の大きな音に驚いて、椅子からすぐにおっ立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会議で意見を述べるために、彼は毅然とおっ立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "いくらひどく踏みにじられても、ひと晩はげしい霜にあったら、草がシャッキリおっ立つぐらいのこたア、あなたがご存じないはずはない。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "御代参の乗物",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱穀器は小屋やそこら中の雪、それからすきとおったつめたい空気をふるわせてまわりつづけました。",
              "citation": {
                "source": "耕耘部の時計",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お日さまは、空のずうっと遠くのすきとおったつめたいとこで、まばゆい白い火を、どしどしお焚きなさいます。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その杉には鳶色の実がなり立派な緑の枝さきからはすきとおったつめたい雨のしずくがポタリポタリと垂れました。",
              "citation": {
                "source": "虔十公園林",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の三人には、どんなごちそうでも、果物でも、お菓子でも、あのすきとおったつめたい水ほどおいしくはないように思われました。",
              "citation": {
                "source": "新宝島",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
