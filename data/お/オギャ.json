        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "常に赤ちゃんの着る花模様のおべべを着て、でんでん太鼓など振って、その九十歳だか百歳だかの御両親のまわりを這いまわって、オギャアオギャアと叫び、以て親の心を楽しましめたり、とあります。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオギャンのタヒチの女そっくりだ。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "透明色の無限の重ね出をしてゐるゴオギャンに比して、その意味では彼は確かにゴッホ的なところがある。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして遂には、その尻尾を引っこめて、前足を持上げて手の形にして、後足で直立して歩きまわる人間の形……普通の胎児の姿にまで進化してからオギャアと生まれる……という段取りになるので、そうした順序から、これに要する時間までも、万人が万人、殆ど大差ないのが通例になっている。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがオギャーと生れてから後の修養や経験に依って整理淘汰されたものが、その人の性格となり、これが向上洗練されたものが、その人の人格となる。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は不思議にも生まれた時から口がありまして、オギャアオギャアと泣きましたそうで、そのために赤ン坊の泣き声を聞いたことのないこの国の人々は『王様のお城に化け物が生まれた』と大騒ぎを初めました」「まあ、何と馬鹿でしょうね。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人造人間の発見」「試験管から人間が生れる」「今秋までにはオギャアと産声をあげる」というようなセンセーショナルな標題をかかげているのがあるかと思うと、村木博士と内藤女史との肖像をならべて「これが試験管で出来る赤ちゃんの御両親です」などと書いているのもあった。",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオギャンだの、ディフィだの好きです。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オギャーと産れたその時から夜鷹商売をするものはねえ」「妾は播州赤穂産れ。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カン護婦のバタバタ足音「御安産でございますよ、お嬢様」　○ホンときこえる　オギャー、オギャーというあの声。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはポオル・ゴオギャンである。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはゴオギャンの転生である。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れてから一昼夜、泣かなかったのでお父さんもお母さんも、産婆さんも、この赤坊は唖ではないかと心配したそうですが、生れてから二十時間たった翌朝の八時頃、元気な声で、オギャーオギャーと産ぶ声をあげたのでみんな愁眉を開いたそうです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルレエヌの韻文狂言「お互に」は、ポオル・フォオルの肝入りでゴオギャン後援のために催された慈善興行の上演目録に加へられた。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "新吉の顔を見ると女房お累が虫気付きまして、オギャア／＼と産落したは男の子でございます。",
              "citation": {
                "source": "真景累ヶ淵",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャルロッタ　（くるまれた赤んぼのような格好をした包みをかかえて）わたしの赤ちゃん、ねんねんよう……（オギャア、オギャア！",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はオギャアといって、この世に生れて以来、善悪ともに片端から手ッ取り早くかたづけたものだ。",
              "citation": {
                "source": "作男・ゴーの名誉",
                "author": "THE HONOUR OF ISRAEL GOW",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マドモァゼル・サトコ、あなたにはまったくうまくだまされましたよ」　あたしはふしぎな赤ん坊で、オギャアともワンとも泣かないので、ずいぶんしずかな赤さんだなんて油断していたら、だしぬけに看護婦の顔の真ん中をうんと蹴っとばして卒倒させたということだった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ放し飼いの牛までまじって、モウモウ、オギャアオギャアと大変な混雑雑踏。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "八人の小悪魔",
                "note": "青空文庫"
              }
            },
            {
              "text": "オギャアと生れたのはツーロンの軍器廠の門衛小屋だ。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、曲った背中と、なえた足を持って貴族の家にオギャと生れた瞬間からね。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもふるえあがっている人々の耳をうってくるものは、屋根の棟をゆりうごかして、ごうごうとなりはためいているその大つむじ風のなかで、ギャオギャオ！",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "上は青空、下は大江、オギャアと泣いたときから、潯陽江の水を産湯に男となった混江龍の李俊、いやさ今では梁山泊のお一人だ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
