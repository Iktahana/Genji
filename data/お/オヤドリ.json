[
  {
    "uuid": "d8b079fa-61c3-509d-9da2-11206d2a3e42",
    "entry": "親鳥",
    "reading": {
      "primary": "おやどり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
