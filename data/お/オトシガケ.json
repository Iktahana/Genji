        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "茶室の落とし掛けは素晴らしい職人技だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "落とし掛けの彫刻を見ると、その時代の美意識が分かる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新築の家に落とし掛けを取り付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "外をながめながら後ろの板へよりかかっていた薫の重なった袖が、長く外へ出ていて、川霧に濡れ、紅い下の単衣の上へ、直衣の縹の色がべったり染まったのを、車の落とし掛けの所に見つけて薫は中へ引き入れた。",
              "citation": {
                "source": "源氏物語",
                "author": "東屋",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
