          "standard": [
            {
              "text": "山の雑木林を歩いていると、大赤啄木鳥が幹を力強くつついている姿を見かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "バードウォッチャーたちは大赤啄木鳥の白黒のまだら模様を望遠鏡で確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "大赤啄木鳥はブナ林を好み、北海道の山岳地帯でよく観察される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "えぞせんにゅう、えぞおおあかげら、くまげら、しめ、赤ばら、えぞやまどり、しまえなが、のびたき、かけす、きびたき、るりびたき、しぎ、うみがらす、つつどり、きんくろはじろ、かるがも、こおりがも、おおせぐろかもめ、おいらんかもめ、うみしぎ、ちどり、うのとり。",
              "citation": {
