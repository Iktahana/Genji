[
  {
    "uuid": "e2976f1d-afcb-59fe-a0c7-64eec470eb43",
    "entry": "幼なじみ",
    "reading": {
      "primary": "おさななじみ",
      "alternatives": [
        "おさなじみ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "childhood friend",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は幼なじみと小学校の時から付き合っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "幼なじみの家はうちの隣にあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "幼なじみとの思い出は今でも大切だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「まずあんた方にご理解いただきたいのは、俺とあいつは幼なじみってことです。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エキスポ会場に用意したブースは小さかったけれど、意義のある大きな仕事に取り組んでいる、幼なじみに再会したような気分になりました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蘭とてまえは一つ町に育った幼なじみ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "向こうは加賀家のお腰元に、てまえは染め物いじりの紅屋さんへ――」「分かれて色修業に奉公しているうち、とんだほんものの色恋が染め上がったというのかい」「というわけではござりませぬが、やはり幼なじみと申す者はうれしいものでござります。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "それというのも、わたしとあの秀の浦とが幼なじみの間がらゆえ、わたしに事情を打ちあけなされまして、秀の浦にあの封じ手を使わするようそそのかしたのでござります。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒色のくちびる",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして尾道時代には春の目ざめの憧憬がまだ幼なじみた身体にませた愛らしさで芽ばえていたのが、今はようやく逞ましい肉体の中から生理的な、若々しい動物のものとして発育しようとしつつあった。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おせんが慕う菊之丞は、江戸中の人気を背負って立った、役者の菊之丞ではなくて、かつての幼なじみ、王子の吉ちゃんその人だったのだから。",
              "citation": {
                "source": "おせん",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふりわけがみの幼なじみが今のいづみ子に会ったらきっとおどろき、そしてどんなに恋着することでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "新村は隣り屋敷で、家格は岸島よりやや低く、主の勘右衛門は七百二十石の中老を勤め、夫婦のあいだに二男一女があり、末娘の七重と出三郎とは幼なじみであった。",
              "citation": {
                "source": "艶書",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お互いの仲だからいいと思ったんだが」と彼は呟やいた、「幼なじみだから笑って見てくれると思ったんだが、――やっぱり年ごろの娘に恋文を読めなどというのは、悪かったかもしれない」　ばかなことをした、と彼は自分を罵しった。",
              "citation": {
                "source": "艶書",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年亡くなった僕の父親と幼なじみの同世代だ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "店主のジョージ沖中と僕の父親は幼なじみだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この島での、ぼくにとっての幼なじみである友人が建築業を営んでいて、その彼が古いドアのコレクターでもある、という話を、ぼくは右側のシートにすわっている彼女に喋った。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイラムに会いたいと言っているラウパホエホエの幼なじみの名は、ワラス・トクジ・カネシゲという。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼なじみの友人、ハイラム・サクイチ・カワシマが来たということはひと目でわかったらしく、ハイラム、よく来た、と言ってワラスはひとりがけのソファをすすめた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛子と哲也は事実としてなかば姉弟であり、その事実関係を越えてさらに、仲のいい幼なじみどうしとなっていった。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまの島村は、いっしょに店へ来た伊東夏子という女性を撮っています」「ずっと近所に住んでいて、幼なじみだという人ね」「そうです」「ものすごい美人だったわ。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「じつは当寺の裏山、扇山の奥に、わたしの幼なじみがおります。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜之助とは郷を同じうして、おさななじみであったとのこと。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい話じゃありませんが、おさななじみのわたしどもにとってみると、どうもひとごととは思われない気がします」　雲衲の一人は、しめやかに昔を追懐して、道を誤った幼き友のために、代ってその罪を謝するかのような調子です。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
