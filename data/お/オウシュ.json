        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "黄酒は中国の伝統的な醸造酒である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "黄酒を飲むことは特別な席の習慣だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "黄酒の深い味わいは何度飲んでも新鮮だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "阿Ｑはちょうど二碗の黄酒を飲み干して足踏み手振りして言った。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
