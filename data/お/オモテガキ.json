[
  {
    "uuid": "5f214c9c-5bc1-5420-a018-b6e449ad1dfb",
    "entry": "表書き",
    "reading": {
      "primary": "おもてがき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
