        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "明日の試験は、先生、どうぞお手柔らかにお願いします。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "厳しい指導の中にも、彼なりのお手柔らかさがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "お手柔らかに頼むと言ったのに、初日から徹底的に絞られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「全くだ」とＡも思ふ、「しかしま、お手柔らかに」と、表情以て友達甲斐を発揮する。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかお手柔らかに」と私も微笑をもってこれに答えた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかお手柔らかに――先生はまずそこにおかけください。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "左頬にあざある一少尉は少軍医の手をとり、　「わが輩が負傷したら、どうかお手柔らかにやってくれたまえ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "左頬にあざある一少尉は少軍医の手をとり、「わが輩が負傷したら、どうかお手柔らかにやってくれたまえ。",
              "citation": {
                "source": "小説　不如帰",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ですが、どうかお手柔らかに願いたい！",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "礼儀だから仕方がない、「お手柔らかに」と藤作はいった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「幼年時代」は何しろゴーリキイやトルストイがあるからお手柔らかに思われますが。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生、なかなかお人が悪い、時節柄ですから、ずいぶん驚いてしまいましたよ、どうかお手柔らかにお願い致したいものでございます」「別段、貴様をおどかしてみるつもりもなかったのだが、張っておいた網に貴様の方からひっかかったようなものだから、ふしょうしろ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あぶないもんだ、お手柔らかに願いたい」　この問答を見ると、土方歳三がいよいよ受身である。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「望むところ、お手柔らかに」　と伝内も緊張した。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おてやわらかに、おてやわらかに。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうか、おてやわらかに願いたいもんで。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "このおてやわらかないたずらは、幸いに船と人命をいためることはありませんが、船と人をてこずらせることにおいては、いっそ一思いに打ち壊してしまうものより、遥かに以上であります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "安房の国の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうぞおてやわらかに願えてえものでがんす、借物ですからね、こう見えても、この烏帽子直垂は、土地の神主様からの借物でげすから――自分のものなら質の値が下ってもかまわねえけれど、借物だから、おてやわらかに願えてえもんでがんす」　さすがに道庵先生は、江戸ッ子です。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手荒いことをしてくれ給うなよ」　兵馬は、おとなしく頼むように言うと、仏頂寺は、「何だい、おてやわらかに取扱わねばならん甲冑が役に立つか。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
