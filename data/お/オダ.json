  {
    "uuid": "36ba5b82-d45f-59be-9deb-e05586d764ba",
    "entry": "オダ",
    "reading": {
      "primary": "おだ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "このたびは霧がなかった、紫の花咲くクカイ草、蘭に似た黄色の花を垂れるミヤマオダマキが、肉皮脱落して白く立っている樅の木を、遠く見て、路傍にしなやかに俯向いている、熊笹が路には多い。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "車百合、稚子百合、白花蛇イチゴ、コケモモ、ゴゼンタチバナ、ヤマオダマキなどが、陰森たる白ビソ、米ツガ、落葉松などの下蔭にうずくまっている。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人で、いやに真面目な顔をして銀座を歩いて、資生堂でアイスクリイム・ソオダとでもいったところか。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の片隅にはアオイ・ホテルから小湊へ事件後返り咲いたお六が、南京刈の男のウィンクに応じて立上るとショートオオダァのために別室に消えた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と満谷なる自分がオダテた。",
              "citation": {
                "source": "号外",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "よせやい、お通夜じゃないか、静にしろとアオヤマが言うとオダが、いやこいつは派手なお通夜の方が喜ぶぜと言って、おいサエキそうだろうと声を掛ける。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "作中に「オダ」という人名が出て来ますが、これは読者が佐伯は作者であるなど思われると困りますので、「オダ」が出て来るのです。",
              "citation": {
                "source": "吉岡芳兼様へ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今宮の十銭芸者か」と海老原は知っていて、わざと私の顔は見ずに、「――オダサク好みだね。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "若崎は徹底してオダテとモッコには乗りたくないと平常思っている。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "田にはもう掛稻は稀で稻を掛けた竹の「オダ」がまだ外されずに立つて居る。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オダ」には黄昏に鴫でも來て止る位のことだらう、見るから淋しげである。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オダ」には黄昏に鴫でも來て止る位のこてとだらう、見るから淋しげである。",
              "citation": {
                "source": "寫生斷片",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代り起業祭の角力の懸賞はオンチのものだろう」と戸塚がオダテるように又野を見上げた。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それを持って筥崎宮の二番目の中の鳥居の傍に在る何某（失名）という茶屋に行って、そこに居る禿頭の瘠せこけた婆さんへ、その短冊を渡してオオダイを下さいと云いなさい。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオダイ……わかるかの」「オオダイ」「そうそう。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオダイとは、どんな品物だろうと色々に想像しながら……。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオダイじゃろう」「はい。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオダイ」「ふうん。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これがオオダイだすな」　婆さんがうなずいた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの娘が若い衆にオダテられてウッカリ喋舌ったって言うんですの。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（東京の美しい、義理堅い花柳界を知つたならば、幾分かオダワラ育ちの野卑の教養にもなるだらう。",
              "citation": {
                "source": "蝉",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔つてゐると云つたつてオダハラの吾家だよ、にくむ勿れ、間もなく酒樽も空らしい。",
              "citation": {
                "source": "秋が深い頃だ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもハイカラな浜でなくて幸せさ、若し、オダハラでなかつたら、あんなミナリで泳いでゐたら、とうに、つかまつてしまつたらうよ。",
