        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "故郷の家族を思い焦がれながら、異国で働いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "離れた恋人を思い焦がれて毎日手紙を書いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "幼い日々の記憶を思い焦がれて、故郷に帰った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そう思うとその無念やら怨恨やらは一層お宮を思い焦がれる情を切ながらした。",
              "citation": {
                "source": "うつり香",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "――自分はさる家の乳母であるが、自分のそだてた嬢さまがあなたをみそめ、おもいこがれるあまり病気のようになった。",
              "citation": {
                "source": "屏風はたたまれた",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その娘らが、秋祭りに笛を吹いて通る美しい若衆を見て、いちように深く思いこがれる身となりました。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、恋す、という語には、いまだ所有せざるものに思いこがれるようなニュアンスもあり、愛すというと、もっと落ちついて、静かで、澄んでいて、すでに所有したものを、いつくしむような感じもある。",
              "citation": {
                "source": "恋愛論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "御行　（御所車の前まで文麻呂を連れて行って）この中にあなたの思い焦れるなよたけの君がいるのです。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
