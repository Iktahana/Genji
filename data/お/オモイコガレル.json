        "examples": {
          "standard": [
            {
              "text": "故郷の家族を思い焦がれながら、異国で働いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "離れた恋人を思い焦がれて毎日手紙を書いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "幼い日々の記憶を思い焦がれて、故郷に帰った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そう思うとその無念やら怨恨やらは一層お宮を思い焦がれる情を切ながらした。",
              "citation": {
                "source": "うつり香",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "――自分はさる家の乳母であるが、自分のそだてた嬢さまがあなたをみそめ、おもいこがれるあまり病気のようになった。",
              "citation": {
                "source": "屏風はたたまれた",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
