        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "布の端を少し内側に折り込むと、縫い目が隠れて見た目がすっきりする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "手紙を封筒に入れるために、規定のサイズに折り込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "スカートの裾を内側に折り込んで、長さを調節して縫った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "それで、敷布をひろげるにも、壁の方の側の縁を折り込むにも、熊手を使う。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to insert (e.g. a flyer in a newspaper)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
