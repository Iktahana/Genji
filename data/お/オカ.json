        "examples": {
          "standard": [
            {
              "text": "最終局面で逆転するために、このラウンドで丘を狙ってプレイした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ゲーム終了時に残ったコインが丘として加算された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "丘の計算方法を間違えてしまったため、優勝を逃してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
