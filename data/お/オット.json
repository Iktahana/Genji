  {
    "uuid": "578dfe6f-3e7c-5f53-befd-fef4c9219677",
    "entry": "オット",
    "reading": {
      "primary": "おっと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "馬鹿と面罵するより他に仕様のなかった男、エリオットの、文学論集をわざと骨折って読み、伊東静雄の詩集、「わがひとに与ふる哀歌。",
              "citation": {
                "source": "碧眼托鉢",
                "author": "――馬をさへ眺むる雪の朝かな――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに来ると自分はどういうものかきっと、ドストエフスキーの「イディオット」の死刑場へ引かれる途上の光景を思い出すのである。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オットセイは鼻の頭で鞠をつく芸当に堪能である。",
              "citation": {
                "source": "ゴルフ随行記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に彼の『イディオット』の主人公の無技巧な人格の美に対して感じるような快感を津田君の画から味わい得られる。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "土を食う分量はもとより一定せぬが、オットマック土人は一日に半ポンドも食うという。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "王国の賛沢な偕調が部屋を満たして、アングロサクソンの英諾威人、ケント族の仏伊人、スラブの露墺人、アイオニアンの血族｜希臘人、オットマン帝国の土耳古人等に交って、東洋の黄色な悲劇的な顔が七分の運と三分の運命に対する己惚れをもって、千金を夢みているのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はマダム・レムブルグの家でアングロ・サクソンの英諾威人、ケント族の仏伊人、スラブの露墺人、アイオニアンの血族｜希臘人の商人、オットマン帝国の土耳古人等と夜食を共にするのであった。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はマダム・レムブルグの家でアングロ・サクソンの英諾威人、ケント族の仏伊人、スラブの露墺人、アイオニアンの血族希臘人の商人、オットマン帝国の土耳古人等と夜食を共にするのであった。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "※「……一六六三年十一月二十四日、リンダのランゲナウ、グレニツ及びチィグラの領主、オットオ・フォン・リルケは、匈牙利にて戰死せし弟クリストフの遺せるリンダに於ける所領地を讓渡せられたり。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に飛び込んだる髯将軍、オットセイと称して浴槽の中へ仰のけのまま跳り込み、頭から、足からザブンザブン飛び込むこと十数回、危うく浴構内の土左衛門さんとならんとせしところを三人して引挙げ、ようやく事なきを得た。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "オットセイの黒ずんだ肉を売る店があったり、猿の頭蓋骨や、竜のおとし児の黒焼を売る黒焼屋があったり、ゲンノショウコやドクダミを売る薬屋があったり、薬屋の多いところだと思っていると、物尺やハカリを売る店が何軒もあったり、岩おこし屋の軒先に井戸が二つあったり。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガリレー、トリツェリ、ヴィヴィアニ、オットー・フォン・ゲーリケ、フック、ボイルなどといったような人がはなはだ粗末な今から見れば子供のおもちゃのような道具を使って、それで生きた天然と格闘して、しかして驚くべき重大な画期的実験を矢継ぎばやに行なったのがそもそもの始まりである。",
              "citation": {
                "source": "量的と質的と統計的と",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地理教室の図書の管理をしていた、オットー・バシンという人も同じ仲間であったがこの人は聴講に身が入って来ると引切りなしに肩から腕を妙に大業に痙攣させるので、隣席に坐るとそれが気になって困った。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸で裸で日光浴をやっているオットセイのような群れも号令でいっせいに寝返りを打ってこちらを向く。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリック・エリオット、映画技術と芸術（岸松雄訳）。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴重海獣の漁獲だけに努めて保護に努めなかった結果は、我が国沿海にラッコ、オットセイの減少を来たしたではないか。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "オットリして浅薄でないことをとなる。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ記事のなかに海豹島のオットセイの話も出ていて、これは大山猫とは全然正反対な、生めよ殖せよの極致だった。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいつか映画でオットセイの群棲を見たことがある。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――オット、奴さんたしかに階段を登って来るらしいぞ、さあこうなるとパイプの詮議立てなんかしているより面白くなるて……」と云っているとほどなく、私達の部屋の入口が開かれた。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」＊デンマルクの詩人ホルベルのデンマルク国史物語に、ハンス王が寵臣のオットー　ルードとアーサー王君臣の交りについてとんち問答した話がかいてある。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "知らない曲だが、慶一の耳は、グレアム・ナッシュのハイ・ハーモニーと、ボビー・エリオットのスネア・ワークを聴きわけ、ホリーズの新曲だろう、と考えた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子戸越に見るヘリオット｜通りはまだ夜のままで、所々に街灯がぼうっと滲んで見える。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ということなしに、私は、其の通を少し行って左へ曲れば、ヘリオット・ロウ（自分が少年期を過したエディンバラの）の我が家に帰れるように考えていた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このほかにエリオットのおった家とロセッチの住んだ邸がすぐ傍の川端に向いた通りにある。",
              "citation": {
                "source": "カーライル博物館",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェロ奏者オットカール・レヴェズは洪牙利コンタルツァ町医師ハドナックの二男。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これと、死体のある室の、傴僂治療之図の二枚は、有名なオットー三世福音書の中にある插画なんだよ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オットカールは吊されて殺さるべし。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右端の、不細工な巨石としか見えないチェリスト、オットカール・レヴェズは、そこに半月形の髯でも欲しそうなフックラ膨んだ頬をしていて、体躯の割合には、小さな瓢箪形の頭が載っていた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリガ・クリヴォフ（同前）　ガリバルダ・セレナ（同前）　オットカール・レヴェズ（同前）　田郷真斎。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
