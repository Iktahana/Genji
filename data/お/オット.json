[
  {
    "uuid": "d748a486-dcdc-5336-bbfe-6dc21065870f",
    "entry": "夫",
    "reading": {
      "primary": "おっと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
