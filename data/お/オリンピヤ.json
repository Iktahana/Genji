        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ギリシアのオリンピヤの競争に捷った三の牝馬は死後廟を立て葬られた。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、出かけよう」「オリンピヤはぼくのものだぜ、諸君、ちゃんと約束しておこう！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつは、オリンピヤといっしょに、長いすに坐ってるに相違ない。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまいましいオリンピヤめ！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはオリンピヤの髪をつかんで、引き倒してやる。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬えて云えば、オリンピヤの闘技場で、観覧席にいて競技を見ているものは、丁度之を「客観」している人達になるわけだが、彼等自身は競技に参加していない処の人間に他ならない。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学オリンピヤアドの記事は、かういふ消息がとつくに文部省あたりへはひつてゐながら、一般は固より、日本の文壇の誰もが知らずにゐたといふ現象を、ちよつと皮肉に感じたから、文学者にとつては別に大したことではないが、ヂヤアナリズムの立場から酔興に取上げて見た。",
              "citation": {
                "source": "編輯当番より",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
