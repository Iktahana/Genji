      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私が襲って来るかも知れぬ苦しみに対して恐れ戦くのは主としてこの理由からである。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "（けれどいっそう徹底的に考えるならば、恐れ戦くということがすでに間違っているのかも知れない。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "無生のものが生の息吹に触れて恐れ戦くに似ている。",
              "citation": {
                "source": "真夜中から黎明まで",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、生れ出たばかりの嬰児が、広々とした空間に畏怖して、手足をちぢめ、恐れ戦くが如き感じであった。",
              "citation": {
                "source": "火星の運河",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "アガメムノーン・クレーオーン彼等を眺め叱り責め、羽ある飛揚の言放ち彼に向ひて宣んし曰ふ、『軍馬を御する豪勇のチュウヂュウスの子ああなんぢ、何故恐れ慄くや、戰場眺め怖るゝや？",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "今昔物語十九に、左大臣藤原師尹の侍童が、大臣秘蔵の硯を破って恐れ慄く状を記して、「護法のつきたる者の様に、振ひて目も暮れ心も騒ぎて」、また同じ巻に越前守孝忠の侍の戦慄の状を記して、「早朝に此の侍の男浄めすとて、護法のつきたる者の様に振ひけるを、守見て、汝和歌読め」など見えている。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
