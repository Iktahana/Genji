        "examples": {
          "standard": [
            {
              "text": "今度のオリンピック大会のチケット、抽選に外れてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "オリンピック大会の開会式を、家族みんなでテレビの前で応援した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "オリンピック大会期間中は、交通規制のため少し不便になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "今、オリンピック大会が始まつてるんだよ。",
              "citation": {
                "source": "かぶと虫",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又日本にして見れば丁度極東オリンピック大会をつぶしてアジア大会を組織したように、支那の仏教は支那に返して、支那抜きのアジア仏教大会と云ったようなものでも造れば、余計な下手な文句はいらないではないか。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年九月、オランダのオリンピック大会から帰って来て年の暮れるまで旅のつかれと二度の遠征による体のつかれでふたたび競技場に立てるかと心配した。",
              "citation": {
                "source": "世界記録と私",
                "author": "人見絹枝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
