        "examples": {
          "standard": [
            {
              "text": "朝食に押し麦入りのおかゆを作ったら、いつもより腹持ちがよかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "健康を意識して、白米に押し麦を混ぜて炊くようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "スーパーで押し麦を買ってきてスープに加えたら、食感がよくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "胃弱を患う人がタカジアスターゼを服し、クミチンキを服し、ペプシンを服し、粥を煮て吸い、フランスパンを買って食らい、押し麦を食らうのを見ることは多いが、咀嚼時間を長くして丁寧に咀嚼することが少ないなどはその一例である。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒキ割り麦、押し麦などは、もすこし安い。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
