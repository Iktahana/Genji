        "examples": {
          "standard": [
            {
              "text": "配送の際に荷物をオーバーラッピングして、保護を強化している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オーバーラッピング機能のある機械で効率的に梱包している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "複数回のオーバーラッピングにより、商品が安全に届く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "画面を単純に複数のウインドウに分割するだけのタイリング方式も試みられたが、ウインドウの大きさを自由に設定できて、重ね合わせることのできるオーバーラッピングウインドウを考案し、スモールトークに組み込んだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
