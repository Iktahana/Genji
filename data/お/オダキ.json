    "definitions": [
      {
        "index": 1,
        "gloss": "greater waterfall (of the two)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
