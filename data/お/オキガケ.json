        "examples": {
          "standard": [
            {
              "text": "起きがけに一杯の水を飲むのが彼女の習慣だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "起きがけに妙な夢の続きが頭に浮かんでなかなか消えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "起きがけからひどい頭痛で、今日は仕事を休むことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "無理もないと引返して、夜も寝ないで今朝、起きがけに行くともう居ないんです。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あて、あしたの朝起きがけに直ぐ姉ちゃんとこい行くさかい、ハズさんが遅うまで寝てはったら、早起してさっさと追い出してしもてエな。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
