        "examples": {
          "standard": [
            {
              "text": "応報主義の観点では、加害者が受ける刑罰は被害の深刻さに比例すべきだとされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女の論文は、応報主義が現代の刑事司法においてどのように機能しているかを分析したものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「応報主義だけでは再犯防止につながらない」という意見をめぐり、議論は白熱した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "権太の苦心の水泡となりしは、作者の懐ける因果応報主義を発表せしものにて「思へばこれまで衒つたも、後は命を衒らるゝ種と知らざる浅間しや」といへる一句はいはゆる狂言の山なるべし。",
              "citation": {
                "source": "いがみの権太",
                "author": "三木竹二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
