        "examples": {
          "standard": [
            {
              "text": "古代インドの狼少年の話は、言葉の獲得についての議論で引き合いに出される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "あの物語の狼少年は、狼たちに育てられたため人間の言葉を話すことができなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "狼少年のように人間との接触なしに育つと、言語発達に大きな遅れが生じるとされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
        "gloss": "boy who cried wolf",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
