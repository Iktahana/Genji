        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「決して御客様方の人格を疑うような訳ではありませんが、これも職務で御座いますからどうか悪しからず御勘弁を願います」と云う。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このリンクの御客が概して地味で真面目で威張らない人の多いせいかもしれない。",
              "citation": {
                "source": "ゴルフ随行記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が昔現在の家を建てたとき一番日当りがよくて庭の眺めのいい室を応接間にしたら、ある口の悪い奥さんから「たいそう御客様本位ですね」と云って、底に一抹の軽い非難を含んだような讃辞を頂戴したことがあった。",
              "citation": {
                "source": "新年雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "卓の両側に陣取った御客様の前に来るごとに、宜しく召上がれと停車する。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分それらの御客と運転手とはお互いに「人」として知合っているせいであろう。",
              "citation": {
                "source": "静岡地震被害見学記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "○○百貨店○○支店の一行は和服が多く、此方は藝者を揚げて三絃の音を響かせて居るが、肝心の本職の藝者の歌謠の節※はしが大分危なつかしく、寧ろ御客の中に一人いゝ聲を出すのが居て、それがやゝもすると外れかゝる調子を引戻して居るのは面白い。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ御客様に一ツお聞かせなさいましなね。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう云う不思議な店へこんな物を買いに来る人があるかと怪しんだが、実際そう云う御客は一度も見た事がなかった。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それともつかぬ状で座敷を見入ったが、「御客様かい、貴方御免なさいよ。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "泰助も続いて入込み、突然帳場に坐りたる主人に向いて、「今の御客は。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴下は今しがた御着になった御客様、さてはその筋の。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と繰返して、「今に御客も来るし、今朝のね、彼の件はきっと謂わないだろうね。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし失礼な、私の大切な御客様をおどそうなんて、飛んでもない。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大目に見ておくれ、この御客は私が買うよ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸者に粋な御客人、至って野暮な御亭主なり。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷い挽割飯と、大根ッ葉の味噌汁と、塩辛く煮た車輪麩と、何だか正体の分らぬ山草の塩漬の香の物ときりで、膳こそは創だらけにせよ黒塗の宗和膳とかいう奴で、御客あしらいではあるが、箸は黄色な下等の漆ぬりの竹箸で、気持の悪いものであった。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "網は御客自身打つ人もあるけれども先ずは網打が打って魚を獲るのです。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも御客が、釣も出来ていれば人間も出来ている人で、ブツリとも言わないでいてくれるのでかえって気がすくみます。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると中浮になっていた御客様は出て来ない訳には行きませんでした。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっしあ加州の御客に聞いておぼえましたがネ、西の人は考がこまかい。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷い挽割飯と、大根ッ葉の味噌汁と、塩辛く煮た車輪麩と、何だか正体の分らぬ山草の塩漬の香の物ときりで、膳こそは創だらけにせよ黒塗の宗和膳とかいふ奴で、御客あしらひではあるが、箸は黄色な下等の漆ぬりの竹箸で、気持の悪いものであつた。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "も一歩進めていって見れば、京伝や三馬や一九や春水は、常に馬琴が端役として冷遇した人物、即ちわずかに刷毛ついでに書きなぐったような人物を叮嚀に取扱って、御客様にも本尊様にもして、そして一篇なり一部なりを成して居る傾きがあります。",
              "citation": {
                "source": "馬琴の小説とその当時の実社会",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "お兄様、あの、先程から何やら気味のわるい御客様が御帰りを御待ちかねでござります」「なに！",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその上で「人の心は飛鳥川、変るは勤めのならひぢやもの」という懐疑的な帰趨と、「わしらがやうな勤めの身で、可愛と思ふ人もなし、思うて呉れるお客もまた、広い世界にないものぢやわいな」という厭世的な結論とを掲げているのである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日は出際にお客さんがありはしたし……明日立つたら……」　母が「甘い」とよく彼が言ふので、また言はれはしまいかと思つて、遠慮深さうにさう言つた時、彼はさすがに「甘い」とはいはれなかつた、却つて自分の方が「甘い」だつたのだ。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のほかにはお客は誰も居なく、どうしたことか、女給も一人も見えないのでした。",
              "citation": {
                "source": "夜汽車の食堂",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めの間は、私もあなたを『お客』だと思ってたの」といいながら、彼女は枕もとの火鉢の前へ、生娘がするように、つつましくすわって、はにかみながら話した。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はね初めはね、あんたをただのお客と思ったの、そして次には坊っちゃんと思ったの、その次はほんとに物のわかったおとなしい人だと思ったの、そしてね、今ではね、あなたは、そうね、何だろう、何といえばいいだろう、私のおとうさんだわ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "東洋軒は、また、その日も、珍無類なお客を迎えた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "マア坊が「お客様ですよ」と言って、君を部屋へ案内して来た時には、僕の胸が、内出血するほど、どきんとした。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
