        "examples": {
          "standard": [
            {
              "text": "部屋中に散らかった本を、足の踏み場もないほどにおっ広げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は地図をテーブルにおっ広げて、ルートを検討している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "資料を床におっ広げたまま、彼は熟睡してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
