        "examples": {
          "standard": [
            {
              "text": "マンションのオープンルームを見学し、広々としたリビングの作りに夫婦で感動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "来週末に新築マンションのオープンルームが公開されるので、家族全員で足を運ぶ予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "オープンルームで実際の間取りを確認してから、購入を正式に決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
