        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "リゾートホテルのオープンルームで朝食をとりながら、海の景色を楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "熱帯植物に囲まれたオープンルームは、外の風が心地よく通り抜けていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "バリ島のヴィラにはオープンルームのバスルームがあり、空を見上げながらシャワーを浴びた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
