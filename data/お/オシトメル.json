          "literary": [
            {
              "text": "地震で時の流れを押し止めるんだ。",
              "citation": {
                "source": "牢獄の半日",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの時矢張無理にでも押し止めるべきであつたのだ。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしな、よしな――」　静かにうち笑って名人が押し止めると、いいようもよくおちつき払っていったことでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "信一郎が椅子に着かうとすると夫人は一寸押し止めるやうにしながら云つた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "信一郎が椅子に着こうとすると夫人は一寸押し止めるようにしながら云った。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、この絵巻物を開いた最初のうちこそ、一種の反抗心と共に落ち付いた態度を保っていたが、死美人の絵が出て来ると間もなくそんな気持ちはどこへやら消えうせて、巻物を開き進める手がだんだんと早くなるのを自覚しながら、どうしてもそれを押し止める事が出来なくなった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この女の全身の肉体美と、痛々しい黒血を噛み出した乳房とを一所にして、明るい光線の下に晒してみたら……というようなアラレモナイ息苦しい願望が、そこいら中にノタ打ちまわるのを押し止めることが出来なくなったのであった。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者が高価い事を説明して押し止めると、彼は高らかに笑った。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、帰るんぢやない、便所だ、便所だ、」　童顔の男は左の手を出して押し止めるやうにしてから、開けてある硝子戸の端に体を当て当て外へ出た。",
              "citation": {
                "source": "蛾",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先に立って格子に手をかけたのぶ子を押し止めるように、おくめは、「お客様じゃないか、若し、何だといけないから」と囁いた。",
              "citation": {
                "source": "黄昏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "びつくりしてダンサー二人がそれを押し止める。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
