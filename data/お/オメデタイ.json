        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼のお目出度い性格では、詐欺に引っかかりやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "あんなお目出度いことを言っていては、社会で生き残れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "そのお目出度い考え方では、競争に勝つことはできない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
    ],
