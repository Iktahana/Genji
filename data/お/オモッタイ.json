        "examples": {
          "standard": [
            {
              "text": "引っ越しの荷物が重ったくて、二人がかりでもなかなか動かせなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "水を含んだ雪が重ったく積もり、軒先から落ちた塊が大きな音を立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "土産に買った石工芸品が重ったくて、空港で預け荷物に詰め直す羽目になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "来やがった、来やがった、陽気が悪いとおもったい！",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊（五月×日）私はお釈迦様に恋をしました仄かに冷たい唇に接吻すればおおもったいない程の痺れ心になりまする。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
