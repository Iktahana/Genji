    "definitions": [
      {
        "index": 1,
        "gloss": "jute",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "バングラデシュでは黄麻の栽培が農家の重要な収入源となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "黄麻から作られた繊維は丈夫で安価なため、麻袋や包装材として広く使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "環境への配慮から、プラスチック袋の代わりに黄麻製のエコバッグを選ぶ消費者が増えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "着物でも夏であったが、黄麻の無地で、髪や容貌と似合っていた。",
              "citation": {
                "source": "田端の坂",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある夏の夕方、彼女が麦藁帽をかぶって、黄麻の大がすりの維子を着て、浅黄ちりめんの兵児帯をしめて、片腕ブラリとさせて俥夫の松さんに連れられて百々瀬へ行く姿を、あたしは町の角で、夕霧にうすれてゆくのを見送りながら大声で泣出したくなったのを覚えている。",
              "citation": {
                "source": "源泉小学校",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "順助は古風な黄麻の湯上りを着ていたのであった。",
              "citation": {
                "source": "夜の若葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしジェソップ氏は、からだをかがめ顔を地にすれすれにして、とおく残光が、黄麻畑の果にただようあたりに透した。",
              "citation": {
                "source": "一週一夜物語",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも、白い下着の上に黄麻を重ね、裾を端折って、紺｜脚絆だ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔評〕南洲｜弱冠の時、藤田東湖に謁す、東湖は重瞳子、躯幹魁傑にして、黄麻の外套を被、朱室の長劒を佩して南洲を邀ふ。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかし細川藩の国家老とか何とかいう家柄をじまんにして、高い背に黄麻の単衣をきちんときている。",
              "citation": {
                "source": "白い道",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳席（藁莚）、黄麻布、桝呑茶碗、杞柳の弁当箱（トンクリチャツと呼ぶ）、鉄の蝶番など。",
              "citation": {
                "source": "全羅紀行",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の方が珍しく紗の冠をつけて、黒い紐を黄麻の服の胸の前に垂らしていた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかなかしゃれ者とみえ、栗色の縞の着物に黄麻の羽折を重ね、白の足袋をはいていたが、帰って来るとすぐに、それらを脱ぎちらして、おみやをびしびしと叱りながら、常着に着替えた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "国王は、「私どもはこれからいついつまでも、天皇のおおせのままに、おうま飼の下郎となりまして、いっしょうけんめいにご奉公申しあげます。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで皇后はさつそくお聞き届けになりまして、新羅の王をおうま飼ということにおきめになり、その隣の百済をもご領地にお定めになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから百済の国の王からは、おうま一｜頭、めうま一頭に阿知吉師という者をつけて献上し、また刀や大きな鏡なぞをも献じました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "お酔いつぶれになっていた天皇は、河内の多遅比野というところまでいらしったとき、やっとおうまの上でお目ざめになり、「ここはどこか」とおたずねになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでまったくなんのお気もなく、すぐにおうまにめして、大長谷皇子のお仮屋へ出かけておいでになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう夜も明けたのだから、早くお出かけになるように申しあげよ」とおっしゃって、そのままおうまをすすめて、りょう場へお出かけになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして弓矢を取っておうまを召すなり、大急ぎで王のあとを追ってお出かけになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」となきながら、「すゞ子ちやんはまだおうまれにならないのですか。",
              "citation": {
                "source": "ぽつぽのお手帳",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "白馬を「あおうま」とのみ訓みしは、『平兼盛家集』に「ふる雪に色もかはらで曳くものを、たれ青馬と名け初けん」、高橋宗直の『筵響録』巻下に室町家前後諸士｜涅歯の事を述べて、白歯者と書いて「アオハ者」と訓ず、白馬を「アオ馬」というがごとしといえるにて知るべし。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジダーノフは二つの雑誌の編輯者が、苦しまぎれにした弁明を、いちおうまともに受けてやっているのだとしか思われない。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日バタ／＼やるので、近所の人々は『何んといふ好い月日の下に、おうまれなさつた方達でせう。",
              "citation": {
                "source": "硯友社と文士劇",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "お礼ごころに、お酌をして上げます――」「雪めが、ぶちこまれた穴の上――本堂で酒盛りは、一しおうまいだろう」　と、門倉平馬の、野太い声。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パカ　パカ　パカ」と　おうまが　かけてきましたが、やつぱり　あめくんに　であふと　びつしより　ぬれてしまひました。",
              "citation": {
                "source": "あめくん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "広島の魚は実にうまいですぜ」　口は肴よりもなおうまかるべし。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、女王さまは、このお姫さまがおうまれになりますと、すぐおなくなりになりました。",
              "citation": {
                "source": "白雪姫",
                "author": "グリム",
                "note": "青空文庫"
              }
            },
            {
              "text": "おうまのりレディのうまのりゃ、　ツリイ、ツレ、ツレエ、　ツリイ、ツレ、ツレエ。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹄鉄へれば、おうまがうせる。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "おうまがへれば、のりてがうせる。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "おうまの蹄鉄がへったせいでよ。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっちゃなおうまも買うてあぎょ。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
