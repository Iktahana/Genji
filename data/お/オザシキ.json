  {
    "uuid": "3c6154cf-8dea-5586-b11f-36bdb368626e",
    "entry": "御座敷",
    "reading": {
      "primary": "おざしき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
