          "literary": [
            {
              "text": "きょうはいくらでもこうやって御飯後のお喋りのような話をしていたいがあんまりな目ですからもうオヤメ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうことを云って選挙に勝って、約束が果せなかったら、内閣失格、オヤメになるべし、である。",
              "citation": {
                "source": "インテリの感傷",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "古鈔本中｜元暦校本に朱書で或ウネメノとあるに従って訓んだが、なおオホヤメノ（神）タオヤメノ（文）の訓もあるから、旧訓或は考の訓によって味うことも出来る。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
