      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "涼み台の外に折り畳み椅子が三つ同時に並べられて一同が中庭へ集まる。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓際のステレオのまえにおかれた、数脚の折り畳みイスには、だれも坐っていない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一が、舎監の指し示した折り畳みイスに坐ると、「きてもらったのは、きみの部屋のことだ」　と、きびしい顔つきで慶一の目を見て、寮長がいいわたした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高志はステレオのそばの折り畳みイスに坐って、ワラがソニーのデッキを操作するのを見ていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だれにきいたんだよ」「へっへ、地獄耳」　ワラはプレイ・ボタンを押すと、鉛筆をもってテーブルのまえの折り畳みイスに腰掛けた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いよう、いよう、死刑囚のお帰り」　折り畳みイスに坐った高志が、頭のうしろで両手を組んだまま、慶一を見ていう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゃんといっておいてくれれば、もうちょっと、マシな準備ができたんだけどな」　ヴェランダに出した折り畳みイスに坐り、高志は、手すりの下に走る桟に足を投げだした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "木の折り畳みテーブルには、オレンジジュースの入ったコップがふたつおかれている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮生は、半数は直接ジュウタンに腰をおろし、のこりは、低い部分におりる階段や、上にならべられた折り畳みイスに坐り、ざわめいている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "折り畳みイスと、広岡が音楽室からくすねてきた譜面台がいつもならべられていて、まるで彼らの専用練習場だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "折り畳みイスにおかれた、二巻の三〇分テープの箱を見て、慶一は情けなくなった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "テープの箱を床におき、折り畳みイスに腰をおろしながら、山崎が口を開く。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "着席」　折り畳みイスをひいて、それぞれワラと慶一のまえの席についた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "やめるのをやめれば、それでいいんだってば」　折り畳みイスを押しやり、リポート用紙を手に、高志はいきおいよく立ちあがった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここは、おれたちの場所だ」　折り畳みイスにすわり、深いサンバーストのギブスンＪ-１６０Ｅをかかえ、躰をゆらゆらさせている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくつか、折り畳みイスが壁に立てかけてあるだけだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「日本ですねえ」　ワラがうれしそうにいって、折り畳みイスを山崎にわたし、じぶんは、もういっぽうの手にもっていた、プラスティックの大きなごみ箱を逆さまに伏せ、そこに腰掛けた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "折り畳み式の革船で八人乗りの大きさであった。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忍び衆常用の龕燈提灯、折り畳み式になっている。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューラの荷物と云えば、台所の壁についている折り畳み寝台の下に置かれている白樺の箱の一つだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "某氏ある時、数冊の寄贈書の中から一冊を選び、炬燵かなにかにあたりながら、その書物を覗こうとすると、折り畳みのまま裁断してないものだった。",
              "citation": {
                "source": "ふざけた読書",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この箱には、折り畳みのできるベッドが一つ、ハンモックが一つ、椅子が二つ、テーブルが一つ、それ／″＼、床板にねじで留めて、馬車が揺れても動かないようにしてありました。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "――黒琥珀の袋に入れた長い折り畳み式釣竿のごときものを小脇にかかえ、大きな自動車用の塵除け眼鏡をかけ、真紅の靴下にズックの西班牙靴をはいた異装の人物。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "謝肉祭の支那服　――地中海避寒地の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡単な構造の金属製の折り畳み椅子を、ヨシオは物置のなかに見つけた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、一枚の大きな新聞紙で捕へられてゐるそれを妻の手から受け取つた彼は、この小さな虫を、その大きな紙で幾重にも幾重にも捲き込んで、更にもう一枚新聞紙を費して極く念入りに折り畳み込んだ。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　折り畳み椅子は全部塞がった。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、この文字面を表にして、一番上の水平点線を山折り、順に谷折り山折りして、一番下の水平点線まで蛇腹に折り畳み、細長い短冊にします。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥の方で折り畳み扉が開いており、温室は紛れもなく華やかな色彩に満ちている。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は家に侵入する方法を見つけることだ」　ムーアが玄関窓のガタついている窓枠を、頑丈な折り畳みナイフでこじ開けようとしている間、目指す部屋で会話が行われていた。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとでチャンの固い信条を大いに揺さぶることになるが、折り畳みナイフと、足のつかない拳銃をやると、デンが弱みにつけ込んだ。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            }
          ]
        }
