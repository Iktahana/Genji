          "standard": [
            {
              "text": "最新の音声合成技術は人間らしい話し方を再現できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "携帯電話に搭載された音声合成は日々改善されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音声合成により視覚障害者のための情報アクセスが可能になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "電子回路によって人間の声に近い音を作り、機械にしゃべらせようという音声合成の研究を行っているこのベンチャービジネスのスタッフ二人も、スタンフォード大学を卒業したばかりだという。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "チームのリーダーである渡辺和也には、「コンピュトーカー」というコンピューターによる音声合成システムの開発を行っているカリフォルニア州サンタモニカのベンチャー企業で、ほんの数か月前に偶然会っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
