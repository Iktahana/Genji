        "examples": {
          "standard": [
            {
              "text": "公園でベンチに座っているおやっさんに話しかけてみた",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "朝の散歩をしているおやっさんの杖がいい音がしていた",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "街でしょっちゅう見かけるあのおやっさんは何をしているのだろう",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
