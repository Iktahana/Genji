        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "おやっさんが仕事から帰ってくるとの連絡があった",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "おやっさんのために夕食の準備をしておいた",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "おやっさんはいつも黙って見守ってくれている",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "――さて、春松は、「おやっさん、本当でっか」　といって、まさかとは思いながら、ひょっと権右衛門が破目を外して芸者遊びをするところを見たらどんなに痛快だろうと期待した。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "客は他吉の異様な気配をあやしんで、「おやっさん、どないしてん？",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ほな、おやっさんがそない行けというねやったら、マニラへ行くわ」　おとなしく、言うことをきいた新太郎の言葉が、にわかに耳の奥できこえた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユニコーン　プラムケーキを持ってきてくんな、おやっさん。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
