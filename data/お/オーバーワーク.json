        "examples": {
          "standard": [
            {
              "text": "彼のオーバーワークが原因で、健康を害してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オーバーワークを減らすため、会社は労働時間短縮を導入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医者から「オーバーワークは避けるべき」と指摘された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "さて、国分君は、こうした良心的な自責に追い立てられながら、幾多の生活的な困苦とたたかい、とうとうオーバーワークに倒れなければならなくなった。",
              "citation": {
                "source": "『教室の記録』の編集を終えて",
                "author": "村山俊太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
