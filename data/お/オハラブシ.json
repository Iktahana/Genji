          "literary": [
            {
              "text": "当時は、安来節、おはら節などを唄うと聞く、流しの法界屋の姉さんの仮装したのに過ぎない。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子戸を開けると、チンドン屋のおはら節が聴えて来る。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにもひなびた調子で、おはら節というのが多い。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
