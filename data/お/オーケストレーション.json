          "standard": [
            {
              "text": "作曲家は弦楽四重奏曲をフルオーケストラ用にオーケストレーションし直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "映画音楽のオーケストレーションは専門のアレンジャーが担当することが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼のオーケストレーションは各楽器の特性を最大限に引き出していると評価された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ここで定められた基本方針に沿って、各楽器のパート譜を書いていくオーケストレーションに相当するのが、回路設計だろう。",
              "citation": {
                "source": "パソコン創世記",
