        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試合の終盤、相手の隙を突いて完璧な大外刈りが決まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "練習の成果が出て、得意の大外刈りで一本を取ることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "体格差のある相手にも、大外刈りなら通用するかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "僕は中学の三年生の時に僕の父と相撲をとり、僕の得意の大外刈りを使って見事に僕の父を投げ倒した。",
              "citation": {
                "source": "点鬼簿",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
