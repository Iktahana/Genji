          "literary": [
            {
              "text": "「オギギア」洪水説話は、その最古の伝承なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "希臘の古伝説には、オディスソイスが女神カリプソーの為めに、「オギギア」島に八年間、妖術者キルケの為めに一年間、止められしと云う事見ゆ。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトラスの娘でオギギア島に住む。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
