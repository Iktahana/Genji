        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この能楽堂の御茶子は品格がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "歌舞伎公演で御茶子として舞台に立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "御茶子の衣装は豪華で見ごたえがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "初枝は〆団治の世話で、新世界の寄席へ雇われて、お茶子をした。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたし方なく五十吉は寄席で蝋燭の芯切りをし、椙はお茶子に雇われたが、足手まといはお光だ。",
              "citation": {
                "source": "螢",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "初枝は新世界の寄席へ雇われて、お茶子をした。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "気が付くと、その女は劇場のお茶子であったのである。",
              "citation": {
                "source": "天の配剤",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に、相手の方には、お茶子の取締らしい男まで加わってしまった。",
              "citation": {
                "source": "天の配剤",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "お茶子達の云い分を、信じて居るらしい巡査は、その女を調べて見ることさえしなかった。",
              "citation": {
                "source": "天の配剤",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ位の事ならお茶子サイサイで。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "女給、案内女、仲居、お茶子、芸娼妓もかためて中流に入れようか。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お紙幣のときはこれ見よがしに、青竹を細く削ってひとつに合わせた割箸みたいなものへ挟んで、赤｜前垂のお茶子が高座へ運んで持ってきた。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "心やすくなったお茶子の一人からこれを聞かされたとき、海老団治と今松とは、棘然と顔を見合わせた。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
