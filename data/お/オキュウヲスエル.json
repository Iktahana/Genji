    "definitions": [
      {
        "index": 1,
        "gloss": "to rake over the coals",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
