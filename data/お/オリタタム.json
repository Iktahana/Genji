        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "服をきれいに折りたたんでタンスにしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新聞を折りたたんでカバンに入れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "シーツを折りたたむのを手伝ってください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "手竿は、折りたたむと煙管の長さだけに縮まるところからその名の起きた、煙管尺十本つぎの朱ぬり竹、針糸は、男の肌を知らぬ乙女の生毛を以ってこれに当てると伝えられている程の、凝りに凝った大名釣りなのです。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして将来覚えておくべきことは、実際にご主人をそのように扱うということです』　メアリが手紙を折りたたむ間、礼儀正しく敬意を払って無言だった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「折りたたむと、たいしたことないよ。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭としりをもって、グッとおさえつけると、小さくおりたたむこともできるのです。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、おりたたむことが、できなかったのです。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
