  {
    "uuid": "c9cd8c1f-57e6-54d8-9c39-5cfbd94cd875",
    "entry": "オソレ",
    "reading": {
      "primary": "おそれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
