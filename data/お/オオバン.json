    "definitions": [
      {
        "index": 1,
        "gloss": "coot (Fulica atra)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "池では大鷭が水面を泳いでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大鷭は冬の渡り鳥として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "双眼鏡で大鷭を観察するのは野鳥愛好家の楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それから「オオバン夫人」といふ戯曲の草稿が遺つてゐることも附け加へよう。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、福を轉じて禍とする縁起の惡い聖母を描いた「黒衣聖母」はメリメの「イルのヴイナス」を、それから「或戀愛小説」はメリメの「神父オオバン」を、それから「湖南の扇」はメリメの「コロンバ」を――彼はこの小説を書くために何度も「コロンバ」を讀み返したと僕に言つた事さへあるのだ。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
