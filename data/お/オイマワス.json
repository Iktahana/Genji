    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to chase about",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子どもが庭でニワトリを追い回して、鶏たちが大騒ぎになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "飼い犬が猫を追い回し、庭中を縦横無尽に駆け回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "兄は弟を家中で追い回し、取り上げたゲームを返そうとしなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それはほんとうにバッカスの酒宴で、酒は泉とあふれ、肉は林とうずたかく、その間をパンの群れがニンフの群れを追い回すのである。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちの子供らがあひるを慣らしているのを見て、今まではいっこうにあひるに対する興味がないか、あるいは追い回す以外の可能性を考えなかった近所の子供たちも、とんぼをつかまえて来たりあき鑵にいっぱいいなごを取ってはあひるに食わせることを覚えて来た。",
              "citation": {
                "source": "沓掛より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つに書き方を決めるまで、筆者を追い回す。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、数多い山女魚が棲んでいて、毛鈎の躍るを追い回す。",
              "citation": {
                "source": "わが童心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、だしぬけに、彼女はとびかかって行って、うるさく追い回す。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある婦人達はリストの触った花について論争し、ある婦人達はリストの捨てた葉巻の吸いさしを捜し回り、有閑婦人達の中には、金と境遇の許す限り、町から町へ、国から国へとリストの後を追い回すのさえあったのである。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "えらいチンセイ　まるで大象を、燕の群がおいまわすような恰好だ。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ年をとって来てね、歯はばくばくになる、ねずみのやつをおいまわすよりか、ろばたで香箱つくって、ごろにゃん、ごろにゃん、のどをならしていたくなるさ。",
              "citation": {
                "source": "ブレーメンの町楽隊",
                "author": "DIE BREMER STADTMUSIKANTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の尻を追い廻す、という最下等のいやな言葉が思い浮びましたが、私の場合は、それとちがうのだというような気もして、そんなに天の呵責も感じませんでした。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤が帰って来たようだ」「赤の鈴の音が聞える」そう呟いてまるで小猫の姿が見えでもしたように呼び声を立てゝ追い廻す所作などもあったと言います。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾ら瀬戸の言うのが事実で、今夜来ている芸者はお茶碾きばかりでも、小倉袴を穿いた書生の跡を追い廻す筈がない。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "血に狂った男はまだ鎮まらないで、相手嫌わずに雪の中を追い廻すのですから、町の騒ぎは大変でした。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり自分も自分の幸福を追い廻す考えで、ついに外国を渡っていたのかもしれぬ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "追い廻す人買を突きのけて、一散にそっちへ走り出した。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは私が勝手に呼んだ名であって、原名を何んというのか知らないが、とにかく一人の男が泥絵具と金紙で作った張ぼての蛸を頭から被るのだ、その相棒の男は、大刀を振翳しつつ、これも張ぼての金紙づくりの鎧を着用に及んで張ぼての馬を腰へぶら下げてヤアヤアといいながら蛸を追い廻すのである。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "◎　彼は、自然や小さな動物を愛し、金魚を飼い小鳥をかいし乍ら、庭に犬が入ったり、蟻が出たりすると、狂気のようになって追い廻す性質だ。",
              "citation": {
                "source": "一九二三年夏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランツは、乾草熊手に跨って黒い捲毛をふり立ててその後を追い廻す。",
              "citation": {
                "source": "顔",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人は少年の彼を女中代り、下男代りにこき使い、おまけに二人の炊事女がこれ又自分達の下働きとして追い廻す。",
              "citation": {
                "source": "逝けるマクシム・ゴーリキイ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察と、犬殺しが、僕の跡を躍起になって追い廻す――捕まるはずがあるものか、どこに寝ようと、ほっつこうと、僕はやっぱり屋根裏に住んでいたのだ。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『わたしは彼の後を追おうとしましたが、靴下一つで自分の妻の情夫を追い廻すのは滑稽だろう、と気がつきました。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第二としては、仇っぽい姐さんや、その尻を追い廻す連中が、虫唾の走るほどいやなんだ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "槍を持ったり、刀を持ったり、棒を持ったりして追い廻す人間は、家の中に於ての働きが不自由です。",
              "citation": {
                "source": "大菩薩峠",
                "author": "道庵と鰡八の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二人を武火に掛けて、閨から閨へ追い廻す。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうでなければ、助手たちがわたしのあとを追い廻すということがどうして問題なんでしょう。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　鱸が小魚や蝦を追い廻す様子を、凝っと眺めて居ると、なかなか興味がある。",
              "citation": {
                "source": "河鱸遡上一考",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "天渓君また問ふて曰く、色情の奴隷が異性を追い廻すも亦美的生活なるかと。",
              "citation": {
                "source": "美的生活論とニイチエ",
                "author": "登張竹風",
                "note": "青空文庫"
              }
            },
            {
              "text": "とう／＼狼は戸を喰い破ってお堂の中を四つ這いに這いながら、犬のような牛のような稀有な呻り声を立て、逃げ廻る二人の旅人を追い廻す。",
              "citation": {
                "source": "少年",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下のところ、已むに已まれぬ行きがゝりで侍従の君を追い廻すような羽目になり、へんに懊らされているものだから、一途に心がその方へばかり向いているのであるけれども、前者との縁も決して完全に切れてしまっている訳ではなかった。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "会うたあとではいつでも後悔しなさって、ああ、ああ、自分は仰山の女の中でも人に羨ましがられる器量持ってながら、あんな男に見込まれるやなんて何ちゅう情ない身の上やろ、もうもう止めてしまいたい思いなさるのんですけど、そら不思議と、また二、三日も立つうちに自分の方から跡追い廻すようになってしまう。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいよいよ猛り狂って、ユスタスを追い廻す。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
