[
  {
    "uuid": "59f7f835-552d-568a-a45e-a1accbaf392e",
    "entry": "追い回す",
    "reading": {
      "primary": "おいまわす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
