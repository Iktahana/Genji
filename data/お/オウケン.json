  {
    "uuid": "10b24f5a-7beb-51f3-a37a-608e2fc2c5a4",
    "entry": "応県",
    "reading": {
      "primary": "おうけん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "惠果は支那人にして關内道慶長郡昌應縣の人と傳へらる如何にや。",
              "citation": {
