        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しい責任が彼の肩に覆い被さってくることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "多くの仕事の負担が覆い被さると、誰もが疲弊する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "家族の期待というプレッシャーが彼女に覆い被さっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
