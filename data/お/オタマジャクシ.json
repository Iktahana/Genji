[
  {
    "uuid": "ddf26c65-6c83-55c0-b70f-b8476143b439",
    "entry": "お玉じゃくし",
    "reading": {
      "primary": "おたまじゃくし",
      "alternatives": [
        "オタマジャクシ"
      ],
      "is_heteronym": false
