        "examples": {
          "standard": [
            {
              "text": "新入社員が先輩のお株を奪うほどの企画書を提出し、会議室がどよめいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「あいつに料理でお株を奪われるとは思わなかった」と料理人は苦笑した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ライバルにすっかりお株を奪われてしまい、自分の得意分野を見直すことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "敵のお株を奪うに限ると考えて、やにわに犬のノド笛にかみついたのである。",
              "citation": {
                "source": "花咲ける石",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中のお株を奪うぐらい過敏になっていたのである。",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
