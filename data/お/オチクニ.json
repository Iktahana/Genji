          "literary": [
            {
              "text": "それから、堕国と言うた地名を、今では弟国と言うとあるいはながひめ式の伝えになっている。",
              "citation": {
                "source": "水の女",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其から、堕国と言うた地名を、今では弟国と言ふとあるいはながひめ式の伝へになつてゐる。",
              "citation": {
                "source": "水の女",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれ其地に名づけて、墮國といひしを、今は弟國といふなり。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでその地の名を墮國と言いましたが、今では弟國と言うのです。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
