        "examples": {
          "standard": [
            {
              "text": "新年を気持ちよく迎えるために、居間の畳の表替えを畳店に依頼した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "表替えをしたばかりの畳は、い草の香りが部屋いっぱいに広がって心地よい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長年使って擦り切れた畳も、表替えをすれば新品のような美しさを取り戻す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "けれどもだんだんと自分が畳の表替えをするということをずいぶん考えなければならぬようになってきますと、こんどは畳がもっときれいならよいと思う。",
              "citation": {
                "source": "生活と一枚の宗教",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大層見事な芸当だが、千番に一番間違って、畳へ落ちた日にゃ、表替えでもしなきゃ追っつくまい」「へッ」　八五郎はモリモリと鬢を掻きました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "許嫁の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "げたのはなおもすげれば、たたみばりを買ってきて、たたみのおもてがえまでやりました。",
              "citation": {
                "source": "福沢諭吉",
                "author": "ペンは剣よりも強し",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階の十疊は、疊の表替へをしたばかりで、新しい藺の香が高かつた。",
              "citation": {
                "source": "太政官",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "「疊は新しくない樣だが、近頃表替をしたか、大掃除をしたらしいな」「へエ」「疊と疊の隙間に埃がハミ出して居るぢやないか――おや、爐を切つてあるのか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お登世の戀人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何にか御用で、親分さん」「近頃二階の五疊の疊の表替か、大掃除でもしたのか」「いえ何んにもいたしませんが」　五助はけげんな顏をして居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お登世の戀人",
                "note": "青空文庫"
              }
            },
            {
              "text": "大層見事な藝當だが、千番に一番間違つて、疊へ落ちた日にや、表替でもしなきや追つ付くまい」「へツ」　八五郎はポリポリと鬢を掻きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "許嫁の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、扨、三日の夜、其前、畳表替いたし候に付、納戸のすみ下柱御座候に付、畳すみ夫へあわし、すみ切り候。",
              "citation": {
                "source": "三次実録物語",
                "author": "稲生武太夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
