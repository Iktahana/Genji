        "examples": {
          "standard": [
            {
              "text": "彼女は自分の持っている知識を惜しみ無く後輩に分け与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "惜しみ無く愛情を注いで育てた花が、ようやく綺麗な花を咲かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は成功の秘訣を、質問者に対して惜しみ無く語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "……・柿の葉や実やおしみなくふる・みごもつていそがしい虫でまさに秋風・お彼岸花もをはりのいろのきたない雨・ヱスもわたしも腹をへらして高い空△糸瓜（随筆）△犬と遊ぶ（雑文）　九月廿五日晴、曇、そして雨、私の気分もそんなだつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって字面をおしみなく並べてスラスラ読み流させる傾向であり、描写は立体的でなく叙述的である。",
              "citation": {
                "source": "一連の非プロレタリア的作品",
                "author": "――「亀のチャーリー」「幼き合唱」「樹のない村」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "メイエルホリドの機智とマヤコフスキーの言葉の魔術は、この舞台にもおしみなく発揮された。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この考えは、一人の作家として自力で可能な範囲での努力は益※おしみなくやって見る必要があるという結論を導き出すのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
