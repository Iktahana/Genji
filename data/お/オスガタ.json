          "literary": [
            {
              "text": "それをオスガタといっている。",
              "citation": {
                "source": "春雪の出羽路の三日",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "形は主として丸い中高の、今謂う鏡餅のなりに作るので、或いはまたその名をオスガタとも呼んでいる。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オスガタは御姿、すなわち色々の物の形という意味かと思われる。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "問題はいわゆるオスガタを作る手段よりも、いかにしてそういう色々の物の形を、現わさなければならぬと考えたかの、動機｜如何という点に存在する。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
