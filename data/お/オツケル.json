        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自業自得を、人の責任におっつけるのは、図々しすぎるぜ」船長は、こいつ一つ脂をすっかりしぼりぬいてやろうと考えた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "手近にあったアルコールの数滴を机の上に垂らしてその上に玉虫の口をおっつけると、虫は活溌にその嘴を動かしてアルコールを飲み込んだ。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったい何の目的があって、どこへおっつけるために、死んだ農奴など買いこむのだろう？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "バアクレーさんが記録係で、記録板を鼻の先におっつけるようにして点数をマークしている。",
              "citation": {
                "source": "キャラコさん",
                "author": "鴎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（腹と背中へ焼鏝をおっつける療法）同　　　六・〇〇　食塩水五〇〇｜瓦。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "合乗り乳母車　――仏蘭西縦断の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし君、こんな、ヤッカイなお荷物を、よりによって、ここへおっつけるのは、セッショウだよ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、空とぶ円盤に、人間の足がおっつけるものではありません。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえ飛行機でおっかけたところで、とても、おっつけるものではないでしょう。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "とてもおっつけるものではありません。",
              "citation": {
                "source": "透明怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
