          "literary": [
            {
              "text": "薫はときどき小初の側面へ泳ぎ出る。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは生涯働かなかつたといふことを思ひ出に漂ふ空無の海に紫の海月となつて泳ぎ出るのだ。",
              "citation": {
                "source": "雪",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "義昭は、水馬の心得がないので、満々たる大河へ駒が泳ぎ出ると、「あぶないッ」　思わず叫んだ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、服部良一と銀座へ泳ぎ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
