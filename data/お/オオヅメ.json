        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長い会議もいよいよ大詰めを迎え、最終的な決定が下されようとしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "映画のストーリーは、観客が固唾をのむ大詰めへと突き進んでいく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "契約交渉は大詰めで難航したが、両者が歩み寄ることで合意に至った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「この芝居ももうこれで大詰めだろう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にこの際大詰めとして君を殺してしまう事になると一層、全体として小説的約束を破っていはしまいか――と思うと、僕も鳥渡考え直したくなる……だが、……清水君。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大詰めに君がついてきてくれるなら、僕も大いに助かるのだが。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間もしないうちに、事件は大詰めを迎えるでしょう。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそれは、この事件の大詰めではない。",
              "citation": {
                "source": "死の快走船",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "和卜、八重垣、大詰め、小詰め、天狗抄花車、柳生流にも色々ある。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも開発は大詰めにさしかかり、重要な決断を迫られるところまで進んでいたのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば、大詰めの「鎌倉御所中門廊」の中程から、幕切れに出て来るだけになります。",
              "citation": {
                "source": "芝居に出た名残星月夜",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度こそ、立派に大詰めまで叩き込んでつとめて御覧に入れましょう」　と、雪之丞も、強いたほほえみで答えた。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸城明け渡しの大詰めも近づきつつあったのだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "大詰めにこいつがペストだ、それなぐれ、それ叩け、それぶちのめせって、ひどい目にあわされてしまう。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろお客は大詰めのそのペストのめちゃめちゃにやられちまうところだけを唯一の楽しみにやってくると言ってもいいんだ。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり忌々しいから今夜、大詰めのペスト退治のとこで、座長の野郎、洋行帰りの医学博士になりやがるんだがね。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "お梅は芝居の大詰めを見るやうに、祖母一家の結着に好奇心を寄せてゐたが、比方から樣子を見に行くのは面羞かつた。",
              "citation": {
                "source": "孫だち",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "大序より大詰めまで引きぬき早がわり五段返しをもってお目にかけます。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "小鰭の鮨",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は非常に強い劇的感覚を持っていたので、なにか大きな舞台効果、たとえば悲劇の大詰めなどになると、彼の小さなからだ全体がわなわな震え出すこともよくあった。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからペエジをめくって、大詰めを弾いた。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもしろくもなんともないよ、おまえはおまえ、おれはおれの道を行くことにしよう、おれはもう、いよいよこれが大詰めという瞬間までは、二度と会いたかないんだよ、さようなら、アレクセイ！",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "今わたしはちょうど大詰めの幕のファームソフ（「知恵の悲しみ」の人形）のようでございます。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フフフフフ、これが今晩のお芝居の大詰めってわけかい。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大詰はこちらに案あり）　時節柄大河内で西郷さんか、乃木さんの一代記八千ぐらいにまとめてやればどうやろか。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "これよりは謝肉祭の大詰なる燭火の遊（モツコロ）始まらんとす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この芝居の大詰は模様更えだ。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての人生劇にとっても、困難なのはいずれ大詰の一幕で、歴史への裁断のように見通しはつきにくいのであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "思想界にも文学界にもいろいろのイデオロギイやイズムの目覚ましい興隆と絶えざる変遷があったが、その波に漾いながら独身時代の庸三の青壮年期も、別にぱっとしたこともなくて終りを告げ、二十五年の結婚生活にも大詰が来て、黄昏の色が早くも身辺に迫って来た。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の素振りに何か煮えきらないものがあり、いつも用心深く二道かける彼女の手もあるので、思い切って乗り出す気にもなれなかったが、どうせぼろぼろになりついでに、大詰の一役を買うのもいいと思った。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "静枝は大詰の幕がおりない前に、後を晴代に委せて、体よく逃げたが、残された晴代は二人を捲くのに甚く骨が折れた。",
              "citation": {
                "source": "のらもの",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "それほど算哲の遺骸が気になるのだったら、その発掘は、この事件の大詰が済んでからのことにしようじゃないか」「うん、神経かもしれないが。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此派の小説にては、先づ人を因とし、事を縁として一果を寫し、この果若くは他の事變をも合せて縁として更に一果を寫し、其果若くは他の新事件をも合せて縁として更にまた一果を畫き、終に大詰の大破裂若くは大圓滿に至りて休む。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に折衷之助は逍遙子が旨を承けたる軍配の大詰として、沒主觀（沒實感）見理想（哲學上所見の現出）といふ詩品を立てゝ、鴎外のために傷けられたりと見たるシルレルを辨護せむと試みたり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
