        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "檀家回りをしているおっさんを、村の入り口で見かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "法事の時に、お寺のおっさんに丁寧な説教をしていただいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "厳しい修行を積んだおっさんの言葉には、独特の重みがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
