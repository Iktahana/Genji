        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "けれどあの北尾言い逃れ光司との猫またぎの一戦で、ビガロはそこまでプロモーターの意向にべたべたに合わせてしまう本当に気のいいオッサンであることを満天下にさらし、東京ドームの巨大ドツボにはまってプロレスラーとしての命を絶った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが何度目かの約束を破った時、自ら病んだ体験を、伏し目がちに細い声で語ってくれたオッサンはオッサンなりの純情は、その後のオレの両脇を支えてくれた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩淵達之助、この人は、泣く子もだまるといわれた怖いオッサンで、本郷界隈では、だだッ児の虫封じに、しばしばその名を用いられた。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オッサン、ゲイ・キャバレロを謳っとくれよ！",
              "citation": {
                "source": "人造物語",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "街へ出ても田舎へ行っても、どこにでも行きあうようなオッサンに見えなくちゃ、御用がつとまらないんだよ。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "意外の声をかけられて、オッサン、ギョッとすくんでしまった。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オッサン、ドロボーだろう」「ウーム。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "カストリをのみ、カストリ屋のオッサンを喜ばせてやっていますぜ」「オイ、重吉。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州のオッサン組と本ヨタ組は完全に没交渉であったが、私はどちらからも大事にされて、甚だケッコウな身分であった。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州のオッサン組は年をくっていたが、無邪気でもあり、同時に、低脳でもあったが、ヨタ組は若くて、しかし老成しており、学業は出来ないが、判断は早く、行動はジンソクだった。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オッサン、野球、見ないかね」「野球やったら、メシよりも好ッきやね」「チェスターの大鹿投手、知ってるかい」「スモークピッチャーや。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人物、まだ若い男かというとそうではなく、二等兵で戦争に行って捕虜にもなってきた山田虎二郎という当年三十八のいいオッサンなのである。",
              "citation": {
                "source": "人生案内",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかしらで私のことを「罪の無いオッサン」と言つたふうに輕蔑している事は事實だし、それを隱そうともしないが、敬意もなくさない。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンコーにそっくりのオッサンもいるし、イワシのような娘もいる。",
              "citation": {
                "source": "肝臓先生",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイのバンコックの海軍の軍医少将で、シュミトラさんというオッサンは、何か私が日本の間諜で、タイの気象状況でも知りたがっていると勘違いしたのであろう。",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "亜米利加のオレゴン州ポートランドのオッサンは、いかにもヤンキーらしく、まず貴下の学界における地位を明示せよ。",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、こういう店には、ボーイに、古老の如きオッサンが必ずいて、痒いところへ手の届くようなサービスをして呉れる。",
              "citation": {
                "source": "色町洋食",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹話術のオッサン人形で「アノネニッサン」とやって世辞る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹話術はオッサンだけ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
