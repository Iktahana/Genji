        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "百獣の長と言われるライオンが、草原の真ん中で静かに獲物を狙っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はその研究分野における長として、世界中の学者から尊敬を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "多くの勇者が集う中でも、彼こそが聖騎士たちの長と呼ぶにふさわしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
