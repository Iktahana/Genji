        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "岩盤に刻まれた甌穴は、長年の水流によって形成されたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "甌穴の底には、磨かれた小石が多く堆積していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この渓谷の甌穴は、地質学的に非常に貴重な遺産である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "栗村君は、曾つて詩人｜國府犀東氏をこの浦富に迎へ地質に精しいなにがし大學の教授をも迎へた時のことを私に話し、この附近に多い岩壁と洞窟と島々岩々とを船から指して見せ、ほとんど研究的といつていゝ程の熱心さで、そこの集塊岩には甌穴がある。",
              "citation": {
                "source": "山陰土産",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "附近には直径二、三尺の甌穴が水中に二、三個穿たれているのを見た。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度などは川底に紺屋の藍瓶を伏せたような濃藍色を呈した甌穴の連っている間の縁を、股を没する急流に押されながら渉ったこともあった。",
              "citation": {
                "source": "秋の鬼怒沼",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さて、いよいよ、あなたさまのおうけつぎになった財産をごらんになるときがまいりました。",
              "citation": {
                "source": "忠義者のヨハネス",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
