        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「お嬢様、そんな所へ出かけては危険です。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「何不自由なく育ったお嬢様は、世間知らずなところがある。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「お嬢様、庭に新しい花が咲きました。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
