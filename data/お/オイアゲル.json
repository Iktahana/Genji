        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "後続集団が猛スピードで追い上げてきたが、首位のランナーはそのまま逃げ切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "試合終盤に相手チームが猛烈に追い上げてきて、あっという間に一点差まで詰め寄られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "新興ブランドが老舗を追い上げ、ついに市場シェアで肩を並べるほどになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "われわれが彼らを拒絶することは、彼らを断頭台へまで追い上げることを意味している。",
              "citation": {
                "source": "船医の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワードプロセッサーとして、また純然たるプリンターとしても、スピンライターはキュームの製品を追い上げる実績を残していった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬と小犬は道化役者を楽屋口の柱の上に追い上げると又、広場の真中に来て内証話を初める。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "で君らを船へ追い上げる。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがの猫好きも少々気の毒になって、今度は二階に追い上げる。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
