        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "王父が残した事業を跡継ぎが引き継ぐことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "父親は王父の遺志を大事にしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "昔王父から聞いた話を思い出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "燕王父子、天縦の豪雄に加うるに、張玉、朱能、丘福等の勇烈を以てす。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "方孝孺の門人｜林嘉猷、計をもって燕王父子をして相疑わしめんとす。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "廖※廖銘は孝孺の遺骸を拾いて聚宝門外の山上に葬りしが、二人も亦収められて戮せられ、同じ門人｜林嘉猷は、かつて燕王父子の間に反間の計を為したるもの、此亦戮せられぬ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾王父｜白仙綱浄は嘗て藩学の医風に反抗して論争した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "おのれは漢學者の子にて、わづかに家學を受け、また、王父が蘭學の遺志をつぎて、いさゝか英學を攻めつるのみ、國學とては、さらに師事せしところなく、受けたるところなく、たゞ、おのが好きとて、そこばくの國書を覽わたしつるまでなり。",
              "citation": {
                "source": "ことばのうみのおくがき",
                "author": "大槻文彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかみは、官途も、今のごとくにはあらず、奉承榮達の道も、今よりは、たはやすかりきとおぼゆ、同僚は、時めきて遷れるも多し、おのれに親しく榮轉を勸めたりし人さへも、ひとりふたりにはあらざりき、されど、かゝる事にて心の動く時は、つねに王父の遺誡を瞑目一思しぬ。",
              "citation": {
                "source": "ことばのうみのおくがき",
                "author": "大槻文彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ次ニ取リ出セル物ハ川端歌合一巻　此ノ巻物ハ我ガ王父従五位下図書頭殿ノ自作自筆ニ係ル。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふおうふおう、ふうふう、ふおうふおうというように鳴くの声の後から、また獣の鳴くような声も聞えてきた。",
              "citation": {
                "source": "太虚司法伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "原子力エンジンは、この宇宙艇で地球から月の世界をらくにおうふくさせてくれる。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "斬りつけている方の二人は、顔が半分隠れるほどの大きな色眼鏡をかけているので、人相は判らないが、月に向うその顔はいずれもクッキリと白く、服装も物腰も、ひと口に典雅とでもいおうふう。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "的矢丸船員も手つだって、龍睡丸の伝馬船と、的矢丸の四隻の小船とは、何べんも、島と的矢丸との間をおうふくして、荷物を運んだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関の屋根の上に若侍が一人いて、妙な、こっちがてれるような腰つきで、踊りでも踊るような恰好をしながら、たいへんおうふうな口ぶりでどなっていた。",
              "citation": {
                "source": "思い違い物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂利の上へ蹴落された彼としては、そこはやはり自尊心というものもある関係から、いちおうふてくさったような姿勢をとるわけだろう。",
              "citation": {
                "source": "長屋天一坊",
