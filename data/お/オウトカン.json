          "literary": [
            {
              "text": "理性もなにもなく、たゞ嫌ひな料理を無理矢理に鼻の先へ突つきつけられるやうな嘔吐感を催すのだ。",
              "citation": {
                "source": "父の百ヶ日前後",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そッくり書くと気の弱い読者は嘔吐感を催してねこんでしまうかも知れんが、その先に雑誌が発売禁止になってしまうよ。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際自分は吉右衛門がこの劇を演じた時に、その芸の巧妙を認めつつも、嘔吐感を禁ずることができなかった。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
