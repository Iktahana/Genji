[
  {
    "uuid": "d4033762-ad66-50fc-8bd4-eddaad52baa2",
    "entry": "お節介",
    "reading": {
      "primary": "おせっかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
