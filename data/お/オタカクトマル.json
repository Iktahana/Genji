        "examples": {
          "standard": [
            {
              "text": "クラスの人気者になった途端、彼はお高くとまるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女はお高くとまっているせいで、あまり友人がいない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "有名人になっても、あの人は決して「お高くとまる」ようなことはない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "私はいったい画伯とか先生とかのくっ付いた画かきが大きらいなんだけれども、……いやよ、ほんとうにあいつらは……なんていうと、お高くとまる癖にひとの体にさわってみたがったりして……けれどもお金にはなるわね。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし君子さん女給になったからって、何もそうお高くとまるには及ばないでしょう。",
              "citation": {
                "source": "つゆのあとさき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなると、今度はエリザベスが、お高くとまる番になった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
