    "definitions": [
      {
        "index": 1,
        "gloss": "ho-ho",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "おほほについて知りたいことがあります。",
              "source": "幻辞"
            },
            {
              "text": "あ、おほほがありますね。",
              "source": "幻辞"
            },
            {
              "text": "おほほというのは何ですか？",
              "source": "幻辞"
            },
            {
              "text": "これはおほほの例です。",
              "source": "幻辞"
            },
            {
              "text": "彼女はおほほが好きです。",
              "source": "幻辞"
            },
            {
              "text": "おほほを使ってみます。",
              "source": "幻辞"
            },
            {
              "text": "昨日、おほほの話を聞きました。",
              "source": "幻辞"
            },
            {
              "text": "おほほはどういう意味ですか？",
              "source": "幻辞"
            },
            {
              "text": "このなかにおほほがあります。",
              "source": "幻辞"
            },
            {
              "text": "おほほは日本語で大事な言葉です。",
              "source": "幻辞"
            },
            {
              "text": "毎日おほほについて考えています。",
              "source": "幻辞"
            },
            {
              "text": "先生はおほほの定義を説明しました。",
              "source": "幻辞"
            },
            {
              "text": "おほほの使い方は難しいですね。",
              "source": "幻辞"
            },
            {
              "text": "研究ではおほほが重要な役割を果たします。",
              "source": "幻辞"
            },
            {
              "text": "おほほについてもっと詳しく知りたいです。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化でおほほは大切です。",
              "source": "幻辞"
            },
            {
              "text": "会社でおほほについて相談しました。",
              "source": "幻辞"
            },
            {
              "text": "おほほという概念は興味深いです。",
              "source": "幻辞"
            },
            {
              "text": "本を読むとおほほの説明がありました。",
              "source": "幻辞"
            },
            {
              "text": "おほほを正しく使うことが大事です。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "何のかのと、ろくでも無い料理をうるさくすすめて、くだらないお世辭を交換し、をかしくもないのに、矢鱈におほほと笑ひ、まあ！",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お秀は嘆息ついて、そして淋びしそうな笑を顔に浮かべ、「ほんに左様ですよ、人様のお話の取次をして何番々々と言って居るうちに日が立ちますからねエ」と言って「おほほほほ」と軽く笑う。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女の仕事はどうせ其様なものですわ、」とお富も「おほほほほ」と笑ッた。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "お秀の当惑の色を見て、「気に障えちゃいけないことよ、あの……」「何に、どうにか致しますよ」とお秀は少し顔を赤らめて、「おほほほほ」と笑った。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "のさのさのさ、頭で廊下をすって来て、夫人の枕に近づいて、ト仰いで雨戸の顔を見た、額に二つ金の瞳、真赤な口を横ざまに開けて、「ふァはははは、」「う、うふふ、うふふ、」と傾がって、戸を揺って笑うと、バチャリと柄杓を水に投げて、赤目の嫗は、「おほほほほほ、」と尋常な笑い声。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（しゃがれた笑）おほほほほ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おほほほほ、おかしいねえ、まあ、その芋虫と、蚯蚓とお前さんと。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうもう貴方のようじゃあございませんよ、おほほほ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴下のお姿を見て、それから心持が悪く……」　再び口の裏で繰返して見て、「おほほ、まあ、大概お察し遊ばして下さいましなね。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十四「おほほほ、大層勉強するわねえ、まあ、お待ちよ。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おほほほほほ、強い人だね。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "松の上なが、興がった声をして、「松葉が私を擽るわよ、おほほ、おほほ。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おほほ、や、お尋ねでは恐入るが、あはは、テ、えッ。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おほほほほほ、おほほほ、おほほほほほ。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぷッ、」と噴出すように更に笑った女が、堪らぬといった体に、裾をぱッぱッと、もとの方へ、五歩六歩駈戻って、捻じたように胸を折って、「おほほほほ。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　たちまちくるりとうしろ向きに、何か、もみじの散りかかる小紋の羽織の背筋を見せて、向うむきに、雪の遠山へ、やたらに叩頭をする姿で、うつむいて、「おほほ、あはは、あははははは。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おほほほほ、あははは、あははははは。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "半襟の藍に嫁菜が咲いて、「おほほほほほほ、あはははは、おほほほほほ。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "島田髷も、切れ、はらはらとなって、「堪忍してよう、おほほほほ、あははははは。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その掛稲は、一杯の陽の光と、溢れるばかり雀を吸って、むくむくとして、音のするほど膨れ上って、なお堪えず、おほほほほ、笑声を吸込んで、遣切れなくなって、はち切れた。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "稲穂がゆさゆさと一斉に揺れたと思うと、女の顔がぼっと出て、髪を黒く、唇を紅く、「おほほほほほほほ、あはははははは。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外套を被って、帽子をめして、……見違えて、おほほほほ、失礼な、どうしましょう。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おほほほほほ、堪忍、御免なすって、あははははは。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御免なすって、旦那さん、赤蜻蛉をつかまえようと遊ばした、貴方の、貴方の形が、余り……余り……おほほほほ。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、家ではかえって人目に立つッて、あの、おほほ、心中の相談をしに来た処だものですから、あはははは。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ひたと胸に、顔をうずめて、泣きながら、「おほほほほほほ。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おほほほほ、」　呼吸も絶ゆげな、なえたような美津の背を、屏風の外で抱えた時、お珊は、その花やかな笑を聞かしたのである。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小稲と云うがまず笑いて、「若お師匠様、おめでとう存じます、おほほほほほ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「でもまた奥様がその何ですから、おほほほほ、」と主婦は三角の口を丸うして笑って控える。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おほほほほ、おちんこが、おほほほほ……』　気が狂つて了つたのだ。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
