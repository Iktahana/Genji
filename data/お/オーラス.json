        "examples": {
          "standard": [
            {
              "text": "オーラスに満貫を上がり、最下位から一気にトップに逆転した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "オーラスを迎えた時点でトップとの点差は八千点あり、逆転には条件が必要だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「オーラスだから守りに入らず攻めていこう」と卓を囲む四人に緊張が走った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "金貨を積んで沈んだオーラス丸の所在をたしかめよ……という官憲の命令を受けて……。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴方がお探しになっているオーラス丸の船長夫婦と……一人の女の児と……一人の運転手と……三人の水夫の死骸なのです。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいかい……おいらは三人ともオーラス丸の船長の味方だったのだ」　と別の錆び沈んだ声が云った。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウエスト（人）West.ウォータールー・プレース（地）Waterloo place.ウォーラストン（人）Wollaston. ウイリアム・ハイデ・ウオーラストン。",
              "citation": {
