    "definitions": [
      {
        "index": 1,
        "gloss": "to show contempt for",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "相手の意見を根拠なく貶めるのは不誠実だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は他人の努力を貶めることで、自分の価値を高めようとしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "先生は決して学生を貶めるような言葉を使わない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "すべてごりっぱなものであって、だれも貶める言葉を知らなかった。",
              "citation": {
                "source": "源氏物語",
                "author": "桐壺",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は必らずしもその小説を貶めるつもりではなかつたのに、室生君は自分に考へて見て或はさういふ風に解したのかも知れない。",
              "citation": {
                "source": "忘春詩集",
                "author": "『忘春詩集』に",
                "note": "青空文庫"
              }
            },
            {
              "text": "特にその中の誰々だけを優遇し、誰を貶めるということはしない。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "家門の威徳を末代まで貶めるようなものではないか。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "病者の貧しさが解決されぬうちは根本的な解決はないなどと云つたところで、そしてその通りだとしても、それは何も今日の彼の仕事をおとしめることにはならない。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ご自身をおとしめることになりかねません。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「或鴉おのれが人物を驕慢し、孔雀の羽根を見つけて此処かしこにまとひ、爾余の諸鳥をば大きに卑しめ、わが上はあるまじいと飛び廻れば、諸鳥安からず思ひ、『なんぢはまことの孔雀でもないに、なぜにわれらをおとしめるぞ』と、取りまはいてさんざんに打擲したれば、羽根は抜かれ脚は折られ、なよなよとなつて息が絶えた。",
              "citation": {
                "source": "孔雀",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to cause to fall",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "柔道で相手を見事に貶めて、試合に勝った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "力士は大きな身体で相手を貶めることで勝利を得る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "相撲の取り組みで相手を貶める技を習った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
