        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "次にヒコイマスの王が山代のエナツ姫、またの名はカリハタトベと結婚して生んだ子はオホマタの王とヲマタの王とシブミの宿禰の王とお三方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄のオホマタの王の子はアケタツの王・ウナガミの王の二人です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またサカタノオホマタの女のクロ姫と結婚してお生みになつた御子は、カムザキの郎女・ウマラタの郎女・シラサカノイクメコの郎女、ヲノの郎女またの名はナガメ姫のお四方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また春日のナカツワクゴの王の女のオミナコの郎女と結婚してお生みになつた御子はナニハの王・クハタの王・カスガの王・オホマタの王のお四方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またアヤの王の妹のオホマタの王と結婚してお生みになつた御子は、チヌの王、クハタの女王お二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
