          "standard": [
            {
              "text": "その音楽評論家は新しい才能を発掘することで知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音楽評論家の批評は時に演奏家に大きな影響を与える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "有名な音楽評論家がこのコンサートについて高く評価した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "蓄音機友達　同じ音楽評論家で、私の本名と一字違いのため、しばしば間違われる野村光一氏から長距離電話がかかって来たことがある。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "地味な音楽評論家がラジオに出て、レコードをかけながら喋ってる、という設定さ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
