  {
    "uuid": "21be16a9-ba37-598e-a5bb-0e7bca9be763",
    "entry": "オッタ",
    "reading": {
      "primary": "おった",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オラア、オッタマゲタ。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人の間に立つその男は、クララの許婚のオッタヴィアナ・フォルテブラッチョだった。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦の街を幾度もくぐったらしい、日に焼けて男性的なオッタヴィアナの顔は、飽く事なき功名心と、強い意志と、生一本な気象とで、固い輪郭を描いていた。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "脅かすような父の顔も、歎くような母の顔も、怨むようなオッタヴィアナの顔も見る見る変って、眼に逼る難儀を救ってくれと、恥も忘れて叫ばんばかりにゆがめた口を開いている。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はフォルテブラッチョ家の座席からオッタヴィアナが送る視線をすぐに左の頬に感じたけれども、もうそんな事に頓着はしていなかった。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラダガナオッタラ、＊＊＊＊＊＊＊＊＊ニナッテ、＊ヲ＊＊テアルキタイナアッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルダウ（モルタ）川の水源この國にあり、この川エルべ（アルビ）と合し北流して海に注ぐ一〇〇―一〇二【オッタケッルロ】オットカール。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレカラ思イツイテ、心易イ者ヘ高利ヲカシタガヨカッタ、浅草ノ奥山ノ茶屋ヘ金ヲカシタガ、是ハマダルカッタガ、ソノ代り山中ハハイハイトイイオッタ故親分ノヨウダッケ」　　　　　　　　　七十　さて、これから名うての剣客島田虎之助をからかった物語だ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "オッタワで、ボストン行の飛行機を待っているうちに、隣にいた老夫人が、見送りに来たらしい人に話をしていた「昨日、アイスランドから飛んで来たのですが、グリーンランドの上で、丁度日が落ちましてね。",
              "citation": {
                "source": "老齢学",
                "author": "――長生きをする学問の存在――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間相談の会を、今年の夏、カナダのオッタワで開いた。",
              "citation": {
                "source": "雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで今度の私の渡米を機会に、この試案を片づけてしまおうということになり、八月十六日に、オッタワの加奈陀国立研究所で、四人の会議をすることになった。",
              "citation": {
                "source": "国際雪氷委員会のことなど",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
