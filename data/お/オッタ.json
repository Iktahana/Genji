[
  {
    "uuid": "5a02fb2a-6772-5aec-bea6-5c874744ccd1",
    "entry": "落った",
    "reading": {
      "primary": "おった",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
