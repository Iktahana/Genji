        "examples": {
          "standard": [
            {
              "text": "うちの弟は本当に怒りん坊で、すぐに顔を真っ赤にする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "怒りん坊なのは父親譲りだと、母はいつも苦笑いしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "怒りん坊な性格を自覚して、最近は深呼吸を心がけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "」「こんな怒りん坊は、誰だつて、見たことがありません。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分に都合のいいときだけ甘たれて、何でもして貰ってすこし気に入らないことを云われると、かげで怒りん坊だのというのは卑怯だ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたが怒りんぼうのくせに、じき優しくなるのも、そんな思考の曲折や、性格の変化があなたにあるからですな。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「目マルの怒りんぼう。",
              "citation": {
                "source": "創作生活にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
