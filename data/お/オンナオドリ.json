          "literary": [
            {
              "text": "上方の芝居は、出雲で芸道化したお国の念仏巫女踊りに、幸若の形や、身ぶりを加へたものである。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡嘉敷君は特に女踊りの達人であるが、年輩からして、老人踊りを踊つても如何にも優雅な味を示すやうになつて来た。",
              "citation": {
                "source": "同胞沖縄の芸能の為に",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "女踊りにしても、女性の参加にたよることなく発達して来ただけに、その良さも、すべて男性的な点にある。",
              "citation": {
                "source": "同胞沖縄の芸能の為に",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
