[
  {
    "uuid": "18ad4d14-e559-5110-a7ab-a4efa9ac91e0",
    "entry": "お家",
    "reading": {
      "primary": "おうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
