  {
    "uuid": "72f0fc71-3b09-54c4-a352-7b1224cca043",
    "entry": "楝",
    "reading": {
      "primary": "おうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "chinaberry",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "裏山の雑木林に楝の木がたくさん生えています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "楝は秋になると実が落ちてきます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この古い写真には楝の木が写っています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "はたと、これに空想の前途を遮られて、驚いて心付くと、赤楝蛇のあとを過ぎて、機を織る婦人の小家も通り越していたのであった。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤楝蛇が、菜種の中を輝いて通ったのである。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲角の青大将と、この傍なる菜の花の中の赤楝蛇と、向うの馬の面とへ線を引くと、細長い三角形の只中へ、封じ籠められた形になる。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が草深い雑木の根を、縦に貫く一列は、殿の尾の、ずんぐり、ぶつりとした大赤楝蛇が畝るようで、あのヘルメットが鎌首によく似ている。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ほほゑみ頬に、浮あゆみ楝、柏の薄ら花ほのにちる日の君ならばそぞろ袂もかざすらむ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "九　楝の花　一夏、脳が悪くて田舎の親類のやっかいになって一月ぐらい遊んでいた。",
              "citation": {
                "source": "花物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "古風な屋根門のすぐわきに大きな楝の木が茂った枝を広げて、日盛りの道に涼しい陰をこしらえていた。",
              "citation": {
                "source": "花物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "きれいに掃いた道に青竹の削りくずや鉋くずが散らばって楝の花がこぼれている。",
              "citation": {
                "source": "花物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "桶をたたく音は向こうの丘に反響して楝の花がほろほろこぼれる。",
              "citation": {
                "source": "花物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほかには椿、鼠冬青木、とべらなどの常盤木が混り、落葉樹には櫨、楢、楝、其他名を知らぬ幾多の雜木がある。",
              "citation": {
                "source": "庭さきの森の春",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう少したてば楝の花のむらさきが見られるが、まだ早い。",
              "citation": {
                "source": "庭さきの森の春",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他冬｜青木、椿、楢、櫨、楝、椋、とべら、胡頽子、臭木等多く、※などの思ひがけないものも立ち混つてゐる。",
              "citation": {
                "source": "沼津千本松原",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "次は第二、「楝軒詩集」である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは楝軒詩集に拠つて此の如くに断ずる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "楝軒は浅川氏、名は勝周、字は士※、通称は登治右衛門、茶山の集に累見せる「浅川」である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "楝軒詩集は五巻ある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "其明証は楝軒詩集にある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅川楝軒は初め霞亭が召されて東に之く時、上に引いた七律を作つて其行を送つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて霞亭が再び備後を発するに当つて、楝軒は詩二篇を賦した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "楝軒の詩題に「五日木犀舎席上別霞亭先生」と云ふのは、何月五日であらうか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼楝軒が霞亭に寄せた「秋気満庭虫乱鳴」の詩は、七月朔より五日に至る間に成つて発送せられたものでなくてはならない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "○妹が見し楝の花は散りぬべし我が泣く涙いまだ干なくに　〔巻五・七九八〕　山上憶良　前の歌の続で、憶良が旅人の心に同化して旅人の妻を悼んだものである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "楝は即ち栴檀で、初夏のころ薄紫の花が咲く。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一首の意は、妻の死を悲しんで、わが涙の未だ乾かぬうちに、妻が生前喜んで見た庭前の楝の花も散ることであろう、というので、逝く歳月の迅きを歎じ、亡妻をおもう情の切なことを懐うのである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この楝の花は、太宰府の家にある楝であろう。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来「おうち」とは今日云う「せんだん」の古名でその支那名すなわち漢名は楝である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の「センダンは双葉より香ばし」と唱うる「せんだん」はすなわち栴檀でそれは楝の「せんだん」ではない。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "初夏の日かげは真直に門内なる栗や楝の梢に照渡っているので、垣外の路に横たわる若葉の影もまだ短く縮んでいて、※の声のみ勇ましくあちこちに聞える真昼時。",
              "citation": {
                "source": "つゆのあとさき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　竹渓は文政九年の春も暮れて楝の花の咲きかけた頃病に臥した。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私が挨拶しましたらその人は少しきまり悪そうに笑って、「なあに、おうちの生徒さんぐらい大きな方ならあぶないこともないのですが一寸来てみたところです。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
