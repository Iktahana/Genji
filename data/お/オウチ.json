  {
    "uuid": "c9e7c7cb-85b3-5744-ae5d-548479df1852",
    "entry": "オウチ",
    "reading": {
      "primary": "おうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミチコサンハ、マダ　アカチヤンヲ　ダツコシテルヤウナ　テツキヲ　シテ　オウチヘ　カヘツテ　キマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木繁君説に、山神、海神と各その持ち物の多きに誇る時、山神たちまち（オウチ？",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "四ヒゲナシ　ニナツテオウチ　ヘカヘツテ　来タラオ母サン　ハオドロイテ山羊サン　ヲ叱ツタ　ケド山羊サン　ハ平気ナ　顔ヨ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいしいでしょう」「オレのウチの桃はもッとうめえ」「オウチはどこ？",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "サァ　コレカラドウシテ　オウチヘ　カヘロウカト、ミンナハ　シクシク　ナキダシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オウチカラ　　　バシヤガ　オムカヘニキテヰマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　オバシヤニノッテ、オウチヘ　カヘッテ　キマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "稈はすなわち竹竿にしてあるいは根茎の節より生ずるあり（例、ハチク、マダケ等）、あるいは根茎の末端直ちにこれを成すあり（例、ネマガリダケ、ホウオウチク等）、以て高く気中に挺出す。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この竹の一品にホウオウチクあり。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦楝は本名オウチ、すなわち古書に誤って樗の字を宛てている木のことで、一種その樹実の味苦いものが、薬用として知られているところからこう書くが、正しくは漢語に楝とあるものに該当する。",
              "citation": {
                "source": "アテヌキという地名",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の知っている限りでは、汽車で通ってみてこの県の山武・匝瑳二郡ほど、オウチの樹をたくさんに見る処は他にはない。",
              "citation": {
                "source": "アテヌキという地名",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この楝すなわちオウチをアテの木ということは、大槻・松井二翁の辞書にも見えないが、京都でもかつてはそういった例があるのである。",
              "citation": {
                "source": "アテヌキという地名",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近に三ヶ尻浩君の複製した文明十六年の『温故知新書』にもちゃんとそう見えているのみならず、また『本草類篇』にもオウチ一名アテノキとあり、『山州名跡志』に引用した『八幡宮鎮座伝記』にもそうあるというから、香取郡に同じ名があっても少しも不思議でない。",
              "citation": {
                "source": "アテヌキという地名",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりも我々にとって重要なのは、このオウチの木が特に千葉県の一部において、地名となって伝わる程度に人の生活と交渉があったということである。",
              "citation": {
                "source": "アテヌキという地名",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹名は非常にその木が珍しいか、または巨大であるならば、単なる存在だけからでも地名に採用せられ得る場合はあるが、オウチの木はその現状から推して考えると、どうもそればかりの理由ではなかったようである。",
              "citation": {
                "source": "アテヌキという地名",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしてそういうことを思いついたかは忘れたが、フクチ　オウチの『幕府衰亡論』、キムラ　カイシュウの『三十年史』、タナベ　レンシュウの『幕末外交談』、その他、旧幕臣たちの著書を読んでいたので、それに誘われたところがあったのであろうか。",
              "citation": {
                "source": "学究生活五十年",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
