          "literary": [
            {
              "text": "オイチニ、オイチニ！",
              "citation": {
                "source": "吾家の随筆",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイチニの薬売りになつて手風琴をならして歩いた。",
              "citation": {
                "source": "反逆の呂律",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵役にしろ、大切な働きてを一年も二年もとりっぱなしで、オイチニ！",
              "citation": {
                "source": "「我らの誌上相談」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かが頭をおさえつけているようで、私はまだまだへこたれるものかと口につぶやきながら、当もなく軒をひらって歩いていると、バスケット姿が、オイチニイの薬屋よりもはかなく思えた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "肋骨のように、胸に黄色い筋のついた憲兵の服を着た父が、風琴を鳴らしながら「オイチニイ、オイチニイ」と坂になった町の方へ上って行った。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええ――子宮、血の道には、このオイチニイの薬ほど効くものはござりませぬ」　私は材木の上に群れた子供達を押しのけると、風琴を引き寄せて肩に掛けた。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　父は風琴と弁当を持って、一日中、「オイチニイ　オイチニイ」と、町を流して薬を売って歩いた。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「漁師町に行ってみい、オイチニイの薬が来たいうて、皆出て来るけに」「風体が珍しかけにな」　長いこと晴れた日が続いた。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校に馴れると、子供達は、寄ってたかって私の事を「オイチニイの新馬鹿大将の娘じゃ」と、云った。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かゞ頭をおさえているようで、私はまだまだ、と口につぶやきながら、当もなく軒をひらって歩いていると、バスケット姿が、オイチニイの薬屋よりもはかなく思えた。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイチニ、オイチニ……と調子をとってまっすぐに歩いていきます。",
              "citation": {
                "source": "風ばか",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
