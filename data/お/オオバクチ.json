        "examples": {
          "standard": [
            {
              "text": "会社を立て直すために、彼は新事業への進出という大博打に出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "貯金のほとんどを投資につぎ込むなんて、まさに人生を賭けた大博打だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その大博打に勝てば、一気に経営陣の仲間入りができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "落合の藪の中でさ、大博打ができたんだよ。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "大国衆民、富国強兵を目標に、軍国主義、侵略主義一点張りで進んで来た我が日本は、大博打の戦争を始めて一敗地にまみれ、明九月二日には、米国、英国、ソヴエット聯邦、中華民国等々の聯合国に対し無条件降伏の条約を結ばうとしてゐる。",
              "citation": {
                "source": "小国寡民",
                "author": "河上肇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
