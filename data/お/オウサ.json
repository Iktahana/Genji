[
  {
    "uuid": "dbc75ca5-10d9-5584-a30c-1cac2e76e7db",
    "entry": "往査",
    "reading": {
      "primary": "おうさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "site visit (auditors, public accountants, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "税務署の往査が決定し、準備に追われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "監査法人は、企業の財務状況を確認するため、定期的に往査を行う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は初めての往査で、緊張しながらも熱心に資料をチェックした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ねのこくに、たち、みのこくに、おうさかに、つき○同五日。",
              "citation": {
                "source": "盲人独笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おうさむこさむやまからこぞうがないてきたなーんとてないてきたさむいとてないてきた。",
              "citation": {
                "source": "お山の爺さん",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日の朝、皆で、「おうさむこさむ……」や「きいのこきのこ……」などを歌いながら、その林にやって来ますと、一面にきのこがはえていました。",
              "citation": {
                "source": "お山の爺さん",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿楽に神聖せられて来た「翁」の、由来不明な「おうさい／＼」の句も、唯の囃し詞ではなく、「ほさき／＼」と言ふ風な畳語で、呪文の附属文句から変化したのではないかとも考へられる。",
              "citation": {
                "source": "「ほ」・「うら」から「ほがひ」へ",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おうさ、当るだきゃあ当って見やしょう。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "お茶漬音頭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おうさ、死骸の傍に。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "梅雨に咲く花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものすごい　こわい　じょおうさまで、　だれかに　はらを　たてると　きまって　そういうんだ。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "わらわは　ちいさな　じょおうさま　スイレンたちよ　よきに　はからえ。",
              "citation": {
                "source": "ねっこうまれのこびとたち",
                "author": "ETWAS VON DEN WURZELKINDERN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おうさま、おうさま」おしのは唇と唇の間で喘いだ、「――ね、ね、お願いよ」　折之助は女の手が、自分の帯の結び目にかかるのを感じた。",
              "citation": {
                "source": "雪と泥",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご足労だが、高安の六波羅番屋まで来てもらおうか」「番屋へ」「おうさ」「なにしに」「胸にききねえ」「迷惑千万。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おうさ」と、吐雲斎は相手のことばも奪いとって「なぜ、もそッと早く、これへ見えなかったか。",
              "citation": {
                "source": "私本太平記",
                "author": "新田帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
