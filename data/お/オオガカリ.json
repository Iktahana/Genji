    "definitions": [
      {
        "index": 1,
        "gloss": "large-scale",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今年の文化祭は大掛かりな企画で、準備期間も長かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その建設プロジェクトは大掛かりな工事を伴い、近隣住民に影響を及ぼした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大掛かりなシステム導入には、スタッフの研修が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ピアノトリオ位で非常に優れた室内音楽でも附属しているのは決して悪いものではないとしても、併し「演出効果」なぞと云う大掛かりな仕掛けは実際邪魔になり過ぎる場合がある。",
              "citation": {
                "source": "牛込館",
                "author": "映画館めぐり（十）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その結果第二に、これを日本で成功させようとすれば大掛かりな日本語化作業が必要となる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大掛かりな行列が、其所の坂の下まで来てゐると云ふので、台所の女たちは、恐しさに立ちすくむ者もあつた。",
              "citation": {
                "source": "菜の花月夜",
                "author": "片岡鉄兵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが後期に及んでいかに大掛かりな舞台建造物を持つようになったかも知っていた。",
              "citation": {
                "source": "エトナ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こんな大掛かりの浮き岩を人工で作ったというのは、決して冗談や好奇心からではあるまい。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは諸国を巡って歩く、大掛かりの香具師の群れであった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それも大掛かりの巣窟が」「面白い出来事にぶつかりそうだよ、さあ中へはいってみよう」　そこで三人は岩壁に添って、左側の方へ行ってみた。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには大掛かりな陥没の痕が明らかに残っていた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "老練な私掠船員による大掛かりな襲撃隊を編成し、ポートゥックスト農場においてカーウィンに奇襲をしかけるべきだ。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハートが見つけた所によると、アマサ・フィールドの区画にある通路からかなり離れた所に大掛かりな穴が掘ってあり、一味は発見前に相当長時間作業をしていたに相違ない。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢に見たものからの大掛かりな変更に気づいたのは僅かに二度のみで――その内の一度は、記憶にあるアーチ型入口を塞いだ輪郭を辿ることができた。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在意図されている南極への侵入――大規模な化石狩りと大掛かりなボーリング及び太古の万年氷雪の融解とを伴う計画に反対する理由を述べることは、全く以て私の意に反するのだ。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "必要なら更なる移動のため備品を他の三機に移送するが、目下のところ大掛かりな飛行の要なし。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅行は極めて頻繁だったが、永住のための移動は種族が拡大する際の大掛かりな植民運動を例外として比較的稀だった。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドレントン・デンですら、仲間にそっと加わるまで、そんなに大掛かりだとは知らなかった。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "賭け金詐欺でやす、大掛かりで巧妙な仕掛けで、ずっと競馬場でやられていやす。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "人を殺すもよし、ものを盗むもよし、ただ少しおおがかりな犯罪ほどよいのですよ。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、硫酸タンクなんておおがかりな設備をすれば、いずれは見つかるにきまっています。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "津浪の恐れのあるのは三陸沿岸だけとは限らない、寛永安政の場合のように、太平洋沿岸の各地を襲うような大がかりなものが、いつかはまた繰返されるであろう。",
              "citation": {
                "source": "津浪と人間",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ずいぶん大がかりな機械ぢやないか。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れて百二十日目に大がかりな誕生祝ひをした。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度こそ、すこし、それを大がかりに形式に現して気持を新にするつもりでゐたものを、これではまるで、他人に自分を葬らせる機会を作つてやつたやうなもので、今更、取返しのつかぬ失敗のやうに思はれた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八　ベンガルの槍騎兵　変わった熱帯の背景とおおぜいの騎兵を使った大がかりな映画である。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この予期しなかった出来事は、見方によっては、東京市民一般に関するいろいろな根本問題を研究するために必要あるいは有益な資料を提供する一つの大がかりなエキスペリメントであったとも見られなくはない。",
              "citation": {
                "source": "破片",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も私がその婦にすれ違った、昨の日は、名古屋から伊豆まわりの、大がかりな呉服屋が、自動車三台で乗込んで、年に一度の取引、湯の町の女たち、この宿の番頭手代、大勢の女房娘｜連が、挙って階下の広間へ集りましたから、ふとその中の一人かも知れない、……という事で、それは……ありそうな事でした。",
              "citation": {
                "source": "菊あわせ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "左大臣の子息たちも、平生の楽器のほかの大篳篥、尺八などの、大きいものから太い声をたてる物も混ぜて、大がかりの合奏の稽古をしていた。",
              "citation": {
                "source": "源氏物語",
                "author": "末摘花",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜通しかかったほどの大がかりな儀式であったが、終局は煙にすべく遺骸を広い野に置いて来るだけの寂しいことになって皆早暁に帰って行った。",
              "citation": {
                "source": "源氏物語",
                "author": "葵",
                "note": "青空文庫"
              }
            },
            {
              "text": "須磨、明石で立てた願を神へ果たすためであって、非常な大がかりな旅になった。",
              "citation": {
                "source": "源氏物語",
                "author": "澪標",
                "note": "青空文庫"
              }
            },
            {
              "text": "内大臣は宮廷へはいる大がかりな仕度を、自家のことでなく源氏の姫君のこととして噂に聞くのを、非常に物足らず寂しく思っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "梅が枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大楽というほどの大がかりなものでなく、感じのよいほどの奏楽の前で御所の侍童たちが舞った。",
              "citation": {
                "source": "源氏物語",
                "author": "藤のうら葉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
