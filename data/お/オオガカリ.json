[
  {
    "uuid": "c9b0c016-d3af-5fde-9458-12527c3851a2",
    "entry": "大掛かり",
    "reading": {
      "primary": "おおがかり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
