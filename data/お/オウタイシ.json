        "examples": {
          "standard": [
            {
              "text": "国王の病状が悪化したため、王太子が摂政として国務を代行することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "外交訪問のため来日した王太子は、首相と会談し両国の経済関係を強化することで合意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "王太子の婚約発表に際し、国民は街頭に繰り出してその慶事を祝った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "子路は至って勇ありしと聞くが周王太子などいずれ柔弱な人なるべきに叱られて服した虎はよほど弱腰の生れだったと見える。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、死刑執行人殿の王太子、寡婦の司令塔（徒刑囚達がギロチンに、恐怖の詩に溢れたこの名前をつけた）」彼は警視庁課長の方を振り返って、こう付け加えた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、嫡子｜劉禅の王太子たるべき旨も宣せられた。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
