        "examples": {
          "standard": [
            {
              "text": "大名の落とし胤として育てられた男。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "落とし胤の身分は社会的に不利だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の父親は有名な武将で、落とし胤として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そこの、あんまり名も知れない抱え芸妓のひとりが、どうしたことか桂公のおとしだねだということが知れた。",
              "citation": {
                "source": "一世お鯉",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、愛媛県令｜関氏のおとしだねで、十六歳の女中の子に生れた。",
              "citation": {
                "source": "江木欣々女史",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
