        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "図書館では視覚障害者のために、ボランティアが書籍を音訳するサービスを行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は毎週末、新聞記事を音訳してテープに録音する活動を十年以上続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "音訳された教科書のおかげで、視覚障害のある学生も授業に支障なく参加できた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
