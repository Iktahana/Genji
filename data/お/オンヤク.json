    "definitions": [
      {
        "index": 1,
        "gloss": "transliteration",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「コーヒー」は英語のcoffeeを音訳した外来語だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "外国の地名を音訳する際、原語の発音にできるだけ近づけるよう工夫した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "アラビア語の文章を音訳してローマ字表記にした資料が参加者に配布された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "仏教にあっては、私たちの内部に「菩提（梵語 〔Bodhi〕 の漢音訳で「覚り」の義）心」が蠢めくときがそれであるといたします。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "難経は生憎「三焦」の一節が出て、何と訳して好いかとまごついたが、これは chiao と音訳して済ませた。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀之内さんのページからたどって、ＢＢＡのサイトを開くと、「弱視者を含めた視覚障碍者全般の読書を支援するために点訳・音訳・拡大訳の３分野の活動を全て統合的に推進しています。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここから、点訳、音訳、拡大訳の三つの道筋を付けていく。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つ目の音訳は、文章を音声データに変換することをいう。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "朗読が、読み手の表現としての性格をもつのに対し、音訳では、読み手の解釈や感情表現は、排除することが求められる。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "全盲に対する読書支援は、点訳や音訳によって、充分からはほど遠いものの行われてきた。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな文字による拡大写本作りは、もっぱら手書きに頼ってきたのが実状で、ボランティアの数も、点訳や音訳に比べれば、はるかに少なかった。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "これにそっておけば、青空文庫のテキストを、ＢＢＡが想定している、点訳、音訳、拡大訳の三つの流れにのせて、視覚障碍者の読書支援に活用してもらえるのではないかという期待もあった。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴眼者がパソコンなどの画面で読むテキスト・データを、そのまま点訳、音訳、拡大訳に利用していくというＢＢＡの構想のかなりは、今や常識的なものとなっている。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ植学啓源などと云う本の行われた時代の字書だから、音訳に漢字が当て嵌めてある。",
              "citation": {
                "source": "サフラン",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのクムヒルの原語クムビラの音訳が薬師の十二神将の宮毘羅、仏の大弟子の金毘羅比丘、讃岐に鎮座して賽銭を多く占る金毘羅大権現等で、仏典には多く蛟竜と訳し居る。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮓答は胡語ジャダーの音訳で、今日もアルタイ地方に鮓答師てふ術士あり。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『松屋筆記』に引ける『蓬※日録』に、〈およそ兵事を達するには、急に能く風雨を致し、囲を突きて走り、けだし赭丹を有って身に随く、赭丹は馬腹中に産するところの物、これを用いて念呪すなわち風雨を致す〉と載せた赭丹も、蒙古名シャダーの音訳だ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "文中人名に漢字を当てたは予の手製でなく実に符秦の朝に支那に入ったカシュミル国の僧伽跋澄の音訳に係る。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って音訳に虫の字を副えて那倶羅虫としたのだ。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬱単越（梵語ウッタラクルの音訳）は天下勝の義でまた勝処また勝生と訳し、アイテルの『梵漢語彙』には高上と訳しある。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲のタイトルは原題の音訳を原則とし、邦題についてはほとんど配慮していない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、邦題が音訳であっても、その表記を採用しているとはかぎらない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "好い加減に頁を繰つて見れば、牧色、加夫単、沽未士なぞと云ふ、西洋語の音訳が出て来るのも、僕にはやはり物珍しい。",
              "citation": {
                "source": "点心",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それならオリーブをどうして斉樹は元来が音訳字であって、それは波斯国でのオリーブの土言ゼイツン（Zeitun）に基いたものに外ならないのである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち斉※樹はオリーブの音訳漢名なのである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とならばこれは疑いもなく音訳字で、それは丁度イギリスを英吉利と書くようなもので単にその発音を表わした字に過ぎないのである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち葡萄、蒲桃と共にかの張騫が始めてその種子を得た大宛、すなわち、北爾肯州の土言 Budaw（ペルシャ語では Budawa）の音訳字で、それが始めは蒲桃であったが後ち葡萄に変ったのである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそのカイの語を漢字を以て音訳するに当って、文字もあろうに「蝦夷」すなわちカエルの夷を以てしたことは、彼らが蟆人すなわちククトとして呼ばれていた為であったかもしれぬ。",
              "citation": {
                "source": "くぐつ名義考",
                "author": "古代社会組織の研究",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにそのクマを魏志に狗奴国と音訳したので、確かに魏志を参照した筈の日本紀の編者は、本来クマ人の同類である筈の隼人が、吠ゆる犬に代りて宮墻を守るという事から、これを狗人と書いたと考えるのである。",
              "citation": {
                "source": "くぐつ名義考",
                "author": "古代社会組織の研究",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はクシ・コシ・クイ皆同語で、「蝦夷」というも、もとはまた「カイ」の音訳であるべきことを承認し、蝦夷名義考と題して、歴史地理（三十一巻二号及び四号）でこれを論じておいた。",
              "citation": {
                "source": "国栖の名義",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡部氏の研究によると、抜頭舞はベーダの神話にあるペドュ（Pedu）王蛇退治の物語を材料としたもので、抜頭はペドュの音訳であるか、あるいは王がアスヴィンの神からもらった名高い殺蛇の白馬（馬はパイドュ Paidu）の音訳であろうとのことである。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その音訳だと思います、正式の梵語では「ルンビニー」という地方で今にその古趾が残っております。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
