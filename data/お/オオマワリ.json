    "definitions": [
      {
        "index": 1,
        "gloss": "wide turn",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大型トラックが交差点を大回りで曲がっていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "コーナーを大回りで曲がると、スピードが維持しやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "車を大回りで入れないと、駐車場に入らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "そして大回りに芝生の隅を回つて、もとの藤棚の下に来て密かに胸を抱き絞めてゐた。",
              "citation": {
                "source": "まぼろし",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから後は、私どもが裏のお宮への道に通じる上坂に出るのには、表通りから大回りするのでなければ、その鈴木の邸内を通らせてもらうよりほかなくなったわけである。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だがおまえがチェルマーシニャ行きをすすめるところをみると、モスクワは遠くてチェルマーシニャは近いから旅費が惜しいとでも言うのか、それとも僕がむだな大回りをするのが気の毒だとでも言うのかい？",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、その日、みんなが出かけてしまった頃を見計らった女は、スキーで大回りしてこっそり窓の下まで滑ってきた。",
              "citation": {
                "source": "浴槽",
                "author": "大坪砂男",
                "note": "青空文庫"
              }
            },
            {
              "text": "はあ……」　と独で頷いて、大廻りに卓子の端を廻って、どたりと、腹這いになるまでに、拡げた新聞の上へ乗懸って、「何を話していたのだい。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、夫人は、谷屋の手代というのを、隣室のその十畳へ通したらしい、何か話声がしている内、「早瀬さん――」　主税は、夫人が此室を出て、大廻りに行った通りに、声も大廻りに遠い処に聞き取って、静にその跡を辿りつつ返事が遅いと、「早瀬さん、」　と近くまた呼ぶ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の書斎を抜けるとまた北向きの縁で、その突当りに、便所があるのだが、夫人が寝たから、大廻りに玄関へ出て、鞠子の婢の寝た裙を通って、板戸を開けて、台所の片隅の扉から出て、小用を達して、手を洗って、手拭を持つと、夫人が湯で使ったのを掛けたらしい、冷く手に触って、ほんのり白粉の香がする。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ぐに、嬉々と廊下から大廻りに、ちょうど自分の席の窓の外。",
              "citation": {
                "source": "朱日記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "沼津、三島へ出ますにも、ここはぐっと大廻りになります。",
              "citation": {
                "source": "半島一奇抄",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく同じ処に影を練って、浮いつ沈みつしていたが、やがて、すいすい、横泳ぎで、しかし用心深そうな態度で、蘆の根づたいに大廻りに、ひらひらと引き返す。",
              "citation": {
                "source": "海の使者",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の中から背面の大畠が抜けられますと道は近うございますけれども、空地でもそれが出来ませんので、これから、ずっと煙硝庫の黒塀について、上ったり、下ったり、大廻りをなさらなければなりませぬ。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを――三光坂上の葭簀張を出た――この老人はうら枯を摘んだ籠をただ一人で手に提げつつ、曠野の路を辿るがごとく、烏瓜のぽっちりと赤いのを、蝙蝠傘に搦めて支いて、青い鳶を目的に、扇で日を避け、日和下駄を踏んで、大廻りに、まずその寂しい町へ入って来たのであった。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その築地は、というと、用たしで、歯科医は大廻りに赤坂なんだよ。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "表へだと、大廻りですものね。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来――帰途にこの線をたよって東海道へ大廻りをしようとしたのは、……実は途中で決心が出来たら、武生へ降りて許されない事ながら、そこから虎杖の里に、もとの蔦屋（旅館）のお米さんを訪ねようという……見る見る積る雪の中に、淡雪の消えるような、あだなのぞみがあったのです。",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "変化を喜ぶ心と、も一つは友人の許へ行くのにＭからだと大変大廻りになる電車が、Ｅからだと比較にならないほど近かったからだった。",
              "citation": {
                "source": "路上",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さうですか、それでは空知太にお出になつたら三浦屋といふ旅人宿へ上つて御覧なさい、其処の主人がさういふことに明う御座いますから聞て御覧なつたら可うがす、どうも未だ道路が開けないので一寸其処までの処でも大変大廻りを為なければならんやうなことが有つて慣れないものには困ることが多うがすテ。",
              "citation": {
                "source": "空知川の岸辺",
                "author": "國木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三度大廻りをして東の方へ下りた。",
              "citation": {
                "source": "鴫つき",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "円形の池を大廻りに、翠の水面に小波立って、二房三房、ゆらゆらと藤の浪、倒に汀に映ると見たのが、次第に近くと三人の婦人であった。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "深川からじゃ大廻りでね、内の前を二度通るようなもんですもの、出直しましょうと思って。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "車は今雇ったのじゃありません、裏道から大廻りに、もみじ邸を卯之吉の木戸まで廻らせて、ここへ待たしてあったんで。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その崩が豊国へ入って、大廻りに舞台が交ると上野の見晴で勢揃というのだ、それから二｜人三人ずつ別れ別れに大門へ討入で、格子さきで胄首と見ると名乗を上げた。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶予ならず、庭の袖垣を左に見て、勝手口を過ぎて大廻りに植込の中を潜ると、向うにきらきら水銀の流るるばかり、湯殿の窓が雪の中に見えると思うと、前の溝と覚しきに、むらむらと薄くおよそ人の脊丈ばかり湯気が立っていた。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "是非大廻りに、堂々めぐり、五百羅漢、卍巴に廻って下さい。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで自然誘われて、雪国の都を見物のため、東京から信越線を掛けて大廻りをしたのであった。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さて、霞から、ずっと参れば玄関へ出られますものを、どういうものか、廊下々々を大廻りをして、この……花から雪を掛けて千鳥に縫って出ましたそうで。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野を通ろうとしたが上野が北条領で新関が処々に設けられていたから、会津から米沢の方へ出て、越後路から信州甲州を大廻りして小田原へ着いた。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、愈例のに違いないから、私は意を決して裏梯子を降りて、大廻りをして、窃そり台所近くへ来て見ると、誰も居ない。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちその中洲口から箱崎河岸、四日市河岸を通って、稲荷橋下から八丁堀を抜けて上って行く水路と、やや大廻りだが川を下に永代橋をくぐって、御船手組の組屋敷角から同じく稲荷橋へ出て、八丁堀へ上る水路とその二つでした。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらへいっては、お屋敷へまいられませんか」「行って行かれないことはないが、半蔵門へかえるのに、本所なぞへいっては大廻りじゃ。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
