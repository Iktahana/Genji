    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オエライ患者で超満員だよ……チャカラカ、チャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オエラ方も犯罪者も戦犯も、みんな一様に氏とよんだら、どうだ。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこのオエラ方の命令か知りませんが、三下だって怒る時はありますぜ」「まアま。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまたま中西伍長が独自の見解をのべて、それを党中央のオエラ方に批判してもらおうと思ったら、徳田中尉はカンカン怒って、伍長が二三分喋り得たのに対し、中尉は二三十分喋りまくって吹きとばしてしまったそうだ。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "中西伍長の独自の見解は、オエラ方にきいてもらえないばかりでなく、アカハタも前衛も彼の論文をボイコットして載せなくなったので、やむをえず党外の雑誌へ発表すると、反動通信網とケッタクした、というレッテルをはられてしまった。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人の大学は今で云うと農林省の相当のオエラ方の役人で、年は四十七。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
