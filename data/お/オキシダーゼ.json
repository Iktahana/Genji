        "examples": {
          "standard": [
            {
              "text": "オキシダーゼは酸化反応を触媒する酵素の総称で、呼吸鎖に欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "チトクロムオキシダーゼの活性を阻害するとミトコンドリアの機能が停止する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "食品の品質検査では過酸化物を分解するオキシダーゼの活性を測定する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "アミノ酸はまず酵素アミノ酸オキシダーゼによって脱水素反応を受けて相応するイミノ酸になる。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            },
            {
              "text": "セレンが酵素グルタチオン・ペルオキシダーゼの必須成分であることが見つけ出されたので、両者ともに抗酸化剤の役割をしている可能性が高くなった（49,50）。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            }
          ]
        }
