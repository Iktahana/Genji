        "examples": {
          "standard": [
            {
              "text": "中世の文献では音仮名が多く使用されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音仮名は当時、漢字の音読みを表す仮名として重宝された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "平仮名が普及する前は、音仮名が重要な表記方法だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "自分は字音仮名づかいを父に習ったばかりで、これまで定まった師匠に就いて学んだことはない。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "言ふまでもなく、八俣遠呂知対治の条に、記・紀二つながら、音仮名で、さずきと記してゐる。",
              "citation": {
                "source": "桟敷の古い形",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
