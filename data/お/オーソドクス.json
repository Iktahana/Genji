          "literary": [
            {
              "text": "青年の方はきちんと坐って、両手を膝に置いて肩を怒らしながら、真赤になって途方もないようなオーソドクスの議論に、文字通りに泡を飛ばしていた。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はその青年の口をついて出る雄弁には驚いたが、しかしまたその議論のあまりなオーソドクスさにも驚いた。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            }
