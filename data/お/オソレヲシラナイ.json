        "examples": {
          "standard": [
            {
              "text": "彼は生まれつき恐れを知らない性格で、どんな危機でも動じない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この恐れを知らない若者は、誰の忠告も聞かずに山へ入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "恐れを知らない挑戦者たちが、次々とその危険な塔へ登っていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "恐れを知らない雀よ。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい捲き毛は恐れを知らない大胆な額から生えだす。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親分、その女の言ふことなんかに取合つちやいけませんよ」「なんだ、湯島の吉か」　それは平次の息のかゝつた下つ引の一人で、若くて少し無鐵砲で、恐れを知らない巾着頭です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鬼女",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つは恐怖心にとらわれることであり、もう一つは恐れを知らないほど高慢になることである。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつは美しく、気高く、恐れを知らない。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「伊吹さまと師直さまの、お連れ合いなんて」「変ね」「変よ」「どっちも、むずかしいお顔をしてさ」「ホ、ホ、ホ、ホ」　彼女たちは、恐れを知らない。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
