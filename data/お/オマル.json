      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いくら藤村の羊羹でもおまるの中に入れてあると、少し答えます。",
              "citation": {
                "source": "文芸の哲学的基礎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのおまるたると否とを問わず、むしゃむしゃ食うものに至っては非常｜稀有の羊羹好きでなければなりません。",
              "citation": {
                "source": "文芸の哲学的基礎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い綺麗な陶器でできているんだが、ちょうどおまるのような大きさの、そしてまたそんな形のもので、そのきんかくしにあたるところに水と湯との二つの栓がついている。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、おまるにしては、固形物の流れるような穴はない。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつは、不恰好な姿で、這うようにしておまるをかたづけていた。",
              "citation": {
                "source": "河沙魚",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供らのおまるのわきに、夜じゅう豆ランプがついていて、いつもぼーっと雨戸についた地震戸の棧を照していた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　名の通り円満なおまるちゃんは首を振って笑っていた。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見るとおまるちゃんだった。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああおまるちゃんだ。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまるちゃん――」　彼女は男の頭の上から答えた。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしたちは、振りかえり振りかえりして、おまるちゃんが自分たちの方へこようとしなかったのをさびしがった。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまるちゃんが「亀の年」といったのは、よく諸方で可愛がられる子で、近所の――そばや利久の前の家――酒屋で、孫娘のように大事にしてよく借に来た。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぜんたい父がそういう趣味でござりましたからなおそうかんじたのでござりましょうがお遊さんの部屋の中にある調度類というものは、みな御殿風か有職模様の品ばかりで手拭いかけからおまるのようなものにまで蝋塗りに蒔絵がしてあったと申します。",
              "citation": {
                "source": "蘆刈",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いんまこんなのが要ろうがいの」　おまるであった。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「猪之じゃないか」と登が呼びかけた、「ばかに精をだすな、なにをやってるんだ」「へえ、なにちょっとその」猪之はあいまいに口を濁した、「先生がたもこんなじぶんまでたいへんですね、外は寒いでしょう」「話をそらすな、なにを作ってるんだ」「その、おまるの腰掛なんです」そう云いながら猪之は赤くなった。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "おくめ殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶長五年の今月今日、畏れ多くも東照宮様におかせられ、られ、られ、られ――ちっ、舌が廻らねえや――られては、初めて西御丸へ御入城に相成った。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところでもう一と働き」「何をやるんです」「西御丸下の牧野備後守樣御上屋敷だ」　平次や八五郎に取つては、大名屋敷はこの上もない厄介な場所でしたが、藩主備後守は幸ひ總州關宿に在國で、江戸屋敷は、わけのわかつた、小意氣な御留守居金山主膳が承つて居て、話は思ひの外簡單に埒が明きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "晒し場は招く",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
