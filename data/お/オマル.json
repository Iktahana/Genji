      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "bedpan",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "幼児がお丸を使うように練習している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤ちゃんがお丸に座るのに慣れるまで、親は根気強く促す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "保育園ではお丸の使い方を教えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "火鉢の火を絶やさぬやうにして風を引かせぬのも、夜なかに手水が支へて、ううんと云つて、夜着を跳ね退けるとき、直に目を醒まして、お丸に手水をさせるのも、皆博士が自分で遣つてゐるのであるから、それを手放しては安心してゐられぬ。",
              "citation": {
                "source": "半日",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟は西河岸の方に倚って上って行くので、廐橋手前までは、お蔵の水門の外を通る度に、さして来る潮に淀む水の面に、藁やら、鉋屑やら、傘の骨やら、お丸のこわれたのやらが浮いていて、その間に何事にも頓着せぬと云う風をして、鴎が波に揺られていた。",
              "citation": {
                "source": "百物語",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "火おけは南部｜桐のお丸胴でね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このお丸というのはどんな女だ」「芝口の下駄屋の娘で、兄貴は家の職をしていて、弟は両国の生薬屋に奉公しているそうです」と、源次は説明した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐにその女を引き挙げなければならねえ」「へえ、そのお丸というのがおかしいんですかえ」「むむ、お丸の仕業に相違ねえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "舐め筆の娘の死んだ日にお丸そっくりの女が筆を買いに来て、一｜※ばかり経って又その筆を取り換えに来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それにしても何故そのお丸という女が途方もねえことを巧んだのでしょうかね」「それはまだ確かに判らねえが、おれの鑑定じゃあ多分そのお丸という女は、上州屋の伜と情交があって、つまり嫉妬から筆屋の娘を殺そうとしたんだろうと思う。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここが少し理窟に合わねえように思われるが、お丸という女の料簡じゃあ、そこまでは深く考えねえで、なんでも売り物の筆に毒を塗っておけば、妹の娘が舐めるものと一途に思い込んでいたのかも知れねえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから馬道へ行って上州屋をたずねると、お丸は一と足ちがいで使に出たということであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "下女を呼び出して、それとなく探ってみると、ここでもお丸の評判はよくなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論それには女同士の嫉妬もまじっているのであろうが、大体に於いて弟の申し立てと符合しているのをみると、お丸という女が顔に似合わないふしだらな人間であるのは疑いのない事実であるらしかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "お丸がその与之助に連れられて、両国の観世物などを観に行ったことがあるらしいとの事であった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに住んでいる子分の庄太を呼んで、上州屋のお丸の出這入りをよく見張っていろと云い付けて帰った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "お丸の奴はきのう出たぎりで今朝まで帰らねえそうです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にも申し上げた通りそのお丸という女は顔に似合わない、質のよくない女で、つまり今日でいう不良少女のお仲間なんでしょう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに上州屋の息子は東山堂の娘を見そめて、三百両の支度金で嫁に貰おうということになったので、お丸は自分のふしだらを棚にあげて、ひどくそれをくやしがって、とうとう東山堂の娘を毒殺しようとおそろしいことを巧んだのです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "このお丸だって、あんまり利巧な奴じゃありません」「で、そのお丸はどうしました」と、わたしは訊いた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お丸は使いに行くと云って主人の家を出て、与之助のところへ逢いにゆくと、弟が丁度わたくしに引っ張られて番屋へ行ったあとで、与之助もなんだか薄気味が悪いので、店をぬけ出してうろうろしているところへ、お丸がたずねて来たという訳です。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "お丸もその話を聴いてさすがに不安心になって来たので、与之助をそそのかして何処へか駈け落ちすることになったのですが、こいつよくよく悪い奴で、なんでも中仙道を行く途中、熊谷の宿屋で男の胴巻をひっさらって姿を隠してしまったんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう訳ですから、死人に口無しで、お丸がなんと云って与之助から毒薬を受け取ったのか、その辺はよく判りませんでした」「お丸のゆくえは知れなかったんですか」と、わたしは又訊いた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お丸はそれから何処をどうさまよい歩いたのか知りませんが、やっぱり上州の赤城の山のなかに素裸で死んでいたそうです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "死骸の二の腕に上州屋の息子の名前が彫ってあったので、お丸だということがようよう判ったのです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お銀はお丸を覗き込んでいる笹村に呟いた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "店口より上へ、あがった事がなかったので、いつの間にか私の妹の、人なつこいお丸ちゃんが、代りに抱いたり、かかえられたりするようになった。",
              "citation": {
                "source": "西洋の唐茄子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしたちは幼いお丸ちゃんによくこういって聞いた。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い綺麗な陶器でできているんだが、ちょうどおまるのような大きさの、そしてまたそんな形のもので、そのきんかくしにあたるところに水と湯との二つの栓がついている。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、おまるにしては、固形物の流れるような穴はない。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　名の通り円満なおまるちゃんは首を振って笑っていた。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見るとおまるちゃんだった。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああおまるちゃんだ。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
