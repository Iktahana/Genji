[
  {
    "uuid": "480fe407-eece-5cd1-9f67-5b7a0cb05bd5",
    "entry": "お丸",
    "reading": {
      "primary": "おまる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
