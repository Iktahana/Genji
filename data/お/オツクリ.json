    "definitions": [
      {
        "index": 1,
        "gloss": "sashimi",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今夜の夕食は、市場で仕入れた新鮮なお作りをいただこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "料理長が丁寧に盛り付けたお作りは、まるで芸術品のようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "お作りをご注文のお客様、こちらが本日のおすすめです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その意味からいえば、ゆうべお作りなさった作品も、不朽に存在しているというものではございますまいか。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから妾のポーズをお作りになって、製作台にお立ちになったロダンさんは人格の変った方のように、妾には感じられるのでした。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ殺されるなら、勝手に調書をお作りなさいと云つて了つた方がいいかも知れない。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "『では、お気の毒ながらやっぱり遺言状をお作りしてあげなけりゃなりますまい……僕にはどうも、それ以上、お力になる事は出来ません。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉屋のお神さんはやっぱりビックリしましたが、「まあ、大変な御馳走をお作りになるのですね。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "八畳間の縁側には、あんなに西日が強く当るのですから、へちまの棚をお作りになると、きっと工合がいいと思います。",
              "citation": {
                "source": "きりぎりす",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年、二科から脱退して、新浪漫派とやらいう団体を、お作りになる時だって、私は、ひとりで、どんなに惨めな思いをしていた事でしょう。",
              "citation": {
                "source": "きりぎりす",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって、あなたは、蔭であんなに笑って、ばかにしていたおかた達ばかりを集めて、あの団体を、お作りになったのでございますもの。",
              "citation": {
                "source": "きりぎりす",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お歌の事に就いては、また後でいろいろとお知らせしなければならぬ事もございますが、十三、四歳の頃からもうあのお方は、新古今集などお読みになり、さうして御自身も少しづつ和歌をお作りになられて、その十七歳の頃には、もう御指南のお方たち以上の立派なお歌人におなりになつて居られたのでございます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ和気靄々、とでも言つていいくらゐのものでございまして、その頃お作りになつたお歌で、あまり人の評判にはならなかつたやうでありますが、綺麗なお歌がございます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雁によする恋、雲によする恋、または、衣によする恋、このやうな題はいまでは、もはや都の冗談に過ぎぬのでござりまして、その洒落の手振りをただ形だけ真似てもつともらしくお作りになつては、とんだあづまの片田舎の、いや、お聞き捨て願ひ上げます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍家は、恋のお歌を、そのころから、あまりお作りにならぬやうになりました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、ほかのお歌も、以前のやうに興の湧くままにさらさらと事もなげにお作りなさるといふやうなことは、少くなりまして、さうして、たまには、紙に上の句をお書きになつただけで物案じなされ、筆をお置きになり、その紙を破り棄てなさる事さへ見受けられるやうになりました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と蒼ざめたお顔で、誰に言ふともなく低く呻かれるやうにおつしやつて、その夜、三首のお歌を謹しみ慎しみお作りになられました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍家に於いても、ただ二念なく大君の御鴻恩に感泣し、ひたすら忠義の赤誠を披瀝し奉らん純真無垢のお心から、このやうなお歌をお作りになつたので、なんの御他意も無かつたものと私どもには信ぜられるのでございます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍家のお歌も、このとしあたりが最も真剣に御労作なされた御時期でございまして、その翌年あたりからは、御歌道にもおこたり、時たま御酒宴の御座興にたはむれのお歌をおよみになるくらゐのもので、まじめに御思案なされてお作りになる事は年に二度か三度、ほとんど数へるくらゐに少くなつてしまひました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのやうに、趣味でお作りになる方は、やはり好奇心や、自負心の満足だけなのですから。",
              "citation": {
                "source": "清貧譚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつたい、このお寺はテイデン和尚が、いつごろお作りになつたものなのでせうか。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、貴下、あらためて、奥様を償ふための、木彫の像をお作り遊ばせ、勝れた、優つた、生命ある形代をお刻みなさい。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは金光様がお作り下すった詩だというのだ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、まずいちばんさきに淡路島をおこしらえになり、それから伊予、讃岐、阿波、土佐とつづいた四国の島と、そのつぎには隠岐の島、それから、そのじぶん筑紫といった今の九州と、壱岐、対島、佐渡の三つの島をお作りになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、こんどからはおあにいさまが高いところへ田をお作りになりましたら、あなたは低いところへお作りなさいまし。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあべこべに、おあにいさまが低いところへお作りになりましたら、あなたは高いところへお作りになることです。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇はまた、人民のために方々へ耕作用の池をお作りになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、命のご陵をお作りになって、そのぐるりの田の中に伏しまろんで、おんおんおんおんと泣いていらっしゃいました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから最後に、お社をお作りになって、今度のご征伐についていちいちお指図をしてくださった、底筒男命以下三人の神さまを、この国の氏神さまにお祀りになった後、ご威風堂々と新羅をおひき上げになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論お作りをして待っているのだ。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぢや、あなたも詩をお作りでせうね、）（たゞ拝見するだけでございますわ、）　さう云つて女は笑つた。",
              "citation": {
                "source": "水郷異聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「野菜はあなたがおつくりになるのですか。",
              "citation": {
                "source": "紫紺染について",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お日さまがおつくりになるのです。",
              "citation": {
                "source": "紫紺染について",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
