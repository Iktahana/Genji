        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この室の両窓にヘリオスタートを取付け、ここへ分光器その他の光学器械を据え付けた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝、私は馬車でオスタ島の砲台附近の印度のイサックの別荘に招かれて、黒奴の紳士と会談するのであったが、でかけるときにアダは私に姿をちらとみせると故意に姿を隠してしまった。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よう、オスタープ、今晩は！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御覧よ、オスタップ」と、私が兄に対つて、「ほら、またあすこへ運送が来たよ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "オスタップや、お主の笛は何処にあるのぢや？",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、オスタップが言つた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄のオスタップを起して、ただ一言、運送屋たちはもう発つて行つたかと訊ねたきり、毛皮外套にくるまつてしまつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "『陥穽』にしろ『フオスタン』にしろ『シスター、ヒロメーヌ』にしろ、全体の構図をこのシーンの取扱方で鮮かにまとめて行つた形は見事であつた。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "オスタアドの寺祭りは中止せられた。",
              "citation": {
                "source": "クサンチス",
                "author": "XANTHIS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィリアム・ホルレルバッハ、シイ・ウェステンブロオク少年、エヌ・ウェステンブロオク、バン・フルインク、ジョス・シリングロップ、アール・メルレンブローク、ヘンリイ・コルテ、イー・ケル、ウィリアム・オスターヘイヂ、ヘンリイ・コオト、イサドラ・フリイベルグ孃、ヘンリイ・フリイベルグ少年。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "（七月四日）倫敦を立たうとして　僕達は大略｜倫敦の見物を済ましたから今日の午後の汽車でカレエ迄乗り、其処から汽船で白耳義のオスタンドへ渡る積りだ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリユツセル　ドオバアからオスタンド迄の海上三時間は少し許り波の立つのを感じた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽船と直ぐ接続するオスタンド発の汽車に乗つたが途中ガン市に住んで居る画家の児島君を訪ふ約束をして置いたに拘らず、其所書を巴里へ忘れて来た事に気が附いたので下車を見合せ、ずつと直行して夜の十時三十分にブリユツセル市へ着いた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月九日　火　オスタンキノ〔地名〕へ出かけた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラン以後にも手近い所でフオスタア（Foster）だとかブツセイ（Bussey）だとかいろいろ訳本の無い訣ではない。",
              "citation": {
                "source": "リチヤアド・バアトン訳「一千一夜物語」に就いて",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人公はオスタップ・ベンデルという山師で、北極飛行で世界に有名なシュミット博士の息子と称するいかさま師である。",
              "citation": {
                "source": "音楽の民族性と諷刺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オスタップ・ベンデル自身の山師としての社会的存在の意義も、彼の哀れな失敗そのもので容赦なく批判されているのである。",
              "citation": {
                "source": "音楽の民族性と諷刺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一〇三三年の頃ピエモンテのアオスタに生れ、一〇九三年イギリス王の知遇をえてカンターベリーの大僧正となり、一一〇九年に死す、著作多し〔ドナート〕アエリウス・ドナートゥス。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "“〔Ville de Lie`ge〕”　ワルソオ・伯林・ケルン・オスタンド。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから数日ののち、私たちはオスタンド・ドウヴァ間のＳＳヴィユィユ・リエイジュ号の甲板上に、近づく白堊の英吉利の断崖を見守っている自分達を発見した。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見ると、彼は、オオスタリイの兵隊服を著てゐる。",
              "citation": {
                "source": "世界覗眼鏡",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "其中にいへるあり、曰く愛蘭尚書ウイリアム、フオスターの辭職するや、其の後任としてチヤーレス、ヂルクを推薦する者あり、而もヂルクは内閣に座次を有せざれば、到底愛蘭に於ける自治政略を内閣に行はしむる能はずと稱して之れを謝絶したり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "其中にいへるあり、曰く愛蘭尚書ウイリアム、フオスターの辞職するや、其の後任としてチヤーレス、ヂルクを推薦する者あり、而もヂルクは内閣に座次を有せざれば、到底愛蘭に於ける自治政略を内閣に行はしむる能はずと称して之れを謝絶したり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "生物の個体は種のホメオスタシスのために生存する。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "やぶ医者やぶ医者のフォスタアさんが、グロオスタアへいって、にわか雨にあって、水たまりに立ち往生して、おへその上まで水びたり。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やぶ医者のフォスタアさんが、グロオスタアへいって」というふうのものはこれもことばの上の引っかけであるが、固有の名詞でそのままやれるから、そのとおりにしておいた。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
