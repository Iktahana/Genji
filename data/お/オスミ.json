          "literary": [
            {
              "text": "オスミウムという金属を用いたオスラム灯というのが出来たがあまり用いられぬ。",
              "citation": {
                "source": "ランプのいろいろ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "○オクツタ」ユイノウタノム」ケツコンシキノシタクセヨ」アスペキンタツ」オオスミチユウタロウ　同時に電報｜為替で百円送られて来たのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタ『パチノ』ガ『オスミ』と称スル日本婦人ト契リシガ、彼女ハ災害ニテ死シ、両人ノ間ニ生レタル一子（姓不詳）ハ生死不明トナリタリ。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お澄さんのうちから、オスミカエッタカと、電報あり。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンボには銀ヤンマのような堂々たる者もあり、トオスミトンボのような楚々たる者もあり、アカトンボのようなしゃれた者もあって、一寸彫刻に面白そうに思えるが、これがやはり駄目。",
              "citation": {
                "source": "蝉の美と造型",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
