        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それを伯母が節おもしろく「コーイーサー、（休止）、オーツキヨーデー、（休止）、オーヤマ、フーミモ、コーマイゾー」というふうに歌って聞かせた。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハ……」――【溶暗】――　オーヤオーヤ……ナアーンのコッタイ……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（オーヤ、オーヤ）と貝十郎は思った。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（オーヤ、オーヤ）と彼は思った。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの人もどの人もそれほかしらない五つほどの下すなしゃれをくり返しくり返して「オーヤオヤ」と思わせる人達ばかりの様に見えた。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オーヤ、オーヤお前もかい、おんなじようなご面相だねえ、見たくもないよ、そんな面は、蝮って本当にどいつもこいつも、こんなにも同じ顔かしら？",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
