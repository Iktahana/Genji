[
  {
    "uuid": "52f64ab1-68a6-5785-9672-0db334ee9115",
    "entry": "泳ぎ回る",
    "reading": {
      "primary": "およぎまわる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行"
      ],
      "ctype": null,
