    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "梅雨後の勢のよい青草が熱蒸れて、真面に照りつける日射が、深張の女傘の投影を、鮮かに地に印した。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人の女傘が後になり先になり、穂の揃つた麦畑の中を、睦気に川崎に向つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "糊も萎えた大形の浴衣にメリンスの幅狭い平常帯、素足に庭下駄を突掛けた無雑作な扮装で、己が女傘は畳んで、智恵子と肩も摩れ／＼に睦しげに列んだ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして川崎道の曲角まで来た時、三町｜彼方から、深張の橄欖色の女傘をさした、海老茶の袴を穿いた女が一人、歩いて来るのに目をつけた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨後の勢ひのよい青草が熱蒸れて、眞正面に照りつける日射が、深張の女傘の投影を、鮮かに地に印した。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人の女傘が後になり先になり、穗の揃つた麥畑の中を睦し氣に川崎に向つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "糊も萎えた大形の浴衣にメリンスの幅狹い平常帶、素足に庭下駄を突掛けた無雜作な扮裝で、己が女傘は疊んで、智惠子と肩も摩れ摩れに睦しげに列んだ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
