      {
        "index": 1,
        "gloss": "to cram (into a box, bag, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "段ボール箱に溢れんばかりの本を無理やり押し詰めて、ガムテープを貼った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "たくさんの荷物を小さなキャリーバッグに押し詰めたので、ジッパーが壊れそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "詰め込みすぎたクローゼットに、新しい冬物をさらに押し詰めるのは無理がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "此処まで押し詰めると理窟はなくなってしまうらしい。",
              "citation": {
                "source": "錯覚した小宇宙",
                "author": "――Our faith comes in moments;",
                "note": "青空文庫"
              }
            },
            {
              "text": "」北山は遠慮なく押し詰める。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし彼に強い意志があったならば、そうして Aesthet となるべく運命づけられているならば、彼はまず精神的傾向を彼がなしたよりももっと深い所まで押し詰めるだろう、そうしてそれを地に打ち砕くだろう。",
              "citation": {
                "source": "転向",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "短兵急に押し詰めると、いわゆる破れかぶれとなって、思慮にとぼしい呂布のこと、どんな無謀をやるかもしれません」　呂虔も、程※の意見、しかるべしと賛同して、「呂布の立場になってみると、今はただ臧覇、孫観などの泰山の賊党がたのみであろうと思われる。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to drive (someone) into a corner",
