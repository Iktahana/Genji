        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "議論の中で相手の矛盾を指摘し、論理的に彼を窮地に押し詰めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "対立候補の失言を追及し、相手を政治的な絶体絶命の局面に押し詰めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "追いつめられた犯人は、もはや逃げ場のない壁際まで押し詰められていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
