  {
    "uuid": "da1b7023-3c5f-59b7-a167-8c1f444e867f",
    "entry": "オトト",
    "reading": {
      "primary": "おとと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
