        "examples": {
          "standard": [
            {
              "text": "夏の終わり、庭の片隅に大毛蓼が群生して咲いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "散歩中に、鮮やかなピンク色の大毛蓼の花に見とれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大毛蓼は、その美しい姿から観賞用としても人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "大毛蓼というものか馬鹿に丈が高くなって薄赤い花は雁来紅の上にかぶさって居る。",
              "citation": {
                "source": "飯待つ間",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
