[
  {
    "uuid": "3f69e27b-a72e-52e5-a853-cd7e30757eea",
    "entry": "奥義",
    "reading": {
      "primary": "おうぎ",
      "alternatives": [
        "おくぎ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
