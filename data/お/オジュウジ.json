        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「仕事の合間にお十時を食べて、エネルギーを補充する。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「現場仕事をしている人たちにとって、お十時は大切な休憩時間だ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「母が作ってくれたお十時を、縁側で食べた思い出がある。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "すなわちハサマはもと朝夕二度の常食の中間にたべるものの名であったが、昼飯が定例となると、さらに転じて是と朝夕二度の飯との、中間のものを指すことになったのみならず、今日九州北部などにおいて、ハサグヒまたはハダグヒと謂うのは、ただのお八つやお十時の間食を意味するのである。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
