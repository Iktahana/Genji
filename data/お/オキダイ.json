        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しく買ったプリンターのために、しっかりした置き台を探している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "観葉植物を飾るために、おしゃれな木製の置き台を購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この置き台はキャスター付きで、移動が楽にできる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "斎めの置き台の上に載せられてあるのを見て、山ではこうした植物の新鮮な色を見ることで時の移り変わりのわかるのがおもしろいと女房たちが言っているのを、姫君たちは何がおもしろいのかわからぬと聞いていた。",
              "citation": {
                "source": "源氏物語",
                "author": "椎が本",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あの足置き台をわたしにお貸しなさい。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐまえの青建物の貧民学校から、総出でくる、すぐそばの海員地区からも、つながってくる、このお仕置台に首をはさまれている、さらし物の見物で、去年｜竜舌蘭の大輪が咲いたときのさわぎとはまたちがった、大へんな人だかりになるでしょう。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "おくみは寝椅子の側の物置台へ乳を置く。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいや、お大尽も早えところ片附けなきゃと、今頃はお仕置台にでものっけているに違げえねえんです。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よい天気だな、茶を所望する」　トンと腰を置台へかけた。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　水にぬれると紫インクのように変化して消えない鉛筆を手にして、偶然伸子が立った荷物置台の前にいた係りの若い金色の髪の男が快活に訊いた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八畳の部屋が狭いほど、花束や花輪や、贈りものが飾ってあって、腰の低い、四条派ふうの金屏風を廻らした中に、鏡台、化粧品｜置台、丸火鉢などを、後や左右にして、くるりとこっちへ向直った貞奴は、あの一流のつんと前髪を突上げた束髪で、キチンと着物を着て、金の光る丸帯を幅広く結んだ姿であった。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、置台の横手の通路をはいると、奥にまた狭い土間があって、そこでは、懇意なお客が特別なものを味った。",
              "citation": {
                "source": "どぶろく幻想",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな卓子を三つ配置しただけの土間の客席、その正面の置台を距てて、調理場があり、おばさんと皆から呼ばれてるお上さんが、独りで忙しく働いていた。",
              "citation": {
                "source": "庶民生活",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしも彼が何か金以上に、或はほとんど金と同じ位に、愛していたものがあるとすれば、それは彼の足置台のまわりで楽しく遊ぶただ一人の姫でした。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、君がもしも是非くわしいところを知りたいというんなら、まあ、まっすぐに立って三マイルから十五マイル、そして、タコウニック山に腰かけて、モニュメント山を足置台くらいにはしただろうと思うね。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "物置台の上に数個ずつ並んでいるにすぎなかったが、それが気に入った物ほど長く置かれてあった。",
              "citation": {
                "source": "解説　趣味を通じての先生",
                "author": "額田六福",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺の外側には細長い卓子があり、その上には四角い箱に四角いお盆が乗った、軽い木の物置台が置いてあった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "暖かく、明るく、楽しく、鍛造まき置台で火がごうごうと燃えている。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "硯のほかに技は置台や箱や急須のようなものにまで及びます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
