    "definitions": [
      {
        "index": 1,
        "gloss": "leaving (something) up to one's man (e.g. husband, boyfriend, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
