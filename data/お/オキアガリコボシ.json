        "examples": {
          "standard": [
            {
              "text": "倒してもすぐに起き上がる起き上がりこぼしは、不屈の精神の象徴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "幼い頃、祖母からもらった可愛い起き上がりこぼしを今でも大切に飾っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会津地方の伝統工芸である起き上がりこぼしを、お土産としてたくさん買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "親分さんとこからお迎いだよ、すぐ顔出すようにって」　と女房のお民が、濡れ手をふきふき水口からがなり立てたので、安兵衛、悪いところでも見られたように、起き上がりこぼしみたいにむっくと立ち上がって、「はてな、いま帰ったのに、急にまた何用だろう――？",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ何が珍しいといっても、おきあがりこぼしの達磨を紋にしておくような変わったかんざしもまれでしたから、早くも右門は明知の鋭さをそこに現わして、ひざに敷いている若者の心をえぐるようにいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "達磨を好く遊女",
                "note": "青空文庫"
              }
            }
          ]
        }
