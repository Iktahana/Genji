      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "男はオイチョカブの北田といい、千日前界隈で顔の売れたでん公であった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜オイチョカブの北田にそそのかされて、新世界のある家の二階で四五人のでん公と博打をした。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイチョカブの北田は金が無くなると本職にかえった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "儲の何割かをきちんきちんと呉れるオイチョカブの北田を、順平は几帳面な男と思い、ふと女めいたなつかしさも覚えていた。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜子が小走りに病院の方へ去って了うと、どこからかオイチョカブの北田が現れて来て、高峰お前なかなか味をやるやないか、泣きたんがあない巧いこと行くて相当なわるやぞと賞めてくれたが、順平はそんなものかなアと思った。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本だけと酒をとり、果物もおごってやって、オイチョカブの北田のことを訊くと、こともあろうに北田は小鈴の後を追うて別府へ行ったらしい。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "食べながら、別府へ行けば千に一つ小鈴かオイチョカブの北田に会えるかも知れぬと思った。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅館の法被を羽織り提灯をもったオイチョカブの北田が、例の凄みを帯びた眼でじっとこちらをにらんでいたのだ。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイチョカブの北田は何をっと一時は腹の虫があばれたが、しかし彼も今は土地での気受けもよく、それに小鈴のお産も遠いことではなかった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一の字を彫りつけられたのは、抗夫長屋ではやっていた、オイチョカブ賭博の、一、二、三、四、五、六、七、八、九のうち、この札を引けば負けと決っている一の意味らしかった。",
              "citation": {
                "source": "競馬",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
