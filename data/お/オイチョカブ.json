    "uuid": "38143d47-fec2-527f-9ef4-152854964f3d",
    "entry": "オイチョカブ",
    "reading": {
      "primary": "おいちょかぶ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
