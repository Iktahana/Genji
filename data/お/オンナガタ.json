    "definitions": [
      {
        "index": 1,
        "gloss": "onnagata",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの俳優は女形の大役を演じきった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "女形として名高い彼の所作は、洗練されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "歌舞伎の女形は、長年の修行の結果である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「同町内のよしみで……」と、挨拶すると、「いや宜しく……」と、三十年に近い「白鷺」の昔ながらに一向年をとつても見えない、覇氣充ちあふれた、この不思議な名女形は齒切れのいい句調で言つて、輕い皮肉めいた微笑を口元に浮べながら、「然しお宅は上の方の町内でせう？",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "源蔵の妻よりもどこか品格がよくて、そうして実にまた、いかなる役者の女形がほんとうの女よりも女らしいよりもさらにいっそうより多く女らしく見える。",
              "citation": {
                "source": "生ける人形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "女形が女よりも女らしく、人形の女形のほうが生きた女形よりもさらに女らしいという事実にも、やはり同じような理由があるのではないか。",
              "citation": {
                "source": "生ける人形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだから女形の男優は、女というものの特徴を若干だけ抽象し、そうしてそれだけを強調して表現する。",
              "citation": {
                "source": "生ける人形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの、底知れずの水に浮いた御幣は、やがて壇に登るべき立女形に対して目触りだ、と逸早く取退けさせ、樹立さしいでて蔭ある水に、例の鷁首の船を泛べて、半ば紫の幕を絞った裡には、鎌倉殿をはじめ、客分として、県の顕官、勲位の人々が、杯を置いて籠った。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめて、白玉のごとき姿を顕す……一｜人の立女形、撫肩しなりと脛をしめつつ褄を取った状に、内端に可愛らしい足を運んで出た。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これから女形が演処なんだぜ。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　黒縮緬の雪女は、さすが一座に立女形の見識を取ったか、島田の一さえ、端然と済まして口を利こうとしないので、美しい女はまた青月代に、そう訊いた。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸末期より明治の初年に亘って、名女形として知られた八代目岩井半四郎は、明治十五年二月、五十四歳を以て世を去った。",
              "citation": {
                "source": "源之助の一生",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その当時、他にも相当の女形がないではなかったが、源之助の人気は群を抜いていた。",
              "citation": {
                "source": "源之助の一生",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢村源之助は東京の劇壇に欠くべからざる女形となった。",
              "citation": {
                "source": "源之助の一生",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも女形として五十の坂を越えると、彼も前途を考えなければならなかった。",
              "citation": {
                "source": "源之助の一生",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "立役と違って、女形は年を取ってはいけませんと、梅幸は述懐していたが、源之助も女形であるために晩年の不遇が更に色濃く眺められたらしい。",
              "citation": {
                "source": "源之助の一生",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸末期を盛りとしたる女形にて、名人小団次の女房役者として世に知らる。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この当時の女形の風俗を察すべし。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸以来著名の女形なり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "中村芝翫と共に、江戸末期より明治初年にわたって、満都の人気を集めたる女形にて、脱疽のために両足を切断し、更に両手を切断して舞台に立ちたるは、劇界有名の事実なり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "容貌技芸共にすぐれ、前途多望と称せられたる女形なり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "粂三郎といいたる青年時代より、美貌を以て評判の高き女形なり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房役者として有望と称せられたる女形なり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪にては一方の覇たりし女形なり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時は頗る人気ありて、団十郎の与三郎を相手にお富を勤めたるほどの女形なりしが、晩年は旅廻りに寂しく終れり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪出の女形にて、大兵ながら女房役者として用いらる。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "女形として容貌は揚がらざりしが、伎倆抜群の聞えあり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "団十郎、菊五郎らの女形役者として知らる。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大酒のため晩年は振わざりしが、壮年時代は団十郎菊五郎の相方を勤めたる有名の女形なり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　文化の低いこの町では、銀子の好きなイタリイやドイツの写真もなく、国活がまだ日活になったかならない時分のことで、ちゃんばらで売り出した目玉の松ちゃんも登場せず、女形の衣笠や四郎五郎なぞという俳優の現代物が、雨漏りのした壁画のような画面を展開していたにすぎなかった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "中で圓朝の心に通うおんながただ一人だけあった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサデス　ツユノ　ヒカルミチコブヲ　トラレタ　オヂイサンツマラナサウニ　ホホヲ　ナデオヤマヲ　オリテ　ユキマシタ　瘤は孤独のお爺さんにとつて、唯一の話相手だつたのだから、その瘤を取られて、お爺さんは少し淋しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
