  {
    "uuid": "1192680e-1c39-5f62-8ba6-37a4be508255",
    "entry": "躍り",
    "reading": {
      "primary": "おどり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "leaping",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の躍りは喜びに満ちていて、見ていて楽しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "馬の躍りを見るのは迫力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "生きたイカの躍りは命が残っている証だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "『あれ、芳ちやん』此の時女は耐り兼ねて、紳士の背後から躍り出た。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同は狂気のように躍り上って、悦んだ、そうして小さい谷川へ下りたときには、敷石の水成岩の上に、腹這いになって、飲む、嗽ぐ、洗う、もう浸かるばかりにして、やっと満腹した。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと山稜の一角に達した、この山稜は御幣岳（南穂高岳）の頂上へと、繋がって行く、しかも鋭利なる剃刀の刃のように、薄く光って、空へ空へと躍り上って行く。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は躍り上るように喜んだ、ほんとうに、久しく尋ねあぐんでいたのだ。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上は、火山を、それ自ら単独のものとして、観察したのであるが、このような能動的な、積極的な、神経が尖って、触覚が鋭敏な火山が、日本アルプスの大山系に潜ぐり込み、そこから赤裸になって躍り出したところに、いかばかり特色のある山岳景を作り出したか、私は次にこれを言って見たいのである。",
              "citation": {
                "source": "日本山岳景の特色",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "小躍りして悦んだことが今に忘れられない。",
              "citation": {
                "source": "井戸",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この映画の頂点はヒロインが舞台で衣裳をかなぐり捨てブロンドのかつらを叩きつけて煩わしい虚偽の世界から自由な真実の天地に躍り出す場面であって、その前のすべてのストーリーはこの頂点へ導くための設計であるように見える。",
              "citation": {
                "source": "映画雑感（５）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな筈があるもんか」　と石松、表へ躍り出る。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　雀躍りして喜んだ。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、旗を……　しかし、その旗はみるみる光りはじめ、躍り上がり、大きくなり、眞赤になりだした……　………………………………………　いましも、彼等の旗は敵の眞只中で燃えだしてゐるのだ。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、彼はその眞只中へ自分の馬を躍り入らせた。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "銃をとると、彼は扉を押して、戸外へ躍りでた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はすきをうかがって躍り出したかと思うと、すぐ安全な地帯へ逃げこんでしまった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧民窟から、二人の支那人が引っぱって来られると、上川は、それによって、焦慮と、憤怒と、冷かされた鬱憤を慰めるものゝように、拳を振りあげて支那人に躍りかゝった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "刹那に、躍り出た仲間は娘を車中へさらいこむ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "盥の水が躍り出して水玉の虹がたつ。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの道死ぬるものなら一足でも前へ進んで、世間の者が夢にも知らぬ血と泥の大沼の片端でも見ておこうと、そう覚悟がきまっては気味の悪いも何もあったものじゃない、体中｜珠数生になったのを手当次第に掻い除け※り棄て、抜き取りなどして、手を挙げ足を踏んで、まるで躍り狂う形で歩行き出した。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と呟きざま、躍りかかりてハタと打ちし、拳はいたずらに土によごれぬ。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "褐色なる獣ありて、おりおり叢に躍り入りたり。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪んで之を質して見ると、夫れは次郎長の子分共で、若し少しでも間違つた事を云つたなら、直ぐ高座へ躍り上つて燕林を責め糺す気であつたらしいが、燕林の調査が行届いて居て余り間違ひの無いのに感服して帰つて行つたといふ事があつた位である。",
              "citation": {
                "source": "侠客の種類",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "何よりも荒馬のいきり立って躍り上がる姿にはたとえるもののない「意気」の美しさが見られるのである。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尉の胸は勇ましく躍りました。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき俄かに進んで行った鹿が竿立ちになって躍りあがって遁げてきました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その汗という考から一｜疋の立派な黒い馬がひらっと躍り出して霧の中へ消えて行きました。",
              "citation": {
                "source": "マグノリアの木",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中には上半身裸体で屑屋みたいな継ぎハギの襤褸股引を突込んだ向う鉢巻で「サア来い」と躍り出るので、審判に雇われた大学生が腹を抱えて高い腰掛から降りて来るようなこと。",
              "citation": {
                "source": "ビール会社征伐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『もしかあの女は遠からず死ぬるのじゃアあるまいか』という一念が電のように僕の心中最も暗き底に閃いたと思うと僕は思わず躍り上がりました。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔に任せ起って躍りいたるに突然水の面を見入りつ、お政々々と連呼してそのまま顛落せるなりという。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はこれまでというので、王と将軍のコールビオルンは舷から海におどり入る。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "○「お習字、生花、お琴、おどり――こういうものに却ってモダニティを感じ、習い度いと思うことはあるけれど、さて、いざとなって見るとね。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」カムパネルラはこおどりしました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
