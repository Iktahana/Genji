  {
    "uuid": "02f31f84-9f6c-52c3-91ea-13342cdf596a",
    "entry": "御布施",
    "reading": {
      "primary": "おふせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
