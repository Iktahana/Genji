        "examples": {
          "standard": [
            {
              "text": "大工は帯鋸を使って複雑な曲線を正確に切り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "帯鋸は細かい加工作業に最も適した工具だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この工房に新しい帯鋸が導入されたばかりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "円鋸や帯鋸が木材を自由にたち切るのを、一時間ばかり眺めた。",
              "citation": {
                "source": "祭りの夜",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、懐中時計のゼンマイに歯をつけた、小人島の帯鋸見た様なものを、二枚の銅貨を擦り減らして作った容器の中へ入れたもので、これさえあれば、どんな厳重な牢屋の鉄の棒でも、何なく切破って脱牢するんだ相だ。",
              "citation": {
                "source": "二銭銅貨",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
