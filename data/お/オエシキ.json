[
  {
    "uuid": "591cabd9-6c48-5413-a505-616276f39dd8",
    "entry": "お会式",
    "reading": {
      "primary": "おえしき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "memorial service for Nichiren (13th day of the 10th month; in Nichiren Buddhism)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎年十月十三日のお会式には、池上本門寺に万灯行列が訪れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "お会式の夜、境内に灯された万灯の明かりが幻想的だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "日蓮宗寺院のお会式に参列し、僧侶たちの読経に手を合わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "まず行者一家の者どもを引き挙げて、それをぶっ叩いて白状させるよりほかあるまいと、かれは内々でその手配りにかかっていると、あしたが池上のお会式という日の朝、多吉があわただしく駈け込んで来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "常丸　母様今日のお会式は面白うおぢやつたのう。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本願寺様のお会式にも負けぬという、それは大層な評判であった。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあくる日は、お会式の景気を見にやらされた、その記事が自分が新聞記者としての最初の記事だらう。",
              "citation": {
                "source": "世に出る前後",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月もお会式の頃から寒い雨がびしょびしょ降りつづいた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "半鐘の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "お会式　毎年陰暦十月十三日、祖師日蓮の忌日を卜して執行の法会をお会式とはいい、宗徒は又おめいこうとて本山に参籠する。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "……丁度、東京の池上のお会式……あれと同じ事であります。",
              "citation": {
                "source": "入庵雑記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "長四畳には帝釈様の髭題目の軸がかかっていて、お会式の万燈の花傘の、長い竹についた紙の花が丸く輪にして上の方にかかっている。",
              "citation": {
                "source": "神田附木店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのじろくお会式桜枝に咲き時雨降るなる三島宿かな　御会式桜とは池上の御会式の頃即ち柿の実の熟する頃に返り咲く種類の桜のことでもあらうか。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "メバル、アイナメ、海タナゴなどもよく交るが、カイヅは十月池上のお会式まで釣れる。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は本門寺のお会式だから、でかけてみないか。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "また騒々しいお会式の太鼓の雑音の中で、凡僧の説教や、演劇の舞台や、土佐まがいのまずい絵巻物の中から、日蓮上人を見てはいけません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、お会式のようなにぎやかさ。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで本門寺のお会式のような有様。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "両国の大鯨",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカ通といわれる四通八達の先生は勿論、実直な音楽批評家までお会式の万燈ほどに提燈を持ったので、いよいよ日本座で蓋を開けるときまると物凄いような前景気、とりわけ有閑、富豪の両階級の肩の入れ方は大したもので、十円也の特等券はすでに二カ月も前に全部売切れてしまったという有様。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "俗にお会式ボラといって、毎年この時分が、海のボラ釣りの一番盛んなころだ。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "竿忠の四代目になるター坊という、この時分十五、六歳であった子を釣れて、深川常磐町「餌友」の隣の「小島」という舟宿から、お会式ボラを釣りに出た。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃあうかがうがお経でもねえのにどうして寺まいりとかお会式なんぞで唱えるんだ。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
