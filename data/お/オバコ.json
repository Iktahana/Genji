    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あれが十年前からの御箱なんだからおかしいよ。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "御三卿お迎えの節には、大玄関の御箱壇にて礼をいたしまするか、それとも、御石段まで下って辞儀をいたしまするか。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五日、内侍所と璽の御箱をお迎えに、鳥羽に公卿たちがお迎えに出た。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのむこうの気違いのような眼つきをした裸の兵隊は、オオハコベを口いっぱいに頬ばり、唇から青い汁を垂らしながらニチャニチャ噛んでいる……そういう人間のすがたも、間もなくまた薄闇のなかに沈む。",
              "citation": {
                "source": "母子像",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが奴のオハコなんですわ。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
