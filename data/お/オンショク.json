        "examples": {
          "standard": [
            {
              "text": "インテリアデザイナーは壁に温色を取り入れ、部屋全体に落ち着いた雰囲気を演出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "夕暮れ時の空が温色に染まり、川面がオレンジ色に輝いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "このカフェは温色の照明と木製の家具で、居心地のよい空間を作り上げている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "また、赤系統の温色よりも、青中心の冷色の方が「いき」であるといっても差支ない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "温色の興奮を味わい尽した魂が補色残像として冷色のうちに沈静を汲むのである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "平凡なおとなしいその京都の女は、温色を包んで伏目になって引き下がった。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
