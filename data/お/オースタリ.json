        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「この麻糸をこんなに並べたところなぞはオースタリヤあたりのペザント・アートにでもありさうだね。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハハハハハハ……お伽話だ……地底の蜃気楼……アッハッハッフッフッフッ……アスタ・セガンチニ……あの近眼婆さん……オースタリ人の志村のぶ子……アハハハハ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハハハハハハ……｜お伽話だ……｜地底の蜃気楼……アッハッハッフッフッフッ……アスタ・セガンチニ……あの近眼婆さん……オースタリ人の志村のぶ子……アハハハハ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大戦後からイタリーとドイツの圧力の下に苦しむオースタリーを書いている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ましてオースタリーの以後のものなどは来ていません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツワイクがオースタリーの出生であり、この作家はドイツの作家というちがいが、決定する以上の意味があります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュナイダーはオースタリーのアルプス山中の寒村の貧農の子である。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば鯉という魚は、アジア洲に限ったものでしたが、十字戦争の時に、オースタリーという国の手で、アジアからヨーロッパへ運ばれました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五　百姓弥之助は東京から植民地への帰りに、新聞を見るとドイツ軍のオースタリー侵入の記事が目に附いた、それと共にチェコスロバキアがふるえ上って居るという脇見出しもある。",
              "citation": {
                "source": "百姓弥之助の話",
                "author": "第一冊　植民地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの現象は戦後、ことに敗戦国の特殊事情のなかに発生したものが多いことは明らかであるが、私は前大戦の直後、フランス、イタリイ、ドイツ、オースタリイの諸国をまはつてみて、それぞれの国民性と、戦後の立場とを考へながら、いろいろな観察を試みた。",
              "citation": {
                "source": "日本人とは？",
                "author": "――宛名のない手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイツ、オースタリイの敗戦ぶりは、今度のことは知らぬが、あの当時はむしろ立派であつたと私は思ふ。",
              "citation": {
                "source": "日本人とは？",
                "author": "――宛名のない手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "オースタリイ軍に殺されたイタリイの薬剤師を憂国の志士と呼んでゐる。",
              "citation": {
                "source": "チロルの旅",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "インスブルク　オースタリイ第二の都会。",
              "citation": {
                "source": "チロルの旅",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "小伝　シュナーベルは一八八二年オースタリーのリプニックで生れ、レシェティツキーに学んで今日の大を成した。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十になると彼と離婚し、アメリカの画家ヴェイルと結婚して、フランス、オースタリー、イギリスなどで暮す。",
              "citation": {
                "source": "「ザイルの三人」訳者あとがき",
                "author": "妹尾韶夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "オースタリーのチロルを舞台にしたこの「メークトラインの岩場」は A Treasury of Mountaineering Stories からとった。",
              "citation": {
                "source": "「ザイルの三人」訳者あとがき",
                "author": "妹尾韶夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
