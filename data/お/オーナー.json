        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "レストランのオーナーが厨房から出てきて、常連客のテーブルに挨拶に回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼はそのビルの元オーナーで、売却後も近所に住み続けているらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "犬のオーナーとして責任を持つことが、近隣との良好な関係を築く第一歩だと思う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "親父はこの銀行のオーナーだよ。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "競合による業績の悪化に直面させられたホレリスは一九一一年に会社を売り払い、新しいオーナーはこれを自動はかりの会社、タイムレコーダーの会社とまとめてＣＴＲ（コンピューティング・タビュレーティング・レコーディング）社を設立した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐれたソフトウエアや、プログラミングを理解するオーナーがいなければ、ホビイ用のコンピューターはむだになります。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オーナー・フライヤーの参加を希望す。",
              "citation": {
                "source": "空飛ぶ悪魔",
                "author": "――機上から投下された手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "参加資格はアマチュワー・オーナー・フライヤーに限る。",
              "citation": {
                "source": "空飛ぶ悪魔",
                "author": "――機上から投下された手記――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
