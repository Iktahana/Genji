        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ちよんぼりとある薄い眉は何やらいたいけな造だけれども、鬼薊の花かとばかりすら／＼と毛が伸びて、惡い天窓でも撫でてやつたら掌へ刺りさうでとげ／＼しい。",
              "citation": {
                "source": "山の手小景",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "掛地なしで、柱の掛花活に、燈火には黒く見えた、鬼薊が投込んである。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あざみをあやめに活けかへる、『見かけはつらき鬼薊、さわれば露の一しづく』か。",
              "citation": {
                "source": "行乞記",
                "author": "室積行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、それらの壺の幾つかには夫々色の異る薔薇や鬼薊の花束とか、橄欖やシトロンの杖が盛られてゐるところを見ると、一見花屋の店先か知ら？",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "誤つて鬼薊を掴めば、痛しとも痛し。",
              "citation": {
                "source": "阿武隈川水源の仙境",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど身の落つるよりはとて、痛しと知りつつも、鬼薊を掴まざるを得ざることもあり。",
              "citation": {
                "source": "阿武隈川水源の仙境",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鬼薊」の稲瀬川に出る恋塚求女の役であつた。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「寿曾我」の十郎、「双蝶々」の放駒長吉・与五郎などに扮し、二月狂言は「六歌仙」に喜撰・文屋・業平「野崎村」にお染、三月は「川中島」に更科六郎「関の扉」に墨染「鬼薊」に十六夜その他、といふ役割りである。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に九月の歌舞伎座は、二銭団洲と謳はれた又三郎を中心にした小芝居の座組みのまゝだが、書き出しの位置に居て、役割りも、岡崎次郎三郎（酒井太鼓）・佐々木高綱（三代記）・清心・清吉（鬼薊）と言つたぐあひである。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "土手には一ぱい触れば手足も脹れ痛む鬼薊が茂っています。",
              "citation": {
                "source": "監獄署の裏",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の野に出て七草みれば露で小褄はみなぬれる、よしてもくんねえ鬼あざみ。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "台湾巡業中に見た映画は片岡千恵蔵「三日大名」、月形龍之介「道中秘記」、嵐寛寿郎「鬼あざみ」、それから伊藤の「忠次信州血笑篇」など。",
              "citation": {
                "source": "私の活動写真傍観史",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "つはぶき、鬼あざみ、山うどが眼につく。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "額に山の雨が降りかゝり冷してくれる山の精力が細かな種子になつて降る蔓どめ、ひこばえ、山うど、鬼あざみ私は何でも觸つたものをつかむ。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう考えると、傍に鬼あざみの花が毒々しく咲いている、その色合が、あの男の頬や唇の色によく似ていたと思った。",
              "citation": {
                "source": "森の暗き夜",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、鬼あざみを摘んで、それに熱い接吻をしている女の唇はもっと紫色であった。",
              "citation": {
                "source": "森の暗き夜",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はじっとその鬼あざみを見て、華やかに笑ったのである。",
              "citation": {
                "source": "森の暗き夜",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮麗な色の鬼あざみが小川のふちに涯もなく咲いていました。",
              "citation": {
                "source": "いまだ癒えぬ傷あと",
                "author": "――放射線火傷で右手をうしなつた木挽きの妻と河原にうつ伏せて死んでいた幼女に――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
