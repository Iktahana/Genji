          "literary": [
            {
              "text": "真正面の青天井に見当を附けて兵隊さん式にオチニオチニと歩まぬと、虱の卵を生み附けられた顔がイクラでも眼に付きます。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオチニ風琴鳴らいて……」「花嫁御のお化粧の広告じゃなかったかねえ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、朝日の光の中を会社へ出かけながら、オチニ、オチニ……という気持で足を運んでいった。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "オチニ、オチニ……幼い時小学校でやらされた通りのその歩調が楽しかった。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも亦都合十人、紅白ダンダラ染めのユニフォームを着せられ、胸には１から10までの番号札をつけた紳士淑女が、向うの森の決勝点めがけて、オチニ、オチニ、息を切らして走っていた。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
