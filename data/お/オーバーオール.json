        "examples": {
          "standard": [
            {
              "text": "農作業のためにオーバーオールを着て畑へ出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "デニムのオーバーオールにストライプのシャツを合わせたコーデが今夏の流行だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「そのオーバーオール、子供っぽく見えない？」「いや、大人っぽく着こなせるよ」と友人と話した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それで、彼は、油絵のカンバスのような、オーバーオールを一つ手に入れることができた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
