[
  {
    "uuid": "814845a1-035f-53b7-90c5-8f4f36509484",
    "entry": "お供",
    "reading": {
      "primary": "おとも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "attendant",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "社長の海外出張にお供して、現地でのプレゼン準備から接待まで一手に引き受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「旅のお供にいかがですか」と書かれた帯封の文庫本が、駅の売店に山積みになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "散歩好きな老犬がいつも主人のお供をして、毎朝公園の一周をともに歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "僕はそれが羨しくて、母に名刺を呉れといふのであつたが「あれはお葬式のお供に行く人の子供だけが貰へるのです」つまり名刺を持つて行つたからとて菓子が貰へるわけはないといふのであつた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "なりひらは高禄の御武家様が御忍びと言った形、半次はお供の下郎である。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "おしまが団九郎に、Ｔ「妾なんぞが　御一緒に　お供して」　と言って、Ｔ「御迷惑で　御座いましょうね」　団九郎が中々もって迷惑どころか、却って喜んで居りまする。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）Ｓ＝街道の朝　団九郎とおしま、後から武蔵がお供する。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「――あたし、お供したいんですわ。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人のお供を連れた立派なお武家がわたくしの店のまえを通りかかりまして、ふと店にいる娘を見ましてふらふらと店へはいって来たんでございます。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "それではお供いたしましょう、」ピシッと鞭がせなかに来る、全くこいつはたまらない、ヨークシャイヤは仕方なくのそのそ畜舎を出たけれど胸は悲しさでいっぱいで、歩けば裂けるようだった。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……私と忠蔵がお供でやしたが、若奥様がね、瑞巌寺の欄間に舞つてる、迦陵頻伽と云ふ声でや、　――あの夏になると、此の辺に常夏が沢山咲きませうね――　へい、其の常夏を知らねえだ。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "院長先生のお供をして、これからみんなでひるめしたべに出ませうよ。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父が笑うのも道理で、鹿狩りどころか雀一ツ自分で打つことはできない、しかし鹿狩りのおもしろい事は幾度も聞いているから、僕はお供をすることにした。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢は七度よいところ、いざ御案内者で客を招けば、おらあ熊野へも三度目じゃと、いわれてお供に早がわり、いそがしかりける世渡りなり。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……詮方がない、災難と思う……御都合に因っては、それはどこへでもお供をする。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……昨日も鐵砲打の旦那に、私がへい、お供で、御案内でへい、立派に打たせましたので。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）後見　はい、お供して参りますで。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度お供物にしたのですよ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくひとつとなりの方へ、弟子をお供に出しませう。",
              "citation": {
                "source": "北守将軍と三人兄弟の医者",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄鎚を二｜挺、大きな紙入の底へ、内懐へしっかりと入れて、もやもや雲の蝋型には、鬱金の切を深く掛けた上、羽織の紐をきちんと結んで、――お供を。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "お供物だと血迷っての、犬の首、猫の頭、目を剥き、髯を動かし、舌をべらべら吐く奴を供えるわ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯉七　ちと申つかった事があって、里へ参る路ではあれども、若君のお使、何は措いてもお供しょう。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――これは稲荷殿へお供物に献ずるじゃ。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……お恥かしい身体ですが、お言のまま、あの、お宿までもお供して……もしその茸をめしあがるんなら、きっとお毒味を先へして、血を吐くつもりでおりました。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「旦那、お供はどうで、」　と停車場前の夜の隈に、四五台｜朦朧と寂しく並んだ車の中から、車夫が一人、腕組みをして、のっそり出る。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この叔父さんのお供だろう。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あえて世間をどうしようなぞという野心は無さそうに見えたのに――　お供の、奴の腰巾着然とした件の革鞄の方が、物騒でならないのであった。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのやうな御不足がござりませうとも、堪忍あそばすがお家の爲、このたびは何とぞそれがしをお供に連れられて、まげて國境まで御出迎ひを……。",
              "citation": {
                "source": "佐々木高綱",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "御差支へなければ途中までお供いたしませう。",
              "citation": {
                "source": "小夜の中山夜啼石",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあいだの朝、若殿様のお供をして行った人です。",
              "citation": {
                "source": "半七捕物帳",
                "author": "朝顔屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　Ａは多少極まり悪そうだったが、切符を無駄にするのは勿体ないと云うので、お供をすることにした。",
              "citation": {
                "source": "花嫁の訂正",
                "author": "――夫婦哲学――",
                "note": "青空文庫"
              }
            },
            {
              "text": "お供と云えば唯国の役人を一人つれたきりで、いや最も屡々、自分で行李を持って歩いた。",
              "citation": {
                "source": "『井伏鱒二選集』後記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "動くは逢見たき欲よりなり、騒ぐは下に恋しければなり」　女は暫時※惚として、そのすゝけたる天井を見上げしが、蘭燈の火かげ薄き光を遠く投げて、おぼろなる胸にてりかへすやうなるもうら淋しく、四隣に物おと絶えたるに霜夜の犬の長吠えすごく、寸隙もる風おともなく、身に迫りくる寒さもすさまじ。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
