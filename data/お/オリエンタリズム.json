          "standard": [
            {
              "text": "エドワード・サイードはオリエンタリズムについての批評的な著作を発表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "西洋美術におけるオリエンタリズムは、異国への憧れと幻想に満ちていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オリエンタリズムの研究は、帝国主義の文化的側面を理解する上で重要である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "瀬戸物の亭だの、睡蓮だの、刺繍の鳥だのを有難がった、安物のモック・オリエンタリズムは、西洋でも追い追い流行らなくなった。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
