          "literary": [
            {
              "text": "そこへも一応行って見なければならぬ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "来る来ないは別にして、とにかく一応行つてみようと安川は思つた。",
              "citation": {
                "source": "老嫗面",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく大念寺の離れまで、一応行つてみるほかに、気持の納まりがつきかねるのだ。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "紹介状と共に刺を通じてから、「斯う立ち働いているところを見ると、家庭教育が相応行き届いている」　と思った。",
              "citation": {
                "source": "嫁取婿取",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "江の島へ一應行つてから又引き返すことにしよう。",
              "citation": {
                "source": "滑川畔にて",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "二六六　他に乞ふのみにては比丘ならず、一切の所應行を服膺するのみにては比丘ならず。",
              "citation": {
                "source": "法句經",
                "author": "荻原雲來訳註",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
