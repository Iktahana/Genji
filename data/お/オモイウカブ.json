[
  {
    "uuid": "2bc959c3-55f7-5aef-8271-d05cc5037feb",
    "entry": "思い浮かぶ",
    "reading": {
      "primary": "おもいうかぶ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-バ行"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to occur to",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "卒業式の歌を聴くと、友達との思い出が次々と思い浮かぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "良いアイデアが思い浮かばないまま、締め切りが迫ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼の名前を呼ぶと、真っ先にあの笑顔が思い浮かぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "オデッサのドルスキィ事件やモンペリエのレテュリエ事件が毒物に詳しい者ならすぐに思い浮かぶだろう。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、美しい尼僧の遍路と話をしている父の姿や、その傍らに坐って静かにそれを聞いている母の姿、尼遍路の顔などが、まるで映画でも見るようにはっきりと思い浮かぶのである。",
              "citation": {
                "source": "抱茗荷の説",
                "author": "山本禾太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、召使たちが私の第二の自我であるハイドの出入りするのに前から慣れていることが思い浮かぶと、たまらないほど嬉しくなって安心した。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、頭にこんなことが思い浮かぶと、いつしかみんなからおくれて、自分は、ひとりぼんやりと、橋の上に立っていました。",
              "citation": {
                "source": "夕焼けがうすれて",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとたん、人間たれしも思い浮かぶのは、肉親の情だ。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一群れの鳥が尖塔に近づいた時、それが恐慌のうちに混乱し、散り散りになって向きを変えるように彼には思えた――何キロも彼方のこととて耳には聞こえなかったが、荒々しいさえずり声が思い浮かぶようだったのだ。",
              "citation": {
                "source": "闇をさまようもの",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの長蛇の提灯行列が流れてゆく熱烈な群衆の顔や打振る紙旗の波などは、幻影のように思い浮かぶが、その中に立ち交じったり、それを見物に行ったりした特殊な実感はないのである。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「極限〜」と名前がつくとどうも怪獣のようなものが思い浮かぶが、要は、人間には暮らせないような場所に生きる生物を言う。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "（「犯罪学雑誌」昭和二十七年三月復刊号）４　異様な兇器　西洋の事例の前に、ちょっと日本の江戸時代の例を考えてみると、私には異様な兇器として、宇都宮の吊天井と、八犬伝の「船虫」の話が思い浮かぶ。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドストエフスキーのスリルといえば、ただちにこれが思い浮かぶほど好きである。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私立探偵といえば、たちまち思い浮かぶのは明智小五郎だ。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "駕から出て、代々木荘の奥へ入ったあの姿が――あの狂わしい声が、まざまざと思い浮かぶ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしも、わしを殺しに来た人間の前で、そんなことを思い浮かぶ筈はなかったが、フトお前の頭巾を見て思いだされた、その、じゅうや頭巾を見て」「な……なンだって……」　頭巾といわれて、孫兵衛の声は意気地なくみだれてきた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "剣山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのように道徳に反しても、恋するひとのところへ涼しくさっさと走り寄る人妻の姿さえ思い浮ぶ。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし宜しかったら、思い浮ぶだけのことをすっかり手帳に書いて、読んでお聞かせしようじゃありませんか」　友人たちは初め承知しなかったが、結局ヴラジーミル・ペトローヴィチは自説を押し通した。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたわけだか、とりわけはっきり思い浮ぶのは、彼女がわたしに浴びせたあの笑い声だった。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄白は、良沢が一座にいると、心に思い浮ぶ質問の半分も、口に出すことができなかった。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう色がすぐさま読者の頭に思い浮ぶことのできるようにして貰いたい。",
              "citation": {
                "source": "書物の倫理",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がひとり部屋に帰り、夜更けて思い浮ぶ風景は、通って来たアラビアの沙漠である。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような動きにつれて、思い浮ぶのは福沢諭吉の「女大学評論」である。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベティー・マクドナルドというアメリカの婦人作家が書いている「病気と私」の明快さ、諷刺をふくむ明るさが、鋭い対照をもって思い浮ぶようないまの日本の闘病の現実が描かれている。",
              "citation": {
                "source": "『健康会議』創作選評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方の女学校に教師をしている友達が、面に恐怖を浮べて、対校競技の時他の教師達がこぞって競争学校の生徒に対する女学生の敵愾心、反感を煽る有様について語ったことをも、現実の問題として思い浮ぶのです。",
              "citation": {
                "source": "現実の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、道の屈折、山のたたずまいに関しては、目をつぶっていても思い浮ぶほど知っていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽気な声で千世子はついこの間書き上げた極く短っかいそいで可哀らしいものを京子に読んできかせたり思い浮ぶ歌を歌の様な調子に唄ったりした。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、ではあの人だったかと背の高い若い人が思い浮ぶ範囲です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の手帳について一番なつかしく思うのは、自分の仕事を心から好いている者としての父の姿に結びついて思い浮ぶ様々の場面です。",
              "citation": {
                "source": "父の手帳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "うっすり思い浮ぶ彼の室は非常に狭い廊下の突きあたりから二番目の灰色の扉の付いた部屋であった様だ。",
              "citation": {
                "source": "追憶",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その感銘から引出された重大なある疑問についてはここにふれず、「風雲」との連関で思い浮ぶただ一つは、島木氏のように新しく文学の仕事をはじめた階級人でさえも、題材の異常性にかかわらず文学の手法としては、リアリズムにしてもどちらかといえば古いタイプと常識とをもっていることを気づくのである。",
              "citation": {
                "source": "文学における古いもの・新しいもの",
                "author": "――「風雲」について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この自然科学の一新面の話が、ひどく面白く思われるのは、文学のリアリズムの問題がすぐ思い浮ぶからであった。",
              "citation": {
                "source": "リアルな方法とは",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　あっさりとさばけた態度で、そう言われましたので、私の方でもすっかり安心して、思い浮ぶまま無遠慮にいろいろな事をおききしました、その時の問答の全部をここでお伝えする訳にもまいり兼ねますが、ただあなた方の御参考になりそうな個所は、成るべく洩なく拾い出しましょう。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
