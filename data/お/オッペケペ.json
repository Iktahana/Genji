        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オッペケペー、オッペケペッポーポー。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ってオッペケペーといえば直ちに川上を連想するほどに、彼は忽ち有名なものになってしまった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "オッペケペ……」　こう唄って「ハハゝゝ」と大声に笑った。",
              "citation": {
                "source": "恭三の父",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "曰くオッペケペー、曰くトコトンヤレ、其音に意なくして、其声は即ち自ら人を動かすに足る。",
              "citation": {
                "source": "詩人論",
                "author": "山路愛山",
                "note": "青空文庫"
              }
            },
            {
              "text": "かげでこそオッペケペなぞと旗上げ当時を回想して揶揄するものもあったが、演劇界に新たな一線を劃すだけのことを川上はやり通した。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし子供ごころに、オッペケペッポの川上はさほど傑い人だと思っていなかった。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "……さすがの大将も、しまいにはオッペケペになって、とうとう兜をぬいじまったんだそうだ。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
