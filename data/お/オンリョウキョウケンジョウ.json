          "standard": [
            {
              "text": "論語に説く温良恭倹譲の五つの徳を、人生の指針としている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "温良恭倹譲のような高い人格を備えた人物を尊敬する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子ども時代から温良恭倹譲の精神を教え込まれた彼は、品格のある大人になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "子貢曰く、夫子は温良恭倹譲もて之を得たり。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "孔子がその温良恭倹譲の徳のゆえに至るところ政治の相談を受けたのはよき例である。",
              "citation": {
                "source": "孔子",
