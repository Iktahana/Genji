          "standard": [],
          "literary": [
            {
              "text": "たどたどしい女文字の片仮名文章は、「オマンサン、コンナコト、アナタニ知ラセタクハ、ナイノダケレド、ヨクヨクノコトト、承知ノ上、読ンデ下サイ」　と、始まる。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサン、　アナタハ、金五郎サントオ京サントノ事、ナニモ知ラナイデシヨウ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサン、　新サンモ、ワタシモ、アナタタチ夫婦ノ、昔カラノ事ヲヨク知ツテ居ルノデ、金五郎サンニ、女ナドハ作ラセナイ様、ズイブント骨折ツテ来マシタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサンニスマンカラ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサン、　金五郎サント、オ京サントヲ切リハナスニハ、モウ、アナタノ力ヲ借ル外、ナイノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
