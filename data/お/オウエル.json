          "literary": [
            {
              "text": "日本ではエミイ・ロオウエル女史が有名だが、テイツチエンズ女史も庸才ではない。",
              "citation": {
                "source": "パステルの龍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九三〇年にはデュアメルが叫び、一九五〇年にオウエルがゲオルギューが叫んでいるところのものが、またそうである。",
              "citation": {
                "source": "レンズとフィルム",
                "author": "――それも一つの性格である――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、オウエルの『一九八四年』にせよ、ゲオルギュの『二十五時』にせよ、文学の中には、この機械時代、集団単位の新しい時代への怖れが、今、世界を支配している観がある。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
