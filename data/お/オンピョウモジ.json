        "examples": {
          "standard": [
            {
              "text": "ローマ字は日本語の音標文字として学校教育で教えられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音標文字を用いることで、異言語話者にも正確な発音が伝わる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "カタカナは日本語における重要な音標文字の役割を果たしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "もちろん彼等の意志は、上述のことの外にも、象形文字の常習的困難を避け、日本語を音標文字化することによつて、智識と文化の普及的能率を擧げようとする實利主義にも存するだらうが、同時にこの實利主義は、國語の純粹性を守らうとする別途の意志とも、必然の關係で不離に結びついて居るのである。",
              "citation": {
                "source": "ローマ字論者への質疑",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮名は勿論使用上、音標文字の一種たるに過ぎない。",
              "citation": {
                "source": "澄江堂雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は片仮名は平仮名よりも進歩した音標文字なのかも知れない。",
              "citation": {
                "source": "澄江堂雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "アは前例どほり上の音と二重母韻をなし、万国音標文字を使ふと bie といふ発音になる。",
              "citation": {
                "source": "津軽地方特有の俚諺",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
