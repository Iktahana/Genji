        "examples": {
          "standard": [
            {
              "text": "そのホールのオーケストラボックスは最大80名の演奏者を収容できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "リノベーション工事でオーケストラボックスの音響設備が一新された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ミュージカルの本番前、オーケストラボックスから楽器の調律音が漏れてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "またこれを上演するバイロイトの祝典劇場というのが大変で、ワグナーが自分のもっている楽劇の理想を実現するために、特別の設計をして建てたもので、百何十名の大オーケストラが入るオーケストラボックスを舞台の椽の下に半円形で作った特殊な構造の劇場なのです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーケストラボックスは取払われ、舞台から客席まで、平面の大広間になっている。",
              "citation": {
                "source": "アーニイ・パイルの前に立ちて",
                "author": "小林一三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
