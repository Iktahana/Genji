    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから二※月くらゐして、やつぱりその同人の集りのあとで、谷君他三人ばかりが、円タクの中からオイデオイデをするから行つてみると、これから牧野さんを誘ひ出しに行くから乗れといふのである。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハイヨイヨワルシ」ダザイイツコクモハヤクオイデマツ」ナカバタ　北さんは、そんな電報を私に見せた。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "七ジノキシヤデオイデマツ。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "探偵小説のお尻の穴から片手を突出してオイデオイデをしている変態心理。",
              "citation": {
                "source": "探偵小説の正体",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンドノ土ヨウ日ニ小サイオヂサント、コチラヘオイデ。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「私も此間、あの半円劇場で「オイデパス王の銅像除幕式」が出された時に中央銅像局の役員達と一処に観に行つたのだが――」「ヴエスタ神社の広場にオイデパスの像が建てられるといふ話は決つたのですか？",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オイデパスよりも先にプローメイシウスを建てるといふわけには行かないでせうからな！",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、今度ヴエスタ広場に建てるオイデパス像に関して、斯う云ふ案が研究されてゐるのですが、如何なものでせう。",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲劇「オイデパス王」が何故に彼の如く満都の人気を呼んでゐるかは今更私が説明するまでもありますまい。",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私達はヴエスタの広場に、オイデパスとその王子との二つの銅像を上下に建てやうとするのです。",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蔭から、オイデオイデをして招く何者かがいた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ｄ）オイディプース（エディプスあるいはオイディプスとも表記）はギリシア神話の登場人物。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "成長したこの男子はオイディプースであるが、自分の両親を探す旅に出る。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "このため彼の馬が殺されたので、怒ったオイディプースはラーイオスらを殺した。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイディプースはテーバイへと向かったが、テーバイではスピンクス（スフィンクス）という怪物に悩まされていた。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイディプースは、その謎を解いたため、スピンクスは自ら城山より身を投じて死んだ。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "スピンクスを倒したオイディプースは、テーバイの王となり、実の母であるイオカステーをそうとは知らずに妻とし、二人の男児と二人の女児をもうけた。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "その探索をしているうちに、オイディプースは自分の素性を知ることになり、妻たる母は自殺し、彼は絶望してわが目をえぐり追放された。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "之アいよいよ警察の仕事になって来たわい」　　　　　　　　　　鳶色の洋服　所轄警察署から小浜信造宛に、スグオイデコウ　という電報が打たれた。",
              "citation": {
                "source": "青服の男",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "リヤ王なんかは悲劇だし、オイデプスなども悲劇に違いないわね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁を涸らすは活力を消耗するなり、即ち悔恨によりて罪を贖ふなり五五―五七【牧歌】ウェルギリウスの著作に牧歌十篇（Bucolica）あり【二重の憂ひ】テバイ王オイディプスとヨカステ（ヨカスタ）の間の二子（エテオクレス、ポリュネイケス）。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨカステ、オイディプスの己が子なるを知りて縊死す【酷き】兄弟相殺すにいたれる（地、一四・六七―七二註及び二六・四九―五四註參照）。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "でコルナイに従えば、例えばプロレタリア・イデオロギーもこのようなオイディプス錯綜に基づく。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして土地は大地たる母（Mutter-Erde）、オイディプスの母、の象徴に他ならない、というのである。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "万国のプロレタリアの結束は、オイディプス錯綜から来る男同志のエロティシズムだと宣告される。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
