  {
    "uuid": "c7ea7efe-a298-5554-87d9-863c69cd6ca1",
    "entry": "オイデ",
    "reading": {
      "primary": "おいで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
