  {
    "uuid": "7b0fb070-232d-5007-9880-9e0407d07469",
    "entry": "応念",
    "reading": {
      "primary": "おうねん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし奉行所の方でも大事を取って、一応念のために京都へ問いあわせたのですが、日野家では一切知らぬという返事であったので、結局お琴は重追放、善兵衛は手錠を申し渡されて、この一件は落着しました。",
              "citation": {
                "source": "半七捕物帳",
