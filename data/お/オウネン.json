  {
    "uuid": "64708b3f-23c5-5fdc-ad62-dd7ee1b7af58",
    "entry": "応年",
    "reading": {
      "primary": "おうねん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
