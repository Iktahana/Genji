    "definitions": [
      {
        "index": 1,
        "gloss": "the front of a building",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その邸宅は、重厚な門扉と手入れされた庭木による立派な表構えを誇っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古民家を改装したカフェは、あえて昔ながらの表構えを残しており、情緒がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "商店の表構えを新しくしたことで、通りを歩く人々の注目を集めるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "行者の家は五条の天神の裏通りで、表構えはさほど広くもないが、奥行きのひどく深い家であるので、この頃の雨の日には一層うす暗く感じられた。",
              "citation": {
                "source": "影を踏まれた女",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "周囲が周囲だけに、モダンな表構えの家が、劃然と目に立っていた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "家のうしろには葡萄園があるそうですが、表構えは茶店のような作り方で、ここでは登山者に無代で梅酒というのを飲ませます。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "路面がアスファルトになったり、表構えだけの薄っぺらな洋式建物が多くなったり、カッフェーやメリンス屋が多くなったりした位のもので、昔と比べて変ったといえば随分変ったといえるが、同じようだといえばまた同じようだといえないこともない。",
              "citation": {
                "source": "早稲田神楽坂",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "街道筋の古風な商家を見るやうな表構え一面に格子のはまつた二階家で、我々のもつあらゆる医院の概念に没交渉なものであつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "表構え一面に格子のはまつた医院のことで、なるほど建物の具合では洋服よりもふさはしいかも知れないが、さしづめ芸人か幇間といふ風俗だつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし表構えはただ「久兵衛」と書いてあるのみ、寿司屋ともなんとも表現していない。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "頑丈な表構えの隣家との間に、漸く人がはいり込める位の狭い路次があった。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "逢いに来たやうに紅梅亭をのぞき　という川柳があったけれど、ほんとうにそうした慎しやかな中に何ともいえない艶気を含んだ古風の表構えだった。",
              "citation": {
                "source": "寄席行燈",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "……とだけでは何のこともない、いまも立ならぶ大きなあの榎のかげに、手堅い、つつましい、謙遜な、いえばおのずからそれが江戸まえのくろ塀をめぐらしたその表構えが「古い浅草」のみやびと落ちつきとをみせていた。",
              "citation": {
                "source": "雷門以北",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "表構えよりは小綺麗で、世帯道具も一と通り揃っておりますが、家の中はひどく乱雑で足の踏み場もないといった感じです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "庚申横町",
                "note": "青空文庫"
              }
            },
            {
              "text": "「沢屋、沢屋、沢屋にあれ等の父親がいるのだ」ちらりと一言耳に挾んだだけで、彼女は、この、恐らくあまり大きくない旅館の表構えの様子まで、まざまざと目に浮んで来るような心持がした。",
              "citation": {
                "source": "黄昏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "表構えを釘づけにしてあるとみせて、周馬は、たえずここから出入りしているものらしく、馴れた足で、まっ暗な道を、サッサと先に歩いてゆく。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "行者の家は五条の天神の裏通りで、表構へは左ほど広くもないが、奥行のひどく深い家であるので、この頃の雨の日には一層うす暗く感じられた。",
              "citation": {
                "source": "影を踏まれた女",
                "author": "――「近代異妖編」",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川家が瓦解になって、明治｜四五年の頃｜大分宿屋が出来ましたが、外神田松永町佐久間町あの辺には其の頃大きな宿屋の出来ましたことでございますが、其の中に春見屋という宿屋を出しましたのが春見丈助という者で、表構は宏高といたして、奥蔵があって、奉公人も大勢使い、実に大した暮しをして居ります。",
              "citation": {
                "source": "西洋人情話英国孝子ジョージスミス之伝",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　幾島暁太郎は、その茶店の表構へを不思議さうに眺めまはした挙句、なんとも云へない弱つたやうな顔をして、縁台の並んでゐる土間の方へ歩いて行つた。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "表構よりは小綺麗で、世帶道具も一と通り揃つて居りますが、家の中はひどく亂雜で足の踏み場も無いと言つた感じです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "庚申横町",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
