          "literary": [
            {
              "text": "唯、紀戸ぞ、脇戸の吉き戸と卜へて、出で行かす時、到り坐す地毎に、品遅部を定めき」とある。",
              "citation": {
                "source": "日本文学の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この曙立の王は、伊勢の品遲部、伊勢の佐那の造が祖なり。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ木戸一六ぞ掖戸の吉き戸一七と卜へて、いでましし時に、到ります地ごとに品遲部を定めたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに天皇、その御子に因りて鳥取部、鳥甘、品遲部、大湯坐、若湯坐を定めたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "このアケタツの王は、伊勢の品遲部・伊勢の佐那の造の祖先です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ紀伊の道こそは幸先のよい道であると占つて出ておいでになつた時に、到る處毎に品遲部の人民をお定めになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで天皇は、その御子のために鳥取部・鳥甘・品遲部・大湯坐・若湯坐をお定めになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
