        "examples": {
          "standard": [
            {
              "text": "卑俗な言い方だが、地元の老人たちは平気で「おめこ」と口にする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "盛り場の酔っ払いが、下品な冗談を言いながらおめこを連呼していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その言葉はあまりに露骨すぎるので、公共の場でおめこなどと言うべきではない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "せっかくでしたけれども、あのお馬には乗るまいと、わたしは考えちまいましたのよ、あの明神様の前で死んでしまおうか知らと思いましたのよ……ですけれども、また考え直して、御親切なお馬に乗せていただいて、おめおめこれまで参りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、おれも蒙古の武士、古い恋を根に持って、大軍を率いて攻め来った成吉思汗に、おめおめこの城を渡されようか。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――へえ、君はよくそれで、おめおめここへ来られたもんですね。",
              "citation": {
                "source": "物言ふ術",
                "author": "岸田国士",
                "note": "青空文庫"
              }
            },
            {
              "text": "このたびこそは、決死の御出陣と知れきっているものを、なんで私ひとりあとに残って、おめおめこの郷を去られましょうか。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
