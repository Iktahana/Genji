        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミロー（Darius Milhaud 1892―1974）　フランス音楽の六人組の一人、オネッガーと共に重要で、新味｜横溢した曲がかなりレコードされている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "オネッガー（Arthur Honegger 1892―1955）　フランス六人組のリーダーであった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パシフィック二三一」は機関車の力強い構成と動きを音楽で描いたという、オネッガーの代表作だ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "オネッガーの傑作「ダヴィッド王」のうち、日本コロムビアから二枚出ているが、無残にも廃盤になった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
