        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旅行から戻った友人は「大阪の食い倒れって本当だね、三日間食べ続けたら財布が空になった」と笑った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "大阪の食い倒れとはよく言ったもので、難波をひとまわりするだけでたこ焼きに串カツにと散財してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「大阪の食い倒れを体験しに行こうよ」と誘われ、三人で道頓堀の屋台を端から端まで食べ歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「京の着倒れ、大阪の食い倒れ」　というが京大阪の咄家は、昔から着物に金を掛ける。",
              "citation": {
                "source": "噺家の着物",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "『京の着倒れ大阪の食い倒れ』というほどだから、此処へ来たら食う方は諦めるんだね。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
