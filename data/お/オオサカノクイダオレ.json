    "definitions": [
      {
        "index": 1,
        "gloss": "financially ruining oneself by overindulging in food and drink (as a fabled tendency of the people of Osaka)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
