          "literary": [
            {
              "text": "「オヤッ」と私は思った。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "物蔭から勝坊がそれ見てオヤッと思った。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "三次オヤッと意外に思った。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷のお絹と勝坊出て来てオヤッと驚く。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "三次オヤッと立ち上る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍で泣いて居た勝坊、　地上に何かを認めてオヤッと云って拾い上げた。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶店の柱に凭れて居たお光が彼方を見てオヤッと言った顔（大吉を見とめたからだ）。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "若侍、オヤッと思ったが、　進藤は平気な物。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤッと半次驚いて立ちどまる。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "投げられて、オヤッと団九郎、意外な顔。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オヤッと若侍、急ぎ足に二人の傍へ。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿様、オヤッと驚く。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤッと私は思った。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふいに、男女二人の訪客があって、その名刺をみたときオヤッと思ったほど、じつにそれが意想外の人物だったのだ。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰だ、マッデンかい」　あけると、意外な男二人にオヤッと目をみはる。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤッ、ありゃ折竹君、なんだね」　と、指差された薄明の地平線上。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤッ」　というようなまん丸い眼をして、しばらくちがった周囲に呆気にとられていたその子は、やがて、しくっしくっと泣きじゃくりを始め、「オジチャン、ここ、ジャッキーちゃんのお家じゃないんだね」「そうだよ。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤッ、と、キューネがふと横をむくと、舟は、大岩礁に桁先をはさんで停っている。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……オヤッ……婦長さんも居ない。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲虫は一体に赤い色が好きなのかも知れんのう」「オヤッ。",
              "citation": {
                "source": "髪切虫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうするとそこに吾輩が予期している、或る素晴しい精神科学の作用が電光の如く閃めき起って……オヤッ……そうだったかッ……俺はこんな人間だったのかッ……と思うと同時に、今度こそホントウに気絶するかも知れぬ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "物騒な事を云うなよ……オヤッ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤッ……先生のお顔色はドウなすったんです。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっかり眼がさめた」　と豚吉はあたりを見まわしましたが、ヒョロ子の姿を見るとビックリしまして、「オヤッ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤッ」と、彼は慌ててふところに両手を容れた。",
              "citation": {
                "source": "失題",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤッと思うと、それが河田だった。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "変なそぶりが見えたら、抜きうちに……儀作が心を配って行くと、「オヤッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい歯の揃った口を盛んに現わしながら、傍へ引きつけたバーテンダーを口説いていたが、そのうち急に入口の方に目を据えると、オヤッという風な表情をした。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "重い靴をゾロゾロ舗道の上に引きずりながら、わが家の前に帰って来たとき、僕は、「オヤッ、――」　と叫んで、その場に歩みを止めた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
