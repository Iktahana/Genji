    "definitions": [
      {
        "index": 1,
        "gloss": "cemetery guard",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代の隠亡は墓地の整備と埋葬を担当していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "隠亡の仕事は社会的には低く見なされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "隠亡は死と向き合う重要な職業であった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "八　隠亡堀の流れの向うに陽が落ちて、入相の鐘がわびしそうに響いて来た。",
              "citation": {
                "source": "南北の東海道四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠亡をやめて遠国に住んで、美しい妻と共に一生を楽しく暮す。",
              "citation": {
                "source": "書けない探偵小説",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "軒は傾き、壁はくずれて、さながらに隠亡小屋のような気味のわるい小屋でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠亡堀の直助権兵衛という形で、阿部さんはその櫛をじっと眺めていると、どこからかお岩の幽霊のような哀れな声が又きこえました。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕の母は――お寺の隠亡と知っているのだ。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "――時に隠亡堀は如何でした？",
              "citation": {
                "source": "動物園",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまや舞台は、三幕目砂村｜隠亡堀の場。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時刻も黄昏、所は十万坪隠亡堀、すべてが陰の極みである。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "台本によつて四谷怪談を読む方々には、何の不審も起るまいが、芝居の方を見る者には、隠亡堀の世話だんまりに樋の口を開けて、何故非人姿の与茂七が参加するのか、そんな事がまづわからなくなつてゐる。",
              "citation": {
                "source": "お岩と与茂七",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "身分は水茶屋の養女であったが、その綽名は「赤前垂」……もう赤前垂のお杉と云えば、武士階級から町人階級、職人乞食隠亡まで、誰一人知らないものはなかった。",
              "citation": {
                "source": "柳営秘録かつえ蔵",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盂蘭盆でありさうな「隠亡堀」も「蛇山庵室」も別にさう言ふ風には見えぬ。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠亡堀で伊藤の妻お弓を欺く直助権兵衛の言ひ状を見ても伊右衛門が死んで四十九日だといふ。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "本水はつかはぬが砂村隠亡堀の場は、男女一対の死骸の動く戸板覆し、伊藤乳母の水死、直助権兵衛の鰻掻き、樋の口をあけて出る与茂七など、水辺の風情はなごりなくとり入れてゐる。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分がはじめ広文庫所引の「山野御房」を見た時には、これ或いは山住の御坊、すなわち俗に所謂｜隠亡の徒ではなかろうかとも考えてみたのであったが、一方にそれを明らかに「山牛蒡」と書いてあってみれば、疑いもなくこれは山の護法で、飛騨の牛蒡種と同一名称のものであることを信ぜざるをえなくなった。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            },
            {
              "text": "御坊とはもと非人法師に対する敬称で、「御坊様」という事にほかならぬが、後にはその法師たることが忘れられて、穏亡或いは隠亡、※房・煙亡・煙坊などの文字を当てている。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "エッタ坊主・ハッチ坊主・スタスタ坊主・スッタラ坊主・乞食坊主・マイス坊主・オゲ坊主・毛坊主・カッタイ坊主・長吏ン坊・八ン坊・皮坊・御坊（隠亡）などから、はてはべら坊・泥坊・立ちん坊・風来坊・ケチン坊・シワン坊に至り、腥坊主・糞坊主・チャンチャン坊主などという語までが用いられる。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（作者が二十歳の頃よく釣舟を漕いで往復した小名木川、中川、隠亡堀あたりの描写である。",
              "citation": {
                "source": "来訪者",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処は砂村隠亡堀であった。",
              "citation": {
                "source": "隠亡堀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪の毛のくだりもよく、黒鬼のごとき隠亡の登場も身の毛をよだたしめ、この仁の前途多幸を思わしめた）。",
              "citation": {
                "source": "随筆　寄席囃子",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂丘のかげの小屋には、母と子と、それに中年の隠亡と、そのほかに誰もゐなかつた。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "その髑髏を隠亡が、長い火箸のさきで突き崩した。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてたうとう、隠亡が自分の前に掻き寄せてゐた灰の山のなかから、火熱で黒ずんだその最後の金歯を杉箸の先でほじくり出すと、さも誇らしげに高々と持ちあげてみせて、骨壺のなかへ落した。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年は隠亡に恥かしかつた。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに夜明けにも間がないので、富五郎の屍体はひとまずそのまま女房へ預けておき、朝、係役人を案内して表向き首実検に供えた後、今日の内にも小塚原あたりに打捨になり、江戸お構いの女房の拾いでも遅くも夕方までには隠亡小屋の煙りになろうという手筈――だったのが、それがどうだ！",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "槍祭夏の夜話",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠亡が棺を運ぶ車をカタ／＼云はせて居た。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠亡は棺を三等の穴に投げ込んで、合い鍵を渡し土を塗って火をつけた。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　棺の中で死体が物を言うので、隠亡は逃げてしまった。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　隠亡は、自分でも馴れた手付で、それの幾つかを拾った。",
              "citation": {
                "source": "童子",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、君は隠亡かね？",
              "citation": {
                "source": "恐怖の正体",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見ると主膳は直ちに、こいつ墓掘りだ、隠亡共だわい、と気取りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
