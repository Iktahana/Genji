[
  {
    "uuid": "67786ea4-8366-521f-ab25-c95cdb86453d",
    "entry": "押し進める",
    "reading": {
      "primary": "おしすすめる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
