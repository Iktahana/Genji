    "definitions": [
      {
        "index": 1,
        "gloss": "to press forward",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しいプロジェクトを計画通りに押し進める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人混みをかき分けて、会場の先頭まで押し進める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "議論が停滞していたが、強引に結論を押し進めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "待ち受けるＵＮＩＸに対し、下からのネットワークを押し進めるパーソナルコンピューター陣営！",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはあたかも車を峻坂に押し進めるが如くである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことは批評家もともども歴史を押し進める推進力を明瞭にするいとなみに協力しあうことが大切だ。",
              "citation": {
                "source": "批評は解放の組織者である",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし市民文化の自己発展は、個人的自由通商主義より重工業的資本主義にみずからを押し進めることによって、人間的自律性としての体系的単一性は、個人的単一性の純粋よりして、組織的単一性としての純粋に変容すべく余儀なくされる。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちその秩序の中に実践することによって、その組織をより新しい段階に押し進めるために、積極的意味における否定をもつことのできるところの新しい道徳的規範の出現なのである。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその考えを押し進めることが出来なかった。",
              "citation": {
                "source": "理想の女",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "七四　この分析は不完全でありながら、一見これ以上にこの分析を一層深く押し進めることは不可能のように見える。",
              "citation": {
                "source": "純粋経済学要論",
                "author": "ELEMENTS D'ECONOMIE POLITIQUE PURE OU THEORIE DE LA RICHESSE SOCIALE",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで、主として、写実的な場面について論じたやうな形になつたが、もともとこの写実といふことが、既に現実の複写ではないのであるから、現実整理の筆を更に現実修正の域に押し進めることは、作者の趣味、才能によつて如何なる程度までも許さるべきである。",
              "citation": {
                "source": "舞台の言葉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "現実修正は更に現実変形、現実拡大、現実様式化に押し進めることもできる訳である。",
              "citation": {
                "source": "舞台の言葉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学者は併しどういう立場に立てば科学を文学にまで押し進めることが出来るか。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会の精神、古典的伝統、精神と形式との旧習、深い真摯の欠乏、などは彼らをして、その大胆な試みを最後まで押し進めることを許さなかった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "寧ろそういうものなしには政治は有り得ない、もう一つ押し進めるとそれが自然でさえあるかもしれない。",
              "citation": {
                "source": "思い違い物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあとで彼の敵がインドの総司令官となったにしても、結局大勢はアルブケルケの開始した植民地経営を押し進めることに帰着するのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを鎮めるために新しく総督に任命されたのがヌンニョ・ダ・クーニャで、これが一五二九年より一五三八年までの十年間に、アルブケルケの事業を力強く押し進める事になるのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもまた、彼を捕え彼を反対の方向に厳として押し進めるも一つの義務があった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブサンゴーとデューマの二人は動物での研究を行わなくなり、リービッヒは実際に動物飼育実験をしたことは無いのに、新しい権威者となり、生理学および栄養学で自分の考えを押し進めるようになった。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが彼は、自分を押し進めることが、そのまま千早城の前進であり、敵に多くの死者を捨てさせるより、もっと有利で意味の大きな味方の拡充と見ていたにちがいない。",
              "citation": {
                "source": "私本太平記",
                "author": "新田帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "それどころか、これ等の人々の作品には、一般に人類の幸福をおしすすめる拍車となるようなものすら何一つ見當らぬ。",
              "citation": {
                "source": "政治的價値と藝術的價値　マルクス主義文學理論の再吟味",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "また文学戦線の問題も歴史的推進力を明瞭にしながら人権を守るという点をはっきりして、よりよく生きる可能の向上としておしすすめることで、民主的なものについて最後の線を守ることで前線に立つという最後の一線がなくてはならず、どなたもおいでなさいのお手々つないで式では前進しない。",
              "citation": {
                "source": "批評は解放の組織者である",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　日本文学のなかでたとえそれがどんな形で経験されたにしろ自然主義の時代は背後にしている私たち今日の作家にとって、現実への凝視と云う場合、それが対象への単に主観的な執拗な絡みであっては、文学を健全におしすすめる力として弱いことがわからせられていると思う。",
              "citation": {
                "source": "作家に語りかける言葉",
                "author": "――『現代文学論』にふれて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、日本の民主主義革命そのものの特殊な性格、すなわち、これまでの封建性、絶対主義に対するブルジョア民主革命をおしすすめる過程に、当面の革命が成熟してゆくという特殊な歴史的条件は、見とおされていなかったわけではなかった。",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャーナリスティックな場合、どうしたって現象的ディテールを追って、それに対して云々する場合が多く、従って文学理論の歴史から見ても、それを或時代から時代へ発展させ押しすすめる集積としての仕事になり難い。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "漱石はそう語りつつ、自身のうちにあるそれ以前の教養の重圧で（後年はたしかに重圧的なものとなって出ている）生活の本質的な成長を、その力によって押しすすめることは不可能であった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たち働く男女が、自分たちの生涯について真面目に考え、選挙についても組合についても、一人ずつ責任をもって、進歩の方へ、民主的な方へと押しすすめるように生活を導いてゆかなければだめです。",
              "citation": {
                "source": "悔なき青春を",
                "author": "――現場録音 No. 4 No. 5 をよんで――",
                "note": "青空文庫"
              }
            },
            {
              "text": "重吉と大谷とのつきあいの深さは、互の噂を個人的に喋り散らす以上のものであり、そういう友情が歴史を押しすすめるための大事な見えないバネとなっている、その値うちがひろ子にも近頃少しずつ分って来ているのであった。",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "未来にソヴェトのプロレタリア文化を護るもの、生産する者、そして、それを更に強力に国際的な人民解放の勝利に向って押しすすめる者は、きょうの小さいソヴェトの子供たちである。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、今日を明日へ押しすすめるべき未熟な、酸苦くはあるがそれが核であることだけは確であった世界観のよりどころを、自分の手で文学から追放してしまった人々は、自嘲的になった自己の内部に十九世紀のリアリストたちの情熱すら抱き得ない有様である。",
              "citation": {
                "source": "今日の文学の展望",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かの意味である一つの問題を大衆化し、討論し、正当な発展へと押しすすめるべき目的をもって書かれるのであるから、その論文が先ず読者を納得させることに失敗したとすれば、それは論文のマイナスの部分として認めなければならぬ。",
              "citation": {
                "source": "前進のために",
                "author": "――決議によせて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "同志林がプロレタリア文学運動に参加して二年の「見習女中」に対して自身の多年の閲歴を語るのであれば、それは、「見習女中」の科学性の欠如をくまなく明らかにし、自身の文学的活動のより高いレーニン的段階の獲保によってプロレタリア文学を押しすすめることにおいてこそなされるべきではなかったか。",
              "citation": {
                "source": "前進のために",
                "author": "――決議によせて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、右翼的日和見主義との闘争は、作家同盟の第五回大会決議が極力警告しているとおり、プロレタリア文学をレーニン的段階へ押しすすめるために欠くべからざる一つの条件である。",
              "citation": {
                "source": "前進のために",
                "author": "――決議によせて――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
