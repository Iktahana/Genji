        "examples": {
          "standard": [
            {
              "text": "歴史の授業で沖縄戦についてのドキュメンタリーを見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "祖母は、沖縄戦で多くの友人を亡くしたと語ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "沖縄戦の悲劇を風化させてはいけないと強く思う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "沖縄戦で末子が潜水艦に乗りくみ戦死したばかりである。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この末娘のせつは、由良の利枝の末の子と結婚する筈だったのに、それが沖縄戦で戦死して、これも日のたたぬ躊躇の折、責任を感じた利枝は自らすすんでこの新庄の婿との間を取りもった。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
