    },
    "definitions": [
      {
        "index": 1,
        "gloss": "food packed in a wooden box",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お花見のお弁当は折り詰めになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "高級な食材が使われた折り詰めをいただいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会議の昼食用に折り詰めを注文する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "この日の御｜饗宴の席の折り詰めのお料理、籠詰めの菓子などは皆｜右大弁が御命令によって作った物であった。",
              "citation": {
                "source": "源氏物語",
                "author": "桐壺",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何かうまそうなもので折り詰めができるか」「できますが、何人まえさんで？",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいいち、仕出し屋へ来て折り詰め弁当をあつらえたことからしてがふにおちないのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ね、だんな、いやみなことをいうようですが、いったんもらった以上はこっちの金ですぜ」　しかし、右門はいっこうに取り澄ましながら、でき上がってきた折り詰めを片手にすると、さっさと道を本郷台に向けて取りました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "村正騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、そのときこっそりと伝六へあの佃煮の折り詰めを手渡しながら、意味ありげにささやきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "村正騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんまり歌ってなんだか渇いて来たよ」　「お茶を持ってまいりませんで」と女中は風呂敷解きて夏蜜柑、袋入りの乾菓子、折り詰めの巻鮓など取り出す。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんまり歌ってなんだか渇いて来たよ」「お茶を持ってまいりませんで」と女中は風呂敷解きて夏蜜柑、袋入りの乾菓子、折り詰めの巻鮓など取り出す。",
              "citation": {
                "source": "小説　不如帰",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、紳士五、六人、酒肴を携えてここに遊び、終日歓を尽くし、帰るに臨んで僕に一包みを与え、借料の礼なりといい、「そのほか階上に肴の折り詰めを残しておいたが、これは貴方に与うるから晩食のときに食せよ」といいつつ立ち去った。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、折り詰めを開けば馬糞が詰めてある。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでにして僕、楼上にのぼりて床の間を探るに、果たして紙包みと折り詰めあり。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "折り詰めを開き見るに、土塊と馬糞あるのみ。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "揃いの水色の衣装に粗製の奴かつらを冠った伴奴の連中が車座にあぐらをかいてしきりに折詰をあさっている。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "折詰の飯に添えた副食物が、色々ごたごたと色取りを取り合せ、動物質植物質、脂肪蛋白｜澱粉、甘酸辛鹹、という風にプログラム的に編成されているが、どれもこれもちょっぴりで、しかもどれを食ってもまずくて、からだのたしになりそうなものは一つもない。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……其の後、つくし、餅草摘みに、私たち玉川へ行つた時、真似して、土を、麹一枚ばかりと、折詰を包んだ風呂敷を一度ふるつては見たものの、土手にも畦にも河原にも、すく／＼と皆気味の悪い小さな穴がある。",
              "citation": {
                "source": "玉川の草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "近在は申すまでもなく、府中八王子｜辺までもお土産折詰になりますわ。",
              "citation": {
                "source": "政談十二社",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご新造さんは一たん引込んでまた出て来た手には宴会の折詰のまだ紐で縛ったまゝのを持っていました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "客は会場の広室に溢れ、帳場にこぼれ、廊下に流れて、わやわやとざわめく中を、よけるようにして通って、一つ折曲る処で、家内総出で折詰の支度に料理場、台所を取乱したのを視ながら、また一つ細く成る廊下を縫うと、其処にも、此処にも、二三人、四五人ずつは男、女が往来う、彳む。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理場の前には、もう揃った折詰の弁当が堆く、戸を圧して並んだが、そこへ幹事が通りかかるのを見ると、蔭から、腰掛を立って、印半纏の威勢のいいのが顔を出して、「白尾さん。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この折詰を積んだ形が大一番の棺桶などは、どんなものです。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "又人間の心をもイヤに西洋の奴らは直線的に解剖したがるから、呆れて物がいえない、馬鹿馬鹿しい折詰の酢子みたような心理学になるのサ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八　浅井とお増とが、子供に贈る羽子板や翫具などをこてこて買って、それを帰りがけに食べた天麩羅の折詰めと一緒に提げながら、帰って来たとき、留守を預かっていたお増の遠い縁続きにあたる若い女が、景気よく入って来るその跫音を聞きつけて、急いで玄関口へ顔を出した。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "持ってきた折詰の弁当が渡された。",
              "citation": {
                "source": "仮装観桜会",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中で最も敬太郎を驚ろかしたのは、長春とかにある博打場の光景で、これはかつて馬賊の大将をしたというさる日本人の経営に係るものだが、そこへ行って見ると、何百人と集まる汚ない支那人が、折詰のようにぎっしり詰って、血眼になりながら、一種の臭気を吐き合っているのだそうである。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂車の附いてゐる車であるのに、持つて乗つたビイルの栓を抜いて、革包からコツプを出して飲んで、折詰のサンドヰツチをむしや／＼食つてゐる。",
              "citation": {
                "source": "魔睡",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "段々準備が手おくれになって済まないが、並の飯の方を好む人は、もう折詰の支度もしてあるから、別間の方へ来て貰いたいと云う事であった。",
              "citation": {
                "source": "百物語",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "弁当は菱屋で拵えてくれたもので、山女の塩辛く煮たのと、玉子焼と蓮根と奈良漬の胡瓜とを菜にして、腹のすいているわたしは、折詰の飯をひと粒も残さずに食ってしまいました。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お代りの蒲焼は二人ともにちっとも箸をつけなかったので、残して行くのも勿体ないといって、その二人前を折詰にして貰うことにしました。",
              "citation": {
                "source": "白髪鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "人力車に乗って帰る人が幕の内の折詰を膝の上に重ねて置いて、その煮染めの汁が浸み出して着物を汚したなどという話をたびたび聞いた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはやはり一人で留守番をして、おみやげの幕の内か口取の折詰めでも貰って、母や姉の口から芝居のはなしを聴かせてもらう方がむしろ楽しいのであった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの家でもその招待を受けたので、わたしは母に連れられて親類の人たちと一緒にゆくと、芝居はおそく始まって、ゆう飯には強飯の折詰をくれた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
