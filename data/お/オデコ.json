[
  {
    "uuid": "69e82be7-82be-5f7c-82f7-d6c6a471ba7d",
    "entry": "お凸",
    "reading": {
      "primary": "おでこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
