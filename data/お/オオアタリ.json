        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の市場分析はいつも的確で、今回の株価予測も大当たりだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "天気予報が「午後は雷雨」と報じていたが、まさにその通りで大当たりだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人が「あの二人は付き合っている」と予言したが、それが大当たりして驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 4,
        "gloss": "bumper crop",
        "register": "standard",
