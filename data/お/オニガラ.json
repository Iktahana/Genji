          "literary": [
            {
              "text": "……鬼殻焼が可いと言ふんです。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼殻焼を退治ようと言ふ、意気が壮なだけ実に悲惨です。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼殻焼……意気が壮なだけ何うも悲惨です。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海老の鬼殻焼はあるが亀の子の甲羅煮は今でさえないくらいだから、当時は無論なかったに極っている。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "海老の鬼殻焼のようなお料理が出ました。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほか海鰻の蒲焼に黒鯛の塩焼、鰕の鬼殻焼」「まるで品川へ行ったようだな」「はい、みな品川から夜通しで廻りますので。",
              "citation": {
                "source": "怪異暗闇祭",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも殻は決して伊勢蝦の鬼殻焼のように堅くはない。",
              "citation": {
                "source": "西洋の浜焼",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼殻焼きもいいし、そのまま薄醤油で煮てもよい。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
