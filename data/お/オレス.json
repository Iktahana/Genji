        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "西英ニユウ・フオレストの大森林地のほとりに小さなコツテエジを建てて、外相の劇職にあつた際も、週末の休みには必ず出かけて、太古の処女林そのままのあの深い森へ分け入つて、季節々々の鳴禽、幽禽の歌を聴くことを忘れなかつた。",
              "citation": {
                "source": "趣味としての読書",
                "author": "平田禿木",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に又復讐の神に追はれたオレステスを考へない訣にも行かなかつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に又｜復讐の神に追われたオレステスを考えない訣にも行かなかった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、お前の親友のフオレスチャ夫人ねえ、あの人の処へ行けば飾り位如何かなりそうなものだねえ、え？",
              "citation": {
                "source": "頸飾り",
                "author": "モウパンサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "フオレスチャ夫人は殊の外同情して、破璃戸の填っている戸棚から大きな宝石の函をとり出してロイゼルの前に開いた。",
              "citation": {
                "source": "頸飾り",
                "author": "モウパンサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロイゼル夫人はその頸飾りを携へてフオレスチャ夫人の処に返済すべくでかけた。",
              "citation": {
                "source": "頸飾り",
                "author": "モウパンサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "フオレスチャ夫人は冷やかな態度を示しながら、「もう少し早く返して頂きたかったですよ、これでもチョイチョイ入用なことがありますからね」　夫人は函を開きもしなかった。",
              "citation": {
                "source": "頸飾り",
                "author": "モウパンサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは忘れもせぬフオレスチャ夫人で、依然として若く美しく口元に微笑さえ湛えていた。",
              "citation": {
                "source": "頸飾り",
                "author": "モウパンサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "フオレスチャ夫人は真底から動かされてロイゼルの両手をしっかりと握った。",
              "citation": {
                "source": "頸飾り",
                "author": "モウパンサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "神に類するチュートラス、馬術すぐるるオレステス、　705アイトーロスのトレーコス、オイノマオスは之に次ぐ、オイノピデース・ヘレノスと耀き光る佩帶のオレスビオスは又次に――オレスビオスの住む處、ケーフィーシスの湖に隣りて特に豐沃のピューレー、之れの傍にボイオーチアの富民住む。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "140而して異日アルゴスの豐沃の地に歸る時、彼を養ひ子となして、富裕の生に育ちたるわれの末の子最愛のオレステースに劣るなく、彼を崇めむ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "率ゐるものはアーシオス、＊イアメノス又オレステス、アーシオスの子アーダマス、トオーン並にオイノモス。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "170僅か二人に過ぎざれど、討つか、あるひは討たるゝか、最後の時の到る迄彼等陣門たち去らず』117　XIII 384.129　I 163 II 741.129　II 740.130　II 745.139　イアメノスとオレステスとは後レオンチュウスに殺さる。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "續きて＊メノーン、イアメノス、オレステースを順々にレオンチュウスは勇を皷し大地の上に切り倒す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつは、そこのあの椈の幹の側に立つてゐたつけが――フオレスのヒイスの上でマクベスに現れた奴等の仲間みたいな妖婆です。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、もしウオレスやダアヰンが古い書物の中に事實と思想とを探すことに固執してゐたとしたら、植物や動物の進化といふ學問はどんなになつたらうか。",
              "citation": {
                "source": "革命の研究",
                "author": "ピョートル・アレクセーヴィチ・クロポトキン　Pyotr Alkseevich Kropotkin",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしよろしくばＯとＰと言うがいい、すなわちオレステスとピラデスと（訳者注　物語中のオレステスとその友人ピラデス。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしておんみは、おんみがしばしば彼れの悪夢を看護り、おんみが軽やかな、母のやうな手で恐しい夢を彼から追ひ却けた或る一人のオレストの感謝となるであらう。",
              "citation": {
                "source": "人工天国",
                "author": "Ｊ．Ｇ．Ｆ．に",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
