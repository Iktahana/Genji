        "examples": {
          "standard": [
            {
              "text": "高速道路に入ったところでオーバードライブに切り替え、燃費を抑えながら走行した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "そのトラックはオーバードライブギアに不具合があり、長距離走行中にエンジン音が異常になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "父は「長距離では必ずオーバードライブを使え」と口癖のように言っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
