        "examples": {
          "standard": [
            {
              "text": "彼はテストで60点取ったことを鬼の首を取ったようにクラスで自慢している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "父は庭の雑草を全部取り除いたことを鬼の首を取ったようにはしゃいでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女は家を掃除しただけなのに、鬼の首を取ったように得意げに見せびらかした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "破産した人間の土地を値切り倒して、それで時価よりも安く買えると彼は、鬼の首を取ったように喜んだ。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに僕もお情けながら大学を卒業して文学士とか何とか肩書の付いてみれば国元のような片田舎では鬼の首を取ったように思うのです。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
