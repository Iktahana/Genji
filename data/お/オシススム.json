        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二つの道の間に選ぶためにこそ努力は必要とせられるけれども、唯｜一筋道を自由に押し進むところに何の努力の助力が要求されよう。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花袋氏は人も知る其當時我國文壇の浪漫的幻夢的のものの行き方といさぎよく分れて、あくまで現實的に現實のままを客觀描寫風に太くたくましく押し進むといふ信念をも述べられ其行き方をとつて居られたが、お貞さんは其師風を最もよく呑みこみ同じ信念のもとに師のあとを進まれた。",
              "citation": {
                "source": "水野仙子さんの思ひ出",
                "author": "今井邦子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中段に構えて押し進む。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッ、タッ、タッ、タッと押し進む。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "せつせと押し進む艀の両側には、鰹からでも追はれて来てゐたか、波の表が薄黒く見ゆる位ゐまでに集つた※の群がばら／＼／＼と跳ね上がつた。",
              "citation": {
                "source": "岬の端",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "記憶を押し進むれば進むるほど、その面影は同じ程度に遠退いて、常にぼんやりした距離に立って居た。",
              "citation": {
                "source": "子を奪う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "と調子に確かめて膝押し進む。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "と善平は酔いに乗じて膝押し進む。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくして、自分のものする書も、自然中身本位となり、いきおい中身を磨き通しに磨いておらないと、良心が許してくれないというところまで押し進むものである。",
              "citation": {
                "source": "美術芸術としての生命の書道",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一々御尤も、そう言われると面目次第も御座らぬが、拙者にとっては八幡城を遁れて、山に入るのがせめても反逆で御座る――強力に存分に、思うところを押し進むる父上に、私風情が逆うことなど思いも寄らない」　頼門にとって、それはまことに本音でした。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "大名の倅",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹這いのままさらに押し進むと、彼は持ち上げた上半身を、それなり水の中へ落し込んでしまった。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勝助までが、左様にいうなれば、玄蕃の意にしたごうて、このまま、押し進むといたそう。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "気勢をあげて、押し進むと、途中で董卓の女婿の中郎将牛輔も、残兵五千をつれて、合流した。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
