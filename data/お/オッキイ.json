        "examples": {
          "standard": [
            {
              "text": "「わあ、大っきいケーキ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "大っきい声で挨拶をしなさい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は大っきいバッグを肩に担いで歩いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「――元よくこの辺翔んでいた――都鳥でしたっけか、白い大っきい鳥――ちっともいなくなっちゃいましたね、震災からでしょうか」　区画整理が始まって、駒形通りは工場裏のように雑然としている。",
              "citation": {
                "source": "九月の或る日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――お前ったら……おなかが大っきいんかい？",
              "citation": {
                "source": "小村淡彩",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大っきいのがいるぜ。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚みたいに大っきいお祖母さんだけれど、やさしいよ。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとおっきい声出しなさいよ。",
              "citation": {
                "source": "三月の第四日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
