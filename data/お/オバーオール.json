        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ブリキのように固くなったオバーオールが、三着。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜あけに起きて警戒しましょう、というのはどういうことをするのでしょうね　きのうは朝公共防空壕の修繕を隣組でやりました、国がオバーオール着て、鉢巻きして出ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子の能力は男子の七十パーセント以上である、近代重工業にもふさわしい、と云われて、女子の技術補導所があちこちにつくられ、女子整備員のオバーオール姿が婦人雑誌に出された時代である。",
              "citation": {
                "source": "郵便切手",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "むっくり起きて、オバーオールきてはちまきして薪ごしらえにかかった。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月十四日（日曜）　国オバーオールを着てウメをつれて、荷物出しに行く、自転車にのって。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋオバーオールを着て、ボギーな形で、荷運びをしたりしている。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもブタブタなオバーオールを着て、腕を捲り上げたお婆さんの命令のままに、パイプを銜えてのそのそと動いていたお爺さんを想うとき、この想像は一段と光彩を増すのである。",
              "citation": {
                "source": "一つの出来事",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
