        "examples": {
          "standard": [
            {
              "text": "お神輿が痛くて寝返りが打てない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "お神輿を傷めないように注意している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "お神輿の調子が悪いので医者に行った。",
              "citation": {
