    },
    "definitions": [
      {
        "index": 1,
        "gloss": "(someone's) assistance",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お陰様で無事に完成することができました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "皆さんのお陰様で目標を達成できた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "上司のお陰様でこの機会をもらえました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "お陰様で八時には今市へ着いた。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "お陰様で……」と平身低頭礼を言っている。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お嬢様が御厄介をかけまして、なんともお礼の申しようもございません、今晩お酒宴をしておりますうちに、興にまかせて、お歩きになったために、こんなことになりました、お陰様でお怪我もせずにすみました、奥様がどんなにお喜びになるか判りません、お立ち寄りを願います」　十丁あまりも往くとまた林がきた。",
              "citation": {
                "source": "崔書生",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度の航海にはしかしお陰様で大助かりをしまして、ゆうべからきわだってよくなりましてね」　と付け加えた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お陰様でわたしはさびしい世の中から救い出されました。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかといってお世話になった叔父様が、頭が変になったからって私一人が勝手なことをするのも嫌だったし……、でも、でもお陰様で病院に入れて頂いて、ほんとに安心しましたわ。",
              "citation": {
                "source": "白金神経の少女",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、お陰様で皆さんが心配して下さるもんですから、こんな体になつても、如何にかかうにかやつてゆけます。",
              "citation": {
                "source": "或る日の小せん",
                "author": "吉井勇",
                "note": "青空文庫"
              }
            },
            {
              "text": "指揮者も合唱者達も非常に驚いたが、その巧みな独唱に圧倒されて心からの賞讃を送り、お陰様でハイドンは、ひさしぶりの御馳走にありついて、たらふく詰めこむことができた。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お陰様で、ようく飲み込めました。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お陰様で、スッカリ気分も、直りまして……まことに有難うございました」　とお礼申し上げた途端に、言い出した夫人は引っ込みがつかなくなった。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はい、おかげさまで、二十二歳になりました。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんというか、まあ、お宅のような大家にあがって行儀見習いした者は、やはりどこか、ちがいましてな」すこし顔を赤くして笑い、「おかげさまでした。",
              "citation": {
                "source": "黄金風景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかげさまで、私は、いつも、そのことは忘れています。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二「おかげさまでだいぶ暖かくなりました。",
              "citation": {
                "source": "木曽の旅人",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかげさまで無事に稼いでおります。",
              "citation": {
                "source": "鷲",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかげさまで達者でございます。",
              "citation": {
                "source": "鷲",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「どうも、おかげさまで……此方だって、本当に食えないからやっているのに……」　青年は押し入れから出て来てそこへ坐った。",
              "citation": {
                "source": "街底の熔鉱炉",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おかげさまで二人とも元気だ。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありがとう、ソウムズさん、おかげさまでこの事件に目を向けることができました。",
              "citation": {
                "source": "三枚の学生",
                "author": "THE ADVENTURE OF THE THREE STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもおかげさまで飢えと寒さとの憂いがないだけ、まず結構な方です。",
              "citation": {
                "source": "水籠",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとうに今夜はおかげさまで助かりました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はい、おかげさまで、みんな達者でございます」「兄貴はまだ若いから格別だが、阿母はもう好い年だそうだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "湯屋の二階",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎は「ええ、ありがとう、おかげさまで」というようなことをまじめに答えながら、下を向いて、お猪口の葡萄豆をしきりに突っつきだした。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくの手柄じゃない」「おかげさまで」と美禰子が礼を述べた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私も、おかげさまで」と今度は原口さんが礼を述べた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかげさまで、危ういところをのがれました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "子持ちすずり",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おかげさまで――」「おてがらでござりましたか」「どうやら、一味徒党五人ばかりを捕えましたわい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときに、そちらのホシはどうでござった」「それもおかげさまで、しかし他言のできぬてがらでござります。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おめでたがござりまして、なによりでござったな」「おかげさまで……お用談はそれについて何か……？",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、おかげさまで。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
