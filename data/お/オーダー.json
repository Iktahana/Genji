                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オーダーを待つお客様のストレスを減らしたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
