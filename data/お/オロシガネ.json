    "definitions": [
      {
        "index": 1,
        "gloss": "grater (esp. the variety used in Japanese cooking to grate foods very finely)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生姜をおろし金でおろして、豆腐の上にのせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "おろし金の目が詰まってしまったので、ブラシで丁寧に洗った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "母はいつも料理の仕上げにおろし金で山葵を擦る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "最高の錦木とは、上等のかつおぶしの中心である赤身ばかりを薄く削ること、太いよいわさびを細かいおろし金で密におろすこと。",
              "citation": {
                "source": "夏日小味",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きのいい青黒の雄貝を、多量の塩で揉み固め、石のようになったのを、おろし金で薯をおろすようにおろし、それを自然薯と等半にすり混ぜて、とろろ汁をつくる。",
              "citation": {
                "source": "東京で自慢の鮑",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろのわたくしの日常の飲料は、　朝は起きぬけににんじんと林檎とをおろし金でおろしてしぼつた自家製ジュースを大コップに一杯飲んでゐるが衛生的な飲料としてばかりではなく、にんじんや林檎の新鮮なもののある間は甚だ美味である。",
              "citation": {
                "source": "飲料のはなし",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ぱんにミクサーにかけたものは味がよくない、朝のにんじんや林檎などもミクサーでは味が出ないから、おろし金を使はせることにしてゐる。",
              "citation": {
                "source": "飲料のはなし",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはおろしがねでおろしておく。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "大根おろしのおろしがねを巨大に引きのばしたような岩棚だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
