        "examples": {
          "standard": [
            {
              "text": "新茶のお茶っ葉の香りが台所に漂っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "良質なお茶っ葉を毎年取り寄せている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "お茶っ葉をつまんで香りを確かめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "かたかけと　よそ行きの　ぼうしを　みにつけ、　リービは　かごを　手に　また　おでかけ、　村のお店で　お茶っ葉　ひとつつみと　角ざとうを　５００グラム、　あと　マーマレードを　ひとびん　買うのです。",
              "citation": {
                "source": "パイとやきがたのはなし",
                "author": "THE TALE OF THE PIE AND THE PATTY-PAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「海老蔵もいいが、月形は熱心で、牧野の頭のいいところが感心だ」などと、お茶っ葉の提灯を持つ折助の若いのがいう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
