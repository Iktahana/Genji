          "literary": [
            {
              "text": "オソラク」と云った。",
              "citation": {
                "source": "雪ちゃん",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このオソラクが甲走った声であったので、自分はふと耳を立てると、男の声で「オソラクってそりゃ何の事だ。",
              "citation": {
                "source": "雪ちゃん",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガレボシ新美南吉　フユノ　サムイ　サムイ　ヨフケ、ヒユーン　ヒユーント　コガラシノ　フク　オソラノ　上ノ　ハウデ　三ツ　ナランダ　コドモノ　ホシガ、ケンクワヲ　シマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシモコレヲ不調和ト感ジル人ガアツタラオソラクソノ人ガカタカナヲ見ナレナイセイカ、ソウデナカツタラ数学ノ本デ十分ニ痛メツケラレタ記憶ヲ持ツ人ニチガイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ理由ハマダ自分デモハツキリワカラナイガ、オソラクヒラガナヲ構成スル線ガアマリニ不規則ナタメ、一定ノ法則ニ従ツテ様式化スルコトガ困難ナセイダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、カタカナハヒラガナヲ書ク場合ニ比シテ、オソラク半分ノ労力デスム。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ問題ハオソラクソノアトノ場合デアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オソラヲ　ミレバズンズントオ山ノ　上ヲワタノヨニウイテル　クモモトビマシタ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
