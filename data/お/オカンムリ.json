  {
    "uuid": "a217940d-4165-5ead-9347-a06e18677251",
    "entry": "オカンムリ",
    "reading": {
      "primary": "おかんむり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
