        "examples": {
          "standard": [
            {
              "text": "彼は何事もなかったかのように、一人で乙に澄ましている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "気まずい空気の中、彼女は乙に澄まして紅茶を飲んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "そんなに乙に澄ましていても、緊張しているのがバレバレだよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "さればとて古い人を新らしく捏直して、何の拠り処もなく自分勝手の糸を疝気筋に引張りまわして変な牽糸傀儡を働かせ、芸術家らしく乙に澄ますのなぞは、地下の枯骨に気の毒で出来ない。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "……｜乙に澄ますねえ、やい！",
              "citation": {
                "source": "ノンシャラン道中記",
