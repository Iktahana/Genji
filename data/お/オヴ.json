        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「それとも、着物のままはひつて、ずぶ濡れの姿で貴公子と逢つて、ふたりでストオヴでかわかしたのかな？",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶店では、ストオヴを備へた。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お仕事のときは、ストオヴの傍でなさつたら。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオヴェルニュのクレエルモン・フェラン市にシブレエ博士と呼ぶ眼科の名医が居た。",
              "citation": {
                "source": "女人訓戒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一枚のマントはプリンス・オヴ・ウエルスの、海軍将校としてのあの御姿を美しいと思って、あれをお手本にして造らせました。",
              "citation": {
                "source": "おしゃれ童子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども他の船客たちは、私と反対に、むくりむくり起きはじめ、身仕度にとりかかるやら、若夫人は、旦那のオオヴァを羽織って甲板に勇んで出て見るやら、だんだん騒がしくなるばかりである。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」赤いオオヴァを着た十歳くらいの少女が、傍の紳士に尋ねている。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と私が階下のストオヴにあたりに行くたんびに、さう尋ねる。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロオヴィス王の時代に、既にもうそこのベッドで死んだ者が數人あつた位だ。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちは泥棒したさかい、あかんけど、姉ちゃんは鳩やわ」　飛んで出るから鳩だというチマ子の声の明るさに、陽子もほっと心に灯がともって、「じゃ、ここを出たら、あんたの使をしてくれというわけね」「モチ、コース……」　モチは勿論のモチ、コースはオヴ・コース（勿論）のコース。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "庄平、十吉（合唱する）「友を選らばば書を読みて、六分の侠気四分の熱……」壁のベエトオヴェンのデス・マスクは歌わない。",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "コスモポリタンとかレビュー・オヴ・レビュースとかさういふ雑誌を見せられて世界の出来事を話され、又パリのサロンの写真帳をひろげて、アムプレショニズムやポアンティリズムの講釈を聞かされた。",
              "citation": {
                "source": "蓑田先生",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも仕合せなことに、ガス・ストオヴが薔薇色の炎を輝し乍ら盛にたかれているのを見て井深君はホッとした。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　更紗の前かけをかけたひねこびたような女給が、二人がストオヴの傍の食卓へ着くのを待ってそう云った。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、御飯がすんだら、少し火のそばで暖まろう――」　井深君はそう云い乍ら椅子をガス・ストオヴの前へ引き寄せた。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」と井深君は薔薇色をしたストオヴの中を見たままで云った。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る日、日が暮れたばかりでね、私はやっぱり銀座通りを散歩していた……」と井深君は両手の指を膝の上でくみ合せ乍らストオヴの方へ向いたまま話しはじめた。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "乾きかけたオヴァオールから酸っぱい汗の臭いが蒸れ立って何とも云えぬ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "連中は〈ゲット・オフ・オヴ・マイ・クラウド〉をかけていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、〈サティスファクション〉で聴かれる、この時代に、こんなものが存在するのが信じられない、ばかげたドラム・ブレイクにくらべれば、〈ゲット・オフ・オヴ・マイ・クラウド〉のイントロのドラムは、はるかにパワーがある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キンクスの〈ユー・リアリー・ガット・ミー〉や、ボビー・フラー・フォーの〈アイ・フォウト・ザ・ロウ〉のような、そして、この〈ゲット・オフ・オヴ・マイ・クラウド〉のような、ギターコードでゴリゴリ押しまくる曲は、慶一は、とりあえず無条件で好きになる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈ハート・フル・オヴ・ソウル〉といってほしい。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「追い出しの曲」は、予定どおり、アニマルズの〈ウィーヴ・ガッタ・ゲット・アウト・オヴ・ディス・プレイス〉（〈朝日のない街〉！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "）も、バリー・サドラー軍曹の〈ザ・バラッド・オヴ・グリーン・ベレー〉も、みんな無視することに決めた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "６おれたち、ここから抜け出さないとたとえ、そんなことなど、できないとしても〈ウィーヴ・ガッタ・ゲット・アウト・オヴ・ディス・プレイス〉アニマルズ　興奮と憂鬱が同時に押しよせて、一九六六年六月が終わりつつあった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高志が見ている列のわきには、ジョニー・リヴァーズのＬＰと、マインドベンダーズの〈グルーヴィー・カインド・オヴ・ラヴ〉、シェールの〈バン・バン〉がおいてある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "中近東みたい」　慶一は、ヤードバーズの〈ハート・フル・オヴ・ソウル〉といい、これといい、ビートルズといい、このところ中近東ばかりだ、と考えた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、こいつら、という顔をして、高志が天井を見あげ、右手を伸ばし、じぶんの顔のまえにかざして、「イン・ザ・ネイム・オヴ・ザ・ブラック・マザー・オヴ・ダークネース」　と、カイリの呪文をとなえた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝たら、起きなくていいよ」　半月ほどまえに初登場したと思ったら、すぐに日になんども耳にするようになった、〈ア・ホワイター・シェイド・オヴ・ペイル〉の、冷たく澄明なオルガンが流れはじめた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
