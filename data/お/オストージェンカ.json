          "standard": [],
          "literary": [
            {
              "text": "十一月六日（火曜）細雨　今日Ｙ、オストージェンカへ引越。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "金をとりオストージェンカへおいて、又出かく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オストージェンカでＹがかえるまで一寸眠った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔日付なし〕〔映画館「チャールイ」の入場券貼付〕　これこそ我等にとって忘れがたきオストージェンカ生活の記念だ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は出かけて、オストージェンカの通りのチャールイでいろいろ下らぬのや下るのを見る。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
