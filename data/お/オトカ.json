        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "有名な歴史家ランケの弟子オトカル・ローレンツは、かくの如き家族系圖學的年數計算の基礎の上に、『歴史的時代の自然的體系』を打ち建てようと企てた＊＊。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "このやうにしてオトカル・ローレンツは歴史の端初を「國家に於て活動する人間の出現」のうちに、或はエドゥアルト・マイヤーは嘗てそれを「一民族の生活の中へ侵入する要素としての個人の進出」のうちに見た。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤ブドー酒、オトカ、キューリ、カプースタ〔キャベツ〕、鶏、腸詰、クルミ、干アンズ、サモワール　○ニキーチナ夫人のスボートでは二十一日に話すことになった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "テーブルの上には食べ残された卵子の目玉焼きのはいっている焼き鍋や、食いさしのパンや、底のほうにほんのちょっぴり残っている地上の幸福（ウオトカ）の小びんなどが載っていた。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこぢや、毎晩のやうに、ウフトムスキイとウオトカを飲んだもんだ。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "シガー一本、ウオトカ一杯やったあとのあなたは、もはやソーリン氏ではなくて、ソーリン氏プラス誰かしら、なんです。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（退場）ドールン　ああして行って、午食の前に〔ウオトカを〕二杯ひっかけるんだ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（足早に退場）トリゴーリン　（手帳に書きこみながら）かぎタバコを用い、ウオトカを飲む。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもきまって、ウオトカかコニャックですわ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリーナ　ウオトカならあがるんでしょう。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーストロフ　いいや、ウオトカも毎日はやらない。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ――ウオトカをあがるからねえ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして……とてもとても……（下男に）君すまないが、ウオトカを一杯たのむよ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして僕は……（下男がウオトカのグラスを盆にのせてくるのを見て）だがしかし……（飲む）もう行かなけりゃならん。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリーナ　では、ウオトカでも一つ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリーナ　（ウオトカの杯とパンを一きれ載せた盆をささげて戻ってくる）さあさ、めしあがれ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーストロフ、ウオトカを飲む。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトカを飲まして頂戴。",
              "citation": {
                "source": "つゆのあとさき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌劇一座の俄国人男女数名来りて頻にウオトカ酒を飲む。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、露艦の水兵がウオトカの空罎を日本人にくれたというので、通詞の森山栄之助があわてて飛んできた。",
              "citation": {
                "source": "空罎",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "またその大國のフチの女のオトカリバタトベと結婚して、お生みになつた御子は、イハツクワケの王・イハツク姫の命またの名はフタヂノイリ姫の命のお二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
