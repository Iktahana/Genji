        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "おばあちゃんから幼物語をよく聞かされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は幼物語を面白おかしく語ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その幼物語は今でも家族の間で有名だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それから、あの『ふるさと』を書いたのはもはや二十二年前、『おさなものがたり』を出したのは十八年前にもなりますよ。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆さんの中には、わたしの『ふるさと』や、『おさなものがたり』を読んでみてくだすったかたもありましょうか。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
