        "examples": {
          "standard": [
            {
              "text": "清流の縁に自生する和蘭芥子を摘んで、サラダの付け合わせにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "和蘭芥子はぴりっとした辛みと爽やかな香りがあり、ステーキの付け合わせとして重宝される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "川べりを散策していると、石の隙間から和蘭芥子が群生しているのを見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "仕方がないので、和蘭芥子を買ってくる。",
              "citation": {
                "source": "鉄道模型の夜",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "和蘭芥子を束のままでねじ切ってあえ、オリーブ油をかけておく。",
              "citation": {
                "source": "鉄道模型の夜",
                "author": "円城塔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
