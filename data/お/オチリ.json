        "examples": {
          "standard": [
            {
              "text": "転んでおちりを思い切り打ちつけ、しばらく立ち上がれなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「おちりをちゃんと拭いた？」と母が小さな子どもに聞いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長時間座っていたせいで、おちりが痛くて仕方がなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "おちりにあんぽんたんはどうどす……。",
              "citation": {
                "source": "螢",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然彦根育ちの登勢にはおちりが京塵紙、あんぽんたんが菓子の名などと覚えねばならぬ名前だけでも数えきれぬくらい多かったが、それでも一月たつともう登勢の言葉は姑も嗤えなかった。",
              "citation": {
                "source": "螢",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
