          "literary": [
            {
              "text": "やっとそれが私の心に入ってきた、――無理に押し入った、戦き震える理性に焼きつけた。",
              "citation": {
                "source": "落穴と振子",
                "author": "THE PIT AND THE PENDULUM",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐怖のためにわれを忘れたのであろう、非常な力でしがみついてくる花世の、おののき震える、柔らかな躯を、両腕でひっしと抱き緊めながら、――これで叔父の死躰も、ゆくべきところへゆく、ということを思った。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
