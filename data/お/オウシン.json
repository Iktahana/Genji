        "examples": {
          "standard": [
            {
              "text": "返信用の往信ハガキに必要事項を記入してポストに投函した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "往信と返信がセットになったハガキを受け取り、アンケートに回答した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "往信欄に記入漏れがあったため、返信が届かなくなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "私は黙って、眼瞼をパチパチやらせながら、その光景を眺めていましたが、彼の自白を一往信用するとしても、まだ私には腑に落ちないことだらけでした。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
