        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "浜口首相狙撃さる――さういふ新聞通信を見た時、私は修証義を読みつゝ行乞してゐた、――無情忽ちに到るときは国王大王親眤従僕助くるなし、たゞ独り黄泉に赴くのみなり、己れに随ひゆくは善悪業等のみなり。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち彼らは尊王親幕に始まり、尊王倒幕に終りしなり。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
