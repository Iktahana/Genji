  {
    "uuid": "c1a2be09-dad6-5efc-902a-97e970d77f2e",
    "entry": "応信",
    "reading": {
      "primary": "おうしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "八百屋のお柚の（釈縁応信女。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "他領域に就いては他領域の専門家の仕事を一応信用してかかるというならば、それはそれで当然なことでもあるし必要なことであるが、併し他領域の専門家を信用するにも、どれを信用しどれを信用しないかは、自分の責任だ。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "技術を「労働手段の体制」と想定してかかるのは、無論相川氏一人の場合だけではない、寧ろ今では唯物論者の多くがこの想定に一応信頼しているように見受けられる。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "平次は一応信太郎の死骸を見せて貰いました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "その熱心によって一応信長の誤解を解くことが出来たのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈この男は贋医者じゃないのか〉　実際に病院の中で、白い診察衣を着て、聴診器でも持っていれば、一応信用出来る。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "平次は一應信太郎の死骸を見せて貰ひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
