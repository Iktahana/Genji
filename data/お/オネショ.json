          "standard": [
            {
              "text": "ところで完全に忘却してしまう位いのものならば初めから智恵づかない方が軽便でいいともいえるが、もし自分の子供が二十歳に及んでなお寝小便をたれるという事があったら悲しむべき状態である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "ところで完全に忘却してしまう位いのものならば初めから智恵づかない方が軽便でいいともいえるが、もし自分の子供が二十歳に及んでなお寝小便をたれるという事があったら悲しむべき状態である。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "――法皇、上皇のお寝小屋でも、恟々と何かおささやきが洩れ、ひとしくどこの寝小屋もよくお眠りではなかったらしい。",
              "citation": {
                "source": "私本太平記",
                "author": "新田帖",
                "note": "青空文庫"
              }
            }
          ]
        }
