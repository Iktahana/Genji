        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "願いを込めて千羽の折り鶴を折る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "机の上に小さな折り鶴が置かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "母が病気の回復を祈って折り鶴を作ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "風のない日は縁側の日向へ出て来て、紙の折り鶴をいくつとなくこしらえてみたり、秘蔵の人形の着物を縫うてやったり、曇った寒い日は床の中で「黒髪」をひくくらいになった。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "余はその罪のない横顔をじっと見入って、亡妻のあらゆる短所と長所、どんぐりのすきな事も折り鶴のじょうずな事も、なんにも遺伝してさしつかえはないが、始めと終わりの悲惨であった母の運命だけは、この子に繰り返させたくないものだと、しみじみそう思ったのである。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "封筒は正月らしい色どりで若松に折り鶴が刷られたもの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……懐紙の、白い折鶴が掌にあった。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ほっと吹く息、薄紅に、折鶴はかえって蒼白く、花片にふっと乗って、ひらひらと空を舞って行く。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　指の細く白いのに、紅いと、緑なのと、指環二つ嵌めた手を下に、三指ついた状に、裾模様の松の葉に、玉の折鶴のように組合せて、褄を深く正しく居ても、溢るる裳の紅を、しめて、踏みくぐみの雪の羽二重足袋。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その枝のさき近々と窓の前にさしいでたれば、広岡のかの君は二階にのぼりて、此方の欄に掴まりたるわが顔を見て微笑みたまいつつ、腕さしのべて、葉さきをつまみ、撓いたる枝を引寄せて、折鶴、木※、雛の形に切りたるなど、色ある紙あまた引結いてはソト放したまう。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰げば白きもの仄見ゆる、前の日雨ふりし前なりけむ、姉上の結びたまいし折鶴のなごりなり。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　自動車を引戻し、ひらりと下りるのに、私も続くと、雨にぬれた草の叢に、優しい浅黄の葉を掛けて、ゆら／＼と咲いたのは、手弱女の小指さきほどの折鶴を乗せよう、おなじく折つた小さな薄黄色の船の形に連り咲いた花である。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "折鶴行灯のかげにとつおいつ娘ごころの羞しや何と答もしら紙の膝のうへにて鶴を折る。",
              "citation": {
                "source": "桜さく島",
                "author": "春のかはたれ",
                "note": "青空文庫"
              }
            },
            {
              "text": "金で大きく蓋の上に定紋の折鶴を現はした手匣とともに、今は亡き父の記念品となつて、病院の枕元に置かれてある。",
              "citation": {
                "source": "天滿宮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞妓は椿餅にも飽きたと見えて、独りで折鶴を拵へてゐる。",
              "citation": {
                "source": "京都日記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "其がまつたく折鶴から飛躍的に進んだ立派な芸術品であつたからである。",
              "citation": {
                "source": "智恵子の紙絵",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お堂の中には、小指の先ほどの括り猿や、千代紙で折った、これも小さな折鶴を繋いだのが、幾つともなく天井から下っています。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは千代紙を智恵子にあたえ、精神病の人に紙の細工が心をしずめるということを聞いて、それで折鶴などを作るあわれな智恵子に、ふたたび不思議な愛情を感じた。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何をするんだえ、いやらしい、巫山戯たことをすると、岡っ引だって勘弁しないよ」　と言うのを引寄せて、グイと掴んだ女の腕をしごくと、二の腕に赤々と朱彫の折鶴。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "七人の花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "巫山戯たことをすると、岡ツ引だつて勘辨しないよ」　と言ふのを引寄せて、グイと掴んだ女の腕をしごくと、二の腕に赤々と朱彫の折鶴。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "七人の花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "桔梗の花を思わせるような娘の俤は、いまでも朧げには眼に浮ぶし、さっさっと裾さばきの凛とした歩きぶりなどは鮮やかに思いだせるが、その娘が自分を恋いわびて、病む人のように寝たり起きたりしているとか、泣きながら独り折鶴を作っているとかいうことは、どう想像しても現実感が伴わないのである。",
              "citation": {
                "source": "ひやめし物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬひは身ぶるいをしながら振向いたが、良人が立っているのを見ると赤くなって折鶴を隠した、「まあ少しも存じませんでした。",
              "citation": {
                "source": "ひやめし物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯島の家に着くと、おくみに手をひかれて、出迎えていたかよが、片手に赤い折鶴を持って、いきなり甲斐に抱きついて来た。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとかよはすぐに、甲斐の膝へ腰をかけて、かよたんが折ったのよ、と持っていた折鶴を見せた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、これを持って、ばあやと向うで遊んでおいで」と甲斐が云った、「たあたまは人に会わなければならないからね、あとでまた遊ぼう、なにをして遊ぶか考えておいておくれ」　かよはおとなしく膝からおり、ふくらんだ折鶴の羽根を摘んで持って、その部屋を出てゆき、自分で襖を閉めた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに若葉色の鼻緒がすがり、同じ緑のつま皮に赤い折鶴が一羽、あざやかに浮き出ていた。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "折鶴　清洲城はここ毎日、登城の列、下城の人馬で、凡ならぬ光景を見せていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄以も弱って、意にまかせていると、さらに、うしろに身をかがめていた乳人が、そっと三法師の手へ色紙で折った折鶴を持たせて、玄以の耳を救った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして手にしていた折鶴を列座の諸侯のまん中へ抛ってしまった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の無い日は縁側の日向へ出て来て、紙の折鶴をいくつとなくこしらへて見たり、秘蔵の人形の着物を縫うてやつたり、曇つた寒い日は床の中で「黒髪」を弾く位になつた。",
              "citation": {
                "source": "『団栗』のことなど",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は其罪のない横顔をぢつと見入つて、亡妻のあらゆる短所と長所、団栗のすきな事も折鶴の上手な事も、なんにも遺伝して差支へはないが、始めと終りの悲惨であつた母の運命だけは、此児に繰返させ度くないものだと、しみ／″＼さう思つたのである」。",
              "citation": {
                "source": "『団栗』のことなど",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "七夕祭　日時計は午后を指してゐる、西班牙国せびゐるびとそてろは物珍しげに、竹に金銀短冊をさげ、晴衣をさげ、折鶴をさげ、軒軒に挿し、さては花火をあげ、はるか、宙の乳街を祝ふ異風の祭の中にたたづんでゐた。",
              "citation": {
                "source": "仙台の夏",
                "author": "石川善助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
