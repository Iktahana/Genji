        "examples": {
          "standard": [
            {
              "text": "ショッピングモールの男便所が長蛇の列で驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "男便所の標識が少し見えにくくて、迷いそうになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "清掃員が男便所を磨いてくれていたので、気持ちよく使えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "腰が曲らないと云うので、男便所の方で後むきに体をささえてやる。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤッ……これあどうも……最前から平気で色眼鏡を外したり、僕と一緒に男便所へ入ったりされるから真逆と思っておりましたが……ハハア……貴女がサイ・メイ・ロン君の青紅嬢で、同時にＲの四号君。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに男を汚ながることは無類で、男便所の前は鼻をつまんで通るくらゐですから、男のきり端にも觸れるこつちやありません」「そんな女は時々あるといふことだよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "妾の貞操",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽屋の男便所に張り紙がしてある。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
