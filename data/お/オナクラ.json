        "examples": {
          "standard": [
            {
              "text": "「あの子、去年まで同クラだったんだ。久しぶりに廊下で会ったよ」と彼女は言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "同クラの友達と放課後に図書館へ行き、試験勉強を一緒にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "卒業式の後、同クラのグループチャットに集合写真を投稿したら、すぐに返信が殺到した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "慶四郎君は、私と小学校が同クラスであった。",
              "citation": {
                "source": "雀",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は日本人として古典語を学ぶのは中々困難であると申上げると、それでもお前と同クラスの岩元君はギリシャ語を読むではないかとのことであった。",
              "citation": {
                "source": "明治二十四、五年頃の東京文科大学選科",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
