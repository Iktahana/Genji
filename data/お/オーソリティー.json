        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その分野では彼はオーソリティーとして認識されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医学の専門家としてのオーソリティーを持つ医師だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オーソリティーのある出版社から本を発行することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "」「さア、承って居りませんですが」「もし何でしたら　その方にでも伺って見たら又　何とか……」　自分　たまらなくなって「オーソリティーの問題じゃない」という。",
              "citation": {
                "source": "無題（九）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男性の芸術家は女性を描く、これにオーソリティーを認める。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな事からつぎつぎに空想をたどりながら、私は人間のあらゆる知識に関するいわゆるオーソリティというものの価値に考え及んだ。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの清少納言のオーソリティが九百年もそのままに保存されて来たとすると、自然界に対する日本人の知識がいかに長い間平和安穏であったかという事を物語っている。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆるオーソリティは彼自身の頭蓋骨以外にはどこにも居ないのである。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しあわせな事には世の中では論理的の証明はわりに要求されないで、オーソリティの証言が代用されそのおかげで物事が渋滞なく進捗するのであろう。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "次には念のためにいろいろの人の話を聞いてみても、人によってかなり言う事がちがっていて、だれのオーソリティを信じていいかわからなくなってしまう。",
              "citation": {
                "source": "案内者",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし案内者や先達の中には、自己のオーソリティに対する信念から割り出された親切から個々の旅行者の自由な観照を抑制する者もないとは言われない。",
              "citation": {
                "source": "案内者",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "少なくも責任の半分以上は彼らのオーソリティに盲従した後進の学徒に帰せなければなるまい。",
              "citation": {
                "source": "案内者",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが第一義でありまた最大の難事であるのに、われわれの目は伝統に目かくしされ、オーソリティの光に眩惑されて、天然のありのままの姿を見失いやすい。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校を出てからも、僕の旧師でありかつ陸軍でのフランス部のオーソリティであった某陸軍教授を訪ねて、陸軍大学への就職を頼んだこともあった。",
              "citation": {
                "source": "続獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分以外になん等のオーソリティなしに暮らしたいのだ。",
              "citation": {
                "source": "浮浪漫語",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンチはイタリーではカルーゾーと並び称せられるテナーで、非常に美しい声を持ち、彼のオペラ「仮面舞踏会」は世界一だと評判されたテナーで、ベル・カントのオーソリティといわれた偉大な音楽家なのです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
