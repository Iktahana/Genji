          "literary": [
            {
              "text": "けれども兄神は弟神の幸福をねたましく思って、さもいまいましそうに、「そんな約束はした覚えがないよ。",
              "citation": {
                "source": "春山秋山",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟神はくやしがって、おかあさんの女神の所へ行っていいつけました。",
              "citation": {
                "source": "春山秋山",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リオブランコ」に於ても、同じく月を女神とし、太陽を其兄弟神とす。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかに兄弟神話はというと大ナムチとスクナヒコナが同一神の大国主をさしているらしいのが神話中の第一の大物で、次に神武天皇紀が登場人物の多くにわたって両面的に、フタゴ的である。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛騨・高山の抹殺――中部の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれここにその弟神沼河耳の命、その兄の持てる兵を乞ひ取りて、入りて當藝志美美を殺せたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
