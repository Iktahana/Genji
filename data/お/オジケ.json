        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何だか高価さうな気もして急にオジケも感じたが、こんな時でゞもなければ義侠の快は味はゝれない……で、思ひ切つて、「うむ、宜しい。",
              "citation": {
                "source": "坂道の孤独参昧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "次で「新青年」で同時当選した者として一度手紙でも出して見ようかと幾度も思ったのであったが、作品から受けた私の「オジケ」た気持がそれをなし得ず一度の文通もせず氏は故人となられた次第である。",
              "citation": {
                "source": "探偵小説思い出話",
                "author": "山本禾太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
