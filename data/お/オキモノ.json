  {
    "uuid": "e4ea5f24-23ac-50a1-b345-f564a74adf7c",
    "entry": "置き物",
    "reading": {
      "primary": "おきもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
