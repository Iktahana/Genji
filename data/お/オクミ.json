    "definitions": [
      {
        "index": 1,
        "gloss": "gusset (esp. in kimono)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "着物の袵が少しほつれているので、縫い直さないといけない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "袵の幅を調節することで、着物のシルエットがより美しく見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "慣れない手つきで着物を畳んでいたら、袵の重なる部分がぐちゃぐちゃになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "前下りに結んだ三尺がだらしなく、衣服の袵が披つて、毛深い素脛が遠慮もなく現はれる。",
              "citation": {
                "source": "刑余の叔父",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "金の章宗の承安五年（西暦一二〇〇）に、女眞人・漢人等の拜儀に就いて議論があつた時、司空の完顏襄が、今諸人袵髮皆從本朝（金）之制。",
              "citation": {
                "source": "支那人辮髮の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に舞台面の装置、背景、光線の使用｜等が巧く出来て居るし、役者の扮装も、初の幕から義士が討入の晩の装束をして居たり、左袵に着て居たりする間違は多いにしても、大体に配色が巧であるから見た眼の感じが快い。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと袖を縫って袵をぬって衿をつければよろし。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "袖付や袵の皺が苔でも置いたようなしっとりした青味の谷をつくって、いうにいえないいい味わい……帯はね、蝦夷錦の金銀を抜いて、ブツブツの荒地にしたあとへ、モガルの色糸で、一重蔓小牡丹の紋をいたずらでもしたようにチラホラ散らしたという……お話中……わからないひとねえ、お話中だと言ってるじゃありませんか。",
              "citation": {
                "source": "猪鹿蝶",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "正に是連袵幃を成し挙袂幕を成し渾汗雨を成すの壮観なり。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "七宝焼で丸に美の字の徽章を袵元へ付けました。",
              "citation": {
                "source": "美術学校時代の岡倉先生",
                "author": "板谷波山",
                "note": "青空文庫"
              }
            },
            {
              "text": "お咲の下に着ている単衣の襟と、片方の袵が裂かれて、かたいかたい三組の繩によられていたのである。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大谷袵子姫とクラスメートたることを誇つてゐたが、一年足らずで淪落のふちに落ちて行つた。",
              "citation": {
                "source": "女子文壇の人々",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "袵ニモブルーノ裏ガチラツイテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この廖立は、孔明の死を聞くと自己の前途を見失ったように嘆いて、　――吾終ニ袵ヲ左ニセン　といったということである。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の勢に乘じて、立所に一國一城の主と志して狙をつけたのは、あらう事か、用人團右衞門の御新姐、おくみと云ふ年は漸う二十と聞く、如何にも、一國一城に較へつべき至つて美しいのであつた。",
              "citation": {
                "source": "片しぐれ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おくみ　　孤児の女中、もと良家の娘、源兵衛の許嫁。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "花道よりおくみ、風呂敷包を抱え宿入り姿で出て来る。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）おくみ『ああ、焦れる、焦れる。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）おくみ『「忘れまいぞえあのことを」「忘れまいぞえあのことを」（此の言葉を言うとき念仏の句調、以後同じ）ああ、わたしとしたことが、また瞋恚の焔炎に心を焼かれ勿体ないお上人さまをお恨み申そうとしかけていた。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "源兵衛さんに逢わずに往んでは、それこそ此の胸が焼け尽してしまうわ』（おくみ、決心してすっくと立上る。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつの間にか蓮如上人弟子の竹原の幸子坊一人供につれ、上手奥より出て来て様子を見て居たが、おくみが立上る途端に上人は進み出て）蓮如『おくみ、そりゃわしより源兵衛に逢うて行くがよい。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは汚ない年寄りじゃものなあ』（おくみ、びっくりして、それが蓮如上人だと判ると、がばと突き伏す）おくみ『まあ、お上人さま。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ忘れてならぬのは六字の名号じゃぞよ』（おくみ、起上って合掌）おくみ『お慈悲は身に染みて身体が浮くようでございます。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しその御名号が唱えられぬばっかりに、一度お上人さまにお目にかかってお教えを頂こうと存じましてお探し申して居りました』蓮如『ふむ、それは気の毒とも何ともはや、さては信心退転でもいたしたか』おくみ『退転どころではござりませぬ。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女人と言えども天晴れな御同行の一人じゃぞ』おくみ『それでは「忘れまいぞやあのことを」でも大事ございませぬか』蓮如『そなたに限って大事ない。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "安心して唱えやれ』おくみ『やれ有難や忝けなや。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何遍でも唱えさして頂きます』（合掌して蓮如を拝む）蓮如（合掌して拝を受けながら）『しかしおくみどの。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "迚ものことにそう唱えしゃっしゃれ』おくみ『「忘れられぬぞあのことを」でござりまするか。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お上人さま』蓮如『まあ待ちやれ、おくみ、そなた何ぞ、も一つ忘れたものはありはせんかの』おくみ『はて、忘れたものとは』蓮如『さあ忘れたものとは』おくみ『何のことでございます』蓮如『そなたに取ってあの世の往生は定まった。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し此の世でいっち慕わしいお人に逢わんで往んでも大事ないか』おくみ『あれ、御慈悲の有難さに源兵衛さんのことは、いつの間にやら忘れていた。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはこれで訣れるとしよう』おくみ『何から何まで御心くばり、有難うて涙がこぼれます』蓮如『では、まめに暮しなさい』（蓮如行きかける。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "松明は要らぬと申すに』幸子坊『でも』蓮如（おくみの方を目配せつつ）『幸子坊、師の命を背かるるか。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは飛んだ失礼、では捨てまするでござりまする』（幸子坊、おくみの方へ松明と火打袋を投げやる。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
