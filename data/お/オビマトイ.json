          "literary": [
            {
              "text": "けれども臍帯纏絡と云って、俗に云う胞を頸へ捲きつけていた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "臍帯纏絡の変状は、御米が井戸端で滑って痛く尻餅を搗いた五カ月前すでに自ら醸したものと知れた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども臍帶纏絡と云つて、俗に云ふ胞を頸へ捲き付けてゐた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "臍帶纏絡の變状は、御米が井戸端で滑つて痛く尻餠を搗いた五ヶ｜月前既に自ら釀したものと知れた。",
              "citation": {
                "source": "門",
