        "examples": {
          "standard": [
            {
              "text": "若い頃はよく大口を叩いて、先輩に叱られたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はいつも大口を叩くが、結局何も成し遂げない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プロジェクトが成功するまでは、あまり大口を叩かない方がいい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "甚兵衛は、日頃大口を叩くが、戦場では殊のほか手に合わぬ男じゃ」という噂が陣中に伝わったらどうしようかと考えた。",
              "citation": {
                "source": "恩を返す話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "平然として取らせながら、「玉菊のお吉でござんすなどと、大口を叩くお前だが、やっぱり女十八番の、喚いて泣いて胸倉を取って、こづき廻して引っ掻いて……という醜態をさらすそうな。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大口を叩くようだが史家村一の旧家、親代々からの大名主だ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
