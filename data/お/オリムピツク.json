        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "青木は少し空腹を感じて来たところで、オリムピツクへ入つて休むことにした。",
              "citation": {
                "source": "二つの失敗",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日の極東オリムピツクも大体吾軍の勝利であつた。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂの表紙には、プラトンがオリムピツクの学芸会で「芸術否定論」を発表してゐる姿、裏は――未だ無地で、何を描かうかと此頃でも考へてゐる――「喜劇論」に関する抜萃帳である。",
              "citation": {
                "source": "真夏の夜の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人影は非常な勢ひで、オリムピツクの選手の如く速に此方へ駆けて居ります。",
              "citation": {
                "source": "青白き公園",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生は狂人の主催に成つたオリムピツク大会に似たものである。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌七年はロザンゼルスでオリムピツクのあつた年であるが、その七月十五日の朝、彼女は眠から覚めなかつた。",
              "citation": {
                "source": "智恵子抄",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりオリムピツク敷地一見。",
              "citation": {
                "source": "五百五十句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
