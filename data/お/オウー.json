          "literary": [
            {
              "text": "仙太、いきなりオウー！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "井上　オウー（こうなれば敵しないと見て取って、構えながら塀外へ向って叫ぶ）仙太、仙太郎！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウーイ」　新九郎はそこから声を揚げはじめた。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オウーイ」　答えはない。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "孫子一「おおうーいっ」　此方の山で呼ぶと、向うの山でも、「オウーイ」　と、遠く答えてくる。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オオウーイ」　不意にすぐ近くの闇の中で、こう呼ぶ者の声が水へ響いて行ったので、弦之丞は陸へ引き揚げられてあった過書舟の底へ身を退いて、その陰から様子をうかがっていた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オオウーイ」　続いて別な声がまた呼ぶと、木魂返しに向うからも、応ーッと答える声がする。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
