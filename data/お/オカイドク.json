        "examples": {
          "standard": [
            {
              "text": "このスーパーは週末に商品がお買い得になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その家具はセール期間中でお買い得だったので購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "母はいつもお買い得な商品を探してまわっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "特にグラフィック関係は相当強力そうだし、一六万八〇〇〇円という価格も、かなりお買い得といった印象を与えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレビを見ているとテレホンショッピングのコーナーで今朝の小柄なセールスマンが登場し、今日のお買い得商品を宣伝している。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
