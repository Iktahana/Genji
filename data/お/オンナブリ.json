    "definitions": [
      {
        "index": 1,
        "gloss": "woman's looks",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの人の女ぶりに誰もが目を奪われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女の女ぶりにみんな見惚れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その写真に映っている女ぶりは若々しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "家の内では王主人の媽々が入って来る白娘子のしとやかな女ぶりに眼を注けていた。",
              "citation": {
                "source": "蛇性の婬",
                "author": "雷峯怪蹟",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の内では王主人の媽媽が入ってくる白娘子のしとやかな女ぶりに眼を注けていた。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「めっきり女ぶりがあがった。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "入学試験に及第しなかったら、………「美津がこの頃は、大へん女ぶりを上げたわね。",
              "citation": {
                "source": "お律と子等と",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "（美い女ぶりや、粗末にはしまいこと）　久しく留守にして見なかったからか、大弥太には女房が美しく見えた。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡本かの子の巫女ぶりと正子とは、文学と婦人とのいきさつのピンとキリを示している感です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪もかきつければ、何やら小ぎれいな襟を掛け、袖口もちゃんとつけたところは、すっかり別人みたいに若返って、女ぶりさえ上がったようでがしたよ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
