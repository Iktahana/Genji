          "literary": [
            {
              "text": "完成された階級にただ一つ残つた必至の垣を今こそ躍り越えるのだ。",
              "citation": {
                "source": "雪",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこをヒラリと躍り越えると、落莫とした冬木立の下に、サーッと響いてゆく水音が聞こえた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていったん城壁の内部へ躍り越えると、もう十名はひとつにかたまっていられなかった。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
