        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "帰り際に友人と「それじゃあ、また明日。お疲れ様！」と言って別れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "電話を切る直前に、「じゃあ、また後で。お疲れ様！」と付け加えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「では、会議はこれで終了です。お疲れ様でした」と言って部屋を出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
