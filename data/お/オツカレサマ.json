    "definitions": [
      {
        "index": 1,
        "gloss": "thank you (for your hard work)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「今日も一日、お疲れ様です」と上司に挨拶をして退社した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プロジェクトが無事に成功し、メンバーに「本当にお疲れ様」と伝えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "遅くまで残業している同僚に、缶コーヒーを差し入れながら「お疲れ様」と言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「ヘイ……どうもお疲れ様で……お流し致しましょう」　揉み手をしながら小奇麗な若衆が這入って来た。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お疲れ様で」　とか「先刻のお方様で」　とか、という御世辞を聞き流して、奥まった部屋へ入った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "おつかれさま、本当に。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "お疲れさま」　それだけ言って、女房の産が近づいた人のようにさっさと帰って行った。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ありがとう」　マッチをすっていると、「お疲れさま。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "出て行くのであろう、「お疲れさま」の「ま」の尻を上げた言い方は、信吉を意織しない調子に聴えた。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも鉄道局との打ち合せも済んでいたものと思われたし、東京の旅客課のＫ君も附いていることなり、や、お疲れさま、どうぞとあったので、そこで一同が安心して鞄を投げ出し、埃っぽい編上げの紐も解いたのである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お早う、昨夜はお疲れさまで」「君だったかね、昨夕馬車へ乗ってここまでいっしょに来てくれたのは」「へえ、お邪魔様で」「なるほど君の云った通り閑静だね。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お疲れさまでした」　針の手を休めて内儀さんが徐かに顔をあげた。",
              "citation": {
                "source": "神楽坂",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女教師　お疲れさま、近頃あなた開墾ですってね？",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お静かにいらっしゃいまし、お静かに」　客席の雑踏へ二、三度、声をかけると、ようやく高座を立って楽屋へ下りていったが、「御苦労さまでございます」「お疲れさまで」　口々に声をかける弟子のなかで、鳶のような口付きをした色の黒い勢朝が、「師匠、お客さまですぜ」「なに……お客様？",
              "citation": {
                "source": "圓朝花火",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こんばんは、お疲れさま。",
              "citation": {
                "source": "白い門のある家",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ起きて待っていたマンが、出迎え、「お疲れさま。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時前後には、お疲れさまです、という挨拶に変わる。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お疲れさまでございます」　まだ寝ずに留守をしていた老女のしほが、手燭を手にもって戸口まで迎えに出ていた。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お疲れさま」と、陽気な声でいった。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
