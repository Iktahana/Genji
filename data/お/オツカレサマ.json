        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「今日も一日、お疲れ様です」と上司に挨拶をして退社した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プロジェクトが無事に成功し、メンバーに「本当にお疲れ様」と伝えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "遅くまで残業している同僚に、缶コーヒーを差し入れながら「お疲れ様」と言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「ヘイ……どうもお疲れ様で……お流し致しましょう」　揉み手をしながら小奇麗な若衆が這入って来た。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お疲れ様で」　とか「先刻のお方様で」　とか、という御世辞を聞き流して、奥まった部屋へ入った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "おつかれさま、本当に。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
