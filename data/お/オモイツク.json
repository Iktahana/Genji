        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔の友人のことをふと思いついて、連絡をしてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "あの人の顔を思いつくと、自動的に笑顔になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "何かを思いついたような表情をして、彼は走り去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
