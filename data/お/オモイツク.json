[
  {
    "uuid": "a4ed98ed-8fcf-5e05-968b-b4bea4c653d5",
    "entry": "思いつく",
    "reading": {
      "primary": "おもいつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
