    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to think of",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "いい案が思いつかなくて、ずっと悩んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その時、ふと良い方法が思いついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "どうしても答えが思いつかなくて、諦めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "こんな事を思いつくのは私の宿命です。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いつくままを書きました。",
              "citation": {
                "source": "御返事（石原純君へ）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の学生時代の想い出のようなものでもいいからといわれるので、たださしあたり思いつくままを書くことにする。",
              "citation": {
                "source": "科学に志す人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく黙っていたが、跳ね返す警句を思いつく気力もなく、「兄弟分でもなんでもない、全く一つのものだ」　と低い声音に渾身の力を籠めて言った。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの問題を系統的に分類でもすればいいわけであるが、まだそこまでの整理ができていないから、ここではただ将来の参考のための備忘録だと思って、以下に思いつくままを無秩序に書き並べるに過ぎない。",
              "citation": {
                "source": "自然界の縞模様",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうわけで、もちろん、論文でもなく教程でもなく、全く思いつくままの随筆である。",
              "citation": {
                "source": "科学と文学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーヒー茶わんの縁がまさにくちびると相触れようとする瞬間にぱっと頭の中に一道の光が流れ込むような気がすると同時に、やすやすと解決の手掛かりを思いつくことがしばしばあるようである。",
              "citation": {
                "source": "コーヒー哲学序説",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "父死亡の電報を見た時でも、この場合その問題をどう片づけるかさえ考えはしなかったのだが、欠席届を書き終えた時、保証人なる槍田氏は三隅の小母さんの知り合いだから、通知かたがた三隅家に立ち寄ってその判を貰うように頼もうと思いつくと同時に、自分の心持もそのついでにいってしまおうと決心したのだ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな想像も出来ないようなことをしても、煎じつめれば、どんな人間の中にもひそんでいる慾望が、人間の智慧の思いつく範囲内での形をとったに過ぎないんですからね。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "お君が鏡台の前で着付けするのを傍で見ながら、安二郎は思いつく限りの嫌味な言葉を苦々しくだら／″＼と吐きかける。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それを思いつくのには頭がいる。",
              "citation": {
                "source": "とびくらべ",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "読んでいるうちに何か思いつくでしょうから、思いついたら、またその時には、申し上げます。",
              "citation": {
                "source": "みみずく通信",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろ思いつくままに、言いました。",
              "citation": {
                "source": "みみずく通信",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりが、思いつくままに勝手な人物を登場させて、それから順々に、その人物の運命やら何やらを捏造していって、ついに一篇の物語を創造するという遊戯である。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "弱気な男というものは、自分の得にならぬ事をするに当っては、時たま、このような水際立った名案を思いつくものである。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし憑きものだとすれば、こんな奇妙な憑きものは前代未聞だし、もし憑きものでないとすれば、こんな途方もない出鱈目を次から次へと思いつく気違いはいまだかつて見たことがない。",
              "citation": {
                "source": "狐憑",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "年代は多少前後するが大体この期間を中心におよそ人間が思いつくありとあらゆる人生に対する考えが衣を調え装いを凝らして世人に見えたのみでなく、義を練り言葉を精しくして互いに争った。",
              "citation": {
                "source": "荘子",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巡業そのものに、そして、そんなことを思いつくお前という人間に、興味を感じたのだ。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "変態といっても、人間が思いつく限りの変態などたかが知れていると見えて、やはり変態には変態の型がある」とその老人は語っていたが、数多くの女を知らない私にもその感想の味気なさは同感された。",
              "citation": {
                "source": "神経",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はそう思いつくと、入水する人のすると云うように、穿いていた草履を水際に並べて置いて、西安寺と云う寺のある方へ往ってしまった。",
              "citation": {
                "source": "鮭の祟",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう思いつくと、すぐに私は、頭にまいていた布をといて、つなを作りました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術のためだもの、自分が本当に生きて行くためだもの、手段なんか、どうだって――と、子供らしい向いっ気で、そんなことを思いつくと、（そうだ！",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　そう思いつくと、彼ははじめて決然として来た。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろ考えたあげく、いつか喫茶店でやったように、手を握るということを思いつくのが関の山だった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　そう思いつくと、やっと口実がついた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、正勝は容易にその適当な手段を思いつくことができなかった。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そう、グローブ、スター、ペル・メル、セント・ジェームジズ、イヴニング・ニューズ・スタンダード、エコー、あとは君の思いつく限りの新聞へ。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは思いつくだけ言葉をかけて、その女性をなだめた。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、警察の思いつくのはこの程度で、まったくありそうもないが、それ以外の解釈もまだまだ信憑性がない。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな言葉をこんな場合に使うことを思いつくと、私は苦悶のなかでもちょっと微笑したのだった。",
              "citation": {
                "source": "落穴と振子",
                "author": "THE PIT AND THE PENDULUM",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
