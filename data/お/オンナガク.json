        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "女楽として活躍した彼女たちの記録が残されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "宮廷の女楽は、特定の身分に限定されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "女楽として修行を始めたのは、わずか八歳のときだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
