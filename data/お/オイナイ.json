        "examples": {
          "standard": [
            {
              "text": "「せっかくここまで来たんだから、中へおいない」と親戚が招き入れてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「祭りの見物、ぜひおいない！」と地元の人々が観光客を呼び込んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「こっちでおいしいお茶を入れたから、おいない」と祖母が手招きした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "まあ、こゝへおいない、モトム君」　と、彼はなれ／＼しく声をかける。",
              "citation": {
                "source": "火の扉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがのかれらも可愛いい日本娘がほんとに死んでしまったと気づいた時、屍体をとりかこんでおいおいないたという。",
              "citation": {
                "source": "放浪作家の冒険",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらは、うるおいない身なりとともに、例外ない持ち前であった。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
