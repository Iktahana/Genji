        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "即ちジヤツク・ウオーキイ等によつて映画で紹介されてゐるやうな、歌詞を本位として簡単な音楽を伴奏的につけ、専ら歌詞の滑稽味やエロチシズムやで、大衆を興がらすやうに出来てる「音楽入西洋万才」が、近い未来に於て日本に現れることを予感させる。",
              "citation": {
                "source": "流行歌曲について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとは、「ポーピーポー」というふうに、中に一つ長三度くらい高い音をはさんで、それがどうかすると「起きろ、オーキーロー」と聞こえたものであるが、近ごろは単に「ププー、プープ」というふうに、ただひと色の音の系列になってしまった。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士の右隣には、博士の信任の篤いオーキー学士が、水中電話機を背負って、たえず水面に待機している掃海艇サンキス号と電話で連絡をとっている。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのオーキー学士の声が海水を伝わって水戸記者の耳にもよく入る。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "前方に何があるか、見当がつかない……」　オーキー学士はしきりに喋っている。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホーテンスは、ワーナー博士とオーキー学士と一人の護衛の組に入った。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "管内の警察官は悉く不在だつたので彼はサムエル・ブルウムを特任し、且ジョン・カッタア、ヘンリイ・ブリット、ジョオヂ・グウルド、デニス・オーキイフ、ジョン・ウエッセル、ビイ・エフ・シヨットの諸氏を選任登録した。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐるぐると暗い街をいい加減に歩いて、やがて賑かな大通りが先方に見え出したとき、ふと傍に、紫色の硝子にカフェー・オーキッドと白く抜いた軒燈を見た。",
              "citation": {
                "source": "被尾行者",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "息子さんはラスキンの研究家で、元オーキという婦人服やのあったところへ茶をのませる博物館めいたものをこしらえています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月二十七日（日曜）　モヤさん、京都へ先発（秀雄さんと一緒なり）　朝モヤ、女子大学寮舎の山原さん、丹野さん訪問、オーキ、理髪の後林町へ来た。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月二十六日　金　オーキで外套かり縫い。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイツとは詩人ウオーキン・ミラー翁の住んでいた旧邸である。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウオーキン・ミラーといえば直ぐヨネ・ノグチを想い起すのが在米日本人であり、ヨネ・ノグチといえば直ぐウオーキン・ミラーを想い出すのは日本の詩人たちであろう。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがアペイという邸宅で、ウオーキン・ミラーが晩年詩作に耽った所なのだ。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『シエラの詩人と呼ばれしウオーキン・ミラーの住みし所、彼の名づけて高嶺といいける所。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳をそばだてると『オーキン、ウオーキン、ウオークイン。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼びかける老婦人こそ、詩人ウオーキン・ミラーの未亡人で、夫の名を呼ぶつもりで『おはいりなさい（Walk in）』といっているのである。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近よると如何にもうれしそうな顔で『ウオーキン』とも一度いって、ウオーキンの意味を説明する。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『こんな所に、たったひとりいたというだけで、ウオーキン・ミラーという人は詩人でもあったろうがまた奇人でもあったろう？",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　指をあげて教えてあげた私は、別に気にもとめなかったが、あとできけば、その男こそウオーキン・ミラー未亡人が口を極めてほめたたえた詩人の菅野衣川氏だったのだ。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨネ野口の師事したウオーキン・ミラーという詩人で名高いバークレーの街を、ずんずん山手に登った所にテレグラフという大通りがある。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時より早くは始まるまいからと、日比谷映画劇場へ行き、「絢爛たる殺人」“Murder at the Vanities”を見る、脚色がゴタついたのと、マクラグレンとオーキーを活用せんとして結局無為に終ったことで、傑作とは言ひがたいが、見てゝは面白い。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャック・オーキー舞台裏ものばかりやってる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
