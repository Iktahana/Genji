    "definitions": [
      {
        "index": 1,
        "gloss": "to turn up (hem, sleeves, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ズボンの裾を折り返すと丈を調整できます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "半袖シャツの袖を折り返すと涼しくなります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "コートの襟を折り返して着こなしをアレンジした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ごわっごわっと時々新聞を折り返す音だけが聞こえて、積み荷があらかた片付いた船室の夜は静かにふけて行った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事務長がまた新聞を折り返す音を立てた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一度襲おうとサメが折り返すたびに、ちぎられた肉片が輝いて見えた。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五メートル・プールで四十回も折り返すのは、馬鹿げていると僕は思う。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百メートルで折り返すあたりで、僕としてはもっとも速いクロール泳法となっている。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分も行くべきであるか否か、まだ思いまよっているとき、折りかえすように阿賀妻の声が遠くから命じていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "折りかえし、向うから、さらにまた優しいお見舞い。",
              "citation": {
                "source": "未帰還の友に",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "手を切りそうな五円札を一重ねに折りかえして銅貨と一緒に財布へ押しこんだのを懐に入れて、神保町から小川町をしばらくあちこち歩いていた。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "金曜日には行くという返事が折りかえして来る。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十七　医師の言葉を書いて、ぜひ九月の学期までに近い所に転任したいが、君に一任してよきや、みずから運動すべきやと郁治のもとに書いてやると、折りかえして返事が来て、視学に直接に手紙をやれ、羽生の校長にも聞いてみろ、自分もそのうち出かけて運動してやると書いてあった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "折りかえした手拭きで顔の汗や脂をふき取った。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "望みどおり丹波よりも、源三郎よりも、一段上の大剣士が、審判に立つから……という笹の返事が、折りかえし源三郎から来た。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただコートの折りかえしだけが眼が痛くなるような紫の天鵞絨だった。",
              "citation": {
                "source": "空中墳墓",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しっかり説明文をよこされよ”　すると、金博士が折りかえし返事して曰く、“醤よ。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、新聞紙を、また折りかえして、次なる頁に目をやった。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると折りかえして本隊から、“わが帝国海軍戦史のあたらしき一ページは、青江三空曹のこのたびの壮挙により、はなばなしくかざられたり”　と、光栄にみちた感状の無電がとどきました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、折りかえし森源から来たハガキには、裏面にただ一つ、大きく『π』と書かれてあるきりだった。",
              "citation": {
                "source": "脳波操縦士",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "金子しげりというような女史たちが、男のズボンの折りかえしが無駄でありというような決議をする世相。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "折りかえした形であらわれている上流人らしい傲慢さを感じて、みほ子は、自分の中に反撥するものがあり、店のほかの連中と一緒に興味本位でそのお喋りに入ってゆけなかった。",
              "citation": {
                "source": "道づれ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よく似合います」「よかったこと」　細君は伸子がひそかに気にしたようには、伸子の髪の変化に注意をはらわず毛皮外套を着ている腕をのばし、厚く折りかえしになっているカフスのところを手で撫でながら、「モストルグには、もっとずっと上等の毛皮外套が出ていたんです。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の背広の襟の折りかえしが糸になっていた。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら、一般読者の胸の中には、折りかえして、では何故、現代の文学愛好者の大多数がそういう自他ともに低めるような情けない末技的興味にひき込まれてしまっているのであるかという反問が生じる。",
              "citation": {
                "source": "文学における今日の日本的なるもの",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "折りかえして戦地より武男が返書は来たれり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると折りかえし返信があった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
