[
  {
    "uuid": "5cc26b98-4d84-52cc-89d1-006b9c83a713",
    "entry": "音楽",
    "reading": {
      "primary": "おんがく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
