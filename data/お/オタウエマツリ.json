      {
        "index": 1,
        "gloss": "shrine ritual held within the first two months of the year to forecast or pray for a successful harvest",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
