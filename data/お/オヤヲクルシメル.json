        "examples": {
          "standard": [
            {
              "text": "ギャンブルで作った借金が膨らみ、結局、連帯保証人である親を苦しめることになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "親の期待に応えられないことが、逆に親を苦しめる結果になっては本末転倒だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "親を苦しめるような不行跡は絶対にするべきではない",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "親を苦しめる事ばかりが能ぢやないよ、何時までも／＼ブラ／＼してゐて、世間の手前も恥かしい。",
              "citation": {
                "source": "惑ひ",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういふ青年のふてぶてしさは此の人の余儀ない傾向でほかに他意はなかつたのですが、これが娘の父親を苦しめる種になるのでした。",
              "citation": {
                "source": "淫者山へ乗りこむ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、警察へ届けたところで、徒らに母親を苦しめるばかりです。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
