        "examples": {
          "standard": [
            {
              "text": "神社の境内に植えられた小賀玉の木は、樹齢数百年の大木だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "春になると、小賀玉の木は白い可憐な花をたくさん咲かせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "森の中でひときわ目立つ小賀玉の木を見つけて、思わず見とれてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "オガタマノキは、神道に古く因縁深き木なるが、九州に自生ありというが、その他に大木あるは紀州の社地のみなり。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "その心材が黄色なので黄心樹［牧野いう、我国の学者はよい加減な想像でこれをオガタマノキと誤認している］の一名がある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
