        "examples": {
          "standard": [
            {
              "text": "彼の横言は周囲の人々から強い反感を買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "会議の席で横言ばかり述べる参加者がいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "横言を言うのではなく、他者の意見をより真摯に聞くべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "しみじみ見ると、すずめってやつめ変な鳥じゃござんせんかい」「横言いうない。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
