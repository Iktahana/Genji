    "definitions": [
      {
        "index": 1,
        "gloss": "being born after April 1 (school entrance date)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はクラスで一番の遅生まれだが、体格は誰よりも大きい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "遅生まれのため、同級生よりも少し幼く見えるかもしれないと心配している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "学校の学年分けでは、４月２日以降の生まれを遅生まれと区分する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "新郎の春藤良一の妹で遅生まれの十四、小学校の最上級に居る学校第一の人気者です。",
              "citation": {
                "source": "身代りの花嫁",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "遅生れの八つで、東京育ちの子供には、この登校は体力に応え過ぎた。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "よたよた飛んでる遅生れの小雀も、精いっぱいにもっと鳴け。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも遅生れの末の子が心配になるのでした。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七と言っても遅生れの、まだ門松を取ったばかり、十五と言っても随分通用しそうな若々しさで、四十五歳の岩太郎の玩具にするのは、誰の眼にも痛々しい限りです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "春宵",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそ生まれの八つですが、手習いなぞの好きな子です。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
