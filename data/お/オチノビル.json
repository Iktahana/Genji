    "definitions": [
      {
        "index": 1,
        "gloss": "to run away",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敗戦を悟った将軍は、山奥へ落ち延びる決心をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "敵軍の追っ手を振り切り、夜の闇に紛れて落ち延びた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "城が陥落する前に、城主の一族は北の国へ落ち延びたという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "この平太夫はいつぞや清水の阪の下で、辻冠者ばらと刃傷を致しました時、すんでに命も取られる所を、あなた様の御かげによって、落ち延びる事が出来ました。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "行く先は京都だろうと言うものがあり、長州まで落ち延びるつもりだろうと言うものも多かった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅券さえ手に入れば、一度台湾か、満州へ行って、そこを足がかりに、南米へ落ち延びるのは何んでもない。",
              "citation": {
                "source": "悪人の娘",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "花田中尉はインタアルに落ち延びる時、水牛にでも積んで行ったのか薬品を沢山もっていて、今はその薬品を原住民の食糧と換えそれで食いつないでいるらしい。",
              "citation": {
                "source": "日の果て",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "まなこさえあいておりましたら、夜にまぎれておちのびることもできましょうけれども、このように四方をかこまれておりましてはたといおいとまをいたゞきましてもわたくしには逃げるみちがござりませぬ。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかし戦国時代、飛騨の国司、姉小路秀綱卿が、いくさに負けて、夫人や姫君と共に、落ちのびるところを、追手に殺されたという、執念の谷に、執念ぶかい焼岳の煙が靡き、灰が降りかかるのである。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、張宗昌の落ちのびる列車に乗らず、商埠地にとゞまっていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、こゝから約四哩の黄河の沿岸の※口まで、一息にとばして、そこから天津方面へ落ちのびるのだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は漸くのことでその港まで落ちのびることの出来た嵐の烈しさを想って見て、思わずホッと息を吐いた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、こういうかつこうで遠くへ落ちのびるところです」　と、言つた。",
              "citation": {
                "source": "火の扉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "疑雨荘で女房が失踪したあとでも、女房子供と別居して彼の下宿へ一室をかりて共に勉強しようかと思ひつき、その一室がなくて小田原へ落ちのびたが、落ちのびる前日風の如くに訪ねてきて、荷物を片づけてくれたのもあの憎むべき奴であつた。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争が本土ではじまることになったら山奥へ逃げこんでも助かるつもりでいたが、まだ空襲の始まらぬ時だったので、遊び場のない田舎へ落ちのびる気持にもならなかった。",
              "citation": {
                "source": "青鬼の褌を洗う女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "パンパンとても同じことで、男の美意識の向上につれて、パンパン自身向上するか、見捨てられるか、場末へ落ちのびるか、どれかしかない。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸へ帰るわけにはいかないから、船で松前へ落ちのびることにきめた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "疑雨荘で女房が失踪したあとでも、女房子供と別居して彼の下宿へ一室をかりて共に勉強しようかと思いつき、その一室がなくて小田原へ落ちのびたが、落ちのびる前日風の如くに訪ねてきて、荷物を片づけてくれたのもあの憎むべき奴であった。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "橘　落ちのびるとは思いもいたしませんでした。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟の御厨三郎将頼は、相模へ落ちのびる途中、追捕の手に打たれ、藤原玄明も、常陸で殺された。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ちのびる行家たちは播磨の高砂から船に乗り、和泉の吹飯浦に押し渡り、そこから河内の長野城に立て籠ってしまった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第八巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、よそながら、二人の落ちのびる道を守っていよう」　と、正成は言った。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
