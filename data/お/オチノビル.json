  {
    "uuid": "dd9f5018-3b81-5d96-ad31-e66ee956061f",
    "entry": "落ち延びる",
    "reading": {
      "primary": "おちのびる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
