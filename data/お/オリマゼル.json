          "standard": [
            {
              "text": "プレゼンのスライドには、グラフだけでなく図解も織り交ぜることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "伝統的な技法に、新しい素材を織り交ぜることで独自の作品が生まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会話の中にユーモアをうまく織り交ぜるのが、彼の才能だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "あれは、最初の水道樋の挿話を物語の最後にするか、若しくは以後のいくつかの挿話を最初の挿話の中に織り混ぜるか、するのが本当でした。",
              "citation": {
                "source": "五題",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            }
          ]
        }
