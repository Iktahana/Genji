    "definitions": [
      {
        "index": 1,
        "gloss": "ukiyo-e portrait of the upper body with emphasis on the facial expression",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
