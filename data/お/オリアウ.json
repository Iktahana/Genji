          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新入社員は最初は先輩との関係が気になったが、すぐに折り合うようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "異なる価値観を持つ二人が折り合い、一緒にプロジェクトを進めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "転校生はクラスメイトとうまく折り合い、今では最も仲良しグループの一員だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
