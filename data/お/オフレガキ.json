    "definitions": [
      {
        "index": 1,
        "gloss": "Edo-period proclamation issued by the shogunate (or a daimyo, etc.) usu. to the general populace",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代の御触書には、当時の商業活動や生活ルールに関する詳細な指示が記されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "町奉行所から発せられた御触書が町内の掲示板に貼り出されて、全ての住民に周知された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この御触書の内容から、当時の社会情勢と統治体制を理解することができます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "嘉永六年の黒船騒ぎのとき、浦賀奉行がだした御触書が翻訳つきで博物館にありますが、外国人を見ると青い眼玉の子供を孕むから……これは失礼、見ちゃならんと書いてある。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "――このあいだの御触書にあったことは本当だろうか。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "駈込み訴え",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
