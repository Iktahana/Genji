        "examples": {
          "standard": [
            {
              "text": "江戸時代の戯け芝居は庶民の娯楽として大いに親しまれ、笑いの中に社会風刺を盛り込んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その劇団の戯け芝居は子どもから大人まで楽しめると評判で、毎年夏祭りの舞台に呼ばれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "二人の役者がかけあいで演じる戯け芝居に、観客は腹を抱えて笑い転げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "（得意の、おどけ芝居だわ）　蒲団を中にして、時次郎と押し問答している最中に、金五郎が入って来た。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "（滑稽千万な、おどけ芝居じゃ）　自分が、派手な無台装置のまん中に坐っている、下手な喜劇役者のように思われて来た。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おどけ芝居よりも、まだ、滑稽じゃ）　重大な生活と運命の高まりが、人間にとって、ぎりぎりの場所に来たとき、常に、その転換や、再生が、奇妙に、滑稽な形であらわれる。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おれはおどけ芝居の名人じゃ）　人間の重大な秘密が、説明しがたい滑稽の表情を呈することは、毎々、経験したが、雪隠詰になったのははじめてだ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おれも、おどけ芝居の名人じゃが、向こうにも、おれに負けん役者が居るとみえるわい）　危険感はまったくなかった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
