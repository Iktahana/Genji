        "examples": {
          "standard": [
            {
              "text": "長年通った道場を去ることを思い切らせたのは、師匠の一言だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼への未練を思い切らせるために、友人は旅行に連れ出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "両親は転校を思い切らせようと、新しい学校の楽しさを話してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "いずれにしても、父が小夜衣の謎を解いてしまった以上、今更なまじいにそれを包み隠すよりも、あからさまに何もかも打ち明けて、いっそ思い切らせる方がましであろうとも考えた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを思い切らせるのにオリヴィエはたいへん骨が折れた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
