      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "highwayman",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夜道で追いはぎに襲われ、財布を奪われてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "昔の物語に出てくる追いはぎは、山賊のような恐ろしい存在だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この辺りは昔、追いはぎが出たと言われているから気をつけて」と忠告された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、太平の世の中でもまれには都大路に白昼追いはぎが出たり、少し貸してくれなどという相手も出現するから、そういう時にはこれがたちまちにして原始民時代の武器として甦生するという可能性も備えているのである。",
              "citation": {
                "source": "ステッキ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらの小使い銭を持っているでもないから、追いはぎはさのみに恐れなかったが、犬に吠え付かれるには困った。",
              "citation": {
                "source": "三崎町の原",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "人殺しや追いはぎがあったとか、幽霊が出たとかいうところは一つ残らず知りつくした。",
              "citation": {
                "source": "わたくし自身について",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミラボーは「社会の最も神聖な掟にわが身を公然たる反抗におくためにはどの程度の決意が必要かをたしかめるために」追いはぎを事とした。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は「隊伍のなかで戦う兵士は追いはぎの半分の勇気も要しない」と、また「名誉と宗教とは十分考えた牢固たる決心の邪魔には決してならなかった」と公言した。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍艦鳥は、鳥の追いはぎだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おどろくじゃございませんの、ホンの二、三日前の晩に、私の内のすぐ近くで、追いはぎと、そいからあの、乱暴された女の人が、一晩に三人もありますのよ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどその秋の初めごろまさしくあの夜の前後に、彼が町を徘徊して三人ばかり追いはぎを働いた事実はまだ人の記憶に新しかったからである。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しい追いはぎのように、シャツからさるまたまで、はぎとってしまった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、十一時が二十分すぎてもまだ帰ってこないのは、きっと、とちゅうでおいはぎにでもつかまったにちがいないといいはるのでありました。",
              "citation": {
                "source": "和太郎さんと牛",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝田さんは、このおさまった御代に、おいはぎなどが、やたらにいるものではないことをきかせました。",
              "citation": {
                "source": "和太郎さんと牛",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "第五のお話　　　　　おいはぎのこむすめ　それから、ゲルダのなかまは、くらい森の中を通っていきました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、おいはぎどもの目にとまって、がまんがならなくさせました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おいはぎたちはさけんで、いちどにとびだしてきました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おいはぎばばがいいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おいはぎのこむすめは、いいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいはぎどもは、みんなわらって、「見ろ、ばばあが、がきといっしょにおどっているからよ。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おいはぎのこむすめはいいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいはぎのこむすめは、ちょうどゲルダぐらいの大きさでしたが、ずっと、きつそうで、肩つきががっしりしていました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいはぎのむすめは、しげしげとゲルダを見て、かるくうなずきながら、「あたいは、おまえとけんかしたって、あのやつらに、おまえをころさせやしないよ。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこはおいはぎのこもる、お城のひろ庭でした。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おいはぎのこむすめがいいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おいはぎのこむすめはいって、てばやく、てぢかにいた一わをつかまえて、足をゆすぶったので、はとは、羽根をばたばたやりました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、いって、おいはぎのこむすめは、それを、ゲルダの顔になげつけました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おいはぎのこむすめはこたえました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいはぎのこむすめは、かた手をゲルダのくびにかけて、かた手にはナイフをもったまま、大いびきをかいてねてしまいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "たき火のぐるりをかこんで、おいはぎたちは、お酒をのんだり、歌をうたったりしていました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "あさになって、ゲルダは、森のはとが話したことを、すっかりおいはぎのこむすめに話しました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おいはぎのこむすめはゲルダにいいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "おっかさんが、びんのお酒をのんで、ねてしまったとき、おいはぎのこむすめは、となかいのところへいって、こういいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
