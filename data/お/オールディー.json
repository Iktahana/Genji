        "examples": {
          "standard": [
            {
              "text": "ラジオから流れてきたオールディーを聴き、高校時代の記憶がふと蘇った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「これ、完全にオールディーだけど、なぜか今でも心に刺さる曲なんだよね」と友人がつぶやいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "父のコレクションの中にあったオールディーのレコードを取り出し、久しぶりに針を落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「じゃ、おまえの知ってるのをかけてやる」「ビートルズぐらいしか知りませんよ、オールディーズは」　ビートルズがオールディーズと呼ばれる時代は、慶一には居心地が悪い。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
