        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "やがて夫人によつて、炭火の盛られた、大丼のやうな火鉢が、彼とＭ君との間におかれた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "錦手大丼と能面を並べた壁飾。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大丼が出たり、小皿が出たりするところを見ると、何が無くとも有合のもので一杯出して、地主に飲んで貰ふといふ積りらしい。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お豆腐のたきたては奈何でごわす」などと言って、内儀さんが大丼に熱い豆腐の露を盛って出す。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠居は古い炬燵板を取出して、それを蒲団の上に載せ、大丼に菎蒻と油揚の煮付を盛って出した。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　鍋の鶏肉はもう煮えたっているし、野菜の煮附は大丼に盛ってあるし、先刻の川魚は甘煮にして大皿に並べてあった。",
              "citation": {
                "source": "田園の幻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると大丼に一杯持って来た。",
              "citation": {
                "source": "蝦蟇を食べた話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀貨と大丼を掴んで渡が食堂へ降りてゆく。",
              "citation": {
                "source": "歩む",
                "author": "戸田豊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "誇張して云うのではない、文字どおり放りだしたので、二つの大丼はいまにも転げそうに、左右へ二、三度もひっかしがり、福神漬は一と握りほどこぼれ落ちたため、松井くんは慌てて膝を横へ向けた。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高級といっても、普通が五銭、大丼が十銭、牛のモツを、やたらに、からく煮込んだのを、かけた丼で、熱いのを、フウフウいいながら、かきこむ時は、小さい天国だった。",
              "citation": {
                "source": "浅草を食べる",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちらのは、当時は手打ちで、薄味で、薬味には細い香ばしいネギが、大丼に出してあった。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
