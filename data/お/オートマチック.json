        "examples": {
          "standard": [
            {
              "text": "応急処置の訓練では、オートマチックな対応方法を繰り返し練習する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このロボットの動作はオートマチックに進行し、人間の介入は最小限である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オートマチックな機器の操作方法は、誰でも簡単に習得できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "すると、さっと軽い電流が僕に流れ、するとあとはもう会話も態度も殆どオートマチックに流れだすのだ。",
              "citation": {
                "source": "火の唇",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと中をかき回したかと思うと、次の瞬間彼女の手の中にあったのはハンプトン大佐の四五口径オートマチックだった。",
              "citation": {
                "source": "最愛の君",
                "author": "Ｈ・ビーム・パイパー　H. Beam Piper",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
