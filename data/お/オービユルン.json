        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "※　三人のオービユルンと悪しき精霊等　幽暗の王国には、無量の貴重な物がある。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれは三代目のオービユルンです」と農夫が答へた。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれ共何時か一度、其宝はオービユルンの一家に見出されて其物になる筈になつてゐる。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "がさうなる迄には三人のオービユルン家のものが、其宝を見出して、そして死なゝければならない。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一のオービユルンは掘つて掘つて、遂に宝の入れてある石棺を一目見た。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから第二のオービユルンが来て、又掘りに掘つた。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三のオービユルンは今掘つてゐる。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれ共又呪が其時に破れて、それから永久にオービユルン家のものが昔に変らぬ富貴になると云ふ事も信じてゐる。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
