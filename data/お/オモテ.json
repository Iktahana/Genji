        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "表の作法を幼い頃から習ってきた彼女は、自然体のお点前が美しいと評判だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "茶道を始めるにあたり、表と裏のどちらを選ぶか先生に相談した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "表の家元が監修した道具展が開かれ、茶道愛好家たちが詰めかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
    ],
