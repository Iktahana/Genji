        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「旦那様はただいまおりゃるか」と番頭が奥へ向かって声をかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "御隠居はこのところ庭の茶室においておりゃるとのことだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「娘はここにおりゃるか」と父親が大声で呼ぶと、奥から返事が聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "is (doing)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
