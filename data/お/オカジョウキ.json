        "examples": {
          "standard": [
            {
              "text": "昔の絵本で、陸蒸気が走る様子を見て不思議に思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "明治時代の小説には、よく陸蒸気の話題が登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "かつての人々にとって、陸蒸気は近代化の象徴だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "むしろ彼等は、西洋の陸蒸気に乗って旅することを、無限の詩的に考えていた。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時俚人は陸蒸気だといって魂消た。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩手県｜二戸郡大野村などでは、大野中ほどに陸蒸気出来た、おまえ船頭でわし乗るべ、というような俗謡まで、できたほどである。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
