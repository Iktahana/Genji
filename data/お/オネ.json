[
  {
    "uuid": "a58c0f48-2378-5df9-b8cb-3bd31ca9a92d",
    "entry": "尾根",
    "reading": {
      "primary": "おね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
