        "examples": {
          "standard": [
            {
              "text": "このスイッチはオンオフの切り替えが素早くできるため、現場での作業効率が格段に上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "集中力のオンオフがうまく切り替えられる人は、仕事でも高いパフォーマンスを発揮できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "照明のオンオフをスマートフォンで操作できるようにしたら、夜中に布団から出なくてよくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "テレビカナタイプには、最終的にはテレビのスイッチを入れる機能に加えて、部屋の照明をオンオフする機能まで付けて完成させた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
