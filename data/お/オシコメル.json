    "definitions": [
      {
        "index": 1,
        "gloss": "to shut up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "狭い部屋に何人も押し込めるのはやめてくれ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "倉庫の中に不要なものを押し込めて、やっと片付いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "無理やり狭いスペースに荷物を押し込めるのは無理がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "虚子の作物を一括して、是は何派に属するものだと在来ありふれた範囲内に押し込めるのは余の好まぬ所である。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "△くちなしの花、その匂ひが（その色よりも姿よりも）私を追想の洞穴に押し込める。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで犬か何かのやうに其の男を審問室に押し込めると、彼は監督警部の所へ行って報告した。",
              "citation": {
                "source": "奥間巡査",
                "author": "池宮城積宝",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしにゃあ目の上の瘤さ――それを知って、あの狐野郎をつかって、あたしをあんな古寺なんぞの穴ぐらへ押し込めるとは、あんまりじゃあないかねえ――だから、今夜、あたしは、わざわざ、同じような、古寺をえらんで、おまえさんをお招き申したのだよ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな、狭くて暗い部屋へ押し込めるのも茶代をやらない所為だらう。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな、狭くて暗い部屋へ押し込めるのも茶代をやらないせいだろう。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤帽は列車の前に待つてゐて、私を押し込めるやうにして乘せ、その後から二つのスーツ・ケイスを投げ込んだ。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い、濃淡のない、おっぴろがった電燈の光が、眼の玉を内部へ押し込めるように強く目に映じた。",
              "citation": {
                "source": "六月",
                "author": "相馬泰三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その暗さは、容易に太子の正体を見定めることが出来ない程度だった」とバラッス子爵が証言しているが、太子の救出を危惧したとしても、防ぐ方法はいくらもあるはずで、野獣でも馴らすわけでもあるまいし、何故にそんなところへ押し込める必要があるのか。",
              "citation": {
                "source": "カストリ侯実録",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "アパートの入口に待たせてあった自動車に、三室銀子を押し込めるように乗せると、自分はその後から飛乗って、深沢深を助手台に納めたまま、高円寺の家へ飛ばしたのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "結婚ラプソディ",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうだい、時限爆弾を作ってくれないか、窪みにドリルで押し込めるんだが。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し其の方法の弊害とする處は、患者が再發に再發を重ぬる間に、益々種々の療法に迷つて、病的觀念を徒らに深く心の底に押し込めるやうな結果を來す事で、神經質の本態に觸れて居ない。",
              "citation": {
                "source": "神經質に對する余の特殊療法",
                "author": "森田正馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困りますねえ、蟻田博士」　と、大江山課長は、椅子からたちあがって、博士の肩をおさえ、「私がお伝えした命令が聞かれないとあれば、やむを得ず、博士の自由をおしばりすることになるかもしれませんぞ」「ははあ、わしを留置場へおしこめると言うのでしょう。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "作戦のためにわしがここを出た方がよいのだ」「そして、どこへお移り遊ばすのですか」「花隈城へ」「ではまた、わたくしの身も、その花隈へ押し籠めるおつもりでしょう。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら我々の妻たちは、深くその家庭に押し込められ、純粋に母性としての訓育を受けてることから、全く社交上の才能を欠いでゐるから。",
              "citation": {
                "source": "家庭の痛恨",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして新しい現実をその一つ覚えの定義に押し込めようと試みる。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどい悪い事を、次々とやらかすので、ついには北さんのお宅の二階に押し込められて、しばらく居候のような生活をせざるを得なくなった事さえあった。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと云ってまた無理やりに嫌がる煎薬を口を割って押し込めば利く薬でももどしてしまい、まずい総菜を強いるのでは結局胃を悪くし食慾を無くしてしまうのがおちである。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちを、へんなお手本に押し込めて、身動きも出来なくさせたのは、一体、誰だったでしょう。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の作家たちが空想に拠って創造した女性を見て、女は、これこそ真の私たちの姿だ、と愚かしく夢中になって、その嘘の女性の型に、むりやり自分を押し込めようとするのだが、悲しい哉、自分は胴が長すぎて、脚が短い。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "面倒くさい靴下はポケットへ押し込め、ポケットがふくれて気持ちがいゝぞ。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "面倒くさい靴下はポケットへ押し込め、ポケットがふくれて気持ちがいいぞ。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらはまず死霊の祟りということを云い触らさせて、津の国屋一家に恐れを懐かせ、さらに菩提寺の住職から次郎兵衛をおどして、体よく隠居させて自分の寺内へ押し込めてしまうつもりであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝長屋の夜　棚倉一味の門弟がお絹を引抱えて無理に駕籠に押し込めて担ぎ去る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "確かに一個のＬＳＩに押し込められたマイクロコンピューターは、原版にあたるマスクができればあとは写真を焼き付けるように一括して大量に作ることができる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "メモリー容量で見ればタイニーベーシックの二倍、四Ｋバイトを必要とするゲイツのベーシックには、多様な機能が見事に押し込められていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "採卵用の鶏は、針金で仕切られたケージに一、二羽ずつ押し込められる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれらがみんな押し込められるとすれば、穴はかなり深く、恐らくは斜にうがたれ、奥は房のやうになつてゐるのだらう。",
              "citation": {
                "source": "ジガ蜂",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い間押入れの奧に押し込めておいたものからは、ほのかに濕り氣のにほひがする。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "目のさめるようなりっぱな王宮の広間から、くらい、じめじめした穴蔵のろうやへエリーザは押し込められました。",
              "citation": {
                "source": "野のはくちょう",
                "author": "DE VILDE SVANER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
