        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オニグラも、うまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、オニグラ、舌平目その他。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、オニグラ、舌平目にクラブハウス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルニューグリルで、オニグラとミニツステーキをやり、座へ出ると今日も補助椅子がワンサと出てゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "けい古すぐ終り、ホテルへ行き、オニグラとフィレソール食って座へ引返す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルのニューグリルで、オルドヴル、オニグラ、フィレソール。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩が有楽座の撮影で徹夜だから、うんと食っとこうと、オニグラに、フィレソール、ミニツステーキに、アイスクリーム、ペストリーにコーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オニグラにフィレソール、珍しくカレーライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "景気がよくなれば必ずよくするからまあ居据って契約を続けてくれとの話、オルドヴル、オニグラ、フィレソール、アスパラガス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オニグラとコトレ・ボライユ、コーヒー、ペストリ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、オニグラに牛肉スパゲティ煮込み。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "石田守衛が来り、三時頃新大阪ホテルへ、グリルでオニグラと、野菜グリルを食ったが、うまくない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食はホテ・グリで一人でオニグラ、コールドラブスター、アスパラ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤山とホテ・グリで夕食、オニグラとひらめチーズ焼にプディング。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤山一郎とホテ・グリへ行き、オニグラ、カネロニー、ゲームパイ、コーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時から「従軍記」の舞台けい古故、ホテルのグリルへ行き、オニグラとフィレソール、ボンファムを食ひ有楽座。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人だけ食事、オニグラ、フィレソール、ボンファム・シャリアピンと定ったやうなものばかり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
