        "examples": {
          "standard": [
            {
              "text": "近年のスマートフォンは大型化が進み、片手では操作しにくくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "企業の大型化により、経営の複雑さが増している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "建物の大型化に伴い、耐震設計がより重要になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "だがこの時期、液晶ディスプレイの大型化は急速に進みつつあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここまで大型化すれば、鳥瞰的な視点に立って個々のモジュールの役割を厳密に定義するとともに、各モジュールのすり合わせを専門に行う担当者を配置することが欠かせないはずだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
