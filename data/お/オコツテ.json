        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレデモ、オモヒダセナイノデ、トウトウ　オコツテ、カタツムリヲ　ツブシテ　シマハウト　シタ　トキ、フツト　オウサマノ　ココロニ、「デンデン　ムシムシ　ツノ　フレヨ、夜アケニ、ヌストガ　ヤツテ　クル」ト　イフ　ウタガ、ウカビマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　チヨウド　ソノ　コロ、ニシノ　ハウデ　センサウガ　オコツテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、モスクデ　オコツテイルトアタマニワルイ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オバアサンハ、ベツドノウヘデオコツテヰマシタガ、「モウシカタガナイ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤントボンコチヤンハ恥カシイヤラ悲シイヤラデ、メチヤ、クチヤニオコツテシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハイクラオコツテヰテモオ家ノ中ニヰルカライイヤウナモノノ、クライ夜道ヲ一人デトンデイツタボンコチヤンハ、モウ、ケツシテ、オ家ヘカヘツテコラレナイデセウ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
