        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おしかぶさるような空を、私たちは望もなく進んでいった。",
              "citation": {
                "source": "雪の武石峠",
                "author": "別所梅之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐しい速度で、大きな男の山のやうな影がおしかぶさるやうに思つた。",
              "citation": {
                "source": "花火",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいてあつちこつちで、おしかぶさる空氣をハネとばすやうに、笑ひが傳染していつた。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い高い家が押しかぶさる様にならんでゐる。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬱蒼と、陰陰と、圧する、押しかぶさる――緑、緑、緑、緑。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "塀のうちには小さい物置と四、五坪の狭い庭があって、庭には柿や桃や八つ手のたぐいが押しかぶさるように繁り合っていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "母の心持が押しかぶさるようにこわく、苦しく、重く迫って来た。",
              "citation": {
                "source": "雲母片",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、この甘睡の落ちはなが、何かの力によって支えられたと覚った時に、政公はうしろから押しかぶさる圧覚を感じて、さてはと醒めようとした時は遅いのでした。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "押しかぶさるような巨岩の下をくぐるのである。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「父上、御助勢申す」　岸の上へ躍り上がろうとする皆吉の上へ押しかぶさるように、六弥は元の舟へ飛移りました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "八人芸の女",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
