          "literary": [
            {
              "text": "オヒゲナンゾ　ツケタリ　シテ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二カハイイ　山羊サン　ハオヒゲ　ガ生エテタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山羊サン　ハオヒゲ　ヲチヨキン　ト切ツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七オ母サン　ハ仕方　ナクミンナ　カラオヒゲ　ヲネ三本ヅツモラツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八トテモ　ソノカクカウ　ガワルイノデミンナ　大ワラヒシテネオヒゲ　ガ　生エルマデホツトク　コト　ニナツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他は資本家も政治家も貴族も、ましてボンクラ共は、みんな一まとめにその他大勢の有象無象といふわけで、オヒゲのピンとはねてゐるのが陸軍大将だらう、などゝ俗でない見解にアッサリ万事を托して落付きはらつてゐたのである。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は巣鴨の戦犯収容所へ入れられたことのあるオヒゲの長いふとった御老体の宮様を思いだしましたよ。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その七　宮様は一級紳士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはよく註文取りのオヒゲという綽名のある番頭の伊東さんや和平どんに尾いて、碇泊中の軍艦をあるいた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからオヒゲの伊東さんよりは、和平どんの方がどこの酒保へ行っても持てた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
