[
  {
    "uuid": "248d08cf-f542-5b1c-8a55-f0b09673670b",
    "entry": "応諾",
    "reading": {
      "primary": "おうだく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞",
