        "examples": {
          "standard": [
            {
              "text": "昔の友人が思い寄った",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "学生時代のことが思い寄る",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "無尽はそこの地勢ようすなどをとくと聞いてどうやら思い寄るふしがありゆきてみるに、それは自分の尋ね求めている白旗であったので、それを納めてそこに寺を開いたという（12）。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦しい恋の結末をそうしてつけたことなどは想像のできぬことで、身を投げたなどとは思い寄ることもできず、鬼が食ってしまったか、狐というようなものが取って行ったのであろうか、昔の怪奇な小説にはそんなこともあるがと夫人は思うのであった。",
              "citation": {
                "source": "源氏物語",
                "author": "蜻蛉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから四十余日後の身の運命など、もとよりこのときの信長が、思い寄るわけもない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
