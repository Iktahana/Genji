[
  {
    "uuid": "79a010b0-5255-50ba-b0d6-7b10781f724c",
    "entry": "置き床",
    "reading": {
      "primary": "おきどこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
