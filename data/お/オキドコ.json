    "definitions": [
      {
        "index": 1,
        "gloss": "portable dais used to create a removable tokonoma",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "茶室には移動できる置き床が備え付けられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "和室に置き床を設えて、掛け軸を飾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "置き床を使うことで、どの部屋でも床の間のように使える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "部屋はたッた六畳敷きで、一間の押入れに置き床などがあって、古びた天井も柱もしっかりしていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お庄は声もかけずに、そっと押入れから小掻捲きを取り出して被けてやると、置き床のうえに据えた鏡台の前に坐って、銀杏返しの鬢を直したり、白粉をつけたりして、やがてまた部屋を出て行った。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "逢つたらあれも聞きたい、これも言はう、と胸一杯に「つもる思ひ」を持つてゆくのに、さて逢つて顏を見ると、もうなにもかにも心が充ちたりて、何も言ふことがないやうな氣がして、手のおきどころに困りながらだまつてゐるといふのである。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでもない、つまらぬことに悲観して、もう、身のおきどころがないなどと、世をはかなみ、命を捨てることは、ほんとうにもったいない話です。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "――我々は十分注意してヤマのおきどころ、心持の変化――恐怖、よろこび、好奇心、滑稽などを、教育的な筋の上へ按配するのです。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月一日朝の汽車でいつしよに戻る、そして河へ飛びこんで泳いだ、かうでもしなければ、身心のおきどころがないのだ、午後また泳いだ、六根清浄、六根清浄。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは其人々々の心のおきどころ次第である。",
              "citation": {
                "source": "やきもの讀本",
                "author": "小野賢一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たとえ、日本国中、いいえ、唐、天竺に身のおきどころがなくなっても、わたしは少しも厭いませぬ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……身のおきどころがない。",
              "citation": {
                "source": "島木赤彦臨終記",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互に、「こんなことは云はなくてもわかつてゐる」と思つて、その点には触れずにゐることが、案外、それを云はないために、重点のおきどころを誤り解されてゐるといふ場合が多いと思ひます。",
              "citation": {
                "source": "新劇倶楽部創立に際して",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "標準のおきどころにもよるし、経営の方針にもよるが、一般大衆の芸術的教養が今のままだとしたら、当然、さういふことをも考へに入れて、しかも、一方、劇場の文化的意義を果し得るやうな演し物が、果して、われわれの頭のなかで想像ができるか？",
              "citation": {
                "source": "新劇倶楽部創立に際して",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "床だと思っていると、それが、ぐらっとうごくと、天井になったり、そうかと思うと、天井が、横たおしになって、かべになったり、二人は身のおきどころもなかった。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、身のおきどころがないなどという生やさしいことではなく、からだとからだが、いやというほどぶつかり、そうかと思うと、鉄壁に、がーんと叩きつけられ、戦車が海底にやっと達したときには、とうとう二人とも気をうしなってしまった。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "剛子が、そっと猪股氏の方へふりかえって見ると、猪股氏は熟したトマトのようにまっ赤になって、身のおきどころもないように恐縮している。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の光の別離苦をはるか離れたこの法悦に、心のおきどころもないではないか。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "八時半に立つというのに、おひるを少々おそうにしたら、はアお夕飯はいりまへん、という胸一杯の有様で、まるで夕方まで身のおきどころのない顔をしてムズムズしていらっしゃる。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "身のおきどころもないような春の大和では、とくにこんな状態になる。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會觀のおきどころも違ふ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞盛や扶の妻が、身のおきどころもなく、蘆荻のあいだを、漂泊していたなどの事は、当時の実情として、甚だ、ありそうなことだし、将門がこれを殺さなかったという郷土の伝説には、多分に、それらしい事実もあったものと思われる。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば、いま天下に身のおきどころのない、落人が、そこをたよってくるのは、まことに自然だとかんがえます」「なるほど、ウム……さてはそうか！",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨戸の中は、相州西鎌倉｜乱橋の妙長寺という、法華宗の寺の、本堂に隣った八畳の、横に長い置床の附いた座敷で、向って左手に、葛籠、革鞄などを置いた際に、山科という医学生が、四六の借蚊帳を釣って寝て居るのである。",
              "citation": {
                "source": "星あかり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "半七は起って次の間へゆくと、ここは横六畳で、隅の壁添いに三尺の置床があって、帝釈様の古びた軸がかかっていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "半七は奥へ通されて、小さい置床の前に坐った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨戸の中は、相州西鎌倉亂橋の妙長寺といふ、法華宗の寺の、本堂に隣つた八｜疊の、横に長い置床の附いた座敷で、向つて左手に、葛籠、革鞄などを置いた際に、山科といふ醫學生が、四六の借蚊帳を釣つて寢て居るのである。",
              "citation": {
                "source": "星あかり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言って部屋の内を※すと、ぼんぼん時計、花瓶の菊、置床の上の雑誌、貸本が二三冊、それから自分の身体が箪笥の前にあるばかり。",
              "citation": {
                "source": "葛飾砂子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三　二階は上がり口が三畳で、押入れに置床のある次ぎの六畳に古い箪笥があり、父は敬神家とみえて天照皇大神の幅がかかっていた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから手提袋に納めて大切に持つて來た厨子を取り出して、型ばかりの置床の上に、私の父の位牌とならべて祀つて、今のパン菓子を供へようとする。",
              "citation": {
                "source": "胡瓜の種",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中には正太の意匠で、お俊の絵筆をかりて、小さな二枚戸に落葉を模様のように画かせた置床もあった。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "益満は、掛物さえかかってない、小さい置床を枕に、仰向きに、寝ていた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "置床にはがさつな鏡臺が一つあるきりの部屋である。",
              "citation": {
                "source": "秋果",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
