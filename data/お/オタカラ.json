          "literary": [
            {
              "text": "子供はお宝、オタカラ／＼というてあやしてゐる。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "採集植物シモツケソウ　クカイソウ　ルリトラノオ　キンバイソウ　ヤナギラン　ウスユキソウ　ヨブスマソウ　ノブキ　バイケイソウ　シュロソウ　ヒメユリ　シラヤマギク　オタカラコウ　タムラソウ　キオン　谷を上れば、右が霧ヶ峰主峰たる車沢山（？",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "刺繍をした黒｜天鵞絨の着物などを見ましたが、これは作り上げるのに幾年もかかるので、オタカラと云って大事にしています。",
              "citation": {
                "source": "親しく見聞したアイヌの生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら新しい生活になれそめたころ、乞食男爵の三人組がそろって姿を現して、「隠し持った品々オタカラの類をそろそろ取りだしたころではないかい。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            }
          ]
        }
