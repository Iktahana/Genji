    },
    "definitions": [
      {
        "index": 1,
        "gloss": "request",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "無理なお願いでしょうけれどもお願いしてみます。",
              "citation": {
                "source": "政治家と家庭",
                "author": "太宰治",
                "note": "青空文庫"
              },
              "source": "幻辞"
            },
            {
              "text": "「お願い、もう一度チャンスをください」と懇願した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "「お願いですから、その話は忘れてください」と頼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私の為のお願いではありません。",
              "citation": {
                "source": "政治家と家庭",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、持参の結納の品々を白木の台に載せて差し出し、「このたびは、まことに、――」と礼法全書で習いおぼえた口上を述べ、「幾久しゅうお願い申上げます。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「は、幾久しゅうお願い申上げます。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "四方八方に、幾久しゅう、幾久しゅうとばかり言うのも、まがぬけているような気がして、こんどは、「末永くお願い申します。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日、私は久しぶりで先生のお宅へお伺いして、大隅君の縁談を報告し、ついては一つ先生に媒妁の労をとっていただきたいという事を頗る無遠慮な口調でお願いした。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小松技師は帰りしなに、少し改って「実はお願いがあって参りましたのですが」　と言って、暫く黙っていたが、主人が気さくな顔をして応けているのを見て安心して言った。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで読者のうちで過去あるいは将来に類似の現象を実見された場合には、その時日、継続時間、降水の形態等についての記述を、最寄りの測候所なり気象台なり、あるいは専門家なりへ送ってやるだけの労を惜しまないようにお願いしたい。",
              "citation": {
                "source": "凍雨と雨氷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）以上　なるべく缶に入れて小包は厳重にお願いします。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけは是非お願い申して置かなくてはなりません。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぜひお願いしますわ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ではお願いがあるわ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「妾のお願いと云うのはね。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたにお願いと云うのはね、妾の同業の厚化粧ぐみをね、彼奴たちはどうせろくなことはやらないのさ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と私が言ううち、婦人は火鉢のそばにすわって、「先生私は少しお願いがあるのですが。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "まアザッとこんな苦しいわけで……けれどつかい込みの一件は、ごく内密にお願いします」と言って立ち上がり、石井翁が何も言い得ぬうちに、河田翁は辞儀をペコペコして去ってしまった。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お願いでございます。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫は早速追い出します」　しかし今まで可愛がって育てていたものを、自分が手ずから捨てにゆくには忍びないから、御迷惑でも御近所の人たちにお願い申して、どこかへ捨てて来て貰いたいと彼女は嘆いた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、なにぶんお願い申します」　おまきはさのみ未練らしい顔を見せないで、家じゅうの猫を呼びあつめて三人に渡した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何分こっちへ越してまいりましたばかりで、御近所の大工さんにだれもお馴染みがないもんですから、熊さんに頼んでこちらへお願いに出ましたので……」「左様でございましたか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "お役には立ちますまいが、この後ともに何分よろしくお願い申します」　得意場が一軒ふえることと思って、お初は笑顔をつくって如才なく挨拶した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "親分さんにお願い申して置けば、それでもう安心なんでございますけれど……」「冗談じゃねえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "「実はわたくしの母が昨年以来、なにか付き物でも致したようで、時々に取り留めもないことを口走りますので、まことに困り果てて居ります」　何分にもそのお祓いをお願い申したいと云って、半七は白木の台付きの箱をうやうやしく捧げて出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いえ、一々お取り次ぎは、かえってお願いの筋が通り兼ねるかとも存じます。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こなたが奉納の品を一応あらためてみろと云われるか」「どうぞお願い申します」　行者はなんにも云わなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「あたし今夜お詣りするの」　「お前がッ」　おふみ、Ｔ「兄さんとお類さんが是非一緒に来いッて言うんだもの」　伝六が――Ｔ「お詣りして何をお願いするんだい？",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今朝の葉書のこと、考えが変わってやめることにしたから、お願いしたことご中止ください」　今朝彼は暖い海岸で冬を越すことを想い、そこに住んでいる友人に貸家を捜すことを頼んで遣ったのだった。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ちょいとお願い申します。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一生のおねがいでございますから、どうぞその魚を一度みせてください。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもまあ無理はねえ、ともかくもこれから一緒に行って、皆さんに宜しくおねがい申してやろうと、こうして出てまいりましたものでございますが、一体まあどうしたんでございましょうね」「いや、別に仔細はない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
