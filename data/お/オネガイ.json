[
  {
    "uuid": "78e21bfd-5f66-5acc-8d08-9508144d5e10",
    "entry": "お願い",
    "reading": {
      "primary": "おねがい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
