        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "母が幼い子をおんりして、そっと地面に下ろした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "長距離を駕籠で運ばれた後、やっとおんりする時間がやってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "馬からおんりした武士は、砂ぼこりを払い落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "（上手の障子をあけて、台所に降りて障子をしめ、あとは声のみ）このごろはどうして、なかなか悪智慧が附いてね、おんりして歩かないかって言えば、急に眠ったふりなんかしてさ、いやな子だよ。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "おんりさせて貰ったときあの姉ちゃんもそう言ったわ。",
              "citation": {
                "source": "青バスの女",
                "author": "辰野九紫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
