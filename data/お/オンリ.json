  {
    "uuid": "048c02b4-2fe5-54ca-8654-723c44cdb5ce",
    "entry": "オンリ",
    "reading": {
      "primary": "おんり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「意味深長かも知れないさ……然し僕にはこれが生れて初めての、オンリイ一つの戀物語と云へば戀物語だ。",
              "citation": {
                "source": "Ｓ中尉の話",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっと、古いけどさ、〈ガッド・オンリー・ノウズ〉は？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウェル、ゴナ・ビー・ザ・ラスト・ソング・フォー・トゥナイト……ウー、ベイビー、アイ・ラヴ・オンリー・ユー、〈ユー・ベイビー〉」　ワラが、ドラムとスレイ・ベルをバックにささやく。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日は晴れる、晴れてくれ、晴れなければ困るといふ気分で、みんな早くから寝た、私だつて明日も降つたら、宿銭はオンリヨウだ（オンリヨウとはマイナスの隠語である）。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、ラブ・イズ・オンリー・ロウ、恋愛こそ唯一の掟、そう決心してもらいたいのです。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……まあ……あぶない……ゆっくりオンリしていらっしゃい」　しかし女の児は聴かなかった。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "委員会の席上、広池秋子の「オンリー達」を支持する声が二三あつたけれども、私は賛成しかねた。",
              "citation": {
                "source": "もうひと息",
                "author": "――芥川賞（第三十回）選後評――",
                "note": "青空文庫"
              }
            },
            {
              "text": "広池秋子の「オンリー達」を読んで、私は、なんのために、この作者は、かういふ女たちの生活をこんなに好奇心をふくらませて書くのかゞわかりかねた。",
              "citation": {
                "source": "もうひと息",
                "author": "――芥川賞（第三十回）選後評――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビジネス・オンリーとは、このことだろう。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビジネス・オンリーの私の旅行も、まず出発からタジタジであった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "省三　三月に一人ずつの恋人を持って、オンリイ、オンリイで次ぎから次ぎと、三年もたつと一中隊ぐらい兄弟になっちゃって、子供でも生れるとなったら、白いのかい黒いのかい、わからなくなったらフイシュ・スキンに聞いてみろい！",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "女史の作『イニシャルズ・オンリイ』がそれだ。",
              "citation": {
                "source": "Ｊ・Ｄ・カーの密室犯罪の研究",
                "author": "井上良夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "スオンリーへ着いた！",
              "citation": {
                "source": "予謀殺人",
                "author": "A CASE OF PREMEDITATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "終って、天ぷら食ひに南部僑一郎を連れて三直へ行く、飯なし時間だから、天ぷらオンリー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "たぶん、彼女はオンリーだろう。",
              "citation": {
                "source": "その一年",
