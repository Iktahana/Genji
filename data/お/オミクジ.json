[
  {
    "uuid": "b8bc88da-e87d-54ba-9468-4e7c99c01a88",
    "entry": "御神籤",
    "reading": {
      "primary": "おみくじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "fortune slip (usu. bought at a shrine)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "神社で御神籤を引いたら大吉が出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "毎年正月に御神籤を引く習慣がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この御神籤は何も運勢を占うものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "今もお堂で御神籤を頂いたんですが、やっぱり凶と出たので……」と、女は苦労ありそうに細い眉を寄せた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "御奥の老女は御神籤を下しに行く。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは試みに一銭銅貨を入れてみると、からからという音がして、下の口から小さく封じた活版刷の御神籤が出た。",
              "citation": {
                "source": "春の修善寺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍にもし霊あらば、どの御神籤にもみんな凶が出るに相違ないと思った。",
              "citation": {
                "source": "春の修善寺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうまでゆくえの知れない以上はもう死んだものに決まっているのだが、それでも死骸を見ない以上はまだなんだか未練があるので、おかみさんは今日も浅草の観音さまへ御神籤を取りに行った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "新カチカチ山",
                "note": "青空文庫"
              }
            },
            {
              "text": "安産のお守を受けたり、御神籤を引いている人もあります。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また御神籤を引いて」　継子は長さ二寸五分幅六分ぐらいの小さな神籤箱の所有者であった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "日參をして岡つ引に睨まれた日にや、江戸に怪しくない人間は幾人もゐないことになるぜ」「それが變なんで」「娘が綺麗過ぎるんだらう」「その綺麗過ぎる娘が、觀音樣にお詣りをするだけなら構はないが、必ず御神籤を引くのはどうしたわけでせう」「毎日か」「一日も缺かしません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "日も時も構はず、毎日御神籤を引くのは、いくら小娘でも變ぢやないか、八」「だからあつしが變だと言つたぢやありませんか――糸瓜に髷を結はせたり、意氣な袷を着せたのは親分の方で――」「そんなことはどうでも宜い。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それから三日の間に變つたことはないのか――若樣が見えなくなつてからだ」「奧樣が築土八幡樣へお詣りに行つただけです――え、昨日でしたか、御神籤を引いたら凶が出たとかで、ひどく萎れてゐらつしやいましたした」「お供は？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "神隱し",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も御神籤所で訊くと、奧方の抽いたお神籤は凶でなくて吉だつたさうで、少し變ぢやありませんか」「フーム」　平次は唸りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "神隱し",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ひ切りお賽錢をあげて、半日拜んだ揚句、この縁談を卜ふつもりで御神籤を抽いた――」「――」　緊張した空氣の中で、平次は懷中を搜りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            },
            {
              "text": "取出した紙入――その中に八つに疊んで挾んだのは、何の不思議もない、半紙半枚に刷つた御神籤が一枚です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おみくじだよ、元三｜大師の有難い御神籤さ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            },
            {
              "text": "隱居の勘兵衞さんは、この御神籤の文句の中に五千兩の金を隱した」「――」　恐ろしい緊張です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            },
            {
              "text": "御神籤の文句から思ひ付いて、その文字に當てはまるやうな隱し場所を拵へた。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            },
            {
              "text": "日参をして岡っ引に睨まれた日にゃ、江戸に怪しくない人間は幾人もいないことになるぜ」「それが変なんで」「娘が綺麗すぎるんだろう」「その綺麗すぎる娘が、観音様にお詣りをするだけなら構わないが、必ず御神籤を引くのはどうしたわけでしょう」「毎日か」「一日も欠かしません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、引いた御神籤を八つに畳んで、仁王門外の粂の平内様の格子に結わえる」「毎日同じことをやるのか」「あっしがつけてから十日の間、一日も欠かしませんよ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「巳刻（十時）から午刻（十二時）の間で」「待ちな、元三大師の御神籤には忌日があるものだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "日も時も構わず、毎日御神籤を引くのは、いくら小娘でも変じゃないか、八」「だからあっしが変だと言ったじゃありませんか――糸瓜に髷を結わせたり、意気な袷を着せたのは親分の方で――」「そんなことはどうでもいい。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「若くてちょっと渋皮のむけた娘の後をつけるんだから、どうせまともな人間じゃありません」「お前もそのまともでない人間の一人だろう」「へッ」「ところでその娘は、引いた御神籤をていねいに読むのか」　平次の問いは妙なところへ立ち入ります。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その八五郎が、美しい下女のお菊の動静を見張っているうち、浅草の日参と、御神籤と、粂の平内様の格子の謎を見付けたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たいそう早いじゃないか」「でも根岸から観音様に廻ると、昼近くなりますよ」「そいつは正直すぎるだろう、御神籤所を見張っただけでたくさんだよ」　だが、このガラッ八の馬鹿正直さが、平次のために、いろいろのことを発見してくれるのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なるほど」「あ、娘は御神籤を引いていますよ」「しッ」　下女のお菊は御神籤を引くと、別段それを見るでもなく、八つに畳んで、もう一つ中ほどから折って帯のあいだへすべり込ませました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "お菊は粂の平内様の堂の前に立つと、これも事務的な冷静さで、帯のあいだから先刻の御神籤を取出し、堂の格子へ器用な手付でざっと結びました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの格子に、たくさん御神籤が結んであるだろう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「端っこをちょいと紅で染めた御神籤だよ――天地紅の御神籤なんかどこのお寺へ行ったって出るものじゃない」「ヘエ――」「あの娘は観音様の本堂からここまで来るあいだに、御神籤の端を染める暇がなかったはずだ」「？",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "教科書の問題を解くのでも、おみくじかなんかを引くように、できるもできないのも運次第のものででもあるかのように思っていた自分のような生徒たちには、先生のこの説は実に驚くべき天啓であり福音であった。",
              "citation": {
                "source": "田丸先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水をかけ終ると、やがて彼女たちはおみくじをひく。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "凶のおみくじをひいたときは、その隙間へおみくじを縛りつけて置く。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
