        "examples": {
          "standard": [
            {
              "text": "医学の教科書でおまんこについての解説を読んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "産婦人科の専門書にはおまんこの構造が詳しく記載されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "人体の構造としておまんこについて学習する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それに引替え、三万円の貯金と、バラックながら二軒の家持ちの桂子、私は子供の頃、ひとから（おまんこ倉）と綽名される、美貌の未亡人の白塗りの倉を持った家が近くにあったのを思いだす。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            }
          ]
        }
