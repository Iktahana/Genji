        "examples": {
          "standard": [
            {
              "text": "その帯の織り色は紫と金色の組み合わせで、とても高級感がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "職人は何十種類の織り色の中から、この作品に最適な組み合わせを選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古い着物の織り色が褪せてしまい、修復に出すことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "大河内氏もいわれたとおりいろいろの社会的施設の不備について改善を要求する発言をしていろいろの行動をしているのです。",
              "citation": {
                "source": "浦和充子の事件に関して",
                "author": "――参議院法務委員会での証人としての発言――",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろな目というのは文字どおりいろいろな目だが、その中で一番極端なものは戦争といったような事であろう。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その結果はどうかというと、毎日、新聞でごらんのとおりいろんなことがでてくる。",
              "citation": {
                "source": "親鸞聖人について",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄は常に善良な王党の人でありますので、御承知のとおりいろいろなことを知っており、いろいろな事を記憶しております。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
