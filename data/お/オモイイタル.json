[
  {
    "uuid": "e27ef841-9029-562d-b7e1-2c7c9d0ee608",
    "entry": "思い至る",
    "reading": {
      "primary": "おもいいたる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null,
      "ctype_source": "pos-derived",
