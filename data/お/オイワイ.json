[
  {
    "uuid": "66e11b81-6068-5bbe-98b4-4be6d5899dfd",
    "entry": "お祝い",
    "reading": {
      "primary": "おいわい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
