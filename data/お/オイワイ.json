        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "友人の出産に、ささやかなお祝いを持っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "入学のお祝いとして、祖父母から新しいランドセルを贈られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "社長は長年の功績を称え、退職する社員に特別のお祝いを渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
