[
  {
    "uuid": "bf72c93e-c529-5fdd-83a3-e3db4f351028",
    "entry": "降りる",
    "reading": {
      "primary": "おりる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
