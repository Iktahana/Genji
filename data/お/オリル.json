  {
    "uuid": "79f3f1b0-113d-5383-8e52-efa09475f83f",
    "entry": "下りる",
    "reading": {
      "primary": "おりる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "上一段-ラ行",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「生命なき砂の悲しさよさらさらと握れば指の間より落つ」「高きより飛び下りる如き心もてこの一生を終るすべなきか」と。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶頂から山越しに向へ一里半も下りると、中股というへ出られる。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた針葉樹林を駈け下りる、水の音がするすると、樹の間を分けて上って来るようだ、水！",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜中からは、ざんざ降りで、尾根伝いの笠ヶ岳登りを見合せて、蒲田谷へ下りるより、外にしようはなかった。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "町は、絶えず山から下りる人、登る人で賑わっている。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここから精進口の登山新道、三合目へ下りることが出来て、途中に中庭、奥庭などを通過するそうだ。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪が氷河になると、その山側を擦り下りる圧力で山体を銷磨して行く。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへは、縄梯子をガットにかけて下りるより外に方法はなかった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "病人を負って下りることもできなかった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "水火夫室から、倉庫へ下りる事は、負って下りると云う方法で行われた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "どう考えても、私には、それより他に生き方が無いと思われて、三つの手紙に、私のその胸のうちを書きしたため、岬の尖端から怒濤めがけて飛び下りる気持で、投函したのに、いくら待っても、ご返事が無かった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空もからりと晴れていたし、私たちはぶらぶら歩いて途中のけしきを見ながら山を下りるから、と自動車をことわり、一丁ほど歩いて、ふと振りむくと、宿の老妻が、ずっとうしろを走って追いかけて来ていた。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからは時々、庭へ下りる度にわざわざ覗いてみたが、蜂の居ない時はむしろ稀であった。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう云えば新橋で下りる人もかなりあった。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "北の階段を下りる時には何だか少し気分が悪かった。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "落葉松の林中には蝉時雨が降り、道端には草藤、ほたるぶくろ、ぎぼし、がんぴなどが咲き乱れ、草苺やぐみに似た赤いものが実っている、沢へ下りると細流にウォータークレスのようなものが密生し、柵囲いの中には山葵が作ってある。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りの汽車が追分辺まで来ると急に濃霧が立籠めて来て、沓掛で汽車を下りるとふるえるほど寒かった。",
              "citation": {
                "source": "高原",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまたま停まる停車場に下りる人もなければ乗る人もない。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "壇上の人が下りると、上壇に椅子へ腰かけた人、これが議長だそうであるが、この人が何か一言二言述べると、左の方の議員席からいきなり一人立上がって大きな声でわめき立てた。",
              "citation": {
                "source": "議会の印象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "右報告、と捨てぜりふのように、さも苦々しく言い切って壇を下りると、またがやがやと騒ぐ声が一しきりした。",
              "citation": {
                "source": "議会の印象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで止むを得ず瓦斯を抜き無事に地上に下りるを得た。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "池の方へ下りる坂脇の稲荷の鳥居も、柱が立って桁が落ち砕けていた。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳独秀は虹のように地面に這入った彼の腕から拳銃をとると、虚空に一発打ち放して花火のように彼方に舞下りる弾丸を見つめながら、――何故死なねばならないのだ！",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳独秀は虹のように地面に這入った彼の腕から拳銃をとると、虚空に一発打ち放して花火のように彼方に舞い下りる弾丸を見つめながら、――何故死なねばならないのだ！",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　何も、肯分けるのでもあるまいが、言の下に、萩の小枝を、花の中へすらすら、葉の上はさらさら……あの撓々とした細い枝へ、塀の上、椿の樹からトンと下りると、下りたなりにすっと辷って、ちょっと末を余して垂下る。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐに、くるりと腹を見せて、葉裏を潜ってひょいと攀じると、また一羽が、おなじように塀の上からトンと下りる。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "下りると、すっと枝に撓って、ぶら下るかと思うと、飜然と伝う。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一羽が待兼ねてトンと下りる。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞き定めて、「おや、」と云って、一段｜下流の板敷へ下りると、お源と云う女中が、今しがたここから駈け出して、玄関の来客を取次いだ草履が一ツ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度その下に漁夫が四人程居て、ウインチの腕が短いので、下りてくる川崎船をデッキの外側に押してやって、海までそれが下りれるようにしてやっていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
