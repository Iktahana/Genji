[
  {
    "uuid": "cc6e2d97-1259-58e7-80d0-df06599d8059",
    "entry": "大売り出し",
    "reading": {
      "primary": "おおうりだし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "big bargain sale",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "デパートでは、年末恒例の大売り出しが開催されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大売り出しのチラシを見て、開店前から列に並んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "欲しかった家電が、大売り出しで半額になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "銘仙ですらがそんな景気ですから、その他のもののはけぐあいがいいことはもちろんのことで、二日三日と大売り出しが重なっていくにつれて、客は客を呼び、評判は評判を生んで、まことに文字どおり店先は市をなすの盛況でありました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　時刻はすでに四ツを回って、普通ならばとっくに寝ついているべきはずでしたが、昼の大売り出しの勘定がつかないとみえて、まだ生島屋ではいずれもが起きていましたので、右門はかって知った内玄関のほうへ駕籠を乗りつけると、案内も請わずにずかずかと門内へはいっていきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "見えるのは軒なみにはためいている「中元大売り出し」という幟くらいなものだ。",
              "citation": {
                "source": "ジャンの新盆",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "空には軽気球がうかんでいて、百貨店の大売出しの広告文字がぶらさがっていた。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど街路を一つ隔てた向かい側に、同じような百貨店の大建築が出来上がり、その開店大売出しが今日だというので、こっちでも負けずに客を取ろうというのであった。",
              "citation": {
                "source": "或る嬰児殺しの動機",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のように各町内連合の年末大売出しなどというものはない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸以来の名物たる錦絵がほろびたと云うのは惜しむべきことに相違ないが、わたしは歳晩の巷を行くたびに特にその感を深うするもので、いかに連合大売出しが旗や提灯で飾り立てても、楽隊や蓄音器で囃し立てても、わたしをして一種寂寥の感を覚えしめるのは、東京市中にかの絵草紙屋の店を見いだし得ないためであるらしい。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "年末大売出しの紙ビラや立看板や、紅い提灯やむらさきの旗や、濁った楽隊の音や、甲走った蓄音機のひびきや、それらの色彩と音楽とが一つに溶け合って、師走の都の巷にあわただしい気分を作っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "勘平の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は諸支払の合計を新聞に入つて来た呉服屋大売出しの広告紙の裏に記して見る。",
              "citation": {
                "source": "日本三文オペラ",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃神楽坂では、特にその繁栄策として、盆暮の連合大売出しの外に、毎月一回位ずつ定時の連合市なるものをはじめたが、その日も丁度それに当っていて、両側の各商店では、一様に揃いの赤旗を軒先に掲げて景気をつけていた。",
              "citation": {
                "source": "早稲田神楽坂",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は歳暮大売出しと大きな門をつくった内の三省堂に本をかいによった。",
              "citation": {
                "source": "心配",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "街は賑やかで、何処も大売出し。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見世物の小屋に立って居る様な幟りに「歳暮大売出し」「大々的すて売り」「上等舶来、手袋有※」などと書いたのがバタバタ云って居る。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "歳暮大売出しの楽隊の音、目まぐるしい仁丹の広告電燈、クリスマスを祝う杉の葉の飾、蜘蛛手に張った万国国旗、飾窓の中のサンタ・クロス、露店に並んだ絵葉書や日暦――すべてのものがお君さんの眼には、壮大な恋愛の歓喜をうたいながら、世界のはてまでも燦びやかに続いているかと思われる。",
              "citation": {
                "source": "葱",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "外では歳暮大売出しの楽隊の音がする。",
              "citation": {
                "source": "饒舌",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "（産業講習会における講演）大売出しについて　開店後かなり年月を経過したが、特別のある期間を限り、特別のある試みを行い、それで、世俗の所謂「大売出し」をやったことは一度もない。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の店では一ヶ年を通じて、毎日毎日が大売出しである。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "大売出しの計画はもとより結構であろう。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、それは販売品の種類によりけりで、私の店のように、日々の消費を予想し、日々の愛用を目的とし、しかもその製品の総てが新しきを尊び、美味なるを貴しとする製菓、製パン商にあっては、一定期間内における一時的売上げ増進策を図り、他店のそれに見様見真似した大売出しを行うことは出来ない。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私は大売出しに就いて、従来一度も計画したり、また実行した例はないけれど、日常絶えず売上げ高の平均増大に就いて考慮をめぐらして来た。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "大売出しは一種の注射　大売出しは一種の注射的商売繁栄策である。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "平素に製造全能率、販売全能率を挙げつつあるならば、決してそこに大売出しを企てるべき余力が生じて来ぬ。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "大売出しを行わないで、また大売出しを必要としないで、それで一日一日の全能力を発揮し、商売の繁閑平均を求め、製造原価と営業経費の低減を期してこそ、商店としての信用を博し、商店としての強みを有し、商店としての繁栄を招来することを得るのである。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして徐々に、堅実に、全体的の売上げ増進策をはかり、一年三百六十五日、毎日毎日が大売出しの意気込みで、顧客に臨みつつあるのである。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、町の化粧品やさんで、大売出しをやつてゐました。",
              "citation": {
                "source": "お猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間でも中元大売出しってワイワイ騒ぐだろう。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "その拙文のなかで、十二月のデパートの賑やかさを見て来たぼくが、歳暮大売出しなどのことを女房に話しかけると、「私だけですよ。",
              "citation": {
                "source": "貧乏を売る",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "街をゆくと大売出し、タナざらい、残品サービスセール、全店半額、などという旗やビラが軒並にかかげられ、スピーカーや店員たちの客を誘惑しようとする声がかみついてくる。",
              "citation": {
                "source": "年の瀬の音",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "楊雄夫妻も大賛成で、日ならずして“開店大売出し”の爆竹（花火）、ちらし、慶祝の紅挑灯などが、どんちゃん、ここの街角をにぎわした。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚を大売出しにして。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
