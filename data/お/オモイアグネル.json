        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "どう謝ればいいか思いあぐねているうちに、三日が過ぎた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "転職すべきかどうか思いあぐねて、夜も眠れなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "両親への告白のタイミングを思いあぐねたまま、年が明けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "とつおいつ思いあぐねるうち、いよいよ無力の孩児としての感じを自分に深めて来た老翁は、いまは何もかもかなぐり捨て、ひたすら娘に縋り付き度くなった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだのに、あの方はまたあの方で、「おれの何処が気に入らないのだ」と云った顔つきをなすって、少しも悪びれずにいらっしゃるので、本当にどうしていいのやら、私は思いあぐねるばかりだった。",
              "citation": {
                "source": "かげろうの日記",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
