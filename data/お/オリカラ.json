[
  {
    "uuid": "4108aaee-823a-57b0-a917-2f80741651c5",
    "entry": "折から",
    "reading": {
      "primary": "おりから",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
