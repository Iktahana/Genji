          "standard": [
            {
              "text": "折から春祭りの準備が進んでいる時期でした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "折からインフルエンザの流行している季節です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "折から台風シーズンなので警戒が必要です。",
              "citation": {
