          "standard": [
            {
              "text": "追跡ページを確認すると「お届け済み」のステータスになっていたが、ポストには何も入っていなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "アプリの通知に「お届け済み」と表示されたので、玄関に出てみると荷物が置いてあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「先ほどお届け済みとなっておりますが、ご確認いただけましたか？」と配送センターから電話が来た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
