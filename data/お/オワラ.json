        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ネエチヤンハ「オカシナミミデスネ」トオツシヤツテ、オワラヒニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "茂兵衛　（お蔦を見あげ、黙って行きかける）お蔦　　（唄いつづける）盛り過ぎればオワラちらばらと。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蔦　　（お君の唄を制そうとする）辰三郎　（お君の手を撫ぜつつ聞いている）お君　　（唄う）盛り過ぎれば、オワラ、ちらばらと。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
