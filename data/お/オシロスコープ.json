          "standard": [
            {
              "text": "電気回路の故障箇所を特定するため、オシロスコープを使用した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "画面上の波形が乱れているので、オシロスコープの調整が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "大学の授業で、初めてオシロスコープの基本的な使い方を教わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "スケジュールに追われて、休日、自宅でオシロスコープを睨みながら試作機の回路をいじっていたとき、後藤氏もまたラジオを聞いていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の隅に置かれたオシロスコープは今のところほとんど使ったことがないが、将来的には合成音声を自分たちのサウンドに取り入れていくつもりなので、結局は楽器の仲間入りをすることになるだろう。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
