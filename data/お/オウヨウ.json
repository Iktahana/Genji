        "examples": {
          "standard": [
            {
              "text": "鷹揚な表情で、彼は部下の意見を静かに聞いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その作家の鷹揚な筆致は、読者に落ち着きと安定感をもたらす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "母親の鷹揚な対応のおかげで、娘は安心して学校生活を送ることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
