        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "自分の過ちの大きさを思い知らされて、後悔した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大人になって初めて親の苦労を思い知らされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "失敗によって自分の限界を思い知らされた経験が大事だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その酬いを、ここでフックに思い知らすわけであるが、ピーターの要求は、フックに「私は卑怯者だ」と言えというのである。",
              "citation": {
                "source": "ピーター・パン",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正季は腹をたてて、それらの卑怯者を、後日、きっと思い知らすぞと、ののしッたが、いまはそんな処置をとっているひまさえない。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
