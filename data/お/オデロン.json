          "literary": [
            {
              "text": "いの一番にオデロン劇場へ行ってニタ・ラインハードを見よう。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて二人は歩いてオデロン劇場へ行った。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オデロン劇場から全員来ているのですか。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "大勢の男女がしゃべくり陽気に笑いながら周りに集まってきて、ほとんどの連中をすぐ見分けられたのはオデロン劇場で見ていたからだ。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "オデロン劇場へ着く頃にはすっかり忘れ、ニタも笑顔を取り戻した。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンテナナ国王とオデロン劇場の花形女優とが秘密裏に結婚』「おお、誓って笑い事じゃありません。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かに並木道をオデロン劇場の方へ、物思いに沈んで歩いていると、伝令少年が肩を触った。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "オデロン劇場に着く頃は遅くなっていた。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "振り返って見れば、オデロン劇場のクラレットだ。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はオデロン一座が全員｜登城していた。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろんオデロン劇団員全員に加えて、劇中軍隊を演じるエキストラも含まれます」「船なら百人は乗れる」「そんなに大勢じゃありません、ふふふ。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "オデロン劇場から来ました」「見たところ兵士ですぞ。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "女王は旧知のオデロン劇団員を招かれた。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            }
          ]
        }
