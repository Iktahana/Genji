        "examples": {
          "standard": [
            {
              "text": "オウム病はペットの鳥から人間に感染する危険な感染症です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "野生の鳥から採取した標本でオウム病の菌が見つかり、注意が呼びかけられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オウム病の症状が出たら、すぐに医師の診察を受ける必要があります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "このことはトリのオウム病やヒツジの「跳躍病」についての最近の経験に明らかに示される。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "このようにして脳炎は麻疹、天然痘、風疹、インフルエンザ、に引き続いて起きることがあるしオウムの病気であるオウム病や「跳躍病」と呼ばれる病気を研究しているときに起きる実験室感染で脳炎類似の状態が起きる。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
