        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い星図には、北斗七星の近くに黄幡という星が記されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古代の天文学者は、黄幡の動きを注意深く観察していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "黄幡星は、かつて夜空の重要な目印とされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "すなわち、太歳神、大将軍、大陰神、歳刑神、歳破神、歳殺神、黄幡神、および豹尾神の八神である。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
