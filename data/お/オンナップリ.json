        "examples": {
          "standard": [
            {
              "text": "年を重ねるごとに女っぷりが上がっていく彼女を見て、同窓会のたびに旧友たちは感嘆の声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「離婚してから女っぷりが上がったね」と共通の友人に言われ、彼女は照れながらも少し誇らしかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "着物をさらりと着こなす姿が板についてきて、周囲からも「女っぷりが違う」と言われるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「やあ晴ちゃん、病気してすばらしく女っぷりがあがったね。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　「目じりをもう三｜分上げると女っぷりが上がるがな――」　「あんた！",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「目じりをもう三｜分上げると女っぷりが上がるがな――」「あんた！",
              "citation": {
                "source": "小説　不如帰",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "着てえ物は何でも着れるし――ほんとに、お世辞じゃあないが、お前はこのごろずんと女っぷりが上がりましたぜ。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼んでも来てもらいたいようなキッパリとした女っぷり。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "永代経",
                "note": "青空文庫"
              }
            },
            {
              "text": "道中馴れたお角の歯ぎれのいい女っぷりに、事新しく感心したらしいお銀様。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十「カタリナはこの前会うた時分より女っぷりが一段上ったのと違うか知らん。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
