  {
    "uuid": "6ff6977c-05e7-597d-8345-0b4ef9e957c9",
    "entry": "オメ",
    "reading": {
      "primary": "おめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "万物が火より成るとか、地水火風から成るとか、また金は金、骨は骨と、いわゆるホメオメリアより成るとか、そういう考えから来る困難を列挙し、また一方では自説に対するこれら他学派の持ち出すべき論難に対して勇敢に応戦している。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポアンカレのいわゆるゲオメーター型の学者と思われた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "電子ビームがブラウン管を走査していくタイミングに合わせて、ビデオメモリーの中身を表示させる基本的な機能を持ったＣＲＴコントローラーは、出来合いの部品の中にもあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし階級争闘というものが現代生活の核心をなすものであって、それがそのアルファでありオメガであるならば、私の以上の言説は正当になされた言説であると信じている。",
              "citation": {
                "source": "宣言一つ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　タウトウ　イチバン　イタダキニ　ヰタ　ツボミガ　オメメヲ　ヒライテ　花ニ　ナリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ　シタノデセウ」「マダ　ネンネシテルノカシラ」「ワタシタチガ　モウ　オメメヲ　ヒライタ　コトヲ　シラナイノカシラ」「モウ　ハルガ　キテルノヲ　シラナイノカシラ」　ソコデ　花タチハ　マダ　ヒラカナイ　ツボミヲ　オコシニ　カカリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ　ヒラカナイ　ツボミサン　モウ　ハルデスヨ、オンモニ　デテ　イラツシヤイ」「マダ　ネンネシテル　ツボミサン　オメメヲ　サマシナサイ」　スルト　ツボミガ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　アカチヤンハ　モウ　オメメヲ　アイタカ　ミテ　キテ　チヨウダイ」　テフテフハ　スグ　ウマヤノ　マドカラ　ナカニ　ハイツテ　イキマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン　コンニチハ」「オヤ　テフテフサン　コンニチハ」「アカチヤンノ　オメメハ　アキマシタカ」「ケサ　ヤツト　アキマシタ」　ミルト　オウマノ　アカンボハ　ネワラノ　ナカデ　パツチリ　オメメヲ　アケテ　オトナシク　シテ　ヰマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互に憎んで戦って居る相手から、そうした申出を示された時、少しでも気概のある男であったら、オメ／＼と受けるだろうか。",
              "citation": {
                "source": "神の如く弱し",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギリシアのジオメデス王、その馬に人肉を飼ったが、ヘラクレス奮闘して王を殺し、その尸を馬に啖わしむると温柔しくなったという。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の唇を見ると、その詞が『ステレオメトリイ』と云ふ詞らしかつた。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそのお咎めを諫めもせずに、オメオメと承って来る大目付も大目付じゃ。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分、半蓋馬車に乗つて行けるだらうが、忌々しいことに腕白どもが後から後から釘を抜き取つてしまつたから、オメーリコにさう言つて、よく革を打ちつけさせんことには。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "馭者のオメーリコ――彼は時には作男であり、時には夜番でもあつた――が、朝早くから鉄槌でカンカンと革を打ちつけながら、あとからあとから車輪の脂を舐めに来る犬どもを引つきりなしに追ひ立てた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "正午ころ、一通り馬車の手入れが終ると、オメーリコは厩から、半蓋馬車よりは幾らか年齢の若い三頭の馬を曳き出して、その偉大なる馬車に繋いだ。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいかえ、オメーリコ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、見ろ、こんな様をオメ／＼と一体誰に報告が出来るものか。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "折角｜爰まで踏出しながら、何にもしないで手を空うしてオメオメとどうして帰られよう。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代思想のアルファでありオメガである。",
              "citation": {
                "source": "生の拡充",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史的実在の世界は日常的世界である（そこが哲学のアルファでもオメガでもある）。",
              "citation": {
                "source": "フランス哲学についての感想",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば純粋経験の事実は我々の思想のアルファでありまたオメガである。",
              "citation": {
                "source": "善の研究",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "統一は実に意識のアルファでありまたオメガであるといわねばならぬ。",
              "citation": {
                "source": "善の研究",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一名はオメケイオコデと為し、一名はオメナイオコデと為し（方言、男兄弟をオメケイと言い姉妹をオメナイと言う）、其の神を祭る一切の事を掌る。",
              "citation": {
                "source": "ユタの歴史的研究",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            }
          ]
        }
