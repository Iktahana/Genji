        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「どうかこの書をお目に触れていただければ光栄に存じます」と著者は献辞に記した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "店主は「この逸品がお客様のお目に適うかどうか」と言いながら、桐箱をそっと開けて見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長旅から戻った夫は「久しぶりに子どもたちのお目にかかれて嬉しかった」と日記に書き残した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
