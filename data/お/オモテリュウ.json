        "examples": {
          "standard": [
            {
              "text": "茶道の表流は、千家の中でも最も古い流派である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女は表流の大家に師事して、三十年間修行を重ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "表流の点前は、その洗練された所作で知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "武野紹鴎とか千利休が出て法式を整へたので、千家表流・千家裏流・千家武者小路流などが出来、更に、石州流・有楽流・藪内流・遠州流などの流派が出来た。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
