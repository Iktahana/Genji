[
  {
    "uuid": "5c676161-2e1a-5b16-ad4a-4ad554a07def",
    "entry": "己等",
    "reading": {
      "primary": "おいら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "代名詞"
      ],
