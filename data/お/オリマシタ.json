          "literary": [
            {
              "text": "私ハ妻子ヲ失ッタ悲シサノタメニ酒色ニ溺レテ、恵ミ深イ大恩アル祖母ノ事ヲ忘レテオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳町、大浜ト飲ミマワッテ、化粧ノ女ト遊ビ狂ウテオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ、アノ新聞記事ヲ見マシテカラ、ヤット昨晩、家ニ帰ッテ見マシタラ、祖母ハ蚊帳ノ釣手ニ、妻ノ赤イ細帯ヲカケテ、首ヲククッテ死ンデオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トイツテ、ソヽツカシイカエルサンハ高イ木ノ枝カラ、ポント土ノ上ヘ飛ビオリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メヲパチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲオリマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　メヲ　パチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲ　オリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒカウキニ　ノッテ、ウミノ　ウヘヤヤマノ　ウヘヤモリノ　ウヘヤマチノ　ウヘヲ　トンデ、レンペイジヨウヘ　オリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイ、オ帰リニナッタコトヽ存ジテオリマシタラ………」「アヽソウカイ」「………オ二階デ涼ンデイラッシャイマシタンデ、………」コップガ二ツトコカコラノ壜ガ二ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ニハヨクアルコトデゴザイマス」「ジャ、君ハ前カラ知ッテタノカ」「ハア、近頃ハ毎朝伺ッテオリマシタ、ピイピイッテ、オ可愛ラシイオ声デ」「婆サンニモコノ声ヲ聞カシテヤロウ」「知ッテラッシャイマスヨ、ソンナコト」「颯子ガ聞イタラ笑ウダロウナ」「若奥様ダッテ御存知ナイコトガアルモンデスカ」五日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
