    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "試合のときは、ひとゲエムのあひまあひまに團長が扇子をひらひらさせて、オオル・スタンド・アツプと叫んだ。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は詩を書いてポオル・フオオルに讀ませたらよい。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラブ員は海賊のユニフオオムを一着すること。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の片隅にはアオイ・ホテルから小湊へ事件後返り咲いたお六が、南京刈の男のウィンクに応じて立上るとショートオオダァのために別室に消えた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "Bullock 恋にやつれたエレクトラの広告板から湧き出すオオケストラ、しかも彼女の才能は日比谷街にもまして複雑なのだ。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヤミのオオケストラ、彼の人糞。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、臥床のお蔭で文藝春秋、三田文學、中央公論、改造、話、オオル讀物、モダン日本などの十二月號、エラリイ・クイインの三作、それに土居市太郎八段から贈られた「將棋作戰學」までも讀み上げてしまつた。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "プレモ、オオトシヤツタア、ソルントンシヤツタア、フオルカルプレンシヤツタア、カアルツアイス、百分の一、千分の一、テツサア、アナスチグマツト――さういふ寫眞用語がいかに歴亂として私の腦裡を動き、いかに胸躍るやうな空想を描かせ、いかに儚ない慰樂を與へたことか？",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この独白に対して、汽車の轟は、一種のオオケストラを聞くがごときものであった。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の陰気な影をうけて、凄いような色の白いのが、黒の中折帽を廂下りに、洋杖も持たず腕を組んだ、背広でオオバアコオトというのが、色がまた妙に白茶けて、うそ寂しい。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウオオオオオ　鉄づくりの門の柱の、やがて平地と同じに埋まった真中を、犬は山を乗るように入ります。",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪を払えば咽喉白くして、茶の斑なる、畑将軍のさながら犬獅子……　ウオオオオ！",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり恥ずかしく日夜悶悶、陽のめも見得ぬ自責の痩狗あす知れぬいのちを、太陽、さんと輝く野天劇場へわざわざ引っぱり出して神を恐れぬオオルマイティ、遅疑もなし、恥もなし、おのれひとりの趣味の杖にて、わかきものの生涯の行路を指定す。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "切支丹屋敷にオオランド鏤版の古い図があるということを奉行たちから聞き、このつぎの訊問のときにはひとつそれをシロオテに見せてやるよう、言いつけて散会した。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは、だいいちばんに、あのオオランド鏤版の地図を板縁いっぱいにひろげて、かの地方のことを問いただしたのである。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオヴェルニュのクレエルモン・フェラン市にシブレエ博士と呼ぶ眼科の名医が居た。",
              "citation": {
                "source": "女人訓戒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども他の船客たちは、私と反対に、むくりむくり起きはじめ、身仕度にとりかかるやら、若夫人は、旦那のオオヴァを羽織って甲板に勇んで出て見るやら、だんだん騒がしくなるばかりである。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」赤いオオヴァを着た十歳くらいの少女が、傍の紳士に尋ねている。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "○オクツタ」ユイノウタノム」ケツコンシキノシタクセヨ」アスペキンタツ」オオスミチユウタロウ　同時に電報｜為替で百円送られて来たのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若侍の一人が「オオＴ「いい所へ、進藤氏　中村座へ行こう」　進藤、震え上って「馬鹿な事」　若侍が、Ｔ「日下部先生をお頼み　したから　今日は大丈夫」　成程、強そうな日下部典六の一党。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲蔵「ハイ、私奴が仲蔵で……」　嘉助「オオ」Ｔ「矢ッ張り………」　と狂喜の如く仲蔵の傍へ。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "振り返った典六「オオ、五郎蔵」と身構える。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "日下部「オオ大吉」と叫ぶ。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さいオスワルドは熱心に何事か聞かうと思つて、フオオクに突き刺した肉を口に入れるのを忘れてゐた。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから又プラツトフオオムへ出て、もう一度同じ地名を呼んだ。",
              "citation": {
                "source": "駆落",
                "author": "DIE FLUCHT",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
