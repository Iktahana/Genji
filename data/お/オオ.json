        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「おお、気持ち悪い虫が出た！」と彼女は椅子の上に飛び上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「おお、またあの課長の長話が始まった」と後輩は小声でこぼした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「おお、雨か。傘を持ってこなかった」と彼はうんざりした顔で空を見上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
