      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "envelope containing a bonus paid to venue staff on the occasion of a full house",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公演の成功を祝い、座長は役者たちに大入り袋を手渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "千秋楽には、スタッフ全員に大入り袋が配られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "予期せぬ大入り袋をもらい、みんなの顔がほころんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あけ荷、衣桁、衣裳、鬘、丸型朱塗りの大鏡台、赤を白く抜いた大入り袋、南京繻子の大座布団、ひらいたままの草双紙、こういった物が取り乱されてあったが、女太夫の部屋だけに、ひときわ光景がなまめかしい。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐるりには大入袋や安っぽい石版摺りの似顔絵などが、一面に張られていて、壁地の花模様などは、何が何やら判らないほどに、色褪めていた。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には大入袋も送って来た。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような調子の総ざらいは、大入袋ではないから景気はよくない。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "初日の評判を後にして、その日いっぱいの上り高のしめくくりをしたお角は、払い渡すべきものは即座に払い渡し、大入袋の割振りまできびきびとやっつけて、残った金を両替にすると、それを恭しく紙に包んで男衆を呼びました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その月の総売上げと大入袋の金額と回数、その他の材料を大卓上にならべておき、あなた方に渡す手当の明細書の各項目に一つ一つ書き込む。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "千代子はその晩興行主から大入袋の外に特別の賞与を貰って、人から羨しがられたが、自分ながら怪しむほど嬉しい気がしなかった。",
              "citation": {
                "source": "心づくし",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは心ばかりの本日の贈りものですが」　と大入袋がめいめいにくばられた。",
              "citation": {
                "source": "ストリップ修学旅行",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "トチリし者十何人にのみは、大入袋をやらず、技芸賞も今回は無し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座員にも明日大入袋が出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十時ハネて、久々で赤い大入袋を貰って、夜の一時すぎの汽車で帰京の途につく。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今月の技芸賞は轟美津子、努力賞を「自叙伝」の中学生にやり、大入袋を皆に分ける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "本社に呼ばれ、一同へ五円宛の大入袋が出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
