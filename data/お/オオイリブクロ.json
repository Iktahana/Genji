        "examples": {
          "standard": [
            {
              "text": "公演の成功を祝い、座長は役者たちに大入り袋を手渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "千秋楽には、スタッフ全員に大入り袋が配られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "予期せぬ大入り袋をもらい、みんなの顔がほころんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あけ荷、衣桁、衣裳、鬘、丸型朱塗りの大鏡台、赤を白く抜いた大入り袋、南京繻子の大座布団、ひらいたままの草双紙、こういった物が取り乱されてあったが、女太夫の部屋だけに、ひときわ光景がなまめかしい。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
