        "examples": {
          "standard": [
            {
              "text": "久しぶりに会った同僚に面忘れしてしまい、失礼を詫びた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "人の多い同窓会でつい面忘れしてしまい、相手が名乗るまで誰だか分からなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "幼なじみとはいえ二十年以上のブランクがあり、彼女のことを面忘れしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "英国の学者社会に多人数知己が有る中に、かの有名の「ハルベルト・スペンセル」とも曾て半面の識が有るが、シカシもう七八年も以前の事ゆえ、今面会したら恐らくは互に面忘れをしているだろうと云う、これも当人の噺で。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            }
          ]
        }
