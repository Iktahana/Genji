        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「ウーン、ダメダ、オナカヾ　イタイカラ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オナカガ　スイテ　ヰル　ヌスビトノ　メニ、フト　マルマルシタ　コヒツジガ　一ピキ、ミンナト　ハナレテ　アソンデ　ヰルノガ　ウツリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリアゲテ　ヰタ　イシコロヲ、ポーント　ムカウノ　キニ　ナゲツケテ、マタ　コヒツジヲ　フトコロニ　イレ、スイタ　オナカヲ　オサヘナガラ　一ツノ　ムラヘ　ヤツテ　キマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コマツタ　ヤツダナ、オレニハ　オチチガ　デナイカラ　ヤツパリ　モトノ　マキバヘ　ツレテツテ　ヤラウ」ト　イツテ、ヌスビトハ　ペコペコノ　オナカヲ　オサヘナガラ　マタ　モト　キタ　ミチヲ　カヘツテ　ユキマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ、チヨウド　オナカガ　スイテ　キタ　コロ　マタ　ヒトツノ　ムラニ　ハイリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヲトコハ　アル　イヘノ　マドシタニ　タツテ、「オナカガ　スイテ　シヨウガ　アリマセン。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツソク、モルモツトノ　オヰシヤガ、イタチノ　ポンポコニ　フクレタ　オナカヲ　シンサツシマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "形式、番号は、D50・444号で、碾臼の様に頑固で逞しい四対の聯結主働輪の上に、まるで妊婦のオナカみたいな太った鑵を乗けその又上に茶釜の様な煙突や、福助頭の様な蒸汽貯蔵鑵を頂いた、堂々たる貨物列車用の炭水車付機関車なんです。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ姉サントオ兄サンハ思ハズ、オナカヲカカヘテ笑ヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オコウちやんはもうオナカが大きくなつてゐた。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のオナカから生んだ母親はその瞬間から子供が可愛いかも知れないが、男の私にはまるで縁もなく愛嬌もない生物が突然現れてわが子を称するようなもので、はじめの一ヵ月ぐらいはいかに扱うべきか窮したのである。",
              "citation": {
                "source": "人の子の親となりて",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の子を、お前のオナカに宿らせたいのだ。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そのお嬢さんのオナカの子はどう始末をしたのだね」「私がヒマをもらうまでは、まだその儘だったと思いますよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの娘のためにも、オナカの子供のためにも決して悪いようにははからいません」　と真心をもってコンコンと説いた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "清作の妻チヨは妊娠中であるから、オナカの子にもしものことがあってはとの心づかいで、向島の寮に居残り、重二郎は木場の本宅に留守を預っているから、この場へ姿を見せていない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "オナカがペコペコなんですもの」「では日野サン、一枚ワタクシに売ってください」　セラダはテーブルの上へ千円札をおきました。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんしろストレートパンチがオナカから下の方だけにしか命中しないんですから心霊術の先生もたまらないわよ」「生命に別状はなかったわけですね」「それはもう熟練してるから。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクたちののんでる薬はオナカのすく薬だからね」　なぞと彼らは自己弁護をこころみたが、オナカのすく薬なら私も年中用いているが、こんな大食はとてもできない。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のしてやることといえば毎日何か食べさせて時々オナカを悪くさせることぐらいで、女房にたしなめられるばかりだが、オッパイのある母親とちがって、父の愛情の表現は何かうまそうな物を食べさせてやるくらいしかないことを母は理解してくれない。",
              "citation": {
                "source": "育児",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂ　あなたに会ってこうしてあなたを見ていると、あなたのオナカはふくれ過ぎていて、そのままでは寸法が余るだろうが、同時に一面、あなたのカラダは棺おけに入るのに適当なかっこうをしているがなあ。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌川多門はカゼをひいたところへビールをのみすぎてオナカをこわして、ちょうど私達が来た日の朝から寝ていたのである。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まもなくキヨ子はイソイソとでてきて、「私、今日、オヒルをたべなかったから、オナカがへったのよ」「うちで御馳走こしらえてやるぜ」　今日に限って珍客招待の用意はしてなかったが、商売柄、品物はそろっているから、忽ち支度はできあがる。",
              "citation": {
                "source": "出家物語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "野鍛冶の宿　女影と書いて「オナカゲ」と読みます。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
