[
  {
    "uuid": "a8f8f362-f761-570e-a600-4606e11737d9",
    "entry": "煽て",
    "reading": {
      "primary": "おだて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
