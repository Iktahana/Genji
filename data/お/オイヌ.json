        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "唯の夜遊びでさへ村中押し歩くのだから兼次がおすがを嗅き出すのは牡犬が牝犬を搜すよりも速かであつた。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも毛をもじゃもじゃにしている尨犬のアデリと、脚の細い牡犬のポプリだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしね、あんただから打明けるのだけれど、ずゐぶん、いろんな牡犬につけまはされてゐるの。",
              "citation": {
                "source": "狂人日記",
                "author": "ZAPISKI SUMASHEDSHAWO",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿に飼へる牡牝二匹の中の牡犬も來り加はれり。",
              "citation": {
                "source": "阿武隈川水源の仙境",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "牡犬なれば悪性にても不能にても苦しからずや。",
              "citation": {
                "source": "女大学評論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人をつなぐ魂の糸はもはや一つも見当らず、太平はキミ子の肉体を貪るやうに愛撫して、牝犬を追ふ牡犬のやうな自分の姿を感じてゐた。",
              "citation": {
                "source": "外套と青空",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "牡犬のやうに私のまはりを這ひまはらせたあげく毛もぬき目の玉もくりぬいて突き放してやらうかと思つた。",
              "citation": {
                "source": "続戦争と一人の女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後に続いて、牝犬を追う牡犬のように、この私がノコノコ入って行ったことは、申す迄もありません。",
              "citation": {
                "source": "法悦クラブ",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "強い牡犬と強い牝犬の恋を追って歩く弱い牡犬のように、首と尻尾を垂れて、二人の姿を追って、何処までも何処までも、ウロウロ従いて行く深沢深だったのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "結婚ラプソディ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
