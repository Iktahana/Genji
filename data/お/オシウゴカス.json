        "examples": {
          "standard": [
            {
              "text": "重い本棚を少し横へ押し動かして、後ろに落ちたペンを拾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "二人で力を合わせて、ステージの重いピアノを中央まで押し動かした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はドアを必死に押し動かしたが、鍵がかかっていて開かなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "そこで、汽筒の中で、進んだり退いたりしてゐるピストンは、其のたびに通動機を前後に押し動かす。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            }
          ]
