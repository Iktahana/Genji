        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "年末の大忙しの中で、新しいプロジェクトが持ち上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "店員たちは大忙しで、客のリクエストに応じていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大忙しの日々が続くと、疲れも溜まるものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "運転手は子供を叱るので大忙しであつた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕は目下大忙しで、邪魔はご勘弁を。",
              "citation": {
                "source": "三枚の学生",
                "author": "THE ADVENTURE OF THE THREE STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうと眼がつきゃ、大忙しだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところで、大忙しなんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "それどころじゃねえ、いま大忙しなんだよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴェト同盟のあらゆる工場・役場・学校の文化宣伝部委員たちは大忙しだ。",
              "citation": {
                "source": "勝利したプロレタリアのメーデー",
                "author": "――モスクワの五月一日――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなったら旦那さまには前掛けをさせてお米とぎから火おこし、それから出前持ちをして頂きますわ」「おやおや、女房の煙管で亭王こき使われかい」「煙管どころか、わたし算盤で大忙しよ」　思えばこうした楽しいやりとりも今となっては詮ない繰り言になってしまった。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　鐘が谷の方で鳴り渡って、山尼の徒がそっちへ走って、そうしてそのまま大忙しに、山を下って行ったことだけは、桔梗様にも解っていたが、その他のことは解らないのであった。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いゝえ駄目――ハナァと一緒にゐると大忙しだし、あなたを粉だらけにしてしまふわ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちの母さんは『婦人之友』への小説できのうは大忙し。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "多賀ちゃんが目白にいた時代は私の大忙しの時代で、ああいう活気はこの半盲さんには望めませんから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "調子のよいときはあっちの鈴も鳴り出す、こっちの鈴も鳴り出すで、大忙しだ。",
              "citation": {
                "source": "瀬戸内の小魚たち",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日は一馬の誕生日で、母屋の方の台所でも赤飯をたいたりしていたが、洋館の方の調理場では、夕食の支度に大忙しで、加代子さんも今日は珍しくこっちの食卓へお客にくることになっていた。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "太宰さん、あちこち大忙し。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の編集者の方達もみえて、太宰さんはその接待で大忙し。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            },
            {
              "text": "つぎの日、ニクシミーはおおいそがしのお城にもぐりこんで、サンタクロースの前に行くと、こういいました。",
              "citation": {
                "source": "サンタクロースがさらわれちゃった！",
                "author": "A KIDNAPPED SANTA CLAUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとの大いそがしの有様を、お役人の案内で「視察」するなどは、考え様に依っては、失礼な事とも思われます。",
              "citation": {
                "source": "三月三十日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の知人が、いま三人ほど満洲に住んで大いそがしで働いて居ります。",
              "citation": {
                "source": "三月三十日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、その知人たちに逢い、一夜しみじみ酒を酌み合いたく、その為ばかりにでも、私は満洲に行きたいのですが、満洲は、いま、大いそがしの最中なのだという事を思えば、ぎゅっと真面目になり、浮いた気持もなくなります。",
              "citation": {
                "source": "三月三十日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "26夏の通り雨に追われてきみとぼくと、そして屋根をうつ雨〈レイン・オン・ザ・ルーフ〉ラヴィン・スプーンフル　梅雨時に生ものを買いおきにもできず、翌日の午前中は、また買いだしで大いそがしになってしまった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここのところ、バンドのあいまに、またブラバンにも顔をだしてるんだ」「へえ、大いそがしなんですね」「令子は知らないけど、去年、慶一があの先生に夢中になって、エラい騒ぎでな」「へえ、そんなことがあったの」　と、令子は高志に顔をむけたまま、目だけを慶一のほうにはねあげた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワラはどこへいったんだ」「あいつは朝まで大いそがしだ」　高志が、ケチャップとマスタードを慶一にまわす。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二頭の馬を木から放し、その一頭に跨がって、峠の道に添いながら、林の中を大いそがしに、菊女の乗っている馬を追い追い、三十郎は犬帰村の方へ進んだ。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中さんが一人留守で、大いそがしよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
