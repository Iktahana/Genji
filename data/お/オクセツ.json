        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その憶説は確かな証拠に基づいていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "科学者たちはこの憶説を検証するために実験を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の憶説は興味深いが、まだ立証されていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "二月前の去年十一月八日、疑問の憤死を遂げたために、流布憶説まちまちだった。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかして、幽霊のごとき妖怪は、すなわちこの四大以上の性を有して、人間の五官にては知り得べからざるものと想像するものもあれども、これかえって憶説、空想のはなはだしきものなり。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでいろいろ憶説がうまれた、途方もない情事がこねあげられたり、彼らの奇怪な生活の秘密が拵えられたりして、それが真しやかに伝わった。",
              "citation": {
                "source": "蛮人",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "病理学総論の分野ではすべての種類の曖昧な憶説に扉が開かれていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "偏見、特権、憶説、虚偽、強請、濫用、暴行、不正、暗黒、などの巨大な城砦は、なおその憎悪の塔を聳やかして社会の上に立っている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みに自分のあやしげな素人生理学の知識を基礎にして臆説を立ててみるとおおよそ次のようなことではないかと思う。",
              "citation": {
                "source": "五月の唯物観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな臆説も考えられる。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "討論の結果、これは今でこそほとんど食えないような装飾物であるが、ずっと昔これらのものが非常に珍しいうまい御馳走であった時代があったので、その時代にこれらのものが特別なとっときの珍肴として持出され、そうして賞味され享楽されたものであろうという臆説が多数の承認を得たようであった。",
              "citation": {
                "source": "新年雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに対する答としては更に色々な学説や臆説が提出され得る。",
              "citation": {
                "source": "地震雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、この方法を真に有効ならしむるには、むしろあらゆる独断、偏見、臆説をも初めから排する事なく、なるべくちがったものをことごとくひとまず取り入れて、すべての可能性を一つ一つ吟味しなければならない。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「臆説って、貴下がお話しなすった癖に。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間では、私の号に就ていろんな臆説を伝えているが、実際は今云った通りなんだ。",
              "citation": {
                "source": "予が半生の懺悔",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度の事件は非常に珍らしい事件で巧妙に行われ、その上多大の人々に重大な関係を持ってるものだから、いろいろと揣摩臆説が行われるんで困らされてるんだが、要するに問題は事実の骨組を、絶対に動かすべからざる事実の骨組を、諸説紛々たる報道の中から掴み出せばいいんだ。",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上がすべての臆説を排除し、出来るだけ粉飾を加えないで述べた事件の骨子だ。",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもこの臆説は不幸にしてたちまち却下された。",
              "citation": {
                "source": "臨時急行列車の紛失",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "その外にも、いろいろ勝手な臆説、仮説を立てるものもあった。",
              "citation": {
                "source": "臨時急行列車の紛失",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "不幸にして強制徴兵案の様に自分の想像を事実の上で直接｜確めて呉れる程の鮮やかな現象が、仏蘭西ではまだ起つてゐないから、自分は自分の臆説をさう手際よく実際に証明する訳に行かない。",
              "citation": {
                "source": "点頭録",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の臆説をまじへず。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "相原の妻の死については、その当時いろいろの臆説を伝えられたが、結局はヒステリーということに帰着して、その噂は月日の経つに連れて諸人の記憶からだんだんに薄らいでしまった。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたささやきが宿の者の耳にも伝わって、いろいろの臆説が尾鰭を添えて忽ちに広がった。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "判らないにつれてそこに又いろいろの臆説も湧き出して、尼に対する諸人の信仰も尊敬もだんだんに薄れて来た。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから三、四日経ってから隣り村から田崎の小父さんがたずねて来たが、隣り村でもいろいろの臆説が伝わっているらしく、そのなかでも犬に咬まれたというのが最も有力な説であるらしかった。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "教員の死因が判明しないために、またいろいろの臆説を伝える者もあって、それがいよいよ探険隊の好奇心を煽ったらしくも見えた。",
              "citation": {
                "source": "こま犬",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって、それに就いて種々の臆説が伝えられたが、いずれも文字通りの臆説であって、ほとんど信をおくに足るようなものはなかった。",
              "citation": {
                "source": "深見夫人の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに就いて種々の臆説が生み出されるのは無理もなかった。",
              "citation": {
                "source": "深見夫人の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍とても取り留めのない臆説を信じて、迂濶に塩冶を疑うようなこともあるまいと思っていた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがために、その前夜はかたきの方を眠らせないとか、あるいは水盃に毒を入れて飲ませるとか、種々の臆説を伝える者もあるが、そんなことはしなかったに相違ない。",
              "citation": {
                "source": "かたき討雑感",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "随って種々の臆説が甲から乙へと附会されて、何だか神秘的の色彩を帯びた怪談が伝えられる様になって了ったのだ、要するに※は、人間が漸次に退化して所謂猿人に近くなったものだと思えば可い。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ改造サルベキ社會組織亦人性ヲ無視シタル此等兩極ノ學究的臆説ヲ誘導サルル能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "臆説は種々に立てられてゐる。",
              "citation": {
                "source": "十三時",
                "author": "THE DEVIL IN THE BELFRY",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
