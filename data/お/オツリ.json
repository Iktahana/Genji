        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公衆トイレで水が跳ねるお釣りが怖くてたまらない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "便座に座ったら、お釣りが来るような音がして驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "お釣りを避けるために少し前かがみになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
