        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "現に此原稿は魯庵君が使って見ろといってわざわざ贈って呉れたオノトで書いたのであるが、大変心持よくすらすら書けて愉快であった。",
              "citation": {
                "source": "余と万年筆",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペリカンを追い出した余は其姉妹に当るオノトを新らしく迎え入れて、それで万年筆に対して幾分か罪亡ぼしをした積なのである。",
              "citation": {
                "source": "余と万年筆",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "今用いて居る万年筆は二代目のでオノトである。",
              "citation": {
                "source": "文士の生活",
                "author": "夏目漱石氏−収入−衣食住−娯楽−趣味−愛憎−日常生活−執筆の前後",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともかく二箱買っていろいろペンについて話していたら、まだオノトがあるということです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし今にペン先がないようになったら、慌てるのは余り商売柄心がけがわるいから、ええと大決心をして到頭オノトを一本買いました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "万年筆の中でオノトが一番ペン先が軟かなのですってね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オノトは元あなたが使っていらしたのではなかったかしら。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃手紙ずっとこの一月二十三日に頂いたオノトで書いているのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸善で、オノト万年筆を一本、九円を買ひ、辞典の小さいのを一つ、それから高島屋で食事、座へ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ちてから大して日数がたっているとも見えぬオノト万年筆である。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "少佐は新一が胸のポケットにはさんでいたのも確かオノトであったことを思い出した。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
