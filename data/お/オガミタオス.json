    "definitions": [
      {
        "index": 1,
        "gloss": "to persuade someone to consent",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
