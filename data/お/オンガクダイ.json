        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は音楽大への進学を目指して毎日練習している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音楽大の入試では実技試験が重要視される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音楽大を卒業した後、彼女はプロの演奏家になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ある時は、お寺を借りて音楽大会を催した。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第一部　牧野富太郎自叙伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで次になすべきことは日比谷公会堂で音楽大会を開催することである。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽大会へ出演の打合せをすませ、そして「これを京極さん（高鋭子爵）に届けて下さい」といって、今朝ほどのお饅頭をお土産に頂いて。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日後に迫った音楽大会に三浦さんを迎えに行ったのだった。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            },
            {
              "text": "日比谷公会堂での音楽大会「音楽五十年史」は七月十三日から十七日まで五日間、一日二回開催された。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二十二日になって、興行開始命令が出たので、日本芸能社では早速、明朗音楽大会を計画し、九月六日から五日間日比谷公会堂で開催した。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            },
            {
              "text": "この明朗音楽大会がきっかけとなり、日比谷公会堂では連日のように音楽会が開かれたが、それは軽音楽の一点張りで、クラシックの方では日本交響楽団が定期演奏会を催すだけであった。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽大学に籍を置いているので、つい甘えて、アルバイトと言ってしまう。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
