        "examples": {
          "standard": [
            {
              "text": "「お馬さんだよ」と母が言うと、二歳の娘は牧場の柵越しに恐る恐る手を伸ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "絵本の中のお馬さんに夢中になった息子は、毎晩その本を読んでくれとせがんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "動物園でお馬さんに乗せてもらった甥は、大喜びで手を振り続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「お馬さん、お馬さん、あなたがほんとうにかけ出したら、どんなに疾いでしょうね。",
              "citation": {
                "source": "馬を殺したからす",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はあなたのようなりっぱなお馬さんが、こうして綱で縛られているのが不思議でならないのですよ。",
              "citation": {
                "source": "馬を殺したからす",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
