          "standard": [
            {
              "text": "航空機が音の壁を超える速度に達した時、機体が激しく揺れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音の壁を突破するには超音速技術が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "戦闘機が音の壁を超える際に激しい音がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "マルティ・トラックのテープにダビングをかさね、音を合成して「音の壁」をつくることをはじめ、一枚のシングルのサウンドに多額のおかねと大勢のミュージシャンをつかうという、ビートルズ後期の音楽づくりとおなじく、コンサートの場ではなくスタジオ内で完成されるロックづくりにむかっていった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
