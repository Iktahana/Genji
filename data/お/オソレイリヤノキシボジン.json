        "examples": {
          "standard": [
            {
              "text": "「大変なことをしてしまったな」「全く、恐れ入谷の鬼子母神だね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「まさかあんな結果になるとは」「まさに恐れ入谷の鬼子母神だよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「今回の件、どう思う？」「恐れ入谷の鬼子母神、といったところだな」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "黒猫の勢揃いは恐れ入谷の鬼子母神だけれど、茶碗酒の召し上がれる御隠居様なんかなかなか話せるというものじゃないか。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに答えていま一人が、「なんのお前様、唐人の化けの皮を一目で引ん剥いだ、御眼力、お若えが恐れ入谷の鬼子母神……へっへっへっなんでごわす？",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
