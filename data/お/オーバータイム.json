        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "バスケットボールでオーバータイムすると、ショットクロック違反になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ペイントエリアでのオーバータイムを避けるため、素早く動く必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ディフェンスはオーバータイムを狙ってプレッシャーをかけてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
