        "examples": {
          "standard": [
            {
              "text": "彼はことあるごとに昔の援助を恩にかけて、無理な頼みごとをしてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「あのとき助けてやったじゃないか」と恩にかけられると、断りにくくて困る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "せっかく助けてあげたのに恩にかけるような言い方をするのは品がないと、彼女は思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「どこがよくって惚れたのか、妾にゃまるっきり見当がつかない」「オヤ、今度は恩にかけるのかい」　次郎吉はもっけな顔をした。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
