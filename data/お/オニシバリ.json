    "definitions": [
      {
        "index": 1,
        "gloss": "Daphne pseudomezereum (daphne shrub species)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
