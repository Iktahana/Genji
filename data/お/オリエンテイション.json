        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "娯楽室は夕方まで閉まっているはずだし、空き部屋には立ち入るなと、晩餐会後におこなわれた、寮生活のオリエンテイションで注意を受けた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日目はオリエンテイションだけで、十一時には解放された。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリエンテイションの最後は、クラブ活動の説明だった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいたいクラブの移動ばっか、やってられるかよ」　高志とワラと慶一の三人は、おとといのオリエンテイションで、テニス部に移った。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリエンテイションは、和気あいあいと、一言ひとことに半畳が入るなかで、二〇分ほどで終わった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
