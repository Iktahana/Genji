        "examples": {
          "standard": [
            {
              "text": "真っ暗な廊下で突然物音がして、私はすっかり怖じけてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "何か悪いことが起こるのではないかと、心の中で怖じけていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "勇敢な彼も、この不気味な状況には少し怖じけている様子だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "おじけるかと思った真紀子や千鶴子も素直に後からついて来た。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "おじ気づいたのではないだろうな」　宗盛の言葉に重能は、「おじけるなど以ての外」　と一言きっぱりいうと、宗盛の前を悠然と下っていった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十一巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
