        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お嬢ちゃん、さようなら。",
              "citation": {
                "source": "たずねびと",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆる、お坊っちゃん、お嬢ちゃんは、魚にすればどこかの辺の遊び肉でありましょう。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "基本的にはお坊ちゃん、お嬢ちゃんがほとんどだった高校の同級生たちに対し、警察学校の同僚たちは多様である。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「婢やアお嬢ちゃんおんぶしておくれッ！",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「姉やアお嬢ちゃんおんぶしておくれッ！",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊っちゃん、お嬢ちゃん、さあ、いらっしゃい。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すえ子は大そう大きくなって、いいお嬢ちゃんになって居る。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "立派なお嬢ちゃんです」　サヨは膝の力が抜けてゆくようなよろこびの感じを、初めてこの時経験した。",
              "citation": {
                "source": "朝の風",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番最初のお弟子さんが原信子さんで、始めて家に来た時は十一才の可愛いいお嬢ちゃんでした。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリーナ　なんでもありませんよ、お嬢ちゃん。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆり子ちゃんは、それを拾って、小さな手で土を落としていると、通りかかった、知らないおばさんが、「お嬢ちゃん、なにを拾いました。",
              "citation": {
                "source": "金色のボタン",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちい子ちゃんが近づくと、「お嬢ちゃん、川上さんという家をごぞんじありませんか。",
              "citation": {
                "source": "鳥鳴く朝のちい子ちゃん",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お嬢ちゃん、どうもありがとうございました。",
              "citation": {
                "source": "鳥鳴く朝のちい子ちゃん",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちい子ちゃんは、かわいいお嬢ちゃんです。",
              "citation": {
                "source": "鳥鳴く朝のちい子ちゃん",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにいる坊ちゃんや、お嬢ちゃんたちに聞いてみてもわかるよ。",
              "citation": {
                "source": "町はずれの空き地",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し、お嬢ちゃん向き〉と書いてある。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい奥さんになり、いま可愛い娘さんのできている同君のお嬢ちゃんが、いまだその今の娘さんぐらいのじぶんで、「艶色落語講談鑑賞」の「牡丹燈籠」の中でも書いたが、貧しい中から遠来の泊まり客たる私に朝に晩にきっと正蔵君はお膳へ一本付けてくれた。",
              "citation": {
                "source": "わが寄席青春録",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お春どん、あんたお嬢ちゃんに、何ぞ今日のこと云うたんか」幸子は今日の見合いのことを女中達に話した覚えはないが、特に彼女達に知られないように気を付けていなかった越度はあるので、こうなって見ると、雪子の手前、自分がお春を糺さねばならない責任を感じた。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんた、お嬢ちゃんにいつ云うたん」「今朝でございます。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は学校の廊下で悦子の無事な姿を見ると、お嬢ちゃん、と、泥まみれの着物で獅噛み着いて周囲の人々をびっくりさせたが、帰りには彼女が流れの先頭を切って、貞之助を庇うようにしながら行った。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は今、日光からの帰りがけで、お久と一緒に雷門から地下鉄に乗ったのであるが、ちょっと御寮人様にお目に懸って今日のお礼を申さなければと思いまして、尾張町で自分だけ下りてお伺い致しました、と、そう云って、これはお嬢ちゃんにと、日光｜羊羹を三｜棹と絵端書とを出した。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢ちゃんが御病気の時ぐらい蓄音器かけたかてええやありませんか、あの西洋人は近所附合い云うこと知らんのですやろかと、お春は憤慨したが、まあまあボッシュさんは変り者やよってに仕方ない、それに朝から蓄音器を鳴らすのは時節柄面白うない、と、貞之助が制したので、悦子はそれからは毎日トランプをして遊んだ。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢ちゃん、まあ見て御覧、こんな工合に何ぼでも剥がれますねんと云いながら、瘡蓋の端を摘まんで引き剥がすと、ずるずると皮が何処迄でも捲れて行く。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瘡蓋を拾い集めて手の中へ入れて、母屋の台所へ戻って来て、ほら、お嬢ちゃんの体からこんなに皮が剥けるねんと、それを下働きの女中達に見せびらかして気味悪がらすのであったが、しまいには皆が馴れて恐がらないようになった。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはスカーフだ、お嬢ちゃん、しかも白のキングとクイーンがオレ様に「おつうじょうび」のプレゼントとしてくれたんだ！",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた、篠崎さんのお嬢ちゃんと同じ年ごろの子どもを、二度も、わざとまちがえてさらったことですよ。",
              "citation": {
                "source": "少年探偵団",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは、こんなまっ黒なインド人ですよ、わたしは篠崎家のお嬢ちゃんをさらおうとしていますよ、と、世間に向かって、いや世間というよりも、篠崎のご主人に向かって、これでもかこれでもかと、告げ知らせたかったのです。",
              "citation": {
                "source": "少年探偵団",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "篠崎さんのお嬢ちゃんをさらったのも、いかにも宝石につきまとうのろいのように見せかける手段で、けっして命をとろうなどという考えはなかったということです。",
              "citation": {
                "source": "少年探偵団",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしが部屋を貸したことは、かりに信用していただけないとしても、ここの二階にいたのを子どもたちが見たということですし、聞けば、小林君とお嬢ちゃんとが乗った車の運転手と助手が、いつのまにか黒ん坊にかわっていて、ふたりはそれをたしかに見たといっていましたが。",
              "citation": {
                "source": "少年探偵団",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カーバー所長、お忘れでは」「エレナお嬢ちゃんじゃないか。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
