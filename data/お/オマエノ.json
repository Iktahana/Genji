          "literary": [
            {
              "text": "オンダモダイタモエンブチハウノモオマエノコジャモノ、キナガニサッシャイ、イカニモショッショ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンガ、キュウシュウヘ、ユクノデ、ワタシハ、オマエノトコロヘ、ユクカモシレマセン、タノシミニ、マッテイナサイ――母よりの手紙。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエノコヒビトヲヨンデヤラウ　アトレスモシツテイル",
              "citation": {
                "source": "朝",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "茂ちゃん安心おし、きっと助けてあげるからね」「ケイサツヘ、イイツケルト、オマエノコドモヲ、コロシテシマウゾ」　アア、何ということだ。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエノホウデ、サッキノコトヲ、一ツデモタガエタラ、シゲルヲ、コロシテシマウゾ」　そして、カチャンと、電話が切れてしまった。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「シッテルダロ、オマエノテキダ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ最後ハオマエノ体ニモガ生エルダロウ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガオマエノ運命ダ……。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局ハオマエノヤッタコトハスベテ無駄ダッタノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
