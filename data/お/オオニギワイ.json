        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "宴会場は乾杯の音頭が上がると同時に大賑わいとなり、あちこちで笑い声が弾けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子供たちが庭で水遊びを始めると大賑わいになり、近所の子まで集まってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "新店舗のオープン初日は大賑わいで、スタッフ全員がてんてこ舞いになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
