          "standard": [
            {
              "text": "昭和40年代、オフィスガールはタイピストとしての技能が求められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このドラマのオフィスガールたちは、みんな同じスーツを着ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "現在のオフィスガールには、より専門的なスキルが必要とされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "併しこの工策は、私がインテリ娘であるか、お百姓の娘であるか、地主の娘であるか、ブルジョアの娘であるか、商人の娘であるか、職工の娘であるかによって、或いは又、私がオフィスガールかバスの車掌か、女教員であるか商売女であるかそれともただの娘や女学生であるか、などによって、別々でなくてはならぬ。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
