          "literary": [
            {
              "text": "これじゃいったいどこへ降りていいんだか、お月さまでもでてくれなきゃア、けんとうがつきあしない」　大空で迷子星になった竹童は、例の、寝るまもはなさぬ棒切れを右手にもち、左の手を目のはたへかざして、鷲の上から、「オオーイ、オオーイ」と、とうとう声をはりあげて呼びだした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オオーイ、旅の御坊」　二度目の声はなお近くした。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おうういッ」「オオーイ」　追々と、敗軍の士卒は、そこへ集まってきた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼んでやりましょう」性善坊はすこし離れた崖の際まで駈けて行って、「オオーイ」谷間をのぞいて呼んだ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――と、何処かで、オオーイと呼ぶ声がその時聞えた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "と耳を澄ましていると、二度めの声は、より近く、オオーイとまた聞えた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "また先へゆく女中さん二人も「オオーイ」と、谷をへだてた新道へ向かって声をはりあげる。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
