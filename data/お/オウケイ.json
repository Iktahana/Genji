        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "concavity",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この凹形のボウルは手に持ちやすく設計されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "凹形のレンズを用いることで、光を効果的に集約できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "器の凹形の部分に雨水が溜まっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "兵士はうやまひあつし竹刀とりお前にとうと聲｜徹り撃つ激しくうちあふ竹刀眼には入れこの畏こさに面も小手もわかず營庭にて三聯隊の兵全部凹形に整列し、隊歌を合唱す。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵士はうやまひあつし竹刀とりお前にとうと声｜徹り撃つ激しくうちあふ竹刀眼には入れこの畏こさに面も小手もわかず営庭にて三聯隊の兵全部凹形に整列し、隊歌を合唱す。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁上の路は凹形に墻があり、幅は野砲を据ゑ得ることが城壁に異らない。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "地球が凸形に円く見えるのは地上にある時で、上空からは凹形に円く見える。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "真に標高の高い部分は南緯八二度東経六〇度から南緯七〇度東経一一五度を結ぶ強大な弧を描いて、我々のキャンプに向かって凹形を成し、海側の終端は長大な氷に閉ざされた岸辺となって、南極圏限界線からウィルキス及びモーソン(*32)が瞥見したのはその終端部の丘々である。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子らの家も在る長方形の一区画を凹形に囲んでいるのであった。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "凹形の右の道をずっと来て煙草屋の角を左へ、今伸子が歩いている横通りへ曲って来るのだ。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やんごとないお方さまの、お身ちかく、この世でならびない、御栄華にお生きなされているあなたさまのお側で、たとえ、たったしばしの間でも、こうして御贔屓をおうけいたせるなぞとは、上方をはなれますとき、思いも及ばぬことでござりました」「何をいやるぞ――そなたは？",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はい、てんのうの　いいつけと　あれば、おうけいたしたく　おもいますが、一つ　おねがいが　あります。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その宝物の御旗、その楯無の鎧が、かがやく日をお待ちするぞ」「ご芳志、ありがたくおうけいたします」「おお、それより小太郎山へお帰りあるは、途中さだめし多難であろう。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ありがたくおうけいたせ」「はっ……」　武松が、首枷の首を下げたとたんに、その隣の荒むしろに据えられていた王婆が、身をのばして叫んだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「身に過ぎた大任ですが、ありがたくおうけいたしまする」「奇計があるか」「いや、べつに」「ないのか」「奇計はございませぬ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "つつしんでおうけいたしまする。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "有難く、おうけいたすべきにはございましょうが、如何せん浅学で、堂上方の御格式すらも、よう弁え申しませぬ。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、三斎公様の御恩にこたえて、不惜身命の御奉公をなさる覚悟でもなければならぬこと、お救い米のような、六人｜一括げの扶持はそれゆえおうけいたされぬ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
