          "literary": [
            {
              "text": "菜穂子は、とうとう矢も楯もたまらなくなって、オウヴア・シュウズを穿いた儘、何度も他の患者や看護婦に見つかりそうになっては自分の病室に引き返したりしていたが、漸っと誰にも見られずに露台づたいに療養所の裏口から抜け出した。",
              "citation": {
                "source": "菜穂子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "オウヴアシユウズは誰もしてゐない。",
              "citation": {
                "source": "佐渡が島のこと",
                "author": "江南文三",
                "note": "青空文庫"
              }
            },
            {
              "text": "オウヴアシユウズも附けました。",
              "citation": {
                "source": "佐渡が島のこと",
                "author": "江南文三",
                "note": "青空文庫"
              }
            }
          ]
        }
