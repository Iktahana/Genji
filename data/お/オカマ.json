          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子どもがお釜をぶつけて泣いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "転んだ時にお釜がいたくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医者がお釜の状態を診察している。",
              "citation": {
