    "definitions": [
      {
        "index": 1,
        "gloss": "pot",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "台所の棚からお釜を取り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大きなお釜で米を炊く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "お釜が火にかかり、ぐつぐつと音を立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "帽子もゴルフ用の鳥打ちや、ビバや、お釜帽を次から次に冠らせられた。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お釜の中には塵が積つて、かまどに煙の立たぬ日が多い。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには女房も蒼くなって、「ああ、もしもし、そのお釜をお取りあげになることだけは、どうぞおゆるしくださいまし、どうぞお返しを願います。",
              "citation": {
                "source": "唖の妖女",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近まわりの工場の連中がワイワイ取巻いて見ているうちに、お釜帽を冠った機械油だらけの職工が、板片の上に小石を二つ三つ並べて、腰元らしく尻を振り振り登場すると皆、一時にドッと笑い出したりした。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見ると又野も、思い出したように急いでお釜帽子を脱いだ。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い袋に入れられた義足がしちりんやお釜の側に積まれたのを、彼女は竹垣によつて見てゐる時瞳が曇つて來た。",
              "citation": {
                "source": "三十三の死",
                "author": "素木しづ子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お釜こほろぎの奴か。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、父さんが雀に、あの大きなお釜の方を御覽と言つて見せました。",
              "citation": {
                "source": "ふるさと",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこではお釜から出したお茶の葉をひろげて團扇であほいで居る人があります。",
              "citation": {
                "source": "ふるさと",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "細かい人形、お茶道具、お釜に鍋やバケツに洗濯板、それに色紙や南京玉、赤や黄や緑の麦稈のようなものが、こてこて取り出された。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの女なら請け合って桝新のお釜を興しますと、小汚い歯齦に泡を溜めて説き勧めた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "このお釜は、きのうの相場なんですって」といった。",
              "citation": {
                "source": "打あけ話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このお釜は大きすぎるんじゃないのかしらといったら、その女のひとは真剣な目づかいで、だって、もしあなた、今に大きいのがいるったって、これから先どんなことになるか知れたもんじゃありませんから、これ位のがいいんですよ、というのであった。",
              "citation": {
                "source": "打あけ話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が火を起し、お釜までかけたのに姉はまだ起きてこない。",
              "citation": {
                "source": "縫子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所では祖母がお釜を前に、明りにすかすようにして弁当をつめていた。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで大きなお釜にいっぱいお湯を沸かして、金仏さまをほうり込みました。",
              "citation": {
                "source": "和尚さんと小僧",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、大男がかえると、あわてて、お釜のなかにかくしてくれました。",
              "citation": {
                "source": "ジャックと豆の木",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてさいごに、ジャックのかくれているお釜のふたに手をかけました。",
              "citation": {
                "source": "ジャックと豆の木",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャックが、そっとお釜のふたをあけてのぞいてみますと、玉でかざった、みごとなハープのたて琴が目にはいりました。",
              "citation": {
                "source": "ジャックと豆の木",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャックは、しめたとおもって、そっとお釜の中からぬけだすと、すばやくハープをかかえてにげだしました。",
              "citation": {
                "source": "ジャックと豆の木",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と思って、馬吉がこわごわはい出して、二｜階からそっとのぞいてみますと、折からさし込む月の光で、さっきの山姥が、台所のお釜の前に座って、独り言をいっているのが見えました。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、独り言をいいながら、大きなお釜のふたを取って、中に入ったかと思うと、やがてぐうぐう、ぐうぐう、高いびきで眠ってしまいました。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、石をお釜の上にのせて、上から重しをしてしまいました。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "お釜の中からはあいかわらず、ぐうぐう、ぐうぐう、高いびきが聞こえました。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "お釜に重しをしてしまうと、こんどはまた、お庭から枯れ枝をたくさん集めて来て、小さく折っては、お釜の下に入れました。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴしりぴしり枯れ枝を折る音が、寝ている山姥の耳に聞こえたとみえて、山姥はお釜の中で、「雨の降る夜は虫が鳴く。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "お釜のそこがだんだんあつくなってきて、そのうちじりじり焦げてきたので、さすがの山姥もびっくりして、「おお、あつい。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "山姥はおこって、お釜の中で、「きゃッ、きゃッ。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが私は例の調子で、相手の氣分におかまひなく、無遠慮にずばずばと放談した。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嫁さんが、わたしをいぢめるお嫁さんでもおかまひなし、わたしは太郎のよろこびのために、そのお嫁さんに美くしい着物を買つてやります。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
