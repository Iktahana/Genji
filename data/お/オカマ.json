        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この界隈で知られているお釜のキャバレーショーは見応えがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼はお釜のコミュニティで活躍している。",
              "citation": {
