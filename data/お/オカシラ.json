[
  {
    "uuid": "2ffa1bd3-0fb7-58aa-af11-531303b5b786",
    "entry": "お頭",
    "reading": {
      "primary": "おかしら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
