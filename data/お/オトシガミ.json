        "examples": {
          "standard": [
            {
              "text": "落とし紙がなくなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "トイレに落とし紙を足してください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "昔は落とし紙の代わりに竹の皮を使った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "」浦子は便所へ入つて戸を開けたまま未来の夫を呼んで落し紙を持つて来させるやうな白痴振りを平気でした。",
              "citation": {
                "source": "汗",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」浦子は便所へ入って戸を開けたまま未来の夫を呼んで落し紙を持って来させるような白痴振りを平気でした。",
              "citation": {
                "source": "汗",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日半枚ずつ配ってくれる落し紙ですら、腹工合が悪いからもう一枚くれと言っても、決して余計にくれたことはない。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃よく乞食が、竹の先に鳥もちをつけたのを持つて歩いて、店頭に積んである軽い品物、例へば歯磨粉の袋だとか、落し紙の束だとかを掻つ浚つて行くといふことであつた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生専用の奥の便所をくみとりし老爺曰く「お宅の先生はなかなかの人と聞いていましたが、落し紙だけはいい吉野紙を使っていますね」同じく家の女中曰く「あまり汚ないので見兼ねて先生のお部屋を掃除すると、あとで先生がたぴしと机をあけたてして、紛失物なきかと探し廻りおれり」と。",
              "citation": {
                "source": "同居人荷風",
                "author": "小西茂也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
