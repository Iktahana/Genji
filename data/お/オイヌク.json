[
  {
    "uuid": "80aeeedd-0d85-5ce5-a8c9-800cc73040e9",
    "entry": "追い抜く",
    "reading": {
      "primary": "おいぬく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
