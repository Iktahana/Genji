        "examples": {
          "standard": [
            {
              "text": "会場には、緊張と期待が織り交ざる不思議な空気が漂っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "青と赤の糸が複雑に織り交ざる美しい模様の布。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人々の会話と鳥の声が織り交ざる、心地よい午後の公園。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "羽柴家には、今、ひじょうな喜びと、ひじょうな恐怖とが、織りまざるようにして、おそいかかっていました。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そして、ゴーリキイの話の中に織り交る、すべての余計な不信実なものを切り去るのであった。",
              "citation": {
                "source": "マクシム・ゴーリキイの発展の特質",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
