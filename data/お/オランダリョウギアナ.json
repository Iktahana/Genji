        "examples": {
          "standard": [
            {
              "text": "オランダ領ギアナは現在のスリナムにあたる地域で、三世紀以上にわたってオランダの植民地だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "歴史資料にはオランダ領ギアナのプランテーションで働かされた奴隷たちの過酷な記録が残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "オランダ領ギアナは一九七五年に正式にスリナム共和国として独立を宣言した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "マラバーはインド南西の海岸、スリナムはオランダ領ギアナのこと、プロヴィデンスはカリブ海にある島、ポートベローはパナマ地峡の北岸にあった港、いずれも昔海賊に荒された土地であった。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            }
          ]
        }
