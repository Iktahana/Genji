        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "海岸の岩の上や、磯の松の根方から、おおいおおい、と板東声で呼ばり立って、とうとう五人がとこ押込みましたは、以上七人になりました、よの。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "見える処に連を置いて、おおいおおいも茶番らしい、殊に婦人ではあるし、と思う。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ、薄雲、北の海、おおいおおいで日が暮れる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおいおおいと誰やらが海のはてから呼んでます。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ、ぬか星、北の海、おおいおおいで日が暮れる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおいおおいと何やらが海の底から呼んでます。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ、くらやみ、北の海、おおいおおいで夜もふける。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おおいおおい、小僧ッ神。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は竿をかついで、おおいおおいと呼ぶ。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "老媼は赤ただれした目に涙を止めどなく流し、私も袖で顔をおおいおおい話を聴いた。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝の山に入りながらではないが、我が荷物ながらオイ遣せと持出す訳にも行かず、知らぬ顔に一、二町スタスタ行き過ぎると、忽ち背後からオーイオーイと呼ぶ者がある。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝は呼び鈴のコードを手近に置くべきのをだれかが遠くに押しのけてあったので大声でオーイオーイと呼んだが階下にいる五人のだれにも聞こえない。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーイオーイと帽子を振る学生なぞ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーイオーイと呼ぶ人間の声も聞えた。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "眠い眼をこすりこすり狭い階段をよろめき降りて電話にかかった、「オーイオーイオーイ……モシモシイ……モシモシイ……わかったよわかったよ。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーイオーイオーイオーイ……」　といくら呼んでも頑強にベルを鳴らしていたが、やがてピタリと震動が止むと、「オホホホホホホホホ」　という笑い声が、真っ先きに聞えた。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "男はあまりの淋しさに、オーイオーイと呼んで見た。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ所に立つて、左手の長い半月形の濱で地曳網を引く漁師たちの律動的な運動、オーイオーイと遠くの方で渇を愬ふ呼び聲、ビール壜に詰めた水を運ぶ女房たち――そうした彼等の生活を、私共は半ば憧憬の心をもつて暫らくの間見てゐた。",
              "citation": {
                "source": "滑川畔にて",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "「船首に立たれたのが若殿らしい」「皆紅の扇をば、手に翳してぞ立ち給うかね」「ほんとに扇を持っておられる」「オーイオーイと差し招けば……」「どっちだどっちだ、熊谷かえ？",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランマンと花の咲き乱れた四月の明るい空よ、地球の外には、颯々として熱風が吹きこぼれて、オーイオーイと見えないよび声が四月の空に弾けている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜辺を洗髪をなびかせながら歩いていると、町で下駄屋をしているあのひとの兄さんが、私をオーイオーイと後から呼びかけて来た。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランマンと花の咲き乱れた四月の空は赤旗だ、地球の外には、颯々として熱風が吹きこぼれて、オーイオーイ見えないよび声が四月の空に弾けている。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日の電報ガワセで、義父や母が一息ついてくれゝばいゝ、キラキラした浜辺を、洗い髪をなびかせながら歩いていると、町で下駄屋をしている男の兄さんが、オーイオーイと後から呼びかけて来た。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オーイオーイ、号外を呉れエ」　号外売りは喰ってかかるような恰好で、こっちへ飛んできた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに陸の方から何だかオーイオーイの声がする。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして坂の途中まで下りかけていた彼らの後からオーイオーイＦ！",
              "citation": {
                "source": "父の出郷",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "（急に歌ひ出す）波の底に呼ぶ声ありわれあらずば誰か応へん男　　（それを受けて、歌ふやうに呼ぶ真似をする）オーイオーイやゝ長い間女　　（朗かに笑ふ）男　　女の友達つていふものは、どうしてかう、妙に相手をはぐらかすのかなあ。",
              "citation": {
                "source": "恋愛恐怖病（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は小永田の出はずれで後からオーイオーイと呼び留められ、何事かと待っていると、お婆さんに「済まないが郵便屋さん、これを出して下さい」と手紙を頼まれた。",
              "citation": {
                "source": "初旅の大菩薩連嶺",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生人形の亀八翁が大の懇意で、ある時ひとつ撮ってくれというと、写真は商売だからと剣もホロロの挨拶、それではよろしいとそのまま出て一丁ばかり行くと後からオーイオーイと呼び止め、今のは表向きだよとわざわざ連れ帰って撮影した。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
