        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "路易はオレンヂエエドを飮みながら、そして煙草のけむりがしみでもするやうに半分目をつぶりながら、それらの娘の中から、まるで花の莖のやうに細い頸を少しかしげるやうにして立つてゐる一人の娘を選び出して、そればかり見つめてゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてみんなに酒を奢つては自分はオレンヂエエドばかり飮んでゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてオレンヂエエド！",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "嵬が炭酸水で割つたウイスキイを飮むのを見ながら、路易は昔のやうにほてつた頬をしながらオレンヂエエドを飮んでゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はすつかりオレンヂエエドと頬のほてりを忘れてしまつてゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
