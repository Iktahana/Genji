          "literary": [
            {
              "text": "ハネてから山野来り、一緒に家へ帰って、珍しや、家でオルドパーを飲む。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドパーをのみ、三時近く迄、中野・岡田を中心に女優論を戦はせた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、シャン／＼としめ、ＰＣＬの植村の招待で、柳橋へ行き、オルドパーを、大分のんじまって、ちと又苦し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
