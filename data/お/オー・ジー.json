        "examples": {
          "standard": [
            {
              "text": "昭和の会社ではＯＧと呼ばれる女性事務員がお茶くみを担当するのが当然とされていた時代があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "当時のＯＧたちは単純作業だけでなく、顧客対応や書類整理など多岐にわたる業務をこなしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「ＯＧという呼び方は今ではほとんど使われなくなったね」と定年間近の先輩社員がしみじみと言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
