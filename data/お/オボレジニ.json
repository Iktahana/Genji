    "definitions": [
      {
        "index": 1,
        "gloss": "death by drowning",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その男は溺れ死にだったと医者は判定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の溺れ死には事故だったのか自殺だったのか不明だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "溺れ死にの報告が増えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "美くしい身振の、身も世もないといふやうな、迫つた三味に連れられて、チヨボの佐和利に乗つて、泣いて泣いて溺れ死にでもするやうにおかるは泣いてゐる。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "とお歌いになり、二人でざんぶと飛び込んで、それなり溺れ死にに死んでおしまいになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻が詰まったお蔭で、溺れ死にかかった少年時代の苦しみを今一度、夢に描かせられる。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今にも溺れ死にそうな声を出してイビキを掻いている者など……だいぶ夜が更けているらしい光景である。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と流れが急でありましたので、二人の子供は溺れ死にました。",
              "citation": {
                "source": "真間の手古奈",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九郎左衛門の膝の上に蔽いかくしたまま、「実は、河の瀬で、釣していた童が溺れ死にました。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹三郎ひとりが溺れ死んで、お前が助かったとあれば、丹後どのの手前、この式部の武士の一分が立ちがたい。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「金城寺の旦那さまなら、水練に達者の筈だが、泳ぎの出来るものが溺れ死ぬのは、腹を切るより我慢のいるもんだという話だが、――さすがだなあ……」　しかし、水の底からは、それっきりなにも浮きあがらなかった。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、良寛さんが溺れ死んでは大変だから、いい加減なところで棹を良寛さんの方へさしだした。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さんが棹をさしだしてくれなんだら、わしは溺れ死んでしまふところぢやつた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの乗合いがみんな救われた中で、野村彦右衛門という盲目の侍だけがどうして溺れ死んだか、それを思うと、平助はまたにわかにぞっとした。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれから後は、黄泥溝で溺れ死ぬ者はなくなりました」　　　僵尸（屍体）を画く　杭州の劉以賢は肖像画を善くするを以って有名の画工であった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに水は口から鼻から眼まで来て、とうとうその人は溺れ死んでしまった。",
              "citation": {
                "source": "約束",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「橋の下で溺れ死ぬ約束をしたのじゃないだろう。",
              "citation": {
                "source": "約束",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "事件はごく簡単なもので、土人の一商人が川の中に溺れ死んでいた、というだけのことだ。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "※の花、男なんぞは物ともしない女の帽子の羽根、口元も腰元も溶けるやうだ、おまへの蜜の湖に若い男が溺れ死ぬ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟇は大きさ人間ほどもあったが、前脚二本で溺れ死んだ筈の吉丸を、さも大事そうに抱いていたが、幾度も幾度も辞儀をして、偖夫れから斯う云った。",
              "citation": {
                "source": "高島異誌",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "毒の味は甘い歓びの毒に溺れて溺れ死ぬのが、一ばん生き甲斐のある生き方と申してよろしい――」　と、言う折しも、取次が呉羽之介の到着を知らせました。",
              "citation": {
                "source": "艶容万年若衆",
                "author": "三上於兎吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま人間が一人、溺れ死ぬかどうかという浮沈の境目だ。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖の中に落ちて、そのまま溺れ死んでしまったのであろうか。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとう帆村は、浪にのまれて溺れ死んでしまったのでしょうか。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この水が川下へ落ちてゆくときは、私の家族の全部の溺れ死ぬるときだ、とさう思ふと、私は堪へ難い恐怖に襲はれて、目が醒める。",
              "citation": {
                "source": "恐怖について",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、息をのむ大洪水の瞬下に此あわれに　早老な女の心を溺れ死なせ。",
              "citation": {
                "source": "海辺小曲（一九二三年二月――）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○橋ぎわに追い込まれ、舟につかまろうとしても舟はやけて流れるのでたまらず、溺れ死ぬ、或は、他に逃げ場を失って持ち出した荷物に火がつき、そのまま死ぬ、被服廠の多数の死人も、四方火にとりかこまれた為、空気中に巨大な旋風が起り、火をまきあげたところへ、さっと荷物におちるので、むしやきになった。",
              "citation": {
                "source": "大正十二年九月一日よりの東京・横浜間大震火災についての記録",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くして、ラランはその弱つたからだを南へ向けて、熱い印度の方へふらふら飛んでゐたが、ガンガといふ大河の上流で、火傷した口の渇きを湿ほさうとして誤つて溺れ死んでしまつた。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "川に溺れてる者があって、飛びこんで助けようとすれば、こちらも必ず溺れ死ぬときまってる場合、君はそれでも飛びこむか、どうだというのである。",
              "citation": {
                "source": "道化役",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、両方のくちばしとも、鳥と一緒に、その汚い泥水の中で溺れ死んだんだよ。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒に酔ったあまり溺れ死んだのか、あるいは身を投げて死んだものか、誰にもわかりませんでした。",
              "citation": {
                "source": "正覚坊",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　杉の沼で、三好屋の花子が溺れ死んでいたのである。",
              "citation": {
                "source": "田園の幻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "とそういう議論から、李が主張することは、凡て社会機能の機械的な働きの一つになり終ることが、これからのインテリ層に要求されることで、心とか精神とかいう古くさいものの薄れゆく影に執着するのは、水に沈む石ころにしがみついてるようなもので、やがて溺れ死ぬ運命を免れない。",
              "citation": {
                "source": "椿の花の赤",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
