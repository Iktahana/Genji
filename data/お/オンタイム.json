        "examples": {
          "standard": [
            {
              "text": "会議をオンタイムで始めるために、全員が10分前に会議室に集まっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "飛行機がオンタイムで到着し、予定通りホテルにチェックインできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼はいつも仕事をオンタイムで終わらせる、信頼できる同僚だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "おしまひの「マーチ・オンタイム」だけ、前半で失敬した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
