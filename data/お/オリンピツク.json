        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オリンピツク選手としての、十年前の思ひ出を書いた小説でありました。",
              "citation": {
                "source": "田中君に就いて",
                "author": "――田中英光著『オリムポスの果實』序",
                "note": "青空文庫"
              }
            },
            {
              "text": "王様の命令をよく承はらぬうちに、粗忽な私はオリンピツクのチヤムピオンの如くに駆け出しました。",
              "citation": {
                "source": "青白き公園",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かオリンピツクへ僕を推薦してくれる者はないか。",
              "citation": {
                "source": "自慢山ほど",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "出発点に立つたオリンピツクの勇士であつた。",
              "citation": {
                "source": "素書",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は元来オリンピツク大会の東京招致運動を苦々しく思つた一人であるが、いよ／＼来るとなれば第一に国民全体がオリンピツクの精神を十分に理解し、見栄や外聞でなく、主催国としての責任を完うする覚悟を示してほしいのである。",
              "citation": {
                "source": "文学オリンピツク",
                "author": "――主催国としてどうするか――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どう考へても、かういふ国際的な催し、殊にオリンピツクのやうな西欧の伝統的な「お祭り」を日本人が主催するといふのは、どうもぴつたりしないところがあり、つまり国民の気風に適しないものゝやうである。",
              "citation": {
                "source": "文学オリンピツク",
                "author": "――主催国としてどうするか――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういふ習慣を一掃しない限り、文学オリンピツクなどやつても面白くないにきまつてゐる。",
              "citation": {
                "source": "文学オリンピツク",
                "author": "――主催国としてどうするか――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
