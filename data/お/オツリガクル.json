        "examples": {
          "standard": [
            {
              "text": "1000円出したので、お釣りが来るはずです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "小銭がなくてお釣りが来るのを待っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "買い物のあと、きちんとお釣りが来るか確認する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「お銚子が一本ついて、タイムどしたら、百円でお釣りが来るのどっさかい、安おっしゃろ。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェンダー・ストラトキャスターを買う金があれば、慶一のガットギターを四〇本買って、おつりがくる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり一〇進数を取り扱う電卓を作るのなら、四ビットを一度に処理できる構成にしておけば、一回の動作で〇から九までの数字をすべて操作できておつりがくる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "重吉が取ったのは二つだから、おつりがくるくらいだと思う、とおりつは云った。",
              "citation": {
                "source": "ちいさこべ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
