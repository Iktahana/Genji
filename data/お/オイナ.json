        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "朗らかや、すがし葉の大広葉の蕗の葉の下つ人、コロポックル、　　呼べよ、げに、神はあり、オイナ・カムイ、　　さながらに立つ影の素の裸男。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "註　アイヌ・モシリ　　　蝦夷島（アイヌ語）　　カムイ・ユカラ　　　神謡（　同　　）　　オイナ・カムイ　　　古伝神（　同　　）曇り日のオホーツク海光なし、燻し空には日の在処、ただ明るのみ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神神の祖先（アイヌ語）老いしアイヌの歌アイヌはよ、老いしアイヌ、神アヱオイナ、アイヌ・ラクグル（アイヌの臭ひある人）の後、神ながらの頭、土の体、柳の脊骨、シネ・シツキ・プイコロクル（眼窩の人）神神の髪の毛の人、彼こそはげに、カムイ・オトプ・ウシユ・グルなれ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神アヱオイナ、アイヌ・ラクグル（アイヌの臭ひある人）の後、神ながらの頭、土の体、柳の背骨、シネ・シツキ・プイコロクル（眼窩の人）神々の髪の毛の人。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイヌは、アエオイナ神、別名アイヌ・ラク・グル（アイヌの臭いある人）に依って創造された祖先の後裔だと自身に彼らを思っている。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "）処へ、智慧、愛、想像の女神イオイナ光のように現われる。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナ　実は、心配して様子をそっと見に来たのです。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナの使者、一片の花弁のように軽く、女神の傍に降る。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナ　まあ美しいこと。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナ　おお、嬉しいことの二つ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イオイナ　そうだろう。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（使者去る）イオイナ　――神々は、私が余り人間の味方をすると云って憤られる。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのつもりで、これを日本文字に直してみよう」右廻し――ソオイナ左廻し――イ右廻し――サヲトセノナチ左廻し――ドニアニ右廻し――ダモオ左廻し――ラ「どうだい！",
              "citation": {
                "source": "獏鸚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのつもりで私の知ってゐる事は何でもオイナでもユカラでも何でも書かふと思ふて、それをたのしみに毎日ローマ字を練習して居ります。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は、夏休みの中に書上げる筈のオイナがまだ半分しか出来ないので、こんどは学校と其方で転てこ舞です。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "互にその成功を競いしが、女神は偶然アイオイナカムイの妹に逢い、女の習慣として、喋々相語りて、多くの時間を空費し、男神の既に其業を終りしを見て、大に驚きて、俄に急きしが故に、西海岸は、東海岸に比して、甚しく粗悪険阻なりと。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイナリ様の小さなホコラすらもなかった。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "外出して夜更けに帰宅することがあっても、家人への挨拶もそこそこに、オイナリ様を拝んでくるのが例であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが終りに、「あなたがお嫁に行く日まで、オイナリ様の朝夕の日参は必ずつづけて下さい。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、母の死後、父がオイナリ様を拝んだことはついぞなかった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "このオイナリ様は狼イナリと云うのだそうだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "由利子はオイナリ様へ参拝した。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもは閉じられているオイナリ様の扉がひらいていた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オーカミイナリって、賀美村のオイナリ様？",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイナリ様直々のタタリだということになりましたが、当家が故郷をひき払って上京したのは、これが原因で、どうしても居たたまらなかったのでしょう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さなありふれたオイナリ様である。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
