    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "プウシュキンほどの自由奔放の詩人でさえも、その「オネエギン」を物語るにあたり、この主人公は私でない、私は別の、全くつまらぬ男だ、オネエギンは私でない。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "プウシュキンは三十六で死んでも、オネエギンをのこした。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ坊や、これから坊やとオジチャンとオネエチャンと三人で、どこか安楽な島へでもゆこうじゃないの」　そうして間もなく、この“Nord-Malekula”を三人が出ていった。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オジチャン、もう日本へ来たのかい」「まだまだ、坊やがそう、百もおネンネしてからだね」「じゃ、オジチャンとオネエチャンがお父ちゃんとお母ちゃんになって……、坊やは、唯今って日本へいくんだね」　そんなことが、ますます二人を近附けてゆくのだ。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オネエと云ふ一人の女などは、「昨日も競馬で儲かりましたから今夜｜酒場モニコへ御一緒に参りませう」なんて、よくおれの部屋を叩いて云ふことがあつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはミリオネエルだ。",
              "citation": {
                "source": "橋の下",
                "author": "フレデリック・ブウテ　Frederic Boutet",
                "note": "青空文庫"
              }
            },
            {
              "text": "して見ると、珍らしいミリオネエルの変物だなあ。",
              "citation": {
                "source": "橋の下",
                "author": "フレデリック・ブウテ　Frederic Boutet",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミリオネエルはよく出来たな。",
              "citation": {
                "source": "橋の下",
                "author": "フレデリック・ブウテ　Frederic Boutet",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩の氣分の高まりと共に、オネエギンの力強い獨唱は、かくして道にはぐれていつた不幸な若者に對する如何ともしがたい憐憫でいよいよ沈痛を加へる。",
              "citation": {
                "source": "ゲエテの「冬のハルツに旅す」",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスにおける伯爵位と、オネエルの隊長職を、矛盾なく兼ねることが、彼には不可能だった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
