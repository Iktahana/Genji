        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先生が子どもたちに「春のお歌を作ってみましょう」と声をかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「このお歌はどなたがお作りになったのですか」と、来館者が学芸員に尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "祖母が昔からよく口ずさんでいたお歌を、孫たちが歌会で発表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
