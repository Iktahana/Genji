[
  {
    "uuid": "6423030f-4630-5c47-873a-1bf90bdd9319",
    "entry": "お歌",
    "reading": {
      "primary": "おうた",
      "alternatives": [
        "みうた",
        "おんうた"
      ],
      "is_heteronym": true
    },
    "grammar": {
