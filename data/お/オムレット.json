        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "パティシエが実演で焼いたオムレットは、ふっくらとしたスポンジ生地に生クリームをたっぷり挟んだ一品だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "北海道のお土産コーナーでオムレットを見つけ、しっとりした食感と控えめな甘さに感動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「このオムレット、外側はさくっとして中はふわふわね」と祖母が嬉しそうに頬張った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "グルグル廻る戸から出た彼の印象、妻沼さんのダディへのインビテーションをホールできき、いそいで、オムレットをたべて出かけた。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝はオートミールとオムレットなどやパンもバタもとる。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼飯はオオゼエルの野菜料理屋で、名代のオムレットを喰べさせると君はいったが、もうそろそろ正午だというのに、今見たらエッフェル塔はまだ目のしたにある様子だ。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "合乗り乳母車　――仏蘭西縦断の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
