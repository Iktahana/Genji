        "examples": {
          "standard": [
            {
              "text": "経済学部の授業でオーストリア学派のハイエクとミーゼスの思想を比較する課題が出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "オーストリア学派は市場の自発的秩序を重視し、政府介入に批判的な立場をとると教科書に書いてあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼はオーストリア学派の経済理論に強く影響を受け、規制緩和を訴える論文を書いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "経済学に於ける古典正統学派（Ａ・スミスやリカード）や歴史学派（シュモラー）、形式主義（Ｃ・メンガー）や主観主義（オーストリア学派）、等々の間の対立も亦有名である。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば前にも云ったように、オーストリア学派の経済学は金利生活者階級の経済学であり、それは金利生活者の社会心理を媒介とすることを通して批評されねばならなかったのである。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
