        "examples": {
          "standard": [
            {
              "text": "「陰陽師身の上知らず」というが、他人の悩みを的確に見抜く彼が自分の失敗にはまるで気づかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「陰陽師身の上知らず」で、人の運勢を占う彼女自身は恋愛で何度も同じ失敗を繰り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「陰陽師身の上知らずだよ」と友人に笑われ、自分のことが一番見えていないと気づかされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "諺に「陰陽師身の上知らず」といい、また「陰陽家は鬼のためにねたまる」というが、八卦を業とするもの、およびこれを妄信するもの、多くは貧困にして、しかもその家に災害が比較的に多いように見ゆ。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
