    "definitions": [
      {
        "index": 1,
        "gloss": "timidly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "初めてのアルバイトで、彼女はオドオドしながら接客の手順をこなしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "校長室に呼ばれた生徒はオドオドと入室し、うまく話せないまま頭を下げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "大きな犬に近づかれた子どもはオドオドして、お母さんの後ろに隠れてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "大吉、オドオドして居る仲蔵の所へ戻って、　「ヤイコラＴ「仲蔵！",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手役によって演技を変えて行く名優のような巧妙さだと、言ってしまえば、話は早判りするが、しかし、オドオドする態度は意識的には演じられても、われにもあらず、ぽうっと顔を赧くするのは、いかな名優にも出来ない芸だった。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと云うのは、彼女は他の女達のように、私へ笑いをかけることをちっともしなかったし、それに脆弱な花のように、ひどくオドオドとした哀れな風情が、その大きな愁しげな眼や、尖った肩さきなどに感じられたからである。",
              "citation": {
                "source": "ああ華族様だよ　と私は嘘を吐くのであった",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこいらをオドオド見まわしては新らしいラムプの光りと、娘の膨れた腹とを、さも恨めしげに何遍も何遍も見比べた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "草川さん……」　草川巡査も何やらハッとしたらしく、そういう一知の何かしら狼狽した、オドオドした眼付きを振返ると、ちょっと立止まって、その顔を穴のあく程凝視したので、一知は見る見る真青になって、唇をワナワナと震わした。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今更の事のようにメソメソ泣きながら出迎えた一知夫婦と一緒に、一言も口を利かないまま、井戸端の混凝土の上に並んで突立って、検事や、予審判事や、警官連の行動をオドオドと見守ってばかりいた。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」人のよさそうな女中は、オドオドしながらいった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう多分、お帰りになるだろうと思いますが、ハッキリしたところは……」と、背後に、夫人の気配を知ってオドオドと、受けているらしい女中に、「誰から？",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中は、まだオドオドしながら、「一度かけましたんですけれど、お話し中でお待ちしている内に、今の方から、お電話がございましたので……」と、相すまなそうな女中の云い訳を、背中で聴き流しながら、二階の部屋へ帰って来ると、綾子夫人は、もう一度鏡の前に、苦っぽい笑いを浮べて、腰をかけた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄養不良らしい青い顔をして、そりの強い眼鏡を掛けてゐてオドオドした娘だつたが、楢雄が行くたび首筋まで赧くして、にこつと笑ふと、笑窪があつた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――何とも云はずに抱き絞めたかつたが、何だかオツカナイやうな気遅れがして、可笑しかつたが仕方がなくさう云つてオドオドしながら延子の肩へ手を掛けさうにした。",
              "citation": {
                "source": "坂道の孤独参昧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい血色が光を失い、大きい眸が、オドオドとふるえていた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　闇の中で、宮田の両手が倭文子の両肩にかかったとき、今まではおびえた小鳥のように、ただオドオドしていた倭文子の心に身を守る強い覚悟が爆発した。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オドオドして、声がふるえていることが、よくわかった。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　杉野｜子爵に対する、父の燃ゆるような憎悪の声を聞くと、瑠璃子は自分の事のように、オドオドしてしまった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "澄夫の顔を指し、又自分の腹部を指し示して、情なさそうな奇声を発しながらオドオドと三人の顔を見廻わした。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処までも正直な忠実な、いつもオドオドキョロキョロしている種類の女であったが、彼女は私たち三人の前で、真赤な両手を膝の上にキチンと重ねながら、柔道選手か何ぞのように眼を据えて答えた。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "門口に立っていた娘はオドオドと慌てて、おくれ毛をかき上げたり、帯の形をなおすように、うしろへ手をまわしたりした。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親が川崎船で出ている雑夫が、漁夫達の集っている輪の外をオドオドしていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――気のせいか、そうして日毎に御容子のお変わりになって行く旦那様のお側におりながら、私共は、ただわけもわからず、オドオドいたすばかりでございました。",
              "citation": {
                "source": "幽霊妻",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその父親と言うのが、これが又無類の子煩悩で何かにつけてもトヨやトヨやと可愛がり、歳柄もなく娘が愚図り始めた時などは、さあもう傍で見る眼も気の毒な位にオドオドして、なだめたりすかしたりはては自分までポロポロと涙を流して「おおよしよし」とばかり娘の言いなり放題にしているとの事。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉葉は唯オドオドしてゐた。",
              "citation": {
                "source": "道綱の母",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　母親はオドオドして、「そんなことを思わないほうがいいよ。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　杉野子爵に対する、父の燃ゆるやうな憎悪の声を聞くと、瑠璃子は自分の事のやうに、オドオドしてしまつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "又いじめられたら……　不安がってオドオドして居る様子を見ると死ぬまで自分のそばに置いた方があの女にとっては幸福かもしれないとなんか思えた。",
              "citation": {
                "source": "蛋白石",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その横後には、中谷助役以下の当局者がズラリと並んでいたが、いずれも蒼白な面を伏せて、罪人の如くオドオドしていた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私に追いすがった男の姿、お話にならないオドオドした姿だった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その唇の近くで白い指先をわななかしながらすぐ傍の芝生の上に残っている輪形の鉢の痕跡を見まわしていたが、やがてオドオドした魘えたような眼付きで、階段の上を見上げた。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして何かに魘えているかのようにオドオドと禿頭を下げたが、揉み手をしいしい首を擡げて、正木博士と私の顔を霞んだ眼で等分にキョロキョロと見比べると、又一つ、床に手が届くくらい馬鹿叮嚀なお辞儀をした。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
