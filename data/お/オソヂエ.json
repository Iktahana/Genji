        "examples": {
          "standard": [
            {
              "text": "幼い頃は遅知恵だった彼だが、今は優秀な若手研究者として活躍している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの子は遅知恵だから、ゆっくり見守ってあげよう」と祖母が優しく言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "周囲と比べて成長が遅く、遅知恵ではないかと両親は心配した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
