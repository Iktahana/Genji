        "examples": {
          "standard": [
            {
              "text": "このビルの地下室はオフリミット区域になっているため、従業員でも許可なく入ることはできない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "スポーツ競技場ではロッカールームがオフリミット区域に指定されており、観客は立ち入り禁止です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "工事現場はオフリミット状態になっているので、安全のため周辺に近づかないでください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "今はオフリミットになっちゃったけど、開店当時は随分外人も来たわよ。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説にはいかなるオフリミットもないと考えていた。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
