  {
    "uuid": "8bb5d499-5384-5eda-8956-69b61ee9de21",
    "entry": "オトウ",
    "reading": {
      "primary": "おとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "壁にはいつの間に描いたのか、丸まげに結った女と、シルクハット姿の男の顔が茶色の色鉛筆で描いてあり、それぞれ、「君チャンノオカアチャン」「君チャンノオトウチャン」　と、右肩下りの字で説明がついていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "センセイノ　コ新美南吉　タキクンノ　オトウサンハ　一ネン　ダンシノ　ウケモチデシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　ハナノ　下ニ　クロイ　ヒゲヲ　ツケテ　ヰタノデ、コドモタチハ　「ヒゲサン」ト　ヨンデ　ヰマシタガ、ヤガテ　タキクンノ　コトモ　「ヒゲサン」ト　ヨブヤウニ　ナリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　タキクンノ　オトウサンガ　ヤサシク　タヅネルト、ミツルクンハ　ナキナガラ、「タキクンガ　イジメタ、アーン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　オトウサンハ　キメツケテ　シマヒマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ、キヨウシツデ　ヒトリキリ、ナニカ　カキモノヲ　シテ　ヰマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　トウサンノ　ウシロカラ、「オトウサン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　クルツト　コチラヲ　ムイテ　タキクンヲ　ヒザノ　上ニ　ノツケマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　ウレシク　ナツテ、「オトウサン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ、タキクンノ　カホヲ　ノゾキコミナガラ、「オトナシク　シナキヤ　イケナイヨ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　ワカイノニ　オトウサンモ　オカアサンモ　キヨウダイモ　ナク、ホントウニ　ヒトリボツチデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、オマエタチノ　オトウサンヤ　オカアサンタチハ　ヨク　コノ　バシヤノ　ゴオンヲ　ウケタノサ」　ソシテ　ソンチヨウサンハ　イヒツヅケマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……オトウサン……」　という声をツイ耳の傍で聞いたように思ったのはソンナ時であった……。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……オトウサーアアーンン……降りて行きましょうかアア……」　という中に太郎は堤の上をズンズンこちらの方へ引返して来た。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オトウサンオトウサンオトウサンオトウサンオトウサン」　それは死に物狂いに藻掻いている小さな人間の声のようでした。",
              "citation": {
                "source": "卵",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシハ、アクネンユエ、タダジットシテイマス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンガ、キュウシュウヘ、ユクノデ、ワタシハ、オマエノトコロヘ、ユクカモシレマセン、タノシミニ、マッテイナサイ――母よりの手紙。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシワ、アクネンユエ、ジツトシテイマス。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレモ　ユリコサン　ニアケマス　オトウサマカ　ナニヲシテ　イマスカ　オカアサマニ　オキキナサイ　オカシイデショウ　　　〇六・三・二六」　ロンドンから母宛に来た手紙の中に封じこめられたものであったのでしょう。",
              "citation": {
                "source": "写真に添えて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は、おかっぱの私の右手に筆を持たせ、我手をもち添えオトウサマ、ハヤクカエッテチョウダイ、ユリコと書かせるのであった。",
              "citation": {
                "source": "中條精一郎の「家信抄」まえがきおよび註",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男がみんな居るみたいだ」「弟も、オトウサンもあるわよ」「そんなの、男じゃないや」　と呟きながら立ち去った。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンモ　オカアサンモオゲンクワンノ　トコロデ、マッテ　オイデニナリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサン　オカアサンタダイマト、タローサンモハルコサンモトンデユキマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　この時に宇陀にエウカシ・オトウカシという二人があります。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてそのオトウカシが獻上した御馳走を悉く軍隊に賜わりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
