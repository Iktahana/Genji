[
  {
    "uuid": "af396fbc-1aa2-5936-8dc7-2c427e02692d",
    "entry": "お父",
    "reading": {
      "primary": "おとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
