        "examples": {
          "standard": [
            {
              "text": "日本語の音素を習得するのが難しいのは、母語の音素体系との違いが大きいからだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "言語学の講義で、音素と音声の違いについて詳しく説明された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「ら」行の音素は英語話者にとって特に発音が難しいと言われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "我々の片仮名で描き出そうとするから失敗するのだが、もともと雀の子音はいたって数少なく、ことによったら一つの音素が、出しようによってちがって聴えるのかとも思う。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
