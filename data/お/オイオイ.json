          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "赤ちゃんはおいおいと泣きながら、母親に抱かれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "幼い妹はおいおいと泣いて、お母さんを探していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "映画の感動的なシーンで、彼女はおいおいと泣いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
