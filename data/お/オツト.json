        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "街路は冬のやうに白つちやけて、昔ながらの大道店が、ガマの油や、オツトセイや、古着類や、縞蛇や、得體のわからぬ壞れた金物類などを賣つてる。",
              "citation": {
                "source": "悲しい新宿",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その口に墮ちたるは、ブルツス、カツシウス、ユダス・イスカリオツトなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にもユダス・イスカリオツトは、魔王が蝙蝠の如き翼を振ふ隙に、早く半身を喉の裡に沒したり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "後にパリでオツトマンがかかる色彩諧調によつて幾多の絵を作つてゐるのを看た。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――（×印へ）同宿のテキヤさん、トギヤさん、なか／＼の話上手だ、いろ／＼話してゐるうちに、猥談やら政治談やら、なか／＼面白かつた、殊にオツトセイのエロ話はおかしかつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る男の手記、彼はま夜中にひとり踊る、何を踊る、ステテコ、ステテコ、オツトヤレコラ、ハクシヨイ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て「ミツドル、マアチ」を見しに、ジヨルジ・エリオツト女史が作に人間派の旨に※へるところあり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホオマア、シエクスピイヤ、ギヨオテ、スコツト、エリオツト等は、家數の大小こそ相殊なれ、此派の詩人なり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「紫式部、清少納言、ヂヨオヂ・エリオツト、クリスチナ・ロセツチ……成程ほんとやわ、みんな髯があらへん。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころ、ある大学の神学部長をつとめてゐたロオレンスとハーバード大学の総長エリオツト博士が、つれ立つてあるきながら、この問題について談話をとりかはしてゐたことがあつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二三日して神学部長はエリオツト総長に出会つた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜もいつか散り果てゝ……オツトそれじやまるでサツマ琵琶のやうだ、もう青葉の影には清新な風が薫るやうになりました。",
              "citation": {
                "source": "〔編輯余話〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オツト危険ねえ、すんでの事溝へ落つこちるところだつけ。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "はツとはするが、そのあとから、今度は、最近の戦況、タラワ、マキン南島守備隊の玉砕、クエゼリン、ルオツト南島指揮官以下四千五百名の悲壮な戦死、敵有力部隊のロスネグロス島上陸の、相次ぐ緊迫した戦局が、ひしひしと胸を締めつける。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "常にオツトセイを捕へて食べるので、その顔がオツトセイに似てゐるといふことは面白いことであります。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども戦争中の日本人は国民儀礼と称する奇々怪々なオツトメをやらされ、朝々ノリトのような誓いの言葉を唱え、その滑稽の度において天璽照妙と全く甲乙のないことをやっていたのである。",
              "citation": {
                "source": "邪教問答",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "★　初七日から四十九日までのオツトメの日には代理の高徳をさしむけてホトケの冥福を祈ってもらったが、ホトケには特別の愛顧をうけ、またはしなくもその臨終に立ち会った因縁もあるしするから、代理まかせにしておくだけでは気持がすまなかった。",
              "citation": {
                "source": "お奈良さま",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御愛顧の大恩もあり、また浅からぬ因縁もあるホトケの法要にオツトメにも参じませず心苦しくは存じておりましたが、重ねて不調法をはたらいてはと心痛いたしましてな。",
              "citation": {
                "source": "お奈良さま",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉氏の応援に、ジコーサマが津軽辺から出張して、呉氏の宿に泊りこんだ由であるが、あたり構わぬオツトメをやり、音楽、オイノリ、そのうるさゝに家主が怒って、警察へ訴え、ジコーサマの一行が留置されてしまったのである。",
              "citation": {
                "source": "呉清源",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「朝夕のオツトメには、まだ加わることはできない。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴メがオツトメの座へ現れよると、一同の魂をぬきよるので、こまる。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "年をとると毎晩のオツトメがつらいよ。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆愚と自働機械の時代に於てはかの俗流に媚ぶるエリオツト或はパツトラア教授の如き人々でなければ成功と永続とは覚束ないのである。",
              "citation": {
                "source": "少数と多数",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで基督一代の事蹟をあらはしたジオツトの壁画を見てゐた。",
              "citation": {
                "source": "接吻",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジオツトの、単純で古雅で佳麗で確かな技倆は、接吻の図に於てもその特徴を失はない。",
              "citation": {
                "source": "接吻",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖ピーター君ガ私ニ三度モ知ラナイト云フ　ヤ否ヤ　鶏が羽搏ク……　　　　　オツト　お湯ヲ　コボシチヤ　タイヘン――",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
