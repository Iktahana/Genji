          "literary": [
            {
              "text": "もうあとは、○○獣が外へ出てきて、陥穴におちるばかりであった。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この侵入者と掠奪者の為に農事の子供は、竹の吹矢をこしらえて隠れて吹きつけたが効を奏さない、陥穴をこしらえて見たがかからない、鰻釣針に餌をつけて、藪の中に仕掛けて置いて見たが、食物と針とは呑み込んで糸だけを食い切って逸走してしまっている。",
              "citation": {
                "source": "百姓弥之助の話",
                "author": "第一冊　植民地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "道｜傍に兎を捕るとて笹の葉をまげて細工した陷穴が二つばかりあつた。",
              "citation": {
                "source": "黒岩山を探る",
                "author": "沼井鐵太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
