        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "振り向くと、唇の間からたらんと舌を垂れ、ウオーウオーとけだもののような声を出して苦悶していた。",
              "citation": {
                "source": "競馬",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにたどればビッグ・ブラザーはジョージ・オーウェルの『一九八四』から、ザ・ホールディング・カンパニーはマリファナを持っているという意味のスラングからきている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "個人へのコンピューター・パワーの解放が実現していなければ、我々は一九八四年をジョージ・オーウェルの描いた悪夢の管理社会により近い形で迎えていたはずである。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これなら私の好きな上田秋成や長谷川四郎や翻訳のジョージ・オーウェルだって、なんとか読んで読めないことはないような気がする。",
              "citation": {
                "source": "本はどのように消えてゆくのか",
                "author": "津野海太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これなら私の好きな上田秋成や長谷川四郎や翻訳のジョージ・オーウェルだって、なんとか読んで読めないことはないような気がする（まだ読んでいない）。",
              "citation": {
                "source": "本はどのように消えてゆくのか",
                "author": "津野海太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかには、海豹、海驢、緑海豹など十匹ほどのものが、鰭で打ちあいウオーウオーと咆えながら、狭いなかを捏ねかえすような壮観だ。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那人はしかたがないというふうでウオーウオーと馬を進めた。",
              "citation": {
                "source": "一兵卒",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月十八日（水曜）　白揚社からバッハオーウェンの母権論を富野敬照という坊さん出らしい人が訳している。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オーウ」　という遠い山のフクロウのような声がきこえた。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとボックスの方からも、「オーウ」　と例の遠い山のフクロウのような声がきこえてきた。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし何事もないので、また、「オーウ」　と同じ声が起った。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オーウ」　という八十松の遠吠え。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（卓をドシンとたたく）（その時、写真班の記者がパンとマグネシウムをたく）トンコ　（久子の腕の中でびっくりして）ウオーウオーン。",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（それが、夜空にオーウと反響して、深夜の大きな驛の構内の靜けさが、這いあがつて來る。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この翻訳にあたっては、H.Tsubota さんの「【日本語訳】ジョージ・オーウェル評論集」（http://blog.livedoor.jp/blackcode/archives/Orwell-essays.html）を参考にいたしました。",
              "citation": {
                "source": "ファシズムとは何か",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "絞首刑ジョージ・オーウェル　George OrwellThe Creative CAT 訳-------------------------------------------------------【テキスト中に現れる記号について】：ルビ（例）さあ！",
              "citation": {
                "source": "絞首刑",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "マスメディアが容易に権力の再生産装置になってしまう事情はオーウェルが唾棄していた当時のままで、今ではSNSも参戦して混迷を深めています。",
              "citation": {
                "source": "詩とマイクロホン",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、何かにウオーウオーと追駈けられる気持で、せかせかと町から町を走り廻った。",
              "citation": {
                "source": "蟲",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
