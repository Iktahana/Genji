    "definitions": [
      {
        "index": 1,
        "gloss": "children's game in which (at least three) people stand back to back to each other and shove vigorously backwards",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
