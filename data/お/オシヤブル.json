        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は群衆の壁を押し破って前方へ進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "嵐の風圧が窓ガラスを押し破り、室内に雨が吹き込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "チームは相手の守備ラインを押し破り、ゴールを決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そこで待ち合わせ、戸を押し破る手助けまでして、そのあと仲間割れしたのかもしれません。",
              "citation": {
                "source": "ライギット・パズル",
                "author": "THE REIGATE PUZZLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい杉を小楯にして、半七は関戸屋の二階に眼を配っていると、やがて竹窓をめりめりと押し破るような音が低くきこえて、黒い人影が二階の横手にあらわれた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "その錆び朽ちた戸を押し破ることはできそうに思えた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄の門をおしやぶるようにして、人々は三つの流れをつくっている。",
              "citation": {
                "source": "白い道",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の力でこの密室が押し破れるものだったら、どこかの羽目を踏み砕いても飛出したであろうが、それとても出来ないことです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金色の処女",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の力で此密室が押し破れるものだつたら、何處かの羽目を踏み碎いても飛出したであらうが、それとても出來ないことです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "金色の處女",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
