[
  {
    "uuid": "cf907207-f937-5f56-90e5-5a0a5624b7ce",
    "entry": "叔母",
    "reading": {
      "primary": "おば",
      "alternatives": [
        "はくぼ",
        "しゅくぼ"
      ],
      "is_heteronym": true
    },
    "grammar": {
