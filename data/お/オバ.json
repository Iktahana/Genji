  {
    "uuid": "3646061b-c512-51da-8871-33a6d2a842e9",
    "entry": "オバ",
    "reading": {
      "primary": "おば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オババサンニ可愛イ言葉。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はいつも手紙の終りに『オババサマニヨロシク』とか『オババサマニ可愛イ言葉』とか書いている。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "オババサマとは彼の妻の母であって、名義上、小泉家の養子たる彼にとっては、姑の義母に当る老婦人である。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリキのように固くなったオバーオールが、三着。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りに一緒にオバさんとこでお茶を飲んだってな。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の陰気な影をうけて、凄いような色の白いのが、黒の中折帽を廂下りに、洋杖も持たず腕を組んだ、背広でオオバアコオトというのが、色がまた妙に白茶けて、うそ寂しい。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この町では、いまも昔と変らず、毎朝、さかなやがリヤカーにさかなを一ぱい積んで、イカにサバだぢやあ、アンカウにアオバだぢやあ、スズキにホツケだぢやあ、と怒つてゐるやうな大声で叫んで、売り歩いてゐるのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤ、オバの訛りか、などと当てずつぱうしてみたつてはじまらない。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト　モウシマス　ト、サカナタチ　ハ、サモサモ　バカ　ニ　スルヨウニ、ワラッテ　オヨギ　モ　シラナイデ　ウミ　ニ　クルナンテ、キミ　ハ　オオバカサンダ　ト　イッテ　アイテ　ニ　シテ　クレマセンノデ、ヤマキチ　ハ　コンド　ハ　ナミ　ニ　ムカッテ、ボク　ヲ　オヨガセテ　クダサイ　ト　タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤーイ、オバアちゃんのほうがよく知ってら。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋茶で羊羹などつまむ暇もなく、マッキントッシュの低価格モデルは飛び出すわ、弟が結婚して中日の落合大選手様と親戚になるわ、町内で三件もオババの葬式がでるわ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人はポルタ・ヌオバの門番に賂して易々と門を出た。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサン新美南吉　ミチコサンガ、コトリヤノ　マヘマデ　クルト、シラナイ　オバサンガ、ウバグルマノ　ナカノ　ニモツヲ　ナホシテ　ヰマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、オバサンノ　ソバニ　ヨツテ、「アカチヤン　ダイテテ　アゲマセウカ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イイワ　オバサン。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オバサンハ　アカチヤンヲ　ミチコサンニ　ダツコサセテ　クレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　ウチニ　オバサンハ　スツカリ　ウバグルマノ　ナカヲ　カタヅケテ、「スミマセンデシタ、ホントウニ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんぼ、私とこの大将と恰好が似ているからって、別に、親類のオバサンが来たなんてんで、懐いたんじゃないよ。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、いまや潜航艇「｜鷹の城」の艇長――故テオバルト・フォン・エッセン男の追憶が、その夫人ウルリーケの口から述べられようとしている。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつかの日、私はテオバルト・フォン・エッセンという一人の男を知っておりました。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですけど、貴方の幻だけはかたく胸に抱きしめて――あの気高くも運命はかなき海賊、いいえ、男爵海軍少佐テオバルト・フォン・エッセンは、死にさえも打ち捷って、このような熱い接吻で私の唇を燃やすではございませんか。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええどうして、テオバルトの生還が望まれましょうか。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがウルリーケの夫、テオバルト・フォン・エッセン男爵の画像だったのである。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、あの方が失踪したおりには、テオバルトも一応は疑われました。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつまでもテオバルトのことを、『さまよえる和蘭人』のように考えていて、シュテッヘという悪魔を冒涜したために、七つの海を漂浪わねばならなくなったと信じているのです。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――貴方もやはり、シュテッヘの失踪について、テオバルトを疑っていらっしゃるのです。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ですけど、あのテオバルトが、どうしてシュテッヘなものですか。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく結果だけを見たら、それが、あのまたとない一人三役――ねえ夫人、貴女はたぶん、それを御存知ないのでしょうね」「いいえ、その病だけは、いかにも真実でも、……現在のテオバルトは違いますわ。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは、私をテオバルトに遇わせて下さいましな。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
