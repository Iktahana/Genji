        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『ビデオプレイ』という雑誌で連載化されたこのシリーズでは、パーソナルコンピューターを使ってパターンを描き出したり、立体映像を作ったり、時には磁石で画面をこすって、色合いをごちゃごちゃにしてしまうといった乱暴な楽しみ方を伝授していきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "エティオプレ」「パルテ」という出発の号音を聞いたときは、ただ漕いだ。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオプレーン・スポンジの、黒いウエット・スーツだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオプレーンで小さな細胞をいくつも作り、それをぎっしりと何層にも封じこめたスーツだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に古い／＼「緑の地平」てふものが始まった、もう我慢出来ないで、自動車で修善寺へ引っかへした六月八日（月曜）　ついに、ラヂオプレイ三十枚きりであったが、まあ書けないよりよかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
