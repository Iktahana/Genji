[
  {
    "uuid": "cd66b1c4-d4fe-5842-bd64-13f91818791d",
    "entry": "帯締め",
    "reading": {
      "primary": "おびじめ",
      "alternatives": [
        "おびしめ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
