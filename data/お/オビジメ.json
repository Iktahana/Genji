      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "decorative string used to hold a kimono sash in place",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "着付け師は太鼓結びの形が崩れないよう帯締めをきゅっと締め、指先で結び目の位置を丁寧に整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "振袖に合わせて選んだ赤い帯締めは、全体のコーディネートを引き締める差し色として大きな効果を発揮した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "帯締めが緩んでいることに途中で気づいた彼女は、着物仲間にそっと直してもらいながら茶席に臨んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "その雨の中を漂ひながらいつだか消えてなくなつた、あの乳白の※嚢たち……今や黒い冬の夜をこめどしやぶりの雨が降つてゐて、わが母上の帯締めも雨水に流れ、潰れてしまひ、人の情けのかずかずも竟に蜜柑の色のみだつた？",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "正直な満蔵は姉にどなられて、いつものように帯締めるまもなく半裸で雨戸を繰るのであろう。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おとよさんちょっとえい景色ねい、おりて見ましょうか、向うの方からこっちを見たら、またきっと面白いよ」「そうですねい、わたしもそう思うわ、早くおりて見ましょう、日のくれないうちに」　おとよは金めっきの足に紅玉の玉をつけた釵をさし替え、帯締め直して手早く身繕いをする。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "萱の花誰に見よとて　　　髪結ふた西の山には　　　萱の花誰に解かそと　　　帯締めた東の山にも　　　萱の花萱の枯葉に　　　だまされたお綱さまはと　　　懸巣啼く。",
              "citation": {
                "source": "別後",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは母がいつも寝床の上に置いて寝る平生着の帯締めで、紫色の打紐に、鉄の茄子が附いているのでした。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚又、当時犯行用と認められし帯締めは、その後、数名の警官の手に転々したる後なりしを以て、何等犯人に関する証跡を検出するを得ず。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と帯締めの打紐を解きつ結びつ。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯締めだってきちんと結ばれているし、落したとすれば、道を急いだために、蟇口自身がひとりでに浮き上って、そして知らぬ間に零れたに相違なかった。",
              "citation": {
                "source": "錦紗",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "五「中姉ちゃん、その帯締めて行くのん」と、姉のうしろで妙子が帯を結んでやっているのを見ると、雪子は云った。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "忙しげに腹帯締めて、起ち上がると、沢から攀じ登って来た顔と、灌木の中からふいに起った彼の顔とが、云い合わせたように双方から見合った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "那奴なら恐れることは無い」　彼の起ちて帯締直すを蒲田は見て、「まるで喧嘩に行くやうだ」「そんな事を言はずに自分も些と気凛とするが可い、帯の下へ時計の垂下つてゐるなどは威厳を損じるぢやないか」「うむ、成程」と蒲田も立上りて帯を解けば、主の妻は傍より、「お羽織をお取りなさいましな」「これは憚様です。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（乙）被害者千世子は同夜午前二時――三時の間に、背面より絹製の帯締を以て絞殺され、寝具を蹴散らし、畳の上を輾転して藻掻き苦しむなど、甚しき苦悶の跡を残したるまま絶命せるものを、更に階段の処に持行きて手摺より細帯にて吊し下げ、階段の降り口に正面させて縊死と見せかけたる事明らかなり。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "細帯締た娘は茶を入れて私達の方へ持って来てくれた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "こほろぎ遊びこほろぎ　コロコロ夜長だな夜長だ　夜長だ帯くけたその帯　どの子に締させるこの子に　この帯締させる。",
              "citation": {
                "source": "螢の燈台",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、上等の帯締と絹のストッキングが幾つもあった。",
              "citation": {
                "source": "田園の幻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "小紋錦紗のすらりとした姿で、重ね着の淡色の襟を二枚、白縮緬の半襟の上にのぞかせ、臙脂矢羽根の帯締に小さな銀鍵をさげている。",
              "citation": {
                "source": "変る",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもより濃く化粧をし、髪のカールを一筋乱れぬまでに梳かしつけ、薄鼠色の地に水色の井桁を散らした薄物をきりっとまとい、一重帯の帯締の翡翠の彫物を正面から少しくずらし、畳表づきの草履を白足袋の先につきかけ、銀の太い握りの洋傘を絽刺のハンドバッグに持ち添えていました。",
              "citation": {
                "source": "白蛾",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからきれいなとき色の絹しぼりの帯締を私は買っていたゞきました。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "琴川　一名帯締川、濫觴ハ奥仙丈ノ中ヨリ発シ、中牧大窪二山ノ渓水相集リテ南流シ、杣口、千野ノ宮、窪平村東ヲ歴テ、室伏村ノ東南ニテ笛吹川ニ注グ。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸子は結ばれたお太鼓の上を片手でおさえて、立ったまま二三度息をしてみて、「今度はええらしい」と、口に咬えていた帯締を取って中へ通したが、そうしてきちんと締めてしまうと、又その帯もキュウキュウ云い出した。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この帯やったら、帯締どれにしょう」「それでええやんかいな、早う、早う、―――」「そない急からしゅう云わんといて。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そない云うてくれると、あたしかてほんまに骨折がいがあるねん」幸子は身支度をしてしまうと、そんならちょっと、晩の御飯までに帰って来るよってに、と云い置いてひとりで出かけたが、雪子は姉が脱ぎ捨てて行った不断着を衣紋竹にかけ、帯や帯締を一と纏めにして片寄せてから、なお暫くは手すりに靠れて庭を見ていた。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯締メハ金ト銀トヲ縄ノヨウニ撚ッタモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "久枝は北浜の銀行へ勤めに出て、太鼓の帯に帯〆めをきりりとしめ、赤い着物に赤い鼻緒の下駄で、姉たちとはかけはなれて派手な娘であった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "物の透間が仄白くなって、戸の外に雀の寝覚が鈴の鳴るように聞える頃は、私はもう起きて、汗臭い身体に帯〆て、釜の下を焚附けました。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
