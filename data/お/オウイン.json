        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "書類に押印する前に、内容をよく確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "契約書への押印で、取引が正式に成立する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "判子を使って押印する光景は日本文化の象徴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "書留用の封蝋や押印も揃っていた。",
              "citation": {
                "source": "踊る地平線",
                "author": "しっぷ・あほうい！",
                "note": "青空文庫"
              }
            },
            {
              "text": "メリヘイブン閣下、例の押印をすっかりお忘れのようですね」　メリヘイブン閣下が意味ありげにつぶやいた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "押印済みの羊皮紙はサマセット・ハウスから各支店へ出荷され、その出荷日が印字されます。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
