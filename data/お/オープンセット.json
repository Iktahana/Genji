        "examples": {
          "standard": [
            {
              "text": "位相数学の授業でオープンセットの定義を学び、すべての内点を含む集合であることをε-近傍を使って確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「実数直線上でオープンセットと閉集合の違いを直感的に理解するには、開区間と閉区間を比べるのが一番だよ」と教授が黒板に図を描いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "証明の中でこの集合がオープンセットであることを示すため、任意の点の周りに含まれる近傍の存在を丁寧に構成した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "オープンセット三島の宿。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五時からオープンセット、間で放送してすぐ引返して又撮影して呉れと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二十二日（月曜）　昨夜オープンセットの始まったのが十一時すぎ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
