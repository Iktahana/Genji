        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は疲れ切った様子で、机の上にぐったりと圧し掛かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供がふざけて、ソファに座っている父親の上に圧し掛かってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は深い悲しみに耐えかねて、墓石に圧し掛かるようにして泣いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "女は手鏡で顔のつくりをなおしかかると、二階あたりの階段をみしりみしりと上ってくるものがいた。",
              "citation": {
                "source": "三階の家",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to weigh on one",
        "register": "standard",
        "nuance": null,
