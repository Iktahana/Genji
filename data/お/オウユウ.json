[
  {
    "uuid": "f280527f-1508-5caf-8c99-b9077636301d",
    "entry": "応尤",
    "reading": {
      "primary": "おうゆう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
