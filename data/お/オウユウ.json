  {
    "uuid": "cfa9ee69-ea85-519e-804b-49e329603f44",
    "entry": "王有",
    "reading": {
      "primary": "おうゆう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
