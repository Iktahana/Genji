        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「コーヒー」と書くときの「ー」が音引きで、伸ばす音を表す記号だと先生が教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「コンピュータ」と「コンピューター」のどちらが正しいか迷ったが、音引きのあり・なしは表記の揺れだと知った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "外来語を片仮名表記する際、音引きを使うかどうかで語感がかなり変わることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
