    "definitions": [
      {
        "index": 1,
        "gloss": "looking up a word or kanji by its reading (rather than by its radical or stroke count)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "部首もわからない珍しい字に出くわしたので、音引きで辞書を引いてなんとか意味を調べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「読み方はわかるから音引きで調べよう」と彼はスマートフォンの辞書アプリを開いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "漢字の音引きに慣れておくと、読めるけど書けない字を素早く調べられて便利だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "俺はな、ヘン、ポンポンながら『おんびき虎』の一の乾分蛇の目の熊五郎と言うもんだ。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "生意気な、貴様は女だてら日本の産業を破壊する賀川の味方をしやがるのか、……よし殴ってしまえ」　こう声をかけたのが「おんびき虎」の一の乾分蛇の目の熊であった。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "katakana-hiragana prolonged sound mark",
        "register": "standard",
        "nuance": null,
