          "literary": [
            {
              "text": "「なるほど、これがオヤフロの野か」と大野順平はかすかにほほ笑んでいた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤフロの野にはいっての数時間は、ヤチダモ、アカダモの密林つづき、次第にカシワ、ナラなどの節くれ立った木が目につき、白い肌の樹が点在する粗林となった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "踏みまよい拒けられて、オヤフロの野と交わる尾根のふもとを歩かせられた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
