        "examples": {
          "standard": [
            {
              "text": "その音楽コンクールは、若い音楽家たちの登竜門として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女は音楽コンクールで優勝し、国際的な認知を得た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音楽コンクールの審査員たちは、その演奏に満場一致で高い評価を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが、去年の秋、俗に赤新聞とよばれている大阪日日新聞の音楽コンクールで、彼の三人の弟子たちが三人とも殆ど最高点に近い成績を取った。",
              "citation": {
                "source": "道なき道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三で小学校を卒業して、間もなく、東京日日新聞主催の音楽コンクールが東京で行われた。",
              "citation": {
                "source": "道なき道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
