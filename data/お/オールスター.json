        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この映画はオールスターと呼ぶにふさわしい豪華な顔ぶれが揃っており、公開前から注目を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "テレビ局の開局記念ドラマはオールスターで制作されると報じられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「こんなオールスターな舞台はなかなか見られない」と観客が興奮気味に話していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
