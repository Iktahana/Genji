      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to not know how to act or what to do",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "恋人との関係について思い余って、真夜中に親友へ電話した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "思い余った末、彼女は直接上司の家を訪ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "どうすればいいか思い余り、すべてを日記に書き出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「……私は……」と彼は軈て思い余るものの如く口走った。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "宰相中将は思い余る時々にだけ情熱のこもった手紙を雲井の雁へ書いた。",
              "citation": {
                "source": "源氏物語",
                "author": "梅が枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "思い余る心から、しいてここまで参ってしまったことは失礼に違いございませんが、これ以上のことをお許しがなくてしようとは存じておりません。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵馬の胸にも実は、思い余ることがあるのであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "道庵と鰡八の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の庵主は五十｜許の品のよい老女で、この老女がこの頃になって何か胸に思い余ることがありげに、しきりに心を苦しめているのが、そう思って見れば他目にも見えます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "慢心和尚の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕女きょうだい一人もないのんで、お姉さん親身の姉や思て大事にしますさかい、お姉さんもどうぞほんまの弟や思て、何でも思い余ることあったら遠慮のう打ち明けて下さいませんか。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "衛門督は思いあまる時々に夢のように忍んで来た。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（下）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女に凄さを求めるのは無理であろうが、紅筆をかんで、薄墨のにじみ書きに、思いあまる思案のそこをうちあけた文を繰広げてゆくような、纏綿たる情緒と、乱れそめた恋心と、人生の執着と、青春の悩みとが、聴くものを魅しつくしてしまう。",
              "citation": {
                "source": "豊竹呂昇",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには西行の思いあまる詠歎は影をひそめ、なにか優雅なきぬずれの音を思い、洗煉をかさねた気品の揺曳に身をつつむ宮廷の女性を思うのである。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を泣いていらっしゃるんですの」独りがさびしくなると、松虫はきっと仲のよい鈴虫の局を訪ねるし、鈴虫が何か思いあまることがあると、松虫の局へ行って、姉のように、何事も打明けていた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その御仏の力をお借りなされたがよい、なんぞ、胸に思いあまることがあれば、縋って、申されたほうがよいのです」「お上人様……思いあまることというのは、信心をすれば、良人の心に逆らい、信心を離れては、今の私は、生きているそらもないのでございます。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
