          "literary": [
            {
              "text": "其処を名高い大筏が二艘も三艘も下って来る。",
              "citation": {
                "source": "長江游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に私の実見した中にも、豚を飼っている筏があったから、成程飛び切りの大筏になると、一村落を載せたものもあるかも知れない。",
              "citation": {
                "source": "長江游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「与八、米の飯を食わせるから手を貸してくれやい」「うん」　そして、大八車でも杉の大筏でも、ひとたび与八が手をかければ、苦もなく解放される。",
              "citation": {
                "source": "大菩薩峠",
                "author": "甲源一刀流の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛入台付、大筏の上にいたスポオティング・クラブの面々も、口々に「いずれ後刻」といいながら、どぶん、どぶんと海に飛び込んで昼飯めがけて泳いで行ってしまった。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "謝肉祭の支那服　――地中海避寒地の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
