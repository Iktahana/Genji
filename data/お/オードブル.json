        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "スーパーの惣菜コーナーに、クリスマス向けのオードブルセットが並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "記念パーティー用にオードブルを大皿で注文したら、見栄えのする盛り合わせが届いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「オードブルだけでもうお腹がいっぱいになっちゃった」と彼女が笑いながら言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
