        "examples": {
          "standard": [
            {
              "text": "長年の病気で彼女は老いさらばえてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "貧困の中で人々は老いさらばえていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その老人は老いさらばえた表情で私たちを見つめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "こんな私を、誰が相手にするものですか……」「信用しない」「そう……でも、私、これから咲き出すつもり、生きている甲斐にね」「まだ、相当長生きだろうからね」「ええ、長生きをして、ぼろぼろに老いさらばえるまで……」「浮気はやめない？",
              "citation": {
                "source": "晩菊",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの見る影もなく、老いさらばえる面影、あの断末魔のはげしい苦悶、あの肉体と幽体とをつなぐ無気味な二｜本の白い紐、それからあの臨終の床の辺をとりまいた現幽両界の多くの人達の集り……。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
