[
  {
    "uuid": "4cc3709d-217d-5cd6-8a96-49a1f9cff380",
    "entry": "御父つぁん",
    "reading": {
      "primary": "おとっつぁん",
      "alternatives": [
        "おとっつあん"
      ],
      "is_heteronym": true
    },
    "grammar": {
