      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "father",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「御父つぁん、今夜の晩飯は何だい？」と太郎が台所へ顔を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "御父つぁんは下駄を鳴らしながら長屋の路地をゆっくりと歩いてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「御父つぁんに頼めば、きっと何とかしてくれるよ」と妹がつぶやいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "おとっつぁんに自転車でひと走りいってきてもらや、すむことだで。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎年おばあさんの役目でした」　おばあさんは、今年は息子のおとっつぁんの歿くなった七周忌だからと言って、念入りに灯籠を張り替えていた。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとっつぁんと呼ばれても文句は云えなかった。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの四人組の一人のおとっつぁん、あの人のように肉がこけて乾からびて行くのと、それはまだいいが、ほんとに文字どおり腐って行く奴とです。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたら、これはおとっつぁんの子なの、えええ、おとっつぁんの子ですともさ――峰吉は火事以来黙ったまんまだ。",
              "citation": {
                "source": "舞馬",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、おとっつぁん」お八重がいう。",
              "citation": {
                "source": "舞馬",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "口惜しかないけど――おとっつぁんもあんまりじゃないか。",
              "citation": {
                "source": "舞馬",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おとっつぁんが殺したんだろう？",
              "citation": {
                "source": "舞馬",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "火をつけたのもおとっつぁんだろう？",
              "citation": {
                "source": "舞馬",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ、おとっつぁんが殺したんだ。",
              "citation": {
                "source": "舞馬",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気ちがいっておとっつぁんがかい？",
              "citation": {
                "source": "美しい村",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりのこどもたちも、おなかがすいて、よく寝つけませんでしたから、まま母が、おとっつぁんにむかっていっていることを、そっくりきいていました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとっつぁんがそこでいいました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なあに、おとっつぁん。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "森のまん中ごろまで来たとき、おとっつぁんはいいました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとっつぁん、たき火をしてやろうよ。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、そのあいだも、しじゅう木をきるおのの音がしていましたから、おとっつぁんは、すぐと近くでしごとをしていることとばかりおもっていました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、それはおのの音ではなくて、おとっつぁんが一本の枯れ木に、枝をいわいつけておいたのが、風でゆすられて、あっちへぶつかり、こっちへぶつかりしていたのです。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとばんじゅうあるきどおしにあるいて、もう夜のしらしら明けに、ふたりはやっとおとっつぁんのうちにかえって来ました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとっつぁんのほうは、でも、ああして子どもたちふたりっきり、おきざりにして来たものの、心配で心配でならなかったところでしたから、よくかえって来たといってよろこびました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "こどもたちがきいていると、夜おそく、寝ながらおっかさんが、おとっつぁんにむかって、「さあ、いよいよなにもかもたべつくしてしまったわ。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おとっつぁんがいいました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　こんなことで、ふたりおとっつぁんの小屋を出てから、もう三日めの朝になりました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてとうとう、遠くの方に、おとっつぁんのこやをみつけました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽんとおへやの中にとびこんで、おとっつぁんの首根っこにかじりつきました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっかさんも、おとっつぁんも、そりゃあ、おまえさんをじいっと見まもっていてくださるな。",
              "citation": {
                "source": "青い玉と銀色のふえ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえのおとっつぁんはりっぱな漁師だったから、どんなときでもけんかなどしなかったがな。",
              "citation": {
                "source": "青い玉と銀色のふえ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもいきなり、『おとっつぁん、セルゲイをゆるしてやって』と、舅にぶつかって行ったものである。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、わしらにゃ恰度子供も出来まッせんけん、なんのおとっつぁん一人くらい……」　人の好い大工は、べつにとりなし顔でもなくそう鷲尾に云った。",
              "citation": {
                "source": "冬枯れ",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
