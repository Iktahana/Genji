[
  {
    "uuid": "8200399b-4f8d-5517-8d5a-b1777d36c4c6",
    "entry": "面変わり",
    "reading": {
      "primary": "おもがわり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
