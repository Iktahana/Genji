[
  {
    "uuid": "82d9f97e-5360-5976-b6b2-cff903907670",
    "entry": "思いつき",
    "reading": {
      "primary": "おもいつき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
