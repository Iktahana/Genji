[
  {
    "uuid": "92c83d69-0d92-56bb-ab8d-1ddf16b9a9ee",
    "entry": "お菜",
    "reading": {
      "primary": "おかず",
      "alternatives": [
        "オカズ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
