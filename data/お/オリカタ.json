        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ただ水の一部分が時折り形を変えて泡になったり、飛沫になったりするだけです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界にはながむるに足るべきあらゆる種類の苔や草や灌木があり、ひもとくに足るべき多くの二折形や三十二折形の書物があるのに、憲法だの民主だの正権だの王政だの共和だのという児戯に類することについて、人々が互いに憎み合うということを、彼は理解することができなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程、竹冷だね」　と三輪さんが枝折形の大きな句碑を読んだ。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
