        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このワークショップでは和紙の折り方を教えます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもたちは先生から丁寧に折り方を習った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "本についている折り方の説明を読みながら作りました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "起臥の、徒然に、水引の結び方、熨斗の折り方、押絵など、中にも唯今の菊細工――人形のつくり方を、見真似に覚えもし、教えもされましたのが、……かく持参のこの手遊品で。",
              "citation": {
                "source": "菊あわせ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして籠のぶら下げ方から、新聞の折り方から、どんなに客に呼びかけるのだということをまで教えてくれた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで漸う前日のことに気がついたのですが、さういへば、湯の浜へくる汽車の中で新聞を読んだときも、やつぱり折目の折り方を気にして、これほどではなかつたのですが、何度もやりなほしてゐたことを思ひだしたのです。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日の夕方になつて、夕刊を読む時になつても、折目の折り方を気にすることは、やつぱり同じことなのです。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "平家に非ずんば人に非ずといった言葉も、むしろ当然のように迎えられたし、六波羅風と言えば、猫も杓子も、右へならえで、烏帽子の折り方やら、着つけの仕方まで、皆が平家一族を真似するのである。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これでてまえの八番てがらは、九分どおりかたづいてござる。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卍のいれずみ",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのような場面のどんなタイミングで抜刀するか、観客たちは文字どおりかたずをのんで見守った。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
