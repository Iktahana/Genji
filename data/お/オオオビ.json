          "literary": [
            {
              "text": "「おれは、大和の日代の宮に天下を治めておいでになる、大帯日子天皇の皇子、名は倭童男王という者だ。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大帯なども、其一つと見られるのである。",
              "citation": {
                "source": "ごろつきの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "針葉喬木林の大帯が山腹を纏うていないことは、幽邃と森厳の気に欠けているように思われて、どうも物足らぬ感を起させる。",
              "citation": {
                "source": "黒部峡谷",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊後国東の海上にある姫島にも大帯八幡の社がある。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
