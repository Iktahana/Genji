        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この会社の業績は、業界全体の好況という追い風を受けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新作映画は話題性の追い風に乗って、興行収入が大きく伸びた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "景気回復の追い風で、採用活動を積極的に行う企業が増えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
    ],
