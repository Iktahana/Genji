  {
    "uuid": "a16b7edf-fdaf-5d58-b9ca-d950ce5eac3c",
    "entry": "遅",
    "reading": {
      "primary": "おそ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「きょうは遅いからいそぐだ」とすこしむずかしい顔をしても子どもは聞き入れそうもしない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "糟谷は、「もう遅いっ」とおちつかないそぶりをことばにまぎらかして外へでた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三｜席勝負してからでかけても遅くはない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は一通り二人の余り遅かったことを咎めて深くは言わなかったけれど、常とは全く違っていた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は山から採ってきた、あけびや野葡萄やを沢山座敷｜中へ並べ立てて、暗に僕がこんな事をして居たから遅くなったのだとの意を示し無言の弁解をやっても何のききめもない。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七日にゆくとしろ……えいか、そのつもりで小支度して置け」　学校へゆくは固より僕の願い、十日や二十日早くとも遅くともそれに仔細はないが、この場合しかも今夜｜言渡があって見ると、二人は既に罪を犯したものと定められての仕置であるから、民子は勿論僕に取ってもすこぶる心苦しい処がある。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "またあの奴民子が居ないから考え込んで居やがると思われるも口惜しく、ようやく心を取直し、母の枕元へいって夜遅くまで学校の話をして聞かせた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへきて民子が明けてもくれてもくよくよして、人の眼にもとまるほどであるから、時々は物忘れをしたり、呼んでも返辞が遅かったりして、母の疳癪にさわったことも度々あった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さても遅くおはします事かな、いつも九時のかねは膳の上にて聞き給ふを。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の部遅き日のつもりて遠き昔かな　蕪村の情緒。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この句もやはり前のと同じく、実景の写生でなくして、心象のイメージに托した咏嘆詩であり、遅き日の積りて遠き昔を思う、蕪村郷愁曲の一つである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "行く春や逡巡として遅桜「逡巡」という漢語を奇警に使って、しかもよく効果を納めている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よもすがら音なき雨や種俵うぐひすや家内｜揃ふて飯時分　春の日の遅い朝飯。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "月天心貧しき町を通りけり　月が天心にかかっているのは、夜が既に遅く更けたのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我を厭ふ隣家寒夜に鍋を鳴らす　霜に更ける冬の夜、遅く更けた燈火の下で書き物などしているのだろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所への人づきあいもせずに、夜遅くまで書物をしていた蕪村。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああした種類の風景は、もはや時代遅れの趣味に属するもので、近代の若い人には感興がない。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も春といつても、山の春は遅いから、伊香保で春といへば五月か六月であらう。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう時、妻はわざわざ私の所へやって来て、『遅くなりますから、お先へ休ませて戴きます』と言う、丁寧に三つ指をついてお辞儀をし、それから自分の寝床へ入る。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵殻もどきの貴公子の微笑と　　　　　遅鈍な子供の白血球とは、　　　　　それな獣を怖がらす。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "良心は遅かれ早かれ、磨滅する性質のものだ。",
              "citation": {
                "source": "夭折した富永",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白さが限界に達すること遅ければ遅いだけ芸術家は豊富である。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "遅れて来て途中から聞いた者は尚更さうであつた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "来診を報知らせる電鈴がその時鳴つた、「夜遅く………」と唸きながら父は立つて行つた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシックはテンポが遅いどころか、「ああした深いことをもう云つてのけたのか」と、君が若しミュジックなるものの存在に耳を触れるに相応しければ当然感ずる次第なのであつたかも知れない。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が認められること余りに遅かつたのは、広告不充分のためであらうか。",
              "citation": {
                "source": "宮沢賢治全集",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "認められること余まりに遅かつたためには、もつと作品の実質に関係ある、謂はば有機的理由ありとする人々があるであらうが、恐らくそれは間違つてゐる。",
              "citation": {
                "source": "宮沢賢治全集",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白さが、その限界に達すること遅ければ遅いだけ、芸術家は豊富である。",
              "citation": {
                "source": "宮沢賢治の世界",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち詩は、發表することのいよいよ早くして、理解されることのいよいよ遲きを普通とする。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくこの詩集は、あまりに長く出版を遲れすぎた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
