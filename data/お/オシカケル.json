        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人気アイドルのコンサート会場に、数千人のファンが押しかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "セール初日の朝、開店前のデパートに大勢の客が押しかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "話題のレストランには、連日多くの客が押しかけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
