          "literary": [
            {
              "text": "私は、オラガビイルを一本、Ｈに買わせた。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、オラガビイルは、二十五銭であった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい切支丹のお祭の方法はオラガ村の祖先伝来のやり方と違う。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "オラガ村の方のが正統派で、新しいやり方に改めた者はインチキだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖先伝来の正統な教えを忠実にまもっているのはこのオラガ村だぞ、と云って、威張り返って、今日に至っても、てんでローマ法王のカトリックを相手にしない部落がタクサンある。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか浦上の一部にもオラガ村の先祖伝来の正統を主張してホンモノのパッパ様（法王）のカトリックをてんで受けつけない部落があったようだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ頃にまた薩州の方ではオラガトトハ三八二十四と、頬白が啼いていたということである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
