    "definitions": [
      {
        "index": 1,
        "gloss": "smelling of men",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "練習終わりの部室は汗が染み付いていて、すごく男臭い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "トラック運転手の彼から漂う、どこか男臭い煙草の匂いに懐かしさを覚えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古い倉庫に入ると、埃とオイルが混ざった男臭い空気が充満していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "がらりと障子を開けて、御客様の蒲団や、掻巻や、男臭い御｜寝衣などを縁へ乾しました。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "がらりと障子を開けて、御客様の蒲団や、掻巻や、男臭い御寝衣などを縁へ乾しました。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、妾は、心から嫌いなのだから――堪らない、男臭い臭、下品な物のいい方、卑しい眼付――）　と、思った時「喜平、駕がある。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、私がぼんやり感じますところでは、男の人で三十年配の独身者は、大抵、何かしらひどく男臭いもので、それを消すために多少香水を使ったとて、いけないわけはありませんでしょう。",
              "citation": {
                "source": "食慾",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり二段目へ突き出しても、柄だけは恥かしくなからうといふ代物で」「そんなのが頑張つて居たら、小夜菊は稼業になるまい」「男に飽々して、男臭いのは側へも寄せ度くないといふ師匠です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "用心棒",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の方に近い六疊、其處には書生兼内弟子で、藥箱持ちを兼ねた、三十男の和助といふのと住んでゐるさうで、男臭い部屋の中は、いぶせきばかりに取亂してあり、代脈の新六は喜三郎の子分に監視されて、神妙に差控へてをります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "三つの死",
                "note": "青空文庫"
              }
            },
            {
              "text": "「臭いっ、男臭いっ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからともなく、熱い男臭い、溜息の波がつたわる。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "情景のひとこまひとこまが、よしんば教養のニュアンスで複雑にされ、情趣で色どられているにしろ、社会で生きる男と女としてはこれまでの男くさい勝手をつらぬいて、むしろその弁護にだけ役立てられる教養というものに、伸子は唾棄を感じた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「男くさい、男くさい。",
              "citation": {
                "source": "男ぎらい",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "陰湿な不潔さ、そこからも男くさい臭いが発散してきます。",
              "citation": {
                "source": "男ぎらい",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかすかな音に、ぼんやり耳をかしていますと、あの男くさい家も、空気もだんだん遠くへ退いてゆくようで、気持ちも落着いてきました。",
              "citation": {
                "source": "男ぎらい",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "男くさい厭らしい穢ならしいところへは、断じて帰りません。",
              "citation": {
                "source": "男ぎらい",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘は隣室の合唱にもめげず手風琴の伴奏に合わせて、だいぶ嗄れたコントラルトで、何やら下男くさい歌をうたっていた……「いや、もうたくさん！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝乱した、男くさいベッドのそばをすりぬけて窓のそばへ行くと、天狗の羽団扇のような栃の葉繁みのむこうの湖水に船が四、五隻も出て、なにかただならぬ騒ぎをしているのが見えた。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
