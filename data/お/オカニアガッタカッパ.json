          "standard": [
            {
              "text": "都会育ちの彼は農村に赴任すると、まさに陸に上がった河童のように戸惑っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "パソコンを持たずにIT企業に転職した彼女は、陸に上がった河童状態だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「海外の会議では英語が話せなくて、陸に上がった河童みたいでしたよ」と彼は苦笑した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "終戦直後、雨後の筍に似て立ち並び始めたバラック飲食店の場銭と、強請とで酒と小遣に不自由しなかった習慣は一朝にして脱することが出来ず、飲食店の閉鎖、恐喝行為の強力な取締りと、組の解体は彼等を陸に上がった河童にした。",
              "citation": {
                "source": "刺青",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            }
          ]
