        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ジェーエ、オーオ、エーエ、ケーエイッと妙に押しつけて、そして無理に西洋人らしくこしらえた声でどなるのがどういうものかあまりいい心持ちがしない。",
              "citation": {
                "source": "路傍の草",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈良原到少年の腸は、武部先生の「行くぞオーオ」を聞いて以来、死ぬが死ぬまで腐らなかった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（下）　月明の霜朝に、自分等に代って断頭場に向った大先輩、武部小四郎先生の壮烈を極めた大音声、「行くぞオーオ」　を聞いて以来、奈良原到少年の腸は死ぬが死ぬまで腐らなかった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホオーオ、勝えの健なんて十錢も貰つてるど、石だつてよ。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレ、先生におくれるな」「なにも獲物のねえやつは、かまわねえから、相手の咽喉ッ首へくらいついてやれ」「オイ、八百屋の初さん、そんなおめえ、天秤棒などかつぎだして、どうしようってんだ」「なあにね、これで相手の脛をかっさらってやりまさあ」「オーオー、糊屋の婆さん、戦場に婆さんは足手まといだ。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しやな、オーオーオー」　寄せ手の勢たちは凱歌をあげた。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このとき、かなたの森の方で、オーオというおおかみの鳴き声を聞きました。",
              "citation": {
                "source": "おおかみと人",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも暗闇に躱れてオーオーと啼く。",
              "citation": {
                "source": "明日",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンセントのオーオーと犬のほえるような泣声だけが残る）ゴー　（びっくりして見ていたが）どうしたんだ？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
