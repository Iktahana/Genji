[
  {
    "uuid": "f70866a4-c39b-56a7-a65b-8c6e247ad25f",
    "entry": "大づかみ",
    "reading": {
      "primary": "おおづかみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
