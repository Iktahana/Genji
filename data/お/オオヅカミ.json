        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "畑で収穫したばかりの野菜を大づかみにして、籠に次々と放り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "焚き火の中に、乾燥した枝を大づかみにして投げ入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "砂遊びをしていた子供が、砂を大づかみにして山を作っている。",
              "citation": {
