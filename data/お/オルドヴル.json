        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五百円のを取ると、オルドヴルから、ポタージュ。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルからとてもうまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "内田百間の「冥途」を読んでると、コン／＼カーンと食事を報せる音が響いた、オルドヴル、ポタジュ、車海老フライ、鶏とヌードル、うまい、たゞこれだけで来てゐるのだからな。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャビヤがあり、オルドヴルとスープに肉と飯の一皿、物が高くなった、そんなことで十円以上になる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "八時半食堂へ、流石此処のはうまい、オルドヴルからアントレー二皿その他色々コーヒー迄一と通りコースを辿ったが何となく堪能しなかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉は無し、オルドヴルにスープ、スクラムルエッグ、アイリッシュ・シチュウ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "煮こゞりの出るオルドヴル。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛込――田原屋のオルドヴル。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "下のグリルで、オルドヴルとポタージュにハムエッグス、紅茶に菓子で三円半、チップ共四円かゝる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都のアラスカも中々うまい、オルドヴルうまし、ポタージュに、鴨とスパゲティ、ティムボールドリアン等。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スープはポタージュ、犢の骨つき、キャビアのオルドヴル。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニュウグランドで母上とオルドヴルにポタアジュ、卵と魚の飯と、アスパラガス、プディング、うまいが高し、二人で八円。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルとオニオングラタンとビーフピカタ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリルで、オルドヴルとオニオングラタン、コールドラブスターを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューグランドへ行き、オルドヴルとポタアジュ（これがとても美味かった）犢脚の煮込、スパゲティ附。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "逢はうと思ってた森岩雄も発熱して帰っちまったので、すっかりあぶれ、ホテルのニューグリルで一人で食事、オルドヴルに、オニオングラタン、雛のココット、こいつはうまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルに、ポタアジュ――これは相不変不味し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アテチョクなんかの出る豪華オルドヴルに、マロボントースト、ポタアジュに小さい魚肉フライの入ったもの、で満腹しちまふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "チアコンソメとオルドヴル、ミニツステーキを食って座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルと、ヅペパバ何とか――といふスープをのんだら、すっかり満腹しちまひ、白いスパゲチ少々食ひ、マスクメロンとアイスクリームでちょん。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラタンとオルドヴルで満腹。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルに、ポタアジュ、舌平目洋酒蒸。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "憂鬱になり、ホテルニューグリルで、オニオングラタンに、オルドヴル、コールビーフで食事し座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝのオルドヴルは二円とるが、まづくない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、オニグラ、舌平目その他。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ミネストロンと犢の白ソース煮。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "お粗末なオルドヴルに、クリームスープ、ハンバクステーキにコーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルとオニオングラタン、舌平目の洋酒煮に、クラブハウスサンドイッチ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、オニグラ、舌平目にクラブハウス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、チキンスープ、平目のグラタン、クラブハウス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
