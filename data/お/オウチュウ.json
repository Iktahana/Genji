        "examples": {
          "standard": [
            {
              "text": "この公園では烏秋がよく見かけられます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "烏秋の尾羽が長く揺れています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "野鳥図鑑で烏秋について調べました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "梅雨ぐもり影にのみ、※たけて、低くのみ烏秋の飛びたわむと。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜子（西瓜のたね）　烏秋（台湾烏）　　赤嵌楼（蘭人の所謂プロヒレンチヤ城なり）蕃童蕃童は※仔を射る。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜子（西瓜のたね）烏秋（臺灣烏）赤嵌樓（蘭人の所謂プロヒレンチヤ城なり）鴛鴦飛ぶ禽としも、幽かだに思ひかけずておろかさよ、こずゑの雪に鴛鴦のたつる羽音を觀しや君。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
