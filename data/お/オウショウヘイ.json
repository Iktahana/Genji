        "examples": {
          "standard": [
            {
              "text": "歴史の記録には、応召兵が故郷を離れて戦った悲劇が綴られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "多くの応召兵は、十分な訓練を受けることなく戦地に送られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "戦時中、村の若者たちは皆、応召兵として召集された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "早くから起きて松原を散歩する、朝の海はことによろしい、同道して、七時の汽車で徳山へ、昨日も今日も応召兵見送でどの駅も混雑してゐる、涙ぐましい風景である。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
