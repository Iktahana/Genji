          "literary": [
            {
              "text": "私の長一はオサカズと読むのが本当で、子供の時私はそう呼ばれた。",
              "citation": {
                "source": "随筆銭形平次",
                "author": "ペンネーム由来記",
                "note": "青空文庫"
              }
            },
            {
              "text": "長四郎の長男で長一は、あまり知恵のある命名でないが、父親は、これをオサカズと読ませた。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷里の村へ帰れば、オサカズと呼んでくれる老友が今でも幾人かは、残っているはずである。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、野村オサカズの方は、何時の間にやら、チョウイチになった。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
