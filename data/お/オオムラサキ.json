      {
        "index": 1,
        "gloss": "giant purple butterfly (species of nymphalid butterfly, Sasakia charonda)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏の花畑に大紫が舞っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大紫は日本の蝶の中でも最大級の大きさだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "採集家たちは大紫を求めて山奥へ入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "蓋の裏に列記せられたる女王の名は「花せゝり」「黄まだら」「日陰蝶」「蛇の目」「豹文」「緋威」「黄べり立て羽」「揚羽」「一文字」「山黄蝶」「日光白蝶」「大紫」「山女郎」などで、其中で価の貴いのは大紫、可愛らしいのは山黄蝶であらう。",
              "citation": {
                "source": "蝶",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "石川麻呂のすぐの弟・日向は、兄をおとし入れた報いで中央を追はれるし、次の弟・蓮子は平々凡々、ただ温厚なだけの人柄を見こまれて、鎌足の下にしばらく大臣をつとめ大紫冠をいただいたが、これも三年ほど前にぽつくり死んでしまつた。",
              "citation": {
                "source": "鸚鵡",
                "author": "『白鳳』第二部",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "Rhododendron oomurasaki (species of purple azalea)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
