          "literary": [
            {
              "text": "オネコサンハ、アヒルサンノ赤イ洋服ガウラヤマシクテナラナカツタノデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼトイヘバ、オネコサンハ赤イモノナラ、ドンナモノデモ大スキダカラデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トオネコサンハアカダラケノ洋服ヲダシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オネコサンハ似合ヒモシナイ洋服ヲキテ得意デスシ、アヒルサンハアカダラケノクサイ洋服ヲキテ大ヨロコビナノデ、誰デモ二人ヲミルト、ワラツタリ、ハナヲツマンダリシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ケレド、アヒルサントオネコサンハ心ノナカデイヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
