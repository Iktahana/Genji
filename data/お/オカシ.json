        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "デパートの地下でおいしそうなお菓子を買ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "3時のおやつに甘いお菓子をつまむのが習慣だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供たちがお菓子を囲んで楽しそうに笑っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "勿論それは余りお菓子の欲しくない人が駄菓子の方が寧ろ美味い、といふ時のやうなふうにして発生した通念と見えるが、それにしても、一応の由来はあると思へるので、一寸その事に就いて云つてみれば、　西洋人の方が、我々よりも尠くも形の上では楽天的である、従つて即興的であるよりも構成を怡しむ習性を一層持つてゐる。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……お菓子……」――今行つた弟が母に言つたのだ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "お菓子を、あげますから」と言つて、せんべい一枚をヒユウと向ふの畑地へ投げてやります。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚のびっくりするような大きいチョコレート菓子可愛ゆい麦粉菓子のヒヨコ、馬鈴薯が本物かと思ったらやっぱり何かを練ってつくったお菓子なのです。",
              "citation": {
                "source": "伯林の降誕祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お菓子をもらふより先きに太郎はマヽを見ます。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニは、ちょっと喰べてみて、（なんだ、やっぱりこいつはお菓子だ〔。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもぼくは、このひとをばかにしながら、この人のお菓子をたべてゐるのは、大へん気の毒だ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞのお菓子でせう。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "苹果だってお菓子〔〕だってかすが少しもありませんからみんなそのひとそのひとによってちがったわづかのいゝかほりになって毛あなからちらけてしまふのです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "用心口を鎖してお寢間へ戻り給ひしが再度立つてお菓子戸棚のびすけつとの瓶とり出し、お鼻紙の上へ明けて押ひねり、雪灯を片手に縁へ出れば天井の鼠がた／＼と荒れて、鼬にても入りしかきゝといふ聲もの凄し。",
              "citation": {
                "source": "われから",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへまた今云つた聖人の名だとか、お菓子の名だとか、僕達がそれに相應した心像を持つてゐない名が二つ三つ行列してはひつて來るともう駄目で、到底一度では意味の通らない文章になつてしまふ。",
              "citation": {
                "source": "「親近」と「拒絶」",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お菓子、おもちゃ、帽子、三輪車――この頃は田舎でも三輪車が流行っている。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニは、ちょっと喰べてみて、（なんだ、やっぱりこいつはお菓子だ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもぼくは、このひとをばかにしながら、この人のお菓子をたべているのは、大へん気の毒だ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただのお菓子でしょう。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "苹果だってお菓子だってかすが少しもありませんからみんなそのひとそのひとによってちがったわずかのいいかおりになって毛あなからちらけてしまうのです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいそう古くなったお菓子を黄色いリボンで縛ったのが一箱あって、これもつるすのだといって、樅の木へほかの飾り物といっしょにつるしました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは十四年前におばあさんが買ったお菓子だということでした。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして食後にあたたかいプンシュを飲んで、お菓子をかじりました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある主婦が盗み食いをする下女を懲らすためにお菓子の中へ吐剤を入れておいた話も聞きました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "追っ払ってくれ、手荒くすると喰いつくぜ、お菓子でもやって」　れいの軟弱外交である。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "芹川さんのお家は、私の家の、すぐ向いで、ご存じでしょうかしら、華月堂というお菓子屋がございましたでしょう、ええ、いまでも昔のまま繁昌して居ります、いざよい最中といって、栗のはいった餡の最中を、昔から自慢にいたして売って居ります。",
              "citation": {
                "source": "誰も知らぬ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女学校を出てからも、兄さんは、一週間にいちどくらいは、何かと注文のお菓子をとどけに、私の家へまいっていまして、私も気易く兄さん、兄さんとお呼びしていました。",
              "citation": {
                "source": "誰も知らぬ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お菓子をいただいて玄関先で失礼した。",
              "citation": {
                "source": "十二月八日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニは、ちょっとたべてみて、（なんだ、やっぱりこいつはお菓子だ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもぼくは、このひとをばかにしながら、この人のお菓子をたべているのは、たいへんきのどくだ）とおもいながら、やっぱりぽくぽくそれをたべていました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただのお菓子でしょう」やっぱりおなじことを考えていたとみえて、カムパネルラが、思い切ったというように、尋ねました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "苹果だってお菓子だって、かすが少しもありませんから、みんなそのひとそのひとによってちがった、わずかのいいかおりになって毛あなからちらけてしまうのです」　にわかに男の子がばっちり眼をあいて言いました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザラメがみんな、ふわふわのお菓子になるねえ、だから火がよく燃えればいいんだよ。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからお母さんへは毎日お菓子やなんか沢山あげるんだ。",
              "citation": {
                "source": "いてふの実",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
