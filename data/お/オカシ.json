  {
    "uuid": "47c7277a-3b5f-533f-a09c-95a0cf28ff63",
    "entry": "オカシ",
    "reading": {
      "primary": "おかし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヨハオカシヤンセ」と七節に分けて考えることができる。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物、ハダカヲ包メバ、ソレデイイ、柄モ、布地モ、色合イモ、ミンナ意味ナイ、二十五歳ノ男児、一夜、真紅ノ花模様、シカモチリメンノ袷着テ、スベテ着物ニカワリナシ、何ガオカシイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "謝源も、これを聞いた家来の一部のものも、あまりのオカシさに笑ひこけてしまつた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンハ　ミチコサンヲ　ミルト、「ナニヲ　ソンナ　オカシナ　テツキ　シテルノ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシイナ……オカシイ……。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシ子が駄々をこねて、単身で佐賀へ行きかけたのは、どうも少々オカシイと思ったが……そこいらの消息を薄々感付いたんだナ」「ウン。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫌な気持やオカシナ所業を。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……オカシイナ……ツイ胴忘れしちゃってチョット思い出せないんですが。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の紳士はたしかに人形だった……ハテナ……オカシイゾ……。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテカラ二人ノ様子ガオカシイト感ジテ居リマシタカラ、其ノ時何トナク気ニナリマシタノデ暫ク経テカラ私モ便所ニ行ッテクルカラト申シテ室外ニ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレモ　ユリコサン　ニアケマス　オトウサマカ　ナニヲシテ　イマスカ　オカアサマニ　オキキナサイ　オカシイデショウ　　　〇六・三・二六」　ロンドンから母宛に来た手紙の中に封じこめられたものであったのでしょう。",
              "citation": {
                "source": "写真に添えて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは泣き走る男の子を「オカシイネェ」などと笑って見ていたが、その顔はしだいに暗くなってきた。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モンコチヤン、チツトモオカシクナイカラボンコヲカブリナサイ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハボンコチヤンデイヤイヤモンコチヤンニカブサリマシタカラ、ソレハソレハオカシクミエマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハ、オカシクナツテ「アラ、マア、何テヘンナオ子サンダラウ、マルデ、カツパノオバケミタイダワ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マハリノ人ハトテモオカシカツタノデスケレド、ヤツトガマンシテワラヒマセンデシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "文明とは餘程オカシナ熟字であります。",
              "citation": {
                "source": "支那人心の新傾向",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "で是れはオカシナ點だけを今申したのでありまして、此中に今まで申し上げました外に隨分公羊學の惡いこともあるのでありますが、又一方左傳必ずしも孔子の眞意を傳へたものとは言はれません。",
              "citation": {
                "source": "支那人心の新傾向",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "古来どんな人でも一向にこの点に気がつかず、その間違いを説破した者が一人もないとはどうしたもんだ、オカシナ話である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシイ、何んだろうと注意して見るとそれはその枝から下っている花の穂から出て来る黄色い花粉なんだ。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしまことに残念に感ずることは、私のような学風と、また私のような天才（自分にそう言うのはオカシイけれど）とは、私の死とともに消滅してふたたび同じ型の人を得る事は恐らく出来ないという事です。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第二部　混混録",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったくイキモノはホントに愛し合うとお互いに、なんとオカシな事をし合うのでしょう！",
              "citation": {
                "source": "殺意（ストリップショウ）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシラつきの魚を持ち出して来る料理人と同じ勇気がね。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな、人を數人も斬つた事のある大の男が、こんなオカシな、夢のような、ミジメな搜し物をするというのは！",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "…………　　　　　　　　33　それにしても、なんと言うオカシナ事を僕は始めたものであろう。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（翁に話候えば評していわく、オカシイ事ばかりする男といった）。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ「オヤ、オカシイナ、ソツチノミミモ立テナサイ」トイヒマシタケレドモ、ウサギハシランカオシテヰマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
