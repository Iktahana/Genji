        "examples": {
          "standard": [
            {
              "text": "大口顧客との契約が取れたおかげで、今期の売上目標を大幅に上回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "担当営業が大口顧客の対応を優先するため、中小クライアントへの連絡が後回しになりがちだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長年の大口顧客が競合他社に乗り換えると聞き、部長は即座に訪問して引き留めに動いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "かつてはゼロックスの独壇場だった普通紙複写機の領域に独自の技術で乗り込んでいった日本のメーカーも、マイクロコンピューターの大口顧客となってくれた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
