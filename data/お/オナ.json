        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "レオナルド・ダ・ヴィンチが画を描く時に隣室で音楽を奏でさせたという話があるが、これももちろんただ音楽の雰囲気だけを要求したものに相違ない。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、月｜給の上る見込みもなかつたし、ボオナスも減るばかりの上に、質屋や近しい友｜達からの融通もさうさうきりなしとは行かなかつた。",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "影と並木のだんだらを、　　　　犬レオナルド足織れば、売り酒のみて熊之進、　　　　　赤眼に店をばあくるなり。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、レオナルド・ダ・ヴィンチよ来れ。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして着物をほころばせたり向こう脛をすりむいては家へ帰ってオナン（おふくろの方言）にしかられていたようである。",
              "citation": {
                "source": "相撲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「レオナルド・ダ・ヴィンチが現代に生まれていたら、彼は映画に手を着けたであろう」とだれかが言っているのは真に所由のあることと思われる。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナルド・ダ・ヴィンチが今、生きていれば、彼もまたコードを書いているだろう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "フイレンツエの博物館に、レオナルドオ・ダ・ヰンチが畫きたるメヅウザ（おそろしき女神）の頭あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲の主人公はレオナルドオ・ダ・ヰンチなりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナルドオの住みしは此地なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親は木工場からもらつたボオナスが少し多かつたので、お歳暮をきばつたのだつたが、若い時分から馬気違ひなので、競馬好きの木山とうまが合つてゐた。",
              "citation": {
                "source": "のらもの",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴代は父のボオナスを当てにする訳ではなかつたけれど、長いあひだの犠牲を考へると、今夜のやうな場合、少しくらゐ用立ててもらつてもいゝと思つたので、戸締りをして家を出たが、途中で罪のない木山を思ひ出して、独りで微笑んでゐた。",
              "citation": {
                "source": "のらもの",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "オナラチャズケ、ウジリョウリとひねった看板が見えるじゃねえか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚だ不倫な言ひざまで恐縮の極であるが、わたくしはレオナルドオのモナ・リザよりは寧ろ其サン・ジエロニモの画を愛する。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナルドオのあの鋭くして柔軟な素描を残したジエロニモこそ世にもこよない物である。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はその時リオナルドオ・ダア・ヰンチのかいたモンナ・リザの画を思い出した。",
              "citation": {
                "source": "心中",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この書の主人公レオナドダヴィンチの独身生活が今さらのごとく懐かしくなった。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもじッと読みつづけていると、新らしい事件は出て来ないで、レオナドと吉弥とが僕の心をかわるがわる通過する。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が家庭の面倒や、女の関係や、またそういうことに附随して来るさまざまの苦痛と疲労とを考えれば、いッそのこと、レオナドのように、独身で、高潔に通した方が幸福であったかと、何となく懐かしいような気がする。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の神経はレオナドの神経より五倍も十倍も過敏になっているだろう。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先駆者」を手から落したら、レオナドはいなくなったが、吉弥ばかりはまだ僕を去らない。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "勉強をする時間が出来たわけだが、目的の脚本は少しも筆が取れないで、かえって読み終ったメレジコウスキの小説を縮小して、新情想を包んだ一大古典家、レオナドダヴィンチの高潔にしてしかも恨み多き生涯を紹介的に書き初めた。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "持ち帰った包みの中からは、厳粛な顔つきでレオナドがのぞいている。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナドの生涯は実に高潔にして、悲惨である。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "革鞄をあけて、中の書物や書きかけの原稿などを調べながら、つくづく思うと、この夏中の仕事は――いろんな考えを持って行ったのだが――ただレオナドの紹介ばかりが出来たに過ぎない。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "同道して鏡子居を驚かす、鏡子君はオナゴヤの主人であるがおもしろい人である、酒、ビール、サイダー、蕎麦。",
              "citation": {
                "source": "行乞記",
                "author": "北九州行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナルド、ダ、食ひ散らした水蜜桃の核子やら皮やらを、一纏めに新聞に包んで、窓の外へ抛げ出した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナルド、ダ、※ンチと云ふ名を聞いて少しく辟易した上に、何だか昨夕の女の事を考へ出して、妙に不愉快になつたから、謹しんで黙つて仕舞つた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
