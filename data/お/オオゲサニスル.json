          "standard": [
            {
              "text": "彼は小さな出来事でも、すぐに大げさにする癖がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "マスコミは、事件をセンセーショナルに大げさにする傾向がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は自分の痛みを大げさにすることで、周りの気を引こうとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "せいぜい、なにか非常な出来事――なにかすばらしい報酬など――で励まされると、自分たちの方針は変えないで、ただもとのやり方を拡張し、また大げさにする。",
              "citation": {
                "source": "盗まれた手紙",
                "author": "THE PURLOINED LETTER",
                "note": "青空文庫"
              }
            }
          ]
