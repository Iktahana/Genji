[
  {
    "uuid": "019e4770-7c61-5f96-982d-bdd59d11a159",
    "entry": "虎魚",
    "reading": {
      "primary": "オコゼ",
      "alternatives": [
        "おこぜ"
      ],
      "is_heteronym": false
    },
    "grammar": {
