        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お正月においしいおかちんをついて、家族みんなで食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「おかちんが焼けたよ」とおばあちゃんが縁側から呼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子どもの頃、神社のお祭りでおかちんをもらうのが楽しみだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "配膳室の箱の中に、今朝中にもって来た「おかちん」がまっ白い体をよこたえて居る。",
              "citation": {
                "source": "午後",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかちんでも焼きませうか。",
              "citation": {
                "source": "雅俗貧困譜",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "なる子　　さ、おかちんをあげるから、あつちへ行つておあがり。",
              "citation": {
                "source": "雅俗貧困譜",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "なる子　　おかちんが固くなりますよ。",
              "citation": {
                "source": "雅俗貧困譜",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだろくに歯もかたまらない宅の子供に正月のおかちんの揚げたのなんか食べさせるのは、何処の家でせうね。",
              "citation": {
                "source": "犬は鎖に繋ぐべからず",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
