        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お宅は結局、どうするつもりですか？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "昨日はお宅に連絡したのですが、繋がらず困りました。",
