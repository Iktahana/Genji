        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「アハハハハハハハハハ……」「オホホホホホホホホ……」　という笑い声が、お局じゅうに流れ漂うた。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前みたいな人間には生れない前から御無沙汰つづきなんだぞ……テンデ……」「オホホホホホホホ……」　女将の嬌笑が暗い部屋に響き渡った。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "管を巻くわよ今夜は……オホホホホホホ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホホホホホホ」　とおかめがこれを見て笑い出しました。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホホホホホホ……あたしの思いが、おわかりになって……」",
              "citation": {
                "source": "縊死体",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホホホホホホ、ハハハハハハハ。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハハハハ」「オホホホホホホ」「ウフフフフフフ」　泥棒は夢中になって逃げ出すと、すぐに通りがかりの巡査さんに捕まりました。",
              "citation": {
                "source": "雪子さんの泥棒よけ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう遅いわよ……諦らめて寝ていらっしゃいオホホホホホホホ」　錐で揉むような痛みを感じて私は又頭を枕に落ち付けた。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ……そんな事でしたの……そんならそうと早くおっしゃればいいのに……オホホホホホホ。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "失礼ですがあなたは……」「あの……あなたは……失礼ですけど……愛太郎さんでいらっしゃいますか……」「ハイ……児島愛太郎です……あなたは……」「……オホホホホホホホホ……」　……受話機のかかる音がした。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーイオーイオーイオーイ……」　といくら呼んでも頑強にベルを鳴らしていたが、やがてピタリと震動が止むと、「オホホホホホホホホ」　という笑い声が、真っ先きに聞えた。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし……何の用ですか……」「オホホホホホホホホホ」　私は表の扉の閂を外すと又二階に上って、あたたかい夜具にもぐり込んだ。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホホホホホホホ」「……………」　　　　　　　×　　　　　　　　　　×　　　　　　　　　　×　彼女は私を一気に、空想の世界から現実の世界へ引っぱり出してしまった。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハハハハ……」「オホホホホホホホホホ」「まあ、そう云わっしゃるな。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホホホホホ……オホホホホホホ……私が誰だか、おわかりになりまして……？",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……校長先生……殿宮さん……川村さん……火星の女ですよ……オホホホホホホホホ……イヒヒヒヒヒヒヒヒ……アハハハハハハハハ……」　校長先生は眼の玉を白くして、舌をダラリと垂らしたまま、大地震に会った仏像のように、仰向け様にドターンと引っくり返ってお終いになりました。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、正式に袈裟法衣をつけて、侍者を従え、ユラリと演壇へのぼって、むんずと坐を組み、「オホホホホホホ」と面に似気ない愛嬌笑いを試みた時に、霞のように棚曳いていた細い眉と目が、一時にドヨみ渡りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女はハッとしたように眼を上げ、少時黙っていたが、急に捨てばちになり、「御用聴きの若衆さんで――、それや迚も奇麗な男でしたわ、オホホホホホホ」とヒステリックな声で笑った。",
              "citation": {
                "source": "美人鷹匠",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オホホホホホホ。",
              "citation": {
                "source": "情鬼",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オホホホホホホ、私も苦労しましたお蔭で大変強くなりましたのよ、そういつもいつも泣いてばかりいませんのよ、泣きたいことや口惜しいことたんとたんとありますけど、もうもう考えないことにして、できるだけ朗かに暮らす決心しましたの。",
              "citation": {
                "source": "猫と庄造と二人のおんな",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホホホホホホホ」　と娘は面白そうに、笑い出しました。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテガミクダサラナイノデ……ワタクシタチ……マイニチシンパイシテオリマス……ドウナサツタノ……デスカ……」と判じ判じ読んで、オホホホホホホホと、母は笑い出しました。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡くなりましたもんですから、帰ってまいりましたら自分の故国でもなんだかまるで、よその国へでも行ったような気がいたしましてオホホホホホホ」　とこの亜米利加帰りの外務次官の令嬢も、伯爵夫人に負けず劣らず、流暢の弁を奮う。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
