        "examples": {
          "standard": [
            {
              "text": "戦国時代の鬼武者たちは、次々と敵陣に突撃していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "あの大坂城の兵士たちは、まさに鬼武者のように勇敢に戦った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "映画の主人公は、鬼武者のように敵将に立ち向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "▲野球界の鬼武者　抑も早慶両大学が戟を交ゆるに至つた径路を語るには、第一にその径路と、当時両校を囲繞した四辺の空気を説明しなければならぬ。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            },
            {
              "text": "人夫たちは、ふるえあがって、「ちんばの鬼武者が見ているぞ」　と、働き出した。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "人夫達から日頃、憎悪の的になっているちんばの鬼武者黒田官兵衛は、すこし離れた所に、竹の杖をついて立っている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
