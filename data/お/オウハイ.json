        "examples": {
          "standard": [
            {
              "text": "女王の夫である王配は、公務を精力的にこなした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "王配殿下は、国内外の様々なチャリティイベントに参加されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史上、王配が政治に大きな影響力を持った例も少なくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "副王配下の隊も頻々としてピサロ側に寝返った。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はいやおうはいわせねえ」　なにか曰くがありそうである。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "鎌いたち",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
