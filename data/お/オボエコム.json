    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to memorize",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は試験前夜に教科書の公式を丸ごと覚えこんで、翌朝の試験に臨んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "セリフを完全に覚えこむまで、舞台俳優は何百回も繰り返し練習した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子どもたちは替え歌にすることで九九を楽しく覚えこんでいった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "『花』『お日さま』『星』『蝶々』などといふ、麗しいものを覚えこまずに病気のごろつき犬や、不吉な鴉や尻に汚らしい糞を皿のやうに、くつゝけて済ました顔をしてゐる牛共の言葉を覚えこむとは何事だらう。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "と私は妻に、うなづいて心の中で、　――今度は、きつと人間の言葉を覚えこむだらう。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の役でない白でも狂言全体のを覚えこむという狂的な熱心さであったということである。",
              "citation": {
                "source": "松井須磨子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "一緒に住んでゐた兄貴はボートとラグビーとバスケットボールの選手で鱶の如くに睡る健康児童であつたが、之には流石に目を覚して、たうとう祈祷文を半分ぐらゐ否応なく覚えこむ始末であつたが、僕はさういふことを気にかけなかつた。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一緒に住んでいた兄貴はボートとラグビーとバスケットボールの選手で鱶の如くに睡る健康児童であったが、之には流石に目を覚して、とうとう祈祷文を半分ぐらい否応なく覚えこむ始末であったが、僕はそういうことを気にかけなかった。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが金サンは野球というものを全然自分ではしたことがない人だから、こういう人に限って、人の講釈の耳学問や、書物雑誌などに目をさらして、一生ケンメイに理窟で野球を覚えこむ。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "木々彦は学問を好まず、長唄や踊りなどを習ったぐらいで、それも打ちこんで覚えこむほどの根気がない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "父はセエラの髪を撫でて、「私の顔をそらで覚えこむつもりなのかい？",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "間違った先生に教わって間違ったことを覚えこむ生徒が多いのと同じである。",
              "citation": {
                "source": "雲石紀行",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、また考えて見ると、貧乏のお蔭で、いろいろの仕事を次から次へと覚えこむことが出来た。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "健がやっきになって歌いながら踊ってみせても、克子の方では歌だけはおぼえこむが、手の動きや足の運びを受けとることができない。",
              "citation": {
                "source": "赤いステッキ",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
