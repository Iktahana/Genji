[
  {
    "uuid": "393b41e8-950d-5149-828d-f584d0496aa5",
    "entry": "覚えこむ",
    "reading": {
      "primary": "おぼえこむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
