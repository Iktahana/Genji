        "examples": {
          "standard": [
            {
              "text": "オムロンの血圧計は操作が簡単で読み取りやすく、高齢の父でも一人でデータを記録できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "工場の生産ラインにオムロンのセンサーが組み込まれており、異常を検知するたびにアラームが鳴る仕組みになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「このタイマーリレー、オムロン製なら品質は間違いない」と設備担当のエンジニアが言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "一九七五年、キルドールはこのデジタルシステムズにＣＰ／Ｍをライセンスするとともに、インテリジェント端末に使おうと考えたオムロン・オブ・アメリカ社、ネットワーク用のモニタープログラムとして使おうとしたローレンスリバモア研究所と供給契約を結んだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
