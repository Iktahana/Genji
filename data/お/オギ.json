  {
    "uuid": "e44beecd-6169-5f3a-98a6-9b6424d2146a",
    "entry": "オギ",
    "reading": {
      "primary": "おぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
