    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ああ、帰りたや帰りたや、オギヤ　と生れた俺の家！",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "常に赤ちゃんの着る花模様のおべべを着て、でんでん太鼓など振って、その九十歳だか百歳だかの御両親のまわりを這いまわって、オギャアオギャアと叫び、以て親の心を楽しましめたり、とあります。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオギャンのタヒチの女そっくりだ。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――その村からリルケはロダンに宛てて二通の手紙を書いてゐるが、最初の三月二十七日日付のものは、「オオギュスト・ロダン」が漸く出來たので、それを當時巴里に居た彼の妻クララにロダンの許へ屆けさすやうにした、その折の手紙である。",
              "citation": {
                "source": "リルケ書翰（ロダン宛）",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹴ったくそわるいさかい、オギアオギアせえだい泣いてるとこイ、ええ、へっつい直しというて、天びん担いで、へっつい直しが廻ってきよって、事情きくと、そら気の毒やいうて、世話してくれたンが、大和の西大寺のそのへっつい直しの親戚の家やった。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリヤンの夫だつた男は、パラオ本島オギワル村の者だが、（パラオでは女系制度ではあるが、結婚してゐる間は、矢張、妻が夫の家に赴いて住む。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "レンゲというのは独逸人で長くオギワル村に住んでいる宣教師だが、中々教養のある男で、それに相当医薬の道にも通じていたらしい。",
              "citation": {
                "source": "南島譚",
                "author": "※",
                "note": "青空文庫"
              }
            },
            {
              "text": "欣んでオギワルのレンゲの所へ治療を受けに行ったが、病気は少しもよくならず、到頭その村の親戚の家で死んだということであった。",
              "citation": {
                "source": "南島譚",
                "author": "※",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリヤンの夫だった男は、パラオ本島オギワル村の者だが、（パラオでは女系制度ではあるが、結婚している間は、やはり、妻が夫の家に赴いて住む。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "透明色の無限の重ね出をしてゐるゴオギャンに比して、その意味では彼は確かにゴッホ的なところがある。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして遂には、その尻尾を引っこめて、前足を持上げて手の形にして、後足で直立して歩きまわる人間の形……普通の胎児の姿にまで進化してからオギャアと生まれる……という段取りになるので、そうした順序から、これに要する時間までも、万人が万人、殆ど大差ないのが通例になっている。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがオギャーと生れてから後の修養や経験に依って整理淘汰されたものが、その人の性格となり、これが向上洗練されたものが、その人の人格となる。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は不思議にも生まれた時から口がありまして、オギャアオギャアと泣きましたそうで、そのために赤ン坊の泣き声を聞いたことのないこの国の人々は『王様のお城に化け物が生まれた』と大騒ぎを初めました」「まあ、何と馬鹿でしょうね。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オギクボ、西オギクボなどといふ小駅を通過して私達は、大きな沼のあるイノカシラといふ処まで半ば駆歩で到達しました。",
              "citation": {
                "source": "蔭ひなた",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人造人間の発見」「試験管から人間が生れる」「今秋までにはオギャアと産声をあげる」というようなセンセーショナルな標題をかかげているのがあるかと思うと、村木博士と内藤女史との肖像をならべて「これが試験管で出来る赤ちゃんの御両親です」などと書いているのもあった。",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオギャンだの、ディフィだの好きです。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あらまあ、またオギンさんが壊したの。",
              "citation": {
                "source": "什器破壊業事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このハンカチでおさえて、そして医者を呼べ」「あらまあ、オギンさん、怪我をしたの。",
              "citation": {
                "source": "什器破壊業事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "オギャーと産れたその時から夜鷹商売をするものはねえ」「妾は播州赤穂産れ。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カン護婦のバタバタ足音「御安産でございますよ、お嬢様」　○ホンときこえる　オギャー、オギャーというあの声。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはポオル・ゴオギャンである。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはゴオギャンの転生である。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオギヤアンの手紙を読んで見ろ。",
              "citation": {
                "source": "闇中問答",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れてから一昼夜、泣かなかったのでお父さんもお母さんも、産婆さんも、この赤坊は唖ではないかと心配したそうですが、生れてから二十時間たった翌朝の八時頃、元気な声で、オギャーオギャーと産ぶ声をあげたのでみんな愁眉を開いたそうです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
