        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "伊作は古革の大胴亂で幾ら煙草を吸つて見ても名案は出ない。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "大胴を入れる音と、笛を合せるのと、シャギリの音までも手に取るように響いて来たものであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "如法闇夜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいおい、そっちの金棒さん、もう少しずしんと、和らか味のある音を出してくんな……さあ、提灯を、も少し上げたり、上げたり」といって、また一目散に屋台のところまでかけ戻って、「しっかりやってくんな……冗談じゃねえよ、大胴がいけねえ、大胴、もう少し腹を据えてやりねえ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱いだ素袷で持ち重りのする寺箱と大胴巻をグルグル巻きに包んでこれを左わきに抱えこんでいる。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
