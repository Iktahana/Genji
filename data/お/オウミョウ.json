        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "師匠の茶の湯には奥妙なところがあり、何年弟子入りしても底が見えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「剣の奥妙は技にあらず、心の静けさにある」と老剣士は弟子たちに語りかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女の料理には奥妙な味わいがあって、食べるたびに新しい発見があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "どうもマセマチカルの考えの薄い人は中々奥妙の理を急に会得する事が難いよ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "学芸に習れず、奥妙なる宗教に養はれざる平民の趣味には、謡曲は到底応ずることを得ざるなり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "心に油断がなくなり、油断のならない心をもち、ヤと叫べばマと応じる神速機敏、微塵も隙といふもののない緊張を常々身心に秘めてゐれば、動作は自ら静を生じ、静かなること林の如く、自然礼節を生じて茶道小笠原流などの奥妙にも達し、しかも全身電波の如く気魄波打つ鋭利の人材となるのである。",
              "citation": {
                "source": "総理大臣が貰つた手紙の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
