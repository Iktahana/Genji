[
  {
    "uuid": "af0f4dd2-56b9-5906-a282-f43763688e1e",
    "entry": "覚書",
    "reading": {
      "primary": "おぼえがき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
