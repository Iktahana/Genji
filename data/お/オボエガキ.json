        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "両国の外相は首都で会談し、経済協力に関する覚書に署名した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "今回締結された覚書は法的拘束力を持たないが、両国の協力意志を示す重要な文書だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "日本とその国との間で、文化交流促進に関する覚書が交わされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
