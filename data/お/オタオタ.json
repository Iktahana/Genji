        "examples": {
          "standard": [
            {
              "text": "突然の指名に、彼はオタオタして返事もできなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会議で予期せぬ質問をされ、オタオタしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "不慣れな土地でオタオタしていると、親切な人が声をかけてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "うちが労務者管理でオタオタしているうちに、こいつは、この家にいた設営局のシュラーに食いついて、シコタマ貯めこんだという大悪党や」と説明してきかせた。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さん、此処に来てから、あんなに香代ちやんに――仕事も世話になるし、あんなひどい脚気も香代ちやんに治して貰ふし、脚気を治して――（と焦るが、うまく言へない）香代　なにをオタオタ言つてんだよ。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺のほうがオタオタしそうになって、（この野郎！",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
