          "literary": [
            {
              "text": "夜八時から、オソアビアヒム〔国防飛行化学建設後援会〕のクラブのリトクルジョーク、今日はカラが創作的会話をするという日なり。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その点オソアビアヒムともセルプ・イ・モロトとも違う。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、もうオソアビアヒムと、モプルの会員となった。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ・カラヴァーエ※は一九三〇年にオソアビアヒムの文学サークル指導をしていたし、同じ年赤軍の文学サークルの作った戯曲「第一騎兵隊」を完成上演させるために努力した。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
