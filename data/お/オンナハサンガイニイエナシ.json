    "definitions": [
      {
        "index": 1,
        "gloss": "a woman has no home of her own in this world (because she has to obey her parents when she is young, her husband when she gets married, and her children when she is old)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
