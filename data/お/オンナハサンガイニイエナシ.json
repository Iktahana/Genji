        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "結婚式の夜、母が「女は三界に家なしよ」と娘に言い聞かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "実家でも嫁ぎ先でも落ち着かない彼女は「女は三界に家なし」という言葉を思い出していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その古い日記には「女は三界に家なし」と何度も書かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「女は三界に家なし」無限の悲哀を誘うこの現実と、生殺与奪の権利をもった男たち、その父、その良人、その息子からさえ監視されて、貞節に過さなければならなかった女の生涯を眺め合わせたとき、私たちは心から慄然とする。",
              "citation": {
                "source": "貞操について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川時代女は三界に家なしといわれた。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
