    "definitions": [
      {
        "index": 1,
        "gloss": "assumption of a suitable form (by a buddha or bodhisattva)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
