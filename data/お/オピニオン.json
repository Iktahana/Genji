        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "編集長はコラム欄をオピニオンページとして刷新し、多様な書き手の声を載せることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "世論調査の結果に対し、各専門家がそれぞれのオピニオンを紙面で述べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「あなたのオピニオンを聞かせてください」と司会者が会場の聴衆に問いかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "受動的抵抗がなかつたら立派な※畫があつて、極めて重要なインデイアン・オピニオンの特別號はこの世に現れなかつたであらう。",
              "citation": {
                "source": "受動的抵抗の理論と實行",
                "author": "エム・ケー・ガンヂー",
                "note": "青空文庫"
              }
            },
            {
              "text": "インデイアン・オピニオンは、過去十一年間、質實にして謙虚な態度で、我が同國人と南アフリカのために貢獻しようと努力して來たのであつて、この十一年間は、彼等が恐らく一度は通り拔けなければならなかつた最も危急な時代であつた。",
              "citation": {
                "source": "受動的抵抗の理論と實行",
                "author": "エム・ケー・ガンヂー",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ガンヂーが南アフリカで發行してゐた「インデイアン・オピニオン」の記念號（一九一四年）に發表した論文。",
              "citation": {
                "source": "受動的抵抗の理論と實行",
                "author": "エム・ケー・ガンヂー",
                "note": "青空文庫"
              }
            },
            {
              "text": "之はブルジョア社会に於ける政治的支配者の意見乃至意志なのである（オピニオンとは要望を意味する）。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
