  {
    "uuid": "97b6387f-4f40-57ff-ab8c-cc171df655b9",
    "entry": "オガ",
    "reading": {
      "primary": "おが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サルオガセの垂れる針葉樹の間からも、同じように起る。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "根曲り竹も、楊の根も、樅の肌も、はた長くしな垂れるサルオガセも、その柔嫩の手に、一旦は、撫でられぬものはない。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "入って行く床には程よく湿ったオガ屑が撒いてあって柔かく靴底にきしむ。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マネにゆき、ドガにゆき、ゴオガンにゆき、アンドレエエフにゆき、シユトラウス、ボオドレエル、ロオデンバツハの感覚と形式にゆく。",
              "citation": {
                "source": "桐の花とカステラ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "会談中マターファが私をアフィオガと呼んで、ヘンリを仰天させた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と呼ばれていたのだが、アフィオガは王族の称呼である。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オガタマノキは、神道に古く因縁深き木なるが、九州に自生ありというが、その他に大木あるは紀州の社地のみなり。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは或る日、東京の友達（オガワ・カヅオ）へ電報を打つた。",
              "citation": {
                "source": "幽霊の出る宮殿",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも毎日毎日奥の間の障子のかげから顔だけ出して、貴男の来られるのをいつまでも待ち続けている妾を見兼ねたのか、とうとう父は恰度いまからひと月程前、Ｂ町へ毎シュウ草花を買いに行く度に、なんでも大変キキメのある神様へオガンをかけて来る様に約束してくれました。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして何事があったのか父はもうバチが当るからオガンをかけるのはイヤだと言いだして、だから今夜も花だけ買って早く帰って来てしまいました。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝には紗をかぶったように苔が垂れ下り、サルオガセが灰色のかたまりとなってし噛みついていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオガンだの、ディフィだの、好きなのですけれど、重苦しくなる時があります。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポール・ゴオガンのやうに、船がタヒチへでも向つて行つてゐるやうな、一種の堪へ難い待ち遠しさも、私は屋久島に感じ始めてゐるのだ。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "搜査は直ちにロオガン街九十番地の彼の住居に向つて開始せられたが彼は不在で女房が訊問に答へて初めに云ふに、夫は昨夜は晩飯後は外出しなかつたと答へた。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまだ彼の住居に到着せぬうち警察署へ行く途中で中尉はポオラス、ノエップ兩官の手によりロオガン街とフィンレイ街の角で逮捕されたルウフアに會つた。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に仏蘭西の富は年毎に増して行くし、学問芸術に就いてはロダンの彫刻、マスネエの音楽、ポアンカレエの科学、ルノワアル、モネ、セザンヌ、ゴツホ、ゴオガン、マチス等の絵画、※ルハアレンの詩、ベルグソンの哲学、キユウリイ夫妻のラジウム発見に至るまで常に世界文明の先頭に立つて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "国民美術協会主催のフランス現代美術展覧会を見に行った時、五十銭の銀貨を並べ立てて買って来た、ゴオガンの手紙をよみ始む。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の帰ってしまった後、わたしは薄暗い電燈の下に大きいゴオガンの画集をひろげ、一枚ずつタイテイの画を眺めて行った。",
              "citation": {
                "source": "夢",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十　「野性の呼び声」　僕は前に光風会に出たゴオガンの「タイチの女」（？",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "美術院の展覧会に出た二枚のルノアルはいづれもこのゴオガンに勝つてゐる。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、年月の流れるのにつれ、あのゴオガンの橙色の女はだんだん僕を威圧し出した。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオガンは、――少くとも僕の見たゴオガンは橙色の女の中に人間獣の一匹を表現してゐた。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノアルは、――少くとも僕の見たルノアルはかう云ふ点ではゴオガンよりも古典的作家に近いのかも知れない。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十一　「西洋の呼び声」　僕はゴオガンの橙色の女に「野性の呼び声」を感じてゐる。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "然らば此のバアトンの訳本は、欧洲の天地を遠く離れて、而も瘴煙蛮雨の中で生れたもので、恰もタイチに赴いたゴオガンの絵と好対照である。",
              "citation": {
                "source": "リチヤアド・バアトン訳「一千一夜物語」に就いて",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　菜っ葉服にオガッ屑をつけ、鳥打帽をかぶった鼻の赤い木工らしいのが、「おめ、おめえんとこに、飛、飛行機あるかね？",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "半地下室のその店の入口の段々のところからタイルではった床の上まで、オガ屑がまかれていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
