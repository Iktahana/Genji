          "standard": [],
          "literary": [
            {
              "text": "＊　この町の東端にオボロケ川といふ支流が灑いで居る。",
              "citation": {
                "source": "支流",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この名は尾花沢町の一部に朧気（オボロケ）といふ処があり、この川が其処を通過するのでこの名がある。",
              "citation": {
                "source": "支流",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "このオボロケといふのはどういふ意味であらうか。",
              "citation": {
                "source": "支流",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
