        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新商品発売記念の大盤振る舞いで、消費者が殺到した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その会社の大盤振る舞いなキャンペーンは話題になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "経営者の大盤振る舞いな判断がビジネスを拡大させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
