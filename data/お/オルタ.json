        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "次には星の運行の原因を説明するものとして、四つばかりの可能なオルターネティヴを列挙している。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "精密という言葉、量的という標語を持ち出す前にまず考えなければならない出発点の質的のオルターネティヴが案外にしばしば粗略に取り扱われる。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナイルの洪水の問題についても四箇条のオルターネティヴがあげてある。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "階下の一室は昔しオルター・ロリーが幽囚の際｜万国史の草を記した所だと云い伝えられている。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "エギザミナア紙の社会部副部長、ウオルタア・ノウトンは、一同と別の意見で、「僕は何うもあの弟のバアトンの奴が臭いと思うんだ。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "崖の上からコオルタールを流すやうに、兵隊の大群が流れ落ちて來る氣持ちの惡い夢を見て、孝次郎はあゝ厭な夢だと、黒板の繪を消すやうなかつかうで、片手で顏を拭いた。",
              "citation": {
                "source": "雨",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドレゴ記者はオルタ町の郊外に、先祖伝来の家を持っていた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏といえども山頂に白く雪の帽子を被つているヘルナーの霊峰、そしてその山腹に残っている廃墟オルタの城塞の壁。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎朝目をさますと、きまってドレゴはこのヘルナーの霊峰とオルタの古城を仰いで宇宙万象古今へ挨拶を贈るのであった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うむ、ジム・ホーテンスの説に傾聴するんだな」　さっきから水戸は、巖陰からオルタの町の方を見下ろしていたが、振り向いてドレゴの顔を見ながら、そういった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼らの古巣であるオルタの町だった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この上はどうしたらいいだろうかと思い、このオルタの港を眺めていると、そこへ入港して来た一隻の汽船がある。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "異常海底地震　その朝、オルタの港へ、一隻の奇妙な恰好をした船が入って来て、町の人々の目をみはらせた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は水戸を誘ったが水戸は応じなかった、こうしてオルタの町の仲好しは一時北と南に別れることとなった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "危険な仕事は出来るだけ早く切り上げて、オルタの町へ帰って来てくれ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事の途中で、この船が午後三時にオルタ港へ入る予定であることが発表された。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよオルタへ入るのだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルタの町に、美人は多い。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "解決のつかないままに、船はオルタ港口を入ってしまった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "約束の手紙　話はアイスランド島のオルタの町へ飛ぶ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日は、実にワーナー博士が水戸のために海底より救い出され、気息奄々たる身体をサンキス号の船上に移したその翌朝のことで、当時サンキス号はアイスランド島のオルタ港へ急航の途中にあり、突然大統領からの暗号電報に接した次第であった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから後は、サンキス号はオルタへの入港を取止め、そして秘密航海の途についた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
