        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "プレモ、オオトシヤツタア、ソルントンシヤツタア、フオルカルプレンシヤツタア、カアルツアイス、百分の一、千分の一、テツサア、アナスチグマツト――さういふ寫眞用語がいかに歴亂として私の腦裡を動き、いかに胸躍るやうな空想を描かせ、いかに儚ない慰樂を與へたことか？",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "庄兵衞の心の中には、いろ／＼に考へて見た末に、自分より上のものの判斷に任す外ないと云ふ念、オオトリテエに從ふ外ないと云ふ念が生じた。",
              "citation": {
                "source": "高瀬舟",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "庄兵衞の心のうちには、いろいろに考へてみた末に、自分より上のものの判斷に任す外ないと云ふ念、オオトリテエに從ふ外ないと云ふ念が生じた。",
              "citation": {
                "source": "高瀬舟",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからすっかり腹を空かした朝の食事、オオトミイルに牛乳をなみなみと注いで、あなたを見ると、林檎を丸噛りに頬張っているところ、なにかふっと笑っては、自分に照れ、俯いてしまいます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭軒は恐くは主としてオオトヂダクトとして其学を成就したものではなからうか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "君、オオトリシアンで、まだ若いのに自殺した学者があったね。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "庄兵衛の心の中には、いろいろに考えてみた末に、自分よりも上のものの判断に任すほかないという念、オオトリテエに従うほかないという念が生じた。",
              "citation": {
                "source": "高瀬舟",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオト・サボアの山の上から、東南の山あひに懷しく眺むる姿が、私には最も忘られぬものである。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、オオト・サボワの山中で、蒼黒い杉林の上から眺めやつた、夕暮のモンブラン、白光が薄紅にやがて紫にかわつて遠く空際にたゆたひ、森の中からは傳説の角笛が谺して響き渡り、羊の鈴が霧の中を流れて行く上に、殘り惜げに身をかくしたこの山の姿は、永久胸につゝまれてゐる。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "グランジュ　　最初の手紙にも書いておいた通り、我輩が君に頼んだのは、たゞ、あのオオトイユ時代の思出を書いてもらひたいといふことだつたんだ。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "其れのみならず自分はやがて、來賓の一同が大使館を辭し去る折には、今日令孃と同道して來た米國人フオオト氏の邸宅で、此の次の火曜日に再び面會しやうと云ふ約束までした。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は實際待ち焦れるやうにして今日と云ふ約束の火曜日を待つて、築地なる米人フオオト氏の邸宅に赴いた。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "フオオト氏夫妻は五年程も日本に居留して佛像の研究にまださして老いもせぬ半生を樂しんで居る。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は家へ歸つて來てからも他愛なく其の日の事を思返したが、同時にフオオト氏夫人の弟だと云ふ二十三四の若い青年がまるで兄妹のやうに親しく令孃と話して居る樣子をば、殆ど何の理由もなしに羨しく思つた。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "令孃はフオオト氏夫妻が何故にかくまで日本の骨董品を愛玩するか其の理由が分らない。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ等のお話うけたまはるだけにても、此上なき樂しみに御座候へば、いつにても午後に御出で下され度く、フオオト氏も日本の事情につきて、いろ／＼お伺ひ致し度き事も有之候由。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "朗讀して聞かした上令孃春子の意見も聞いて見たいと、さう云ふ意味の手紙を書きかけた處へ、思ひがけず築地のフオオト夫人からの手紙が屆いた。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "春子はフオオト夫人の弟なる若いジエヱムスと相愛してゐて遂に婚約の意志を發表した。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の爲め春子の兩親はフオオト夫人の監督の行き屆かない事を攻めて春子を早速實家に引取つてしまつた。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "フオオト夫人は事情を語る―――夫人は單に弟の依頼を受けて姉と云ふ義務と責任を帶びて、春子の兩親に春子が將來外國人と結婚する事を許される意志があるか否かを質問したばかりである。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は然う云ふ結論を殘してフオオト夫人と別れた。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十七日　フオオト氏の一家はいよ／＼日本を去るべき由を手紙で知らして來た。",
              "citation": {
                "source": "新歸朝者日記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "対岸、オオト・コムブの鬱蒼たる樅の林は、そのまま水に姿を映し、湖上の小舟は、いまやその林中に漕ぎいるのである。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "先祖を問へば、ペエテルのまだ軍の功名を世にとゞろかした時、屈竟の武士で、フオオト、クリスチナを打囲いた一人のフアン、ヰンクル氏です。",
              "citation": {
                "source": "新浦島",
                "author": "RIP VAN WINKLE. EINE NACHGELASSENE SCHRIFT VON DIETRICH KNICKERBOCKER.",
                "note": "青空文庫"
              }
            },
            {
              "text": "四世紀の終にはじまり五世紀を通じて続いている最も大きな事件は、半島の経営であるが、それには武力が必要であるから、武事を掌るオオトモ（大伴）氏やモノノベ（物部）氏やはそれについて重要のはたらきをしたのであろう。",
              "citation": {
                "source": "建国の事情と万世一系の思想",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "またナカトミ氏とかオオトモ氏とかモノノベ氏とかいうようなトモノキミ（伴造）の家、またはそれと同じような地位にある朝廷の貴族も、あちこちの地方にそれぞれ領土人民（部）があって、そこから入って来る租税などによって生活していたから、経済的の根拠はみな地方にあった。",
              "citation": {
                "source": "日本歴史の特性",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
