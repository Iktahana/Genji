        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これから丸沼へ出て、その次が大尻沼である。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "三つ続いた火山湖のうちの大尻沼がそれであった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尻沼より大きい、丸沼であった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "老番人に訊ねると、これが菅沼、丸沼、大尻沼の源となる水だという。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尻沼に至りて、光景忽ち一變す。",
              "citation": {
                "source": "上州沼田より日光へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "この湖長さ十四五町、幅三四町、大尻、丸の二湖に比して、更に大に、更に幽邃也。",
              "citation": {
                "source": "上州沼田より日光へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尻、丸、菅の三湖を見來りて、湯の湖に對すれば、更に一層大なるに、目先かはりて面白し。",
              "citation": {
                "source": "上州沼田より日光へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "三つ續いた火山湖のうちの大尻沼がそれであつた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尻沼より大きい、丸沼であつた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "案内人に訊ねると、これが菅沼、丸沼、大尻沼の源となる水だといふ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅沼と丸沼の水を集めて、金精峠から西に向かい片品川へ落ちこむ大尻川には、今年山女魚と岩魚が多かった。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "片品川と、大尻川の合する鎌田の村から下流は二尺に近い巨大な鱒が棲んでいて、時どき竿を引き折って釣り人をあっと驚かす。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "片品川、赤谷川、湯桧曽川、谷川、宝川、楢俣川、薄根川、大尻川、根利沢、砂沢、南雲沢、吾妻川など、利根川へ注ぐ数多い支流へは、幾度も幾度も分け入った。",
              "citation": {
                "source": "水の遍路",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、大尻川を下って鎌田へ出て、さらに戸倉の集落を過ぎて尾瀬沼と尾瀬ヶ原の方へも行った。",
              "citation": {
                "source": "水の遍路",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尻端折で、二人の子分を指圖して居るのは、二十七八にはなるでせうが、小柄で、意氣で、四ツ五ツ若かつたら、寺小姓のやうに綺麗だつたでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "御落胤殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり長い顏なんか出しやがつて」　錢形平次は大尻端折の植木の世話を燒く恰好で、さして驚いた樣子もなく、こんな馬鹿なことを言ふのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "狐の嫁入",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の内弟子は、大尻端折の、色氣のない恰好で格子を磨き、居間には青い顏をしたお幾と、これはまた、對蹠的に赤い禿頭の父親の豊年坊主が、火のない火鉢を挾んで、朝の煙草にしてゐたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "闇に飛ぶ箭",
                "note": "青空文庫"
              }
            },
            {
              "text": "南に丸沼大尻沼が不恰好な瓢箪の形をして現われる。",
              "citation": {
                "source": "秋の鬼怒沼",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "金精峠の西に在る菅沼は、丸沼｜及大尻沼と共に白根山の堰止湖かと疑われるが、これはまた殆ど針葉樹の純林に周囲を取り巻かれている為に、恐ろしく暗い感じのする山湖である。",
              "citation": {
                "source": "尾瀬雑談",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尻沼はわるくない。",
              "citation": {
                "source": "尾瀬雑談",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯く菅沼の既に発見されたる上は、其事実を知りたる何人なりとも、之を地図に顕す場合に於ては、字地を異にする丸沼及大尻沼と区別す可きは、当然の事ならんと予想せらる（此際余は『正保』より約四十年後に改選されたる『元禄図』を見るを得ざるを以て、一言の之に論及し能わざるを遺憾とす）。",
              "citation": {
                "source": "古図の信じ得可き程度",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尻端折りで、二人の子分を指図しているのは、二十七八にはなるでしょうが、小柄で、意気で、四ツ五ツ若かったら、寺小姓のように綺麗だったでしょう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "御落胤殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり長い顔なんか出しゃがって」　銭形平次は大尻端折りの植木の世話を焼く恰好で、さして驚いた様子もなく、こんな馬鹿なことを言うのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "狐の嫁入",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
