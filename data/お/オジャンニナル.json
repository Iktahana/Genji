        "examples": {
          "standard": [
            {
              "text": "「そんな無謀なことをしたら、全てがおじゃんになるぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「結局、会議での決定事項がおじゃんになる可能性が高い。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「これ以上遅れると、この計画もおじゃんになる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "――それに、日曜でも何でも出帆入港でとられれば、それで休日はおじゃんになるが、それは休日を翌日回しということにしてもらおう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――飯も炊けたし、魚も焼いてある」「こいつあびっくり仰天だ、冗談じあねえ、せっかく続いていた日和が、これできっとおじゃんになるぜ」「――まあ足を洗え、そして飯にしよう」十一　食膳に向うと伝九郎はもういちど驚ろいた。",
              "citation": {
                "source": "泥棒と若殿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことで計画がすべておじゃんになるとは」「出走を止められなければ、だろ」　フォスタがテーブル越しにコプリをじっと見て意味ありげに言った。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
