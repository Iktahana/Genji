        "examples": {
          "standard": [
            {
              "text": "港に入港した船の前に税関オフィサーが立ち、積み荷の申告書を丁寧に確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "国連のオフィサーとして赴任したのは、紛争直後の不安定な地域だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "警備会社のオフィサーが夜通し施設を巡回し、異常がないことを記録していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ところがＰＷの士官がサックの一つに横になっているのを誰かが発見し、艦長が僕でないインタープレターにこれはどうしたことだと聞いたら、あのオフィサー、つまり俺が、そうしてもいいといったと答えた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "座間のオフィサー・クラブで、彼は兵士の一人に殴り倒されスチームの太い鉄管で頭を打ち、一瞬意識をなくしたのだという。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
