        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その女御子は宮中で大切にされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "皇帝の女御子が政略結婚することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "江戸時代の女御子の生活は厳しく制限されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "たゞ万葉には、他の三首（或は四首）の歌と共に、作者を其女みこの祖母なる、難波高津宮の皇后磐姫と伝へる点が変つてゐるのである。",
              "citation": {
                "source": "日本文学の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史に伝へる行跡を近代の感情で理解して行くと、女みこは極めてやさしく、心は其かんばせに匂ふが如く、美しい女性であつた。",
              "citation": {
                "source": "日本文学の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
