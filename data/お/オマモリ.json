[
  {
    "uuid": "b317b038-5001-526f-a3dd-7417a2bf3e8b",
    "entry": "お守り",
    "reading": {
      "primary": "おまもり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
