        "examples": {
          "standard": [
            {
              "text": "彼は怒り上戸で、酔うとすぐに喧嘩腰になってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "怒り上戸の人と飲みに行くと、後味が悪くなることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "昔の友人に怒り上戸が一人いて、飲み会のたびに苦労した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "怒り上戸やアノ泣き上戸。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら司令部の有名な怒り上戸のアカザル通信兵が出ているようです。",
              "citation": {
