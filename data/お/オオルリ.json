    "definitions": [
      {
        "index": 1,
        "gloss": "blue-and-white flycatcher (Cyanoptila cyanomelana)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "初夏の森で美しいさえずりを聞かせてくれる大瑠璃をようやく写真に収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "渓流沿いの木々の中に、鮮やかな青色をした大瑠璃の姿を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "大瑠璃は渡り鳥として、この時期に山間部へやってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "雪の消えた両側の斜面には、春を待ちかねていた各種の高山植物が咲き乱れたり、角ぐむ草の芽立ちがほの紅く匂ったりして、登山者の目を楽しませ、近くの岳樺や深山榛の矮い林の中では、鶯、駒鳥、大瑠璃其他の小鳥が囀り交わして、快い響を漂わしている。",
              "citation": {
                "source": "山の魅力",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫に和して大瑠璃の囀りが近くの木の間から洩れ聞えた。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
