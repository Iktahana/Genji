[
  {
    "uuid": "a4ffa5e4-db40-5b84-939e-020e106823c5",
    "entry": "親代わり",
    "reading": {
      "primary": "おやがわり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
