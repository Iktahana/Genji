[
  {
    "uuid": "4e4bef5e-cda7-511d-9167-e7d8bdcb4363",
    "entry": "おめでた",
    "reading": {
      "primary": "おめでた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "matter for congratulation (wedding, pregnancy, birth, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女が妊娠したというおめでたがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "春に会社で新入社員を迎えるのはおめでただ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "先月は結婚というおめでたで一族が大騒ぎだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "こんなおめでたい席に。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂子屋太宰治　書房を展開せられて、もう五周年記念日を迎へられる由、おめでたう存じます。",
              "citation": {
                "source": "砂子屋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その感じはちょうどおめでたい新聞小説と恐ろしい罪悪を主題とした傑作とを読み比べる時のそれとよく似たものである。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもおまえが（生命かけても）という男だもの、どんなにおめでたかったかもしれやアしない。",
              "citation": {
                "source": "夜行巡査",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでまあ、日本でもいよいよこの民主主義という事になりますそうで、おめでたい事と存じていますが、この民主主義のおかげで、男女同権！",
              "citation": {
                "source": "男女同権",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあ、今日はおめでたう。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あゝ、おめでたいね、お客さまが濟むと、毎年ね、お前がたも夜あかしで遊ぶんだよ。",
              "citation": {
                "source": "片しぐれ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　屠犬児は天窓を掻きて、「むこうがおめでたいだけにちっとは冥利が悪いようだ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へゝゝ、おめでたう、へゝゝへゝ。",
              "citation": {
                "source": "鑑定",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よゝつツと、宙外君が堪まらず奇聲と云ふのを上げるに連れて、一同が、……おめでたうと稱へた。",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋を渡って向うへ通る、暗の晩の、榛の木の下あたり、蛍の数の宙へいかいことちらちらして、常夏の花の俤立つのが、貴方の顔のあたりじゃ、と目を瞑って、おめでたを祈りましたに……」　声も寂しゅう、「お寺の鐘が聞えました。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　と童謡を口吟んで通ったと云うだけで、早やその声が聞こえるようで、」　僧は魅入られたごとくに見えたが、溜息を吻と吐き、「まずおめでたい、ではその唄が知れましたか。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "與一　　鎌倉どのが初めての御上洛に、かやうな日和つゞきと申すはまことにおめでたい儀でござりまするな。",
              "citation": {
                "source": "佐々木高綱",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうわけで、お岩稲荷の縁起は、徹頭徹尾おめでたいことであるにも拘らず、講釈師や狂言作者がそれを敷衍して勝手な怪談に作り出し、世間が又それに雷同したのである。",
              "citation": {
                "source": "四谷怪談異説",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから小城さんの白雲閣を襲ふ、赤ん坊が生れてゐる、おめでたい、主人がすゝめられるまゝに、二階で飲む、牛肉がうまいやうに芋がらもうまかつた、酒のうまさは握飯のそれに匹敵した。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "おめでたいことぢやないかね。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、「何が、おめでたいことがあるもんかい。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことを言っている、おめでたさ、これも、ただものでない。",
              "citation": {
                "source": "一日の労苦",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "新年おめでたうございます。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おめでたいことじゃありませんかネ、ハハハ。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（否、源氏の題に、小松橋というのはありませんが、今日はあの橋の上で、）（それは、おめでたい。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中でも私が、お喜ばしい、おめでたい儀と申しました。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙の鶴「おれは君とちがつて、どうやらおめでたいやうである。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私、文化運動は性に合わず、殊にもプロレタリヤ小説ほど、おめでたいものはないと思っていましたから、学生とは、離れて、穴蔵の仕事ばかりをしていました。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "重子というが寄添いつつ、「ちょいと、何がおめでたいのさ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何でも、おめでたいに違いませんもの。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "このおめでたい矢先に、こんなことを申上げるのもどうかと思いますけれど、少し変なことを聞き込みましたので……。",
              "citation": {
                "source": "経帷子の秘密",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "君のことだから、いずれ新聞か雑誌にでも書くのだろうが、春の読物にはおめでたくないからね。",
              "citation": {
                "source": "虎",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
