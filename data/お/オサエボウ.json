        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鉋（かんな）の刃を正しく調整するために、押さえ棒の締め具合を細かく確認する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "熟練の職人は、押さえ棒を玄能でコンコンと叩いて刃の出方を微調整した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "摩耗してしまった古い押さえ棒を新しいものと交換し、鉋の鋭い切れ味を蘇らせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "午後から空模様が変って来たので、為吉は水夫一同と一緒に七個ある大倉口の押さえ棒へ楔を打って廻った。",
              "citation": {
                "source": "上海された男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
