        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "序にハバナの方も一つ輪に吹して……オットット……これはしたり。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その医学士は……憎らしい」「オットット、そう昂奮するなよ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オットット……こぼれますこぼれます。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……オットット……その窓は、そのまんま開け放しといた方がいいね。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ここへ、茶壺がへえったろう」　オットットット！",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはいづれ木田の野郎をとッつかまへて、ダンパンしたまへ」　それから、ドタバタ、店中をひつかきまはして紙を全部つみこんで、ヤアとも言はず立ち去る気配だから、「オットット、お待ち下さい。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "才蔵が降りてタチバナ屋の玄関へ駈けこもうとすると、「オットット。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "見せなきゃいけないから、一とつまみ、もらってくぜ」「オットット。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッと驚くとたんに帯がとけてしまったのを、ひきずりながら一目散に走りだそうとすると、書生の晏吾がよびとめて、「オットット。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞお先になどと譲合つたり、風に吹飛ばされたカンカン帽をオットットなどと拾つてやる。",
              "citation": {
                "source": "総理大臣が貰つた手紙の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オットット」　ホラブンはヘッピリ腰にモチ竿を犬の方へつきだして、竿の先をチョイ、チョイ、チョイ、とゆさぶりながら、「チョーセイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が怪物に近づこうとすると、魚屋が慌てて、「オットット、手をだすと噛みとられますよ」　長さ一米ぐらいの怪魚「カキザメ」という私が見たことのない怪物です。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんじゃ頂かざあなるめえ、オットット――（ついでもらって、ゴクゴクと一気に飲む）ふう――うめえトウだ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
