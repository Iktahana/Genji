        "examples": {
          "standard": [
            {
              "text": "「おっとっと、危ないところだった」と彼は言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "おっとっと、ホットコーヒーをこぼすところだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "「おっとっと！」と声を上げてバランスを取り戻した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「おっとっとっとっと危ねえ！",
              "citation": {
                "source": "黒い地帯",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おっとっと……こぼれます、こぼれます。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「米沢街道に、白菊植えて何さ、聞く聞く便りきく米沢街道に、松の木植えて何を、まつまつ主を待つとこ、すっとこ、ぴいとことん、か」　右源太は、唄いながら「おっとっと」　と、独言をいって、細い、急な坂道を、どんどん降りて行った。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ね、ほら、アーンと口をお開きなさいよ」　いっぱいの幸福感を顔中に漲らせて、お絲は、風雅な朱塗りの箸で名代の共白髪をはさみかけたが、「おっとっと、お絲、それにゃおよばねえて」　また、その白い手を押さえて圓朝は、「あっしは親代々の落語家だ。",
              "citation": {
                "source": "圓朝花火",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっとっとっと――。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "怪談抜地獄",
                "note": "青空文庫"
              }
            },
            {
              "text": "顎十郎は、おっとっと、と手でとめて、「行かれてしまっては困る。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "菊香水",
                "note": "青空文庫"
              }
            },
            {
              "text": "……おっとっと、散ります、散ります」　大有頂天の大はしゃぎ。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "菊香水",
                "note": "青空文庫"
              }
            },
            {
              "text": "（急な崖道を勢いをつけてトットと走りくだる）金吾　だけんど、足元から鳥が立つみてえに……（これもトットットッと走りくだる）壮六　おっとっとっと！",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっとっと――」　その時に、自分がさいぜん見つけ出した、藤川の岸へ下りるであろうところの藪の崖道の中から、むくむくと姿を現わしたものがありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっとっと――」　それを見ると、意外にも、たったいま常盤御前のお堂の前で別れた、頭巾の権高の貴婦人を迎えに来たところの杖を携えた小怪漢――すなわち宇治山田の米友でしたが、お雪ちゃんは、その出現ぶりに、なんだか夢に夢を見るような思いをさせられました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
