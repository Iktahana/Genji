          "standard": [
            {
              "text": "病院の各階に汚物入れが設置されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "感染防止対策として汚物入れの使用方法が徹底される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この汚物入れは医療廃棄物を安全に処理するために設計されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "置時計、寒暖計、硯、筆、唾壺、汚物入れの丼鉢、呼鈴、まごの手、ハンケチ、その中に目立ちたる毛繻子のはでなる毛蒲団一枚、これは軍艦に居る友達から贈られたのである。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし今日という今日は、犬や兎の屍体はすっかり取り出されて、汚物入れのなかに移されてしまった。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
