        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アイヌの神話では、オキクルミが人々に知恵や技術をもたらしたと語られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "北海道の博物館でオキクルミにまつわる伝承資料を閲覧した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "叙事詩ユーカラにはオキクルミが怪物と戦う場面が繰り返し登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "蝦夷島の神、古伝神、オキクルミの裔。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼アイヌ、蝦夷島の神、古伝神、オキクルミの裔。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは古伝神オキクルミを矜る、その蝦夷島の神を。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと共に美しい凪が眼前に打ひらけて、オキクルミ・サマイウンクル一人乗で沖漁に出て来た。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからオキクルミは、大浪の谷底へ追い落され漕ぎつづけて行くうちに、手のおもてから手のうらから、夥しい血まめが見る見るぶらさがっていく。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "オキクルミは、ただ一人になって漕ぎつづけて行ったあげく、手廻の品々を入れてある袋の中を手さぐり手さぐりして、イケマの小弓、イケマの小矢を前にとりだし、大空のおもてをにらみにらみ、ひょうと射はなった。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、やがてまたもやオキクルミは、大空のおもてをにらみにらみ、イケマの小矢を射はなった。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "またもや大空をオキクルミは、にらみにらみ、ひょうと射はなった。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　この神謡は、北風の女神が悪い風を吹かせて、人間を苦しめ、そのために人間の祖神オキクルミに罰せられるいきさつを、北風の女風が、“自らの体験を語った”という形式で述べた物語であります。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかわり、蛇体の常として、寒さには弱いので、アイヌの始祖神オキクルミが、この神に追いかけられた時、霙の神に頼んで霙を降らせてもらって助かった、という神謡があります。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、サマイクルといい、オキクルミといい、いずれも古代のシャーマンであったことは、すでに明らかにされているのでありますから、そういう山や丘の上の祭場が、古くアイヌの社会に栄えたシャーマニズムの祭の遺跡であることは、もう断言しても差支えあるまいと思うのであります。",
              "citation": {
                "source": "アイヌ宗教成立の史的背景",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
