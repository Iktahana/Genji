        "examples": {
          "standard": [
            {
              "text": "橋の設計には、応用力学の厳密な計算が不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大学院で応用力学を専攻し、構造物の安全性について研究している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この現象を説明するには、応用力学の知識が必要となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "次の冬学期には上記の先生方の外に、ヘルメルトの「地球の形」やオイゲン・マイヤーの「航空に関する応用力学」などを聴いた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌三十五年助教授となり、四十二年応用力学研究のため満二年間独国及び英国へ留学を命ぜられ、これと同時に工学博士の学位を授けられた。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十四年帰朝後工科大学教授に任ぜられ、爾来最後の日まで力学、応用力学、船舶工学等の講座を受持っていた。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの純粋力学が応用力学に先行せねばならぬことも確かである。",
              "citation": {
                "source": "純粋経済学要論",
                "author": "ELEMENTS D'ECONOMIE POLITIQUE PURE OU THEORIE DE LA RICHESSE SOCIALE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
