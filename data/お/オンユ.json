        "examples": {
          "standard": [
            {
              "text": "漫画では「どかーん」「ぴかっ」などの音喩が場面の迫力を高めるために効果的に使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その漫画家は独自の音喩を多用し、ほかの作品にはない独特の世界観を作り出している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "翻訳者は日本語の音喩を外国語に置き換える作業に毎回頭を悩ませると話していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "取り急ぎ候ため、乱筆の儀はおんゆるしくだされたく候。",
              "citation": {
                "source": "右門捕物帖",
                "author": "子持ちすずり",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉信ただいまうちじにつかまつる、おんゆるし候え」　そして夏目次郎左衛門は討ち死をとげた。",
              "citation": {
                "source": "死處",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
