    "definitions": [
      {
        "index": 1,
        "gloss": "to interweave",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "光と影が織り成す幻想的な風景に目を奪われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "様々な要素が織り成す物語は、読者を魅了する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "四季折々の自然が織り成す景色は圧巻だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "前者は与えられた一つのものに内在する有機的構造を分析展開して見せるに対して、後者は与えられた離れ離れの材料からそれによって合成されうべき可能の圏内に独創機能を働かせて建築を構成し綾錦を織り成すものだとも言われないことはないのである。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "運命の魔女が織り成す夢幻劇の最後の幕の閉じる幔幕としてこの刺繍の壁掛けを垂下したつもりであるかもしれない。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "香気のもつれに出る細かい幻想の糸の織り成す感情の展開のことです。",
              "citation": {
                "source": "「香水の表情」に就いて",
                "author": "――漫談的無駄話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "光と闇との不思議な交錯が織り成す、あの懐しい人々の影。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "天と書いてあれば、まづスカイとよむが、外國人ならただ四本の線の面白い組み合せ、書かれた線と空白との織り成す比例均衡の美だけを見るだらう。",
              "citation": {
                "source": "書の深淵",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯顧みて過去の山旅を憶うとき、そぞろに足を蹈み入れた秩父の山々が、深い渓谷と、色彩豊かな闊葉樹林と、黒い森厳な針葉樹林とが織り成す秩父の特色ともいう可き滋味を充分に味うことを得せしめて、私どもを心ゆくまで満足させて呉れたことを感謝せずにはいられないのである。",
              "citation": {
                "source": "初めて秩父に入った頃",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "物を織り成す、神聖な、清浄な力で、2715あの神々しい姿貌がここで発展したのだ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は午後っからずーっと起きてるんです、　いいお天気でしたからねえほんとうに――「ようござんしたねえ、　早く御なおりなすって。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「病気がおなおりなすって、ほんとに宜しゅうございました。",
              "citation": {
                "source": "花子の陳述",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "病気がおなおりなすってからでも……。",
              "citation": {
                "source": "古木",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、一人の人間の文章の達成とは、やや極端に言へば、その人なりの個性や氣質を十分に生き生きと生かし、織りなす文章を作り上げるといふ事に外ならない。",
              "citation": {
                "source": "氣質と文章",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その二つの交錯が織りなす物語であって、その二つの要素以外に何もない。",
              "citation": {
                "source": "大衆文芸作法",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "月の影が、さまざまの綾を地上に織りなす。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の紅葉は、叙情詩の題目の一にして、龍田川の紅葉の錦は、龍田姫の織りなす所として、或は秋風の神の賜として、遂に龍田姫を以て、秋風の神とし、紅葉を司る神とするに至りしなり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この山川雲霧、禽獣虫魚、草木花卉という横糸、春夏秋冬という縦糸、即ちこの経緯の織りなす天地を描き、その天地に情を寄する心が我が俳句への道であります。",
              "citation": {
                "source": "俳句への道",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫のねほそる秋の野を染めし昨日の露霜や萩が花ずりうつろへば移る錦は夕端山思入る日に啼く鹿の紅葉織りなす床の上。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつ果てるともなく南に延びる薄気味悪い茶色の小路が織りなす困惑の迷路たち。",
              "citation": {
                "source": "闇をさまようもの",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういったものが、絡み合う伝説と幻想が織りなす背景であった。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある種の諸神話の織りなす印象は力強いものであって、それらはある秘伝の潮流の中に包含されるようになった。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日のあらゆる心の静謐を希って、『古今集』『源氏物語』へのおだやかな共感を、桜花や月光の織りなす情緒的な自然へ、そのまま流れこませ、想いうるかぎり甘美な気分の羅を織りなすために、その生活をまもる人たちを描くのである。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皺のあらわれた金五郎夫婦の顔に、歳月と歴史とが織りなす、人間の宿命を思う大らかな表情が、共通に、あらわれていた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラビア夜話に取材して、豪華な夢を織りなす手際は見事だ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくし自身はと云えば、多少はへんに思ったものの別だん気味が悪いというほどの感じもなく、何か光と影との織りなす作用と自分の眼のせいだろうぐらいにあっさり見過していたものであった。",
              "citation": {
                "source": "幽香嬰女伝",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐘チャンギリも浮きうきとして、風流小袖の老幼男女が、くることくること、帰ること帰ること、今宮神社の八｜神殿から、斎院、絵馬堂、矢大臣門、ほとんど織りなすばかりな人出である。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "織りなす開帳の人浪をこぐり抜けて、仁王門の前まで息をきって行く。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やった、やった、ついにすべて、私のものだ」　運命の織りなす細い蜘蛛巣が、最後の一つを除き、確実に女の手中に落ちた。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "心とは、運命を正確無比に織りなすものである。",
              "citation": {
                "source": "朝に想い、夜に省みる",
                "author": "MORNING AND EVENING THOUGHTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "（a）我々はあらゆる努力をつくしても、とうていちっぽけな小鳥が作り上げるその巣の精巧さと美しさとまたその効用とを、ただ真似をすることすらできないし、みすぼらしい蜘蛛が織りなすあの布を模造することすらもできないのである。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに不思議な運命のそれ自体単純にして、それを織成す無限に複雑な因子の離合の間に、今や我々に既に分つたことは、宮沢賢治は死後間もなく認めらるるに至つたといふことである。",
              "citation": {
                "source": "宮沢賢治全集",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "死の冷たい手が彼をとらえる前に、どれだけの美しい「空想と言葉との織物」を織成すことが出来るか？",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
