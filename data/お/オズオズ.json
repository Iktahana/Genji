[
  {
    "uuid": "1b98a2c8-6dc1-5eda-913a-675f8f11171a",
    "entry": "怖ず怖ず",
    "reading": {
      "primary": "おずおず",
      "alternatives": [
        "オズオズ"
      ],
      "is_heteronym": false
    },
    "grammar": {
