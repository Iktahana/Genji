    "definitions": [
      {
        "index": 1,
        "gloss": "to catch up (with)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ランナーがライバルに追いつく寸前だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "発展途上国が先進国に追いつく速度が加速している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "仲間たちに追いつくため毎日練習している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "しゅっこが、あんまり急いで行くもんだから、小さな子どもらは、追いつくために、まるで半分｜馳けた。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この問題の解決に、われわれは、現在の幾人かの作家が闘争の現実に馳け足で追いつくことによって文学を推し進めようとするようなそんなケチなところに重点を置いてはならない。",
              "citation": {
                "source": "農民文学の問題",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "松木は息を切らし切らし女に追いつくと、空の洗面器の中へ乾麺麭の袋を放り込んだ。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの息子もおとなしいから、おふくろの云うことを何でも素直にきいているんだろうが、この頃の高い魚を毎日あれほどずつ売り残して来ちゃあ、いくら稼いでも追いつくめえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "イワンは、さきに急行している中隊に追いつくために、手綱をしゃくり、鞭を振りつづけた。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでながら、歩幅と同時に歩調を勘定に入れなければ何時間で追いつくかという勘定はできないはずであるが、あの映画に出るあの役者にその勘定ができるかしらと思うとちょっとおかしくなる。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでもし世界じゅうの他の国が昔のままに「足踏み」をして、日本の追いつくのを待っていてくれたらさぞいいだろう。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は追いつくのがほんとうに辛かった。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、ボートのほうが早いため、追いつくことはできません。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それから右へ曲って、電車道をどこまでもどこまでも……水道橋のとこまで……ね……そのうちに私が追いつくから……ネ……」　昂作は掌に乗っかった五十銭玉を凝視ながら、繰り返し繰り返しその言葉の意味を考えようとした。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけに、悪口祭の「佐助どんのアバタ面」云々の一言は一層こたえて、佐助の臓腑をえぐり、思わず逃げたのだが、「あ、佐助様、どこへ行かれます」　と楓が追いつくと、さすがに風流男の気取りを、佐助はいち早く取り戻して、怪しげな七五調まじりに、「楓どの、佐助は信州にかくれもなきたわけ者。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "シェットランドを去って間もなく舵輪にいた水夫たちが、何物かが船を追いかけて、しかも追いつくことが出来ないかのように、船のあとに哀れな叫びと金切り声をあげているのを聞いたと、しばしば繰り返して話したのがそもそも始まりであった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の者は彼に追いつくと、そこに映った光景を見て、同じ行動をとらざるをえなかった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "岐路があると赤はけろりと立って太十の追いつくのを待って居る。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、「僕だい僕だい水は僕が持って行くんだい」　と泣きそうに怒って追っかけたけれども、婆やがそれをお母さんの手に渡すまで婆やに追いつくことが出来なかった。",
              "citation": {
                "source": "碁石を呑んだ八っちゃん",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがの伝六も毒気を抜かれて、追いつくことも鳴ることもできないほどにすばらしく早いのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、吉岡は急いで追いつくと、その肩へ手を掛けながら、気色ばんで言いました。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに干場の面型をかぞえて見ると辛うじて十二、三の数で、あれがきのうまでの三日がかりの仕事では今夜あたりは徹宵でもしなければ追いつくまいと心配した。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど女の足でどうしてこれに追いつくことができよう。",
              "citation": {
                "source": "ネギ一束",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "容易なことでは追いつくことが出来ない。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに第一次大戰以後、敗戰國もしくは後進國において、敗戰から立上り、或は先進國に追いつくため、自由主義よりも更に能率高き統制主義が採用された。",
              "citation": {
                "source": "新日本の進路",
                "author": "石原莞爾將軍の遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "日当りもいいし、風通しもいいし、新しくて綺麗だし、なかなか下六番町の僕の家などの追いつくものでない。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日一日と騰貴する物価に、決して追いつくことのない待遇改善の実情は、妻であり母である女性の辛苦を言語に絶した状態においています。",
              "citation": {
                "source": "国際民婦連へのメッセージ",
                "author": "――「女性を守る会」から――",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら、待遇改善しても、月給は物価に追いつく時は決してない。",
              "citation": {
                "source": "合図の旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はだんだんと追いつくようになるにつれ、益々面白くなって何かを叫んだり喚いたりさえした。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "寿女は息切れがして決して早くは歩けなかったから、この母親の並足に追いつくため、真っ赤になってせいせい息をきらした。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく追いつくと、こんどは、「馬の足を一｜本。",
              "citation": {
                "source": "山姥の話",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と叫びながら、再び追いつくと、私はもう息も絶え絶えの姿であったが、阿修羅になって、左右の腕でところ構わず張りたおした。",
              "citation": {
                "source": "ゼーロン",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、ロシアよ、お前もあの、どうしても追いつくことの出来ない三頭馬車のように、ずんずん走って行くのではないか？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちいさな赤いくつは、うしろのほうで、ふわふわういていましたが、小舟においつくことはできませんでした。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
