        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "警察は暴動の群衆を追い落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "砲撃により敵軍を追い落とすことに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "先発投手は打者を次々と追い落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ここを以て東は明るく西は闇し、天に三段ありてカクーの天最高所にあり、ブロク猴の大きさ山ほどなるがこれを守り、その天に登って天菓を窃まんとする者を見れば、刺だらけの大なる菓を抛って追い落す。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、奴、足は早いが、地理を知らねえ、野山へ鹿を追い込むと、里の方へ、里の方へと逃げたがる、あいつは地の理を知らねえから、どっかで行き詰るよ、まあ、焦らず北へ北へと追い込んで行くことだ、そうすれば結局、恐山へ追い込むか、外ヶ浜へ追い落すが最後だ、は、は、は」と、榾火の色を見ながら、こう言いました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、容赦なく私の地位を奪い取り、私を彼の地位に追い落すのではあるまいか？",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのフスマの陰には槍ナギナタの十数名が隠れていて、合図に応じて房吉を庭へ追い落す手筈になった。",
              "citation": {
                "source": "花咲ける石",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「落せとは」「追い落すのだ」「はっ」　ふたりは、断崖の際へ、馬の首を引っ張った。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方攻めじゃ、追い落すようなものだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま、並べ返してみるとさながら大石を山の頂きから追い落すどうどうたる響きを耳にする思いがある。",
              "citation": {
                "source": "本因坊秀哉",
                "author": "野上彰",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間、こちらは、ほどほどにあしらっておき、夜に入ってから、平家方を一挙に、倶利迦羅峠へ追い落すのじゃ」　義仲の予想はうまく的中した。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第七巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "数頭の馬を絶壁の上から追い落すと、果して崖の途中で転んで落ちて砕かれる馬、足を折ってそのまま死ぬ馬などもあったが、その中に鞍置き馬三頭がなんと崖の下に無事に降りた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第九巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣きさうだと隆治が不意に思ふと、すぐ追ひ落すやうに涙がぱらぱらとこぼれた。",
              "citation": {
                "source": "ある死、次の死",
                "author": "佐佐木茂索",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
