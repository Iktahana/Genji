        "examples": {
          "standard": [
            {
              "text": "鏡を見るたびに、目元のシワに老いの波を感じて少し落ち込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "どんなに抗おうとしても、老いの波は静かに押し寄せてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼もまた、老いの波には勝てず、髪はすっかり白くなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「老いの波かひある浦に立ちいでてしほたるるあまをたれか咎めん　昔の聖代にも老齢者は罪されないことになっていたのでございますよ」　と尼君は言った。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            }
          ]
