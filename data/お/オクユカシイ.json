[
  {
    "uuid": "4034579d-749e-5486-8f88-178d5ed3ed30",
    "entry": "奥ゆかしい",
    "reading": {
      "primary": "おくゆかしい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
