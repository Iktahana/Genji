    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ボーボラナンキン」といふのは「オタンコナス奴」といふやうな意味だ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなのを、オタンチンっていうのだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこそ「沈み」に「沈み」切って、シヅ子の雑誌の毎月の連載漫画「キンタさんとオタさんの冒険」を画いていると、ふいと故郷の家が思い出され、あまりの侘びしさに、ペンが動かなくなり、うつむいて涙をこぼした事もありました。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はっはっは、ジッコさんといふのは磁鉄鉱だね、もうわかったさ、喧嘩の相手はバイオタイトだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」その時俄かにピチピチ鳴りそれからバイオタが泣き出した。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「バイオタさんがひどくおなかが痛がってます。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うむ、うむ、そのホンブレンもバイオタと同病。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はっはっは、ジッコさんというのは磁鉄鉱だね、もうわかったさ、喧嘩の相手はバイオタイトだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」その時｜俄かにピチピチ鳴りそれからバイオタが泣き出した。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……春星池活東、活東は蝌蚪にして、字義（オタマジヤクシ）ださうである。",
              "citation": {
                "source": "番茶話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさにここまではダイナスティの脚本家も赤面しそうな、絵に書いたようなステレオタイプの幸運である。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "忙しいモオタアや川蒸気や荷足の往来が、すでに水の上に頻繁になっていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして歩むにつれて、その水面の随所に、菱の葉、蓮、真菰、河骨、或は赤褐黄緑その他様々の浮藻の強烈な更紗模様のなかに微かに淡紫のウオタアヒヤシンスの花を見出すであらう。",
              "citation": {
                "source": "水郷柳河",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神は在る、モオタアと廻転する。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "小蒸汽とモオタア船の甲板である。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "迎えのモオタアボートが伝馬を引っ張って来て辛うじてロップを投げる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう、ウォオタア・ポロの練習もすんだですから、どうぞ、泳がれてもいいです。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな丈の立つ所で、ウォオタア・ポロの練習が出来るのかしらん。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マオカから七里ほど北のオタトモといふところに製造所があるのだが、そこは八月から浪が荒くなるので、四里ばかり手前へ假製造所を定め、また別に一ヶ所、マオカの南一里ばかりのテイヤにも設けた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹一疋に附き、マオカで二十錢から二十五錢もしたのに、少し不便なオタトモでは始終八錢の値段を保つてゐたが、それも雜漁者數名を抱へて置けば、ずツと安い割合になること。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供はお宝、オタカラ／＼というてあやしてゐる。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "「是が此間話したハイドリオタフヒア。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "成るが儘に成るとのみ覚悟せよ」　是はハイドリオタフヒアの末節である。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "門内を一寸覗き込んだ三四郎は、口の内で、「ハイドリオタフヒア」と云ふ字を二度繰り返した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイドリオタフヒアは覚えるのにさへ暇が入る。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎は返さうと思つて、持つて来たハイドリオタフヒアを出して読み始めた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に広田先生は必竟ハイドリオタフヒアだと思つた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一｜標題が解らんです」「ハイドリオタフヒア」「何の事ですか」「何の事か僕にも分らない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
