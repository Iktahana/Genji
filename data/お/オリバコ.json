        "examples": {
          "standard": [
            {
              "text": "テイクアウト用に、特製の折り箱を用意しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "祖父は木を薄く削って、丈夫な折り箱を作る職人だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この折り箱は、ケーキを潰さないように工夫されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "食事がおわってからまたもや余興がはじまった、チビ公はいとまをつげてひと足早く光一の家をでた、かれはてぬぐいに包んださかなの折り箱を後生大事に片手にぶらさげ、昼のごとく明るい月の町をひとりたんぼ道へさしかかった。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折詰をよこせ」「いやだよ」とチビ公は折り箱をふところに押しこんだ。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えい、面倒だ」　生蕃はずるずると折り箱をひきだした、チビ公は必死になって争うた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふしぎな地図　太郎と一郎は、料理屋によって、いろんなおいしいものを買い、それを折り箱に詰めてもらいました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
