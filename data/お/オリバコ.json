[
  {
    "uuid": "a20bf141-9aae-578e-8d67-1030cddfa3fc",
    "entry": "折り箱",
    "reading": {
      "primary": "おりばこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "box made of thin wood or cardboard",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "テイクアウト用に、特製の折り箱を用意しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "祖父は木を薄く削って、丈夫な折り箱を作る職人だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この折り箱は、ケーキを潰さないように工夫されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "食事がおわってからまたもや余興がはじまった、チビ公はいとまをつげてひと足早く光一の家をでた、かれはてぬぐいに包んださかなの折り箱を後生大事に片手にぶらさげ、昼のごとく明るい月の町をひとりたんぼ道へさしかかった。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折詰をよこせ」「いやだよ」とチビ公は折り箱をふところに押しこんだ。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えい、面倒だ」　生蕃はずるずると折り箱をひきだした、チビ公は必死になって争うた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふしぎな地図　太郎と一郎は、料理屋によって、いろんなおいしいものを買い、それを折り箱に詰めてもらいました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "石も、折箱の蓋も撥飛ばして、笊を開けた。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其中には空虚の折箱も三ツ入つて居るのである。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の前には折箱の蓋があけておかれてあった。",
              "citation": {
                "source": "不幸",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "試験所前の曲ものや折箱を拵える手工業を稼業とする家の離れの小｜座敷を借りて寝起きをして、昼は試験所に通い、夕飯後は市中へ行って、ビールを飲んだり、映画を見たりする単純な技術家気質の学生生活が始まった。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雛妓は席へつくと、お土産といって折箱入りの新橋小萩堂の粟餅を差し出した。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたくしもあとからお手伝いに行きますよ」というしまに見送られ、自動車の広い座席にわたくしはお土産の栄太楼の最中の折箱とちょこなんと並んで目黒に向いました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "６　ある夜おそく、折箱の職人の家に間借りしている活動写真館の弁士がにやにや笑いながらはいって来て、どす濁った声で言うのには、「他あやん、あんたこの間新世界で三味線をもった五十くらいの婆さんを乗せなかったかね」「なんや、刑事みたいなものの言い様するねんなあ、気色のわるい。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "階下は弁当や寿司につかう折箱の職人で、二階の六畳はもっぱら折箱の置場にしてあったのを、月七円の前払いで借りたのだ。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "心中を遂げた筈の男女から不気味至極な折箱到来とあっては、よい退屈払いどころか、事が穏かでないのです。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　道子は抱へて来た折箱の中から美味さうなシユウクリームを出して盛んに喰べ始めてゐた。",
              "citation": {
                "source": "爪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムサツカの夜明けは二時頃なので、漁夫達はすっかり身支度をし、股までのゴム靴をはいたまま、折箱の中に入って、ゴロ寝をした。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら大阪古来の風習からいえば、この袋の発明はさほど驚くに当らない事で、むしろ多少手遅れかも知れない、私の知っている婆さんなどはこんな便利な袋さえお金を出して買う事は無駄なもったいない事で、どんな料理屋でも折箱位いはくれるというだろう。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし洋食屋には折箱の用意はないかも知れないから彼女は鼻紙を沢山持って行くにきまっている。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の縁故としては、東京には本所で小さな折箱屋をやってる遠縁の者と、下谷で芸奴になってる姪の娘きりだった。",
              "citation": {
                "source": "死の前後",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "知人の紹介で島村のところに世話になってる三ヶ年余の間、おしげは本所の折箱屋とあまり往き来をしなかった。",
              "citation": {
                "source": "死の前後",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "おしげは折箱と酒瓶とを片附けて、押入のなかに頭をつきこんで、行李のなかをかきまわして、みち子の美しい芸妓姿の写真を、幾枚も、また改めて、彼女に見せるのだった。",
              "citation": {
                "source": "死の前後",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔦子という名前で芸妓に出てた彼女は、本所の折箱屋夫婦に連れられて、初めて島村の家の敷居をまたいだ。",
              "citation": {
                "source": "死の前後",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年半ばかりでそこを逃げ出して、東京で折箱屋をやってる伯母を頼ってきた。",
              "citation": {
                "source": "潮風",
                "author": "――「小悪魔の記録」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "野の中や泉のほとりに、弁当の折箱、新聞紙の一片、人の手にむかれた蜜柑の皮……などを見出した時は如何。",
              "citation": {
                "source": "「自然」",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中、電車の乗換場近くで、おれは鮨の折箱を一つ手に下げた。",
              "citation": {
                "source": "失われた半身",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは鮨の折箱を差出した。",
              "citation": {
                "source": "失われた半身",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "折箱の隅からは桃色の羊羹がぬるぬるとはみ出した。",
              "citation": {
                "source": "次郎物語",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふみにじられた折箱を囲んで、さまざまの言葉が入り乱れた。",
              "citation": {
                "source": "次郎物語",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お糸婆さんは、いかにも勿体なさそうに、そう言って、ぺちゃんこになった折箱を拾いあげた。",
              "citation": {
                "source": "次郎物語",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、三四年まえに、お祖母さんが自分にかくしてしまいこんでいた羊羹の折箱を、そっと盗み出して、裏の畑で存分にふみつけてやったことを思い出し、何か武者振いのようなものを全身に感じた。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりわけ、お祖母さんが大事にかくしていた羊羹の折箱を盗み出して、下駄でふみにじった時の記憶が、膚寒いほどの思いで蘇って来た。",
              "citation": {
                "source": "次郎物語",
                "author": "第三部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
