          "literary": [
            {
              "text": "「ナンダ　カナヅチカ、オンナジヤウナ　カタチヲ　シテ　ヰルガ、フエハ　ヨイ　オトヲ　タテヽ　ナルノニ、カナヅチハ　ナンニモ　ナラナイ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オンナジヤウナ　カタチヲ　シテ　ヰテモ、フエナンカ　ピロ　ピロト　ナクダケヂヤ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾だってオンナジ事よ。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "脳髄を持たない下等動物とオンナジ事なんだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ号外まで出ているのに……オンナジ処に居ながら御存じないなんて……」「……………」「……あのねお兄様。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "白鷹の奥さんも、やっぱり妾たちとオンナジ気持で、あの娘をお可愛がりになったに違いない事が、今やっとわかったのよ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "青イ青イガラスオンナジオ顔青イ青イオ顔ガラスニウツルオ顔ハ青イ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            }
          ]
        }
