        "examples": {
          "standard": [
            {
              "text": "1970年代に起きた**オイルショック**は、世界経済に大きな影響を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "**オイルショック**の際、ガソリン価格が急騰し、車の利用が控えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖父は**オイルショック**で物資が不足した時のことをよく話してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "だがオイルショックで社会が縮こまった中、新手の電子部品にはさっぱり販路が開けなかった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイルショック後のヒステリーの中で、まるで軍隊のように組織的締め上げが進んでいったこの国に悪態を付きながら、オレは正直なにをしたらよいのか分からなかった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫婦二人だけで始めた会社はこれまで、オフィスコンピューターの販売とメインテナンス、加えてマシンの納入先からの開発依頼をこなし、第二次オイルショック後の苦しい時期をどうにかこうにか乗り切ってきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
