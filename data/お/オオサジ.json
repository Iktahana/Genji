        "examples": {
          "standard": [
            {
              "text": "レシピに「醤油大さじ2」とあったので、計量スプーンで丁寧に量ってから加えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「砂糖は大さじ1杯で十分よ、入れすぎると甘くなりすぎるから」と母が教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "大さじで味噌を量りながら、今日の味噌汁には少し多めに入れようと決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "慎み深く大さじを持ちあつかいながら、葉子は自分に何かきわ立った印象を与えようとして、いろいろなまねを競い合っているような人々のさまを心の中で笑っていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねるまえに　おおさじいっぱい　のむこと。",
              "citation": {
                "source": "あなうさピーターのはなし",
                "author": "THE TALE OF PETER RABBIT",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
