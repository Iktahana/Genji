  {
    "uuid": "bf4691e6-bb0f-525f-be22-c4dd62a86dc1",
    "entry": "大匙",
    "reading": {
      "primary": "おおさじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
