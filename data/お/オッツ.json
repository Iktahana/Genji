        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自業自得を、人の責任におっつけるのは、図々しすぎるぜ」船長は、こいつ一つ脂をすっかりしぼりぬいてやろうと考えた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなったら私は、死んでおわびしたっておっつかない。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "手近にあったアルコールの数滴を机の上に垂らしてその上に玉虫の口をおっつけると、虫は活溌にその嘴を動かしてアルコールを飲み込んだ。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おっつけ先生は二階からおりていらっしゃる時分だよ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おつきさん、おつきさん、おっつきさん、　ついお見外れして　すみません　あんまりおなりが　ちがうので　ついお見外れして　すみません。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝生の上に置いてもとの古巣の空きがらを頭の所におっつけてやっても、もはやそれを忘れてしまったのか、はい込むだけの力がないのか、もうそれきりからだを動かさないでじっとしていた。",
              "citation": {
                "source": "簔虫と蜘蛛",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミゼラブル」の中でファンティーヌが往来で乱暴な男に肩へ雪の塊をおっつけられるところもあります。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばド・ヴァレーズ伯爵がけしからぬ犯行の現場から下着のままで街頭に飛び出し、おりから通りかかったマラソン競走の中に紛れ込み、店先の値段札を胸におっつけて選手の番号に擬するような、卑猥であくどい茶番はヤンキー王国の顧客にはぜひとも必要なものであろう。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルクナー主演の「女の心」（原名アリアーネ）の一場面で食卓の上にすみれの花を満載した容器が置いてある、それをアリアーネが鼻をおっつけて香をかいだりいじり回したりするのであるが、はじめは自分にはそれがなんだかよくわからなくて、葡萄でも盛ったくだもの鉢かと思っていた。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（詩入）「国を去って京に登る愛国の士、心を痛ましむ国会開設の期」雲や霞もほどなく消えて、民権自由に、春の時節がおっつけ来るわいな。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おっつけお前が誰かと恋に落ちた時に、はじめて解ることだわ。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論誰にも知らせないで、おっつけ土くれになってしまう僕の体と一緒に亡びてしまう秘密だ。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "露出しの男の膝を抓ったり、莨の火をおっつけたりなどした。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "おっつけ仕事を間に合すことのできないその器用な遅い仕事振を、お島は時々傍から見ていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうおっつけ九頭竜らがやってくる。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あぶれのお客をおっつけやがって。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "オロチョンギリヤーク土人の独木舟の競漕がおっつけ花火が揚ると初まる手筈であった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんなはそのるす中に、あの、なんとかいいましたね、そうそう、お弓さんか、まだけさは姿を見せませんが、おっつけご入来になりましょうからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでに、その香箱とやらも取り返してしんぜようが、いま仙次の野郎は在宅でござるか」「今は不在でござりまするが、暮れ六つまえには帰ると申しましたので、おっつけもうそのころでござります」「さようか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "達磨を好く遊女",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は「北のおっつあん」といわれて居た。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "おっつあんというのはおじさんでもなく又おとっつあんでもない。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっつあんどうかしやしめえ」　対手は聞いた。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それじゃ、おっつあん赤か、どうしたんでえまあ」　太十は犬殺しの噺をした。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっつあん殺すのか」　斯ういう不謹慎ないいようは余計に太十を惑わした。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "おっつあんそうするんだな」　太十は返辞をしなかった。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっつあん」と先刻の対手が喚びかけた。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっつあん縛ったぞ」　三次の声で呶鳴った。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おっつあん此のタンボク引っこぬくかんな」　其声が太十の耳に強く響いた。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
