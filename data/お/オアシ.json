    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "沙漠にオアシスの蜃気楼を旅人が見るように、彼らは「愛」の蜃気楼さえをもさがし求めたので。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "オアシスありと、人の言う。",
              "citation": {
                "source": "かすかな声",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――貴女の移気な恋愛のオアシス、近代女の株式、同盟破棄！",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダム・レムブルグのオアシスはいまでは相場師で埋もれてはいないであろうか？",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "埃及のカイロの街の古煉瓦壁のひまには砂漠なるオアシスうかぶ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムラヒハ　ゲタヲ　カツテ、コドモタヌキノ　バケタ　ゲタヲ　オモテニ　ダシテ　ヤリ、オアシヲ　ヒトツ　ヤツテ、「ヤ、ゴクラウダツタノウ」ト　イヒマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ　オアシヲ　モラツタノデ　サツキノ　クルシサモ　ワスレテ、ヨロコビ　イサンデ　カヘツテ　イキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その狭い往来に五、六株の大樹が繁っているのであるから、邪魔といえば邪魔であるが、電車も自動車もない時代にはさのみの邪魔とも思われないばかりか、長い堀端を徒歩する人々にとっては、その地帯が一種のオアシスとなっていたのである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その昔の江戸時代には、ほかにもこういうオアシスがたくさん見いだされたのであろう。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　沙漠でオアシスを見いだしたように、私たちはその池をさして駈けてゆくと、池はさのみ広くもないが、岸には大きい幾株の柳がすずしい蔭を作って、水には紅白の荷花が美しく咲いていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ふところの夕暮れに歩み疲れた若い旅人が青黒い杉の木立のあいだから、妓楼の赤い格子を仰ぎ視た時には、沙漠でオアシスを見いだしたように、かれらは忙がわしくその軒下に駈け込んで、色の白い山の女に草鞋の紐を解かせたでしょう。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その狭い往来に五、六株の大樹が繁っているのであるから、邪魔といえば邪魔であるが、電車も自動車もない時代にはさのみの邪魔とも思われないばかりか、長い堀ばたを徒歩する人々に取っては、その地帯が一種のオアシスとなっていたのである。",
              "citation": {
                "source": "御堀端三題",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その昔の江戸時代には、他にもこういうオアシスが沢山見出されたのであろう。",
              "citation": {
                "source": "御堀端三題",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから語ろうとする詳しい話のなかで、私のために、広漠とした罪過の砂漠のなかにいくつかの小さな宿命のオアシスを、捜し出してもらいたいのだ。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座へ出て、傍目も触らずに非常な速歩で歩いてゐると、だんだんに、どうして好いか解らない程な愴忙な気分に襲はれてしまつたのだ――私は、「オアシス」の酒つぎ台に肘をのせてゐた。",
              "citation": {
                "source": "日記より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "はるか向うにオアシスが見える。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポーはアメリカ文学におけるオアシスであった。",
              "citation": {
                "source": "ポウの本質",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時私は経済学の研究に夢中になっていた時代なので、月に一回のこうした清遊は、実に沙漠の中のオアシスであり、忙中の閑日月であって、この上もなく楽しいものに思えた。",
              "citation": {
                "source": "御萩と七種粥",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "美の小さなオアシスの探求の道によってか、それとも能動的に創造の道によってかは、勿論、一部分理想の高さに関係する。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "美の小さなオアシスの探求の道によってか、それとも能動的な創造の道によってかは、勿論、一部分理想の高さに関係する。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「牧田さんはうまい事したなア、サイゴンとプノンペンでは、久しぶりのオアシスだね……」「うん」「富岡さん、サイゴンで、面白い事あつたの？",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりゼニを一向ありがたがらんからオアシがズンズン逃げてゆく。",
              "citation": {
                "source": "風狂私語",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま東京｜丸ノ内のオアシス、日比谷公園の中にも、黄昏の色がだんだんと濃くなってきた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、あの部屋は僕のオアシスです。",
              "citation": {
                "source": "鼻に基く殺人",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大へんなオアシスだこと！",
              "citation": {
                "source": "鼻に基く殺人",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、黒吉はそれをいい事にして、独りぽつねんと、小屋の隅に忘れられた儘、たった一つ、彼に残されたオアシスである他愛もない「空想」に耽っていた。",
              "citation": {
                "source": "夢鬼",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、このタッタ一つ残された「夢」というオアシスにも、到頭恐ろしい破局が訪れて来た。",
              "citation": {
                "source": "夢鬼",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オアシスという緑地もある。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
