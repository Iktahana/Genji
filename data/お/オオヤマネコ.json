        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのなかの絶滅せんとしつつある樺太オオヤマネコの話、というのが強く私の空想を刺戟した。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオヤマネコは孤独な病者である私に最大の慰めを与えた。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オオヤマネコに感動してまだ幾日もたたぬうちに、一介の野良猫にすぎぬが、その倨傲な風格において、一脈相通じるところのある奴が我が家の内外に出没することになったのは愉快だった。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "17世紀の初めのころアカデミア・デイ・リンチェイ（＊オオヤマネコ・アカデミー）創立のために数人の学者がチェシ公爵の宮殿に集まった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
