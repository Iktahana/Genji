        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――その村からリルケはロダンに宛てて二通の手紙を書いてゐるが、最初の三月二十七日日付のものは、「オオギュスト・ロダン」が漸く出來たので、それを當時巴里に居た彼の妻クララにロダンの許へ屆けさすやうにした、その折の手紙である。",
              "citation": {
                "source": "リルケ書翰（ロダン宛）",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "その卷頭に「アポロの古拙なるトルソ」なんぞと題せられた詩を載せてゐる此の詩集は、その「大いなる友」オオギュスト・ロダンに捧げられた。",
              "citation": {
                "source": "一插話",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇三年　「オオギュスト・ロダン」（Auguste Rodin）成る。",
              "citation": {
                "source": "リルケ年譜",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（ロダン宛書翰）　又、「オオギュスト・ロダン」（1903）を補ふ。",
              "citation": {
                "source": "リルケ年譜",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨匠オオギュスト・ロダンの仕事場になっているオテル・ビロンでロダンは晴やかな顔つきをして、許多の半成品を見渡している。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "オメール・オギュ、黒人。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
