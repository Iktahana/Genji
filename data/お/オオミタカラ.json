  {
    "uuid": "85fce384-1454-5fcb-b3a0-72a0fbe9003e",
    "entry": "オオミ宝",
    "reading": {
      "primary": "おおみたから",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
