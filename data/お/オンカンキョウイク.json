        "examples": {
          "standard": [
            {
              "text": "子どもたちは音感教育を通じて、複雑な和音を聞き分ける力を養っていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音感教育は、音階を正確に認識する基礎を身につけるのに欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の優れた相対音感は、幼少期からの音感教育の成果だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そして軍事的な目的で音感教育がやかましくいわれた。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
