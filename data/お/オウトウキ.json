  {
    "uuid": "77158201-5ee8-55ba-b148-23538f260418",
    "entry": "桜桃忌",
    "reading": {
      "primary": "おうとうき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "anniversary that celebrates author Dazai Osamu's birthday, and incidentally, the day his body was found after he was involved in a double suicide",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "桜桃忌が近づくと、三鷹の禅林寺には全国から太宰のファンが集まってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "文学仲間と桜桃忌に合わせて太宰の短編を読み返し、改めてその文体に圧倒された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "桜桃忌の日、書店には太宰作品のフェア棚が設けられ、『人間失格』が平積みにされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それまでは大方信州にゐて出られなかつた桜桃忌の七周年に今年、はじめて自分は夫妻で出席して彼の遺孤の成長したのをも見たが、席上求められるままに話したのがおほよそ、この文と同じことであつた。",
              "citation": {
                "source": "稀有の文才",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜桃忌の席上で井伏さんは云った。",
              "citation": {
                "source": "風貌",
                "author": "――太宰治のこと",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
