          "standard": [
            {
              "text": "この映画のクライマックスの追っかけは圧巻だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "最近のアクション映画は、長回しの追っかけが定番になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "追っかけの途中でパトカーが横転するシーンが凄かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "obsessive fan who follows a celebrity around",
        "register": "standard",
        "nuance": null,
