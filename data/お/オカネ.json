  {
    "uuid": "93f66106-df72-57dd-af49-03a113282152",
    "entry": "オカネ",
    "reading": {
      "primary": "おかね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナニシロ　オカネガ　アリマセンノデ、キシヤヤ　ジドウシヤニ　ノル　コトハ　デキマセン。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネ、オクレテ、スミマセン。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネハ、イツモノヨウニ、ハンヲ、オシテ、アリマスカラ、コノママキョクヘ、トリニユキナサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネハ、イツモノヤウニ、ハンヲ、オシテ、アリマスカラ、コノマヽキヨクエ、トリニユキナサイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しい哉、カストリ社は、受附をつくるオカネもないのであった。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレはだなア、全力をつくして仕事に打ちこみ、かつ、莫大なるオカネをもうける。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "たかられちゃってさ、オレ、オカネが一文もねえんだもの、アノコが千五百円とられやがんのさ。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネというものがなければ、オレが社長であるという意味はない。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "弁内の問わず語りの通り、師匠の銀一は小金持の後家のオカネと良い仲になり、株を買ってもらって開業したのだそうだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀一は小金持のオカネと結婚してアンマの株を買ってもらったが、メクラ以外の者には羨しがられもしなかった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネの顔は四谷お岩と思えばマチガイない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネの片目はつぶれていたが、完全なメクラではなかった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀一は一文二文のことにまでお金にこまかい男だが、オカネはもッとこまかい。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "お志乃は銀一の姪だが、養女に選んだ張本人はオカネであった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、残りの一ツはオカネとちがってハッキリ見える目であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネがお志乃を選んだのは、第一に片目しかないというのが気に入ったのである。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもオカネの気に入った。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネの狙いたがわず、お志乃は変に色ッぽい女に育ちあがったから、オカネは旨を含めて、お客に手を握られたのを報告させ、その中からお金持の爺さんを選んで、特にサービスを差許す。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネの化け物婆アときたしにゃア、両手の熊手でカッこむことしか知りやしねえ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "弁内はヤジ馬や火消が退散して、深夜の静けさに戻るまで油をうって帰ってくると、オカネが銀一とお志乃に当りちらしている最中だった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　なるほど、オカネ婆アの怒るのも一理はある。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "松之助はオカネの妹の子供であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、オカネ婆アはなかなかウンとは云わない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌカミソ野郎め」　角平は日に一度や二度は銀一とオカネにこうどやされる。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐変木め」　と、オカネに年中怒られているが、それぐらいのことで弁内の早飯がのろくなったことはない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀一もサグリの名人だが、一方オカネ婆アは片目の半分を活用して、メクラどもに泥を吐かせる大手腕をもっていた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "角平や弁内はいい齢をしながら今でもオカネ婆アのサグリにあうとコテンの有様である。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネと銀一が会ってみると、なるほど気立てのよいメクラだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
