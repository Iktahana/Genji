[
  {
    "uuid": "759e4f61-cfc0-5ab0-9bd0-08cc0e680513",
    "entry": "お金",
    "reading": {
      "primary": "おかね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "money",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "財布を開けたら、お金がほとんど残っていなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「お金があれば何でもできるわけじゃない」と祖父はよく言っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "旅行に向けて、毎月少しずつお金を貯めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "まあ、順序からいへば、お金儲けも念頭に置くべき日となつた。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "三造はお金のことなんか忘れてゐる。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "三造はお金のことを思ひ出すといやになる。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり五年前、船橋に住んでいた頃の事であるが、くるしまぎれに市川まで、何のあてもなく出かけていって、それから懐中の本を売り、そのお金で映画を見た。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お金持ちには、お金持ちの暗い不幸があるのです。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "神代櫻へは、わざわざ團體で行かなくても、私たちだけで、のんびり見物に行きませう、賞金もらつたら、そのお金で行きませう、さうしませう、と三人で話をきめた。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、子供たちには、五文のお金でも大金ですからね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供だからお金をやつたんだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、世捨人だつて、お金が少しでもあるから、世を捨てられるので、一文無しのその日暮しだつたら、世を捨てようと思つたつて、世の中のはうから追ひかけて來て、とても捨て切れるものでない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けふあたり家の者がお金を持つて、この宿へ私を迎へに來る筈である。",
              "citation": {
                "source": "貪婪禍",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一億國民ひとしく貯蓄にいそしまなければならぬ重大な時期であると、嚴肅に我が身に教へてゐるのだが、どういふわけか、お金が殘らぬ。",
              "citation": {
                "source": "金錢の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかして、たつぷりとお金を殘したいものだと、いつも思つてゐる。",
              "citation": {
                "source": "金錢の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、どうもお金が殘らぬ。",
              "citation": {
                "source": "金錢の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一生お金の苦勞からのがれられぬ宿業を負つて生れて來たのかも知れない。",
              "citation": {
                "source": "金錢の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「自分の收入を忘れてゐるやうな人でなくちやお金が殘らぬ。",
              "citation": {
                "source": "金錢の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　してみると、金錢に淡泊な人に、かへつてたくさんお金がたまるものかも知れない。",
              "citation": {
                "source": "金錢の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもお金にこだはつて、けちけちしてゐる人にはかへつてお金が殘らぬものらしい。",
              "citation": {
                "source": "金錢の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日からお金まうけを始め度いのです。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはお金をまうけて、恋人に香ひの好い煙草一箱買はうとするのでもありません。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですが、年頃の男の子にあまりお金をやつてはよくありません。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お金は麻のハンカチへ一包、二包。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのお金でいまに太郎の美くしいお嫁に着物を買つてやるのです…………太郎はどこからかきつと美くしいお嫁さんを連れて来ませう…………そのお嫁さんは、ひよつとするときつい意地悪るかもしれません。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、わたしは今日からお金を貯めなければなりません。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな太郎の為に…………太郎の美くしいお嫁さんに着物を買ふため麻のハンカチ古い革手袋、昔はやつたお高祖づきんの布つ片へ、そつと貯めて置かうとするお金なんです。",
              "citation": {
                "source": "愚なる（?!）母の散文詩",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑い苦しめられた芸妓の一人が、その復讐のつもりもあって「姐さんは、そのとき、銀行の通帳を帯揚げから出して、お金ならこれだけありますと、その方に見せたというが、ほんとうですか」と訊く。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○「お金入れの口を開けてみて、お金が一文も無いときは何だか可笑くって可笑くって、あはあは笑うのよ。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」○お金があると、ついお友達と円タクに乗ってしまって。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな抽象的な教材でも、それが生徒の心の琴線に共鳴を起させるようにし、好奇心をいつも活かしておかねばならない。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人はつと身を起して立って来て、（お坊様、それでござんすがちょっとお断り申しておかねばなりません。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの雀をみると、「ぼくおかねをもってるよ。",
              "citation": {
                "source": "落とした一銭銅貨",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
