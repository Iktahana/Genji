    "definitions": [
      {
        "index": 1,
        "gloss": "to take down in notes (meeting minutes, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会議の内容を落とし込むのが私の役割だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "議事録に各自の意見を落とし込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "先ほどの提案を資料に落とし込みましょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "」「湖水の水を落とし込みましてな」「湖水の水を落とし込むって？",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○○獣をこの穴の中におとしこむんだよ」「へえ、陥穽ですか。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが一本腕にかなわねえで、穴へおとしこむたアなんでえ」　ガヤガヤののしりあう人声……それを左膳は、竪坑の底でかすかに聞いていた。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "舷の内張を一枚はずせば、船底へあるたけの銀子を落しこむことができる。",
              "citation": {
                "source": "呂宋の壺",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ええ、たしか、たしか……」　とうとう、つぶれてしまったのを素っ気なく見すてて、奥まった衝立のうしろへ入りこみ、紙と筆を借りて、なにかこまごまと書きつけ、封をして、それを胴巻の中へ落しこむと居酒屋を出ていった。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "御代参の乗物",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンホールに落しこむのは？",
              "citation": {
                "source": "ロンリー・マン",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この罠は、火事にまぎれてお前を落としこむために、こしらえたものに相違ねえ。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルクをかけ、左肩を思いきりよく、落としこむ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦心に苦心をして、蘭子ちゃんを、あのけだものの罠の中へ落としこむなんて……」　神谷はもうまっ青になって、自動車の床に、地だんだを踏むのであった。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
