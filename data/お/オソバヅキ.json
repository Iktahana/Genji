        "examples": {
          "standard": [
            {
              "text": "お側付きの侍女が新しい着物を持ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は先代から続くお側付きの一人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "お側付きに命じて、客人を中へ案内させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "一人は副将の乳母で、首を懐に、今一人はお側付きの女房で、幼いなきがらを大切に抱いて、それぞれ沈んでいった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそばづきの人たちは、陛下がおかくれになったこととおもって、ひとりもまだ、かえってきていませんでした。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "妖女は、魔法の杖をふるって、王様とお妃をのぞいては、お城のなかの物のこらず、それはおつきの女教師から、女官から、おそばづきの女中から、宮内官、表役人、コック長、料理番から、炊事係、台所ボーイ、番兵、おやといスイス兵、走り使いの小者までのこらず、杖でさわりました。",
              "citation": {
                "source": "眠る森のお姫さま",
                "author": "ペロー　Perrault",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
