          "literary": [
            {
              "text": "」　――オマエハ、モウ、ソレヨリ、オオキクナッテハ、イケマセンヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "――オマエハ、バカダカラ、シラナイノダ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハ、ウチデ、オトナシク、ルスバンヲシテイレバ、ソレデ、イイノダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オマエハ　ナゼ　オカアサンノ　イフ　コトヲ　キカナイノ」ト　オカアサンノ　タケガ　キキマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ガ存在スルコトヲオマエハ本当ハ知ッテイル。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキオマエハ私ノ奴隷トシテ考エルコトカラ解放サレル。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハタダ自己満足ヲ得ル以上ノコトハ何モシテハイナイノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハ自分ノコトシカ考エテイナイ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "サエ生ヤセバオマエハ何モ考エルコトモ悩ムコトモナク、タダ私ノ命令二従ッテイルダケデ生キラレルノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
