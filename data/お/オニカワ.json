        "examples": {
          "standard": [
            {
              "text": "硬いクルミの鬼皮を割るのに、特別な工具が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この栗の鬼皮は厚く、手では剥けない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "鬼皮を取り除いて、中の白い実を食べる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "顔色がまっさおにかわって、口がきけないのです。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こしもと衆のはなしでは、そのときばかりはお顔のいろまでがまっさおにかわって、ひでよし公をはったとおねめつけなされたそうにござります。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと顔色もまっさおにかわっていたにちがいありません。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
