          "literary": [
            {
              "text": "」　スルト、アサツユハ、ハノ　サキカラ　ピヨイト　ハナレテ　プツント　ヂベタヘ　オチテ　シマヒマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテ、コンナ　ウツクシイ　花バタヲ　ダレガ　アラシタノダラウ」ト　ヲトコガ　タホサレタ　イツポンノ　ケシノ　花ヲ　オコシテ　ヤラウト　スルト、ソノ　ネモトニ　シンチユウノ　ラツパガ　ヒトツ　オチテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムラヒハ　ゲタノ　ヲヲ　キツテ　コマツテ　ヰル　トコロデシタノデ、「ヤ　コレハ　ウマイワイ、ココニ　ゲタガ　オチテ　ヰル」ト　イツテ、コドモダヌキノ　バケタ　ゲタヲ　ハキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒロツパノ　マンナカニ　マルイ　カゲガ　ヒトツ　オチテ　ヰマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ユウガタニ　ナツテ、タイヤウガ　オチテ　シマフト　ヒロツパノ　マンナカノ　マルイ　カゲハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、ソノママ足ヲフミハズシテ、ヒドイ音ヲタテナガラ、マヨナカノ高イカイダンヲコロゲオチテシマッタ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ、カイダンヲオチテ、ウチドコロガワルクテ、君チャンガネコンデシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "●オタケサン――●ボウヤ――●ア、ココニモアッタワヨ――●ア、アソコニモオチテイルワヨ――●オバサン――●ソオネ――●ワタシオコルワヨ――●ワタシオトナシクマッテ（ナッテ？",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、マダアルワヨ」「ソコニモオチテイルワヨ」　この言葉をロオラが覚えたのは、きっと、こういう風に小さな飼主たちから食べ物を貰った時のことでありましょう。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
