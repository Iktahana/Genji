        "examples": {
          "standard": [
            {
              "text": "「最近、誰かに尾行されていませんか」と聞かれ、思い当たるふしがあって背筋が冷えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女が突然距離を置くようになった件について、思い当たるふしがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "部長に呼ばれたとき、思い当たるふしがあって少し緊張した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "知識とは少しちがう「智恵」については第三十八段に「智恵出でては偽あり」とか「学びてしるは、まことの智にあらず」などと云っているのは現代人にも思い当たるふしがあるであろう。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
