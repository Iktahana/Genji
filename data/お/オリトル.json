        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「一｜枝」と意を得ると、小笠原氏の顔を出して、事もなげに頷くのを視て、折り取る時、瀬の音が颯と響いた。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十吉は池のほとりへ行きて、花を折り取る。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、お主がそれを一つでも折り取るのは禁物ぢやぞ。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "道端や公園の花は折り取るものにきまつてゐる。",
              "citation": {
                "source": "墓",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "道端や公園の花は折り取るものにきまって居る。",
              "citation": {
                "source": "墓",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｊ　公共の園の樹木の枝葉を折り取るべからざる禁制は、尤もである。",
              "citation": {
                "source": "文学以前",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も二度ばかり、花の小枝を折り取る役目をさせられた。",
              "citation": {
                "source": "白木蓮",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰でも言うじゃないか、花を折り取るのは罪悪だって」と、彼は言う。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "月桂樹の枝を折り取ることと死人の靴を盗むこととは、同一人の手には不可能事であるようにわれわれは思う。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にも言ったように、ドロマイト弾は水平方向にしか作用しないから、言わば歯根だけを折り取るはずだ。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これをね、手の平の幅だけ折り取るのだ。",
              "citation": {
                "source": "毒草",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにあなたの運命は、明日になれば茎からあなたを折りとるでせう。",
              "citation": {
                "source": "測量船拾遺",
                "author": "三好達治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
