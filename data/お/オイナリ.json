        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オイナリ様の小さなホコラすらもなかった。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "外出して夜更けに帰宅することがあっても、家人への挨拶もそこそこに、オイナリ様を拝んでくるのが例であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが終りに、「あなたがお嫁に行く日まで、オイナリ様の朝夕の日参は必ずつづけて下さい。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、母の死後、父がオイナリ様を拝んだことはついぞなかった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "このオイナリ様は狼イナリと云うのだそうだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "由利子はオイナリ様へ参拝した。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもは閉じられているオイナリ様の扉がひらいていた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オーカミイナリって、賀美村のオイナリ様？",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイナリ様直々のタタリだということになりましたが、当家が故郷をひき払って上京したのは、これが原因で、どうしても居たたまらなかったのでしょう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さなありふれたオイナリ様である。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
