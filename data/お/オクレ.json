[
  {
    "uuid": "9941cd0a-110c-5f58-8465-51ff268621e8",
    "entry": "遅れ",
    "reading": {
      "primary": "おくれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "delay",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "事故の影響で電車に三十分の遅れが出ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "プロジェクトの遅れを取り戻すため、チーム全員で残業した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "発送の遅れについて、お客様にメールでお詫びした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "翌朝遅れたと思つて、慌てて先方に行着いたのは六時半だつた。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "遅れて来て途中から聞いた者は尚更さうであつた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああした種類の風景は、もはや時代遅れの趣味に属するもので、近代の若い人には感興がない。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "急いで朝飯かき込み岡崎氏と停車場に馳けつくれば用捨気もなき汽車進行を始めて吐き出す煙の音乗り遅れし吾等を嘲るがごとし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "西班牙の探検者たちが、加州にシエラ・ネヴァダ山脈を見つけたよりも、三世紀も遅れている。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は馬に慣れないので、少なからず閉口したが、同行中の神田憲君は、この仲間では馬術の達人で、ややともすれば遅れがちな私の馬の綱を、時々引いてくれた。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘の婚期は遅れて来た。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一秒遅れゝば一秒の敗、山を想はう。",
              "citation": {
                "source": "疑獄元兇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニが、カムパネルラ、きみは前からこゝに居たのと云はうと〔〕思ったとき、カムパネルラが「みんなはねずゐぶん走ったけれども遅れてしまったよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "××乗船ニ遅れた兵。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "一足遅れて来た七五郎。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し遅れて勝坊も続いて曲る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　「時遅れては」と半次、次に大吉、ドッと表へ飛び出した。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同より少し遅れてそッと呼び掛ける。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "事業というものは片っぽうで先走った思い付きを引締めて、片っぽうはひとところへ噛り付きたがる不精な考えを時勢に遅れないように掻き立てて行く。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕暮になりて幸助の帰りこぬに心づき、驚きて吾らもともに捜せし時はいうまでもなく事遅れて、哀れの骸は不思議にも源叔父が舟底に沈みいたり。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし今のように桃や李の数がふえてしまっては、この言葉はほんとうに時代遅れになったのかもしれない。",
              "citation": {
                "source": "神田を散歩して",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニが、カムパネルラ、きみは前からここに居たのと云おうと思ったとき、カムパネルラが「みんなはねずいぶん走ったけれども遅れてしまったよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう私らは今夜は時間に遅れました。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、帰りの遅れた馬力が、紙で囲った蝋燭の火を花束のように持って歩いた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遅れて来る人々もあちこちの横町からプロージット・ノイヤールと口々に叫ぶ。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは自分の趣味｜嗜好が時代に遅れたという事実を証明する以外になんらの意味もない些事ではあろうが、この一些事はやはりちょっと自分にものを考えさせる。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニが、　カムパネルラ、きみは前からここにいたの、と言おうと思ったとき、カムパネルラが、「みんなはね、ずいぶん走ったけれども遅れてしまったよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "洞熊先生も少し遅れて来て見ました。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の朝、授業の前みんなが運動場で鉄棒にぶらさがったり、棒かくしをしたりしていますと、少し遅れて佐太郎が何かを入れた笊をそっとかかえてやって来ました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴーシュさんはこの二番目の糸をひくときはきたいに遅れるねえ。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは役目柄ズッと入るけに、アンタはすこし遅れて、いつもの通りの物貰いの風で、人にわからん様、入んなさいや」「おっとアラマシ承知の助。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが当然の道筋で、まだまだ手遅れでは御座いますまい。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "こののろわれた乙電車の次に来る丙電車はどうであるか、この丙電車が第一の停留所に来る時刻が規定の時間どおりであったとすると、前の乙電車がｂ時間遅れてくれたおかげで、平均よりは nb だけ少ない人数を収容すればよいことになる。",
              "citation": {
                "source": "電車の混雑について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしこの丙電車が規定よりｃ時間遅れたとしても、乙が遅れなかった場合よりはやはり nb だけ過剰収容数が減るわけである。",
              "citation": {
                "source": "電車の混雑について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
