    "definitions": [
      {
        "index": 1,
        "gloss": "to weave up into fabric",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "職人は何日間も織機を操りながら、美しい帯を織り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "独特の質感を持つ生地を織り上げるには、高い技術が必要である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "伝統的な柄を一から織り上げるこの織物は、一枚に数ヶ月を要する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "自分が材料を作り、自分が意匠をこらして、自分の手で織り上げる、それはどんなに美しい価値のある仕事でありましやうか。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで現実から物語を織り上げるんだよ。",
              "citation": {
                "source": "夕映えのむこうの国",
                "author": "時代を超えた童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "真実の糸を状況に合わせて都合良く織り上げるのだ。",
              "citation": {
                "source": "最愛の君",
                "author": "Ｈ・ビーム・パイパー　H. Beam Piper",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも酸漿とマハツブとは、姉と妹か友だちかであったようだが、二人が日を切ってめいめいの着物を織り上げることになった時に、酸漿はどんなでもよいからと大いそぎで仕上げたゆえに、今でもあの通りがさがさとした目の荒い着物だが、ともかく全身をつつむことができた。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "藻の間を掬った叉手を、父が丘へほおりあげると、私は網の中から小蝦を拾った。",
              "citation": {
                "source": "父の俤",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごくごくわずかな部数の本を出会いの場としても、書き手の与えてくれる縦糸と、読み手の心が紡ぎ出す横糸を編み、大切な人生の一こまを織りあげることはできるのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺には、其々の技女が居て、其絲で、唐土樣と言ふよりも、天竺風な織物に織りあげる、と言ふ評判であつた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺には、其々の技女が居て、其糸で、唐土様と言ふよりも、天竺風な織物に織りあげる、と言ふ評判であつた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺には、其々の技女が居て、其糸で、唐土様と言うよりも、天竺風な織物に織りあげる、と言う評判であった。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで一瞬の間に、私の想像がすぐに奇怪なデサンの織布を織りあげる。",
              "citation": {
                "source": "測量船",
                "author": "三好達治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
