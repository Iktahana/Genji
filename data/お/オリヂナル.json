        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いくらオリヂナルの人でもイミテーションの分子を何処かに持っている。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなオリヂナルの人でも、人から切り離されて、自分から切り離して、自身で新しい道を行ける人は一人もありません。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらオリヂナルの人でも前に外の絵を見ておらなかったならば、あれだけのヒントを得ることは出来なかったと思う。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "またオリヂナルの方が早く自然に滅亡するか、イミテーションの方が先に滅亡するかであって、大した違いはない。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし考えるとそう真似ばかりしておらないで、自分から本式のオリヂナル、本式のインデペンデントになるべき時期はもう来ても宜しい。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "日露戦争というものは甚だオリヂナルなものであります。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ルンプは伯林でエミイル・オオリツクの所で一緒に絵を習つた相弟子だと云つて居たが、描いた絵は見なかつたけれど、なんでも伯林の女子美術学校を卒業したと云ふので、絹物の繍の図案のオリヂナルに富んで居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は、オリヂナルな思想なんてさうざらにないと高をくくり、未だ嘗て、思想そのものに感激したことのない連中である。",
              "citation": {
                "source": "新劇の始末",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故、僕は、この「齒車」こそ彼の生涯の最大傑作――と言ふよりは、最もオリヂナルな（個性的な）傑作だと斷言するのに躊躇しないのである。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            },
            {
              "text": "○外のものなら兎も角、この『桜の園』でほんたうにオリヂナルな演出を、誰にでも望むことは、望む方が無理である。",
              "citation": {
                "source": "『桜の園』の思ひ出と印象",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "否、寧ろ、この征服によつて、最もオリヂナルな演出を見うるのである。",
              "citation": {
                "source": "俳優の素質",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その結果は、舞台そのものを、非常にオリヂナルにすることはできなかつたに拘はらず、人物のうちに自然に流れ出るものを感じさせることに於て、多少成功したと思つてゐる。",
              "citation": {
                "source": "稽古雑感",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "紳二　　なるほど、オリヂナルたらんとすることも、亦難いかなだ。",
              "citation": {
                "source": "歳月",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "三重吉の言ふこともすることも、當時の私の地平線を超えてオリヂナルに見えたので、私は三重吉を「英雄」として崇拜し、甘んじてその弟分になつてゐた。",
              "citation": {
                "source": "知られざる漱石",
                "author": "小宮豐隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生の尺八の研究は有名であり、米国でその紹介が出た時、「日本人は欧米人の真似ばかりしている国民かと思ったら、こういうオリヂナルな研究をする人もある」と附け加えてあった位である。",
              "citation": {
                "source": "続先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝村がオヤヂ島津保次郎を連れて来て呉れた、ホテルのバーで、十一月の芝居、島津保次郎演出といふもの並に来年度彼のオリヂナルで撮る映画の打合せ、相変らず島津は仕事の熱に燃えてゐるのがたのもしい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
