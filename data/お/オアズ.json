        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……それがよ二十一日の間、オアズケ食っていたんじゃあねえか！",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の世の瀬には、オアズのこの曲折して行く河のやうに、數多の曲線があり、樂しい田園の内にさすらひまた戻つて來る。",
              "citation": {
                "source": "道學先生の旅",
                "author": "戸川秋骨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして場所は同じとしても、それは同じオアズの流れではあるまい。",
              "citation": {
                "source": "道學先生の旅",
                "author": "戸川秋骨",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬ならチンチン、オアズケなどするのであるが、このタマ貰い小僧どもはミジンもユーモアなく稚風なく、ただタマを返送すべきことを頑に要求する態である。",
              "citation": {
                "source": "神経衰弱的野球美学論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことわっておくが、オアズケはごめんだぜ。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オアズケを見せびらかされたって、腹がクチくなるか？",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オアズケは、お互いに、つらいや！",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
