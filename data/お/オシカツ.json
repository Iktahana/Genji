        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今週末は推し活のために、朝からグッズ販売の列に並ぶんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "社会人になって自由なお金が増えたから、全力で推し活を楽しんでるよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "推し活のおかげで、毎日忙しいけれど充実した日々を送れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "浜べには町じゅうから駆り出された出面たちが、赤地に墨で奔放に書きなぐった大漁旗をおしかついであつまっていた。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……かんじんのてめえの命がおしかつたら、いけねえもなあ、きれいサツパリやめる事だ。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
