[
  {
    "uuid": "20e9bcf8-a2a8-5ddd-ac9d-e0eff56d22d3",
    "entry": "お先",
    "reading": {
      "primary": "おさき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "ahead",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お先という言葉は、様々な文脈で用いられる重要な表現である。",
              "source": "幻辞"
            },
            {
              "text": "彼はお先の意味について深く理解していた。",
              "source": "幻辞"
            },
            {
              "text": "お先を正しく使用することで、より自然な日本語の表現ができる。",
              "source": "幻辞"
            },
            {
              "text": "この文献ではお先という概念が中核的な役割を果たしている。",
              "source": "幻辞"
            },
            {
              "text": "お先の用例は、古典文学から現代文まで幅広く見られる。",
              "source": "幻辞"
            },
            {
              "text": "日本語学習者にとって、お先は習得すべき重要な表現の一つである。",
              "source": "幻辞"
            },
            {
              "text": "文化的背景を考慮すると、お先の意味がより明確に理解できる。",
              "source": "幻辞"
            },
            {
              "text": "お先と同義語の使い分けについては、細かい注意が必要である。",
              "source": "幻辞"
            },
            {
              "text": "学術的には、お先は複数の関連する意味を持つことが知られている。",
              "source": "幻辞"
            },
            {
              "text": "口語表現において、お先はしばしば省略形で用いられる。",
              "source": "幻辞"
            },
            {
              "text": "お先の語源を追うと、興味深い言語史の一部が見えてくる。",
              "source": "幻辞"
            },
            {
              "text": "現代の日本語では、お先の使用頻度は比較的高い傾向にある。",
              "source": "幻辞"
            },
            {
              "text": "医学や科学の分野では、お先が特定の技術用語として定義されている。",
              "source": "幻辞"
            },
            {
              "text": "お先を含む表現は、詩歌や文学作品で特に効果的に使われることがある。",
              "source": "幻辞"
            },
            {
              "text": "会話の文脈によって、お先のニュアンスが微妙に変わる可能性がある。",
              "source": "幻辞"
            },
            {
              "text": "辞書によっては、お先に複数の定義が記載されている場合もある。",
              "source": "幻辞"
            },
            {
              "text": "お先の使用は、特定の社会階層や世代と関連していることもある。",
              "source": "幻辞"
            },
            {
              "text": "言語学的分析により、お先の文法的性質が明らかになっている。",
              "source": "幻辞"
            },
            {
              "text": "お先は、日本語能力試験などの言語試験でも重視される語彙である。",
              "source": "幻辞"
            },
            {
              "text": "同じ意味でも、お先の代わりに別の表現を選ぶことで、印象が変わる。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "そういう時、妻はわざわざ私の所へやって来て、『遅くなりますから、お先へ休ませて戴きます』と言う、丁寧に三つ指をついてお辞儀をし、それから自分の寝床へ入る。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈々ちゃんお先においでよ奈々ちゃんと雪子が叫ぶ。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一時間ばかり、さらに談じかつ飲み、中倉翁は一足お先に、「加と男」閣下はグウグウ卓にもたれて寝てしまったので、自分はホールを出た。",
              "citation": {
                "source": "号外",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "……蔵元の娘胴切りそれかぎり熊なき詮議お先まっくら……赤猪口兵衛……」「ヘヘヘ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことにお先まっくらなぞと嘲弄されては役目柄が相立たぬわ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大風呂敷が何を包んだものか、何処の穴から出て来たものかがわからぬうちは、お気の毒ながらお役目柄がお先まっくらじゃろう。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "お先まっくらの奴……ヒトの手柄を横取りし腐って……」「……エ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "大目付様にも何にも生まれて初めて見る御状箱で御座いましたけに、よくわかりませなんだが、お先方様のお名前は渋川様と御座いましたが……渋川ナニ吾様とか……」「エッ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの国も物見高で、お先走りの若いのが、早や大勢。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "救助隊を出さねばなるまいという者もあったが、ナァニあの先生が捕虜になる気遣いはないと、一同は一足お先に那河川に架けたる橋を渡り、河畔の景色佳き花月｜旅店に着いて待っていると、間もなく杉田先生得意満面、一行の荷物を腕車に満載してやって来た。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さあずうつとお先へ。",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお先刻の腹癒に、滅茶々々に撲り潰さんと、例の鉄棒を捻る時、銀平は耳を聳てて、「待て！",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「降りませんうちに、じゃあこうなさいまし、そこらで車夫を呼んで参りますから、御前様は一足お先へ、私はお後から奥様を引張って帰ります。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、お先ばしりで、衆と一所に、草の径を、幻の跡を尋ねた――確に此処ぞ、と云う処に、常夏がはらはら咲いて、草の根の露に濡れつつ、白檀の蒔絵の、あわれに潮にすさんだ折櫛が――その絵の螢が幽に照った。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お隣のを借りる）を掛けると六丁目里見氏宅で、はあ、とうけて、婀娜な返事が――幹事で支度がありますから、時間を早く、一足お先へ――と言ふのであつた。",
              "citation": {
                "source": "九九九會小記",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はははは、御遠慮なくお先へ。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お先立ちがその易者殿、御幣を、ト襟へさしたものでござります。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "六郎　　お先觸れの同勢はもはや尾州の熱田まで到着したとか申すことでござりまする。",
              "citation": {
                "source": "佐々木高綱",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お先に失礼します」　伝票を掴んでいた。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おあいそ」　君勇は勘定を払うと、すくっと起ち上って、「――お先イに。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ものの二十間も行かぬうちに、案内すると見せかけた客引きは、押していた自転車に飛び乗って、「失礼しやして、お先にやらしていただきやんす。",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、お先きにと、湯殿の戸をあけた途端、化物のように背の高い女が脱衣場で着物を脱ぎながら、片一方の眼でじろりと私を見つめた。",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお先方は尺八の趣味があるといい、それも何となく奥床しいといえばいえ、かねがね筑前琵琶をならっている定枝とその点でも何か釣り合っているではないかと、これで纒らねば嘘だった。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そりや然うですけれども、家にゐらツしツて見れば、豈夫お先へ戴くことも出來ないぢやありませんか。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩、兄弟三人は揃って、「お父さんお母さん、お先へ……」　と云って離れた室に寝ますと、間もなくアアとサアは起き上って、リイをつかまえて窓から外へ引ずり出して、そのまま窓をしめて寝てしまいましたが、リイは前から知っていましたから、声も出さずに兄さん達のする通りになっていました。",
              "citation": {
                "source": "雨ふり坊主・先生の眼玉に・奇妙な遠眼鏡",
                "author": "香倶土三鳥（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたがお先へお打ちなさい。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "フレデリックもイングンもスウエーデン貴族社會の甘やかされた子供達で、共にウプサラの大學に學んでゐたが、不良な道樂者のお先棒だつた。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっそり、おさきに這入ってきたのだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おさきへ、ごゆるされや、はい、はい。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいてい見当は付いたかね」「おさき真っ暗で眼も鼻も利きません」と、半七は笑った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "十五夜御用心",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
