        "examples": {
          "standard": [
            {
              "text": "新薬承認の噂が流れ、思惑買いが殺到してバイオ株が急上昇した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "利上げ観測を受けた思惑買いで、銀行株が軒並み値を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "アナリストは「この上昇は業績改善ではなく思惑買いにすぎない」と警告した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "我々の同業者の中でも、景気に乗って思惑買いをして、一時は大いに儲けたものもあった。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は最初から、思惑買いはさておき、実際に使用する砂糖でさえも買置きせず、必要量だけを購入してこの変則の場合を凌いでいたので、五十五円が一時に三十円まで下落した際も、私のところには一俵の手持もなかった。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
