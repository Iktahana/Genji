        "examples": {
          "standard": [
            {
              "text": "音楽史の授業で、中世の多声楽曲であるオルガヌムの複雑な構成について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "合唱団は、厳かな雰囲気の中で初期オルガヌムを再現するプログラムを組んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古楽の楽譜を読み解きながら、オルガヌムの独特な旋律を歌うのは想像以上に難しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "必要なのは従って、帰納という方法であり、この帰納法こそ新しい研究機関でなければならぬ（その著『ノヴム・オルガヌム』――新方法機関）。",
              "citation": {
                "source": "辞典",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "（フランシス・ベイコン「ノーヴム・オルガヌム」格言）　世界史を通して金の糸が通っている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
