        "examples": {
          "standard": [
            {
              "text": "夏のパーティーに合わせてリネンのオープンシャツを一枚買い、内側にタンクトップを合わせてさらっと着こなした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「そのオープンシャツ、ハワイアン柄が涼しげでいいね」とバーベキュー会場で声をかけられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ドレスコードがカジュアルと聞いたので、白いオープンシャツをゆったりとズボンに入れずに着て出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "制服ひとつとっても、金糸のエンブレムがついた紺のブレザー、レジメンタル・タイ、グレイのスラックス、というフォーマルなもの、そして、ふだん学校や寮で着る、衿なし上着にオープンシャツの校服、という二種類があり、いろいろ行事のある入寮入学前後は指示が複雑で、新入生を悩ませた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
