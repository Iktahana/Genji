    "definitions": [
      {
        "index": 1,
        "gloss": "skill",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「彼は何をやらせてもお上手で、感心してしまう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「お料理がお上手ですね。何か秘訣があるのですか。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「彼女はお上手な絵を描くので、美術部で活躍している。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "そんな時、ものを遣る代りに、そのなまけ者のお上手者の頬に平手の一つも見舞ってやる。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく又一尾上げるとボズさん、『旦那はお上手だ。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "支配人の内川は、中隊長や、中隊附将校にお上手を使った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいへん飛び乗りがお上手でいらっしゃいます。",
              "citation": {
                "source": "電車",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "芹川さんは、学校に居た頃から漱石や蘆花のものを愛読していて、作文なども仲々大人びてお上手でしたが、私は、その方面は、さっぱりだめでございました。",
              "citation": {
                "source": "誰も知らぬ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……花田さん、あなたは才覚があって画がお上手だから、いまにりっぱな画の会を作って、その会長さんにでもおなりなさるわ。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな時、ものをやる代りに、そのなまけ者のお上手者の頬に平手の一つも見舞ってやる。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「奥さんは字がお上手なんですね」　しかし、その皮肉が通じたかどうか、顔色も声の調子も変えなかった。",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "お上手なんでしょう？",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、すこし大きくなりすぎたけどね」「ほんとに、お話がお上手だこと！",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはこれまで武器と云うものを手にした事がありませんから、あなたのお腕前がどれだけあろうとも、拳銃射撃は、わたくしよりあなたの方がお上手だと信じます。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌のお上手な」　そして、世間に自分と同名な名流歌人がいることをお座敷でも聴かされたことがあったし、雑誌の口絵で見たことがあると言った。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたは、急にお口もお上手になって、私を一そう大事にして下さいましたが、私は自身が何だか飼い猫のように思われて、いつも困って居りました。",
              "citation": {
                "source": "きりぎりす",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムレットさま、あなたは本当に言いのがれが、お上手です。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（菊代）　なかなかお上手ね、先生。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまで人一倍、がんばって勉強して、それからテニスも、水泳もお上手だったのだもの、いまの寂しさ、苦しさはどんなだろう。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お邸育ちのお慰みから、縮緬細工もお上手だし、お針は利きます。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おや、お上手だ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貢さんが、お上手だもんだから。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この字は、四、五日前に、新子が支度の方が正しいと、教えたばかりであったので、彼女は、微笑を浮べながら、しかしややきびしい調子で、「たいへん、お上手だけれども、一字小太郎さんらしくもない間違いをしていらっしゃるわ。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "（畠のだと、貴方の方が取るのがお上手でしょうけれど……）　微笑する。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そう、ほんとうにお上手ね、」と莞爾した。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お上手に出来ました」　お母さまは、まじめにそう言い、スウプをすまして、それからお海苔で包んだおむすびを手でつまんでおあがりになった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴方は文科へ行つてゐらつしやるのだから定めし詩や歌をお作りになることがお上手でせう。",
              "citation": {
                "source": "I Am Not A Poet, But I Am A Poet．",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "特別にお好きなせいかお描きになることもお上手であった。",
              "citation": {
                "source": "源氏物語",
                "author": "絵合",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐれた貴女がたであるが歌はお上手でなかったのか、ほかのことに比べて遜色があるとこの御贈答などでは思われる。",
              "citation": {
                "source": "源氏物語",
                "author": "胡蝶",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は皆さんお上手で……。",
              "citation": {
                "source": "二つの失敗",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中でおあにいさまの火照命は、海でりょうをなさるのがたいへんおじょうずで、いつもいろんな大きな魚や小さな魚をたくさんつってお帰りになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドイツ語がおじょうずですね」などと言われて、おしまいにはまたドロップの瓶入りを買わされた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱりスミスおじいさんのほら話に、あんたたちは乗ってしまったようね」「おじいさんは、話がおじょうずですからねえ」「ほら話と思ってちゃ、あとで後悔しなさるぞ。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "flattery",
