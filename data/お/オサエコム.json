    "definitions": [
      {
        "index": 1,
        "gloss": "to pin (someone) down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "警官が背後から暴漢に飛びかかり、一瞬のうちに床へ力強く押さえ込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "プロレスラーが鍛え上げた巨体を生かして、相手選手をマットに押さえ込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "必死に抵抗して暴れる獲物を、猟師は体重をかけて地面に押さえ込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「その二つのコンピューターを、私に作らせてもらえませんか」　機内に響くアナウンスの声を押さえ込むように、稲盛和夫がそう言った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "日が昇っていくにつれて彼の虚ろな目は焦点を結ぶ位置を変え、昼までにはがらんとした空間を見つめる衝動を押さえ込むことができた。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃあ時には邪魔に感じるでしょうけれどね」　ウージェーヌは既に何度か嫉妬の衝動に駆られたが、彼の忘恩の気持ちを元から押さえ込むような彼女の言葉を非難することは出来なかった。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "柔道は投げる、おさえこむ、絞める、逆をとるという技だ。",
              "citation": {
                "source": "柔道と拳闘の転がり試合",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to shut out (one's opponent)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先発投手は強力な相手打線を、わずか三安打の無失点に押さえ込む快投を見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "敵の得点源であるエースを徹底的にマークし、最後まで無得点に押さえ込むことに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "守備陣がゴール前で一丸となって、試合終了のホイッスルまで相手の猛攻を押さえ込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to suppress",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
