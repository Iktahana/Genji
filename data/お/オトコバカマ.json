          "literary": [
            {
              "text": "――一圓五十錢、男袴。",
              "citation": {
                "source": "痴日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣の部屋で、率八の話に聞き耳をたてていた間に、身装も作っていたものとみえ、いつもの黒頭巾に男袴、腰に細身の大小を落としている。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "九、前掛と下物　女が改良した男袴を共用するやうになつて、在來の女袴は追々に廢れたやうである。",
              "citation": {
                "source": "服裝語彙分類案",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
