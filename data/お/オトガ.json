        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シバラク　スルト　タニ川ノ　オトガ　ドドドドト　キコエテ　キマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タニガワノ　オトガ　ダンダン　チカク　ナツテ　キタ　トコロデ、トツゼン　カゴカラ　トビダシ、カゼノヤウニ　ハヤク　グングン　ニゲマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テンカン　テンカント　イサマシイ　オトガ　シテ　ヰルノデ　イツテ　ミルト　カジヤデシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オオ　タイハウノ　オトガ　キコエル。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ヨツピテグツスリネコンダノニ、マダネタイデスガ、メガサメテシマツテネムレナイノデ、ホンヲヒロゲテヨミマセウトシマストキウニ、マドノスグソトデ、パタパタトハシリマハルオトガシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンガ一字ヨムカヨマナイウチニ――オバアサンハ、ムツカシイ字ヲヨムトキハ一字ヨムノニトテモ時間ガカカルノデス――マドノソトデ、ハリサケルヤウナオホキナオトガ、キコエマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドロノナカニ　コロガツテヰルト、ナニカ　ウチノナカデサワガシイ　オトガ　シハジメマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
