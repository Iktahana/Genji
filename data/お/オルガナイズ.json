          "literary": [
            {
              "text": "すべての個人をオルガナイズしその細胞組織の中に暗い集団の構造を形成せんとするところの、かの新しきロマンティシズムの新しきヴェゲテジーレン（植物化）をもつ。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノキイのもつ喜悦は、このオルガナイズの情趣の上に在る。",
              "citation": {
                "source": "レンズとフィルム",
                "author": "――それも一つの性格である――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソリダリテの感情とはそれを指す、オルガナイズの情趣ともいわるべきものである。",
              "citation": {
                "source": "レンズとフィルム",
                "author": "――それも一つの性格である――",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノキイのもつ喜悦は、このオルガナイズの情趣の上にある。",
              "citation": {
                "source": "物理的集団的性格",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルガナイズの情趣ともいわるべきものである。",
              "citation": {
                "source": "物理的集団的性格",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがオルガニッシュな構成を目標とするかぎり、関連の情趣はまたオルガナイズの情趣でもある。",
              "citation": {
                "source": "物理的集団的性格",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "情熱の中に秩序を、秩序の中に情熱をもつところのオルガナイズの情趣をその中に見る。",
              "citation": {
                "source": "芸術の人間学的考察",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
        }
