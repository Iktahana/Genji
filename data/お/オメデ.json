        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ギリシアのジオメデス王、その馬に人肉を飼ったが、ヘラクレス奮闘して王を殺し、その尸を馬に啖わしむると温柔しくなったという。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一瞬にツル子の美しさ気高さが骨身にしみこんだというから、見かけによらぬオメデタイ男で、実にもうダラシなく感動してしまった。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「犯人も案外オメデタイ人物なのかね。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑われたろう」「笑われもしなかったな」「オメデタイよ。",
              "citation": {
                "source": "巷談師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりそめにもどちらかにヒイキの態度など見せてはいけませんし、どなたが勝ってもオメデトウも云ってはいけません。",
              "citation": {
                "source": "九段",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "係りの女中だけは最少限度にオメデトウぐらいの表現はしてもよろしい」　この訓辞は賞讃すべきであろう。",
              "citation": {
                "source": "九段",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間というものはゼイタクなもので、結婚式のオメデタに新聞記者が会見を申込むのは自分たちぐらいのものだという結構な身分であるのに、やっぱり新聞記者はウルサイ奴だ、と云って怒っていらッしゃる。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その三　精神病診断書",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリだのヘルシンキだのモロッコだのというところで、そこのアンチャン連が、「ナア、オイ、大戦は遠ざかったぜ」「そいつア、オメデてえな」　といっているときに、かりに日本に小戦がオッ始まっていたぶんには助からない。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「父と同様、あなたもだいぶオメデタイかたのようだわ。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い学者、技師連などは古い書物に書いてある間違いの影響を受けてその誤りを引き継ぎ、今日でもなお甘藍をキャベツ、すなわちタマナと思っているのはまことにオメデタイ知識の持主であって、憐れ至極な古頭の人々である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、オメデトウ！",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "オメデトございます」「あの西洋人誰？",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "精一杯手短かな言葉に代表さしていえば、「お目出度き人」という小説か脚本かを書いた武者小路氏のごとく、皮肉でも反語でもなく、勿論何らの漫罵でもなく、思切って「オメデタイ」ことである。",
              "citation": {
                "source": "文壇昔ばなし",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之、あの小説だか脚本だかを読んでいないでも、武者小路氏及び氏によって代表されているいわゆる白樺派の文芸及び思潮が、本当にオメデタイものであることを言明し得られると思っている。",
              "citation": {
                "source": "文壇昔ばなし",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとはそういう日も一同のイワイだったのが、後にはその空気の外から遣って来て、やたらにオメデトウという者が多く、結局は祝祭日などと言っても、何が祝いなのやら、判らなくなってしまったのである。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　あたりは再び静寂に包まれる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　またしても頭の中に甲高い金属音が鳴り響く。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス20点”“オメデトウゴザイマス　プラス20点”“オメデトウゴザイマス　プラス20点”　しかし敵の宇宙船は巧みに編隊を組み、今度はなかなかレーザー光線が命中しなくなる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス20点”　書斎の安楽椅子に深々と体をうずめながら擬似体験ゲームの世界に没入しているあなたは、塾から帰った小学生の秀夫がこっそり部屋に入って来たのに気づかない。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス５点”　頭の中に金属音が響き渡る。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス10点”　頭の中でまたしても金属音が鳴り響く。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス３点”　ちくしょう、俺はゲーム得点が欲しくて戦っているわけじゃないんだ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス３点”「今度はお前の番だ」あなたは大魔王ミノスを威嚇するようににらみつける。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“オメデトウゴザイマス　プラス20点”　しかしその金属音は頭の中で常に響いているキーンという音に妨害されてよく聞こえない。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（早く、オメデタクなりやがれ！",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "オメデタクなったのである。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "だってディオメデスなんか、ただ一つの文法上の問題で六千巻を一ぱいにしたではないか。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
