[
  {
    "uuid": "b3e4b786-18ba-543c-92c9-6ed0b4af2ceb",
    "entry": "横断",
    "reading": {
      "primary": "おうだん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
