        "examples": {
          "standard": [
            {
              "text": "親の光は七光りというが、本人の努力がなければ意味がない",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "有名俳優の息子で親の光は七光り、彼も同じく俳優志望だ",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "親の光は七光りと言われても、自分の人生は自分で切り開きたいと思っていた",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが、兄にしてみれば、親の光は七光りを感じてそれを有難く思わねばならぬ理由もあるわけで――というのは、身体が弱いため、無試験で会社にはいったことや、その他、上役の人も兄に対しては、特別な見方で接しているということなど――その反面、親の七光りが迷惑に思われることもたくさんあるわけなんでした。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "親の光は七光り、その親が社長だから、特別扱いになっている。",
              "citation": {
                "source": "村一番早慶戦",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ、亀井おばあちゃんも来り、あゝこれも神様のおかげ、親の光は七光りと、喜ぶ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
