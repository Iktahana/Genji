        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と、クロは、ウオウッとひと声ほえるといっしょに、正坊のからだをかるがるとくわえて、あっといううちに、見物人の中をかけぬけて、テントの外へとび出してしまいました。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまた新しい泪をさそって、お艶はオオオオウッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、そのやさき、「オウッ、父上ッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「チェストオウッ！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オ婆チャンハ胃痛カモ知レナイカラ、ツイデニ行ッテ見テ貰オウッテ云ッテルノサ、オ婆チャンノハ神経ダヨ」「ドウセソウニ決マッテマスワ」「君」ト云イカケテ予ハ云イ直ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
