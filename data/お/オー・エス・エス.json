        "examples": {
          "standard": [
            {
              "text": "会社のシステム部門はコスト削減のため、商用ソフトウェアからＯＳＳへの移行を段階的に進めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "このウェブアプリはＯＳＳとして公開されており、世界中の開発者がバグ修正や機能追加に貢献している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「ＯＳＳだからといってサポートが受けられないわけではなく、有償サポートを提供している企業もある」と説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "伊藤氏が、ＯＳＳのパンを、「色も白く軽い風味で、ビフテキなぞの対手にはもって来いである」と評しているが、あの、アメリカ式の、なるほど色は白いが、スカスカと、味もソッケもないパンは、僕は嫌だ。",
              "citation": {
                "source": "駄パンその他",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
