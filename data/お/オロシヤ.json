        "examples": {
          "standard": [
            {
              "text": "江戸後期の漂流民がオロシヤに流れ着き、数年間を過ごした記録が残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "鎖国時代の日本人はオロシヤという国の存在を風聞でしか知らなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "光太夫はオロシヤの女帝エカテリーナに謁見し、帰国を願い出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "彼等はかつてナポレオンをオロシヤに破り、転じては若きエルテルの詩人を伊太利に送り、澆季の今日に於ては純愚利の尊公をも酒倉へ送ろうとする。",
              "citation": {
                "source": "木枯の酒倉から",
                "author": "聖なる酔っ払いは神々の魔手に誘惑された話",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はかつてナポレオンをオロシヤに破り、転じては若きエルテルの詩人を伊太利に送り、澆季の今日に於ては鈍愚利の尊公をも酒倉へ送らうとする。",
              "citation": {
                "source": "木枯の酒倉から",
                "author": "――聖なる酔つ払ひは神々の魔手に誘惑された話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱゲレス船、アメリカ船、オロシヤ船などが、それこそ港を壓してうかんでゐる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
