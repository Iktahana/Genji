  {
    "uuid": "50491b2c-5fc6-5c99-b8b0-bad520ea8f82",
    "entry": "御歳暮",
    "reading": {
      "primary": "おせいぼ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
