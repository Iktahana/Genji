        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "もうお歳暮の時期か、一年が過ぎるのは早いものだね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "忙しいお歳暮の季節を過ぎると、ようやく仕事が落ち着く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「お歳暮の準備はもう終わった？」と母に尋ねられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
