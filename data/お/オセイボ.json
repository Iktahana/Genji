    "definitions": [
      {
        "index": 1,
        "gloss": "year-end gift",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お世話になった取引先へ、今年もお歳暮を贈る手配をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "お歳暮として送られてきたハムの詰め合わせを、家族みんなで分けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "デパートの売り場は、お歳暮を探す人たちで大変混雑していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「私のお母さんなんか、来るたびにちやほやされて、盆暮には家中めいめいにうんとお中元やお歳暮をもらうもんだから、あんな話のわかる御主人はないと言って、有難がっていたものよ。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏中の好下物、盆の贈答に用ふる事、東京に於けるお歳暮の鮭の如し。",
              "citation": {
                "source": "寸情風土記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっかから、お歳暮に福寿草と、雪割草の盆景をもって来た。",
              "citation": {
                "source": "午後",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうもお歳暮ながら訪ねて来て、昼間からあかりのつくまで話して行きました」「はあ、横浜の人達ですか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "化け銀杏",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに庸三は暮に師匠と清川の訪問を受け、何か思いがけないお歳暮まで貰っていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お歳暮に来る人たちの出入りするたびに鳴っていた門の鈴の音も静まって、そのたびにお今に呼ばれて下へ降りて行ったお増は、やっと落ち着いて仲間に加わることが出来た。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "水引きのかかったお歳暮が階下の茶の間に堆く積まれてあった。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな縁起棚の傍には、つい三四日前の酉の市で買って来た熊手などが景気よく飾られて、諸方からの附届けのお歳暮が、山のように積まれてあった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親は木工場からもらつたボオナスが少し多かつたので、お歳暮をきばつたのだつたが、若い時分から馬気違ひなので、競馬好きの木山とうまが合つてゐた。",
              "citation": {
                "source": "のらもの",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "寥平さんのおかげで、炊事具少々、端書六十枚、其他こま／″＼したものを買ふ、お歳暮を持つて千体仏へ行く、和尚さんもすぐれた魂で私を和げて下さつた。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった二人の女が笑ったとてつれない世間に遠慮は無用だ私達も街の人達に負けないで国へのお歳暮をしましょう。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はなつかしい木箱の匂いを胸に抱いて、国へのお歳暮を愉しむ思いだった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった二人の女が笑ったってつれない世間に遠慮は無用だ私達も街の人達に負けないで国へのお歳暮をしましょう鯛はいゝな甘い匂いが嬉しいのです私の古里は遠い四国の海辺そこには父もあり母もあり家も垣根も井戸も樹木も……ねえ小僧さん！",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は食物の持つ、なつかしい木箱の匂いを胸に抱いて、国へのお歳暮を楽しんだ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達も街の人に負けないで国へのお歳暮をしませう。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "林町の父にお歳暮に母のかたみの着物でどてらを縫って貰っていたのが出来上り。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、肴町まで行き、それぞれお歳暮のものを買ってしまう。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が入社した五、六年は、まだ大隈伯が頗る元気で、毎年暮れになると社の会議室へ姿を現わし、社員を集めて一場の訓話を施す例になっていたが、大隈さんが来社するほんとうの用向きは、報知新聞から毎年定まって贈るところの金十万円のお歳暮を取りにくるのであるという話であった。",
              "citation": {
                "source": "入社試験",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親のもとへとお歳暮のしるしにお弟子が持つて来る砂糖袋や鰹節なぞがそろ／＼床の間へ並び出した。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親のもとへとお歳暮のしるしにお弟子が持って来る砂糖袋や鰹節なぞがそろそろ床の間へ並び出した。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……」　親方は昨夜夜明かしでこいつを彫り上げ、大そう出来がよかったといって上機嫌で最前お歳暮にでていったものを。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "感化院で教はつたのか、假名くらゐは書けるらしいので、私は、お歳暮に書店から貰つた日記帳をやると、しよつちゆうそれを懷ろに入れて、時々鉛筆で何か書いてゐるやうであつた。",
              "citation": {
                "source": "吉日",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "気は心だからあの児へ何かお歳暮をやらなくちゃあ……女の子達には出ず入らずで一様に羽子板がいいけれど、腕白にはやはり破魔の弓かしら？",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのお喜びにお歳暮のとりやりも立消えとなりしその代はり、おしめの詮索、玩具の買ひ入れ、御余念もなきその内に、年も明けお枕直しも済みて、奥様は従前の通り御出勤。",
              "citation": {
                "source": "今様夫婦気質",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはことしのお歳暮にさし上げましょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "島田へはこのお歳暮にさしあげましょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "おせいぼはもうスタンドにきめてあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの日は富士見町、四谷の病院とおせいぼやお礼にまわって、島田のお母さんのものを買ったりして、林町へまわり、うちへ電話かけたらデンポーだとよんでくれたので、すぐありあわせの毛筆でかいたのでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "寿江子がこの歳は私の一番ほしいものが手に入らなくているのに同情して、珍しくおわんだのお茶碗だのをおせいぼにくれました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "では又おせいぼの手紙は別に。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "end of the year",
        "register": "standard",
