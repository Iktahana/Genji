        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「中大兄」は、考ナカツオホエ、古義ナカチオホエ、と訓んでいる。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "またイナビの大郎女の妹、イナビの若郎女と結婚してお生みになつた御子は、マワカの王・ヒコヒトノオホエの王です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またヤマトタケルの命の曾孫のスメイロオホナカツ彦の王の女のカグロ姫と結婚してお生みになつた御子は、オホエの王です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "オホタラシ彦の天皇がこのカグロ姫の命と結婚してお生みになつた御子はオホエの王のお一方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天皇、オホエの王の女のオホナカツ姫の命と結婚してお生みになつた御子は、カゴサカの王とオシクマの王お二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天皇、葛城のソツ彦の女の石の姫の命（皇后）と結婚してお生みになつた御子は、オホエノイザホワケの命・スミノエノナカツの王・タヂヒノミヅハワケの命・ヲアサヅマワクゴノスクネの命のお四方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
