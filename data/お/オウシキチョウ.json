          "standard": [
            {
              "text": "黄鐘調は最も格式高い雅楽の調べである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "黄鐘調の曲は皇帝の重要な式典で演奏された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "黄鐘調を習得することは雅楽師の必須科目だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "黄鐘調の掻き合わせに美しい音を出しておいでになる時、夫人は好きな音楽であったから、恨めしいふうばかりはしておられず、小さい几帳の横から脇息によりかかって少し姿を現わしているのが非常に可憐に見えた。",
              "citation": {
                "source": "源氏物語",
                "author": "宿り木",
                "note": "青空文庫"
              }
            },
            {
              "text": "音には御承知の通り、宮商角徴羽などの幾通りもございます、また双調、盤渉調、黄鐘調といったような調子もいろいろございます、それをわたくしは聞きわけるのが好きでございます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "小名路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
