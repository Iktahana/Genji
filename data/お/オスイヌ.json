        "examples": {
          "standard": [
            {
              "text": "近所の公園で、元気なオス犬と散歩している人を見かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "うちで飼っているオス犬は、とても人懐っこい性格だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ドッグランで、他のオス犬と仲良く遊ぶ姿が微笑ましい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "たくましかった虎毛“百”　奈良田部落の調査を終えて、それから高山、トノコヤ峠を越えて芦安村に出るため、深沢さんという猟師に道案内を頼みましたが、この人の連れていた虎毛八カ月のオス犬が実に名犬でした。",
              "citation": {
                "source": "私の飼った犬",
                "author": "斎藤弘吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
