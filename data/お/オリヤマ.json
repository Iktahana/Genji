        "examples": {
          "standard": [
            {
              "text": "プリーツスカートの折り山がきれいに出るよう、当て布をしながらアイロンを丁寧にかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "型紙の折り山の線に沿って布を折り返し、しつけ糸で仮止めしてから本縫いに入る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "スーツのズボンをクリーニングに出したら、折り山のクリースがくっきり戻ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "さて、この文字面を表にして、一番上の水平点線を山折り、順に谷折り山折りして、一番下の水平点線まで蛇腹に折り畳み、細長い短冊にします。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
