    "definitions": [
      {
        "index": 1,
        "gloss": "to push aside",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "茂みを両手で押し分けて、ようやく洞窟の入り口を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "混雑した雑踏の中を、前の人の肩を押し分けながら進む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "厚いカーテンを押し分けて、部屋に差し込む朝日に手をかざした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "彼女は人の肩を押し分けるようにしながら、尾張町の停留所の方へ歩いた。",
              "citation": {
                "source": "指",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけにこの楽屋はちっとも風がはいらないんだからね」　お辰は病める太夫の枕もとをそっと離れて、楽屋のうしろに垂れている荒筵を少し押し分けると、夕日の光りはもう山の手の高台に隠れて、下町の空は薄い浅黄色に暮れかかっていた。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄扇をうけた位で、生血が垂れているとは少し奇怪じゃな」　勃然として大きな不審が湧き上がりましたので、うろたえ騒いでいる人々を押し分けると、構わずにずいと死骸の傍らへ近よりました。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "源宰相中将も来ていて、平生と違って気軽に女房などとも話しているのを、ほかの女房たちが、「やはり出抜けていらっしゃる方」　とも評していた時に、近江の君は女房たちの座の中を押し分けるようにして御簾の所へ出ようとしていた。",
              "citation": {
                "source": "源氏物語",
                "author": "真木柱",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は急いで、よくこれまでそれを見て嘲笑ったりした、顔じゅうを繃帯して、二つの穴から眼玉だけ出している乞食の老婆の立ちならんでいる間を押し分けるようにして、伽藍へ駆けつけるなり、堂内へ飛びこんだ。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "風に捲き落された煙が下甲板一パイに漲っていたが、その中で二等運転手が、突然に鋭い呼子笛を吹くと、待ち構えていたらしい人影がそこここから、煙を押し分けるようにして出て来た。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の身体はその群衆の中を、水をでも押し分けるように容易く、通りぬけてゆきました。",
              "citation": {
                "source": "水甕",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "木の枝を押し分けると、赤い窓帷を掛けた窓硝子が見える。",
              "citation": {
                "source": "冬の王",
                "author": "ハンス・ランド　Hans Land",
                "note": "青空文庫"
              }
            },
            {
              "text": "足と膝との二重の障害を押し分ける。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "初さんは煙の中を押し分けるようにずんずん潜って行く。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾思う人の為めにと箸の上げ下しに云う誰彼に傚って、わがクララの為めにと云わぬ事はないが、その声の咽喉を出る時は、塞がる声帯を無理に押し分ける様であった。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い草を押し分けるようにして、連翹色のオローシカが咲いている。",
              "citation": {
                "source": "犂氏の友情",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ人を押し分ける様子はなくて、どこにもひどい混雑は起りませんね。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "無理やり風の隙きを押し分けるようにして、ヒョロヒョロ進んでも、呼吸が続かない。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気を押し分けるように暗い人影があらわれて来た。",
              "citation": {
                "source": "日の果て",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処には小網町や小舟町辺の掘割と全く趣の違った、幅の狭い、岸の低い、水の一杯にふくれ上っている川が、細かく建て込んでいる両岸の家々の、軒と軒とを押し分けるように、どんよりと物憂く流れて居た。",
              "citation": {
                "source": "秘密",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、まもなく、下のほうから一人の娘が、霧を押し分けるようにして、こちらへ登って来た。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は群集の列を押し分けるようにして前へ出ていった。",
              "citation": {
                "source": "早稲田大学",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "藪をおしわける音がして、現われたのはイスラエルのお町で、もう一度呼んだが答えがなかった。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その原ッぱを登ったり沈んだり、おしわける萱の葉に首をさされたり、棟梁の身内が近よっていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻に黒山を築いた、が北風の通す、寒い背後から藪を押分けるように、杖で背伸びをして、「踊っとるは誰じゃ、何しとるかい。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆スバラシイ大木ばかりで、しかも、切って落したような絶壁の中途に、岩の隙間を押分けるようにして生えているのだそうですから、猿でも使わない事には、トテモ危険で近寄れない訳です。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　根室の水上署員が、弥次馬達を押分けるようにして惨劇のその場に駈けつけたのは、それから三十分もあとの事だった。",
              "citation": {
                "source": "動かぬ鯨群",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "深い笹を押分ける苦しさにいつとなく下りに向った脚元が急に明るくなって、右の方に大谷が口を開いていると気が付いた折などは、慌てて上の方へ引返したりした。",
              "citation": {
                "source": "秋の鬼怒沼",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷えちまうじゃないかね……」　与平はさからう水を押しわけるようにして、左右に大きく躯をゆすぶりながら、水ぎわに歩いて来た。",
              "citation": {
                "source": "河沙魚",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども先方はまっすぐに近よって来、突然、霧を押しわけるようにして、源太の眼の前にあらわれ、その大きな舳先を源太の機械船の横腹へ突っかけた。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "草をおし分けるばさばさという音が消えたので、谷間の静かさがごッと襲ったのであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
