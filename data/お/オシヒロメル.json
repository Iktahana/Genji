        "examples": {
          "standard": [
            {
              "text": "彼は自分の事業の範囲を、隣の町まで押し広めることに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その新しい技術の普及を、全国規模で押し広めるためのキャンペーンが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は自身の活動の場をSNSを通じて、海外へも押し広めようとしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "技芸習得の道程にある者に対しては、それは一つの良い教訓に相違ないが、それを全般に押し広めることは不聡明である。",
              "citation": {
                "source": "演出",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
