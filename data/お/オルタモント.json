          "literary": [
            {
              "text": "一九六九年一二月六日、カリフォルニアのオルタモント・レースウェイで、ローリング・ストーンズが無料のコンサートをひらいた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "このオルタモントのコンサートが失敗した原因は、さまざまにあげられている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウッドストックでは、ステージのマイクは全員のコミュニケーションのために用いられたのだが、オルタモントでは、ステージから客を統制し命令する一方的な伝達にしかつかわれなかった、というのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
