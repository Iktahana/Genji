    "definitions": [
      {
        "index": 1,
        "gloss": "kitchen maid",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お三どんという言葉は、様々な文脈で用いられる重要な表現である。",
              "source": "幻辞"
            },
            {
              "text": "彼はお三どんの意味について深く理解していた。",
              "source": "幻辞"
            },
            {
              "text": "お三どんを正しく使用することで、より自然な日本語の表現ができる。",
              "source": "幻辞"
            },
            {
              "text": "この文献ではお三どんという概念が中核的な役割を果たしている。",
              "source": "幻辞"
            },
            {
              "text": "お三どんの用例は、古典文学から現代文まで幅広く見られる。",
              "source": "幻辞"
            },
            {
              "text": "日本語学習者にとって、お三どんは習得すべき重要な表現の一つである。",
              "source": "幻辞"
            },
            {
              "text": "文化的背景を考慮すると、お三どんの意味がより明確に理解できる。",
              "source": "幻辞"
            },
            {
              "text": "お三どんと同義語の使い分けについては、細かい注意が必要である。",
              "source": "幻辞"
            },
            {
              "text": "学術的には、お三どんは複数の関連する意味を持つことが知られている。",
              "source": "幻辞"
            },
            {
              "text": "口語表現において、お三どんはしばしば省略形で用いられる。",
              "source": "幻辞"
            },
            {
              "text": "お三どんの語源を追うと、興味深い言語史の一部が見えてくる。",
              "source": "幻辞"
            },
            {
              "text": "現代の日本語では、お三どんの使用頻度は比較的高い傾向にある。",
              "source": "幻辞"
            },
            {
              "text": "医学や科学の分野では、お三どんが特定の技術用語として定義されている。",
              "source": "幻辞"
            },
            {
              "text": "お三どんを含む表現は、詩歌や文学作品で特に効果的に使われることがある。",
              "source": "幻辞"
            },
            {
              "text": "会話の文脈によって、お三どんのニュアンスが微妙に変わる可能性がある。",
              "source": "幻辞"
            },
            {
              "text": "辞書によっては、お三どんに複数の定義が記載されている場合もある。",
              "source": "幻辞"
            },
            {
              "text": "お三どんの使用は、特定の社会階層や世代と関連していることもある。",
              "source": "幻辞"
            },
            {
              "text": "言語学的分析により、お三どんの文法的性質が明らかになっている。",
              "source": "幻辞"
            },
            {
              "text": "お三どんは、日本語能力試験などの言語試験でも重視される語彙である。",
              "source": "幻辞"
            },
            {
              "text": "同じ意味でも、お三どんの代わりに別の表現を選ぶことで、印象が変わる。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "私はお三どんだよ、箒を一つ貸して頂戴。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥満のお三どんが、ぶっちょう面をしゃあがって、旦那様とか、先生とかお言いなさい、御近所へ聞えます、と吐しただろうじゃねえか。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お三どんのようだと云っては、可哀そうであろう。",
              "citation": {
                "source": "花子",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜に人影がなくなって、海松ばかり打上げられる、寂しい秋の晩方なんざ、誰の発議だったか、小児が、あの手遊のバケツを振提げると、近所の八百屋へ交渉して、豌豆豆を二三合……お三どんが風呂敷で提げたもんです。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「親方本当でございますね、酒の値は上りまさ、食る物は麺麭の附焼、鰻の天窓さ、串戯口でも利こうてえ奴あ子守児かお三どんだ、愛ちゃんなんてふざけやあがって、よかよかの飴屋が尻と間違えてやあがる、へ、お忝。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へい、只今……」　とお糸さんが矢張下女並の返事をして、「お三どん新参で大狼狽……」　と私の面を見て微笑しながら、一寸滑稽た手附をしたが、其儘｜所体崩して駈出して、表梯子をトントントンと上って行く。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "然う然う、お三どん新参で大狼狽といって微笑……偉い！",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを常談事にして了って、お三どん新参で大狼狽といって微笑……偉い！",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「変な事いうネ、おれの女房は三年前に死んだし、娘は持たず、お三どんだッて置かないのはお前も知ってる通りだろうじゃないか」。",
              "citation": {
                "source": "権助の恋",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもお三どんの仕事をするやうな事はむしろ得意であるから、平日はそれでよしとして別に備はるを求めなかつたが、一朝一家の大事が起つて、即ち主人が病気になるといふやうな場合になつて来た処で、忽ち看護の必要が生じて来ても、その必要に応ずることが出来ないといふ事がわかつた。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "お三どんのやうだと云つては、可哀さうであらう。",
              "citation": {
                "source": "花子",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "お本店へ務めて荷作りをしたり、物を持ってお顧客様へお使いをしたり、番頭さんに睨まれたり、丁稚に綽名を付けられたり、お三どんに意地悪くあたられることは、どうにも私の嗜好に合わない。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "へい、私は仙介という者で」　などお三どんや仲働きや、庭掃きの爺やにまで愛嬌を振り撤いた。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ご用聞きには惜しいわね」などとお三どんは仙介のことを、仲働きへ噂したりして、仙介の評判は来た日から良かった。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで勝手口でお三どんを相手に、油を売っていた仙介であった。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな無性なお三どんでも決していきなり桶をネジの口へ当てて昨夜の溜り水を使うような事はしない。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おさんどんですか。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "撫子　いいえ、いま思知ったんです、まったく罰が当りますから、私を可哀想だとお思いなすったら、このお邸のおさんどん、いくや、いくや、とおっしゃってね、豆腐屋、薪屋の方角をお教えなすって下さいまし。",
              "citation": {
                "source": "錦染滝白糸",
                "author": "――其一幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさんどん見たいに頬ペタばかり赤くしやがって……」　なぞと寄ってたかって笑い物にした。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたはおさんどんになるという事を想像してみる事ができますか。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさんどんという仕事が女にあるという事を想像してみる事ができますか。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさんどんの仕事もろくろくできはしないくせによけいな所に出しゃばるもんじゃない事よ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "・いつまで生きることのホヤをみがくこと・ひとりをれば蟻のみちつづいてくる・草の青さできりぎりすもう生れてゐたか・胡瓜植ゑるより胡瓜の虫が暑い太陽　風ふくゆふべのたどんで飯たく（追加）　五月十一日雨、五時には起きておさんどんの仕事。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・風のトマト畑のあいびきで　やうやう妻になりトマトもいでゐる　　　　□　虫がこんなに来ては死ぬる　八月三十日風が落ちておだやかな日和となつた、新居三日目の朝である、おさんどんと坊主と、そして俳人としてのカクテル。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そういって女中を――台所働きの女中をおさんどんと呼ぶころだった。",
              "citation": {
                "source": "木魚の顔",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の多助の気の利くことは、主人の用向ばかりでなく、番頭から小僧から、家へ出入る者一同から、おさんどんにまでも宜く勤めますが、決しておべっかでするのではなく、信実に致しますので、番頭が肩が張ったと云えば直ぐに後へ※って打きます。",
              "citation": {
                "source": "鹽原多助一代記",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "賄は七八人以下の団体稼ぎの時分には廻りコックにて、これにも初めは極く閉口したが今では仲々｜下手なおさんどんなどはだしだよ。",
              "citation": {
                "source": "新らしき祖先",
                "author": "相馬泰三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに、さいぜん食傷新道で見た行列は、おさんどんや、山猿連のようだが、これは見ていると、しかるべき身上の奴が多い。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけにとうとう堪忍ぶくろの緒が切れたとして（たとえばスープの中に何か変てこなものがはいっていたのでもいい――）、そこでそのおさんどんを怒鳴りつけてでもみたまえ。",
              "citation": {
                "source": "真珠の首飾り",
                "author": "ZHEMCHUZHNOE OZHERELJE",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその時、秤杆へ吊るさげたメリケン樽のなかから、おさんどんのアクシーニヤの血色のいいハチきれそうな豚づらが、ぬうっとのぞいた。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
