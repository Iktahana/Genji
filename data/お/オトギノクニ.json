        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "まるで御伽の国に迷い込んだような、美しい庭園だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この風景を見ていると、御伽の国にいるような気分になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "夢の中で御伽の国を旅した思い出が、今も鮮明だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "おとぎの国へきたアリスのような気がするポコちゃんだった。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、あの夏の日に私が眺めたときのように遠望すれば、そこは靄と夢で出来たおとぎの国の都である……。",
              "citation": {
                "source": "橋の上で",
                "author": "ON A BRIDGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいしい西洋菓子もつくってくださる……まるでおとぎの国へ行くかのような大はしゃぎ。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "メグが、「まるで、おとぎの国みたいねえ。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の日の午後も遅く、おとぎの国のような黄金の光のただ中を、バスがパーカタックを横切りロードアイランド州に入る時、彼の胸は高鳴った。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "全てを忘れて、信じましょう、ここはおとぎの国で、あなたは王子様……」　こうヴィラが言いながら、テーブルに席を取った。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
