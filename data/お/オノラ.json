        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "頭を囘らして右のほうを望むと、サント・マルグリット島とサント・オノラ島が、波のうえにぽっかり浮び、樅の木に蔽われたその島の背を二つ見せている。",
              "citation": {
                "source": "初雪",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレオノラ・ドウゼと交る。",
              "citation": {
                "source": "リルケ年譜",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、例しにあの人の前で、エレオノラ・ドゥーゼでも褒めてごらんなさい。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラウラマルホルムは彼女の著述の中に天才エレオノラデユーゼ、大数学者兼著述家ソニヤコワレフスカイヤ、夭死せる詩人風の芸術家マリイバシユカアトセフの如き世界的名声を有する天賦ある数人の運命に就て語つてゐる。",
              "citation": {
                "source": "婦人解放の悲劇",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めてこの時ヘルマン・バアルはエレオノラ・デュウゼの蒼白い、弱々しげな、力なげな姿を見たのである。",
              "citation": {
                "source": "エレオノラ・デュウゼ",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレオノラの初舞台は一八六一二年、彼女が四歳の時であった。",
              "citation": {
                "source": "エレオノラ・デュウゼ",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "露都の一夜、なつかしきエレオノラのために狂舞したヘルマン・バアルはかくして世評に対する彼の論理的欲望を充たした。",
              "citation": {
                "source": "エレオノラ・デュウゼ",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "偉大なるエレオノラ・デュウゼ。",
              "citation": {
                "source": "エレオノラ・デュウゼ",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの皮肉なバアナアド・ショオをして心からの讃美と狂喜とをなさしめたエレオノラ・デュウゼ。",
              "citation": {
                "source": "エレオノラ・デュウゼ",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレオノラ・デュウゼのことば。",
              "citation": {
                "source": "エレオノラ・デュウゼ",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、エレオノラ・デュウゼ。",
              "citation": {
                "source": "エレオノラ・デュウゼ",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
