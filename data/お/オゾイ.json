        "examples": {
          "standard": [
            {
              "text": "昔の道具は作りがおぞいが、頑丈で長持ちする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "そんなおぞい作りのおもちゃでは、すぐに壊れてしまうだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "職人から見れば、この製品は非常におぞい仕上がりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "や、おぞいな千太、われ、えてものを見て逃げたな。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「久し振りでこういうところは珍らしいものだから」　葛岡はおぞい調子でこう言訳します。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
