    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「オヤ、負けん気だよ」、「怒つてるよ」と女給は思ふ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤッ」と私は思った。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "新屋のオヤヂは、相変らず足が良くないようだし、どうです、おかみさん」　と、大山は気持にゆとりができたので、まぜっかえした。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その事を云いだすと二人の子供も「オヤ、ほんとにそうだ」と云って同意したから、強ち自分だけの錯覚ではないらしい。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩年大学蹴球部の部長をつとめていたが、部の学生達は君を名づけて「オヤジ」と云っていた。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤ、オバの訛りか、などと当てずつぱうしてみたつてはじまらない。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "春宵一刻、――」などと、つまらぬ事を呟きながら木の虚から這ひ出ると、オヤ　ナンデセウ　サワグコヱミレバ　フシギダ　ユメデシヨカ　といふ事になるのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサデス　ツユノ　ヒカルミチコブヲ　トラレタ　オヂイサンツマラナサウニ　ホホヲ　ナデオヤマヲ　オリテ　ユキマシタ　瘤は孤独のお爺さんにとつて、唯一の話相手だつたのだから、その瘤を取られて、お爺さんは少し淋しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　実に、気の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　毎日毎日、雪が降り続ける。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　お爺さんにとつて、こんな、がむしやらな情熱を以て行動するのは、その生涯に於いて、いちども無かつたやうに見受けられた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　まさか、これを口に出して歌ひながら捜し歩いてゐたわけではない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサデス　ツユノ　ヒカルミチコブヲ　トラレタ　オヂイサンツマラナサウニ　ホホヲ　ナデオヤマヲ　オリテ　ユキマシタ　瘤は孤獨のお爺さんにとつて、唯一の話相手だつたのだから、その瘤を取られて、お爺さんは少し淋しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　實に、氣の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　毎日毎日、雪が降り續ける。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　まさか、これを口に出して歌ひながら搜し歩いてゐたわけではない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オヤ、田川さん。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オヤそう、お上がんなさいよ、でも未だ十時が打たないでしょう。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            }
          ]
        }
