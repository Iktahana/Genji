[
  {
    "uuid": "98ae50b4-9133-5993-b042-255be0dafd40",
    "entry": "お召し物",
    "reading": {
      "primary": "おめしもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
