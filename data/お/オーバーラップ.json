          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "二つのプロジェクトの期限がオーバーラップしているので、リソースを調整する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オーバーラップする領域に関しては、両チームが協力して対応する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "映像の編集でオーバーラップトランジションを使用して、滑らかなシーンチェンジを実現した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
