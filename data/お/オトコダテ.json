    "definitions": [
      {
        "index": 1,
        "gloss": "chivalrous spirit",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人助けのためにあえて喧嘩に首を突っ込むなんて、まさに男伊達だな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "弱きを助けるという男伊達を貫き通す彼の姿は、今の時代には珍しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "周囲から煙たがられても気にしない、彼の不器用な男伊達が僕は好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「江戸の花」には、命をも惜しまない町火消、鳶者は寒中でも白足袋はだし、法被一枚の「男伊達」を尚んだ。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の江戸時代の男伊達とかいうものに、ちょっと似ているところがあったようです。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂は照る照るでも地名だけを変えて歌われたり、男｜伊達なら千ヶ崎沖の潮の早いのを留めて見よという大島のがっしゃがしゃが節が、小笠原の父島では八丈のしょめ節で男伊達ならワントネの岬の潮のながれを留めて見なという風に転化されて、それが小笠原特有の歌のように思われたりします。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "男伊達が起つてきてからの社會では金がなければ、中々道理もひつこむ世の中なのだから、勢ひ、講談などできいても惡い親分が多い。",
              "citation": {
                "source": "凡愚姐御考",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のいふ意味の、女親分、姐御の起つたはじめは――もとよりそれより前にも似た職分はあつたであらうが――男伊達、奴立から來てゐる。",
              "citation": {
                "source": "凡愚姐御考",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下に名を轟かして味噌を上げたいと心がけたすえ、まず兵法を習ったが失敗して、書を学んで成らず、つぎに役者を志したはいいが、たった初日一日が一世一代の冷飯に終ったので、今度は男伊達を真似たものの、似た山と嘲られて色事師に転じた。",
              "citation": {
                "source": "仇討たれ戯作",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中を、男伊達風の連中が、隊を組んでねり歩いていた。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "任侠とか、仁義とか、男伊達とかいうものとはちがっていたからである。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男伊達も、江戸へ来てから、風俗だの精神は大いに変化したが、江戸の町から発生した生え抜きではない。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "剣を度胸で使う男伊達一流の早技だ。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……男だてなら、あの木曾川の、で、留めて見ると言ったって、水の流は留められるものではない。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを燒いて二十｜食つた、酢にして十食つたと云ふ男だて澤山なり。",
              "citation": {
                "source": "寸情風土記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして終りの言葉は男だてらに「どうかね蝶子、済まないとは思うが、いつまでも僕を捨てないでね」というのであった。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがすむとお君が行水し、安二郎は男だてらにお君の背中を流した。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが済むと、お君が行水し、安二郎は男だてらにお君の背中を流した。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "）さて二号室は「歌姫」と呼ばれ、いい髯面の男だてらに女の着物を着て可憐なソプラノを張りあげ、発狂当時覚えたものであろう古臭い流行歌を夜昼なしに唄いつづけては、われとわが手をバチバチ叩いてアンコールへの拍手を送り、送ったかと思うとケタケタと意味もなく笑い出したりした。",
              "citation": {
                "source": "三狂人",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、歌六の印象が薄れると共に、近年は、頗江戸の男だての颯爽としたものに傾いて来たやうである。",
              "citation": {
                "source": "実川延若讃",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "……全体仙太公と言う男は因果な男だて。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全体……仙太公という男は因果な男だて。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "表向き、狭斜の巷で、幇間（たいこもち）めかした業をやっていたが、喧嘩出入りが好きで、一面、男だて肌な風もある。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "柄の長い大小を突出し、二本のから脛と、二本のこじりを突っ張って歩く男だての姿から来た町の綽名なのである。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "市井の事々は複雑だが、その中を、単純に生きようというのが、男だてである。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "（この人は偉い）　と思うと、こういう持前の男だては、一本槍に惚れこんでゆく。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "ruffian who acts under the pretence of chivalry",
