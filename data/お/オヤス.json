        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミナサン、ゴキゲンヨクオヤスミナサイマセを云ったあとですよ。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は充分に満足すると、残される女のことなど眼中になく立上つて、それでも、オヤスミとだけ言つて立ち去つた。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "対馬をあるいている時に始めて気がついたのだが、夜分別れる折の常の辞令に、我々がオヤスミまたはオシズカニという所を、かの島ではオイザトナという語がまだ使われている。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが十時弥君の話を聴くと、筑後柳河でも上流の士分の家では、子供のオヤスミナサイが定まってオイザトウであったそうだ。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤス　大豆の「もやし」、地方によつては夙くから之を食料にし、從つて育成の方法もよく研究せられて居た。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹿兒島縣肝屬郡などでオヤスといふのも、モヤシの音變化ではあらうが、同時に豆を併せてこの物を作る行爲をもオヤスと謂つて居て、二つの動詞の元は一つであつたことを心づかせる。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤス　大豆の「もやし」、地方によっては夙くからこれを食料にし、従って育成の方法もよく研究せられていた。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹿児島県｜肝属郡などでオヤスというのも、モヤシの音変化ではあろうが、同時に豆を併せてこの物を作る行為をもオヤスといっていて、二つの動詞の元は一つであったことを心づかせる。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
