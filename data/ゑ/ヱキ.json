        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "湿布する度に、ヱキシカを塗る毎に入雲洞をおもふ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱキのポストまで、――やつと行つてきた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "国頭方面の鼠の異名にもヱキというのがあり、そのヱキは島尻のオエカと同じく、血筋の続きを表示する語だったかと思われる。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃のすばらしい横濱のヱキゾチツクな夜景や平和な町々の散景は、シヤボン玉みたいに行方も知れないが、生れた土地の土への執着と幻想は妙なものである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして当てはめて行くと、アスヰチジシンバシヱキ　となる。",
              "citation": {
                "source": "黒手組",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
