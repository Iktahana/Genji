        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "融はそれから又一旦部屋へかへつて、下へ電話をかけて、会計と自動車を頼んでから、外套や衿巻をして、力ぬけのした足で、ヱレベータの乗り場へ出て行つた。",
              "citation": {
                "source": "折鞄",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　青木はビールデイングのヱレベータアを昇つて、四階のホールへ入つて見た。",
              "citation": {
                "source": "二つの失敗",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ヱレベータアを出て、踊り場へ入つていくと彼はいつでも憂鬱を感じた。",
              "citation": {
                "source": "二つの失敗",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木はヱレベータに乗つた。",
              "citation": {
                "source": "二つの失敗",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "永平本山では、ヱレベーターは出来ても、また、水流し式の便所が出来ても、行持は綿々密々でなければならない、それが曹洞禅の本領である。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある朝、洛陽ホテルのヱレベーターの入口で、ふと、すれちがつた紋服袴の人に眼をみはる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "井口海仙氏と、ヱレベーターの入口での、お見それ話しに興じあふ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
