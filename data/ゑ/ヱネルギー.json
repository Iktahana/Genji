          "literary": [
            {
              "text": "我等がヱネルギーと称するものはその結果として生じて来る。",
              "citation": {
                "source": "運命と人",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してヱネルギーが働いてゐる間我等の間には生命が厳存する。",
              "citation": {
                "source": "運命と人",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しながら安定を求めて安定の方に進みつゝある現象が遂に最後の安定に達し得た時には、ヱネルギーは存在するとしても働かなくなる。",
              "citation": {
                "source": "運命と人",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            }
          ]
