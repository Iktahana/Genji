        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……午後は畑を中耕施肥した、トマトよ、茄子よ、胡瓜よ、伸びよ、ふとれよ、実れよ（人間はヱゴイストですね！",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝉捕の児が三々五々やつてくる、うれしくもあればうるさくもある、私はやつぱり薄つぺらなヱゴイストだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "□作者は作者である限りヱゴイストであつてよい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつぱり人間はヱゴイストだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "作画上ではかなりに強烈なヱゴイストなのである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術の究極目的は、作者が作画上でヱゴイストになることではない。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
