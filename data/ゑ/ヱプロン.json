        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お孃樣これめせと、乳母ならむ走り來て捧ぐるを、曰く、ヱプロン掛けて白魚の料理が出來ますかと。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女のヱプロンが恐ろしい程白かつた。",
              "citation": {
                "source": "幻想",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見詰めてゐた白いヱプロンは然し黒いしみになつて、暫らくは眼の前をちら／＼として離れなかつた。",
              "citation": {
                "source": "幻想",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして脣からヱプロンなどまで黒紫の色に染めては母親に叱られた。",
              "citation": {
                "source": "たべものの木",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "商店の中で、シャツ、ヱプロンを吊した雑貨店、煎餅屋、おもちゃ屋、下駄屋。",
              "citation": {
                "source": "寺じまの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
