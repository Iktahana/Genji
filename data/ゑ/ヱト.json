        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大久保がベヱトベンのシムホニーなぞのレコードを買つたのも、奈美子が音楽好きだからであつた。",
              "citation": {
                "source": "彼女の周囲",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コノ　タケノコハ　オホキク　カタク　ナツタ　トキ、リツパナ　ヨコブヱト　ナリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し少しでも変つてゐるとすれば、それは一面にスレヱトの屋根や煉瓦の壁の落ち重なつた中に藜の伸びてゐるだけだつた。",
              "citation": {
                "source": "ピアノ",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "只けふはそれ等は勿論、崩れ落ちた煉瓦やスレヱトも秋晴れの日の光にかがやいてゐた。",
              "citation": {
                "source": "ピアノ",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつと気のついた栗の木はスレヱトの屋根に押されたまま、斜めにピアノを蔽つてゐた。",
              "citation": {
                "source": "ピアノ",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱトリを早く云ひて、云ひゆがめてヱタと云へり。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱトリを略せるなり。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱトリをはやくいひて、いひゆがめてヱタと云へり。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱトをヱタと云ふなり。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            }
          ]
        }
