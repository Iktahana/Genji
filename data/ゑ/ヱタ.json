        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スヱターを売る店なぞへ立寄つてから、一行はＭ君と別れた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あだねつき染め木が汁に染め　衣を……（シムルトコロノ衣シメタル衣）上つ毛野いかほの沼に栽ゑ　小水葱……（ウヽルトコロノ小水葱ウヱタル小水葱）右の例における接続点は、前代の文法及び、其形式を襲ふものでは問題にならないが、やはり次第に、整頓せられて来る。",
              "citation": {
                "source": "形容詞の論",
                "author": "――語尾「し」の発生――",
                "note": "青空文庫"
              }
            },
            {
              "text": "此地の口碑によれば、昔はヱタに長利派、八矢、中間の三種族あつたが、後に皮田といふ一種族新に起り、専ら獣類の皮を取り扱ふ様になつた、云云。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "日蓮とほぼ時代を同じゅうした「塵袋」に、キヨメをヱタといふは如何なる詞ぞ。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱトリを早く云ひて、云ひゆがめてヱタと云へり。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを非人・カタヒ・ヱタなど、人まじろひもせぬ同じ様の者なれば、まぎらかして非人の名をヱタにつけたるなり。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "生物を殺して売るヱタ体の悪人なり。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも「旃陀羅考」に引いた鎌倉時代の「塵袋」（五）に、キヨメをヱタと云ふは如何なる詞ぞ　穢多根本は餌取と云ふべき歟。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱトリをはやくいひて、いひゆがめてヱタと云へり。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱトをヱタと云ふなり。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "其れを非人・カタヒ・ヱタなど、人まじろひもせぬおなじさまのものなれば、まぎらかして非人の名をヱタにつけたる也。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
