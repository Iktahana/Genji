          "literary": [
            {
              "text": "昔母山羊あり、子七つ持てり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "母山羊帰りて之を聞き、途に眠り居る狼の腹を割きて、尚生き居たる、食われし六つの子を、取り出だし、代りに石を入れ置きしに、狼は之を知らず、目覚めて後、水を呑まんとて、井に行きしが、石の重さに絶えず、水中に陥りて死す。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま、おじさんのつれている山羊は母山羊で、おなかに大きなお乳をぶら下げているのが、すぐ目につきます。",
              "citation": {
                "source": "柿の木のある家",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
