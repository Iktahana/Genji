        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼のスピーチの冒頭の発語は、聴衆の注意を一瞬で引きつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "教師は、子供たちに基本的な挨拶の発語を教え込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「始めましょう」という発語とともに、会議が開始された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
