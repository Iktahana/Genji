[
  {
    "uuid": "19c3c894-4f38-58bf-b323-820b742f2776",
    "entry": "発語",
    "reading": {
      "primary": "はつご",
      "alternatives": [
        "ほつご"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
