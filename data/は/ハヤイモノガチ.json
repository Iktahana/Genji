          "standard": [
            {
              "text": "数量限定の福袋は早い者勝ちなので、徹夜で並ぶ熱狂的なファンもいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今日のおやつは早い者勝ちよ！」と母が言うと、子供たちが一斉にキッチンへ走った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会社の保養所の予約は早い者勝ちで、シーズン中はすぐに枠が埋まってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "予約ではなくて、早い者勝ちだったので、まだ暗いうちから並んでいる人もたくさんいて、大さわぎだったのよ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
