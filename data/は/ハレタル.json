          "literary": [
            {
              "text": "國民自由ノ人權ハ生産的活動ノ自由ニ於テ表ハレタル者ニツキテ特ニ保護助長スベキ者ナリト云フモ其四。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人ハ惡用スベキ大資本ヲ奪ハレタルガ故ニ國家ノ物價調節ニ反抗シテ買占メ賣惜ミ等ヲナスコト能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵式體操ヲ廢止スル所以ハ、其形式亦實ニ丹田ノ充實ヲ忘レタル外形的整頓ニ捉ハレタルニ依ルモ一理由ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人ト五人ト角力シテ已ニ三人ヲ倒シタル者ガ他ノ二人ヨリ足ヲ奪ハレタルヲ見テ其ノ人ヲ弱者ナリト云フ能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ津浦鐵道ガ南北ニ分割サレテ列車ヲ直通スル能ハズ、南段ノ英資ニ對シテ北段ノ獨資ナルハ先ヅ投資的分割ニ現ハレタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ「ヴェルサイユ」ニ救ハレタル同盟ノ誼ニヨリテ英國ノ支那本部併合ニ報謝スベシト云フカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
