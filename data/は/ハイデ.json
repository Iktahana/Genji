        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハイデルベルクでもベデッカーの案内記にはグランド・ホテルとなっている旅館もハイデルベルゲル・ホーフと改名していた。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく私は、あの海老茶色のリボンを考へ、その書生帽子を思ふだけでも、ふしぎになつかしい独逸の戯曲、アルト・ハイデルベルヒを聯想して、夏の青葉にそよいでくる海の郷愁を感じたりした。",
              "citation": {
                "source": "夏帽子",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は人の居ないところで、どこか内証に帽子を被り、鴎外博士の『青年』やハイデルベルヒを聯想しつつ、自分がその主人公である如く、空想裡の悦楽に耽りたいと考へた。",
              "citation": {
                "source": "夏帽子",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の朝、二三輪の花の咲きほころびた梅の枝に朝日が当って、その枝にハイデルベルヒの若い学生が、ほっそりと縊れて死んでいたという。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンブルクからハイデルベルクへ行ってクインケ（Quincke）を訪ねた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "題も「老ハイデルベルヒ」として置いた。",
              "citation": {
                "source": "『老ハイデルベルヒ』序",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「老ハイデルベルヒ」とは、編中の一作品の題名であるが、この書に收録されて在る一系列の作品全體に冠しても、決して不自然ではないと思つたからである。",
              "citation": {
                "source": "『老ハイデルベルヒ』序",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間は誰しも、思ひ出のハイデルベルヒを持つてゐる。",
              "citation": {
                "source": "『老ハイデルベルヒ』序",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "著者のハイデルベルヒは、この一卷の中にある。",
              "citation": {
                "source": "『老ハイデルベルヒ』序",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいいち、日本には実存主義哲学などハイデガー、キェルケゴール以来輸入ずみみたいなものだが、実存主義文学運動が育つような文学的地盤がない。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイディンガー・ブラッシと称するものがある。",
              "citation": {
                "source": "錯覚数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイディンガーがこの現象を発見してまもなく、ヘルムホルツがこれをたしかめようと思って実験したがどうしても見えなかった。",
              "citation": {
                "source": "錯覚数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイデルベルヒの学生歌」（俗名、若きハイデルベルヒ）でも窓下の学生のセレネードは別として、露台のビア・ガルテンでおおぜいの大学生の合唱があって、おなじみのエルゴ・ヴィヴァームスの歌とザラマンダ・ライベンの騒音がラインの谷を越えて向こうの丘にこだまする。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "独逸へ行こうと思っていた頃で、そこの酒場に居合せた軍艦エムデン号の乗組員だったと称する変な独逸人に、ハイデルベルヒの大学へ入る第一の資格は、ビールを四打飲めることだと唆かされて、私はピルズナア・ビールを二打飲んだのであった。",
              "citation": {
                "source": "ああ華族様だよ　と私は嘘を吐くのであった",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "その和約の席上で、テオドリッヒは家臣に命じ、ハイデクルッグの弓でオドワカルを狙わせたのであったが、弦が緩んでいて、目的を果せず、やむなく剣をもって刺殺したのだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、貴方がオドワカル殺しの故智を学ばれたのは、さすがだったと思います、御承知でしょうが、テオドリッヒの用いた弓の弦と云うのは、木の繊維で編んだ、ハイデクルッグ王（北独逸ゲルマン族の一族長）からの、虜獲品だったのですからね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達はハイデルベルヒの書生さんのやうな大騒ぎで地下室の酒場へ駆け込むと同時に更に、漸く発見したアザミさんを、とりかこんで花々しい乾盃を挙げました。",
              "citation": {
                "source": "ひとりごと",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年はハイデルベルクで迎へた正月を、今年はマールブルクで迎へました。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の独逸で将来のある哲学者と云へば、多くの人がハルトマンとハイデッゲルとを挙げます。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイデッゲルが新しくマールブルクへ来たのは私には嬉しいことでした。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハルトマンのことを書いて思はず長くなつた私は、ハイデッゲルに就いては簡単な報告だけにとどめておかねばなりません。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る日私がリッケルトと話しましたとき、リッケルトが「ハイデッゲルは非常に天分の豊かな男であるから、彼の思想はこれから後もまだまだワルデルンするでせう」と云つたのを覚えてゐます。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の独逸に於ける唯ひとりのアリストテレス学者として、中世哲学に深い理解のある人として、ハイデッゲルを推す人はかなり多いやうです。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイデッゲルは殆どあらゆる点でハルトマンの反対をなしてゐます。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴公子然たるハルトマンに対してハイデッゲルは全くの田舎者です。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイデッゲルがフッサールのフェノメノロギーから新しく踏み出さうとする出発点、この努力の目差してゐる方向を辿つてみることは私には非常に興味のある仕事でありますが、他の機会を待つことにいたしませう。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイデッゲルの語を借りて、前者を存在的真理、後者を存在論的真理と称することもできるであろう。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベートーヴェンで思い出すのは、ハイデルベルクの初めの下宿の主婦がドイツ語の勉強のために紹介してくれたドクトル――その名は忘れてしまった――がまたベートーヴェン研究の専門家で、ドイツ語の稽古にベートーヴェンの文章を使用するという、いささか無法なことをするほどベートーヴェンに熱中していたことである。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
