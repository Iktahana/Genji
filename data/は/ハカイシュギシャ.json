          "standard": [
            {
              "text": "彼は自らを破壊主義者と名乗り、既存の規範を全て否定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "破壊主義者たちが広場で暴動を起こし、街は混乱に包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "周囲からは破壊主義者として煙たがられているが、彼自身は信念を貫いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "禅学徒の中には、偶像や象徴によらないでおのれの中に仏陀を認めようと努めた結果、偶像破壊主義者になったものさえある。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            }
          ]
