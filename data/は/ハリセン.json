        "examples": {
          "standard": [
            {
              "text": "舞台上のコメディアンが、張り扇で顔を叩くギャグは定番だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "時代劇のドタバタシーンで、張り扇がコミカルな効果を生み出していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「はい、これ！」と、芸人が張り扇を小道具に観客に投げかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
