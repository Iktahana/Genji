[
  {
    "uuid": "fa238729-24cd-58e8-b446-394432b36621",
    "entry": "張り扇",
    "reading": {
      "primary": "はりせん",
      "alternatives": [
        "はりおうぎ"
      ],
      "is_heteronym": false
    },
