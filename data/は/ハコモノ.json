          "standard": [
            {
              "text": "お歳暮として、有名百貨店の包装紙に包まれた立派な箱物が届いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "手土産として持参した箱物を、取引先の受付で丁寧に手渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「中身は何だろう」と期待しながら、リボンのついた大きな箱物を開けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
