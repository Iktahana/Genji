        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして化尼に導かれて蓮糸の曼陀羅を織る。",
              "citation": {
                "source": "『死者の書』",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の見知らぬ比丘尼が彼女の側に立って、百駄の蓮茎を注文し、自ら蓮糸をとった。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天女のような一人の美女が、その蓮糸から美しい曼陀羅を織り出した。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち蓮糸で織ったということは嘘なのである。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし蓮糸で布が織れるものでないということは、昔の人にも明らかなことであったろう。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓮糸でなくてはならないのは幻想の要求である。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓮糸で織ったことが嘘であってもこの幻想の力は失せない。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
