    },
    "definitions": [
      {
        "index": 1,
        "gloss": "halter",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "暴れる馬に鼻綱をつけ、なんとか落ち着かせようとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "調教の際、馬に鼻綱を装着し、指示を与える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この鼻綱は、丈夫な革でできており、耐久性に優れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いうまでもないが、初荷の車を曳く牛は五色の新しい鼻綱をつけて、綺麗にこしらえている。",
              "citation": {
                "source": "牛",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い者の取落したのか、下の帯一筋あったを幸に、それにて牛乳鑵を背負い、三箇のバケツを左手にかかえ右手に牛の鼻綱を取って殿した。",
              "citation": {
                "source": "水害雑録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は夢から覚めた心地になって、覚えず手に持った鼻綱を引詰めた。",
              "citation": {
                "source": "水害雑録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い者の取落したのか、下の帶一筋あつたを幸に、それにて牛乳鑵を背負ひ、三箇のバケツを左手にかゝへ右手に牛の鼻綱を取つて殿した。",
              "citation": {
                "source": "水害雜録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は夢から覺めた心地になつて、覺えず手に持つた鼻綱を引詰めた。",
              "citation": {
                "source": "水害雜録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらはもう夢のような心持で鼻綱を結われた牛のように、かの眇目の男の導くままに、引き摺られて行った。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉野の家では駒平が鼻綱を引いて連れて行つた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧へ登りつくと牛の鼻綱を解く。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダラシがないんだね」「ハッハヽヽ」「そんなことじゃ豊子に鼻綱を取られるぜ」「取って貰うさ」「仕方がないんだね」「ハッハヽヽ」「おい。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯の夫婦でも強い細君は弱い良人の鼻綱を取る。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
