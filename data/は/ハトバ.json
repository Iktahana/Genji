[
  {
    "uuid": "f304256e-6b0f-55b1-95f3-31b931d65661",
    "entry": "波止場",
    "reading": {
      "primary": "はとば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
