          "literary": [
            {
              "text": "アハアハアハアハアハ………。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハ……アハ……可笑しい可笑しい……アハアハアハアハアハ……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハアハアハアハ……」　私はドシンと椅子に腰を卸した。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お休みい……」「布哇でクリスマスだよオオ――だ……」「勝手にしやがれエエ……エ……だ……」「アハアハアハアハアハ……」　ところがこうした愉快な会話が、霧が晴れると同時にグングン裏切られて行ったから不思議であった。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様の面が歪んどるぞ』と冷やかしてやると進藤の奴、天井を仰いで『アハアハアハアハ』と高笑いしおったが、後から考えるとソウいう自分の方が弱かったのかも知れんて、ハハハ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬鹿馬鹿しい」「アハアハアハアハ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アアハアハアハア。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ハッハッハッ……ザマを見ろ……アハアハアハアハ」七本の海藻　曇り空の下に横たわる陰鬱な、鉛色の海の底へ、静かに静かに私は沈んで行く。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が眼まぐるしく瞬を続けるのを見返りながら、「……アハアハアハアハ……嘘だよ……今のは……。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで彼は音に出してハアハアハアと笑ひ崩れてしまつたのだ。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
