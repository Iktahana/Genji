        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今年初めて収穫した初生りのトマトは、格別の味だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "畑の初生りの野菜を、近所の友人におすそ分けした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "努力が実を結び、嬉しい初生りとなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "金策に出でてひねもす歸らざる老父を思ひつつ夜の戸とざす柿の實の初生り賣りて得し金を神にそなへて額づくわが老父わがのぼる脚榻に昨夜の霜おけり高き小枝に柿の實ちぎる柿の實は乏しくなれり柿の落葉あつめて今宵火を焚きにけり　ほか二首であつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "初生りの柿を青竹で作った小さな籠にいれ、子供に背負わせると息災にそだつという俗習がある、みよは青柿をながめながらそれを空想した。",
              "citation": {
                "source": "日本婦道記",
                "author": "箭竹",
                "note": "青空文庫"
              }
            },
            {
              "text": "良人が生きていたら、そしてあの初生りの柿が一つでも熟れていたら、いまごろは青竹で籠をあんで、安之助の背に負わせて、あやうげな足どりであるくさまを良人と共に笑いながら見ていたであろう。",
              "citation": {
                "source": "日本婦道記",
                "author": "箭竹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そんなことは余計なお世話だよ」「僕は長男だから、初生りだ。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "初生りと末生りの差異が現れて来たのか、菊太郎君は僕よりも発育が好かった。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "最も饗膳なりとて珍重するは、長蟲の茹初なり。",
              "citation": {
                "source": "蛇くひ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頃は二月の初なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊（一月×日）海は真白でした東京へ旅立つその日青い蜜柑の初なりを籠いっぱい入れて四国の浜辺から天神丸に乗りました。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月の白い海と初なりの蜜柑の匂いはその日の私を売られて行く女のようにさぶしくしました。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "病院の石の段々の下には、酢いさうな初なりの蜜柑を売つてゐる露店がありました。",
              "citation": {
                "source": "小さい花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――一九二八・一二――古創　一月×日海は真白でした東京へ旅立つその日青い蜜柑の初なりを籠いっぱい入れて四国の浜辺から天神丸に乗りました。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の恬然と本名を署して文章を公にせる最初なり。",
              "citation": {
                "source": "学校友だち",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "二郎は、毎年、夏になると、こうしてきゅうりのなるのを見るのでありますが、その初なりの時分には、どんなにそれを見るのが楽しかったでしょう。",
              "citation": {
                "source": "遠くで鳴る雷",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあ、みごとな、いい初なりですね。",
              "citation": {
                "source": "遠くで鳴る雷",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあさんが、「きゅうりの、初なりを、水神さまにあげなさい。",
              "citation": {
                "source": "水七景",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
