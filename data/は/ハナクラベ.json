        "examples": {
          "standard": [
            {
              "text": "平安時代の貴族たちは、風流を競う花競べを楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭園で咲き誇る花々を使って、花競べが行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その花競べでは、彼の育てた菊が優勝した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "花競べ、歌競べ、虫競べなどの遊戯にならって、十種二十種の国々の銘茶をそろえ、香気や色味をのみくらべるのを“闘茶”といい、その闘茶にはまた、莫大な賭け物をかけたりする婆娑羅な人々もあるとは――高氏も、聞きおよんでいたことだった。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
