          "literary": [
            {
              "text": "「ハインツェルマンのお玉さんのところへ、ちょっと寄ってみません？",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハインツェルマンって……。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハインツェルマンという独逸人と同棲している尼さんよ。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハインツェルマンは、ちょっとした門構えの家に住んでいた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノ弾きのハインツェルマン氏が、骨張った両手で鍵盤を打つ。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただハインツェルマン氏だけは、無味な事務的な顔附で、さらに弾き始める合図を待っていた。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            }
          ]
        }
