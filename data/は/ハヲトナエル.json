        "examples": {
          "standard": [
            {
              "text": "戦国の世では、多くの武将が天下に覇を唱えようと争った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その企業は、AI技術の分野で世界に覇を唱える存在となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若き将軍は、圧倒的な力で周辺国に覇を唱え、領土を拡大していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "外様六万石として北東の海辺に覇を唱える相馬大膳亮殿の湯池鉄壁、中村城のそと構えである。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
