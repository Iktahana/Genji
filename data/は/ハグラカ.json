        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それをハグラカスために、あるひは酒といふ窮余の手を用ひたことも、有り得ないことではないのである。",
              "citation": {
                "source": "勝負師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ほどのハグラカシの名人はいない。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハグラカされたような気がする。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして悪くすると、一寸のばしに――と言うことは、つまり永久に――ハグラカされてしまいそうな気がするのである。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さあ、どうかしら、―――」そう云って彼女はハグラカシてしまって、「―――毎晩来ちゃあ悪いッて云うの？",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
