[
  {
    "uuid": "3d419a84-6abe-51fa-ab6f-e214b826d8ee",
    "entry": "煩雑",
    "reading": {
      "primary": "はんざつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
