    "definitions": [
      {
        "index": 1,
        "gloss": "to throw up (e.g. mud)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "車が水たまりを通過した際、泥水を勢いよく跳ね上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子どもたちは、水たまりで遊んで泥をあちこちに跳ね上げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "走行中にタイヤが泥を跳ね上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "次の瞬間には、食堂をうちから跳ね上げるような轟音になって「万歳」が叫ばれた。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぱつと白く、そのなかに、遠ざかる港の桟橋を隠して、レエスの網を跳ね上げる飛沫。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、鐘に恨み――の文句の終りに　※｜真如の月を眺め明かさん　と、いう歌詞がございますが、ここで、白拍子が冠っている金烏帽子を、手にもつ、中啓で跳ね上げるところがございます。",
              "citation": {
                "source": "京鹿子娘道成寺",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "頃合を見はからって汀へ引き寄せ、一気に岡へ跳ね上げると、六尺も遠くへ飛出し、叢の中でバタバタしているという。",
              "citation": {
                "source": "蛙を食う岩魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三番がスプラッシュをして櫂で水を跳ね上げるのまではっきり見える。",
              "citation": {
                "source": "競漕",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その天蓋をおとりめされよッ」　課役の藩士だなとわかりましたから、しずかに天蓋をはねあげると、相手は深々と御用龕燈をつきつけて、しげしげ右門の顔をのぞき込んでいましたが、がらりそのことばが変わりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "起床二〇分まえ、前夜の予告どおり、外泊しなかった一〇二の連中と、「エキストラ」で呼ばれた他の部屋の奴らが起こされて、高志に、起床のドラムとともに、いっせいに毛布をはねあげるように注文された。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを、水面すれすれのところから、ぱっと陸にはねあげるか、手網ですくい取るかするのです。",
              "citation": {
                "source": "崖下の池",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "万三郎は大きくうしろへ跳び、「やっ、――」　と叫んで、伸びた槍をはねあげると、そのまま刀を持った相手へ空打ちを入れた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやと、燕作がびっくりしている間に、さらに、二｜畳敷ほどな床板をはねあげると、縁の下は四角な井戸のように掘り下げられてあった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんじゃ」　折もおりなので、一同おもわず、ガバと顔をはねあげる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to flip up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "蓋を跳ね上げると、中から香ばしい匂いが立ち上った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は前髪が邪魔になったので、指でさっと跳ね上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このスイッチを跳ね上げると、電源が入ります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to raise sharply (e.g. prices)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "原材料費の高騰により、製品価格が大きく跳ね上げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "需要の急増が、株式市場の株価を一時的に跳ね上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会社は急に配送料を跳ね上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
