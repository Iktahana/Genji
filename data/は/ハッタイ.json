  {
    "uuid": "cdd266bb-0246-5b55-9ccf-53f3763ca445",
    "entry": "ハッタイ",
    "reading": {
      "primary": "はったい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もう一つの紙袋には、挽きたてのハッタイ粉が入っていた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "重吉からの手紙の中で、故郷のハッタイ粉をなつかしんで話していたのが思い出された。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなものに初めてお目にかかる日本の兵隊は、これをハッタイ粉だとか「おこし」だとかいってよろこんでいた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし是もまたかつては皆はたいて粉にしていたことは、炒粉をハッタイと謂うただ一つの語からでも判る。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "東北で今日ハットウと謂っているのは、主として蕎麦のかい餅をつみ入れた汁類のことであり、出来た食品が関西のハッタイとはまったく違っているために、両者もとは共にハタキモノの義であったことは忘れられている。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
