        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "場所はラムマムーアのハーミストン附近及びエディンバラ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウィア・オヴ・ハーミストン」？",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウィア・オヴ・ハーミストン」にも「セント・アイヴス」にも、両方に必要だから。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、「ウィア・オヴ・ハーミストン」？",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウィア・オヴ・ハーミストン」を又取上げ、又もてあましているのだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月×日「セント・アイヴス」も完成に近くなったが、急に、「ウィア・オヴ・ハーミストン」を続け度くなって、又、取上げた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜、私の「ウィア・オヴ・ハーミストン」は大いにはかどった。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィア・オヴ・ハーミストンの今迄｜書溜めた分を読みかえす。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月××日　ウィア・オヴ・ハーミストン第八章書上。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十　十二月三日の朝、スティヴンスンは何時もの通り三時間ばかり、「ウィア・オヴ・ハーミストン」を口授して、イソベルに筆記させた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
