          "literary": [
            {
              "text": "三　母を葬りに「ハハキトク、スグコイ。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "この夢をみた翌日、私の郷里からハハキトクの電報が来た。",
              "citation": {
                "source": "翳",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所でやっていたらＹ子のところへ電報ハハキトク、スクカヘレ。",
              "citation": {
                "source": "日記",
                "author": "一九五〇年（昭和二十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙちゃん、ハハキトクスグカヘレで夜十時に立つ、お客四人に食事、咲とわたし大童、古、松（夫人）、クボ二月五日　日　編輯会議。",
              "citation": {
                "source": "日記",
                "author": "一九五〇年（昭和二十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハキトクスグコイ。",
              "citation": {
                "source": "泡盛物語",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十にもなれば、彼女はある日ハハキトクの偽電報一本で奉公先から呼びかえされ、危篤のはずの母たちの膳立てのまま、よくはたらく百姓か漁師の妻になるかもしれぬ。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
