        "examples": {
          "standard": [
            {
              "text": "空一面に広がる波状雲を見て、明日は天気が崩れるかもしれないと予報士が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "規則正しく並んだ波状雲の隙間から、青空がわずかに覗いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "飛行機から見下ろすと、海の上に広がる波状雲が白い絨毯のように見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "対流渦による波状雲のことは今さら述べるまでもないが、これに類似の縞は、近ごろ「墨流し」の実験をしているときに、最初表面に浮かんだ墨汁の層が、時がたつに従って下層の水中に沈む場合にもかなりきれいに発達するのを見ることができた。",
              "citation": {
                "source": "自然界の縞模様",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
