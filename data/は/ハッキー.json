          "literary": [
            {
              "text": "しかも　だんなの　しまりすハッキーは　わたしを　おいて　いえでちゅう。",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だんなの　しまりすハッキーが　かみついてくるの！",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまりすハッキーは　そこまで　ふっくらしてませんが、　こっちは　こっちで　でたくないのです。",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが　しまりすハッキーは　もう１しゅう　のじゅくを　つづけまして、　とはいえ、　やっぱり　おちつかなくって。",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまりすハッキーも　おおあわてで　おうちへ　かえります！",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして　うちへと　ついた　しまりすハッキーでしたが、　どうも　はなかぜを　ひいてしまったようで。",
              "citation": {
                "source": "つまさきチミーのはなし",
                "author": "THE TALE OF TIMMY TIPTOES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
