        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さうして、ふいと何か考へ直したやうな御様子で、御病床の将軍家のお顔をちらりとお伺ひなさつた間一髪をいれず、事ノ正邪デハナイ　お眼を軽くつぶつたままで、お口早におつしやいました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども将軍家はおだやかに、ナカナカ、世捨人デハナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧苦オススメシテイルノデハナイ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ結核菌ノ所有者デアルガ、現在ノ父ニモ母ニモ結核菌ハナイ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカルニ現在ノ父母ハレプラデハナイ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコヤネズミノシワザデハナイ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアー、コトモアロウニ、ジブンタチノ死ンダオ母ッチャニアゲタモノヲ、君チャンヤ弟ヤ妹ガ、ムチウニナッテ、タベテイルデハナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "マケナヨマケナヨ、アスノ夜ハナイゾ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガルタンの市民は、マハナイムの祭りに焼かれた犠牲のごとくヘルモンの山上に載るであらう。",
              "citation": {
                "source": "碑文",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「心細イコトヲ云ハナイデ欲イヨ、だつでい――僕トイフ息子ノアルコトヲ忘レタンデスカ？",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“U. S. R. S. Flanklyn”フランクリン号ナル、レシービングシツプデアル、大概港ノ中ニ碇ヲ降シテヰルノデ危険ノ憂ヒハナイガ、僕ニハヤハリ水雷艇ノ方ガ面白イ、君ノ冒険心ガ健ヤカニ成長スルコトヲ望ンデヰル。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニヨルト、我国ニハ「シロウトハクロウトヲ支配ス」トイウ法則ガアルノデハナイカト思ウガマダ調ベテモミナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナワチ形カライエバ草書ト少シモカワリハナイノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカルニ草書ト楷書ハ、コレヲ混ゼコジヤニ布置シタ場合ケツシテ調和スルモノデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、ソウナルト実際ニ使用スル文字ト活字ノ文字ガ違ツテ不都合ダトイウカモシレヌガ、西洋ノホウデハドコヲ見マワシテモ書ク文字ト同ジ活字ヲ持ツテイル国ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "書ク文字ト活字ハチガツテアタリマエナノデアルカラ気ニスル必要ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハアクマデ意見デアツテ実際運動デハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノアナタガ私ガ今誰ヲ又愛シヨウト、何モ云ウ権利ハナイ筈ダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ夫ニハスマナイト思ウカモ知レナイケレド、アナタカラ文句ヲ云ワレルハズハナイワ」　ト言イ放ッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は仕方ナク床ニ戻ッタノデスガ、ドウ考エテモ余リニ無札ナ仕打デハアリ、私が今更ソンナ事ヲイエタワケデハナイノデスガ、道子ガ人妻トシテ余リニヒドイ乱行ヲシテ居ルノヲ見テ、モウ堪エラレヌ、イッソ道子ヲ殺シテ自分モ自殺シヨウト決心シタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハ君ヲ愛シテハ居ナイゾ、君モ道子ヲ愛シテハ居ナイデハナイカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ探求シ、分析シ、整頓シ、再現スルコトニヨッテ、ワレワレハ自然界ノ新シキ神秘ニ触レルコトガ出来ルノデハナイカト思ウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊ニソノ整形ノ効果ノ大ナルコト、他ノ部位ノ比デハナイ。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生はなほこれらの史料を過信することを戒められ、兎モ角モ人間ノ眼デ見タ證據程當テニナラナイモノハナイトイフ、心理學上ノ事實ハ、吾々ノ忘レテナラナイ誡デアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼ハ大キクハナイガ非常に特色ガアル。",
              "citation": {
                "source": "ロシアの過去を物語る革命博物館を観る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スベテ渦巻ケル地平ノ向背カラ　自ラヲ標的トスル虚妄デハナイカ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
