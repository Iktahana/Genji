    "definitions": [
      {
        "index": 1,
        "gloss": "to stick (to)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "汗でTシャツが背中に張り付いて、少し不快だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "壁にポスターがしっかりと張り付いていて、剥がすのに苦労した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供が母親の足にぴったりと張り付いて離れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "最後の死力を振り絞り恐怖のフレスコ画に背を向けようと、少なくとも顔だけは表面に触れて張り付くことのないようにしようと試みた。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからは、猶更以てじやれ着いて、ろくに團右衞門の邸へも行かず、絡はりつくので、ふら／＼立ちたいほど氣に掛つた。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――」櫓を降り、変にポタポタと靴の裏にはりつくような地面を事務所の方へ歩きながら、その技師は、バクーの油田が無慮二百七十の大小会社によって無統制に掘りかえされていた時代の恐ろしい競争の状態を話した。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼いものゝ微妙な感情が、敏感な栄子の心に絡はりつくのであつた。",
              "citation": {
                "source": "質物",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "母を失つて、父にまつはりつく梅子に、栄子のやつて来てくれたことは、たゞそれだけでも捨三に取つては何んなに有難いことだか分らなかつた。",
              "citation": {
                "source": "質物",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "樫の枯葉が背中にはりつく。",
              "citation": {
                "source": "吠える",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "千世子のどうしようもないかんしゃくを、嘲笑う様にあさぎのかみはヘラヘラヘラとひるがえってペッタリとはりつくかと思うと、パカンと口をあいて千世子の心をいじめぬいたあげくだらんと下ってそのまんま死んだ様に動かなくなった。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はホテルの玄關の次第に近づいてくるのを、うるさく顏にまつはりつく蜘蛛の巣のやうなものを透して、やつとのことで見分けてゐた。",
              "citation": {
                "source": "恢復期",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸先は闇、見えるものは生きてゐる自分の肉体だけであつてみれば、その肉体にまつはりつく一ヶ年の垢を眺めて見るのは、めでたくも切ない気持に相違なからう。",
              "citation": {
                "source": "一九三六年回顧",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、初瀬のからだへまつはりつくやうに、「あのこと、どうなつたの、小母さま？",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局自分にまつはりつく後腐れだけが厭なのだ。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔の近くへもつてくると古風な香気がまつはりつく。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年は、裾をからげた奥さんの細ながい脚に、まつはりつくやうに動きまはつた。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、さきに示したる立春大吉の文字を書したる札を、年始に当たりて門柱などにはりつくるは、その文字が表より見るも、また裏より見るも同一の文字なるがゆえに、裏表の別なく均々幸いあるを祝するものなりという。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、家外の吹雪の中に一人のヴァイオリン弾きの老爺の乞食が立ち、やがてそれは寒さのために縮んで主人の室の硝子扉に貼りつくように体を寄せました。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中には、高く飛んで檣へ貼りつくのもあります。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "汗ばんだ裸の脛に、スカートがベッタリと貼りつく。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その若侍は赤くなった顔を机の上へ貼りつくほど伏せ、口の中でなにやら答えながら、さもいそがしそうに筆を動かしていた。",
              "citation": {
                "source": "饒舌り過ぎる",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸外へ出ると、いきなり冬の月と寒風が顔に貼りつくように感じるのである。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いがらっぽく、すぐに吸口が唇に貼りつく。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "よろりと立って樹にその身をうしろむきに張りつく。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時にかれは、反対側の雨戸へ、張りつくように身を引いて、じイッ、聞き耳を立てながら、長い廊下の左右へ眼を配った。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらの肌にぴたりと張りつくようなその眼眸に、異様な魅力があった。",
              "citation": {
                "source": "憑きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴたりと張りつくだけで何にも見えない眼眸ではなく、生々と光って、何かを探りあてようとする視力だ。",
              "citation": {
                "source": "憑きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、家をあけて出ずるときに、戸口の外に※の字を張りつくる。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝屋の屏風｜太鼓張の襖なぞ破れたるを、妻と二人して今までは互に秘置きける古き文反古取出して読返しながら張りつくろふ楽しみもまた大厦高楼を家とする富貴の人の窺知るべからざる所なるべし。",
              "citation": {
                "source": "矢はずぐさ",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「両方が意地の張りつくらをしてけつかるんだ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "口が乾いて舌が上顎に貼り付く。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに懺悔をしている以上は、鬼の面の貼り付くおそれはないと彼は信じていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "夜叉神堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち強てこれを紙に摺り付くれば、単にその毀れた外皮のカケラが暫時不規則に紙に貼り着くのみである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
