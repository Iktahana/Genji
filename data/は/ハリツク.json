        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は一日中、パソコンの画面に張り付いて作業をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "猫は日当たりの良い窓際に張り付いて、気持ちよさそうに寝ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "犯人は、警察の目をかいくぐり、しばらくの間その町に張り付いていたらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
