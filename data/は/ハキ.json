[
  {
    "uuid": "0d4d0f95-2c13-56a9-b8fa-cfed7ecf67df",
    "entry": "覇気",
    "reading": {
      "primary": "はき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "spirit",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日の試合の彼は、いつになく覇気が感じられ、気迫に満ちていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "連敗続きのチームには覇気がなく、どこか諦めムードが漂っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "若いのだから、もっと覇気を持って新しいことに挑戦してほしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "○　僕は前進座の此のぴちぴちとした若々しさ――此の覇気を愛し、此の芸道に於ける謙譲の徳を讃え此の家族的な融合を羨ましく思うものだ。",
              "citation": {
                "source": "雑録",
                "author": "――前進座に就いて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "××というのは、思い出せなかったが、覇気に富んだ開墾家で知られているある宗門の僧侶――そんな見当だった。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は青年期の有り余る覇気をもちあぐみ、元来の弱気を無理な非人情で押して、自暴自棄のニヒリストになり果てていた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手は同じ近郊の素封家の息子で、覇気のある青年だった。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（舅の友人に前田黙鳳といふ先生があつて、その古朴正厳な覇気横溢の書体にも私は深く感銘を得たことを憶えてゐる。",
              "citation": {
                "source": "私の書に就ての追憶",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "覇気と頑強と、精力的なので多少主人を顰蹙させ、朋輩達に憎がられはしても、どんどん彼は他を抜いて行つた。",
              "citation": {
                "source": "老主の一時期",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のその精力と頑強と覇気とを余すところなく発揮した。",
              "citation": {
                "source": "老主の一時期",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "寂心は飾り気の無い此の御房の打明話には、ハタと行詰らされて、優しい自分の性質から、将又智略を以て事に処することを卑しみ、覇気を消尽するのを以て可なりとしているような日頃の修行の心掛から、却ってタジタジとなって押返されたことだったろう。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "元々意志の弱い男が、二年に亘る流浪の間に、絶えざる不安と恐怖とのために、すっかり覇気を失って了ったからである。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）、そんな気がしたので、後者の一派はこれはまた、僕にしてみると、あまりに覇気がなく、文壇妥協派で面白くもなかつたが、ウヤムヤに僕はそつちの一員になつてしまつたのだ。",
              "citation": {
                "source": "貧しき文学的経験（文壇へ出るまで）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後僕は、「新文学準備倶楽部」といふ雑誌で彼の短い感想文を読んだことがあるが、これは誰にも好く解るであらう文体で、その述べるところの所論は堂々たる覇気に富み読んで愉快であつたことを今でもはつきり憶えてゐる。",
              "citation": {
                "source": "新興芸術派に就いての雑談",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちよつとは思ひ出せない程幾晩も徹夜を続けた後の混乱の頭が司る覇気だ。",
              "citation": {
                "source": "嘆きの谷で拾つた懐疑の花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが試験場へ行き、あまり大勢の学生が青ざめてゐるのを目撃すると、一人でも余分に入学させてやりたいと云はんばかりの凡そ意味もない覇気見たいなものに駆られて、そのまま方角も知らなかつた早稲田へ人力車を走らせた。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "君子とすると覇気があり過ぎた。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は衒気五分市気三分の覇気満々たる男で、風流気は僅に二分ほどしかなかった。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、幕府が瓦解し時勢が一変し、順風に帆を揚げたような伊藤の運勢が下り坂に向ったのを看取すると、天性の覇気が脱線して桁を外れた変態生活に横流した。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　『浮雲』時代の失意煩悶『浮雲』著作当時の二葉亭は覇気欝勃として、僅に春廼舎を友とする外は眼中人なく、文学を以てしては殆んど天下無敵の概があった。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡そ、彼の勇士の振舞ひは、あらゆる人間の情熱と根気と忍耐と覇気の徳を兼ね備えた遠い昔、遠い国のガスコン族の再来かと見紛ふばかりであつた。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は師の信西入道をも驚かすほどの博学で、和歌に心を寄せる兄の忠通を常に文弱と罵っているほどに、抑えがたい覇気と野心とに充ち満ちている人物であった。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして一面には頗る覇気に富んでいたらしく、一種｜精悍の気がその風貌に漲っていた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "覇気に富んだ彼としては恐らく堪えがたい苦痛であったろうと察せられるが、実際かれはそれほどに衰弱してしまったのである。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうは言っても、かれに今一段の覇気とか活気とかいうものがあったならば、かの七代目団蔵の末年とおなじように、古典劇の名手として一部の賞讃を博し得たであろうが、彼はすべてにおいて余りに無欲｜恬淡、殆んど一種の仙人か子供のようであったらしい。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏は本質に於ては短気であり覇気に富んでいた。",
              "citation": {
                "source": "名古屋の小酒井不木氏",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "文壇｜擦の毫も無い、謙遜温雅な態度の中に、一脈鬱々たる覇気があって、人をして容易に狎れしめないのは、長袖者流でないからである。",
              "citation": {
                "source": "日本探偵小説界寸評",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴御殿の玄関に立ち、「ご免」といった声にさえ、ピーンと覇気がみなぎっている。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "覇気充満の態度である。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小い時分から覇気の壮んな、才気に溢れた、一時は東京に出て、まだ二十にも足らぬ齢で著書の一つも出した渠――その頃数少き年少詩人の一人に、千早林鳥の名のあつた事は、今でも記憶してゐる人も有らう。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「「Ｗ」全軍の稀有なる覇気は、彼の度外れなる敏捷振りに不思議な団結状態を醸したかに見えた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "月蝕皆既萩原朔太郎みなそこに魚の哀傷、われに涙のいちじるく、きみはきみとて、ましろき乳房をぬらさむとする。",
              "citation": {
                "source": "月蝕皆既",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "祕佛萩原朔太郎つゆしものうれひはきえず、わづかなるつちをふむとて、あなうらをやぶらせたまふ。",
              "citation": {
                "source": "祕佛",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
