        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会議での彼の反論は、的確で説得力があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "提案された計画に対し、多くの参加者から反論が出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「それは違うだろう！」と、彼は大声で反論した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "間違っていたら反論するといい。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "その際に「そらもよう」に書いた内容と重複するが、ここで再び、ＪＡＳＲＡＣの論拠に反論しておきたい。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらく祝田さんは、「寝ころんで読めない本など本とはいえない」という電子本批判派の意見をまえに、かれなりの反論を具体的なやり方でこころみておこうと考えたのだろう。",
              "citation": {
                "source": "本はどのように消えてゆくのか",
                "author": "津野海太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと、これは面白いって」　慶一はなにもこたえず、反論しないことで、不承ぶしょうの同意を示した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いっておくけどな、他人の家のことをあれこれほじくりかえすのは、あんまりいい趣味じゃないぞ」　そういわれれば、たしかに悪趣味なので、慶一は口をとがらせたが、反論はしなかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツンツルテンでよかったな」「交通安全じゃあるまいし、そんなの穿いてたら、一キロさきからだって見つかるね」　ツンツルテンという事実誤認に対する反論は放棄し、慶一は高志のオレンジ色のトランクスをねめつける。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "失礼ねー、酔っぱらい、と女子から反論が出る。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガキのときから、その手になんどもやられてる」　令子はなにも反論しなかったが、その沈黙には不満がこめられているようだった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学はつぎのように反論するだろう。",
              "citation": {
                "source": "石仏",
                "author": "THE STONE BUDDHA",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、あなた方西洋は、それがたんなる夢に基づいたものではないという反論のしようがない証拠をもたらした。",
              "citation": {
                "source": "石仏",
                "author": "THE STONE BUDDHA",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕はちっとも淋しいとは思わんぞ」と野口が反論する。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アドメートス王は老いて先き行く命が少ない身であるから自分の身代わりとなるよう実父母に要請するが、父母は感謝こそされ、息子のために命を差し出すような恩義はなく暴慢だと反論する。",
              "citation": {
                "source": "九州の学生とともに",
                "author": "WITH KYUSHU STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが求められていたのはマイクロソフト版と互換で、しかも当然予想される彼らからの権利侵害のクレームに対して、いっさい問題はないと反論できるベーシックだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "同社の著作権に抵触せず、彼らが疑いを持ったとしても説得力を持って反論できるようにと、古山はベーシックの情報源を厳密に限る方針を定めた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲイツのもとには反論の手紙が殺到し、ホビイストの雑誌にも多くの反対意見が掲載された。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「積み上げてきたアプリケーションの数においても、製品の技術レベルにおいても、将来の発展に向けたビジョンにおいても、いずれもＣＰ／Ｍ―86の方が上なのではないか」　そう反論する早水に対し、あくまでＭＳ―ＤＯＳを主張する浜田の確信の根にあるものは、「ＩＢＭへの信頼」につきるように思えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それを聴いた刹那検事と熊城には、いったんは理法と真性のすべてが、蜻蛉返りを打ってケシ飛んでしまったように、思われたけれども、少し落ち着いてくると、それにはむしろ、真面目な反論を出すのが莫迦らしくなったくらい、不思議なほど冷静な、反響一つ戻ってゆかないという静けさだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が説明しようと努力する理論を確立するために他の理論に反論することは必要としない。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "流れと同じ方向だけでなくしばしば逆らって疫病の起きることから、川の水による病気の広がりに反論があることもある。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "君だって反論しようがないだろう。",
              "citation": {
                "source": "亀がアキレスに言ったこと",
                "author": "What the Tortoise said to Achilles",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の不都合もないのだ」　この歴史的弁護論は当然、「そんな勝手なことがいえるのか」とか、「先例はすべて善例なのか」といったような反論を貴族の間によび起したが、しかしいずれも私語の域は出なかった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "時は金なりだ」　諸君、この見解には反論できない。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って、観点の数だけ世界がある」　俺は反論した。",
              "citation": {
                "source": "観点",
                "author": "THE POINT OF VIEW",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌の数は決ってしまわないから、勉強して作る方がいいよ」と反論されたことがある。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は明治初期の十四家歌人の中に入っており、『十四家集』中にその作品が収められているが、この本を、加納諸平系の海上胤平が『十四家集評論』というもので片っ端から悪評し、それを鈴木弘恭が『十四家集評論辯』として反論したこともあった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに対してザイデル弁護人は、検事側のふりかざす被告の口述書は全く脅迫と利益をもって導いた検事の捏造に他ならない、その証拠に検事側の証人は一人として出廷しなかったではないか、と反論し、さらにマクナイト検事は己れの功名心のため、将来の出世の基礎を作らんがために、罪なきものを罪に陥れたのだと断じた。",
              "citation": {
                "source": "戦争医学の汚辱にふれて",
                "author": "――生体解剖事件始末記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそういう反論は直接物を見ての上ではなく、先入観が邪魔しているので、なかなか真実相が見えないのである。",
              "citation": {
                "source": "四十年の回想",
                "author": "『民藝四十年』を読んで",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわんや批評家は朝鮮の窯場の事、作り方の事、作った人たちの事等をまるで知らない所から来る反論なのである。",
              "citation": {
                "source": "四十年の回想",
                "author": "『民藝四十年』を読んで",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
