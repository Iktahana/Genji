        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "花もうつろふ仇人の浮気も恋といはしろの結び帛紗の解きほどきハリサ、コリャサ、よいよいよい、よいとなアツテチン、ツテチン　心なき門附けの女の歌。",
              "citation": {
                "source": "大菩薩峠",
                "author": "東海道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンガ一字ヨムカヨマナイウチニ――オバアサンハ、ムツカシイ字ヲヨムトキハ一字ヨムノニトテモ時間ガカカルノデス――マドノソトデ、ハリサケルヤウナオホキナオトガ、キコエマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小柄のくせに、まったく気違いの蛮声、なんというハリサケルような声なのだろう。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
