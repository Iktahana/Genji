    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to run away",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "警察官の姿を見ると、犯人は慌てて走り去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は悲しみにくれ、人混みの中に走り去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あっという間に、新幹線が視界から走り去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "全速力の汽車が向う向いて走り去るように、彼はズンズン細くなった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「てっきり彼奴」　と独り言、Ｔ「朝ッぱらから一稼ぎしてやがるかも知れ無えぞ」　其辺で鉄五郎クルッと踵を反して走り去る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "してやったりと三次走り去る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と急いで茶代を払って走り去る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "居たたまれず走り去る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と三次驚いて、Ｔ「これァ返してやらなくちゃ」　と急いで三四郎の後を追って走り去る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の気なしに仲蔵がその男見送ると、　蛇の目傘の浪人者（大吉）が跣足で走り去る（所謂定九郎の恰好よろしく）。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠く走り去る大吉を見送って、　雨の中の仲蔵狂喜する。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝五郎蔵の家の表　大吉と半次格子戸をガラリと開くと、　バラバラと五六人の通行人急ぎ、　走り去る。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の一人が驚いて床の間の文箱を抱えて走り去る。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と叫んで、　八方に走り去る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車は私の部屋をよぎりながら轟々と走り去る。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "大喜びのおふみ、ふと思い出して伝六に、Ｔ「土左衛門は」　伝六がアッ、Ｔ「其奴忘れてた」　で慌てて走り去る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍でこれを聞いて居た敬四郎が又乾分の松と共に走り去る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は知りません」　太郎左衛門、　「そんな事わしは知らぬ」Ｔ「おふみさんを返して欲しくばお類を連れて帰って下され」　伊吉、Ｔ「連れて帰ります」Ｔ「きっと連れて帰ります」　と言い捨てて走り去る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「右門はまだその事を知るまいね」　「何言ってんのさ、あの人はもうとッくに出発しましたよ」　それは大変と敬四郎と松公慌てて走り去る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "右門等駕籠に乗って崖の上を走り去る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "走り去ること一町ばかり、俄然留り振返り、蓮池を一つ隔てたる、燈火の影を屹と見し、眼の色はただならで、怨毒を以て満たされたり。",
              "citation": {
                "source": "妖僧記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（甲乙は外へ出て、上のかたの奥へ走り去る。",
              "citation": {
                "source": "影",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは思わずも、鼻息あらく、たてがみをなびかせつつ走り去るアラビアの野馬を思いださずにはいられませんでした。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊代、上手の出入口に向って走り去る。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥田教師、学童二名と共に舞台｜下手に走り去る。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠等米錢を惠まるゝ時は、「お月樣幾つ」と一齊に叫び連れ、後をも見ずして走り去るなり。",
              "citation": {
                "source": "蛇くひ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一人は下手に走り去る。",
              "citation": {
                "source": "修禪寺物語",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（春彦は橋をわたりて走り去る。",
              "citation": {
                "source": "修禪寺物語",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽よ、出口を示せ、出口を指させ、入口があつて出口のない世界があるとは私は信じられない探す、そいつを、探せ、君も、あいつ太陽が暁と夜とをすばやく走りさる一瞬間の時間に急速に。",
              "citation": {
                "source": "小熊秀雄全集-4",
                "author": "詩集（３）小熊秀雄詩集１",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車が走りさると、道路の上は、まっくらになってしまって、その後、二人の勝敗がどうなったか、ざんねんながら、房枝はしることができなかった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢中の様な形をして道のない雪をけたてて走りさる男の人間らしい形は段々小さくなってたった一つの黒点になってころがって行った。",
              "citation": {
                "source": "どんづまり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その女の人の知らせを受けた交番のおまわりさんが、矢のように走りさる怪自動車を見とどけています。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "園井さんと正一君は、目かくしをとって、どことも知れず走りさる賊の自動車を見おくってから、外苑を出て、大通りを走るタクシーをよびとめ、ぶじにおうちに帰ることができました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
