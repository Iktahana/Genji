        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は長年、この地で花作りとして生計を立てているベテランだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "将来は花作りになって、たくさんの人に笑顔を届けたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "有名な花作りのもとで修行し、その技術を習得した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
