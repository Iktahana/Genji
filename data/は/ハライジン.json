        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彷徨きながら、見ぬ振をして横目でチョイチョイ見ていると、お糸さんが赤い襷に白地の手拭を姉様冠りという甲斐々々しい出立で、私の机や本箱へパタパタと払塵を掛けている。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "作は時ならない払塵の音を聞きつけて、梯子段から銀杏返しの頭を出した。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦の払塵の声がここかしこで聞こえた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "御米は奥で座敷へ払塵を掛けていた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "箒と払塵と雑巾とを持った女中が、慌てて駈けてきた。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど俺の方は、物も供えず払塵もかけないで放っておかれる、埃と煤とにまみれたその神棚を、次第に無関心な眼で眺めるようになってきた。",
              "citation": {
                "source": "神棚",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "御米は奧で座敷へ拂塵を掛けてゐた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸伺つておいで」其聲が止んだと思ふ間も無く、何處かの部屋で勇しい拂塵の音が聞えるのはもう文太郎が其部屋の掃除に行つたものらしかつた。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
