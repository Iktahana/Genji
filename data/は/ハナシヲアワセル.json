        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「後で問い詰められたときのために、二人で話を合わせておこう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "アリバイ工作のために、彼らは前もって話を合わせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "話を合わせていたはずなのに、一人がうっかり本当のことを言ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
