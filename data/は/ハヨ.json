  {
    "uuid": "bbd2174f-9b03-50fe-ba50-9f8fa2322c82",
    "entry": "ハヨ",
    "reading": {
      "primary": "はよ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは「コンニチワ」「オハヨオ」などというような種類のものであったが、あまり発音が変っているから、はじめは日本語だとは気が付かないくらいであった。",
              "citation": {
                "source": "異郷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "門をはひるや否や、色の淺黒い（といつても、カロリン諸島は東へ行くにつれて色の黒さが薄らいでくるやうに思はれる）子供等が爭つて前に出て來ては、オハヨウゴザイマスと叮嚀に頭を下げる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、一齊に、オハヨウゴザイマスと言ひながら頭を下げた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "門をはいるや否や、色の浅黒い（といっても、カロリン諸島は東へ行くにつれて色の黒さが薄らいでくるように思われる）子供らが争って前に出て来ては、オハヨウゴザイマスと叮嚀に頭を下げる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、一斉に、オハヨウゴザイマスと言いながら頭を下げた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、仏蘭西の選手達でしたが、他に、独逸の選手達も、ずいぶん気持の好い連中で、ぼく達と顔を合せるたびに、直ぐ「オハヨオ」と愛嬌たっぷりに、日本語で挨拶してくれます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏庭から横露地を玄関前へタッタッタッと乗出して、往来へ出るや否や左へ一曲り、「ハヨ――ッ」　と言う子供声、高やかに、早や蹄の音も聞こえなくなってしまった。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、君チャンハヨナカニ目ヲサマスト、ブルブルフルエナガラ、何ンダカオッカナクテ、オ母ッチャトコエモ出セズニ、ソート手ダケヲノバシテヤッテ、ユスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮明度、速力ナドニ関シテハモチロン、資材ノウエカラ労力ノウエカラ大変ナ経済ダト思ウガコノ種ノコトハ私ニハヨクワカラナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ご気嫌ね……オハヨウ――」「え……」　はっとベッドの上から入口を見ると、同じ病棟のマダム丘子が、歯刷子を持って笑っていた。",
              "citation": {
                "source": "※の囁き",
                "author": "――肺病の唄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「や、オハヨウ……」「いい朝ね、ご覧なさいよ、百合が咲いてるわ」「そう」　私は体温計を抜くと寝衣の前を掻きあわせながら、水銀柱を透かして見た。",
              "citation": {
                "source": "※の囁き",
                "author": "――肺病の唄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダム丘子は、そんな時、わざと活溌に廊下を歩き、「オハヨウー」と大きな声で看護婦や、顔見知りの患者に呼びかけるのだ。",
              "citation": {
                "source": "※の囁き",
                "author": "――肺病の唄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ、ハタケモノハヨクナイデセウ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「犬ハヨク夜ヲ守ル、人ニシテ犬ニ如カザルベケンヤ」　背の高いのが、大きな声で叫び出す。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「マア、ソレハヨカツタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オバアサンハヨイネコデスカラ、ケツシテコドモガドンナニヤカマシクシテモ、ドナリツケタリハイタシマセン。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイシヤサマハヨクヨク、シンサツシテ、ソレカラ、「ボンコチヤン、アナタノ病気ハモンコチヤンノ所ヘカヘレバスグナホリマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、モンコチヤンノアタマニデキルダケカツカウヨクカブサリマシタカラ、ソレハソレハヨクニアフヨウニナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハキウニトビ上ツテ、「アラ、アラ、誰カト思ツタラ、アナタハヨシヲサンヂヤナイノ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サヨナラもタダイマもオハヨウも、その他親しみのこもつた言葉何一つしやべらず、宿六をなんと思つてゐるのだか、同衾はする、しかしそこから宿六といふ特別な人格などはミヂンも設定の意志がなくて、かうなると宿六も切ない。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、アラア、先生、コンチハ、オハヨウ。",
              "citation": {
                "source": "お魚女史",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に深いワケはなかったのですが、まだ寝みだれ姿で便所へ立って、そこでバッタリと、すでにすっかり仕事着をきたトオサンと顔を合せた小夜子サンは自分の朝寝坊や寝みだれ姿が味気ない気持になって「オハヨー」と顔をそむけて背をむけました。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オハヨー、奇術師サンと云って糸子がやってきた。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "また今のアイヌが伝うるハヨクベすなわち鎧は、わが古墳から発見せられる挂甲の系統をそのまま伝えたものだからとて、誰がその実年代をわが古墳時代に持って行こうとする。",
              "citation": {
                "source": "「あばた」も「えくぼ」、「えくぼ」も「あばた」",
                "author": "――日本石器時代終末期問題――",
                "note": "青空文庫"
              }
            },
            {
              "text": "八、要するに、巡回文庫はニユーヨークを中心として創設せられ、漸次「マッサチューセッツ」、「ウイスコンシン」、「ミシガン」、「ペンシルヴェニヤ」、「メリーランド」、「オハヨー」、諸州に普及して、既に争うべからざる成績を得たり。",
              "citation": {
                "source": "米国巡回文庫起源及び発達",
                "author": "佐野友三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆が身寄りもハヨリもねえ身の上で、そいで、嬢様にひでえ苦労ばかけていることを知っていやがるです、そいで一所懸命になる。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "段六　ああによ、皆が身寄りもハヨリもねえ身の上で、そいで、嬢様にひでえ苦労ばかけていることを知っていやがるです。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
