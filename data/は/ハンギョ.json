          "standard": [],
          "literary": [
            {
              "text": "昨夜の夜半に、風呂場で見た半人半魚の麗人が、数歩前を自分の方へ向かって、窈窕として歩を運んでくるではないか。",
              "citation": {
                "source": "岩魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、今朝は半人半魚の姿ではない。",
              "citation": {
                "source": "岩魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダゴンは半人半魚なので頼りにならなかった。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
