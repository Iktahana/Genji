          "literary": [
            {
              "text": "俺は之をポンし、つづけて友田から出た発財をポンし、次いで又友田が打った九万をポンした。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "發財蓄積意の儘である。",
              "citation": {
                "source": "支那史上の偉人（孔子と孔明）",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "宦官が發財致富の根源はここに在る。",
              "citation": {
                "source": "支那の宦官",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上の事情によつて、外國貿易船と關係する官吏は、古來發財致富するものと定まつて居る。",
              "citation": {
                "source": "蒲壽庚の事蹟",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
