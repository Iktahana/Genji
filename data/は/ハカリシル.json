    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to conjecture",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "表情からは読み取れないが、彼女の受けたショックの大きさは計り知るに余りある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この古い書物から当時の人々の暮らしぶりを計り知ることは、容易ではない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "部下の努力の過程を計り知り、上司は適切な評価を下すべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それから毛唐の嫌う金曜日金曜日に汽笛を鳴らして、到る処の港々を震駭させながら出帆する、倫敦から一気に新嘉坡まで、大手を振って帰って来る位の離れ業は平気の平左なんだから、到底｜吾々のアタマでは計り知る事の出来ないアタマだよ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、その思想の重量は自らこれを支へ得るもののみがよく計り知るのである。",
              "citation": {
                "source": "「趣味」の草原へ",
                "author": "――「アナトオル・フランス短篇小説全集」推薦の辞――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日米両艦隊の戦闘は、いまや順序を捨て、予測を裏切り、いずれが進むか退くか、俄かに計り知ることの出来ない疑問符号に包まれた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが当代の文化や先生の訃によつてその失ふところ殆ど計り知るべからざる事を思ひたればなり。",
              "citation": {
                "source": "書かでもの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "新問題の提出がどれだけの役目をしたかは、ほとんど計り知るべからざるほどに大きい。",
              "citation": {
                "source": "和算の社会的・芸術的特性について",
                "author": "三上義夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "処でここに云う大衆なるものの意味をつきつめて見ると、一見計り知ることの出来ないような奥まった諸現実が、伏在していることを知ることが出来るのである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "意識的には正しい認識の心算が、意識主観を離れて見ると、意外にも正しくないかも知れぬということは、認識というものの計り知るべからざる謎を提出する。",
              "citation": {
                "source": "認識論とは何か",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ等の大学はリーグ戦に加わっているおかげで、大学自身として計り知ることの出来ない程の利益を得ている。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "文化映画というものに、だから私は容易に心を許さないのであるが、それと共に、そこに見えかくれしている映画の或る計り知るべからざる能力には注意を怠ってはならないと考える。",
              "citation": {
                "source": "映画芸術と映画",
                "author": "――アブストラクションの作用へ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "１　流行病がある国で続いたときの影響は死亡率だけから計り知ることはできない。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なぜと申しまするに、みなさま、とりわけ陛下におかせられまして、ごらんのとおり、ほんもののさよなきどりにいたしますると、つぎになにをうたいだすか、まえもって、はかりしることができません。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれをもつて是をおもへば、我国の深山幽谷雪の深事はかりしるべからず。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "ましてや神々しきを敬ば霊威ある冥々の天道は人の知を以てはかりしるべからず。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　松崎は先んじられた……そして美しい女は、淵の測り知るべからざる水底の深き瞳を、鋭く紳士の面に流して「私は確です。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "今既にこの川一帯の地は工業者の占有するところとなれるが多し、他日の発達測り知るべきなり。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "いざさらば船宿まで行かめ、船出す出さぬは船頭こそ判じ定むべけれ、我等の今こゝにて測り知るべきにはあらず、行かめ、行かめと手疾く衣を更へて立出づ。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ぞと見るに雉子の雌鳥なれば、あわれ狩する時ならばといいつつそのままやみしが、大路を去る幾何もあらぬところに雉子などの遊べるをもておもえば、土地のさまも測り知るべきなり。",
              "citation": {
                "source": "知々夫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "恰もそれは測り知る可からざる霊智と妙技とを以て描かれた大画巻を一尺二尺と繰りひろげながら驚異感嘆の心をもて観賞し行く心持である。",
              "citation": {
                "source": "穂高岳",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし運命というものがないのであれば、人の未来はすべて数学的に測り知ることのできるもので、三々が九となり五々が二十五となるように、明白に今日の行為をもって明日の結果を知り得るはずである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの測り知る事のできない疑問について知る事は、今の太田にとつてはぞくぞくするやうな戰慄感を伴つた興味であつた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの測り知ることのできない疑問について知ることは、今の太田にとってはぞくぞくするような戦慄感を伴った興味であった。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれを読んだ子の心に現われる効果は、予め測り知ることが出来ない。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "往きて見れば待遇殊にめでたく、魯西亜行の労を問ひ慰めて後、われと共に東にかへる心なきか、君が学問こそわが測り知る所ならね、語学のみにて世の用には足りなむ、滞留の余りに久しければ、様々の係累もやあらんと、相沢に問ひしに、さることなしと聞きて落居たりと宣ふ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "何等かの知識を女房が得たらしいとは認めても、その知識の範囲を測り知ることが出来ぬので、なんとも云うことが出来ない。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "往きてみれば待遇ことにめでたく、魯西亜行の労を問い慰めてのち、われとともに東にかえる心なきか、君が学問こそわが測り知るところならね、語学のみにて世の用には足りなん、滞留のあまりに久しければ、さまざまの係累もやあらんと、相沢に問いしに、さることなしと聞きて落ちいたりと宣う。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "往きて見れば待遇殊にめでたく、魯西亞行の勞を問ひ慰めて後、われと共に東にかへる心なきか、君が學問こそわが測り知る所ならね、語學のみにて世の用には足りなむ、滯留の餘りに久しければ、樣々の係累もやあらんと、相澤に問ひしに、さることなしと聞きて落居たりと宣ふ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "往きて見れば待遇殊にめでたく、魯西亞行の勞を問ひ慰めて後、「われと共に東にかへる心なきか、君が學問こそわが測り知る所ならね、語學のみにて世の用には足りなむ、滯留の餘りに久しければ、樣々の係累もやあらんと、相澤に問ひしに、さることなしと聞きて落居たりと宣ふ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日まで彼が心に待受け、また待受けつつあるものと、現に一歩踏出して見たこの世の中とは、何程の隔りのものとも測り知ることが出来なかった。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "この根元の法則は捕えどころもなく、その及ぶ範囲も普通の常識ではとても測り知ることができません。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖人の本意は、後世より測り知るべからざるものとして、しばらくこれを擱き、その聖人の道と称して、数百年も数千年も、儒者のこれを人に教えて、人のこれを信じたる趣をみれば、欠点、はなはだ少なからず。",
              "citation": {
                "source": "小学教育の事",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
