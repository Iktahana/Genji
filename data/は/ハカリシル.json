[
  {
    "uuid": "543b25e8-7e78-57fe-97c4-202bc67936fc",
    "entry": "計り知る",
    "reading": {
      "primary": "はかりしる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
