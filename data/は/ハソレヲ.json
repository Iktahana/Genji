        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "之ハ見タワケデハアリマセンガ、確ニ私ハソレヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹ハソレヲキイテ噴キダシタ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「仮リニ君ガ―――仮リニダヨ、―――春久トドウ云ウコトガアッタニシタッテ、僕ハソレヲ取リ上ゲル気ハナインダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソレヲ取リ壊シテ近代建築ニ作リ直し、ソコニ今度ハワレ／＼ノ隠居所ヲ作リタイ考デアルガ、ソレニハ今日マデ婆サンガ反対シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハソレヲ自分ノ座席ノ隣ニスワラセ、ピッタリ体ヲ寄セ着ケテ乗ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ知ッテイルヲ容易ニ口ニ出サナイノガ常デアルガ、悪イコトニハソレヲ女ノ嗜ミデアルトモ思ッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハソレヲ考エルト不安デモアリ、彼女ニ罪深イヲ好ムノデアル、―――ヲ刺戟シテ、ソレニヨッテ自分ヲ刺戟シヨウトスル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妻ハソレヲ口ニ出シタ※ハナイガ、ジェームス・スチュアートノ映画ダト缺カサズ見ニ行クラシイノデアル）モットモ妻ガ木村ニ接近スルノハ、僕ガ彼ヲ敏子ニ妻ワセテハドウカトイウ考エガアッテ、家庭ニ出入リサセルヨウニシ、妻ニソレトナク二人ノ様子ヲ見ルヨウニト命ジタカラナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日マデハソレヲ確カメル機会ガナカッタガ、今日彼女ガ映画ヲ見ニ出カケタ間ニ茶ノ間ヲ捜シテ、容易ニ探リアテルニハ、早クモ僕ニ嗅ギツカレルヲスル女デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキノ買イ物包ミハ提ゲテイタガ、僕ノ見テイル前デハソレヲ解カナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして私には「今日モナオ時代オクレナ舊道徳ヲ重ンズル一面ガアリ、或ル場合ニハソレヲ誇リトスル傾向モア」ったのである。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
