          "literary": [
            {
              "text": "ただ聞くところによれば、大川氏の携えていたピストルはなんらの許可を得ずしてもっていたものとのことであるから銃砲火薬類取締規則に触れることは別問題である」参照　刑法第三十六条――急迫不正ノ侵害ニ対シ自己又ハ他人ノ権利ヲ防衛スル為メ已ムコトヲ得ザルニ出デタル行為ハコレヲ罰セズ。",
              "citation": {
                "source": "黄昏の告白",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、かねての手はずのとおりに……」　なにやら低声に命令をくだした玄蕃は、お蓮様とお美夜ちゃんの待ってるところへ、たちいでて、「コレハコレハ、よく来られた。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ眠ル時ハコレヲ枕頭ニ安置ス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルイハコレニ基クカ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "近世人心浮薄ニシテ、父祖ノ詩モアルイハコレヲ刻セズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ学業イマダ成ラズシテ数省スルハコレ二親ノ喜バザル所、僕モマタコレヲ愧ヅ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "はぁああ、伊達と相馬の、境の桜、ハハコレワノサ……こらやい、早く歩べ……ハイッサイコレワノ、パラットセと。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神様ハコレデ人間ヲゴマカサウト。",
              "citation": {
                "source": "骨片ニ関スル無題",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハコレモワザトデハナイカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコレ以上生キナガラエテイタトコロデ格別ノコトモナイノダカラ、モシ今ノ世ニオ伝ノヨウナ女ガ現ワレタラ、ムシロソノ女ノ手ニカヽッテ殺サレタ方ガ幸福カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デハコレカライタシマス、別ニ痛クモ何トモゴザイマセンカラ御心配ナク」「心配ハシテオリマセン、ドウゾ御遠慮ナク」「ヨロシュウゴザイマスナ」針ガ頸部ニ射シ込マレルノガ感ジラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ困ルノハコレヲ実行ニ移ス方法如何デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハコレヲ読ミサエシナケレバ、意識ヲ失ッテイル最中ニ何ヲサレタカ知ラナイハズナノデアルカラ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハコレマデ決シテ必要以外ノ部分ヲ見タリ触レタリシタハ今モナオ疑問ダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ意ヲ決シテ木村ニ云ッタ、「デハコレノ現像ヲ頼ム、絶対ニ誰ニモ見セナイデスベテヲ君自身デシテクレタマエ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度ハコレヲ聞キタイノデスカ？",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハコレヲ破壊スルヨウニ命ジ、私ハ命ゼラレタ通リノコトヲシタ」「その通りだ」あなたの意識は思念を送った。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
