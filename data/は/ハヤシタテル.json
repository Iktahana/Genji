[
  {
    "uuid": "e92407b1-3c7c-538c-96c8-27312cf9e170",
    "entry": "はやし立てる",
    "reading": {
      "primary": "はやしたてる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
