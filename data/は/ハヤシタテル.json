      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to cheer",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "観客は、ホームチームのゴールに、一斉にはやし立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "応援団は、選手たちを勇気づけるため、大声ではやし立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の見事なパフォーマンスに、会場は歓声ではやし立てられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "壇上の人が何かいう度に、向かって右の方と左の方の椅子の列から拍手をしたり、何か分らぬ事を云ってはやし立てる人がいた。",
              "citation": {
                "source": "議会の印象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒い時分であったと思うが、二階の窓から見ていると黒のオーバーにくるまった先生が正門から泳ぐような格好で急いではいって来るのを「やあ、来た来た」と言ってはやし立てるものもあった。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンセント・スポールディングはね、わしを乗り気にしようとはやし立てるんですが、もう寝る時分になると考えるのをやめにしました。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」などゝはやし立てるのであつた。",
              "citation": {
                "source": "夜見の巻",
                "author": "「吾が昆虫採集記」の一節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「権兵衛が種蒔きゃ鴉がほじくる……」と子供はくやしがって、馬車のうしろから追いかけながら、はやし立てるのがおきまりだった。",
              "citation": {
                "source": "大人の眼と子供の眼",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時どつといふ喚声があがり、手を拍つて口々にはやし立てる女工等の声がふくれ上つて聴えて来た。",
              "citation": {
                "source": "道化芝居",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、ドイツがちよつとした新兵器を使つたといふので、まるで自分のことみたいに新聞にはやし立てるんですから、国民は、日本の科学者は何をしてるんだらうと思ひます。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを茂太郎が寺の前でうたうと、寺から餓鬼共が二三人、首を出して、やあい、やあい、牛小僧やあい、とはやし立てる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "Ocean の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやし立てる「ええじゃないか」の騒ぎは正月十四日になってもまだやまない。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞は面白がって、はやし立てる。",
              "citation": {
                "source": "雨を降らす話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを公卿達は喜んだ、日頃のうっぷんをはらすのはこの時とばかりにはやし立てる。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の使いを追い帰した奈良では、余勢をかって毬杖の玉の大きなものを作り、目鼻をつけるとこれを入道清盛の首と称して、踏め、打てなどはやし立てる中を、玉を蹴り、棒で叩くなど大いに憂を晴らしていた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第五巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　はやし立てる四五人の声。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒いステッキにすがったまま、市中へのちょっとした散歩をすますと、彼は灰色通りで、子供たちのはやし立てる声に迎えられながら、自分の住居へ帰って来る。",
              "citation": {
                "source": "トビアス・ミンデルニッケル",
                "author": "TOBIAS MINDERNICKEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "当れば、それこそ稀な・信じられない・驚くべきことであるから、人がはやし立てる。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "リエージュではルッカの温泉をもてはやし、トスカナではスパの温泉をはやし立てる。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段、万国の男女が酔いどれてはやしたてる。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、あまり、克巳がおもしらそうにはやしたてるので、いっしょになってこれも、「わはい、おじいさんの耳、毛がはえている。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、あまり克巳が面白さうにはやしたてるので、いつしよになつて、これも、「わはい、おぢいさんの耳、毛が生えてゐる。",
              "citation": {
                "source": "疣",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋は相もかはらず此処を先途とはやしたてる合唱をはらんで、大浮れの絶頂であつた。",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「右がひいきで西のお座敷のほうに寄っていた花を、今まで左方に貸してお置きあそばしたきまりがつきましたのですね」　などと愉快そうに右方の者ははやしたてる。",
              "citation": {
                "source": "源氏物語",
                "author": "竹河",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで噴火山のようにみごとなんだ、みんながはやしたてるんで、鼻をかくして台所へ逃げていって、出てこないんだよ。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とはやしたてると、云われた子はまっかなかおしてやめる。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "囃方がおもしろくはやしたてる。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベッピン、牛のクソふむなア」　とはやしたてる野良の年寄もいた。",
              "citation": {
                "source": "桂馬の幻想",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "さかんにはやしたてる星人たち。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、火星兵どもは、あやしげな声をあげて、はやしたてるのであった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「云ひつけよう、云ひつけよう」とはやしたてる少年少女の意地わるな眼つきはどうであらう。",
              "citation": {
                "source": "日本人とは？",
                "author": "――宛名のない手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とはやしたてるのです。",
              "citation": {
                "source": "あたまでっかち",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、はやしたてる　ほどでした。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
