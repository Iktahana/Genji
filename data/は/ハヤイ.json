    "definitions": [
      {
        "index": 1,
        "gloss": "fast",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この車は、本当に早い！あっという間にスピードが出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は計算が早いから、いつも問題を早く解ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「もっと早いペースで走らないと、間に合わないよ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「神学」としての歴史的地理的な研究は、まだまだ日本は、外国に及ばないようであるが、キリスト精神への理解は、素早いのである。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩といふものが、恰度帽子と云へば中折も鳥打もあるのに、帽子と聞くが早いか「ああいふもの」とハツキリ分るやうに分らない限り、詩は世間に喜ばれるも、喜ばれないも不振も隆盛もないものである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑ふといふ謂はば面白さの名辞に当る現象が早ければ早いだけ人は生活人側に属する。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――人類が驚きにひきつゞいた想ひを書かずに驚きの対象を記録した方が手つとり早いと考へたことには微笑すべき道理がある。",
              "citation": {
                "source": "小詩論",
                "author": "小林秀雄に",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペンクの足の早いのとベーアマンの口の早いのとに悩まされたが、ずいぶん色々とためにはなった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と狸はほくほくして、「でも、あの鮒つてやつは、素早いもんでなあ、おれはあいつを捕へようとして、も少しで土左衞門になりかけた事があるけれども、」とつい自分の過去の失態を告白し、「お前に何かいい方法があるのかね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「神學」としての歴史的地理的な研究は、まだまだ日本は、外國に及ばないやうであるが、キリスト精神への理解は、素早いのである。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉門次が一行の案内を務めるのは、言うまでもない、雨でグッショリ濡れた青草や、仆れている朽木からは、人の嗅覚をそそるような古い匂いがして、噎びそうだ、足が早いので、一丁も先になった嘉門次は、私を振り返って「他所の人足は使いづらくて困る」とブツブツ言いながら、赤石の河原に出た。",
              "citation": {
                "source": "槍ヶ岳第三回登山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻の先にぴかりと光ったのが早いか、鳴りはためいた。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、――明日も早いから――とおふくろは云ってる。",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して振り返って見た月日の経過はまた自分ながら驚くほどに早いものに思われた。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "優者の進歩の速度は始めには目ざましいように早い。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "細い溪流の橋の兩側と云つたやうな處のが特に紅葉が早いらしい。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝の早い父親は、私が眠い目を我慢して砥石で擦って持って行く灰吹を、座敷に坐り煙管を膝に構えたまま、黙って待っている。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とある街角などでばたばたと火を煽ぎながら、　――は、いらはい、いらはい、早いこと！",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あしたの朝は早いだらう。",
              "citation": {
                "source": "ラジュウムの雁",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "足が早いというのは道をあるくときの話だ。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに山は山だけに風が強く、湖水には白波が立って、空には雲の往来が早い。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "登るときは牛のようにのろい代りに、下り坂は奔馬のごとくスキーのごとく早いので、二度に一度は船暈のような脳貧血症状を起こしたものである。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーターの早い規律正しい廻転から起る音の中にはかなり純粋な楽音がいくつかある。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば早い話が教科書や試験問題には長さ一メートルの物差とか一グラムの分銅とかいう言葉が心配げもなく使ってあるが、実際には決して精密に一メートルとか一グラムとかいう量に出逢う機会は皆無と云ってよい。",
              "citation": {
                "source": "物理学実験の教授について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "中でも早吸の瀬戸などは神武天皇が東征の時に御通りになったというので、歴史で名高くその名も潮流の早い事を示していて大変に面白い名でありますが、今ではただ豊後海峡と呼ばれています。",
              "citation": {
                "source": "瀬戸内海の潮と潮流",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このほか名高い瀬戸や普通の人の知らぬ瀬戸で潮流の早いところは沢山ありますが、しかし、何といっても阿波と淡路の間の鳴門が一番著しいものでしょう。",
              "citation": {
                "source": "瀬戸内海の潮と潮流",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＡＢとＣの間に波形の模様を描いたのは流れの早い部分の有様を示したものです。",
              "citation": {
                "source": "瀬戸内海の潮と潮流",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "月が少し早いようですと報告した。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "またある人の話によると、落葉樹の葉の中で遅く発育したのがまだ十分成熟しないうちに早い霜に痛んでしまうと、それきり発育が止まって、コルク質の出来る間がなく、梢に枯れたまま淋しい趣を見せるという事である。",
              "citation": {
                "source": "歳時記新註",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹木と遺伝　樅などの種子を播いてその生長の遅速を試験してみると、低い土地から取って来た種子の方が高地から取ったのに比してよほど生長が早いという事がスイスやオーストリー辺で確かめられた。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三分早い　三分ぐらい　三分あれば師団の編成が出来る。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶店の娘のお絹が朝早いので、お客がない鬱晴らしに三次と世間話をしている。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺屋の白袴、医者の不養生ということもあるが、物理の学徒等が日常お互いに自由に話し合う場合の用語には存外合理的でないものが多数にあって、問題の「速度のはやい」などもその一例である。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
