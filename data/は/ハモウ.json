        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレ共、友田ニ心ヲ移シテシマッタ彼女ハモウ全ク私ニハ戻ッテ来ヨウトハシマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "より江は淋しいので、兄さんが大事にしているハモウニカを借して貰って、一人で出鱈目に吹いて遊びました。",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校六年生の健ちゃんはときどき机から顔をあげて、「よりちゃん、ハモウニカに唾を溜めちゃ厭だよ。",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "より江はハモウニカを灯に透かしてみました。",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢山窓があるので、小さいより江は、すぐ汽車の事を考え出して、ハモウニカを算盤の上へ置いて「汽車ごっこ」とひとりで遊びました。",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "より江が板の間の方までハモウニカの汽車を走らせていると、戸外で、「今晩、今晩、今晩！",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "より江は淋しいので、兄さんが大事にしてゐるハモウニカを借して貰つて、一人で出鱈目に吹いて遊びました。",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校六年生の健ちやんはとき／″＼机から顔をあげて、「よりちやん、ハモウニカに唾を溜めちや厭だよ」　といひました。",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢山穴があるので、小さいより江は、すぐ汽車の事を考へ出して、ハモウニカを算盤の上へ置いて「汽車ごつこ」とひとりで遊びました。",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "より江が板の間の方までハモウニカの汽車を走らせてゐると、戸外で、「今晩　今晩　今晩は‥‥」　といふ声がします。",
              "citation": {
                "source": "蛙",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ッテモ、オ勝ハモウスグオ産ヲスル。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハ、コンゲツ一パイメッタニ雨モフラズ、カゼモナクテ、マイニチマイニチヤケルホドアツクテ、ワタシハモウスコシデ、クタバッテシマフトコロデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トイヒマシタガ、ヨシヲサンハモウウミノ中ヘトビコンデシマヒマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤ」ト思ッテ、予ハモウ一遍耳ヲ澄マス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手ハモウスッカリオ直リニナッタンデスカ」来ルトイキナリ気ヲ呑マレタ形デ眼ヲ白黒サセテイタ五子ハ、コヽデ辛ウジテ嘴ヲ入レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハモウ少シデ怒号スルトコロデアッタガ、怒号シタラ動脈ガ破裂スルノヲ怖レテ、辛ウジテ怺エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子ハモウ部屋ニイナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハモウ一度彼女ノ衣類ヲ全部、何カテ何マデ彼女ガ身ニ纏ッテイルモノヲ悉ク剥ギ取リ、素ッ裸ニシテ仰向カセ、螢光燈トフローアスタンドノ白日ノ下ニ横タエタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスコノ鴨川タキシーマデ歩イテ行ッテ、寝テイルノヲ叩キ起シテ乗ッテ来タノデス」ト云ッテ、コチラガ聞キモシナイノニ、「家ヲ出タノハモウ二十分以上モ前ナンダケレド」ト独語ノヨウニ附ケ加エタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ノ耳ニハモウアノ真珠ガ下ッテイナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
