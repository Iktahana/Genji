        "examples": {
          "standard": [
            {
              "text": "その企業は常にハイテクな製品を開発している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ハイテク産業は、国の経済を牽引する重要な分野だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最新のハイテクを駆使した医療機器が導入された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その後の映画会社の買収やハイテクパークの開発に、オレはかつてのマシンへの求心力を感じ取れなくなっていた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾分か未発達な生活共同体を助けることを目的としたにも関わらず、“ハイテク”計画となったことに、ロンドン大学の衛生・熱帯医学学部から厳しい批判が加えられた。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしもあなたが技術畑の人間であるなら、エレクトロニクス関係の企業に籍を置いているなら、ＮＥＣブランドにはかねてからハイテックなイメージを持っていたかもしれない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "技術者の思い描くハイテックなイメージとほとんどの日本人が持っていただろう「売れない家電」のイメージ――。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九三二（昭和七）年には住友系の傘下に入ったが、創業以来一貫して、官需中心に電話機、交換機、のちには無線通信機、コンピューター作りに携わってきたハイテック企業である。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロッキード社の進出によって果樹園の村からハイテックの町へと変貌を遂げていたサニーベイルで、ウォズニアック家の近隣はエンジニアの家庭だらけだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九六三年にクパチーノに新設されたホームステッドハイスクールは、急増するハイテック企業の従業員の子弟を一手に受け入れた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "終戦後の一時的な落ち込みはあったものの、ＨＰはその後、エレクトロニクス台頭の波に乗って、代表的なハイテック企業として成長を遂げていった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は付近の大学やハイテック企業、ＰＣＣのたまり場などにビラを貼り、一九七五年三月五日、メンローパークにあるフレンチの家のガレージに集まった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイテック日本がさんざ囃される中で、日本のパーソナルコンピューター産業は取り残されていったのだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
