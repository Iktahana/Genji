          "literary": [
            {
              "text": "「ベツドは、ハンモツク？",
              "citation": {
                "source": "山を越えて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "樽野は其処の椿の枝から肉桂の幹にハンモツクを釣り放しにして置いた。",
              "citation": {
                "source": "籔のほとり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "或夏、新しいハンモツクを買つて来て庭の森の木の間に結はえて置いた。",
              "citation": {
                "source": "若芽",
                "author": "島田清次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の日の午後など緑陰の下にうつとりとハンモツクの上に眠つて居る若い人の白い顔が、本を持つた手と共に目に残つてゐた。",
              "citation": {
                "source": "若芽",
                "author": "島田清次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると若い文士はハンモツクから寝てゐる身体を起しにかゝると『いゝよ。",
              "citation": {
                "source": "若芽",
                "author": "島田清次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆やもお女中もゐない家庭なので、ふしぎに思つて、ある時、訊いてみると、新婚二年ぢかい若奧さんは、「えゝ、宅では、出かける時、ベビーにミルクをたんと飮ませておいて、家の中のハンモツクに、落ちないやうに縛つて入れておくんですの。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
