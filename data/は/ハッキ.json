  {
    "uuid": "2c029664-7e59-5a5f-81f9-5009b1e96119",
    "entry": "発機",
    "reading": {
      "primary": "はっき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "貴方を抱いて、ちゃんと起きて、居直って、あいそづかしをきっぱり言って、夜中に直ぐに飛出して、溜飲を下げてやろうと思ったけれど……どんな発機で、自棄腹の、あの人たちの乱暴に、貴方に怪我でもさせた日にゃ、取返しがつかないから、といま胸に手を置いて、分別をしたんですよ。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "｜水漉しへ逃込もうとした彼は、油に滑って其儘ワイヤア氏｜蒸発機の蔭へ横ざまに倒れた。",
              "citation": {
                "source": "上海された男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノースウエスト航空会社のＤＣ四型という四発機。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸上機でもこんなのを一九三二年に同軸上に星型発動機を二基積む四発機。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と叫んだまゝ、空拳を振つて本艦々頭に仁王立、轟大尉は虎髯逆立ち眦裂けて、右手に握る十二｜珊砲の撃發機は唯だ艦長の一令を待つばかり。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
