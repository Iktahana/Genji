        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "己ハアノ揚巻ノ顔ヲ見テルダケデモイクラカ痛ミヲ忘レルンダ」予ハ婆サンニ窘メラレテ一層｜依怙地ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダケドアレヲ提ゲテ歩イタラ、僕ガ買ッテヤッタンダト、婆サンガ感ヅキャシナイカナ」「オ婆チャンハアノ時見テイラッシャラナカッタワ、ドン／＼歩イテ先ノ方ヘ行ッテラッシャイマシタワ」ヤッパリソウダッタナト予モ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞ニハアノ時ノ石ガ二百萬圓ト書イテマシタネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鑿ト云ウノハアノコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ彼女ハ、遠カラズ予ガ死ンデシマッタ後モ、「アノ馬鹿ナ老人ハ私ノコノ美シイ足ノ下ニ眠ッテイル、私ハアノ可哀想ナ老人ノ骨ヲ今モナオ地下デ蹈ミツケテイル」ト思ウコトヲ禁ジ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ中年以後、妻ノ度ハズレテ旺盛ナ請求ニ応ズル必要ガアッタタメニ、早期ニ精力ヲ消耗シ尽シ、今日デハアノ方面ノ慾望ガハナハダ微弱ニナッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁ノハンガーニハアノ衣裳ガマタダラリト垂レテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
