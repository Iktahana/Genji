        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「ハハヽヽヽヽ五目並べじゃしかたがない。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハヽヽヽヽ、おどろいたかい。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハハハヽヽヽヽ、どうだね、この早わざは。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハヽヽヽヽ、それは今お目にかけるよ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハヽヽヽヽ、わかりましたか。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからともなく、きこえてくる、クスクスという、しのび笑い、それが、だんだん大きくなって、ついにワハハヽヽヽヽヽと、人をばかにした大笑いになりました。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハヽヽヽヽ、きみは、それが爆発すると思っているのか。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハヽヽヽヽ、手榴弾だって、同じことだよ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハヽヽヽヽ、きみは顔色をかえたね。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハヽヽヽヽ、いくら小林が変装がうまくても、こんなにうまくばけることはできないよ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハヽヽヽヽヽ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
