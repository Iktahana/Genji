          "standard": [
            {
              "text": "検索結果が多すぎたので、期間で範囲を狭めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "候補者が100人以上いるため、経験年数で範囲を狭めて絞り込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "地域全体の需要調査だったが、都市部に範囲を狭めて詳しく分析した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "けれども封建時代にのみ通用すべき教育の範囲を狭める事なしに、現代の生活慾を時々刻々に充たして行ける訳がないと代助は考へた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども封建時代にのみ通用すべき教育の範囲を狭める事なしに、現代の生活慾を時々刻々に充たして行ける訳がないと代助は考えた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しそこで第一から第四までの痕跡を発見することが出来なかったら、さしずめ第五と第六の場合が残るばかりだから、非常に捜査範囲を狭めることが出来る訳だ。",
              "citation": {
                "source": "黒手組",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
