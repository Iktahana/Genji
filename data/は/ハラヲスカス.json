        "examples": {
          "standard": [
            {
              "text": "一日中歩き回って、すっかり「腹を空かした」。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "運動した後だから、「腹を空かせて」何でも美味しく食べられそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ああ、もう「腹を空かした」よ！早くご飯食べたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "今に自分も犬と一緒に腹を空かすやうになるまでさ。",
              "citation": {
                "source": "犬の八公",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しか、急に出て行くやうなことがあると、晩御飯も食べないぢや、お腹を空かすわよ。",
              "citation": {
                "source": "空の悪魔（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
