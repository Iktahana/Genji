        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今此処から聞えるヴァイトゥリンガの水音までが、ハイランドの急流のそれの様な気がして来る。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "爽かに、何かハイランド的な感じだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンノ　ウデニ、オチチクサイ、シロイ　パヂヤマノ　カハイラシイ　アカチヤンガ、ダカレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "光りが単に物象からの反射としてみる場合は、安易にハイライトを描ききつて、物質に対する光りの効果を外光派的に生かすことができよう。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻村伊助氏の「スウィス日記」及び「「ハイランド」、この二册はいかにもすぐれた登山文藝として爽高の感じを與へるものである。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻村氏の「ハイランド」は我々にこの二つの東西の高原風景を結び付けて、親ましめてくれる。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私はハイラルのＴ社のものですが、この人は今日一寸手伝いに頼んだ人です。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は大雨が降りましたものですから、ハイラルの飛行機が出ませんので、この人を頼んだのです。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイラルから今飛行機で来たばかりですが、さっきまでは豪雨で今夜帰れないかもしれないのですよ。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この聖マテオのハイランド街に、私の妻の妹が住んでいます。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、四、五日前遊びに来て言いますには――」　そのハイランド街を妹の家から一町程下った一軒の建物に、この頃、白い制服を着た看護婦の姿が見える。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かしらぴいんと来るものを感じたガフは、直ぐその足で問題のハイランド・アヴェニウの家へタクシを乗りつける。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇躍したガフ刑事は、其の場から直ちに瓦斯会社へ飛んで、成程三月三日附けをもってハイランド街六一五番のＦ・フランシス夫人なる人から、中二日置いた三月六日から瓦斯の供給を受け度い旨の申込が出ていることを発見した。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は確かに、三月五日、七日の両日に、そのハイランド街六一五番の家へ、休止してある瓦斯管を開きに行ったと語った。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　そのアル・ベェダアの話しでは、ハイランド街六一五の家には三月五日から水を供給したとある。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人は窓を毀して其のハイランド街六一五の家へ這入り込んだ。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "この三人の看護婦の写真を手に入れて、問題の家の隣家の主婦、ハイランド街六二一のシュワイツア夫人に見せると苦もなく、其のうちの一人を指して隣りの六一五番に見掛けた女であると言明した。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "引き受けたが、桑港では眼に付くというので、一時聖マテオのハイランド街にある家を借りて、フランシス・メイスンを雇って準備している。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイラルでは四年ほど住んでゐた。",
              "citation": {
                "source": "崩浪亭主人",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同室者は、ハイラルで降りる、ロシヤ人のお婆さんでした。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "林檎を描くとします、その光ったハイライトの部分は、先きに描いて置くのです、次に暗い影を描くのです、最後に赤い全体の球を塗りつぶすのであります。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "その光ったハイライトの部分は、先きに描いて置くのです。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕○毛糸の足袋下はハイラないのでしょうか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この感情が普遍的だということは、ラジオが一九四七年度のハイライトで水泳の古橋選手を紹介するとき、アナウンサーは古橋選手のレコードで日本もやっと国際的な一つの窓をあけられたように明るくなった、と語った。",
              "citation": {
                "source": "それらの国々でも",
                "author": "――新しい国際性を求めて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽い夕飯を食っているのはグリーン色の縞のスカートに膝出したハイランダアである。",
              "citation": {
                "source": "中條精一郎の「家信抄」まえがきおよび註",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガブリーラや、ミハイラやバラーシュカたちは、気ちがひのやうにかけまはつて、なんだか、どなつてゐます。",
              "citation": {
                "source": "そり（童話）",
                "author": "オイゲン・チリコフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジューネーの、銀の壺に盛られた琥珀の蜜も、煙草の名のハイライフも、紅のように頬を染めたあの北風も、今はなかなか忘れられない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハルハ地方の外蒙兵越境事件に就いて満州帝国が外蒙古と交渉中の処を、又々ハイラステンゴールに於ける同様な事件が惹き起こされた。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野原の土地そのものは、盆地ともいえないし、高原ともいいにくい山間の迫ったところに、おのずから小規模のハイランドを形づくっているだけに、そこではまた何ともいえない荒涼たる月の光を見ることがあるのであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
