[
  {
    "uuid": "ce0a5f36-90a1-52b2-97ca-c735f99b225d",
    "entry": "煩労",
    "reading": {
      "primary": "はんろう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
