        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「心細イコトヲ云ハナイデ欲イヨ、だつでい――僕トイフ息子ノアルコトヲ忘レタンデスカ？",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "不便ト思ウノハイヽケレド、オ爺チャンヲ楽シマセルタメニ、アタシガ犠牲ニサレルノハ嫌ダワ」「犠牲ト云ウコトハナイデショウ、僕ヲ楽シマセルト同時ニ、君自身モ楽シムンジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「君ト一緒ダトイツモ興奮サセラレル」「アンナ顔ヲ見テ興奮スルコトハナイデショウ」「アノ顔ヲ見タ上デ君ノ顔ヲ見ルト、溜ラナク興奮スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ理由ハアタシニハヨク分ラナイガ、オ爺チャンコソ何カシラ感ヅイテイラッシャルノデハナイデショウカト、乙ニ絡ンデ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハカネテカラ、敏子ガ木村ヲ避ケル風ガアルヲ、彼女モ感ヅクニ至ッタカラデハナイデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「脳貧血カモ知レマセンカラ、湯タンポハオ止メニナッタ方ガヨクハナイデスカ」ト木村ガ云ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真デ思イツイタガ写真機ガ欲シクハナイデスカ、「パテエ・ベビイ」ハイカガ？",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ケレドアナタノ決心ガ真ニ最後ノモノデアルナラ、一日モ早イ方ガヨクハナイデスカ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスレバ斯波君ダッテ「気ガ楽ニナル」デハナイデスカ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
