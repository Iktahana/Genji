          "literary": [
            {
              "text": "諸君はハマモノという言葉を知つているであろう。",
              "citation": {
                "source": "映画と民族性",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "民族に根ざし、民族に生れた芸術が、自己の民族に対する奉仕を忘れて国際性を第一義とし、輸出を目的とした場合、それはたちまちハマモノに転落し国籍不明の混血児ができあがるのである。",
              "citation": {
                "source": "映画と民族性",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには故事があってその中に波摩毛、すなわちハマモの名が見え、これは浜藻でそれは海藻のホダワラであろうとの事である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
