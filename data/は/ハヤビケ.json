    "definitions": [
      {
        "index": 1,
        "gloss": "leaving work (office, school) early",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日は歯医者の予約があったので、会社を早引けした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "部活の試合があるので、生徒たちは早引けして会場に向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「お先に早引けさせていただきます。」と、彼は皆に挨拶した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三亀雄の妻の早引けは帳消しになった。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "神谷も毎日会社を早引けにして、蘭子の楽屋部屋に入りびたり、注意をおこたらなかった。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎が友達の手を離して出て行くと、使丁に案内されて来た迎への俥屋が、直ぐに早退けを貰つて、自宅へ駆け戻れといふことであつた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく学校へ行くのをやめたり早退けしたりして上野の図書館へ行った。",
              "citation": {
                "source": "年譜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ、格子戸が勢いよくあいて早退けで社からかえってきた内狩の声が聞え、彼はあがってくるとすぐポケットの中から謄写版で刷った一枚の紙きれをとりだした。",
              "citation": {
                "source": "菎蒻",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
