[
  {
    "uuid": "95a7bf2b-f82f-5ca2-bd4a-71d41c5328b1",
    "entry": "蜂の子",
    "reading": {
      "primary": "はちのこ",
      "alternatives": [],
      "is_heteronym": false
    },
