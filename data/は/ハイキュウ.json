  {
    "uuid": "1249cf92-f9f0-5ae1-bd69-989c8d940f34",
    "entry": "配給",
    "reading": {
      "primary": "はいきゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
