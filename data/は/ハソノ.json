        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我輩ハソノ期間ニ、我輩自身ヲ我輩ノ私室ニ密閉シ、君ノ文章ヲ研究シ、シカシテ、我輩ノ答ヲ、我輩ノ能力ノ最大ヲ致シテ書キシタタメルデアロウ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナオマタ、切手、モシクハ葉書、御不用ノ際ハソノママ御返送ノホドオ願イ申上候。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オ母ッチャハソノツギノ日カラネテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "）三、ヒラガナトイウモノハソノ素性ヲ探ルト、イズレモ漢字ヲ極端ニ崩シタモノニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ソレハソノ日ノ夜半デアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　友田ハソノ頃便所ニ立ッタカモ知レヌト申シテ居ルガ、道子ト話ヲシタ事ハ全クナイト云ッテ居ルガ如何。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ニハソノ顔ガ悪魔ノヨウニ見エマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ時自分ノ危険ヲ考エテオリマセンデシタガ然シモシ誰カ来タラ自分ハ道子ヲ一思イニ殺シテ自殺スル気デシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハソノ間苦シミニ苦シンデ居タヨウデシタガ、ソノ中、清三ガ意識ヲ復シテ動クヨウデシタカラ、思イ切ッテ、道子ノ心臓ト思ウトコロヲ一刺ニ刺シテ此ノ女ヲヤッツケテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴ガ下船シテ故郷ニ引込ンダノハソノ直後ダッタ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ツテヰル間中、死ンダヤウニナツテヰルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　二定点間ノ最短距離ハソノ二点ヲ結ブ線分ナリ。",
              "citation": {
                "source": "未開な風景",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ッテイル間中、死ンダヨウニナッテイルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "石黒氏ノ近業ハソノ名ノ示スガ如ク往昔郷閭ノ私塾ナリシ有隣舎ノ沿革ヲ調査シソレガ師弟ノ伝ヲ述ベタルモノニシテコレスナハチ拙稿『下谷叢話』ノ記述スル所トホボソノ事ヲ同ジクスルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "答フル所アルイハソノ問フ所ニ異ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "医ハソノ好ム所ニ非ズトイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "若キ令嬢ハソノ美貌ニ加エ真ナル価値ニ恵マレ、コノ婚姻ヲ光輝アラシメ至福ヲ永遠ナラシム也。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソノ足ヲ自分ノ膝ノ上ニ載セ、五本ノ趾ヲ一本々々握ッテ見タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ノ沢村源之助ノ舞台顔ニハソノ感ジガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今年ハソノ割ニ雨ガ降ラナカッタジャナイカ」「モウ今日ハ草市デスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソノ言葉ノタメニ興奮ヲ感ジタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ寝台ニ仰臥シ、盲人ノ鈴木氏ハソノ傍ノ椅子ニ腰カケテ治療ヲ施ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父ト母トハソノ古イ方ノ家ヲ隠居所ニシテ、土地ノ閑静ナノヲ愛シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ狙ッテイタ三百萬圓ハソノ金ノ一部ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "体ガ丈夫デサエアレバコンナ秋日和ノ日ハドンナニ爽快デアロウ、予モ四五年前マデハソノ爽快味ヲ満喫シテイタノニト思ウト、クヤシクモ忌マ／＼シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソノ涙ヲゴマカスタメニ慌テヽ眼鏡ヲ取ッテカケタガ、忽チ眼鏡ガ曇ッタノデ、一層工合ガ悪カッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓地捜シヨリハソノ方ガ優シダ、私ガ御案内シマショウト京二郎ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ鑿師ニハソノ図ヲ示シテ、ソノ図ノヨウニ線彫リサセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
