[
  {
    "uuid": "5fc7cc34-a9e5-5a08-b0ce-c02b740b4556",
    "entry": "腹合わせ",
    "reading": {
      "primary": "はらあわせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
