    "definitions": [
      {
        "index": 1,
        "gloss": "women's obi with a different colour on each side",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は特別な日のために、リバーシブルの腹合わせの帯を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "腹合わせの帯は、裏と表で異なる表情を見せるので着物の雰囲気を変えるのに便利だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖母の遺品整理をしていたら、美しい刺繍が施された腹合わせの帯が出てきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "眉の痕の青い櫛巻髪に黒繻子の腹合わせ帯。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯は白茶と鶯茶の腹合わせをしていた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫛巻きとかいうものに髪を取上げて、小弁慶の糸織の袷衣と養老の浴衣とを重ねた奴を素肌に着て、黒繻子と八段の腹合わせの帯をヒッカケに結び、微酔機嫌の啣楊枝でいびつに坐ッていたのはお政で。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "困難な新進の道　芥川賞を得た小田嶽夫・鶴田知也「二新人に訊く」という題で『三田新聞』に小田嶽夫氏の書いている文章をよみ、それと腹合わせに「創生記」（太宰治・新潮）を読み、私は鼻の奥のところに何ともいえぬきつい苦痛な酸性の刺戟を感じた。",
              "citation": {
                "source": "十月の文芸時評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれは、黒繻子と、紫縮緬とを腹合わせにした、女帯であった。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "うらうらと燃える陽炎を背に、無造作な櫛巻き、小弁慶の袷に幅の狭い繻子と博多の腹合わせ帯を締めて、首と胸だけをこう背へ振り向けたところ、「おや！",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は暗い側を選んで、廊下のかべに腹合わせに、身を押し付けて立った。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "襟のかかった渋い縞お召に腹合わせ帯をしめて、銀杏返しに結って居る風情の、昨夜と恐ろしく趣が変っているのに、私は先ず驚かされた。",
              "citation": {
                "source": "秘密",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『春色恋白浪』に「鼠色の御召縮緬に黄柄茶の糸を以て細く小さく碁盤格子を織｜出したる上着、……帯は古風な本国織に紺｜博多の独鈷なし媚茶の二本筋を織たるとを腹合せに縫ひたるを結び、……衣裳の袖口は上着下着ともに松葉色の様なる御納戸の繻子を付け仕立も念を入て申分なく」という描写がある。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "『春色恋白浪』に「鼠色の御召縮緬に黄柄茶の糸を以て細く小さく碁盤格子を織出したる上着、……帯は古風な本国織に紺博多の独鈷なし媚茶の二本筋を織たるとを腹合せに縫ひたるを結び、……衣裳の袖口は上着下着ともに松葉色の様なる御納戸の繻子を付け仕立も念を入て申分なく」という描写がある。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋が両方にある、茶の間かと思う左の一層暗い中から、ひたひたと素足で、銀杏返のほつれながら、きりりとした蒼白い顔を見せた、が、少し前屈みになった両手で、黒繻子と何か腹合せの帯の端を、ぐい、と取って、腰を斜めに、しめかけのまま框へ出た。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとい芳さんと私とが、どんなに潔白であッたからっても、世間じゃそうとは思ってくれず、（へん、腹合せの姉弟だ。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」　　　　　　　六　黒の唐繻子と、薄鼠に納戸がかった絹ちぢみに宝づくしの絞の入った、腹合せの帯を漏れた、水紅色の扱帯にのせて、美しき手は芙蓉の花片、風もさそわず無事であったが、キラリと輝いた指環の他に、早附木らしいものの形も無い。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其奴の間夫だか、田楽だか、頤髯の凄まじい赤ら顔の五十男が、時々長火鉢の前に大胡坐で、右の叔母さんと対向になると、茶棚｜傍の柱の下に、櫛巻の姉さんが、棒縞のおさすり着もの、黒繻子の腹合せで、襟へ突込んだ懐手、婀娜にしょんぼりと坐っているのが毎度と聞く。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じようなのが二枚出来たところで、味噌の方を腹合せにしてちょっと紙に包んで、それでもう事は了した。",
              "citation": {
                "source": "野道",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "艶やかな黒髪を惜気もなくグッと引詰めての束髪、薔薇の花挿頭を※したばかりで臙脂も甞めねば鉛華も施けず、衣服とても糸織の袷衣に友禅と紫繻子の腹合せの帯か何かでさして取繕いもせぬが、故意とならぬ眺はまた格別なもので、火をくれて枝を撓わめた作花の厭味のある色の及ぶところでない。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "この巡査は丸帯も腹合せもいっこう知らない。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもくすんだ縞物を、年相応に着こなして、腹合せの黒だけが目に着くほどに締めている。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺縮の単物に、黒襦子と茶献上との腹合せの帯を締めて、繊い左の手に手拭やら石鹸箱やら糠袋やら海綿やらを、細かに編んだ竹の籠に入れたのを懈げに持って、右の手を格子に掛けたまま振り返った女の姿が、岡田には別に深い印象をも与えなかった。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "帶は紺の唐繻子と縞のお召との腹合せである。",
              "citation": {
                "source": "身上話",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯はどんな帯だ」「どんな帯って、そんなに何本もあるもんですか、黒繻子と縮緬の腹合せの帯です」「黒繻子と縮緬の腹合せの帯一筋――価はいくらくらいだ」「六円くらいでしょう」「生意気に高い帯をしめてるな。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱いだ袴を畳んで、桃色メリンスの袴下を、同じ地の、大きく菊模様を染めた腹合せの平生帯に換へると、智恵子は窓の前の机に坐つて、襟を正して新約全書を開いた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱いだ袴を疊んで、桃色メリンスの袴下を、同じ地の、大きく菊模樣を染めた腹合せの平生帶に換へると、智惠子は窓の前の机に坐つて、襟を正して新約全書を開いた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便局の為替受け口には、黒繻子とメリンスの腹合せの帯をしめた女が為替の下渡しを待ちかねて、たたきを下駄でコトコトいわせている。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "また大きな牡丹の模様の出た腹合せの帯に午後の日影の線をなしてさしてゐるのを見たであらう。",
              "citation": {
                "source": "百合子",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "年は十九か、二十にはまだなるまいと思われるが、それにしても思いきってはでな下町作りで、頭は結綿にモール細工の前※し、羽織はなしで友禅の腹合せ、着物は滝縞の糸織らしい。",
              "citation": {
                "source": "深川女房",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯はメリンスに繻子の腹合せと思われ、襦袢の襟は赤らしく、着物の襟は繻子でした。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "街の裏と表とではまるで地獄と極楽とが腹合せになっているというようなところである。",
              "citation": {
                "source": "余齢初旅",
                "author": "――中支遊記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「でも、お師匠さん、すこし根下りの大丸髷に、水色｜鹿の子の手柄で、鼈甲の櫛が眼に残っていますって――黒っぽい透綾の着物に、腹合せの帯、襟裏も水浅黄でしたってね。",
              "citation": {
                "source": "市川九女八",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとなは今のやうに丸帶ははやらない、丸帶はよつぽど大よそゆき――つまり儀式ばつた時にばかり用ふるので、片側帶があたりまへだつたから、腹合せの片側の上等品は、唐繻子だつた。",
              "citation": {
                "source": "日本橋あたり",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
