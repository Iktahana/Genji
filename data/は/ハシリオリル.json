        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "秋の海名も無き島のあらはるゝ　これより一目散に熱海をさして走り下りるとて草鞋の緒ふッつと切れたり。",
              "citation": {
                "source": "旅の旅の旅",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "木華里は一礼して走り下りる。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳麗玉も勇躍して、見送りに走り下りる。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転車の達者な者は、一気に走り降りることも出来たが、昇りはみな徒歩で自転車を押し上げた。",
              "citation": {
                "source": "庶民生活",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "二枚並べて架けた板梯子を踏んで、一定の間隔を置いた黒人たちが、一つを駈け上って他の一つから走り降りる。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "このミコシが天下無類の荒れミコシで、まず表参道を走り降りる。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思った五郎は、階段を走り降りると、胸を躍らせながら受話器を手にした。",
              "citation": {
                "source": "劇団「笑う妖魔」",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
