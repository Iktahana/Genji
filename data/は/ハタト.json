  {
    "uuid": "24c83f03-6620-5fad-a767-14b48908f144",
    "entry": "ハタト",
    "reading": {
      "primary": "はたと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
