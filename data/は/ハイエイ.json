[
  {
    "uuid": "53ff145b-4e37-5ab6-a8ef-4b87e919584b",
    "entry": "背泳",
    "reading": {
      "primary": "はいえい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
