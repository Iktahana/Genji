        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "サービス精神旺盛な店主は、いつも少し多めに惣菜を量り込んでくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "粉末洗剤を詰め替える際、うっかり規定量以上に量り込んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は袋いっぱいにキャンディを量り込み、満足そうにレジへ向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "さういふ米を俵に量り込むと、米は米自身の重さでずつしりとして、米の一粒々々は互にしつくりと抱き合ひ、その緊密さ、隙間の無さは、土臼で摺つたものとは大きな相違なのである。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "升取りの巧みなる者は一斗の米を一斗三合に計り出し、その拙なる者は九升七合に計り込むことあり。",
              "citation": {
                "source": "学問のすすめ",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "升取りには巧拙あるも、これによりて生ずるところの差はわずかに内外の二、三分なれども、才徳の働きを升取りするに至りてはその差けっして三分にとどまるべからず、巧みなるは正味の二倍三倍にも計り出し、拙なるは半分にも計り込む者あらん。",
              "citation": {
                "source": "学問のすすめ",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この計り出しの法外なる者は世間に法外なる妨げをなしてもとより悪むべきなれども、しばらくこれを擱き、今ここには正味の働きを計り込む人のために少しく論ずるところあらんとす。",
              "citation": {
                "source": "学問のすすめ",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
