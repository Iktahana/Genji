        "examples": {
          "standard": [
            {
              "text": "「商品に不都合がございましたら、パッケージ裏面に記載の販売元までご連絡ください」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この輸入玩具の国内販売元は大手商社だが、実際の流通は専門の問屋が担っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "同じ商品でも販売元によって保証内容やサポート体制が異なるため、購入前に確認が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "★『マッキントッシュ伝説』（インタビューアー　斎藤由多加、オープンブック、販売元　マックワールド・コミュニケーションズ・ジャパン、一九九四年）中のアラン・ケイのコメント。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "保険会社の方は兎に角聖書会社は博愛主義の基督教の宝典たる聖書の販売元だから、罪を憎んで人を憎まずと、損害賠償の私訴などを起して、今更支倉を苦しめなくても好さそうなものだが、矢張りそうは行かぬと見えて、忽ち訴訟を起した。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
