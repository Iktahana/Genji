        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハルハ地方の外蒙兵越境事件に就いて満州帝国が外蒙古と交渉中の処を、又々ハイラステンゴールに於ける同様な事件が惹き起こされた。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつてヘルキュレスとハイラスの物語を読んだとき、彼女は一種白昼夢のなかの半意識で、あの異教徒的な男性の持つものに魅惑されたと思いはしなかったか。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのハイラスはお小姓だった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
