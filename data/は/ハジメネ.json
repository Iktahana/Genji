        "examples": {
          "standard": [
            {
              "text": "今朝の東京株式市場で、主要銘柄の始値は前日終値を大きく上回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "始値が決まった瞬間、取引所内には活気ある声が響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "原油価格の急騰を受けて、関連企業の始値に注目が集まっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "小屋係りはその渓流のほとりでとっつきの仕事をはじめねばならない。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "福井の由緒古い町人の家に生れた彼であることから、考へはじめねばならぬ。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、はじめね。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは古代の立派な人々と同じく善くあるべきであるが、ある程度まではまずいかに善くかれらがあったかを知ることからはじめねばならぬ。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "常識を否定するのにはまず常識から踏みはじめねばならぬ。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
