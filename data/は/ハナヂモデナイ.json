        "examples": {
          "standard": [
            {
              "text": "給料日前に財布の中身を見たら、鼻血も出ないほどお金がなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "宝くじが当たったかと期待したが、結果は鼻血も出ない金額だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "月末はいつも鼻血も出ない状態だから、節約を心がけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ある日、逆さにふっても鼻血も出ない一文無しでこの金沢の楽屋を出て、京橋の上へかかってきたら忘れもしない爺さんの乞食が、自分の前に七、八銭並べて、どうぞやどうぞやとお辞儀をしている。",
              "citation": {
                "source": "初看板",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって、そうなれば、逆さに振ったって鼻血も出ないんだからな。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
