                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "昨日から株価が跳ね上がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "インフレで商品の値段が跳ね上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
