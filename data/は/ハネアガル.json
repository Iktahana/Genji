    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "隙を覗つたる水兵は、サツと出口の扉を排くと、途端、稻妻は、猛然身を跳らして、彼方の岸へ跳上る。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩は何の目的もなく器械的に跳上る。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビ・リ・リ・リ・リと叫びながら遠野のくれた喙の紅い小鳥が籠の中で跳上る。",
              "citation": {
                "source": "静物",
                "author": "十一谷義三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷口は妙な腰付をしながらボンヤリその後を見送っていたが、追々嫌な顔色になり、しまったしまったとしきりに舌打ちをしながらいたく煩悶する態であったが、やがて耐りかねたように椅子から跳上ると、転がるように部屋を飛出し、廊下つづきの局長室へ駆込んで行った。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　俊亮はめっちゃくちゃに跳上る飛沫を、顔一ぱいに浴びながら、そろそろと次郎の体を前進させてやった。",
              "citation": {
                "source": "次郎物語",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそうと……彼はベッドから跳上ると、五六歩進んでテーブルの前に行き、緑罫の原稿用紙を一枚取ると、ぶっつけに、やや自棄気味にもなって、次のような題を書いた。",
              "citation": {
                "source": "幸福な家庭",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "軒先に掛けた日蔽の下に居ても跳上る飛沫の烈しさに、わたくしはとやかく言う暇もなく内へ這入った。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御覧くださいませ、女が生涯の良人に捧げる大事な体、蚊にも刺させず大切にしてきました、腫物は愚か針で突いたほどの傷もない筈、――伯父上さま、御得心くださいましたか」「見届けた、この痴者――」　勘兵衛が叫んで大剣を掴むのと、伝吉が蝗のように跳上るのと同時だった。",
              "citation": {
                "source": "嫁取り二代記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝙也は飛鳥のごとく跳上ると、虚を衝かれてあっという武太夫の懐へつけ入りざま、利腕を執って、「や！",
              "citation": {
                "source": "松林蝙也",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その体に触るな」　と絶叫しながら舞台へ跳上る。",
              "citation": {
                "source": "劇団「笑う妖魔」",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
