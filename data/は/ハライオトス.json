[
  {
    "uuid": "deaf4349-8e7c-5a52-8ba8-a098d3e8e8eb",
    "entry": "払い落とす",
    "reading": {
      "primary": "はらいおとす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行"
      ],
      "ctype": "五段-サ行",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to brush off",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "肩についた雪をさっと払い落として、家の中に入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あの虫、気持ち悪い！ 早く払い落としてよ！」と彼女が叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "心配事を頭から払い落として、目の前の仕事に集中しようとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "敵の片腕　島原城之介力をこめ、ピューッと鉄杖を横へ振ったが、払い落とすことはできなかった。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく振って埃りをすっかり払い落とすと、それを肩にひっかけて、彼は階段を降りて表へ出た。",
              "citation": {
                "source": "外套",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はぷんぷん腹を立てながらも、さすがに寂しさを払い落とすことができなかった。",
              "citation": {
                "source": "宇宙尖兵",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの勇気ある行為によって不健全なイメージを払い落とすための一歩としたのではなかろうか。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "石屑の乱れがある一つの払い落とすことのできぬ印象を我々に与え、ガソリンの臭いがどんどんきつくなってきた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし音楽は魔法の小枝をもっていて、いかなる錠前をも払い落とす。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "火星基地はここからすぐのところにあります」　あなたはおもむろに立ち上がり、服についた土を払い落とす。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "甥への手紙にも書いている――「今の時代にとって必要なのは、けちな狡い卑怯な乞食根性を人間の魂から払い落とすような剛毅な精神の人々である」と。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "手拭きを出して、裾を、特に脚絆の黄色い埃をはらいおとすのであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな足のほうからはいのぼってくるカニを、はらいおとすのに、大さわぎをしました。",
              "citation": {
                "source": "怪奇四十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいてが、潜航艇にしがみついてしまっては、手も足もない機械ですから、はらいおとすことも、どうすることもできません。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "糸屑を払い落す為であったかも知れぬ。",
              "citation": {
                "source": "玩具",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は驚ろいた様もなく、うろうろする黒きものを、そと白き指で軽く払い落す。",
              "citation": {
                "source": "一夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦しみは払い落す蜘蛛の巣と消えて剰すは嬉しき人の情ばかりである。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は毎朝払い落すと、午頃には大きな網が再び元のように張られている。",
              "citation": {
                "source": "二階から",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方に再び払い落すと、明る朝にはまたもや大きく張られている。",
              "citation": {
                "source": "二階から",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が根よく払い落すと、彼も根よく網を張る。",
              "citation": {
                "source": "二階から",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやくの事これは前足の助けを借りて餅を払い落すに限ると考え付いた。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽黒山の社の前後に賽銭砂礫のごとく充満し、参詣人の草履に著く故、下山に先だちことごとく払い落す。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、自分の前に立っているものとは自分はよほどずっと以前のある時期――無限にとさえ言っていいくらい遥かな過去のあるとき――から知り合っているのだという信念を、なかなか払い落すことができなかった、というより以上に、そのとき自分を襲った気持をうまく書きしるすことはできない。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜には、私は言いようもなく恐ろしい夢から毎時間ぎょっとして目覚めると、そいつの熱い息が自分の顔にかかり、そのどっしりした重さが――私には払い落す力のない悪魔の化身が――いつもいつも私の心臓の上に圧しかかっているのだった！",
              "citation": {
                "source": "黒猫",
                "author": "THE BLACK CAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとに、叔父さんがくるしいじゃないの、おりなさいよ、それに今日は、まだ復習をしないじゃありませんか」「厭だい、厭だい」「この坊主、どこかへおっぽり出せ」　広巳は何かを払い落すように叫ぶなり、ぐるりと体の方向をかえて井戸の方へ走りだした。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　矢代は黙って頷いたが、千鶴子の一人旅は良い結婚の相手の選択の機会を彼女に与えるために、兄も両親も赦したのにちがいないのであってみれば、自分が千鶴子へ馴馴しくすることは、それだけ彼女の良縁を払い落す結果になっているのかもしれぬと思った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　狽てたように、立ち上って、膝から、前かけを払い落すと、とっかわ、入口に出て行って、ガラリと開けて、「思いがけない！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び鋭い矢声あって、飛び来る征矢をまたふたたび右門は左手で払い落す。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "極端に、その名を聞いてさえ虫酸が走る程山田に悪感を持つ様になった祖母は、そんな家へ行きでも仕様ものなら一生払い落す事の出来ない「つきもの」にとりつかれて仕舞いでもするか、髪の一本一本にまで厭な彼の家の空気が染み込んででも仕そうに感じて居たのだから、お久美さんに会う等と云う事は以ての外の事で有った。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世故に長けた先生はそれにはわざと答えずに、運動帽を脱ぎながら、五分刈の頭の埃を勢よく払い落すと、急に自分たち一同を見渡して、「そりゃ毛利先生は、随分古い人だから、我々とは少し違っているさ。",
              "citation": {
                "source": "毛利先生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを一つ一つ、彼は手先で払い落す。",
              "citation": {
                "source": "夢の図",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、無論、金五郎は、その悪魔の想念に愕然として、妄念を払い落すように、頭を打ち振った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやく名字を申さぬと、一｜颯のもとに、素首を払い落すぞ」　と、まず一圧を加えてみた。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
