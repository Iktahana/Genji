[
  {
    "uuid": "facd5c41-8298-5d0c-868f-8aaf59a38265",
    "entry": "端武者",
    "reading": {
      "primary": "はむしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
