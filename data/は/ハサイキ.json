        "examples": {
          "standard": [
            {
              "text": "工事現場に大型の破砕機が導入された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "破砕機の音が建設現場に響き渡る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この破砕機は1時間で何トンも処理できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私はさいきん、少しからだの調子を悪くして、神妙にしばらく酒から遠ざかっていたのであるが、ふと、それも馬鹿らしくなって、家の者に言いつけ、お酒をお燗させ、小さい盃でチビチビ二合くらい飲んでみた。",
              "citation": {
                "source": "酒の追憶",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "苗字はさいきでしょうか。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人はさいきんニスをぬってもらっていましたので、お月さまの光をうけて、キラキラと光っていました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はさいきん、芥川の家の燒跡にはじめて行つてみた。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
