        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "藤原は、ボーイ長の寝床の端板にもたれかかって、ボーイ長の顔をのぞき込んだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "手燭の光は台の端板へ斬り込んだ監物の刃の痕を照らした。",
              "citation": {
                "source": "不動像の行方",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母屋から鍵の手のやうに折れ曲つた所に小さな軒を喰付けた離屋は、端板一つで母屋と繋がつてゐた。",
              "citation": {
                "source": "黒い蝶",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
