        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヤガテ　ツヨイ　ヒカリニ　ナレテ　クルト　ナタネノ　花タチハ　アタリヲ　ミマハシテ、木ヤ　ハタケヤ　ミチヤ　イヘヤ　ソラヤ　ミズヲ　ミマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミナサン」ト　モルモツトハ、シンパイサウニ　シテ　ヰル　ミンナノ　カホヲ　ミマハシテ　イヒマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ真似グライハシテミセルカ知ラ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間ハオロカ、猿ダッテコンナ醜悪ナ顔ハシテイナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ガ浴室ニイル時、アスコノドーアハマサカ開ケッ放シニハシテ置カナイダロウ、ソノ時ハ戸締マリヲスルデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ場合ノアルコトヲ、カネテ覚悟ハシテイタケレドモ矢張サスガニ「死ヌ」ト思ウト恐クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デハコレカライタシマス、別ニ痛クモ何トモゴザイマセンカラ御心配ナク」「心配ハシテオリマセン、ドウゾ御遠慮ナク」「ヨロシュウゴザイマスナ」針ガ頸部ニ射シ込マレルノガ感ジラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "決シテ嫌ナ顔ハシテイナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
