[
  {
    "uuid": "b9b3d44c-92d3-586d-a994-9046eabe1b34",
    "entry": "腫れ上がる",
    "reading": {
      "primary": "はれあがる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to swell up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昨日ぶつけた膝が、朝起きたらパンパンに腫れ上がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "アレルギー反応で、まぶたがみるみるうちに腫れ上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "怪我をしてから数日後、その傷口はさらに腫れ上がって痛みが強くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "早速右の肩が瘤の様に腫れ上がる。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八尾という数は自慢にはならないが、七寸五分、八寸という鉄砲ギスばかりで、それに小ダイ、イイダコと色とりどりでおもしろく、なかに、刺されるとはれあがるほど猛毒を持った「一寸」という小魚もあったりして、朝の話の散歩には大受けだった。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、もう一度わたし、あなたの下唇を接吻しますわ、あなたの下唇ははれたようになってますけど、もっともっとはれあがるほど接吻してあげてよ。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし天性の泣き虫にかぎって、泣きだすのもはやいが泣きやむのもむぞうさに、ケロリと天気がはれあがる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻孔からは、鼻血がどくどく流れ出し、両の眼縁がみるみる紫色に腫れあがる。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえのその鼻の先が紫いろに腫れあがるとおかしく見えますよ。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "帆村と小浜の両人は、膝がしらが痛んで腫れあがるほど、一生けんめいに匐いました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "腺病質な少年の常として、何かといへば扁桃腺が、唾を呑みこむにも差支へるほど、腫れあがるのである。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "この御岳では、殺すわけにもゆかないが、うム、こうしてやる」　まえに寄ってくると、呂宋兵衛、煙草色のウブ毛がいっぱい生えている大きなてのひらで、竹童の横顔を、みみず腫れに腫れあがるほど、三つ四つ打ちつづけた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "手槍で大蛸を突き損って胸や腹に吸い付かれ、身体中｜腫れ上ることもある。",
              "citation": {
                "source": "南島譚",
                "author": "幸福",
                "note": "青空文庫"
              }
            },
            {
              "text": "髭ッ面の分隊長は、「気合いを入れてやる」とそんな瞳の吊上った岡田を素裸にし、古参上等兵とふたりで、掌や足の甲、両肩、下ッ腹を紫色に腫れ上るほど革バンドで叩き撲ってから、近くの冷たい泥沼に追いこんだ。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "好くも切れない剃刀で、彼は唇の周囲の腫れ上るほど力を入れて剃った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　鐚助、みるみる腫れ上る頬っぺたを押えて、横っ飛びに飛んで玄関から走り出しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どいつもこいつも青白い顔をして、リンパ腺は腫れ上る、咳はする、毎日医師に診てもらう、私はほんとに大阪の空が呪わしく思います」　これは西区選出の堀江喜一郎の言葉であった。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉に吸い付いて、腹が赤く、酸漿のように腫れ上るまで生血を吸いたい。",
              "citation": {
                "source": "森の暗き夜",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
