[
  {
    "uuid": "802d7c55-0e37-5d75-b58f-edb5405142bc",
    "entry": "廃疾",
    "reading": {
      "primary": "はいしつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
