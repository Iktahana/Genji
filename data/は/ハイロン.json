    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それと同時に座附の芝居茶屋全廃論も出でたるが、未解決に終れり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那人の間に、宦官全廢論の起つたのは、恐らく二十餘年前に、孫詒讓等の創唱以來のことであらう。",
              "citation": {
                "source": "支那の宦官",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "兔に角その當時餘り有力でなかつた宦官全廢論が、今日に至つて始めてその現實を見得た譯で、民國成立後宦官は無勢力で、その存廢は政治上格別の影響なしとしても、兔に角かかる野蠻な制度の撤廢されただけでも、支那の爲に祝福すべきことと思ふ。",
              "citation": {
                "source": "支那の宦官",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
