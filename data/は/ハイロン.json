[
  {
    "uuid": "64d93561-ec00-5905-a06e-f722cd4a51cb",
    "entry": "俳論",
    "reading": {
      "primary": "はいろん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "実際にも芭蕉は、句作以外にも多くの俳論や散文を書き、俳人と詩論家の両面を具えていた。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったい昔からの俳論は皆俳諧の中にいて内側からばかり俳諧を見たものである。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとおなじ意味に於て、私は『情理をつくした俳論』を要望する。",
              "citation": {
                "source": "最近の感想",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は人間本来の声――その声に根ざした俳論を熱求して居る。",
              "citation": {
                "source": "最近の感想",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは俳友を集めよう」と、私の来たことを人をして知らせたので、三四人直ぐに来たが、その中で透石と言ふ人は非常な俳論家で、子規や碧梧桐等のいろいろな話を聞かせてくれた。",
              "citation": {
                "source": "小川芋銭先生と私",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで子規氏も得意になって俳句の選をする事は勿論、俳論を縦横に書いて月並派を攻撃して、ここに始めて我々が俳句の今日あるを致した。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は、茶をのみながら俳論をはじめた。",
              "citation": {
                "source": "酒徒漂泊",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳論に夢中になっていた校長先生は漸くそれをさとったのであろう。",
              "citation": {
                "source": "酒徒漂泊",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は京都に在る間『日本新聞』は購読しなかったのであるが、この紀行と前後して居士の俳論、俳話は日々の紙上に現われてそれらは俳句革新の警鐘となりつつあるのであった。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が卑近な平易な句作法をお話しいたしたことは、晦渋な迂遠な俳論をして諸君を一夜作りの大家にするよりも、諸君の良友をもって自らを任じておるゆえんだと考えるのであります。",
              "citation": {
                "source": "俳句の作りよう",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "芥川は芭蕉の門人で長江と同じ病気を患っていた森川許六の例を引き、「昔許六は自分の姿の醜いのを恥じ、屏風を隔てて人と語るのを常としたが、客が是非お顔を見せて下さいというと、始めて屏風の蔭から出て来て臆する色もなく対面し、従容として俳論を闘わしたというが、この話を長江にも聞かせてやりたいな。",
              "citation": {
                "source": "文壇昔ばなし",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治俳句の進歩の迹をたずねる者は、この一篇を振出しとする居士の俳論俳話を切離して考えるわけにいかない。",
              "citation": {
                "source": "「俳諧大要」解説",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "居士の俳論俳話のうち、最も広範囲に亙り、首尾一貫したものとしては先ずこれを挙ぐべきであろう。",
              "citation": {
                "source": "「俳諧大要」解説",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "この前後の居士は、病苦が漸く募って来たのと、歌の方面に力を分つ関係もあって、俳論俳話の数を減じ、たまたまあるものも短篇が多い。",
              "citation": {
                "source": "「俳諧大要」解説",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "但しその内容は子規居士がはじめて自分の句集を世に出すに当り、回顧的に感想を述べたものだから、従来の俳論俳話とは少しく種類を異にする所がある。",
              "citation": {
                "source": "「俳諧大要」解説",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "子規居士の俳論俳話は明治俳壇における一の羅針盤であったのみならず、今日から見てなお啓発さるべき内容のものが少なくない。",
              "citation": {
                "source": "「俳諧大要」解説",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしこれだけでは慊らぬとする人があるならば、更に全集について俳論俳話の二巻を通読すべきである。",
              "citation": {
                "source": "「俳諧大要」解説",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
