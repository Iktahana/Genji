[
  {
    "uuid": "dd769f8c-f57d-5223-b9f0-d4d9f5f3a5ad",
    "entry": "煩多",
    "reading": {
      "primary": "はんた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
