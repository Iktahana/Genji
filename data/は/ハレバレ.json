[
  {
    "uuid": "652b4066-d52c-59e6-ad64-59a713c33770",
    "entry": "晴れ晴れ",
    "reading": {
      "primary": "はればれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
