      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "bright",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験が終わって、彼の顔は晴れ晴れとしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長年の悩みが解決し、心の中が晴れ晴れとした気持ちになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "休日に自然の中で過ごすと、気分が晴れ晴れとする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "晴れ晴れと春めいた気持の好い表情は、少なくも大人の中にはめったに見付からない。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、夏の終りに病後の一月餘りを過した時の事を思ひ浮べて、此處の晴れ晴れしい秋空を想像してはいけない。",
              "citation": {
                "source": "疑惑",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　奧さんは晴れ晴れしくひとみを輝かしながら、暫らくその額面に眺め入つてゐた。",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでおみちははじめて晴れ晴れじぶんの拵えた寒天もたべた。",
              "citation": {
                "source": "十六日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちにまた天気のいい気分のいいおりに小さな鏡を机の前に立てて見たら、その時は鏡の中の顔が晴れ晴れとしていて目もどことなく活気を帯びて、前とは別人のような感じがした。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴れ晴れしゅう進んでおった蔵元屋の祝言の支度が、いつからとものうダラダラになって来た。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを演出しこれを書いたあとの子規はおそらく最も晴れ晴れとした心持ちを味わったのではないか。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "欲張りもけちんぼうも年寄りも病人もこのころばかりは晴れ晴れとなって子どものようになりますので、かしげがちの首もまっすぐに、下向きがちの顔も空を見るようになるのがこのごろです。",
              "citation": {
                "source": "燕と王子",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴れ晴れとした春の野辺。",
              "citation": {
                "source": "花子",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがよめに往ったので、折合が好いかと問われたのなら、大層好いから安心して下さいと、晴れ晴れと返事が出来るのだろう。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴れ晴れしく点頭いた「ああ。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンド、アイ、ノウ、ザット、マイ、マザー、イズ、プレーイン……」と、鼻にかかった、甘ったるい声で、晴れ晴れと唄いながら、美和子が帰って来た。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "想像するだけでも私は胸の奥底まで晴れ晴れとするようないい心持ちがする。",
              "citation": {
                "source": "解かれた象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢さんは晴れ晴れとした、身軽な様子をして、主人と並んで、階段の上に立つた。",
              "citation": {
                "source": "薔薇",
                "author": "ROSEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "『外の世界って、とってもきれいで、なんて晴れ晴れしているんでしょう。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとよはだれの目にも判るほどやつれて、この幾日というもの、晴れ晴れした声も花やかな笑いもほとんどおとよに見られなくなった。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時に長十郎の顔は晴れ晴れした気色になった。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "年忌の営みは晴れ晴れしいものになるらしく、一箇月ばかり前から、熊本の城下は準備に忙しかった。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃彼は、小説を書き終へて晴れ晴れしい気持を味つたことがなかつたから――。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな廊下がその左右にあるのもあまり晴れ晴れしかつた。",
              "citation": {
                "source": "浴室",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋは夕食を君に勧めながら、ほんとうはそれを両親に打ち出して言う事を非常に苦にしていたらしく、さればとてまずい心持ちで君をかえすのも堪えられないと思いなやんでいたらしかったので、君の言葉を聞くと活路を見いだしたように少し顔を晴れ晴れさせて調剤室を立って行った。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はこんな目もくらむような晴れ晴れしいものを見た事がなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒くとも気分は晴れ晴れしますから。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝飯を終へて、制服を着て登校するときには、気も晴れ晴れとして、「起きることも、かうして見ると、やはり親孝行かな。",
              "citation": {
                "source": "親孝行",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "有難く心得て書判せい」　ぐいとその手をねじむけて、介添えながら十郎次に書判させると、折から晴れ晴れとした顔で再び姿を見せた老神主に、大目付上申のその奉書をさしながら、莞爾として言った事でした。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンネルを出て、電車の速力がやや緩くなったころから、かれはしきりに首を停車場の待合所の方に注いでいたが、ふと見馴れたリボンの色を見得たとみえて、その顔は晴れ晴れしく輝いて胸は躍った。",
              "citation": {
                "source": "少女病",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈はすらりとしているし、眼は鈴を張ったようにぱっちりしているし、口は緊って肉は痩せず肥らず、晴れ晴れした顔には常に紅が漲っている。",
              "citation": {
                "source": "少女病",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ私たちのかうした友情は、世にも珍なる彼のはればれしき男性的性情と、やや女性的で憂鬱がちなる私の貧しき性情との奇蹟めいた会遇によつて結びつけられた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬場はいつになくはればれと微笑み、私の肩をぽんと叩いて、「日本で一番よいまちだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しのびやかにしかもはればれと桐の花。",
              "citation": {
                "source": "五月の朝の花",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
