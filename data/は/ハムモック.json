        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その槐に張り渡した、この庭には似合わない、水色のハムモックにもふり撒いている。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムモックの中に仰向けになった、夏のズボンに胴衣しかつけない、小肥りの男にもふり撒いている。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムモックの側に立っているのは、上海の旅館にいた時より、やや血色の好い敏子である。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからさも大儀そうに、ハムモックの上へ体を起した。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　男はハムモックに腰かけたなり、もう短い葉巻を噛み噛み、無造作に手紙を読み始めた。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　男はもう一度ハムモックに、ゆらりと仰向けになりながら、同じ言葉を繰返した。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムモックを解いてしまうわよ。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は多加志も庭木に吊ったハムモックの中に眠っている。",
              "citation": {
                "source": "子供の病気",
                "author": "――一游亭に――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
