[
  {
    "uuid": "b5e8e06c-2e52-55ea-a1f9-7e857f726c8b",
    "entry": "張板",
    "reading": {
      "primary": "はりいた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
