    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "よいことを「ハクイ」、悪いことが「セコイ」。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "よいお客は、「ハクイキンチャン」。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのタレはハクイトオスケだ」つまり美しい顔の女。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「奴にしてはハクイワコを持ったね」「あいつのワコはもとシャダレしていて、しまいに蝶々になったんだよ」　いや楽屋雀はうるさいことである。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "その尻が部屋から消えかかったとき、丸万がテキヤのチョウフ（隠語）で、「ガセビリ（淫売）にしちゃ、ハクイ（いい）ナゴ（女）だ」と俺にささやいた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんなハクイ子がどうしてガセビリになったんだろう」　そう言って、丸万は脂の浮いた顔をつるりと手で撫でおろして、「ヒモがついてるんじゃねえかな」「ヒモが？",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "四郎さんもあの仲間にはいったほうがハクイ（安全な）んじゃねえのか」「いやなこった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
