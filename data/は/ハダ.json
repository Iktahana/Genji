        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生まれたばかりの赤ちゃんは、母親の肌を求める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "愛する人と肌を寄せ合うことで、心の安らぎを得る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "寒い夜は、温かい肌のぬくもりが恋しくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "surface",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
