          "literary": [
            {
              "text": "学士はその椅子を自分にて持ち来らんとして馳せ寄る。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵士たちの銅鉾を叩いて馳せ寄る響が、武器庫の方へ押し寄せ、更に贄殿へ向って雪崩れて来た。",
              "citation": {
                "source": "日輪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子　（少年を凝視し、にわかに馳せ寄る）ヨハナーン！",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "門を出ると二人の争うているのを見て馳せ寄る）どうしたのだえ。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝信　（輿のほうに馳せ寄る）善鸞様ではございませぬか。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "475サルペードーン再びも、その燦爛の槍をもて、覘誤まり、鋭刄はパトロクロスの左肩掠め落つれば、青銅をかざし馳せ寄る敵の將、パートロクロス手中より放つ飛槍は誤らず、隔膜及び心臟の觸れ合ふほとり打ち當つる。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "追う武者たちの中で大将と見られる武士がたちまち知盛の馬に馳せ寄るが早いか組み打とうとした。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第九巻",
                "note": "青空文庫"
              }
            }
          ]
        }
