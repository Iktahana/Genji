[
  {
    "uuid": "b6938709-e72f-59a8-bb9d-ace18fd63d69",
    "entry": "羽飾り",
    "reading": {
      "primary": "はねかざり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
