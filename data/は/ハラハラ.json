[
  {
    "uuid": "e2f7d51d-3613-5e2f-8692-9c15950e89bd",
    "entry": "ハラハラ",
    "reading": {
      "primary": "ハラハラ",
      "alternatives": [
        "はらはら"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-サ変",
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to feel anxious",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "高所での作業を見ていると、ハラハラして目が離せない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の初めての舞台を見守る間、私はずっとハラハラしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最終回の展開に、視聴者は皆ハラハラしながら見入っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "傍でハラハラしている左衛門。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「非人に迄、身を落し　さだめて辛いであろう」　とハラハラと落涙して、Ｔ「其の方の至孝　天に通ぜぬ　道理が無い」　と乞食の手を掴んで、Ｔ「仇討本懐の日を　祈り申すぞ」　と老臣に金子を包ませて、　それを乞食に与え、Ｔ「些少乍ら　余の志じゃ」　乞食はまるで、鳩が豆鉄砲を喰った形。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、寢ちやあ危いぞ‥‥」と、私は度毎にハラハラして彼の脊中を叩き著けた。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六は死んだほうが幸福でございますよ、」と言って涙をハラハラとこぼしました。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "感激の涙をハラハラと流した。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "両眼を閉じて唇をワナワナと震わしたが、一言も物を言い得ないまま「ハアア――ッ……」と骨身に泌みるようなタメ息を一つして、涙をハラハラと流した。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "御尤も御尤も」　頭を下げたままの半三郎の眼から又も涙がハラハラと落ちた。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "涙をハラハラと流しながら猪口兵衛の前にニジリ出した。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌を落せば、ハラハラと膝に散る。",
              "citation": {
                "source": "花間文字",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　博士は思わずハラハラと涙を流した。",
              "citation": {
                "source": "月世界競争探検",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたが百万円を得られると同時に、そうした立派な令夫人を迎えておられましたならば、あなたの百万円は一文も無意義に費されずに済んだでしょう」　青年芳夫の眼から熱い涙がハラハラと溢れ落ちた。",
              "citation": {
                "source": "夫人探索",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリバイも知らないで……」　玄関に近いので母親はハラハラした。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうえ毎晩九時から十時まではあなたに勉強のおひまをいただくようにお母様にお願いしておきましたから、そのつもりで勉強して立派に女学校に這入って下さい」　露子さんは夢かとばかり驚いて、嬉し涙をハラハラとこぼしました。",
              "citation": {
                "source": "キキリツツリ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして井伏さんはその後も、また、いつまでも、或いは何かの間違いかもわからない、とハラハラしていらっしゃる。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな祝賀会をお見せしたって、中畑さんも北さんも安心するどころか、いよいよ私の将来についてハラハラするだけの事かも知れなかった。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女のひとは、まさかその人は私の昔からの監督者だとは知らないから、「ええ、たいへん親切よ」なぞと、いい加減のふざけた口をきくので私は、ハラハラした。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると是は又何事であろう、やがて氏郷の眼からはハラハラと涙がこぼれた。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵愈々逼りたれば吾が兄備前守」と此処まで云いて今更の感に大粒の涙ハラハラと、「雑兵共に踏入られては、御かばねの上の御恥も厭わしと、冠落しの信国が刀を抜いて、おのれが股を二度突通し試み、如何にも刃味｜宜しとて主君に奉る。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それですから善女が功徳のために地蔵尊の御影を刷った小紙片を両国橋の上からハラハラと流す、それがケイズの眼球へかぶさるなどという今からは想像も出来ないような穿ちさえありました位です。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕もこんどの君の恋愛には、ハラハラしていたんだが、しかし、出来たものは仕様が無えしなあ。",
              "citation": {
                "source": "女類",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めて自分の娘を一人旅に送り出したママは旅先きで娘がどんな刺戟や感銘を受けるかをハラハラ身もやせる程案じて居ります。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お差しつかえなければ、お伴致しとうござる」　と言うと、無敵は、「よくぞ言って下さった」　と、佐助の手を握って、ハラハラと落涙し、既に道場を荒された恨みなど忘れていたのは勿論である。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一個八十銭の西瓜で十銭の切身何個と胸算用して、柳吉がハラハラすると、種吉は、「切身でまけて丸口で儲けるんや。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば、畳の上にハラハラと涙をこぼし、眼をこすりもしないで芝居がかった容子であるから、丸亀夫婦も舞台に立ったような思いいれを暫時した。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "卓の数列に向って並んで、手頃に重ねた幅広い白紙の層を、ちょいと片端へ右の手の指を触れると、ハラハラハラハラとめくる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "fluttering down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "桜の花びらが風に舞って、ハラハラと地面に落ちていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冬の訪れと共に、枯葉がハラハラと舞い落ちる季節になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の目から、涙がハラハラとこぼれ落ちた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "hanging untidily (of hair)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長い前髪がハラハラと顔にかかり、邪魔そうにしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "汗で濡れた髪がハラハラと額に張り付いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "風に吹かれて、彼女の髪がハラハラと乱れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
