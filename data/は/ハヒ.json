        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハヒフヘホは現今ではhahihuhehoと発音されているが、かような音は古代の国語にはなく、江戸時代以後にはじめて生じたもので、それ以前はこれらの仮名はfafifufefoと発音されていた。",
              "citation": {
                "source": "駒のいななき",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のハヒフヘホのような音は古くから支那にあって、今でも支那および朝鮮の漢字音にそのまま残っております。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう点から見ると、古代には、今日のハヒフヘホのような音はなかったことがわかります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは今日のハヒフヘホにあたる古代の音は何であったかというに、それは唇をすぼめて発する「ファ」「フィ」「フ」「フェ」「フォ」の音であったと思われます。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクテアシタハヒルトナリ、　　水音イヨヨシゲクシテ、　鳥トキドキニ群レタレド、　　　ヒトノケハヒハナカリケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソハヒマビマニトリテ来シ、　　木ノ芽ノ数ヲトリカハシ、アルイハ百合ノ五｜塊ヲ、　　　　ナガ大母ニ持テトイフ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁づとの褪めたる色、ハヒビヤクシンの傾斜面の暗青色の静止――短艇の船腹の如き雲灰白色の別館の上に薄れんとし、ヒマラヤ杉ひとり早春の風に戦ぐ。",
              "citation": {
                "source": "春の暗示",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁づとの褪めたる色、ハヒビヤクシンの傾斜面の暗青色の静止――短艇の船腹の如き雲灰白色の別館の上に薄れんとし、ヒマラヤ杉ひとり早春の風に戦ぐ、大きなる魚の青き骨のごとく。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "五、カタカナハヒラガナニ比較シテヨリ確実ナル伝達能力ヲ持ツ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、カタカナハヒラガナヲ書ク場合ニ比シテ、オソラク半分ノ労力デスム。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "地久節チキユウセツハメデタイナクワウゴウサマノオウマレ日ガツカウモ　ヤクバモイハヒマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ノ　上カラ見テヰルトハタモ　ヒラヒラヒルガヘリケフノ　ヨキ日ヲイハヒマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の上には尺八の譜本のようなものが一二冊載っていたが、ハヒハヒチレツロ……などと、啓吉にはさっぱり面白くない。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙幕ハヒッキリナシニ……」　うわーッ。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "水色美とハヒルスという魚を自慢にしている。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモ、コノ傾向ハヒトリ仏蘭西ニ限ラナイ。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、ヨノナカハヒトノキヲシランヤツガオホクテコマル。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本のハヒフヘホの音は元はＰ音であった証拠には、北の方で大平山を今でも「おうぴらやま」といっているので分る。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大島島民は「カキクケコ」を「ハヒフヘホ」に発音するのだとさ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヒフヘホに濁りをつけてバビブベボやパピプペポをつくっているが、ハヒフヘホは喉音で、バ行パ行は唇音である。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "目ニ視テ色ヲ知リ、耳ニ聽テ聲ヲ知リ、鼻ニ嗅デ臭ヲ知リ、舌ニテ味ハヒテ味ヒヲ知リ、支體ニテ覺エテ寒熱、疎密、軟硬、方圓等ヲ知ル。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シアナタノ作ヲ読ムノハヒマガ入ラナカッタ。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ニハヒルマンヲ買ッテオヤリニナルノニ」ソウ云ワレタノガグット来テ、予ハハッキリト断ル決心ガツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズレ近イウチニ、佐々木ノ留守ノ夜ハ颯子ガ勤メルヨウニナルト、予ハヒソカニ期待シテイル次第デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ウト、イカニモ善人臭ク聞エルガ、涙脆ク、情ニ脆イ癖ニ、本心ハヒネクレテ薄情極マル人間ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ワタシハヒトヲコロシタノダガ……。",
              "citation": {
                "source": "測量船",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "―― 〔J'ai tue'〕 ……ワタシハヒトヲコロシタノダガ……。",
              "citation": {
                "source": "測量船",
                "author": "三好達治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
