        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "嗚呼是レ聖代ノ汚点ニ非ズト謂ハンヤ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ、ラファエルニオイテヲヤ……未ダカツテ……ジョットーヨリ純正偉大ナル宗教画家ハナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ二公ハ学徳兼テ優レルヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔鎮年道途ヲ走キ／祭祀ヲ奉ズル暇無シ／地下｜若シ知有ラバ／豈｜謂ハンヤ克家ノ子ト／惟ダ詩癖ノ同ジキ有ルノミ／家声誓ツテ墜トサズ〕枕山はこの誓言にたがわず家声を墜すようなことはしなかった。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤワガ江戸ノ大ナルヤ、文章ノ淵藪ニシテ、牛耳ヲ執リ盟主トナル者騒壇ニ角立スルヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ二十年ノ久シキヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤソノ師ニオイテヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ諸孤皆予ニ就イテ学ブ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔揚揚トシテ匹馬西ニ向ヒテ行ク／山｜複ナリ水｜重ナリ程又程／寧ゾ厭ハンヤ天気風雪ノ苦ヲ／黄金台ハ築イテ金城ニ在リ〕　毅堂はこの時四十一歳である。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
