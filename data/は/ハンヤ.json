[
  {
    "uuid": "df397278-4fa0-5e4f-9b2b-d18c302cfdd6",
    "entry": "半夜",
    "reading": {
      "primary": "はんや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
