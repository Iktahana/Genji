  {
    "uuid": "14d5a70d-d400-5130-9611-e7182e1cc730",
    "entry": "花蜂",
    "reading": {
      "primary": "はなばち",
      "alternatives": [
        "ハナバチ"
      ],
      "is_heteronym": false
    },
    "grammar": {
