    "definitions": [
      {
        "index": 1,
        "gloss": "adlay (Coix lacryma-jobi var. ma-yuen)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "健康のために、毎朝はと麦茶を飲むことにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "はと麦を炊き込んだご飯は、香ばしくて美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この化粧水にははと麦エキスが配合されており、肌に良いらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私の盲腸は、はと麦と玄米と黒豆とを煎って挽いたものを煮てのむことで大分つれなくなりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はあれを見ると自分の盲腸にも腹が立って、しきりにはと麦の煎薬をのみ、この頃はすこしましです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
