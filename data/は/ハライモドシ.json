[
  {
    "uuid": "4a5effb4-4a75-5b04-82d2-b3985433bb51",
    "entry": "払い戻し",
    "reading": {
      "primary": "はらいもどし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
