[
  {
    "uuid": "cddb4169-3786-5722-b741-0e2edda459a6",
    "entry": "ハツハツ",
    "reading": {
      "primary": "はつはつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
