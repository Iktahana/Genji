          "literary": [
            {
              "text": "ハナマキ村と書いた立札がみえ、そのあたりに、急造のベンチがいくつかおいてある。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナマキ村のリキ　　　　（満場の拍手）シラタマ村のゲン　　　　（遠い拍手歓声）タコツボ村のクマ　　　　（同じ）モモシキ村のヒヤク　　　（同じ）ウラシマ村のカメ　　　　（同じ）カグラ村のハチ　　　　　（同じ）ハナマキ村のタケ　　　　（歓声拍手）以上七名。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二回予選のタイムは、最高記録ハナマキ村のリキ、四分十五秒。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "救援作業によつて、ハナマキ村のリキさん、只今意識喪失の状態で引き上げられた。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "不幸なる犠牲者、ハナマキ村のリキさんは、第一、第二の予選に抜群の成績を示し、輿望をになつて決勝戦に出場した。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一位、女王、ハナマキ村のタケさん。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（僅かな拍手）以上の外、ここに、全審査員の発議により、別格として、準女丈夫の席を設け、謹んで、ハナマキ村のリキさんを神霊として、その席に迎へたいと思ふ。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "スピーカー只今、われらの準女丈夫、ハナマキ村のリキさんの遺骸が、村の人々に守られて競技場を出発する。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
