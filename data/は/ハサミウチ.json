[
  {
    "uuid": "de1fa220-848c-56a1-a751-6e82367bfc40",
    "entry": "挟み撃ち",
    "reading": {
      "primary": "はさみうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "attack on both sides",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敵軍は挟み撃ちにされて、あっという間に降伏した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "討論会で、彼は二人のパネリストから挟み撃ちにされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "警察は容疑者を挟み撃ちにする作戦を立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "慶一は、十三歳のじぶんが歯を磨きながら、カメラにむかって笑いそうになっているのを見て、目をそむけたくなる気持ちと、よく見たい気持ちの挟み撃ちにあった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "表から出れば長唄、裏口から出れば常磐津、毎日この挟み撃ちを受けていたのであるから、わたしの音楽趣味が普通の子供以上に発達したのも無理はなかった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "母国の資本は今は挟み撃ちに逢い出したのだ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の者は窓へ倚って発砲し、警官隊は塀の間から挟み撃ちし、強盗は、植え込みから植込みを昆虫のように這って縫いながら、この内外の敵を相手に猛悪に応戦した。",
              "citation": {
                "source": "チャアリイは何処にいる",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "押し寄せる水と押し返す波とが、小さな独木船を挟み撃ち、大穴へ引き入れるその代りに、横穴へ船を押しやったのであった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土人は挟み撃ちを試みるらしい。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貯金奨励の宣伝劇を最初に据ゑるのはどうかと危ぶまれたが、それも素直にうけいれられ、第二の南方第一線における朗らかな挿話を本筋に、銃後の頼もしい決意を結びとした悲壮喜劇とも名づくべき演し物は笑ひと涙の挟み撃ちで一見、申分のない効果を挙げた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "信玄自身は八千の兵を率いて川中島に陣し、夜明けと共に挟み撃ちにかけるツモリであったらしい。",
              "citation": {
                "source": "決戦川中島　上杉謙信の巻",
                "author": "――越後守安吾将軍の奮戦記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「逃しちゃならねえ、誰をどこで捕まえたんだ」「紙屋の裏をウロウロしている奴があるから、二人で挟み撃ちにすると、こいつはとんだ強い奴で、思いの外骨を折らせました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "十七の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして源氏の陣所の山と自分等の占めた高地とで、ちょうど、挟み撃ちにする形態をとった。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳生、それを見て、「助太刀」と、呼ばわりながら、張虎を扶けて韓当を挟み撃ちに苦しめた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "みなごろしにしてしまえ」　と、無造作に包囲して、馬を深く敵中へ馳け入れ、「徐晃は汝か」と、彼のすがたを探しあてるやいな、挟み撃ちにおめきかかっていた。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「兵を陸へ揚げて、蜀軍が夜討ちに進む退路を断ち、逆に孫桓としめし合せて挟み撃ちにしてやろう」　すぐ書簡をしたためて、使いを孫桓の陣へやった。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二人の犬殺は、両方から、仔犬をかこんで、はさみうちにしようとしています。",
              "citation": {
                "source": "可愛いポール",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "井上君は、前とうしろから、はさみうちになっていました。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "はさみうちにされたのです。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとからの追っ手と、はさみうちにしようというわけです。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまえがいくら大丈夫といったって、トラックと観光バスにはさみうちされてみろ、それこそ、生卵みてえなもんだ」「気をつけてます」「おまえ、てっきり死んだと思った」「いつですか」「おぼえてねえの？",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分たちはあっちから、あんたたちはそっちから、はさみうちにしたわけだね。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、はさみうちにするんだっ。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、わたしたちと広田とで、はさみうちにしたわけだから、にげみちは、この書斎のほかにはない。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、ゾウをはさみうちにしようというのです。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "はさみうちになってしまったのです。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪人は電灯がないので、方角がわからなくなり、コンブ林の中で、まごまごしているうちに、ふたりの潜水夫に、はさみうちになってしまいました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、板戸をぬけだした豹は、両方から、はさみうちになったわけです。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかたがないので、警官たちは、手わけをして、両方から、しげみのなかにわけいって、はさみうちにしようとしましたが、まんなかで、両方の警官が、ぶつかっても、じいさんのすがたは、どこにもないのでした。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "うす暗い岩の廊下をまがっていきますと、向こうに、黒覆面の部下たちがむらがっていて、黄金怪人を、両方から、はさみうちにしていることが、わかりました。",
              "citation": {
                "source": "魔法博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "骸骨男は、はさみうちになったのです。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "警官たちは、トンネルの両方から、そのまんなかにいる二十面相を、じりじりと、はさみうちにしていきました。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "じいやさんは、あっちがわから、ぼくはこっちがわから、あいつを、はさみうちにするんだ。",
              "citation": {
                "source": "夜光人間",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
