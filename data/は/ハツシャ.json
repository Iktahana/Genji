          "literary": [
            {
              "text": "この雜誌は明治三十年五月に開發社（湯本武比古先生社長）から發刊された。",
              "citation": {
                "source": "芳賀先生と日本主義",
                "author": "高橋龍雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "資本家は岡崎遠光君で、開發社から離れて獨立することゝなつた。",
              "citation": {
                "source": "芳賀先生と日本主義",
                "author": "高橋龍雄",
                "note": "青空文庫"
              }
            }
