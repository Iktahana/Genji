          "literary": [
            {
              "text": "“U. S. R. S. Flanklyn”フランクリン号ナル、レシービングシツプデアル、大概港ノ中ニ碇ヲ降シテヰルノデ危険ノ憂ヒハナイガ、僕ニハヤハリ水雷艇ノ方ガ面白イ、君ノ冒険心ガ健ヤカニ成長スルコトヲ望ンデヰル。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼ハ大キクハナイガ非常に特色ガアル。",
              "citation": {
                "source": "ロシアの過去を物語る革命博物館を観る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、コツチノ気持ハ第二トシテ、軍人ダケガ、ナゼ当節サウイフ感情ヲ尊重シテヰルカニツイテ考ヘテミルト、「モンテェニュ」デハナイガ、世ノ中ニ軍職グラヰ愉快ナ職ハナイノカモ知レヌ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "手ノヨウナ痛ミヤ冷感ハナイガ、何トモ不思議ニ重ミガカヽリ、モツレルヨウニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "篏メテモ痛イコトハナイガ、全ク首ヲ動カスコトガ出来ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハコルセットヨリ柔イ布デ頤ヲ吊ルダケデアルカラ、コルセットホド窮屈デハナイガ、首ヲ動カセナイコトハ同ジデ、天井ヲ睨ンダマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ春久ト限ッタコトハナイガネ、甘利デモ誰デモイヽガネ」「四阿ヘ来ルト、キットコンナ話ニナルノネ、チット散歩シマショウヨ、足ノ運動バカリデナク、頭ニモ毒ダワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ同時ニ、コノ調子ナラコレカラ後モ気狂イ的行為ヲ繰リ返シテモ差支エアルマイ、颯子ノ好キナピンキー・スリラーデハナイガ、コノ程度ノ冒険ハ止メル訳ニ行カナイ、間違ッテ死ンダトシテモ構ウモンカ、ト云ウ気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ母屋デモ家族全部ヲ収容スルノニ狭過ギルト云ウコトハナイガ、予ガイロ／＼ト企ンデイル悪事ヲ実行スルノニハ少シ不便デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ彼女ヲソウサセタノニハ予ニモ責任ガナイコトハナイガ、浄吉ノ奴ハ亭主ノ癖ニ最初カラ彼女ニ一目置クヨウナ素振ヲ見セテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モヒデハナイガコレモ一種ノ麻薬デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡庸ノ作家ノ技術デハ容易ニ出来ル仕事デハナイガ、予ハ不幸ニシテ彫刻家ニ一人ノ友人モ持ッテイナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妻ハソレヲ口ニ出シタ※ハナイガ、ジェームス・スチュアートノ映画ダト缺カサズ見ニ行クラシイノデアル）モットモ妻ガ木村ニ接近スルノハ、僕ガ彼ヲ敏子ニ妻ワセテハドウカトイウ考エガアッテ、家庭ニ出入リサセルヨウニシ、妻ニソレトナク二人ノ様子ヲ見ルヨウニト命ジタカラナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナドト胡麻化スノデハナイガ、余計ナオセッカイヲシテ悪カッタラ詑マリマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
