      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "きたる幾日｜義雄の初節句の祝いをしますから皆さんおいでくださるようにとチョン髷の兼作爺が案内に来て、その時にもらった紅白の餅が大きかった事も覚えている。",
              "citation": {
                "source": "竜舌蘭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのころの田舎の初節句の祝宴はたいてい二日続いたもので、親類縁者はもちろん、平素はあまり往来せぬ遠縁のいとこ、はとこまで、中にはずいぶん遠くからはるばる泊まりがけで出て来る。",
              "citation": {
                "source": "竜舌蘭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の初節句、結婚の披露、還暦の祝い、そういう機会はすべて村のバッカスにささげられる。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故と云ふに、柏の初節句即丙申の三月三日には、たかが家にゐたと伝へられてゐるからである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼い柏の初節句である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "牡丹屋では亭主の孫にあたるちいさな女の子のために初節句を祝うと言って、その雪の中で、白酒だ豆煎りだと女中までが大騒ぎだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえり晴子の初節句の人形見に高島やにゆき、おどろいた。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "初節句、ところが、ここでは子供と母さんが、石森へ行くことにきめた由。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "物識りのこいさんにも似合わんやないか」この家の雛と云うのは、昔悦子の初節句の時に京都の丸平で作らせたもので、蘆屋へ移って来てからは、結局家族たちの団欒の部屋に使われている階下の応接間が、洋間ではあるけれどもそれを飾るのに一番適当だと云うことになって、毎年そこに雛段が組み立てられるのであった。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は初節句の祝いに人形好きの父親が特別に京都の丸平で拵えてくれた古風な雛を、結婚の時道具と一緒に斯波家へ持って来ているのである。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また初節句にゃ団子でも食わしておくれ。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも正月には、流石に「夏浜より来りて一泊」し、また貞子の初節句の時には、珍しく二泊して「雛の衣桁にかくべき衣縫ふ」というようなはかない喜びの日もあった。",
              "citation": {
                "source": "『団栗』のことなど",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏子夫人も一時は大分調子がよく、四月十日貞子の初節句に高知へ帰り、珍しく二泊して「雛の衣桁にかくべき衣」を縫った頃は「帰路片山にて診察受く。",
              "citation": {
                "source": "『団栗』のことなど",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀井夫妻が、清の初節句にと、カブトを持って来る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東宝本社事務所連から初節句の祝ひに、金太郎の大人形来る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月五日（日曜）　清　初節句。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "清の初節句で親類集まる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
