        "examples": {
          "standard": [
            {
              "text": "生後100日目の初節供は、子供の健やかな成長を願う大切な儀式だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "初節供に用意されたお祝い膳を、家族みんなで囲んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その初節供の写真は、宝物として大切に保管されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "誕生とか初節供とか、または老人の年祝とか、餅がある一人のために特に大きかった場合は多い。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
