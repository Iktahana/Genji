        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "学生とは本来、青いマントを羽織ったチャイルド・ハロルドでなければならぬと、私は頑迷にも信じている者であります。",
              "citation": {
                "source": "心の王者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハロルドのマント羽織つた莫斯科ツ子。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハロルドのマント羽織った莫斯科ッ子。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハロー、ウイルキンス。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハロー」「うん――。",
              "citation": {
                "source": "職業婦人気質",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "紳士は、ふいと私の視線をたどって、そうして、私と同様にしばらく屋台の外の人の流れを眺め、だしぬけに大声で、「ハロー、メリイ、クリスマアス。",
              "citation": {
                "source": "メリイクリスマス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロイドに、そっくり」　当時、ハロルド・ロイドとかいう外国の映画の喜劇役者が、日本で人気がありました。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、自分は、日本の東北のハロルド・ロイドに過ぎなかったのです。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者は思はずハローとやった。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、母の妹に当たるホノーリア・ウェストファイルという叔母がハロウの近くに住んでおりまして、父もここを訪ねることだけは許してくださいます。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "狼藉を働くようなら、ハロウの叔母さんのところまで送って差し上げます。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々はふるえるご婦人に悲劇を告げ、早朝の汽車でハロウにいる善良な叔母の元へ送り届けた。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "正味、負担重量の関係でベイアードは五ハロンで一〇〇ヤードは差がつくだろ、馬主筋はみんなこっちに賭けたって本当かね？",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "新馬場（一マイル五ハロン）。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の姿を見ると一同は総立ちになって「ハロー」を叫んだ。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心は安く、気はかろし、揺れ揺れ、帆綱よ、空高く……　ハロウとでも呼びかけたい八月の朝凪である。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハロウだ、まさしく。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治四十一年四月ハロー市の大火の前に兎一疋市内を通り抜けた由（翌年六月五日の『随筆問答雑誌』四五八頁）。",
              "citation": {
                "source": "十二支考",
                "author": "兎に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思って見ると、堤を切って溢れて行くような「チャイルド・ハロルド」の巡礼なぞの方に、捨吉は深く心を引かれるものを見つけた。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はゼネラル・エレクトリック・コンパニーのハロルド・クリーバーという社員ですが、あなたの方は？",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "物も云ったこともないのに向うも覚えていたらしく、にっこり笑いつつハロウと声をかけて行きすぎた。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "往来で出遇つた時など、思はず私が以前のやうに手をあげて、ハロウ……と呼びかけても、今では彼はニコリともせず棒切れでも呑んでゐる見たいにしやちこ張つて、まん丸な眼玉を極めて真面目さうにぎよろりと輝やかせてゐるだけだつた。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうだ俺は、それ以来一度も木登りといふことを試みたことは無かつたのぢやないかしら――不図私は、そんなことを思ひ廻らせてゐる矢先に、ずつと先の方に踏み入つてゐたフロラが、「ハロー、ハロー！",
              "citation": {
                "source": "寄生木と縄梯子",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はギツクリとして眼を白黒させてゐた途端に、ずつと先の方へ踏み入つてゐたフロラが、「ハロー、ハロー！",
              "citation": {
                "source": "祝福された星の歌",
                "author": "An episode from the forest",
                "note": "青空文庫"
              }
            },
            {
              "text": "）「GOD KHONSU――ハロウ、ハロウ！",
              "citation": {
                "source": "ラガド大学参観記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもへルンに申しますと、いつものように『有難う』と喜びまして、縁の端近くに出かけまして『ハロー』と申しまして、花を眺めました。",
              "citation": {
                "source": "思い出の記",
                "author": "小泉節子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもヘルンに申しますと、いつものように『有難う』と喜びまして、縁の端近くに出かけまして『ハロー』と申しまして、花を眺めました。",
              "citation": {
                "source": "思い出の記",
                "author": "小泉節子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
