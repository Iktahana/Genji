        "examples": {
          "standard": [
            {
              "text": "母ザルは、我が子を抱きかかえ、優しく毛づくろいをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "天敵が近づくと、母ザルはすぐに警戒し、子ザルを隠した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "動物園で、母ザルが遊び疲れた子ザルを背負って移動する姿を見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
