        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "秋になると、産卵のために川を遡上する鼻曲がりの鮭が見られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鼻曲がりの鮭は、生命の力強さを感じさせる独特の姿をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "産卵期を迎えた鮭は鼻曲がりになり、川を遡上してくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
