        "examples": {
          "standard": [
            {
              "text": "ライブハウスのステージで、ジャズギタリストがハモンドオルガンを弾き始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古いブルースのレコードから、あの独特のハモンドオルガンの音が聞こえてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はゴスペル音楽に欠かせないハモンドオルガンの奏法を熱心に学んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "壁につけて、レズリー・スピーカーのついていないハモンド・オルガン、アップライト・ピアノ、ヴィデオコーダーと呼ばれる、小さなトランクほどの大きさがある重い機械がおかれ、天井近くに十九インチのテレビがある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギターとフルートが、おなじ音なんだからな」　ハモンド・オルガンには、トランペットとか、フルートといった、音色のスウィッチがついている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            }
          ]
        }
