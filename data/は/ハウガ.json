          "literary": [
            {
              "text": "お声もさはやかに御申渡しになり、少し間を置いて、お胸に何か浮んだらしく、うつむいてくすくすとお笑ひになり、管絃ノハウガイイヤウデス　とおつしやいました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マヘノ　ハウガ、「モウ　シバラク　マテ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ウシロノ　ハウガ　イヒマスト、マヘノ　ハウガ、「モウ　スコシ　サキノ　ガケノ　上カラ　タニ川ヘ　ホリコンデ　ヤラウ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、コハレナイ　ウチニ、ムカシ、コノ　バシヤガ　マイニチ　カヨツタ　カイドウスヂヲ　ミセテ　ヤツテ、ソレカラ　モヤシテ　シマツタ　ハウガ　ヨイト　オモフ」　コドモタチハ　ミナ　サンセイイタシマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネンネン　ヨヲヲヲ　ネンネン　ヨウ」　シカシ、アカンボウヨリ　サキニ、コモリノ　ハウガ　ウツラ　ウツラ　ネムリハジメマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
