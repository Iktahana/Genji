        "examples": {
          "standard": [
            {
              "text": "「お釣りの端（はした）のお金は、募金箱に入れてください。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "1000円札で払ったので、端（はした）の金額は小銭で返ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "たった端（はした）の小銭でも、集まれば大きな額になることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
