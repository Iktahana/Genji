        "examples": {
          "standard": [
            {
              "text": "70年代のガーナで爆発的な人気を誇ったハイライフの独特なリズムに、すっかり魅了されてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "カフェのスピーカーから陽気なハイライフが流れてきて、街の喧騒も少し心地よく感じられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼のギターソロは、伝統的なハイライフの旋律を現代風にアレンジしていて非常に独創的だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "デジューネーの、銀の壺に盛られた琥珀の蜜も、煙草の名のハイライフも、紅のように頬を染めたあの北風も、今はなかなか忘れられない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            }
          ]
        }
