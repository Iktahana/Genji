      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "桜雛、柳雛、花菜の雛、桃の花雛、白と緋と、紫の色の菫雛。",
              "citation": {
                "source": "雛がたり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "花菜の中を半の時、私は香に咽んで、涙ぐんだ聲して、「お寂しくおいでなさいませう。",
              "citation": {
                "source": "雪靈記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "懐にして、もとの野道へ出ると、小鼓は響いて花菜は眩い。",
              "citation": {
                "source": "若菜のうち",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも夢か、胡蝶の翼を櫂にして、桃と花菜の乘合船。",
              "citation": {
                "source": "月令十二態",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "花菜の中を半の時、私は香に咽んで、涙ぐんだ声して、「お寂しくおいでなさいましょう。",
              "citation": {
                "source": "雪霊記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしやわざくれ、作品のモチーフとなる切情に殉ぜんかなと）　からし菜、細根大根、花菜漬、こういった旬の青味のお漬物でご飯を勧められても、わたくしは、ほんの一口しか食べられなかった。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日も、翌日も……行ってその三度の時、寺の垣を、例の人里へ出ると斉しく、桃の枝を黒髪に、花菜を褄にして立った、世にも美しい娘を見た。",
              "citation": {
                "source": "瓜の涙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――一方やや高き丘、花菜の畑と、二三尺なる青麦畠と相連る。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方は雑木山、とりわけ、かしの大樹、高きと低き二幹、葉は黒きまで枝とともに茂りて、黒雲の渦のごとく、かくて花菜の空の明るきに対す。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "・春あを／＼とあつい風呂此宿は見かけよりもよかつた、町はづれで、裏坐敷からのながめがよかつた、遠山の姿もよい、いちめんの花菜田、それを点綴する麦田（此地方は麦よりも菜種を多く作る）その間を流れてくる川一すぢ、晴れわたつた空、吹くともなく吹く風、馬、人、犬、――すべてがうつくしい春のあらはれだつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "筑前の海岸一帯は美しい松原つゞきだが、殊に津屋崎海岸の松原は美しい、津屋崎の町はづれの菜の花も美しかつた、いちめんの花菜で、めざましいながめである（こゝでまた、筒井筒振分髪のＨ子をおもひだした）。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "花菜を水仙に活けかへる、水仙のつめたきもよいが花菜のあたゝかさもよい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "石花菜君の説には賛成ですが、今は其時期であるまいと思います。",
              "citation": {
                "source": "雑信（二）",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "△　△　△△華やかな春にあこがれていられる石花菜君の若々しい感情を祝福する。",
              "citation": {
                "source": "雑信（二）",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "香気にしてからが然うで、石花菜を食べるのは、海の匂を味はひ、香魚を食べるのは淡水の匂を味はふので、今｜恁うして茸を食べるのは、軈てまた山の匂を味はふのである。",
              "citation": {
                "source": "茸の香",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "独活、花菜、山椒の芽、小鳥の叩き肉。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "「馬鈴薯、甘藷、胡羅蔔、雪花菜、※、藁、生草、それから食パンだとか、牛乳、兎、鶏、馬肉、魚類など、トラックに満載されてきますよ」「なるほど」帆村は又鴨田の方へ向き直った。",
              "citation": {
                "source": "爬虫館事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうはとしよりのお献立に、春らしく蕗だの花菜（油菜の花の蕾のついたの）、うど、コリフラワーなどにとりの肉のたたいたのをおだんごにしたのをなべにします。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の好物の中に、雪花菜汁がある。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此一｜期・月雪花菜鳥椀　今年のように雪の多い年も珍らしいと、長生きしている年老さえ、眼を瞠って戸外に眺め入るのだった。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ココロボチ　越前の三國港附近で、石花菜即ち「てんぐさ」をさういつて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ココロボチ　越前の三国港附近で、石花菜すなわち「てんぐさ」をそういっている。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "庇のもとに床ありて浅き箱やうのものに白く方なる物を置たるは、遠目にこれ石花菜を売ならん、口には上らずとおもひながらも、山をはなれて暑もはげしく汗もしとゞに足もつかれたれば茶店あるがうれしく、京水とともにはしりいりて腰をかけ、かの白き物を見ればところてんにはあらで雪の氷なりけり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
