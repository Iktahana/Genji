          "literary": [
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、僕ハアナタ方ニ隠シテイタコトガアリマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハアナタカラ記憶ヲ消シ、アナタノ意識ニ架空ノ現象ヲ投影シタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当ハアナタシカ存在シナイノニ、アナタノ五感ニ訴エル擬似現象ハ、アナタ以外ノ存在ヲアナタニ納得サセタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
