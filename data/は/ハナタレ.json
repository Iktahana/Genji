    },
    "definitions": [
      {
        "index": 1,
        "gloss": "runny-nosed child",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園で、鼻たれ小僧たちが無邪気に走り回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔はよく、鼻たれながらも泥だらけになって遊んでいたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あらあら、鼻たれさん」と、優しいおばあさんが子供の鼻を拭ってあげた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "鼻たれ小僧の時から使われて、権右衛門のためには随分危い橋も渡って来た春松なのだ。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――鼻たれて、きたなきも。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身を米の粉でまっしろにして、かれの妻と三人のおとこの鼻たれのために、帯と、めんこのために、努めて居る。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな時安子は、「何さ鼻たれ小僧！",
              "citation": {
                "source": "妖婦",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレが鼻たれ小僧だったころには強力なメディアだった本物の紙芝居の機能に加え、電子化したＴＯＷＮＳ版にはいろいろなボタンを画面上に仕込んで任意のページに飛んだり、仕掛けておいた音を出したりといった機能が付け加えられている。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "新任の美人英語教師にあてて中学二年の鼻たれ小僧が書いた、愚直な作文ではないか。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うん、こう鼻たれるようになったらもうあかん。",
              "citation": {
                "source": "南北",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻たれの兄と呼ばるゝ夜寒かな　ふと眼を開けば夜はいつしか障子の破れに明けて渋柿の一つ二つ残りたる梢に白雲の往き来する様など見え渡りて夜着の透間に冬も来にけんと思わる。",
              "citation": {
                "source": "旅の旅の旅",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "門前に立っては、もの珍しげによりたかる私どもにむかって、「それそれ鼻たれ、そっちゃへどけ、どけ……」　と一応怒鳴り廻してから、砂袋の中から五色の砂を取りまぜて握り出しては門の石だたみの上にそれをさっとはくように撒く。",
              "citation": {
                "source": "砂書きの老人",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ども鼻たれはこの驚異を前にそれこそ呆然と突ったって見惚れてしまっている。",
              "citation": {
                "source": "砂書きの老人",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "どふぞ／＼昔の鼻たれと御笑被遣間じく候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十二月四日　坂本権平、一同あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓の鼻たれっ児の子守だった癖にさ。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸へ着いた時も、いの一番に飛び上がつて、いきなり、磯に立つて居た鼻たれ小僧をつらまへて中学校はどこだと聞いた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸へ着いた時も、いの一番に飛び上がって、いきなり、磯に立っていた鼻たれ小僧をつらまえて中学校はどこだと聞いた。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに一年、一行の文字も書くことができず、川の底の屍体をひきあげて町の鼻たれ子供にほめられてもてはやされて、わが身の馬鹿さを怒らずにゐられるものか。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "源床の鼻たれ小僧が天才だと。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "天才てえものは、鼻たれ小僧のうちから、広い日本で四千人に一人でなくちゃアいけねえものだ。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚式も借着の紋付ですました野郎が、新調の紋付をきて、商売を休んで、鼻たれ小僧の手をひいて、静々と将棋大会へでかけやがったじゃないか。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "床屋の鼻たれ小僧に負けちゃア、御先祖様に顔向けができない」　こういう心掛けでせッせとやるから、子供は大喜びである。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの床屋の鼻たれは、いくらか強いか」「子供にしちゃア指しますが、私もあの年頃にはあのぐらいに指しましたよ」「へえ、そうか。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、子供であの鼻たれを負かす者も珍しくないな」「そうですとも。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "床屋の鼻たれよりも二三年下で、あの鼻たれをグウの音もでないほど打ち負かすことのできる滅法強い子供をな。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この町へつれてきて、大勢の見物人の前で床屋の鼻たれと試合をさせて、ぶち負かしてやるんだから」「それじゃア二割引きでマキを売って下さいますか。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年四年の鼻たれでさえ渡るのに！",
              "citation": {
                "source": "橋の上",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは鼻たれ小僧じゃないぞ、センチメンタルな青二才じゃないぞ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくのおやじは、おしとねも金屏風もなしで、腰元の代わりに鼻たれ小僧のぼくを連れて行った。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ、そうじゃありませんか、『薬屋のカルルが恐ろしくって、心臓を突き刺された』だの、その男が（鼻たれ小僧が！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "菜種の黄、レンゲの紫に彩られた田舎道に領主の赤馬が絵のようにうかびあがると鼻たれ小僧どもがわいわい騒ぎながら駈けあつまってくる。",
              "citation": {
                "source": "本所松坂町",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五人が、息せき走って行くと、土手に凭れて鼻たれ小僧が遊んでいる。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "反対側に出ると、その部屋の、入口は開けはなたれていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
