[
  {
    "uuid": "5ea431e2-f98a-5828-bf25-58d2172debc7",
    "entry": "鼻たれ",
    "reading": {
      "primary": "はなたれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
