        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はまだ仕事の経験が浅い鼻たれだが、飲み込みは早い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの鼻たれだった新人が、今ではチームリーダーを務めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「俺も昔は鼻たれだったけど、努力してここまで来たんだ」と、先輩は静かに語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
