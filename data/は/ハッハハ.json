          "literary": [
            {
              "text": "ハッハッハハ」　私は、歯を食いしばった。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハハハハ」　西沢も、そのベッドへ上がって、ころがってしまった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈台下暗しだぜ、ハッハッハハハ』と。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハハハハ」「相手さえあればね。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは痛快だ、こいつあおもしろい、ワッハッハハハハハハ、ワッハッハッハハハハハ、とてもたまらない、ワッハッハハハハハ、あれを見たまえ！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟板を虎の子みたいに抱いてるぞ、ワッハッハハハハハ」船長はころげ歩くばかりに笑い狂った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "この糞のにおいのする仕事着にでも近づいて来るだろうかってことを考えてるんさ、ハッハハハハハ」彼は笑った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハハハハハ」「それは全くだよ、波田君」藤原は感に堪えぬようにして言った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハハハハハ」とうとう船長も、あまりのストキの言葉にふき出してしまった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハハハハハ、蚤と南京虫のだろう！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯だお願い申してみる位なんですねハッハッハッハッ」「矢張り道楽でさアハッハッハハッ」と岡本は一所に笑ったが、近藤は岡本の顔に言う可からざる苦痛の色を見て取った。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハハ」「もうつかれてだめです。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なめくぢはいつでもハッハハと笑って、そしてヘラヘラした声で物を言ふけれども、どうも心がよくなくて蜘蛛やなんかよりは却って悪いやつだといふのでみんなが軽べつをはじめました。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハハハハッハ、ハハハハハ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なめくじはいつでもハッハハと笑って、そしてヘラヘラした声で物を言うけれども、どうも心がよくなくて蜘蛛やなんかよりは却って悪いやつだというのでみんなが軽べつをはじめました。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は襦袢の袖を噛み声も得たてず泣き出せば、十兵衛涙に浮くばかりの円の眼を剥き出し、まじろぎもせでぐいと睨めしが、おおでかしたでかした、よくできた、褒美をやろう、ハッハハハと咽び笑いの声高く屋の棟にまで響かせしが、そのまま頭を天に対わし、ああ、弟とは辛いなあ。",
              "citation": {
                "source": "五重塔",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と云つて、輕く「ハッハハハ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハハ』『酷い男だ、君は』『だってそうじゃないか。",
              "citation": {
                "source": "火星の芝居",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と云つて、軽く「ハッハハ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ハッハハ、解りませんか？",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッハッハッハッハハハハハ、とうとう一パイ喰いましたね……ヒッヒッホッホッホホハハハハハ。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは重畳」「私昼行灯になりましょう」「ハッハハハ、昼行灯になれよ」「きっとなってお目にかけます」「昼の行灯は馬鹿気たもの、人は笑っても憎みはしない」「御意の通りにござります」「我が家は内藤家の二番家老、門地高ければ憎まれ易い。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まだまだ首は渡されぬて、ハッハハハ」　と物凄く笑う。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "というように上を向いてアッハッハハと笑ったが、すぐにまじめな顔に返ってじろりと泰軒を見すえた。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッハッハハ飛んでもない奴等だ、そんな小供や小娘に、裏掻かれるような俺達なら、とうの昔に縛られている……さあさあ帰れ従いて来い。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
