        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "不良の木村が、凄い傑作だから是非とも見よ、と矢鱈に力こぶをいれて言うものだから、期待して見に行ったのだが、なんという事だ、ハアモニカの伴奏でもつけたら、よく似合うような、安ポマードの匂いのする映画だった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗って来た自転車を、其のまま売り払うのは、まだよい方で、おじいさんが懐からハアモニカを取り出して、五銭に売ったなどは奇怪でありました。",
              "citation": {
                "source": "老ハイデルベルヒ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "或いは又、孫のハアモニカを、爺に借せと騙して取上げ、こっそり裏口から抜け出し、あたふた此所へやって来たというような感じでありました。",
              "citation": {
                "source": "老ハイデルベルヒ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本のとうもろこしに、食いついている姿は、ハアモニカを懸命に吹き鳴らしているようである。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜂雀は細い細いハアモニカの様な声でそっと私にはなしかけました。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハアモニカの声がきこえて来た。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、ハアモニカがいよいよ調子づいて、甘い甘いセンチメントを顫はして来る。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣鐘マントが、そつとハアモニカを引つ込めて、さてやや鼻白んですれちがつた。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのハアモニカだよ、若造つて云ふのは。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンドリンとギタアとハアモニカと、そしてかぼそくふるえるバイオリンとが、このまずしい名人たちの手でかなでられていた。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
