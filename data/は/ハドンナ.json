        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "倫敦ノ焼芋ノ味ハドンナカ聞キタイ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヘルサンハドンナニウレシカツタデセウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ニ顔ハドンナ顔ニナルダロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "体ガ丈夫デサエアレバコンナ秋日和ノ日ハドンナニ爽快デアロウ、予モ四五年前マデハソノ爽快味ヲ満喫シテイタノニト思ウト、クヤシクモ忌マ／＼シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼吸困難ニ陥ッテ息ガハアハア云イ出シ、次第ニ人事不省ニナリ、気管内ニチューブヲ差シ入レラレル時ノ心持ハドンナダロウナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気狂イ沙汰ダワ」ト、口デハ云ウニ決ッテイルガ、心デハドンナニ喜ブデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ僕ガ木村デアッタトシテ、ドッチニヨケイ惹キ付ケラレルカトイエバ、ソレハ、年ハ取ッテイルケレドモ母ノ方デアルヨリモ、僕自身ハドンナツモリナノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハドンナ場合デモ常ニ夫ニ忠実ナル妻デアル以外ノ何者デモアリマセン」トイウ意味ナノカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
