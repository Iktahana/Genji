        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレデ、ボンコチヤンハイツモ、アタラシイ時ノヤウニ美シウゴザイマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ボンコチヤンハイツモ、モンコチヤンノアタマニイヤイヤノツカリマシタカラ、アマリニアヒマセンデシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナマメカシイト云ッタライヽノカ、色ッポイト云ッタライヽノカ、己ハ今マデニアンナ妖艶ナ女ヲ見タコトガナイ、妖婦ト云ウノハ正シクアンナ女ノコトヲ云ウンダロウナ、アンナ女ニナラ殺サレタッテイヽト思ッタト、湿ノ父親ハイツモ忰ヲ掴マエテヨク／＼感ニ耐エタヨウニ云イ暮ラシタソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウナルト予ハイツモノ癖デ依怙地ニナリ、直グニハ立チ上ロウトシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ糊ノ硬イゴワ／＼シタ単衣ヲ着セラレルノガ嫌イデアッタガ、寝間着ニハイツモ甘ッタルイ腐リカヽッタヨウナ糊ノ匂イガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈良ノ三月堂ノ不空羂索観世音菩薩ノ足ヲ見ルト、予ハイツモ母ノ足ヲ思イ出ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ泣キ声ヲ出スウチハ何モシタゲナイワヨ」「ジャア泣クノヲ止メル」予ハイツモノ予ニナッテ、ケロリトシテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツナサルノ」「病院ノ方ハイツデモイラッシャイト云ッテルンダ、ソウ決マッタラ早イ方ガイヽ、明日行ク」「マアオ待チナサイ、アナタハイツモ性急ナンダカラ」婆サンハ出テ行ッタト思ウト、高島易断ノ暦ヲ持ッテ戻ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ早ウゴザイマス、オ爺チャンハ朝ハイツモオ早イノネ」ソウ云ッテ、竹ノ皮ニ包ンダモノヲ二本、風呂敷ヲ解イテナイトテーブルノ上ニ置ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ、日記帳ヲ入レテアル抽出ノ鍵ハイツモ某所ニ隠シテアルノダガ、ソシテ時々ソノ隠シ場所ヲ変エテイルノダガ、詮索好キノ彼女ハ事ニヨルト過去ノアラユル隠シ場所ヲ知ッテシマッテイルカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今時分ハイツモ留守ダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
