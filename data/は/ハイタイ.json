  {
    "uuid": "73b68a0a-8e25-5c27-9c59-74f9acc93eaa",
    "entry": "胚胎",
    "reading": {
      "primary": "はいたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "germination",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しいビジネスアイデアが彼の心の中でゆっくりと胚胎し始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そのプロジェクトはまだ初期段階であり、多くの可能性を胚胎している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の作品には、未来の芸術の方向性を胚胎させるような創造性が感じられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "学者と素人との意思の疎通せざる第一の素因は既にここに胚胎す。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらくそれへの嫌悪から私のそうした憎悪も胚胎したのかもしれないのである。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしもともと相対性理論の存在を必要とするに至った根原は、畢竟時に関する従来の考えの曖昧さに胚胎しているのではないかと考えられる。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかして自由詩は、實にこの時代的の趣味から胚胎された。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説を芸術として考えようとしたところに、小説の堕落が胚胎していたという説を耳にした事がありますが、自分もそれを支持して居ります。",
              "citation": {
                "source": "芸術ぎらい",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちの恋は六七歳のころふたりでよく遊んだお嫁さんごっこの他愛ない遊びに胚胎しているのでございます。",
              "citation": {
                "source": "おしどり",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等は抑※何に胚胎してゐるのであらうか、又｜抑何を語つてゐるのだらうか。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども人の最大なる得意の時代は、やがてまた最大の失意を胚胎し来るの時代たるなからむや。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して彼が従来の歌劇を捨て、其の芸術綜合の信念と目的とを表現したる初めての獅子吼『タンホイゼル』は、実にこの惨憺たる悲境に於て、彼の頭脳に胚胎したりし者なる也。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って、それから胚胎して来る僕たちの結婚にも熱が無くなって来たのだ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は、この湖に胚胎する伝説によってはたから一生苛めつけられなさった。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダメス王の王座はこの如くにして、埃及の国家組織の中心に自ら胚胎した事でありました。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに女が秘密をよろこぶという心が胚胎したのかもしれない。",
              "citation": {
                "source": "咲いてゆく花",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その不朽の名畫晩餐式はこゝに胚胎せしなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "道教の宗教として世に臨んでゐる部分は、決して道家の那處に胚胎してゐるといふことすら全く無いのである。",
              "citation": {
                "source": "道教に就いて",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "第六回院展の『秦准の夕』では、ある批評家にこの作は漫然たる浪漫的気分の胚胎したものだといふ風にも評された。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉と霊とを峻別し得るものの如く考えて、その一方に偏倚するのを最上の生活と決めこむような禁慾主義の義務律法はそこに胚胎されるのではないか。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二葉亭の東方問題の抱負は西郷の征韓論あたりから胚胎したらしい。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃一と度は政治家たらんと欲し、転じて建築に志ざし、再転して今度は実業界に入ろうとした一青年たる自分が文学に興味を持つようになったのもまた、直接には龍渓鉄腸らの小説、間接にはこれらの新傾向を胚胎した英国の政治家的文人の典型であった。",
              "citation": {
                "source": "四十年前",
                "author": "――新文学の曙光――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の失脚は、全く此女との関係に胚胎して居たとは云へ、彼女に対する愛は、その為に、まだ少しも傷けられては居なかつた。",
              "citation": {
                "source": "海の中にて",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "かやうな理論的行き詰りは、ひとへに、氏が文芸のアプリオリに執着せられるところに胚胎する。",
              "citation": {
                "source": "文学の本質について（二）",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然主義文学の一面の特色である平凡主義は、かういふ事情に胚胎してゐるのである。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それらは、大きな原因の一部であって、結局は日本人の生活、文明が科学的に幼稚であり原始的であるというところに一切の原因は胚胎しているのである。",
              "citation": {
                "source": "日本の近代的探偵小説",
                "author": "――特に江戸川乱歩氏に就て――",
                "note": "青空文庫"
              }
            },
            {
              "text": "出る杭を打たうとしたりや柳かな酒を煮る家の女房ちょとほれた絵団扇のそれも清十郎にお夏かな蚊帳の内に螢放してアヽ楽や杜若べたりと鳶のたれてける薬喰隣の亭主箸持参化さうな傘かす寺の時雨かな　後世｜一茶の俗語を用いたる、あるいはこれらの句より胚胎し来たれるにはあらざるか。",
              "citation": {
                "source": "俳人蕪村",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "バイロンの「マンフレッド」に胚胎したという青木が処女作の劇詩は、その煙草屋の二階で書いたものであることも分って来た。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来を云うと、犬と云うのも記号で、心を石だと云うのも一種の象徴でありますから、第三段になって正式にあらわれるのはすでに前から胚胎しておったものであります。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸本の心の毒は実にその孤独に胚胎した。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが三人の女の児を先立てたことに胚胎したことを思い出した。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "京弥は言うまでもないこと、妹菊路のろうばいはいたいたしい位でした。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「不眠症のときの涙はいたい。",
              "citation": {
                "source": "四五ニズム述懐",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "arising (in)",
