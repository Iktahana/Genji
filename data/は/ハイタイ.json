        "examples": {
          "standard": [
            {
              "text": "「ハイタイ、今日はどちらまで？」沖縄の空港で、タクシーの運転手さんが笑顔で声をかけてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "久しぶりに会った友人に「ハイタイ！」と元気よく挨拶した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "電話に出ると、知らない声で「ハイタイ、〇〇さんのお宅ですか？」と尋ねられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
