        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "買って来たピッツアとロウソクの明かり　僕のビートルの前を走っていたマーキュリーのステーション・ワゴンは、ハレイワの町のなかで右折した。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハレイワからワイアルーアにむかう田舎道を、この三台の自動車は、走っていた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハレイワの町にさしかかって、もう一度、雨が来た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎町ハレイワは、いつもとおなじたたずまいだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハレイワのランドマークとなって久しい。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまご覧になったとおり、ハレイワのニシモト・カントリー・ストアは、これで終わりです。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと悲しさを覚えてしまうほどのいつに変わらぬハレイワだが、その不変の陽ざしのなかで、僕はたったいま、古いものが永久に姿を消す現場をひとつ見た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
