        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "人モ家モ、暗イウチハマダ滅亡セヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自省直ケレバ千万人ト言エドモ、――イヤ、握手ハマダマダ、ソノ楯ノウラノ言葉ヲコソ、「自省直カラザレバ、乞食ト会ッテモ、赤面狼狽、被告、罪人、酒屋ニ飛ビ込ム。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ハナレヤニハマダタレカイル。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノフェレスは、ハマダラ蚊ともよばれ、羽根に黒いまだらがたくさんあつてとまるのにも、普通の蚊がおしりを下につけるのと反対に、おしりを上げてとまりますからすぐ区別がつきます。",
              "citation": {
                "source": "パナマ運河を開いた話",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マラリアの病原菌は或小さな微生物にとりついて、それを寄生主にして生きてゐるもので、その寄生主がハマダラ蚊のからだの中に住んでゐるといふことを、ロッス少佐が根気づよい顕微鏡検査で見つけ出したのです。",
              "citation": {
                "source": "パナマ運河を開いた話",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ理由ハマダ自分デモハツキリワカラナイガ、オソラクヒラガナヲ構成スル線ガアマリニ不規則ナタメ、一定ノ法則ニ従ツテ様式化スルコトガ困難ナセイダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ見タトコロデモ死骸ハ大概同ジヤウナ形ニナツテヰタ頭ガヒドクフクレ　顔ハマル焦ゲ　胴体モ腕モケイレン的ニフクレ上ツテヰル　火傷者ノ腕ニ蛆ガ湧イタリスル　十三日後ニナツテモ広島市デハマダ整理ノツカヌ死骸ガ一万モアルラシク　夜ハ人魂ガ燃エテヰルト云フ。",
              "citation": {
                "source": "原爆被災時のノート",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "［第一図］※　　　　　　　８　　　＿＿＿＿＿＿＿７４□）□□□□□□　　　　□□□２　　　　―――――※ハ東京新宿追分「ハマダ」撞球場内ノ世界撞球選手「ジョナソン氏」ノポスターノ裏。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあこれからハマダ撞球場へ乗りこむことになったのだ。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ夕刻のこととて、ハマダ撞球場は学生やサラリーマンで七台ある球台が、どれもこれも一杯だった。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "塔ノ上ヨリ三ツ目ノ窓ニ星印アリ　これは例の新宿追分ハマダ撞球場にしまってあった世界的撞球選手ジョナソンのポスターの裏に紫外線灯をさしつけて素早く読みとった文字の写しであった。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレカラ思イツイテ、心易イ者ヘ高利ヲカシタガヨカッタ、浅草ノ奥山ノ茶屋ヘ金ヲカシタガ、是ハマダルカッタガ、ソノ代り山中ハハイハイトイイオッタ故親分ノヨウダッケ」　　　　　　　　　七十　さて、これから名うての剣客島田虎之助をからかった物語だ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼトイツテ、モンコチヤンハマダ九ツデ、イタツテ小サイ子ダツタシ、ボンコチヤンハナルベク、セイノタカイ人ノアタマニノツカリタカツタカラデス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕暮ア市より一つ手前の驛に停車した時、何だか私の姓を呼ぶ樣な女聲が聞こえたが、アラビヤ語には「ハマダ」と言ふ風な名前が少なくない上、こんな處で女の知合はないので、私は意に介せずして居た處、汽車が動いてから、私の車室に這入つて來て私を尋ねる英國婦人があるのに驚いた。",
              "citation": {
                "source": "埃及雜記",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで言う蚊はアメリカ合衆国北部で普通にいるイエカではなく、この寄生虫が発育し感染を起こすのは主としてハマダラカである。",
              "citation": {
                "source": "簡約医学史",
                "author": "A Concise History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の墓は古代のエクバタナであるハマダンにあり、長方形の単純な煉瓦の建物であって、気取らない庭で囲まれている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚巻ハ先代歌右衛門、ソノ時ハマダ福助ト云ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヽ、何カノ時ノ用心ニアレハ取ットク積リナノ」「何云ッテルンダイ、オ前ノ亭主ハマダ四十台ジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「春久ハマダイタンダネ」予ハ努メテ晴レ／″＼ト、気軽ナ風ヲ装ッテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰宅シテ見ルト、颯子ハマダ帰ッテイナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南禅寺ッテ云エバ永観堂ノ紅葉ガ綺麗デショウネ、アタシガアレヲ見テカラモウ何年ニナルカ知ラ」「永観堂ハマダ早イヨ、高尾ヤ槙ノ尾ガチョウド見頃ダガ、己モコノ脚ジャ行ケソウモナイ」……………………………………………………………………………………………………十二日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハマダホテルニ帰ッテイナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食ベ終ッテモ颯子ハマダ寝テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食ノ時ニ食堂ニ見エナカッタノハ、朝寝坊ノ彼女ノ常デアルカラ、予ハマダ颯子ハ寝テイルモノト思ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昨夜ノ今日デ郁子ハ例ニヨリ今朝ハマダ昏睡シテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ上僕ハ精力ノ補給ヲスルタメニ相馬博士ニ相談シ、大体月ニ一回男性ホルモンノデポヲ用イテイルノダガ、ソレダケデハマダ不足ナ気ガシ、脳下垂体前葉ホルモンノ五百単位ヲ三日カ四日オキニ注射シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後にハマダン（イラン中西部の都市）についた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
