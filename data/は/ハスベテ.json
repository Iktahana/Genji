        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "既婚ノ女、大概数エ年十八九歳以上ハスベテ眉ヲ剃リ歯ヲ黒ク染メテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去ハスベテ幻影デココニ真実ノ存在ガアリ、僕ト妻トガタダ二人ココニ立ッテ相擁シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番｜肝腎ナハ、―――今度コソ郁子ハスベテノモノヲ木村ニ捧ゲ尽シテシマッタノデハナイカ、ソシテ敏子ノ口ヲ介シテソノ諒解ヲ僕ニ求メテイルノデハナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエガ小竹向原ノ空家デ着々ト進メテイル計画ヲ私ハスベテ知リツクシテイル。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局ハオマエノヤッタコトハスベテ無駄ダッタノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガコレラハスベテ架空ノ出来事ナノダ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
