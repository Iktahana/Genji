        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「おんちゃんごはんおあがんなさいって」「おはんなさいははははは」　父は両手を回し、大きな背にまたふたりをおんぶして立った。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　（四辺を見廻す様にして）はははは。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　あははははははは………嘘だわ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはははは、とひとりで笑ってみたい気持だ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人をだましていい生活をするほど悪がしこくないから、だんだん追いつめられて、あんなばかげたことをして、二円、三円を強奪して、そうして五年も十年も牢へはいっていなければいけない、はははは、おかしい、おかしい、なんてこった、ああ、ばかばかしいのねえ。",
              "citation": {
                "source": "燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ははははは……」　青木さんはうつろな声で笑つた。",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "千円かの無尽にあたつて発狂したといふおぢいさんが……」「はははは、僕達はそんなに※が小さかあない。",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ははははは、それが何より。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はははは、奥さんのお仕込みだろう。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "と面を合わせて、「はははははは、今日あ、」「何かい、それで腹を立って行かないのかい。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はははは、こいつア可い。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はははは、下郎は口のさがねえもんだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はははは、えい、おい、」　と調子が砕けて、「母様の指揮だろう、一々。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "主税は、ややあせった気味で、「なぜと云って、」「はははは、そこが、肝心な処だ、と母様が云ったんだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はははは、すなわち御持せのお車、早速間に合いました。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際、願ってもない良縁で、もとよりかれこれ異存のある筈はありませんが、ただ不束な娘ですから、」「いや、いや、」　と頭を掉って、大に発奮み、「とんだ事でごわります、怪しかりませんな、河野英吉夫人を、不束などと御意なされますると、親御の貴下のお口でも、坂田礼之進聞棄てに相成りません、はははは。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　先生｜哄然として、「はははは、事実ですよ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "巣立の鷹　　　　　　　六十「おっと、ここ、ここ、飯田町の先生、こっちだ、こっちだ、はははは。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣くやら、はははははは、笑うやら、はははは。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハハハハハ」「オウ常さん、今日は駄賃かな。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハハハハハ」　この野郎失敬なと思ったけれど、吾々も余り威張れる身でもなし、笑いとぼけて常吉をやり過ごした。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハハ」「あらア口の悪いこと。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハハ、なるほどね、サロンから、おもてまでじゃ三時間じゃ来られねえや」波田は、冗談だと思って笑った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハハハハ」これが小倉の人間観であった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、一度だけ純粋なほんとの話をして聞かしてもらったら、なおおもしろいだろうと思うよ」「アハハハハ、君の皮肉の方が上手だよ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハハハ」と気のよさそうに笑った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハハハハ」　西沢も、そのベッドへ上がって、ころがってしまった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハハハハ」「相手さえあればね。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はアハハハハハと、船長の後ろ姿に向かって哄笑を浴びせかけた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハハ」と笑った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
