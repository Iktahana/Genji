          "literary": [
            {
              "text": "石坂氏ハダメナ作家デアル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ最初敏子ニ差シタノダガ、「私ハダメデス、ドウカママニオ酌ナスッテ」ト敏子ガ云ッタカラデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月六日　　雪ドケ御大葬寫生ハダメ、夕方雪モヤウ二月十三日、日田端、遠藤二人ヨリ手紙月末東京へ引キアゲルニツイテ一寸塚本サンニユク――十七日、くもり　寫生休田端、入谷ヨリ手紙　入谷といふは小澤碧童のこと。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
