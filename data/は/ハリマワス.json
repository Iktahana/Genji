        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その前へ来て黒羅紗の日覆いなぞのかかった駕籠を停めさせる諸大名もなければ、そのたびに定紋付きの幕を張り回す必要もない。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、雨はザアザア降る、霧は山のすそのほうまで幕を張り回す。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でいつもそんなに引っ張り回す」　またぶつぶつ言うのをアイダがはっきり聞いた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "磯野はその女を一、二度引っ張りまわすと、またふっつりと忘れてしまった。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのままじゃ、とても船にも載せられないし、陸へあげても列車にも積めないし、町を引張りまわすことも出来やしないからね」　そんな話が、あっちでもこっちでも取り交されているうちに、更に国民を愕かせるニュースが入ってきた。",
              "citation": {
                "source": "東京要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がこの杖を引っ張り廻すように、何かが僕を引っ張り廻すだけだ」「ハハハハだいぶ哲学的だね。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "職人はかみそりを持って、その塩辛い指で私のくちびるを引張り廻すのである。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに例のがひいきして引っ張り廻すからサ。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼も彼女を勝手に引っ張り廻すべきではなかったでしょうか。",
              "citation": {
                "source": "白蛾",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "標め縄も、山野や木に張り廻すものです。",
              "citation": {
                "source": "翁の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは筆の調子で宇津木兵馬を引張り廻すのでもなければ、原稿の回数をひきのばすために、無用のペン先を弄するわけでもない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴慕の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しやうがないんですよ、姉さんは……昼間から人を誘ひ出して方々引つ張り廻すんだもの……。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
