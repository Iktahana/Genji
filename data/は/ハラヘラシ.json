          "literary": [
            {
              "text": "式部小町とやらのお嬢さまは、河童が丘を連れてつっ走ったから、もう腹減らしなまねはすんなといってな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "へび使い小町",
                "note": "青空文庫"
              }
            },
            {
              "text": "――腹減らしの餓鬼どもだ！",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "郡役所の兵事係が二人腹減らして待つてはるんや。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            }
          ]
        }
