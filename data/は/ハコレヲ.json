          "literary": [
            {
              "text": "ただ聞くところによれば、大川氏の携えていたピストルはなんらの許可を得ずしてもっていたものとのことであるから銃砲火薬類取締規則に触れることは別問題である」参照　刑法第三十六条――急迫不正ノ侵害ニ対シ自己又ハ他人ノ権利ヲ防衛スル為メ已ムコトヲ得ザルニ出デタル行為ハコレヲ罰セズ。",
              "citation": {
                "source": "黄昏の告白",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ眠ル時ハコレヲ枕頭ニ安置ス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "近世人心浮薄ニシテ、父祖ノ詩モアルイハコレヲ刻セズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ困ルノハコレヲ実行ニ移ス方法如何デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハコレヲ読ミサエシナケレバ、意識ヲ失ッテイル最中ニ何ヲサレタカ知ラナイハズナノデアルカラ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度ハコレヲ聞キタイノデスカ？",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハコレヲ破壊スルヨウニ命ジ、私ハ命ゼラレタ通リノコトヲシタ」「その通りだ」あなたの意識は思念を送った。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
