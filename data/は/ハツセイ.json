[
  {
    "uuid": "a0871a01-f082-557b-94ea-3e13749576e1",
    "entry": "発性",
    "reading": {
      "primary": "はつせい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "空想を失ってしまった詩人、早発性｜痴呆に陥った天才にも似ている！",
              "citation": {
                "source": "愛撫",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての色彩と形が水中へ入れば一律に化生せしめられるように人間のモラルもここでは揮発性と操持性とを失った。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "青葉の揮発性の匂いがした。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどき店の奥のスタンドで、玻璃盞にソーダのフラッシュする音が、室内の春の静物図に揮発性を与えている。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女が、ほのかに匂っているオレンジに塗られたブランデーの揮発性に、けへんけへん噎せながら、デザートのスザンヌを小さいフォークで喰べていると、むす子がのそっと立ち上って握手をして迎える気配がした。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "木々の若芽の叢が、垂れた房々を擡げてほのかに揮発性の匂いを発散する。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "粘って青臭い護謨の匂いが、何か揮発性の花の匂いに混って来る。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "野には青麦が一面によろ／＼と揮発性の焔を立てゝゐた。",
              "citation": {
                "source": "川",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがいま眼の前の父の言葉といい、態度といい、全く思いがけないもので何だかわたくしの身体に融け入って来る和やかなものがありながら、それはもう父の茹り枯しの滓で、揮発性も爆薬性もない摘みほぐした綿のようになった父の性格の繊維だけを感ずるのでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧鶴は遂に仏教の開発性を疑い出したのだという。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "葱を刻んだのを、薬味箱に誇大に盛ったのを可笑しさを堪えた顔の小女が学生たちの席へ運ぶと、学生たちは娘への影響があった証拠を、この揮発性の野菜の堆さに見て、勝利を感ずる歓呼を挙げる。",
              "citation": {
                "source": "家霊",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩、圭介は寿枝から話をきいて、早発性痴呆症だと苦り切つた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁の前面に肉片を置いたときにでも、その場所の気流の模様によっては肉から発散する揮発性のガスは壁の根もとの鳥の頭部にはほとんど全く達しないかもしれない。",
              "citation": {
                "source": "とんびと油揚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また換言すれば、精神に安定性を与えるものがこれ形式で、形式を揮発性にしたものがこれ精神である。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "だぶ／＼してゐるのは猛烈な爆発性をもつた薬品ですからね。",
              "citation": {
                "source": "フアイヤ・ガン",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、早速捜索させますが、そんな猛烈な爆発性をもつてゐるものだとすると、それを何う処置していゝか、それもちよつと伺つておいた方がよささうです。",
              "citation": {
                "source": "フアイヤ・ガン",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰それの展覧会を、今開催してゐるから行つて見ようなどといふ場合は、まつたくの有閑人か、招待状を貰つて出かけなければ義理が悪いか、批評家とか、職業的に美術に関係してゐる人とか、展覧会を見るといふ自発性は多忙な都会生活者にとつては全くないといつてもよい。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして「詩人」とか「天才」とか、其頃の青年をわけも無く酔はしめた揮発性の言葉が、何時の間にか私を酔はしめなくなつた。",
              "citation": {
                "source": "弓町より",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして「詩人」とか「天才」とか、そのころの青年をわけもなく酔わしめた揮発性の言葉が、いつの間にか私を酔わしめなくなった。",
              "citation": {
                "source": "弓町より",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに吾輩が研究の主題として選んだ材料を、今の学者の流儀で名付けると、遺伝性、殺人妄想狂、早発性痴呆、兼、変態性慾とも名付くべき、世にもややこしい代物と来ているんだから厄介この上もない。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから又、あの土下座している髯男の周囲を跳まわっておりますお垂髪の少女は、高等女学校の二年生で、元来、内気な、憂鬱な性格で御座いましたが、芸術方面に非常な才能をあらわしておりまするうちに、所謂、早発性痴呆となったもので御座います。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……呉一郎の遺伝性、殺人妄想狂、早発性痴呆、兼、変態性慾……すなわち一千年前の呉青秀の怨霊の眼で見ると、世界中、到る処の土の下には、女の死体がベタ一面に匿されているように思われて来たのだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことによるとこの少女はキチガイの一種である早発性痴呆かも知れないと思った。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、それが非常な美人だったので「深良小町」の名が近郷近在に鳴り響いているのであったが、可哀相な事にそのマユミは学問上で早発性痴呆という半分生れ付みたような薄白痴であった。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その女房は「早発性何とか云ふ気違ひになつてね、狂ひ死しましたがね。",
              "citation": {
                "source": "日本三文オペラ",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが卒業後、大蔵省に入つて一ト月目に極度の神経衰弱から早発性痴呆症みたいになつて了つた。",
              "citation": {
                "source": "現代詩",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "憎みの習慣性がその自然性を現わすとすれば、怒の突発性はその精神性を現わしている。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みるというのは自主的に、予見的に行うことであって、かような経験には知性が、その自発性が予想される。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "習慣的になることは行為が自然的になること、惰性的になること、従って受動的になることであるが、同時に行為はその自発性において高まる。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "習慣は受動性であると同時に自発性である。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
