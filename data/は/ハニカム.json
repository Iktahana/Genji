        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もうかなりの、五十歳を越したくらいの、頭の禿げた小柄なおじさんが、派手なパジャマを着て、へんな、はにかむような笑顔で私たちを迎えた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はにかむような微笑は魅力的だ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
