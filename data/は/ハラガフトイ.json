        "examples": {
          "standard": [
            {
              "text": "彼女はいつも周りのことを気遣ってくれる、懐が広いというか、腹が太い人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "腹が太い上司だったから、部下の失敗も大らかに許してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "腹が太い性格のおかげで多くの友人に恵まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「遣ってやれんこともないね」感じが鈍いのか、腹が太いのか解らないような小野田は、にやにやしながら呟いた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、ミイが、また、腹が太いですけ、近いうち、三匹ほど増えますわ」「ウフフ……」チヱは、妙にさびしげな含み笑いをして、「増えるのは、子供だけね。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
