        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鼻環は、木綿針を長さ八分ほどに切り落とし、真んなかを麻糸で括った撞木式。",
              "citation": {
                "source": "想い出",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚籠のなかの鮎は掌で捕らえ、そこでそのまま、かねて聞き覚えの通り撞木の鼻環を鼻の穴へ突き通して、瀬のなかへ放り込んだのであった。",
              "citation": {
                "source": "想い出",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私は、井伏君に囮鮎の鼻の穴へ、鼻環を通す次第から、竿の持ち方、足の運び方、鮎が掛ったときの気の持ちようまで仔細に説いた。",
              "citation": {
                "source": "弟子自慢",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は猛牛に鼻環をはめたのであった。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
