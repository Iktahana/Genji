        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どうせ捨てる物なら分けて欲しいと思って、ミス・ハウドンにも願ったんですけれど――」「駄目なの？",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、ミス・ハウドンの心づかいで、わざわざ豊子の隣に席を貰ったのであった。",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――誰も好きな人はいないわ」「デリカシーだの何だのって云う癖に、ああいうことは平気なのね、厭だわ」　ミス・ハウドンは、学生達を集め、最近必要と思われた種々の注意を与えた。",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さて、もう一つ申すことがあるのですが――洗濯場で昨日シーツを一枚めちゃめちゃにして突込んであるのが見つかったのです」　ミス・ハウドンは、後を振向き、彼女の秘書のような役をしている学生の一人に何か合図をした。",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――思い当る方は、それでは後ほど私のところに来て下さい」　ミス・ハウドンは、軽く頭を動した。",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "漠とした不快、ミス・ハウドンの処へ行く者などあるまいという見越し。",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えて見れば、太った体に肉桂色の絹服をつけ、鼻眼鏡をかけたミス・ハウドン。",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
