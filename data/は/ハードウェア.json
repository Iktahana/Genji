    "definitions": [
      {
        "index": 1,
        "gloss": "hardware",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この新しいソフトウェアは、最新のハードウェアで最大限の性能を発揮する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "パソコンのハードウェア構成をアップグレードして、処理速度を向上させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "故障したハードウェアを交換するのに、かなりの費用がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ただし、もっぱらハードウエアの進歩だけに「革命的」なる言葉を奉っていたのでは、何か非常に重要なことを見逃してしまう気がするのです。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "技術者でない人間、特に私のように文科系出身の人間にとっては、半導体もコンピューターも、ソフトウエアもハードウエアも、ともかく常人には近づけぬコンピューターの国のお話と、ごっちゃに見えてしまいやすい。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ当時の電子回路の常識からすれば、機能とは回路上に作り付けになっているはずのもので、ハードウエアにソフトウエアが加わって機能が実現されるといわれても、さっぱりピンとこない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "機械語でプログラムを組んでいくためには、ハードウエアに関するくわしい知識が求められるが、コンピューターを扱う人間がごく一部の専門家に限られているうちは、それですまされていたのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケシにとって幸福だったことは、この本が『マイコン基礎講座』とは題しながら、かなりハードウエアに関して突っ込んだ内容だったことだろう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがハードウエアにも大胆に切り込み、ハードと密接に関係した機械語を学ぶことで、タケシの中でコンピューターはしだいにブラックボックスではなくなっていった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハードウエアとソフトウエアの境目、どこまでの機能がハードによって実現されており、どこからがソフトによっているかが見えてきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでケイらは、ハードウエアに関しては暫定的に大型のものですませ、このマシンを試験台として、ソフトウエアの側からダイナブックに向かって進もうと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケイが性能の要求を示して研究所のハードウエアのエンジニアが作った暫定版ダイナブックは、アルトと名付けられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずらりと並んだ講演会の協賛ハードウエアメーカーに遠慮でもしたのか、彼は「集合的ＩＱによって企業は生産性を高められる」と、化学調味料を振りまくような見解も述べた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "磁気テープを使った記憶装置を付け加え、ハードウエアを改良したＴＸ―２も、ディスプレイとライトペンを受け継いだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハードウエアは、平面型のディスプレイを使ってフレックスマシンよりももっと小さく、厚めのノートほどのサイズに押し込んでしまいたいと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫定版のダイナブックのハードウエアを用意したアラン・ケイは、このシステムで使う言語にロゴにおけるタートルのような、人とコンピューターとが交流し合うための道具を組み込もうと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "当初はコンピューターのハードウエアを作る会社を作ろうと考えたが、やがて自分たちのもっとも得意とするソフトウエアに絞ろうと決めた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイクロプログラミング方式の採用で低価格化と小型化を推し進めたというハードウエアの特長に加え、さまざまなアプリケーションをあらかじめ用意しておくというソフトウエアの備えによって、システム１００はコンピューターの利用の裾野を広げようと狙っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした新しい環境を載せるハードウエアは、μＣＯＭ―16の後継機として開発されたμＣＯＭ１６００を中心に、集積度をより高めたＬＳＩによって構成されていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来使ってきたソフトウエアが新しいハードウエアでは利用できなかったことから、これまでのものに戻して急場をしのげなかったことは、事態の深刻さにいっそうの拍車をかけた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学卒業後、軍需用の電子機器メーカーに入ってプログラミングとハードウエアの知識を養ったルービンスタインは、知人のビル・ミラードに誘われて彼のソフトウエア会社に転職した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハードウエアを設計した経験などまるでなかったキルドールは、筺体も接続ケーブルも電源もコントローラーもないドライブを前にして、途方に暮れた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミニコンピューター上のインタープを使ってＣＰ／Ｍを書き上げて間もない一九七四年の秋、知り合いのジョン・トロードがこの話に興味を持って、ハードウエアを仕上げる作業を手伝ってくれた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、個々のハードウエアの特徴に対応しなければならない部分だけをＣＰ／Ｍの中から抜き出して一まとめにし、ＢＩＯＳ（Basic I/O System）と名付けたこの部分だけいじれば移植が終わるようにしたいと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなったときに最大の利益を上げるためには、キルドールやゲイツのようにハードウエアのメーカーと供給契約を結ぶべきではなく、また通信販売に頼るべきでもない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュレイヤーが手直しの作業に忙殺されたように、それぞれのハードウエアはそれぞれの特徴を持っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＩＢＭ機用に合わせてプログラムを開発しているために、たとえ他社がすぐれたハードウエアを開発したとしてもシステムを変更しようがない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "システム３６０は、従来のトランジスターに代えてＩＣを使うことで高速化、小型化、低消費電力化、信頼性の向上など、ハードウエアの革新を果たすと発表された。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "市場で特に大きなシェアを獲得しているアップル※は、ハードウエアの仕様を全面的に公開するオープンアーキテクチャーをとって、サードパーティーによる増設ボードや周辺機器の開発に門戸を開いていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "計画が正式にスタートした直後から、マシンのハードウエアの詳細な検討が始まった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "シアトル・コンピューター・プロダクツというハードウエアメーカーのために８０８６を使ったマシンを開発したエンジニアのティム・パターソンは、一六ビットに対応したＣＰ／Ｍ―86の開発が遅れ遅れとなっていることにしびれをきらしていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣのハードウエアには見る者を驚かせるような要素はなかったが、ディスプレイへの表示を受け持つ回路の構成には、ユニークな点があった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハードウエアの開発には、さして問題はなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
