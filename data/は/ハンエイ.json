      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "reflection (of light)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鏡の反映で景色が美しく見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "水面の反映は風で揺らいでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "白い壁の反映により室内が明るくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "一般社会人の悲しみは、常にそれ自ら僕等の心に反映してゐる悲しみなのだ。",
              "citation": {
                "source": "流行歌曲について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの現実の社会的陰鬱性を、此等の流行唄がよく反映してゐるのである。",
              "citation": {
                "source": "流行歌曲について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体、温泉などといふものは、周囲が極めて閑寂であるから、之れと反映するために、生活の気分を華やかにする必要がある。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "順つてそれが周囲に対して特異な気分を反映するほど、さうした場所の印象と魅惑を深くする。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（言ふ迄もなく、それは調和ある反映である。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑陰に白のベンチを配合するといつた反映である。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑蔭に於ける白のベンチ、野景に於ける女のパラソル等も、またこの意味でのよい人工的反映である。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "学者で同時に政治家らしいペンク教授の人柄がやはり反映しているような気もした。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝は日を受けて柔和な桃色を潮し、昼は冴えた空に反映して、燧石のようにキラキラ晃めき、そのあまりに純白なるために、傍で見ると空線に近い大気を黒くさせて、眼を痛くすることがある。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝日を反映さする金茶色の唐松と、輝やく紅葉――そのくせ、もう枯れ枯れに萎び返って、葉の尖はインキを注したように、黒くなって、縮れている――で、夏ならば緑一色のちょんぼりした林が、今朝は二、三倍も広くなったような気がする。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの映画「影なき男」に現われた夫婦愛のソフィスティケーションの中にわれわれは江戸っ子の粋の反映のようなものを認めることはできないであろうか。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は、さうした女の気持ちの反映を直ぐに直覚しました、と同時に三年前の自分の記憶に残つて居た女とは似もつかぬ、やつれて老いた女の俤を一目見て、あらゆる歓喜と期待の心が打ち破られました。",
              "citation": {
                "source": "恋愛といふもの",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、やがて可憐な精神病患者が遊歩するのを認めて一種｜奇嬌な美の反映をその満庭の桜から受け始めました。",
              "citation": {
                "source": "病房にたわむ花",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば、esprit という意味はフランス国民の性情と歴史全体とを反映している。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "意識現象としての存在様態である「いき」のうちには、江戸文化の道徳的理想が鮮やかに反映されている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "このチキンライスの話と輪飾りの話には現代思潮の反映がある。",
              "citation": {
                "source": "雑記帳より（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほぼ同年頃の吾等の子供等と比べると眉宇の間にどことなしに浮世の波の反映らしいものがある。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはまた所知者が能知者を反映する事によって可能である。",
              "citation": {
                "source": "文学の中の科学的要素",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "能知者と所知者の結合を包括する全体が更に大きな普遍的で絶対的な能知を反映する事によって芸術たる価値が定まると考える事が出来るだろう。",
              "citation": {
                "source": "文学の中の科学的要素",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かように、仮名遣は音の時代的変化と関係があり、同音の仮名が正しく使いわけられているのは、もとはその表わす音に区別があったことを反映しているのが普通の例であります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし一人の科学者の仕事が如何にその人の人格と環境とを鮮明に反映するかを示す好適例の一つを吾々はこのレーリー卿に見るのである。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人に読ませるための創作意識の最も稀薄な俳句において比較的自然な心持が反映しているのであろう。",
              "citation": {
                "source": "夏目先生の俳句と漢詩",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "短い言葉にも社会が反映しており、思想がこもっている。",
              "citation": {
                "source": "気まま者の日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "汚れた手拭の上へ載せて見たりマントの上へあてがつて見たりして色の反映を量つたり、またこんなことを思つたり、　――つまりは此の重さなんだな。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（年老いた「歎きの女」が若い死者を案内するところの「歎きの國」は、はつきり埃及として考へられるべきではなくして、單に死の意識の沙漠のごとき明るみのなかへのナイル地方の反映として考へられるべきでありますが。",
              "citation": {
                "source": "ドゥイノ悲歌",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　裏街を行く車窓にメインストリートの上層の華美な電飾が反映していた。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "reflection (of society, attitudes, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
