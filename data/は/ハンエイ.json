[
  {
    "uuid": "b9dbaee8-a918-5c5d-b533-e1995d4c677f",
    "entry": "半影",
    "reading": {
      "primary": "はんえい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "penumbra",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "月食の最初の段階では半影が見え始めるが、肉眼ではほとんど気づかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "地球が太陽の光を遮るとき、半影は月の周辺部に現れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "日食の予測では半影の通過時間も正確に計算される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "千鳥の帆走空氣の笛を吹けよ、若者ら爽涼たる寶石いろの砂原をあちこちと帆走する千鳥を喜びながらあの色のよい形と聲の朝の半影を身にうつし、影を射つて海青いろの波濤と岩とのこのわびしい清らかな場所を遊星の羽のやうに耀やかしめよ。",
              "citation": {
                "source": "季節の馬車",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると立派な風采で、半影まことに非凡である。",
              "citation": {
                "source": "しゃもじ（杓子）",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [
