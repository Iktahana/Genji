  {
    "uuid": "bc0ff1e1-7026-5e89-8e24-a24803c38791",
    "entry": "反映",
    "reading": {
      "primary": "はんえい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞",
