        "examples": {
          "standard": [
            {
              "text": "交通量の多い道路沿いを歩いていると、車の排ガスの匂いが鼻につく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最新のディーゼル車は、排ガスをクリーンにする技術が飛躍的に進化している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "トンネルの中は排ガスが充満しやすいため、大型の換気設備が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "トラックは、地響きと共に、ぼくに排ガスと風圧の渦巻きを浴びせ、走り去った。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
