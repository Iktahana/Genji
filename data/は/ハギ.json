        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏休みに家族で山口県の萩へ行き、武家屋敷の街並みを散策した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "萩は幕末の志士たちを多く輩出した、歴史ある城下町だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "萩の特産品である夏みかんを使ったお菓子をお土産に買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
