  {
    "uuid": "095c0275-1a35-5383-9762-a0cc4de63672",
    "entry": "接ぎ",
    "reading": {
      "primary": "はぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "けっして竹に木を接ぎ、木に竹を接ぐような少しも成長しない価値のない生涯ではないと思います。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "母はそれでわが子の骨を冥府の河底から一つ／＼拾い上げ、河原の小石の上で根気よく接ぎ合せました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが子の姿に似た形に骨は接ぎ合さりました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "又惡木に良樹の穗を接ぎて、美果を實らしめんとするのも植福である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が一つの事実と他の事実とを接ぎあわせたとき、あるおぼろげな観念は浮かんで来たけれども、その結論はやはりまとまらないのであった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "海凪ぎぬ、朝ぼらけ潮もかなひぬ、艫舳接ぎ、大御船、御船出今ぞ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "海凪ぎぬ、朝ぼらけ潮もかなひぬ、艪舳接ぎ、大御船、御船出今ぞ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも接ぎ合わせて物にしなければならない義務を心得た文学者だからである。",
              "citation": {
                "source": "元日",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "恰も金を接ぎ合せた様に寸分の隙間なく寄せてくる。",
              "citation": {
                "source": "『煤煙』の序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "※びた鉄瓶、焼き接ぎの痕のある皿なんぞが、それぞれの生涯のruineを語る。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "※びた鉄瓶、焼き接ぎの痕のある皿なんぞが、それぞれの生涯の ruine を語る。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「枝ぶり悪き桜木は、切って接ぎ木をいたさねば、太宰の家が立ちませぬ。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「枝ぶり悪き桜木は、切って接ぎ木をいたさねば、太宰の家が立ちませぬ」と、定高は凛とした声でいい放つ。",
              "citation": {
                "source": "島原の夢",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただこの象牙と竹を接ぎ合わした札を二三枚貰って来たかった。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "御神さんは余を二つ接ぎ合せたように肥えている。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "半分本当の懺悔をし、それにうその懺悔を接ぎたそうと思った。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "只戦争に行つたので、首と左の足とは焼接ぎで直してある。",
              "citation": {
                "source": "クサンチス",
                "author": "XANTHIS",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の明方に、白粉で粧つた、綺麗な首が接ぎ目からころりと落ちた。",
              "citation": {
                "source": "クサンチス",
                "author": "XANTHIS",
                "note": "青空文庫"
              }
            },
            {
              "text": "成る程｜重心板の下端部の、鉛と木材の接ぎ目の附近に、薄く引っこすったように柔かな粘土が着いている。",
              "citation": {
                "source": "死の快走船",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "張つて麩糊を引いてゐるのは、文吾の單衣になる、繼ぎ接ぎだらけの大和木綿であつた。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の途端、四角い穴は元の壁なりに塞がつて、接ぎ目も分らぬ暗黒になつてしまつた。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分もこのまゝで、運命の繩をつかみそこねたら、襤褸を接ぎあはせて着なければならぬのだ。",
              "citation": {
                "source": "雨",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の脚のすぐそばには、菜葉服の工夫が三人ほど、社長の足が飛んでくるのをヒヤヒヤ気にしながら、しきりとなにか針金を床下から引張りだして接ぎ合わせていた。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この柿色の風船のように、半端な色花びらを接ぎ合わせたものは外にない筈だ。",
              "citation": {
                "source": "柿色の紙風船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "首のうしろにつづいているのは、男枕を二つ接ぎあわせたようなブカブカした肉魂。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり甚平を呼びよせた室には額の裏かなんかにマイクロフォンを置き、それから出た二本の電線をラジオの発振機に接ぎそれから更に電話線に持っていって接ぐ。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると高周波の電流は電話線を伝わって走るから、そこで大隅学士の宿の前を走る電話線から別に二本の支線を接ぎ、それを学士の室まで引張り込んでラジオ受信機に入れてやれば、それで甚平の話はすっかり聞えるわけだった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
