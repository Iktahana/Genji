        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼等も矢張り水火の苦難を潜って来たのである。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スクリーンの長方形の格好もほぼあのガラス張り水槽と同じである。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてまた春は即ち張るであって、木の芽も草の芽もみな張り膨らんで、万物｜尽く内より外に張り水も四沢に満ちる程である。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢張り水の潜んで流れて行くやうな女性的の力といふものも、それは決して別の力ではなくて、本當の力の本質である。",
              "citation": {
                "source": "人間の本性",
                "author": "片上伸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
