        "examples": {
          "standard": [
            {
              "text": "熱帯の海に潜ると、鮮やかな縞模様を持つハコベラが岩場を泳いでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "釣り上げたハコベラの鱗が、南国の太陽の光を浴びてキラキラと輝いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "図鑑で調べると、この五色の筋がある魚はハコベラという名前だと分かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ハコベラ　ハコベラはナデシコ科のハコベである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このハコベラはこの草の昔の称えであるが今でも稀れにこの古名をそのまま呼んでいる地方もある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿波の祖谷山ではホウベラ、春の七草の一つのハコベラが、この草であったことが想像せられる。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
