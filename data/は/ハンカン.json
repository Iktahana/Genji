[
  {
    "uuid": "a8a32bf5-ca8d-58df-8c72-5c37ea7b89ea",
    "entry": "反感",
    "reading": {
      "primary": "はんかん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
