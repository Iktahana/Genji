        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると、翌日の夜、楢雄から速達が来て「俺ハ世間カラキラハレタ人間ダカラ、世間カラキラハレタレプラ療養所デ働ク決心ヲシタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤならイヤぢやとハツキリいふべし、もうホレタハレタではない（彼女に）。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民自由ノ人權ハ生産的活動ノ自由ニ於テ表ハレタル者ニツキテ特ニ保護助長スベキ者ナリト云フモ其四。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人ハ惡用スベキ大資本ヲ奪ハレタルガ故ニ國家ノ物價調節ニ反抗シテ買占メ賣惜ミ等ヲナスコト能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵式體操ヲ廢止スル所以ハ、其形式亦實ニ丹田ノ充實ヲ忘レタル外形的整頓ニ捉ハレタルニ依ルモ一理由ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人ト五人ト角力シテ已ニ三人ヲ倒シタル者ガ他ノ二人ヨリ足ヲ奪ハレタルヲ見テ其ノ人ヲ弱者ナリト云フ能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ津浦鐵道ガ南北ニ分割サレテ列車ヲ直通スル能ハズ、南段ノ英資ニ對シテ北段ノ獨資ナルハ先ヅ投資的分割ニ現ハレタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ「ヴェルサイユ」ニ救ハレタル同盟ノ誼ニヨリテ英國ノ支那本部併合ニ報謝スベシト云フカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコカラ　アラハレタカ、ホースノ　ミヅガ　イタベイニ　トンデキマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな時にどんな返事をしてよいのやら、まともな返事はバカみたいだし、はぐらかしてもバカみたいだし、私はまったくこうなると、幼稚園の生徒みたいで、「だって、私は、惚れたハレタ、そのことしかほかに一生まともなことを知らないような奴ですもの、ようやくホットしたようなものですよ。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "文士だの女優だの、ホレタ、ハレタ、イヤらしい。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オクゲ様が乞食するというこの節に芸者遊びだなんて、きいた風なことをしやがって、惚れたハレタが、きいて呆れらア。",
              "citation": {
                "source": "出家物語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ニテ聞ケバ、柴田方ノ戸波隼人トテ由々シキ豪ノ者ナリシ由ニテ、其時ノ一番槍トモ称ハレタレ　と清正自身が噺していることになっている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
