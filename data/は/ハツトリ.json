        "examples": {
          "standard": [
            {
              "text": "元旦の朝、初鶏の声が響き渡り、新年を迎えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の日本では、初鶏の声で一年の始まりを感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "静かな山奥で、初鶏の鳴き声が厳かに聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "初鶏や動きそめたる山かづら昭和六年十一月十四日　新聞｜聯合特信部の依頼。",
              "citation": {
                "source": "五百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『万葉』七に「にはつとりかけのたりをのみたれ尾の、長き心も思はさるかも」。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
