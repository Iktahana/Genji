  {
    "uuid": "d8ab1eb6-2931-5cb0-9130-5cb6874df763",
    "entry": "波上",
    "reading": {
      "primary": "はじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
