    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一波上るわ、足許へ。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し然なくば隱見出沒、氣長く我船の後を追ふ内、本船が何時か海水淺き島嶼の附近か、底に大海礁の横る波上にでも差懸かつた時、風の如く來り、雲の如く現はれ出でゝ、一｜撃の下に其處に我が船を撃沈する積かも知れぬ。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」の號令は響いて、第一の端艇は波上に降下つた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一端艇の波上に浮ぶや否なや、忽ち數百の人は、雪崩の如く其處へ崩れかゝつた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "泡立つ波、逆卷く潮、一時は狂瀾千尋の底に卷込まれたが、稍暫して再び海面に浮上つた時は黒暗々たる波上には六千四百｜噸の弦月丸は影も形もなく、其處此處には救助を求むる聲たえ／″＼に聽ゆるのみ、私は幸に浮標を失はで、日出雄少年をば右手にシカと抱いて居つた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪の江丸とは、例の反古新聞に記されて居つた名で、はじめ、大佐の一行を此島へ搭せて來た一大帆前船、あゝ、あの船も、今は何かの理由で、此海岸にあらずなつたかと、私は窓の硝子越しに海面を眺めると、星影淡き波上には、一二｜艘淋し氣に泛んで居る小端艇の他には、此大海原を渡るとも見ゆべき一艘の船もなかつた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰でも左樣だが、非常にの硝子越しに海上を眺めると、電光艇は星の光を浴びて悠然と波上に浮んで居る、あゝ此艇もかく竣成した以上は、今から一週間か、十｜日以内には、萬端の凖備を終つて、此島を出發する事が出來るであらう。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "此島を出發したらもう締たものだ、一時間百海里前後の大速力は、印度洋を横切り、支那海を※ぎ、懷かしき日本海の波上より、仰いで芙蓉の峰を拜する事も遠い事ではあるまい。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "加ふるに橄欖島の附近には、始終有名なる海賊船が横行し、また屡々、歐洲諸國の軍艦も巡航して來ますから、其邊に我が海底戰鬪艇が機關の活動を失つて、空しく波上に漾つて居るのは無謀此上もない事です。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "』といひかけ、頷づく私の顏を打守りて、屹と面を改ため『實は先刻貴君等が不思議にも大輕氣球と共に此印度洋の波上に落下したと聞いた時から、私は心に或想像を描いて居るのです。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "海蛇丸は最早叶はじとや思ひけん、旗を卷き、黒煙團々橄欖島の方向へ逃げて行くを、海底戰鬪艇今は波に沈む迄もなく、奔龍の如くに波上を追ふ、本艦鳴を靜むる十｜秒二十｜秒。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "月は中天にありて一条の金蛇波上に馳する処、ただ見る十数｜艘の漁船あり。",
              "citation": {
                "source": "金時計",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大森林の木魂を驚した響きはやがて入江の波上に鳴り渡り、曉天數里の郡内に傳はつた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "既にして波上の鳥と波底の魚と、一齊に鎭まり、鷲の翼の水面を掩ふこと蓮葉の如くなりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手なる岸の全景は、空想のセミラミスや築き起しゝ、唯だ是れ一大｜苑囿の波上に浮べる如くなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "加えて波上の炎々たる水雷火、その魚鱗火、連弾光、鵜舟の篝、遊覧船の万灯、提灯、手投げの白金光、五彩の変々たる点々光、流出柳箭、けだし参と信との花火芸術の最高を極め精を尽くし神を凝らしたものであった。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちの舟はまた櫓の音も緩く緩く波上に遊んでゆく、流れはもはや急ではない、大江の浩蕩とした漣である。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕等は波上にたゞよふ船の樣ではない、依然として立つて居る家の樣だ。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて竹本綾之助が現われ、住之助が出で、高坐の上は紅紫爛※、大阪｜上りとか阿波上りとかいろいろの名をつけて、四方からおびただしい女義太夫が東京に集まって来たのである。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへ人の偶然事のみとして雲煙看過するの事件も、仔細に観来れば奥底必ず不動の磐坐のあるありて、未だかの長汀波上の蜃気楼台の如からず。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "三界は波上の紋、一生は空裡の虹とかや。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "まどかなる、月は波上を照せども、　　この水底は常世暗。",
              "citation": {
                "source": "北村透谷詩集",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "萬里の波上、たゞ一痕の明月を見る。",
              "citation": {
                "source": "房州の一夏",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "中には幾んど全身を波上に露はせるもあり。",
              "citation": {
                "source": "北條より一ノ宮へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "前面の波上に潜望鏡の鼻が現われる。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "“――本日十六時、本監視哨船の前方一｜哩のところに於て、海面に波立つや、突然海面下より大型潜水艦とおぼしき艦艇現われ艦首を波上より高く空に向けたと見たる刹那、該艦の両舷より、するすると金色の翼が伸び、瞬時にして爆音を発すると共に、空中に舞上りたり。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "掣掣波上、二月有餘。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "海がしずかなときには、ガラスのようにたいらな波上を、いっぱいに帆を張って走るほど、愉快なものはない。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "有明の室に十六夜ほどのまるい月が銀色の淡い光を波上に投げ、海上たひらかに爽快な暁の微風をのせて遠く明滅する青森港の美しい灯色をうつしてゐました。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
