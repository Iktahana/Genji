[
  {
    "uuid": "b3657813-596c-5aad-be8b-bd4ed2ce2733",
    "entry": "鼻先",
    "reading": {
      "primary": "はなさき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
