          "literary": [
            {
              "text": "「女ノ人ニコンナ所ヲ触ラセルノハイヤダヨ」予ハワザトソウ云ッテヤッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハワザト空ットボケテイルノダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシ一人デ寝カシテ戴クワ、オ爺チャンハ佐々木サントオ休ミナサイヨ」「ナゼサ、一緒ニ寝テクレタッテイヽジャナイカ、東京デモ時々ソウシテクレテルジャナイカ」五子ニ聞カセルタメニ予ハワザト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハワザトコノニスル。",
              "citation": {
                "source": "鍵",
