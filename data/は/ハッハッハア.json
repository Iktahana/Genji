        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近づいて見ると――　ハッハッハア。",
              "citation": {
                "source": "インターナショナルとともに",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハアと笑って、ようし、やるぞ！",
              "citation": {
                "source": "新たなプロレタリア文学",
                "author": "――アレゴリーと諷刺――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッハッハッハッハア！",
              "citation": {
                "source": "決戦川中島　上杉謙信の巻",
                "author": "――越後守安吾将軍の奮戦記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあげくには音をたてて、「ハッハッハッハッハア」　バカのようにトメドなく笑いだしてしまったのである。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　五忘にこう云われて、ベク助は苦い顔をした。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と、又してもチクリとやられたが、何を小癪なと、もうベク助は相手にならないことにしていた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と虎之介は大きな両腕でヘコ帯の前を抑え、肩をゆすって呵々大笑した。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　それから三日目。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と虎之介がからかったが、「そうなんですよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "グズ弁が犯人で悪かったら、あんた、パンパン屋へ遊びにくるの、およしよ」「わるかったな」「ハッハッハア」　二人の会話はどうやらそこで終りをつげたようであった。",
              "citation": {
                "source": "都会の中の孤島",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と突拍子もない笑い声をつけ加えました。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで仕方なく二人は顔を見合わせて、ハッハッハアと笑い合ったのですが、外国の諺に、最後に笑うものがもっともよく笑う、というのがあるそうですねえ。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
