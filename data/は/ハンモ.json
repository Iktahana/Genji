[
  {
    "uuid": "e63705ae-018f-5ebe-93ac-9cf378639781",
    "entry": "繁茂",
    "reading": {
      "primary": "はんも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
