        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "flourishing (of plants)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長雨の後、庭の雑草が驚くほど繁茂して、手入れが大変だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ジャングルでは、熱帯植物が生命力に満ち溢れて繁茂している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "誰も手入れをしていない廃墟には、蔦が壁一面に繁茂していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "眉毛は太く短くまっ黒で、おどおどした両の小さい眼を被いかくすほどもじゃもじゃ繁茂していやがる。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "草はいくら食ってもとても食い切れそうもないほど青々と繁茂しているのである。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の家屋が木造を主として発達した第一の理由はもちろん至るところに繁茂した良材の得やすいためであろう、そうして頻繁な地震や台風の襲来に耐えるために平家造りか、せいぜい二階建てが限度となったものであろう。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "事によると、昔のある時代に繁茂していた植物のコロニーが、ある年の大噴火で死滅し、その上に一メートルほどの降砂が堆積した後に、再び植物の移住定着が始まり、その後は無事で今日に到ったのではないかという気がする。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏は、青々とした雑草が、勝手きまゝにそこに繁茂した。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒された土地には依然として雑草が繁茂し、秋には、草は枯れ、そこは灰色に朽ち腐った。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この小さな、緑色に繁茂り栄えた島の中には、稀に居る大きな蟻のほかに、私たちを憂患す禽、獣、昆虫は一匹も居ませんでした。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ折々聞るものは豌豆の莢が熱い日に彈けて豆の飛ぶ音か、草間の泉の私語やうな音、それでなくば食ひ飽た鳥が繁茂の中で物疎さうに羽搏をする羽音ばかり。",
              "citation": {
                "source": "怠惰屋の弟子入り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」四十二「三枝、五枝、裏掻いてその繁茂が透くに連れて、段々、欄干の女の胸が出て、帯が出て、寝着姿が見えて、頬が見えて、鼻筋の通る、瞳が澄んで、眉が、はっきりとなる。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "またそのむらがる枝の葉かげに　ぞくぞくと繁茂するところの植物およそ　しだ　わらび　ぜんまい　もうせんごけの類地べたいちめんに重なりあつて這ひまはるそれら青いものの生命それら青いもののさかんな生活。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　氏の笑い声が、はたはたと、八月の海岸地の繁茂する野菜畑に響き渡った。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉毛は太く短くまつ黒で、おどおどした兩の小さい眼を被ひかくすほどもじやもじや繁茂してゐやがる。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界の生物の生々の力が衰へないで、繁茂し孳息する間は、張る氣の運の世界なのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれだけに育つた木々だから、何とかしたらば繁茂をつゞけられるのだらうが、二十世紀的、資本的、ドシ／＼バタ／＼的に無遠慮に採鑛精煉の事業をやられては、自然も破壞｜潰裂させられるのを如何ともし難い。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍に一｜本、榎を植ゆ、年經る大樹鬱蒼と繁茂りて、晝も梟の威を扶けて鴉に塒を貸さず、夜陰人靜まりて一陣の風枝を拂へば、愁然たる聲ありておうおうと唸くが如し。",
              "citation": {
                "source": "蛇くひ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　門、背戸の清き流、軒に高き二本柳、――其の青柳の葉の繁茂――こゝに彳み、あの背戸に團扇を持つた、其の姿が思はれます。",
              "citation": {
                "source": "雪靈記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "畳翠滋蔓繁茂せる、竹と竹との隙間を行くは、篠突く雨の間を潜りて濡れまじとするの難きに肖たり。",
              "citation": {
                "source": "妖怪年代記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "震災前、即ち改築前の大學の庭には此草が毎年繁茂して、五月なかばには紅緑の粒を雜へた可憐な花の穗が夕映のくさむらに目立つた。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが二十前年頃までは、誰が植ゑたのか、ひとりでに生えたのか、葉の長い石菖が繁茂してゐた。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の流の一方にさはさはと、其すかんぽの一群が繁茂してゐたのである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　門、背戸の清き流、軒に高き二本柳、――その青柳の葉の繁茂――ここに彳み、あの背戸に団扇を持った、その姿が思われます。",
              "citation": {
                "source": "雪霊記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その邑に入れば民家の牆屋は完備し樹木は繁茂している。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ私は今、眼前に、炎熱と颱風と地震との幾世紀の後、尚熱帶植物の繁茂の下に埋め盡されもせずに其の謎の樣な存在を主張してゐる巨石の堆積を見、又一方、巨石の運搬どころか極く簡單な農耕技術さへ知らぬ・低級な現住民の存在を知つてゐるだけである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ私は今、眼前に、炎熱と颱風と地震との幾世紀の後、なお熱帯植物の繁茂の下に埋め尽されもせずにその謎のような存在を主張している巨石の堆積を見、また一方、巨石の運搬どころかごく簡単な農耕技術さえ知らぬ・低級な現住民の存在を知っているだけである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こは彼妙音の女怪のすみかにして、草木繁茂せるカプリの島は唯だこれを蓋へる屋上たるに過ぎざるにやあらん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫟や楢や其他の雜木は蛙が鳴けば鳴く程さうしてそれが鳴き止む季節までは幾らでも繁茂することを繼續しようとする。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛や馬でも地上に軟かな草の繁茂する季節が來れば自然に乾草や藁を厭ふやうになる。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "雜木林の繁茂した間の、もう硬く成つた草の中へ蜀黍の穗は縛つた儘どさりと置いてあつたのである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "土手の内側は水際から篠が一｜杯に繁茂して夜目にはそれがごつしやりと自分を壓して見える。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬て見れば彼等は狹いとはいひながら跳ては越せぬ堀を隔てゝ、然かも繁茂した野茨や川楊に身を沒しつゝ女の軟かい手を執らうとするのである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
