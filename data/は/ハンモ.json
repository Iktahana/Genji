  {
    "uuid": "c761bb02-33a7-51dd-8572-9a66b0e14a3b",
    "entry": "ハンモ",
    "reading": {
      "primary": "はんも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――しかしやがてイスポリの燈台を離れて、エルアルズのコーカサスの山脈が静かに黒海に映るころになって、トレビゾンドの赤土のプラットホームに女実業家達が下車すると夜は神秘に地球はハンモックのなかで眠りだすのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻は労働者のように終日こつこつと働いて食うし、蜘蛛は資本家のように、暑い夏の日を、梢から枝へとハンモックを釣って、その上に寝ていて食っている。",
              "citation": {
                "source": "首を失った蜻蛉",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑いので障子を兩方とも明け放ち、時には、縁がはの柱と柱とにハンモクを結び付けて、その上にからだをぶら付かせることもある。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、渠はそんなことには頓着なしで、「ハンモク」と云ふ可なり世間の注目を引いた散文詩を作つた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下　の　柱と　柱とに　ゆはへて　低く　釣るした　ハンモク　の　中で、　僕は　たわいもない　からだ　を　たわいもなく　横たへた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "前世界　から　生活に　疲れて　來た　からだが、　ハンモク　の　中で　搖られて　ゐる　樣だ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンモクは　實に　不安な　住まひだ、　ぶら／＼　動く　たんびに、　僕の　胸は　息詰る　思ひ！",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　男『フンフン、御前ハンモ行タケスカ。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "三吉は、南の窓に近く、ハンモックを釣った。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ベツドは、ハンモツク？",
              "citation": {
                "source": "山を越えて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "樽野は其処の椿の枝から肉桂の幹にハンモツクを釣り放しにして置いた。",
              "citation": {
                "source": "籔のほとり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁に添ってハンモックが釣るされてあったが、そこには、人間が寝ていずに、和蘭あたりの船長でも着そうな、洋服が丸めて置いてあった。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "玩具箱がひつくりかへつてゐたし、ハンモックも吊つたなりだつた。",
              "citation": {
                "source": "濡れた葦",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "廣太郎は、ハンモックの中へ、帽子や土産物を投げいれて、臺所に二本並んでゐるビールを座敷へ持つて來て、一人で栓をぬいてごくごく飮んだ。",
              "citation": {
                "source": "濡れた葦",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋はハンモックのやうに揺れた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人が舟へ飛び乘ると、屋根つきの細長い船はしばらくハンモックのやうに左右にゆれ動いた。",
              "citation": {
                "source": "ボルネオ　ダイヤ",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはハンモックじゃないですか」「そう。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれ軍人のベッドはハンモックでたくさんだ」　そういうと、少佐はハンモックをかついで三階へあがっていった。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンモックだったのか」　源一はアメリカ軍人の簡易生活におどろきながら、少佐のハンモック吊りを手つだった。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "対角線にハンモックを吊った。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その少佐は三階へハンモックをもちこんで、はすかいにつった。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは鳥のように高い空をとぶこともできるし、ハンモックもないのに空中で昼寝をすることができますわ。",
