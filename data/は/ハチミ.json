    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「霧もいいですね」　ハチミがなかば叫んだ。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、クラスの仲の良い仲間たちは誰もが、彼女をハチミと呼んでいた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも」　ナナエがハチミとリカのふたりに言った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハチミとナナエとトモには、絶対に見ててほしい」「見ます。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤霧リカの最後」　ハチミが言った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお本日、関東甲信越地方のとある一角で、午後三時十五分頃、赤い霧がさっと流れて消えるという、不思議な現象がありました」「それは賛成」「霧の色は赤なのね」　トモの質問に、「リカには赤がいちばん似合う色だから」　とハチミが答えた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "掘りごたつのテーブルをはさんで、ナナエのむかい側にハチミがいた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハチミからふと視線をはずして窓を見たナナエは、窓の外に降りはじめている雪を見た。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "手ですくってあげて、指先で触れて、ハチミ、ハチミと、名を呼んであげる」「いいわ、それ。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも私は雪だから、返事は出来ないね」　ハチミが言った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「丸めて球にして、みんなで雪合戦をしましょう」「当たるとハチミのほうが痛いよ」　ハチミの自宅の二階にある五つの部屋のうちのひとつに、この四人の少女たちはいた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　トモがハチミにきいた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハチミは首を振った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「色はつきません」「どの雪がハチミなのか、わからないわ。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしましょう」「いいのよ、わからなくても」「どれがハチミかしらと、私たちは捜すのに苦労するね、きっと」「これだと思えば、それが私なのよ」「降る場所をきめておいて」「それは便利でいいね」「みんなの家の庭に降ろう」「時間をきめておかないと」「そうだね」「その時間に雪が降るのを、私たちは待ってるのね？",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "イメージ先行」「駄目か」「それに、花は気持ち悪いです」「花が不気味なときって、確かにあるからね」「私の家の庭にある池に降るといいかもしれない」「鯉がいますね」「池の水の上に、雪の結晶がひとつ、はらりと落ちてそれでおしまい」　ハチミの言葉にナナエは首をかしげた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階でこたつに入るとすぐに、ハチミの母親が汁粉を持って来た。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「リカとハチミとトモが、桟橋から別のボートで来てくれて、私のボートを桟橋まで引いていってくれます。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハチミは、ほかの三人への年賀状に書いた自分の名前のあとに、『早く死に隊のメンバー』などと書いたりする。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハチミとトモは、正月の休みのあいだ外国に出ていて留守だった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハチミとトモが外国から帰って、三人は集まった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「嘘です、それは絶対に嘘」　ナナエが死んだということを、ハチミは信じなかった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルで食べた正月の雑煮の餅を喉に詰まらせた、という直接の死因をリカからきかされて、ハチミは笑っていた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんは悲しみます」「さっき私は電話をしたよ」　ハチミはそう言い、リカとトモは悲鳴を上げた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「化粧品」「ナナエは、もうどこにもいないのよ」「嘘だね」「初七日が三日まえで、私はお墓へもいって来たのだから」　リカがハチミとトモに言った。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しいです」　ハチミとトモはしばらく黙っていた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ハチミの質問に、リカはうなずいた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッフル・コートのフードをハチミは両手で押さえ、リカは髪を風になびかせながらダウン・ジャケットの襟のなかに首をすくめていた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
