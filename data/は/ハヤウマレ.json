    "definitions": [
      {
        "index": 1,
        "gloss": "being born between January 1 and April 1 (school entrance date)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "四月生まれの同級生に比べると、早生まれの彼はまだ少し幼い印象がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「二月生まれの早生まれだから、免許を取れるのがみんなより遅いんだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "早生まれの子は、体力面での不利を補うために人一倍努力する傾向があるという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "月見草の花が咲いていて、早生まれの松虫が鳴いていた。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　豹一は早生れだから、七つで尋常一年生になった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "早生れの安子は七つで小学校に入ったが、安子は色が白く鼻筋がツンと通り口許は下唇が少し突き出たまま緊り、眼許のいくらか上り気味なのも難にならないくらいの器量よしだったから、三年生になると、もう男の子が眼をつけた。",
              "citation": {
                "source": "妖婦",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき豹一は七つ、早生れの、尋常一年生であった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　豹一は早生れだから、七つで尋常一年生になった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "早生れの二年生であったから、十六になっていなかった。",
              "citation": {
                "source": "図書館",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそ生れと早生れの二つ違いである姉弟の顔だちは、そうやって一つ灯の下に並んだところを見ると、その間におのずから微妙な違いがあった。",
              "citation": {
                "source": "雑沓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつれて、咲二も体が弱いから、ちょうど早生れなのを幸い、来年の四月頃まで、一緒に田舎で、のんきにさせて置いた方が好かろうということになった。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伜の彌太郎にも逢つて見ましたが、早生れでも六つの子供では、何を聞いても要領を得ず、これは證人のうちにも入りません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "恋をせぬ女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お母ちやん、――坊は川へ突き落されたんだよ、ひとりで落ちたんぢやないよ――」　四つの早生れで、幸三郎は賢い子でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "受難の通人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お母ちゃん、――坊は川へ突き落されたんだよ、ひとりで落ちたんじゃないよ――」　四つの早生れで、幸三郎は賢い子でした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "受難の通人",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の方が早生れだ」「そんな遠慮はよしてくれ給え。",
              "citation": {
                "source": "村一番早慶戦",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟は数え年の八つで、早生れだったので、学校は二年生であった。",
              "citation": {
                "source": "生い立ちの記",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
