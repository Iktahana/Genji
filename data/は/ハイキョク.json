        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのうちには、どんな敗局にも勝機が勃々と動いて来ることがあるのである。",
              "citation": {
                "source": "将棋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "余りに、くやしかつたので敗局の盤面を今でも思ひ出す位である。",
              "citation": {
                "source": "世に出る前後",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "この敗局は、彼のために、よい教訓であったと思う。",
              "citation": {
                "source": "呉清源",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
