        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それからもう直ぐ畑道だ、蛙が鳴いてゐる。",
              "citation": {
                "source": "散歩生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう青葉だなどと話しながら、畑道のあいだを縫って大宮八幡の門前へ辿り着くまでに、二人は途中の百姓家で幾たびか道を訊いた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "正雪の絵馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女等はそれを避けて畑道へそれた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水を入れたタンクを背負つて傾斜した畑道を行く、押しひしがれたやうな駒平の姿が特になまなましかつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜など、ひとり畑道を歸つて來て、そこの雜木林や、あそこの岡の下あたりに、二三軒づつかたまつてゐる農家を見、そのなかに營まれてゐる生活を思ふとき、駿介はいつとはなしに涙ぐんだ。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事を終へて彼が畑道の方へ戻つて來ると、傾斜した道のずつと下の方から、彼を呼ぶ聲が聞えた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして新しい一筋の手拭ひをもらつて、菜の花の咲く畑道の間を歸つて來た。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑道やうねり道こほろぎはこほろころ、やつこらさつさ、やつこらさ、やれ、蜻蛉が飛んだ、火が飛んだ。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑道に出て、ふりかえってみると、紅倫がせど口から顔を出して、さびしそうに少佐のほうを見つめていました。",
              "citation": {
                "source": "張紅倫",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は先生先生と呼びつづけながら、木立のあいだは勿論、草原や畑道をむやみに駈けまわったが、どこからも左内の返事は聞かれなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "ズウフラ怪談",
                "note": "青空文庫"
              }
            },
            {
              "text": "三里ほどは乗合馬車にゆられて行って、それからは畑道や森や岡を越えて、やはり三里ほども徒歩でゆくと、だんだんに山に近いところへ出ました。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこらの畑道には大きい四足の跡が残っていた。",
              "citation": {
                "source": "馬妖記",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は図々しく郊外の畑道を歩いた。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は次の朝四時頃、こゝへ來ることにして、そこから畑道に出て、家に歸つた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　　　　　　　　　＊　二人は、畑道に出た、源吉はこんなに澤山とれるとは思つてもゐなかつただけ、子供のやうに上機嫌でゐた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、身体をびッこに振りながら、片手に下駄を持って、畑道を走ってくる由三が見えた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "野を耕す農夫や、畑道に急ぐ娘や、濡れた帆を干して居る漁師の舟や、さういふものは総て絵のやうに平和で、そして美しいものであつた。",
              "citation": {
                "source": "春雨にぬれた旅",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑道を寄切つたり、だらだら坂を降つたり、橋を渡つたり――二人の家と家との隔りは相当の遠さであつたから、失敗の折には樽野は、若し途中で滝の家の者に出遇つても其処を訪れたと思はれたくない為に非常な速力で駆け出すので、漸く橋のあたりまで達すると胸を撫でゝ一休みするのが常だつた。",
              "citation": {
                "source": "籔のほとり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車を下りると、畑道が細くうねつて、絲のやうに願念寺へ續いてゐる。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち化かされるものは、狐が化るという事をどこかで信じているか疑っていてももし本当なら恐いという恐怖を割に持っているかどっちかの人であって、そういう人が山道とか、畑道とかを通る。",
              "citation": {
                "source": "ばけものばなし",
                "author": "岸田劉生",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸締りをして戸外へ出ると、二人は云いあわしたように胸を拡げて息をしながら、青麦のそろった畑道を歩いた。",
              "citation": {
                "source": "魚の序文",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "逢ふなり、孝次郎は父親にひつぱられるやうにして暗い畑道の方へ出て行つた。",
              "citation": {
                "source": "雨",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私をおどろかしたその老人は、村の入口の小川の曲り角とか、畑道で、ひよつくり出逢ふことがあつた。",
              "citation": {
                "source": "小さな村",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、ふと目をあげて、向こうにつづくひろびろとした畑道をながめたとき、彼は意外なものを見つけて、おもわず「あっ」とおどろきの声をあげた。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっ、あれはマリ子じゃないか」　二百メートル先の向こうの畑道を、二人の少年少女が、手をひいて歩いていく。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑道をかけくだってゆくと、郊外電車の踏切があった。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い畑道を歩きながら男に手をまかせ、ぎんは不安と臆病さからしょっちゅうどきどきしていた。",
              "citation": {
                "source": "鴻ノ巣女房",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "田のなかで草をとっていたお百姓たちは、馬方のかげも見えないのに、俵をつけた馬だけが、のこのこ、畑道をあるいて行くうしろ姿を、みんなふしぎそうに見送っていました。",
              "citation": {
                "source": "たにしの出世",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて又山門の外へ出て、畑道をゆき、薯掘りにかかったが、井汲さん親子一生懸命掘るわ掘るわ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
