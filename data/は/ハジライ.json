[
  {
    "uuid": "62986b78-5444-55d8-a261-2d20e405557d",
    "entry": "恥じらい",
    "reading": {
      "primary": "はじらい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
