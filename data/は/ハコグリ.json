          "standard": [],
          "literary": [
            {
              "text": "三度グリ、シバグリ、カチグリ、ハコグリ　諸国に往々三度グリと呼んでいるクリがあって、その土地の名高い名物となっていることがある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに珍らしいクリにハコグリ（箱グリの意）というのがあって、まれに見受けられる。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本草綱目啓蒙』栗の条下に「江州ニ一毬ニ七顆アルアリ、ハコグリト云毬ノ形四稜ニシテ闊シ」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このハコグリが今東京都練馬区東大泉町五百五十七番地なる私宅の庭に育っている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
