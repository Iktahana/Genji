        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敵の動きを監視するため、国境に兵士を貼り付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は新しいプロジェクトのため、しばらくの間、海外支社に貼り付けられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重要閣僚の警護のため、会場の四隅にSPを貼り付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
