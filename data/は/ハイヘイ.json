[
  {
    "uuid": "5c08294e-8bb5-5ce3-869f-7782967b8de7",
    "entry": "廃兵",
    "reading": {
      "primary": "はいへい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
