    "definitions": [
      {
        "index": 1,
        "gloss": "displaying prostitutes behind a grille",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代の遊廓では、華やかな張り見世が客を誘った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、歴史小説の中で張り見世の様子が詳細に描かれているのを読んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "現代社会では考えられないような、昔の張り見世の慣習に驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "十分のちには、清三の姿は張り見世にごてごてと白粉をつけて、赤いものずくめの衣服で飾りたてた女の格子の前に立っていた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ、気にいった女のいる張り見世の前は注意した。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "張り見世の女郎の眼がみんなこっちに注がれた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度は村の見知り越しの若者の横顔を張り見世の前でちらと見た。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前は何處に潜つて居たんだ」「あつしは北の國で、歌舞の菩薩の張り見世を一と廻り拜んで、向柳原へ歸つて寢てしまひましたよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "月待ち",
                "note": "青空文庫"
              }
            },
            {
              "text": "『矢張り見世物興行に関係していらっしゃいますか？",
              "citation": {
                "source": "髪の毛",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから直ぐ正燈寺へのして、刷毛序に仲町を覗きたいくらゐのもので」「馬鹿なことを言へ、御用をどうするんだ」「へツへツ、それは冗談ですが、近ごろ谷中にも張り見世が出來たといふ騷ぎですよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美少年國",
                "note": "青空文庫"
              }
            },
            {
              "text": "八五郎が谷中にも張り見世と言つたのは、この上もない適切な言葉で、お舟、お小夜、お玉の三人娘が、赤｜前垂の赤｜襷、それを片はづしに、貫入の入つたやうな厚化粧、此處を先途と、地獄の三丁目まで屆きさうな嬌聲を發するのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美少年國",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとはみんな、こうして店先に出ていて、ちょんちょん格子から客にのぞかせてじかに、よりどり見どりをさせる張り見世だったそうだが、それが禁止になって、本人代りの写真を並べるようになった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがさ、商売柄、ぴかぴかきらきらで、廓の張店を硝子張の、竜宮づくりで輝かそうていったのが、むかし六郷様の裏門へぶつかったほど、一棟、真暗じゃありませんか。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、驚かしちゃあ不可え、張店の遊女に時刻を聞くのと、十五日｜過に日をいうなあ、大の禁物だ。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハルミさん一昨年の夏とかに、避暑かたがた軽井沢へ美容院の出張店を出していたのよ。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の身内にあたるという出張店をあずかっている若い男が、お今のことでちょいちょい浅井を訪ねて来てから、浅井もおのずからその話に肩を入れないわけに行かなかった。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十九　仮にお今を迎えるための室の家が、出張店の人たちによって、じきに山の手の方に取り決められた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎から代りに出て来た室の親類の人たちや、出張店の店員などが、それに連なって居並んだ。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はロータスの出張店へ入つて行つた。",
              "citation": {
                "source": "競馬の日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の母の亡なつたのは、六月の七日で、村の若い衆たちが、娘のある家をつぎ／＼へ、張店を素見すやうにして歩き※るには、おひ／＼と好い時候であつた。",
              "citation": {
                "source": "父の婚禮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "里の市が流して行く笛の音が長く尻を引いて、張店にもやや雑談の途断れる時分となッた。",
              "citation": {
                "source": "今戸心中",
                "author": "広津柳浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "純然たる支那市場であって、昼は大道芸人などが出ていろいろの芸当をやり、むせ返る程に人出がし、雑沓するということであったが、夜の此処は、恰度東京に於ける玉ノ井のような最下等の支那娼婦の張店街を現出していた。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつそ、懐古趣味を発揮させようとするならば、うちかけを着せて張店を出すがよい。",
              "citation": {
                "source": "名古屋スケツチ",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "張店といへば、昨年一時そんな噂がひろがつて、政治問題とされたことがある。",
              "citation": {
                "source": "名古屋スケツチ",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者は公娼存置にも、張店にも賛成だけれど、遊郭そのものゝ改良は、早晩行ふべきだと思つてゐる。",
              "citation": {
                "source": "名古屋スケツチ",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは徳山の何かの店が出張店を出すためその弟家族をよびよせた由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉原｜大籬の遊女もボンネットをかぶり、十八世紀風のひだの多い洋服を着て椅子に凭りかかって張店をしたのを、見に連れてゆかれたのを、私はかすかに覚えている。",
              "citation": {
                "source": "勝川花菊の一生",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "トントン／＼と登るをすが籬のうちから見て、あゝ来て呉れたなと嬉しく飛立つようですが、他の張店している娼妓の手前もありますので、花里は知らぬ顔していても眼の早い朋輩が疾ッくに見附けていますから堪りません。",
              "citation": {
                "source": "根岸お行の松　因果塚の由来",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲の町にはビーヤホールが出来て、「秋信｜先通ず両行の燈影」というような町の眺めの調和が破られ、張店がなくなって五丁町は薄暗く、土手に人力車の数の少くなった事が際立って目についた。",
              "citation": {
                "source": "里の今昔",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲の町にはビーヤホールが出来て、「秋信先通ず両行の灯影」といふやうな町の眺めの調和が破られ、張店がなくなつて五丁町は薄暗く、土手に人力車の数の少くなつた事が際立つて目についた。",
              "citation": {
                "source": "里の今昔",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "里の市が流して行く笛の音が長く尻を引いて、張店にも稍｜雑談の途断れる時分となツた。",
              "citation": {
                "source": "里の今昔",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは若い女達が、其の雇主の命令に従って、其の顔と其の姿とを、或は店先、或は街上に曝すことを恥とも思わず、中には往々得意らしいのを見て、公娼の張店が復興したような思をなした。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸人づらの、高級ぶってダンサアしてるのは客引きの張店で人をも自分をもゴマカシているイヤらしさにも飽きました眉毛をもうすこし長く引き、口紅をもっと濃く塗ってチュインガムをクチャクチャかみながら鼻唄うたい気楽にただの普通のＰさんで世間の波に沈みます。",
              "citation": {
                "source": "殺意（ストリップショウ）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
