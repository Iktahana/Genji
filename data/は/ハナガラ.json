[
  {
    "uuid": "10555a7a-4df8-5b01-9997-827fff3eba8f",
    "entry": "花柄",
    "reading": {
      "primary": "はながら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "flower pattern",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は花柄のワンピースを着て、春らしい装いだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このカーテンは、部屋を明るく見せる花柄を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "花柄の食器は食卓を華やかにしてくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "酒があんなに湧きあがり波を立てたり渦になったり花弁をあふれて流れてもあのチュウリップの緑の花柄は一寸もゆらぎはしないのです。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一はそのひとり、花柄のプリントのワンピースを着た子の、頭のうしろでたばねた、長い、艶のある、豊かな髪の毛に見ほれた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "花柄のワンピースを着て、白い帽子をかぶり、脚をきちんとそろえて、すっと伸ばして坐っているすがたは、いちだんと大人びて見えた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "八つ手もその先きに蕾の丸い総をつけた花柄を伸した。",
              "citation": {
                "source": "日を愛しむ",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮やかなグリーンのラグビー・ショーツに、花柄の半袖シャツを、今日の彼女は着ていた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "花柄のなかにところどころあるきれいな緑色の葉が、キャロリンのグリーンの瞳に合わせてあった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙な花柄の、透けて見えるような薄い生地。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪をゆるやかにうしろへまとめ、花柄の大判のハンカチで束ねていた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "花柄のハンカチのこうした使いかたについて質問された草野三四郎は、「場面を支えて進展させていく論理というものがあって、その論理の整合ぶりを視覚的に見せる工夫のひとつが、たとえばこのハンカチだね」　と答えた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつも持っている、花柄のハンカチ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "花柄のハンカチで銭湯に入る女」「早い時間がいいね。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗い場や浴槽が、まだ昼間の光で明るい頃」「それは初夏から夏の終わりくらいまでだわ」「花柄のハンカチは湯に濡れて、肌に貼りついたりするのだから、夜ではないほうがいい」「なぜ？",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "花柄の大きなスカーフを巻きスカートみたいに腰に巻きつけて。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "花柄のハンカチを持っていた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　私はこはごはながら頷いた。",
              "citation": {
                "source": "阿片の味",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空にはながらく動かないでいる巨きな雲があった。",
              "citation": {
                "source": "蒼穹",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "養子の太兵衛という方はながらくお茶の商売屋に奉公していたので、その経験を生かそうとしたわけであります。",
              "citation": {
                "source": "あのころ",
                "author": "――幼ものがたり――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この硯はながらく私の側にあって、今でも私の絵の一助をつとめていますが、この硯をみるたびに中島先生のご恩をしみじみと感じるのであります。",
              "citation": {
                "source": "あのころ",
                "author": "――幼ものがたり――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
