        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もう、おひるすぎになって旗雲がみんな切れ切れに東へ飛んで行きました。",
              "citation": {
                "source": "よく利く薬とえらい薬",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲の旗の如く見ゆることは多し、旗雲といふ語は今無きやうなり。",
              "citation": {
                "source": "雲のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三章　御船出男声女声（独唱竝に合唱）その一日はのぼる、旗雲の豊の茜に、いざ御船出でませや、うまし美々津を。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その三日はのぼる、旗雲の照りの茜を、いざ御船、出でませや、明き日向を。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三章　御船出男聲女聲（獨唱竝に合唱）その一日はのぼる、旗雲の豐の茜に、いざ御船出でませや、うまし美々津を。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "海を越えたる百萬の大御軍の雄叫びは旗雲高くさしのぼる日にこそ勇めまのあたり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "享保十二年九月三日の夕方で、浅黄がやがて薄白く暮れかかる西の空に紅い旗雲が一つ流れて、気の早い三日月が何時の間にか白い小舟の影を浮べていた。",
              "citation": {
                "source": "黄八丈の小袖",
                "author": "岡本椅堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊けふは照日の映々と青葉｜高麦生ひ茂る大野が上に空高く靡びかひ浮ぶ旗雲よ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊けふは照日の映々と青葉高麦生ひ茂る大野が上に空高く靡びかひ浮ぶ旗雲よ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊けふは照日の映々と青葉高麥生ひ茂る大野が上に空高く靡びかひ浮ぶ旗雲よ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "わだつみの豐旗雲に入日さしこよひの月夜あきらけくこそ　此歌、題を逸す。",
              "citation": {
                "source": "萬葉集を讀む",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲が旗のやうに靡きたるを見て旗雲といふ熟語をこしらえ、それが大きいから豐といふ形容を添へて豐旗雲といふ熟語をこしらえたり。",
              "citation": {
                "source": "萬葉集を讀む",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "豐旗雲を只成語として見ず、古人が如何にして此熟語をこしらえしかを考へ、自己がある物を形容する時の造語法を悟るべし。",
              "citation": {
                "source": "萬葉集を讀む",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで勢ひ、反歌の中の「わたつみの豊旗雲」の歌は、同時の作でない様に考へられ易い。",
              "citation": {
                "source": "相聞の発達",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "○渡津海の豊旗雲に入日さし今夜の月夜清明けくこそ　〔巻一・一五〕　天智天皇　此歌は前の三山の歌の次にあるから、やはり中大兄の御歌（反歌）の一つに取れるが、左注に今案不似反歌也とあるから編輯当時既に三山の歌とすることは疑われていたものであろう。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「豊旗雲」は、「豊雲野神」、「豊葦原」、「豊秋津州」、「豊御酒」、「豊祝」などと同じく「豊」に特色があり、古代日本語の優秀を示している一つである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "万葉の歌には、「わたつみの豊旗雲に」の如き歌もあるが、またこういう切実な感傷の歌もある。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば第三句で、「引き結び」と云って置いて、「まさきくあらば」と続けているが、そのあいだに幾分の休止あること、「豊旗雲に入日さし」といって、「こよひの月夜」と続け、そのあいだに幾分の休止あるのと似ているごときである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう間に、士気いよいよ高い蜀の大軍は、※亭から川口にいたる広大な地域に、四十余ヵ所の陣屋と壕塁を築き、昼は旌旗雲と紛い、夜は篝火に天を焦がしていた。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
