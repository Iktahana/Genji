        "examples": {
          "standard": [
            {
              "text": "戦国時代の武士は、腹巻きを身につけて戦に臨んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "博物館で古い腹巻きが展示されており、興味深く見学した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この腹巻きは、体の動きを妨げないように工夫されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
