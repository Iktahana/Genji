        "examples": {
          "standard": [
            {
              "text": "当時は髪を日本髪に結わず、ハイカラな束髪にするのが最先端のファッションだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "おめかしして写真館に行くために、美容室でハイカラな髪型にセットしてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ハイカラに結った髪に大きなリボンをつけるのが、当時の女学生の定番スタイルだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
