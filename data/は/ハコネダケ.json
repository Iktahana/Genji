          "literary": [
            {
              "text": "また時々花を出すことある者はメダケ、ハコネダケ、カンチク、スズタケ、チマキザサ、ネマガリダケ等なり。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第五図　メダケに最も近き縁を有するものにはハコネダケあり。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "故にハコネダケと云う。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
