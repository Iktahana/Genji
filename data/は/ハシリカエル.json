        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "継母の目のなきひまに、姉上の潜に取りて、両手に堆く盛りてわが袂に入れたまいしが、袖の振あきたれば、喜び勇みて走り帰る道すがら大方は振り落して、食べむと思うに二ツ三ツよりぞ多からざりける。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "家へ走り帰ると直ぐ吉は、鏡台の抽出から油紙に包んだ剃刀を取り出して人目につかない小屋の中でそれを研いだ。",
              "citation": {
                "source": "笑われた子",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ、息せき切って帰って来た知らずのお絃……その話を聞くと、今夜、喬之助には内証で、右近が横地半九郎の家をおそったところが、源助町の道場から用心棒が来ていて、そのうえ、一人はすぐに、もっと援兵を呼びに芝へ走り帰るのを自分は、右近について行っていて見届けたから、その足で迎いに来たのだという。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "向こうの娘さんは雨の中を首をすくめて走り帰る。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしっ――すぐに立とう」　武田兄弟は、走り帰ると、にわかに兵をまとめ、駒に枚を銜ませて、味方にも気づかれぬように、富士川の真夜半を、粛々と岸に沿って上流へ移動しはじめた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
