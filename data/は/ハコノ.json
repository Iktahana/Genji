        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "青キ朝日ハコノトキニ、　　　　ケブリヲノボリユラメケバ、樹ハサウサウト燃エイデテ、　　カナシキマデニヒカリタツ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハコノ疑問ヲ抱イテ死ヌノダ※　俺ハ北畠ノ霊媒研究所ヘ行ツテ、十円出シテ霊媒シテ貰ツタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "只天寵ハコノ切開手術ニ於テ日本ノ健康體ナルコトニ在リトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今月ノ君ノ写真ハコノ前ノ君ニクラベルト見チガエルホド大キクナツタ、余モコノトホリ元気ダ、余ハ今年ノ夏ヲミシガントイフ湖ノソバデオクル。",
              "citation": {
                "source": "断唱",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十ハコノ次デス、アシタカラデス」「今日教えて下さい、そうしないと数が合わなくていけません」「デハ、教エテ上ゲルヨロシイ」といって、マドロスは黒板の上に、10を書いて、「テン」「テン――十はテンですか、棒と球ですね」　茂太郎の首には小さな石盤があります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "天候｜悪シクシテ風波ノ険甚シク、九週間ノ後漸クかつど岬ヘ達スルヲ得タレド、彼等ハコノ地ニ殖民ノ権利ヲ有セザリケレバ、更ニ南ニ航シテ進マントセリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボク　オキアガツテ　キヤラメルヲ　カゾヘテ　ハコノナカヘシマツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "団十郎ノ助六ハコノ時ガ最後デ、三十六年ニハ死ンデイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ時ノ孫右衛門ハコノ猿之助ノ父段四郎、小春ハ先代梅幸デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツイテハコノ際今少シ廣クテ近代的様式ノ家ニ移リタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコノ女ハ枕サガシダト分ッテモ、却テソノタメニ興味ヲ惹カレテ、枕サガシヲ承知ノ上デ関係ヲ結ブ、ソノ誘惑ニ抗シカネルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハコノ間モ云ッタ通リ、自分ノ墓ハ東京ノ墓地デハ嫌ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ又愉快ナノヨ」予ハコノ話ノ途中カラ左手ガヒドク痛ムヨウニ感ジ始メタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハコノコトヲ少シ委シク書キ留メル必要ガ起ッタノデ、モウ一度コヽニ記ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「君ハドウデモイヽッテ云ウカモ知レナイケレド、浄吉ハコノトコロ旅行バカリシテタジャナイカ」「ソレガ何ナノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このやうに一尊を台座・光背共に一石で作り出した石佛としては全国的に最も古い年号をもつ像で、また鎌倉時代石佛の様式の基準をこれによつて求め得る点で貴重な遺品である」ト記サレテイルガ、予ハコノ写真ヲ見テ、フト思イ付イタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那人ハコノ技ニ甚ダ熟達シテイテ、風ノ吹ク中デモ平気デブラシニ水ヲ含マセ、碑面ニ白イ紙ヲ伸バシテ傍カラパタ／＼叩イタリシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコノ朱ノ拓本ヲ極メテ美シイト感ジタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ敏子ハコノ縁談ニハドウモ気乗リガシテイナイラシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何ヲ云ウノダ、夫ハコノトコロ大分好調ガツヅクト思ッタラ、トウトウタマリカネテ降参スルノダナ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハコノ家ノ勝手ヲ心得テイルラシク、浴室カラ洗面器ソノ他ヲ運ンダリ湯ヲ沸カシタリ注射器ノ消毒ヲ手伝ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ豫想スルトコロデハ、妻ハコノ記事ヲ読ンデモ読マナイフリヲシテ、マスマス淫蕩ニナルデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御注文ノ広東犬ハコノ間カラ捜シテイマスガナカナカ見ツカラナイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨクモテツノハコノナカノモノヲ、カクシタナ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハコノ宇宙ガ不満ダッタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
