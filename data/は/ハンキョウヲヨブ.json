        "examples": {
          "standard": [
            {
              "text": "彼女の型破りなプレゼンテーションは、会場で大きな反響を呼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "雑誌に掲載されたそのインタビュー記事は、若者たちの間で予想以上の反響を呼んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "地球環境に関する彼の警告は、世界中の科学者の間で反響を呼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "曰く、「此の戯曲が――しかも何等企むところなき此の戯曲が受けたかくも熱烈な、また意外にもかく懇篤なる世評を想ふとき、わたくしは、真を求むる心が常にある反響を呼ぶといふ一事を信じないわけにいかない。",
              "citation": {
                "source": "サン・ジョルジュ・ド・ブウエリエについて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つてさういふ感情のおほやけの表示が、どんな反響を呼ぶかといふこと、自分がその結果どんな立場に立つかといふことしか考へないのである。",
              "citation": {
                "source": "日本人とは？",
                "author": "――宛名のない手紙――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
