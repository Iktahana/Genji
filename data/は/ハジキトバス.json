        "examples": {
          "standard": [
            {
              "text": "彼は、服についた埃を「弾き飛ばした」。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "衣服についた泥を、手でパッと弾き飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は怒りに任せて、テーブルの上のグラスを弾き飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "おとといのような泥濘になると、おそろしく泥の飛沫をはじきとばす。",
              "citation": {
                "source": "上林からの手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがうまくとどいて命中すれば、音がするであろうし、また位置をかえ、あるいははじきとばすであろう。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "植物の果実のことだけを詳しく取り扱ったいわゆるカルポロジーの本を読んだときに、乾燥すると子房がはじけて種子をはじき飛ばすものの特例の一つとして Impatiens noli-tangere というものが引き合いに出ていた。",
              "citation": {
                "source": "沓掛より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子は自分が煙草をのむかのまぬかの問題をはじき飛ばすように、「あれはどなた？",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてはこれにも眼をつけたかとすばやく察したものか、伝六の胸倉をドンと強く十手ではじき飛ばすと、「何をでしゃばりいたすんだッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日一日、安静にしておけば回復するだろうといっていました」　主任は火のついた煙草を指ではじき飛ばすと、むっつりとした顔で下草のうえにあぐらをかいた。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのがつしりした鉄のやうな腕は、すべての不健全なもの、非人倫的なもの、神秘的なもの、病感的なもの（もちろんその中には私の詩にみるやうな哲学も含んで居る）及び人生の幸福に有害なる一切の感情を弾きとばすことに熱して居る。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "枚岡の斎き姫にあがる宿世を持つて生まれた者ゆゑ、人間の男は、弾く、弾く、弾きとばす。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "枚岡の斎き姫にあがる宿世を持つて生れた者ゆゑ、人間の男は、弾く、弾く、弾きとばす。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "枚岡の斎き姫にあがる宿世を持って生れた者ゆえ、人間の男は、弾く、弾く、弾きとばす。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
