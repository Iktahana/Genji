        "examples": {
          "standard": [
            {
              "text": "彼は、服についた埃を「弾き飛ばした」。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "衣服についた泥を、手でパッと弾き飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は怒りに任せて、テーブルの上のグラスを弾き飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "おとといのような泥濘になると、おそろしく泥の飛沫をはじきとばす。",
              "citation": {
                "source": "上林からの手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがうまくとどいて命中すれば、音がするであろうし、また位置をかえ、あるいははじきとばすであろう。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
