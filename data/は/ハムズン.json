          "literary": [
            {
              "text": "實際、ハムズンの「餓え」に匹敵する「怖れ」とでも云ふ創作を書くことが充分俺には出來るのだ。",
              "citation": {
                "source": "書翰",
                "author": "大正十一年九月（推定）　小島勗宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　ハムズンをよみつづく。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　ハムズン　性慾の中に詩のあることは前人もとうに発見してゐた。",
              "citation": {
                "source": "続文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、食慾の中にも詩のあることはハムズンを待たなければならなかつたのである。",
              "citation": {
                "source": "続文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
