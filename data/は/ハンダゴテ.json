        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "先端が黒く焦げたハンダゴテが灰皿の上に葉巻のように載っている。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともとこの無線機には二個しかＶＦＯはなかったのだが、隼人がケースを分解してハンダゴテで十四個も無理に取り付けたのだった。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "隼人は紙袋からトランジスタを二個取り出すと、無線機の映像信号の増幅回路にハンダゴテを使って取り付けた。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンダゴテで回路を変え、映像と音声の電気的信号を増幅させる機能を持たせた。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
