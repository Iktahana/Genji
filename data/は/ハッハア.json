          "literary": [
            {
              "text": "近づいて見ると――　ハッハッハア。",
              "citation": {
                "source": "インターナショナルとともに",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハアと笑って、ようし、やるぞ！",
              "citation": {
                "source": "新たなプロレタリア文学",
                "author": "――アレゴリーと諷刺――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッハッハッハッハア！",
              "citation": {
                "source": "決戦川中島　上杉謙信の巻",
                "author": "――越後守安吾将軍の奮戦記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイラはまた、誰もお客さんを迎えてやる人がないと思って、出迎えにでてきただよ」「アッハッハア。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあげくには音をたてて、「ハッハッハッハッハア」　バカのようにトメドなく笑いだしてしまったのである。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッハッハア」　サルトルの哄笑は満堂を圧するものがあった。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ぼくをビックリさせないために、わざと悠長な話し方をしたのかと訊いているのさ」「ハッハア」　穂積は雲をつかむような笑い方をした。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハッハア」　また、雲をつかむような笑い方をした。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくの目からは、君の方がトーチカのように見えるんだがね」「ハッハア」　穂積は明るく笑って、「だから、人のことで気をつかっちゃいられないんです。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが案外にも、男の方は、なんとなく引き立ってみえるんですな」　穂積はハッハアと笑って、「しおれた野草のような青木さんが、一輪ざしの花のように生き生きと、ハッハ、まア、それぐらいに見える瞬間もなきにしもあらずです。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　五忘にこう云われて、ベク助は苦い顔をした。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と、又してもチクリとやられたが、何を小癪なと、もうベク助は相手にならないことにしていた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と虎之介は大きな両腕でヘコ帯の前を抑え、肩をゆすって呵々大笑した。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　それから三日目。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と虎之介がからかったが、「そうなんですよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "グズ弁が犯人で悪かったら、あんた、パンパン屋へ遊びにくるの、およしよ」「わるかったな」「ハッハッハア」　二人の会話はどうやらそこで終りをつげたようであった。",
              "citation": {
                "source": "都会の中の孤島",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "※アッハハッハアッハハッハこりや可笑し」と云ふオペレット特有のあのコーラスを揶揄したものなのである。",
              "citation": {
                "source": "大正東京錦絵",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と突拍子もない笑い声をつけ加えました。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで仕方なく二人は顔を見合わせて、ハッハッハアと笑い合ったのですが、外国の諺に、最後に笑うものがもっともよく笑う、というのがあるそうですねえ。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
