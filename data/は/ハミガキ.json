        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "フッ素配合の歯磨きは虫歯予防に効果的だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "いくつかの種類の歯磨きを試して、一番合ったものを選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供用の歯磨きは、味が色々あって楽しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
