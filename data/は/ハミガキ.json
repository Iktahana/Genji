        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎食後には歯磨きを欠かさないようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行に行くときは、歯磨きセットを忘れずに持っていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "正しい歯磨きの仕方を歯科医に教えてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "主人は給仕をする老婢に「皆川老人は」「ふじのや連は」「歯磨き屋は」「彦七は」と妙なことを訊き出した。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一は、パジャマのまま、トイレから出てきて、手を洗い、歯磨きをしろ、と説得されている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯ブラシを出し、歯磨き粉をつけると、高志が、こっち見て笑え、という。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから歯みがき一つ買うにも、まず政府へ願書を差し立て、何が故に歯磨きに興味を感ずるか、年齢は幾つか、既婚か未婚か既婚ならば妻もしくは夫の人物・性行・嗜好の一般、家族は何人か――各写真一葉添附のこと――共産党政府に異心なきことの証明。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔵前の長井兵助の家は、店で歯磨きや楊子を売っていて、大きな長い刀が飾ってあった。",
              "citation": {
                "source": "牢屋の原",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは唯はた目には石鹸や歯磨きを売る行商だつた。",
              "citation": {
                "source": "素描三題",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "耕す畑も田もないから、仕方なく爺さんは楊枝、歯磨き、洗粉などを行商して、いくらかのお銭を取り、婆さんは他人の洗濯や針仕事を頼まれて、さびしい暮しをつゞけてをりました。",
              "citation": {
                "source": "竜宮の犬",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　野蛮人には、歯磨き粉を呑ませても、胃病がなおるということだ。",
              "citation": {
                "source": "味覚馬鹿",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこの草を焼いて灰と成し、塩を交えてハコベジオと称する歯磨き粉を製する。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウム」　思いは同じ海老団治が、歯磨きの空缶のにわか仕立ての猪口でおどけたようにヒョイと受けた。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "一廉のお邸の、障子は破れ、敷台には十文以上の足の跡、縦横無尽に砂もて画かれ、履脱ぎには歯磨きの、唾も源平入り乱れ、かかる住居も国野てふ、その名に怖ぢて、誰批難するものはなく。",
              "citation": {
                "source": "誰が罪",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年越し店を手伝って、奉公人並みに働きながら、一文も給金を貰ったことのない私が、たまたま歯磨きを使ったのが贅だとか、手拭を買ったのが生意気だと言われちゃ、我慢がなり兼ねます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "二本の脇差",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯磨き売りや、古着屋や、野天にいろいろな露店が出ていた。",
              "citation": {
                "source": "治郎吉格子",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "書籍、歯磨き、タオル、寝巻き、ブラシ……と私の投げ出すのを、手際よくユアンの詰めてくれた鞄を下げて、運転手が出て行った後を続いて私も出ようとした途端、パタン！",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに哀れをとどめたのは――大勢の客を呼びあつめ足駄ばきで三｜方にのっていた歯磨き売りの若い男、居合の刀を持っていたところから、一も二もなく目がけられて、豹のごとく飛びついてきた酒乱の浪人者に、血まつりの贄とされた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "居合抜きの歯磨き売り。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ああ、なに、うんそうか、土産ものも売っとるう、写真に絵はがき、首かざり、宝石入指環、はみがきに靴墨。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "道綸は二厘五毛のテグスを黒く染めたもの、鈎素はみがきの二厘のテグス。",
              "citation": {
                "source": "青鱚脚立釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "（福神漬や、らつきようはあの当時入手できなかつたかもしれない）お魚はみがきにしんのてり焼が一ばん結構だと思ふ、味がそれより落ちるけれど烏賊のわた煮（輪ぎりにしたもの）、鰯のみりんぼし、家庭で生乾にしたもの、ほつけのバタやき、ぢか火で焼いた鯨のビフテキ、塩胡椒でにほひを消せばよろしい。",
              "citation": {
                "source": "ともしい日の記念",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "過日この孤児園の孤児たちが、連れ立って、書簡せんや、鉛筆や、はみがき粉などをかんへ入れて、売りにきたとき、自分は、つれなく、「みんなあるから、いらない。",
              "citation": {
                "source": "子供は悲しみを知らず",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとの一人は、八寸の三宝に三種の歯みがき――塩、松脂、はみがきをのせて、お嗽ぎを申し入れる。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "膚はみがきあげた象牙のように冴えかえり、女にしてはととのいすぎた冷い面ざし。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "かごやの客",
                "note": "青空文庫"
              }
            },
            {
              "text": "重吉が網走からもってかえって来た人絹の古い風呂敷包みの中には、日の丸のついた石鹸バコ、ライオンはみがきの紙袋、よれよれになった鉄道地図、そして、一まとめに大事にくくった書類が入っていた。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白玉のかけたるはみがきても見む、言の葉のかけたるはせんすべもなし。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "月はみがきあげたように光っていたが、三人ともそれを仰ごうともしなかった。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "「技法」はみがきあげられた。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯磨｜楊枝をくわえた人、犬をひっぱっている人、写真機をあちらこちらに持ち廻って勝手に苦しんでいる人、それらの人の観察を享楽しているらしい人、そういう人達でこの美しい朝の広場はすっかり占領されていた。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、手拭いとフンドシと歯磨粉だった。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）たべ物の中から、一寸細長い白いもので、さきにみじかい毛を植えた、ごく率直に云うならば、ラクダ印の歯磨楊子、それを見たのだ。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "祈っても駄目だ、この病的な生活を洗い浄めて練歯磨の匂いのように新鮮なすがすがしい健康な生活をしなければならぬと、さまざまに思い描き乾いた雑巾を絞るような努力もしてみるのだが、その夜の道がそうした努力をすべて空しいものにしてしまうのである。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
