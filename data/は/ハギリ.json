        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "自動車部品を製造するために、特殊な旋盤を使って歯切りを行う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "精度の高い歯車を作るには、熟練した職人による歯切りの技術が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "金属の円盤に等間隔の溝を刻む歯切りの工程を、工場で見学した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
