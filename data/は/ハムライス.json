        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "Bld de Italie の方へ歩き、変な 〔Cafe' Restaurant〕 へ入ってスペイン料理という野菜スープや、ハムライスみたいなものをたべ、出てＴさんが共同便所へかけ込んで、それから Volga Volga というのを見に入った。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "死顏　七月二十二日の夕べ、芥川はサンドウィッチ、僕はハムライス、どちらも芥川の家でこしらへたものを食べてから、いつも二人だけの話になるときのやうに横になつた。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻、ハムライスを食って座へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "新宿まるやへ寄り、まづいカツレツ、オムレツとハムライスを食ひ紅茶のむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻雀――夕食は悲しきハムライス、又々続ける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "間にスコットから、コロッケとハムライスとって食ったのみ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムライス・幕の内・支那そばを食ひ、五千プ程勝つ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食は、スコットのポタアジュ、ビフシチュウ、ハムライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュとビフテキ、ハムライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽屋で食事、スエヒロのタンシチュウにハムライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムライスがあるといふので一皿食ひ、羊羹二片。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
