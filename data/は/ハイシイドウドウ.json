          "literary": [
            {
              "text": "陸軍の閣下様でハイシイドウドウと馬の尻を叩いているじゃないかよ。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイシイドウドウ、手綱をとりながら、彼は又叫ぶ。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこから取り出したのか、手綱代わりの同じだんだら染めのひもが男の口にくわえさせられ、その両端を持って、ハイシイドウドウと、お馬の曲乗りがはじまった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
