    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何しろこの這い下りることは、這い上るのに何百倍して、困難なことだったからね。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の手には、杖の柄と一緒に、数珠つなぎになったロープのたるみをやけに握って、一足、一足と段を作って、靴のつま先を雪の中に突っ込んでは、そろりそろり這い下りる、で、その雪が、また意地わるく、解けるように柔かい。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ、背ろむきになって這い下りるんだから、足もとは悪し、雪の急斜で手掛かりはなし、重くはなかった筈のリュックサックまで、いやに意地悪く背を曳いて、気のせいか、もんどり打ちそうで気味がわるくてならない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
