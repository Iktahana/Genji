        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『朝野僉載』には大酔して崖辺で睡った人の上へ虎が来て嗅ぐと虎鬚がその人の鼻孔に入りハックションと遣った声に驚きその虎が崖から落ちて人に得られたとある。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に無茶先生は、谷川のふちに生えていた細い草の葉を取って、二人の鼻の穴へソッと突込みますと、二人共一時に、「ハックションハックション」　と嚔をしながら眼をさまして、起き上りました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハ、ハックショイ！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下に名高い大辻……うわッ……ハーハックション！",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからそうするよ、ハックショ！",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハックショ、ほんとにばかばかしい、何が寝物語だ」　こう言って、近江の国の障子を引きあけて、なれなれしく近江の国へ夜込乱入をかけ、「いやに暗いじゃありませんか」　燈心を掻きたててやって、さて、寝かしつけて置いた相手の枕許を見ると、「おや？",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで六兵衛は、持ちまえの大声をはり上げて、「ハックショ、ハックショ。",
              "citation": {
                "source": "とんまの六兵衛",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふん、（幕のフチに手をかけ、眼をむいて声色）いずれを見ても貧乏育ち、菅秀才の……ハッ、ハックショイ、あったら口に風を引かしたわえ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
