    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "供先揃えながら、鳥毛、挟み箱の行列も七十三万石の太守らしく横八文字に道を踏んで、長蛇のごとく練って来たのは待ちに待たれた島津のお道中でした。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗左は名高い大名の折角のお招きだといふので、出来るだけ供をたんと連れて、供には挟み箱や長刀などを担がせた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒塗り紋附きの挟み箱が往来においてある。",
              "citation": {
                "source": "巣鴨菊",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "槍の挟み箱のという仰々しいことはごくお嫌いな先生、それに暇どりするゆえ、一人で駕で行ってくる。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで羽柴秀長の迎えを見、指揮をさずけ終るや、また山を降って黒田村を渡り、観音坂を経て、余吾の東方、茶臼山へかかって、初めて床几代りの、挟み箱に腰をおろした。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "挟み箱に腰かけた彼の服装を見るに、昼から汗と埃にまみれきった柿色染めの木綿陣羽織に、柿団扇をもち、徐々、それをうごかして、戦闘指揮にかかっていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方――　秀吉の進撃と、ここの動きとを、時間的に対比してみると、玄蕃允が陣払いを始めていた頃、ちょうど秀吉は、黒田村から茶臼山へのぼり、挟み箱を床几として、ひと休みしている時分かと思われる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち、彼女は或る日、往来を歩いていると、二階笠の紋をつけた挟み箱や塗り駕籠の行列に行き会った。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "挟箱や鳥毛の槍を押し立てて舞踊しながら練り歩く百年前の姿をした「サムライ日本」の行進のために「モダーン日本」の自由主義を代表する自動車の流れが堰き留められてしまったのである。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "箪笥、長持、挟箱、金高蒔絵、銀金具。",
              "citation": {
                "source": "雛がたり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "街道の並木の松さすがに昔の名残を止むれども道脇の茶店いたずらにあれて鳥毛挟箱の行列見るに由なく、僅かに馬士歌の哀れを止むるのみなるも改まる御代に余命つなぎ得し白髪の媼が囲炉裏のそばに水洟すゝりながら孫｜玄孫への語り草なるべし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十軒店で近頃出来合の品物じゃあないんだそうで、由緒のあるのを、お夏さんのに金に飽かして買ったって申しますがね、内裏様が一対、官女が七人お囃子が五人です、それについた、箪笥、長持、挟箱。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからね、まだ長持だの、挟箱だの……」　ああ、もう駄目だ。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "長持や挟箱の話になっちゃ大事去った、と後悔しても最う追付かない。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪江さんは、何処が面白いのだか、その長持や挟箱の話に夢中になって了って、其から其と話し続けて、盛返したくも盛返す隙がない。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "挟箱持った人と、怖い顔のお侍様が一人お供しておりました」「ウーム。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "木刀を一本差して、南部家中の小者らしく、挟箱を肩にしていた。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "――）　右源太は、行手に、小さく、黒い挟箱を担いで行く小者を、じっと見つめながら、刀を押えて、小走りに、急いでいた。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああっ」　と、叫んで、挟箱を担いだまま、二間余り走ると、両脚を揃えて、木のように、倒れてしまった。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の騒ぐ姿、罵る者、橋外へ来かかった津軽の行列は槍を傾け、挟箱持は濠端へ逃げ、駕籠はよろめきながら、人数の乱れる脚の真中に――そして、柳の木の下には白い硝煙が、薄く立ち昇っている。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「津軽だ」　と、挟箱の金紋を見た侍が、叫んだ。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "挟箱、草履、御槍の人々が、そのあとを、追って行った。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、若い衆に制されて、爪立ちになって覗くと――真先に、士分一人、挟箱一人、続いて侍女二人、すぐ駕になって、駕脇に、四人の女、後ろに胡床、草履取り、小者、広敷番、侍女数人――と、つづいて来た。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "挟箱――そんなものも見えていた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "その傍に挟箱を下ろして煙草を吹かしてをる者もある。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "挟箱、鳥毛の槍、武鑑を繰るまでもなく、丸鍔の定紋で青山因幡守様と知れる。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "持槍、薙刀、台笠、立傘、挟箱、用長持、引馬までが動揺して、混乱せずにはいられなかった。",
              "citation": {
                "source": "怪異黒姫おろし",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂にも入り、夕飯も済んで、挟箱担ぎはどこへか用足しに行ってしまい、米友はまだ寝るには早いから坐っていると、長押に槍がかけてあります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "東海道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほか仲間、槍持、挟箱担ぎ、馬方に至るまで、みな人足の肩を借りたり手を借りたりして、なかなか大業なことでありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "駒井能登守の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "残ったのは、虫の食った挟箱や、手文庫、軸の曲った燭台、古風な長提灯、色の褪せた裃といったような、いかにもがらくたという感じのするものばかりであった。",
              "citation": {
                "source": "次郎物語",
                "author": "第一部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
