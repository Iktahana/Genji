  {
    "uuid": "5cd368e4-57c3-50c7-94ef-b3b552e2bc88",
    "entry": "挟み箱",
    "reading": {
      "primary": "はさみばこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
