        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしてハイドンや、バッハや、ヘンデルやは、そう呼ばれていないのである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞いてみるとそれはハイドンのトリオであった。",
              "citation": {
                "source": "ラジオ雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の人格者はヂキール博士で、後の人格者はハイドである。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂキールはハイドを殺さうとし、ハイドはヂキールを殺さうとする。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちハイドがジキールにしたやうに、自己の一方の人格が、他の一方の人格を抹殺して、記憶から喪失させてしまひたいのだ。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイド・パークの青芝の広場に幾筋もの汗ばんだ行進隊が吸ひ寄せられて行く。",
              "citation": {
                "source": "英国メーデーの記",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイドパークの青芝を踏まへて六つの演壇が出来てゐる。",
              "citation": {
                "source": "英国メーデーの記",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はハイドパークの真向ひ大理石門地下鉄ステーションへ終電車近く駈けつけた。",
              "citation": {
                "source": "英国メーデーの記",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイド公園を抜け、オックスフォード街を通ってベイカー街へ出た。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "〉、つぎが〈ルーズ・ザット・ガール〉、そのつぎが、えーと、〈ユーヴ・ガット・トゥ・ハイド・ユア・ラヴ・アウェイ〉、それから、アルプスだから、〈ティケット・トゥ・ライド〉で……」「そこまで！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ジキルとハイド』が頭をかすめる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三晩｜寐ないで書上げた「ジィキルとハイド」の初稿をストーヴの中に叩き込ませたのは、ファニイであった。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジィキルとハイド」や「誘拐」の場合も恐ろしく速く書けたが、書いている最中に確かな自信はなかった。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「是が此間話したハイドリオタフヒア。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "成るが儘に成るとのみ覚悟せよ」　是はハイドリオタフヒアの末節である。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "門内を一寸覗き込んだ三四郎は、口の内で、「ハイドリオタフヒア」と云ふ字を二度繰り返した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイドリオタフヒアは覚えるのにさへ暇が入る。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎は返さうと思つて、持つて来たハイドリオタフヒアを出して読み始めた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に広田先生は必竟ハイドリオタフヒアだと思つた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一｜標題が解らんです」「ハイドリオタフヒア」「何の事ですか」「何の事か僕にも分らない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは、先主が歿られてから間もなくのことで、去年の五月の初めでしたが、その夜は、ハイドンのト短調｜四重奏曲の練習を、礼拝堂でやることになりました。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マヌエラのあれは、「ジキル博士とハイド氏」のように二重人格なのか――と、ますます糸のもつれが深まるなかで、座間は追及の鬼のようになっていた。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでハイド氏のような二重人格も、怪奇をおもわせたドドの魅魍も、さらに、いま五人のものが浮びあがろうとすることも、畢竟マヌエラに可憐な狂気があるからだった。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイドパークに面し地下電気へ三分地下鉄道へ五分、貴女と交際の便利あり」なんと云うのがある。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これがこのあいだ話したハイドリオタフヒア。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "成るがままに成るとのみ覚悟せよ」　これはハイドリオタフヒアの末節である。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "門内をちょっとのぞきこんだ三四郎は、口の中で「ハイドリオタフヒア」という字を二度繰り返した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
