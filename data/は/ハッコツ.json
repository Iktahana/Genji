[
  {
    "uuid": "b18471fe-7bb0-5837-af7a-c340266e4c5d",
    "entry": "白骨",
    "reading": {
      "primary": "はっこつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "white (bleached) bone",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長い年月を経て、動物の骨は白骨となり、地面に静かに横たわっていました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人里離れた山奥の洞窟で、身元不明の白骨が登山客によって発見された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "火災の焼け跡からは、無惨にも白骨化した状態の遺体が見つかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "我が日本アルプスでも、上高地は、私が明治三十五年に、白骨温泉から梓川を渉って、霞沢岳を踰え、この峡谷に下りて、槍ヶ岳へ登ったときは、夏とはいえ、寂寥無人、太古の如き感があって、温泉の湧出はあっても、今日のような宿屋は、まだ建っていなかった。",
              "citation": {
                "source": "上高地風景保護論",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "白骨温泉へ行くのださうで沢渡で下りた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "白骨温泉へ行くのだそうで沢渡で下りた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥や鼠や猫の死骸が、道ばたや縁の下にころがっていると、またたく間に蛆が繁殖して腐肉の最後の一｜片まできれいにしゃぶりつくして白骨と羽毛のみを残す。",
              "citation": {
                "source": "蛆の効用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はたとえマラバーの六個の円筒の下でカルカラの一群によって白骨になろうとも、私は未来の有効な地図に向って突進します。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとに、もろい白骨以外何が残るか！",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五人とも黄河の河畔で、犬に喰われて白骨が出ていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥やねずみや猫の死骸が道ばたや縁の下にころがっているとまたたく間にうじが繁殖して腐肉の最後の一片まできれいにしゃぶり尽くして白骨と羽毛のみを残す。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ岩櫃山というて正平年間｜吾妻太郎行盛の城跡、巨巌重畳、断崖｜聳立、山中に古戦場あり、今日に及んでなお白骨の横わるものありという。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほとんど狼の食い散した白骨のごとき仮橋の上に、陰気な暗い提灯の一つ灯に、ぼやりぼやりと小按摩が蠢めいた。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉うらに透る月影の銀色は、やがて、その蘆の細莖の霜となり、根は白骨と成つて折れる。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の白骨もともに、革鞄の中にあります。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白骨にも鼻の高低はあるのか。",
              "citation": {
                "source": "好奇心",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "海で死んで、底深く沈んできた人間が、白骨となって、ポリプの腕のあいだからのぞいていました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "広場のまんなかに、一けんの家が立っていましたが、それは、船が沈んだときに死んだ人間の白骨で、作ったものでした。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の外には老人や青年が真黒に集まって、泥だらけの白骨を中心に、大評議をしている……というわけで……そこへ文作が帰って来たのであったが、女房の死骸を一眼見ると、文作は青い顔をしたまま物をも云わず外へ飛び出して、村の人々を押しわけて、白骨の置いてある土盛りの処へ来た。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジイッと泥だらけの白骨を見ていたがイキナリその上に突伏して、「兄貴……ヒドイ事をしてくれたなア……」　と大声をあげて泣き出した。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから間もなく件の白骨は、キレイに洗い浄められて、古綿を詰めたボールの菓子箱に納まって、文作の家の仏壇に、女房の位牌と並べて飾られた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも話がおかしいというので、駐在所の旦那が色々と取調べたあげく、一週間ばかりしてから郡の医師会長の学士さんに来てもらって、件の白骨を見てもらうと、犬の骨に間違いない……という鑑定だったので又も大評判になった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうした農家の裏山には、小高い冬枯れの墓丘があつて、彼等の家族の長い歴史が、あまたの白骨と共に眠つてゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、いよいよ生きながら白骨化して行く自分を感じて、これではいけないとたとえ遠くからでも無理にも真佐子を眺めて敵愾心やら嫉妬やら、憎みやらを絞り出すことによって、意力にバウンドをつけた。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひょっとしたら、尖った鼻先から氏の体が、見る見る白骨に化して行くのでは無いかと思われてぞっとした。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋はまた巨鯨の白骨のような姿で寂寞として見返す。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠はもとより両親も何もない、最愛の児を失い、最愛の妻を失って、世を果敢むの余り、その妻と子の白骨と、ともに、失うべからざるものの一式、余さずこの古革鞄に納めた、むしろ我が孤の煢然たる影をも納めて、野に山に棄つるがごとく、絶所、僻境を望んで飛騨山中の電信局へ唯今赴任する途中である。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三方崩れかかった窪地の、どこが境というほどの杭一つあるのでなく、折朽ちた古卒都婆は、黍殻同然に薙伏して、薄暗いと白骨に紛れよう。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
