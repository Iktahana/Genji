        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アルコールのおかげで快眠、夢中大きな鯉を捕へた、何の前兆か、ハツハツハツ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イツテ、ハツハツハツト　ワラヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツハツハツハツハ。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「斯うなつてからは、まさか憤つても居られないでせう、ハツハツハツ。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると二人はハツハツハツと大きな声で笑ひました。",
              "citation": {
                "source": "心配な写真",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツハツハツ……」「ハツハツハ……。",
              "citation": {
                "source": "地球儀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは社会事業をしにこゝへ来とるんぢやないから、……ワハツハツハツヽヽヽ」　馬鹿々々しい高笑ひといつしよに、この男もまた起ち上がつた。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワツハツハツハツハツ。",
              "citation": {
                "source": "素面の管",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻声で歌を唱ふぐらゐなんでもありませんよ……ワハツハツハツハツ……。",
              "citation": {
                "source": "頼母しき求縁（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "明神下の縁側から向島が見えるわけが無いぢやありませんか」「ハツハツハツ、むきになるなよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の留守",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「曲者が逃げ込んだのは、もう一二軒先だつたかも知れませんよ」「ハツハツハツ、ハツ」　平次はそれを聽くと急に笑ひ出しました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "辻斬綺談",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハツハツハツ、手が廻つたのか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "双生兒の呪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハツハツハツ、ハツ、ハツ、――この平次が色氣違ひに見えるかえ、番頭さん」「飛んでもない親分さん」「まア、宜い、若い女の後を跟けて來たに違ひないから、何と言はれても一言も無いよ、ところで、番頭さん」「へエ／＼」「今日、山の上であの騷のある少し前に、馬道の良助が、此處で着物を變へた相だ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "お、まだ物置に窮命中であつたな、ハツハツハツ」「城明け渡しと仰しやると？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "傀儡名臣",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツハツハツ」「でも、佐七が臭いとは何うして氣が付きなすつたんで――」「千之助が助かつて得をする者は、佐七ばかりと言つた時からだよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "地獄から來た男",
                "note": "青空文庫"
              }
            },
            {
              "text": "他に氣のついたことはないか」「そんな事をするのは、酒嫌ひな奴でせう、どうせ」「ハツハツハツ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "酒屋火事",
                "note": "青空文庫"
              }
            },
            {
              "text": "「猪や鮪へ出刄庖丁を抛つた話は聞かないな、ハツハツハツ」　平次はカラカラと笑ひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "どんど燒",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐚一｜文缺けても相成らぬぞ、ハツハツハツ、馬鹿な奴だ」　カラカラと笑ふ浪人長谷倉甚六郎、まことに水際立つた男振りです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "結納の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "八なんざ馬みたいなもので、何を聞かしたつて構やしない――あツ、其處に居たのか、ハツハツハツハツ、こいつは大笑ひだ」　平次の高笑ひに吹飛ばされたやうに、ガラツ八は納りの惡い顏を、次の間へ引込めて了ひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "たぬき囃子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お品さんにも少しは手傳つて貰へるだらうネ」「それはもう」「女御用聞もしやれて居るだらう、ハツハツハツ、これは冗談だ」　平次は蟠りない調子でかう言ふと、お品もツイ誘はれたやうに、濡れた顏を擧げて、淋しくニツコリしました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "たぬき囃子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな馬鹿な事が――」「まアいゝやな、ハツハツハツ」　平次は他愛もなく笑ひ乍ら、輕い心持で小屋を出ました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "歎きの菩薩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「利吉、――とか言つたね、神妙にするがいゝ、裾に血が附いてゐるぢやないか」「えツ」「ハツハツハツ、さう言はれて、自分の裾を見るところが正直だ、――番頭さん、この男の荷物を見せて下さい」「へエ――」　老番頭の太兵衞もどうすることも出來ません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "捕物仁義",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもお靜さんに少しでも疑ひがあるなら兎も角、お靜さんは、お袋と俺の側を一寸も離れちや居ねえんだぞ」「うるさいツ」「金輪際此處を通すものか」「役目の表でもか」「――」「馬鹿野郎、ドヂを通らねえと、手前のやうになるとよ、ハツハツハツ」　清吉はこんな洒落を言ひ乍ら、八五郎の胸をドンと突きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次女難",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツハツハツ、まアさう言つたやうなわけさ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛喜三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハ、ハツハツハツ、尤も贋金使いを縛つた褒美の金は、八五郎が貰ふことになつて居るよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "二枚の小判",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旦那は昨夜何處にお出ででした」「俺は下手人ぢやないぜ、ハツハツハツ」「そんなつもりぢや御座いません」「まア宜い、言譯には及ばない。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "父の遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "――だが、お絹さんは下手人にしては綺麗過ぎるよ、ハツハツハツ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "紅い扱帶",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
