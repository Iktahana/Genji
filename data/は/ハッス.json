          "standard": [],
          "literary": [
            {
              "text": "ひとつ、ここはうんとハッスルしてもらって、ことマイクロ・コンピュータ技術資料に関する限り、世界中のエンジニアが、日本語を知らなければ遅れをとるというぐらいに、がんばってほしいものである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が漸くモアッサンにかかるともう彼はウォルフとハッスリンガーにかかっているという状態で、夜の目も寝ずに私が勉強したとてとても彼には及ぶことが出来ないのだ。",
              "citation": {
                "source": "鳥",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞記者をする人の文章には、達者なら達者で、一種のハッスリングな心持がある。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は亡母の命日だったけど僕は何となく亡母もよろこんでくれている様に思えて子供になってハッスルしました。",
              "citation": {
                "source": "遺愛集",
                "author": "島秋人",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんながハッスルしたのです。",
              "citation": {
                "source": "遺愛集",
                "author": "島秋人",
                "note": "青空文庫"
              }
            }
          ]
        }
