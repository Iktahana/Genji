        "examples": {
          "standard": [
            {
              "text": "墓参りでは、故人が好きだった花を花立てに供えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "寺院の境内には、多くの参拝者が供えた花立てが並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お彼岸には、家族みんなで花立ての花を新しくしに行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
