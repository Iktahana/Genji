        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "仏壇には、いつも清らかな水と季節の花が供えられた花立てが置かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "陶芸教室で、自分だけのオリジナルな花立てを作る体験をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "食卓に置かれた花立ての花が、部屋を明るく彩っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "墓のまえの花立てには、経師職の息子が涙を振りかけたらしい桔梗と女郎花とが新しく生けてあった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "花立ての花もきょうはもう萎れて、桔梗も女郎花も乾いた葉を垂れていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母も久しくお参りをせぬとみえて、花立ては割れていた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "花立てにはみそ萩や女郎花などが供えられてある。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏壇には灯がついていて、蓮の葉の上に供えた団子だの、茄子や白瓜でつくった牛馬だの、真鍮の花立てにさしたみそ萩などが額縁に入れた絵のように見える。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "新所帯の仏壇とてもないので、仏の位牌は座敷の床の間へ飾って、白布をかけた小机の上に、蝋燭立てや香炉や花立てが供えられてある。",
              "citation": {
                "source": "深川女房",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "須彌壇の花立てには、何時｜活けたとも知れぬ花の枝が乾枯びて、焚き付けにでもなりさうになつてゐた。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからその机の側にある、とうにニスの剥げた茶箪笥の上には、頸の細い硝子の花立てがあって、花びらの一つとれた造花の百合が、手際よくその中にさしてある。",
              "citation": {
                "source": "葱",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓦屋根の上の月の光は、頸の細い硝子の花立てにさした造花の百合を照らしている。",
              "citation": {
                "source": "葱",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと心づきて武男は涙を押しぬぐいつつ、墓標の下に立ち寄りて、ややしおれたる花立ての花を抜きすて、持て来し白菊をさしはさみ、手ずから落ち葉を掃い、内ポッケットをかい探りて一通の書を取り出でぬ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "近時、ふと思うことありて、欠かさず月詣ではじめしも、地蔵尊には『大正三年一月十六日　釈浄證信士』　とあり、左楽（現）、燕枝、志ん生、柳枝、つばめ、馬生、小勝、今輔、小せん、文楽（いずれも先代、先々代）の名を線香立て、花立てに刻し、別に三代目小さん、建之云々とありけり。",
              "citation": {
                "source": "随筆　寄席囃子",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとに……」　桶の中から取り出した樒を半分ずつにして、両方の花立ての中へ差し込みながら圓朝は、「うちの師匠の代になってめっきり三遊派は衰微してしまった」　そっと微かに溜息を洩らした。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中のひとり、およしというのをじょうだんに家の中へ閉じ込め、外からかぎをかけてほっておいたところ、その女は尿意をもよおして辛抱できず、床の間の花立てに用を足してしまった。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓標の長い影や、花立てに枯れかかった白い菊や、毎日眺めている景色ではあったけれど――貧しい、何か貧しいと、遠い日の悔恨のようにその風物は私ににがさを強うるものがあったのだ。",
              "citation": {
                "source": "風宴",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "花立ての椿はがらがらに枯れて午後の陽をうけている。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "クニ子が花立ての花をとりかえ、水をさしている時、実枝はその弔旗の中から松江作太郎という字を見つけ、「松江作太郎か」と大人ぽく呟いた。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ枯れきってはいない花が、花立てに豊富にあった。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "越後も中頸城の漁村には「鰯の年取り日」という珍しい名があるが、それからやや北へ行くと一般に、もとは「藤の花立て」といって、晴着をして山に行き藤の花を採って来て、仏壇に立てる風があった。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨時分になりますと、切花は駄目でございますわね……」と、武井さんは答へながら花立に※さつてゐた古い花を窓外に投げ捨てた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええ、綺麗ですね……」と、私は花立に※さつたコスモスの花を眺めながら云つたが、何となく何時ものやうな明るいなごんだ氣持にはなれなかつた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "艸花立樹の風に揉まれる音の颯々とするにつれて、しばしは人の心も騒ぎ立つとも、須臾にして風が吹罷めば、また四辺蕭然となって、軒の下艸に集く虫の音のみ独り高く聞える。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論｜木葉は堆く積って、雑草も生えていたが、花立の竹筒は何処へ行った事やら、影さえ見えなかった。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "下り藤の定紋をつけた左右の花立の草花の間を、線香の匂がほのぼのと分けていつた。",
              "citation": {
                "source": "醉ひたる商人",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七年忌には金百円、幕｜一帳男女名取中、葡萄鼠縮緬幕女名取中、大額｜並黒絽夢想袷羽織勝久門弟中、十三年忌が三世の七年忌を繰り上げて併せ修せられたときには、木魚一対墓前｜花立並綫香立男女名取中、十七年忌には蓮華形皿十三枚男女名取中の寄附があった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五六日になると、「竹の花立はいりませんかな」と云って売って歩く。",
              "citation": {
                "source": "鶏",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "碁好きの墓に台石を碁盤に拵へ、碁笥を花立に見立てたのや、酒飲みの墓を徳利形や、酒樽形に刻んだのもあつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "深い天井の下に、いつまでも変らずにある真鍮の香炉、花立、燈明皿――そんな性命の無い道具まで、何となく斯う寂寞な瞑想に耽つて居るやうで、仏壇に立つ観音の彫像は慈悲といふよりは寧ろ沈黙の化身のやうに輝いた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親と父親とは、そのあたりを掃除したり、花をさすための穴をそこらにある竹切で掘つて見たりしたが、土が堅くつてとても深く掘れさうにもないので、そのまゝあきらめて、石塔の花立のところに一束にしてその持つて来た花を挿した。",
              "citation": {
                "source": "草みち",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "花を器に插すに法あり、插花立花の術と云ふ。",
              "citation": {
                "source": "帝室論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくつもの空の花立はひっくり返って、白い鳩の糞だらけだ。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
