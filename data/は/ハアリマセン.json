          "literary": [
            {
              "text": "ママサマ、少シモアブナイ事ハアリマセン。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一雄ハ深イ所デ泳イデモ危イコトハアリマセン。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴官ノホカニ、コノ真相ヲ調ベ切ル人ハアリマセン。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ハ見タワケデハアリマセンガ、確ニ私ハソレヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ奥様モ夢中デ云ッタヨウデハアリマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ計略ノ外ニハオ婆サンノ手カラ、逃ゲ出スミチハアリマセン。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドナタカ、私ノ家ヘ一シヨニ住ンデ下サル方ハアリマセンカ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オココロアタリノ方ハアリマセンカ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、笑イ事デハアリマセン。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ若サデソンナ意気地ノナイコトデドウスル」「陸子ハ嫁ニ行ッテカラ今マデ一度モコンナ話ヲ持ッテ来タコトハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハ溜リカネテソノコトヲ浄吉ニ訴エルコト再三ニ及ンダラシイガ、「ソンナコトハアリマセンヨ」ト、浄吉ハ笑イニマギラシテ相手ニシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネエオ爺チャン、颯子ガソンナモノヲ持ッテタ筈ハアリマセンガ、………」婆サンノ追及ハコヽヘ来テ俄ニ急デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「心電図ノ結果ハ矢張格別ノコトハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ノコトデスカラ多少ノ変化ハ已ムヲ得マセンガ、コノ前測ッタ時ト比ベテ異状ハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ御老人ノコトデスカラソノ御辛抱ガ辛イト仰ッシャルノモ無理ハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯チャント二人デ朝御飯ニ召シ上レ」「ソレハ有難ウ」「外ニ何カ、奈良デオ買物ハアリマセンカ、蕨餅ハイカヾ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテソノ足ノ甲ニ接吻サセテクレト云ッテモ、マア汚イトカ、コンナ所ニ触ルモノデハアリマセントカ云ッテ、ナカナカ願イヲ聴イテクレナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤハリ脳貧血ダソウデ、「御心配ハアリマセン」ト云ッテ、ヴィタカンフルノ注射ヲシテ児玉氏ガ帰ッテ行ッタノハ、夜中ノ二時デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供ノ読ム「アラビアン・ナイト」デハアリマセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
