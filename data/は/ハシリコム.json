    "definitions": [
      {
        "index": 1,
        "gloss": "to run into (room, building, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試合開始のホイッスルとともに、選手たちはフィールドに走り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "雨が降ってきたので、急いで家の中に走り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "猫が玄関を開けた途端、外へ勢いよく走り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「おんちゃん、おんちゃん、かちあるかい、かち、奈子ちゃんがかちだって」　続いて奈々子が走り込む。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は相手が倒れたのを見て恐ろしさのあまりピストルを投げ棄てて葛飾の部屋へ走り込む。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "續いて奈々子が走り込む。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "一蓆の籾をさゝへた儘急いで土間へ走り込むのであつた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "はるばるも帰り来しものかな――やがて亜細亜のメトロポリスへ、汽車は走り込むのだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "三頭立ての馬が「とうとう死んだ」牛の屍骸――マイナス耳――を引きずって走り込む。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上から帆布を当てがって、片っ方から順々に大釘で止めて行く……最後に残った一尺四方ばかりの穴から猛烈に走り込む水を、針金に押し当てがった帆布で巧みにアシライながら遮り止めてしまった。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼正は森の中へ走り込む。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水瓜を並べて置いて、そのなかをみつくろって撲ったつもりで米友は、少しばかり溜飲を下げて、行列の崩れたのを後ろに、今度は群衆の足許を潜って元のところへ走り込むと、その梯子を横にして肩にかけ、銭受けの笊を腰に差し、「ざまあ見やがれ」と言って、一散にその場を走せ出しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "黒業白業の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、お松としては、あのすさまじい現場へ走り込むことを遮られたのみか、その現場を見届けることをさえ抑えられてしまった形で、どうすることもできないで、全くその瞬間だけは、蜘蛛の巣にかかった小蝶と同じような運命に置かれました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら何でも元日っぱなから警視庁に護送されるところなぞを同業に見られたくないから、他聞を恥じるどの被告もするように、襟巻で面を包み帽子の前鍔を鼻の上まで引き下げ、走り込むように自動車に乗り、その儘の姿で帝国ホテルの車寄せに降りた。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "要心の深い奴は物音がすると、叮嚀にくさむらの奥まで走り込むほど臆病なのもいる。",
              "citation": {
                "source": "螽※の記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、もし船の中へ走り込む元気があったならば、いきなり、竜之助の膝にしがみついて、うらみつらみを並べたかも知れません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時あちらでは、指を噛みきれなくなった模造大御所が、自ら馬を飛ばしたのか、馬が驚いてはやり出したのか、まっしぐらに大御所を乗せて戦争の渦中へ走り込むのを見ました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋内に走り込むと大声で人々を呼び起しながら階段を駈け上った。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "小暗い隅へ走りこむと、やっと萩乃をはなして、左手に持ちかえた濡れ燕を、自分の着物の裾でスウーッとふきつつ、「萩乃さんとやら、おどろくことはねえ。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこをもう一度走りこむ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "運もよくて、彼は春木と共に、元の地下牢の方へ走りこむことができた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "うしろの子供等は、敵機追撃だと叫びながら口でうなりを立てゝ、ほこりの中に走りこむ。",
              "citation": {
                "source": "旱天實景",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらは、それぞれ自分の穴の入口に坐ったり、となりの家に噂話をしに走りこむプレーリー・ドッグのように好奇心いっぱいに見えた。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "伜どもが連名し、法皇に不届な上書したことを聞いていたので、すごい形相で中門から走りこむと、長い渡廊ノ間、対ノ屋、母屋の塗籠のなかまで、邸じゅうを馳けまわって伜どもを探したが、国吉と泰博は下司の知らせで逸早く邸から逃げだし、きわどい瀬戸で助かった。",
              "citation": {
                "source": "無月物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い谷底から、きりたつた岩塊が冬空へ走りこむ。",
              "citation": {
                "source": "麓",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋敷の裏の狹い空地へ　彼らは溢れ出る　躓きながら彼らは溪流のやうに　眞白になつて走りこむ滿潮の堀割へ！",
              "citation": {
                "source": "間花集",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "にじの女王は大テントに走りこむと、てんじょうのぶらんこから、さがっている綱につかまると、スルスルと、それをのぼっていきます。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「幾度、水の手の樋を断ち切りましても、いつの間にか、城内へ水の通っている容子なので、それがしの手勢を伏せておきますと、夜ごと、この若武者が、決死の一隊をひきつれて、搦手から裏山へ攀じ、貯水池の樋をかけ直し、水路をひいて城内へ走りこむのを見届けました。",
              "citation": {
                "source": "剣の四君子",
                "author": "柳生石舟斎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろと、迷ったり悩んだり致しましたが、大義と小義だと、考えつきましたので、源氏方のほうへ、走りこむ隙を窺っておりましたところ、ご危難を見かけたので、われにも非ず、前の主人景親様を、あのような目に遭わせて、お供に従いて来たわけでございます。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシ子ちゃんは、そこまで見とどけると、大いそぎで塔の階段をかけおり、電話のある部屋に走りこむと、すぐに、淡谷さんのうちをよび出しました。",
              "citation": {
                "source": "塔上の奇術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
