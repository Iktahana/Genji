      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "leaf withering",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "連日の猛暑で、庭の植木にひどい葉枯れが目立ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この病害虫は、急速な葉枯れを引き起こすので注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "葉枯れを防ぐために、朝晩欠かさずたっぷりと水を撒く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "烏頭は花ある時は、其の毒が根には乏しい位で、蝦夷人は花無く葉枯れた後に至つて、其の毒の根に歸するを待つて利用する。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなあはれ岡の鉾杉、をちこちの小竹のむら笹、柿もみぢ、梅が枝の蔦、とりどりに色に出づれど、神無月すゑの時雨に濡れ濡れて、その葉枯れず、落葉せず、透かず、薄れず、ただ上べわづか赭みて天鵞絨の焦茶いろすれ、深ぶかと黒くか青く、常久に古び鎮もる。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなあはれ、岡の鉾杉、をちこちの小竹のむら笹、柿もみぢ、梅が枝の蔦、とりどりに色に出づれど、神無月すゑの時雨に濡れ濡れてその葉枯れず、落葉せず、透かず、薄れず、ただ上べわづか赭みて天鵞絨の焦茶いろすれ、深ぶかと黒くか青く、常久に古び鎮もる。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏頭は花ある時はその毒が根には乏しいくらいで、蝦夷人は花無く葉枯れた後になってその毒が根に帰するのを待って利用する。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよ東北戦争の結果も明らかになったころは、それらの恨みをのんで倒れて行ったものの記憶や、あるいは闇黒からはい出したものの思い出のさまざまが、眼前の霜葉枯れ葉と共にまた多くの人の胸に帰って来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは霜の葉枯れで、地面が黒くなっている。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "このようにしてできた砂の層が大あらしなどの時にまたはがれて浜へ打ち上げられる時でも、細かいのと大きいのでは水に運ばれるのに遅速があって、いつでも選り分けられるような傾きがあるでしょう。",
              "citation": {
                "source": "夏の小半日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "噴火｜係の職をはがれ、その火山｜灰の土壌を耕す。",
              "citation": {
                "source": "ペンネンノルデはいまはいないよ　太陽にできた黒い棘をとりに行ったよ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの家の山椒の皮もはがれましたし、それに魚が、たびたび死んでうかびあがるというではありませんか。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」すっかり覚悟がきまりましたので目をつぶって痛いのをじっとこらえ、またその人を毒にあてないようにいきをこらして一心に皮をはがれながらくやしいというこころさえ起しませんでした。",
              "citation": {
                "source": "手紙　一",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この西洋人の車は一方の泥よけがつぶれただけですみ、われわれのバスは横腹が少しへこんでペイントがはがれただけで助かった。",
              "citation": {
                "source": "あひると猿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはあたかも蛇の皮を脱するごとく、物体の表面からはがれて、あとからあとからと八方に飛び出す。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェニスの町は朽ちよごれているが、それは美しく朽ちよごれているので壁のはがれたのも、ないしは窓からぶら下げたせんたく物までも、ことごとく言うに言われぬ美しくくすんだいい色彩を示しています。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水泳などに行って友だちや先輩の背中に妙な斑紋が規則正しく並んでいて、どうかするとその内の一つ二つの瘡蓋がはがれて大きな穴が明き、中から血膿が顔を出しているのを見て気味の悪い思いをした記憶がある。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山男はもうすつかりかあいさうになつて、いまのはうそだよと云はうとしてゐましたら、外の支那人があはれなしはがれた声で言ひました。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俄かに遠くから軍歌の声にまじつて、「お一二、お一二、」といふしはがれた声がきこえてきました。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根をはがれたトタン板と、屋根板が、がたん、ばり／＼と、競を追つたり、入りみだれたり、ぐる／＼と、踊り燥ぐと、石瓦こそ飛ばないが、狼藉とした罐詰のあき殼が、カラカランと、水鷄が鐵棒をひくやうに、雨戸もたゝけば、溝端を突駛る。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "片手づまみの大皿の鮨は、鐵砲が銃口を揃へ、めざす敵の、山葵のきいた鮪いのはとくの昔討取られて、遠慮をした海鰻の甘いのが飴のやうに少々とろけて、蛤がはがれて居る。",
              "citation": {
                "source": "祭のこと",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸山が原は青い衣をはがれて、古木もその葉をふるい落すと、わずかに生き残った枯れ草が北風と砂煙に悼ましく咽んで、かの科学研究所の煉瓦や製菓会社の煙突が再び眼立って来る。",
              "citation": {
                "source": "郊外生活の一年",
                "author": "大久保にて",
                "note": "青空文庫"
              }
            },
            {
              "text": "スラブみなしはがれ聲に御軍の吾たたへなむ日をも待つべし。",
              "citation": {
                "source": "短歌",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの患者すべて、人の資格はがれ落されている。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　岩壁の縁が、縁から、はがれて、飛ぶ、飛ぶ、　白光、　赤光、　紫金光。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "深山の石の間にいでくるものにて、紙をかさねたるごとくかさなりあひて、剥げば、よくはがれて、うすく、紙のやうになれども、火にいれてもやけず。",
              "citation": {
                "source": "雲母集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "疊んだ蒲團は、から紙の後ろのあかり取りがない中座敷へ押し出してあるから、から紙を締めて置けば見ないでも濟んでゐるが、この三疊だけは明るく開らいて秋の西日を受けてゐるので、障子の切り張りや壁がみのはがれがよく目に付いて穢い。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨戸を細目にあけて外をのぞいて見ると、塀は倒れ、軒ばの瓦ははがれ、あらゆる木も草もことごとく自然の姿を乱されていた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、大きな樹も小さな灌木も、みんなきれいに樹皮をはがれて裸になって、小枝のもぎ取られた跡は房楊枝のように、またささらのようにそそけ立っていた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "柱の白樺の皮がはがれた所を同じ皮で繕って、その上に巻いたテープには「白樺の皮をだいじにしてください」と書いてある。",
              "citation": {
                "source": "軽井沢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし全体がぬらされたものだとすると、無論そんな紙ははがれてなくちゃならないさ。",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして枝をきりおとされ、太いみきのかわをはがれ、まるはだかの、ほそっこいものにされて、とうとう、木だかなんだかわけのわからないものになると、この若いもみの木は、それをみてこわがってふるえました。",
              "citation": {
                "source": "もみの木",
                "author": "GRANTRAEET",
                "note": "青空文庫"
              }
            },
            {
              "text": "君、人間もこれだけ装飾をはがれるとよほど奇怪なものですぞ。",
              "citation": {
                "source": "水籠",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
