  {
    "uuid": "4cace3cc-8b27-5e66-a91b-7dde73a21b6b",
    "entry": "葉枯れ",
    "reading": {
      "primary": "はがれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
