[
  {
    "uuid": "0b354110-2be6-5876-88b4-141026754d2b",
    "entry": "ハリキリ",
    "reading": {
      "primary": "はりきり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私は自分の肉体の衰えと、彼女の身体のハリキリ方を身にしみて感じる。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "拙者、これが道楽で、貴殿のような御仁が、人相をやって下さるとなれば、拙者手弁当で出かける」　と、たいへんな、ハリキリ方である。",
              "citation": {
                "source": "奉行と人相学",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ペンダア君は手でハンドルを握り、両脚はばたばたさせて、紅毛人特有の無邪気なハリキリぶりを見せた。",
              "citation": {
                "source": "墓場",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び緑の自動車　ところが翌朝意外にも吉野大竜は早々とつめかけて、それ出動だと大そうなハリキリようである。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "大満員、「兵隊」大ハリキリ、ハネて、服部のオゴリにて築地の秀仲へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「兵隊」で、陸軍省の人々見物とあってハリキリ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「新婚」の時、若年部数名トチる、大声でカス食はせたので調子がいかん、それに夜の「兵隊」大ハリキリで又とても声いかん。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部は、「兵隊」七時四十五分より中継なので大ハリキリ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々してる間に、「曲芸団のロッパ」プロローグ、これだけで何時間とかゝる、秦専務ハリキリの演出ぶり、踊子の帽子の一つ／＼に迄注意するのに皆驚く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "清、久々の畳でハリキリ、匍ひ廻る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほろ酔ふ、清ハリキリ、あんよは上手と大いに歩く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二役早変りの僕の役、一寸ハリキリすぎてるが、ま、やらう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「凸凹ロマンス」久しぶりなので大ハリキリ、熱演大受け。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "センチな、ハリキリの歌ひ方をした、尤も声を細くすることには大分努力してみた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺はま子の「トンがらかっちゃダメよ」のＢ面について話す、「トンガラかっちゃダメよかい」といふのをテストしてみたがピンと来ないので、「ハリキリボーイ」といふのを考へた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビクターへ、ダレてばかりもゐられないので行く、「トンガラかっちゃ」Ｂ面用「ハリキリボーイ」が出来て鈴木静一がけい古して呉れた、これはよろしい、演歌調でいける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木静一曲の「ハリキリボーイ」オーケストラ入りのけい古、歌も自信がついた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」の吹込みである、昨日の声より悪いと言はれ、牛乳のんだりして、漸く二時半頃終る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣＬの永見来り、「大洋の寵児」について打合せ、放送局の小林氏来り、十六日は書き卸しをといふ注文、「ハリキリボーイ」と「まんざら悪くない」を入れてオペレットを書く約束した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "放送局へ「ハリキリボーイ」を届け、それから浅草へ行きたくなり、林寛・吉岡・石田・藤森・大庭等を引きつれ、観音様へお参りし、みや古へ落ちつき、生駒・只野など来て大いにのみ語る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時から小劇場で、十六日放送の「ハリキリボーイ」を本読み、三時半頃から大丸の内で一荘やり、ケタ／＼に負ける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑の王国楽屋で生駒・山野と話し、銀座へ出て、ヨーロッパおでんといさみずしへ寄り、有楽座で「一本刀土俵入」を見ようとしてると、ＪＯＡＫの小林・飛島以下文芸部の連中来り、僕作「ハリキリボーイ」が、逓信省から差止めを食ったと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「歌ふ弥次喜多」の藤沢のとこのけい古と、「ハリキリボーイ」をオケで合せて、チョン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一部のミュジクゴーラウンドは、僕ハリキリボーイを歌ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "穂積と近処で茶をのむ、とたんに「ハリキリボーイ」をかけられてくさる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「河内山」と「ハリキリボーイ」に決定。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」を早く書かう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は立石君に、丸ビルサラリマン生活見学の案内を頼んであるので十一時、家を出て、大阪信託へ行き、オフィスの陣立、月給支払日の光景等いろ／＼話をきく、すべて十月の「ハリキリボーイ」のためである。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」一景八枚書く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時頃から「ハリキリボーイ」を書きにかゝる、大体プランを立ってゐたので、すら／＼行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
