        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハウプトマンが始めに『日出前』や『さびしき人々』を出し、後に『沈鐘』や『ヒツパ、タンツト』や『ハンネレ』を出したのもそれがためである。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ハンネレフの昇天』の中にも、『ピツパ・タンツト』の中にも、また今年の新年の作中に評判になつてゐる武者小路実篤の『愛慾』の中にも、自然が生きて動いてゐるので、それで人の心を惹くのである。",
              "citation": {
                "source": "私の考へてゐる事",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "童話のなかの和製ハンネレが少しも動いてこない。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、私はハンネレのような淋しい少女はきらい。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも和製ハンネレを書かないことには、本屋さんはみとめてくれないのだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
