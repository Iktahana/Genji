          "literary": [
            {
              "text": "」と「十三往来」に記され、津軽平野北端の湖で、岩木川をはじめ津軽平野を流れる大小十三の河川がここに集り、周囲は約八里、しかし、河川の運び来る土砂の為に、湖底は浅く、最も深いところでも三メートルくらゐのものだといふ。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし手足の挙止が、内面の消息を形而下に運び来る記号となり得るならば、この二人ほどに長閑な母子は容易に見出し得まい。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬琴が壮時一室に籠って小説を考案中、下女が茶を運び来る。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "午過ぐる頃やうやうに母、飯を運び来る。",
              "citation": {
                "source": "明治卅三年十月十五日記事",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "母、夕飯を運び来る。",
              "citation": {
                "source": "明治卅三年十月十五日記事",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵卒ら、酒肴など運び来る。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "お登和や、早速ここへお膳を出したらよかろう」妹「ハイ」といって勝手へ往き下女と共に大きな食卓を運び来る。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何んにしろ世人がモット食物問題と衛生問題とに注意するようにならなければ国の文明が進まんさ」と頻に歎息しける時お登和嬢は日本料理の御馳走が出来たりとて食卓の上へ珍味｜佳肴を運び来る。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……主人、さすがに心得たるものにて、自動車より下ろしたる金剛杖を浄水にてきよめ、笠とゝもに床に運び来る。",
              "citation": {
                "source": "にはかへんろ記",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
