        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "新橋詰めの勧工場がそのころもあったらしい。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　かくして乗りつけたところは、いうまでもなく日本橋詰めの近江屋勘兵衛方です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴見の橋詰めには杉の角柱に大貫を通した関門が新たに建てられた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "景蔵はまた今の京都の空気が実際にいかなるものであるかを半蔵に伝えたいと言って、石清水行幸後に三条の橋詰めに張りつけられたという評判な張り紙の写しまでも書いてよこした。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伊十郎めに早く逢おう」　こうして足を早ませて、両国の橋詰めまで行った時に、向こうから一人の若い武士が、息をせき切って走って来たが、「おおこれは醍醐殿で」「伊十郎氏か、何か起こったか？",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "和泉橋の角まで行くと、橋詰めの火の番所。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつむき勝ちの、用ありげな足どり、通りすがろうとすると、向うは、橋詰めにさしかかりそうになったので、捕ものは川向うか、あらためて、同心から、みんなに訓示というわけだ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "邦之助が正気づくのを待っていろいろきいてみたが、数寄屋橋詰めで水戸の篁守人にあってすれ違ったからおおかたそのときに附けられたのだろうというが、篁守人という名だけは危険人物として聞いたことがあるが、文次は顔を知らない。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "……両国橋の橋詰めで、あいつに河へ追い込まれてからは、何彼につけて怖じ気がつき、やることなすこと食い違い……」　なお女房は祈っていた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "両国橋の橋詰めをめがけて、歩いて行く一人の老人があった。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この陰謀は大きいぞ　両国橋の橋詰めのほうへ、歩いて行く儒者ふうの老人を、「本郷の殿様」と呼ばれた武士は、疑念を差しはさんで見守ったが、足を止めるとつぶやいた。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "群衆を排して老儒者を追って、橋詰めのほうへ走って行く。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、誰かに追われてでもいるのか、さっき胸もとへぶつかって来た振り袖姿の町娘が、人波を分けてあわただしそうに、これも両国の橋詰めのほうへ走って行く姿が眼についた。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、まもなく両国橋の、橋詰めの擬宝珠の前まで行った。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が京に出て来て、五条の橋詰め・北野の東などに舞台を構へた時に、此等の大名たちは、直に其に目を止めた。",
              "citation": {
                "source": "ごろつきの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本橋詰めの店々では、その夜三越に火がついたときくまでは逃げようともしていなかった。",
              "citation": {
                "source": "地異印象記",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋詰の、あの大樹の柳の枝のすらすらと浅翠した下を通ると、樹の根に一枚、緋の毛氈を敷いて、四隅を美しい河原の石で圧えてあった。",
              "citation": {
                "source": "雛がたり",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋詰の小店、荒物を商う家の亭主で、身体の痩せて引緊ったには似ない、褌の緩い男で、因果とのべつ釣をして、はだけていましょう、真にあぶなッかしい形でな。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白木屋横手から、まず永代橋詰まで行くつもりで、その道筋の二つ目の橋を渡る手前にさしかかると、左の河並に横町がある。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "向う岸の橋詰に榕樹の茂みが青々として、それから白い尖塔が抽んでている背景が、橋を薄肉彫のように浮き出さすためであろうか。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしはぐれて迷子になったら、あの橋詰に立っていなさればよい、迎いに行きますよ」社長はこんな冗談を云った。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを思うと、俺は切なくてやり切れなくなるのだ」　ここで、逸作は橋詰の茶店に向って水を呼んで置いてから、喘ぎを続けた。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは周章てゝ、「あら、人のアラを見ちゃ嫌よ」　と言って押え隠しますのを追って突き倒すような語気で、「ばか、自分の膚なんか、ひとに見せるもんじゃない」　と言ったかと思うと、ちらりと庭の柴の橋詰の方を見ました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "久松橋の橋詰まで来ると、わたくしは足癖でひとりでに左の河沿いの方へ曲ります。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋詰を曲ったときから、浄瑠璃のサワリを弾いている音が聞えましたが、来てみると、わたくしの家の母の部屋からでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮒の雀焼の匂いの中を通り、橋詰の青柳を見返り、いそ／＼とさしかゝる千住の大橋、蓊※として川気の黄いろなさみだれ月のすみだ川。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だのに、いつか女乞食はわたくしの足音を雑音の中から聞分けるようになり、橋詰の土手へ躍り出て、狂乱の態で石を投げるのでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは土橋を渡ってその店の前を行き過ぎようとすると、橋詰からは斜に当る材木店の勝手口から顔を出して川を眺めていたご新造さんが「ちょいと／＼」と手招きして呼んで呉れました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "左岸の橋詰に一かたまり屯している鷺町の屋根の上に高く抽ん出て、この辺での名刹清光寺の本堂の屋根が聳えています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "対岸は、葭の上に横たえられた青い土手が見え、橋詰にごちゃ／＼している予田町の人家の裏が土手の上に塊まって覗いています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
