    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしアイコノスコープも発振器もどこもわるくなさそうである。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "無機物の集合体であるところの電波発振器は、空間へ電波を発射します。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビッグ・アイデアだよ」「あの籠みたいなものに、送影用のレンズや発振器装置などがついているんだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "気球に小さいラヂオの発振器をつけて飛ばし、その発信波長が気象状態の変化によってかわるのを地上で受信して、上層の気象状態を推測するという方法があるので、そういう気球も大分飛ばせてみた。",
              "citation": {
                "source": "雪後記",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
