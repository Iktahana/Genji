[
  {
    "uuid": "1a712dcb-7ff4-5658-b605-27dfae5b25e6",
    "entry": "飯米",
    "reading": {
      "primary": "はんまい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
