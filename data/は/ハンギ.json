[
  {
    "uuid": "8cc08a95-5465-54ea-a502-4615660cca7e",
    "entry": "版木",
    "reading": {
      "primary": "はんぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
