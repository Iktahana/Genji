        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「来週の何曜日に来るのです」「アハヽヽヽヽヽヽ」「あゝあたし彼方から廻る電車に乗りたかつたのに……」　彼が行かうとした停留場の間際まで来てＳ子はジラ半分にさう言つた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "おはまさんなんかかわいそうな所があるんだアな、同病｜相憐むというんじゃねいか、ハヽヽヽヽヽ」「あん畜生、ほんとにぶちのめしてやりたいな」「だれを」「あの野郎をさ」「あの野郎じゃわからねいや」「ばかに下等になってきたあな、よせよせ」　おはまがいるから、悪口もこのくらいで済んだ。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "おらこれでもお前に同情してるど、ウム人間はな、どんな事があっても元気をおとしちゃいけない、なんでも人間の事は元気一つのもんだよ」「兄さん、これでわたしだって元気があります」「アハヽヽヽヽヽそうか、よし一杯つげ」　省作も今日は例の穏やかな顔に活気がみちてるのだ。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "労働者はネ、選りどり自由ときてらア、ハヽヽヽヽヽ。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハヽヽヽヽヽ、左樣か、それは可かつた、左樣か、入りやんしたか、ハヽヽヽ。",
              "citation": {
                "source": "姉妹",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハヽヽヽヽヽ、これもお氣に入りやんしたらうね。",
              "citation": {
                "source": "姉妹",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハヽヽヽヽヽ」　一瞬の沈黙を破つてけたたましい笑ひ声が起つたと思ふと、弥生がもつくり半身を起して、狂気のやうに哄笑しながら、二三枚の札幣をつかんでビリビリ千切つた。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハヽヽヽヽヽヽ」　波子は、けたゝましく、笑ひしれる。",
              "citation": {
                "source": "波子",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヽヽヽヽヽといふ、突然部屋に爆風のやうな哄笑が起つた。",
              "citation": {
                "source": "孤独閑談",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヽヽヽヽヽ」と笑つて「こいつがねえ増田、いつか醉つぱらつて腰が立たなくなつてねえ、くす／＼泣き出しやがつて、其ざまつたら無かつた。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヽヽヽヽヽヽ」と言つて座蒲團以來むづ／＼してゐた溜飮を下げて五十嵐はカラ／＼と笑ふ。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヽヽヽヽヽと十風は三藏の初心なのを可笑しがつて又噴き出す。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其細君の顏を見て居た十風はハヽヽヽヽヽと最前來のと違つて又異樣な笑ひやうをする。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハヽヽヽヽヽ」　と団さんは哄笑一番痛快を極めた。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからともなく、きこえてくる、クスクスという、しのび笑い、それが、だんだん大きくなって、ついにワハハヽヽヽヽヽと、人をばかにした大笑いになりました。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハヽヽヽヽヽ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
