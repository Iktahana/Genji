          "literary": [
            {
              "text": "」「八重九重桜花姿絵」「五郎時宗、お定りだ。",
              "citation": {
                "source": "助五郎余罪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ではスミレとしては皆その花色の美とその花姿の可憐なのを愛でて香は一向に注意しない。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "観賞眼から梅の花に対してはその花色も花姿もまたその芳香も固より大切であるのに相違は無いが、またその樹態、枝勢ならびにその環境も大切であってこれが揃うて始めて一段とその価値が昂まる。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風は紋羅の浮織に人と草との舞のあや――ほのに映れる花姿、弱肩、それとさだめなく。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "細流ある所にいたれば紅唇粉面の哥妓紅て渉る、花姿柳腰の美人等わらじをはいて水をわたるなど余が江戸の目には最珍らしく興あり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
