        "examples": {
          "standard": [
            {
              "text": "恐怖で顔が青ざめ、鼻許に冷たい汗が流れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は子供が泣いているのを見て、鼻許を優しく撫でた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「鼻許がむず痒いな…。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "』と大きな声で叫ぶお千代、時によると鼻許り黒く塗つて、また時によると顔全体に壁の様に白粉を塗つて、袖の長い破れた着物を着て哀れな袋をさげて坊主頭をなでながら貰つて歩くお千代。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            }
          ]
