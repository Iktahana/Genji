[
  {
    "uuid": "dd8d69c7-a583-530f-abf8-26457640aa93",
    "entry": "晴れ晴れしい",
    "reading": {
      "primary": "はればれしい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "clear",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "入学式は、晴れ晴れしい雰囲気の中で行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の晴れ晴れしい表情は、成功を物語っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "晴れ晴れしい門出を祝うため、多くの人が集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "が、夏の終りに病後の一月餘りを過した時の事を思ひ浮べて、此處の晴れ晴れしい秋空を想像してはいけない。",
              "citation": {
                "source": "疑惑",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "年忌の営みは晴れ晴れしいものになるらしく、一箇月ばかり前から、熊本の城下は準備に忙しかった。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃彼は、小説を書き終へて晴れ晴れしい気持を味つたことがなかつたから――。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はこんな目もくらむような晴れ晴れしいものを見た事がなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体が、目に立つように晴れ晴れしいことや、華やかなことが、質素な新吉の性に適わなかった。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "小野は自分の花嫁でも来るような晴れ晴れしい顔をして、「どうだ新さん待ち遠しいだろう。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　新吉はこの晴れ晴れしい席に、親戚の者と言っては、ただの一人もないのを、何だか頼りなくも思った。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "毀ったあとへ新たにできた寝殿は晴れ晴れしいものになっているのであった。",
              "citation": {
                "source": "源氏物語",
                "author": "東屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「時々は晴れ晴れしい気持ちにもおなりあそばせよ。",
              "citation": {
                "source": "源氏物語",
                "author": "手習",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「すっかり晴れ晴れしい顔をいたしまして」「薄氷をふんで、ついに渡ってしもうた、か――松岡どの？",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボブは晴れ晴れしい顔附きでそれを注いでしまった。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、少なくともあの純情という紺絣を取り戻し、抱きしめ、初々しく身に着けている、何とも晴れ晴れしい心地がした。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリスマスに栄一が人形を与へてから、栄一が好きで毎日栄一の処へくるのであるが、今の先、義理の父が暴れ込んで来たことなどは、忘れてしまつたかのやうに、晴れ晴れしい顔して、栄一を見て笑つて居る。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやくの事春になって」と云って、晴れ晴れしい眉を張った。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも平常からあまり晴れ晴れしい眼ではない。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが出ないうちは証拠が揃わねえ」　平次は始めて晴れ晴れしい顔になりました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "赤い痣",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに彼女は、弟の晴れ晴れしい元気を、清い空気を、ことに休息を、深く楽しんでいた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雪は、晴れ晴れしい神主のことから、かえって暗い気持を、自分の胸に感得しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴慕の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしアメリカの映画のような晴れ晴れしい明るさとは違って、うっかりしていれば見過してしまうほど、何百年もの伝統の埃の中に埋まって佗びしくふるえている光だけれども。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、またうしろへ廻って、父の肩へつかまりながら、「あまり根気をつめ過ぎたんでございましょう、お父さんはもう筆をもつと、御飯も忘れていらッしゃるんですもの、だから、肩がこッて気がふさいで来るはずですわ」　わざと常のように、晴れ晴れしい声でそういって、幅の広い父親の肩をしなやかな指でもみ初めました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "西町奉行所の白州ははればれしい光景を呈している。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "西町奉行所の白洲ははればれしい光景を呈してゐる。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨去りぬ先づ縹草初夏の瞳を上げて喜びを云ふ　梅雨が上つていよいよ夏だといふはればれしい感じは恐らく凡ての草木の抱く所であらう。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここまで来ると、若い番頭も全く度胸が据わって、主人の死骸は、あたりへ穴を掘って、手際よく埋めてしまい、証拠に残りそうなものも、ゆっくりと整理して、かえってはればれしい気持で、あのたっぷりしたお内儀さんの面影だけを頭にうつらせて、胸を躍らせながら、甲州路に向いたのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と自分の部屋へ帰ると、はればれしい目でソーニャを見ながら、彼は口を切った。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにか、今日ばかりは、はればれしい旅ごこちがした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
