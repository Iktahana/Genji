[
  {
    "uuid": "4e564856-c4d3-5f96-b607-574d8a7d0e4d",
    "entry": "話しかける",
    "reading": {
      "primary": "はなしかける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
