        "examples": {
          "standard": [
            {
              "text": "定年退職後は、知人の手伝いなどの半端仕事をして日々を過ごしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "本格的な工事ではないが、庭の柵を直すような半端仕事を請け負った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "忙しい時期だったので、書類整理のような半端仕事でも助けが欲しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この居候連中は宿屋や酒場にいりびたって、使い走りをしたり、いろいろ半端仕事をして、台所の余り物や、酒場のおこぼれにしこたまありつこうという算段である。",
              "citation": {
                "source": "駅馬車",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            }
          ]
        }
