          "literary": [
            {
              "text": "「わたしどもの沙地の中には大潮の来る前に、たくさん跳ね魚が集って来て、ただそれだけが跳ね廻っています。",
              "citation": {
                "source": "故郷",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれたちの方の沙浜にゃ、潮がさして来ると『跳ね魚』がもうどっさり跳ねているぜ。",
              "citation": {
                "source": "故郷",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶉だの、跳ね魚だの、貝殼だの、※だの。",
              "citation": {
                "source": "故郷",
                "author": "魯迅",
                "note": "青空文庫"
              }
            }
          ]
