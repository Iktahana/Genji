    "definitions": [
      {
        "index": 1,
        "gloss": "to strain",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験会場は、受験者たちの緊張感が張り詰めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "静寂の中、弓の弦が張り詰める音が響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "交渉の場では、お互いの駆け引きでピリピリとした空気が張り詰めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "人目をつつむ苦しさに、鳴りを沈めた琴の絃、じつと哀しく張り詰める。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからこの山の神様がこれではいけないというのでいつも氷を張り詰めることにしたのである。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁の修覆と言つても塗替へるとなると大變であるから豫ての計畫通り壁土のやうな色をした洋紙で一面に張り詰める事を思ひ立つた。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "期待の永さと、短い間にひどく緊張して気をはりつめるせいで面会はくたびれた。",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇宙がこの部屋一ツになつたやうな緊張が、部屋いつぱい、はりつめる。",
              "citation": {
                "source": "散る日本",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "蕾蓮の蕾のはなびらは、なかふくらみの紅いすぢ、さざなみ立てそ、月夜には、蕋のにほひも張りつめる。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "生まれんとする者は胎内に張りつめる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "“SORI-BATTEN!”TONKA JOHN の不思議な本能の世界が魔法と、長崎と、和蘭陀の風景に思ふさま張りつめる…………食慾が躍る。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "心を張りつめる不安を追って行くと、不安は暗の裡で無限に拡り、なほ子の心を震わす程強かった。",
              "citation": {
                "source": "白い蚊帳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "否却って酒を飲むと益々私の心は悲痛なものに張りつめるを常とした。",
              "citation": {
                "source": "運命のままに",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "第九「青貝の間」は十七畳、第十「檜垣の間」は檜垣の襖、第十一「緞子の間」は緞子を張りつめる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう明るい太陽が、それでも尚朝の潤ひを帯びて、張りつめるやう山一杯にかんかんと照り、二人を汗にぐつしより濡らした。",
              "citation": {
                "source": "黒谷村",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "風に押し戻されるため、アーチの張り出していく速度はいつもよりわずかに遅く、そのためにアーチの内部に粘りのあるパワーが張りつめる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですが、その怒れる声の張合いもなく、向うの気配はシーンとして、ただ氷の如く張りつめる殺気と人の動きだけが観てとれる。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "底知れぬ危機に直面し、神経がピンと張りつめるとともに、散々痛めつけられたあの男の顔が真っ青で、動揺していることを見逃さなかった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "内地では根太や框の上に板を張りつめるのが普通であるが、此処では根太や框の間に一尺から一尺五寸幅ぐらいの板を切って張りつめる。",
              "citation": {
                "source": "全羅紀行",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こんな風に、互に相手をなるべく悪く思つて、さう思つて気を張りつめることに依つて暮してゐた。",
              "citation": {
                "source": "質屋の小僧",
                "author": "宇野浩二",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い功名心が、脈々と、肋骨のうちに張りつめる。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
