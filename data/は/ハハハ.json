    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「おんちゃんごはんおあがんなさいって」「おはんなさいははははは」　父は両手を回し、大きな背にまたふたりをおんぶして立った。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　（四辺を見廻す様にして）はははは。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　あははははははは………嘘だわ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　ははは、そんなに叮寧に訊かれちや、何にも言へなくなる。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　ははは、みんな冗談。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」てれ隠しに、甚だ唐突な詩句を誦して、あははは、と自らを嘲った。",
              "citation": {
                "source": "竹青",
                "author": "――新曲聊斎志異――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはははは、とひとりで笑ってみたい気持だ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人をだましていい生活をするほど悪がしこくないから、だんだん追いつめられて、あんなばかげたことをして、二円、三円を強奪して、そうして五年も十年も牢へはいっていなければいけない、はははは、おかしい、おかしい、なんてこった、ああ、ばかばかしいのねえ。",
              "citation": {
                "source": "燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "相模守さまは、あはははと愉快さうにお笑ひになり、おそれいりました、と言つて退出なさいましたが、下々の言葉でいへば、あざやかに一本やられた、といふところでもございませうか。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口からあふれるほど一ぱいのお客が押し合いへし合いしながら立って見ていて、それでも、時々あはははと声をそろえて笑っていた。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ははははは……」　青木さんはうつろな声で笑つた。",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "千円かの無尽にあたつて発狂したといふおぢいさんが……」「はははは、僕達はそんなに※が小さかあない。",
              "citation": {
                "source": "夢",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こないだ女中殺しのあつた……」「ははは、物騷な方か……」と、引き取つて咳き、水上さんが顏を笑ひ崩した。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ははははは、それが何より。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はははは、奥さんのお仕込みだろう。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "桃六　むむ、見える、恥しそうに見える、極りの悪そうに見える、がやっぱり嬉しそうに見える、はっはっはっはっ。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "うわっはっはっは」　私は苦笑し、お茶を注いで出した。",
              "citation": {
                "source": "親友交歓",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はっはっは、面白いさ。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっはっは、いや迷惑したよ。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっはっは、どうだ、もっともそれはおれのように勢力｜不滅の法則や熱力学第二則がわかるとあんまりおかしくもないがね、どうだ、ぼくの軍隊は規律がいいだろう。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「わっはっはっは、わっはっはっは、ホッホウ、ホッホウ、ホッホウ。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はっはっは、ジッコさんといふのは磁鉄鉱だね、もうわかったさ、喧嘩の相手はバイオタイトだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はっはっは、ジッコさんというのは磁鉄鉱だね、もうわかったさ、喧嘩の相手はバイオタイトだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はっはっは、山男が薪をお前に持って来てくれたのだ。",
              "citation": {
                "source": "祭の晩",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はっはっは、いや、ありがたう。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（銭、五貫より、その方が割じゃぜい――はっはっはっ。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっはっはっ……』『黙ってお聞きなさいよ。",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっはっはっ……』『あら！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はっはっはっ、Ｐ公はどげんどんしたかな。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっはっはっはっ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
