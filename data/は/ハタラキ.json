[
  {
    "uuid": "e1e0fc7d-7124-5f55-823f-a038d690b397",
    "entry": "働き",
    "reading": {
      "primary": "はたらき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
