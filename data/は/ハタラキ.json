      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "work",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この会社の働き方は、社員の意見を尊重している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "定年まで働き続けることが、私の目標です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の働きは、チームにとって不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "何故なら、個性といふものが、独自の働きをするものであるからは、対人圏に於て、或ひは人中に於て、所謂「パツとしたもの」、則ち雄弁なものではないからだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて私は、もはや外界をしか持つてゐないのだが、外界をしかなくした時に、今考へてみれば私の小心――つまり相互関係に於いてその働きをする――が芽を吹いて来たのである。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何よりも彼はもと善良な人で、その善良は今も依然存するが、彼の善良は働きを失つてゐる。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "また「上風に」のに、「音なき麦を」のをが、てにをはとしての重要な働きをして、句の内容する象景を画いてることは言うまでもない。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狸の働き振りを見ると、一心不亂どころか、ほとんど半狂亂に近いあさましい有樣である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ひて、迎へられんとには非ず、従ふことのみ学びとなるべく、学びて汝が品格を高め、そが働きの裕かとならんため！",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし氷河を欠いた日本アルプスには、それほど雪の働きを示さないから、岩石は鋭い山稜や、尖った峰となって、粗硬な形態を示している。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "構いませんわ、あの人は気象の確かりした人ですから、きっとそれ相当な働きをしますわ。",
              "citation": {
                "source": "セメント樽の中の手紙",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "三台のポムプは、昼夜間断なくモーターを焼く程働き続けていた。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、今回の津浪の時に働き盛り分別盛りであった当該地方の人々も同様である。",
              "citation": {
                "source": "津浪と人間",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "懐疑、躊躇、不信、探りごころ――こういう寒雲の翳は、冥通の取持つ善鬼たちが特に働きを鈍らす妨げのものであった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "西国の山にかけては冥通自在な翁も、東国へ足を踏み入れ東国の山に対するとき、つい不勝手な気がしてその冥通の働きをためらわした。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁に僅に残っている頭の働きはこういうことを考えている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁の頭の働きはやや現実に蘇って来る。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分を自分から離して、冷やかに眺めて捌き、深く自省に喰い入る痛痒い錐揉みのような火の働き、その火の働きの尖は、物恋うるほど内へ内へと執拗く焼き入れて行き、絶望と希望とが膜一重となっている胸の底に触れたと思ったとき、自分はまた裂けた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "母はやや老い、筑波の岳神の家では、働きものの水無瀬が主婦のような形になっていた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が自分の母屋を和洋折衷風に改築して、電化装置にしたのは、彼女が職業先の料亭のそれを見て来て、負けず嫌いからの思い立ちに違いないが、設備して見て、彼女はこの文明の利器が現す働きには、健康的で神秘なものを感ずるのだった。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「陰の電気と陽の電気が合体すると、そこにいろいろの働きを起して来る。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな身の毛のよだつような男にしろ、嫉妬をあれほど妬かれるとあとに心が残るものさ」　若い芸妓たちは「姐さんの時代ののんきな話を聴いていると、私たちきょう日の働き方が熟々がつがつにおもえて、いやんなっちゃう」と云った。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに不思議なことはこの東海道には、京へ上るという目的意識が今もって旅人に働き、泊り重ねて大津へ着くまでは緊張していて常にうれしいものである。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女も男と同じように働き、学び、考える時代となり、尚上述の条件を男子側より否定されるならば、永遠に、女性の生命は内面の不平を堪えて男子を羨み続けるでありましょう。",
              "citation": {
                "source": "女性の不平とよろこび",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッシー通りで夫婦｜揃って食料品店で働き抜いた五十五、六の男の自然に枯れた声も秋風のなかにふさわしい。",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし家の内では実に私は一平の召使のような働きをする時がいくらもあるのですから。",
              "citation": {
                "source": "家庭愛増進術",
                "author": "――型でなしに",
                "note": "青空文庫"
              }
            },
            {
              "text": "また仮りに『文藝春秋』五月号を開いてみても大臣または大臣級の人たちが「労働者はない、しかるにメンタルの働き手というものは余っているという訳だな。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば「落体がある場所で九・八メートル／秒秒の加速度をもって垂直に落下する」というのでも、実は地球の重力のみ働き空気の抵抗や電気磁気などの作用がないとした場合の事である。",
              "citation": {
                "source": "物理学実験の教授について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はまだこれからが働き盛りである。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯の如き奇抜な働きをやっても当時窃にしたことで、人に話してほこりもせず、独無邪気ないたずら童子の頭に記臆された許りであった。",
              "citation": {
                "source": "井戸",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらっぽい刺撃の強い趣味の歌とは全くその味いを異にしてるのであるから、読者の方でもこういう歌を味おうとするには、気を静め心を平かにして、最も微細な感能の働きに待たねばならない。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この平凡な一句がここに置かれて生きて来るのみでなく、一首全体に統一を促し生命を起すの働きが出て来たのである。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔まひるつとめにまぎらひて〕宮沢賢治まひるつとめにまぎらひてきみがおもかげ来ぬひまはこころやすらひはたらきしそのことなにかねたましき新月きみがおももちをつきの梢にかゝぐれば凍れる泥をうちふみてさびしく恋ふるこゝろかな",
              "citation": {
                "source": "〔まひるつとめにまぎらひて〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
