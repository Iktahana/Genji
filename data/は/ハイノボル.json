          "literary": [
            {
              "text": "「朝顔や手ぬぐい掛けにはい上る」という先生の句があったと思う。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "食卓の上にはい上る。",
              "citation": {
                "source": "父と子供たち",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　へちまの芽が出て、銀色のなよなよとしたつるが、姉の立てた棒にはい上るころには、正雄は、町の工場で、機械のそばに立って、働いていました。",
              "citation": {
                "source": "へちまの水",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人は下に待合せながら、まるで蟹が石垣をはい上る様だと思った。",
              "citation": {
                "source": "一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
