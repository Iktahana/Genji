        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハタハタハタ、ハタハタハタと、方向が変えられた幾個の帆は風を孕んで靡いたが、筏船は素早く方向を変え、街道筋の方へ辷り出した。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハタハタハタ……ハタハタハタと、夜風に靡く五月幟の、音ばかりが聞こえてくる。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハタハタハタハタと羽搏きしながら森の隙間を翔け廻わっていたが、またスーッと帰って来たかと思うと空洞の中へ隠れ去った。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とまたあま戸へあたる音、ハタハタハタとやわらかい。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "火気に煽られて陣幕の裾が、ハタハタハタハタと鳴っている。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
