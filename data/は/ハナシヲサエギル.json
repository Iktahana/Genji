        "examples": {
          "standard": [
            {
              "text": "彼が真剣な話をしている最中に、友人が無神経にも話を遮ったので、場の空気が凍りついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先生が説明している途中で質問するのはよくないが、どうしても話を遮って聞きたかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ちょっと待って！」と、彼女は興奮して彼の話を遮り、自分の意見を述べ始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」この詞を、フィンクは相手の話を遮るように云って、そして心のうちでは、また下らないことを云ったなと後悔した。",
              "citation": {
                "source": "白",
                "author": "リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
