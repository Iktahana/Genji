[
  {
    "uuid": "4dd6ccfe-f143-5830-8fb2-7659db78cd59",
    "entry": "ハツキ",
    "reading": {
      "primary": "はつき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
