          "literary": [
            {
              "text": "がハーノツクとオーアどちらを開くかが問題になつた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "宣教師は曾つてハーノツクを異端だから用心しろと云つて居たからハーノツクを開く事にしようかと思つたがハーノツクは五冊に成つて居る。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しハーノツクのは厚いだけ実がある。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハーノツクの方はスベ／＼の紙で印刷がハツキリして居る。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "え、ハーノツクにせえ、実のある方を』とオーアをブツク・ケースに押込んで頭を抱へてハーノツクを読み初めたが、『之を読んで何にする？",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハーノツクを読んで居ると鶴子に云うたら鶴子は「あなたは学者だ」と云つて接吻の一つもして呉れようが、もう鶴子も広島へ行つて終つた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ハーノツクの『教理史』から得た事は何？",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            }
          ]
        }
