        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "渡辺はま子の「トンがらかっちゃダメよ」のＢ面について話す、「トンガラかっちゃダメよかい」といふのをテストしてみたがピンと来ないので、「ハリキリボーイ」といふのを考へた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビクターへ、ダレてばかりもゐられないので行く、「トンガラかっちゃ」Ｂ面用「ハリキリボーイ」が出来て鈴木静一がけい古して呉れた、これはよろしい、演歌調でいける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木静一曲の「ハリキリボーイ」オーケストラ入りのけい古、歌も自信がついた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」の吹込みである、昨日の声より悪いと言はれ、牛乳のんだりして、漸く二時半頃終る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣＬの永見来り、「大洋の寵児」について打合せ、放送局の小林氏来り、十六日は書き卸しをといふ注文、「ハリキリボーイ」と「まんざら悪くない」を入れてオペレットを書く約束した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "放送局へ「ハリキリボーイ」を届け、それから浅草へ行きたくなり、林寛・吉岡・石田・藤森・大庭等を引きつれ、観音様へお参りし、みや古へ落ちつき、生駒・只野など来て大いにのみ語る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時から小劇場で、十六日放送の「ハリキリボーイ」を本読み、三時半頃から大丸の内で一荘やり、ケタ／＼に負ける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑の王国楽屋で生駒・山野と話し、銀座へ出て、ヨーロッパおでんといさみずしへ寄り、有楽座で「一本刀土俵入」を見ようとしてると、ＪＯＡＫの小林・飛島以下文芸部の連中来り、僕作「ハリキリボーイ」が、逓信省から差止めを食ったと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「歌ふ弥次喜多」の藤沢のとこのけい古と、「ハリキリボーイ」をオケで合せて、チョン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一部のミュジクゴーラウンドは、僕ハリキリボーイを歌ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "穂積と近処で茶をのむ、とたんに「ハリキリボーイ」をかけられてくさる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「河内山」と「ハリキリボーイ」に決定。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」を早く書かう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は立石君に、丸ビルサラリマン生活見学の案内を頼んであるので十一時、家を出て、大阪信託へ行き、オフィスの陣立、月給支払日の光景等いろ／＼話をきく、すべて十月の「ハリキリボーイ」のためである。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」一景八枚書く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時頃から「ハリキリボーイ」を書きにかゝる、大体プランを立ってゐたので、すら／＼行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」の本を渡し装置家を横川と定め、狂言四つ決定。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一の川島のは「山に呼ばれて」といふのを「海抜三千尺」と直し、二を「ハリキリボーイ」三に中野実の「彼女をめぐる」四が「ギャング河内山」菊田が目下書いてゐる他皆揃ったわけ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイはサラリーマンのバイブルだ、音楽入りのテキストだ」なんてのは傑作だらう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二「ハリキリボーイ」を自分で読む。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼女をめぐる」「ハリキリボーイ」「河内山」と読み合せをして行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリキリボーイの歌と、「歌ふ弥次喜多」道中日記の一頁を立つ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」は、今迄僕の書いたものゝ中ではかなり変った味のものだ、当るか何うか心配になる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリキリボーイを歌ふ、受ける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "横宝劇場で二時半から、第一部の歌、ハリキリボーイを歌ふ、受ける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "山水楼のやきそばだけで腹をこしらへ、夜十時頃から「ハリキリボーイ」にかゝった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "序終って、二の「ハリキリボーイ」狙ひどこが、いろんな手違ひで外れた、第一音楽がひどい、まるで小さな音しか出ない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハリキリボーイ」は、段々うけるやうになった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "井上の女中が「ハリキリボーイ」の歌を絶讃する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣＬの滝村来り、三月の撮影は「歌ふ弥次喜多」よりも「ハリキリボーイ」にしたい由。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
