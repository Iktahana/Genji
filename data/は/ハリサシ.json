        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "裁縫箱の中から、カラフルなビーズで飾られた針刺しが出てきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "祖母が使っていた古い針刺しは、たくさんの針で埋め尽くされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "sewing kit (裁縫道具) の中には、便利な針刺しも含まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "が、針で針刺しの布を激しく突きながら黙つてゐると、「杓子顔や。",
              "citation": {
                "source": "悲しめる顔",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はい」　針刺しへ指をとめて、「お茶でございますか」「いいや、つかぬことを伺うが、床の御風雅、御主人は、俳諧でもおやりかの」「左様でござります。",
              "citation": {
                "source": "雲霧閻魔帳",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでその長い竿を針といい、今でも沖繩などではこの助手の役を針刺しとよんでいる。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ええ、いま」　彼女は、針を針刺しに。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして初祖以来、世々の群禅の末孫たちのうちには、解明のかぎをつかんだものも少なくはあるまいが、それはみな彼らの山房林室のうちにとどまり終って、ついに衆生のうちには、やはりさしたる影響ももたらさなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "針さしから手頃の針を抜き取り、針先を頭の髪の毛へ突き込んで油をにじませた。",
              "citation": {
                "source": "過去世",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それにの、刃物を刺すといや、針さしへ針をさすことより心得ておらぬような婦人じゃあなかった。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お作は十二時を聞いて、急に針を針さしに刺した。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんは僕を見ていて思わず笑おうとなさったが、すぐ心配そうな顔になって、大急ぎで頭にさしていた針を抜いて針さしにさして、慌てて立ち上って、前かけの糸くずを両手ではたきながら、僕のあとから婆やのいる方に駈けていらしった。",
              "citation": {
                "source": "碁石を呑んだ八っちゃん",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本風の紅絹の針さしだの鋏だのがちらばっていて、そのかたわらに一冊の本がきちんとおいてある。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで育っている学生たちは、自分たちだけに満足して、世の中にどっさり存在している不幸について、想像力をはたらかすことさえ知らないのでしょうか」　書いている自分の肱で、紅絹の針さしを床におとしてしまったのにも心づかないで、伸子はつづけた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "長椅子から立って来るとき、伸子は、テーブルのわきに落してしまっていたのを知らずに、紅絹の針さしを靴の先でふみつけた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　いそいでひろいあげて、伸子は紅絹の針さしについたかすかな跡をはらった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かあいそうに――」　針さしをテーブルの上へおき、ベッドから紫の羽織をとって袖をとおしながら伸子は室を出た。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい枕屏風にかこまれて、針さしのように膨れ上った赤い蒲団がある。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老嬢の自覚を心ねたく思う女は、決して針さしに手を触れないがよろしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "元気はいいが、もう萎びてしまった彼らの女房たちは、ひだのついた帽子をかぶり、胴の長いガウンを着て、手製の下衣をつけ、鋏や、針さしやら、派手なキャラコの袋を外側にたらしていた。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "そっとといてみると、中は針さしでした。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　が、針さしの下に着けてある名刺を読んだ時には、セエラは何だか狐につままれたような気がしました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんまに恐ろしやの、目の子の玉に針さしたりして、えい目もつぶれろぞ思いますけんど、何せ日本でも名高い医者のいうことじゃというし。",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれは針さしさ」と三番目のがいいのけた。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "……浜から取立てを茹上げて持出すのだそうで、女護島の針刺といった形。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
