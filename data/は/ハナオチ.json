      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "the part of the fruit from which the flower has dropped",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ミニトマトの花落ち部分が黒くなっているのは、カルシウム不足のサインだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "収穫したばかりのキュウリは、まだ花落ちが新鮮な緑色だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このリンゴは花落ちがきれいに閉じているから、虫が入る心配が少ない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "人｜若し良く草木を観察したならば、花開き花落ちるのも葉が翠になるのも黄ばむのも、一切の現象はただ天地の気の動きの姿であることを知って、一切庶物に気が働いているというよりは、気の中に一切庶物が存在していると云った方が適切なのを感じるであろう。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "苗の時から、花落ちの時から、いろいろ苦心して育てた奴が、一日一日に膨大して、とうとうここまで、一貫目以上もあろうというところまで大きくなったのだから、父が上機嫌で破顔微笑するのも無理はない。",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから花落ちの時には、ツケギで立札をして、その月日を記しておくのだから、およそ何日間であったか、それは忘れたけれども、大体成熟の日取りになって、父が小首を傾けながら爪の先で弾いて見る。",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "又　　樂府憶江南調同遊地　　　　　　同に遊びし地、寂寞憶君時　　　　寂寞君を憶ふの時、孤影龍鐘空曳杖　　孤影竜鐘として空く杖を曳けば、百花落盡一溪遺　　百花落ち尽して一渓遺り、水嗚咽風悲　　　　水嗚咽して風悲めり。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "又　　雙調憶江南春已逝　　　　　　春已に逝き、花落割愁腸　　　　花落ちて愁腸を割く。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨後花落ちて啼鳥を聴く。",
              "citation": {
                "source": "わが家の古玩",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「花落ちて三週間、果実の表面が白粉を帯びる。",
              "citation": {
                "source": "天主閣の音",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "綿帽子｜脱っての心細さ、たよりなさを覚えているほどの姑、義理にも嫁をいじめられるものでなけれど、そこは凡夫のあさましく、花嫁の花落ちて、姑と名がつけば、さて手ごろの嫁は来るなり、わがままも出て、いつのまにかわがつい先年まで大の大の大きらいなりし姑そのままとなるものなり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "山茶花落ちて風漸く寒し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "花落ちて樹は烟の如く草は蓐の如し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "日頃の用心もそのかいなく鳥｜啼き花落ちる頃に及んでかえって流行感冒にかかりつづいて雨の多かったためか新竹伸びて枇杷熟する頃まで湯たんぽに腹あたためぬ日とてはなく食事の前後数うれば日に都合六回水薬粉薬｜取交ぜて服用する煩わしさ。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりの寒さが、風花落ちかかる夜更けの街から街を慄えていく寒念仏の辛い境涯が、そのまましきりにいま自分の上にあてはめて考えられてきた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし仔細にみると、二箇の大茄子の重量感といい、花落ちの実や花の異様なモザイク風な描線の組み方といい、尋常でない画人の風戯であることはすぐわかる。",
              "citation": {
                "source": "雪村筆「茄子図」",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花落ち花咲く春秋の姿を見て、これが文化の盛りだ、文化の進歩だと考へるならば、その文化は老齡に入つて行く證據である。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽長はなおちょっと待った。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリストフはなおちょっと彼を見守った。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼はなおちょっと言葉を切ったが、また言い出した。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "人若し能く草木に於て諦觀したならば、花開き花落つるも、葉の翠に葉の黄ばむも、一切の現象はたゞ天地の氣の動の姿たるに止まるを知つて、一切庶物に於て氣が働いて居るといふよりは、氣の中に於て一切庶物が存して居ると云つた方が適切なのを感ずるであらう。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣かゆるに日は照り暑し湯気立てて蟶を今｜釜に煮沸す照る砂に雷管のごと花落す朱欒一木が老いてお庭に棟瓦千石船の朱と碧は正目仰ぎて深き雑草鍋二つ汲水場に伏せて明らけき夏真昼なり我家なりにし白栄に蛇奔る裏堀は水紋の動き光とありつつ我が書斎たりし隠居家は、なほ遺れども、既に久しく鎖しぬ。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "花笑ふ時に我も笑ひ、花落つる時に我も落つ。",
              "citation": {
                "source": "万物の声と詩人",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、花開き、花落つる間、今年の人は去年の人ならず。",
              "citation": {
                "source": "小金井の櫻",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "――楊花落尽子規啼。",
              "citation": {
                "source": "鴉片を喫む美少年",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "広島に帰り母を奉じ京師に入り西遊の行を終り更に母を伴ふて嵐山に遊び奈良芳野の勝を訪ひ侍輿百里度、花落南山万緑新、筍蕨侑杯山館夕、慈顔自有十分春の詩あり、終に送りて広島に還る。",
              "citation": {
                "source": "頼襄を論ず",
                "author": "山路愛山",
                "note": "青空文庫"
              }
            },
            {
              "text": "時多遅花落在于井中。",
              "citation": {
                "source": "貴種誕生と産湯の信仰と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してあゝ、翠帳暖に春宵を度るの処、膏雨桃李花落つるの時、松殿の寵姫と共に、酔うて春に和せる往年の栄華、今はた、何処にかある。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日より、滝のほとりに、ささやかな安居の地を求めて、そこへ飛花落葉を積み重ね、正身の座を構えると共に、心神をすまして音なしの音を聞かんとすることが、この法師の早天暁の欠かさぬつとめ、世間は暫く彼の広長舌から免れるの自由を得ました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は余りに数理的なる西洋音楽の根本的性質と、落花落葉虫語鳥声等の単純｜可憐なる日本的自然の音楽とに対して、先づその懸隔の甚だしきに驚かずんばあらず。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一花落つれば、一花開き、五月を過ぎて六月｜霖雨の候に入り花始めて尽く。",
              "citation": {
                "source": "来青花",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜花落尽して満山の新緑滴るが如し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜花落尽して新緑潮の如し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
