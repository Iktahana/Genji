  {
    "uuid": "4d4c7ac3-4e15-5588-b674-9b739559512d",
    "entry": "花落ち",
    "reading": {
      "primary": "はなおち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
