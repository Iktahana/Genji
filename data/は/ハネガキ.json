        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いろいろな種類がこうして啼き立てたり、泳いだり、ぱたぱた羽掻きをやったりする眩しさは、その一羽ずつの美しい観賞を削いだばかりではなく、人間的な、どこかで出会ったある夜の群衆を思わせた。",
              "citation": {
                "source": "或る少女の死まで",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを私と同じように童子の顔がさしのぞき、すばやい小鳥の羽掻きをながめていた。",
              "citation": {
                "source": "童子",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "日はやや西に傾いて赤とんぼの羽がきらきらと光り、風なきに風あるがごとくふわふわと飛んでいる、老人は目をしばたたいてそれをながめている、見るともなしに見ている。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭におりて見ると杉の梢にも蜻蛉の羽がきら／＼と光つて見えた。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "誠さんが捨てたとんぼや、せみが、もちで羽がきかなくなって、飛んでいけずに庭の地面に落ちていると、春子さんが見つけて、すぐに、げたをはいて庭へ出て、それを拾い上げました。",
              "citation": {
                "source": "玉虫のおばさん",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
