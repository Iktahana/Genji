[
  {
    "uuid": "57143bb3-0d3d-5eb9-ae25-1b8465df2dd6",
    "entry": "発事",
    "reading": {
      "primary": "はつじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
