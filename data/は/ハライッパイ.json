        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "久しぶりの休日は、一日中好きなことを腹いっぱい楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夏休みは、海水浴で腹いっぱい泳ぐ予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は子供の頃から、漫画を腹いっぱい読むのが夢だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
