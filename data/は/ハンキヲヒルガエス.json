        "examples": {
          "standard": [
            {
              "text": "彼は長年仕えてきた社長の独裁的なやり方に耐えかねて、ついに反旗を翻した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "地方の領主たちが中央政府の重税に反発し、次々と反旗を翻して立ち上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "党内の若手議員たちが派閥のリーダーに対して一斉に反旗を翻すという前代未聞の事態になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "僅の間隙でも生ずれば――そこに彼等は自由を望んで反旗を翻すことは火を見るよりも明かなことではありませんか。",
              "citation": {
                "source": "悲しき項羽",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "威光に恐れて、すくんではいるものの、いざとなれば反旗を翻す連中がずいぶんいるので、事件はますます拡大してしまったのである。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり彼は自分の犯罪によって、単に人間に対してのみならず、キリストの教会に対しても反旗を翻すことになるじゃありませんか。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてついには、おまえにそむいて自由の反旗を翻すに違いない。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリガーセンに反旗を翻すのに時間はかかりません」「それはいいことですよ。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
