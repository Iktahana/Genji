[
  {
    "uuid": "1aec60e5-a8f0-5510-a1e9-58c334445da0",
    "entry": "初めて",
    "reading": {
      "primary": "はじめて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
