          "literary": [
            {
              "text": "前方にハリッチ市が見えてきた。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれこそ、余が最初、派遣を願い出でたるハリッチ海軍根拠地のあるところであった。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、これではハリッチの海岸にのりあげそうである。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだか、余の気が、船をハリッチの方へ持っていくように感ぜられて愉快である。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（×月×日、ハリッチ発）　ハリッチ発などと書くと、余が、とうとう初一念を貫いて、ロンドン上陸後、このハリッチへ来たように邪推するであろう。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
