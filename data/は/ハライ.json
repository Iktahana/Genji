  {
    "uuid": "0a425638-690c-5f60-9bf5-5c0e951cb9d9",
    "entry": "はらい",
    "reading": {
      "primary": "はらい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
