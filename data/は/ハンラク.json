        "examples": {
          "standard": [
            {
              "text": "急騰した株価は、買いが一巡すると反落に転じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "原油価格は一時的に上昇したが、その後、反落して元の水準に戻った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "不動産市場では、需要の減少に伴い価格が反落している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "十月一日に発表されたこのパンフレットは二日の株式市場の諸株を反落せしめた。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、前の棒切れが反落してくるのと一しょに、クロの巨影もそれにつれて真一｜文字に地へ降りてきた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
