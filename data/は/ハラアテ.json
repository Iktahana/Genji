        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "中世の騎士が身につける腹当ては、敵の攻撃から身を守る重要な防具だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "博物館には、精巧な装飾が施された古い腹当てが展示されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ゲームのキャラクターは、光り輝く腹当てを装備して敵に立ち向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
