    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "向岸の水際に破れた檜笠と草鞋が半足ある、そいつが馬鹿に陰氣に見えるのだつた。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年半足らず暮して見た離座敷の南側にある窓の雨戸の透間の薄明るくなったのが彼の眼に映った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレアンダ――ヤールタの西南一里半足らずにある公園地。",
              "citation": {
                "source": "犬を連れた奥さん",
                "author": "DAMA S SOBACHKOI",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞこれによりて、印度に起つた大乘佛教の思想が南方支那を見限つて北方支那に移り、北方支那にも僅に履半足だけを殘して再び流沙葱嶺の西に歸つたと云ふことで、西暦第六世紀の前半には、南北支那いづれも大乘相應の國でなかつたことを認知すれば、それでよろしいのであります。",
              "citation": {
                "source": "金剛智三藏と將軍米准那",
                "author": "榊亮三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "親分さんと二人押し掛けて名乘りをあげたら、萬に一つも取逃すやうなことはないでせう」「――」「此處からほんの一里半足らず、敵を討つても夜中までには歸つて來られます」「歸つて來る？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お局お六",
                "note": "青空文庫"
              }
            },
            {
              "text": "親分さんと二人押し掛けて名乗りをあげたら、万に一つも取逃がすようなことはないでしょう」「…………」「ここからほんの一里半足らず、敵を討っても夜中までには帰って来られます」「帰って来る？",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お局お六",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人の草鞋をたった半足盗んだばかりで、罪せられて打首になった。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
