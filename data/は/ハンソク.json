  {
    "uuid": "f52909dd-53dd-5803-a251-573f01d08fa0",
    "entry": "半足",
    "reading": {
      "primary": "はんそく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
