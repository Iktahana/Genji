        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さてユダヤ人の中にハバカクという一人の予言者がいて、スープを作り、入れ物の中にパンのかけらを入れて、取り入れの人たちに持つて行くつもりで野に入つて行つた。",
              "citation": {
                "source": "ベルとドラゴン",
                "author": "――経典外聖書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし主の使者がハバカクに言つた。",
              "citation": {
                "source": "ベルとドラゴン",
                "author": "――経典外聖書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はライオンの檻にいる」　そしてハバカクは言つた。",
              "citation": {
                "source": "ベルとドラゴン",
                "author": "――経典外聖書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてハバカクはこう言つて呼んだ。",
              "citation": {
                "source": "ベルとドラゴン",
                "author": "――経典外聖書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして主の使者はすぐまたハバカクを元の処に返した。",
              "citation": {
                "source": "ベルとドラゴン",
                "author": "――経典外聖書――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
