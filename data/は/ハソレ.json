        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "〈敵ハ幾万アリトテモ　スベテ烏合ノ勢ナラズ　烏合ノ勢ニ非ズトモ　味方ニ正シキ道理アリ　邪ハソレ正に勝チ難ク……〉二　万十郎は剣舞で練へあげた「満身の鉄骨と憂国の血涙」と自ら誇る五尺の体躯を（彼は丈が真実五尺であつたが、十七貫もあるといふ固太りの布袋であつた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、ヒラガナノ活字ハソレ自身ガ美シクナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗太郎の実父は私の母の従兄ですから、私もその風采を知て居ますが、ソレハソレハ立派な侍と申して宜しい。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソレデ直グ人々ヲ呼ンダノデアリマス」　検事が果してこの言を信じるだろうか、無論信じないわけはない。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ハ見タワケデハアリマセンガ、確ニ私ハソレヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其期限明言シ難キモ、来月五月一日ヨリ三ヶ月間若クハソレ以上ニ渉ル事アルベシ。",
              "citation": {
                "source": "編輯室より（一九一三年六月号）",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハボンコチヤンデイヤイヤモンコチヤンニカブサリマシタカラ、ソレハソレハオカシクミエマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、モンコチヤンノアタマニデキルダケカツカウヨクカブサリマシタカラ、ソレハソレハヨクニアフヨウニナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹ハソレヲキイテ噴キダシタ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歌にも寓意を考え、「此歌上句ハ佞人ナドノ官ニ在テ君ノ明ヲクラマシテ恩光ヲ隔ルニ喩へ、下句ハソレニ依テ細民ノ所ヲ得ザルヲ喩フル歟」（代匠記）等というが、こういう解釈の必要は毫も無い。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ヲ云ウト予モ彼女ノ食イ残シガ廻ッテ来ルコトヲ豫期シテ―――或ハソレガ今夜ノ目的デ―――コヽヘ来タノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時ハ非常ナ恐怖感ヲ伴ッタガ、今デハソレガ幾分楽シクサエアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚シタテハソレホドデモナカッタノダガ、コノ三四年目立ッテソンナ風ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハソレ以前カラモ時々自分ダケ茶ノ間デ寝テイタガ、ベッドニシテカラハ完全ニ別レ／＼ニ寝ルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハソレヨリモ、春久ト颯子トガドンナ工合ニ接触スルカ、ソノ様子ガ見タカッタノデアルガ、団欒ノ中ニ加ワッテカラ三四十分モシタ時分、次第ニ脚カラ腰ノ周リガ冷エテ来ルノニ心ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンニハソレガ相当ヨ」「セメテコウシテル間、シャワーヲ止メテ貰エナイカナ」「止メル訳ニ行カナイ、触ラレタ傍カラ直グト綺麗ニ流シチャワナイト気味ガ悪イ」予ハタヾ水ヲ呑マサレタ気ガシタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「仮リニ君ガ―――仮リニダヨ、―――春久トドウ云ウコトガアッタニシタッテ、僕ハソレヲ取リ上ゲル気ハナインダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚当座ノ浄吉ハ大シタ打チ込ミ方デアッタガ、今デハソレホドデナイコトハ確カダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ハソレニ後レルコト数年、昭和三年ニ死ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソレヲ取リ壊シテ近代建築ニ作リ直し、ソコニ今度ハワレ／＼ノ隠居所ヲ作リタイ考デアルガ、ソレニハ今日マデ婆サンガ反対シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハソレヲ自分ノ座席ノ隣ニスワラセ、ピッタリ体ヲ寄セ着ケテ乗ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽジャナイノ、折角楽シミニシテルンダカラ佐々木サンヲ行カシテオヤンナサイヨ」「君ハソレデイヽノカネ」「何デソンナコトヲオ聞キニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハソレデモヤヽ元気ナノデ少シ書ク気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソレニ答エテ云ッタ、彼女ト春久ト仲ガイヽコトハ予ガ知ッテイルバカリデナク、自分デモ公然ト云ッテイルシ、亭主ノ浄吉モ承知デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ知ッテイルヲ容易ニ口ニ出サナイノガ常デアルガ、悪イコトニハソレヲ女ノ嗜ミデアルトモ思ッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハソレヲ考エルト不安デモアリ、彼女ニ罪深イヲ好ムノデアル、―――ヲ刺戟シテ、ソレニヨッテ自分ヲ刺戟シヨウトスル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妻ハソレヲ口ニ出シタ※ハナイガ、ジェームス・スチュアートノ映画ダト缺カサズ見ニ行クラシイノデアル）モットモ妻ガ木村ニ接近スルノハ、僕ガ彼ヲ敏子ニ妻ワセテハドウカトイウ考エガアッテ、家庭ニ出入リサセルヨウニシ、妻ニソレトナク二人ノ様子ヲ見ルヨウニト命ジタカラナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前ガツイテ行クカラ悪イ、二人キリデ出シテミナサイ」ト云ウノダガ、妻ハソレニハ不賛成デ、母親トシテ監督スル責任ガアルト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
