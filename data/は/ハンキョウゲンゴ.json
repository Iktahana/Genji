        "examples": {
          "standard": [
            {
              "text": "彼は相手が言った言葉をそのまま繰り返す反響言語の症状を示した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "幼児期の発達において、一時的に反響言語が見られることは珍しくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "専門家は、その子供の反響言語がコミュニケーションの試みであると分析した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そのときは、じぶんがなにをしているかが明白と分っていながら、どうにも目のまえの人間の言葉を真似たくなり、またその人の動作をそのまま繰りかえす――つまり、反響言語、返響運動というのがおこる。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、反響言語のじつに奇怪なところである。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
