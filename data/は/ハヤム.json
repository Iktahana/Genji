          "literary": [
            {
              "text": "去年の十月、Ａが、中央公論に、オムマ・ハヤムの訳詩、並に伝を載せて、貰った金の一部で、三本の槇、一本の沈丁花、二本可なり大きい檜葉とを買った。",
              "citation": {
                "source": "小さき家の生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛するのも、自分が満足しなければ、自己を通さなければ、まるで手を引くと云う独〔後欠〕六月三日（日曜）晴　午前中、Ａ、オムア・ハヤムの清書。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハユキ、ワレハヤム、という打電だけで私は平常親友とまでゆかない間柄なのに、急速に宇野浩二に近づいていったのは宇野がもう生きていないことが、もとになっていた。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
