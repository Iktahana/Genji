          "literary": [
            {
              "text": "町のハシリガネを買つた男は、いちいち、駐在へ届けることになるらしいぜ。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――町へ行つて、ハシリガネにあぶら絞られるな。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、町へ行つて、ハシリガネと会ふのをやめてくれさへしたら、あたしは、夜だけお前のそばにゐればいゝ。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
