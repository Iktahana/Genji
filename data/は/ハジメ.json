        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏休みの始めに計画を立てたが、結局三日坊主に終わってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
