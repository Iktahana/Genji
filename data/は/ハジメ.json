  {
    "uuid": "c7f07cca-567e-5df3-9178-84d193d9134c",
    "entry": "創",
    "reading": {
      "primary": "はじめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
