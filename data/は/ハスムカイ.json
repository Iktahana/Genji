        "examples": {
          "standard": [
            {
              "text": "駅の改札を出て、はす向かいのカフェで友人と待ち合わせをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しいアパートは、コンビニのはす向かいにあって便利だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は私の席のはす向かいに座り、ずっとスマホをいじっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "市電の革屋町駅で降り、本通りと名付けられたこの通りを東に向かって歩くと、パチンコ店や高級食料品店が目に入り、その並びにブティックや書店があり、パン屋のアンデルセン本店のはす向かいには、何と小さな古書店がある。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
