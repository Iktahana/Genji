        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "悪天候のため、デパートは予定より早く早仕舞いを決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "今日は忙しかったから、お店を早仕舞いさせてもらうよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "早仕舞いして、早く家に帰ろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "坑夫だって人間である以上、早仕舞いにして上りたいのは、他の連中と些も違いはなかった。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに松の内は銀座は早仕舞いで酒飲みなんかあまり出掛けないと思ったもんだから」　明子は言い訳をした。",
              "citation": {
                "source": "越年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまに早仕舞いをしたときは銭湯へ行ってゆっくり手足を伸ばしてくるか、隣家の紺屋へ遊びに行って同じ郷生れの婆様から昔話をきくのが、このうえない安楽だった。",
              "citation": {
                "source": "鴻ノ巣女房",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あそこの焼芋屋は早仕舞いだからもう寝ているわよ」　母はじれったそうに荒っぽく言った。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "土曜日が早仕舞いだから、一時間と少しばかり寄進につく。",
              "citation": {
                "source": "四十不惑",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十二年八月三十一日即ち関東大地震の前日、蒲田の松竹撮影所に勤めている人が早仕舞いで家へ帰る途中、とある小さい池の水面に魚が躍ったり跳ねたりしている。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "早仕舞いとして、一杯飲もうか」「たまには、そんなことがあって、ようがすよ。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、早仕舞にしようじゃないか」　秋山と云う、ライナーのハンドルを握ってるのが、小林に云った。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう五尺は入っただろう」「そうさなあ、入ったかも知れねえな」「早仕舞にしようじゃないか」「いいなあ、ハムマーの連中にそう云おうかなあ」「だが、ダイの仕度は出来てるかい？",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "――姉さんが来て、今日は火が燃える、大火事があって危ないから、早仕舞にしてお帰りなさい。",
              "citation": {
                "source": "朱日記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、いつも学校の帰りには此二人の事を考え考え帰るのだが、或日――たしか土曜日だったかと思う、土曜日は学校も早仕舞なので、三時頃にそうして二人の事を考えながら帰って見ると、主人夫婦はいつも茶の間だのに、其日は茶の間に居ない。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "松の内｜早仕舞の銭湯におひねりを置いてゆく人も少いので、番台の三宝の上に紙包の雪を積み上げたのも昔の夢となりました。",
              "citation": {
                "source": "二階から",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう湯は抜けるのかな」「へい、松の内は早仕舞でございます」　車夫のかく答へし後は語絶えて、車は驀直に走れり、紳士は二重外套の袖を犇と掻合せて、獺の衿皮の内に耳より深く面を埋めたり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は何か意味ありげな伯父の勧めを変に思ひながら、姉のお君とは此前伯母の葬式の時に会つたきり会はないことを思ひながら、台所を早仕舞ひして、六条の方へ出掛けて行つた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの悪習慣をぜひ改むるの必要ありと考えまして、閑な時は如何に早仕舞しても結構という事にしまして別に配当の新法を始めました。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その結果は予想以上によろしく、閑な時は早仕舞が出来るので喜び、忙しい時は配当が俸給額を超加することもあるので、むしろ忙しさを歓迎するようになりました。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば、これらの人々の執務時間は、十四五時間に及ぶとも、その能率に至っては早仕舞を楽しみつつ喜び勇んで働く人々の八時間にも劣るものであります。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、お父さんは、毎日お役所を早仕舞してかへられ、三郎さんも学校を早くかへつて、家ぢうのものが心をあはせて、松子さんの看病をしました。",
              "citation": {
                "source": "身代り",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａ君は蠣殻町の勤め先を早仕舞にしてわたしの家に立寄り連立って出かけたのである。",
              "citation": {
                "source": "写況雑記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "店構への様子は前と同じであるが、却つて夜は早仕舞ひになるのは、当分これが戦災後の世相か。",
              "citation": {
                "source": "銀座の柳",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三人目は、お藏前の飮屋の看板娘おさん、これは錢湯の歸り、露地の入口で銀簪に眼を刺され、第四人目は駒形の小間物屋の若女房お國、所用で出かけた夫の歸りを待ち乍ら、店を早仕舞にして奧へ入つたばかりのところを、これも右の眼を銀簪で刺されて、長火鉢の側に無慙な死體を横たへて居たのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "呪ひの銀簪",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三人目は、お蔵前の飲屋の看板娘おさん、これは銭湯の帰り、露地の入口で銀簪に眼を刺され、第四人目は駒形の小間物屋の若女房お国、所用で出かけた夫の帰りを待ちながら、店を早仕舞にして奥へ入ったばかりのところを、これも右の眼を銀簪で刺されて、長火鉢の側に無慙の死体を横たえていたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "呪いの銀簪",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那は留守だったし、店は早仕舞だし」「いや、旦那が帰って、巳之松が出るまでの間だ」「頬冠りをして、無精髯を生やした男が、店先でウロウロして、旦那に叱り飛ばされていましたが、それっきりですよ」「有難うよ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "二服の薬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、今日は早仕舞として、久しぶりで一つ、正月らしく怠けようか」　忽ち、空箱の机や日月｜星晨の幕をおろして、後に水洟をすすッている同業の先生達へ、「お先に――」と言いながら好い気持で、ぶらりと住居へ帰って行く。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「百さん、きょうは、早仕舞にしない？",
              "citation": {
                "source": "野槌の百",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日明日とみっちり刈れば明後日は早じまいの刈り上げになる。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "往来に出るとその旅館の女中が四五人早じまいをして昼間の中を野毛山の大神宮のほうにでも散歩に行くらしい後ろ姿を見た。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど、お粂も表玄関に近い板敷きの方で織りかけていた機を早じまいにして、その廊下つづきの方へ通って来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもまだ時間が余れば、早じまいを宣してしまうことだった。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭日の前の早じまいまであって、これまでは一年に七十三日から七十九日、工場と役所で仕事が止った。",
              "citation": {
                "source": "正月とソヴェト勤労婦人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
