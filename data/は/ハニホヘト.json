          "literary": [
            {
              "text": "国民学校へ移ってゆく現実の過程には、あらゆる面で、これまでドレミファとうたっていた唱歌をハニホヘトイロと歌わせるという以上に複雑な問題が、解決をまっていると思えるのである。",
              "citation": {
                "source": "国民学校への過程",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処でイロハニホヘトを教えるのは宜しいが、大阪の事だから九々の声を教える。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校の音楽教育は急にドレミファからハニホヘトに変えられた。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
