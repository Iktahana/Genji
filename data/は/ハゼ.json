    },
    "definitions": [
      {
        "index": 1,
        "gloss": "goby (fish)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちは川でハゼ釣りに夢中になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "晩秋になると、釣れるハゼのサイズも大きくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "漁師が獲ってきた新鮮なハゼを天ぷらにして食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "鯊を見着けたが、買はうと思ふと、いつもは小清潔な店なんだのに、其の硝子蓋の中は、と見るとギヨツとした。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞黒に煮られた鯊の、化けて頭の飛ぶやうな、一杯に跳上り飛※る蠅であつた。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる群集の動揺む下に、冷然たる線路は、日脚に薄暗く沈んで、いまに鯊が釣れるから待て、と大都市の泥海に、入江のごとく彎曲しつつ、伸々と静まり返って、その癖｜底光のする歯の土手を見せて、冷笑う。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……宵に鯊を釣落した苦き経験のある男が、今度は鱸を水際で遁した。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "季節季節によって、鮴、川鯊、鮠、雨降り揚句には鮒や鰻も浮出てとんだ獲ものもあった。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鱧を焼く匂いの末に中の島公園の小松林が見渡せる大阪天満川の宿、橋を渡る下駄の音に混って、夜も昼も潺湲の音を絶やさぬ京都四條河原の宿、水も砂も船も一いろの紅硝子のように斜陽のいろに透き通る明るい夕暮に釣人が鯊魚を釣っている広島太田川の宿。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「川｜鯊のこれんぱかしのは無いかい。",
              "citation": {
                "source": "川",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親らしいのは少し酔っているようでしたが、お秀の店から鯊釣りの道具と餌を買入れて、船が岸を離れるとき運転手がまた迎えに来ますかと訊いたのに対して、不要の旨を答えたあとで、こう言いました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯊をうんと釣って土産に持って帰るから」　すると運転手は苦り切った顔で、「あんまり、見え透いた冗談は言わないことにして下さい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣船宿のお秀は稼業柄、戸を早く開けて店つきを整え、定刻に廻って来る餌屋から鯊釣りの餌のごかいだの、鮒釣りの餌のきじだのを少し許り買ってから店先で朝刊を見ています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本草』に海中の虎鯊能く虎に変ずとある。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕窩鯊翅（燕の巣や櫨の羽―中国料理）の珍味はその後にすべきである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸者の言つた「ムツゴロウ」とは、肥前の有明の海にしか棲まない、鯊に似た小魚で、知事と同じやうに色黒で出目である。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "獲物は、――鮒二つ、鯊一つ、そして句二つ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の獲物は、小鮒二、小鯊五。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣りと網　寒鮒に始まって鯊釣り、鱚釣り、鯔、海津など、釣りと網とは花に次いでの江戸ッ児の遊楽だ。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯊釣りは彼岸を待っての垂綸で、東京湾の鱚釣りは脚立に限る。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京附近では、鯊かカイヅ、或は投網でイナをやるくらゐであるが、横浜から先は海も深くなるし、大鰺やメゴチ、或はソーダ、鱸、大｜鮹、ガラ、カンパチ、ボラ、メナダ、といふやうなものが釣れるから、皆ハネ竿で、倫糸も長く、先づ半職釣といつた人が多い。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時、東京式に若者が二人｜威勢よく盤台を担いで来たので、珍らしい事だと出て見ると、大きな盤台の中は鉛節が五六本に鮪の切身が少々、それから此はと驚かされたのは血だらけの鯊の頭だ。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯊の頭にはギョッとした。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人の足裏も鯊の顋の様に幾重も襞をなして口をあいた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狼の頭、豹の頭、鯊の頭、蟒蛇の頭、蜥蜴の頭、鷲の頭、梟の頭、鰐の頭、――恐ろしい物の集会である。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前は二間もある海の鯊がこゝまで上って来たと云う。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰍の族が三、四十種あるうち、海近い河口に棲むダボ鯊に似た鰍は肉に締まりがなく骨が硬い。",
              "citation": {
                "source": "香魚と水質",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、どんこ（だぼはぜ、鯊、かじかの類）も水垢を好む魚であって、汀に近い石の頭をなめている。",
              "citation": {
                "source": "水垢を凝視す",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、どんこ（だぼはぜ、鯊、かじかの類）も水垢を好む魚であつて、汀に近い石の頭をなめてゐる。",
              "citation": {
                "source": "水垢を凝視す",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "木場はどういふ風の吹きまはしか、また突然、鯊の佃煮を手土産にして一人で尋ねて来た。",
              "citation": {
                "source": "来訪者",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼玉の飛び出た鰭の長い八尺あまりの鯊のような魚が鰭で木の幹を攀じながら悲しそうに鳴いているのであった。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、八百屋の店先などへは、唐芋や八つ頭や蓮根などが、牛蒡や青蕪と位置を争ってその存在を示すようになり、魚屋の店先へはかれいやひしこが、かじき鮪や鯊などと並んで、同じように存在を示すようになる。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前は二間もある海の鯊がこゝまで上つて來たと云ふ。",
              "citation": {
                "source": "熊の足跡",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
