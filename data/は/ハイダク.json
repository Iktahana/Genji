          "standard": [],
          "literary": [
            {
              "text": "もし関羽が味方にきてくれれば、顔良、文醜が生きかえってくるにもまさる歓びであろう」　玄徳は拝諾して、黙々、自分の陣所へ帰った。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに拝諾の旨は、勅使へお答え申しあげてしまったのだ。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ以上、主上にせまッて、叡慮のお苦しみをみてもと、義貞も観念のほかはなく、ついに拝諾のお答えとなったものだった。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
