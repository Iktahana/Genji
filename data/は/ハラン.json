  {
    "uuid": "a29bd609-9447-54e4-9ca5-ba7d6367dc16",
    "entry": "葉蘭",
    "reading": {
      "primary": "はらん",
      "alternatives": [
        "ばらん",
        "ハラン",
        "バラン"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "cast iron plant (Aspidistra elatior)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "玄関には、「葉蘭」が植えられていて和風の雰囲気を醸し出している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「葉蘭」は日陰でも育つため、日本の庭園によく利用される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "生け花には、葉の美しい「葉蘭」が欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "すぐ眼の下の汀に葉蘭のような形をした草が一面に生えているが、その葉の色が血のように紅くて、蒼白い月光を受けながら、あたかも自分で発光するもののように透明に紅く光っているのであった。",
              "citation": {
                "source": "夢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は甲板の籐椅子に寐ころび、さうして夢見心地のする葉蘭の影に、いつも香氣の高いまにら煙草をくはへて居た。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の声は少し濁みていますが、ところ／″＼に葉蘭の葉の縁のように慄えがあって、暖かく寂しくあります。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸の山の手に住んでいる侍の一人が、某日の黄昏便所へ往って手を洗っていると手洗鉢の下の葉蘭の間から鬼魅の悪い紫色をした小さな顔がにゅっと出た。",
              "citation": {
                "source": "通魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンクリートの階段と手摺りとがあり、階段の上がり口には蘇鉄や寒菊や葉蘭などの鉢が四つ五つ置いてあった。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後は森で、すぐに、そこに、墓が、卒塔婆が、と見る目と一所に、庵の小窓に、少し乱れた円髷の顔が覗いて、白々と、ああ、藤の花が散り澄ますと思う、窓下の葉蘭に沈んで、水の装上った水盤に映ったのは、撫肩の靡いた浴衣の薄い模様です。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きなサボテンや葉蘭の鉢が硝子の中にくつきりと見えてゐた。",
              "citation": {
                "source": "時子",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "一葉蘭が花と葉と、どちらもたった一つずつの、極めて乏しい天恵の下に、それでも自分を娯しむ生活を営んでいるのを知り、社交嫌いな鷦鷯が、人一倍巣を作ることの上手な世話女房であるのを見たのも、この山のなかであった。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには葉蘭が沢山｜生えていたので、その一本の茎を中心に小さい円を描いておいた。",
              "citation": {
                "source": "火",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、直ぐ金剛石のことを思い出すと裏へ廻って行って、夕闇の迫った葉蘭の傍へ蹲って、昼間描いておいた小さい円の上を指で些っと圧えてみた。",
              "citation": {
                "source": "火",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉蘭なぞはバラバラ音がした。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭というても四坪たらず、紅葉の木に桃葉珊瑚が二本、手水鉢の水落ちのきわにも手入れの届いた葉蘭のひとむらがあって、水に打たれ染め上げたばかりの緑の色艶は眼にしみるよう、したたり落ちる雫のはずみをうけて葉が微かに揺れている。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶の間から掃き出したごみが葉蘭にくっついている手洗鉢の横からあがって、サイは自分の部屋の戸をあけた。",
              "citation": {
                "source": "三月の第四日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "袖垣に辛夷を添わせて、松苔を葉蘭の影に畳む上に、切り立ての手拭が春風に揺らつくような所に住んで見たい。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体ばれんは、後に変化を遂げた形から類推して、葉蘭の形だとする説もある様であるが、此は疑ひなく、ばりんである。",
              "citation": {
                "source": "まといの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "母家から別れたその小さな低い鱗葺の屋根といい、竹格子の窓といい、入口の杉戸といい、殊に手を洗う縁先の水鉢、柄杓、その傍には極って葉蘭や石蕗などを下草にして、南天や紅梅の如き庭木が目隠しの柴垣を後にして立っている有様、春の朝には鶯がこの手水鉢の水を飲みに柄杓の柄にとまる。",
              "citation": {
                "source": "妾宅",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭に咲いた松葉｜牡丹、凌霄葉蘭などの花の見える奥の部屋で、三吉は大きな机の上へ煙草盆を載せた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子には植木鉢の葉蘭の影が暖かそうに写っている。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子の中で例の御師匠さんと下女が話しをしているのを手水鉢の葉蘭の影に隠れて聞いているとこうであった。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の室は、私の静かさと清潔とを好む性癖によく適っていて、庭には葉蘭がたくさんに繁っていた。",
              "citation": {
                "source": "幼年時代",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤掃の埃しづまる葉蘭かな　　　　子規　煤掃をすると家の内は綺麗になるけれども、一時は煤埃が空中に舞い上ってその辺一面に大荒れに荒れるのであるが、その煤掃も終って暫く時間が経つと、空中に散ばっていた埃も自然と地上に静まって来る、その埃は庭の葉蘭の上にも懸っているというのである。",
              "citation": {
                "source": "俳句はかく解しかく味う",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉蘭の大きな葉の上に埃が静まったという事が、いかにも的確に空中全体の埃の静まった事を証明しているような心持がするのである。",
              "citation": {
                "source": "俳句はかく解しかく味う",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢崎は席に就く前に、薄端に未生流らしい矯め方をした葉蘭が活けてある床の間を向いて跪き、掛軸の書を丹念に打ち眺めている様子であったが、幸子と雪子とはその隙に彼の後姿へ眼を遣った。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて松葉蘭、今は誰も顧みぬが当時逸品は百金二百金、これは程なく下火で次は桜草、十五、六年から二十年頃が盛り、染井の常春園、入谷の横山など珍種を誇った。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "大凧が充分に風をはらんで揚がる時は若者の二人や三人は引きずられるくらいの強い牽引力をもっている。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらずば、さらずば、我が方に賜はらんとて甲斐なき御玉章に勿躰なき筆をや染め給ふ。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "盆景春夏すぎて手は琥珀、瞳は水盤にぬれ、石はらんすゐ、いちいちに愁ひをくんず、みよ山水のふかまに、ほそき滝ながれ、滝ながれ、ひややかに魚介はしづむ。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "立並んだ軽便ホテルの裏街から、ホテルの硝子戸ごしに見える、アカダマの楼上のムーラン・ルージュが風をはらんでいる。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが今では、三尺ばかりに伸びて穂をはらんでいる。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇一の家には、麦が穂をはらんで伸びている自分の田畑があった。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
