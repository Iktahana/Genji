[
  {
    "uuid": "11568089-0460-5852-9edc-fa4d2fda866c",
    "entry": "波乱",
    "reading": {
      "primary": "はらん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
