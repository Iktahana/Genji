[
  {
    "uuid": "374594b8-b74b-5ec6-a1c9-5446ab802ec6",
    "entry": "花柳",
    "reading": {
      "primary": "はなやぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
