        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "仕ヘル者ノハリツメタ心モ知ラヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮力の加減で船底にハリツイていた喜三郎の屍体は、その儘連れ出されて外海へ漂流する訳だ。",
              "citation": {
                "source": "カンカン虫殺人事件",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間だからそう長時間ハリツメて働ける訳のものではない。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "政治家がわれ等の罪を負うてハリツケにかかったところで、われわれの空腹は救われはせぬ。",
              "citation": {
                "source": "帝銀事件を論ず",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "首がまわらぬ、八方ふさがり、全体がたゞハリツメタ重さばかりで、無性にイライラするばかり。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリツケにかけられた罪人だつた。",
              "citation": {
                "source": "私の小説",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "養神様はハリツメタ力が一時にゆるんで、グラグラくづれるやうだつたが、「それで、気がすんだかい」　フラフラしながら、さゝやいた。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この殺しかたにもいろいろとあって、はじめは斬首であったが嬉々として首をさしのべ、ハリツケにかければゼススさまとおなじ死にかただと勇みたつ始末だから、火あぶりにした。",
              "citation": {
                "source": "二合五勺に関する愛国的考察",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、これは、一度はハリツケにかかるという宿命を行うためであるから、仕方がないように出来ているのだなア。",
              "citation": {
                "source": "安吾巷談",
                "author": "田園ハレム",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤十郎一族はハリツケになったが、ここに哀れをとどめたのは訴えでた妾たちで、これも同罪なりと「首を斬られ」てしまったのだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "その方法は斬首、ハリツケ、火アブリ、水責め、氷責め、熱湯責め、ノコギリびき、蓑踊り、穴吊し等々いろいろある。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめには斬首やハリツケであったが、見物人に挨拶したり説教したり、改心をすすめたりして堂々と死ぬので、見物人や首斬り役人まで改心して信者になる者が処刑のたびに増加した。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界総体を相手にしてハリツケにでもなってハリツケの上から下を見てこの馬鹿野郎と心のうちで軽蔑して死んで見たい。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも僕は臆病だから、本当のハリツケは少々恐れ入る。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦はその捕えた蚤のまだ生きているのを縫針に突きとおし、ハリツケデゴザイマスなどと言って自分のところに持って来てくれるので、枕頭でそれを見乍ら心を慰めて居るという具合であった。",
              "citation": {
                "source": "蚤",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔、キリシタン退治の頃、信徒をハリツケ、火アブリにかける。",
              "citation": {
                "source": "ヤミ論語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなことを調べると、昔なら、ハリツケものだぜ」　と、ひやかされながら、せがれまで助手にして、土地の古老にきいて歩いた。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧道にある「お玉ヶ池」は、お玉という女が、ハリツケになった跡だというが、こういう極刑は、めったに行なったものではない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その星の汚ない馬小舎の中で生まれてね、うんとゲンシュクな顔になってお説教をしてね、そこで裏切られて、ハリツケにされて殺されちゃうのが役目なのよ」「たのしい休暇でした」と、青年も目で話した。",
              "citation": {
                "source": "メリイ・クリスマス",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
