        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "寢てからも、むかし讀んだ小型の詩集や、眞紅の表紙に黒いハムマアの畫かれてあるやうな、そんな書物を枕元に置くことは、めつたになかつた。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムマアの尖った方ではだめだ。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは五人でハムマアだの検土杖だの試験紙だの塩化加里の瓶だの持って学校を出るときの愉快さは何とも云われなかった。",
              "citation": {
                "source": "或る農学生の日誌",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、赤いユニホォムを着た、でぶの爺さんが、米国一流のハムマア投げ、と、きかされ、もの珍しく、眺めていたのだけ記憶にあります。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
