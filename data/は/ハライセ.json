[
  {
    "uuid": "03af20c6-65c2-54fe-b469-e94c543b3bdd",
    "entry": "腹いせ",
    "reading": {
      "primary": "はらいせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
