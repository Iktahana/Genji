    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "光の酒に漬っては花椰菜でもアスパラガスでも実に立派なものではありませんか。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑には灰いろの花椰菜が光って百本ばかりそれから蕃茄の緑や黄金の葉がくしゃくしゃにからみ合ってゐた。",
              "citation": {
                "source": "花椰菜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は花椰菜の中ですっぱだかになってゐた。",
              "citation": {
                "source": "花椰菜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにも花椰菜がならんでゐた。",
              "citation": {
                "source": "花椰菜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花椰菜、千日大根、萵苣、白菜、パセリ、人蔘、穀物、豆類。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "――青黍、もち稗、花椰菜、火焔菜、トマトが、南瓜が、ああ大蕪が。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしその椰菜へ花の字を加えて花椰菜となし、それをハボタンの一種なる Cauliflower の訳字となし、これは今日でも普通に用いている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
