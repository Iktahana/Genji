          "literary": [
            {
              "text": "使用人としては、原紙などの運び役に櫛原万造という大酒飲みのじいさんと、私が日給二十銭で雇った亭主持ちの女子作業員、おげんさんの二人。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもわたしにおいては、このゆたかな髭が特にその運び役を承る。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
