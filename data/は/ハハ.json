[
  {
    "uuid": "b0c03546-9815-5f23-89f3-bf428cefaff8",
    "entry": "母",
    "reading": {
      "primary": "はは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
