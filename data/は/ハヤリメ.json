        "examples": {
          "standard": [
            {
              "text": "子どもがはやり目をもらってきて、数日後に家族全員がなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "眼科医は「これははやり目です」と診断し、目薬を処方した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "プールの季節になるとはやり目の患者が増えるという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "めくら　カヤノがはやり目を誰からかもらってきた。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒポクラテスが書いている時代にターソス島でピンク・アイ（はやり目）に似ている目の炎症の流行が述べられている。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
