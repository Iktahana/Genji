        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「わしのやうな小国の王の杯は受けぬと言ふのか、恩知らず奴ツ」彼はこう叫ぶやいなや、その大杯を丈の高い蘭人の額にハツシとぶつけた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "得たりと勢込んで紀昌が其の矢を放てば、飛衞は咄嗟に、傍なる野茨の枝を折り取り、その棘の先端を以てハツシと鏃を叩き落した。",
              "citation": {
                "source": "名人傳",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙二郎は、馬の鬣をしごくやうに左の手を前に出して切りに動かし、右の手では鞭を打つやうに「ハツシ！",
              "citation": {
                "source": "鞭撻",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツシ」と云ひながら臀を叩いて駈けてゐた。",
              "citation": {
                "source": "鞭撻",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――その汚い言葉の矢が、ハツシと直子の胸を射て来る。",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノサーカスハ、イツデモ、ワタクシノテニヨッテ、バクハツシマス。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウダン、ヤマモミジ、一行寺、大盃、イタヤ、ハツシモ、など云う類の楓や銀杏は、深く浅く鮮やかにまた渋く、紅、黄、褐、茜、紫さま／″＼の色に出で、気の重い常緑木や気軽な裸木の間を彩どる。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
