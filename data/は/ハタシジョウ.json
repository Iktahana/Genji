        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "体育祭の応援合戦で、ライバルチームに「勝負は正々堂々！」という決意を込めた、ユーモラスな「果たし状」を渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "武士は相手に果たし状を送った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その果たし状には決闘の日時が記されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "――左封はいうまでもなく果たし状か脅迫状か、いずれにしても不吉を物語っている書状です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ、隼団からの果し状やぜ」「判つてる。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、いくら雪子が好きでも、青蛇団の豹吉ともあろうものが、女のことにかけて、果し状を怖がって逃げたと思われるのは、辛かった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "小沢は雪子への土産の寿司を持って、阿倍野橋の宿屋へ帰る途中、亀吉に会って、亀吉が小沢に返そうとして持っている二千円の金を掏られて、その代り隼団から青蛇団の豹吉へあてた果し状がはいっていたことを知った――それからのことだ。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "小沢はふと亀吉のポケットにはいっていた果し状のことを思い出すと中之島公園へ駈けつけて行った。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "参れ」　くるくると巻いてその果し状を小柄へ結いつけると、「少し痛いぞ。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "源三郎からは、果し状をつきつけられる。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……諸人に迷惑さえかけなかったら、何をやってもいいわけだ）　そこで彼は果し状を認め、こっそり猪之松へ持たせてやった。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――諸人はかかわりなく二人だけで、今夜宿外れの黒川渡の野原で、勝負しようという果し状であった。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "武士として鞘当てを受けたのは、果し状をつけられたようなものであるにかかわらず、その武家は知らぬ顔に、人混みに紛れて逃げ去ろうとするのは歯痒い。",
              "citation": {
                "source": "大菩薩峠",
                "author": "安房の国の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜之助は勃然として半身を起し、封を切って読むと、「貴殿に対して遺恨あり、武道の習にて果合致度、明朝七ツ時、赤羽橋辻まで御越あり度」「うむ、小癪な果し状」　竜之助は手紙をポンと投げ出して、夜具を蹴って起き直りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴鹿山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お浜はそっとその一つを手に取って見ると、それは宇津木兵馬からの果し状でありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴鹿山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊勝なこと、こうも立派な果し状を人につけるようになったとは。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴鹿山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　兵馬は附添の片柳と水島とを押し分けて、「姿は変れどよう似てござる、念のため与八どの、この女の持物はないか、調べてくりゃれ」「ここに短い刀が……書付が……あれ、こっちにも」　与八が拾って兵馬に手渡したのは、意外にも自分の手から机竜之助に送った果し状でありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴鹿山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "果し状をつけられながら逃げるというはこの上もなき恥辱。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴鹿山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし道庵としては、かくうろたえるのがあたりまえで、ただいま投げ込まれた投げ文なるものは、確かに道庵に向って、生命を脅すに足るべき果し状同様なものでありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の恋文はまたこの果し状と同じでんで、あるときはキザなこと話にならず、また或時は熱に浮かされて何がなんだかてんで分らず、また或時は深謀遠慮を逞うして恋の手管をつくして居り、思ひ出してもはづかしくて顔が赧らむ状態だから、メリメとはだいぶん違ふ。",
              "citation": {
                "source": "手紙雑談",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "――外ならぬ銭形の平次へ果し状を付けるんだ、二分や一両とはずまないまでも、二朱や一分はきっと出す」「なるほどね」「それにあの手紙の文句は、少し巫山戯すぎていたよ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "巨盗還る",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎も角読んで見て下さい」「少し怖いなア、果し状なんか謝るぜ」　平次はそういいながら、件の一と品を取上げました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "「生き残りの斑組の首領が、八丁堀の組屋敷へ果し状を付けたんだ、――こいつは驚くでしょう、親分」「驚くよ八。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……今度のことは前の失敗の雪辱といえば雪辱だが、どうも私などには手ぬるく思われてもの足りない」「うん、それはそうだ、予め敵に果し状をつきつけて正々堂々と相見えるというのでなくて、いわば奇策だ、自由党の策だからな」「松方総理が演説でいった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ、相手は江崎満吉、今でも、子分を何百人と持って、幅をきかせとるが、その頃は手のつけられん横暴の最中でな、紀元節の日に、決戦をやろう、ちゅうて、わしのところに、果し状をつけて来とった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、話が面白うなりかかっとるところじゃけ」　新之助も、助け舟が出て、ほっとした面持で、一つ、咳をし、「それで、江崎満吉が、吉田さんに、果し状をつきつけて、大喧嘩になるんじゃが……」　と、話をつづけた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "果し状一「何を仰しやるので？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美少年國",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲者の逃げ路が、わかると言ふのか」　平次は到頭、果し状を突き付けられた形になりました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美少年國",
                "note": "青空文庫"
              }
            },
            {
              "text": "――外ならぬ錢形の平次へ果し状を附けるんだ、二分や一兩とはずまない迄も、二朱や一分はきつと出す」「成程ね」「それにあの手紙の文句は、少し巫山戯過ぎて居たよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "巨盜還る",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それではちょっと見て頂きたいものがありますが、この手紙を光川様は御存じでしょうな」　平次は死骸の袂から出た果し状を見せました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "敵討果てて",
                "note": "青空文庫"
              }
            },
            {
              "text": "――一と足先に家へ帰って、この果し状を認め、藤枝蔵人の家へ投げ込んだのが無理だろうか」　光川左門太は昂然として頭を挙げるのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "敵討果てて",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩とラシャメンのありもしない関係が評判になって、或朝、我輩の机の上にベッケルからの果し状が置いてあった」「イヨ／＼参りましたな」「晩の十時にお好みの武器を持って介添を一人つれて、会社の裏の松林へ来てくれとある」「成程」「我輩も後へは引けない。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝山藩百年のためだ」「おれは平三郎に果し状をつけたのだ。",
              "citation": {
                "source": "蘭",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
