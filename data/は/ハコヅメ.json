    "definitions": [
      {
        "index": 1,
        "gloss": "packing into a box",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "引っ越しのために、本をダンボール箱に箱詰めした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お土産のお菓子は、一つ一つ丁寧に箱詰めされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "出荷前に製品の箱詰め作業を行う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "吉良の父親は関係会社の一つに製菓会社があって、そこの包装部の特別室では思い付きのある娘たちに自由な意匠で製品を箱詰めさせ、豪華版の贈答品に売出すのを特色としていました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階の函詰場で、男工と女工がコンヴェイヤーの両側に向い合って、空罐を箱詰めにしていた。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台の左右に奏楽者の天幕ができ、庭の西と東には料理の箱詰めが八十、纏頭用の品のはいった唐櫃を四十並べてあった。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月に入ると北国から、箱詰めにして送られる鈴蘭、おのれの強い芳香の、化学的変化が、毒素になつて死ぬ鈴蘭。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大変も大変だ、自分の身体が箱詰めになってしまうんだ。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは器械に自然に捲きこまれて息の根も止れば、屍体も箱詰めになって、ビールと一緒に積み出される――」「そんな歯車仕掛けのようにうまくゆくものか。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の妖酒から始まって、川っぷち、薬屋、ガールの家、ユダヤ横丁、黒塀、クレーンと吊り籠、ビール工場の高窓、箱詰め器械、それかち貨物駅と、これだけのものは次から次へとつながっているのだ。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "切迫した尿意と慾情とかゆみと夢遊と地形とユダヤ横丁の掟と動くクレーンと動く箱詰め器械と、これだけのものが長いトンネルのように繋がっている。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口を入ったが最後、箱詰め屍体になるまで逃げることはできないのだ。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このままにして置けば箱詰めになる辻永だった。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『なつめしゆろといふのは乾かして箱詰めにしてある大変おいしい長い果物ですね。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに初めからきちんとした箱詰めの様な生活を真似るよりも、境遇に適応した活動をしてそこに規則のある生活を造ることが必要である。",
              "citation": {
                "source": "青年の元気で奮闘する我輩の一日",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の箱詰めを見た事があるかい。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "手も足もしびれちまって、俺みたいな片輪者は、みんなあの箱詰めで出来るんだよ。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてね、箱詰めになって、船にのって、大阪へ来たんだ。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱詰めにされっちまうよ。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱詰めにされたって俺ぁ知らないよ」　一寸法師は、さもさも怖わそうな表情で、附加えた。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの中に見世物に売る為に赤坊を箱詰めにして不具者を作る話が書いてある。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、いくら気の毒だって、罪もない人の子を、箱詰めにしたり、皮をはいだりして、見世物小屋に曝すなんて、そんな残酷な、地獄の陰謀に加担出来ると思うか。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ箱詰めの文代さんを積んで、おさらばしようってわけなのさ。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔術師は看客の目の前で生きた女を胴切りにしたり、箱詰めの小女を剣の芋刺しにしたり、彼女を殺害して鮮血したたる生首を転がして見せたり、或は立所に人を眠らせ、自由自在の暗示を与え、或は他人の心中持物を看破するなど、あらゆる奇怪事を行うことが出来る。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸中の人を箱詰にする体裁。",
              "citation": {
                "source": "第二菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペリイ出帆の翌日、アメリカ側から幕府への献上物の中には、壜詰、罐詰、その他の箱詰があり、浦賀奉行への贈り物があったが、これらの品々は江戸へ伺い済みの上で、浦賀の波止場で焼きすてたくらいだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして母を取巻いてぞろぞろと青い葉や蔓と共にこれを引出す彼等のそれぞれを思い浮べると同時に、私は早速これを蔓のまま箱詰にして郵便局から送ってやろうと思い立った。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから歯磨ナ、あれはココ」に傍点］になつてる歯磨を升で買つて来て竜脳を些とばかり交ぜて箱詰にして一と晩置くとプンと好い香がする、そいつをオンタケ散とか豚印とか好い加減な名を付けた袋へ入れて一と袋一銭五厘に売るんだ。",
              "citation": {
                "source": "貧書生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "貨物自動車には箱詰になった荷物や、トランクが満載してあった。",
              "citation": {
                "source": "日蔭の街",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱詰になったような重い空気が街の上に覆さっている。",
              "citation": {
                "source": "秘められたる挿話",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の箱とは、前後三回に亙って発見された有名なる箱詰屍体事件の、その箱のことなのである。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "事件はそのまま迷宮へ入った――というのが箱詰屍体事件のあらましである。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さっきの女のうちに、箱詰になった青年が三人とも泊ったことが判った。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
