[
  {
    "uuid": "1fe6493b-42d1-5faa-9d8b-9822313a2102",
    "entry": "８時",
    "reading": {
      "primary": "はちじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
