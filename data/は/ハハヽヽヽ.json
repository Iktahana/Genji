        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「ハハヽヽヽヽ五目並べじゃしかたがない。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ハハヽヽヽ』と楠野君は哄笑したが、『然しね君、北海道も今ぢや内地に居て想像する樣な自由の天地ではないんだ。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ハハヽヽヽ』と楠野君は哄笑したが、『然しね君、北海道も今ぢや内地に居て想像する様な自由の天地ではないんだ。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『Guten Abend, Herr Yosino!　ハハヽヽヽ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「厭になつてしまふなア、ハハヽヽヽ。",
              "citation": {
                "source": "極夜の記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "なに明智にあえないのが、かなしいというのか、ワハハハヽヽヽ、しんぱいするな。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハヽヽヽヽ、おどろいたかい。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハハハヽヽヽヽ、どうだね、この早わざは。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハヽヽヽヽ、それは今お目にかけるよ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハヽヽヽヽ、わかりましたか。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからともなく、きこえてくる、クスクスという、しのび笑い、それが、だんだん大きくなって、ついにワハハヽヽヽヽヽと、人をばかにした大笑いになりました。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハヽヽヽ、何をおっしゃる。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハハハヽヽヽ、しらばくれるのも、いいかげんにしろ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハヽヽヽ、明智君、さすがに、まだ腕はにぶらなかったね。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハヽヽヽヽ、きみは、それが爆発すると思っているのか。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハヽヽヽヽ、手榴弾だって、同じことだよ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハヽヽヽヽ、きみは顔色をかえたね。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハハヽヽヽヽ、いくら小林が変装がうまくても、こんなにうまくばけることはできないよ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハヽヽヽヽヽ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハヽヽヽ、気のどくだが、鉄の人魚怪物団もこれで全滅だね。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
