[
  {
    "uuid": "74fc812e-a955-5ffb-a86f-a97700bb6982",
    "entry": "半座",
    "reading": {
      "primary": "はんざ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
