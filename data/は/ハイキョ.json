[
  {
    "uuid": "0aa6d5f0-af75-5294-ba48-688f84dc98bb",
    "entry": "廃墟",
    "reading": {
      "primary": "はいきょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
