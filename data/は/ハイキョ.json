      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "ruins (of a building, town, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山奥にひっそりと佇む廃墟の洋館は、かつての栄華を物語るような静寂に包まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "戦争によって街の半分が廃墟と化したが、市民の懸命な努力で復興が進んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "危険なので立ち入り禁止になっている廃墟に、無断で侵入する観光客が後を絶たない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "旧解剖学教室、生理学教室の廃墟には冬枯れの雑草ががらがらに干からびて哀れである。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢の奥の行きづまりには崩れかかったプールの廃墟に水馬がニンプの舞踊を踊っている。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして夜が更けるにしたがってなんとなく廃墟に宿っているような心持を誘うのである。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその情景はますます私に廃墟の気持を募らせてゆく。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "地震か、ペストか、それともソドム、ゴモラのような神罰か、とにかく、そんなに遠くもない昔に栄えた都会が累々たる廃墟となっていて、そうして、そういうものの存在することをだれも知らないかあるいは忘れ果てていたのである。",
              "citation": {
                "source": "ロプ・ノールその他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロプ・ノールの話や、このペルーの廃墟の話などを読んでいると、やっぱりまだこの世界が広いもののように思われて来るのである。",
              "citation": {
                "source": "ロプ・ノールその他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十三年一月、東京朝日新聞）　　　　　ローマから　ローマへ来て累々たる廃墟の間を彷徨しています。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜にでもなったら古い昔のドイツ戦士の幻影がこの穴から出て来て、風雨に曝された廃墟の上を駆け廻りそうな気がした。",
              "citation": {
                "source": "異郷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯れ枝がブラ下ったり、杉の木が傾いたりして、だんだんと廃墟じみた感じをあらわし始めた。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "溝渠の向こう側には小規模の鉄工場らしいものの廃墟がある。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの仕事しながらの会話によって対岸の廃工場が某の鋳物工場であった事、それがようやく竣成していよいよ製造を始めようとするとたんに経済界の大変動が突発してそのまま廃墟になってしまった事などを知った。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵の具箱を片付けるころには夕日が傾いて廃墟のみぎわの花すすきは黄金の色に染められた。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵として見る時には美しくおもしろいこの廃墟の影に、多数の人の家の悲惨な運命が隠れているのを、この瞬間まで私は少しも考えないでいた。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、廃墟はあいもかわらず立っていました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの都のまん中にある七つの丘の一つに、皇帝宮の廃墟があります。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根はもちろん、柱一本も無く、見渡す限り廃墟と言つていいくらゐの荒涼たる大広場である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマの廃墟が黄色い夕日を浴びてとても悲しい。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかしの築城の大家は、城の設計にあたって、その城の廃墟になったときの姿を、最も顧慮して図をひいた。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廃墟になってから、ぐんと姿がよくなるように設計して置くのである。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女は伊太利の旅で見た羅馬の丘上のネロ皇帝宮殿の廃墟を思い出した。",
              "citation": {
                "source": "かの女の朝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "廃墟は廃墟としての命もちつゝ羅馬市の空に聳えてとこしへなるべし。",
              "citation": {
                "source": "かの女の朝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "崩れ落ちた工場の廃墟に咲き出た、名も知らぬ雑草の花を見た時には思わず涙が出た。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた私達のセンチメンタリストは、廃墟に自然が培う可憐な野草に、涙含ましい思いを寄せることがある。",
              "citation": {
                "source": "季節の植物帳",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方は窓の破れたところに板が打ち付けてあったり、屋根がへこんでいたりして、廃墟の体であった。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、君も知っておられるだろうが」と彼は考えこみながら言い続けて、「スパルタに（それは今のパレオコリのことだが）、そのスパルタに、城郭の西の方に当って、渾沌たるほとんど見分けられない廃墟の間に、台石のようなものが一つあって、その上に今でも ΛΑΣΜ という文字が読まれる。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でもその廃墟が処々の山蔭や、湖の底からニョキニョキと頭を出しているそうですが、その周囲には天然の森が茂り、高山風の花畠が展開して、珍らしい鳥や見慣れぬ蝶が、長閑に舞ったり歌ったりしている。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "室蘭の町は廃墟のように、雪の灰の中からところどころのぞいていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの種の作品ではなく、私のいふ『錯雑たる自然』を描くことの妙手であるといふ意味は、桂月氏がその材料を、殆ど雑草園か廃墟からでも求めてきたのではないかと思はれる場合の作品で、もつともよくこの作者の自然観、人柄、実力、そしてそこには一人の人物も描かれてゐないが、人間観をさへ発見できるのである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの二三年、廃墟といふことを非常に考へた。",
              "citation": {
                "source": "地震の時",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒寥たる地方での會話「くづれた廢墟の廊柱と、そして一望の禿山の外、ここには何も見るべきものがない。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
