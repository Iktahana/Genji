[
  {
    "uuid": "1687b3c1-910b-528a-8e78-55f120487017",
    "entry": "花菖蒲",
    "reading": {
      "primary": "はなしょうぶ",
      "alternatives": [
        "はなあやめ",
        "ハナショウブ"
      ],
      "is_heteronym": true
    },
