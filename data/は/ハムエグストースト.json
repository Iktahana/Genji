        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ホテルへ帰るとハムエグストースト紅茶。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグストースト、ハンバークステーキにホットケーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂ハムエグストーストのみ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食がとてもいけなさうなので、不二アイス迄行き、ハムエグストースト他、ハムエグスのみうまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグストーストと、ミニツステーキ、わりにいゝ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラスカへ寄り、ポタアジュとハムエグストースト、プディング。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝塚ホテルのグリルで、ハムエグストーストにニューイングランドボイルディナを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂で一人、ハムエグストースト、ハムが危かったから残す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
