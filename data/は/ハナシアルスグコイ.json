        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "創生記に憑ると私が太宰に芥川賞が欲しいかどうかを問ふために、「ハナシアルスグコイ」と電報で彼を呼び出した事があるとやら、わざわざ呼び出さなければわからない程ぼんやり太宰が芥川賞を欲しがつてゐたかどうか、太宰自身はもう忘れてしまつてゐるらしい。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も「ハナシアルスグコイ」と電報で彼を呼びつけた事は確かにあつた。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナシアルスグコイと打つのだ。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "創生記を一読して、自分はハナシアルスグコイを繰り返さうと思つたが、夜中であつたから、夜の明けるのを待つた。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
