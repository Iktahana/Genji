          "literary": [
            {
              "text": "「ハテネ、たいそう慣れなれしくおっしゃるが、おまえさんは……どちらの？",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "斎「ハテネそうして。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "石頭をいじめたって仕様がないさね」「滝沢起久子が殺されたよ」「ハテネ。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸｜開府前の名家とやらで」「ハテネ？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "系圖の刺青",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは昔のことで、ヘッ、二人目はさいしょから屁っぴり腰で向ったら、この野郎は首尾よく腰を抜かして、眼を廻しましたよ」「ハテネ？",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "笛吹兵二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテネ、堅氣のお前さんからの頼み、といふと、袋戸棚の唐紙でも貼つて貰ひたいと言ふのかい」　東作は煙草盆を引寄せて一服吸付け、長閑な煙を長々と吐きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "巾着切の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勘弁しておくんなさい、その朱鞘が目に入らねえほど面喰って居たんで」「ハテネ」　赤崎才市はプッと楊子を吐きました。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテネ、堅気のお前さんからの頼み、というと、袋戸棚の唐紙でも貼って貰いたいと言うのかい」　東作は煙草盆を引寄せて一服吸付け、長閑な煙を長々と吐きました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "巾着切りの娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテネ、そんな野郎というと丑松の外にはないようだが――」「とにかく、女や子供じゃありませんぜ、――ちょいと、そのお才に訊いてみたいことがあるんですが」「あ、何なと、御自由に」　市蔵は少し皮肉に身を退きました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "血潮の浴槽",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハテネ、若旦那、これやてっきり昨夜の内に起ったことだぞ。",
              "citation": {
                "source": "鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
