        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "負けてるのですぐ引返して、赤門の不二アイスでトマトスープとハンバーク、オムレツ等食ひ、又盲役者林長之助を宝生座で見物し、広小路へ出て買もの、テク／＼と歩いて朝日ビル、暑い／＼。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグストースト、ハンバークステーキにホットケーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝塚ホテルへ食事しに行く、グラタン入のポタージュうまし、マカロニとハンバークステイキを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネてから道子と南のかどやの冷房グリルへ、竹川とおクスも来て食事、ポタアジュうまし、サハラのグラタンにハンバーク皆よし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四時頃女房共々出て、中村屋で食事、ボルシチとハンバークサンド、コゝアをのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二十五日（火曜）　招魂社の臨時大祭で特別マチネー、入りは七分位か、まあみっともなくないだけ、走れよ／＼で昼の終り四時十分、急げば外で食事出来るからと、ホテ・グリで食事、スープ抜いてコールドラブスターとハンバーク。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタージュ、ひらめのコロッケ、ハンバーク、ホット・レギュウム、コーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
