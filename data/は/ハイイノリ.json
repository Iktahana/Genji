          "standard": [],
          "literary": [
            {
              "text": "それに「ヴィクトル」といえば史丹のごとくに臥そべッて、グッと大負けに負けて、人柄を崩して、いやながらしばらく「アクーリナ」の本尊になって、その礼拝祈念を受けつかわしておった。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "浦和から大宮、武蔵の国の一の宮、氷川大明神へ参詣して、またまた米友をおどろかせたのは、道庵先生が見かけによらず敬神家で、いとねんごろに参拝祈願する体を見て驚嘆しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌廿日、中村、藤沢の両君が諏訪｜上社に参拝祈願して護符を奉じて来た。",
              "citation": {
                "source": "島木赤彦臨終記",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
