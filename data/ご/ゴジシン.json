[
  {
    "uuid": "612ed8a3-d5a5-5fd1-bb88-82059420610a",
    "entry": "ご自身",
    "reading": {
      "primary": "ごじしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
