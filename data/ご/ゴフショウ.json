        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　と片手に燐寸を持ったと思うと、片手が衝と伸びて猶予らわず夫人の膝から、古手紙を、ト引取って、「一度お話した上は、たとい貴女が御不承知でも、もうこんなものは、」　と※と火を摺ると、ひらひらと燃え上って、蒼くなって消えた。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今さら御不承知と申されては、わたくしどもの役目が立ちませぬ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、どうぞ娘御をこれへ」「は、はい」「あくまでも御不承知か。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なぜ御不承知と云われます」「失礼ながら御屋敷の御家風が少し気に入りませんから」「異なことを……。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡野のもなかにて御不承なさるか。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "真実、たって御不承知か。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大方は御不承知と察して居りました」と、伝兵衛はやがてしずかに云い出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "旅絵師",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御不承知とあれば強いてとは申しますまい。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜介　　え、御不承知でございますか。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも御不承知か。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "）甚作　　それでも御不承知とあれば致し方がない。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "定重　　鎌倉の將軍頼朝公がはじめての御上洛、武藏相模は申すにおよばす、海道の大小名はすべておん供に加はるなかに、叔父上ばかりが御不承知とは……。",
              "citation": {
                "source": "佐々木高綱",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄衣　　もし父上が飽までも御不承知と仰せられたら……。",
              "citation": {
                "source": "佐々木高綱",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "御母さんが御不承知ならいつでもやめます。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処をお考へ遊ばしたら、如何に好かん奴であらうとも、雫ぐらゐの情は懸けて遣らう、と御不承が出来さうな者では御座いませんか。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この御結婚には宮様も御不承知であった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、御不承か」「もちろん！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は、私の不快そうな顔を認め「何も、お前が御不承知なら、来て貰うには及ばないのだよ」と云われる。",
              "citation": {
                "source": "二つの家を繋ぐ回想",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ……できると思うわ」「おや、何だか御不承知らしいね」　みんなにはだまっているが、けさのホテルでのことがあるから、伸子は、四五日こっちへとまるとしたら、と、ホテルの荷物がどうにかなってしまわないかしら、と思ったのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし御本人がイヤと言わず、親御さんたちが御不承知でなければ君は別段に異存を言わんかね」主人「それは別に異存も言わんが、今妹を取られると僕が少し困る」客「それは君の勝手というものだ。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "布恬廷　條約之儀昨年以來厚く御心配被爲在候て、御取極相成候儀に付、政府御不承知之儀無之事と存候處、はからずも右等之次第を承り驚き入候。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかわり、他様と入込みで、ご不承を願うかも知れません。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご不承か」　いうことばのはしばし、名は名のらなかったが、まさしく加賀家のお重役です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "子持ちすずり",
                "note": "青空文庫"
              }
            },
            {
              "text": "返事のないのはご不承知でござるか」「いいえ……」　とかすかに答えた千浪は血の顫きに上逆って、男の手がふんわりと肩にからんだのも現であった。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それでも、ご不承か」「考えておきます」「ゆうべも、そう仰せられたままと聞く」「大事の儀は、大事に考えねば、ご返答はなりませぬ」「賢いの……六条どの」「さようか」「ふ、ふ、ふ、ふ」　浄憲法師は、嘲むがごとく笑って、ついと、背を向けた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あれをご覧になったお答えは、灯でご合図を願いたいと書いておいたから、あの窓の灯が、消えればご不承知。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
