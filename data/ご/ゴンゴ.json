        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ゴゴンゴーゴー、　やまのいわやで、　熊が火をたき、　あまりけむくて、　ほらを逃げ出す。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴゴンゴー、　田螺はのろのろ。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "田螺のしゃっぽは、　羅紗の上等、ゴゴンゴーゴー」　本線のシグナルはせっかちでしたから、シグナレスの返事のないのに、まるであわててしまいました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "電信柱どもはブンブンゴンゴンと鳴り、風はひゅうひゅうとやりました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オンオンオンオン、ゴゴンゴーゴーゴゴンゴー」　風はますます吹きつのり、西の空が変に白くぼんやりなって、どうもあやしいと思っているうちに、チラチラチラチラとうとう雪がやって参りました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空では風がフイウ、涙を知らない電信柱どもはゴゴンゴーゴーゴゴンゴーゴー。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそんなもんには一切係わらず、オレ様の貧困に後ろ足で砂をかけて、時代はゴンゴン変わってしまうのだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ゴンゴンといふ者には、その不思議が出來た。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンゴンは、とある横町に一軒のサアカス小屋をみつけたのである。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ゴンゴンはその小屋へはいつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、それを見るや、ゴンゴンはふきだしてしまつたのである。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂ――　或る日、ゴンゴンはひとりの神さまに出會つた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ふだんから不思議に思つてゐたから、と尋ねると、神さまはそれには答へないで、そのかはりにゴンゴンの目の前で雲を作つてみせて下さつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｃ――　ゴンゴンが、町を歩いてゐたら、白い雲が、頭のうへを飛んで行つた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、ゴンゴンの服裝のことをまだ一言も言つてゐなかつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ゴンゴンはキヨトンとした顏で空を振り仰いだ。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンゴンは、突然ほほゑんでしまつて、と、呟いた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上は、ゴンゴンといふ者の夢物語であるが、眠りの例のシヤボン玉の外側から見て、こんな夢が見えるか、僕は知らない。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、ゴンゴンに聞いても知つてはゐないであらう。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのゴンゴンが、或る日、僕に土産を持つて來てくれた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "※　僕は架空のゴンゴンを失はなければならなかつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "信じないのではあつたが、僕は、どの夜にも、そのやうなゴンゴンの夢を見出すことが出來なかつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのやうないつはりの戀の思ひ出が種ぎれになつたときはいつも、僕は、架空のゴンゴンや夜に就いての童話を語らねばならなかつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし為替が来なくっては本も買えん、少々閉口するな、そのうち来るだろうから心配する事も入るまい、……ゴンゴンゴンそら鳴った。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくすると第二のゴンゴンが鳴る。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "足を「一寸」すべらすと、ゴンゴンゴンとうなりながら、地響をたてて転落してくる角材の下になって、南部センベイよりも薄くされた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
