        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あまり英一が騒がしく暴れると、彼は、ありふれた親父らしく眼をむいて、「ゴロスケにやつてしまふぞ。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の故郷では梟のことを俗にゴロスケと称び、魔法使ひの異名に用ひた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼時彼も往々家人から、さう云つて悸されたが、「ゴロスケとなら一所に住んでも好いよ。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴロスケつて何さ、田舎言葉は止めて下さいよう。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢から三河・遠州の方面にかけては、この鳥をゴロスケと呼ぶ村が多い。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "静岡県の方では、梟のことをある村はゴロスケといい、また他の村ではゴロシチともいっている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
