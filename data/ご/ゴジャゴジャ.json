        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして、その段々に飯粒や蟹の肉や茶色のドロドロしたものが、ゴジャゴジャになった嘔吐が、五、六段続いて、かかっていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニハ何十人トイウ人ガ、ゴジャゴジャ住ンデイテ、ヤカマシイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "碁じゃない、碁じゃない、こちゃゴジャゴジャだ。",
              "citation": {
                "source": "お墓のすげかえ",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
