        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "本の色彩をゴチヤゴチヤに積みあげて、一度この檸檬で試して見たら。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、私の中には色んな奇妙な奴等がゴチヤ／＼と雜居してゐるらしい。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……終にや山も川も人間の顔もゴチヤ交ぜになつて、胸の中が宛然、火事と洪水と一緒になツた様だ。",
              "citation": {
                "source": "漂泊",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "船宿などのゴチヤ／＼並んで居るところです。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし私が父に勸められたやうに畫家にでも成つて居たら、彼樣いふ路地を畫いたらうと思ふほどゴチヤ／＼した面白味のあるところでした。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅の荷物やら引越の仕度やらゴチヤ／＼した中で、子供は皆な寢沈まりました。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯の一区域について折れ曲つて行つたところに、人家がゴチヤゴチヤ並んで居た。",
              "citation": {
                "source": "燈火",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴチヤ／＼と不規則に立ち塞がつてゐる山が次第に四方へ片づいて、人の住むべき地歩を少し許り讓つてゐるやうな氣がする。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "物置の中には、いろ／＼の物がゴチヤ／＼してゐて、緑礬の入れてあつた大きな茶碗へ新らしく水を盛つたのが、マッチの灯であり／＼と見られた。",
              "citation": {
                "source": "天滿宮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒屋の小僧や自轉車乘の小僧や小供がゴチヤ／＼高低になつてゐる。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しみと癇癪とがゴチヤゴチヤに迫つてきて、私は外套のポケットへやんちやに手を突つ込んだまま、涙で顔中ぬらぬらと濡れてくるのを拭はうともしずに、馳け出してみたり、馬鹿らしくなつて歩いてみたりしてゐた。",
              "citation": {
                "source": "イボタの虫",
                "author": "中戸川吉二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうして」「だつて僕等の今の汽車が一時間ばかり延着したらう」「ええ」「赤帽に訊くと、そんな事で、此處の發車時間がすつかりゴチヤゴチヤになつたんださうだよ」「へえ、さう」　と妻は淋しさうに目をパチクリさせてゐる。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワツシヨイ／＼と帰つて来ると、校舎の玄関を入つて左に折れ、たつた一つの教室の入口の土間に飛びこみ、そこへゴチヤ／＼に草履や下駄を脱いで教室にながれ込むのですが、履物にはみんな名札が附いてゐたので、めつたに無くなることはありませんでした。",
              "citation": {
                "source": "先生と生徒",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりでなく原つぱの向ふは一面の家で、ゴチヤ／＼込み合つて立ち並んだ小さい家の屋根には、「井戸ポンプ修繕」「ブリキ」「下駄のはいれ」などと書いた看板さへハツキリ見えてゐるのです。",
              "citation": {
                "source": "文化村を襲つた子供",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、ゴチヤゴチヤしてゐる有様が、とんと、国芳の絵本かなんぞを見るやうであつた。",
              "citation": {
                "source": "洲崎の印象",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、これは又、地方山間の人の広々とした記憶経験とは似ても似つかないまでに、ゴチヤゴチヤとして、身辺一間毎に、いや一尺毎に複雑極まりない。",
              "citation": {
                "source": "両国界隈",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "この邊の見世物輕業の小屋は、粗末なものではあるにしても、半永久的の建物で、裏に廻ると怪しげ乍ら住居になつて居り、餘程の良い藝人でなければ、別に家を持たずに樂屋裏のアパートに、ゴチヤゴチヤと合宿してだらしのない生活をして居るのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "一と目千兩",
                "note": "青空文庫"
              }
            },
            {
              "text": "遅れた者も先頭の者もなく、十人の者が殆どゴチヤ／＼とかたまつて来たのであつた。",
              "citation": {
                "source": "怒れる高村軍曹",
                "author": "新井紀一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
