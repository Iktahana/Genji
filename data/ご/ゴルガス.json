        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハヴァナの公衆衛生はゴルガス博士の手にあり、９月のあいだに市から黄熱病を一掃し、アメリカ軍撤退の後に少しの発生はあったが、その後は何世紀にもわたって存在した天罰を受けないですむようになった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎月、小さい灰色表紙のパンフレットがゴルガス大佐によって刊行された。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴルガスによって衛生状態が著しく進歩している証拠として1912年の月報のうちの１冊を無作為に取り出して例としよう。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "医学はゴルガス大佐およびそのスタッフにこの素晴らしい例を感謝するだけでなく、彼らは全世界の尊敬を得た徹底さと能率の例を提供してくれている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
