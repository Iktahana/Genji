    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "廿一日朝まだきに起き出でて見るに有明の月東の空に残りて雨はなごりなく晴れたり。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹脂の香に　朝は悩まし　　うしなひし　さまざまのゆめ、森竝は　風に鳴るかなひろごりて　たひらかの空、　　土手づたひ　きえてゆくかなうつくしき　さまざまの夢。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして下宿へ帰ると井戸端へ行って水ごりをとった。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いふまでもなく先生は私の三田｜文科生時｜代からの先生であるが、球突では始終喧嘩相手で、銀座裏の日｜勝亭で勝負を爭つて、その成績で風月｜堂の洋食のおごりつこをしたなどもしばしばである。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御奉公のおなごりに、皆さんお酌、と来たから、難有え、大日如来、己が車に乗せてやる、いや、私が、と戦だね。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "逢うが別れの今世に、臨終のなごりを惜むため、華燭銀燈輝いて、見返る空に月のごとき、若竹座を忍んで出た、慈善市の光を思うにつけても、横町の後暗さは冥土にも増るのみか。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人夫婦に別を告げつつ、民子は雁にも殘惜しいまで不便であつたなごりを惜んだ。",
              "citation": {
                "source": "雪の翼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処でお茶をお入れ下すった上のお話じゃ、結構過ぎますほどですが、あの歌に分れて来たので、何んだかなごり惜い心持もします。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと、肉身のものの目に、その丈より長い黒髪の、三筋、五筋、筋を透して、大蛇の背に黒く引くのを見る、それがなごりと思うが可い。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　さて壇を退きざまに、僧のとざす扉につれて、かしこくもおんなごりさえ惜まれまいらすようで、涙ぐましくまた額を仰いだ。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」……大歎息とともに尻を曳いたなごりの笑が、更に、がらがらがらと雷の鳴返すごとく少年の耳を打つ！",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……水ごりでも取りましたか、それとも途中の小川へでも落ちたんでしょうか。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅空掛けてこうしたお世話を受けるのも前の世の何かだろう、何んだか、おなごりが惜いんです。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その姿の、轍の陰にかくれるのが、なごり惜いほど、道は次第に寂しい。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "片翼になって大道に倒れた裸の浜猫を、ぼての魚屋が拾ってくれ、いまは三河島辺で、そのばさら屋の阿媽だ、と煮こごりの、とけ出したような、みじめな身の上話を茶の伽にしながら――よぼよぼの若旦那が――さすがは江戸前でちっともめげない。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "真向うは空地だし、町中は原のなごりをそのまま、窪地のあちこちには、草生がむらむらと、尾花は見えぬが、猫じゃらしが、小糠虫を、穂でじゃれて、逃水ならぬ日脚の流が暖く淀んでいる。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰げば白きもの仄見ゆる、前の日雨ふりし前なりけむ、姉上の結びたまいし折鶴のなごりなり。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなが私の靴を見つめているような、たいへんな、おごりの気持よ。",
              "citation": {
                "source": "俗天使",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でも、そのなごりか、おそばやが四、五軒、軒をつらねて、今の時代には珍らしく「やすんで行きせえ。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この世のなごりに、関西で遊ぶのも悪くなかろう。",
              "citation": {
                "source": "犯人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものかいて扇ひき裂くなごり哉　ふたみにわかれ十九日。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、冷いにごり酒を二、三杯のまされ、そうして、かれらの句というものを、いくつか見せつけられたのである。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おりおり時雨しめやかに林を過ぎて落葉の上をわたりゆく音静かなり」同二十七日――「昨夜の風雨は今朝なごりなく晴れ、日うららかに昇りぬ。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "山脈は若い白熊の貴族の屍体のようにしずかに白く横たわり、遠くの遠くを、ひるまの風のなごりがヒュウと鳴って通りました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が青ぞらを吼えて行けば　そのなごりが地面に下って　クラレの花がさんさんと光り　おれたちの袍はひるがえる。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」農民一「厚ぐ蒔ぐて全体陸稲づもな、一反歩さなんぼごりゃ蒔げばいのす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」農民一「枯れだどごぁ半分ごりゃだんす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」農民一「水さなんぼごりゃ入れるのす。",
              "citation": {
                "source": "植物医師",
                "author": "郷土喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉には水の幡かゝり、　　　　しぶきほのかに拡ごりぬ。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてごりっぱなものであって、だれも貶める言葉を知らなかった。",
              "citation": {
                "source": "源氏物語",
                "author": "桐壺",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
