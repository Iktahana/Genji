        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その最も標本的に現われているのは、越中薬師岳（二九二六米突）、信州黒部の五郎岳（二八四〇米突）などで、一体に槍ヶ岳から以北、即ち立山山脈、または後立山山脈に頗る多い。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐倉宗五郎じゃあるまいし。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "姓名は須川五郎、二十六歳。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこの陰謀の伴類の中に和田さまの御子息、四郎義直さま、五郎義重さまも、甚だまづい事でございましたが、はひつて居りまして、おのおのお預けの身になつてゐたのでございます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じようなことをしばしば菊五郎三津五郎の踊りで見ることがある。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後四時にはもう三代吉の父親の辰五郎が白米、薩摩芋、大根、茄子、醤油、砂糖など車に積んで持って来たので少し安心する事が出来た。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の事はない、美少年録のソレ何だっけ、安保箭五郎直行さ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "安保箭五郎悪い事は言わないが、どうだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さればこそ、松五郎。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――蟹五郎すかりすかりと横に追う。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　水心、魚心だ、その礼に及ぼうかい。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　こいつにか。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　人間の首が飛んだ状だな、気味助、気味助。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　その事かい、御苦労、御苦労。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　神通広大――俺をはじめ考えるぞ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯉七　そこだの、姫様が座をお移し遊ばすと、それ、たちどころに可恐しい大津波が起って、この村里は、人も、馬も、水の底へ沈んでしまう……蟹五郎　何が、何が、第一俺が住居も広うなる……村が泥沼になるを、何が遠慮だ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　南無三宝、堂の下で誓を忘れて、鐘の影を踏もうとした。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　帰途はお池へ伴侶だ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　かッかッ、怪しいものだ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　お山の池の一の関、藪沢の関守が控えた。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　鯰入は御坊かい。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　お使、御苦労です。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　さあ、御坊。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　何と腰を押そうかい。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）蟹五郎　かッ、かッ、かッ、（と笑い）御坊、おまめです。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）蟹五郎　お笑止だ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯉七　幸、五郎が鋏を持ちます……密と封を切って、御覧が可かろう。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　もっとも、もっとも。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹五郎　やあやあやあ！",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
