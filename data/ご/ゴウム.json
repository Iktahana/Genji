        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "暗号無電　太刀川は、飛行艇にぶじ乗りうつることができた。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほう、これは暗号無電じゃないか、なにごとが起ったのか」　艇長は、しばらく黙っていた。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、たえず暗号無電で、軍艦明石の無電班と連絡をとっていたのであった。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "交差点で信号無視の四輪と衝突。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "分隊所属の六号無線機が、英米に対する宣戦布告を傍受した。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「戦況の具合は、どうだね」　霊丘県の山奥の六号無線機では、新聞通信もろくに入らない。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
