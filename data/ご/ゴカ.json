  {
    "uuid": "5b33c650-b644-52f5-bd7c-472171fe70a8",
    "entry": "ゴカ",
    "reading": {
      "primary": "ごか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どんなに苦しんでも、『暮せない』人間が、どぶの中のゴカイみたいに、押し重なって、ウヨウヨしてるんだ。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツクマデ　ウゴカズ。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴカキ新美南吉　ツキヨノ　マツナミキノ　ミチデ　一リノ　サムライガ、ウシロカラ　ハシツテ　キタ　カラノ　カゴニ　ノセテ　モラヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シバラク　スルト、ウシロノ　カゴカキガ、「シーツ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マヘノ　カゴカキモ、「シーツ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タニガワノ　オトガ　ダンダン　チカク　ナツテ　キタ　トコロデ、トツゼン　カゴカラ　トビダシ、カゼノヤウニ　ハヤク　グングン　ニゲマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト、カゴカキノ　一リガ　ツエヲ　フリナガラ、「オーイ、ダンナア。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ　カケツケタ　カゴカキガ、「ダンナ、カタナヲ　オワスレニ　ナリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴカキハ、「ダンナ　カンチガヒデスヨ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウレ　ゴラン、オマエサンノ　カゲデ　ナイ　シヨウコニ、オマエサンガ　トンデモ、アノ　カゲハ　ウゴカナイデハ　ナイカ」ト　ポストハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエダケガヨナカニヒビイテ、オ母ッチャハウゴカナイ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "フカシイモ、ウドン、ゴカイ、ムキミ、ミミズ、サナギを飴糟にて練りたるもの、などを用ゐる。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケイサツニツゲタリ、コノハナカゴヲウゴカスト、スグバクハツサセマス、ワタクシタチノブカガ、イツモチャントミテイマス。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそう見てとって安心したが、図にのって、こまかくせゝくるとゴカンムリをまげさせるばかり、万事は時期というものがある。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴカイを小さくして透明にしたような虫だ。",
              "citation": {
                "source": "桐生通信",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に諸氏の尊顔を拝するのも心苦しいのですが、これひとえに農村不況の致すところでありまして、流汗リンリ、ゴカンベン下さい」　四十八枚売ったうち、たった八枚ぶん差しだした豪の者もいる。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに合せて「どうぞゴカンベン。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴカンベン」「不思議だなア、先生は」　と云って、チョンマゲのクビをかしげていた。",
              "citation": {
                "source": "太宰治情死考",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひらにゴカンベンねがいます」　額をタタミにすりつけて、平伏する。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "以後心掛けを改めますから、なにとぞゴカンベン下さい」「じゃア記憶のないときザンキにたえないことを時々なさるのね」「まことに面目ありません。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛸重に限らず登場人物一様に怪しからぬヤカラのみで、淳風良俗に相済まぬ次第ですが、これもスカンク流極意の一手、ゴカンベン願います。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪しからずゴカンベン下さい」「で、横浜へ泊ったのですか」「いゝえ。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし舞台のストリップを見れば一目瞭然であるが、このうえ全ストなどゝいうものはそればッかりはゴカンベンという気持になる。",
              "citation": {
                "source": "安吾巷談",
                "author": "ストリップ罵倒",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞゴカンベン下さいまし」「江戸表に於ての評判も心得ておる。",
              "citation": {
                "source": "花咲ける石",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの大事な秋田犬をおだててみたり、悪口云ったり、甚だしく陰陽ただならぬところはゴカンベン願う。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっそく小鳥を放しますから、ゴカンベン下さいまし」「それならば今回は許してつかわす」　と放してもらったそうだ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮の影響のある流れでは、イトメやゴカイを使うのである。",
              "citation": {
                "source": "寒鮒",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いままで、東京方面から遠征してくる釣り人は、イトメやゴカイ、袋イソメなどを持参しているが、僕のやり方は、そんな高価な餌はいらない。",
              "citation": {
                "source": "那珂川の鱸釣り",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴカイや袋イソメの餌は、一度もやって見た事はなかった。",
              "citation": {
                "source": "河鱸遡上一考",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "涸沼川の平戸橋付近にいくらでもゴカイやイソメを売って居るからやれるのである。",
              "citation": {
                "source": "河鱸遡上一考",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
