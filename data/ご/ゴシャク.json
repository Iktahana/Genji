        "examples": {
          "standard": [
            {
              "text": "言葉の厳密な定義を知るために、国語辞典の語釈を一行ずつ丁寧に読み解く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "専門用語の語釈が不十分だと、論文全体の論理構成が崩れてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "英和辞典の語釈を比較して、日本語にはない微妙なニュアンスの違いを学ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "語釈其他此前うたには、狐火のことは出て来ない。",
              "citation": {
                "source": "地唄",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに反して、自分の仕事は、主として語原や語史、語誌や語釈の、主として分解的な、しかし根本的本質的な方面の考究に専念し、綜合的方面の事業に意を致し力を注ぐまでには至らなかった。",
              "citation": {
                "source": "『広辞苑』自序",
                "author": "新村出",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
