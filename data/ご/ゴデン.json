[
  {
    "uuid": "1d9c4123-aa0d-5542-b08a-a3eb7f201422",
    "entry": "誤伝",
    "reading": {
      "primary": "ごでん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
