        "examples": {
          "standard": [
            {
              "text": "検査を通過した合格品だけが出荷される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "不良品と合格品を区別して管理する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この部品は、厳格なテストに合格した合格品です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "外聞がわるそうな公売で、東芝の生産した不合格品のストックや、会社として負担になっていたけれども潰してしまえなかった下請け工場の整理が出来て――労働者をクビにすることが出来て――或る意味では悪くなかったというのが現実である。",
              "citation": {
                "source": "正義の花の環",
                "author": "――一九四八年のメーデー――",
                "note": "青空文庫"
              }
            },
            {
              "text": "万人には最低の生活が配給されていたが、軍人や会社上司の特権階級は、今日との物資の比例に於ては同じように最高級の酒池肉林であったことに変りはなく、監督官庁の役人は金次第で、あとは表面の帳面ヅラを合せておけば不合格品ＯＫだ。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
