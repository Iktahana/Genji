[
  {
    "uuid": "95ecaa06-e22a-5072-be04-e6cc10ecab43",
    "entry": "破落戸",
    "reading": {
      "primary": "ごろつき",
      "alternatives": [
        "ゴロツキ"
      ],
      "is_heteronym": false
    },
    "grammar": {
