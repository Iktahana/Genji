        "examples": {
          "standard": [
            {
              "text": "「いらっしゃいませ！ご新規のお客様１名様、ご案内します！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "美容院で「本日はご新規の方限定のクーポンをご利用いただけます」と言われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "開店したばかりの居酒屋は、多くのご新規さんで賑わっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "なれども、事はなるべくに荒だてぬが従来もわしの吟味方針じゃによって、そのうえにまた加賀守家というご名門の名にもかかわることゆえ、いっさいは穏便に取り扱ってつかわすゆえ、爾今はせっかくご新規八百石をたいせつにいたさねばならぬぞ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
