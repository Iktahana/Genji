[
  {
    "uuid": "0896a16c-2ff3-50d1-94ba-736375418733",
    "entry": "ご不浄",
    "reading": {
      "primary": "ごふじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "bathroom",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「失礼、ちょっとご不浄を拝借します」と言って、彼は席を立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い旅館の廊下の突き当たりに、木造りの清潔なご不浄があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "おばあちゃんはトイレのことを今でも「ご不浄」と上品な言葉で呼んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "昨夜、お店で前川がご不浄に立ったとき、（明日二時、ちょっと来ます）と、行きずりに囁いたので、早く店へ行かねばならず、大急ぎで化粧をした。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "とっくにもうお番所だと思いましたから、あっしゃご不浄の中までも捜したんですぜ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卍のいれずみ",
                "note": "青空文庫"
              }
            },
            {
              "text": "居ないわネ」「ど、どこへ行ったんでしょうネ」「ご不浄へ行ったんじゃないこと」「ああ、ご不浄へネ。",
              "citation": {
                "source": "柿色の紙風船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この方、ご不浄へ行っちゃいけないことになってんのよ」「まあどうして？",
              "citation": {
                "source": "柿色の紙風船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり肛門にラジウムを差し込んであるんだから、ご不浄へは行っちゃいけないのよ」「治療中だからなのねェ」「それもそうだけれどサ、もし用を足している間に、下に落ちてしまうと、あのラジウムは小さいから、どこへ行ったか解らなくなる虞れがあるでしょう」「そうね。",
              "citation": {
                "source": "柿色の紙風船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたし、ご不浄へ行って探してみるわ。",
              "citation": {
                "source": "柿色の紙風船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご不浄の手洗の鏡にまで白墨で書いてある。",
              "citation": {
                "source": "速水女塾",
                "author": "四幕と声のみの一場よりなる喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "好子　　ご不浄でもないわ。",
              "citation": {
                "source": "雪だるまの幻想（ラジオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "長持ち部屋だの、用途不明な部屋が、あちらこちらにあり、入り側になった廊下には、必要もない段々をつけて、わざと上ったりおりたりさせ、上の厠といっている二ノ間つきのご不浄は、畳を敷きつめた六畳ほどの広さで、地袋の棚には、書見台と青磁の香炉が載っているといったぐあいである。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "植込みのなかに突きだした『ご不浄のサロン』は、芽出しの若葉に三方から囲まれ、ソファに坐って窓のほうを見ると、いぜん、われわれが、しゃがみながらながめたその位置に、むかしどおりの布袋竹と丁字の葉むらが、そよそよと風にそよいでいる。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "千々子さまを探しながら、西のご不浄のサロンへ行くと、机の上に、『結婚式の心得』という薄っぺらなパンフレットが置いてあって、会師、二人ノ手ヲ合セテ、言ウ神の合せ給える者は、人これを離すべからず。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やいこら、静かにしろ」　と庭へ追いもどすと、つぎの朝には、ご不浄の窓から入りこみ、天井の玉縁を這いまわって、ぎょっとさせた。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "機嫌のいいときは、メード専用の日本式のご不浄へ入って、大きな声でジャズ・ソングをうたう。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "少時すると乳母やさんは達也様を小さい寝台の上にねかしつけ、ツト、起って廊下へ出ました、たぶんご不浄へでも行ったのでしょう。",
              "citation": {
                "source": "美人鷹匠",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
