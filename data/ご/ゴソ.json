[
  {
    "uuid": "1a95340f-3ea9-5bfd-9b10-7c36dea6ccbc",
    "entry": "語素",
    "reading": {
      "primary": "ごそ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
