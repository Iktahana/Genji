    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　眞野はそれに答へず、ごそもそと寢返りをうつて、ひとりごとのやうに呟いた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」小菅はおごそかに眼をつぶつた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "確乎たる自信が、あって、もっともらしい顔をして、おごそかな声で、そう言ったつもりなのであるが、いま考えてみると、どうしても普通でない。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖母は椅子に腰かけて、こくりこくりと眠りはじめ、術者のおごそかな問いに、無心に答えるのである。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、ひどくもったい振ったおごそかな声で、「まとまったようです。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その顔は輝くばかりに美しかった、と書いて、おごそかに眼をつぶり暫く考えてから、こんどは、ゆっくり次のように書きつづけた。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "下から南京虫がごそ／＼と這い出してくる。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "虱は温か味が伝わるに従って、皮膚をごそ／＼とかけずりまわった。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、それをさきへやり過ごそうとした。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那語で笑い喋りながら、六七人の若者がごそごそとあがってきた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と薄暗い顔を上げてニヤリと笑いながら、鳥打帽を取ってお時儀をして、また被り直すと、そのままごそごそと樹を潜って廂に隠れる。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ、ごそごそと池を廻って響いて来た。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのままじっと覗いていると、薄黒く、ごそごそと雪を踏んで行く、伊作の袖の傍を、ふわりと巴の提灯が点いて行く。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "威儀おごそかに渠らの着席せるとき、正面の戸は再び啓きて、高爽の気を帯び、明秀の容を具えたる法官は顕われたり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ちと以前より、ごそごそと、台所で、土瓶、炭、火箸、七輪。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "是から推上らうと云ふのに一呼吸つくらしく、フト停まると、中でも不精らしい簑の裾の長いのが、雲のやうに渦いた段の下の、大木の槐の幹に恁懸つて、ごそりと身動きをしたと思へ。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでしばらくごそごそしている様子だった。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがすこしごそついて、山の手の智識階級の青年でもなく、下町の商家の息子でもなく、何か中途半端で懐疑的な性格が姿にも現れているようでいて、根は人の良い怜悧な青年でした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙袋がごそごそといって、蓑吉の傍へ余計近よると、蓑吉は手だけ延ばした。",
              "citation": {
                "source": "娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日がくれて間もない時刻であるから、銘々の家から、明りがさし、人の話声なども、しかとはわからないが、ごそごそと耳にはひる。",
              "citation": {
                "source": "夜烏",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその返事はたゞごそごそごそっとつぶやくやうに聞えました。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此鉤に種々の餌を付けて置くので、其餌には蚯蚓や沙蚕も用いる、芋なども用いるが、其他に「ゴソッカイ」だの「エージンボー」だのという、陸にばかり居る人は名も知らないようなものがある。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "発表されてから一ト月ほどの予猶など、瞬く間に過ぎてしまって、ただわけもなく遽しさの中に、若い所員たちがゴソッと立って行ってしまった感じだった。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日からこの世の中での頼る人がまたひとり減るのかと思えば、ゴソッと身体の一部を揉ぎ取られる思いだった。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴソッ、ゴソッと、とおくから、土の中を歩く音が聞こえてきます。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴソッ、ゴソッ、ゴソッ……、足音はだんだん、こちらへ、ちかづいてきます。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
