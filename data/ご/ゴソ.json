      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "word root (smallest portion of a larger word that holds meaning)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「言語学」という言葉は、「言語」と「学」という二つの語素からできています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "語素を理解することで、新しい単語の意味を推測しやすくなります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "日本語の動詞には、様々な語素が付いて活用します。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あの晩、おれは、中野の言語素振りに殊に気を引かれた。",
              "citation": {
                "source": "朝やけ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでしばらくごそごそしている様子だった。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、それをさきへやり過ごそうとした。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那語で笑い喋りながら、六七人の若者がごそごそとあがってきた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "久次郎もそれを信用して、なにぶんお頼み申すと云うと、行者はお豊を神壇の前に坐らせて、一種のおごそかな祈祷を行なってくれた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "改めておふくろ殿にお掛け合いをいたすために、こんにち罷り越した次第であると、式部は形を正しゅうしておごそかに云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "下から南京虫がごそ／＼と這い出してくる。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "虱は温か味が伝わるに従って、皮膚をごそ／＼とかけずりまわった。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」おじいさんはごそごその着物のたもとを裏返しにしてぼろぼろの手帳を出してそれにはさんだみじかい鉛筆を出してキッコの手に持たせました。",
              "citation": {
                "source": "みじかい木ぺん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キッコはまだ涙をぼろぼろこぼしながら見ましたらその鉛筆は灰色でごそごそしておまけに心の色も黒でなくていかにも変な鉛筆でした。",
              "citation": {
                "source": "みじかい木ぺん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでキッコはその鉛筆を出して先生の黒板に書いた問題をごそごその藁紙の運算帳に書き取りました。",
              "citation": {
                "source": "みじかい木ぺん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう云うごとほんと云うごそ実ぁあるづもんだ。",
              "citation": {
                "source": "十六日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なになんでもないですよ、大丈夫ですよ」と学生がさも請け合ったように言ったのに対して、駅員は急におごそかな表情をして、静かに首を左右にふりながら「いや、そうでないです、そうでないです。",
              "citation": {
                "source": "小爆発二件",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　眞野はそれに答へず、ごそもそと寢返りをうつて、ひとりごとのやうに呟いた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」小菅はおごそかに眼をつぶつた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその返事はただごそごそごそっとつぶやくように聞えました。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おごそかな神祭の席にすわっている時、まじめな音楽の演奏を聞いている時、長上の訓諭を聴聞する時など、すべて改まってまじめな心持ちになってからだをちゃんと緊張しようとする時にきっとこれに襲われ悩まされたのである。",
              "citation": {
                "source": "笑い",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆえ彼は第一学期の試験が来るまで、じっと自分の家にいて養生をしながら過ごそうと思いついたのだ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "純次は何か手ごろの得物をさぐっているのらしくごそごそと臥床のまわりを動きはじめていた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悒鬱な氣分が靜かにおごそかに彼れを壓倒しようと試みるらしかつた。",
              "citation": {
                "source": "幻想",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（石膏面をながめながら）死はいかなる場合においても、おごそかな悲しいもんだ。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙袋がごそごそといって、蓑吉の傍へ余計近よると、蓑吉は手だけ延ばした。",
              "citation": {
                "source": "娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
