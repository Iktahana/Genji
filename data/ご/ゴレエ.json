          "literary": [
            {
              "text": "午後六時、ネゴレエ着。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "理由はポーランド国境のネゴレエ入国の際、旅券にその記入を忘れていたためだ。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "検屍はシャルル・ゴレエ、レオポルド・ミショオ、シャルル・ポオリュウ三議員の立会いの下にペルタン、デュマニャンの医師によって行なわれ、王女マリイ・テレーズの認証があった。",
              "citation": {
                "source": "カストリ侯実録",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "検屍に立会った議員シャルル・ゴレエの「余の証言」によると、太子は大体五日の夜あたりに死んだのらしいが、誰一人知らず、八日の朝、食事を差し入れに行った使丁が発見したときには、死体は大部分鼠に食われていたというのが真相らしい。",
              "citation": {
                "source": "カストリ侯実録",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
