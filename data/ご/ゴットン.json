        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我等の小さな汽車、唯だ二つの車室しか持たぬ小さな汽車はそれからごっとんごっとんと登りにかかった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二社の鉛筆工場の水車の音が、ごっとんごっとん耳に響く。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉛筆工場の水車の音がごっとんごっとん耳について来る。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごっとんごっとんと、重いひびきが地底からひびいてくる。",
              "citation": {
                "source": "時計屋敷の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "地底戦車は、ごっとん、ごっとんと、ゆるやかに、氷の中を縫っていった。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "トニーの旦那、いままた、大きくごっとんと、うごきましたよ。",
              "citation": {
                "source": "豆潜水艇の行方",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごっとん、ごっとん、ごっとん。",
              "citation": {
                "source": "豆潜水艇の行方",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "学士が、潜望鏡のハンドルをもって、ごっとんごっとんやっているのを、しばらく見ていた春夫少年は、やがてぷっとふきだしました。",
              "citation": {
                "source": "豆潜水艇の行方",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このとき春夫は、足の下から、かすかではあるが、ごっとんごっとんと、エンジンが廻っているらしい震動が、ひびいてくるのを感じました。",
              "citation": {
                "source": "豆潜水艇の行方",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして暫くすると、その閊えたものが、胃袋の底へ、ごっとん、ごっとん、さがってゆく。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこに閊えるのか分らないが、確かに閊えて、そしてやがて、ごっとん、ごっとん、下ってゆくのである。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者にみせても原因は分らないし、この節ではもう諦めて、ごっとん、ごっとんを、却って楽しみに待つのだった。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやですわ、胃の中でごっとんごっとん音がするなんて。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それより、胃袋の中のごっとんごっとんの方が先だろう。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "胃袋のなかの、ごっとんごっとんか。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "大工はフォックスル（おもての甲板）へ上がって揚錨機をゴットンゴットンと調節したり、油を差したりしていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "だけど、そうして眼が醒めてからの苦しくて情なかった事……軍艦の器械のゴットンゴットンという響きが身体に伝わるたんびに、毛布ごしに床板に押しつけられている背中と、腰骨と、曲ったまんまの膝っ節とが、まるで火が付いたように痛むじゃないの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、それは夢じゃなかったの……そうして歯を喰い締めて、一心に耳を澄ましていると、ゴットンゴットンという器械の音の切れ目切れ目に、ドド――ンドド――ンっていう浪の音が、どこからか響いて来るじゃないの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴットン、ゴットンという御輿の転される音は、遅くまで谷底の方で、地響のように聞えていた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴットン、ゴットンと煩く耳についたは、水車の音であった。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つの大振りの木の槌が、ゴットンゴットンと台の上へ、規則正しく落ちている。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガッタンゴットン荒れ放題にひきずり降すんでしょう。",
              "citation": {
                "source": "桂馬の幻想",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が病気のオヤジサンを大八車に荒ナワでしばりつけて坂道を大いに荒っぽく手心しながらガッタンゴットンひきずり降したことだって、要するにただ運動ですね。",
              "citation": {
                "source": "桂馬の幻想",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々都内電車だけが仕方がねえやというようにゴットンゴットン走っているだけだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもちゃの汽車竹内浩三ゴットン　ゴットン汽車が行くケムリをはいて汽車が行くアレアレアレアレ脱線だお人形さんの首が飛びキューピイさんの手が飛んだ死傷者優に三十個オモチャの国の大椿事",
              "citation": {
                "source": "おもちゃの汽車",
                "author": "竹内浩三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロゴロゴットン、ゴロゴロゴットンと、神経をうずかせる様な機関の響が、全身に伝わって来ます。",
              "citation": {
                "source": "パノラマ島綺譚",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "小広い平地があって、竹林のしげった隅に、一｜軒の茅葺屋根がみえ、裏手をながるる水勢のしぶきのうちに、ゴットン、ゴットン……水車の悠長な諧調がきこえる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　ゴットン、ゴットン、ゴットン……　水車の諧調に、あたりはいつか、たそがれてきた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴットンゴットン各駅に停車して、横浜へついたのは、もう正午に近い頃であった。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
