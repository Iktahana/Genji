        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゴーゴルか誰かの小品で読んだ、パンの中から出た鼻の捨場所を捜してうろついて歩いている男の心持を想い出した。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "”怪物ウラゴーゴル　辻川博士は何処へ行った？",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ等はウラゴーゴルだ”　ウラゴーゴル？",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラゴーゴルとは何であろうか。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラゴーゴルとは、何処かで聞いた名前である。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラゴーゴルとは何です。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうか教えて下さい」今や最後に残った一匹の白幽霊――ではないウラゴーゴルが床の上から天井に昇ろうとするのを引き留めて、大隅は一生懸命に訊ねた。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　最後のウラゴーゴルの姿も、遂に天井の向うに見えなくなってしまった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "武夫の父親　怪物ウラゴーゴル！",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大隅学士は只一人室内に取り残されたまま、暫くは物に憑かれたように、ウラゴーゴルとシュワルツコッフ博士の名をくりかえして叫んでいた。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくは分らないけれど、あのウラゴーゴルは人間の幽霊ではなさそうに思える。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく辻川博士は、ウラゴーゴルが何者であるかを知って居り、彼等と交際をしていたと思われる。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュワルツコッフ博士もまたウラゴーゴルと交際っているのであろう。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは辻川博士のウラゴーゴルについての手記が必ずどこかにある筈である。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手記というか研究ノートというか、その書き物を見れば、ウラゴーゴルの秘密は、幾分わかるであろう。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は岩蔵の言葉の調子から、彼が既にウラゴーゴルを知っているらしいのを感じたのだった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」シュワルツコッフ博士といえば、あの白幽霊のウラゴーゴルが残していった名前だ。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "白幽霊ウラゴーゴルなどは、何んな役割をつとめているのでしょう」　するとドクトルは、ひどく狼狽の色を見せて、椅子から突立った。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ウラゴーゴルこそ、この研究の最後の鍵なのです。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああウラゴーゴル」　ドクトルは、神に祈りを捧げるときのような恰好をして、天を仰いで歎息をした。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "武夫と再会　ウラゴーゴルを怒らせてはならぬと、大隅学士に注意したシュワルツコッフ博士は、それからというものは、急に沈黙してしまって大隅学士がなんと聞こうとも、それ以上の説明を避けた。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "白幽霊ウラゴーゴル！",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュワルツコッフ博士すら、ウラゴーゴルに一目も二目も置いている有様がよく分った。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラゴーゴルと握手をしているらしいのは、辻川博士だけらしいが、その博士はいまごろ大戸神灘の海底で白骨に化していることだろう。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとかしてウラゴーゴルの秘密を早く知りたいものだ。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのウラゴーゴルというのは、要するに他の遊星に住んでいる生物だと思うよ。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのウラゴーゴルが、なにかこの地球に働きかけているせいだと思うよ」「それに違いありませんよ。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生、するとウラゴーゴルなどという怪物は、そんなことで発生したものではないでしょうか」「大きにそうかも知れない」　と大隅学士は相槌をうった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの先生、今どうしているのですか」「ウラゴーゴル星に上陸しているそうです」「ええッ、ウラゴーゴル星に上陸？",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
