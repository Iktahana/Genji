        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はヘビーメタルをゴリゴリ聴く、ハードコアなファンだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このゲームは、ゴリゴリのゲーマー向けに作られている。",
