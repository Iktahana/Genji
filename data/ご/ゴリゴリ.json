    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "短刀か庖丁でごりごりやったらしい。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "水色ちりめんのごりごりした地へもって来て、中身の肉体を圧倒するほど沢瀉とかんぜ水が墨と代赭の二色で屈強に描かれている。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "淵沢小十郎はすがめの赭黒いごりごりしたおやじで胴は小さな臼ぐらいはあったし掌は北島の毘沙門さんの病気をなおすための手形ぐらい大きく厚かった。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三はかつて葉子の故郷で、昔、先夫の松川と結婚の夜に着飾ったという、小豆色した地のごりごりした小浜の振袖に、金糸銀糸で千羽｜鶴を刺繍してある帯をしめた彼女と、兄夫婦に妹も加わって、写真を取ったことがあった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔の綺麗なその良人は、ごりごりした帯や袴の紐に金鎖を絡ませながら、ぬッとした顔をして出て行った。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "山内は、お銀がつぐ酒を、黒羽二重の紋附や、ごりごりした袴に零しながら、爛れたような目をして、やっと坐っていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて弁当の支度を母親に任かして、お絹は何かしら黒っぽい地味な単衣に、ごりごりした古風な厚ぼったい帯を締めはじめた。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "のつそりとして草履の下へ入れた小石をごりごりとこすつてゐて行くとも行かぬともいはぬ。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "顋のあたりに利刃がひらめく時分にはごりごり、ごりごりと霜柱を踏みつけるような怪しい声が出た。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごりごりした顎髯にも痛まない程｜掌面は硬いらしかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い声では言へないが、神様の仕事にも、実は無駄があるもので、髯なぞもう伸びなくてもよささうなあの老人の顔から、不思議にごりごりした白いのが頭を持ち上げて来る。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "家畜小屋の閂のような、非美術的極まる留置室の扉が、此の上なく野蛮な音をたてて、ごりごりときしみながら開いた。",
              "citation": {
                "source": "犠牲者",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "只酒を飲んで、「あゝいゝ気持ちだわ」と云ふことが、何となく亭主の前では憚ばかられて、口の先では、「お化けだよウ」と呶鳴り、心のうちでは牛の舌のやうな奴をべろんと出していゝ気持に、船底枕をごりごりゆすぶつて嘉吉を気味悪るがらせておくのであつた。",
              "citation": {
                "source": "朝夕",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "会社員の関と云う男の肩はライオンの様な波を打っていたし、古物商の息子の中村は絹のごりごりするような襯衣を着ていた。",
              "citation": {
                "source": "帯広まで",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今やホテルの南側の窓下が、がりがりごりごりと盛んに噛られてゆき、見る見る大きな穴が明いてゆく。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "柱が壊れないようにそろそろやるように注意を頼む」恐ろしき謎　鋸引きの音が、ごりごりいっている間に、敬二は博士のそばへいって声をかけた。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "食はぬのもどうかと思はれたので、一つ口に入れて見ると、固い羊羹はごりごりと音を立てた。",
              "citation": {
                "source": "間木老人",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに人々の話を聞くと、今日は誰が足を一本切つたの、腕を片方外科場に置いて来たのと言ひ、しかも切られる本人は、医者が汗を流しながら鋭い鋸でごりごり足をひいてゐるのに、平然と鼻歌の一くさりも吟じて知らん顔をしてゐるといふのである。",
              "citation": {
                "source": "間木老人",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "噛むとごりごりするやつ、まるで、鷓鴣の羽根肉にもぐってる鉛の弾丸みたいに、がちりと来るやつ、あれを食うくらいなら、鶴嘴の先を齧ったほうがましだ」にんじん――こいつは、舌の上で溶けるね。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、トランクはまだ失くなったわけじゃないと思いますよ」「そう思ううちがしあわせでさあ」と、男はいって、短くて濃い黒い髪の毛をごりごりかいた。",
              "citation": {
                "source": "火夫",
                "author": "DER HEIZER",
                "note": "青空文庫"
              }
            },
            {
              "text": "忘れもせぬ「ワットマン」と云うごりごりした紙へ描いてあって、その絵の為に『風見』はあけにくい位でしたが、私はそれを見た時、頭がカァーッとする程亢奮しました。",
              "citation": {
                "source": "少年の食物",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "木賃宿にあるものは、みんなバルブレンのおっかあのうちのと同様にごりごりしていた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の織物は何でもこの通りごりごりしている、今のはどんな物だって大概人絹が這入ってるんだから、………」乗り物で行くほどでもないのでめいめいが重箱や折詰の包を提げながら出かけたが、「もう日傘がいりますなあ」と、お久は照りつけられるのを恐れて手をかざした。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その言いぐさに　アナ＝マライアが　くいかかろうとした　そのとき、　だしぬけに　頭上から　べつの　物音が　聞こえてきます　――　のこぎりの　ごりごりという　音で　それから　ひっかきながら　わんわん　ほえる　子犬の　声も！",
              "citation": {
                "source": "ちょびひげサミュエルのはなし",
                "author": "まきまきパンのまき",
                "note": "青空文庫"
              }
            },
            {
              "text": "くわえるところは烈しくかんであって、先の鉢のなかは乱暴にごりごり掻いてあり、しょっちゅう叩きつけるので、ふちが疵だらけです。",
              "citation": {
                "source": "歌う白骨",
                "author": "THE ECHO OF A MUTINY",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはごつごつした木の丸いのを並べた縁側で、坐ると向う脛の骨がごりごりして、今にも骨がおっぴしょれるかと思われ、痛さのあまりしまいには眼がちらくらしてきた。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海舟先生大作の盗難伯一代の大字の傑作　海舟伯の書も多いがこれは特別、しかも伯一代の大字を、ごりごりした白｜縮緬の生地へ筆力剛健、竜蛇の勢いをもって揮毫された大傑作。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、今のそのしばられたざまは何じゃ、何も言えまい、言えるものか、それ、こっちへ引ずれ」　と縁近く、西光を引ずり出すと、履物をはいた足をあげて、西光の顔を右左に、ごりごりと踏みにじった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第二巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
