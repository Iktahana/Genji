        "examples": {
          "standard": [
            {
              "text": "しゃぶしゃぶのゴマ味噌タレは辛めに作ってあり、大人向けの味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "手作りのゴマ味噌は、市販品よりも風味が豊かで子どもたちにも好評だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "野菜に付けるゴマ味噌は、サラダとしても小鉢としても重宝している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "二十五円の蓄音器は、今晩もずいずいずっころばし、ごまみそずいだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "弐拾五円の蓄音器は、今晩もずいずいずっころばし、ごまみそずいだ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
