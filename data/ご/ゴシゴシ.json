      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "室生犀星の抒情詩は、あの無心な小學一年生が舌で鉛筆の心を嘗めつけながら、紙の上にごしごしと書いてゐるところの、あの片假名の作文を思ひ出させる。",
              "citation": {
                "source": "室生犀星君の人物について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と莞爾々々笑って、澄まして袷を掻取って、襟を合わせて、ト背向きに頸を捻じて、衣紋つきを映した時、早瀬が縁のその棚から、ブラッシを取って、ごしごし痒そうに天窓を引掻いていたのを見ると、「そんな邪険な撫着けようがあるもんですか、私が分けて上げますからお待ちなさい。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と手拭で、ごしごし拭いを掛けつつ云う。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）か何かで、美濃から近江、こちらの桟敷に溢れてる大きなお臀を、隣から手を伸して猪口の縁でコトコトと音信れると、片手で簪を撮んで、ごしごしと鬢の毛を突掻き突掻き、ぐしゃりと挫げたように仕切に凭れて、乗出して舞台を見い見い、片手を背後へ伸ばして、猪口を引傾けたまま受ける、注ぐ、それ、溢す。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」頭をごしごし掻いて、笑つた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人は自分の変化をかの女に気取られたのを知って、ちょっとしまったという様子を見せ、指を旧式な「髷なし」という洋髪の鬢と髱の間へ突込んで、ごしごし掻きながら、しとやかな夫人を取り戻す心の沈静に努める様子だったが、額の小鬢には疳の筋がぴくりぴくり動いた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と冷水につけた手で顔をごしごし擦り乍ら氏は私に云う。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "種吉は高利貸の姿を見ると、下を向いてにわかに饂飩粉をこねる真似したが近所の子供たちも、「おっさん、はよ牛蒡揚げてんか」　と、待て暫しがなく、「よっしゃ、今揚げたるぜ」　と言うものの、摺鉢の底をごしごしやるだけで、水洟の落ちたのも気附かなかった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄行大菩薩といい、境内の奥の洗心殿にはいっているのだが、霊験あらたかで、たとえば眼を病んでいる人はその地蔵の眼に水を掛け、たわしでごしごし洗うと眼病が癒り、足の悪い人なら足のところを洗うと癒るとのことで、阿呆らしいことだけれど年中この石地蔵は濡れている。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ワイシャツを洗っちまうから」　小田は不器用な手つきで、ごしごしとワイシャツを洗っていたが、やがて、タオルを絞るように水を絞って、「――やもめは辛いや」　と言いながら、鶴雄をうながして六畳の部屋へ案内した。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所の小供たちも、「おっさん、はよ牛蒡揚げてんかいナ」と待てしばしがなく、「よっしゃ、今揚げたアるぜ」というものの擂鉢の底をごしごしやるだけで、水洟の落ちたのも気付かなかった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな青竜刀の柄を切ったようなものをさげていて、これでごしごし垢でもこするのではないかと思われた。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の日など泥まみれの足を手ぬぐいでごしごしふいて上がるのはいいが絹の座ぶとんにすわらされるのに気が引けた記憶がある。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その岩の面にひたとあてて、両手でごしごし一｜挺の、きらめく刃物を悠々と磨いでいたり。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　見向かれた、ひょろ竹は、なぜか、ごしごしと天窓を掻いた。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "真俯向になって面を上げず、ものとも知らぬ濁みたる声で、「猿の年の、猿の月の、猿の日に、猿の年の、猿の月の、猿の日に、猿の年の、猿の月の、猿の日に、」と支干を数えて呟きながら、八九寸伸びた蒼黒い十本の指の爪で、件の細々とした、突けば折れるばかりの巌の裾をごしごしごしごしと掻※る。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来の上で、と辞して肯ぜぬのを、平にと納めさすと、きちょうめんに、硯に直って、ごしごしと墨をあたって、席書をするように、受取を――　　記一金……円也「ま、ま、摩……耶の字？",
              "citation": {
                "source": "夫人利生記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも始末に悪いのは、高く崩れる裾ですが、よくしたもので、現に、その蚤の痕をごしごし引掻く次手に、膝を捩じ合わせては、ポカリと他人の目の前へ靴の底を蹴上げるのです。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "省作は手水鉢へ水を持ってきて、軒口の敷居に腰を掛けつつ片肌脱ぎで、ごしごしごしごし鎌をとぐのである。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに奥坐舗では想像のない者共が打揃ッて、噺すやら、笑うやら……肝癪紛れにお勢は色鉛筆を執ッて、まだ真新しなすういんとんの文典の表紙をごしごし擦り初めた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎌をごしごしこすりつけるやうにして切るなどは、誰が見てゐるのでないにしても出來ない氣持だ。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで古賀は湯ぶねのなかで、身體もそれから顏まで湯をひたした手ぬぐひでごしごしと洗つた。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
