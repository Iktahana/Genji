    },
    "definitions": [
      {
        "index": 1,
        "gloss": "scrubbing hard",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お風呂場のタイルにこびりついたカビを、たわしでゴシゴシと擦り落とす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「もっとゴシゴシ洗わないと汚れが落ちないわよ」と母に注意された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "濡れた髪をタオルでゴシゴシ拭くのは、キューティクルを傷める原因だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "鉄脚自慢の我々もゴシゴシ引張られて閉口した。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　エミ子は兎も角、タオルで、ゴシゴシと旦那様の頭をこすってやりました。",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "無茶先生は、睡っているヒョロ子と豚吉を二人共丸｜裸体にして、手は手、足は足、首は首、胴は胴に鋸でゴシゴシ引き切って、塩をふりかけて、傍にある空樽の中へ漬物のように押しこんでいます。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "醍醐の醍の字を忘れて、まごまごして居た佑筆に、大の字で宜いではないかと云った秀吉は、実に混乱から整理へと急いで、譬えば乱れ垢づいた髪を歯の疎い丈夫な櫛でゴシゴシと掻いて整え揃えて行くようなことをした人であった。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "人から聴けば臍の緒も煎じ、牛蒡の種もいいと聴いて摺鉢でゴシゴシとつぶした。",
              "citation": {
                "source": "競馬",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台の枕元に掛けたタオルに薬鑵の湯を器用に流しかけて、涙に汚れた顔をゴシゴシと拭い初めた。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭がボーとなって来る」　又野が毛ムクジャラの手の甲で顔をゴシゴシとこすった。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、また思い直して、手先をゴシゴシと洗い始めた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "激しく降り出した雨は、バスタオルで頭をゴシゴシ拭き終えたころには唐突に上がりかけていた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "――シャモ、がまんしれよ、――シャモ、がまんしれよ、暗から聞えるのは人間の骨を切るゴシゴシといふ梁の声山林官の苦痛の悲鳴にもまして『我慢すれよ』の権太郎の繰りかへしの言葉は悲鳴を帯びてゐた、そして血に塗れた鋸と山林官の腕を梁にのこして山林官の体は地上に運びだされた。",
              "citation": {
                "source": "小熊秀雄全集-6",
                "author": "詩集（５）飛ぶ橇",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　さう云ひながら鉛筆を倒にして、ゴシゴシとその字を消してゐた。",
              "citation": {
                "source": "妄想患者",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この暑いさなかに、ものものしい七つ道具を持ち出して、カンカンゴシゴシと、必死に大工のまねを始めたというのも、実をいうと名誉の最期をとげたあのかわいくて小さかった善光寺｜辰の新盆が迫ってきたので、お手製の精霊だなをこしらえようというのでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポケットから例の案内書を出して見つめながら、頭をゴシゴシ掻きまわしたが、わからないものはどうしてもわからない。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝ていると、ゴシゴシと身体をやけにかく音が何処からも起った。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "指を熊手にして、ゴシゴシ頭をかいた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハ、まア、よオく御無事様で……」　佐々爺は手拭で顔をゴシゴシこすりながら、何べんも頭を下げた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして真黒に汚れた手巾で、顔から首をゴシゴシこすった。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒川が鉄筆で頭をゴシゴシやりながら、「こうなったら佐々爺とか武田、それに『のべ源』あんなものに気をつけなけア駄目だ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二十五日と前の日に続けて書いて、ふと思いついて鉛筆を倒にして、ゴムでゴシゴシ消した。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」小僧「それで左の手で、電話の受話器を持ち、右の手に握った鉛筆で、向うの云う用件を紙の上に書き……それから補手でもって、薄くなった頭の頂上をゴシゴシと掻いてごらんなさい。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴシゴシゴシと深刻な響が、シーンとした解剖室の中にひびき渡るのであった。",
              "citation": {
                "source": "人体解剖を看るの記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に洗面器に、新しい湯を貰ってきて、その中に手をつけると、石鹸を十分につけてゴシゴシと洗った。",
              "citation": {
                "source": "人体解剖を看るの記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親は木の香の新しい台所へ出て、ゴシゴシ働いていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親は手元の薄暗い流し元にしゃがみ込んで、ゴシゴシ米を精いでいた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその仕事が、東京監獄ではごく楽で綺麗な経木あみであったのが、南京麻の堅いのをゴシゴシもんで柔らかくして、それで下駄の緒の心をなうのであった。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "三枝君は茶飲み茶わんを買って来て、水道口で之をゴシゴシ洗っていた。",
              "citation": {
                "source": "『唯研ニュース』",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
