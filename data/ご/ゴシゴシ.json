  {
    "uuid": "4382905e-34fa-5e03-8da4-3bc2d653bcb2",
    "entry": "ごしごし",
    "reading": {
      "primary": "ごしごし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
