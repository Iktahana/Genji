          "literary": [
            {
              "text": "十六頁取の大版の紙が一号に約八千枚から一万枚を必要としたのであるから、「工芸」百号分のため総計約九十万枚を使用したわけである。",
              "citation": {
                "source": "和紙十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上約四十号分の和紙の表紙が加はり、且つ包装紙まで多くは塵入の和紙にしたから、合せると並々ならぬ量である。",
              "citation": {
                "source": "和紙十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "初號分締切二月十日限り。",
              "citation": {
                "source": "無題",
                "author": "月刊文藝雜誌　樹木と果實　初號三月一日發行",
                "note": "青空文庫"
              }
            }
