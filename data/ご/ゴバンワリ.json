        "examples": {
          "standard": [
            {
              "text": "「都市計画によって、この一帯は機能的な碁盤割りに再開発された。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「土地を碁盤割りに区画整理することで、交通の便が飛躍的に向上した。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「歴史的な書物によると、古代の都は厳格な碁盤割りで設計されていた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "さて「名古屋へいりゃあたら寄て頂戴も」という註文は果したが、団さんの発祥地は、「笹島駅から三丁目、一軒置いて二軒置いて三軒目」よりはもっと遠く、碁盤割の本町通り、木綿問屋が軒を並べているところだった。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び碁盤割の市街に入ったが、古着屋ばかり並んでいるところを通った時は驚いた。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
