    "definitions": [
      {
        "index": 1,
        "gloss": "the five eyes (physical eye, heavenly eye, wisdom eye, dharma eye and Buddha eye)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "仏教では、修行を積むことで五眼が開かれると説かれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は五眼の境地に達した聖者であると信じられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "五眼とは、肉眼、天眼、慧眼、法眼、仏眼のことである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "故に免許にはいまだ致されぬが、しかし、一足二身三手四口五眼を逆に行って、彼の眼は天下無敵だ。",
              "citation": {
                "source": "怪異暗闇祭",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
