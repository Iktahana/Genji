  {
    "uuid": "4150c558-cdb8-5a1c-a6a0-b2123d395584",
    "entry": "語言",
    "reading": {
      "primary": "ごげん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "たゞ一語言ひたいことは、この絵そのものはいささかも難がないが、この作品がかなり偶然性があるといふことである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "「平洲為之称有疾、謝来客、息講業十余日、無朝無暮、語言一室、若引緒抽繭、縷々不尽」であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "二語三語言っては復た黙って了った。",
              "citation": {
                "source": "船",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「善いかな、善い哉、乃至、文字語言あることなし。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "御礼千万語言にかへかね候。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年十月十二日　印藤肇あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵操則思改日本、語言則樂效日本。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "國文者本國之文字語言。",
              "citation": {
                "source": "支那近世の國粹主義",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから露國は何如であるかといふに、該國の學者で、支那塞外民族の言語地理を研究したり、又隨分支那本部の文學史學とか、地質植物などまで調べた人は少くないが、彼得堡大學東洋言語科大學に、支那語言科（此には語言科といふ。",
              "citation": {
                "source": "續狗尾録",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "其次にはかの有名なゼェシュイット派のポルトガル人ソメド（Alvaro Somedo 1585-1658 漢名魯徳照）の支那帝國史にも、支那語言文字に就いて、別に一章を設け、王玉等の字を標本として擧げて居る。",
              "citation": {
                "source": "續狗尾録",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "一體歐洲人にて當時支那の文學等を研究するものは申迄もなく、支那で宣教をなしつゝあつた教士連で、彼等が支那の語言を解し、又支那從來の道徳宗教に關する思想を知ることは職務上極めて必要であつたからである。",
              "citation": {
                "source": "續狗尾録",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく支那との通商が盛んとなるに從ひ、必要上、英國人の中に支那の語言を學ぶ者が出て、それから支那の文學や歴史等の方面に手を出すものがなくてはならぬ譯だが、事實は之に反し、彼等は支那語に對しては全く興味を感ぜず、寧ろ輕蔑をして居つた。",
              "citation": {
                "source": "續狗尾録",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "之を耶蘇會士の人々が支那に來るや直に支那の語言文字を研究して十數年を出でずして種々の學術的著作をなしたのと大に其趣を異にする。",
              "citation": {
                "source": "續狗尾録",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "堂々たる英國使節の譯官として、支那の教民を使用せねばならぬことになつたのを見ても、當時英本國で、支那の語言文字を知つた人のなかつた事が分る。",
              "citation": {
                "source": "續狗尾録",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに昨年の如く朝鮮人等專ら漁獵をして我を妨げ、動もすれば不軌の語言を放つて和平ならず。",
              "citation": {
                "source": "他計甚※（竹島）雜誌",
                "author": "松浦武四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "国津神の文化のやや低級であったことは、大祓の祝詞からでも窺われるが、おそらくは語言はほぼ通じ、したがって相互の信仰は理解し得られ、烈しい闘諍をもって統一を期するまでの、必要はなかったかと思われる。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（３）（４）叢書『説鈴』（第六冊）に収むる所の張氏の『使琉球紀略』に語言二十余箇を摘録せるを見るに大を倭捕殺（ウフサ）とせり。",
              "citation": {
                "source": "南嶋を思いて",
                "author": "――伊波文学士の『古琉球』に及ぶ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミケランヂェロの彫刻は「語言はぬ」事のみが缺點とせられた。",
              "citation": {
                "source": "新憲法の解説",
                "author": "解説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
