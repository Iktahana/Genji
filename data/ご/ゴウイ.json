  {
    "uuid": "088d2894-d376-5028-a76d-ce742884e422",
    "entry": "合囲",
    "reading": {
      "primary": "ごうい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "苦悶の上また苦悶あり、一の苦悶を愈さんとすれば、生憎に他の苦悶来り、妾や今実に苦悶の合囲の内にあるなり。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『琅邪代酔篇』三八に、〈横州猿を捕えて入貢す、故に打ち捕るを事とするは皆南郷の人、旬日村老一人来り告ぐ、三百余人合囲して一小黒猿を独嶺上に得、もし二百人を益し、ことごとく嶺木を伐らば、すなわち猿を獲べしと、その請のごとくす、三日の後一猿を舁ぎて至る〉。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "たちまち染人が、歳ごとに染むるところの綾帛の尋丈尺寸を籍して簿となし、合囲するに遇う。",
              "citation": {
                "source": "失うた帳面を記憶力で書き復した人",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ元和偃武以来、幾んど四半世紀、忽然として清平の天地に砲火を上げ、竪子を推して、孤城を嬰守し、赫々たる徳川｜覇府の余威を籍り、九州の大名これを合囲し、百戦老功の士これを攻め、年を改めて始めて抜くを得たり。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十九日、信濃小県国分寺ヲ通グルニ、既ニ将門、千曲川ヲ帯シテ待チ、前後ヲ合囲ス。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
