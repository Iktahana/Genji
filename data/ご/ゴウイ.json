[
  {
    "uuid": "4a753f13-edb8-574d-af7b-589b7650a2e9",
    "entry": "合意",
    "reading": {
      "primary": "ごうい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
