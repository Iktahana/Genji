          "literary": [
            {
              "text": "これは次号予告を見ても強く感じました。",
              "citation": {
                "source": "気になったこと",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、九月號豫告のところに「田村義雄氏の人生觀並びに藝術觀を論ず」（百五十枚）とある。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、第三號豫告にＰ…Ｖ…といふ署名で「ポオ、ニイチェ」とあるのもヴァレリイにちがひないが、そんな題のエッセイはとうとう書かれずにしまつたものと見える。",
              "citation": {
                "source": "色褪せた書簡箋に",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
