[
  {
    "uuid": "dc4957df-6458-504e-badd-79b84ba4f312",
    "entry": "五胡",
    "reading": {
      "primary": "ごこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
