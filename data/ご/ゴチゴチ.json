        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（子規の作った万葉ばりの歌というのが、全然音楽美のないゴチゴチした散文的のものであった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴチゴチにすみのくずのかたまった筆を見ると人間のミイラを見る時とそんなに違わないほど見せつけられる様なきがする。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれ共二十本ほどずつ一っかたまりになってゴチゴチになって行列を作ってチョキンとなって居るのは淋しい中にも何とはなしおどけた茶化した気持がある。",
              "citation": {
                "source": "旅へ出て",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあよく見ておけ、ここから先きがイタリアだと連中がゴチゴチの岩山を指しました。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは明治十八年頃のいわゆる鹿鳴館時代で、晩年にはあんなゴチゴチの国粋論者、山県元帥でさえ徹宵ダンスをしたり、鎗踊りをしたという、酒池肉林、狂舞の時期があった。",
              "citation": {
                "source": "勝川花菊の一生",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ドアのそばへいって、その針金をかぎ穴にさしこんで、なにかゴチゴチやっていましたが、しばらくするとカチンと錠がはずれて、ドアがひらきました。",
              "citation": {
                "source": "妖人ゴング",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
