          "literary": [
            {
              "text": "ゴーキーが Folk-novelist として最も注目にあたいする人であるのを知る。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのロマンティシズムを打破するために、極端なリアリストが現れ、その二つを統合した産物としてゴーキーが現れたと云って居る。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーキーの作品集を読み感深し。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーキーの“chums”をよみ、河村明子のことを思う。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜からゴーキーの my childhood をよみ始む。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
