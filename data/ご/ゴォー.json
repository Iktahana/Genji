          "literary": [
            {
              "text": "思わず、耳をふさいだが、ヒューシュシューゴォーッと、敵弾は気味の悪い音を立てて、すぐ近くの波間へ落ちた。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "とほとんど同時だった、彼の袂のすれすれを、ゴォーッと凄まじい唸りを残して真黒い列車が通り過ぎた。",
              "citation": {
                "source": "自殺を買う話",
                "author": "橋本五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かと思うとまたまたくるりと起き上がり、行列を見かえって、「オーケストラ、ゴォー。",
              "citation": {
                "source": "曲馬団の「トッテンカン」",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            }
          ]
