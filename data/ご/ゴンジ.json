        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「ついては、ここに　さいごんじの　おしょうに　てがみが　かいてある。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいごんじの　おしょうは　てんかに　かくれない　がくもんの　ふかい　おしょうじゃ。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この　てがみをもって、これから　すぐ　さいごんじに　いきなさい。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいごんじの　おしょうには　もう　よく　話してある。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一休さんは　その日　さっそく　さいごんじに　いきました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいごんじの　おしょうさまは、あんこくじの　おしょうさまの　そえてがみを　みて、一休さんを　へやに　とおすと、「しゅうけんと　いう　小ぞうは　おまえか？",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　さいごんじの　おしょうさまは、じょうひんで　きだてのやさしい、まえの　あんこくじの　おしょうさまとは　まるで　はんたいで、かみなりの　ような　大ごえで　がみがみいう　ひとでした。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こんどの　さいごんじの　おしょうさまは、こんなふうに　てっていした　こころを　もっており、そのころ　がくもんも　おこないも、天下一だと　いわれていた　えらい　ぼうさんでした。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一休さんは　こうして、その日から　さいごんじの　小ぞうに　なりました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」かたい　けっしん　一休さんは　さいごんじで　四ねんかん。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、いって、しばらく　さいごんじに　とどまっていました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなが、「そうじゅんさん、おしょうさまの　あとを　ついで、さいごんじの　じゅうしょくに　なって　ください。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、いって、さいごんじを　でていきました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいごんじを　でた　一休さんは、ひさしぶりに　母の　もとを　たずねていきました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さいごんじの　おしょうさまに　四ねんかん　まなびました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいごんじの　おしょうに　ついたか。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいごんじの　おしょうも　おしいことを　したな。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さいごんじの　おしょうも　がんこ　だったが、わしは　もっと　がんこじゃ。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "材料による名があることは、前述のように「けら」の場合でも分るが、蓑も「ひろれみの」とか「ごんじみの」とかいうのはその例である。",
              "citation": {
                "source": "蓑のこと",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ごんじ」は蓑によく用いる「うりき」の別名で、ある地方では「おっかわ」ともいう、青皮の意である。",
              "citation": {
                "source": "蓑のこと",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
