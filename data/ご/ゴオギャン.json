          "literary": [
            {
              "text": "ゴオギャンのタヒチの女そっくりだ。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "透明色の無限の重ね出をしてゐるゴオギャンに比して、その意味では彼は確かにゴッホ的なところがある。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴオギャンだの、ディフィだの好きです。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはポオル・ゴオギャンである。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはゴオギャンの転生である。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルレエヌの韻文狂言「お互に」は、ポオル・フォオルの肝入りでゴオギャン後援のために催された慈善興行の上演目録に加へられた。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
