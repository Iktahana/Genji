        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代、多くの村に郷学が設けられ、庶民の教育に貢献した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は郷学で読み書き算盤を学び、村の帳簿係となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "郷学の跡地には、今も当時の教育精神を伝える記念碑が立っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "広吉茂吉は半郷学校え天子様のシヤシン下るに付而行。",
              "citation": {
                "source": "念珠集",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人に同郷学生の学友会の会長になってもらっていた。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに大阪の富商の手代が蓑賀参蔵を詐欺犯人であると証言するや、ごうごうがくがくと蓑賀殿の悪事醜行が並べられ、ついにこの筆頭与力殿も縛られなされた。",
              "citation": {
                "source": "三悪人物語",
                "author": "忍術千一夜　第二話",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
