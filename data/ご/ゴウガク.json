      {
        "index": 1,
        "gloss": "village school (esp. in Edo-era Japan, and ancient Korea and China)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
