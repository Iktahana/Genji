[
  {
    "uuid": "1834b05f-e2d4-5cea-a139-3b7bffd9624d",
    "entry": "御悩",
    "reading": {
      "primary": "ごのう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
