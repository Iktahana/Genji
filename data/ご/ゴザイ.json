  {
    "uuid": "17f76146-b8de-51b5-a182-e68940bb18d1",
    "entry": "ゴザイ",
    "reading": {
      "primary": "ござい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白痴、幽霊、守銭奴、狂犬、ほら吹き、ゴザイマスル、雲の上から小便。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者が〔以下原稿数枚なし〕　それから「アナタ、タヾノオキャクサンゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると向ふが意外にも「アナタオ湯オハイリゴザイマセンカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタコノヘンノオテラ、ボンゾサン　シッテヰルゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノヘンノボンゾサン、シャカブツ五カイ、マモルゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ゴザイマセンネエ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サケノミゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ニクルイタベルゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモマダミンナキマセンゴザイマス。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "門をはひるや否や、色の淺黒い（といつても、カロリン諸島は東へ行くにつれて色の黒さが薄らいでくるやうに思はれる）子供等が爭つて前に出て來ては、オハヨウゴザイマスと叮嚀に頭を下げる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、一齊に、オハヨウゴザイマスと言ひながら頭を下げた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "門をはいるや否や、色の浅黒い（といっても、カロリン諸島は東へ行くにつれて色の黒さが薄らいでくるように思われる）子供らが争って前に出て来ては、オハヨウゴザイマスと叮嚀に頭を下げる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、一斉に、オハヨウゴザイマスと言いながら頭を下げた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシガ　ワルウ　ゴザイマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "作中、Ｔ市長ダノ銀座ダノトイウ名詞ガ出テクルガ、コレハ決シテ何処カノ帝都ニアッタ実話ナドヲもでるニシタモノデハゴザイマセン。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月九日さよなら　幸恵より　愛する御両親様　　　　　　　　御前に伊藤元子宛（北海道・名寄）大正十一年五月頃（東京発信）御タヨリヲ下サイマシテ、ホントウニ有難ウゴザイマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "マコトニウレシウゴザイマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの外になお、私は三百人を下らない印度人、ゴザイン族、及びサンニアス族が、毎日この場所で、ラマの恩恵で養われる、と聞いたのである１）。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ犬デスガ、年ヲトリマシタノデ、一人デクラスノハ、サミシウゴザイマス。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサハ　ダレニデモ　バウシヲトッテ、「オハヤウゴザイマス。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ボンコチヤンハイツモ、アタラシイ時ノヤウニ美シウゴザイマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　モンコチヤンハホントニカナシユウゴザイマシタカラ、ワア、ワアナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア、ポカポカト　アタタカイヒデ　ゴザイマシタワネエ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　フタリハ　イツシヨニ　ワラツテ「マア、ポカポカト　アタタカイヒデ　ゴザイマシタワネエ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
