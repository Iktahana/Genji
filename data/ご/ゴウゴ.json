        "examples": {
          "standard": [
            {
              "text": "豪語には、独特のスラングや表現がたくさんある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "オーストラリアに留学した際、豪語のアクセントに慣れるのに時間がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画を観ていたら、登場人物が豪語を話していたので、字幕が必要だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
