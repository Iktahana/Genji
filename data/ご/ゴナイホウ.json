          "literary": [
            {
              "text": "そしてすぐ、勝手元の墨江の方へ、『御内方。",
              "citation": {
                "source": "死んだ千鳥",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――御内方、御内方』『はい……』　墨江は行燈をそこへ持って来て、客の間に坐った。",
              "citation": {
                "source": "死んだ千鳥",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それより御内方、風邪をひかさぬように、平田殿へ何ぞ掛けてあげてくれ』　伏原半蔵は、土間の履物を足の先で探りながら、手をつかえている墨江の顔を、無遠慮な眼でながめて帰った。",
              "citation": {
                "source": "死んだ千鳥",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『――平田殿の御内方。",
              "citation": {
                "source": "死んだ千鳥",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さだめしあの御内方の優しい御内助であろうなあ。",
              "citation": {
                "source": "死んだ千鳥",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた、勝頼夫妻に向って、「このたびの御悲運は、まったく御内方の一族に、離反があったためによる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "では久しぶりに御内方と共にいただこうか」　と望んだところから、出立を間際にして、急にこういう団欒になったのであった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
