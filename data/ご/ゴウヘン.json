          "literary": [
            {
              "text": "唖々子花月第五号編輯に来る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "隨つて此號編輯に關する一切の責任は小生の負ふ所に候。",
              "citation": {
                "source": "消息",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎も角も毎號編輯者が變る故、毎號違つた色が出て面白い事なるべく候。",
              "citation": {
                "source": "消息",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
