        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こうした風に、段々、へんな噂がたつのに加えて、人の好い村川が、無意識にふりまいた、デマゴオグも、また相当の反響があったと思われます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴオグの死骸を載せた玉突台だね、あの上では今でも玉を突いているがね。",
              "citation": {
                "source": "悠々荘",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は或本屋の店先に立ち、ゴオグの画集を見てゐるうちに突然画と云ふものを了解した。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論そのゴオグの画集は写真版だつたのに違ひなかつた。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は僕と同時代に生まれた、あらゆる造形美術の愛好者のやうにまづあの沈痛な力に満ちたゴオグに傾倒した一人だつた。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしゴオグの糸杉や太陽はもう一度僕を誘惑するのである。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "辰子はいつも熱心にゴオグとかセザンヌとかの話をした。",
              "citation": {
                "source": "春",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術的な感動を味ふのではなく、デマゴオグの熱弁に魅せられてゐたのである。",
              "citation": {
                "source": "批評家・作家・劇場人",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
