        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゴロゴロピカリとくると、もう生きた心地はせん！",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロゴロピカピカの真っ最中に、いくら艶かしく縋りつかれたからとてそんな恐怖のタダ中で、味な気なぞが起るものか！",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロピカの最中は、二人でただ抱き合っていて、やがて、西の空が明るくなって、ゴロゴロが遠のいて、初めて人心地がついてから、抱き合ったが百年目とばかりに、そろそろ心臓がアレの方に向うのが、本当であろうというのが、私の意見であった。",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏だから、大島の元村で、ゴロゴロピカッ！",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかれば、世界至るところ、雷の鳴らぬところはねえということになるのだが、神は何が故にこんな人騒がせな、迷惑極まるものをゴロゴロピカピカ至るところに暴れさせるのだろうか？",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
