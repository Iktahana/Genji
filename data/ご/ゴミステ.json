          "literary": [
            {
              "text": "七つか八つのゴーリキイは、ニージュニの町の貧乏な男の子たちと一緒に、町はずれのゴミステ場へ行って、そこで空カンだのこわれた金具だのをひろって、売って其日其日を過しました。",
              "citation": {
                "source": "マクシム・ゴーリキイについて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
