  {
    "uuid": "bc15fa9b-5811-50c6-b9f3-312365522fcf",
    "entry": "塵捨て",
    "reading": {
      "primary": "ごみすて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
