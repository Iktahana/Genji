[
  {
    "uuid": "b77c082f-a14c-5b06-8b51-4490205726d2",
    "entry": "ごちゃ",
    "reading": {
      "primary": "ごちゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いろんな事が此の二箇月間、ごちゃまぜになって僕を襲った。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリストも、おしゃかさんも、ごちゃまぜになった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三つ目入道、狐、狸、猫も鼬もごちゃごちゃと小さく固まっていたが、松崎の殺進に、気を打たれたか、ばらばらと、奥へ遁げる。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "象徴と、比喩と、ごちゃまぜにしているのである。",
              "citation": {
                "source": "豊島與志雄著『高尾ざんげ』解説",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "背嚢や、毛布や、天幕や、外套が、乱雑に畳まれて、ごちゃごちゃと並べられていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　詰襟の善人らしい支那人は、日本語と、支那語を、ごちゃごちゃに使った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの踊り場の前にも吐き出す、乱曲を浴びながら肩を怒らしてズボンへ両手を突込んだ若者と、安もので突飛に着飾った娘達とが、ごちゃ／＼していた。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹はむしゃくしゃすると同時に堪えぬなつかしさの痛み、悔いないでよいことへの悔い――そういったことでごちゃごちゃになっていた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "よし、それは養蚕期の都合によるにもせよ、また、あまりにごちゃ／＼と何か強力のものからこゝへと逃れ佗びた恰好に見受けられました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "対岸は、葭の上に横たえられた青い土手が見え、橋詰にごちゃ／＼している予田町の人家の裏が土手の上に塊まって覗いています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "樟脳とナフタリンの匂いのするスカートと花模様の袂がごちゃごちゃに玄関で賑わって六日目の朝、妹たちが到着した。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本建ての屋根瓦のごちゃごちゃした上に西洋風の塔が取って付けたように抽き立っていた。",
              "citation": {
                "source": "とと屋禅譚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この不思議な意図も慧鶴青年の胸に蓄えられたまま、人間慾と超人慾とのごちゃごちゃに混った青年慧鶴は、清水と富士をあとに残し、何事かを極める為に美濃ノ国へ旅立ったのである。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この中のどれが一番、重大な原因であるか判らないほど、ごちゃごちゃのものに追い立てられて彼は清水を急いで離れて行ったのであった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山羊に追いついてからふりかえって見ますと畑いちめん紺いろの地平線までぎらぎらのかげろうで百姓の赤い頭巾もみんなごちゃごちゃにゆれていました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはその間にすっかり考えをまとめようと思いましたが、何もかもごちゃごちゃになってどうしてもできませんでした。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして昔はそのへんには熊がごちゃごちゃ居たそうだ。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "活動小屋の絵看板がごちゃごちゃと並んだ明るい新世界の通りを抜けると、道は急にずり落ちたような暗さで、天王寺公園だった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
