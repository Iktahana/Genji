    "definitions": [
      {
        "index": 1,
        "gloss": "this place",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ご当地の名物料理は何ですか？",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ご当地産の特産品が販売されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ご当地の文化を守ることは重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「ええ――ご当地へ参りましたのは初めてでござりますが、当商会はビンツケをもって蟇の膏薬かなんぞのようなまやかしものはお売り致しませぬ。",
              "citation": {
                "source": "風琴と魚の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「昨年、ご当地で、お目どおりいたしました娘は、さる地方において、俵を積み重ねまする際に、腹帯が切れて、非業の最期を遂げました。",
              "citation": {
                "source": "公園の花と毒蛾",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あすは、もうご当地におわかれするのでございますが……」　夫人は鼻をつまらせた。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、何かの会議に呼ばれるほど長くご当地にとどまりもしないでしょう。",
              "citation": {
                "source": "流刑地で",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その主謀者は、ご当地の東渓村の名主、晁蓋という人物。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご当地へは初めてのこと。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご当地では初のお目見得。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがご当地のお客様は品がちがう。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "任原関にはご当地でもすんでに二年間の勝ちッ放し。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
