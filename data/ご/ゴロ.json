[
  {
    "uuid": "0f070d32-9702-5707-a1da-9de9a9bb9aca",
    "entry": "ゴロ",
    "reading": {
      "primary": "ゴロ",
      "alternatives": [
        "ごろ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-接尾辞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "ground ball",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ピッチャーの好投も虚しく、打球は無情にもゴロとなってセカンドへ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "打った瞬間、センターへの鋭いゴロかと思いきや、イレギュラーで外野を抜けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの一打は、わずかな隙間を抜けるゴロで、チームの勝利を決定づけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そして母が髪を結つてたのでその傍にゴロンと仰向きに寝転んだ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロンと横向きになつて、書棚に並んだ本を手で横撫でしながら、私は私の前途がいかにもいらだたしいもののやうな感じを懐いた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "稜角の端まで這い出して、小さい阜――古代の動物の骨のようにゴロゴロ転がっている石の堆積――の上に立った、石はビッショリと濡れて、草鞋が辷る。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の登った北米のフッド火山は、大なる氷河が幾筋となく山頂から流れているにもかかわらず、麓の高原は乾き切って、砂埃とゴロタ石の間に栽培した柑橘類の樹木が、疎らに立っているばかり。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶壁の縦断面には、灰青色の熔岩を見ないでもないが、上を被覆するゴロタ石のために、底の岩石を知ることが出来ない。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フン」「セ・モン・ジゴロ……」である。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の売出しごろには舞台の背景に巴里の場末の魔窟を使い相手役はジゴロ（パリの遊び女の情人）に扮した俳優を使い彼女自身も赤い肩巻に格子縞の Basque という私窩子型通りの服装をして彼女の唄の内容を芝居がかりで補ったものだが、このごろは小唄専門のルウロップ館あたりへ出る場合にはその必要は無い。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が唄うところのものはジゴロ、マクロの小意気さである。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の如く間歇的な情熱に興奮して、三日も四日も不眠不休で書き續けたり、さうかと思ふと一月も二月も遊んでしまひ、何もしないでゴロゴロして居たりする人間には、到底大きな仕事のできる筈がない。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "容貌ばかりでなく、全體の態度や、言葉づかいや、言行からして、何となく田舍新聞の記者とかゴロツキ書生とかいふ類の者を思はせる所があつた。",
              "citation": {
                "source": "室生犀星の印象",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『センダガヤノシヨウジヨゴロシノハンニンケンキヨサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "此處らでゴロリとやつちまひたいな‥‥」「全くだ。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ二｜臺の三｜等車、次に二｜等車が一｜臺、此三｜臺が一｜列になつてゴロ／＼と停車場を出て、暫時くは小田原の場末の家立の間を上には人が押し下には車が走り、走る時は喇叭を吹いて進んだ。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "關羽巡査は眼鏡をかけて、人車は上だからゴロゴロと徐行して居た。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼等は、満洲や朝鮮をゴロツク間に、不逞なヨボや、苦力が、守備隊の示威演習や、その狂暴な武力によって取っちめられてしまうのを、痛快に思いつつ目撃して来た。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、この地方の邦人達を慄え上らしているゴロツキの馬賊上りだった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ある時は、山寨の馬賊の仲間に這入り、ある時は、奉直戦争に加わり、又、ある時はハルピンの郊外に出没して、ロシア人の家を荒し、何人、人を殺したか数しれないこの不思議な、ゴロツキも、二人の妹には、おかしな、そして少し滑稽なおじさんにすぎなかった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この一とすじものでないゴロツキは、ほかの空想に夢中になって、彼の相談に乗ろうとしなかった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを作るのには、中津のようなゴロツキを手さきに使うのが一番いいのだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎は、この五人のゴロツキどもを、なお、未練げになにか釣銭でも取ってやりたいように見送っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつでも事件のきッかけは中津のような反動のゴロツキが必要に応じて作っているのだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロ寝をしていた浜田たちは頭をあげた。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガリガリッ、ゴロゴロゴロゴロ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はゴロッと仰向きに寝転んで、猫を顔の上へあげて来る。",
              "citation": {
                "source": "愛撫",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "racketeer",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
