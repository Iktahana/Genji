          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あのゴロたちは、駅前でいつも客引きをしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画では、昔のゴロたちの暮らしがリアルに描かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "裏社会のゴロたちに、彼は一人で立ち向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
