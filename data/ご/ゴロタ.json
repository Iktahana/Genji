[
  {
    "uuid": "b0bcc383-fd85-554f-87d9-3d337987ee25",
    "entry": "ゴロタ",
    "reading": {
      "primary": "ごろた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私の登った北米のフッド火山は、大なる氷河が幾筋となく山頂から流れているにもかかわらず、麓の高原は乾き切って、砂埃とゴロタ石の間に栽培した柑橘類の樹木が、疎らに立っているばかり。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶壁の縦断面には、灰青色の熔岩を見ないでもないが、上を被覆するゴロタ石のために、底の岩石を知ることが出来ない。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は遠雷のように聞え、或は浪の音のようでもあり、又は火吹達磨が火を吹いてるようにも思われれば、ゴロタ道を荷馬車が通る音のようにも思われる。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、二人は明るいとき通ったほこりの深いゴロタ石の道を駅に向った。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "春子　だってあんな川原のゴロタ石ですもの下が。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二寸三寸と見る間に積って行く、頼めば宿もするらしいゴロタのとある飲食店に立ち寄って、渋茶と焚火の馳走になりながら用意の朝食を済ました。",
              "citation": {
                "source": "初旅の大菩薩連嶺",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝの温泉も河津浪で流されたばかりで、道路を下った河原のゴロタ石の間に深さ一尺ばかりの溜り水に過ぎなかったが、日暮に近く、長々と身をよこたえて、あれで三十分ものびていたことだろうか。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "太平洋の汽船で、シベリアの汽車で、私は時々針ノ木の雪渓の下、ゴロタ石の中に咲いていた赤い百合と、峠に近く咲いていたりんどうとを思った。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの温泉も河津波で流されたばかりで、道路を下った河原のゴロタ石の間に深さ一尺ばかりの溜り水に過ぎなかったが、日暮れに近く、長々と身をよこたえて、あれで三十分ものびていたことだろうか。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯触った位では開かぬように、この通り岩扉の根にゴロタ石が積んである」　雲水空善は、早くも扉の仕掛を見破ったものか、三猿を彫んだ大岩の前に積み重ねた、ひと抱えほどの岩を幾つも幾つも取除きました。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えい、これしきのもの」　伊那丸は、金剛力をしぼって、波のほうへ、綱をひいてみたが、荒磯のゴロタ石がつかえて、とてもうごきそうもない。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロタ下駄やドロ靴が、たちまち眼鏡をとばし、肩を蹴とばした。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部落の横丁から道はゴロタ石をたたんだ石段となっており、上では、正季が待ち、中院ノ俊秀や矢尾常正らも先に来ていて、「しばしお待ちを」　と、正成へ告げ、そして正季もこう言った。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロタ石のけつまづき、ごろつきが一番よくない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "河原のゴロタ石を、それこそ命からがら引きあげてきてわけを話すと、家の者も宿の者も窓からぼくの釣りを見ていたのだが、何で河原で手ぬぐいを振って踊りを踊っているのだろう、また例の悪ふざけが始まった、と思っていたという。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "マハゼの要領で、ただ、地底が平場よりゴロタ石の間とかソダまわりでの数釣りだけに、針の返りのアゴを取ってやってみたが、思ったほどバレも少なかった。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
