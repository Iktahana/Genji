        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "こちらは、私の昔からのご存知の田中さんです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会場には、何人かご存知の方がいらっしゃいました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は顔が広く、どこに行ってもご存知がいるようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
