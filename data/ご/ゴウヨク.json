[
  {
    "uuid": "930f498e-8266-5cd4-b5d1-89b8fdbfe0a3",
    "entry": "強欲",
    "reading": {
      "primary": "ごうよく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
