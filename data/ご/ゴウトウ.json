    "definitions": [
      {
        "index": 1,
        "gloss": "robber",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昨夜、この地域で強盗事件が発生した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "防犯カメラの映像から強盗の顔が特定された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "店に押し入った強盗は、金品を奪って逃走した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「フン、棍棒強盗としてあるな。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の心に取入るには、強盗に這入るような事をしなくてはならない。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おや、又、強盗かしら？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "強姦でも、強盗でも、窃盗でも、自分の経験を大ッぴらに喋りちらした。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "土匪の中には、勿論、強盗を働いたものもあった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この馬賊上りの、殺人、強盗、強姦など、あらゆる罪悪を平気でやってのけた鬚づらの豪の者が、娘々したすゞに少なからず参っている有様は、実際不思議だった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中津が強盗、殺人、強姦などをやってきた、そして多くの人々から、恐るべき蝎として、嫌われ、おっかながられている。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――張作霖、張宗昌、強盗、強姦、売国的………　ふと、一郎は、両手で彼女の手からビラを叩き落してしまった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの女に金を与えるために、強盗、殺人、何でももう、やってやろうかという気にさえなった事がございます。",
              "citation": {
                "source": "男女同権",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "うっかりすると謀殺か強盗の廉で首を絞められるかも知れない虞れが十分にある。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこは追剥強盗が名物じゃけに仕事には持って来いじゃろう。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく聞いてみると、当時高名であった強盗犯人山辺音槌とかいう男が江の島へ来ているという情報があったので警官がやって来て宿泊人を一々見て歩き留守中の客の荷物を調べたりしたというのである。",
              "citation": {
                "source": "海水浴",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "強盗犯人の嫌疑候補者の仲間入りをしたのは前後にこの一度限りであった。",
              "citation": {
                "source": "海水浴",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の名僧などで、信念の凝り固まったものには、悪人強盗はもちろん、猛獣毒蛇でさえ近寄れなかったと言い伝えられています。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "強盗殺人かの兇暴な被告であつたが、判官は型の如く居並んで、型の如く判決の主文を朗読した。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、この時刻だから強盗の所業です。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この夏公園で人殺しをした強盗の一件？",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、その男を、年配、風采、あの三人の中の木戸番の一人だの、興行ぬしだの、手品師だの、祈祷者、山伏だの、……何を間違えた処で、慌てて魔法つかいだの、占術家だの、また強盗、あるいは殺人犯で、革鞄の中へ輪切にした女を油紙に包んで詰込んでいようの、従って、探偵などと思ったのでは決してない。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらは二、三人または三、四人ずつ幾組にも分れて、馬喰町その他に宿を取って、江戸馴れない旅人の風をして窃盗や辻強盗や万引の悪事を働いていたのであるが、そのなかで証拠の最も歴然たるのは、日本橋人形町の小間物屋忠蔵方で鼈甲の櫛四枚をぬすみ取ったことであった。",
              "citation": {
                "source": "拷問の話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "○九月二十三日の夜、河原崎権之助、今戸の宅にて浪士の強盗に斬殺せらる。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　だんだん聴いてみると、なんとまあ驚いたことには、浅井という人は浪人あがりの強盗だったのだそうです。",
              "citation": {
                "source": "怪談一夜草紙",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういえば浅井は余り人相のよくない人でしたが、息子の余一郎という人は色白のおとなしそうな顔をしていながら、親子連れで斬取り強盗を働いていたのかと思うと、実に二度びっくりでございました。",
              "citation": {
                "source": "怪談一夜草紙",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「辻強盗に剥がれたんですか……？",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一糸もまとわぬ裸から、想像できるのは、わずかに辻強盗ぐらいなものだった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "小沢は外地から復員して、今夜やっと故郷の大阪へ帰って来たばかしだが、終戦後の都会や近郊の辻強盗の噂は、汽車の中できいて知っていた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "強盗と同じこっちゃさかいな」　そう言った時、次郎ははっと眼を輝かせた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "強盗もよう掴まえんのに……」「どないしたら、ええやろ」「…………」　もう次郎は答えなかった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故世の中には情死や殺人や強盗や姦通や自殺や放火や詐欺や喧嘩や脅迫や謀殺の騒が斷えぬのであらうか、何故また狂人や行倒や乞食や貧乏人が出來るのであらうか。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありふれた強盗、強姦、殺人事件にばかりぶつかって最初から犯人のアタリを附けてかかる流儀に慣れ切っている草川巡査は、この事件に限って、実際、暗黒の中を手探りで行くような気迷いを感じながら、駐在所を出たものであった。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "疑いもない強盗殺人で、新夫婦が熟睡して気付かぬ間に演ぜられた兇行に相違ない。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "robbery",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの事件は単なる窃盗ではなく、悪質な強盗だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "銃器を用いた強盗は、非常に重い罪に問われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行中は、強盗に遭わないよう貴重品の管理に気をつけよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
