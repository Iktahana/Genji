        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は一度決めたら聞かない強情っ張りだから、説得するのは難しいだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私の祖父は昔ながらの強情っ張りで、新しいものにはなかなか手を出さない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あの強情っ張りをどうにかしないと、会議が進まないよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それ位で知人もない神戸へ行くのは危険だ、それは止したがいいと、私はしきりに手を振ったが、七面鳥さんなかなか強情っ張りで、容易に私の戒告を聴こうとはしなかった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「強情っ張りよ」　妹が老婆を見て云った。",
              "citation": {
                "source": "蟇の血",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このおじさんは強情っ張りがいちばんきらいだからな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾はこの上なく自尊心の強い強情っ張りなんです。",
              "citation": {
                "source": "オパール色の手紙",
                "author": "――ある女の日記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、二人とも、親譲りの、強情っ張りだからの」「頼まあ、俺、じゃあ、行くから」　南玉は、頷いて、元の座へ戻りかけた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "このむすめは、わんぱくにそだって、おまけにごうじょうっぱりでしたから、なんでもしたいとおもうことをしなければ、気がすみませんでした。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「強情っぱりだね。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私だってもっと強情っぱりだ。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとひねりひねりあげりゃ、どんな強情っぱりでも音をあげるにちげえねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二コマとんでいいっていうならこうなるじゃないか」「違うさ、それじゃ斜の線だもの、同じ線の上でなくちゃ」「だって、こうだぜ、君は強情っぱりだなア」　竹村もそんなことをいう気分になった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ女の強情っぱりだ！",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなに立派に聞こえたんなら、なぜ自分で行かないんだい、この罰当たり」「おや、僕が冗談を言うと思ってるんだね」「へん、それくらいのことはしかねないからさ、信心のことときたら」「きっとだから……」「うるさい」「よしよし、強情っぱり、勝手にするがいい。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
