        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ある時同じ露西亜生れのヤアシヤ・ハイフエツツといふ名高い少年｜提琴手の独奏会が紐育のある楽堂で催されたので、友達のレオポルド・ゴドヰスキといふ洋琴弾きと一緒に聴きに往つた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして小声で側にゐる洋琴手のゴドヰスキに耳打ちをした。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」人の悪いゴドヰスキは汗ばんだ友達の顔を見ながら言つた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
