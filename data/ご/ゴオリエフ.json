        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ぢや、ゴオリエフを知つてるだらう？",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ゴオリエフを知つてるのかい、……ふうん……。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのゴオリエフに、おれは最近会つたんだよ。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "知りもしないゴオリエフなんていふユダヤ人が出て来やがつて、話が面倒になつちまつた。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの婆あ、そのゴオリエフなるものを怖がつてやがつて、おれがなにか、そいつの廻し者かなんぞのやうに思ひ込んだんだ。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
