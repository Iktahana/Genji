  {
    "uuid": "9651f9a1-a161-5c1b-8d26-c6ec5379c11e",
    "entry": "ゴゴ",
    "reading": {
      "primary": "ごご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかるところ、唯今申上げました（コンニチゴゴツク、ヨウイ）で、不意に故障が起りました、幾度も接続を試みますうちに、うかと記憶に残ったのです。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴゴン、ゴーゴー、　うすい雲から　酒が降りだす、　酒の中から　霜がながれる。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴゴン、ゴーゴー、　ゴゴン、ゴーゴー、　霜がとければ、　つちはまっくろ。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴゴン、ゴーゴー」　それからもっともっとつづけざまに、わけのわからないことを歌いました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴゴンゴーゴー、　やまのいわやで、　熊が火をたき、　あまりけむくて、　ほらを逃げ出す。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴゴンゴー、　田螺はのろのろ。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "田螺のしゃっぽは、　羅紗の上等、ゴゴンゴーゴー」　本線のシグナルはせっかちでしたから、シグナレスの返事のないのに、まるであわててしまいました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オンオンオンオン、ゴゴンゴーゴーゴゴンゴー」　風はますます吹きつのり、西の空が変に白くぼんやりなって、どうもあやしいと思っているうちに、チラチラチラチラとうとう雪がやって参りました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空では風がフイウ、涙を知らない電信柱どもはゴゴンゴーゴーゴゴンゴーゴー。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "電信ばしらが、「ゴーゴー、ガーガー、キイミイガアアヨオワア、ゴゴー、ゴゴー、ゴゴー。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アスゴゴ八ジノキウコウデタテウオソウデマツ」　で、それに久しくあくがれて旅をして来た女の父親の名と番地とを書いて、それを本社のＴさんあての電報の下にして、丁度向うに来てゐた女中を手を鳴して呼んだ。",
              "citation": {
                "source": "海をわたる",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "二カゴゴニウコウとある。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありゃあ、芸者ちゆうたって、ここらの町のゴゴさんよりゃおとなしか子じゃけん、心配いらんたい。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "波の音は、地の底からのように、ゴゴーッ、ゴゴーッと突きあげ、ゆすぶつて、僕ら三人を包んでいるのです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デ・ルカ、ゴゴルツァ、ショル、エディ、ヤンセンDe Luca, Gogorza, Schorr, Eddy, Janssen　デ・ルカは過去の人になったが、旧盤時代にはルッフォ、スコッティ、バッティスティニらと並んで、或はこの三人を率いてビクターのバリトン陣第一人者であった。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴゴルツァはスペインのバリトンで、アメリカ人になり切っているが、スペイン的なものが良いらしい。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アケチタンテイ、ユウリョクナブキヲモチ、ケサ、シュッパツシタ、ゴゴ五ジ、ソチラニツクハズ」　ああ、明智探偵が来るというのです。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッダッダッと地の底を打つような音――ゴゴゴゴゴという騒音――それがだんだんに近づいてくる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
