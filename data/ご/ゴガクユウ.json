        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「そのアマリエンボルグ宮にいた頃、殿下の御学友に……」　ハッとしたように老人は口を噤んだが、さりげなく続ける。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「王子殿下たちの御学友でしたがな、その方がいやもう器用とも器用とも！",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホホホホホホ、その御学友は俳優にでもおなりでしたの？",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「御学友たちは、大勢いらっしゃいましたの？",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっき老人が、御学友なぞと言っていた造船会社のステーンセン伯爵とは、もしかすると……もしかすると、先王陛下のその秘密のお子様ではないかしら？",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "表面は、王子らの御学友ということになっているが、待遇は王子王女と何の変りもなかったことが判明した。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはまだ極秘のことなんだが、おまえは近いうちに若君の御学友にあげられる筈だ。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――近いうち若君の御学友にあげられるだろう、そのなかでおまえと小太郎の二人に、いちばん望みをかけている。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そんなことにならないように、自分ではかなり努力したつもりだったが、その甲斐もなく「御学友」にあげられてしまったのである。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おひとりでは出来ない芸で、これには日頃の御学友なども加担していたにちがいない。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
