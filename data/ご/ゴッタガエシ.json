        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "停車場は、持てるだけ荷物をかゝえこんだ青島への避難者でごった返した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔を黒く隈どった赤鉢巻の青年達で、市中はごった返している。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　たちまち船の上はごった返しの騒ぎとなった。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、ごった返している人込みのあいだを押し分けてゆく厄介さも、気持をいらだたせるのにかなり油を注いだ。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "百貨店は押し合いへし合いごった返した。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "死んだ農奴と知事の娘とチチコフとが、彼等の頭の中で非常に変な具合にこんぐらかって、ごった返した。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "通りはまた通りで、幌をかけた弾機附馬車や、一向見たこともない大型の馬車や、喧ましいガタ馬車や、車輪のギーギー軋る馬車などで一杯になって、まるで芋をあらうようにごった返した。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ここがそろそろ空襲に見舞はれ出し、街は疎開騒ぎでごった返しの最中だった。",
              "citation": {
                "source": "詩集『花電車』序",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "日曜日のこととて大人と子供で園内はごった返していたので、動物を見るどころの騒ぎではない。",
              "citation": {
                "source": "スフィンクス（覚書）",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度今省線電車の線路増設や停車場の位置変更などで、上の方も下の方も工事の最中でごった返していて、足元も危うい位の混乱を呈している。",
              "citation": {
                "source": "早稲田神楽坂",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と振り試みるもの、上を下へとごった返しているから、これを見た与吉が、ひそかに考えたことには、「これほどじゃあるめえと思ったが、強そうには強そうだけれど、いやはやどうも、ひでえ田舎ッぺばかりじゃアねえか。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "近い親類の者も駈けつけたらしく、広い家のなかはごった返していた。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "宇治の茶箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "露路に向かって駈け込む者、露路から往来へ駈け出る者……それで、往来はごった返している。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごった返しているのである。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜の花を見る人で、ごった返していただろう。",
              "citation": {
                "source": "奥さんの家出",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "町々はうちこわしの群衆と、それを見物の群衆とで、ごった返し沸き立っていた。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ海岸が河童共のごった返している最中に、ええと、瑠美子、とかいったな、大井という実業家の長女だ、それが海岸で冷えた体を砂の上で暖めていて、気がついてみると、誰も知らぬ間に、胸に匕首を突刺されていた、という訳なんだ。",
              "citation": {
                "source": "鱗粉",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから大金持と乞食とがまるでごった返しているのである。",
              "citation": {
                "source": "余齢初旅",
                "author": "――中支遊記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月二日（水曜）英語ディクテーション　英男が四十度の熱を出したので家中ごった返して仕舞った。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "英男もあまりよくないので、家中はごった返しに返して居る。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥濘にごった返した土を見た時、帰らなければよかったと思った。",
              "citation": {
                "source": "五色温泉スキー日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "けい　何時、何処が戦争でごった返しになるかわからない中国にいて、女や子供だけで、のうのうと旦那様の留守を娯しんでなどいられるのですか。",
              "citation": {
                "source": "女の一生",
                "author": "五幕七場",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の中はごった返していた。",
              "citation": {
                "source": "公孫樹",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "両方で、男と女とが芋の子のように湯壺の中にこみ合って、ごった返してる。",
              "citation": {
                "source": "或る素描",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある限りの力を搾って、堰き止めるものと突き破るものとが、ごった返してる渦巻きのうなりが、ごーう、ごーう………と秋子の喉から洩れてきた。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう別々に云ってしまえば何でもないが、そんないろんなことが、それにまた他のことも加わって、一緒にごった返して、僕の頭はめちゃめちゃになってしまった。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから大騒ぎになって、その男は仲間の者から、すぐ病院へかつぎ込まれるし、警官はやって来るし、野次馬はたかるし、ごった返しましたが、どういうものか、警官は皆をカフェーの外に逐い出してしまいました。",
              "citation": {
                "source": "変な男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、こうしたごった返しやさし変えにかかわらず、やはりある痛みを感ずる。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹き矢と並んで煮込みおでん、その前に大福餅、稲荷鮓、などとごった返して、一盛りその景気は大したものでありました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "佐竹の原繁昌のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると伊藤公が撃られたというんでしょう、さあ大変、みんな滅茶苦茶に飛び出して行って、わいわいごった返しです。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
