        "examples": {
          "standard": [
            {
              "text": "「隅の方でごちょごちょ相談してないで、みんなの前で堂々と言ってよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「いつまでごちょごちょ細かい不満を並べているんだ、いい加減にしろ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "何やらごちょごちょと独り言を言いながら、彼は熱心に作業を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "御免なさりませよ」と心のうちで弁解して何か解らないものを、ごちょごちょと書くように手を動かした。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
