          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日のランチは部長のゴチだったので、いつもより豪華なメニューを選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「昨日の埋め合わせに、帰りのコンビニでアイスをゴチするよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昇進祝いで親友に回らないお寿司をゴチになり、最高の気分だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "（子規の作った万葉ばりの歌というのが、全然音楽美のないゴチゴチした散文的のものであった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のドイツで一番高いゴチックの寺塔のあるという外には格別世界に誇るべき何物をも有たないらしいこの市名は偶然にこの科学者の出現と結び付けられる事になった。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "特にゴチックの建築に譬えられるバッハのものを彼が好むのは偶然ではないかもしれない。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "本の色彩をゴチヤゴチヤに積みあげて、一度この檸檬で試して見たら。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度クリストフは手鼻をかんだ処で、そのとばしりが地の透くやうになつた上衣に掛かつてゐるのを、丁寧にゴチツク形の指で弾いてゐる。",
              "citation": {
                "source": "老人",
                "author": "GREISE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな時は痩せたクリストフがゴチツク形の指をおそる／＼差し伸べて拾つて、帰り途にそれを大切な珍らしい物のやうに手に持つてゐる。",
              "citation": {
                "source": "老人",
                "author": "GREISE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただそれがＱの冷罵とペルゴレシの音楽とのすぐ後に出くわしたばかりに、偶然自分の子供らしいイーゴチズムに迎合したのかもしれない。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴチック建築のなかを辿ってゆくときのような、犇ひしと迫って来る静寂と孤独とが感じられた。",
              "citation": {
                "source": "筧の話",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは暗いゴチツク建築のなかを辿つてゆくときのやうな、犇々とせまつて來る靜寂と孤獨とを眼覺ました。",
              "citation": {
                "source": "闇への書",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このゴチツク風の建物の内部は、しかし、全然日光が射して來ないのではなかつた。",
              "citation": {
                "source": "闇への書",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本の色彩をゴチャゴチャに積みあげて、一度この檸檬で試してみたら。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノゴチソウデス」　あるじは固くなって言った。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い素足と真紅のスリッパにゴチック式の豪華を極めた応接間をモノともせぬ勝気さを見せて、これも炭坑王の奢りを見せた真綿入｜緞子の肘掛椅子に、白い豊満な肉体を深々と埋めている。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "最前から見物していたキャラメルの仲間のミンツ、ボンボン、チョコレート、ドロップス、飴玉の仲間の元禄、西郷玉、花林糖、有平糖なぞはソレというので馳け寄って、双方入り乱れてゴチャゴチャに押し合い掴み合っているうちに、みんなお互いにくっつき合って動けなくなってしまいました。",
              "citation": {
                "source": "キャラメルと飴玉",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、アル　ヒノ　コト　ガチヨウノ　タンジヨウビト　イフノデ、ミンナハ　ガチヨウノ　トコロヘ　ゴチソウニ　マネカレテ　イキマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロイロナ　ゴチソウガ　デマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチモ　ゴチソウニ　ナリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴチや／＼メヤや／＼其間に猫が浮きつ沈みつして居る。",
              "citation": {
                "source": "鈴木三重吉宛書簡―明治三十九年",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "取っつきの室には粗末な木地のテーブルに、ミルクの空罎だのつまったのだの、ゴチャ交ぜに並べた、その横に素の片肱をついて、同じ亜麻色の髪のセーニャによく似た若い娘が此方を微笑して見ていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めどんな物をかこうかと相談して下すったので、第一部はゴチック第二部はアンチックと云う風にして下さいと願った。",
              "citation": {
                "source": "訳本ファウストについて",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンチックは造做は無いが、ゴチックはなんにしようかと、太田さんは迷って、随分暇を潰してあれを捜して下すった。",
              "citation": {
                "source": "訳本ファウストについて",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、私の中には色んな奇妙な奴等がゴチヤ／＼と雜居してゐるらしい。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三造は初め一向のみ込めなかったが、とにかくＭ氏の開けてくれた所――白樺の、女の子の喜びそうな栞が挟んである――を見ると、なるほど、一頁が上下二段に分れていて、その上段にゴチックで彼の細君の名が記されている。",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、私の中には色んな奇妙な奴らがゴチャゴチャと雑居しているらしい。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬が十頭近く、豚もそれ位、その外、猫だの山羊だの鶏だの家鴨だのが、ゴチャゴチャしている。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
