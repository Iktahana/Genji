        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あー美味しかった！今日のランチ、ゴチでした！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「先輩、ゴチっすね！あざーっす！」と後輩が満足げに言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「これ、昨日のゴチのお返し。つまらないものだけど食べて」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
