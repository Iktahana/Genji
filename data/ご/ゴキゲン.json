        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "しばらくお会いしておりませんが、その後ご機嫌はいかがでしょうか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "恩師の家を訪ね、長らくご無沙汰していたことへのお詫びとご機嫌伺いをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "便りがないのはご機嫌が良い証拠だと言い聞かせて、息子の連絡を待つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "in a good mood",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
