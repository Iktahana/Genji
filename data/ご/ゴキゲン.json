  {
    "uuid": "5427c5d9-fe1c-525f-aaae-2935f9b0918d",
    "entry": "ゴキゲン",
    "reading": {
      "primary": "ごきげん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "内容に踏み込むことはレビューの狙いからは外れるだろうが、作品はすっとぼけたゴキゲンな宇宙オトギ話だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミナサン、ゴキゲンヨクオヤスミナサイマセを云ったあとですよ。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "時にゴキゲンは相変らずで、実は小々本日は話の筋があつて」「もうダメだよ。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃ葉子さん、ゴキゲンよう。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長は、信玄のアトトリの勝頼に自分の養女をもらってもらって、しきりにゴキゲンをとりむすんでいた。",
              "citation": {
                "source": "織田信長",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長はゴキゲンをとりむすぶぐらいは平チャラだった。",
              "citation": {
                "source": "織田信長",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "本日はまた、うるわしいゴキゲンで何よりでざんす。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲さんゴキゲンナナメだね」　半平、かがみこんで、ほる。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいゴキゲンですね。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇賀神のところへは各党の政治家が出入りしてゴキゲンをとりむすび、金をもらっている。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "べつに大した用もないんだが、お名残りおしいから、ゴキゲン伺いにきたのさ」　相変らずの皮肉な口調であった。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浩然の気を養うという大人の風格があるよ」　と、感心したのか、ひやかしたのか、わけのわからないことを長平が言うと、せつ子はなさけなそうに苦笑して、「ゴキゲンとりむすぶの、つらい。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴキゲンいかがですか。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのところへゴキゲン伺いは今日がはじめて、御降嫁以来御無沙汰していたが、うん、こうして御対面、シミジミ拝顔すると、さすがに正司君は目が高い。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴキゲンよう」　伊助は無言で頭を一つペコンと下げただけだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            },
            {
              "text": "控えの部屋にナミ子がいたから、「御主人のゴキゲンはどうだ？",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            },
            {
              "text": "日中は誰も便器も見てあげなかったようだから一パイつまって臭いかな、と案じながら、まずドアをあけて燭台をかかげて病人のゴキゲン偵察に中をのぞきに行った。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺さんはよいゴキゲンで引越しの荷造りをしているところだ。",
              "citation": {
                "source": "能面の秘密",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が赤くなるのは一滴ものめなくてムカムカ吐き気に苦しみだした時なのだが、人はそうとは知らないから、オヤ、今日は大そうゴキゲンですね。",
              "citation": {
                "source": "人生三つの愉しみ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "真ッ昼間、一時ごろというに、昼酒をきこしめして、良きゴキゲンだったね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏屋のオヤジサンは犬に吠えられるのが大キライだそうで、ウチの犬が店の前を通ると肉やタマゴをサービスしてゴキゲンをとりむすんでいるそうだが、全然キキメがない。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴキゲンヨウ」　アリーのこの挨拶が又、母を喜ばせた。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろと手をつくしてヒダの土民のゴキゲンをとりむすんで、奈良京の終りごろにはどうやらヒダにも国司を置いて税をとることもできるようになった。",
              "citation": {
                "source": "飛騨の顔",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷崎先生と葡萄酒　これも日本ゴキゲンなりし昔のこと。",
              "citation": {
                "source": "食べたり君よ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
