    },
    "definitions": [
      {
        "index": 1,
        "gloss": "garbage dump",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "失礼な話だけど、彼の部屋はまるでお菓子の袋のゴミ溜めのようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "空き地に不法投棄が相次ぎ、いつの間にかゴミ溜めになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「こんなゴミ溜めみたいなところで生活していたら、病気になっちゃうよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼等は方々の料理屋のゴミ溜めを漁ったり、掻っ浚ったりして喰っている。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐久間町の裏、ゴミ溜めのような棟割長屋の奥で、魚のように切られて死んでいるのを、翌る朝になってから、隣に住んでいる、蝮の銅六という緡売りの、いかさま博奕を渡世のようにしている男が見付け、町内の大騒動になったのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "南蛮仏",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はゴミためを漁りにやって来るが、もはやそのゴミためというものさえも人間の家にはないのである。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "学術上は千何種類あるというが、普通釣り師が使うものだけで、ドバ、シマ、アズキの三種であるが、同じキジでもゴミための下にいるゴミキジは喜ばない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "主として山だが、立木でも、煙出しでも、屋根でも、土手でも、ゴミためでも、何でもかまわぬ。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "路次から路次をかけ廻りながら捕手は、ゴミための蓋から空家の床下まで覗いていったが、とうとう姿が見あたらなかった。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
