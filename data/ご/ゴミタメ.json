[
  {
    "uuid": "b3ed0b3e-25a6-549c-a342-349b17d48777",
    "entry": "ゴミ溜め",
    "reading": {
      "primary": "ゴミため",
      "alternatives": [
        "ごみため",
        "ゴミタメ"
      ],
      "is_heteronym": true
