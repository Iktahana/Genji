[
  {
    "uuid": "3a4babd2-8074-55af-a8d5-b1b26d588309",
    "entry": "ごとり",
    "reading": {
      "primary": "ごとり",
      "alternatives": [
        "ゴトリ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞-と"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "with a thump",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "手から滑り落ちた本が、床にごとりと音を立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冷蔵庫のドアを閉めると、中から何かがごとりと動いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は急に椅子に座り直し、ごとりと大きな音を立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この部屋きりの一人住居――そんな風に女の身を想像してゐた私は、思掛ない氣持で扉の方を眺めながら耳を澄ましたが、ごとりごとりと聞えてゐた女の靴音はやがて止んで、隣の部屋は直ぐに鎭まり返つてしまつた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると何やらまつ白な、尾の形した塊が、ごとりと床にころがり落ちた。",
              "citation": {
                "source": "北守将軍と三人兄弟の医者",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラットホームに呆然と立っているうちに、列車は溜息のような汽笛を鳴らして、たいぎそうにごとりと動いた。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、狙いを定めているうちに、馬車はごとりと揺れ、ぎしぎしと軋めきながら方向を更えた。",
              "citation": {
                "source": "熊の出る開墾地",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神経は針のように尖って、ごとりと音がしても、警官がふみこんで来たのではないかと思ってひやりとした。",
              "citation": {
                "source": "山吹町の殺人",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はしばらくはごとりと物音がしても「もしや参木が」というように身を起した。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがもうほとほと気力もつきてごとりと桃の枝を床の上に落し、彼は目頭に涙さえ浮べながら更に沈んで盃を重ね始めた。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその途端に、中継の柱のところで、急にごとりと車体が一度ずり下った。",
              "citation": {
                "source": "比叡",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "車を降りて初めて地を踏んだとき、清は大きな声で、「恐かったね、さっき、ごとりっていうんだもの。",
              "citation": {
                "source": "比叡",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の者はそれに驚いて見ると、馬は退屈そうに、ごとりごとり歩き出した。",
              "citation": {
                "source": "黄昏",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごとりごとりと云う音がする。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、ごとりと云った。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくしてまたごとりと云った。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "世を畏れぬ鉄輪をごとりと転す。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "知らぬ車はごとりごとりと廻転する。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてごとりと一つ反動をなして止まった。",
              "citation": {
                "source": "轢死人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "風もないらしいのに、硝子戸がごとりと揺れた。",
              "citation": {
                "source": "女心の強ければ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "暁方近くうとうとして、ごとりごとり床板を踏む、フォイツの足音に、ふと眼覚めた時は、枕に近い小さい窓には、朝靄が浴場の玻璃扉のように渦まいておる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の家では、一番年上の十二になる子供が、表の戸がごとりごとり叩かれるのを聞きつけて、立っていって戸を開けると、にゅっと馬の頭がはいってきた。",
              "citation": {
                "source": "狐火",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
