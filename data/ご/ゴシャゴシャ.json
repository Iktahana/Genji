    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そうして、どの新聞を見ても、私が探している記事が見当らないことがわかると、私はニッタリと冷笑しながら、ゴシャゴシャに重ねて押し丸めた。",
              "citation": {
                "source": "縊死体",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は二三枚の新聞紙をゴシャゴシャに丸めて、ベンチの下へ投げ込むと、バットを一本口に啣えながら、その方向の曇った空を振り返った。",
              "citation": {
                "source": "縊死体",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつだって机ん中ゴシャゴシャにしとる奴！",
              "citation": {
                "source": "砂遊場からの同志",
                "author": "――ソヴェト同盟の共学について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴子はベッドの上に半身を起してその方へ聞き耳を立てると、ドアの外で何かゴシャゴシャ言っている工合では、そこにいるのはどうやら竜太郎一人ではないらしい。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "とてもそれどころじゃない」　あたしは終戦の日から〈新日本史〉の執筆をはじめ、毎日、部屋にこもってゴシャゴシャ書きつけている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴシャゴシャいってないで、すこし運動していらっしゃい。",
              "citation": {
                "source": "キャラコさん",
                "author": "ぬすびと",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなものがあたしのところまで押し寄せて来ようとは思わなかったわ」　閉口して、両手でゴシャゴシャと髪を掻き廻しながら、長い間なにか考えていた。",
              "citation": {
                "source": "キャラコさん",
                "author": "雁来紅の家",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
