          "literary": [
            {
              "text": "獄中でゲタの鼻緒の芯をない、封筒はりをしたが、獄房の中へもシャバのタヨリが伝わってくる。",
              "citation": {
                "source": "私の履歴書",
                "author": "浅沼稲次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は友人の三宅正一、稲村隆一の両君が活躍していることを思い、いても立ってもおられず出獄したら、すぐその足で新潟に行き応援しようと心に決め、獄房の中で小さな声でアジ演説の練習をしていた。",
              "citation": {
                "source": "私の履歴書",
                "author": "浅沼稲次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったい、世には、こんな巨大な獄房の数を必要とするほど、悪人が多いのだろうか。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
