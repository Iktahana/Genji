    "definitions": [
      {
        "index": 1,
        "gloss": "thud",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "頭をドアにゴツンとぶつけてしまい、痛かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重い荷物が床にゴツンと落ちて、大きな音がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ボールが壁にゴツンと当たって跳ね返ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "と同時に彼の足は小荷物台から攫われて、尻や背中でゴツンゴツンと調子をとりながら、コンクリートの上へ引きずり下された。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "こくりこくりしかけていた少年兵は、ふと頭をゴツンと打って眼をあけた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "向直らうとして、又ゴツン。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女教員さんのシヤンを覗いて、戸だなで、ゴツンの量見だから、これ、天の戒むる所であらう。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら死ななくても、あの金槌でゴツンとやられるのは御免だ」「ホントに恐ろしゅう御座いましたね」　二人は話し合いました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と一所に正吉はゴツンと強く柱の角に頭をぶつつけた。",
              "citation": {
                "source": "やぶ入の前夜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄坊の頭がゴツンと鳴つて、玄坊がワツと泣いたので、自分は急いで面を脱いだ。",
              "citation": {
                "source": "蚊",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に立っているものが、それを見付けて、いきなり二つ並んでいる頭を両方からゴツンとやった。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍吉は輕くゴツン／＼と板壁に自分の頭を打ちつけてみた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そして、彼の頭はゴツンと硬い天井を突きあげたのだった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりかえしがつかない」　そういって、杜はわれとわが頭を握り拳でもってゴツンゴツンと殴った。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　間もなく彼の、うつかり――彼の槍の尻がゴツンと玄吉の頭にひどく当りました。",
              "citation": {
                "source": "蔭ひなた",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この不規則に激烈な運動につれて背中の荷物は思わず跳ねあがって私の後頭部にゴツンと突き当ったり、背骨一杯を息も止まれと云わんばかりにハタきつけたりしたが私は、やがて到達すべきピエル・フォンの「森蔭深き城砦の」饗宴の卓を眼蓋の裏に描きながら、この猛烈な苦悶に殉じた。",
              "citation": {
                "source": "ゼーロン",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがために、彼はステッキの頭で顎をいやというほど打ったり、そうかと思うと、今度は後頭部をゴツンとぶっつけたりで……、結局は躯じゅうを泥だらけにしてしまったのである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして一艘の小舟がもやはうとして、上下に揺れながら、ゴツンゴツンと岸にぶつかつてゐる。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、故意か内発か――なんだ」と乙骨医師は卓子をゴツンと叩いて、彼の知見を強調するのだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッ、推進機で、首が截られた……」　すると船底を、鈍くゴツンゴツンと突きながら遠のいてゆくものがあって、その響きが、靴の底からズウンと浸み渡ったとき、巡査はもう何事も分らなくなってしまった。",
              "citation": {
                "source": "地虫",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我すばやく起上つて敵の頭をゴツン。",
              "citation": {
                "source": "剣術の極意を語る",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、皆サンゴゾンジナイカモ分リマセンガ、ジヤガイモサンハ大ヘンナオ寝坊サンデシタカラ、人参サンニゴツンゴツンタタカレテモ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　チョイとアゴを押して、ゴツンと頭を柱にぶつけさせた。",
              "citation": {
                "source": "桂馬の幻想",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、ひどく担ぎやの寒川家の頑固ぢぢいを思ひ泛べてゴツンと息をのんだのである。",
              "citation": {
                "source": "村のひと騒ぎ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "父のするように、竿先を少しずつ次第に水面近くへあげてくると、ゴツンと当たりがあった。",
              "citation": {
                "source": "父の俤",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "脚立の上から潮下に向って錘を遠く打込み海底で錘をこづき加減に竿先を動かしているとゴツンと当りがある。",
              "citation": {
                "source": "青鱚脚立釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、実際に食べないという事実にゴツンとぶつかったら、泣きたくなりやしないか。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その四　人形の家",
                "note": "青空文庫"
              }
            },
            {
              "text": "亀の子のように空中で首を振っているあの大きな梁が、彼の乗っている梁にもう一度ゴツンとでも触れて見ろ！",
              "citation": {
                "source": "秋空晴れて",
                "author": "吉田甲子太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
