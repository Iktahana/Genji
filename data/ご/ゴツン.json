    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "わざわざ目の前に置いてある地図から目をそらし、ごつんごつん周囲の壁に頭をぶつけては、ようやく一段ずつステップを確認していったことが、今となれば不思議でなりません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "トゥロットが、ふざけがあんまり永すぎるとおもつて、もつてゐたおもちやのシャベルで、犬の背中を力一ぱい、ごつんとくらはせたからでした。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トゥロットは、くわッと血が顔中へ上つて来ると一しよに、シャベルをふり上げて、ごつんと男の子の頭をなぐりつけました。",
              "citation": {
                "source": "乞食の子",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "とびだすとき、ひおいの棒にごつんと頭をぶつけて、大きなこぶをつくりました。",
              "citation": {
                "source": "王さまと靴屋",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、頭をごつんごつんと打って、だんだん苦しくなりました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と怒鳴りつけたと思ふと、如何にも腹が立つて堪らぬといつた風にわな／＼しながら、持つて居た太い銀煙管で私の頭をごつんと叩きつけた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に彼のすぐ傍で居眠りをしている鬚もじゃな小男が頭を彼の方へもたせかけたと見るや、いきなり彼は荒くれた拳骨を男の頭上へごつんと打ち下ろした。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごつんと膝頭をぶっつけた彼は、あたりに木魂した声を遠く聞いて、ふるえ声で答えた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸にごつんと当って乗りあげた舳のわきから、先の男がとびこんだ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごつんごつんと頭をたたかれたような先年来の労苦が、半夜の瞼を濡らすのであろう。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は拳固をこしらえると自分の頭をごつんと一撃してからそのトランクの口を閉めて再び店の一隅へ並べた。",
              "citation": {
                "source": "鞄らしくない鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごつんと向脛を一撃される。",
              "citation": {
                "source": "烏啼天駆シリーズ・４　暗号の役割",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニュートンが、リンゴが頭の上から地上へごつんと落ちたのを見て、重力を発見したというあれでしょう」「そのあれです。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、見物人の席から板ぎれがとんできましてね、これが雨谷の頭にごつんとあたったんです。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あ、痛……」　頭をごつんとぶっつけた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "眠っていた恐竜の鼻に、岩のかけらが、ごつんと命中したのであった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつはわしの大嫌いな人間じゃからな」　金博士は、最初の一撃でもって、特使をごつんとやっつけた――つもりであった。",
              "citation": {
                "source": "不沈軍艦の見本",
                "author": "――金博士シリーズ・10――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぶうーん」「あっ、いた――」　とつぜん、佐々の顎に、相手の鉄拳が、ごつんとはいった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "うれしや、兵曹長の頭が、飛行機の腹にごつんとあたりました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓を外からごつんごつんと鳴らしに来る魚が見えましたので、これをとくと見なおしますと、魚も魚、たいへんな魚でありました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、みんな、はやくこいつの兜をぬがしてみろ」　リーロフは、太刀川の潜水兜に自分のをよせて、ごつんごつんと、いじのわるい頭づきをくれた。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
