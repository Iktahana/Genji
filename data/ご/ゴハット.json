[
  {
    "uuid": "f3e3fd7d-c306-56fc-914c-c93b55ff811f",
    "entry": "ご法度",
    "reading": {
      "primary": "ごはっと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
