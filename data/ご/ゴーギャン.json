        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "光琳の躑躅などは、セザンヌ、モネー、ゴーギャン、誰の画よりも、すぐれていると思われました。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分たちの少年の頃には、日本ではフランスの所謂印象派の画が大流行していて、洋画鑑賞の第一歩を、たいていこのあたりからはじめたもので、ゴッホ、ゴーギャン、セザンヌ、ルナアルなどというひとの絵は、田舎の中学生でも、たいていその写真版を見て知っていたのでした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "引越しのゴタゴタの間、つかれるとちょいとひろげては、モームの「月と六ペンス」ゴーギャンの生活から書いたという小説をよみました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーギャンは、ロンドンの株屋だったのね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーギャンに当る人間は、いくらか偶像的に間接にしかかかれていません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "このゴーギャンにゴッホがひきつけられ、しかもそれは不安な魅力で、ゴッホが自画像の耳が変だとゴーギャンに云われて、てんかんの発作をおこして自分の耳をきりおとしてしまったことなど、そういう人間の火花は面白いけれど、書かれては居りません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもゴーギャンの絵のあの黄色と紫と赤のあの息苦しいような美はよくとらえて、タヒチの美として、ゴーギャンの感覚としてかいて居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーギャンの絵の感覚は、そういう自然の中に他国の感覚で入って行って、全身をそこに浸したときの作品ですね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ゴーギャンだってさ――あんなひどい一生だったのに。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界の金もちだけよ、いま、ゴーギャンを買えるのは」　伸子と素子とはメトロのステーションの段々を降りて行った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ず美術について考えれば、一方にゴーガンや、ゴーホや、ムンヒや、それから詩人画家のブレークなどがいて、典型的な主観派を代表している。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら前に他の章（音楽と美術）で言っているように、美術それ自体の部門に於てまた主観派と客観派との対立があり、その主観派に属するもの――ミレーや、ターナアや、ゴーガンや、ゴーホや、ムンヒや、歌麿や、広重や――は、画家と言うよりはむしろ詩人に属している。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美術にあっては、一方にミレーやゴーガン等の、抒情派があり、一方にピカソやセザンヌ等の、歪んだ科学的の叙事詩派がある。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーホやゴーガンもいつまでも崇拝されるだろう。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーガンの複製を見てをるだけだ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くとも、今甲板から眺めるクサイの島は、どう見ても、ゴーガンの畫題ではない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーガンの複製を見ておるだけだ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くとも、今甲板から眺めるクサイの島は、どう見ても、ゴーガンの画題ではない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーガンという人は仏蘭西の人ですが、野蛮人の妙な絵を描きます。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、昨夜の行動を申上げましょうか」と云って、――四時に学校から戻って、それから室でゴーガンの伝記を読んでいて、七時に夕食に呼ばれ、九時頃蒟蒻閻魔の縁日に出掛けて十時過ぎに帰宅したと云う旨を、要領よく述べ立てた。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此他、大きな差は、印度土着の画師が描いたもの、ゴーガンと云う欧州人が、タイチの島に住み、爛熟した西洋文明と相反する恐ろしいような自然力を感じ、生命の力に圧せられて描いたもの、と云う点。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイチが描かれた場合、そこには、哲学を知ったゴーガンと云う一つのはっきりした反射鏡があるから、まるで異う。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モローゾフスキーには、ピカソの笛吹きをはじめ、青年時代のいくつかの作品やゴーガン、カリエール、ドガ、モネ、マネ、セザンヌなどフランスの印象派画家たちの作品があった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "GAUGUIN（ゴーガン）は TAHITI（タヒチ）へまで行って非フランス的な色彩を残したが、彼の作は考えて見ると、TAHITI 式ではなくして矢張りパリっ子式である。",
              "citation": {
                "source": "緑色の太陽",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神の光に涵っていた人間がはじめて太陽の光を発見し、ベンノー・ライフェンベルグが指摘するように、一九〇〇年代ゴッホ、ゴーガンによってそれが燃え切らされて後、人間は一種真昼の寂寥を画布に味わいはじめた。",
              "citation": {
                "source": "芸術の人間学的考察",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽の光をふんだんに費ったという、十八、十九世紀の絵画も、ゴッホ、ゴーガンをもって区切りとし、燃えきってしまって、やがて、一九〇〇年代、ムンクより始まって、キリコにいたる線は、寂しい空虚が、芸術を支配しはじめるのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてこれが十九世紀の末にいたって、ゴッホ、ゴーガンのあの太陽の光の洪水、あの太陽の光の賛美によって頂点に達するのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーガン、ゴッホで、その個性の豊かさは最高の点にまで達し、ようやくそのカタストローフ、その空間の破壊が支配しはじめたのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴッホもゴーガンも芭蕉もさうだ。",
              "citation": {
                "source": "エゴイズム小論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "メリメがコルシカに、ゴーガンがタヒチに見出した旅のような、何かが。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
