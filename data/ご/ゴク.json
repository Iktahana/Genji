    },
    "definitions": [
      {
        "index": 1,
        "gloss": "quite",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はごく普通のサラリーマンに見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その問題はごく簡単に解決できたよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の意見はごく的を射ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "勿論時代といふものは極めて包括的に観る場合にのみその姿を現すがやうなものであるから、現代が芸術のためには明かに不幸な時代であるとしてからが、それは必ずしも芸術家個人々々にまで直ちに不幸な時代といふことを意味しはしまい。",
              "citation": {
                "source": "詩と現代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ是等三様式は極めて短い詩形であるから、語自体の力が、語を駆使する作者の力よりも存外に大きいものであることは明瞭であらう。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "新体詩様式は、未だ十分の発達を示してはゐないけれども、人々はその案外に困難なる故を以てかどうか、何時の間にか退却し、昨今再び立向つてゐる状勢だが、猶極めて怠惰な立向ひ方と云へよう。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "加ふるに黄熱病が猖獗を極めてゐて、ルモオルは船から船に移されて漸くのことで例の親戚の手に渡されたのだが、その親戚は貧乏になりはてちまつてゐたといふわけだ。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "統一への途上に於て小主観的作品の物されることが多ければこそ、問題は錯雑を極め、作品よりも批評の方に真実の見られ易いが如き事態ともなつてゐるのではあるまいか。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、ボートのことに例へて話せば、明々白々のことになつて、まさかＡとてそんなにまで馬鹿でもあるまいと思へるだらうが、事個性的な仕事の志望者達の間では、極めて至当なこととして、「ぢや、てんで漕げない俺はどうしてくれる」が通用することは決して珍しくないのである。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "技術堪能そのものが登用される場合は極めて稀であります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもなければ、田舎の川べりにでも住んで、夏は縁台を出して夕顔の花をみてゐるといふ、あの消極的平安の中に安住しなければならないのです。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが仮りに私の気温のせゐだとしても、何のせゐだとしても、この好い気持はこの好い気持であつて、これを努力して造型してお目に懸けることくらゐは出来るとしても極めて可及的可能なことでしかない。",
              "citation": {
                "source": "深夜の峠にて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際、当時の彼の詩は、青春の感情の奔蹤を極めたものであつた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、此の国の自由詩と称するものは、多くは旧来の形式を完全に脱して居ない、極めて幼稚な口調本位のものであつた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "極めて稀にみる子供らしい純一無垢な性情と、そして何よりも人間としての純潔さを、私共は互に愛し悦びあつた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "この姑の婦人もまた、旧武士の家庭に育った士族の娘で、純日本風の礼儀正しき教育を受け、かつ極めて善良に優しい心根の人であった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたヘルンの生活は、極めて質素のものであった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼の精神生活は、反対に極めてデリケートで贅沢だった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の手の某所に住んでるある華族の老婦人が、非常に極端な西洋嫌いで、何でも舶来のものやハイカラなものは、一切『西洋｜臭い』と言って使用しない。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘルンの妻であった日本女性は、もとより極めて聡明であったと共に、武士道ストイシズムの家庭教育から、非常な意志の力をもって努力した。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の詩の中では、郷土望景詩數篇が最も氣に入つたらしく、口を極めて賞讚してくれた。",
              "citation": {
                "source": "芥川君との交際について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何よりも不可解なのは、一面極めて冷靜なる理智の人でありながら、一面狂氣じみた情熱に内燃してゐる人のやうであつた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして小説家といふ語の典型と、詩人といふ語の典型とは、私の辭書に於ては全く矛盾した、兩立できない反極に屬してゐる。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が、自分の立場としての文學論を進めて行くと、窮極して芥川君は敵の北極圈に立つことになる。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私は、この不愉快極る疑問からのがれることができなかったのである。",
              "citation": {
                "source": "緒方氏を殺した者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、私の作品を、ほめてくれた人の前では極度に矮小になる。",
              "citation": {
                "source": "自作を語る",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "国技館の角力を見物して、まじめくさり、「何事も、芸の極致は同じであります。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことさらに、映画と小説を所謂「極致」に於いて同視せずともよい。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、兄は、それが出来るかも知れない極めて少数のひとの一人だと思います。",
              "citation": {
                "source": "政治家と家庭",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「知性の極というものは、たしかにある。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は君の瞳のなかにフレキシビリティの極致を見たような気がする。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何が、フレキシビリティの極致だ！",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に何の奇もない平凡な木造建築であつて、ホテルと言つてもごく簡便な物であるが、それがどことなく西洋の野菜料理店といつた感じがする。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "10^48",
