[
  {
    "uuid": "ec084051-d7f5-5f3e-ac30-2dba55472dd7",
    "entry": "極",
    "reading": {
      "primary": "ごく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
