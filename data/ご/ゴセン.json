        "動詞-他動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "election by mutual vote",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今回の委員長は、メンバーの互選によって選ばれました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "公平性を保つため、代表者は互選で決めるのが良いでしょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地域の自治会長を互選で選出することになりました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "△互選はせぬ方がいいらしい。",
              "citation": {
                "source": "鎖ペンを握って",
                "author": "――三月十九日夜――　　山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "追加の雪の題が、一つ増しただけ互選のおくれた初夜過ぎに、はじめて約束の酒となった。",
              "citation": {
                "source": "第二菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが自由寮には自治委員会という機関があって、委員には上級生がなっていたが、しかしこの委員は寮生間の互選ではなく、学校当局から指命されており、噂によれば寮生の思想傾向や行動を監視して、いかがわしい寮生を見つけると、学校当局へ報告するいわばスパイの役をしているということであった。",
              "citation": {
                "source": "髪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "思うに運座とか互選とかは、こう大勢ではともすると無意義になるのである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "審議院議員ハ各種ノ勳功者間ノ互選及勅選ニヨル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ニ對シ又ハ世界ニ對シテ勳功アル者ハ、戰爭政治學術發明生産藝術ヲ差別セズ、一律ニ勳位ヲ受ケ、審議院議員ノ互選資格ヲ得、著シク増額セラレタル年金ヲ給付セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ政治ニ干與セザル原則ニヨリテ審議院議員ノ互選資格ヲ除ク。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでは職工の利益になる事項が決議されるわけがない、委員長は全委員の互選できめること。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめ互選の際作者を知らぬ儘に余りあらはなので私がけなしつけた処、後でそれが晶子さんのだと分つて、私の感じは不思議に表裏一転し忽ち之を讃美するやうになつた。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが運座という事に改まって、かつ互選であるという所から、各々多数の点を得るのを興味として、その運座を幾度となく催し、今度は誰れが勝ったとか負けたとかいっていよいよ面白くなり、遂に徹夜をする事にもなるのである。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "私どもは頗るそれをよい方法だと感じたから、その後は伊藤松宇氏が始めた互選法と共に、この状袋廻しの事をも真似する事になった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　相互選択と男性のイニシアチヴ　青年男女はその性の選択によって相互に刺激し合い、創造と淘汰との作用がおのずと行われる。",
              "citation": {
                "source": "学生と生活",
                "author": "――恋愛――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで青年たちは断然相互選択にイニシアチヴをとって「愛人教育」をやる気でなくてはならぬ。",
              "citation": {
                "source": "学生と生活",
                "author": "――恋愛――",
                "note": "青空文庫"
              }
            },
            {
              "text": "庫裡の大廣間で互選の最中、露伴全集を主掌する土橋利彦さんの東道で、思ひがけず幸田文女史も姿を見せた。",
              "citation": {
                "source": "露伴忌",
                "author": "心猿",
                "note": "青空文庫"
              }
            },
            {
              "text": "云うまでもなくこれらの者は上から少しの干渉もされず互選によって選び出されるのであった。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五州の知事というのは、このミズリイ流域は十州にまたがっているので、その十人の知事が互選して、五人を選出したのである。",
              "citation": {
                "source": "コロラド通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙突おっ立てゝ合法的な血ぶくれ●同誌掲載「川柳祭句抄」宿題「雑」互選姉妹つぎつぎに売られ飢餓日本！",
              "citation": {
                "source": "鶴彬全川柳",
                "author": "鶴彬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべ各室で就寝前に行なわれた互選の結果、かれは第五室の室長になっていたのである。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "室長の互選という意見も出たのでそれに落ちつけば一番合理的なはずだったが、それには室長の多数がふしぎに賛成しなかった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、互選も一段落となったところで、お待ちかねのシイタケ飯である。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが判って、官軍方の部将の前に曳き出されて詰問を受けると、太兵衛は何気なく、「どっちも同じ日本人じゃごせんか。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「合点承知之助――だが、親分、野郎にゃ小指がついてたってえじゃごせんか。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "怪談抜地獄",
                "note": "青空文庫"
              }
            },
            {
              "text": "うん、　それはね　ごせんさまの　ところなんだ。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "「せんせえ」「おなごせんせえ」　女の子はみんな走りだした。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「せんせえ」「おなごせんせえ」　声をかぎりにさけぶものもいる。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「せんせえ」「おなごせんせえ」　途中でバスがとまり、女先生をおろすとまた走っていった。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やっぱり、おなご先生じゃア」「おなご　せんせえ」「おなごせんせが　きたどォ」　浜べはもういつのまにか大人までがまじっての大かんげいになった。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすればただいまの老婆もその片われじゃな」「オオ、そこにいる修道士、引っくくってごせんぎなされませ」　といわせもはてず、小谷の方のうるわしい頬へピラピラッと四、五本の針がふき刺さった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……いま、北京府の急使、王定が訴えに聞けば、これを一地方の擾乱とだけでは見過ごせん。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
