    "definitions": [
      {
        "index": 1,
        "gloss": "rumbling (of thunder, one's stomach, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "遠くで雷がゴロゴロ鳴り始め、急に空が暗くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お腹がゴロゴロ鳴って、もうすぐお昼だと知らせている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い木の家なので、風が吹くたびに屋根がゴロゴロと音を立てる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "稜角の端まで這い出して、小さい阜――古代の動物の骨のようにゴロゴロ転がっている石の堆積――の上に立った、石はビッショリと濡れて、草鞋が辷る。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の如く間歇的な情熱に興奮して、三日も四日も不眠不休で書き續けたり、さうかと思ふと一月も二月も遊んでしまひ、何もしないでゴロゴロして居たりする人間には、到底大きな仕事のできる筈がない。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "關羽巡査は眼鏡をかけて、人車は上だからゴロゴロと徐行して居た。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガリガリッ、ゴロゴロゴロゴロ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説を読んでゴロゴロしたり、女の尻ばかり追いまわしたりして、さっぱりダラシが御座んせん。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この猫は鼠を一匹も捕らぬくせに泥棒猫で、近所から嫌われていましたが、「ニャーニャーゴロゴロ」とおべっかを使うのが上手なので、この家の人に可愛がられていました。",
              "citation": {
                "source": "どろぼう猫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして裸体の主人を一心に見つめながら咽喉をゴロゴロ鳴らし、短いしっぽを立てて振動させるのであった。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "路の中には大きな石がゴロゴロしている。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方、白根噴火口ヘ回った連中は、焼石のゴロゴロした中を辿って遂に頂の噴火口の辺へ出たそうである。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "孟子の所謂恒産無き者は恒心無しとでも謂うものか、多少でも財産や田畑のある者は左程でもないようだが、その他の奴等に至っては、どれもこれも、汗水流して少しばかりの金を儲けるよりは、ゴロゴロ寝ていた方が楽だといわぬばかり。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロゴロ昼寝ばかりしていずに、ドシドシ草鞋でも筵でも作って売ったらどうだ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "いなずまがピカピカ光り、かみなりがゴロゴロ鳴りだしました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、のどをゴロゴロ鳴らしながら、顔をまっかにしました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坊やちゃん」は背中をまるくしたり、のどをゴロゴロ鳴らしたりすることができました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコは、のどをゴロゴロ鳴らし、ニワトリは、コッコと鳴きだしました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "のどをゴロゴロ鳴らすことができるかい？",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、さあ、これからは、いっしょうけんめいに、卵を生むとか、のどをゴロゴロ鳴らして、火花でも散らすようにするといいわ！",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "外では、そのあいだも、いなずまがピカピカ光り、かみなりがゴロゴロ鳴っていました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "いなずまは、ひっきりなしにピカピカ光り、かみなりは一晩じゅう、ゴロゴロ鳴りつづけました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の鼻の先には、震災の名残りらしい、赤煉瓦とコンクリートの破片がゴロゴロと積み上げられていた。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局残るところの嫌疑者は、この頃、都の高等女学校から帰省して御座る、お邸のお嬢さん只一人……しかもすこぶるつきのハイカラサンで、大旦那が遠方行きの留守中を幸いに、ゴロゴロ寝てばかり御座る様子がどうも怪しいということになった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その真黒な獣がゴロゴロと咽喉を鳴らすのを聞きながら、その柔かい毛の感触を咽喉や顎のあたりに感じながら、彼は毎晩寝に就いた。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "安子は一日中炬燵にあたって、「出ろと云ったって、誰がこんな寒い日に外へ出てやるものか」　そう云いながらゴロゴロしていたが、やがて節分の夜がくると、明神様の豆まきが見たく、たまりかねてこっそり抜け出した。",
              "citation": {
                "source": "妖婦",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "見るといつの間にかゴロゴロした砂利道へ這入っています。",
              "citation": {
                "source": "所感",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人参畑の婆さんの処にゴロゴロしている書生どもは皆、順繰りに掃除や、飯爨や、買物のお使いに遣られた。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "rolling (of something large and heavy)",
        "register": "standard",
