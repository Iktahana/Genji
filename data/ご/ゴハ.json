[
  {
    "uuid": "5341af6b-2cac-5ffa-8a2e-b30b53d8efc9",
    "entry": "語派",
    "reading": {
      "primary": "ごは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "branch (of a language family)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「英語は、インド・ヨーロッパ語族のゲルマン語派に属している。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「同じ語派の言語間では、文法構造や基礎語彙に共通点が多い。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「歴史比較言語学の授業で、ロマンス語派の分化について学んだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "其一を固有派又主事派又物語派と名づけ、次を折衷派又性情派又人情派と名づけ、末なるを人間派と名づく。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、おそい朝ごはんを、気まずい思いで食べた。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし相対原理が一般化されて重力に関する学者の考えが一変しても、りんごはやはり下へ落ち、彼岸の中日には太陽が春分点に来る。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝ごはんを食べて、家のちかくの井之頭公園へ散歩に出かけ、行く途々も、議論であります。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、朝ごはんまへに、校正のはうを片附けてしまふつもりで、机にむかつたら、ひよつこり母がたづねて來た。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "母がかへつて、私は校正にとりかかり、ひるごろまでに濟まして、晩い朝ごはんをたべ、それから、〆切のせまつてゐる小説を少しづつ書きつづけ、そのうちに、しきりと侘びしくなつて來た。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ごはうびのつもりかも知れない。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんが、ちびちび晩酌をやつてゐる傍で、默つてごはんを食べてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と阿波聖人は、ごはんをすまして、お膳に向ひうやうやしく一禮して立つ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そろそろ、私もごはんにしよう。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お婆さんにお給仕されてごはんを食べながら、お爺さんは、昨夜の不思議な出來事を知らせてやりたくて仕樣が無い。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつむいて、わびしくごはんを食べてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕暮になって、一行が水神の八百松へ晩餐をとりに入ろうとすると、みち子は、柚木をじろりと眺めて「あたし、和食のごはんたくさん、一人で家に帰る」と云い出した。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ夕ごはんをたべないで待ってゐるお母さんのことが胸いっぱいに思ひだされたのです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おんちゃんごはんおあがんなさいって」「おはんなさいははははは」　父は両手を回し、大きな背にまたふたりをおんぶして立った。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "オスワルドはこはごは惜しげにその肉を見送つた。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、私は心の中にこはごは呟いた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　私はこはごはながら頷いた。",
              "citation": {
                "source": "阿片の味",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「……」「ごはんをお上り――はどういうんぞいや？",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごはんと云いなされ！",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　しかし、おしかはどうしてもごはんという言葉が出ず、すぐ田舎で使い馴れた言葉が口に上ってきた。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チュンセがさっぱりごはんもたべないで毎日考えてばかりいるのです。",
              "citation": {
                "source": "手紙　四",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ夕ごはんをたべないで待っているお母さんのことが胸いっぱいに思いだされたのです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごはんの知らせが来ても、私は、からだ工合が悪いから、きょうは起きない、とぶっきらぼうに言い、その日は局でも一ばんいそがしかったようで、最も優秀な働き手の私に寝込まれて実にみんな困った様子でしたが、私は終日うつらうつら眠っていました。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその人から晩ごはんのごちそうになるのはどうにも苦痛だったので、お昼ちょっと過ぎ、町はずれの彼の私宅にあやまりに行った。",
              "citation": {
                "source": "やんぬる哉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日ごはん食べずに平気、そのかわり、あの、握りの部分にトカゲの顔を飾りつけたる八円のステッキ買いたい。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごはんも、要らない。",
              "citation": {
                "source": "八十八夜",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三兄は、決してそのお仲間に加わらず、知らんふりして自分の席に坐って、凝ったグラスに葡萄酒をひとりで注いで颯っと呑みほし、それから大急ぎでごはんをすまして、ごゆっくり、と真面目にお辞儀して、もう掻き消すように、いなくなってしまいます。",
              "citation": {
                "source": "兄たち",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）家内は、朝ごはんの後片附がすむと、湯道具持って、毎日そこへ通った。",
              "citation": {
                "source": "美少女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕ごはんの時、父は、「岩見さんが、あんなに誠意を以て言って下さっているのだし、こちらでも失礼にならないように、私が和子を連れて行って、よく和子の気持も説明して、おわびして来なければならないと思う。",
              "citation": {
                "source": "千代女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
