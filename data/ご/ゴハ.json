  {
    "uuid": "00176ce0-0851-5df6-958b-087b9197adb6",
    "entry": "ゴハ",
    "reading": {
      "primary": "ごは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カゴハ、「ヨイシヨ　ヨイシヨ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴハ　ドンドン　ハシリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　コハゴハ、ホンヲ　トウサンニ　ワタシマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "上着には何處にも血痕は附着してゐなかつたが軈てズボンを脱ぐと猿股の膝の部分が鮮血でゴハ／＼になつてゐた。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "何分二十名位の客が急に泊まるのですから、宿では村の娘さんたちを召集して給仕させるのですが、血気盛んな若者揃いですから、村の娘も「おいゴハン」あちら、こちらから大声で呼ばれ、眼をまわすほどの忙しい目にあったものでした。",
              "citation": {
                "source": "明治懐顧",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "隆治さんから十九日に電報が来て、　イロイロノゴハイリヨアリガタクウケマシタゲンキニシユツパツ　とありそれを見たら涙が浮びました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒は一滴も飲まぬが、煙草は好物で、配給のキザミや金鵄ぐらゐで事足りるわけはないから、ひとから聞いたイタドリやフキの葉を乾かして吸ひ、山をうろつきながら、さまざまな雑草の葉を自分でためしてみては、最後に、ゴハといはれる茎の短い、大きな葉がカヘデのやうに五つに割れたヒダのある草を常用にした。",
              "citation": {
                "source": "秋の雲",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサゴハンデモタベルトシヨウ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲタベテ、晩ゴハンヲタイテオイテネ。",
              "citation": {
                "source": "母子ホームの子供たち",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、先日、街で三人の知りあいのパンパン嬢にあい、ゴハンたべさして、と云うので、食堂へ行く。",
              "citation": {
                "source": "無毛談",
                "author": "――横山泰三にさゝぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミソ汁と卵とリンゴ、ゴハンは朝はたべない。",
              "citation": {
                "source": "本因坊・呉清源十番碁観戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから姐御は悲劇的だ）そのうち毎日八百円貯金して二百円で二度ゴハンをたべる。",
              "citation": {
                "source": "パンパンガール",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝のゴハンはお客にたべさせてもらひ、お客と別れてきて、お風呂へ行つて、二時頃からタマリの喫茶店へブラリと現れる。",
              "citation": {
                "source": "パンパンガール",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オタツ自身もカツレツを食べる気持がないが、シシド君にはカツはおろかゴハンを食べさせる気持がないのである。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "持参の卵とリンゴとミソ汁だけで食事をすまし、朝だけはゴハンはたべない。",
              "citation": {
                "source": "呉清源",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうちょッと食べるゴハンが残っていたからである。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "神様は寝床に腹ばいになって、ゴハンをたべているのである。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがゴハンのオカズであった。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間ほど、ブラついて、ゴハンをたべて、それからズッと、つききっていることが大切なんだ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前の着物もぬってくれるし、お前が木挽の仕事につかれて帰ってくると、ちゃんとゴハンの支度ができていて、つかれた肩をもんでくれるなア。",
