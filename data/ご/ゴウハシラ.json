        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三十九年八月　　立秋憂愁のこれや野の国、柑子だつ灰色のすゑ夕汽車の遠音もしづみ、信号柱のちさき燈淡々とみどりにうるむ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの野辺よ、信号柱は断頭の台とかがやき、わか葉洩る入日を浴びてあかあかと遙に笑ひき。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二町許りも構内の木柵に添うて行くと、信号柱の下で踏切になる。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のすぐ横には白ペンキ塗の信号柱が、白地に黒線の這入った横木を傾けて、下り列車が近付いている事を暗示していたが、しかし人影らしいものはどこにも見当らなかった。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして最後には、信号柱の尖へ行って、オペラバッグを齧り始めた。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二町許りも構内の木柵に添うて行くと、信號柱の下で踏切になる。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
