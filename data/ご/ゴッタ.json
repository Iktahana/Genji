[
  {
    "uuid": "bab846fd-0c2b-51e7-9432-b727e4c77b47",
    "entry": "ごった",
    "reading": {
      "primary": "ごった",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "confusion",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "連休初日の駅構内は、大きな荷物を持った帰省客でごったな状態だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「新しい情報が入りすぎて、頭の中がごったで整理がつかないよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "秋祭りの会場は、並ぶ屋台と押し寄せる人でごったな賑わいを見せていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "無茶なことを云われて民子は心配やら嬉しいやら、嬉しいやら心配やら、心配と嬉しいとが胸の中で、ごったになって争うたけれど、とうとう嬉しい方が勝を占めて終った。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の中は、ゴミ箱をごったかえすように、掻きまわされた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場は、持てるだけ荷物をかゝえこんだ青島への避難者でごった返した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベッドもなく、藁蒲団もなく、床の上に毛布をのばして、ごった寝にねた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごったかえしたあとを掃除して、寝についた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "通訳は、小屋のかげから、悲鳴や叫喚や、銃声がごったかえしに入りまじって聞えて来る方をおずおず見やった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国、仏蘭西、独逸とずいぶんながいごったごたした旅行を続けておしまいにウィーンへやって来る。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いゝえ、まるでちらばってますよ、それに研究室兼用ですからね、あっちの隅には顕微鏡こっちにはロンドンタイムス、大理石のシィザアがころがったりまるっきりごったごたです。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいえ、まるでちらばってますよ、それに研究室兼用ですからね、あっちの隅には顕微鏡こっちにはロンドンタイムス、大理石のシィザアがころがったりまるっきりごったごたです。",
              "citation": {
                "source": "土神ときつね",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち何だかわたくしどもの影が前の方へ落ちているようなので、うしろを振り向いて見ますと、おお、はるかなモリーオの市のぼぉっとにごった灯照りのなかから、十六日の青い月が奇体に平べったくなって半分のぞいているのです。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅籠の表は黒山の人だかりで、内の廊下もごった返す。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったくたいへんな人で、ごったがえすような、ありさまだったよ。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それでは、わしは、神さまをもせいふくしよう」　こう言うと、心のおごった、ばかな王さまは、空を飛んでいくことのできる、一そうの船を作らせました。",
              "citation": {
                "source": "わるい王さま（伝説）",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二箇月間、故王のお葬いやら、わしが位を継いだお祝いやら、また婚儀やらで、城中は、ごったがえしの大騒ぎでした。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五年ほど前の夏には避暑客でごったかえしていた片貝の銀座も、いまは電燈一つ灯っていない。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごったがえしの、天地震動の大騒ぎ。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただのときは水につかることのない、川べりのすすきや、萩の株が、黄いろくにごった水に横だおしになって、もまれています。",
              "citation": {
                "source": "ごん狐",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの魚も、「とぼん」と音を立てながら、にごった水の中へもぐりこみました。",
              "citation": {
                "source": "ごん狐",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっ四角な深い池で、底の方に緑色のにごった水がよどんでいた。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "其損得に掛けて武士道――忠義をごったにし、それはそれ、これはこれと、全く別の事を一ツにして、貴殿の思わくに従えとか。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "組織は、ふたたび収拾し能わぬほどの大混乱、火事よりも雷よりも、くらべものにならぬほどの一種｜凄烈のごったがえし。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おりというのは、お酒をつくるとき、たるのそこにたまる、乳色のにごったものであります。",
              "citation": {
                "source": "和太郎さんと牛",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのごったがえしの群々の中には、そこにもここにも、全身にやけどをした人や、重病者が、横だおしになってうなっている。",
              "citation": {
                "source": "大震火災記",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔を黒く隈どった赤鉢巻の青年達で、市中はごった返している。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　たちまち船の上はごった返しの騒ぎとなった。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんじゃ、長作せえいいごったら、取り換えでくんつえ。",
              "citation": {
                "source": "山茶花",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ほんとに、この野郎まで、なんとしたごったやなあ！",
              "citation": {
                "source": "蜜柑",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「美代姉は、厭んだって言ったの、父、行がねえごったら、首さ、縄つけでも連せで行ぐどて。",
              "citation": {
                "source": "蜜柑",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ほだって俺、洋服着たり、靴穿いだりして、お笑止ごったちゃ。",
              "citation": {
                "source": "土竜",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
