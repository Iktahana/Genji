  {
    "uuid": "39778567-7329-565c-a82a-8c33160217e1",
    "entry": "ゴトゴトゴト",
    "reading": {
      "primary": "ごとごとごと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "玩具のような、小さな、薄汚ない、ゴトゴトゴトゴトピイの二三輛の聯結列車である。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "シューゥ、ゴトゴトゴトゴト。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思う間もなく、ガーンと厚い鉄板を一つ叩きつけたような音がして、それに引続き遠くの彼方へ地震が動いてゆくようなとでも云うより外に云いあらわし方のない気持の悪い振動が、ゴトゴトゴトと向うの方へ遠のいていった。",
              "citation": {
                "source": "キド効果",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬が隠れ、頬かむりの百姓が見えなくなり、天も地もすべて灰色で、鈍い退屈な荷馬車のゴトゴトゴトゴトという音だけがきこえてきた。",
              "citation": {
                "source": "冬枯れ",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴトゴトゴト、という、ウインチの音とともに、金五郎の乗った大籠は、空間に浮いた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何だか、ゴトゴトゴトゴト、長い間やかましい物音がしていました。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
