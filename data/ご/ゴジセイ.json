    },
    "definitions": [
      {
        "index": 1,
        "gloss": "the times",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "最近のご時世では、情報セキュリティの意識が非常に重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「このご時世に、そんなことを言うのは時代遅れだよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ご時世の変化に合わせて、ビジネスモデルも柔軟に変える必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この不景気なご時世、私は未亡人ですし、息子は海軍でお金がかかります。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のご時世、なかなかそううまくはいかないものです。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "……だがねえ親方、こんなご時世に、金なんか持っていたって仕方ありませんね」「何故よ」「脱走武士なんかがやって来て、軍用金だといって、引攫って行ってしまうじゃアありませんか。",
              "citation": {
                "source": "甲州鎮撫隊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……まあ、これもご時世とあればああいうものの跋扈するのも、仕方ないとは云われましょうがな。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く変なご時世でござる。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『よにあうは、道楽者に驕り者、転び芸者に山師運上』『世の中は、諸事ごもっともありがたい、ご前、ご機嫌、さて恐れ入る』『世の中は、ご無事、ご堅固、致し候、つくばいように拙者その元』『世にあおう、武芸学門、ご番衆、ただ奉公に律義なる人』……アッハッハッ、変なご時世で。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがこいつもご時世のためだ。",
              "citation": {
                "source": "銅銭会事変",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "乱脈なこんなご時世だから、考えようによっては住みよいともいえる。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "申すも畏き極みながら、以上に述べたように、ご時世とあってみれば、幕末の頃においては一天万乗の大君にましましても、あらゆるご不自由に堪え、ご質素を忍ばれたのである。",
              "citation": {
                "source": "にらみ鯛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それというのは、ご時世で物の値が一帯に高くなり酒ばかり飲んでいたのでは生活向きが立たなくなるという考えが、飲み放題のお正月へも影響してお互いに控えましょう、となった結果であると思う。",
              "citation": {
                "source": "酒渇記",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ米でありさえすればあり難がるご時世ではあるが、しかし以前でも、米の味に詳しいというひとは少なかった。",
              "citation": {
                "source": "お米の話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "神官が近ごろ急に弱まって来たことに氏子たちは気づいたが、多分ご時世のせいだろうと思った。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "「拙者数日前備前屋の店頭で、長船の新刀をもとめましたが、泰平のご時世試し斬りも出来ず、その切れ味いまに不明、ちと心外でございますよ」　と、川上｜嘉次郎という武士が云って、酔った眼であたりを見廻した。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなテンヤワンヤのご時世が見えねえ訳でもあるめえに。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご時世が変るだの何だのと方々でワイワイ騒いでこそいるが、どうせどっちに転んだとて所詮が、二本差した奴か物持ちの奴等の話だ。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来なれば利根を渡って縄張り違えなこの辺の百姓一揆なんどに引張出されるのは少し筋の違った話だが、水戸の天狗があばれ出すのなんのと噂のあるご時世だ、八州様お声がかりとあって、代官お手代役浜野様のいいつけで弥造の方から話がありゃ、まさかに懐手して佐貫の方から眺めてもおれねえ。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "へへ、真直ぐも曲ったもねえ、どうせこのご時世でさあ。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その辺の具合は俺達にゃよくわからねえが、とにかくお前のいうように、俺達下々の者が安心して家業をはげめるご時世が来さえすればよいには違いないけれど、だからというて、そう一がいには行かぬものよ。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『今のご時世じゃ、そういうことが起らずにはいませんさ。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "野球の選手でさえ、何らかの規制が、問題になっているご時世だ。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなご時世に切れたら大事だ。",
              "citation": {
                "source": "バブル崩壊",
                "author": "A BUBBLE BURST",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
