        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゴスイズ〔国立図書出版所の略〕で、ブハーリンの唯物史観を買う。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "名を知らぬ画家、ゴスイズダートの人、民謡をうたう人、ブラウデの講演会のときピアノを弾いた人、その他、十二時すぎまで居て、随分愉快であった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴスイズダート、頭の男のひと、要領よくて、いろいろ本を紹介してくれた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月三日（月曜）　ゴスイズダート行、本を貰い、買う。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴスイズダートが、どうして今の夫と結婚したか――今の夫をつかまえたかということについて話して居た。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙが入って来る、ゴスイズダートが――さ、行こうと云った。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○Ｙと二人出かけて、ゴスイズダート〔国立図書出版所〕で本を買う。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴスイズダートで本を買った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "並木道の左右に売店が並び、各々が意匠した店名を、「アガニョーク」「ゴスイズダート」青葉の下にかかげている。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
