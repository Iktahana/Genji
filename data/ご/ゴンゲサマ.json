        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一一〇　ゴンゲサマというは、神楽舞の組ごとに一つずつ備われる木彫の像にして、獅子頭とよく似て少しく異なれり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "新張の八幡社の神楽組のゴンゲサマと、土淵村字｜五日市の神楽組のゴンゲサマと、かつて途中にて争いをなせしことあり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "新張のゴンゲサマ負けて片耳を失いたりとて今もなし。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンゲサマの霊験はことに火伏にあり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "子どもの頭を病む者など、よくゴンゲサマを頼み、その病を噛みてもらうことあり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
