        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "遠くで鐘がごんごんと鳴り響いています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "扉がごんごんと激しく叩かれました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「危ない！」と叫んだ瞬間、何かがごんごんとぶつかる音がしました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ごんごん胡麻は老婆の蓬髪のようになってしまい、霜に美しく灼けた桜の最後の葉がなくなり、欅が風にかさかさ身を震わすごとに隠れていた風景の部分が現われて来た。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それはきっと、ごんごん鳴るので、はじめに誰かがごんごん鐘といったのさ。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごんごん鐘ごんごん鐘といっているうちに、誰かが言いちがえてごんごろ鐘といっちまったんだ。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとごんごろ鐘の方がごんごん鐘よりごろがいいので、とうとうごんごろ鐘になったのさ。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きのう、お別れだといって、あげん子供たちが、ごんごん鳴らしたが、わからなかっただかね。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その気のついでに、……何となく、そこいら屋敷町の垣根を探して（ごんごんごま）が見たかったのである。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "スズメノエンドウ、スズメウリ、スズメノヒエ、姫百合、姫萩、姫紫苑、姫菊の※たけた称に対して、スズメの名のつく一列の雑草の中に、このごんごんごまを、私はひそかに「スズメの蝋燭」と称して、内々｜贔屓でいる。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "分けて、盂蘭盆のその月は、墓詣の田舎道、寺つづきの草垣に、線香を片手に、このスズメの蝋燭、ごんごんごまを摘んだ思出の可懐さがある。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、何処でも、あの、珊瑚を木乃伊にしたような、ごんごんごまは見当らなかった。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ははあ、ごんごんごま、……お薬用か、何か禁厭にでもなりますので？",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あすこは、いくらでも、ごんごんごまがございますでな。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "卯の毛で胡粉を刷いたような女の膚の、どこか、頤の下あたりに、黒いあざはなかったか、うつむいた島田髷の影のように――　おかしな事は、その時｜摘んで来たごんごんごまは、いつどうしたか定かには覚えないのに、秋雨の草に生えて、塀を伝っていたのである。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでもなん千年というむかし、甲斐と駿河の境さ、大山荒れがはじまったが、ごんごんごうごう暗やみの奥で鳴りだしたそうでござります。",
              "citation": {
                "source": "河口湖",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "開拓使庁の棟に一きわ高くつき出た鐘楼で、がんがんと鐘が鳴るのだ、響きは、やがて、名実ともに都府となるのであろうこのきり拓かれた一廓から、ひろい原野へ――イシカリ川の灌漑する涯しのない平原へ、さえぎるものも無くごんごんと拡がって行くように思われた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごんごんごんと音がして、ガス弾は白いあとをひいて、砲門をはなれていく。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵のすがたを見たらばと、かねて合図してあったか、鐘楼からはごんごんと鐘が鳴った。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "千年杉一　朝である、七宝寺の山で、ごんごんと鐘が鳴りぬいた、何日もの刻の鐘ではない、約束の三日目だ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "時刻でもないのに、突然、鐘楼の鐘がごんごん鳴った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "凱旋の彼を迎える祝いの鐘が、戦勝祈願の達成を告げる勤行のそれか、上の転法輪寺の鐘がごんごんと鳴っている。",
              "citation": {
                "source": "私本太平記",
                "author": "新田帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "山門の大鐘も全山の衆徒へ、ごんごんと告げ鳴らしている。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "電信柱どもはブンブンゴンゴンと鳴り、風はひゅうひゅうとやりました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそんなもんには一切係わらず、オレ様の貧困に後ろ足で砂をかけて、時代はゴンゴン変わってしまうのだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ゴンゴンといふ者には、その不思議が出來た。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンゴンは、とある横町に一軒のサアカス小屋をみつけたのである。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ゴンゴンはその小屋へはいつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、それを見るや、ゴンゴンはふきだしてしまつたのである。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂ――　或る日、ゴンゴンはひとりの神さまに出會つた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ふだんから不思議に思つてゐたから、と尋ねると、神さまはそれには答へないで、そのかはりにゴンゴンの目の前で雲を作つてみせて下さつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｃ――　ゴンゴンが、町を歩いてゐたら、白い雲が、頭のうへを飛んで行つた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、ゴンゴンの服裝のことをまだ一言も言つてゐなかつた。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
