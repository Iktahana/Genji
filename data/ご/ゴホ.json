[
  {
    "uuid": "712a6459-0086-548d-afd4-962c6cb04139",
    "entry": "ゴホ",
    "reading": {
      "primary": "ごほ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
