        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "種則はユスリだと云い、院長は美代子なんてパンパンじゃないか、というゴセンタクですよ。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説は十九世紀で終りになつたゾヨ、これは璽光様の文学的ゴセンタクといふものだ。",
              "citation": {
                "source": "教祖の文学",
                "author": "――小林秀雄論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "万端最上清人の命令でなく、倉田支配人の指図によつて、これより万事店のことは新任の支配人が執り行ふから旧来の仕来りは一新する、店内の作法は支配人の許可なくして何事も行ふことはできない、天妙大神のゴセンタクも支配人にはミミズのタハゴトにすぎないのだから、と申渡す。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがつい先日のことだが、人見角造と云って平作の長女のムコで三百代言をしている奴が訪ねてきての話によると、どうやら近ごろは平作のこの心境までぐらついてきたらしいぞ」　天心堂は荒ぶる神がゴセンタクをくだすようにカッと目をむいて語りつづける。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり教祖的でありすぎるからゴセンタクをそっくり信用する勇気がくずれるのだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "教祖のゴセンタクがどうあろうとも、牛肉自体は料理の素材ではあるが、料理そのものではない。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、教祖のゴセンタクほど神秘的ではないが、うまいことは確かである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本犬は絶望よ、見るだけでゾッとするわ」　という、これはまた念入りのゴセンタクであった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説は十九世紀で終りになったゾヨ、これは璽光様の文学的ゴセンタクというものだ。",
              "citation": {
                "source": "教祖の文学",
                "author": "――小林秀雄論――",
                "note": "青空文庫"
              }
            }
          ]
        }
