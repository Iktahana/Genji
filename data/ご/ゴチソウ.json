        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "テーブルにはお正月らしい豪華なご馳走が所狭しと並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「わあ、今日のご馳走は何？」と子供がキッチンを覗き込んできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "山海の珍味が揃ったご馳走を前に、思わず笑みがこぼれてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
