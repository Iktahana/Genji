[
  {
    "uuid": "096e913b-cc9a-50fb-8ad9-df61b4f4707a",
    "entry": "ご馳走",
    "reading": {
      "primary": "ごちそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
