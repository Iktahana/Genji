    "definitions": [
      {
        "index": 1,
        "gloss": "treat (esp. food and drink)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「たまには贅沢にご馳走を食べに行こう」と妻を誘って外出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "父の還暦祝いに、家族全員でフレンチのフルコースをご馳走した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お世話になった先生に最高のご馳走でもてなすため、料亭を予約した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「ご馳走を持って来てやったのよ。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ばか、そんなにしないだって、ご馳走あげるわよ」　柚木の額の汗を掌でしゅっと払い捨ててやり「こっちにあるから、いらっしゃいよ。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（はっは、なあに、こごらのご馳走てばこったなもんでは。",
              "citation": {
                "source": "十六日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうにいろいろご馳走になって、これはほんの少しですが。",
              "citation": {
                "source": "十六日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "轡頭を取って立ちはだかり、（嬢様そんならこのままで私参りやする、はい、ご坊様にたくさんご馳走して上げなされ。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "栗だのきのこだの、うんとご馳走したぞ。",
              "citation": {
                "source": "狼森と笊森、盗森",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このうちは料理店だけれどもただでご馳走するんだぜ。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとでご馳走に呼んでやらう。",
              "citation": {
                "source": "月夜のけだもの",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご馳走なんてとんでもありません。",
              "citation": {
                "source": "月夜のけだもの",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "棺のこっちにこの椅子をおいて……これをここに、おい青島……それをそっちにやってくれ……おいみんな手伝えな……一時間の後には俺たちはしこたまご馳走が食える身分になるんだ。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがほんとのご馳走だ、といってね。",
              "citation": {
                "source": "餅",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にその日はわたくしはまだ俸給の残りを半分以上もっていましたし、もしお金を払わなければならないとしてもファゼーロとミーロにご馳走するぐらい大丈夫だと考えたのです。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどその頃平右衛門の家ではもう酒盛りが済みましたので、お客様はみんなでご馳走の残りを藁のつとに入れて、ぶらりぶらりと提げながら、三人ずつぶっつかったり、四人ずつぶっつかり合ったりして、門の処まで出て参りました。",
              "citation": {
                "source": "とっこべとら子",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この野郎、ひとの家でご馳走になったのも忘れてづうづうしい野郎だ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎のおとうさまももう帰っていて、その晩は様々のご馳走がありました。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺す前にキーキー叫ぶのは、それは引っぱられたり、たたかれたりするからだ、その証拠には、殺すつもりでなしに、何か鶏卵の三十も少し遠くの方でご馳走をするつもりで、豚の足に縄をつけて、ひっぱって見るがいいやっぱり豚はキーキー云う。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このうちは料理店だけれどもたゞでご馳走するんだぜ。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人は私に夕飯をご馳走するのを忘れていたのだ。",
              "citation": {
                "source": "天衣無縫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、信吉は、なかなかご馳走だとほめるのだった。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、ご馳走のたくさん並んでいる食卓について、一｜皿ごとに銀の紙で口もとをふきたいものだと望んでいたのでしょうか。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが、ご馳走の全部だったのです。",
              "citation": {
                "source": "眠りの精",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "君よ　なぜ早く籠をひらいて鷄肉の　腸詰の　砂糖煮の　乾酪のご馳走をくれないのかぼくは飢ゑぼくの情慾は身をもだえる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ご馳走さまでした。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "規矩男は一つをかの女に与え、自分も一つを飲みながら、「今日は母が居ないからご馳走がないな。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だけどご馳走攻めされなくて煩わしくないでしょう」　でもそう云われればかの女は、それが規矩男の母の美点だとさえ思えて来るのである。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸妓は果して「あら、ご馳走さま、妬けますわ」と燥いでいった。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ごちそうさまでござりました。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは、陸上のどんなごちそうよりもおいしいですよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのお家の庭先に私が時々あそびに行つて、さうして、おいしいやはらかな豆なんかごちそうになつたのを、あなただつて知つてたぢやないの。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央アジアの旅行中シナの大官からごちそうになったある西洋人の紀行中の記事に、数十種を算する献立のどれもこれもみんな一様な黴のにおいで統括されていた、といったようなことを書いている。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
