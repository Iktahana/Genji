        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "是に於て孤憤、五蠧、説難諸篇すべて五十餘篇を著はす。",
              "citation": {
                "source": "韓非子解題",
                "author": "小柳司気太",
                "note": "青空文庫"
              }
            },
            {
              "text": "又韓非子の説難は、文學上不朽の文章にして、其の人情を穿ちたる點に於ても極めて犀利なる者なるが、此粉本は、既に荀子非相第五に出づ。",
              "citation": {
                "source": "韓非子解題",
                "author": "小柳司気太",
                "note": "青空文庫"
              }
            },
            {
              "text": "廉直の・（五三）邪枉の臣に容れられざるを悲み、（五四）往者得失の變を觀る、故に（五五）孤憤・五｜蠧・内外儲・説林・説難、十｜餘萬言を作る。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども韓非は説の難きを知り、説難の書を爲ること甚だ具はれるも、終に秦に死し、自ら脱るること能はざりき。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（五六）説難に曰く、『凡そ説の難きは、吾が知の以て説くこと有るの難きに非ざる也。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            },
            {
              "text": "余、獨、韓子の・説難を爲り而も自ら（禍ヲ）脱るること能はざりしを悲しむ耳。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            },
            {
              "text": "【五五】孤憤・五蠧・内外儲・説林・説難。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            },
            {
              "text": "【五六】韓非子説難の篇を參照せよ。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            },
            {
              "text": "余獨悲韓子爲説難而不能自脱耳。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
