          "literary": [
            {
              "text": "學校トシテハ簡單ナル事務ニシテ、若シ兒童ノ家庭ノ惡感化ニヨリテ食事ヲ肯ンゼザル者アラバ教師ノ權威ヲ以テ其ノ保護者ヲ召喚訓責スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ過般ノ暴動ト米國市中ノ黒白人爭鬪トヲ比較スルトキ其ノ恥辱ノ程度ニ於テ日本ハ幾百倍ヲ感ゼザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ本国いぎりすノ国家ノ強ヒル宗教ヲ信ズルコトヲ肯ンゼザルナリ、制度ハ国ノ制度ヲ遵奉セザル可カラズトイヘドモ、信仰ハ自由也、国家ヨリ賦課セラルベキモノニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "王（将軍のこと）マコト嗣ヲ欲セバ、ナンゾ殺生ヲ禁ゼザル。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "王（将軍）マコト嗣ヲ得ント欲セバ、ナンゾ殺生ヲ禁ゼザル。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
