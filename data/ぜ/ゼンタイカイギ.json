        "examples": {
          "standard": [
            {
              "text": "月末には、全社員が参加する全体会議が開催される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しい経営戦略について、全体会議で活発な議論が交わされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は全体会議で、プロジェクトの成果を力説した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一九四九年九月二十一日から十日間、北京で開催された人民政治協商会議第一回全体会議の第一日に行われたあなたの演説が、日本で読まれています。",
              "citation": {
                "source": "宋慶齢への手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は明日、司令部で司令官を議長とする全体会議があって、高官が全員出席の上で開かれます。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "六人は全国の各地方から集まった者共で、日本本土に潜伏する間諜団の全体会議ともいうべきものであることが推察された。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
