[
  {
    "uuid": "dcb249fa-f540-5380-8aeb-4f82d5275c66",
    "entry": "銭",
    "reading": {
      "primary": "ぜぜ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
