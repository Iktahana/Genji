        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナポレオンはウーゴモンに対して弟のゼロームをつかわした。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "左下の端はウーゴモンで、そこにゼローム・ボナパルトとともにレイユがいる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖ゼロームが心を向けていたのは、疑いもなくこの賤民へであった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伊東ゼローム殿です」　生徒たちは、自分らの中のひとりへ、方々から眼をそそいだ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれにおります、ゼロームでありました」　宣教師が、指さすと、その少年は真っ赤になって俯向いた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長は、覚えのあるようなないような気がして、「ゼロームとは、誰か。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゼローム、起立して、君主さまに、お答えしなさい」　その生徒は起った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっき提琴を弾いていた伊東ゼローム以下、生徒たちは、校庭に整列していた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
