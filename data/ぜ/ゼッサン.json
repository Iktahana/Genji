        "examples": {
          "standard": [
            {
              "text": "この小説は文学界で絶賛され、新人賞を受賞した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "海外のメディアでも、そのパフォーマンスは絶賛を浴びた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の作品は絶賛されたにもかかわらず、本人は謙虚な姿勢を崩さなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
