    "definitions": [
      {
        "index": 1,
        "gloss": "high praise",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の新作映画は、批評家から絶賛された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の料理は、訪れた客全員から絶賛の嵐だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "監督は、主演俳優の演技を惜しみなく絶賛した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "兄の知らせを受け取ったのが今朝で、あなたのことは大絶賛でしたよ。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスのある有名な詩人がこの御会式の大群衆を見て絶賛した。",
              "citation": {
                "source": "学生と先哲",
                "author": "――予言僧日蓮――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は黒部渓谷、九谷の奥、金沢のごりやなどでしばしば試みているが、星がれいに匹敵して、しかも格別という態の風味をもっていて、絶賛に価する。",
              "citation": {
                "source": "洗いづくりの美味さ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　人により、鮎の高い香気と清涼な風趣を絶賛し、一方には山女魚の濃脂と、焼き上げた肉の軽泊とに心酔している人があるが、それは人々の好みによることであるから、いずれの味品がよいか俄に断じきれない。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の気の毒な病気に対して、彼女の異邦人たる地位に対して、彼女の羞恥と遠慮とに対してイエスの愛と憐憫とはあふれ出て、「息女よ」という温かい呼びかけとともに、彼女の信仰に対する絶賛と豊かな祝福とを賜わったのです。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラウニングはベニスでの生活がなければ、絶賛されませんでした。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、封筒の出来ばえを絶賛している人がいるということも、つけ加えておこう」「ぜひともそうしてくれ」　彼はにこにこと笑ってそう言い、大きな体を椅子に降ろした。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこのパンを僕は絶賛するものである。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日読売夕刊の浜村米蔵は「兵隊」を絶賛し、「ロッパ万歳、日本の喜劇の前途に栄光あれ！",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "田村は「歌ふ弥次喜多」絶賛で、前篇よりづっと面白いと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "（安積艮斎の厩戸論）　今日では厩戸皇子を、聖徳太子として、絶賛する人が多いけれども、それは、事実に即した公正な論とは言えないであろう。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は浙江省の紹興に生れ、あの辺は東洋のヴェニスと呼ばれて、近くには有名な西湖もあり、外国の人がたいへん多くやって来て、口々に絶讃するのですが、僕たちから見ると、あの風景には、生活の粉飾が多すぎて感心しません。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、そこに、犯人の絶讃的な技巧があったのだよ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お重には絶讃ものの甘豆あり、うちの白い鶏の生んだ卵が半分に切ってあり、黄色鮮かなり。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キンギン国の大統領は、彼アルゴン大尉を招き、その成功を絶讃すると共に一躍大将に昇任させた。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが大評判でして、それから約半歳、日本全国で独唱会をいたしましたが、いたるところで絶讃されました。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "川口一郎は、この力篇を昭和七年「劇作」誌上に発表したが、翌八年、築地座（飛行館の舞台に拠る）に上演され、一部好劇家の絶讃を浴びた。",
              "citation": {
                "source": "二つの戯曲時代",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つ「東は東」などは、発表当時正宗白鳥から絶讃を浴びた。",
              "citation": {
                "source": "岩田豊雄と私",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「樹々の一家」の如きは、レミ・ド・グルモンも絶讃したやうに、至純至高の精神のみがよく描き得る「自然」の心理風景であらう。",
              "citation": {
                "source": "「博物誌」の序に代へて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして中河こそは不世出の一塁手で、生れながらのプロ野球人だなどと絶讃しているのである。",
              "citation": {
                "source": "戦後新人論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、大藩の当主としては陰鬱で風采の上らぬ宗久であったが、その学識は彼を知る者の絶讃せざるなき有様で、学問は名も金もいらぬ者にしてはじめて深く正しかるべし。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "孔子自身としても、伯夷・叔斉を絶讃しているのだから（參照一六一章）矛盾なしとはいえない。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中、富士見高原の蕎麥を絶讃したい。",
              "citation": {
                "source": "食指談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この鮮醤の持つ舌への感覚は魔味と称して絶讃するほかに言葉がないであろう。",
              "citation": {
                "source": "魔味洗心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、東京に大規模な上水道が完成して以来、多摩川の水質は亡びてしまい、鮎の質も変わったのであるが、それを知らないで、今でも多摩川の鮎を、絶讃している東京人がある。",
              "citation": {
                "source": "魔味洗心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に淡紅の色鮮やかに、牡丹の花弁をならべたような鱗の艶は、友人に贈っていつも絶讃を博すのだ。",
              "citation": {
                "source": "縁談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹に片子を持つと腸の渋味に、濃淡の趣を添えて、味聖の絶讃を買う。",
              "citation": {
                "source": "香魚と水質",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　常陸国の久慈川の鮎は、質の立派な点に味聖の絶讃を博している。",
              "citation": {
                "source": "香魚の讃",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、絶讃をおくることができよう。",
              "citation": {
                "source": "すっぽん",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に、膾の醤油に姫柚子の一滴を加えれば、その酸味に絶讃の嘆を放ちたくなるのである。",
              "citation": {
                "source": "姫柚子の讃",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
