        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから非常に背の高い、すらりとした男が一人、シャン・ゼリゼエの方の、町角を曲りながら、立ち現れた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンゼリゼエ、ボア・ド・ブウロンニュ、モンマルトル、カルチェ・ラタン、……学校の裏山に寝ころんで空を流れる雲を見上げながら幾度僕はそれらの上に思いを馳せたことでしょう。",
              "citation": {
                "source": "十年",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物売りに我もならまし初夏のシヤンゼリゼエの青き木の下　五月のシヤンゼリゼエの大通りは、両側のマロニエの街路樹が花をつけ、小さいシヤンデリエヤを一面に飾り立てたやうに見える。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウンデル・リンデンの並木｜路を美しいと聞いて居たが、其れは巴里のシヤンゼリゼエを知らない人の言ふことであつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤン・ゼリゼエの植込も、セエヌの水もしつとりと青い狭霧に街灯の涙を垂れて泣いて居る。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは言うまでもなく、ろんどんチャアリン・クロスの敷石も、クリスチャニアのフィヨルドも、シャンゼリゼエの鋪道も、同じ軽さで叩いたし、マドリッド闘牛場の砂も附けば、これからはまた印度の緑蔭も踏むことだろう。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、倫敦チャアリング・クロスの敷石もアルジェリアの砂漠も、シャンゼリゼエの歩道も同じ軽さで叩くだろうしベルゲンの土も附けばアラビヤの砂も浴びるだろう。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "『キャトルヴァンデズヌウフ・アヴェヌウ・ドュ・シャンゼリゼエ――セッサ！",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、これからの一本道が名にし負うシャンゼリゼエなんだが、こいつがまた凱旋門まで一｜哩と四分の一もある、おまけにいやに真直ぐだから、気のせいか、なお長い。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンゼリゼエからちょいと横へ切れた、眼立たない裏通り、Rue d'Albe の九番地下室である。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の日のシャンゼリゼエに留度もなく滑る自動車の車輪のように、彼女は自分の心頭がどこへ流れて行くかじぶんで知らないのである。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "（同右☆）３　シャンゼリゼエの亭の黴くさい臭ひ。",
              "citation": {
                "source": "續プルウスト雜記",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三の場合は、シャンゼリゼエで少女たちと遊び疲れて、自分の家への歸り途、四目垣のある亭の黴くさいやうな臭ひを嗅ぐと、突然、いままで潛伏してゐた幻が浮び上るのだ。",
              "citation": {
                "source": "續プルウスト雜記",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "『桜の園』の思ひ出と印象岸田國士　○一九二二年の暮れ、モスコオ芸術座の一行が初めて巴里を訪れ、シャン・ゼリゼエ劇場の大舞台で、その華々しい上演目録の中から、特に純露西亜の作品数篇を選んで、旅興行の蓋をあけた。",
              "citation": {
                "source": "『桜の園』の思ひ出と印象",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "○『桜の園』の幕が明いた――嘗て、シャン・ゼリゼエの舞台でのやうに。",
              "citation": {
                "source": "『桜の園』の思ひ出と印象",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャン・ゼリゼエ街（われをして百万長者たらしめよ）シトロエンよりも古風な幌馬車君は女王――われは御者日の暮れぬ間にプウロオニュまで一と走り。",
              "citation": {
                "source": "巴里素描",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリの劇場で、幕間の数分間を、さほど不愉快に思はずに過せた劇場と云へば、まあ、コメデイー・デ・シヤン・ゼリゼエの、それも木曜のマチネでせうか。",
              "citation": {
                "source": "幕間",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その開演の前夜シャン・ゼリゼエ劇場主、エベルトオは盛大な歓迎会を同劇場内に催して、一行を巴里の劇壇に紹介した。",
              "citation": {
                "source": "あの日あの人",
                "author": "――巴里劇壇回顧――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントワアヌとスタニスラフスキイとコポオと、この三人を同時にシヤンゼリゼエの舞台の上に見た記憶は、僕の演劇理論を組み立てる象徴的な夢なのである。",
              "citation": {
                "source": "芝居と僕",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて、シヤンゼリゼエの小屋に無限の心残りを感じつゝ、医者の勧めで南仏ポオへ旅立つた。",
              "citation": {
                "source": "芝居と僕",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里などではシャンゼリゼエの真ん中でもランプを燈す家があるのに、日本ではよほど辺鄙な山奥へでも行かなければそんな家は一軒もない。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の一夜、巴里シャンゼリゼエ大通りの並樹の下で、青年貴族マキシミリヤンと佳人リュシエンヌが極めて物静かに語り合っている。",
              "citation": {
                "source": "感傷主義",
                "author": "Ｘ君とＸ夫人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
