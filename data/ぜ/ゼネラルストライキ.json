        "examples": {
          "standard": [
            {
              "text": "全国規模のゼネラルストライキにより、公共交通機関が完全に麻痺した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "政府はゼネラルストライキを回避するため、労働組合との交渉を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "過去のゼネラルストライキは、社会に大きな影響を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "港一帶にゼネラル・ストライキがあつた時、お惠は外で色々「恐ろしい噂さ」を聞いた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月一日から七日まで、第二のゼネラル・ストライキが開始された。",
              "citation": {
                "source": "労働者農民の国家とブルジョア地主の国家",
                "author": "――ソヴェト同盟の国家体制と日本の国家体制――",
                "note": "青空文庫"
              }
            },
            {
              "text": "総辞職を主張するものもあれば、全吏員のゼネラル・ストライキを宣伝して回るものもある。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
