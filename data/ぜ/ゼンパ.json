[
  {
    "uuid": "57522466-a24b-58c9-bdb5-2d7082441d20",
    "entry": "全波",
    "reading": {
      "primary": "ぜんぱ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
