[
  {
    "uuid": "d9224c20-f173-5f8c-920a-8cc04d90b674",
    "entry": "前半",
    "reading": {
      "primary": "ぜんはん",
      "alternatives": [
        "ぜんぱん"
      ],
      "is_heteronym": false
    },
    "grammar": {
