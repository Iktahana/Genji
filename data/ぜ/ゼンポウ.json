[
  {
    "uuid": "9d485a1a-db61-5cb6-9657-e7bbd847ea82",
    "entry": "前方",
    "reading": {
      "primary": "ぜんぽう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
