          "literary": [
            {
              "text": "わが舌人たる任務は忽地に余を拉し去りて、青雲の上に堕したり。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "長崎｜舌人の事跡に精しい人の教を得たい。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶山の言は長崎にある新旧の清客に及び、又｜舌人に及んだ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが舌人たる任務はたちまちに余を拉し去りて、青雲の上におとしたり。",
              "citation": {
