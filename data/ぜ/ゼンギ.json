        "examples": {
          "standard": [
            {
              "text": "お互いの気持ちを高めるために、ゆっくりと時間をかけて前戯を楽しむ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は繊細な前戯を好むので、指先の動き一つ一つに気を配る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "パートナーとのコミュニケーションを大切にし、前戯の好みを共有する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "第一部の劇場にての前戯に、道化方がアイン・ブラアウェル・クナアベのいるのは劇場の利方だと云っている。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "とこう一つゆきやしょうかな」「は、その事でござりますが、手前戯作者志願でござって、ついては厚顔のお願いながら、ご門下の列に加わりたく……」「へえ、そりゃア本当ですかい？",
              "citation": {
                "source": "戯作者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "劇場にての前戯座長。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "性行為の前戯として、相手の男性から唇に口紅を塗られる女性の、告白となっていた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、とつぜんぎょっとしたように振返った。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
