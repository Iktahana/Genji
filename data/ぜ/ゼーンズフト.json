          "literary": [
            {
              "text": "私たちが地上の悲しみに濡れて天に輝く星をながめる時、私たちの魂は天つふる郷へのゼーンズフトを感じないであらうか？",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが地上の悲しみに濡れて天に輝く星をながめるとき私たちの魂は天津ふるさとへのゼーンズフトを感じないであろうか？",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜も天の甘美と遠い調和と魂の休息とが思われて、そこはかとなき永遠へのゼーンズフトを感ぜずにはいられませんでした。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            }
          ]
        }
