        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大統領と“影”の大統領ゼルコフとの会談――。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼルコフ「一体どうするんだね、この始末は……」大統領「どうするもないさ。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は余の既定方針に基き、それを強行するまでだ」ゼルコフ「ちょっと待ってくれ。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが最善の方法だ」ゼルコフ「宣伝方法を問題にしているのではない。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は物量を以て、完全に日本を屈服させ得るという信念を今もって堅持している」ゼルコフ「困った信念だ。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "君がそういう国家の不利益を、この上もたらさないことを望む」ゼルコフ「なんだって。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "余が大統領である以上、それを余の最善と信ずる方向へ向けるのは蓋し当然のことだ」ゼルコフ「待て。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰が余を大統領に選定したにしろ、余は大統領たるの職権を信ずるところに従って振うばかりである」ゼルコフ「きさまは気が変になっているんだ。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれたちを怒らせて、何を得るか、分っているはずだ」　ゼルコフ退場し、扉が閉まる。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "またゼルコフが来るかもしれん。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのう、ゼルコフは、さっきぷんぷんして戻っていきました」大統領「ふん。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "国民は、わしが世界の帝王になることを望んでいるのだ」　突然ゼルコフが、この部屋へ闖入してくる。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼルコフ「おい大統領。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は君の政策戦略に責任を持つね」大統領「御念に及び申さぬ」ゼルコフ「もし失敗したらどうする。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "りっぱに責任を……どうぞ委員会の紳士方へよろしく」ゼルコフ「なにい。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
