          "literary": [
            {
              "text": "菓子屋のドロツプやゼリビンズは點描派の畫布の樣だし、洋酒瓶の竝んだ棚はバグダツドの祭の樣だ。",
              "citation": {
                "source": "太郎と街",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パイをたべた後で、お母さんは、たなからゼリビンズのはいった袋をおろして、四｜人の子供たちに、分けてくださいました。",
              "citation": {
                "source": "お母さんはえらいな",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "四｜人はかんじょうすると、いちばん小さい勇ちゃんのが、一つ多かっただけで、三｜人のゼリビンズの数はまったくおんなじだったのです。",
              "citation": {
                "source": "お母さんはえらいな",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
