          "literary": [
            {
              "text": "那珂氏は菅氏の説に對しては筑前博多ヨリ贈於郡ニ至ルニ、豐前豐後日向ノ東ニ沿ヒテ、佐多岬ヲナレバ、信ゼラレズ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノ説、イト巧ニハ辨ゼラレタレドモ、想像ニ成レル事多クテ、確證少ケレバ、慥ナル事ハ知リ難シ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍輩ノ浪人ハ其ノ縁ヲ以テ諸大名ニ奉公ニ出デ、又左京儀ハ他家ノ主人ニ仕フル事、本意ナラズ存ゼラレ候。",
              "citation": {
                "source": "大菩薩峠",
                "author": "間の山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治元年二月内國事務參與職ニ補セラレ、尋デ公議院ノ議長、左院小議官等ニ歴任シ、或ハ元老院議官ニ、或ハ貴族院勅選議員ニ任ゼラレ、明治三十七年十月病テ歿ス。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "秋月古香略傳",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年東京六小学始メテ建ツヤ、第一小学大訓導ニ任ゼラレ、マタ命ヲ蒙ツテ教科書ヲ撰ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五年第四高等中学校教授ニ任ゼラレ、以テ今ニ至ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "『私ハソビエト社会主義共和国連邦ノタメニ命ゼラレタコトハ何事デアッテモ行ウコトヲ誓イマス。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年前ノ出来事ガマルデ新シイ事実ノヨウニ感ゼラレ、興味津々盡キルトコロヲ知ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅イツル／＼シタ板ノ上ニ臥カサレテイロ／＼ノ形ニ体ヲ彎曲サセルベク命ゼラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ又寝室デ夜食ヲ取リ、安静ニスベク命ゼラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ貴意ウゴカバ、身ヲ以ツテ、本船ニ投ゼラレヨ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハコレヲ破壊スルヨウニ命ジ、私ハ命ゼラレタ通リノコトヲシタ」「その通りだ」あなたの意識は思念を送った。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
