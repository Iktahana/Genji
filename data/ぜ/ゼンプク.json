[
  {
    "uuid": "7de44ab9-3c77-5da3-b8c6-ab113109dc9e",
    "entry": "全幅",
    "reading": {
      "primary": "ぜんぷく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
