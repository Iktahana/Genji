          "literary": [
            {
              "text": "此レ歐米諸國ヨリ一歩ヲ先ンゼントスル國民的覺醒ヲ裏切ル大汚濁ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第○野戦高射砲隊ハ、既定計画ニ基キ陣地ヲ占領シ主トシテ高田市附近ノ防空ニ任ゼントス。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシソノ亜舶ニ投ゼントスルノ前数日也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは、おしゃれなので、床屋がぼくの頭をリーゼントスタイルにしたとき、あわてた。",
              "citation": {
                "source": "鈍走記（草稿）",
                "author": "竹内浩三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その歌うのを聞けば、――天地｜反覆火※セント欲ス大廈崩レントシ一木｜扶ケガタシ四海ニ賢アリ明主ニ投ゼントス聖主ハ賢ヲ捜ルモ却ッテ吾ヲ知ラズ「……はてな？",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
