        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "多分ゼジュン断食であつたであらうと言はれてゐる。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママはおれのことをゼジュ・クリ（キリスト）と呼ぶんだ。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はゼジュイット派の牧師を懺悔聴聞者に選び、大弥撒や夕の祈祷などに出かけて行った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばアンファン・ゼジュ会では言う、「ただ今の時間にまたそれぞれの時間に、イエスの愛は私の心をあたため下さいまするよう！",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼジュイット派が建てたものだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼジュイット派建築の傑作は、ナムュール市にあって、サン・ルーと言われてる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
