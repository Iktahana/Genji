        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その本は「禅関策進」であった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「禅関策進」にはこの項目以外にも肉体の自然の要求を退けて悟りの道に進んだ幾多の事例が載っていた。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧鶴は「禅関策進」を懐へ入れて部屋へ帰った。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧鶴は時に落胆したり、時に怒ったりしたが、しかし、結局は現実の老僧たちの態度よりも馬翁の許の虫干で拾った「禅関策進」の中に書いてある文字上の歴史の人々の事蹟言行を信じた。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "禅関策進を読む、読むだけが、そして飲むだけがまだ残つてゐる。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし強いて何か御読みになりたければ、禅関策進というような、人の勇気を鼓舞したり激励したりするものが宜しゅうございましょう。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし強いて何か御讀みになりたければ、禪關策進といふ樣な、人の勇氣を鼓舞したり激勵したりするものが宜しう御座いませう。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
