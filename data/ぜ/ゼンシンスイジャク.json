        "examples": {
          "standard": [
            {
              "text": "長引く闘病生活の末に、彼は極度の全身衰弱に陥り、自力で起き上がることも難しくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "遭難した登山家は、発見されたときには全身衰弱が激しく、意識も朦朧としていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "獣医は、保護された野良犬の全身衰弱を見て、直ちに栄養剤の投与を開始した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "全身衰弱いちじるしく、一週間ないし十日で死亡した。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "惜しいことに余りにも全身衰弱しきっていて、歩くことさえ大儀そうで、見ていても痛々しく窶れ果てている。",
              "citation": {
                "source": "妖影",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく発熱と全身衰弱があった。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "省吾にその自覚がなかったため、死毒だとわかったときは悪液質があらわれ、救いようのない全身衰弱が始まっていた。",
              "citation": {
                "source": "四年間",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
