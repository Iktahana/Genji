        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "前職の人が作成したマニュアルのおかげで、業務の引き継ぎがスムーズに進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は前職の担当者が残した顧客リストを整理し、自分なりの営業戦略を練った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "前職から引き継いだプロジェクトを、彼は粘り強く進めてついに成功に導いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
