        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "友禅模様のごくいきなのにしてお呉れ。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋にはいると、赤い友禅模様の蒲団を掛けた炬燵が置いてあり、風呂もすぐにはいれ、寒空を歩いてきた安子にはその温さがそのまま折井の温さかと見えて、もういやな奴ではなかった。",
              "citation": {
                "source": "妖婦",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに友禅模様の肩当てをした夜着の襟から、口元などのきりりとした浅井が寝顔を出していた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼女はもう古くなつた友禅模様の縮の単衣を着て出たが、こゝの晩方の陽気には少しぺら／＼しすぎてゐた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は前と違って、吉原の花魁の裲襠を見るような派手なけばけばしい扮装で、真っ紅な友禅模様の長い裾が暑苦しそうに彼女の白い脛にからみついた。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらば友禅模様ある紫縮緬の半襟に韜まれたる彼の胸を想へ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "未亡人も友禅模様の長繻絆をしどけなく着て私の枕元に横坐りをしている。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "広い天井一パイの花や紅葉の間に昼夜輝く電燈の下を、十七八から二十歳前後の揃いも揃ったのが二十人程、友禅模様に白エプロンの結び目高やかに右往左往している。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "痩せぎすの体に友禅模様の長襦袢を着た、二十四五に見える廂髪の女であった。",
              "citation": {
                "source": "指環",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあ、お酒を出しましょうね」「今日はもう好い、うんと酔ってるから」「では、また後にあげましょう、今晩はお名残に泊っていらっしゃい」　真澄は女と他愛のないことを話していたが、何時の間にか女が友禅模様のついたきれいな布団を敷いたのでそのまま横になった。",
              "citation": {
                "source": "岐阜提燈",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは友禅模様の鮮麗な羽織を着た十六七の色の白い女であった。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小女の羽織の友禅模様は、蒼白い光の燃えついているように、暗い中にはっきりと見えていた。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い帷にするような友禅模様の羽織と、くっきりと白い顔が見えるように思われた。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝法院の塀をはなれて池の縁へ出たところで、左の方から来る人群の中に、友禅模様の羽織を着た小女を見出した。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青光のするような友禅模様の羽織の模様がはっきり見えた。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小女は友禅模様の羽織の袖をひらひらとさせながら、いきなり水の中へ飛び込んだが、少しも水の音はしなかった。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その羽織も鮮麗な青光のする友禅模様の羽織であった。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は小柄な青い友禅模様の羽織を着ていた。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十六七の色の白い、友禅模様のような羽織を着ておりました」と岩本が云った。",
              "citation": {
                "source": "水魔",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなところで、何人の丹精で、こんな花園があるかと思われるくらい、地べた一めんに高山植物が花をつけて、ひろい野原に、赤、黄、むらさきと、一望に咲き揃っている眼も綾な自然の友禅模様――高い山にはよくあるお花ばたけなのである。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い友禅模様の夜具が、この部屋の主には少し不釣合なほど艶かしい。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅色の勝った、友禅模様の袖は、いろいろの落花の積み重ねのように見え、それを弄んでいる娘の、白い、細い、柔らかい指は、その花の積み重ねを、出たりはいったりする、蚕かのように見えた。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "島田の髷が崩れ傾り、細い白い頸にかかってい、友禅模様の派手な衣裳が、紫地の博多の帯ともども、着崩れて痛々しい。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥田の中からひっぱり出したような子供の派手な友禅模様のチャンチャンが放り出してあるわきに、溺死した二羽の白色レグホンが、硬直した黄色い脚をつき出してころがされている。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お恵さんは今まで縫っていたらしい友禅模様の小布を抓み上げて、ヒラヒラ動かしながら微かに笑った。",
              "citation": {
                "source": "加護",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしの着物……大きな赤い牡丹のついた、友禅模様の金紗の袷です。",
              "citation": {
                "source": "坂田の場合",
                "author": "――「小悪魔の記録」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "長火鉢の磨きすました銅壺、黒塗りの餉台、茶箪笥の桑の木目、鏡懸けの友禅模様、違い棚の真中にある大きな振袖人形、縁起棚の真鍮の器具……そうした室の中に、みさちゃんと呼ばれた小女は、行儀よくまめまめしく立働きました。",
              "citation": {
                "source": "沼のほとり",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の膝の前には、美しい友禅模様の布が並んだ。",
              "citation": {
                "source": "子を奪う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下に足音を立てないようにして、それから注意して障子を開いて、頭だけ差出して眺めてみると、覆いのしてある電燈の薄暗い光の中に、ぱっとした派手な友禅模様のメリンスの布団に、竜子と順一とがぬくぬくと眠っていた。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まだ、温味があるか」と丸山から揶揄い気味に言われて、仏頂寺弥助は友禅模様にいよいよ面を赤くはえらせ、「まだ遠くは行くまい」「炭部屋の中をたずねてみさっしゃい」「ばかにするな」　丸山勇仙も冷かし気味であり、揶揄い口調であるけれども、その、は、は、は、と冷笑するところに、なんとなくすさまじい響がする。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
