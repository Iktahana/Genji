          "literary": [
            {
              "text": "「ワツハツハ……止せ／＼。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は、ドリアン以下十頭の駒をならべて――森に入つては鳥を打ち、川に降つたら魚をつかみ、夜になつたら樽を叩いて酔ツ私ひ、グウグウと鼾をあげて眠つてしまへば世話はない、明日は明日、今日は今日――そんなやうな意味で、処々に、「ワツハツハ、グル／＼回れ、上手に踊つてあの娘にもてろ！",
              "citation": {
                "source": "喜劇考",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい／＼、ちよつと立ち止まつて皆なでいち時にワツハツハツ！",
              "citation": {
                "source": "出発",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワツハツハ……」「ワツハツハ……」「ワーツ、ワーツ！",
              "citation": {
                "source": "出発",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ワツハツハ……」　老父は扉を蹴つて立去つた。",
              "citation": {
                "source": "木枯の吹くころ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワツハツハ……」「ともかく提灯の用意を……」　そんな言葉が解つた。",
              "citation": {
                "source": "ラガド大学参観記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワツハツハ……」　提灯の連中が一勢に声をそろへてゲラゲラと嗤ひはやしたらしくも聞へ、さうかと思ふと引き波に転がる例の小砂利の音でゞもあるらしい。",
              "citation": {
                "source": "ラガド大学参観記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワツハツハ……といふ笑ひ声が時々起るんで、僕は非常に不愉快になつたから、それでちよいと君に来て貰つたんだが……」「それは何かの聞き違へだらうよ。",
              "citation": {
                "source": "ラガド大学参観記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分果報者ねえつて、さう云つてたよ、ワツハツハツハ」　安藤はいつもの調子である。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワツハツハハハ」　幾島は、面白くないといふ顔で、「光」に火をつけようとした。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたはなにもかも知つとるわい」　そして、また、ワツハツハがはじまつた。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワツハツハツハツハツ。",
              "citation": {
                "source": "素面の管",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チイサナ　ナミガ　ボクノ　スナマンヂウヲ　タベチヤツタ　ワツハツハ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイサナ　ナミガ　ボクノ　スナマンヂウヲ　タベチヤツタ、ワツハツハ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳兵衛が相手なら左手で沢山だね」　かう云つて彼は鷹揚にワツハツハと笑つた。",
              "citation": {
                "source": "朧夜",
                "author": "犬養健",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
