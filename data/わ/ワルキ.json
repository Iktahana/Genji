        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこにはいつも薪を割る木の台がある。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾の再び三たび頼み聞えしには答えずして、徐かに沈みたる底気味わるき調子もて、かかる大それたる事に加担する上は、当地の警察署に告訴して大難を未萌に防がずばなるまじという。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "われは一語をも出すこと能はずして、僧と僧のめぐりなる氣味わるきものとを驚き※たり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "學校にありしころ人の世途の難を説くを聞きては、或課題のむづかしき、或師匠の意地わるきなどに思ひ比べて、我も亦早く其味を知れりといひしことあり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "』胸わるき油煙のにほひ女子らが汗に蒸されて、焦熱のこころあかあか火の車、または釜うで、餓鬼道の叫喚さながら人人が苦悩を醸す。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち上手に気味わるき人声。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "固より意地わるき繼母の如きものとも見えねば、慈母とも見えず。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話が、ご都合わるき時は、お手紙を。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "寡言にして何事も内気なる浪子を、意地わるき拗ね者とのみ思い誤りし夫人は、姉に比してやや侠なる妹のおのが気質に似たるを喜び、一は姉へのあてつけに、一はまた継子とて愛せぬものかと世間に見せたき心も――ありて、父の愛の姉に注げるに対しておのずから味方を妹に求めぬ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "意地わるき同僚が、君、どう、着色写真でも撮って、君のブライドに送らんかと戯れ候も一興に候。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あれは志を翻して、石田三成を助けに行くのでござる」「治部少輔へ加勢にか……」「螳螂の軍に加わるきりぎりすのようなものでござる」　一軍の間に嘲笑が起ろうとする時に、家老の松野主馬がそれを遮った。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの薄気味わるき博文館使用人は再び頻々としてわが玄関に来りて文句をならぶ。",
              "citation": {
                "source": "書かでもの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳里恭がいはゆる「爪先の向けやう」わるきものにして千里を行くものにあらず。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶屋といふものなくなりて、劇場内の食堂の料理何となく気味わるき心地せられしがためのみ。",
              "citation": {
                "source": "矢はずぐさ",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月二月の寒風に吹かれて家に入れば、眼くるめくばかり頭痛を催し、八月の炎天を歩み汗を拭はんとて物かげに憩ひ風を迎ふれば凉しと思ふ間もなく、忽ち肌ひやひやとして気味わるき寒さを覚ゆ。",
              "citation": {
                "source": "矢はずぐさ",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "年々｜鳥雀昆虫の多くなり行くこと気味わるきばかりなり。",
              "citation": {
                "source": "夕立",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは題が少きと題がわるきとに基因いたし候。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "本村にさしかかり、お母さんと別れねばならぬ場所が近づくと、さすがのきょうだいも少し不安になったらしく、かわるがわるきいた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆これ景気わるきことだが、お年玉ぐらゐは配ってゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがにワルキリーの国だと思われたりした。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初に越さなくてはならない線はワルキといふのだ。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせワルキかポギバに行けば、お前達はみんな弾を食ふのだ。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ワルキまでは二十ヱルストだといふ事を聞いてゐた。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「もう追つ付けワルキに来るだらう。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "日耳曼神話に見ゆる、戦場に斃れし武士の霊魂を、天国へ引導す可き任務を有する天女ワルキリアの如きは、即ちこれなり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローン河に横はる橋々の袂に、其の年の初演奏はワグナーのワルキール、次の夜にはグノーがフオーストとの予告は出でたり。",
              "citation": {
                "source": "舞姫",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワルキールの夜には、（ワグナーのかたくなゝる事よ）舞踏なければ、われは徒に、ソプラノの姿より数多き女戦士の一人一人を見まもりぬ。",
              "citation": {
                "source": "舞姫",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある晩なんかは、ワルキューレのある幕の最中に、自分のヴァイオリン大｜協奏曲をひきたいと考えついた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「ラインの黄金」「ワルキューレ」「ジークフリート」「神々の黄昏」の四部作はワグナーの楽劇の理想を具現した大傑作であるばかりでなく、実に古今の音楽史上に燦たる大金字塔でもあったのである。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
