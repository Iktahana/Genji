        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それも、考へ考へぽつりぽつりと申し上げるのでございますから、その長つたらしい事、将軍家もたうとう途中に於いてお笑ひになり、ワカリマシタ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、ソノ　トキ、ジブンノ　アタマニハ　カンザシハ　サセナイ　コトガ　ハジメテ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ、ホカノ　ヒトニハ　トウトイ　モノデ　アツテモ、ジブンニハ　チツトモ　トウトクナイ　コトモ　アルノダ、ト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ミンナハ、カゲト　イフ　モノハ　タイヤウガ　ツクルノダト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴官ガコノ事件ヲ、本気デ調査サレタ事ガワカリマシタラ私ガ貴官ノ御宅ニ出頭シテ、真相ヲオ話シシマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホキナ　コヱデナニヲ　ネゴトヲイッテルノ」トオカアサンニオコサレテ、ハジメテ　ユメダッタ　トワカリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワカリマシタカ……。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
