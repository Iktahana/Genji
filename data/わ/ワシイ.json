          "literary": [
            {
              "text": "手紙は簡単に「トニカク、クワシイ事ヲオ話シマショウ。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "クワシイコトハ物理学者ニ聞カナイトワカラナイガ、多分直線ノホウガヨリ少ナイエネルギーデヨリ多クノ距離ヲ行ケルノダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ニハ清三ガ道子ノ夫ダトイウ事ダケデ、清三ノ存在ガ呪ワシイモノダッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九五〇年の私達の課題は日本が全面的な講和によって、次の戦争に利用する事の出来る従順な八千五百万の住民と云うノロワシイ条件を克服しなければなりません。",
              "citation": {
                "source": "今年こそは",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんた、あたしなんかといっしょにいるの、ケガラワシイと思っているのね」　サト子は、シヅの肩に手をまわして抱きかえしながら、「それは邪推よ……あなたが、あんまり気をつかうので、居づらくなったの。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その私も、もう少し厳密にしらべて見ると、五、六年前＝戦争中＝かなりイカガワシイ事をしました。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらも当人はチャンとやっているのでイカガワシイ気持はしませんが、ギョッとはします。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、ナカ／＼別レル気ナンカアルマイ、萬一彼女ニ疑ワシイ行為ガアッタトシテモ、見テ見ナイ振リヲスルカモ知レナイ、上手ニ振舞ッテサエクレヽバ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼女ノ性質カラ推シテ、果シテホントウニ睡ッテイタノカ寝タフリヲシテイタノカ、ソノ点ハ疑ワシイ」と夫が書いているあの二日間、私は決して「寝タフリヲシテイタ」のではないが、そうかといって完全に意識を失いつづけていたとは云いがたい。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
