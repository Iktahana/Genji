        "examples": {
          "standard": [
            {
              "text": "祭りで子供たちが綿飴を食べている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その綿飴屋は毎年大繁盛だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "綿飴の甘い香りが立ち込めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "よく縁日で子供達が買つてゐるものに綿飴といふ白いボッと大きくふくれたのがあるが、あゝして質の充実しない外劃的な大きさのみがある作者にはもつと真面目な行き方を望む。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶えず、足で機械をふんでゐる、綿飴屋が、割箸に、それをからませて、子供の前につき出して、何か云つてゐた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨリコはまた綿飴ともいう土地があり、上方ではジンキとも呼んでいた。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
