        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "メーテルリンクは法律家であつて、その業務の傍ら、論文と作劇とに從事して居たが、『モンナワンナ』を作つてから、その作劇上の資才が見とめられる樣になつたのである。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "○大きないいイワンナーという犬が居る。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術座の「モンナ・ワンナ」公衆劇団の「エレクトラ」近代劇協会の「マクベス」――さうして自由劇場では小山内氏が西洋からかへつて来たところで、三年前に一度やつた「夜の宿」を再演して、われ／＼を十二分に満足させて呉れました。",
              "citation": {
                "source": "井上正夫におくる手紙",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンナ　千葉、茨城二縣の農村で、芋殼一名ズイキの乾したのをワンナと謂つて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンナも恐らくは乾して貯へるものに限らず、以前はもつと弘く用ゐられた食料だつたらしい。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンナ　千葉、茨城二県の農村で、芋殻一名ズイキの乾したのをワンナといっている。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンナもおそらくは乾して貯えるものに限らず、以前はもっと弘く用いられた食料だったらしい。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子じゃったらジワンナ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ぢやつたらジワンナ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
