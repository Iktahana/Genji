        "examples": {
          "standard": [
            {
              "text": "前半戦をどう乗り切るかが、この試合の勝敗の分かれ目になるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "プロジェクトが成功するか失敗するかの分かれ目は、最初の資金調達にかかっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼が病気を克服できたのは、早期発見が大きな分かれ目だったと医者は言う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
