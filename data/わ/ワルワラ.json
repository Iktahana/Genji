        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さてステパンが幼年学校に這入ると同時に、未亡人は娘ワルワラを連れてペエテルブルクに引越して来た。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステパンが此時の心持を領解してゐたのは、同じやうに自信のある、名誉心の強い同胞のワルワラ一人であつた。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワルワラはステパンの心を洞察してゐた。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより外に、ワルワラの理解し得ない動機がある。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
