        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ある家庭で歳末に令嬢二人母君から輪飾りに裏白とゆずり葉と御幣を結び付ける仕事を命ぜられて珍しく神妙にめったにはしない「うちの用」をしていた。",
              "citation": {
                "source": "雑記帳より（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このチキンライスの話と輪飾りの話には現代思潮の反映がある。",
              "citation": {
                "source": "雑記帳より（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥は奥で、神棚の燈明がハタハタ風に揺めいて、小さい輪飾りの根松の緑に、もう新しい年の影が見えた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの町を歩いても、軒ごとに門松や輪飾りが綺麗に出来｜揚って、新しい春がもう来たようであった。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "門松や輪飾りはめんどうくさいから止めにして、裏山から歯朶を五六本折ってきて瓶に挿した。",
              "citation": {
                "source": "雑記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方に、低い束髪にしてから、元禄髷に似た縦長い髪毛の束を三寸ばかり上に突上げたのが居るかと思うと、洗い髪同様の髪を玄冶店のお富式にうしろに投げ卸して、その先を三つ組にして輪飾りの七五三のようにしているのがある。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた　死の輪飾りを薔薇のつぼみのやうなお前のやはらかい肩へおくるだらう。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "表門のくぐり戸を開けて、田辺とした表札の横に、海老、橙、裏白、ゆずり葉などで飾った大きな輪飾りの見える門の前を先ず掃き清めた。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いふーわりとした服をつけた女の児が、頭に春の花の輪飾りをのせて、嬉しそうにリンゴでお手玉をとっている絵ハガキに、お手玉うたのようなものを書いてくれたのもあった。",
              "citation": {
                "source": "父の手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨居にあるのは小さな錆び釘で、正月の輪飾りをかけた残りのものだった。",
              "citation": {
                "source": "浅間噴火口",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはそつくり二十年前の閏土で、ただ少し顔色が悪く痩せて頸には銀の輪飾りがないだけであった。",
              "citation": {
                "source": "故郷",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "菰冠りがひとつドデンと据えられ、輪飾りや七五三飾りがちらばっている大きな台所へゆくと、チャンと大工道具が置かれてあった。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方、女房と輪飾り、門松などとげぬき地蔵の方へ買いに行く。",
              "citation": {
                "source": "随筆　寄席風俗",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう鏡臺にまで小さい輪飾りがしてあつた。",
              "citation": {
                "source": "蒼白き巣窟",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツハツ、ハツハツ、だが、世間附き合ひが惡いやうだから、ちよいと直してやらう」　平次は店の中から空樽を一梃持出して、それを踏臺に、輪飾りを直してやりました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "――第一番に、入口の輪飾りが引つくり返つて、裏の方を見せて居たらう」「へエ――」「縁喜物を裏返しに掛けるあわて者が何處の世界にあるものか――空樽を踏臺にして、やつと手の屆くところだから、子供のしたことぢやねえ」「成程ね」　ガラツ八は長い顎を撫でました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "「輪飾りを引つくり返したり、障子を裏返しにすると、何かの禁呪になるでせうか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "――街を通る人から、たつた一と目で見える輪飾りと障子に細工があつたんだぜ――」　二人の足は、何時の間にやら、平次の家へ――路地を入つて居りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "親分、海賊橋の輪飾り」「あ、そんな事もあつたやうだね。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうだ八」「あの通りだ、輪飾りも、――二階の障子も」　輪飾を裏返しに、二階の障子の骨は此方を向いて居るのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "「輪飾りが裏返になつて居るのを見ただけさ、いやはや」　さう言つて首筋を掻く平次だつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "真新しい看板に『さざなみ』と書き、浅黄の暖簾に鎌輪奴と染め出した入口、ヒョイと見ると、頭の上の大輪飾りが、どう間違えたか裏返しに掛けてあるではありませんか。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッ、ハッハッ、だが、世間付き合いが悪いようだから、ちょいと直してやろう」　平次は店の中から空樽を一挺持出して、それを踏台に、輪飾りを直してやりました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "――第一番に、入口の輪飾りが引っくり返って、裏の方を見せていたろう」「ヘエ――」「縁喜物を裏返しに掛けるあわて者がどこの世界にあるものか――空樽を踏台にして、やっと手の届くところだから、子供のしたことじゃねえ」「なるほどね」　ガラッ八は長い顎を撫でました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "「輪飾りを引っくり返したり、障子を裏返しにすると、何かの禁呪になるでしょうか。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "――街を通る人から、たった一と目で見える輪飾りと障子に細工があったんだぜ――」　二人の足は、いつの間にやら、平次の家へ――路地を入っておりました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "親分、海賊橋の輪飾り」「あ、そんな事もあったようだね。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうだ八」「あの通りだ、輪飾りも、――二階の障子も」　輪飾りを裏返しに、二階の障子の骨はこっちを向いているのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次屠蘇機嫌",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
