        "examples": {
          "standard": [
            {
              "text": "冬の夜、誰もいない部屋での佗寝は心細い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "遠い旅先で佗寝をしていると、ふと家族を思い出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "枕を並べていた頃が懐かしく、今は佗寝をする夜が長い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし裁判は終結しない儘休憩となり、ごろ寝をする、しかしもともと終結してゐないのであるから佗寝以上には進みやうがない。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋになんとかわびねばならぬと思いこんでいるらしく、――二人は親しげに身体を寄せていっしょに立っていた――初めは自分でイタリア人のお供をするつもりだったが、次に――詳しい理由は言って聞かせなかった――むしろＫに行ってもらおうと決心した、と言った。",
              "citation": {
                "source": "審判",
                "author": "DER PROZESS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
