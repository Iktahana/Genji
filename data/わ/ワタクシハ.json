        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ワタクシハ予テ世間ニ於テ人間ノ美ト醜トニヨル差別待遇ノ甚ダシイノニ大ナル軽蔑ヲ抱イテイタ」とヒルミ夫人はその論文に記している。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "前座のＦは、いまや現役のパリパリで、この文章の中にも登場しているが、さて、「ワタクシハダレデショウ？",
              "citation": {
                "source": "艶色落語講談鑑賞",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハオ魚ヲ食ベルノガ下手デスカラ、オ婆チャンノヨウニ綺麗デハゴザイマセンケレド」颯子ノ鮎ノ残骸ハ成ル程マコトニキタナラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハソンナニ子供ガ好キジャゴザイマセンノ」トカ、「死ノ灰ガ降ルッテ云ウノニ沢山生ンダッテ仕様ガナイジャアリマセンカ」トカ云ッタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタクシハマタベウキ……ハはワでなければならず、病気もベウキと書いては、二人には判じられないのです。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのワタクシハの、ハの字を消して、ワと書き直して、ワタクシワマタベウキを消してビヨウキと書いて、コノベウインヘをまた消して、ビヨウインエ……と直した消しだらけの手紙を出すと、ジーナやスパセニアからもまた、お手本でも見て書いたらしい、尋常一年生のような手紙が来ます。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
