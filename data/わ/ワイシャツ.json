    "definitions": [
      {
        "index": 1,
        "gloss": "(formal) shirt",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はクリーニングに出していたYシャツを、会社帰りに受け取って帰った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "明日の大事な面接のために、アイロンのかかったきれいなYシャツを準備した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "夏のクールビズ期間中は、多くの会社員がノーネクタイ、腕まくりしたYシャツ姿で働いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "然し、奥さん出張すると、靴は痛む洋服は切れる、Ｙシャツは汚れる……随分｜煩さいのです。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いＹシャツに、灰色の洋袴をはいて素足である。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "原稿もすゝまなかつたので、むつくり起きて、汚れたＹシャツに、黒いサージの洋袴をはいて、階下へ降りて、下駄箱からおせいの下駄を出して、それをつつかけて戸外へ出た。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "桂子と別れた後の苦しい放浪の日々、短靴を酔って溝に落し、ひとから貰ったボロ軍靴に、一枚の破れＹシャツしか残っていない私。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで何んでも自由になる男がほしい気持ちで金をつかうのですなアー」　と、森さんはＹシャツの新しいやつを三枚ばかり出して、しわをのばし始めた。",
              "citation": {
                "source": "ストリップ修学旅行",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "追いかけ呼びもどして三人の見事な口髭、銀色の呼吸を流して、年増女の深い思いが高潮に達したときニコロは私の白いワイシャツの皮膚に彼女の眉墨でもって、レニングラードに向かって驀進する機関車と食用蛙を描いて東洋人が彼女の未来の夫であることを象徴するのであった。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊太利女の堅気な臭にふと眼が覚めると廊下でフランス人の車掌とイタリー人の官憲とが僕を指して僕のワイシャツに僕のフランスの港の生活が絵のように書いてあると云ってわらっているのだ。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台から跳ねあがる音がして、黒いスカートのもとから素足のままで、フランのワイシャツに汚れたネクタイを締めながらスマ子女史は英介氏の部屋にやってきて、ストーブのまえでうずくまりながら、――お仕事できたらしいわねえ。",
              "citation": {
                "source": "職業婦人気質",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スマ子女史はワイシャツの縫目からミス・フランセのコバルトの細巻をとりだして火をつけると、蒸気のこもった部屋に水沫のように緑色の煙を吐き出して、――だが、人に聞くと君はちかごろ恋のテクニックに夢中なんですって？",
              "citation": {
                "source": "職業婦人気質",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十分程たった頃、二人は、上衣を取り、ワイシャツ一つになって、片手に棒を握って、豚群の中へ馳こんでいた。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はいつの間にか腹立て怒って大切なズボンやワイシャツが汗と土で汚れるのも忘れて、無暗に豚をぶん殴りだした。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚は彼の猛打を浴びて、またそこからワイシャツの方へ引っかえした。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫らくするうちに、二人のワイシャツはへと／＼に疲れ、棒を捨てて、首をぐったり垂れてしまった。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、日本へ来ている西洋人が夏は好んで浴衣を着たり、ワイシャツ一つで軽井沢の町を歩いたりすることだけを考えても、和服が決して不合理なものばかりでないということの証拠がほかにもいろいろ捜せば見つかりそうに思われる。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブンゼン燈のバリバリと音を立てて吹き付ける焔の輻射をワイシャツの胸に受けながらフラスコの口から滴下する綺麗な宝石のような油滴を眺めているのは少しも暑いものではなかった。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "裂けたワイシャツに、ズボンだけの男は、アンペラに腰をおろすことも出来ず、弾丸よけに毛布を垂らした窓の傍に突ッ立って、唇をかみしめ、ポケットに、片手を突ッこみ、光った眼で前方を見つめていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかっぱに洋装の女の子もあれば、ズボンにワイシャツ、それに下駄ばきの帳場の若い男もある。",
              "citation": {
                "source": "沓掛より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから素裸体になって、外套や服はもとより、ワイシャツから猿股まで検査した。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年は上衣と胴衣を脱いでワイシャツ一つのネクタイを緩めているし、眉香子も丹前を床の上に脱ぎ棄てて、派手な空色地の長｜襦袢に、五色ダンダラの博多織の伊達巻を無造作に巻きつけている。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから大急ぎで洋服を脱いで、衣桁に引っかけてあった浴衣に手早く袖を通し、泥だらけの洋服とワイシャツとズボンを丸めて、番号札のついた脱衣戸棚と天井裏との間に出来ている暗がりに突込んだ。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "先方は揃いの新しいユニフォームをチャンと着ているのに、こちらはワイシャツにセイラ・パンツ、古足袋、汗じみた冬中折れという街頭のアイスクリーム屋式が一番上等で、靴のままコートに上って叱られるもの。",
              "citation": {
                "source": "ビール会社征伐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "上着もチョッキも着ないで、ワイシャツのままで出て来た。",
              "citation": {
                "source": "二十四年前",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一人はワイシャツ一つになって体操をしてみたり、駆け足のまねをしてみたり、ピッチャーの様子をしたりしている。",
              "citation": {
                "source": "LIBER STUDIORUM",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷たい軽い風のある日で、ワイシャツの袖口あたりに、ウブ毛の風に靡くのが感じられるやうなふうであつたことを記憶してゐる。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ワイシャツを洗っちまうから」　小田は不器用な手つきで、ごしごしとワイシャツを洗っていたが、やがて、タオルを絞るように水を絞って、「――やもめは辛いや」　と言いながら、鶴雄をうながして六畳の部屋へ案内した。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」鶴雄に坐蒲団をすすめて置いて、小田は窓側の手すりに洗濯したワイシャツをひっ掛けると、机の前へ戻って来た。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワイシャツも汚れているし、よく見ると靴足袋も踵に穴があいてるの。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その辺まで付き合ってくれないかと言うから、お金はいけないから、靴足袋の一足も買ってやりましょうと思って、上野の松坂屋まで行って、靴足袋とワイシャツを買って、坊やと三人で食堂で幕の内を食べて別れたけれど、男もああなると駄目ね。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　栗栖はワイシャツを着ながら尋ねた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色いジャケツを脱いでワイシャツ一枚になり、「これは面白くなったですねえ。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
