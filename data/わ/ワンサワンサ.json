          "literary": [
            {
              "text": "ここはまえと違って、いかさま、江戸のお盆人気をひとりで占めているらしく、わんさわんさの大入り繁盛です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "するてえと、慾の皮のつっぱった連中がわんさわんさとおしかけて、十万円とふしぎな見世物の両方につられてどんどんはいる。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、アメリカやヨーロッパのよくばり連中が、シャベルをかついで、さびしいいなかの港、サンフランシスコに、わんさわんさと出かけて行っては、砂金をほった。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "武芸の流行もけっこうだが、このごろのように、わんさわんさと押しかけて来られては宝蔵院でも実にうるさい。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ホラティウス）願わくはこの格言が、わが国のあらゆる印刷屋の軒さきにかかげられて、わんさわんさと押しかけるへぼ詩人諸氏の御入来を謝絶せんことを。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
