[
  {
    "uuid": "1375caff-5a3f-5903-82ea-df857ef96664",
    "entry": "湧き上がる",
    "reading": {
      "primary": "わきあがる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
