          "literary": [
            {
              "text": "“〔Ville de Lie`ge〕”　ワルソオ・伯林・ケルン・オスタンド。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "列車主任にワルソオへひきかえす交渉をしているうちに、乗客は部落の馬車を傭ってボーゼンの方面へ逃げてしまった。",
              "citation": {
                "source": "川波",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田と豊川はしばらく後を追ったが、思ったより情況が悪いので、おとなしくワルソオまでひきかえし、リスアニア、和蘭、白耳義を経由して、ジャモンからフランスへ入り、がたがたのフォードを買って、二十日目に、やっとのことで巴里に辷りこんだ。",
              "citation": {
                "source": "川波",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワルソオへ帰りますには、三千法もあれば充分なのでございます。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "南風吹かば　――モンテ・カルロの巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
