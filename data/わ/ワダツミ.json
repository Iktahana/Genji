        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ワダツミ」「ワダノハラ」の「ワダ」は water や露の voda やその他同類の水を意味する言葉と類し、また「ワタル」という意味の wade(L. vadere) および関係の諸語と似ている。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "梵語 udadhi（海）が単数四格で終わりにｍがつけば「ワダツミ」に近づく。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかしはワダツミと言ひしが如し。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "凌霜子所藏の弘化年間印行の地圖を見るにワダツミと假名振りてあり。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
