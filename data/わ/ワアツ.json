          "literary": [
            {
              "text": "同時に鎖を引くと消えるアメリカ製のきらびやかなオイル・シヤンデリアが、ワアツ――といふ観客の熱狂と共に幻のやうに消えて、技手役の照吉が写し出す日章旗のへんぽんたる光景が華麗な色彩を浮べた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "直子さんたらツ」　せん子が、直子を追つて外へ出ると、一時ワアツと笑ひ声が湧きあがつたが、すぐ花火のやうに消えてしまつて、森となつた。",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ちワアツと、みんな騒ぎ立ちました。",
              "citation": {
                "source": "掃除当番",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちらからもこちらからも黒い頭が、白い穂芒の間に現はれてワアツと鬨の声をあげました。",
              "citation": {
                "source": "文化村を襲つた子供",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
