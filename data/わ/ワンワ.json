        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ワンワンに言うようだわ、何だねえ、失礼な。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい並木路を下るときには、振り仰いで新緑の枝々を眺め、まあ、と小さい叫びを挙げてみて、土橋を渡るときには、しばらく小川をのぞいて、水鏡に顔をうつして、ワンワンと、犬の真似して吠えてみたり、遠くの畠を見るときは、目を小さくして、うっとりした風をして、いいわねえ、と呟いて溜息。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさか赤坊の時から、紫式部や、おっぱい御上り、清少納言や、おしっこをなさい、ワンワン来い来い、などと云われたので無かろうことは分っているが、仙人の女王、西王母の、姓は侯、名は婉泥滞水の挨拶を以て其場を済ませて置くというようなことも仕無かったろうから、次第次第に夫婦の間は険悪になっていったであろう。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、お姫さまにむかって、イヌがワンワンほえたてたものですから、お姫さまはすっかりこわくなって、また、もとの広々とした海へもどってきました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "狩りの角笛がひびきわたり、イヌがワンワンほえたてました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれかが、そばを通りかかると、きまって、ワンワンほえたてます。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩酌の酔ひも手伝つて、私は着物をぬぎ捨て、猿股ひとつになつて、青丸の前に、ワンワンと犬のほえる真似をして、座敷中を四ツんばいになつて駈廻つた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "細君は隣座敷で針箱の側へ突っ伏して好い心持ちに寝ている最中にワンワンと何だか鼓膜へ答えるほどの響がしたのではっと驚ろいて、醒めぬ眼をわざと※って座敷へ出て来ると迷亭が薩摩上布を着て勝手な所へ陣取ってしきりに扇使いをしている。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからワンワンの廃り物の方がニャアニャアのルンペンよりも遥かに多い訳だ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もいくらワンワンだって、無鑑札の廃物ばかりを狙っている訳じゃない。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな動物連中の排泄物や、体臭や、猛烈に腐敗した食餌の落零れの発酵｜瓦斯で、気が遠くなるほど臭い上に、ギャアギャアワンワンニャーニャーガンガン八釜しい事｜夥しい。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから草原みたいな柔らかな絨壇の上に上って、背後をピッタリと締切ると、外でワンワンワンとブルドッグの吠える声と、自動車の中で女たちの悲鳴を揚げて脅える声が入り交って聞えて来た。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを見付けた犬は急に憤ってワンワン吠えながら道化男に噛み付こうとする。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ西比利亜には日本軍がワンワン這入っとるから喜んで御座るにきまっとる……それでも嫌なら今の中に貴様もデッキに上っとれ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッという間に船の中が、ワンワンワンワンと蜂の巣を突ッついたような騒ぎになった。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時にワンワンワンワンと火の附くように吠え初めた。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その頃まで北海道の砂金といったらカリフォルニヤの向う張る勢いで、しかも夕張川の上流の各支流の源泉附近は到る処、砂金ならざるなしという評判で、全国の成金病患者がワンワンと押しかけていたものだ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は土間へ引っくり返ってワンワン泣き出しました。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "藪蚊がますますワンワンと殖えて顔から首すじ、手の甲、向う脛、一面にブラ下る。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ縛られているのと同様の不自由な身体に附け込んで、ワンワン寄って来る藪蚊の群が金輪際怨めしかった。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又もワンワンと寄って来る蚊の群を怖れ怖れシテ柱をまわる時の息苦しかったこと。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "金襴の着物を着た儘王様の椅子を飛び降りて「ワンワンワンワン」と吠えながら一所懸命に追っかけました。",
              "citation": {
                "source": "犬の王様",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
