        "examples": {
          "standard": [
            {
              "text": "彼はまだ30代前半なのに、若ハゲに悩み始めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "「最近、抜け毛が増えてきて…これって若ハゲかな？」「気にしすぎだよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "遺伝的な要因も大きいと言われるが、生活習慣の乱れが若ハゲを進行させることもあるらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "これは男の若ハゲなどゝは比較を絶する悲痛な呪いであったろう。",
              "citation": {
                "source": "無毛談",
                "author": "――横山泰三にさゝぐ――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
