        "examples": {
          "standard": [
            {
              "text": "弟は和光大への進学を決めたようです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "和光大のオープンキャンパスに参加して、学部の雰囲気を確かめてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "友人が和光大の教授に研究のアドバイスをもらいに行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "高校卒業後三浪して、古川は和光大学に籍を置いた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが三年間浪人して、一九七五（昭和五十）年に和光大学の人間関係学科に潜り込んだころ、古川が趣味としていたエレクトロニクスの世界に異変が起ころうとしていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
