        "examples": {
          "standard": [
            {
              "text": "セーターに付いた綿くずを、丁寧に粘着テープで取り除いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ポケットの中を掃除したら、大量の綿くずが出てきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "服に綿くずが付いていると、だらしなく見えてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "おかあさんは心配になって、ひざから綿くずをはらい落としながら、門口に出てみました。",
              "citation": {
                "source": "和太郎さんと牛",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "このいかがわしい罪悪の巣窟の奥の方に、葺卸屋根の下に、軒の低い、廂の出張った店があって、そこでは鉄物や、古襤褸や、空壜、骨類、脂のべとべとした腸屑（わたくず）などを買入れていた。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
