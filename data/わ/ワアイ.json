          "literary": [
            {
              "text": "ワアイといふ聲が一しきり谷のこだまにひゞいてきこえた。",
              "citation": {
                "source": "歸國",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ワアイ、ふぉっくす！",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "引き抜くと、「ワアイ」　意味のない叫び声を発して、一散に走りだした。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
