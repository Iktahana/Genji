  {
    "uuid": "a148409a-4430-51c3-939f-a4f2074ed3a2",
    "entry": "ワサ",
    "reading": {
      "primary": "わさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
