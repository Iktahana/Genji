        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小川の直ぐ向ふの笹籔が、サワサワと秋風に吹かれて音立てゝゐた。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝六時頃、この見附を、客人で通りました時は、上下、左右すれ違うとサワサワと音がします。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノッソリ出テ来テ、蠅タタキノ如ク、バタットヤッテ、ウムヲ言ワサヌ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、居留民ノ生命財産ノ保護、国旗ノ尊厳トイウガ如キ言葉ニ迷ワサレテハナラヌ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しそれを趣味に順じないでナスに清冽の水を与え、ワサビに硫黄を与えるような事をすれば、二者の気は各々萎靡して、共に不出来の結果を現わさずには終らない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年、ビートルズが日本にくる、というウワサもあるが、そちらのほうはあまり信じていなかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大根だというウワサだが、ここへくるまでは、畦道なんか歩いたこともなかった連中のいうことだから、全然あてにならない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくつか、妙なウワサをきいたことが、慶一を神経質にさせていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校はちがうけど、ウワサはきく」　高志は〈ユー・ベイビー〉のことは忘れたようだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "――樹明君近来の口癖はブチコワスゾである、何カヲブチコワサズニハヰラレナイホド、君は悩み苦しみ焦立つてゐる、そこで、私が先づ茶碗をぶちこはす、樹明君喜んで皿を投げつける、ガチヤンガラガラ、どうやら胸がすいたらしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "刺身にワサビを附けて煮て食ふ樣なもんぢやないか。",
              "citation": {
                "source": "ハガキ運動",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も皆ワサ／＼していた。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日ワサビ谷を登ってみたが、長くて閉口した。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとつ水いらずで、とっくりと納得させるがいいワサ」　言いすてて、家へはいる石金へ、「何いってやんでエ」　と舌を出したチョビ安、「サ、お美夜ちゃん、こんなところに立ってると、蚊に食われるよ。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰色の女学校がある、石塀の中からは、たそがれ色の往来へ若葉が吹きこぼれて、サワサワと葉ずれの音をたてゝゐる。",
              "citation": {
                "source": "瑪瑙盤",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワサビヅケ　　　　五銭。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "処女の体を呑んだ紙帳は、ほんのちょっとの間、サワサワと揺れたが、すぐに何事もなかったように静まり、その上を、眼白や頬白が、枝移りしようとして翔けり、その影を、刹那刹那映した。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半分意識しているのね、他の半分の意識が変に明るいようなサワサワしたような工合で、盛にうわことが云いたい気がするの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い女の子がワサワサいるところだと、ひとに負けまいと思って気を張るから、いやなのだって。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻があわてて駈け廻って、その御飯粒をくわえ、サワサワ音が聞えそうに、足を動かして逃げ出した。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うそれだけのうちで、何を訊ねようにも種が無いので、先生が後を向ききりになると一緒に、今までひっそり閑としていた教室中には、急に小蜂のうなるような囁や、せわしい身じろぎの音が、一しきりサワサワ、サワサワと鳴り渡った。",
              "citation": {
                "source": "面積の厚み",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本でも昔から義太夫や長唄をやる人達は、咽喉に障るからといって茄子や里芋を食べない、お刺身のワサビも食べなかったものです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　長沙　往来に死刑の行われる町、チフスやマラリアの流行する町、水の音の聞える町、夜になっても敷石の上にまだ暑さのいきれる町、鶏さえ僕を脅すように「アクタガワサアン！",
              "citation": {
                "source": "雑信一束",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちはいつもの習慣で、カフェを飮み、クロワサンをかじりながら、しばらく往來の人通りを眺めてゐた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "實はパリの最後の朝食を、いつものカフェのテラスに腰かけて、あのうまい珈琲とクロワサンでしたかつたのだが、出發前の氣持のあわただしさは、私たちをホテルの平凡な食卓で我慢させた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おぺら・ぐらす　六月二十三日――ロウヤル・アルバアト会館にロウヤル・コウラル協会の「ヒアワサ」を見る。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒアワサの結婚祝い、ミネハハの死、ヒアワサの出発の三幕に別れている。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
