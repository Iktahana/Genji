[
  {
    "uuid": "3444562f-9c6f-509e-a14d-e68ff1fb6ccf",
    "entry": "渡し船",
    "reading": {
      "primary": "わたしぶね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
