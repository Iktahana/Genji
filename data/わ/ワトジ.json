        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この詩集は、伝統的な和綴じで製本されており、独特の趣がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古い巻物は、丁寧な手仕事による和綴じで、大切に保管されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "自分で作ったオリジナルの小説を、粋な和綴じで仕上げたいと思っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "かくかくとした祖母の字も、和綴じでていねいに仕上げられた『蜉蝣』の、味わいの一つです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い人は論外だし、もう一人いる人も、円いような顔の老人で、すっかり背中を丸め、机の下でこまかい昔の和綴じの字書の頁をめくっている。",
              "citation": {
                "source": "図書館",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手元にある和綴じの小さな冊子に拠りながら、私自身の言葉で昔話を再現してみたい。",
              "citation": {
                "source": "夏の日の夢",
                "author": "THE DREAM OF A SUMMER DAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "字体も大きく、和綴じの本で、※絵もなかなか鮮明でしたからお手本には上々でした。",
              "citation": {
                "source": "あのころ",
                "author": "――幼ものがたり――",
                "note": "青空文庫"
              }
            },
            {
              "text": "和綴じの六冊本で、馬琴の覚書きのやうなものであつたが、西鶴のことについての小伝記は、立つて読んでゐる私にも大変面白かつた。",
              "citation": {
                "source": "子供たち",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "書齋へ通ると、上原は、机の上にひろげた和綴の古文書のやうなものをわきへ片づけて、こつちへ向きなほつたところであつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ私は、それが和綴の本で、中には色々な植物の花の絵などがあったのを、覚えているだけである。",
              "citation": {
                "source": "御萩と七種粥",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鈴子や、万葉集を持って来ておあげ」「はい」　と鈴子は立って書院の棚から和綴の本を持って来て、私の机の上に置いて、また前のところに侍していた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の朝、早くから行くので、昌綱さん（先生の弟御）が大急ぎで座敷を掃いて、踏みつぎをして、上の方の本箱から、納めてある和綴本の大判のを出して貸してくだされた。",
              "citation": {
                "source": "渡りきらぬ橋",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　引出しをがたがたいはせて、金井が取り出したのは、かなり大きな古ぼけた和綴りの冊子であつた。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "和綴のかなり厚い一冊物で、表紙は茶色の熨斗目模様、じゃばらの糸で綴じてあり、綴目の上下に紫色の切れが張ってあって『心の種』と書いてあります。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じテーブルに坐つてゐる二重※しを着た男は特別室の顏馴染だつたが、醤油のこぼれたテーブルを鼻紙で拭いて、うすい和綴の本を擴げてゐた。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "「新塾餘談」第三篇は、上下二册になつてゐて、樺色表紙の薄い和綴の本である。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴見が受合って、印刷させて、和綴の小冊子が出るようになった。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の作句を集めた和綴の本が二冊、わたしの家の二階の書物棚の上に古雑誌とともに積み重ねてあったが、それ等も何時の間にか多くの反古とともに紙屑屋にでも売られてしまったのであろう。",
              "citation": {
                "source": "三等郵便局",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "和綴の本で、一年のはじめに十二カ月の題を出して、その月毎に題に関係あるものをもってくるのである。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "和綴の十二三枚の紙のもので表紙には、僧に似ない行成流の、しなやかな筆で「寺宝及承伝書籍目録」高沢寺と書かれてあった。",
              "citation": {
                "source": "雪",
                "author": "楠田匡介",
                "note": "青空文庫"
              }
            },
            {
              "text": "他に御客はなく、白髪のおじいさんは何か和とじの本をよんでおります。",
              "citation": {
                "source": "落ちてゆく世界",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
