          "literary": [
            {
              "text": "ワイルクまでシャトル・バスに乗った。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワイルクに入るあたりから町なかまで、いくつか点々と停留所がある。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらくワイルクだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフルイとワイルクへ遊びにいったときには、このハナ・ハイウエイを往復とも、果敢にもハンナが運転してくれた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
