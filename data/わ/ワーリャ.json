        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "例えば、そん中で、マクシムが、俺はあっちの工場へ行くかもしれねえって云った時、ワーリャが訊く。",
              "citation": {
                "source": "「鎌と鎚」工場の文学研究会",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ワーリャは可愛かつたのですが、ワーリャの母親は、一々物を呉れ呉れと云つて嫌でした。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ワーリャはよたよた歩いてきて、私の頬へ唇をさしよせて来ます。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリッポフの万端が庶民風なのにくらべると、ワーリャと呼ばれているその人の生活は、伸子に、ロシアの首府がペテルブルグと呼ばれていた時代の知識人の空気を思いやらせた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、黒ずくめの服装の堂々とした母夫人の場所で、ワーリャを訪ねて来る素子や伸子なども母夫人は家の客としてもてなし、伸子とは英語で話した。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリャ自身は画家であった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小柄だが、肉づきのしっかりしたワーリャの顔だちには、あたたかい深みがあった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリャと素子とが、二階の書斎へ行って調べものをして来る間、伸子は客間に母夫人と残っていた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリッポフ夫婦の生活やワーリャの家の人たちは、伸子に、昔から今へ生きているロシアの社会のひとこまを見せるようだった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「浅原さんがね、ワーリャさんの眼は、ほかの外国人の眼とちがって、じっと見ていても変になって来ない、っていうのさ」「変になって来るって……」　伸子はよく意味がのみこめなくて、「どういう風に？",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、この間はじめてお目にかかったワーリャさんの眼は私たちの目とあまりちがわないみたいで、わけがわかったから」「本当に！",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな男友達とでも素子が話すいつもの調子なのだが、その調子は素子がほかの女友達やワーリャを対手に話しているときの、まともで真実のこもったやりとりと、どこかちがった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はワーリャに父さんを持たしてやりたい。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは只婚礼をしなくちゃならないの」「ワシリー・ワシリーエフが俺にワーリャを呉れねえことはわかっている。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワシリーの日頃の自慢は、ワーリャは貴族へ、旦那へ嫁入らすということなのであった。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い夫婦は老人の家へ来て暫く一緒に暮したが、確かりしたマクシムに対するワーリャの兄弟共ミハイロとヤーコブの嫉妬が恐ろしい奸計を企てさせた。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラネーフスカヤ夫人、アーニャ、鎖につないだ小犬を連れたシャルロッタ、以上みな旅行服で、――それから外套にプラトークすがたのワーリャ、ガーエフ、ピーシチク、ロパーヒン、包みとパラソルを持ったドゥニャーシャ、いろんな荷物をかかえた召使たち――みなみな部屋に通りかかる。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリャ　なんて寒いんだろう、手がかじかんでしまったわ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（兄とワーリャに、それからまた兄にキスする）ワーリャはちっとも変らないのね、相変らず尼さんみたいね。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（懐中時計を出して見て）あのかた、お起しするといいんですけど、ワルワーラさま（訳注　ワーリャの正式の名）がいけないと仰しゃるものですから。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリャ登場、バンドに鍵束をさげている。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリャ　ドゥニャーシャ、コーヒーを早く……。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）ワーリャ　よかったわ、みんな無事でお着きで。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリャ　察しるわ！",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだってあんた、シャルロッタなんか付けてくれたの……ワーリャ　だって、あんたひとりで旅へ出すわけにも行かないじゃないの、アーニャ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママはそれからいつも甘ったれて、泣いてばかりいたわ……ワーリャ　（涙ごえで）もういいわ、もう言わないで……アーニャ　マントン（訳注　南フランス、ニースに近い保養地）の近くのご自分の別荘も売ってしまったし、ママにはもう、なんにも残っていないの、なんにも。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも一緒に連れてきたの……ワーリャ　見たわ、いやなやつ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリャ　それどころじゃないわ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
