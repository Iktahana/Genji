        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イワス（岩壁の截り立っているところ）にぶつかると、水が深くて急であるから、森の中へ潜り込む、そうしてまた森から吐き出されては、谷の中へと飛び込む。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "太宰イツマデモ病人ノ感覚ダケニ興ジテ、高邁ノ精神ワスレテハイナイカ、コンナ水族館ノめだかミタイナ、片仮名、読ミニククテカナワヌ、ナドト佐藤ジイサン、言葉ハ怒リ、内心ウレシク、ドレドレ、ト眼鏡カケナオシテ、エエト、ナニナニ？",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ労働ニ害サレタ手ハ思ウヨウニ自分ノ感力ヲ現ワス事ガデキナイデ困リマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――樹明君近来の口癖はブチコワスゾである、何カヲブチコワサズニハヰラレナイホド、君は悩み苦しみ焦立つてゐる、そこで、私が先づ茶碗をぶちこはす、樹明君喜んで皿を投げつける、ガチヤンガラガラ、どうやら胸がすいたらしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ　カケツケタ　カゴカキガ、「ダンナ、カタナヲ　オワスレニ　ナリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　ラツパヲ　ミルト　花ヲ　オコシテ　ヤル　コトモ　ワスレテ、「アア、コレダ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ　オアシヲ　モラツタノデ　サツキノ　クルシサモ　ワスレテ、ヨロコビ　イサンデ　カヘツテ　イキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし私が、私の所属部隊、沿海洲ワスクレミヱンカ飛行、第三十編隊兵舎からこの満洲の国境まで、テクつて来たとしたら幾日かゝるだらうね、想像しても怖ろしいことだ――。",
              "citation": {
                "source": "小熊秀雄全集-6",
                "author": "詩集（５）飛ぶ橇",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら、ボルルワスキーかニコラス・フェリー――臭いのだが……」　あるいは、朱と暗緑の対比から、発しているのかもしれないが、事実その絵からは、竦ませるような鬼気が迫って来るのだ。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六三八年アムステルダム板リンショテンの『航海記』一一二頁に、ゴア市の郊外マテヴァクワスなる土堤へ羊や牛の角を多く棄つる。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてこの日は、犢の冷肉を一皿とクワス一本を平らげてから、広大無辺な我がロシア帝国の地方によっては、よく言い草にされている、謂ゆる『鞴のような大鼾』をかいて寝こんでしまうことで、どうやら幕になったらしい。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでただのクワスじゃないか。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクノヨブコエワスレタカ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、いきなり、青い帖面からのまる暗記で太い声を出し、――ワス、コステッド、ダス？",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲッベルスのために放送　ドイツ人捕虜とレンラク、収容所の壁にスワスチカ〔鉤十字〕やスローガンをかく。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "並木道の入口にコップ一杯五カペイキの向日葵の種やリンゴ、タバコを売っている屋台店があり、一軒の屋台店では腸詰だのクワスだのを売っていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "胡瓜の漬けかた、クワスの作りかた、赤坊のとりあげかたを誰にでも親切に教えてやるのも、この祖母さんなのであった。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ近く（北方四マイル）にはケンルワスの古城があり、ウォリクと兩兩相竝んで壯大を誇る遺物であるが、歴史の上からも、風致の上からも、また今なほ昔の城主の遺族（ウォリク伯）が住まつてるといふ點からも、ウォリクの方が一層有名である。",
              "citation": {
                "source": "ウォリクの城",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（キムラサンシス、セトシバンジセワス、アスクニヨリオヂクルヨシ、ヘン）午後五時におせいが打つた電報は、翌日の十時頃配達になつた。",
              "citation": {
                "source": "湖畔手記",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "『さよう、ある年の春、わたしの領地の付近で、百姓たちが鉄道線路の土手で仕事をしましたが、若い農民の普通の食物は、パンとクワス（ライ麦より製したロシヤ独特の弱酒精飲料）と玉葱ですが、それでも元気で達者に生きています。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "じょうずに焼かれたパンが三いろに、葡萄酒が二本、修道院でできるすばらしい蜂蜜が二壜、それに近在でも有名な、修道院製のクワスを入れた大きなガラスの壺などが出ていた。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「もう済みましたよ」とアリョーシャは答えたものの、その実、修道院長の台所で、パンを一切れにクワスを一杯飲んだだけであった。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ドゥニャーシャに花束をわたす）ロパーヒン　ついでにクワスをおれに持ってきとくれ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ登場、ロパーヒンにクワスを差出す。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（丸薬を受けとり、手の平へあけて、ふっと吹いて口へほうりこみ、クワスでのみくだす）この通り！",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様にして、クワスでノドをうるおそうと思って手にとると、またしても、いやはや、たとえば油虫といったたぐいの、極度に無礼千万なやつがはいっている。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "或家ではクワスを飮ませ、或所ではパンを食はして呉れる。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "或家ではクワスを飲ませ、或所ではパンを食わしてくれる。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "大竜は気がついて、「これなる美女は西江大将のワスレガタミ、わが社の専務、西江葉子クン。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
