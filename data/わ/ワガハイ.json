        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "我輩、地球防衛軍は、断固として侵略者と戦う所存である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "「静粛に！ 我輩、審査員一同は、満場一致で彼の優勝を決定した」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "我輩の船は、七つの海をまたにかける冒険の旅に出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": []
        }
