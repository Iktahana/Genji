          "literary": [
            {
              "text": "氷上の公魚釣りも、趣が深い。",
              "citation": {
                "source": "わが童心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "山中湖は深いので秋の公魚釣りはなく、氷が張りつめてからの穴釣だけである。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分で造るにも寒い諏訪では無理になつて心細くなつて居た時、偶々公魚釣りのお弟子の実業家が、瀬戸から土産にもつて来てくれて、それ以来瀬戸から仕入れる事にしてやつと安心したのであつた。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
