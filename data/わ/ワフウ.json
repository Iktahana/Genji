[
  {
    "uuid": "7d8bebbf-fad2-548a-b5ac-26a323b716f7",
    "entry": "和風",
    "reading": {
      "primary": "わふう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
