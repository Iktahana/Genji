        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "窓から心地よい和風が吹き込み、部屋の中を通り抜けていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夕焼け空の下、和風に揺れる木々の葉が美しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この季節は、いつもより和風を感じることができて気持ちがいい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
