[
  {
    "uuid": "01634814-40b6-5c2a-a5b4-8c6f4aee6a82",
    "entry": "ワングリ",
    "reading": {
      "primary": "わんぐり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
