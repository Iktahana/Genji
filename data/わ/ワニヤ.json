        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "当時は、クリミヤ人でござれ、波蘭人でござれ、乃至はリトワニヤ人でござれ、どれもこれも世界を股にかけて渡り歩いたものぢや！",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからマツシヤが今の婿のワニヤが好きになりました。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワニヤは善い人でございますが、不為合な事には病気でございます。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワニヤは此土地で好いお役をしてゐました。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにワニヤは辛抱が出来ないで、とう／＼辞職いたしました。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のリベラリズムは、かの、「鳥料理レエヌ・ペドオク」の主人公、アベ・コワニヤアルを想はせた。",
              "citation": {
                "source": "世界覗眼鏡",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
