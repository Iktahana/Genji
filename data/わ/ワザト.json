[
  {
    "uuid": "4cf5db28-95dd-52fc-94c6-eb9ecf36ffb3",
    "entry": "態と",
    "reading": {
      "primary": "わざと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
