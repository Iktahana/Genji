    "definitions": [
      {
        "index": 1,
        "gloss": "to well up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼のスピーチを聞いて、聴衆の中から感動の拍手が沸き起こった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "その不正な決定に対して、市民の間から大きな抗議の声が沸き起こった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼女の心に、故郷への懐かしい思いがふと沸き起こった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "身動きもせぬ人々のその影は、いまにも沸き起こる悪魔の荒びの一瞬前の静寂のように、神秘とも凄惨とも云おうようなく見えました。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と耐らぬ自嘲の念が沸き起こる一方、考えてみれば、ついこの間まで水茶屋をかせいでいた自分、当り矢のお艶が夢八になったところで大した変りもないではないか。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "信じてください、私は純粋に心から沸き起こる動機で動いているのです。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が真からあこがれたのは、思いもかけぬときにとつぜんわきおこる惨事、あるいは何か新奇な事変から生ずる溌剌たる、そして尖鋭ななやみそのものであった。",
              "citation": {
                "source": "或る精神異常者",
                "author": "モーリス・ルヴェル",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤旗とプラカートがわきおこる音楽の上に林立していたモスク※のメーデーの街々が思いくらべられた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜の花蔭に、掛けつらねた小袖幕と、極彩色の屏風と、そして眼もあやな娘たちと衣装と、これらの絢爛たる丹青のなみの中からわきおこる琴曲の音いろと、すべてがあまり美しくて、見る者はむしろ哀愁をおぼえるくらいだった。",
              "citation": {
                "source": "日本婦道記",
                "author": "墨丸",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に我れながらさもしい卑屈な感想の湧き起るのを禁じ得なかった。",
              "citation": {
                "source": "大雨の前日",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "隅の方に坐つて彼女の不幸を悲しみながらも、その病氣のために自分の研究の中挫したのを殘念に思ふ程の餘裕を有つてゐた彼れは、この有樣を見て、そんな事を考へてゐた薄情さを悔むと共に、ほんとに眞劍な同情が勃然として湧き起るのを感じた。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――記憶も、去るにあらずや……湧き起る歓喜のためには　人の情けも、小さきものとみゆるにあらずやああ、神様、これがすべてでございます、　尽すなく尽さるるなく、心のままにうたへる心こそ　これがすべてでございます！",
              "citation": {
                "source": "夏は青い空に……",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうとう意志を強くして、具体的の事実の上にしっかり手綱を引き締めて行かなければ、そこが違うんでしょうねえ」　けれども、一たんむす子へ萌した尊敬の念は、あとから湧き起るさまざまの感傷をも混えて、昇り詰めるところまで昇り詰めなければ承知出来なかった。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その掃蕩に当って心すべきことは、この章のはじめに述べましたように、誤解は人生の機構上、無尽に湧き起る性質を持っております。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "對比させること、さうしてそこから湧き起る感情は、平凡陳腐なるものであつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、あの、七年前の煽情的な事件を思い出すと、投げようとする僕の中に、又、新な勇気が湧き起るのだったんだ。",
              "citation": {
                "source": "殺人迷路",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、湧き起る合唱と香煙の渦の中を、裏庭の墓※をさして運ばれて行ったのである――閉幕。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウルリーケはこもごも湧き起る回想のために、しばらくむせび泣きしていたが、やがて歩を返し、つづいて艇長の最期を語るために、詩人の犬射復六が朝枝に連れ出された。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はというと、間もなくその猫に対する嫌悪の情が心のなかに湧き起るのに気がついた。",
              "citation": {
                "source": "黒猫",
                "author": "THE BLACK CAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして何かしら学問上の実験に使おうとしているのではあるまいか……というような疑いが、チラリと頭の中に湧き起ると、見る見るその疑いが真実でなければならないように感じられて、頭の中一パイに拡がって来たのであった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、やがてそのようなあらゆる感情が雲のように湧き起るのをやっと押し鎮めて、平生の理智を取り返して来ると、私は眼の前に面を伏せている少年の姿に、驚異の眼を注がない訳に行かなかった。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて拍手の音が演技場の四方から湧き起ると豪快な露西亜国歌「戦い熟せり。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その端々、隅々から赤や、青や、茶色の焔がポーッと燃え上るたんびにそこいら中が明るくなって、又、前にも増した暗黒を作って行く物すごい光景を、薄板工場の中から湧き起るケタタマシイ雑音の交錯が伴奏しつつ、星だらけの霜の夜を更けさせて行く。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "汗じみた、甘鹹い手の甲の皮膚をシッカリと…………て気を散らそうと試みた……が……しかしその手の甲の肉から湧き起る痛みすらも、一種のタマラない……………のカクテルとなって彼の全身に渦巻き伝わり、狂いめぐるのであった。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "またも湧き起る爆笑と、続いて起るゲラゲラ笑いとを、華やかに渦巻くジャズの旋律と一緒にフロックの背中に受け流しながら、愴惶として階段を駈け降りた。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の事を、他の事を、斯んな種類の悪は自身で自然に湧き起る力のないことを！",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた海から湧き起る恐しい唸り声――随分長く聞えていました。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして階下から湧き起る警官隊の大声と階段を荒々しく駈けあがってくる靴音とを、夢心地に聞いた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　忽ち湧き起る四人の子供たちの叫びが私を包んだ。",
              "citation": {
                "source": "樹木とその葉",
                "author": "地震日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間うちから、スエコと話している事ですが、心の内に次から次へと湧き起る色々の心持や考えを、一旦言葉に出して、それを人の手で字に写してゆくと云うことは、何と困難な、時にはバツの悪い、しかもいつも云いたいことはとことんの処で云い残されていると云う工合の悪いことでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "極度の静謐、すっかり境界がぼやけ、あらゆる固執を失った心と対象との間に、自ら湧き起る感興、想念と云うもので先ずその第一歩を踏み出すのが創作の最も自然な心の態度らしく感ぜられ始めたのである。",
              "citation": {
                "source": "透き徹る秋",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "動かぬ死に向って床の上に目を醒し、牢の中にも漂う朝の空気を感じた時、彼の心にどんな愛が湧き起るか！",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "愈々自分の見識で、この皿を贋物と判定してしまうと、奇妙なことに日下部太郎は、今迄とまるで異う一種の愛着が、この皿に対して湧き起るのを感じた。",
              "citation": {
                "source": "伊太利亜の古陶",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
