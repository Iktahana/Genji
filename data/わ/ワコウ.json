  {
    "uuid": "8b1b3554-38c0-57a2-8dd2-0972fa856280",
    "entry": "和光",
    "reading": {
      "primary": "わこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "和光同塵とは申せども、神境、佛地である。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが三年間浪人して、一九七五（昭和五十）年に和光大学の人間関係学科に潜り込んだころ、古川が趣味としていたエレクトロニクスの世界に異変が起ころうとしていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "高校卒業後三浪して、古川は和光大学に籍を置いた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、顔を横に振りながら「否、否、垂迹和光の月明らかに――」　と、絶叫して、戒刀で上を指した。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「摂」とは摂受の意味で、つまり和光｜同塵、光を和らげて塵に同ずること、すなわち一切の人たちを摂めとって、菩薩の大道に入らしめる、善巧な四つの方便が四摂法です。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "弁護士界の長老である正木、長野、和光、吉田などをこめる十一名の弁護士がこの公判に参加している。",
              "citation": {
                "source": "それに偽りがないならば",
                "author": "――憲法の規定により国民の名において裁判する――鈴木裁判長",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に二銭の団洲と呼ばれた、和光の不破伴左衛門が、編笠を片手に見得をしている。",
              "citation": {
                "source": "将軍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴎外翁は、所謂、讃めて言ふと、和光同塵と申すのでせうか。",
              "citation": {
                "source": "芝居に出た名残星月夜",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "持山　　（その方に）あゝ、和光さんだね。",
              "citation": {
                "source": "雅俗貧困譜",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "和光さん、寒いから、外套を着たまゝでいゝよ。",
              "citation": {
                "source": "雅俗貧困譜",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "持山　　（印刷屋に）君は、和光さん。",
              "citation": {
                "source": "雅俗貧困譜",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "四神相応の地をしめし、後に浅間山日光山そびえ、東に筑波山、西に富士山箱根山軒端につらなり、和光の影に曇りなく仏法を守護し給ひ、月真如の光をかゝげ、前には生死の海まんまんとして波煩悩のあかをすゝげば、無始の罪障も消滅すると覚えたり。",
