[
  {
    "uuid": "152ad85f-91e2-580a-af1f-b8956be12c4f",
    "entry": "割り切る",
    "reading": {
      "primary": "わりきる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
