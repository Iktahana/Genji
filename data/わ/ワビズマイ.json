    "definitions": [
      {
        "index": 1,
        "gloss": "solitary life",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山奥で静かな侘住いを送っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は世俗を離れて、侘住いを楽しんでいるようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "都会の喧騒を離れ、簡素な侘住いを選択した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "それは多分、蕪村自身が窮乏しており、終年裏町の侘住いをしていたためであろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一　猿寺の侘住いに遷った香以は、山城河岸の店から受ける為送の補足を売文の一途に求めた。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の知らない遠い片田舎に、今の奥さまが、まだ新嫁でいらしッたころ、一人の緑子を形見に残して、契合た夫が世をお去りなすったので、迹に一人｜淋しく侘住いをして、いらっしゃった事があったそうです。",
              "citation": {
                "source": "忘れ形見",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうなれば、無論、田舎の侘住いも、これでなかなか面白いものでしょうがね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘麓の片側町三十何戸は半数まで陸軍将校の侘住いである。",
              "citation": {
                "source": "閣下",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
