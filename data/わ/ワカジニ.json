[
  {
    "uuid": "df888904-33c5-5f50-9f5a-11507111fb70",
    "entry": "若死に",
    "reading": {
      "primary": "わかじに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
