        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "風邪を引きそうだ……」「船長を呼べ船長を呼べ……」　とワメキ出したのには呆れ返ったよ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は黙って、その給仕に案内されて広やかなコルク張の階段を昇って行ったが、登って行くにつれて、階中に満ち満ちている高潮したレコードと舞踏のザワメキに気が付いた。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに連れて舞踏のザワメキが中絶して、シインとなったと思う間もなく、タッタ今閉まった扉が向側から開かれて、赤白ダンダラの三角の紙帽を冠ったタキシードが五、六人ドヤドヤと雪崩れ込んで来て、私の眼の前の長椅子に重なり合って倒れかかった。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "目の血ばしった青年、片そでのちぎれた若者、振りみだした髪を背になびかせて走っている少女などが、みな口々にワメキ叫んでいた。",
              "citation": {
                "source": "赤旗事件の回顧",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "キワメテアタリマエノコトナノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタガツテ楷書ノ活字トカタカナノ活字モマタキワメテ調和ガヨイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし何のザワメキも鐘の声も聞えないところから見れば、それはまず当っていなかった。",
              "citation": {
                "source": "火葬国風景",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻シノブ、侍女キミ子及びカヨ子、三名の者は、まったくただ一人の人間です」　その奇妙な答弁を待ちかまえていたらしい人々は、ここに至って緊張を破り、思いのままにザワメキを起した。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのザワメキは人々がすでに全く同一の結論を得て論争の余地もなくなったことによる余裕や安らぎを表していた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴高は人々のザワメキが静かになるまで浮かない面持で身の持て扱いに困じ果てているようであったが、満堂のザワメキがおさまると、改めて威儀を張り、「宗久どの。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗久はすでに人々のザワメキが起ったとき、人々の心中に起った思いを読みとったのであろう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのザワメキを身に浴びたとたんに、彼は一切の意志したものを投げて、すべての気乗りを失った様子であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が第三の問いに答えた時に人々のザワメキが起った。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのザワメキが示している意味に応じて、彼はにわかに総てを投げた人の態度を示したようであったというが、その反応は、三人の女の姿の一人ずつ入れ代っての現れに応じて起ったものではなくて、それに対する自身の信ずる正しい応答を終ってのちに、人々のザワメキに応じて起ったものであった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、およそ俗と下根なところのない現実の幸福と満足でいっぱいだった父母の太陽夫妻によって、全然生きた神様の教育だけ受けたこの女帝が、身辺をめぐる多くの陰謀のザワメキを処理して殆ど誤っていないのだから、その生得の叡智と威風は然るべきものであったに相違ないと信じうるのである。",
              "citation": {
                "source": "安吾史譚",
                "author": "道鏡童子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四五人の乗客がプラットフォームに降り立って足音をさせながら改札口に来て切符を渡して待合所を通りぬけて出て行くザワメキ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「え、寄るな／＼、見世物ぢやねえ、まご／＼すると掛り合ひだぞ」　露拂ひのガラツ八が持前の鹽辛い地聲でワメキ立てながら、人波をかきわけて中へ潜ると、「お、錢形の兄哥、丁度宜い鹽梅だ」　元町の文七はホツとした顏になりました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お此お糸",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く來て見て下さい」　下男部屋は母家に續いた物置の一部で、其處へ飛込んだ八五郎は下男圓三郎の容易ならぬ姿に手を下し兼ねてワメキ立てるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "闇に飛ぶ箭",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ポストの千種十次郎ですよ」　早坂勇の無遠慮にワメキ立てる声も聞えます。",
              "citation": {
                "source": "笑う悪魔",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前が路地でワメキ散らすのを、曲者は何処かに隠れてやり過しているかも知れない。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん重大な世界的の発表と言ったからとて、日本のそれのように一同着席、座のザワメキが落ちついた頃を見計らって、両博士静々と登場、咳一咳オホン！",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "下女のお六が、誂へ向きにワメき立てて、庵崎もお前も飛んで行つた」「何んだつて、あつしなんかを泊める氣になつたんでせう」「八五郎に氣があつたのさ」「冗談でせう」　と。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女護の島異變",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘエ、ヘエ、ヘエ」　其の儘大地へへた張りそうになった清作、その上へ嵩にかかって、「何処へ行くのだ、不届者、入山禁制の制札が見えぬかッ」　六尺棒を鳴らしてワメキ立てるのです。",
              "citation": {
                "source": "天保の飛行術",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラッ八の八五郎は、それを後ろに聞いて、お勝手から、瓢々斎の部屋を捜しておりますが、「親分、恐れ入った、――さすがは見通しだ」　何やらワメき散らしながらやって来ます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "瓢箪供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウメキ、ザワメキ、ガラメキなどはもと水の音を形容した地名であるが、瀬の早い川の岸にある部落または田畑で百目木、沢目鬼などという例はいくらもある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
