        "examples": {
          "standard": [
            {
              "text": "昔の書物には、別名『忘れ草』とも呼ばれる植物について書かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "庭に植えた忘れ草が、今年は特にきれいに咲いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古くから忘れ草は、悲しみを忘れさせてくれる花として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
