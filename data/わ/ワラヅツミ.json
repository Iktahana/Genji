          "literary": [
            {
              "text": "宿は※送問屋のやうなかまへで、藁包みの積み上げてある荷物の横から、女中の案内で二階へ上つた。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁包みの荷物のわきに、ゆき子は蹲踞みこんだ。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして公孫樹は、枝をすっかり切り落され、全部藁包みにされて、庭の隅に淋しくぽつりと立っていた。",
              "citation": {
                "source": "公孫樹",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議に思って、そっと覗いて見ると、月の光がぼんやり落ちている庭の植込の向うの、藁包みの公孫樹の根本に、老人がしょんぼり立っている。",
              "citation": {
                "source": "公孫樹",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
