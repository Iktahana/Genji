        "examples": {
          "standard": [
            {
              "text": "ストレスが溜まりすぎて、ついに患いついてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "無理が祟って、急に高熱を患いつくことも珍しくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "最近の不摂生で、風邪を患いつくような予感がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「実はね、津の国屋の惣領娘がわずらいつく二、三日まえの晩に、近所の者が外へ出ると、町内の角で一人の娘に逢った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            }
          ]
        }
