        "examples": {
          "standard": [
            {
              "text": "お茶請けに、さっぱりとしたわさび漬けをいただいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "お土産にわさび漬けを買ってきたので、ご飯のお供にしよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "わさび漬けのピリッとした辛さが、日本酒によく合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "○湯河原町の名物、椿油、きび餅、わさびづけ、みかん。",
              "citation": {
