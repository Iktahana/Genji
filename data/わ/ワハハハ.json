          "literary": [
            {
              "text": "ワハハハハハ」　若い僧は朗らかに笑って礼を言って行きかけた。",
              "citation": {
                "source": "とと屋禅譚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「直参旗本早乙女主水之介様御宿」「ウワハハハ、わが文字ながらなかなかに見事よ喃。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワハハハハハ」と無理に大きな声で笑って見せたが、腑の抜けた勢のない声が無意味に響くので、我ながら気がついて中途でぴたりとやめた。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう威張るほどの字でもないて、ワハハハハ」「時に和尚さんは、誰を習われたのかな」「わしか。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワハハハハ」とシワルドは傍若無人に笑う。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「主が女に可愛がられたと云うのか」「ワハハハ女にも数多近付はあるが、それじゃない。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人も迷亭もちょっと驚ろいて表の方を、垣の隙からすかして見ると「ワハハハハハ」と笑う声がして遠くへ散る足の音がする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとまた垣根のそばで三四人が「ワハハハハハ」と云う声がする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハサヴェジ・チーだ、サヴェジ・チーだ」と口々に罵しる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒で死ぬ奴あ鰌ばっかりションガイナと来た」「トロッコの下で死ぬよりよかろ」「お作どんの下ならなおよかろ」「ワハハハハ」「おい。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから馬が共鳴して暴れ出したんだろう……馬い話だってんで……」「アハハハ……違えねえ」「ワハハハハハハ……」「しかし三万円は大きいじゃねえか。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハハハハハハ……お伽話だ……地底の蜃気楼……アッハッハッフッフッフッ……アスタ・セガンチニ……あの近眼婆さん……オースタリ人の志村のぶ子……アハハハハ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハハハハハハ……｜お伽話だ……｜地底の蜃気楼……アッハッハッフッフッフッ……アスタ・セガンチニ……あの近眼婆さん……オースタリ人の志村のぶ子……アハハハハ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の小便なら縁起が宜いかも知れねえ」「人をつけ……ウラハラだあ……」「ワハハハハハ」　……だってさあ……こんな事を云い合って呑気そうに笑いながら、その男たちは又四ツばかり叫び声を担ぎ上げたの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワハハハハハハハ」　兼は大口を開いて笑いながら私たちを見まわした。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワハハハハ」　と訳のわからない事を喋舌って噪ゃいでいるうちに、ゴトンゴトンと音を立てて出て行った。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞあしからずってね……ワハハハハハハハ」「マア意地のわるい……オホホホホ……」「…………………………………………」",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハハハ」「ワハハハハハ」　手錠をかけられた男が恐ろしく面を膨らました。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭山が書を頼まれる世の中になってはモウイカン、世の中はオシマイじゃワハハハハハハハ……」　そこいらに遊んでいる子供等が皆、ビックリして家の中へ逃込んだ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "痳疹の神様様じゃ」「ワハハハハ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "心は、インチキがお嫌い……と言う訳かな」「ワハハハ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワハハハ」　なぞ言う無邪気な主人翁の愛嬌話のうちにお茶席に案内をされて、名にのみ聞きし懐石なるものが出た。",
              "citation": {
                "source": "お茶の湯満腹談",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "見込みがあるぞッ」「ワハハハハハ……」「フフフフフフ……」　昂作はそんな笑い声を耳にしながら、静かに頭を横にして起き上りかけた。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで一杯行こうぜ……アハハハハハハ」「ワハハハハハ」　そんな事でその時は済んだが、サテそのあくる日の正午近い頃であった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "女難に重なる女難に、源三郎は、その切れのながい眼をパチクリさせて、かたわらにすわっている左膳をかえりみ、「これはいったいなんとしたのだ、左膳」「ワハハハハハ、おれがいたとて、遠慮は無用だ。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "男達は咄嗟に何を聯想したのか、期せずして一時にワハハハハと噴き出してしまった。",
              "citation": {
                "source": "霧",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ワハハハハハハ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、このとき、何処からか、不意に、「ワハハハハハハ」　と、突破ったような笑声が起った。",
              "citation": {
                "source": "怪奇人造島",
                "author": "寺島柾史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
