        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ワーシカがやられた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペーチカへ、白樺の薪を放りこんだワーシカは、窓の傍によって聴き耳を立てた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、来ているぞ」　ワーシカは、二重硝子の窓に眼をよりつけるようにして、外をうかがった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "警戒兵としての経験からくるある直感で、ワーシカは、すぐ、労働組合の労働者ではなく、密輸入者の橇であると神経に感じた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方では、飲酒反対、宗教反対のピオニールのデモを見習った対岸の黒河の支那の少年たちが、同様のデモをやったりするのに、他方どうしても、こちらの、すきを伺っては、穀物のぬすみ喰いにたかってくる雀のように、密輸入と、ルーブル紙幣の密輸出を企てる支那人があるのを、ワーシカはいまいましく思った。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ワーシカは氷を踏んで進んだ。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ワーシカは、すぐ折敷をして、銃をかまえた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカは引鉄を引いた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ワーシカは、夜が短い白夜を警戒した。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカがこれを見た。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカは、一種の緊張から、胸がドキドキした。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ワーシカは、ひょくんとして立止った。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカは、ポカンとして、しばらくそこに不思議がりながら立っていた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、間もなく、ワーシカの疑問は解決された。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカ・コルニコフ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "名前はワーシカ・コルニコフと申します。",
              "citation": {
                "source": "死後の恋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカもニキータと同じ青年共産主義同盟員で村の牧童だ。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニキータ、ワーシカ、ニーナなんかがトラクターとピムキンとを見張ってるのだということが、ペーチャにわかった。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカがピューッと音をさせて鞭を振り、　――え、おい！",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカとニーナが一抱えの乾草と手風琴をとって来た。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカは口笛で合の手を入れ、ニーナが前歯の間でひまわりの種をわりながら、　　お婆さん、石鹸おつかいな。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカの声とを聞いた。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターニャはちぢれっ毛のイリーナや、氷滑選手のワーシカなんかとやった。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと云って、字を知っている奴は村の富農のワーシカだとしたら、そのワーシカにソヴェトの仕事がまかされるだろうか？",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
