  {
    "uuid": "17b746c4-dc15-5b36-b868-acc928032897",
    "entry": "わーん",
    "reading": {
      "primary": "わーん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "奇妙な音がうわーんと彼らの耳を衝いた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあげく、どどどーん、ぐわーんという大爆発だ。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐわーん、めりめりめり、ばらばらばらと、なにが飛ぶのか、根拠地の奥の方ではひっくりかえるようなさわぎだ。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっと思ったが、もう遅かった、ぐわーん、どどーんと大きな音とともに真白な煙が室内に立ちのぼった。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして思わず川島が、両手を口に当ててメガホンのようにし「洋子さあーん」　と呼んで手を振ったのに、いや、却ってその声が、あたりの森の中にわーんと泌込んで行ったせいか、彼女は、その美しい顔を泣き笑いのように歪めると、ぱっと身を飜えして木々の間に消え失せてしまったのだ。",
              "citation": {
                "source": "植物人間",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三畳敷ほどのその風呂場の空間には、わーんといふ太い唸りが、一本になつて立ち昇つてゐる。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わーん、ちやんが、ちやんが、親分」　小伜はもう他愛もありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "遺言状",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わーん、ちゃんが、ちゃんが、親分」　小倅はもう他愛もありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "遺言状",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだか辺鄙な山の湯にでも来たようで、老人がよく「うちの庭ではほととぎすが聞ける」と云っていたのを思うにつけ、こう云う時に啼かないものかなと耳を澄ましたが、聞えるものは何処か遠くの田圃の方で雨を呼んでいる蛙の声と、わーんと云う蚊の啼きごえばかりである。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の肌の下で、幼な子が、わーんッと、泣き出したのも一しょだった。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一休さんは　わーんと　なきだして　しまいました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん親しくなり、そのうちに父上の危篤の知らせがあって、彼はその故郷からの電報を手に持って私の部屋へはいるなり、わあんと、叱られた子供のような甘えた泣き声を挙げた。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつきから線路の左がはで、ぐわあん、ぐわあんとうなつてゐたでんしんばしらの列が大威張りで一ぺんに北のはうへ歩きだしました。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍歌はただのぐわあんぐわあんといふうなりに変つてしまひました。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐘は嗄れた声でごわあんとわめいた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてミツちやんが、わあんと泣き出しても、みむきもせず、弓の工合が悪くなりはしなかつたかどうか、仔細に調べた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人は耳をすましてきいていたが、余韻がわあんわあんと波のようにくりかえしながら消えていったばかりで、ぜんそく持ちの痰のような音はぜんぜんしなかった。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "――わあん／＼／＼！",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供は飛蝗のやうに水を藻掻いて深く沈んで浮き上るときんぎよのやうに口を開いてわあんと一声泣き、再び沈んで今度はいくら待つてゐても浮き上つて来なかつた。",
              "citation": {
                "source": "白痴",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしね、藪さんが来てくれないつて、わあん／＼泣きだしちやつたのよ。",
              "citation": {
                "source": "蒼茫夢",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やっぱりあたくしフローレンスにちがいないのね、だったらあたくしあのせせこましい小屋にうつり住まなきゃいけないことになって、しかも遊ぶおもちゃもろくにないの、うわあん！",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やっぱりあたくしメイベルにちがいないのね、だったらあたくしあのせせこましい小屋にうつり住まなきゃいけないことになって、しかも遊ぶおもちゃもろくにないの、うわあん！",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "露の音すら耳だつ暁方の静寂を破って、ふいに、ぐわあん！",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "うわあん……鐘の鳴るような唸りが起って、満天満地に蠅が舞い立ち、ために、一天の陽もなお晦いほどだった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "出してくれなければ火をつけるぞう」　そして、わあん、わあん、と吠えるように泣いていたが、夜半近くになると、泣寝入りに寝てしまった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "わあん……　と、手を折ったり、瘤をこさえたり、血だらけになって降りて行く子が、多勢の中にはきっと二、三人ずつ出来た。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "首を締められる者の叫び声、窒息する者のみじかい、くっくという喘ぎ、締めつけられた咽喉の、おしころされたごぼごぼという音などが、いま彼が囚われて生贄として立っている四つの壁の間を往き来して、わあんわあんと反響した。",
              "citation": {
                "source": "秘密礼拜式",
                "author": "アルジャナン・ブラックウッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二人の必死の努力の甲斐があって、ロープは一インチづつゆっくり手繰られ、やがてすごい水音が聞えたのと同時に、とても言いあらわせないような恐怖の絶叫が、竪坑の底からわあんと反響してきた。",
              "citation": {
                "source": "井戸",
                "author": "Ｗ・Ｗ・ジェイコブズ",
                "note": "青空文庫"
              }
            },
            {
