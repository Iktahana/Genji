          "literary": [
            {
              "text": "ワタシノ母サン、ヤサシイ母サン。",
              "citation": {
                "source": "作家の手帖",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノゴチソウデス」　あるじは固くなって言った。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは誰だと、若い女に聞けば、ワタシノダンナサンノオ母サンと答へた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは誰だと、若い女に聞けば、ワタシノダンナサンノオ母サンと答えた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　カタナハ　ヨク　キレル。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　イママデ　ウツカリシテ　ヰタケレド、ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルデハ　ナイカ」　コノ　カナシミハ　ドウ　シタラ　ヨイデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルノデス」ト　ハジメノ　デンデンムシガ　ハナシマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカニモ　カナシミハ　イツパイデス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカニモ　カナシミハ　イツパイデス」　ソコデ、ハジメノ　デンデンムシハ　マタ　ベツノ　オトモダチノ　トコロヘ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　カホヲ　ミテ　ワラツタワ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ　イロイロ　カンガヘテカラ、マタ　マエノ　ラツパト　オナジ　ラツパヲ　オクツテ、「コノ　ラツパヲ　ミミニ　ツケルト　ワタシノ　コヱガ　キコエマス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストノ　ウエニ　トマツテ　ヰタ　スズメガ、「アレハ　ワタシノ　カゲダワ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　トクイサウニ、「アレハ　ワタシノ　カゲダ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……中に、ステパンの会話の力で判断してだろう、片仮名で、「オナツカシキペテロフサマ、ソノゴオカワリモアリマセンカ、ユウベ、マテイタノニキテクダサイマセン、ナゼデスカ、シドイシト、ワタシノココロモシラナイデ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、アナタ、モウ、ワタシノモノアリマス、逃ゲラレマセン」「ばかにおしでないよ、お前さんなんて、ウスノロのくせに」「アナタ、モウ、ワタシニ許シタデス、ワタシモウ、アナタ離サナイデス」「しつこい奴ね」「アナタ、ワタシノモノデス」「あ、畜生！",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシノホシヘ、ツレテイク、ソシテ、ホシノヒトニ、ウツクシイ、チキューノ、オンガク、キカセル。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノナマエモ、Ｒトシテクダサイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノホシデハ、ウチュウノコト、ミナ、シラベテ、ワカッテイルノデス、ワタシ、チキュウノニンゲンヨリ、百バイ、カシコイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ、ワタシノホシデ、コシラエタノデス。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシノコト、ダレニモイッテハイケナイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノコトワ、本ヲヒロウタ人ニキイテ下サイ、サウシテワタシヲ此所カラダシテ下サイ、アナタワ、キレイデ、カシコイ人デスカラ、キツト助ケテ下サイマス。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
