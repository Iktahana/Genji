          "literary": [
            {
              "text": "曾つて之を争ひしが為めにワルレンスタインは悲苦の境界に沈淪したり。",
              "citation": {
                "source": "罪過論",
                "author": "石橋忍月",
                "note": "青空文庫"
              }
            },
            {
              "text": "又レッシングの「ガロッチー」シルレルの「ワルレンスタイン」も亦た皆な然らざるはなし。",
              "citation": {
                "source": "罪過論",
                "author": "石橋忍月",
                "note": "青空文庫"
              }
            },
            {
              "text": "シルレルは既に、一七九八年に、其の「ワルレンスタインの戦」の上場の際に云っている。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は初め当時全盛のワルレンスタインのためにその運勢を占う占星図を作製したのであるが（第十四図）、後にはついに占星学上の計算をすることを謝絶するに至ったということはケプラーのために特筆すべき事実である。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "第十四図　ケプラーの作ったワルレンスタインの運勢を占う占星図。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            }
          ]
