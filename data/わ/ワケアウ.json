        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちが大切なおもちゃを分け合っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "経験を分け合うことで、互いの理解を深めることができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼らは成功の喜びを分け合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "九本の一升瓶をずらりと一列に並べて、よくよく分量を見較べ、同じ高さずつ分け合うのである。",
              "citation": {
                "source": "十二月八日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、仲好く分け合うのだ。",
              "citation": {
                "source": "心の王者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋と家賃を分け合うなら、私など打ってつけの男ではないか。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "分け合えば分け合うほど、我々は多くを得るでしょう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり活きておりましたら、何彼につけて頼みにもなり、嬉しいことも楽しいことも、分け合うことが出来ますのに。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人が豊饒のまっただなかに暮し、万人が自然の恩恵を平等に分け合う社会状態においては、かかる感情は必ずや消失してしまうであろう。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "質屋の内情を知り、友達と最後の六ペンスを分け合うようになる頃には、ずっと優しい、いい女になるよ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "政治はもとより、われわれ文化人も働きかけて、もっと広い全土にお互いに文化を作用し合って幸福を分け合う、それがきょうの文化の日に思うことである。",
              "citation": {
                "source": "文化の日",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、わが物は何なりと、欲しくば、仲よく分け合うて持ち去るがよい」「…………」　忽ち、すすり泣きが流れた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "連れの諸子にも、仲よく分け合う。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時「感激」がどんなにはげしくても、そして、その「感激」をわけあう男の人たちが数人集ったにしろ、仕事そのもののじみな本質は必ず経済問題にぶつからずにはすまない。",
              "citation": {
                "source": "その人の四年間",
                "author": "――婦人民主クラブの生い立ちと櫛田ふきさん――",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちは、ひとと睦じくすることの魅力をしみじみと感じ、互いに喜びをわけあうようになり、親しく寄りあうのだ。",
              "citation": {
                "source": "クリスマス",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは、そんな二人の少年｜乞食のような姿でわずかな食事をわけあうぼくと山口とに、まるで人目をしのぶ泥棒ネズミのような、ある隠微な、みすぼらしい友情がつながっているのをかんじる。",
              "citation": {
                "source": "煙突",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お民の兄であるからと言うばかりでなく、同じ街道筋の庄屋仲間として互いに心配を分けあうのも寿平次だ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "死んだときも常子が行って、後で問題が起きない程度に始末をし、これで厄が落ちたと胸を撫でおろしたが、山川のほうは、秘密を分けあうものがいることで、いくらか慰められていたのに、リーナの死で漏泄の道がなくなり、孤独感でおしつぶされそうになった。",
              "citation": {
                "source": "蝶の絵",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠州から、土佐から、大阪から、日向から、出た港はそれぞれにちがうが、おなじ潮の流れにみちびかれてひとつの島に溜まり、ともしい食物を分けあうというのは、ただならぬ因縁事と思うが、こういう大人数に成上り、二十人の男どもがいいほどに餓えを凌ぐのに、島の幸だけでは事足らぬようになった。",
              "citation": {
                "source": "藤九郎の島",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "食うものがなければ、水を飲めといってくれればいいので、苦労を分けあうこそ、夫婦というものなのではなかろうか。",
              "citation": {
                "source": "奥の海",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は森のなかで、ときどき木の根もとに腰をおろして、ウルフと弁当を分けあうのだった。",
              "citation": {
                "source": "リップ・ヴァン・ウィンクル",
                "author": "ディードリッヒ・ニッカボッカーの遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "ましてや、その堅い交友の良心の上に築き得た成果の歓びを、互いに分けあう日に恵まれたのである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな愉快なこともこれを分けあう相手がなくては、わたしにとって味気ない。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か愉快な思いが胸に浮び上るたびに、わたしは分けあう友もないのにただ一人でそれを産み出したことを、悲しく思わないことはない。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
