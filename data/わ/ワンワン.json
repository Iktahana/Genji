  {
    "uuid": "82976241-28e2-524c-b61e-49d056b75567",
    "entry": "わんわん",
    "reading": {
      "primary": "わんわん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこで私は、橋や荷足を見残しながら、　　レストオランに這入るのだ――わんわんいふ喧騒、むつとするスチーム、　　さても此処は別世界。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、うっかり注射でも怠ろうものなら、恐水病といって、発熱悩乱の苦しみあって、果ては貌が犬に似てきて、四つ這いになり、ただわんわんと吠ゆるばかりだという、そんな凄惨な病気になるかもしれないということなのである。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちど先生に連れられて、クラス全部で、上野の科学博物館へ行ったことがございますけれど、たしか三階の標本室で、私は、きゃっと悲鳴を挙げ、くやしく、わんわん泣いてしまいました。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "喪主らしい男は、一人だけ粗麻の喪帽をかむり、泣き女はわんわんほえながらあとにつゞいていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供のキャッチボールのそれ球をわんわんのように這って椽の下にさがしに行ったりどろだらけな靴下をつくろってやることもあります。",
              "citation": {
                "source": "家庭愛増進術",
                "author": "――型でなしに",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ふるさとも可懐しい、わずかに洋杖をつくかつかぬに、石磴の真上から、鰻が化けたか、仙人掌が転んだか、棕櫚が飛んだか、ものの逞ましい大きな犬が逆落しに（ううう、わん、わんわん！",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝早く、おやゆび姫は目をさまして、自分がどこにいるか気づくと、わんわんとはげしく泣きだしました。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "蚊の群がわんわんうなって二人に襲いかかった。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして蜜蜂に体のめぐりをわんわん飛び廻らせながら一人一人やってきて大きな手で私の手を堅く握ってくれた。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりの犬たちが出て来て、店の中へもぐりこもうとでもしますと、やせ犬はうゝうときばをむいておいまくり、うろんくさい乞食が店先に立つと、わんわんほえておいのけてしまいます。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の毒千万、蜂の巣わんわん、――久方ぶりの酒だから、金丸は酔うたです、こら女！",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳が垂れて、尾が巻いて、わんわん云う声を出しているかも知れません。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョウフクインの　うらの　やぶの　なかに、やぶっかが　わんわん　なきました。",
              "citation": {
                "source": "ひよりげた",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "わんわんわん、と長く余韻がつづいた。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "坑の中は反響が強いので、初さんの言葉がわんわんわんと自分の耳へ跳ねっ返って来る。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶんぶん、わんわん云うて窓から、戸口から、開きから、いやしくも穴の開いている所なら何の容赦もなく我勝ちに飛び出した。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「降参しねえか」「しねえしねえ」「駄目だ駄目だ」「出てこねえ」「落ちねえかな」「落ちねえはずはねえ」「吠えて見ろ」「わんわん」「わんわん」「わんわんわんわん」これから先は縦隊総がかりとなって吶喊の声を揚げる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わんわん」　小供は犬の真似をしていた。",
              "citation": {
                "source": "八人みさきの話",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しつきりなしに耳の中でわんわん音がするので、あたしよく片足をあげては立ちどまつて扉の外に聽耳をたてるのよ。",
              "citation": {
                "source": "狂人日記",
                "author": "ZAPISKI SUMASHEDSHAWO",
                "note": "青空文庫"
              }
            },
            {
              "text": "蠅ばかりが、閑散な店の土間を一杯に、わんわんとかすかな唸りをたてて飛び廻っているだけだった。",
              "citation": {
                "source": "放浪の宿",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「犬はわんわんって泣くさ」「そりゃ日本の犬さ、西洋の犬はどういって泣くか知ってる？",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど梢のクマ蝉やアブラ蝉のわんわんと鳴り渡る声に交つて、蜩の、シロフオンを滑るやうな伴奏が八方から襲ひかかつてゐた。",
              "citation": {
                "source": "創作生活にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供らがわんわんと泣きだした。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方民で暇も多いのだろう、アリゾナ名物のカウボウイやなどが、わんわん詰めかけて来て、恐怖に口を開けて、小さなバンガロウを取り巻いている騒ぎ。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
