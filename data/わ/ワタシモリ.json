[
  {
    "uuid": "3bda1b58-4ac2-530e-a10f-2425dfd6283a",
    "entry": "渡し守",
    "reading": {
      "primary": "わたしもり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
