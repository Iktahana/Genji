  {
    "uuid": "82482be7-9d43-5152-b81c-458bf0719e9c",
    "entry": "渡守",
    "reading": {
      "primary": "わたしもり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
