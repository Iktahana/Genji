    "definitions": [
      {
        "index": 1,
        "gloss": "to boil up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鍋のお湯がぐらぐらと沸き返っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "真夏の太陽に照らされて、アスファルトが沸き返るように熱くなっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は怒りのあまり、血が沸き返るような思いだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "かしこの民は、沸き返る熔巖の釜の上に生涯を送れるなりと答へぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのたんびに蒼い波が遠くの向うで、蘇枋の色に沸き返る。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると観客はすっかりわれを忘れてわあっと沸き返る。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして沸き返るあがり湯を盛った小桶を、右左の二人の客に投げ附け、銜えていた懐剣を把って鞘を払った。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "沸き返る浪の音に消されるなと、いらだたしい思いを塩からい喉にあつめて、一生懸命に歌ったのである。",
              "citation": {
                "source": "貉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狸の鳴き声、知らない知らない、キイ、キイ、キャッキャッ」　それを聞くと、小屋の中は沸き返るような騒ぎになりました。",
              "citation": {
                "source": "人形使い",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて一三二頁に「互の気合が沸き返る、人は繚乱として飛ぶ」というのは何のことだろう。",
              "citation": {
                "source": "中里介山の『大菩薩峠』",
                "author": "三田村鳶魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はもう身体中の血が沸き返るようである。",
              "citation": {
                "source": "霜凍る宵",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は見た、沼かと紛ふ巨大な魚梁が沸き返るのを其処にレヴィヤタンの一族は草に絡まり腐りゆき、凪の中心に海水は流れいそそぎ遠方は淵を目がけて滝となる！",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりの空気は、彼らのきれぎれの鳴き声で沸き返る。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の頓兵衛が出て来る「神霊矢口渡」は、豊竹新太夫座元で堺町の外記座にかかり、ちょうど今日が初日で、沸き返るような前景気。",
              "citation": {
                "source": "平賀源内捕物帳",
                "author": "萩寺の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "11645そしてその奥の沸き返る蒸気の中に、永遠に燃えている、※の城が己に見える。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "決して美しくはありませんが、聡明らしくて、健康そうで、何んとなく可愛らしさのあるこの婦人は、虔ましく壇の上に立っただけで、会場の沸き返る空気を支配し、一瞬、水を打ったように静まり返ります。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "第四の場合",
                "note": "青空文庫"
              }
            },
            {
              "text": "この土用浪の砕けて沸き返る赤黒い潮の中へ、パッと飛込んだ美奈子は、暫らく得意の綺麗なブレストを見せておりましたが、やがて沖から小山のように押し寄せて来た巨大な浪が、数十尺の真黒な屏風を押し倒したように、あっという間もなく、美奈子の上へ崩れたのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "運命の釦",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　360猛火に燒かれ斯く叫び美麗の流沸き返る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　たがいの気合が沸き返る、人は繚乱として飛ぶ、火花は散る、刃は閃く、飛び違い走せ違って、また一際納まった時、寄手の人の影はもう三つばかりに減っています。",
              "citation": {
                "source": "大菩薩峠",
                "author": "甲源一刀流の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "フレンチの胸は沸き返る。",
              "citation": {
                "source": "罪人",
                "author": "アルチバシェッフ　M. Artzibaschew",
                "note": "青空文庫"
              }
            },
            {
              "text": "この足が使えたら、そう思うと胸が沸き返るようだった。",
              "citation": {
                "source": "花も刀も",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "成都の上下は、沸き返るような歓呼だった。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "天秤の先へ風呂敷ようのものをくくしつけ肩へ掛けてくるもの、軽身に懐手してくるもの、声高に元気な話をして通るもの、いずれも大回転の波動かと思われ、いよいよ自分の胸の中にも何かがわきかえる思いがするのである。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてつくづくこの多くの古い落書きを見ていると、自分はたまらなく昔なつかしの思いがわきかえるのであった。",
              "citation": {
                "source": "落穂",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の影をちらと見たばかりでも、血がわきかえるほど気がはずんだ。",
              "citation": {
                "source": "落穂",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしや野原か往来などで、行き倒れにでもなりやせまいか、人の知らぬまに死んでいたのではないかしら、それともすこしは早くようすがわかって家のものの世話を受けてなくなったのか、いろいろな想像が一｜時に胸にわきかえる。",
              "citation": {
                "source": "告げ人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "わきかえるような泡の混乱の中に船をもまれながら行く手を見ると、いったんこわれた波はすぐまた物すごい丘陵に立ちかえって、目の前の空を高くしきりながら、見る見る悪夢のように遠ざかって行く。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　なぞとたいへんな騒ぎで、場内はもうわきかえるばかり――。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういううわさで、町はわきかえるようなさわぎでした。",
              "citation": {
                "source": "活人形",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い波がわきかえるのは新年にふさわしい活動的な見もので、これを見るのがわが家新年初頭の吉例的行事であった。",
              "citation": {
                "source": "新宮",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうえおん子城介どのまでがおなじく二条の御所においてあけちが兵に取りこめられて御せっぷくあそばされ、御父子いちどに御他界と知れましたときはまったく世の中がわきかえるようなさわぎでござりました。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし知ったら、世界じゅうが、わきかえるだろう。",
              "citation": {
                "source": "透明怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで水を掻いていた板は、一郎君の手をはなれて、わきかえる流の中へまきこまれて行きます。",
              "citation": {
                "source": "新宝島",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
