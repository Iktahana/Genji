        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アイドルの登場に、会場は割れんばかりの歓声で沸き返った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "歴史的な勝利のニュースに、国中が喜びに沸き返った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼のホームランで、スタジアムは興奮のるつぼと化し、沸き返るようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
