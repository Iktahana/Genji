    "definitions": [
      {
        "index": 1,
        "gloss": "making an excessive fuss",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昨夜、隣の部屋の大学生たちが悪騒ぎをしていて、全く眠れなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "酔った勢いで悪騒ぎをしてしまい、翌朝になって店の人に謝罪した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "ただの噂話に尾ひれがついて、とんだ悪騒ぎに発展してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "今夜も、これから聴かせて貰ふ、酔つ払ひ共の悪騒ぎのない晩に、沁々と甚太郎の喉を聴いて……得難い思ひを囚へてやる。",
              "citation": {
                "source": "歌へる日まで",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてのこなし方｜能く本文の意に適ひ、人形流の悪騒ぎなくして、後人の模範となすに足る。",
              "citation": {
                "source": "両座の「山門」評",
                "author": "三木竹二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
