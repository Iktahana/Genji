    "definitions": [
      {
        "index": 1,
        "gloss": "Japanese dog breed (e.g. Shiba, Akita)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "柴犬や秋田犬は、代表的な和犬として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "最近、和犬の魅力に惹かれて飼う人が増えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "公園で、珍しい和犬が散歩しているのを見かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "三聲を續けて鳴いたと思ふと……雪をかついだ、太く逞しい、しかし痩せた、一頭の和犬、むく犬の、耳の青竹をそいだやうに立つたのが、吹雪の瀧を、上の峰から、一直線に飛下りた如く思はれます。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三声を続けて鳴いたと思うと……雪をかついだ、太く逞しい、しかし痩せた、一頭の和犬、むく犬の、耳の青竹をそいだように立ったのが、吹雪の滝を、上の峰から、一直線に飛下りたごとく思われます。",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "君達人間様が平生愛国者振るくせに我々｜大和犬族の優等なるを忘れて外国種の下等な性質を遺伝いだ雑種犬を珍重するとは何事だ。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "……威張るとも、我々大和犬族は敢て毛唐種に譲らない力量勇気があるから子。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも洋犬と和犬の雑種のようだ。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうかと云うて、こぎやん話んなつとるもんば、引き留むるわけんも行かず……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そるば、どうしてん、発たずにやをられんて云ふととだるけん、こん位あわけんわからん話てあるもんぢやなかと。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "東路の草葉をわけん袖よりも　　たたぬ袂の露ぞこぼるる　忠度はすぐ歌を返した。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第五巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
