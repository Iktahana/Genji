          "literary": [
            {
              "text": "（おや、きょうはおみこしが出ているわ、ワッショワッショイ、ワッショワッショとやっている声がして来ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中鹽田村で土地の祭と見えて、赤烏帽子の子供が二人櫓太鼓の上に乘つて之れを打ち、同じやうな子供二三十人が之れを擔いでワッショワッショと押し出してゆくのに出會つた。",
              "citation": {
                "source": "淡路人形座訪問",
                "author": "竹内勝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "各地共一緒で、花は個から群へ、群から団へと、結束させられて、ワッショワッショと春に向って、行進させられる事になった。",
              "citation": {
                "source": "社日桜",
                "author": "河井寛次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
