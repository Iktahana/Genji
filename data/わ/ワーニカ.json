        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ワーニカの親父は、旋盤工で、「鎌と鎚」工場に勤続二十五年の労働者だ。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカは、「鎌と鎚」工場の工場学校でずっと勉強し、共産党青年だ。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカは、だから元気だ。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "元気な息子を見て、ワーニカのおふくろはよろこんで、親父の古外套を仕立直して、ワーニカのにしてくれた。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　ワーニカは、わいわい云いながら入口で防寒靴をぬいでる一かたまりの男女学生の中に、見なれた円い緑色の毛糸帽を見つけた。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モスクワには、そんな緑色の帽子をかぶってる女がうんといるわけなんだが、ワーニカは、例えそれが五つかたまってたって、見そこなわないだろう。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "うしろから、その緑色帽の肩へ自分の肩をぶつけてワーニカが云った。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ワーニカは批判能力がないんだ。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカとターニャは並んでかけてる。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカはしかしターニャと別に喋くらない。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカはターニャとは別の組に入った。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカは飯を食わなけりゃならない。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度はワーニカがだまってる。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカは、マトリョーナの赤い頬っぺたと、そこへおちてる金髪を眺めた。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカは思わず笑い出し、だんだん大きな口あけて笑った。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカはつれ立って食堂を出た。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーニカは、考えながら雪道をトウェルスカヤ通の方へ歩いてった。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
