[
  {
    "uuid": "37a4e971-86d0-55fa-8c51-0d9c3d632c22",
    "entry": "渡り合う",
    "reading": {
      "primary": "わたりあう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
