        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "中宮の仰せられた話などをされて、「変わりない愛を持っていながら来られない日が続いても疑いは持たないでください。",
              "citation": {
                "source": "源氏物語",
                "author": "総角",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしそれにしても、手書き文字の認識は紙―ペン環境へのパス・ポートである事情には変わりない。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "見たものは君と変わりないと思う。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来上がった混合物が見た目、真水と変わりないことはおわかりですね。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "長く空いたとはいえ、過ちの記憶と復讐への渇望は、やはりジョン・フェリアの墓前で立ち尽くしたあの忘れ得ぬ夜からまったく変わりない。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "すいませんが、みなさん、私は家内の部屋へ行って、変わりないか確かめなくては。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろこの尋常ならざる事件にまだ関わりないのがただ不思議なくらいだ。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここも家も寒いのには変わりないのです、あそこは屋根があるだけ。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "孫太郎虫の小娘おなつを絞め殺したのはこのあっし、てつだわせたのは妹おくに、殺せと頼んだのは、だれでもねえ闇男屋敷のおふくろと、その兄の宗左衛門でござんす」「闇男本人の友次郎とやらはかかわりないか！",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは定か、いつわりないか」と、実雅は苛いらしながら念を押した。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "女のいつわりない女心は、ものわかりよさが腐臭を放っていることをよろこばないのである。",
              "citation": {
                "source": "ものわかりよさ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "短波がどうであろうと、一見民衆の生活にかかわりないようないきさつに置かれている。",
              "citation": {
                "source": "市民の生活と科学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人だからモラトリアムにかかわりない、という架空の天国は、地上にはないのである。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後は変わりないかな。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ磯五は、はじめから夫婦になる気はないのだし、夫婦になれないとわかっても、おせい様から金を引き出すほうには、いっこうさしさわりないと考えているのだから、いっそ今夜話してしまおうと思った。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、そんなに戦き脅えながら、僕はどのように熱烈に人間を恋し理解したく思っていたことか）　ところが今では、今でも僕が人生に於てぎこちないことは以前とかわりないが、それでも、人間と会うとき前とは違う型が出来上ってしまった。",
              "citation": {
                "source": "火の唇",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "源どん、元気かわりないか」　ヘーイ少佐が、血色のいい顔をぬっと店の中へ入れた。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒ずんで見た目がわるいだけのことで、品質にはかわりないといったところ、ポーニンは、それなら自分の使い途にはさしつかえないというので、近日はっきり注文すると約束をしてくれました」「うん」「つまり、これで判断すると、ポーニンがこれからそのセメントをつかおうとする所は、塩気があるのです。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄の灰皿を立体｜走査すれば、これはすなわち一連の電信符号とかわりないものとなる。",
              "citation": {
                "source": "宇宙女囚第一号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "桂子その人に捧げている、小次郎の心持ちというものは、あの泰西の騎士なる者が、自分を庇護してくれる貴婦人に向かって、捧げているところの心持ちと、ほとんど変わりないものであった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂女ながらも逢えた嬉しさは、正気の女と変わりないが、うっとりとした潤んだ眼で、お浦は家治の顔を見詰め、握られている手に力をこめ、家治の言葉の一句一句に、それを締めそれを緩めた。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私の人間と思想とのエレメントは依然として変わりない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも熱は七度五分位で、熱にかかわりなく又痛みの自覚にもかかわりない由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "稲ちゃんは心のこなごなに苦しいようなときでも、ウーウー云いながら、そのときの心持とかかわりないものを書く。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれにせよ、私にはかかわりないことです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたにかかわりない全然私のくちおしさ、苦痛であって、しかも、ことの結果があらわれれば完全にあなたの上にあらわされるということで、堪えるに堪えがたい苦痛がまさるのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その花たちはたっぷりした葉をほしいまま緑金色にきらめかせたまま、それにかかわりないように、寧ろ、その美しさの凝集のように葉かげによりそっています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正初めのその頃文学好きな人は殆どみんな読んだワイルドの作品だのポウだの、武者小路実篤の書いたものを手に入る片はじから熱心に読み、自分から書くものはと云えば、手に負えない内心の有様とはかかわりない他愛のない物語だったことも、精神が不平均に芽立ちむらがったその年頃の自然だったのだと思われる。",
              "citation": {
                "source": "時代と人々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "単に望気の法だけで鉱山の有望無望を考定するのは愚かであるが、既に何等かの物があれば又自然と何等かの気が有る理屈であるから、気を望んで山を占うのも一理無いことではない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
