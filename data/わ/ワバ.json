        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「クライミングローズフワバー。",
              "citation": {
                "source": "めくら草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また不眠の鬼が戻つて来たらしい、クワバラ／＼。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通に蟒に充てるウワバミは小野蘭山これを『和名抄』の夜万加々智とす。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "一七六九年インドの北西部飢饉し牛多く死し虎常時の食を得ず、ブハワバール市を侵しおよそ四百人を殲し、住民逃げ散じて市ために数年間空虚となったとクルックの『西北印度諸州篇』に見え、次に開化の増進に随い虎が追々減少する事体を述べ居る。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そのはなしは願ひさげ……」　片野の主人は何故か慌てゝ手を振り、クワバラ／＼などゝしやれた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　今夜はあまり風が烈しくガワガワバタバタと庇のトタンが鳴り、且つ手がつめたく新しい仕事にかかる気がないので、又一寸かきつづけます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今になって白状に及んだところをみると、みんな相当私のウワバミ元気にはヘコたれていたらしいのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に滑稽なことは咲枝さんも心臓の為にそれを注射されていて、ウワバミ元気にあてられる度も一入であったのでしょうが、しかしこの人の方は腰の痛いのがましだという結果に現われて、私のように悲しき女人足にはならなくてすんだのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウワバミ元気のこと［自注４］については、一同に朗読して聞かせたところ、御難という程でもなかったとのことです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注４］ウワバミ元気のこと――「ウワバニン」の注射のために百合子は亢奮状態におかれて結果がよくなかった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで「ウワバミ」という家庭のアダナがついた。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラそれはお父ちゃまて云われないからね」「それゃそうかもしれない」「私はもううわばみ元気が抜けたから片づけはきらいになっちゃった」　ウワバニンとかいう砒素の薬（それをうちはウワバミというのよ、きらって）を水上さんは注射してその刺戟で亢奮していた頃私はよく女人足と自分をよんでいたでしょう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クワバラ」　碁の手筋にしたって、深く究めなくては本当の筋は分らない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをキレイに飲みほして、お茶づけをかッこんで、ウワバミのようなイビキをかいて寝やがるんで」「婆さんは毎晩いつごろやすむのかえ」「こちとら時計の見えねえタチだから、何時てえのは皆目分りやしねえや。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶づけを食ッちまやがると、たちまちウワバミのイビキでさア。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "クワバラ、クワバラ。",
              "citation": {
                "source": "人生案内",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "野郎どもが狸だかイタチだかネズミだかわからないようなチョロチョロした小者ばかりになって、かりにも獅子とか虎とかワニとかウワバミのような大者がいなくなってしまった。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が思うには、獅子とか虎とかウワバミというものはまだしも女に敵しがたいところがあるが、豆狸やネズミやイタチは女狐ていどを手玉にとるには至芸に達していて、女は全然カスまざるをえなかったのではないかと思う。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "してみると、泉山三六先生なぞは、やっぱりウワバミていどの大物かも知れないのである。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事が終って無用になれば金で買った奴隷だから、人にくれてやることも、ウワバミにくれてやることも主人の勝手だ。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで四谷の伊賀町の路地へウワバミでも出たようじゃないか」　平次はそれを迎えてニヤリニヤリしております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "遠眼鏡の殿様",
                "note": "青空文庫"
              }
            },
            {
              "text": "このまま飯にしちゃ毒だよ」「ついでに今晩は泊めて下さいな親分、用心棒になりますよ」「お志ざしは有難いが、お前は一杯飲むとウワバミのような鼾をかいて寝込むから、用心棒どころか心張棒ほどの役にも立たないよ」「ヘッ、違げえねえ」　八五郎はピシャリと自分の頬をたたきました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "生ヲ望ミ給ワバ、降ヲ乞ウテ、速刻、余ガ軍門ニ使サレヨ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう舞がもうなくなって、姥という名ばかりが記憶せられると、後には福島県の各地のように、カワババだの川原の伯母さんだのという名が、改めてまた考案せられるのであろう。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史ハイワバアナタノ誕生ト共ニ始マリ、アナタノ死ト共ニ終ワル運命ニアッタノダ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "典型的なウワバミ夫婦とでも言うべきでしょうねえ。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがこのウワバミ夫婦との同居生活は、わずか一週間をもってはかなく終りを告げました。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
