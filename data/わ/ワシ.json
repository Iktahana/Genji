    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "梅の花、菜の花ののどかな村むらを、粟毛に額白の馬をのりまわした糟谷は、当時若い男女の注視の焦点であった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "糟谷はいまの場長の話は遠まわしに自分に諷するのじゃないかと思った。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうこうなっては寝ていようとて寝ていらるるものでない、母なるものが起きる、予も起きる、着物もあぶれたというので、上なが起る次なが起る、仲なのも起る、足袋がないとさわぐ、前掛がないと泣きだす、ウンコーというオシッコーという、さわがしいのせわしいの、それは名状すべからずと云う有様。",
              "citation": {
                "source": "浅草詣",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "予は寧ろこれを読むのが厭わしかった。",
              "citation": {
                "source": "大雨の前日",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯る深山に入りてみやびたるわざに心をこらす少女の心のうちを思うにいとなつかしく今｜迄は只いとわしき者にのみ思いし外国人の中にかかるやさしきもありけるよと心にくき事限りなし。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人声かけあいて登るに道けわしければ汗は滝なして降る。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅かの相違であるが『あまた立ちならぶ様のさびしも』と詞に淀みのある云い方が自然に作者の心持を現わして居る。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰ろうと云う決心極めて薄弱であるので未だ吾からだを動して帰路に向わしむる程の力がないのだ。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉がせわしなく台所の用をしながら、遠くから声を掛けてあやしてくれたけれど、いつものように嬉しくなかった。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈々子は満足の色を笑いにたたわして、雪子とお児の間にはさまりつつ雛を見る。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "くりくりと毛を刈ったつむり、つやつやと肥ったその手や足や、なでてさすって、はてはねぶりまわしても飽きたらぬ悲しい奈々子の姿は、それきり父の目を離れてしまった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が牛舎の流しを出て台所へあがり奥へ通ったうちに梅子とお手伝いは夕食のしたくにせわしく、雪子もお児もうろうろ遊んでいた、民子も秋子もぶらんこに遊んでいた。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四日は祭の初日でただ物せわしく日がくれた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互に気のない風はしていても、手にせわしい仕事のあるばかりに、とにかく思い紛らすことが出来た。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "互に手を取って後来を語ることも出来ず、小雨のしょぼしょぼ降る渡場に、泣きの涙も人目を憚り、一言の詞もかわし得ないで永久の別れをしてしまったのである。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子のお父さんはお詫びを言わしてくれという。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸村のお母さんは、民子の墓の前で僕の素振りが余り痛わしかったから、途中が心配になるとて、自分で矢切の入口まで送ってきてくれた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故、奈良朝において同音を表わした「伊」「以」「移」等の一類は後世の仮名「い」に相当し、「毛」「母」「慕」等の一類は後世の「も」に相当するのである。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様に、後には同音に発音する「え」と「ゑ」、「お」と「を」の仮名も、それぞれこれに相当するものが奈良朝には別類の仮名として存在するのであって、それらは、それぞれ異なった音を表わしていたと思われる。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、当時は、この二類は、それぞれ別の音を表わしていたのであるが、後世の仮名にはこれを混じて、同じ「え」で表わすようになったものと認められる。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに、この仮名は初のうちは相当正しく音韻を表わしたであろうが、院政・鎌倉時代から室町時代と次第に音韻が変化して行った間に、仮名と音韻との間に不一致を来し、仮名が必ずしも正しく音韻を代表しない場合が生じた。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かようなわけで、ｅとyeとがすべてｅになったとする説は極めて疑わしい。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし促音は書きあらわしてない）。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『万葉集』巻十二に「いぶせくも」という語を「馬声蜂音石花蜘※」と書いてあって、「馬声」をイに宛て、「蜂音」をブに宛てたのをみれば、当時の人々は、蜂の飛ぶ音をブと聞いたと共に、馬の鳴声をイの音で表わしていたのである。",
              "citation": {
                "source": "駒のいななき",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の仮名は「キ」という音なら「キ」として一つの字で表わしますけれども、キの音を分解してみれば更にｋの音とｉの音とに分解できます。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは「サン」という漢字であって、支那において既に「ヤマ」という意味を表わしている。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような表わし方もあります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは皆一々違った音をあらわしたとは思われませんが、とにかく文字は皆違っているのですから、その中のどれだけが同じ音で、どれだけが互いに違った音であるか、そういうようなことは予め決める訳には行かない。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは今でこそ同じ音であるけれども、ずっと古い時代において違った音であったとすれば、仮名の違いがやはり音の違いを表わしておったものである。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十七の仮名は四十七の違った音を表わしておったものであるということが解って来たのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
