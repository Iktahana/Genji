    "definitions": [
      {
        "index": 1,
        "gloss": "to break down laughing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あまりの面白さに、彼女は腹を抱えて笑い崩れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "コントを見ていた観客は、次々と笑い崩れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人の失敗談を聞いて、私は椅子から転げ落ちるほど笑い崩れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "六　私が「いでゆ」のドアをあけたとたんに、わっと笑い崩れる少女たちの声が聞えた。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして一同が高く笑い崩れるにしたがって、片方の牡蠣のように盲いた眼までを輝かして顔だけでめちゃめちゃに笑った。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう信敬（神経）を起すな」「アハハハ、アハハハ」と、一同は笑い崩れる。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなた来ていたのですか」「ええ、お帰りになってから、考えたら何だか様子が変だったから、すぐ車で来て見たの、そうして昨夕の事を、みんな婆やから聞いてよ」と婆さんを見て笑い崩れる。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はキョトンとして女の笑い崩れる歯ぐきに見とれた。",
              "citation": {
                "source": "苦力頭の表情",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "怒鳴る本人すら訳の解らない啖呵を吐き出しながら、顔中を赤貝みたいにむき出して、笑い崩れるロシヤ人のテーブルを泳ぎ廻った。",
              "citation": {
                "source": "放浪の宿",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ハアドルの内田さんが、先に進みでて、「おおきに」と澄ましたお辞儀をしたので、あなた達は笑い崩れる。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "（手を拍つ）みな笑い崩れる。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同笑い崩れる中に、言いだした侍が起って、残りの十人ほどの帯刀を一しょに集めて、ひとかかえ奎堂の前へ置く。",
              "citation": {
                "source": "稲生播磨守",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "両人は申し合せたごとく「ハハハハハ」と笑い崩れる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うではまたひと際高く、笑い崩れる四人の苦しげな声が聞えた。",
              "citation": {
                "source": "あだこ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一勝一敗のつくたびに、どっちかが、杯をのみ乾し、その口惜しがりようを見て、みんなが笑い崩れるのだった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもしろがって二人の問答を聞いていた群集は思わず一度にどっと笑いくずれる。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赧くなりながら一生懸命に読み直せば読み直すほど、みんなは笑いくずれる。",
              "citation": {
                "source": "虎狩",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホルモンが欠乏したの」と笑いくずれる程度の女学生なぞはザラに居る。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの室にはわたしと外にだれか一人、隣の室には婦人連、そして向かい側の大部屋にはその他の大勢という割当てであったが、その大部屋はまるで動物園のおりよろしくで、皆が鉄ごうしにつかまって怒鳴る、わめく、笑いくずれるの大騒ぎであった。",
              "citation": {
                "source": "赤旗事件の回顧",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはははは、ワッハッハッハ」　と一同は、腹をかかえて笑いくずれる。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてラッパからしゃがれた張の作り声が、はっきりしない言葉となって飛出すたびに、そのまわりに集っていた町の人々は、どっと笑いくずれるのであった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お父様、エダじゃないの」「そうですよ、イダだよ」「――……」　伸子は笑いくずれるように父の肩ごしに祝儀袋を見せた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、まわりではどっと笑いくずれる――わたしはこういう時、ペテルブルグの弥次馬連が好きですよ、カンカン的な連中ではありますがね。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "……なんだかきょうの髪、すこし根がつまりすぎて……」お照はさっきと同じようなことを言って、まだ気になってしようがないように自分の髪へちょっと手をやっていたが、そのとき急に、向うの家のなかからどっと若い娘たちの笑いくずれる声が起った。",
              "citation": {
                "source": "三つの挿話",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの障子には、大勢の影法師が映していて、時々、笑いくずれる声が往来まで流れてくる。",
              "citation": {
                "source": "死んだ千鳥",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
