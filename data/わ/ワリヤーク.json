          "literary": [
            {
              "text": "日本海海戦で沈んだロシアの軍艦、ワリヤーク、コレーツがその残がいをさらす月尾島をすぎると仁川の港である。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "千代田が囮になって湾内にじっとしているので、ロシアの軍艦ワリヤークという六千何百トンのと、ずっと小さいコレーツという二隻が油断している間に、沖から他の日本軍艦がしのんで来て、夜明けに二隻を沈めてしまった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
