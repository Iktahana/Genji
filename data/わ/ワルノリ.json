          "literary": [
            {
              "text": "ではこりゃいったい何だと考えているうちに、かつてオレの悪妻自慢に悪乗りした某の面つきが浮かんで、はたと膝を叩いた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがこいつは、全く持って悪妻叩きへの悪乗りだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "至上の芸にただただうなっていれば、知らぬ間に身内叩きに悪乗りする客にされちまう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
