        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "木ヲ組合ワセテ作リタル丈夫ナルモノ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（スエコは意地悪で「ソノママ、マニアワセテ」と早口に続けて云ってみろと云います、ひどいわね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ又痛イ目ニ遇ワセテクレル異性ノ方ニヨリ一層魅力ヲ感ジ、惹キツケラレル、ト云ッタ方ガイヽカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「承知イタシマシタ」ト云ワセテ寝室カラ書斎ニ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女等ハ茫然トシテ無言デ顔ヲ見合ワセテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妻ハソレヲ口ニ出シタ※ハナイガ、ジェームス・スチュアートノ映画ダト缺カサズ見ニ行クラシイノデアル）モットモ妻ガ木村ニ接近スルノハ、僕ガ彼ヲ敏子ニ妻ワセテハドウカトイウ考エガアッテ、家庭ニ出入リサセルヨウニシ、妻ニソレトナク二人ノ様子ヲ見ルヨウニト命ジタカラナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一々フラッシュヲ用イナケレバナラナイヲ見合ワセテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫ケラノヨウナゴンゾ達ニ、グズグズ言ワセテハ、自分ノ顔ニカカワル。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイツヲ、アイツノ子ヲ、アイツノ孫ヲ、オレト同ジ目ニ合ワセテクレ、アイツノ一家ガ栄エテイテハ、オレハ死ニ切レヌ。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
