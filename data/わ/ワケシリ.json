[
  {
    "uuid": "657475de-b943-5dac-bd40-8e99f2deca97",
    "entry": "訳知り",
    "reading": {
      "primary": "わけしり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "man of the world",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はいつも落ち着いていて、まるで人生の全てを知っているかのような訳知り顔だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ベテランの彼は、どんなトラブルにも対応できる訳知りなベテランだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「まあ、世の中そんなもんだよ」と、彼は訳知り顔でため息をついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "黄村のまえではあくまで内気な孝行者に、塾に通う書生のまえでは恐ろしい訳知りに、花柳の巷では即ち団十郎、なにがしのお殿様、なんとか組の親分、そうしてその辺に些少の不自然も嘘もなかった。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日以後の文人は山林に隠棲して風月に吟誦するような超世間的態度で芝居やカフェーにのみ立籠っていて人生の見物左衛門となり見巧者訳知りとなったゞけでは足りない。",
              "citation": {
                "source": "二十五年間の文人の社会的地位の進歩",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "時刻は、ひと風呂浴びて、二人が浴衣にくつろぎ、訳知りの宿の女中のひきさがつたあと、初夜の幕がまさにあがらうとする寸前である。",
              "citation": {
                "source": "菜の花は赤い",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳知りのように首を振った。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとたび俺が命令すれば、お前さんに指一本触れさせねえ、船員もそうする、つまり訳知りってことだ。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルデラが訳知り風に大股で、真っ暗な家に向かった。",
              "citation": {
                "source": "鉄面皮",
                "author": "A Front of Brass",
                "note": "青空文庫"
              }
            },
            {
              "text": "理解できないが、訳知りが言うに、原因は娘のメイ・ヘアデール嬢にあり、コプリがぞっこん惚れたからだとか。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "密かにほくそ笑む連中、この連中こそ訳知りだ。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蔦　（やや気色ばむ）まあ、死んでも構わないと、あの、ええ、死ぬまいとお思いなすって、……小芳さんの生命を懸けた、わけしりでいて、水臭い、芸者の真を御存じない！",
              "citation": {
                "source": "湯島の境内",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……嫁御はなるほど、わけしりの弟分の膝に縋って泣きたいこともありましたろうし、芸妓でしくじるほどの画師さんでございます、背中を擦るぐらいはしかねますまい、……でございますな。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　君待て、仏国のわけしりが言ったと聞く。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには従来の所謂教養ある婦人作家のかたくるしさや、令嬢気質、奥様気質とはちがった、わけしり、苦労にぬれた女の智慧、風趣などが特色として現わされたのであった。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで雀たちの数を言ったついでに、それぞれの道の、学者方までもない、ちょっとわけ知りの御人に伺いたい事がある。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "多少わけ知りらしい口調といい、ことに、この十人の男が、いずれも六尺近い、仁王のような頑丈なのばかりがそろっていることといい、決して普通の駕籠｜舁きとはうけとれない。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、今度のことは、その男とまつたく関係がないとはいえないね」　年嵩の方が、わけ知り顔に呟いた。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人は見掛けに寄らないと言ふが、――こんな騷ぎがあつて驚いたことは、甲州屋の家の者で、主人の萬兵衞を殺し兼ねない者が四五人は居るぜ」「へエ――」「世間體は良い男だつたが、通人とか、わけ知りとか言ふ者は、大方斯うしたものだらう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お藤は解く",
                "note": "青空文庫"
              }
            },
            {
              "text": "指揮のハーティ卿は英国楽壇第一のわけ知りで、カサドのチェロを援けて、平明だがよき効果をあげている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "札付の道樂者、大通で金持で日本一のわけ知りと言はれてゐる扇屋丹右衞門の、取卷き見たいなことをしたのが氣に入らない樣子でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "浮世繪の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "平次の問ひに對して答へたことは、主人の丹右衞門は、世にも情け深くてわけ知りで、自分をどんなに大事にしてくれたかといふ、惚氣交りの身の上話で、その恥を恥とも思はぬ無智な態度は、八五郎でさへも胸を惡くした程で、縁側に出ては不作法にも、泉水にペツペツと唾を吐いてをります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "浮世繪の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "すつかり忘れて居たが、豐島町の手習師匠進藤孫三郎先生、若くてわけ知りで、學があつて、足が惡い。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけ知りの主君日向守は、事芸道に関する限り、欺くことの出来ない名君だったのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "左京の恋",
                "note": "青空文庫"
              }
            },
            {
              "text": "人に知れては悪いに決っている内証の情事までも、誰も知ってくれないと心細いから、ツイ匂わしてみたくなる奴さ」　こういう佐野屋九助は、わけ知りらしい五十代の男でした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "敵討果てて",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人は見掛けに寄らないと言うが、――こんな騒ぎがあって驚いたことは、甲州屋の家の者で、主人の万兵衛を殺し兼ねない者が四五人は居るぜ」「ヘエ――」「世間体は良い男だったが、通人とか、わけ知りとかいう者は、大方こうしたものだろう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お藤は解く",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆきという婦人にしても、言葉づかいや動作には武家のような感じがするが、とりもちの巧みさや、酒をすすめたり、さりげなく屏風の中の支度をととのえたりするようすは、大きな商家のわけ知りのばあや、といったふうなところもあった。",
              "citation": {
                "source": "屏風はたたまれた",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "令夫人がわけ知り顔にのたまった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "折しも、山時鳥がわけ知り顔に、ひと声鳴くのも一層情趣があった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "灌頂の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、多少裏面に通じているわけ知りまでが、いろんな疑惑を後ではもった。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "余りに情にもろい彼の単純さに、わけ知りの公卿輩はあきれたということだ。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると衣子は、そうですか、考えてみましょう、などゝは言わず、例のジロリと一ベツをくれて、「ずいぶん、ワケ知りですことね」　と突き刺した。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "論語よみの論語知らずと云うが、ワケ知りのワケ知らずというべきか。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
