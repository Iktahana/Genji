        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イワノウィッチが編入された、ワルシャワの守備の連隊が駐屯していたワジェンキ王宮の近所には、パガテラという有名な遊園地があった。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次の朝、イワノウィッチは、ワジェンキ宮殿の広場で、不意にダシコフ大尉と会った。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、夜になるとワジェンキ宮殿の泉水には冷たい微風が吹き起った。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "イワノウィッチは、中隊長の目を盗んで、秘かにワジェンキの営舎を抜け出たのである。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
