          "literary": [
            {
              "text": "土門はやがて笑い止むと、「誤解とぬかしたな」と、言った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、やっと笑い止むと、持っていた封筒を、一つ一つ破り出した。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑いながらよくよく互いの顔を眺めあい墜落的に笑い止むと同時に、三人ともそれぞれの背後を振り返って見た。",
              "citation": {
                "source": "三悪人物語",
                "author": "忍術千一夜　第二話",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして笑い止むと腹が少し痛かった。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
