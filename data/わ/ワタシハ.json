        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ワタシハ、オオキイウチハ、ミンナキライダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ、アノクスリヲノムカラ！",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マタ　サツキノ　フトイ　コヱデ、「ワタシハ　ウマデス、チツトモ　オソロシイ　モノヂヤ　アリマセン」ト　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　モウ　メヲ　サマシテ　ヰマス」「アラ　アラ、ソレデハ　スグ　デテ　イラツシヤイ」　ヤガテ　ソノ　ツボミガ　フタツニ　ワレテ　ナカカラ　ナニカ　デテ　マヰリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　モウ　一ツキアマリ　カタナヲ　ヌカナイノデ、ウデガ　ムヅムヅスル。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエイエ、ワタシハ、アナタノ　フイテ　イラツシヤツタ、ソノ　フエノ　コヱガ　アンマリ　ヨカツタノデ、コツチヘ　サソハレテ　キマシタ」ト　タケノコハ　コタヘマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　イママデ　ウツカリシテ　ヰタケレド、ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルデハ　ナイカ」　コノ　カナシミハ　ドウ　シタラ　ヨイデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　モウ　イキテ　ヰラレマセン」ト　ソノ　デンデンムシハ　オトモダチニ　イヒマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　ナント　イフ　フシアハセナ　モノデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ラツパシユニ　ナツテ　リツパニ　ハタラキマス」ト　ワカイ　ヲトコハ　コタヘテ、トシヨリタチノ　マエデ　イサマシイ　ラツパヲ　フイテ　キカセマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　ヒロツテ　アゲマセン。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イイエ、ワタシハ　ツイテ　イキマス」　ソシテ、テフテフハ　ヒラヒラト　アカイ　フウセンダマニ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンガ、キュウシュウヘ、ユクノデ、ワタシハ、オマエノトコロヘ、ユクカモシレマセン、タノシミニ、マッテイナサイ――母よりの手紙。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ玉子ハ入リマセン。",
              "citation": {
                "source": "続野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハ、コンゲツ一パイメッタニ雨モフラズ、カゼモナクテ、マイニチマイニチヤケルホドアツクテ、ワタシハモウスコシデ、クタバッテシマフトコロデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノウチニワタシハ、コタンヘカヘリマスガ、マタ、コンド、アガリマスカラ、ドウカ、ヨロシクネガヒマス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　長イステツキドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　毛糸ノカタカケドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　十文ノオクツハドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモガ、マチヲアルイテモイイデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――イイエ、ワタシハ何モ知リマセン。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ワタシハヒトヲコロシタノダガ……。",
              "citation": {
                "source": "測量船",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、　――キノフモケフモワタシハムダニヒヲスゴス。",
              "citation": {
                "source": "測量船",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "―― 〔J'ai tue'〕 ……ワタシハヒトヲコロシタノダガ……。",
              "citation": {
                "source": "測量船",
                "author": "三好達治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
