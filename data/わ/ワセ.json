  {
    "uuid": "ad136e17-9a98-5910-86b2-3d8ec1bcaa47",
    "entry": "ワセ",
    "reading": {
      "primary": "わせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
