          "literary": [
            {
              "text": "「モシオ前ガ何カ他人ノ物ヲコワシタトキニハ、オ前ハドウシナケレバナランカ？",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ガ関係シタ霊魂第十号モ、カカル雑音ノ中カラ姿ヲ現ワシタノデアル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　カゲモ　ヨロコンデ、トンダリ、シツポヲ　クルクルト　フリマワシタリ　シテヰマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ上下ノ歯齦ヲ何度モパク／＼ト離シタリ合ワシタリシテ黄色イ舌ヲ口腔デベロ／＼サセ、思イキリグロナザマヲシテ見セタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
