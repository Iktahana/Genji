    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が、その花を持って家に帰る途中、自転車の後に同じ吾亦紅と薄の穂を括りつけてゆく子供の姿をふと見かけた。",
              "citation": {
                "source": "吾亦紅",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤袴吾亦紅など名にめでて九月二十九日　「玉藻五句集（第五十六回）」松茸の香りも人によりてこそ十月二日　天台座主渋谷慈鎧より松茸を送り来る。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋かぜのつのりて吾亦紅の雨十一雁わたる――灯を消した、山の湖畔の宿。",
              "citation": {
                "source": "独楽",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "らんらんの眼には毛虫｜眉衫衣に繍わせた　吾亦紅あまりに人がこわがるので※に挿したよ　花一枝　彼はつねに帽の※傍に何か花を挿す習慣を身につけていたので河北の人は彼を、一枝花の蔡慶とも呼びならわしていた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝は雨後の朝露がことに繁くて道ばたの薄や、ワレモコウ、桔梗、ヤマニンジン、ヒメカンゾウなどの花は何れもうつ俯して、初秋の静粛を瀟洒たる風姿に表して居る。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ヒメシャクナゲ　ミツバオウレン　ツルコケモモ　イワゼキショウ　ショウジョウバカマ　ワレモコウ（小形の一種）　ツバメオモト　ヤチスギラン　此の他疑問中にあるもの二種。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "青葉の雨を聞きながら――　露を其のまゝの女郎花、浅葱の優しい嫁菜の花、藤袴、また我亦紅、はよく伸び、よく茂り、慌てた蛙は、蒲の穂と間違へさうに、（我こそ）と咲いて居る。",
              "citation": {
                "source": "玉川の草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "桔梗、刈萱、女郎花、我亦紅、瑠璃に咲ける朝顏も、弱竹のまゝ漕惱めば、紫と、黄と、薄藍と、浮きまどひ、沈み靡く。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
