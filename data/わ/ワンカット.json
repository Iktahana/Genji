        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "グロリア・スワソンの「サンセット大通り」にまるで見ちがえるほど年をとった姿をワンカット出演していたのは僕には淋しい思いであった。",
              "citation": {
                "source": "私の洋画経歴",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "セット七時すぎからかゝり、ワンカットでチョン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼ばれてワンカット、又休んで又呼ばれ――つひにクタ／＼とつかれた、終りが何と午前四時十分。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前中、こんなことでワンカット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入りて、ワンカット、廊下のとこを撮ると、待ちに入り、九時十時十一時――づっと無し、たゞひたすら待ちで、夜はほの／″＼と明けた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前中ワンカットで昼めしだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレベーターのとこワンカット撮る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから楽屋で休んじゃあワンカット、又休んじゃあワンカット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時頃から開始で、午前中、社長室ワンカット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前中ワンカットで昼になる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時迄にワンカット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉例の如く午前中ワンカットで昼休み、午後の撮影中、突如として今夜ロケーションだと言ひ出した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時からまだ四カットあったのを岡田敬も気をきかしてワンカットワンシーンといふスピードでやって呉れたので七時にアガり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタンドの掃除夫が掃いてるとこワンカット撮ると、もう待ち、結局これでおしまひ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後ワンカット撮ると待ち、セリフを渡されすぐ喋らされるので何うもうまく行かない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとワンカット、終ったのが六時。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月二十一日（水曜）　今日のオープンで終りといふ筈、十時近く城下町のオープン、たよりない陽であるが、移動をワンカット、かなり長いのを済ませる、ともう十二時、今日は東宝西撮影所の社長（？",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンシーンワンカット、三分何秒流しっ放しで、丸山定夫とのやりとりを一カット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東宝映画の連中来り、明日の一時頃から「忠臣蔵」のワンカットだけ撮って呉れと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "着くと、大東館といふ宿へ落ちつき、伊東駅のホームで、ワンカット撮す、と今日はアガリ、馬鹿々々しい、何のために此んなとこ迄来にゃならんか分らず。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前中、一郎の部屋ワンカット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
