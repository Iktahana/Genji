        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「これは痛快だ、こいつあおもしろい、ワッハッハハハハハハ、ワッハッハッハハハハハ、とてもたまらない、ワッハッハハハハハ、あれを見たまえ！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟板を虎の子みたいに抱いてるぞ、ワッハッハハハハハ」船長はころげ歩くばかりに笑い狂った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありがとう、いただきますわ」「ワッハッハ。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると下の方で「ワッハッハ。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大工とか左官とかそういった連中が溪のなかで不可思議な酒盛りをしていて、その高笑いがワッハッハ、ワッハッハときこえて来るような気のすることがある。",
              "citation": {
                "source": "闇の絵巻",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワッハッハッハッ」　それを見ると青年は、もう不思議を通り越して気味が悪いという顔になった。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワッハッハッハッハッハッハッ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワッハッハッハッハ……」　なぞと笑い合った位だから……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハッハッハッ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……もし僕が……呉一郎に……この絵巻物を……見せた本人……」「アッハッハッハッハッ……ワッハッハッハッハッハッ……」　正木博士は、私の云う事を半分聞かぬうちに大袈裟に吹き出して反りかえった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルチック司令官｜寝呆豆腐とござあい」「ワッハッハ」「しっしっ聞えるぞ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "地図を読む馬の先生……」「アッハッハッハッハッハッハッハッ……ワッハッハッハッハッハッハッ」　ストーン氏は又も堪らなく噴き出した。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「呉羽嬢と、その犯人とは連絡がある……九蔵氏を殺した犯人が無事に逃げられるように、わざと朝寝をして、事件の発覚を遅らした……」「ワッハッハッハッハ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハッハッ、思い知ったか！",
              "citation": {
                "source": "犬神娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハッハッ」と暢気そうに馬鹿にしたようにまず響いたが、「そんな事じゃ駄目だ、駄目だ。",
              "citation": {
                "source": "日置流系図",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワッハッハッ」とまた笑う。",
              "citation": {
                "source": "日置流系図",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハッハッハッまだ駄目駄目！",
              "citation": {
                "source": "日置流系図",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハッハッハッ、まだ駄目じゃ。",
              "citation": {
                "source": "日置流系図",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハッハッハッこりゃ面白い！",
              "citation": {
                "source": "北斎と幽霊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッハッハッ」　と老人は笑う。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワッハッハッハッ」　と笑う声がしたが夫れも矢っ張り雲の中からです。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワッハッハッ」「ワッハッハッ」「ああ夫れでは此私は天の使いではなかったのか」　二人の話を立聞きしていた四郎時貞は余りの意外に仰天しましたが、次に来たものは絶望でした。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
