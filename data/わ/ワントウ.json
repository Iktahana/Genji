[
  {
    "uuid": "9cebc370-9c5c-53c2-a6af-6092d51a8922",
    "entry": "湾頭",
    "reading": {
      "primary": "わんとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "bay shore",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "小さな漁村は、静かな湾頭に沿って家々が立ち並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "湾頭に停泊している船は、夕焼けに照らされて美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は湾頭のカフェで海を眺めながら、ゆっくりとコーヒーを飲んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "海路は相模国三浦半島から、今の東京湾頭を横断して房総半島の湊へ渡るのが船筋だった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道｜歌志内の鉱夫、大連湾頭の青年漁夫、番匠川の瘤ある舟子など僕が一々この原稿にあるだけを詳しく話すなら夜が明けてしまうよ。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギネタ湾頭の浅瀬に艇をのしあげて、ぼくたちは「やれやれ助かった」と思った。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人達は私に畑中の巨大な百二十畳敷けるという鬼岩を見せた上、小浜街道から自動車に乗せ、この人のために千々岩灘に橘湾の名を与えた湾頭の橘中佐の銅像を見せ、美しい千々岩の松原を見せた。",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よくいってくれたね次郎君、じつはぼくもそう思っているのだ」　サクラ湾頭に立てた旗がさんざんに破れたので、蘆をとって大きな球をつくりそれをさおの先につけることにした。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかづち夕に天半を過ぐ、烏帽子、国見の山脈に谷谺をかへせしその響は漸く遠ざかれり、牧島湾頭やがて面より霽れたれども、退く潮の色すさまじく柩を掩ふ布のごとき雲の峯々の谷間に埋れゆくも懶げなり。",
              "citation": {
                "source": "松浦あがた",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼子より殿の浦の背後を上り、やがて名護屋の渡りに下る湾頭きはまるところ更に入江をなし、あひせまれる両岸の崖は、影を清き潮にを吹きよせたり、渚のさざれは玉よりも滑かなり、眠れる渡守を呼び醒し悵然として独り城山に対す。",
              "citation": {
                "source": "松浦あがた",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "韓山の風雲に胸をおどらし、佐世保の湾頭には「今度この節国のため、遠く離れて出でて行く」の離歌に腸を断ち、宣戦の大詔に腕を扼り、威海衛の砲撃に初めて火の洗礼を授けられ、心をおどろかし目を驚かすべき事は続々起こり来たりて、ほとんど彼をして考うるの暇なからしめたり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あめりか物語」中最終の短篇にも書いた通り紐育湾頭の離島に夜の小禽が鳴く「六月の夜の夢」を見たのは、丁度々々このやうな古びたペンキ塗りの水道も電灯もない田舎家の一室であつたのだ。",
              "citation": {
                "source": "海洋の旅",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "そは明朝に至るを俟つて品川湾頭に飛ぶ白鴎に問ふ可し十二月十二日。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮に乗ってしずかに湾頭を去らんとするとき、北岸の汀に鹿がならんで、いぶかしそうに見送ってくれた」。",
              "citation": {
                "source": "汽船が太平洋を横断するまで",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "達府湾頭十万家、愛州又見此繁華、街如経緯人如織、幾百飛梭是電車。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "よって、余はダブリン湾頭といえり。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこを目指す遠征であるかの秘密はよく保たれ、それゆえ、一五九六年六月の末近く、イギリス艦隊が、キャデイズ湾頭に現われたのは、スペインにとってまったく寝耳に水だった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "この山は由布、鶴見などの山系とはやや離れて、別府湾頭にひとり超然として聳えておる。",
              "citation": {
                "source": "別府温泉",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この原理を敷衍すれば、菓子は「くわし」と書かずして「かし」と書き、關東は「くわんとう」でなくして「かんとう」、蝶は「てふ」でなくして、「ちよー」と書くべき筈である。",
              "citation": {
                "source": "ローマ字論者への質疑",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰向けた茶わんとうつ向けた同じ茶わんとが同一物である事を自得するまでにはかなりな経験を重ねなければならぬ。",
              "citation": {
                "source": "物理学と感覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "視感的空間では仰向きの茶わんとうつ向きの茶わん、一里を隔てた山と脚下の山とはあまりに相違したものである。",
              "citation": {
                "source": "物理学と感覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また豊臣秀吉が小田原城攻囲の際、天正十八年五月一日附けを以て、その妻すなわち大政所へ遣わした消息には、「小たはらの事はくわんとう（関東）ひのもと（日の本）までのおきめにて候まゝ、ほしころしに申付くべく候」とある。",
              "citation": {
                "source": "国号の由来",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いにしへチベリウス帝が奢をきはめ情を縱にし、灣頭より眸を放ちて拿破里の岸を望みきといふはこゝなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "品川灣頭に出でて見よ。",
              "citation": {
                "source": "鹿野山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘英が使命を果さずに、ペルシア灣頭から東歸したのは、千歳の下なほ遺憾に堪へざる次第である。",
              "citation": {
                "source": "東漢の班超",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔Abu^ Zayd〕 は 〔Si^ra^f〕 の産で、彼自身支那の地を踏まぬけれど、當時 〔Si^ra^f〕 はペルシア灣頭第一の貿易港として、東洋貿易に從事する商賈の出入頻繁であつたから、彼は此等の商賈に就いて傳聞せる所を筆録したもので、ヘヂラ暦三〇三年、即ち西暦九一六年頃の作と認められて居る。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "廣州の蒲姓と同時に、福建の泉州に居つて、巨萬の富を擁した舶はペルシア灣頭 〔Si^ra^f〕 の産の蕃商たること疑を容れぬ。",
              "citation": {
                "source": "蒲壽庚の事蹟",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
