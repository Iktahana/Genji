          "literary": [
            {
              "text": "キミノ仕事ノコルヤ、ワレノ仕事ノコルヤ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワレワレ通信技術者ガワレワレノ組立テタ器械ニヨッテ放出シテイル通信用電波ノ外ニ此ノ空間ニハ現ニ多種多様ナ未知ノ電波ガ飛ビ交ッテイルノダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "慈コレヲ聞キテ曰ク汝ラワレノ故ヲ以テ起程ヲ延ベント欲スル歟。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆ヤハ通イナノデ夕方水ダケ張ッテオイテ帰リ、瓦斯ニ火ヲ付ケルノハワレワレノウチノ誰カナノダガ、今夜ハ時分ヲ見計ラッテ郁子ガ付ケタ）ヘ行ッテ倒レタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ノ怨恨カアッテ、独リワレノミニ法ヲ説カザル。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
