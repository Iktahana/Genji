        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母は使い古した破れ鍋を大切にしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この破れ鍋では、もう料理はできないだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の人生は、まるで破れ鍋のようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "帰朝して六年めに四十歳で始めて娶ったが二十八歳の素女で、破れ鍋どころか完璧だった。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊楠も破れ鍋、ドッコイ、完璧に逃げられては換えがないから、実際よっぽど参って居ると自白して置く。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "破れ鍋が一つ、箱の底にゴロッと転がっているんです。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いきや、ころがりでたのは、真っ黒々な破れ鍋が一つ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも知らず左膳は、あの高大之進の一党が斬り込んだ時、命を賭して破れ鍋をかかえて、走ったとは、左膳一代の不覚――お藤の家でチョビ安をおさえられて、それと交換に、おとなしく大之進方へ渡した箱の中から、衆人｜環視のなかに出てきたのは、この鍋と、ありがたく頂戴の紙きれであった。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　門之丞眼を光らして、「丹波が、かの橋下の掘立小屋より、破れ鍋をかわりに置いて盗みださせたのを、拙者がまた、それと寸分違わぬ箱やら風呂敷を、ひそかにととのえて、この道場にある間にそっとすりかえたのです。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "中に入れたのは破れ鍋を碎いたのを一と抱へほど。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "例によつて破れ鍋の爲に午前十時頃まで茫然と暮してしまふ。",
              "citation": {
                "source": "黒岩山を探る",
                "author": "沼井鐵太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを目的にして国じゅうの「われなべにとじぶた」が鍋も蓋もじっとして、あんまり「自由」を求めたり急に「自由意識にめざめ」たりしないとすれば、人間オスカア二世は、仲なかどうして世話なおやじだったと言われなければならない。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、何の禁厭か知れぬまで、鉄釘、鉄火箸、錆刀や、破鍋の尻まで持込むわ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ吹雪に怪飛んで、亡者のごとく、ふらふらと内へ戻ると、媼巫女は、台所の筵敷に居敷り、出刃庖丁をドギドギと研いでいて、納戸の炉に火が燃えて、破鍋のかかったのが、阿鼻とも焦熱とも凄じい。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あ、あ、あ危ない、棚の破鍋が落ちかゝる如く、剩へべた／＼と崩れて、薄汚れた紀州ネルを膝から溢出させたまゝ、……あゝ……あゝ行つた！",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺達はすよりは、妄想をデツチ上げた恋愛小説でも作つて、破鍋にトヂ蓋の下宿屋の炊婦でも覘つたら可からう。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は店を孤鼠々々と飾り十位の學生帽子の息子は道にしやがんで、破鍋の中で火をおこして居る。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
