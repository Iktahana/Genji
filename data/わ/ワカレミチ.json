    "definitions": [
      {
        "index": 1,
        "gloss": "branch road",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この先にある分かれ道を右に進むと、駅への近道になります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "ハイキングコースの途中で分かれ道に出たが、地図がなくてどちらに進むべきか分からなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は分かれ道で立ち止まり、どちらの道が目的地に通じているか思案した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "この腕に縄が掛かるか、掛からねえかの分かれ道だ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "十五夜御用心",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くの間、私たちはその村はずれの分かれ道に、自分たちが無言でいることも忘れたように、うつけた様子で立ちつくしていた。",
              "citation": {
                "source": "菜穂子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生の道程でいくたびか出会った分かれ道、そのどこかひとつが変わっていれば、私はいまとは全く違ったものになっていたであろう。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでながら、私はあなたの馬車の音を聞かなかったですが、たぶんあすこの分かれ道の所の林の後ろに乗り捨ててこられたのでしょう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "探り探りの不安な逃走で、分かれ道などは全く不明な土竜の穴のような道程だった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はその分かれ道が下り坂になり始めてすぐのところまで、濁流がせり上がり渦を巻いて流れていた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「運命の分かれ道だ！",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕にとって今は自分の道を切り開くか、ぬかるみの中に留まっているかの分かれ道にいるのです。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、わかれみちに立つてゐた人は、しぶしぶ承知しました。",
              "citation": {
                "source": "百姓の足、坊さんの足",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて「濁り江」を讀み、「十三夜」を讀み、「わかれみち」を讀みもてゆく中に、先の「丸山新町」を思ひ出して、一葉女史をたゞ人ならず驚きぬ。",
              "citation": {
                "source": "一葉女史の「たけくらべ」を讀みて",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "運命のわかれみち　ロロー殿下は、長良川博士にしばらく待っていてくれるようにたのんで、また宮殿の奥をさして姿を消した。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャラコさんは、はじめての日、湖畔から宿のほうへ曲り込むわかれみちのところで佐伯氏に逢った。",
              "citation": {
                "source": "キャラコさん",
                "author": "蘆と木笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻、うちつれて追分の岐れ道を見、惆悵として帰る。",
              "citation": {
                "source": "海阪",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "この坂一つを無事に越すか越さぬかは、与之助に取っても一生の運命の岐れ道であった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "筆屋の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その一刻の猶予が、真に私にとつては天国と地獄の岐れ道とも思はれるのでした。",
              "citation": {
                "source": "祝福された星の歌",
                "author": "An episode from the forest",
                "note": "青空文庫"
              }
            },
            {
              "text": "大天井岳の前にて常念道、喜作新道の岐れ道あり、そこにルックザックを置き、大天井頂上を極む。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "田圃を通って、雑木山に入る岐れ道まで来た時、主人は白を抱き上げて八幡下に立って遙に目送して居る主婦に最後の告別をさせた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中で、桑の葉を重たそうに背負ってくる、汚れた顔をした若い娘たちと幾人もすれちがいながら、私たちはとうとう村はずれの岐れ道まで来た。",
              "citation": {
                "source": "菜穂子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　二軒茶屋というのは峠から谷へ降りようとする村はずれの紅葉と若葉の頃はバスの乗客がいずれも眼を輝やかせて絶景をたゝえる、県道と村道との岐れ道であるが、その人里をはなれた道ばたにスキイ帽をかぶつた屈強そうな男が、手提を手拭で肩にかついだまゝ、うつ向けに倒れ、そのからだは半ば既に雪の中に埋つていた。",
              "citation": {
                "source": "この握りめし",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここが策戦の岐路、運命の第一回目の岐れ道ださうである。",
              "citation": {
                "source": "勝負師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それについて、辰五郎という古老（勿論今は死んでいるが、当時八十五）の談によると、昔は岐れ道にあったが、慶応四年行幸のあったとき、通路に当って目ざわりだというので、他へ移したものだ、という。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもそこで岐れ道になっている田甫のあいだにはおりてゆかないで、彼女はきづかぬ風に、土堤道をさきへ歩いてゆく。",
              "citation": {
                "source": "白い道",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時、本流と祖母谷との岐れ道に着いて昼飯にした。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "万三郎は岐れ道のほうへと戻りながら、「どうしたんだみんな」　と役人たちに呼びかけた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "万三郎が進むと、そっちにいる三人が追って来た、三者が睨みあいのまま、岐れ道のほうへじりじりと移動するのであった。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふり向いてみると、追手は岐れ道を曲って来るところだった。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれも、彼の日が、生涯の岐れ道になって、とうとう、つまらない刀鍛冶に成っている』『そうか。",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "岐れ道の石が教えるところでは、川越の城下までまだ、これより三里半。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "西、天目山、鳥首ヲ越エテ天童谷ヨリ甲州路――　駆けながら見て通った岐れ道の道しるべには、どうやらこう記してあったように読まれましたが……今は何を振顧っているいとまもない。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あの人魚を食ったようにいつまでも若くて、飽くなき性の脂と白粉と、虚慢ないやしさを湛えているすべた女に、これからという男の岐れ道をこうされて。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
