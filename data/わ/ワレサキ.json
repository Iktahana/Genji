        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我先に其端艇に乘移らんと、人波うつて※閙く樣は、黒雲の風に吹かれて卷返すやうである。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　懸賞金百円の沙汰即日四方に喧伝して、土地の男女老若を問わず、我先にこの財を獲んと競い起ち、手に手に鎌を取りて、へいげん門外の雑草を刈り始めぬ。",
              "citation": {
                "source": "金時計",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "我先ず独り悦び、朋もまた悦び来たる。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに降り出したと思ったとたん、雨は肩を押し合いながら我先に地面を激しく叩き始めた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "で鈴の第一聲が鳴るか鳴らぬに、ガタ／＼廊下を踏鳴らしながら、我先にと解剖室へ駈付ける。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は痛さに堪えかねて、まだ張りもしないで砂の上に拡げてあったテントの下へ、我先にともぐり込んだ。",
              "citation": {
                "source": "虎狩",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供達は我先と、小突き合いながら、潮のように雪崩込んで来た。",
              "citation": {
                "source": "手品",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて人ごゝち附きて見れば、家のしりへの方に、紺屋の物干す料なる広く明きたる地のあれば、そこをさして我先にと往くなり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　汽車がプラットホームに、横付けになると、多くもなかつた乗客は、我先きにと降りてしまつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "会葬者に対する挨拶があると、会葬者達は、我先にと帰途を急いだ。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "大和伊豆、三浦越中、弘中三河守等の勇将は、敵は少し、恐るるに足らず、返せ返せと叫んで奮戦したが、一度浮足たった大軍は、どっと崩れるままに、我先に船に乗らんと海岸を目指して逃出した。",
              "citation": {
                "source": "厳島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しのびの兵」（透波間諜）のもち来る情報も入ったので、甲軍が隊を二分し、一は妻女山の背後に廻り、一は川中島に邀撃の計画であることが分ったので、我先ず先んじて出で奇襲を試みようと決心した。",
              "citation": {
                "source": "川中島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人二人の後は只我先にと乱れ入る。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "小供らも二人の態を見て、我先にと裾を捲つて水に入つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供らも二人の態を見て、我先にと裾を捲つて水に入つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　汽車がプラットホームに、横付けになると、多くもなかった乗客は、我先きにと降りてしまった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "この土地こそ、子より孫と代々相伝えて、此の畑は我が先祖の開きたる所、この樹は我先祖の植えたるものなりと言いはやされ、其の功は行末永く残るべし。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "足の達者なものは、我先にと山路を走つて、一散にその峠の上へと登つて行つた。",
              "citation": {
                "source": "歸國",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "サアお出だというお先布令があると、昔堅気の百姓たちが一同に炬火をふり輝らして、我先と二里も三里も出揃って、お待受をするのです。",
              "citation": {
                "source": "忘れ形見",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幹部達も我先にとその後を追った。",
              "citation": {
                "source": "組合旗を折る",
                "author": "永崎貢",
                "note": "青空文庫"
              }
            },
            {
              "text": "我先に異色を立てようとするのである。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "我先に朽つべき肉の中にありて汝を愛せる如く今｜紲を離れて汝を愛す、此故に止まらむ、されど汝の行くは何の爲ぞや。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "我先民が三韓を失して李唐の手に奪はれたるものは之が爲め也。",
              "citation": {
                "source": "深憂大患",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "我先民、雄畧の資なしと雖も、若し三韓をして我官家たるに止らしめず、斷乎として我屬國たらしめば統御の道便利あるのみならず、其租税によつて其民を治む、之を保つの道、决して難からざるべき也。",
              "citation": {
                "source": "深憂大患",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりもなおさず我先覚の諸士志士である。",
              "citation": {
                "source": "謀叛論（草稿）",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど、山崎の合戦で、羽柴軍と明智軍とが天王山を争うたように、この両箇の先陣が、その水門口をめがけて我先にと競いかかる有様が、米友にハッキリと読めました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと入り代りに、こちらに待兼ねた士農工商が、いま到着した渡し船に、普通ならば我先に乗込むのですが、今日は二の足を踏む者が多いのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "すは津波こそ、はや逃げよ、と老若男女われさきにと逃迷ひしかど、しばしが間に打寄て、民屋田畑草木禽獣まで少しも残らず海底のみくづと成れば、生残る人民、海辺の村里には一人もなし、扨こそ初に神々の雲中を飛行し給ひけるは此大変ある事をしろしめして此地を逃去り給ひしなるべしといひ合て恐れ侍りぬと語りぬ。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　汽車が来ると、帰る者たちは、珍らしい土産ものをつめこんだ背嚢を手にさげて、われさきに列車の中へ割込んで行った。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの星のやうな形のものは、漁師の投げた烏賊釣針に、われさきに争つて喰ひついてあがりました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
