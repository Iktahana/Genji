        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日の当番の割りは君だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "部長から新しい仕事の割りを言い渡された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "公平な割り振りになるよう、みんなで話し合った。",
