    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そんな訳であるから、遠くに先生を敬慕した人はもちろん非常に多かったに相違ないが、近づいて親密にした人は割合にすくない。",
              "citation": {
                "source": "正岡子規君",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "手だけは毎日石鹸で洗っている　こう云う調子に衰えてきた　此割合で推してゆけば結局の事もちゃんとわかる。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも建ちは割合に高くて、簡単な欄間もあり銅の釘隠なども打ってある。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "越石を持っていると云えば、世間体はよいけど、手間ばかり掛って割に合わないといつも母が言ってる畑だ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にそれが仮名によって多少程度の差があるのでありまして、オ段の仮名の方が他のものに比べて比較的例外が多く、オ段の中でも「ト」という仮名には割合に例外が多いのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "直線から成る割菱模様が曲線化して花菱模様に変ずるとき、模様は「派手」にはなるが「いき」は跡形もなくなる。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、いかに色と色とを分割してもなお色と色との間には把握しがたい色合が残る。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が振返ってすっかり青葉になってしまった桜を眺めている間に、羽織姿の桃割と赤前垂の丸髷とが交って踊り出した。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "とざせる思想の底を割つてしづかにながれるいのちをかんずるあまりに憂鬱のなやみふかい沼の底からわづかに水のぬくめるやうにさしぐみはぢらひためらひきたれる春をかんずる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君よ辨當をひらきはやくその卵を割つてください。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこでも見物は熱狂し、割れるように喝采した。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた、時に合宿所の割寢床で、彼が温き夜具の方へ、順番を好都合にしてもらへることを、密かにその神へ歎願した。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで機因は、宇宙の因果律が構成するところの、複雜微妙極みなきプロバビリチイの數學から割り出される。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉親の骨肉を負ひて道路に蹌行し、肉を以て氷を割らんとするの孝子傳奇蹟人物である。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けだし、彼等の認識中には、詩と散文との間に割線がなく、しばしば韻文の延べた線が、散文の方に紛れ込んでいるのを知ってるからだ。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちそれは有機的である故に、形式律の法則によって分析されず、数学的の計算によって割り出されない。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は氏の晩年の小説（歯車、西方の人、河童等）を日本文学中で第一位の高級作品と認めてゐるが、その俳句に至つては、彼の他の文学であるアフオリズム（侏儒の言葉）と共に、友情の割引を以てしても讃辞できない。",
              "citation": {
                "source": "小説家の俳句",
                "author": "俳人としての芥川龍之介と室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "常に彼の作品は、二二が四で割り切れる所の、あまりに常識的な理智的合理物でありながら、しかも言語の或るかくれたる影に於て、ふしぎに神祕的な「鬼」を感じさせる。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうして牧水氏との友情は、さまで親密とは言へないながら、お互に深い敬愛と好情とを感じ合つて、割合に長く續いてゐた。",
              "citation": {
                "source": "追憶",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時の酒飮仲間だつた歌人河野愼吾君は、幼ない婚約の妻をもつてゐるといふだけで、君の苛立たしき嫉妬を買ひ、幾度か本郷の街路に組み伏せられ、理由なく下駄で頭を叩き割られた。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏夫は割合に平氣な顏で、今朝の私の言葉は忘れてしまつてゞもゐるやうに、「何時で歸るの」と云つた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れは内臟を一つ／＼黒塗の滑らかな臺の上に乘せて腦刀で縱横に斷割つて見ながら、綿密な報告を落着いた言葉で記録者の方に云ひ送つた。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "著しく擴大した脾臟を割いて見ると粟粒状の結節を到る所に發見した。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
