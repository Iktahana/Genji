        "examples": {
          "standard": [
            {
              "text": "来月までにご予約いただくと、宿泊料金を20%割り引きます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このクーポンを使えば、会計から500円割り引いてもらえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大口注文の場合は、さらに価格を割り引くことが可能です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "何割引くか判然しない中は首を切られても、引きさがらない。",
              "citation": {
                "source": "世之助の話",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人萬兵衞の死んだ後では、この家の心棒になつて居るのは、お菊といふ一人娘で、これは矢の倉小町と言はれて十九、無口でおつとりして、親の萬兵衞の口やかましかつたのを、この娘の品のよさで割引くやうな、世にもすぐれた江戸娘でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "歩く死骸",
                "note": "青空文庫"
              }
            }
          ]
        }
