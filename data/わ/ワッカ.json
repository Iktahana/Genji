        "examples": {
          "standard": [
            {
              "text": "聖母マリアの絵には、柔らかな光を放つ **輪っか** が描かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "祭壇の上の天使の像には、美しい **輪っか** が取り付けられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "絵本の中の天使が、輝く **輪っか** をつけて空を飛んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
