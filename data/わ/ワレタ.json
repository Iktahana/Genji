        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コノトキ、私ニハドウシテモ、君チャンタチハオソロシイ、ノドマデクチノサケタオニノヨウニオモワレタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイ一カイノヒゲキハ、スデニオコナワレタリ。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると彼はダイ一カイノヒゲキハオコナワレタリ、云々という手紙を三通タイプライターで打つて持参し、同時に一方僕に『五月一日を警戒せよ』というあの手紙を郵送しておいて秋川邸にかけつけた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンガ　オツムノナカデ　クルクルマハツテ　パチント　コワレタノヂヤナイカト　オモツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ニハヒルマンヲ買ッテオヤリニナルノニ」ソウ云ワレタノガグット来テ、予ハハッキリト断ル決心ガツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコレ以上生キナガラエテイタトコロデ格別ノコトモナイノダカラ、モシ今ノ世ニオ伝ノヨウナ女ガ現ワレタラ、ムシロソノ女ノ手ニカヽッテ殺サレタ方ガ幸福カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ予ハ行カズニシマッタノデ、委シイ様子ハ知ラナイガ、アトデ聞クト、餘リ嫌味ヲ云ワレタノデ却テ颯子ガ反撃シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ縁側カラ庭ヘ下リヨウトスルト、「佐々木サン、今日ハイヽワヨ、アタシガオ供スルカラ」ト、不意ニ颯子ガ何処カラカ現ワレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ来ナイノカネ」「エヽ、這入ッテラッシャイ」云ワレタノデ這入ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ハ若イ時美人ト云ワレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ美人ト云ワレタ時代ノ彼女ノ姿ヲ記憶シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分ソノタメニ和服ヲ着、ソレヲ見セルベク予ノ面前ニ現ワレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルデ猛獣ガ現ワレタヨウナ気ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カヨイ治療法ハナイモノデショウカ、御老人デイラッシャルノデ、牽引法ソノ他手数ノカヽル面倒ナ方法ハオイヤナンデスガ、ト云ッタトコロ、ソレニハ方法ガナイコトハナイト、博士ガ云ワレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ内心非常ナ不安ニ襲ワレタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテソノ麻痺状態ニ置カレテイタ期間ハモノノ二三十分ニ過ギズ、間モナク遮断サレテイタ神経ノ通路ガ復舊シ、失ワレタ記憶ガ戻ッテ来テスベテガ平生ノ通リニナッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
