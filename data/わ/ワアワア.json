[
  {
    "uuid": "06fea83c-5e8f-5952-8809-47fe6f773765",
    "entry": "わあわあ",
    "reading": {
      "primary": "わあわあ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
