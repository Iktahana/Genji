        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "和顔愛語ということ　今は故人になっていますが、私のかつて教えた学生の一人に、阿部という男がありました。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいつもその男に「和顔愛語」という、菩薩の態度を話したことです。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "和顔とは、やさしい和かな顔つきです。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしとにかく和顔と愛語の二つは、我人ともに十分に、心懸けねばならないと存じます。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
