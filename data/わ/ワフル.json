          "literary": [
            {
              "text": "夕食は一人で不二アイスでホットワフルのハム附とポンキンパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終って不二アイスへ寄り、トマトクリーム、ローストビーフに、ワフルを食ひ、又日劇へ寄って「日本女性読本」を見る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座通りで徳山と逢ひ、三人で歩く、伊東屋へ入るとサイン攻めでくさり、出ると松島屋で眼鏡を作らせて、かけ代へる、不二アイスで、トマトポタアジュ、白魚フライ、ワフルベーコン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊田と不二アイスへ寄り、白魚フライにワフル。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
