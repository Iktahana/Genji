        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "古來歴史上の大科學者、例へばガリレオや、ワツトや、ニユートンや、エヂソンやが、その少年時代に於て、いかに夢想的な子供であり、いかにフアンタスチツクな童話の愛好者であつたかを、彼等の教育者等は知らないのである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士の四合目から以上を輪切りにすれば、木山に対するいわゆる石山で、イワツメグサ、オンタデなど、薄い髪の毛のような草はあっても、眼にいらず、ただ見上げるばかりの岩石の堆積である。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "der Bettler,」と小声で言って煙草を捨て、靴の先で踏みにじりながら、「支那ではね、乞食の事をホワツと言うのです。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい山田下りて來い、と二階を大聲で呼ぶと、ワツといひさま、けたゝましく、石垣が崩れるやうにがたびしと駈け下りて、私の部屋へ一所になつた。",
              "citation": {
                "source": "怪談女の輪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "長啄能獵――パン／＼と厚皮な鼻が、鼻へぶつかつたから、「ワツ。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆ワツと言つて駈出した。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よし子は画筆の手を休めて、両手を伸ばして、首をあとへ引いて、ワツトマンを成るべく遠くから眺めてゐたが、仕舞に、小さな声で、「もう駄目ね」と云ふ。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムライハ　一シヨウケンメイ　ニゲマシタガ　イキガ　キレタノデ、ミチバタヘ　バツタリ　スワツテ　シマヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミズグルマノ　マワツテ　ヰル　ソバデ　パンヲ　モツタ　ヒトリノ　ヒヤクシヨウニ　アツタノデ、「オイ　コヒツジト　パント　トリカヘツコ　シナイカイ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊版で、ワツトマンの純白な紙に、富岡鐵齋翁の金字塔といふ字を金箔で捺した清雅な裝幀でしたが、高安氏に會ふと、尾崎氏は同じやうにこの本の裝幀をほめ、『私もこんなにして本を出してみたい。",
              "citation": {
                "source": "詩集の後に",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉饅頭８・29（夕）　近頃チヤールス・シユワツブといふ男が、カアネギーと他の富豪との比較をした事がある。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "シユワツブはかう言つてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからシユワツブは言つてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だがの、今朝眼がさめて自分の寝相を見ると、乃公の身体が寝台の外に食み出してゐて、まるでワツフル（お菓子）のやうだつたよ、はゝゝゝ……」　人間は時々自分をナポレオンやソクラテスに比べるやうに、お菓子や眼薬の壜にも比べてみる必要がある。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人こそ誰あらう、ベスレム製鋼会社の社長から螽斯のやうに一飛びして米国管船局総裁の位置に上つたチヤールズ・シユワツプ氏である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "――忘れてゐたが、シユワツプ氏は独逸系の米人である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この少年は誰あらう、今米国の造船総監として非凡の手腕を揮つてゐるチヤアルズ・シユワツブ氏その人である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ビステキが食ひたさに牛を殺すとは８・６サンデー毎日　チヤアアルズ・シユワツブ氏は今では閑地で遊んでゐるらしいが、戦時中はアメリカ切つての働き手として、その凄い腕つぷりをみせたものだ。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのシユワツブ氏が、ある時自分の古い別荘をとりのけて、その跡へ新しいのを建てかへようとしたことがあつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "シユワツブ氏は、これまでの古い家を、今はもうそれに要がないからといつて、ばらばらに毀すことを好まなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "請負師は困つたやうにいく度か立木のなかを見あるいてゐたが、やがてシユワツブ氏の前へ出て来たをりには、晴々しい顔つきをしてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」シユワツブ氏は苦い顔をした。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのシユワツブ氏が、ある時黒ん坊の運転手と肩を並べて、同じ運転手台に腰を下して、紐育の街を走らせてゐたことがあつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、街を通り合せた二人の紳士があつたが、その一人が自動車を指ざして、「あれ、あの車に名高いシユワツブさんが乗つてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、今一人の紳士は、「なに、シユワツブさん？",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをちらと小耳に挟んだシユワツブ氏は、長い一生を通じてその瞬間ほど、どやしつけられたやうな思ひをしたことはないといつたさうだ。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは両手の使ひわけだが、アメリカのチヤアルス・シユワツブは人一倍器用な性で、ピアノに向かふと左手では“Yankee Doodle”を弾き、右手では“The Star-Spangled Banner”を打ちながら、同時に口笛では“Home, Sweet Home”を吹くさうだ。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "閑７・26サンデー毎日　いつでしたか、米国の実業家が五六人、資本を出しあつて、ベスレヘムの鋼鉄会社を買収しようとして、その議を持主のチヤアルズ・シユワツブ氏に申込んだ事がありました。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "シユワツブ氏は、家に帰ると、早速その由を夫人に打ち明けました。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シユワツブ氏は、それを聞くと、初めて安心したやうににつこりしました。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
