        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キイテ　タイソウ　ヨロコンデ「ヨシヨシ　ワタシモ　コノコブヲゼヒトモ　トツテ　モラヒマセウ」　と勇み立つ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホントウニ　ソウデスヨ、ワタシモ　ハヤク　ボウヤニ　コノ　ヨイ　セカイヲ　ミセテ　ヤリタクテ　タマリマセン」ト　ウマハ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシモ、ゲンキデス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシハ、アクネンユエ、タダジットシテイマス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシワ、アクネンユエ、ジツトシテイマス。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに働かされると、ワタシモ、ドコカヘ、カエッテシマイタイ。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、アナタ、モウ、ワタシノモノアリマス、逃ゲラレマセン」「ばかにおしでないよ、お前さんなんて、ウスノロのくせに」「アナタ、モウ、ワタシニ許シタデス、ワタシモウ、アナタ離サナイデス」「しつこい奴ね」「アナタ、ワタシノモノデス」「あ、畜生！",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサン、　新サンモ、ワタシモ、アナタタチ夫婦ノ、昔カラノ事ヲヨク知ツテ居ルノデ、金五郎サンニ、女ナドハ作ラセナイ様、ズイブント骨折ツテ来マシタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "新サンモ、ワタシモ、イツモ、オ京サンニ向カツテ、口グセニ、　――玉井サント切レテクレ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシモクロガコイシクテナリマセン。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
