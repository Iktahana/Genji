        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この問題は感情的にならず、論理的な割り切りが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "仕事とプライベートはしっかり割り切りが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の考え方には、ある種の割り切りがあり、潔さを感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これぞ売文業者の割り切り、プロ根性と感心すべきかなとも思ったが、書く側に回ってもオレにはやはりそんなご立派な真似はできやしない。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中でも比較的知能指数の高い者はこれを早目に英語マシンと割り切り、新しいアプリケーションの鑑賞やゲームといったツボに味わい所を限った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＶｉｓｉＯｎはマシン側にハードディスクを求め、専用のアプリケーションしか動かすことができないという割り切りによって、実用性を高めようとしていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「敗戦を口実にするのが、卑怯なのです」　と語気強くつけたしたから、私もいさゝかその割り切り方に反撥を感じて、「然し、ヤス子さん。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの割り切り方の底には、小学校における「嘘をつかない教育」がある。",
              "citation": {
                "source": "自由と進歩",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吝嗇というのではないが泰文は徹底した自己主義者で、金銭に関しては、前例のないほどキッパリした割り切りかたをし、子供の一代に金をかけることなどに、なんの意義も感じていなかった。",
              "citation": {
                "source": "無月物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の生き方、人生の割り切りかたにも、心情美がある。",
              "citation": {
                "source": "紅梅の客",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "電子出版にはいくつかの試みがありますが、先ず紙と縁を切ると決め、画面で長文を読んでもらおうと腹をくくった割り切りが、この道具に独自の個性と強みを与えています。",
              "citation": {
                "source": "青空文庫の提案",
                "author": "青空文庫編",
                "note": "青空文庫"
              }
            },
            {
              "text": "不自由なからだを何時までも、すわりきりに、板についたまゝの舞台で勤めた僚友を見て、彼一流の冷笑を放つたこともあらう。",
              "citation": {
                "source": "戞々たり　車上の優人",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんなの　おねえさんの　みずかきリベカは、　たまごを　あたためるにしても　はじめから　だれかに　まかせっぱなしで　――「わたし　こらえしょうが　ないから、　２８にちも　たまごのうえに　すわりきりだなんて　むり。",
              "citation": {
                "source": "みずかきジェマイマのはなし",
                "author": "THE TALE OF JEMIMA PUDDLE-DUCK",
                "note": "青空文庫"
              }
            },
            {
              "text": "それによって惣七は、一室にすわりきりでいながら、世の中が春に近いことを知っている。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所か居間かにすわりきりだった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして彼女は幾時間もの間｜椅子にすわりきりでいた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽が西へまわりきり、海に向けて落ちていく頃になってようやく、重なり合う不細工な高層の建物のなかから、ロイアル・ハワイアン・ホテルのピンク色の建物を、太陽の光は選び出してくれる。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鏡のような皿のスープにうら恥かしきわが相貌を可憐なるこの餓鬼達が写す時給仕は、柘榴程の大きさの割切りにした牛の骨を運んで来た。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たうてい医しがたく割切りがたい苦汁のやうな哀愁であつた。",
              "citation": {
                "source": "蒼茫夢",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一生をシニックな思弁で通した大人たちでも、思弁では割切りがたい甘さが残つてゐるものである。",
              "citation": {
                "source": "木々の精、谷の精",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "泰文は吝嗇というのではないが、徹底した自己主義者で、金銭のことにかけては前例のないほどキッパリした割切りかたをし、子供の一代に金をかけることなどになんの意義も感じていなかった。",
              "citation": {
                "source": "無月物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりに幼稚であり、単純すぎる割切り方であるが、単純なだけに、なにやら「ずばり」としたものが感じられ、いってみれば、躯を張って生きている者のぎりぎりの本音、というふうな印象で、彼にはちょっと抵抗のできないものがあった。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何もかも自分の判断で割切りそして行動していると信じていたのだが、それもあやふやなもののように思われた。",
              "citation": {
                "source": "日の果て",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
