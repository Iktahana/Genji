        "examples": {
          "standard": [
            {
              "text": "このプロジェクトは大変そうだけど、長期的に見れば割に合う投資だよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「そんなに労力をかけるのは、割に合わないんじゃないか？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "少々残業しても、お客さんに喜んでもらえれば割に合うものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これは衛生学部だと狂犬病の実験に供して、高価い予防注射液を作る資本にするから、割に合うので、生理や解剖だと切積った研究費で博士になろうと思っている筍連中が、単なる使い棄てに使うつもりだからだろう。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうして、そう安く売って割に合うんでしょう」としまいに聞き出した。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
