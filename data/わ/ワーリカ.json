        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だからって、どうしてワーリカが不仕合わせにならなけりゃならないんだ。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所と洗濯桶と亭主とワーリカが命である。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れたばかりのワーリカ。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワーリカとあんたとは俺にとってたった一つの、ほんものの血縁だ。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三になる子守り娘のワーリカが、赤んぼの臥ている揺りかごを揺すぶりながら、やっと聞こえるほどの声で、つぶやいている。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈明から、みどり色の大きな光の輪が天井に射し、お襁褓やズボンは、ほそ長い影を、煖炉や、揺りかごや、ワーリカに投げかけている。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリカは、ねむくてたまらない。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……揺りかごは悲しげにきしり、当のワーリカはぶつぶつつぶやく――それがみんな一つに溶けあって、夜ふけの寝んねこ唄を奏でているのを、寝床に手足をのばして聞いたら、さぞ楽しいことだろう。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "まんいちワーリカが寝こんだら最後、旦那やおかみさんに、ぶたれるだろう。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "みどり色の光の輪と影が、また動きだして、ワーリカの半びらきの、じっとすわった眼へ這いこむと、はんぶん寝入った脳みそのなかで、もやもやした幻に組みあがる。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ、さっと風が吹いて、雲が消えると、ワーリカには、いちめんぬかるみの、ひろい街道が見えだす。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、ワーリカがきく。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねんねんよう、おころりよ、唄をうたってあげましょう……」と、ワーリカはつぶやくと、今度は自分が、暗い、むんむんする百姓小屋のなかにいるのが見える。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリカはカマドの上に横になって、まんじりともせずに、父親の『ブ・ブ・ブ』に聴き耳をたてている。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかで赤んぼが泣き、ワーリカの耳には、誰かしら自分の声で、うたっているのが聞こえる。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　ワーリカは森へ行って、そこで泣いている。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見ていると、ワーリカはたまらなく眠くなる。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ワーリカはとびあがって、あたりを見まわし、ことの次第をのみこむ。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふとった、肩幅のひろいおかみが、赤んぼに乳をふくませ、あやしているあいだ、ワーリカは立ったまま彼女をながめ、すむのを待っている。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ワーリカは赤んぼを受けとり、揺りかごへ入れて、また揺すぶりはじめる。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリカは頭を揺りかごのふちにもたせ、なんとか眠気に勝とうとして、胴なか全体で揺すぶるけれど、眼はやっぱり自然にくっついて、頭が重たい。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワーリカ、煖炉を焚くんだ！",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリカは揺りかごを離れて、物置へ薪をとりに駈けだす。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワーリカ、サモワールをお立て！",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリカは木っぱを割る。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「ワーリカ、旦那のゴム長をきれいにおし！",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリカはブラッシをとり落とすが、すぐさま頭を振り、眼をむきだして、そのへんのものが目蓋のなかで、伸びたり動いたりしないように、懸命にじっと見つめる。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワーリカ、表の段々を洗っとけ。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ワーリカは段々を洗い、部屋部屋の掃除をし、もう一つべつの煖炉を焚きつけ、それから店のほうへ駈けてゆく。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓が暗くなってくるのを眺めながら、ワーリカは、木のようになったコメカミを両手でしめつけて、にっこりする。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
