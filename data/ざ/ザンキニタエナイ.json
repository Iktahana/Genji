    "definitions": [
      {
        "index": 1,
        "gloss": "deeply ashamed (of oneself)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年支えてくれた恩師の期待を裏切る結果になり、慚愧にたえない思いで謝罪の手紙をしたためた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "自分の軽率な発言が友人を深く傷つけてしまったことに、慚愧にたえない気持ちでいっぱいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "部下のミスを見逃してしまい、上司として慚愧にたえない気持ちで取引先に頭を下げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "慚愧にたえない姿をして、枕に額を押しあてた儘、息ぎれのやむまで、俯伏していた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……考えれば慚愧にたえない。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――実は慚愧にたえないので、出舷の前に、都督に会って、そう偽りのない気もちを語り、旧来の罪を謝して来たわけだ」と、しきりに懺悔していた。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "国家の厚恩をうけ、一城の守りを任ぜられ、かかる一期の時となって、城を捨てて遁れんなどという気持をふとでも起したのは慚愧にたえない。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
