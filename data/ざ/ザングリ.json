        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "目差したは左肩、ザングリ一刀、切り付けたとばかり思ったところ、どうして反せたか薪十郎、「駄目だア」とばかりピョイと反せ、幹之介のよろめく足の辺り、これも感覚、両手の諸薙ぎ、杖を揮ってひっ叩いた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "下町の好みは、髮をザングリと油でかためずに、ものものしく結ひあげない。",
              "citation": {
                "source": "下町娘",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、技巧に溺れないザングリした、しかも芸術的に高度なもの。",
              "citation": {
                "source": "芸術としての探偵小説",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
