        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ケサノコノ走リ書モマタ、純粋ノ主観的表白ニアラザルコトハ、皆様承知。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ義務ニセヨ、父母妻子ノ負擔アル男子ヨリ其ノ勞働ヲ奪ヒテ何等ノ賠償ヲナサザルコトハ國家ノ權利ヲ濫用スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ積極的發展ノ爲メニ戰フコトノ單ナル我利私欲ニ非ザルコトハ、他ノ民族ガ積極的覺醒ノ爲メニ占有者又ハ侵略者ヲ排除セントスル現状打破ノ自己的行動ガ正義視セラルル如ク正義ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自利ガ罪惡ニ非ザルコトハ自滅ガ道徳ニ非ザルト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "那珂氏が博士の説に對して此ノ山門郡ハ、筑前ナル國々ト相近クシテ、魏志ノ行程ニ合ハザルコトハ、近藤氏ノ山門郷ヨリモ甚シ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
