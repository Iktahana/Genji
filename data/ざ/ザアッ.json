    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sound of water",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "蛇口を開けると水がざあっと流れ出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "雨がざあっと降ってきたので傘を広げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ホースからざあっと水を噴いて庭を潤した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "すると空中にざあっと雨のやうな音がして何かまっくらなものがいくかたまりもいくかたまりも鉄砲丸のやうに川の向ふの方へ飛んで行くのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると空中にざあっと雨のような音がして何かまっくらなものがいくかたまりもいくかたまりも鉄砲丸のように川の向うの方へ飛んで行くのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると空中にざあっと雨のような音がして、何かまっくらなものが、いくかたまりもいくかたまりも鉄砲丸のように川の向こうの方へ飛んで行くのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すきとおった風がざあっと吹くと、栗の木はばらばらと実をおとしました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでゐて、その夕方に又あの丁場がざあっと来たもんです。",
              "citation": {
                "source": "化物丁場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時風がざあっと吹いて来て土手の草はざわざわ波になり、運動場のまん中でさあっと塵があがり、それが玄関の前まで行くと、きりきりとまわって小さなつむじ風になって、黄いろな塵は瓶をさかさまにしたような形になって屋根より高くのぼりました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　みんながまたあるきはじめたときわき水は何かを知らせるようにぐうっと鳴り、そこらの木もなんだかざあっと鳴ったようでした。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき耕助はまた頭からつめたいしずくをざあっとかぶりました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　おしまい何と云ったか、風がざあっとやって来て声をもって行ってしまいました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時友だちがまわるのをやめたもんだから、水はざあっと一ぺんに日詰の町に落ちかかったんだ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたらやっぱり、今度もざあっと雫が落ちて来たのです。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「逢ったとたんに、二人のあいだに波が、ざあっと来て、またわかれわかれになるね。",
              "citation": {
                "source": "メリイクリスマス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自分のからだがずっと高まってやがてまた落ちて行くなと思わしいころに、窓に近い舷にざあっとあたって砕けて行く波濤が、単調な底力のある震動を船室に与えて、船はかすかに横にかしいだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たわけたちめがっ」　さっと横へ、青い光りが伸びたかと思うと一緒に、ざあっと、小次郎たちふたりの背から血がふきあがった。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どこかに水があったら、ざあっと一ぺえかぶりてえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまえ、下の道が田んぼにむかって、途中で消えてるのは、なんでだと思ってたんだ」「なんでって、あそこで敷地が終わるからじゃない」「じゃあ、わざわざあっちまで舗装することはない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "水がざあっと看護婦の白い制服にひっかかって、たいへんなことになった。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『じっさい、』と床屋は私の頭のうえで、『もう二、三時間もしたらわたしの考えじゃあざあっと一雨来ますね。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、ざあっと水の音がし出した。",
              "citation": {
                "source": "踊る地平線",
                "author": "ノウトルダムの妖怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどどこにもかしこにも同じような赤や青のペンキを塗りたくった家ばかりで、折からざあっと土砂降りになった雨の水煙りにけぶって見えなくなる。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとたんに雨がざあっと土砂降りにかわり、一陣の野風がごうと吼え襲って来た。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとにざあっと十本。",
              "citation": {
                "source": "通り雨",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨は、羅生門をつつんで、遠くから、ざあっと云う音をあつめて来る。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまにも足もとの土がざあっと崩れるのではないか――踏む一足一足にも力を抜くようになる。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "大地の亀裂が蜈蚣のような罅からだんだんに拡がるあいだから、吹きだした地下水がざあっと傾いだ方へながれてゆく。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとざあっと一風呂浴びて来ました。",
              "citation": {
                "source": "舞馬",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからざあっと一月又会わなくなると云う事等は一寸も悲しい事にも淋しい事にも思えなかった。",
              "citation": {
                "source": "千世子（二）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
