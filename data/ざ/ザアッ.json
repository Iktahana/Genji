  {
    "uuid": "ddff3134-0dbd-543b-adf7-4f6fea8e9e77",
    "entry": "ザアッ",
    "reading": {
      "primary": "ざあっ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　風がザアッとやって来ました。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ある晩空の下の方が黒い雲で一杯に埋まり雲の下では雨がザアッザアッと降って居りました。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨つぶはだんだん数が増して来てまもなくザアッとやって来ました。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからザアッと鳴りました。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザアッと水が降りかゝってあたりの湯気をはらうと、お君のピチ／＼と弾み切った肢体が妖しくふるえながらすくっと立っている。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "外は真暗で、雨の音は例の如くザアッとしている。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると戸外の雨の音はザアッと続いていた。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋外は雨の音、ザアッ。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞもう雨の音ばかりザアッとして、空虚にちかい晩成先生の心を一ぱいに埋め尽してゐるが、ふと気が付くと其のザアッといふ音のほかに、また別にザアッといふ音が聞えるやうだ。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "外は真暗で、雨の音は例の如くザアッとして居る。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると戸外の雨の音はザアッと続いて居た。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "大雨が、ザアッと降ってきたんでしょうか？",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ザザザザ、ザアッと浪が舷側を撃った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手の寒竹の繁みが、ザアッと鳴った。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザアッ――と、刷毛ではいたようなにわか雨でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂村から葛飾野の空へかけて、ザアッ、ザアッ、と早足の雨がうなって通りすぎるのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザアッ、ザアッと、けたたましく降り募って、しぶきの煙が川一面にもうもうとたちこめながら、さながらに銀の幕を引いたかのようでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザアッ、ザアッと、また通り雨……。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザアッ、ザアッと、いまだにふりしきる夕だちの中を、雨がっぱにくるまった寺男の姿が、ぬれつばめのように土手の向こうへ消えました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
