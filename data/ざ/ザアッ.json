[
  {
    "uuid": "9d586146-22e6-50dc-b16e-384354a981e0",
    "entry": "ざあっ",
    "reading": {
      "primary": "ざあっ",
      "alternatives": [
        "ザーッ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
