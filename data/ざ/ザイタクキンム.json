        "examples": {
          "standard": [
            {
              "text": "新型コロナウイルスの影響で、多くの企業が在宅勤務を導入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "在宅勤務のおかげで、通勤時間がなくなり、自分の時間を有効に使えるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は集中できる環境を整え、在宅勤務でも高い生産性を維持している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "体調が優れず、自宅療養と可能な限りの在宅勤務となるかも知れないと言う。",
              "citation": {
                "source": "短く語る『本の未来』",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
