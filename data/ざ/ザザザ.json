        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "波の音がかすかにザザザと聞えて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はちすずめがたびたび宝石に打たれて落ちそうになりながら、やはりせわしくせわしく飛びめぐって、ザッザザ、ザザァザ、ザザァザザザァ、降らばふれふれひでりあめひかりの雲のたえぬまま。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、はちすずめは、だんだんゆるやかに飛んで、ザッザザ、ザザァザ、ザザァザザザァ、やまばやめやめ、ひでりあめそらは　みがいた　土耳古玉。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お空のちゝは、つめたい雨の　ザァザザザ、かしはのしづくトンテントン、まっしろきりのポッシャントン。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お空のちちは、つめたい雨の　ザァザザザ、かしわのしずくトンテントン、まっしろきりのポッシャントン。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ザザザザ、ザアッと浪が舷側を撃った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "とつぜん、昇降階のしたでザザザザという太鼓の音。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのまま、ザザザッ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "波の音が未来も過古もない荒んだ都会のセメントをザザザと崩す日を思へ！",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザザザと水の軋るような音がする。",
              "citation": {
                "source": "廃墟から",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち雨と風がアスファルトの上をザザザと走りまわった。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザザザと水の軋るやうな音がする。",
              "citation": {
                "source": "廃墟から",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち雨と風がアスフアルトの上をザザザと走りまはつた。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の音かはしらぬが、カーンカンと金物を打つ鋭い音が冴々と聞えるかと思うと、またザザザーッと物をぶちまけるような高圧蒸気の音がするのであった。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれ共、松のある出島の裾まで、白い波頭がゆるやかに見渡せて、ザザザザ――と云う響が、遠くから、次第に近く、よせて来て低い砂を□う波が、白い水泡をのこしては引いて行く様子は必して悪いはずもない。",
              "citation": {
                "source": "冬の海",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏の竹藪で雪を落してはね返る若い竹のザザザッと云う音が快く聞えて来る。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザザザザと破片をすくう音が私の耳にのこった。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "繁吹をあげてザザザザーッ……と頭を揺すぶる竹藪の音が、激浪のやうに荒れ狂ふ裏手一帯の劇しい起伏を未だ一杯に温気の籠めた朝の部屋に歴々と描き出して見せてしまふ、かと思ふと、突然硝子を射抜くやうな太く真つ直な雨脚がヂヂヂヂヂイーと一頻り窓に噛みつくのであつた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ザザザと足音をさせて坂道を走りおりて行く）次郎　へつ！",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "健二　そら、行くぞ、お花どいてろう……カーンと打ちこんだ音でヒノキの大木がベリベリベリ、ザザザーッと倒れる音。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザザザーアと急流の響。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それの立てる波がザザザジャブンジャブンと寄せる音。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザザザザと通過して了う。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
