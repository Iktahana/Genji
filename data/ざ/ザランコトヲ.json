          "literary": [
            {
              "text": "然ルニ今次ノ大戰中ニ於テ日本ハ獨逸ノ青島ヲ領有シテ支那ニ還附セザランコトヲ企ツルト共ニ、獨逸ノ投資ヲ繼承シ更ニ北支那ニ投資的侵略ヲ學ビタルコト悉ク獨逸ノ跡ヲ追フ者ナラザルハナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "独リ予及ビ三島遠叔ニオケルヤ盛ニ推許ヲ加ヘ、人前ニ称道シテ唯及ザランコトヲ恐ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
