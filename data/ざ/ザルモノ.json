        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "而シテ外、英米獨露悉ク信ヲ傷ケザルモノナク、日露戰爭ヲ以テ漸ク保全ヲ與ヘタル隣邦支邦スラ酬ユルニ却テ排侮ヲ以テス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ此ノ場合ニ於テ國家ハ別途其ノ父ニ對シテ賠償ヲ命ジ、從ハザルモノハ勞働ヲ課シテ賠償ニ充テシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが真実に子供たちの運命を予言しうるものとすれば（実験の結果によれば――と当代の心理学者が権威をもって発表する）コノ指数ニ満タザルモノハトウテイ社会有用ノ人間タルコトヲ得ズ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ハ日本人ナルカト思イタレドモ、後ニ至リテ彼等ハ日本人ニハ非ザルモノノ如キコト判明セリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ本願出願以前、帝国領土内ニ於テ、義手或ハ義足ガ公然製造使用セラレタルコトハ、例エバ明治三十九年東京市下谷区御徒町仁愛堂発行ノ「義手義足型録」ニ依リテ公知ノ事実ナリ、仍リテ本願ハ特許法第一条ニ該当セザルモノト認ム』　と、拒絶理由が述べてあった。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "仍リテ本願ハ其ノ出願以前ニ於テ、公知ニ属スルヲ以テ、特許法第一条ニ該当セザルモノト認ム』　審査官は、千手観音を持ち出して、この出願を一蹴したのであった。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "仍リテ両者ハ根本的ニ構造ヲ異ニスルモノト謂フベク、従テ本願ハ、援用立像ヲ以テ拒絶セラルル理由ヲ発見シ得ザルモノナリ。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ甘ジテ之ヲ為ス所以ノモノハ洵ニ国家生民ノ為ニ図リテ一片ノ耿耿竟ニ忍ブ能ハザルモノ有レバナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ然ラズシテ長ク毒水ノ横流ニ任セバ臣ハ恐ル其禍ノ及ブ所将サニ測ル可ラザルモノアランコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ花鈿委地ノ惨禍亦深ク哀シムニ足ラザルモノ有リ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "一朝其品ガ消滅スルニ忍ビザルモノ有ラン。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ユルコトヲ得ザルモノ三十六年……　そこで一座は笑いながら、三十六年も大げさだが、これら女護の島の女人たちの多くが、性の悩みに堪えきれないでいることだけは明らかな事実で、その関を突破さえすれば、洪水のように流れ出して来るのだという。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "古語に『自ラ求メザルモノニ向ツテハ哀楽ソノ前ニ施スべカラズ』というのがございます、世にこの求めざるの心ほど強いものはございません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "即チ其通義トハ人ノ自カラ生命ヲ保シ自由ヲ求メ幸福ヲ祈ルノ類ニテ、他ヨリ之ヲ如何トモス可ラザルモノナリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ淫肆放縦ニシテ獲ル所ノモノハ直ニ濫費シテ惜シマザルモノアリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ当初稿ヲ脱セシ時ヨリ既ニ半歳ヲ過ギ一時｜蒐集シタリシ資料ノ今｜蚤クモ座右ニ留メザルモノマタ鮮シトナサズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ時勢ノ変ニシテ兵法ノ一定シテ論ズベカラザルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ他イマダ梓セザルモノ長短七、八百首アリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ千仞ノ如クニシテ而シテ後始テ書生ノ面目ヲ失ハザルモノトイフベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "古来往々突尋スルモノ得テ見ルモノアリ、得テ見ザルモノアリ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ甘ジテ之ヲ為ス所以ノモノハ、洵ニ国家生民ノ為ニ図リテ、一片ノ耿々竟ニ忍ブ能ワザルモノ有レバナリ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ然ラズシテ長ク毒水ノ横流ニ任セバ、臣ハ恐ル、其禍ノ及ブ所将ニ測ル可ラザルモノアランコトヲ」　最後はまた、次のような哀切極まる文字をもって結んであった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "快楽、虚栄、又アラユル欲望ニ惑溺シテサメザルモノハ、必ズ、命七日ニ終ラン――　ほんとうに仏陀はそう仰っしゃったのかしら？",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
