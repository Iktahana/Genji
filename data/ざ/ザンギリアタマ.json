        "examples": {
          "standard": [
            {
              "text": "散切り頭の少年たちが、校庭で元気に走り回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "散切り頭が似合う、さっぱりとした印象の青年だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「最近、散切り頭流行ってるの？」「いや、昔の髪型だよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "……お起きにならないと横浜のほうがおそくなるわ」　倉地はやはり物たるげに、袖口からにょきんと現われ出た太い腕を延べて、短い散切り頭をごしごしとかき回しながら、「横浜？",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海を渡って来るものは皆文明開化と言われて、散切り頭をたたいて見ただけでも開化した音がすると唄われるほどの世の中に変わって来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり汚れがひどいので、さすがの彼もとうとう断念して、散切り頭になったのである。",
              "citation": {
                "source": "三郎爺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェルカソフ氏は散切り頭の頑健な男で、青いスーツを着ていた。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            }
          ]
        }
