  {
    "uuid": "d25250f0-ff21-50f9-a120-8ab4f106ce11",
    "entry": "石榴口",
    "reading": {
      "primary": "ざくろぐち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
