        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自省直ケレバ千万人ト言エドモ、――イヤ、握手ハマダマダ、ソノ楯ノウラノ言葉ヲコソ、「自省直カラザレバ、乞食ト会ッテモ、赤面狼狽、被告、罪人、酒屋ニ飛ビ込ム。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サレバ、書ハ読ミタル者ヲ聰明ニ成ストハ限ラザルモ、読マザル者ハ必ズ阿呆ニナラン」「夕ニ武道ノ稽古ヲ成ス所以ハ」「サレバ、今ヤ天下麻ノ如ク紊レ、武ヲ知ラザレバ皆目知ラザルニ等シキ世ナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "敬ニシテ礼ニ中ラザルヲ野トイヒ、勇ニシテ礼ニ中ラザルヲ逆トイフ　とか、信ヲ好ンデ学ヲ好マザレバソノ蔽ヤ賊、直ヲ好ンデ学ヲ好マザレバソノ蔽ヤ絞　などというのも、結局は、個人としての子路に対してよりも、いわば塾頭格としての子路に向っての叱言である場合が多かった。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "湛々タル露アリ陽ニ非ザレバ晞ズ厭々トシテ夜飲ス酔ハズンバ帰ルコトナシ　明らかに貧しい生活なのにもかかわらず、まことに融々たる裕かさが家中に溢れている。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "転々、アヤマラザレバ、コノナニヲ作ルベキ。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ再ビスル必要ハ國家組織ヲ根本的ニ改造スル時獨リ宮中ノ建築ヲノミ傾柱壤壁ノマヽニ委スル能ハザレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ハ物質的享樂又ハ物質活動其者ニ就キテ劃一的ナル能ハザレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ニ禮式作用ガ必須課目ナラバ男子ニモ男子ノ其レガ然ルベク、茶ノ湯生花ガ然ルナラバ男子ニ謠曲ヲ課セザレバ不可。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ分配ヨリモ國際間ノ分配ヲ決セザレバ日本ノ社會問題ハ永遠無窮ニ解決サレザルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ニ取リテ支那ハ只分割サレザレバ足ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ひとわたり悪態の連ねが回ると、もとの太十に戻つて、「詩は此方のお手のものだ――世人交リヲ結ブニ黄金ヲ須フ――」　と私達の声よりも遥かに朗々たる喉で、月の光りをふるはせると、閑吉が次いで、「黄金多カラザレバ交リ深カラズ――てえんだあ！",
              "citation": {
                "source": "武者窓日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "千七百七十年代、亜米利加騒乱ノ時ニ、亜人ハ自由ノ為メニ戦フト云ヒ、我ニ自由ヲ与フル歟、否ザレバ死ヲ与ヘヨト唱ヘシモ、英国ノ暴政ニ苦シムノ余、民ヲ塗炭ニ救ヒ、一国ヲ不覊独立ノ自由ニセント死ヲ以テ誓ヒシコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉目ノ寸法、配列等ガ当ヲ得レバ美人トナリ、マタ当ヲ得ザレバ醜人トナル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死刑ノ宣告ヲ受タル婦女懐胎ナルトキハ其執行ヲ停メ分娩後一百日ヲ経ルニアラザレバ刑ヲ行ズ」",
              "citation": {
                "source": "遺伝",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "左ハ言ヘ古器ヲ玩ブハ他ノ学事ト同ジカラザレバ、古刹ノ僧侶ガ霊宝ノ伝来ヲ説クガ如ク、附会ノ説ヲ喋々スルハ甚ダ煩ハシケレバ、考証ハ固ヨリ有用ナレド、務メテ雅致ヲ失ハズ、空シク理窟ニノミ流レザルヲ可トス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ヨリ先キ廿九日両氏ヲ問、時ニ西曰、近日西客来ル、其時件ニ付テハ曽テ木桂ヨリ来書アリ、其儀ニ曰ク、両国論ヲ合テ云々ト、故ニ此国ニ来ラバ先ヅ其事件云々ヲ委曲、使ヲ以達可ク、然ラザレバ其西客ニ一名ヲ付て送ルベシト。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "内ニ信仰ノ火燃ユルガ如ク、外ニ国民性ノ堅実｜不撓ナルニアラザレバ、イカデカコノ悲惨ニ堪ヘ得ンヤ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○急要ノ事件｜指起ルトキ、其土地ノ奉行ニテ法ヲ立ントスルモ、英国王｜之ヲ禁ジテ、王ノ免許ヲ得ルニ非ザレバ之ヲ施行セシメズ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "（６）怡然自樂ノ怡モ樂シムコトナレド、同ジ譯語ヲ用フル事能ハザレバ、少々區別シ、「怡」ノ尤近キハ調和ノ和或ハ調ナレドモ、コレヲ如何ト思ヒ、心やすらげに見ゆト譯シタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ如クナラザレバ、學ブ所ノ學術恐ラクハ生硬事實ニ切ナラズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "否ザレバ鳥啼虫吟沾沾トシテ自ラ喜ビ佳処アリトイヘドモ辺幅固已ヨリ狭シ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ラザレバ徒ニ纏頭ヲ他隊ノ婢ニ投ジテ而モ終宵阿嬌ノ玉顔ヲ拝スルノ機ヲ失スト云。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔妙齢固ヨリ好容儀有リ／更ニ見ル嶄然トシテ頭角奇ナリ／三日逢ハザレバ人刮目ス／百年何ゾ愧ヂン豹ノ皮ヲ留ムルニ／新秋風月扁舟ノ夢／故里煙花艶体ノ詩／聞説ク東帰期近キニ在リト／天辺岳色朝曦ニ映ズ〕　江戸下谷に生れた枕山の風采は春濤の言うが如く丹羽村の人々の目には「好容儀」であったに相違ない。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤヽ意ニ当ラザレバ則チ狂呼｜怒罵シテソノ座人ヲ凌辱ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ラザレバワレ汝ヲ子視セジト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ中ノ消息ハ詩ニ深キニ非ラザレバ知ルコト能ハザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ノコレニ銘スルニ非ラザレバ誰カ与カランヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモ大筋ニ臨ムニ※テ私情ニ拘ハリ公義ヲ失フニ非ラザレバ則畏縮退避シテ活ヲ草間ニ窃ムモノ往往ニシテアリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
