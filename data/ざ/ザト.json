        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なモノスゴサに、それらの出来事のワザトラシサをハッキリと気付きながらも、喜んで魅惑されて行きました。",
              "citation": {
                "source": "江戸川乱歩氏に対する私の感想",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナツテシマフノデスガ、今夜ハサウナラナイ内ニ、ワザト魔法ニカカツタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナッテシマウノデスガ、今夜ハソウナラナイ内ニ、ワザト魔法ニカカッタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニンによれば、プロパガンダは百人を目安として物を考えることであり、アジテーションは数万人を、之に対してオルガニザトールや、レヴォルチヨンスフューラーは数百万大衆を、目安として物を考えねばならぬという。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニンによれば、プロパガンダは数百人を目安として物を考えることであり、アジテーションは数万人を、之に対してオルガニザトールや、レヴォルチヨンスフューラーは数百万大衆を、目安として物を考えねばならぬという。",
              "citation": {
                "source": "啓蒙の現代的意味と役割とについて",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は私の田舎の中学校の同級生で出版屋の番頭をやってる「ザト」という人物のことをきいた。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私と彼の共通の友人がザトらしい。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると彼も出版か文学に関係ある人で、ザトを通じて私と一面識があったに相違ないのである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の常識　ザトペックがヘルシンキのマラソンで優勝したとき日本の新聞記者がインタビューした。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで「あなたは常識を破ったが……」　と質問すると、ザトペックが答えて「君の常識とは、なんだね」　と訊いたそうだ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "［dieser, jener ノ區別ヲ明瞭ナラシメルタメワザト奇拔ナ事實ヲ擇ンダノデス］２．彼は知らない女に話しかけた、彼女は驚いてふり返つた。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は原初の混沌についての古い言い伝えを思い、その混沌の中央に横たわる盲目の白痴神アザトース(*24)のことを考えた。",
              "citation": {
                "source": "闇をさまようもの",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は黒の男と会い、みな共に究極の混沌の中心に設えられたアザトースの玉座へと行かねばならぬ、こう老婆は言うのだ。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "独力で進めた探求がかくなる奥義に達した今、彼は己の血で以てアザトースの書(*8)に署名し、新たなる秘密の名を得ねばならぬ。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう、彼は「アザトース」の名を『ネクロノミコン』の中で見たことがあり、それが表すものは余りの恐ろしさに人間の手では描写することのできない原初の邪悪だと知っていたのである。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつの発する忍び笑いはますますギルマンの頭の中に達するようになり、そいつがどんなやり方で「アザトース」「ニャルラトホテップ」という言葉を発音したか、朝になっても思い出すことができた。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の観念は自分が『ネクロノミコン』の中で心を持たぬ存在であるアザトースについて読んだ内容から拾ってきたものだと。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "その究極の空たる混沌を統べる者こそ、心を持たぬ魔王アザトースなのだ。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハコレモワザトデハナイカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダケドレスリングノヨウニワザトジャナイカラ、アンナニ沢山ハ出ナイワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ、予ト二人キリノ時ニ限ッテワザト昔ノ俤ヲチラツカセルコトハアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンヤ経助ト軽井沢ヘ立ツ時モ、ワザトコヽヘ寄ラナイデ上野駅デ落チ合ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スリッパヲ穿イテ来タ颯子ハ、ワザト予ノ眼ノ前デ草履ヲ穿イテ見セル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテワザト上下ノ歯齦ヲ強ク噛ミ合ワセ、顔ノ寸法ヲ出来ルダケ縮メテ見セタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女ノ人ニコンナ所ヲ触ラセルノハイヤダヨ」予ハワザトソウ云ッテヤッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワザトデハナイ、ヒトリデニソンナ声ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハワザト空ットボケテイルノダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシ一人デ寝カシテ戴クワ、オ爺チャンハ佐々木サントオ休ミナサイヨ」「ナゼサ、一緒ニ寝テクレタッテイヽジャナイカ、東京デモ時々ソウシテクレテルジャナイカ」五子ニ聞カセルタメニ予ハワザト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御免ナサイネ」声ノ調子ニイツモノ彼女ラシクナイ、ワザトラシイトコロガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
