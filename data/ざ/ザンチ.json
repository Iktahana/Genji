        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "賃貸マンションを退去する際、エアコンを次の入居者のために残置することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "工事現場には、明日も使用する予定の大型重機がそのまま残置されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "登山道の避難小屋には、緊急時のための食料が有志によって残置されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "共同水道端の水道の水滴がポトリ／＼落ちて、残置灯の鈍い光に照らされているのが、にわかに夜の更けた感じだ。",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下の残置燈の光で部屋はぼんやり明るい。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "残置燈の火影に横顔が照し出されてゐる。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜は珍しく門まで送ってやって一年と半ぶりで、夜の通りをしみじみ見ましたが、団子坂迄の間に残置燈が一つあるきりよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
