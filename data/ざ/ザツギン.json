          "literary": [
            {
              "text": "「客中雑吟」四首の中ここにその一首を採録する。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢張り面白くないのは面白くないから、これは跡まはしにして、手帳に控へてある散文詩十篇を清書し、「樺太雜吟」と題して博文館へ送つた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び某女史に送る返書の末に雜吟を書す。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "三溪子京華雜吟アリ。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
