    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今は雑使婦か何かの宿舎になっているらしい。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠色の制服を着た雑使婦の婆さんが洗濯している。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十歳の、親なしの雑使婦のターニャの白い上被を着た身のまわりには腹の児に対する愛とともに深い生活の安心が輝やいて居た。",
              "citation": {
                "source": "無題（七）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日は御部屋ですか」　彼女は、亜麻色の髪を古風な束髪にし、雑使婦そっくりな藍縞の服に長い前垂をしめている。",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の年若い雜使婦が寢臺の上に上つて、予を後から抱くやうにしてよりかゝらせた。",
              "citation": {
                "source": "郁雨に與ふ",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "後から予を押へてゐた雜使婦は予の問と共にプツと吹き出してさうしてそれが却々止まなかつた。",
              "citation": {
                "source": "郁雨に與ふ",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の雜使婦は手早くそれを別の容器に移した。",
              "citation": {
                "source": "郁雨に與ふ",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は何囘も水を潜つたやうな縞の雜使婦服を着て、背が低かつた。",
              "citation": {
                "source": "第十八號室より",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
