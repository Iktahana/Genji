        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其の詠ずるところの雑詩の一に曰く、志士は　苦節を守る、達人は　玄言に滞らんや。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "姑く集中の詩に就て検するに、常遊雑詩十九首があつて、中に太田と註した一絶がある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その百七十二　備後では此年文政八年の暮に、菅茶山が「歳杪雑詩」の五律三首を作り、又除夜に始て雪がふつたので「除夜雪」の五律を作つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "予、宋白尚書の玉津雑詩を読むに、云ふあり、坐臥将何物、陶詩与柳文と。",
              "citation": {
                "source": "放翁鑑賞",
                "author": "その七　――放翁詩話三十章――",
                "note": "青空文庫"
              }
            },
            {
              "text": "哈爾賓雑詩二首俄人少女競春妝。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二月十日）　　　　　昨日の風流　趙甌北が呉門雑詩に云ふ。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢と現実　　　（雑詩四十章）明日明日よ、明日よ、そなたはわたしの前にあつてまだ踏まぬ未来の不可思議の路である。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "薔薇の陰影　　　（雑詩廿五章）屋根裏の男暗い梯子を上るとき女の脚は顫へてた。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の陣痛　　　（雑詩四十一章）第一の陣痛わたしは今日病んでゐる、生理的に病んでゐる。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幻想と風景　　　（雑詩八十七章）曙光今、暁の太陽の会釈に、金色の笑ひ天の隅隅に降り注ぐ。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷たい夕飯　　　（雑詩卅四章）我手の花我手の花は人｜染めず、みづからの香と、おのが色。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "消閑雜詩遠き花火つつましき人妻とふたりゐて屋根ごしの花火を見る――見出でしひまに消えゆきしいともとほき花火を語る。",
              "citation": {
                "source": "佐藤春夫詩集",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
