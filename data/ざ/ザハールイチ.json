        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『セミョーン・ザハールイチ（マルメラードフの名と父称）が、お勤めで疲れて、休んでらっしゃるんだよ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "『わしはもちろん、セミョーン・ザハールイチ、君の功労は忘れはせん、と閣下がおっしゃるんでございますのよ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたもご自分で見ておわかりでしょう――セミョーン・ザハールイチはどんなことになりました？",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミョーン・ザハールイチ、もし無理でなかったら」と彼女は大きな声で言った。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、少しなぐられたらしいんです……少なくとも、そう思われるんですよ……あのひとは長官のセミョーン・ザハールイチのところへかけつけたんですが、主人は留守だった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、どうでしょう――とうとう強情を張り通して、長官のセミョーン・ザハールイチを呼び出したもんです。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "『閣下、なくなったセミョーン・ザハールイチを、よくご存じなのでいらっしゃいますから、どうぞみなし児たちをお守りください。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "なくなったセミョーン・ザハールイチの饗応をおぼし召して！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
