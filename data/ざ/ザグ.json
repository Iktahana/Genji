[
  {
    "uuid": "85a2618e-ab1c-5178-92e1-d1a3c8b95b37",
    "entry": "座具",
    "reading": {
      "primary": "ざぐ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一同座具を延べて三拝する。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（列の人々一拝し、おのおの座具の上に座を占める。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（唱え終り、座具を修め、威儀を整えて退場。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（阿難座具を展べ釈尊に三拝し、娘の手を執り悠々と僧等の前を過ぎて退場。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "列座具通の幽愁の諷誦が、既に意識せられて居た抒情発想の烈しさを静め、普遍の誇張から、自己の観照に向はせて居た。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、知客が迎えたとき、禅家の作法もよくわきまえぬものか、たずさえている香具、座具、袈裟などの使い方にも、まごまごしおった」「ていよく、お断りあったほうが、当山のためかと存じますが」　衆口｜紛々である。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
