        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "映画雑誌屋は、それを称して女工と呼んだ。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しく出来た六間道路とその辺の者が呼んでゐる通りには、まだギャレッヂと雑誌屋と玉突場とがあるきりだつた。",
              "citation": {
                "source": "古本屋",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の小説が何かに出ると、方々の雑誌屋の店先で小説月評といったような欄をあさって見るが、いつでも失望するにきまっていた。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "宅へ帰ってどうすると云うあてもないので、銀座通りをぶらぶら歩き、大店のガラス窓の中を覗いてみたり雑誌屋の店先をあさってみたり、しばらくはほとんど何事も忘れていた。",
              "citation": {
                "source": "障子の落書",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "往復ハガキで下らない質問の回答を種々の形の瓢箪先生がたに求める雑誌屋の先祖のようなものに、千成瓢箪殿下が成下るところが聊か憫然だ。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "議論みたようなことは、あれは新聞屋や雑誌屋の手合にまかせておくサ。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは一ヶ月の間雑誌屋の店頭に曝されたぎり、永久人間世界から何処かへ、運命の為めに持つて行かれて仕舞つた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは一カ月の間雑誌屋の店頭に曝されたぎり、永久人間世界から何処かへ、運命の為めに持って行かれてしまった。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "四っ角近くへ来ると左右に本屋と雑誌屋が沢山ある。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと気がついて見ると角に大きな雑誌屋があって、その軒先には新刊の書物が大きな字で広告してある。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "四角近くへ来ると左右に本屋と雑誌屋がたくさんある。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもそのお夕飯後になりますと先生の御用で、二三町先の荒物屋の前まで郵便を出しに参りましたので、そのついでに私は大急ぎで遠まわりをしまして、裏町の小さな文具屋兼業の雑誌屋からその月の「歌舞伎時代」という雑誌を一冊買って参りました。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとの三割が煙草屋、雑誌屋、玉突き、理髪、銭湯、占師、貸本屋といったようなもの。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "本町の雑誌屋は近頃出来た店。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "丑松は色の褪せたズボンの袖嚢の内へ手を突込んで、人知れず銀貨を鳴らして見ながら、幾度か其雑誌屋の前を往つたり来たりした。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "丑松は又、『懴悔録』の広告を見つけた時の喜悦から、飯山の雑誌屋で一冊を買取つて、其を抱いて内容を想像し乍ら下宿へ帰つた時の心地、読み耽つて心に深い感動を受けたこと、社会といふものゝ威力を知つたこと、さては其著述に顕はれた思想の新しく思はれたことなぞを話した。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はよく槇町の北中通の古雑誌屋へと出かけて行った。",
              "citation": {
                "source": "日本橋附近",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで私は、大丸と、雑誌屋と、荒木と、丹平と、それだけ以外で決して買物をした事はないが、又実際、心斎橋で白狐の襟巻も、気の利いたウォッチリングも、マイ・ミキスチュアも、無いのだから仕方がない。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく此記者先生は丸善を雑誌屋とでも思ったのであろう。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃は専門の雑誌屋がなくて絵双紙屋で雑誌を売っていた。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る時は雑誌屋に傭われて飜訳の手伝いをしました。",
              "citation": {
                "source": "悪魔の弟子",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互いに愛想のつきるような電車に乗ってつとめへ往復して、粉ばかり食べて下腹がみにくくつき出る日本の今の若い人達が、こういう雑誌の絵にみとれているのを見ると、新円稼ぎの雑誌屋共を憎らしく思います。",
              "citation": {
                "source": "若人の要求",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日文子は雑誌を買おうと思ってがま口を懐にして外へでた、雑誌屋の店頭に男女の学生が群れていた。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "弁士は多く雑誌屋や新聞屋――それも月に一回出すか出さぬか、広告専門で、三ヶ月一回、新聞紙法に違反しないやうに出して居る。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "混雑した川蒸気の中、乗り合の衆は、二十銭で八冊売る月遅れの雑誌屋の口上に聞取れて、無頼漢風の男が蒸気の屋根に飛乗った事などには気が付きません。",
              "citation": {
                "source": "悪人の娘",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に最近の旅行案内を買いに雑誌屋まで飛んで行って来た。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
