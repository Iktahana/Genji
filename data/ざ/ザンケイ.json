    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "踏歌・呪師・田楽・鎮花祭舞踊の文献や、残形を見ると、念仏踊りの要素となつたものが、うんとある。",
              "citation": {
                "source": "古代研究　追ひ書き",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが今はただ児童のあてもの遊戯の中に、幽かな残形を留めているのである。",
              "citation": {
                "source": "こども風土記",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしも現在二三の土地において、垣内の特徴のごとく見られている事実が、ともに中世の垣内の残形に過ぎぬとすると、これらを綜合していた本の姿というものは、よほど茫漠として把捉しがたいものになってしまうのである。",
              "citation": {
                "source": "垣内の話",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一三　こういう信仰の遺蹟は、あるいは存外に今の人々には興味が薄いかも知れぬが、もう一つの方面には制度の残形がある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
