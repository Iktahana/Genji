        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と思われた刹那、門番から近侍の者へ、近侍の者から十郎次へ、菊路のことが囁かれでもしたらしく、急に座内が色めき立ったかと思われるや一緒に、十郎次の言う声が戸の外にまで洩れ伝わりました。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うのは、座内を隅々まで探したのだったが、一滴の血さえ発見されないばかりでなく、誰しもが、格闘の物音も聴かずと云い、ただ逢痴の部屋から平素使う沃度の注射器を、拾い上げて来たのみであった。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ＱＸ30ハ間諜座内ニ其儘止リテ、打出シト共ニ群衆ニ紛レテ脱出セヨ。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵〔牧野いう、Ovule の事〕ハ胎座内ニ在テ後ニ種子ト成ル、卵ハ大率子房ノ中ニ居ス……卵ニ胞〔牧野いう、膜皮の事〕アリ或ハ一層或ハ二層、卵内ニ胚珠一点アリ、即チ異日果中ノ胚ナリ　今了解し易い様に図を以て示せば右の如くである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "桟敷の毛氈のいろ褪せた朱や昼芝居の舞台を走る鼠を追つて黒衣が竹の棒で追歩く宮戸座内部の光景を、永遠になつかしく後世にと伝へるものは永井先生が「すみだ川」であらう。",
              "citation": {
                "source": "異版　浅草燈籠",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "座内の暑さは殺人的だ、じっとしてるのが一ばん辛い。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "川口が久保田氏を引込めるのに、あからさまに自分の心情を言はずに、「古川がとても注文がきけないと言ってるし、中々座内にうるさいことがあって云々」と言ったと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三益が生意気になり、面白くない、川口迄三益の他の舞台に口を出したりして、座内空気一掃の必要をしみ／″＼感じた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座内益々明朗である。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
