  {
    "uuid": "3550a8ab-a85d-5ebb-8290-6038afb6f01d",
    "entry": "ざくざく",
    "reading": {
      "primary": "ざくざく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "目笊に一杯、葱のざくざくを添えて、醤油も砂糖も、むきだしに担ぎあげた。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "黙っていろよ、何んにも言うな、きっと誰にも饒舌るでねえぞ、と言い続けて、内へ帰って、納戸を閉切って暗くして、お仏壇の前へ筵を敷いて、其処へざくざくと装上げた。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらくは、あの少女のこれが父親であろう主人に、ざくざく髪を刈らせて、私は涼しく、大へん愉快であったという、それだけの悪徳物語である。",
              "citation": {
                "source": "美少女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから金だらいを出して顔をぶるぶる洗うと、戸棚から冷たいごはんと味噌をだして、まるで夢中でざくざく食べました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしがかの女に何か御馳走の望みはないかと訊くと、「では、あの、ざくざく掻いた氷水を。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近づいて来ると兵士達は、靴音をざくざくさせながら、二人にからかい始めた。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その野菜というのが蓮根だの、慈姑だの普通煮て食べる種類のものを、ただ皮を剥いただけで、ざくざく輪切りにしたものでありました。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして小石の上をざくざく踏み散らして行つたと思ふと、曲り角ではたととまつた。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（ええ、何ですか、瀬戸物の欠がざくざくして、）　私は肚胸を突いたんだ。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その癖、この通り、それはそれは勿体ないほど、ざくざくお宝をお運びで、嬢さんがまたばらばら撒く。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃ何だ、医学士はざくざく注ぎ込む、お夏さんはばらばら遣う、しかも何一つ自分から欲いといったことはないのか。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつき山羊の小屋へ行つた時、駿介の足の下では、霜柱がざくざく鳴つた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに女は裏の木戸を開けて、ざくざくした石炭殻の路次口から駒下駄の音をさせて外へ出て行った。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "平気で日に二円ばかりの働きをするお島の帯のあいだの財布のなかには、いつも自分の指頭から産出した金がざくざくしていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな所いやねえ、住んでみると」　そういって葉子はパラソルを開いたまま柄の先で白い砂をざくざくと刺し通した。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、その前に、ざくざくと積まれた千両近い黄金の山！",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間を前駆の足軽｜徒侍六十名が、いずれも一文字がさにももだち高くとって、ざくざくとよぎり通る。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "知恵の実のざくざくはいった袋がな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかひとあたり当たって、この米びつにざくざくお米がたまるようにと、こんなところに祭っておいたにちげえねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場までは路三里その半ばにて雪霽れぬ眩ゆき聖き荘かの雪の世界をざくざくと歩む馬こそわが身こそ現世ならぬ尊さよ。",
              "citation": {
                "source": "文学に現れたる東北地方の地方色",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「金山つて、掘るといくらでも小判がざくざく出て来るの？",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さうさ、ざくざく出て来るのさ。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "異人はみんなお金を持っているそうで、どこで両替えして来るのか知りませんが、二歩金や一歩銀をざくざく掴み出してくれるという話で、馬鹿に景気がいいんです」と、女中は嫉むような嘲るような口吻で話した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "妖狐伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありがたい事に味噌汁がついていたんで、こいつを南京米の上から、ざっと掛けて、ざくざくと掻き込んだんで、今度は壁土の味を噛み分ないで済んだ。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "人波の肩の間で、首環売りがざくざくと玉を叩いた。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど仙太は応答もなさで、首をたれたるまま、時々思い出したらんように苫屋の方を振返りつつ、的もなく真砂の間をざくざくと踏行きぬ。",
              "citation": {
                "source": "片男波",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼鈴を鳴らすとざくざくと砂の上を歩く足音と、犬の高吠えが聞えた。",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            }
          ]
        }
