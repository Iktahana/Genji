    "definitions": [
      {
        "index": 1,
        "gloss": "walking on frost",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "霜柱をザクザクと踏みしめながら、冬の朝の冷たい空気の中を歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "深い雪道をザクザクと進んでいく足音だけが、静かな山に響いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "砂利道を自転車で通ると、タイヤの下で石がザクザクと音を立てる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "焼砂が足の指先に、ザクザク障るので、闇の中でも裾野を歩くという意識があるだけだ。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "君が撫順に来たとき、大きな電気ショベルが、ザクザクと石炭をトロッコにすいこんでいただろう。",
              "citation": {
                "source": "防備隊",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ白湯を打かけてザクザク流し込むのだが、それが如何にも美味そうであった。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "管はず踏込むで、踏躙ると、ザクザク寂な音がする……彼は、ふと其の音に耳を澄まして傾聽した。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供達はそこで（銭と金とザクザクと持って参った。",
              "citation": {
                "source": "手品",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「銭と金とザクザク持って参った。",
              "citation": {
                "source": "手品",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "銭と金とザクザクと持って参ったか。",
              "citation": {
                "source": "手品",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、編粗朶にしても、一二度やる中には、穴に直接当るところは、樫の枝がザクザクに折れて取れて終うのだった。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "滑っこく、水で洗われた岩肌や、岩肌に生えた苔や、凹みに生えた菖蒲に似た草だのは、一本のハッパで、跡も片もなくなって、その後には、有史以来初めて光線を見るのであるかもしれない、地殻の内皮の一部分が、ザクザクになって、ひっくりかえる。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのショベルの音、石炭のザクザク鳴る音、彼らが何か呼ぶ声が、デッキの上をあるいていると、初めての者にはどこから聞こえて来るかわからないのと、その音がまるでもしあるなら冥土からでも出ただろうといったふうな妙に陰気な響きであるので、必ず驚かされるほどであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてグウグウ、ザクザクと、その胴体が二個の半球に切り割かれた時、「ほう！",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に二人の目の向うの、月光散りしく城内｜遥かの広場の中を騎馬の一隊に先陣させた藩兵達の大部隊が軍鼓を鳴らし、法螺の音を空高く吹き鳴らし乍ら、二｜旒の白旗を高々と押し立ててザクザクと長蛇のごとく勇ましげに進んでいった。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵隊は歩きづらい砂地を、泥人形のような無恰好さで、ザクザク歩き出した。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏門にいたる砂利道の上を、ザクザクと寒そうな音をたてて歩きながら、私はおもわず胴震いをした。",
              "citation": {
                "source": "ある宇宙塵の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親は今朝猫の額のような畠の角で、霜解けの土をザクザク踏みながら、白い手を泥だらけにして、しきりに何かしていたが、やがてようやく芽を出し始めた福寿草を鉢に植えて床の間に飾った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月の中旬過の、珍らしく寒さの緩んだ日で、街々の雪がザクザク融けかかつて來たから、指先に穴のあいた足袋が氣持惡く濡れて居た。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザクザクと融けた雪が上面だけ凍りかかつて、夥しく歩き惡い街路を、野村は寒さも知らぬ如く、自暴に昂奮した調子で歩き出した。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月の中旬過の、珍らしく寒さの緩んだ日で、街々の雪がザクザク融けかかつて来たから、指先に穴のあいた足袋が気持悪く濡れて居た。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、鈍い歩調で二三十歩、俛首れて歩いて居たが、四角を右に曲つて、振顧つてもモウ社が見えない所に来ると、渠は遽かに顔を上げて、融けかかつたザクザクの雪を蹴散し乍ら、勢ひよく足を急がせて、二町の先に二階の見ゆる共立病院へ………………。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザクザクと融けた雪が上面だけ凍りかかつて、夥しく歩き悪い街路を、野村は寒さも知らぬ如く、自暴に昂奮つた調子で歩き出した。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "町々のどよめきが波が寄せる様に響くのでまるで海に来て居る様な気持になって波に洗われる小石のすれ合う音や藻の香りを思い出し、足の下からザクザク砂を踏む音さえ聞えて来そうであった。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と新吉はやっぱりザクザクやっている。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が毎日毎日通った時分、誠之は斯様に黒い木の門と、足の下でザクザクいう玄関前を持ち、大きなコの字形に運動場を囲んだ木の低い建物で出来ていたのです。",
              "citation": {
                "source": "思い出すかずかず",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おどろき悲しみ、手で押えるがザクザク口一杯になってどうしようもなく、その堅い歯がザクザク口一杯にひろがった時厭な、絶望的な感じが醒めて後まではっきり残った。",
              "citation": {
                "source": "白い蚊帳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "気が付くと其処でも此処でもザクザクと草刈る音がする。",
              "citation": {
                "source": "木曾御嶽の両面",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "氣が付くと其處でも此處でもザクザクと草刈る音がする。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおかめさんが寝間着に寛袍をはおって、大座ぶとんに坐り、それをとり巻いて振り将棋みたいなことをして、みんなが賭けた小銭を、ザクザクと、おおかめさんは座ぶとんや、膝の間に押入れて、忽ちのうちに勝ってしまう遊びをした。",
              "citation": {
                "source": "鉄くそぶとり",
                "author": "続旧聞日本橋・その二",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
