      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "brutal",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "犯人の残忍な手口に、世間は強い衝撃と怒りに包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は冷酷な独裁者として、反対派を残忍な方法で処刑した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "映画の中の残忍なシーンがあまりにリアルで、途中で席を立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかもその妻のごとき、純日本的な可憐な女を、彼のいわゆる『野蛮人』である西洋人の社会に、孤独で生活させることの痛ましさは、想像だけでも耐えがたい残忍事だった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵神経過敏な緊張か、さもなくば過度の疲労から来る不感が人々の眼と眉の間や口の周囲に残忍に刻まれている。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これほど美しいものを視る事の出来ない人に、香だけ嗅がせるのはあまりに残忍な所行である。",
              "citation": {
                "source": "断片（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを待構えた残忍な悪太郎は、蚊帳の切れで作った小さな玉網でたちまちこれを俘虜にする。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、掠奪の被害をなめた群集は、むしろ残忍な殺し方を歓喜した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵に対する残忍なやり方では、多くの話種を持っていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓場を発いて屍体を嗜む変質者のような残忍なよろこびを俺は味わった。",
              "citation": {
                "source": "桜の樹の下には",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああはたして仁なりや、しかも一人の渠が残忍｜苛酷にして、恕すべき老車夫を懲罰し、憐むべき母と子を厳責したりし尽瘁を、讃歎するもの無きはいかん。",
              "citation": {
                "source": "夜行巡査",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどそのころに枕もとのガラス窓――むやみに丈の高い、そして残忍に冷たい白の窓掛けをたれた窓の外で、キュル、キュル／＼／＼と、糸車を繰るような濁ったしかし鋭い声が聞こえだす。",
              "citation": {
                "source": "病院の夜明けの物音",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "白熊は、自分の毛皮から放射する光線が遠方のカメラのレンズの中に集約されて感光フィルムの上に隠像の記録を作っていることなどは夢にも知らないで、罪のない好奇と驚異の眼をこの浮き島の上の残忍な屠殺者の群れに向けているのである。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "猛獣の争闘のように血を流し肉を破らないから一見残酷でないようでありむしろ滑稽のようにも見えるが、実は最も残忍な決闘である。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、人の三倍も四倍も復讐心の強い男なのであるから、また、そうなると人の五倍も六倍も残忍性を発揮してしまう男なのであるから、たちどころにその犬の頭蓋骨を、めちゃめちゃに粉砕し、眼玉をくり抜き、ぐしゃぐしゃに噛んで、べっと吐き捨て、それでも足りずに近所近辺の飼い犬ことごとく毒殺してしまうであろう。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のそれからの境涯に於いても、いつでもこの女の不意に発揮する強力なる残忍性のために私は、ずたずたに切られどおしでございました。",
              "citation": {
                "source": "男女同権",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その形小さく力無い鳥の家に参るといふのぢゃが、参るといふてもたゞ訪ねて参るでもなければ、遊びに参るでもないぢゃ、内に深く残忍の想を潜め、外又恐るべく悲しむべき夜叉相を浮べ、密やかに忍んで参ると斯う云ふことぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その形小さく力無い鳥の家に参るというのじゃが、参るというてもただ訪ねて参るでもなければ、遊びに参るでもないじゃ、内に深く残忍の想を潜め、外又恐るべく悲しむべき夜叉相を浮べ、密やかに忍んで参ると斯う云うことじゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那風の美人、美少女、美少年が、あらゆる残忍酷烈な刑に処せられて笞打たれ、絞め殺され、焙られ、焼かれ、煮られ、引き裂かれ、又は猛獣の餌食にあたえられて行く凄愴、陰惨を極めた場面の極彩色密画であった。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもかなり残忍な方法で……たとえば私はいろんな事の褒美や何かでおやじから金時計を四ツとプラチナの時計を二個貰っていたが、実物はまだ一度も手にしなかった。",
              "citation": {
                "source": "ざんげの塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして東京みやげの「江戸絵」を染めたアニリン色素のなまなましい彩色がまだ柔らかい網膜を残忍にただらせていたころの事である。",
              "citation": {
                "source": "青衣童女像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてが埃に塗れて汚らしく、肉慾で人を繋ぐグロテスクで残忍な獄屋の正体をありありと見せ付けられる感じがした。",
              "citation": {
                "source": "とと屋禅譚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう時の老人は懸命で残忍だ。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お涌は、何か、肉体のうちを掠めるむずむずしたような電気を感じ、残忍な征服慾を覚え、早くこの不安なものの動作を揉み潰してしまい度いような衝動にさえ駆られて、浴衣の両｜袂を握ったまま、しっかり腕を組み合せ、唇を噛んで見入っていた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五種｜浄肉となづけてあまり残忍なる行為によらずして得たる動物の肉はこれを食することを許したのである。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その五種浄肉とても前論士の云われた如き余り残忍なる行為によらずしてというごとき簡単なるものではない。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "出でては仁慈優愛なるもの、入っては残忍｜酷薄にて、隣家の娘に深切なるもの、己が細君には軽薄なり。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑猥残忍の批難攻撃甚しく、遂に警視庁の注意を受けて半途休業。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　真実は慈悲深くあり同時に残忍である。",
              "citation": {
                "source": "砕けた瓦",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の残忍な爪はその唯一をむしりとったのである。",
              "citation": {
                "source": "白い花",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそうした青年をこれ程までにいじめつけて鼓を吾が物にしようとする鶴原夫人の残忍さ……それを通じてわかる「あやかしの鼓」の魅力……この世の事でないと思うと私は頸すじが粟立つのを感じた。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前用事が済んだのかえ」と云いつつ未亡人はジロリと妻木君を見据えたが、その一瞬間に未亡人の眼が、冷たいというよりも寧ろ残忍な光りを帯びたのを私はありありと見た。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にしても余程の残忍な、同時に大胆極まる遣口で、その時の光景を想像するさえ恐ろしい位であった。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
