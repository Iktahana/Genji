[
  {
    "uuid": "d718f52a-d493-5a24-b509-28bf28c63e2a",
    "entry": "残忍",
    "reading": {
      "primary": "ざんにん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
