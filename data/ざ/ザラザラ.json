        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "袋に入った豆が揺れると、中でザラザラと音がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "砂時計の砂が落ちる音が、耳元でザラザラと響く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "小石が山積みになっている場所を歩くと、足元でザラザラと音が鳴る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
