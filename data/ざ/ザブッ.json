          "literary": [
            {
              "text": "ちょうど、俺がいるところから四、五十メートルほど先に、ザブッと水をかぶったまま立ちあがったものがある。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｑの足が、暗い水の中へ、ザブッとはいりました。",
              "citation": {
                "source": "鉄人Ｑ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッと思う間に、真逆様につり下げられた一寸法師の頭が、ザブッと酒樽の中に漬った。",
              "citation": {
                "source": "踊る一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
