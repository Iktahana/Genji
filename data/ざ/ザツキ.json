    "definitions": [
      {
        "index": 1,
        "gloss": "working in the theater (theatre)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "明治時代の歌舞伎界では、座付きの作者が看板役者のために脚本を書き下ろしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は人形浄瑠璃の座付きの太夫として、長年舞台を支え続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "座付きの音楽家たちが、幕間に演奏するお囃子の練習に余念がない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "わきにはテニスのできる芝地と黒い物置小屋、台座付きの日時計があり、今回の不思議な事件を思い起こさせた。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "出しものは「酒井の太鼓」だったが、あとで座付き役者から物議が起ったことがあったりした、九女八にはいやな、ききたくないことなのだ。",
              "citation": {
                "source": "市川九女八",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にはお稽古の合間などに、よく、お芝居の話、それも、座付きになっていらっしゃる、岩井半四郎一座の話をよく、お聞かせ下さったのでございました。",
              "citation": {
                "source": "京鹿子娘道成寺",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "木内桜谷は芝居の座付き作者になろうとしたが、いまは瓦版の拵え記事などを書いて、かつかつに食っている。",
              "citation": {
                "source": "へちまの木",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる特長あるにもかかわらず、座付きの作者らの嫉妬と利己心とは、小生を排斥せんとするやも知れずと懸念いたし候。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うむ、だが、おれたちがお座敷を勤めた若い頃は、どんな乱れた席でも芸妓が三味線を執れば、まあ、形だけでもと言って、お座付をつけ、続いてちょっとでもこの三下りに入ったものだな――それからめい／＼客の注文の座興の唄に応じたものだ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えてみるとネオン燈がはやり始めて以来、まだ一度も著しい降雹がなかったようであるが、今に四五月ごろの雷雨性の不連続線に伴のうて鳩卵大の降雹がほんのひとしきり襲って来れば、銀座付近が一時はだいぶ暗くなる事であろう。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手を着けてはならないと井上氏が宣告して置いたにも拘らず、俳優や座付作者たちから種々の訂正を命ぜられた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この通し狂言の脚色者は何人であるかを知らなかったが、後に聞けばそれは座付の佐橋五湖という上方作者の筆に成ったのであった。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも座付作者の新作で、作者は竹柴万治であったように記憶している。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその後に座付の芝居茶屋、猿家のうしろ楯を得て、興行ごとに大役を背負うようになったのである。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶の間は応接室がわりに成っていて、仕切場だとか大札だとか芝居茶屋の女将だとかそういう座付の連中ばかりでなくその他の客が入れ替り立ち替り訪ねて来る度に、よく捨吉が茶を運ぶところだ。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪朝日の旧社員の土屋大作や、今は故人となった帝劇の座付作者の右田寅彦兄弟も同塾であったそうだ。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八八頁図（第二十五図）は天の一部分、すなわち、三角、アンドロメダ、牡羊、及び魚の各星座付近における恒星の運動を示すものである。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝夜叉譚一　猿若町三座の中でも、結城孫三郎あやつりの常小屋の真向うの中村座は、江戸随一、撰りすぐりの名優を座付にして、不断の大入りを誇っていたのが、物の盛衰は理外の理、この春ごろから狂言の立て方が時好と妙にちぐはぐになって、ともすれば、軒並のほかの小屋から圧され勝ちに見えて来た。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことさら、気負った盆興行が、大の不入り、そこで座元の策戦の秘術をつくして、この大切な顔見世月には、当時大坂でめきめきと売り出している、門閥外の中村菊之丞一座を招き、これに、座付の若手を加えただけで、思い切った興行ぶりを見せようと試みたわけであった。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は熱療法の病院を退職すると、その次には浅草の安来節の座付作者になつて、まつたくどうも、かういふところにも脚本家などの必要があつたのかネ、私は知らなかつた。",
              "citation": {
                "source": "足のない男と首のない男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "座付作者になるにもインチキ・レビュウとくるとまだ少しまともすぎて、安来節とこないと、どうしてもをさまることが出来ない。",
              "citation": {
                "source": "足のない男と首のない男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "開幕をまつまでの見物人のことまで考えるに至るから、事ここまで思うに至っては、座付作者でもない私に筆の進むはずがなくなってしまう。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸者現れてお座付を弾けば、客酔うて必かくし芸をなす。",
              "citation": {
                "source": "桑中喜語",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "極星座付俳優ヘニング・ローマンとの浮名が立っているが、伯爵は一切関知せざる模様、夫妻の間に風波はない様子である」　毒蛇のラルフに、こんな緻密な聞き込みなぞのできるわけがない。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "場所は旧大八幡楼（後に料理店神泉亭）の横を東へ曲って、一丁ばかり町並のそろわぬ原中の一軒建て、向う側にこれもただ一軒の座付茶屋、左右は草ぼうぼう、座の裏手は一面の麦畑に菜の花がところどころ。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上ほんとうの座付となって馴染の見連も殖え、しばらくは女天下すこぶる泰平であった。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "木挽町三丁目の空地（今の歌舞伎座付近）で天幕張りの興行、物珍しさに前景気は素敵。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
