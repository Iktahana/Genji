  {
    "uuid": "3ba23447-f7f5-5e05-8e27-6759d4d0b7a0",
    "entry": "ざりがに",
    "reading": {
      "primary": "ざりがに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "赤くちろちろと舌をだしてうみざりがにのやうに平つくばつてる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ざりがにもいるらしい。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしどことなく普通のざりがにと違う。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "動きも普通のざりがによりずっとすばやい。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓のほうに視線をやるとざりがにが次々と部屋のなかにこぼれ落ちてくるのが目に入った。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "このざりがにの皮膚はぬらぬらと湿っていて気持ち悪い。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは途切れることなく部屋のなかに入ってくるざりがにを片っ端からつかんで外に放り投げた。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは片時も手を休めずにざりがにを投げ出しつづけた。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも部屋のなかのざりがには増える一方だ。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくがつかんで放り出すざりがにの数よりも新たに入ってくるざりがにの数のほうがずっと多いのだ。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓からはほとんど流しこまれるような勢いでざりがにがこぼれ落ちてくる。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓を閉めればこれ以上は入ってこないが、そうすると窓が一つしかないこの部屋にすでに入りこんでいるざりがにを外に出す手立てもなくなる。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "床一面に足の踏み場もないほどのざりがにがうごめいている。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "足の裏に感じるざりがにの体液はねっとりとしていて滑りやすい。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなったら全身ざりがにの体液にまみれることになる。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは下半身の体勢に神経を使いながらひたすらざりがにを拾っては放り出す作業をつづける。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
