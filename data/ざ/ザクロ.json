  {
    "uuid": "7ef9f26e-b27f-559f-9afc-4014596d75b5",
    "entry": "石榴",
    "reading": {
      "primary": "ざくろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
