[
  {
    "uuid": "bf7fb39d-e497-5d93-a2d3-8fee4773bbed",
    "entry": "ざらん",
    "reading": {
      "primary": "ざらん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
