        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "こたつで本を読んでいると腰が痛くなるので、通販で座椅子を注文した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "和室に新しく購入した高級な座椅子を置くと、部屋の雰囲気が一段と良くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "おじいちゃんは、テレビを見る時にいつも使い込んだお気に入りの座椅子に座る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "お父様は障子のそばへ床をうつし、今は座椅子によって上半身起き上っていらっしゃいます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのうは午後一寸（二時間ほど）横になってあと茶の間にいた、座椅子にもたれて。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（いんね川のでございす。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは貧しいみなし児でございすが、贅沢などをしたいとは存じません。",
              "citation": {
                "source": "三つの指環",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレアチニンは正常尿にアンモニアよりも多量にそんざいする。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            },
            {
              "text": "はい、それだけでございす」「昨夜王様が来られた時、だれか連れのあるような模様はなかったか」「おや、王様ってだれのことでしょう。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃもうたしかなんでございす」「間違いはないね」「ええもう」　真名古は依然として瞼を垂れたまま、「なかなか口が固いな。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「奧さまはお見かけしたところ、お丈夫さうで、上べは申分のないやうに見えますが、お心の中は、さうお樂でもございすまい。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
