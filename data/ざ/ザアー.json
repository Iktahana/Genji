        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「フーネニホ、ホバシラニハータ、コヒガヰマス、ヒゴヒモヰマス……」　雨がザアーツと降り出して来た。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨はじきに過ぎたが、まだ近処を襲っている音だけは、ザアーッと盛んに聞えている。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれでせうあゝ　このボタンを押すんですか○（ザザアー　ザアー　ザアー）○あつ？",
              "citation": {
                "source": "小熊秀雄全集−22",
                "author": "火星探検―漫画台本",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが見る見る近付いてくると、窓のところへドッと打ち当り、砕けて、ザアー……と泡立つ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間、出口がザアーと滝になった。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　悪寒が彼の背筋をザアーッ、と走った。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、七、八間後の草ムラが、急にザアーと鳴つた、かと思ふと、雨が降つてきた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞暗闇の廣漠々とした平原に雨がザアーと音をさして降つてゐるその最中を提灯もつけずに歩くのは、勝には、然し、矢張り氣持よくなかつた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ロシア革命万歳※」「日本共産党バンザアーイ※」　ワァーッ！",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "提灯の火だけでそれを見ていると、寒気がザアーッと身体を走った。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "素早く追った造酒の長剣は、それこそ銀百足のように、庭へ倒れようとする雨戸を一枚ザアーッ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザアーと大粒の力強い雨だ。",
              "citation": {
                "source": "登山は冒険なり",
                "author": "河東碧梧桐",
                "note": "青空文庫"
              }
            },
            {
              "text": "海は大そうしづかで、時たま、磯波がザザアーと、うちよせる音がきこえます。",
              "citation": {
                "source": "さがしもの",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "（呼びながら、歩き出している）ザアーャと風の音。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くの空を、異様な、ザアーッと言うような爆音がこちらに向って近づいてくる）金太　あれ、何だろうな、お父ちゃん？",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思う間もあらせず、ザザザザザザザアーッと盆をくつがえすという、文字どおりな大雨の襲来。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と愕いて見れば、風のごとく寄ってきた白い人影、森啓之助の脾腹を当て、九鬼弥助の腰をすくってザアーッと生洲の水へ投げつけた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　飛び寄った一人、弦之丞の片手を取り、ズルズルと前へ引きずりだそうとすると、足をすくわれたか、その影が、猫回りに、舟縁を越えて、時ならぬ水音、ザアーッと、一面の飛沫に、川面を夕立のようにさせた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザアーッと、一散な雨が横に吹ッかけてきた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドドドブン……ザアーッ……と珠を洗うような波の音。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
