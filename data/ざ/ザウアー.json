        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一九〇二年十九歳夏学期にはアウグスト・ザウアーという教授の下でドイツ文学を学んだ。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノ協奏曲とピアノ管弦楽合奏曲　二つのピアノ協奏曲のうち「第一番＝変ホ長調」は多少老齢の頽廃はあるにしても、ザウアー（ピアノ）とワインガルトナー指揮、パリ音楽院管弦楽団を推すべきであろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザウアーはもはや八十歳の老人であるが、依然楽壇の尊崇を集めている様子で、瑰麗な表現には青年らしい覇気と光沢とがある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダルベーアはザウアーと並んで二十世紀初頭以来、ドイツの国宝的なピアニストではあったが、その演奏はグラモフォンの古い録音に従えば、重厚素朴で、却ってケンプを思わせるものがある。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人はエミール・ザウアー、一人はモリッツ・ローゼンタール、も一人はフレデリック・ラモンド、そして最後の一人はデ・グリーフだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザウアー　Emil von Sauer　一八六二年の生れで、ウィンの象牙の塔にリストの衣鉢を伝えている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりはむしろ私は、十五、六年前のフォックス・レコードに入っていた六枚のザウアー・レコードに興味を持っている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐るべき粗悪な録音であったが、ベートーヴェンの『悲愴ソナタ』や『碧きダニューヴ』の演奏に、まだ残るザウアーの若さの匂うものがあったような気がする。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローゼンタール　Moritz Rosenthal　一八六二年オーストリアの生れでザウアーと同年だ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラモンド　Frederic Lamond　一八六八年生れ、イギリス人でローゼンタールやザウアーより四つ若い。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八六二年生れというから、ザウアー、ローゼンタールと同年なわけである。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
