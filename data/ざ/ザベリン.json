        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "艦橋には、若いぴちぴちした艦長ザベリン中尉が、すらりと高い長身を、雨がっぱにつつんで立っていた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おう、船内にはもうだれもいないのだね」　と、ザベリン中尉はたずねた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "むこうの艇内をちょっとみてこい」　と、ザベリン中尉は、水兵にいいつけた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわてたのはザベリン中尉だった。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄水母の撃沈命令がおりているのに、このまま鉄水母が沈んでしまっては、ザベリン中尉の職責がはたせない。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザベリン中尉は、ジム水兵よりも、もっともっとあわてた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザベリン中尉の砲撃命令に、砲手はやむをえず、主砲の照準をいそぎ鉄水母の方につけた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、照準手、かわれ」「ザベリン中尉。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃあ照準は、おれがつける」　ザベリン中尉は、砲のそばへかけつけた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、急いで全速後進だ」　ザベリン中尉が、顔をまっかにしてどなっている間に、潜水艦はようやくすこし動いた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よし、そのへんでストップ」　ザベリン中尉は手をあげた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっ、とうとう沈んでしまったか」　ザベリン中尉のくやしがること。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
