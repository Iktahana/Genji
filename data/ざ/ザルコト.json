        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ケサノコノ走リ書モマタ、純粋ノ主観的表白ニアラザルコトハ、皆様承知。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家生産ノ勞働者ニ利益配當ヲ用ヒザル所以ハ、國家ハ全生産ノ永遠的經營ヲ本旨トスルガ故ニ、全國家ノ生産的活動ノ爲ニ或省ニハ殊更ニ投賣ヲ行ハシメテ損失ヲ顧ミザルコトアル如ク、或ル省ヲ犧牲トシテ或省ノ對外競爭ヲ專ラナラシムルコトモアルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "中食ノ學校支辨ノ理由ハ第一ニ登校兒童ノタメニ毎朝母ヲ勞苦セシメザルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本建國ノ精神ハ内外人ニヨリテ正義ヲ二ニセザルコトヲ誇リトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ義務ニセヨ、父母妻子ノ負擔アル男子ヨリ其ノ勞働ヲ奪ヒテ何等ノ賠償ヲナサザルコトハ國家ノ權利ヲ濫用スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ積極的發展ノ爲メニ戰フコトノ單ナル我利私欲ニ非ザルコトハ、他ノ民族ガ積極的覺醒ノ爲メニ占有者又ハ侵略者ヲ排除セントスル現状打破ノ自己的行動ガ正義視セラルル如ク正義ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自利ガ罪惡ニ非ザルコトハ自滅ガ道徳ニ非ザルト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "開版ノ自由ト云ヘバ、何等ノ書ニテモ、刊行勝手次第ニテ、書中ノ事柄ヲ咎メザルコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "材料ノ不足ニヨリテ意ノ如キ波長ノモノヲ作ルコトヲ得ザルコトヲ発見シタルトキハ絶望ノ泪ニ暮レタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「利門名路両ナガラ何ゾ憑ラン、百歳ハ風前短焔ノ燈、只恐ラクハ僧ト為テ心了セザルコトヲ、僧ト為テ心了セバ総テ僧ニ輸セン――どうじゃな、これが杜荀鶴の詩じゃ。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "只恐ラクハ僧ト為テ心了セザルコトヲ、私は若い時この詩を読んで一生の目的を定めたのじゃ。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（第二号）我邦ノ好古先生ハ其ノ心ニ謂ヘラク、古物ヲ愛玩スルハ本邦及ビ支那ノ如キ、雅致ヲ尚ブ国ノ風習ニテ、泰西諸国ノ如キ功利ニ汲々タル世界ニハ、夢視セザルコトナラント。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがこんどの新刑事訴訟法第二七九条ではついにこれを法文の上に現わして「犯人ノ性格、年齡及境遇並犯罪ノ情状及犯罪後ノ情況ニ因リ訴追ヲ必要トセザルトキハ公訴ヲ提起セザルコトヲ得」と規定するに至った。",
              "citation": {
                "source": "嘘の効用",
                "author": "末弘厳太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "那珂氏が博士の説に對して此ノ山門郡ハ、筑前ナル國々ト相近クシテ、魏志ノ行程ニ合ハザルコトハ、近藤氏ノ山門郷ヨリモ甚シ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "又合衆國ニテ黒人ノ兒ト白人ノ兒ト、一處ニ教育セザル道理ノ一ツモ亦同一ニテ、數歳ノ後ハ其業課共通シテ進歩セズ、黒兒ノ智ハ一定ノ度ヲ越ユレバ、教育ニ供セザルコト明カナリト。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テ此等ノ事並ニ瑣細ナル事ニ就テ、精微ナル理ヲ穿鑿スル、論辨ヲ理會スルハ、我々ニテモ力ノ及バザルコト屡々コレアルガ如ク、其理由ハ智力單素ナルヲ以テ、知覺スベキ關係ハ夾雜組織セル者ニ相應給スルコト能ハザルニ在リ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テ此等ノ事ハ微細ナル水蟲ヨリ大ナル禽獸ニ至ルマデ、各其餌食ヲ得ルノ具、且ツ己ヲ保護スルノ具アリテ、又其傳嗣蕃育ノ法各々其天然ニ備ハラザルコトナク、皆其本能ニ依テ知ラズ識ラズ其本分ヲ盡ス者ナリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "邦人妄ニ之ヲ借リ来ツテ酒肆ニ名クト雖其ノ名ノ実ニ沿ハザルコト蓋甚シキモノアリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ其ノ金額日々拾円ヲ下ラザルコト往々ニシテ有リ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ヤ性狷介固陋世ニ処スルノ道ヲ知ラザルコト匹婦ヨリモ甚シ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ニマタ豪商ノ有トナリ棄テテ治メザルコト殆四十年、今遂ニ我ニ帰ストイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "宣光不敏ニシテ唯負荷ノ任ニ堪ヘザルコトヲ懼ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、聯合軍ニ話シカケ、マタ話シカケニ答ヘザルコト。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな派手なフロックで横浜をのそのそ歩いたりしたら、他人ヲ挑発スル如キ華美ナル服装ヲセザルコトと、午後五時以後外出セザルコトの禁止事項にふれて憲兵にひどい目にあう。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには、「右ノ者社会主義者ニアラザルコトヲ証明ス」とあって、駒込警察署の角印まであざやかなのであった。",
              "citation": {
                "source": "野宿",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊尹ノ周公モ及バザルコト遠シ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "権三、わかるか」「…………」「それから次の文句には賞ハ、卑賤ニ依ラズ、一切仔細ニカカハラザルコト、同前ナリ　つまり凡下放埒でも、坊主でも武士でも、敵味方なく、正成の首さえ持ってくれば、その日から船井ノ庄一郡の地頭にしてやるというお布令だ。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
