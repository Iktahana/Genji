        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "案内のの歯はザクリザクリと雪に音をたてて食いこんだ。",
              "citation": {
                "source": "春の上河内へ",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち、麦の穂波の向うに見えなくなり、そちらからの鎌の音がザクリザクリと聞こえて来る。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳をすませると、夫人のいうとおり、たしかに露にぬれた落葉をふんで、ザクリザクリと足音をしのばせて、家のまわりを歩いているではありませんか。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりか、ときどき、雨戸に手をかけてみるらしく、ガタガタと風もないのに戸のきしむ音がして、……また、ザクリザクリとあつい落葉をふんで、歩きだしているようすが、ありありとうかがわれます。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "……と、ふたたびザクリザクリと、落葉をふむ音が、しのびやかにきこえてきました。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり、黄金の山を駆け登り、その上に二三度転がって、あとは両手ですくい上げて、大判小判の滝を頭の上からザクリザクリと冠るのでした。",
              "citation": {
                "source": "黄金を浴びる女",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
