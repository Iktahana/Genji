        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このセーターはざっくりとした編み目で、とても暖かい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "麻のざっくりとした生地は、夏にぴったりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ざっくりとした質感の陶器は、手作りの温かみを感じさせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
