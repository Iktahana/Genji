          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日のプレゼンの資料は、まだざっくりとしかできていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ざっくりとした計画だけど、まずは始めてみよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は話が長いので、いつもざっくりと要点だけを伝えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "お納戸の絹セルに、ざっくり、山繭縮緬の縞の羽織を引掛けて、帯の弛い、無造作な居住居は、直ぐに立膝にもなり兼ねないよう。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と親しげに問いかけながら、口不重宝な返事は待たずに、長火鉢の傍へ、つかつかと帰って、紙入の中をざっくりと掴んだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてがこの調子で、間へ二ツ三ツずつ各自の怪談が挟まる中へ、木皿に割箸をざっくり揃えて、夜通しのその用意が、こうした連中に幕の内でもあるまい、と階下で気を着けたか茶飯の結びに、はんぺんと菜のひたし。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮舟さんが燗部屋に下っていて、七日ばかり腰が立たねえでさ、夏のこッた、湯へ入っちゃあ不可えと固く留められていたのを、悪汗が酷いといって、中引過ぎに密ッと這出して行って湯殿口でざっくり膝を切って、それが許で亡くなったのも、お前、剃刀がそこに落ッこちていたんだそうさ。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロロフォルムを嗅がして置いて枕の上に混沌としているやつを、水瓜を割るように斧でざっくり遣る手口、コウツもヘルグラインも耐ったものではない。",
              "citation": {
                "source": "斧を持った夫人の像",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "但右の養蚕家入門中、桑を切るとて大きな桑切庖丁を左の掌の拇指の根にざっくり切り込んだ其｜疵痕は、彼が養蚕家としての試みの記念として今も三日月形に残って居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ざっくり一太刀、帰雁が黒頭巾を割り下げた。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　男が鑿で荒彫りを一と刃ざっくりと立てながら、ひょいと顔をあげて言うと、女はひくい声で、「いいえ。",
              "citation": {
                "source": "香爐を盗む",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "この生きた鯉の背中にざっくりと庖丁が切り放たれることは、病室ではとうてい想像することも出来ない難事業であった。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "眺めていた人たちはぞっとし、ざっくり斬られる老人の姿が見えるようで、かみさんたちは眼をつむり、お互いに肩へしがみついた。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "太い毛糸でざっくり編んだ、丈のながいセーター。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親の牛九郎の方は仰臥けしたまま、禿上った前額部の眉の上を横筋違いに耳の近くまでザックリと割られて、鶏の内臓みたような脳漿がハミ出している。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "声も掛けず抜き打ちに背後からザックリ斬り付けたのはその次の瞬間のことであった。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やにわに飛び込んだ葉之助は、切りよい左手の一人の武士を、ザックリ袈裟に切り倒した。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを目掛けて小一郎は取り直した大刀、柄を廻わし、一歩踏み出すと身長を縮め、相手の左胴を上斜めに、五枚目の肋六枚目へかけ、鐘巻流での荒陣払い、ザックリのぶかく掬い切った。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに太刀を振り冠り、脳天からザックリと鼻柱まで、割り付けて軽く太刀を引いた。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザックリ割って飛びしさった。",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひだり肩口から乳下へかけてザックリ……下手人はよほど一流に達した武士であることに疑いを入れない。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダ、出さぬと、コレ、ザックリ行くぞ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と掛けた血走った声、ザックリ肩先へ切り込んだ。",
              "citation": {
                "source": "柳営秘録かつえ蔵",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれマア腕が……」と云うところをザックリまたも斬り付ける。",
              "citation": {
                "source": "村井長庵記名の傘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐘の鳴るのが成敗の合図じゃ……」　あわてて止めるのを尻目にかけ、油断を窺い繊手一閃、ザックリ肩を割りつけた。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と飛び込んで来た若い山窩、ザックリ肩を――切った意りだが、どうもね、うまく切れなかったらしい、余った力で前へ出た。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザックリ一太刀、出鼻を利用し、宗三郎右肩へ切り付けた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叫ぶと宗三郎、ザックリ一人を背後袈裟！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飽きると、私はその百銭を再び袋にしまい、歩調に合わせて膝にぶっつけザックリ、ザックリ鳴らしながら廊下を歩いた。",
              "citation": {
                "source": "百銭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、やや躊躇して、それを拾い上げる、銭の重味はザックリとして手答えがある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "前のは、ともかくも向う傷であったが、これは斬られて後に欄干にしがみついたのか、逃げ場を失うて欄干にしがみついたところをやられたのか、後ろ袈裟に、ザックリと思う壺に浴びせられて、二言ともなく息が絶えている形であります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "小名路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランボーはざわめく叢の上から鋤の刃をしめっぽい粘土の中へザックリと刺込んだが、思わずその手を引いて棒杭にでもよりかかるようにその柄によりかかった。",
              "citation": {
                "source": "作男・ゴーの名誉",
                "author": "THE HONOUR OF ISRAEL GOW",
                "note": "青空文庫"
              }
            },
            {
              "text": "末の見込があると目のあたり鯉かんに賞められたそのあとだけに肩先深くザックリやられた今夜の傷手は深かった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
