        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "転んで膝をざっくりと切ってしまい、血が止まらなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の言葉は、私の心をざっくりと深くえぐった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鋭い石で手のひらをざっくりと裂いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
