        "examples": {
          "standard": [
            {
              "text": "痔の治療のため、医師から温かいお湯での座浴を勧められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "出産後の回復を早めるために、助産師が座浴の方法を教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冷え性改善のため、毎晩ハーブを入れた座浴を楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "座浴、立浴、臥浴、洒浴、針浴、按浴、湿浴、乾浴等の種類あり。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、不意を喰つたやうに、ちよつと照れて、「しかし、とにかく、こんな遠いところへ、わざわざよく来てくださいました。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐れ入ったろう」「……これは手酷しい」「会いたいなら、わたしの家だってお茶屋だし、わたしが会わして上げるものを、隠れ遊びなんざよくないね」「相済みません。",
              "citation": {
                "source": "春の雁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは僕には坐浴より外に瘉すことの出来ない痛みだつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坐浴、――ベエトオヴエンもやはり坐浴をしてゐた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　坐浴に使ふ硫黄の匂ひは忽ち僕の鼻を襲ひ出した。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは僕には坐浴より外に瘉すことの出来ない痛みだった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坐浴、――ベエトオヴェンもやはり坐浴をしていた。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　坐浴に使う硫黄の匂いは忽ち僕の鼻を襲い出した。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
