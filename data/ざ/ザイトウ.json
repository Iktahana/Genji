        "examples": {
          "standard": [
            {
              "text": "政府は、景気対策として財投の活用を検討している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "財投によって、公共事業やインフラ整備が進められてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "財投の規模や使途については、国会で議論されることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "とざいとうーざい、夜どおし狂言で腰を折るのは御勝手なれど、いま業平の香屋の若旦那が、ざんげ話の腰を折ることはまかりならぬ、いずれも静かにお控えあれ、などと黄色いような声で叫んだ。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
