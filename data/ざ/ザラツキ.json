        "examples": {
          "standard": [
            {
              "text": "塗装の表面にざらつきがあり、滑らかな仕上がりにならなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "肌のざらつきが気になる季節なので、保湿ケアをしっかり行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "コーヒー豆を挽いたとき、粉に少しざらつきが残った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "男は砂埃でざらつきさうな赤い毛と、日に燒けて生涯褪めつこない強い色を有つてゐた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は砂埃でざらつきそうな赤い毛と、日に焼けて生涯褪めっこない強い色を有っていた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙台松島湾の数珠子釣りも郷土色があっておもしろいが、魚も松笠で色もどす黒く、手につかんでもざらつき、煮出しに使うぐらいなものだ。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
