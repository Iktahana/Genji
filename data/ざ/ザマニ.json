        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『ザマニロフカ村はまだ遠いかね？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "』という質問に対して、二人の百姓は帽子を脱ったが、その中の一人で、少し利口そうに見える、楔形の顎鬚を生やしたのが、『ザマニロフカじゃごぜえめすめえ、おおかたマニロフカでごぜえましょう？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ザマニロフカなんちゅう村はこけえらにゃねえだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザマニロフカなんちゅうところは、こけえらにゃ頓とねえだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ザマニロフカなんちゅう村はこけえらにゃありもしねえし、あった例しもねえだよ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモコレト当世ノ務ヲ談ズルヤ議論横ザマニ生ジ口角｜沫ヲ溌シソノ気力｜毫モ前日ニ減ゼズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
