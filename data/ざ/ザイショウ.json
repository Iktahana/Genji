  {
    "uuid": "2caa1b7f-74d0-56ef-a49f-b54641068950",
    "entry": "財相",
    "reading": {
      "primary": "ざいしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Minister of Finance",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "財相は、経済対策について記者会見を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今年の予算案は、財相が中心となって編成された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ねえ、今年の財相の発表、何か新しいことあった？」と友人が尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それらの人を一切合財相手にして、ごみだらけのアイスクリームや、冷し飴や、西瓜などを売っている縁日商人は、売れ残りの品をはやくさばいてしまおうと思って、いまだに声をからして客を呼んでいます。",
              "citation": {
                "source": "祭の夜",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんという侮蔑、なんという愚弄、いや、御前もさぞ御気持の悪いことでございしょう。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
