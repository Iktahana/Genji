        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "敬ニシテ礼ニ中ラザルヲ野トイヒ、勇ニシテ礼ニ中ラザルヲ逆トイフ　とか、信ヲ好ンデ学ヲ好マザレバソノ蔽ヤ賊、直ヲ好ンデ学ヲ好マザレバソノ蔽ヤ絞　などというのも、結局は、個人としての子路に対してよりも、いわば塾頭格としての子路に向っての叱言である場合が多かった。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本改造法案ノ起草者ハ當然ニ革命的大帝國建設ノ一實行者タラザルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "都市ト限リテ町村住宅地ヲ除外セル所以ハ、公有トスベキ理由ガ町村ノ程度ニ於テハ完成セザルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ國庫ノ負擔堪ヘザルヲ云ハン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "公告決定通知本願ハ拒絶ノ理由ヲ発見セザルヲ以テ、公告スベキモノト決定セリ　輝かしい日だ、雪は降りしきっているが……。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これというのも、この節は夜具屋が縫わなくなって、うちで人に手伝ってもらって夜具の綿入れをいたしましたから、それで、おそろしながら「綿入れ」と称するものが出来上ったのよ、あれこそブランカ特製品ですものね、アタタカナラザルヲエンヤ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草幾管捻リ来タリ捻リ去リ、空々タル談話百回説クモ益無ク終日聴クモ利無クシテ、其ノ尻ノ長キ絛虫ニ百倍スル如ク、屡バ他人ノ事業ヲ妨グル者ニ至テハ真ニ辟易畏避セザルヲ得ズ。",
              "citation": {
                "source": "忙ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "左ハ言ヘ古器ヲ玩ブハ他ノ学事ト同ジカラザレバ、古刹ノ僧侶ガ霊宝ノ伝来ヲ説クガ如ク、附会ノ説ヲ喋々スルハ甚ダ煩ハシケレバ、考証ハ固ヨリ有用ナレド、務メテ雅致ヲ失ハズ、空シク理窟ニノミ流レザルヲ可トス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭君ガ漢宮ノ姫人ニシテ遠ク胡地ニ沈淪シテ死スルニ至テハ、誰カ之ガ為メニ暗涙滴々タラザルヲ得ン。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ物理ニテモ、心理ニテモ、大顱ノ歐洲種ト小顱ノ夷種トヲ區別スル所以ハ、外境ノ組織セル關係ヲ内部ノ能力ニテ相應スルノ度ニ由ルト、斷言セザルヲ得ズト。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論漢學ナル者ハ支那ヲ祖トスレバ、之ヲ師トセザルヲ得ズト雖ドモ、皆蹈襲摸傚ヲ事トシ、化シテ本邦ノ益トナスコト無クンバ、亦何ノ用ゾヤ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ一ハ實驗ヲ主トシテ生踈ヲ免レ、一ハ淵源ヲ深ウシテ精微ニ至ラバ、則チ後生ニ至テ新理ノ發明者興ラザルヲ患ヘムヤ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ東山ノ勝ニ至ツテハ則愛翫シ娯樂セザルヲ得ズ。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "余｜安ゾ欣然トシテコレニ叙セザルヲ得ンヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "途ニ上ルノ日｜復ビ慈顔ヲ奉ズルコト能ハザルヲ知リ、話シテ刻ヲ移ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノイマダ交付セザルヲ以テ皆仮ニ民舎ニ館ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、医師ノ立場カラ言エバ facies（顔）ハ皇帝ナレド corpus（体）ハ全然別人ナリト言ワザルヲ得ズ。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歌にも寓意を考え、「此歌上句ハ佞人ナドノ官ニ在テ君ノ明ヲクラマシテ恩光ヲ隔ルニ喩へ、下句ハソレニ依テ細民ノ所ヲ得ザルヲ喩フル歟」（代匠記）等というが、こういう解釈の必要は毫も無い。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガ自分ノ顔ナノカト呆レザルヲ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思エバ予ハ随分長イ月日ヲ生キタモノヨ、数限リモナイ移リ変リヲ経験シタモノヨト、自ラ驚カザルヲ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜいけませんか」「――ソノ備エザルヲ収メ、ソノ不意ニ出ヅ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝瞻今スデニ八歳、聡慧愛スベシ、タダソノ早成、恐ラクハ重器タラザルヲ嫌ウノミ　彼は八歳の児を見るにさえ、国家的見地からこれを観ていた。",
              "citation": {
                "source": "三国志",
                "author": "篇外余録",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
