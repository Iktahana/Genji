    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-サ変-す",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to sit",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "式典では、主賓が壇上の最前列に静かに座した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "瞑想のため、彼は床に坐禅の姿勢で座した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「どうぞ、お疲れでしょうから、椅子に座してください」と老婦人が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一たび槍ヶ岳や穂高岳に登った人は、日本アルプスに列座する大連嶺の、雪に閃めき氷に尖れる壮観に接して、北へ！",
              "citation": {
                "source": "上高地風景保護論",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）○＝（Ｆ・Ｉ）奉行笠原左衛門の宅（内部）　左衛門と七兵衛と対座する。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも最初のうちはあやまって堪忍されたのであるが、あまりにそれが度重なるので、ほかの芸人がすべて彼女と一座するのを嫌うようになった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "通された一同其処へ着座する。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ L = 0 すなわちＳＫの面内に座する著名の大家を物色する事が困難である。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゾンマーフェルトやその他の数理物理学者はＳ軸の上近くに座するものであり、純実験、純測定の大家らはＫ軸に羅列される。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにＬ軸の真上に座する人はもはや科学者ではない。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」脚を重ねて椅子に座す。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "初の烏、※と地に座す。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも銀子が一座する芸者のなかに、塩釜育ちの妓があり、「はっとせい節」の話が出て故郷を思い出し、客に強請んだからであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に銀子も沢正の座敷に一座し、出が出だけに歌舞伎や新派ほど役者の気取りがなく、学生丸出しで、マークの柳に蛙の絵を扇子に気軽に描いてくれたり、同じマークの刻まれたコムパクトをくれたりするので、芸者の間にも受けがよく、一座するのを光栄に思うのであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しそれにしては何様も様子が腑に落ち兼ねたから、恐る恐る進んで、恐れながら我が君には御落涙遊ばされたと見受け奉ってござるが、殿下の取分けての御懇命、会津四十二万石の大禄を被けられたまいし御感の御涙にばし御座すか、と聞いて見た。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪洞を取って静に退座す。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "素袍でも着た徒が玉の輿持つて、へい、お迎、と下座するのを作らつせえ。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、呼びにやられた母親が、いつも有卦にでも入った顔付で直ぐ馳せつけまして、いよ／＼池上から結婚の話でも切り出されたのかと、ひとり飲み込み顔にわたくしに対座するのには随分嫌気がさしました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖経はエルサレムの神殿を以て神の座すところとせり、其神殿に聖所あり、至聖所あり、至聖所には祭司の長の外之に入ることを得るもの甚だ稀なりと伝ふ。",
              "citation": {
                "source": "各人心宮内の秘宮",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "書院には両奉行が列座する。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側には取り調べを命ぜられた与力が、書役を従えて着座する。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし五歳の男児と三歳の女児の未だ教の何たるかを知らない者まで連座するのを見ると涙がこぼれる」と云うと、角蔵は、「何と云う事を云われる。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "従兄弟同士が沈黙を挟んで五六時間も対座することがある。",
              "citation": {
                "source": "秋草の顆",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "王の着座するや、其頭には金色に塗りて更にまた彩りたる鷄卵を並べて作れる笠を冠として戴かせ、其手には「マケロニ（麪類の名）つけたる大いなる玩具の柄つきの鈴を笏として持たせたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "小三津は泣いて退座すると云い出したが、花形役者に退かれては興行にさわるので、ほかの人々が仲裁して無事に納めた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "老年になってからは、君前で頭巾をかむったまま安座することを免されていた。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠之の表へ出座する時刻が遲れ勝になり、奥へ引籠む時刻が早目になった。",
              "citation": {
                "source": "栗山大膳",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "立會として井伊｜掃部頭直孝、酒井｜雅樂頭忠世、酒井｜讚岐守忠勝、松平｜下總守忠弘、永井信濃守尚政、青山｜大膳亮幸利、板倉｜周防守重宗、稻葉丹後守正勝、尾張家附成瀬隼人正、紀伊家附安藤帶刀、大目附柳生但馬守｜宗矩、秋山修理亮、水野河内守、加々爪民部の人々が利勝の左右に著座する。",
              "citation": {
                "source": "栗山大膳",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "書院には兩奉行が列座する。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側には取調を命ぜられた與力が、書役を隨へて著座する。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと「神が在る」といふことは、私の直観に根ざすのだ。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "もつと適確に云ふなら、西田幾多郎の「純粋意識」に根ざすのだ。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "指ざす方に日は出らめ。",
              "citation": {
                "source": "絶句四章",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to be implicated",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
