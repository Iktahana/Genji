        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はその不正事件に座すことになり、会社を辞任せざるを得なかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "軽はずみな行動が、思わぬ形で周囲の人々を苦境に座すことになりかねない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "無関係な人間が、事件の渦中に座すことは避けたいものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
