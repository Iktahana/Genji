    "definitions": [
      {
        "index": 1,
        "gloss": "stranding",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "嵐に流された小型船が、座州してしまい身動きが取れなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "座州した漁船の救助作業は、天候不良のため難航を極めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このプロジェクトは途中で資金難に陥り、完全に座州してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もともと「神が在る」といふことは、私の直観に根ざすのだ。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "もつと適確に云ふなら、西田幾多郎の「純粋意識」に根ざすのだ。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "指ざす方に日は出らめ。",
              "citation": {
                "source": "絶句四章",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり大小の群星には二つの党派があってそれぞれの根拠地より出でて互いに入り乱れつつも目ざす処に馳せ行くがごとき有様である。",
              "citation": {
                "source": "宇宙の二大星流",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大日堂の裏手より裏見の滝へとこころざす。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼ざし定まりて口元かたく結びたるまゝ、畳の破れに足も取られず、心ざすは何物ぞ。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "何となればその詩集は、二つの別な方向を目ざす所の、互に矛盾した心境からなつてるもので、二部混亂の不統一を示してゐたから。",
              "citation": {
                "source": "室生犀星君の飛躍",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めの内は誤解もするし、怒るような事もあるし、場合に依っては誰か死ななくては目ざす人に近寄られないというような事さえある。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　摩天楼の鏡の面からつやぶきんをとるために、私は、藍色のカーテンで市街に向ってひらいた窓を閉ざすと、「――それよりか、君のコオセット・ボタンがいくつあるか計算さしてもらいたいもんだね。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "セリストもピアニストも目ざすところは音楽であるように、われわれ物理学者も専門のいかんによらず目ざすところは物理であろう。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔廿日月かざす刃は音無しの〕宮沢賢治廿日月かざす刃は音無しの　　　　黒業ひろごるそらのひま　　　　　　　　　その竜之介風もなき修羅のさかひを行き惑ひ　　　　すゝきすがるゝいのじ原　　　　　　　　　その雲のいろ日は沈み鳥はねぐらにかへれども　　　　ひとはかへらぬ修羅の旅　　　　　　　　　その竜之介",
              "citation": {
                "source": "〔廿日月かざす刃は音無しの〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども狡猾なるブルジョアジーは、うまい、美しげな大義名分を振りかざす。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "目ざす白い電燈のところまでゆきつくと、いつも私は息切れがして往来の上で立ち留った。",
              "citation": {
                "source": "闇の絵巻",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一七六〇年にシナ政府は三人のジェスュイトをこの地方へ視察に派遣したが目ざす地方には至るところ砂漠ばかりで求むる湖水はどうしても見つからなかった。",
              "citation": {
                "source": "ロプ・ノールその他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして後者のほうは、同時にまた科学に接近する、というよりもむしろ、科学の目ざすと同一の目的に向かって他の道路をたどるもののようにも見えるのである。",
              "citation": {
                "source": "科学と文学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "西北隣のロシアシベリアではあいにく地震も噴火も台風もないようであるが、そのかわりに海をとざす氷と、人馬を窒息させるふぶきと、大地の底まで氷らせる寒さがあり、また年を越えて燃える野火がある。",
              "citation": {
                "source": "災難雑考",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "母がどんどん行ってしまうのであとを追いかけようとするけれども、二人の間にはガラスのかけらがうざうざするほど積まれていて、脚を踏み入れると、それが磁石に吸いつく鉄屑のように蹠にささりこんだようでもある。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道路の左側は林檎園になっていて、おおかた葉の散りつくした林檎の木立が、高麗垣の上にうざうざするほど枝先を空に向けて立ち連なっていた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "足音はやや斜め後ろから間近になると突然私の眼の前に、野花をうざうざするほど摘み集めた見覚えのある経木の手籃が放り出された。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速一風呂浴びて渓流を耳にしながら杯を傾け、寝に付く前四人して浴場へ志ざす。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "小山駅で水戸の三人武者とも別れて、後はただ一人、俄かに淋しくなれば数日以来の疲労も格段に覚えて、吾輩は日光の鮮かに照す汽車の窓から遠近の景色を眺めていると、吾輩に向い合って腰掛けていたのは頬骨の高いハイカラ紳士、物をもいわず猿臂を伸ばして、吾輩が外を眺めている車窓の日除け扉を閉ざす。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは怪しからん奴じゃ、他の領分の扉を無断で閉ざす奴があるものかと、吾輩は用捨なくすぐに開けると、暫時してまたノコノコ手を伸ばして閉める。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "片手づまみの大皿の鮨は、鐵砲が銃口を揃へ、めざす敵の、山葵のきいた鮪いのはとくの昔討取られて、遠慮をした海鰻の甘いのが飴のやうに少々とろけて、蛤がはがれて居る。",
              "citation": {
                "source": "祭のこと",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）晃　月影に……（空へかざす）なお光るんだ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "と晃然とかざす鉄杖輝く……時に、月夜を遥に、唄の声す。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　さて壇を退きざまに、僧のとざす扉につれて、かしこくもおんなごりさえ惜まれまいらすようで、涙ぐましくまた額を仰いだ。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "横路地を衝と出て、やや門とざす湯宿の軒を伝う頃、一しきり静になった。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "高綱　　今日はこゝろざす佛の命日。",
              "citation": {
                "source": "佐々木高綱",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年八月三十日『東京朝日新聞』）発電所は難破船　メキシコの南隣グァテマラの西海岸の一小市で近頃電灯を点ずるようになったが、その中央発電所は同市の海岸近くに坐洲したドイツの汽船である。",
              "citation": {
                "source": "「万年筆」欄より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間ほどすると、坐洲点から三百パ（約二百米）ほどずりだし、そこで水に浮いた。",
              "citation": {
                "source": "海難記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
