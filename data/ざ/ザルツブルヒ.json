          "literary": [
            {
              "text": "「まあ、己の考えでは、ザルツブルヒあたりに足を留めようかと思う。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに乗って正午に立ってザルツブルヒへ行こうというのである。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザルツブルヒに着いたのは午後遅くなってからであった。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのザルツブルヒの宿屋の長椅子に寝ていたのはきょうだっけな。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリイはザルツブルヒで合奏を聞いた晩の事を思い出した。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            }
          ]
        }
