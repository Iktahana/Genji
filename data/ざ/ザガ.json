[
  {
    "uuid": "f88e30ac-ed45-5d3e-84a6-6efcce7763fa",
    "entry": "座臥",
    "reading": {
      "primary": "ざが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
