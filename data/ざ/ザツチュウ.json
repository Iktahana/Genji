          "literary": [
            {
              "text": "この混雑中に窓から飛んで逃げたのもいた。",
              "citation": {
                "source": "私の子供時分",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "混雑中ながら猶予はならぬ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お座敷帰りとも見える姿で、ちょうど忌中の札をかけて大混雑中の棟梁方の格子戸をくぐろうとした時だ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その混雑中に、孫堅についていた郎党のひとりが、袁紹の陣へ行って、内通した。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
