    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『一話一言』一六に、『会津旧事雑考』より承安元年｜辛卯を耶麻郡新宮の神器の銘に、弥勒元辛卯と記した由を引き、三河万歳の唱歌に、弥勒十年辰の歳、諸神の立ちたる御屋形と唄うも、いずれなき事にはあらじかし、とある。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "静物画雑考　東洋画ことに支那絵には野菜、果実、草花、器物、等が単独に絵の題材として古くから多く使われている。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラス絵雑考　私は、ガラスというものについて特殊な愛着を持っている。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "本項はかつて本誌所載「斑鳩宮及び斑鳩寺に関する雑考」中にその大要を述べたところであるが、今、さらに再建非再建論問題の回顧を完うし、兼ねて前説の不備を補うの意味において繰り返す事とした。",
              "citation": {
                "source": "法隆寺再建非再建論の回顧",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "斑鳩宮に掘立柱の建築物のあった事は、余輩かつて本誌上の「斑鳩宮雑考」の中にも述べておいた。",
              "citation": {
                "source": "法隆寺再建非再建論の回顧",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり、文政頃の酒価と酒の質について『異聞雑考』の記すところでは――味噌は甲午の夏五月より、金一両二十貫四百目になりぬ。",
              "citation": {
                "source": "酒渇記",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「※庭雑考」に「禁秘抄」を引用して『角なきは獅子、角あるは狛犬なり』と云うているけれども、実際には角のある獅子が、狛犬の代理をしているのも、決して珍しくない。",
              "citation": {
                "source": "獅子舞雑考",
                "author": "中山太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九、獅子頭の鼻毛と馬の尻尾　私の雑考も、獅子頭の鼻毛の如く、それからそれへといたずらに長くなったので、この辺で打ち切ろうと思うたが獅子の鼻毛の出たついでに、これに関する一挿話を掲げて擱筆する。",
              "citation": {
                "source": "獅子舞雑考",
                "author": "中山太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事業があまりにも断片的であるために、随筆などといって軽んぜられているが、京伝や種彦のいくつかの著述は先駆であって、同じ態度を一段と精透に、進めて行ったのが喜多村節信、すなわち『嬉遊笑覧』『画証録』『※庭雑考』などの著者である。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず米の話については、今日のように文化史の側からも、自然科学の側からも、互に協力して研究してゆくようになったのは、西ヶ原農事試験場に四十年も顕微鏡を覗いておられた安藤広太郎さんの『日本古代稲作史雑考』という、画期的な著書が出版されたのが動機であった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "白鳩号の調査記録は、昭和九年の『航空研究所彙報』に出ているが、その内容の一番面白いところは、寺田先生の随筆「災難雑考」に紹介されている。",
              "citation": {
                "source": "「もく星」号の謎",
                "author": "――白鳩号遭難事件を回顧して――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
