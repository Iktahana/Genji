        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "橋の支柱に想定外の荷重がかかり、金属疲労によって座屈してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "建築現場で足場のパイプが座屈し、あわや大惨事になるところだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "薄いアルミ缶を上から踏みつけると、簡単に座屈して潰れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ぴか／＼と光る鍬の先を、ざくつと芋の株へ斜に突き立てゝぐつと鍬を持ちあげると大きな土の塊がふわりと浮きる。",
              "citation": {
                "source": "寫生斷片",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴか／＼と光る鍬の先をざくつと芋の株へ斜に突き立てゝぐつと鍬を持ちあげると大きな土の塊がふわりと浮きる。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "一夕、翁の側に侍りけるに、いざくつろぎ給へ、我も臥なんと宣ふ。",
              "citation": {
                "source": "芭蕉雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎はポケットから、貝殻をざくざくつかみ出して、そこに並べる。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
