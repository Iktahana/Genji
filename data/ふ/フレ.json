  {
    "uuid": "e8d11ca9-812a-56b5-be2b-52970cc0bb6d",
    "entry": "フレ",
    "reading": {
      "primary": "ふれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
