        "examples": {
          "standard": [
            {
              "text": "今夜のメインディッシュは、鶏肉ときのこのフリカッセだよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "フリカッセの濃厚なクリームソースが、バゲットによく合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "フランス料理店で、仔牛のフリカッセを初めて注文してみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "あの先生がたの台所で、市場に四日も店晒しになってたような羊の肉で拵らえるフリカッセーなぞたあ物が違いますからね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して、フリカッセ・チキンをとると、ベシャメルソースの味もおっとりしてゝ上等。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
