        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "微風が花の香りを部屋の奥まで吹き送ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "扇風機で涼しい空気を病人に吹き送り、体温を下げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "遠くで聞こえる音楽が、風に乗って耳元まで吹き送られてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼等は太平洋の岸辺に立って、大陸からの潮風が吹き送る新日本の文明を、いつも時代の尖鋭に於て触覚していた。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術家はそれゆえ、自分のからだをひた隠しに隠して、ただその笛の音だけを吹き送る。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日までの人々にとつては、その美しい日本アルプスなるものも、ただ冬期に嵐と雪とを吹き送る厄介なものたるに過ぎなかつたに異ひない。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "西山一帶は冬の嵐を捲いて來るもの、雪を吹き送るものとしか思はれてゐなかつた。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "開聞のほとり迫平の松にあり屋久の島より吹き送る秋　前の天草が日本の西端なら、この開聞が岳は日本の南端で、その点もよく似てゐるがその調子の高いことも同じ程で何れもやたらに出来る種類の歌ではない。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの木、どの草、どの葉にも、冴えた萠葱と、金色と、深い紅とが入りまじり、そして、内気なそよ風も、水晶質のしら露の嬉し涙を吹き送る。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その爲め蘆の湖から吹き送る濕氣が多くていけないなどゝいふ者があるが、併しその相模灘から湧き上つてくる水煮氣が刻々千變萬化の奇趣妙景を盡しつゝやがて雲となり溪を埋め、峯を這ひ大空を蔽うてゆく有樣を見ようとすれば蘆の湯に足を逗めてゐなければならぬ。",
              "citation": {
                "source": "箱根の山々",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑かった江戸の一日も終わって、この貧しいとんがり長屋にも、自然はすこしの偏頗もなく、日暮れともなれば、涼しい夕風を吹き送るのでした。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨が雷を送る香港の海、ばしょうの風が暑熱を吹き送る呂宋の山、航路は熱帯の地をこえてはじめて涼風起こり、船は珊瑚礁の地に入って景色はまじりあう。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「大変ですよ、あっしの手には了えねえから、親分を迎えに飛び出したところで」　ガラッ八の八五郎は、額口の汗を拭き拭き、馬のような荒い息を、川風に吹き送るのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、正に世界の最後の日のために用意された、悪魔の大軍が、人間の罪を鳴らすために地獄の底から吹き送る音楽と言った方が適切だったでしょう。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "結婚ラプソディ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほたる子は　繁みの中に　あはれ光るもわたつみの遠きかなたゆ　吹き送るくだりの風の　雲をいだせりわたの風、ふきしくこの夜　くらくして、夏虫おほく　鳴きいでにけりたぶの木の繁みはくろく、さびしもよ。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗盛　『払いし露にも　跡は知るべし　後ろ吹き送る　風よ音すな』宗盛も同様に船に上ると、舳先より動き出し、水に浮かんだ屋形船、奥へと退いていく。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "之を惠みて銀弓のアポローン追風吹き送る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらは鐘の音のように揺いでいる、野の中にいる人の耳に、風がもたらしてはまた一つ一つ遠くへ吹き送る鐘の音のように。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "其海から青田を越えて吹きおくる凉風がさわ／＼と其芒の穗を吹き靡ける。",
              "citation": {
                "source": "松蟲草",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "沖遠く吹きおくる凉しい風に日覆の布がばさ／＼とふれる。",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして軟風のいらいらと葱の臭を吹きおくるたびに私はある異常な靈の壓迫を感じた。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエスとマリアとの間には、花の香とそのかおりを吹きおくるそよ風のように微妙な心のかよいがあったにしろ、マリアを純一にし、まじりけなく行動させたのは窮極において、彼女が人間の関係のうちに見出したまともなものへの献身であった。",
              "citation": {
                "source": "傷だらけの足",
                "author": "――ふたたび純潔について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る小説に或る時代の反応が明かに提出されているということだけが芸術家を成仏せしめるものでもないし、読者に清新な精神の風を吹きおくるものでもない。",
              "citation": {
                "source": "数言の補足",
                "author": "――七日附本欄伊藤整氏への答として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼は静けき窓のうち、心の絃にたちかへり、夜はよもすがら胸のうへ、あえかの夢を吹きおくる。",
              "citation": {
                "source": "小曲二十篇",
                "author": "漢那浪笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "（b）僅かなる風辛うじて彼らの勲功を我らのもとに吹きおくるのみ。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
