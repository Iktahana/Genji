  {
    "uuid": "cc809d26-78d0-5964-8432-1515d20f7e13",
    "entry": "ふりふり",
    "reading": {
      "primary": "ふりふり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゐもりは短い首をふりふり泳ぎ※つてゐたが、次の朝みたら逃げて了つてゐなかつた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は首をふりふりこの並木の青葉を眺めた。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "便所というのは「トイレ」で通じるのかなと朦朧とし始めた頭をふりふりたずねあてて便座に腰を下ろすや、腹はナイヤガラの滝のように下るわ、イエローストーンの間欠泉のように吐瀉物は口から吹きだすわ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウイルス頭をふりふりそう考えたオレは、本当に流行って欲しい環境としてはＷｉｎｄｏｗｓだけを挙げた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、からすはいって、あたまをふりふりとんでいってしまいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、さもうれしそうに、くびをふりふりしました。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "農工商の上に立つお歴々が、尾をふりふり素町人の御機嫌を取り結んでいるゆえ、珍しゅう思うて尋ねるのじゃ。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あけな、あけな、女の子は近寄ってもさしつかえねえが、ろくでもねえ野郎ども雁首を引っこめな」　肩をふりふり通っていったあとから、名人は秀麗かぎりない面に、ほのかな笑みをたたえながら、静かに通っていくと、案内も請わずずかずかとはいっていって、ずばりと宿の者にいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのなかで頭をふりふり世間を観じている蓑虫の心は、むかし周氏の父が味ったような遊びに近いものではなかろうか。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてセルロイド製のやうな禿頭をふりふり群衆に紛れ込んだ。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして昼間のおつかなびつくりな挙動とは打つて変つた敏捷な足どりで、長い焦色の触覚をふりふり、いきなり冬瓜に抱きつき、相手があまりに大きく、ちよつと得体が知れないのに戸惑ひしたるかたち。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　父はさういつて鋸をふりふり、大股にまた他の樹をさして歩き出すのであつた。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "くらがりの小川の岸づたひに、松明をふりふり辿つて往くと、火影を慕つた大鯰が偶にぱくりと水音をさせて、その大きな頭を流の上にもちあげます。",
              "citation": {
                "source": "雨の日に香を燻く",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが彼もまた最後の望みにこの帝都有数の校長として、せめては最高俸二百四十円なりに辿りつきたい、それには何をさて措いても――と彼は頭をふりふり考えるのであった――まず第一に校舎を清浄に生命のある限り保たねばならぬ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鵞鳥鵞鳥に腹掛けかけさせてみんなで遊びにつれてゆこ玩具屋の表は駈けて通ろみんなで　ならんで駈けて通ろ鵞鳥も一緒に駈けるだろ長い頸ふりふり駈けるだらう。",
              "citation": {
                "source": "十五夜お月さん",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "幅員が三十三メートルもあるその大通りのまん真中を、洋杖をふりふり悠然と濶歩してゆくのだった。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから彼は、太い籐のステッキをふりふり、新温泉の方へ歩いていった。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は自分の情熱が百度以上に昇っているのを知ってます」「とにかく後でまたご連絡しましょう」　袋探偵は、頭をふりふり病院を出ていった。",
              "citation": {
                "source": "心臓盗難",
                "author": "烏啼天駆シリーズ・２",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度彼は永い間かかった或る仕事を片づけた直後で、半ば興奮し、そして半ば退屈を覚えて、いつも愛用の細身の洋杖をふりふり散歩をしていたのだった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『それが貴方……』　ばあやはいかにも大事件だ、というように手をふりふり話し出すのであった。",
              "citation": {
                "source": "蝕眠譜",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "教会堂へつくと、殆んどがら空きな脇間の祈祷台に膝まずいて、両手を組み合せ頸をふりふり、牧師の声に合せて低声でお祷りをした。",
              "citation": {
                "source": "老嬢と猫",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガノ公と話していたら目の前にドラやきがあるのにそれどころでなし　夜痛んで首をふりふりひとり治療九月二十七日　水曜『新女苑』、急なことを云ってかけるかどうか。",
              "citation": {
                "source": "日記",
                "author": "一九五〇年（昭和二十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはさつきから根気よく、朱柄の麈尾をふりふり、裸の男にたからうとする虻や蠅を追つてゐたが、流石に少しくたびれたと見えて、今では、例の素焼の瓶の側へ来て、七面鳥のやうな恰好をしながら、勿体らしくしやがんでゐる。",
              "citation": {
                "source": "酒虫",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、彼は、片目を火のようにひらめかせながら、黙って、席を蹴って去ろうとする――すると、その後ろから、猪熊の爺はまた、指をふりふり、罵詈を浴びせかけた。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一太はそのとき勇み立って、「ああ行こうよ、行こうよおっかちゃん」と云ったが……一太は、頭を傾げ脚をふりふり、「どんなところだろうね朝鮮て！",
              "citation": {
                "source": "一太と母",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたんところに大きな絨毯はありませんか」　男を送り出すとアンナ・リヴォーヴナは頭をふりふり食堂へ戻った。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃあ一生懸命云ったんです」　だがリザ・セミョンノヴナは、彼女の綺麗で怜悧な水色の横目でナースチャの喋べくるのを眺めながら、膝を抱えて体をふりふり、彼女の鼻歌をうたいつづけた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
