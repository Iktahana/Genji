        "examples": {
          "standard": [
            {
              "text": "ソファのクッションには、快適なフォームラバー（foam rubber）が使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このマットレスは、体圧分散に優れたフォームラバー（foam rubber）製です。」と販売員は勧めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "フォームラバー（foam rubber）は、断熱性や衝撃吸収性に優れているため、様々な用途に使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "早速、紅絹は解かれ、左の背中にフォームラバーが当てられる。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
