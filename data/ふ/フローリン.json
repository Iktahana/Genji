    "definitions": [
      {
        "index": 1,
        "gloss": "florin (coin)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アンティークコインのオークションで、保存状態の良い19世紀のイギリスのフローリン銀貨を落札した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ヴィクトリア女王の肖像が刻まれた古いフローリン硬貨を、祖父のコレクションの中から見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "イギリスが十進法に移行する前、2シリングに相当するフローリン硬貨が日常的に使われていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼が教王ホノリウス※世にふつうの謝金として要求したのは毎日200フローリンで、その他に「心付け」が6000フローリンであった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "400から500フローリンが最高であった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常に低めの推測であるが賃金の損失および医療費を３日あたり１フローリン(23)とみなすと住民は病気によって毎年340万フローリンを失っていることになり、当時としては莫大なものであった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは民衆にとって127万1600フローリンの節約を意味した。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "利率を5%とみなすと資本の額は2543万2000フローリンとなる。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八〇九年に、ヴィーンの最も富裕な三人の貴族ルードルフ大公（彼はベートーヴェンの弟子であった）とロプコヴィッツ公とキンスキー公とが協力して、ベートーヴェンがオーストリアを去らないというだけの条件のもとに、彼に四千フローリンの年金を与えるように計らった。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年以来彼は僕のために六百フローリン投げ出してくれた。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "金が通用する限りは問題ないが、手付け金は粗悪なフロリン銀貨のようなものをくれたと。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "六ポンドのエクー古銀貨、英国のフロリン銀貨、ダカット銀貨、ジャコビュスの金貨、ローズノーブルの銀貨などが音もなしに盤のなかへ落ちました。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "聖餐祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "国内の或る部分では、地面が海面よりも低いので、堤防が到る所に築かれてあることは既に述べたが、その堤防の上には楊柳の枝などをかぶせて泥で固め、それを数年ごとに取り替えねばならないので、その費用だけに年額千五六百万フロリンを支出するそうだ。",
              "citation": {
                "source": "レンブラントの国",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尉と中尉だけはよく描いてあるが、あとの組合員は全部｜端者のように蔭に押し込められて中には顔さえも判明しないものが少くないので、大枚千六百フロリンを払って却って侮辱を買ったと彼等は思い込んだのだ。",
              "citation": {
                "source": "レンブラントの国",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃組紐業のブルフホルツという人が、ハイドンの窮乏を憐んで百五十フロリン貸してくれたが、後年ハイドンはその恩に酬いるために、遺言状で指定してブルフホルツの孫娘に遺産をわけてやった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "光は彼方より　一七九〇年ニコラウス侯が死んで、ハイドンは二千フロリンの年金を約束されてエステルハツィ城から解雇された。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーツァルトはしばしば窮乏のドン底に追いやられ、音楽時計のためにアダジオを書き、数フロリンの金のためにソナタを書いた。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にはシューベルトを助けた者もあるが、多くはシューベルトのたまたま儲けた数フロリンを、酒とソーセージにしてしまう場合の方が多かった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "シューベルトの受けた報酬は一授業わずかに二フロリンにすぎなかったが、作曲の時間があるのと、田園の風物に親しむことの出来たのが、ウィーン児のシューベルトにとってはなかなかに楽しい経験であった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "出版屋は愚劣な流行作家のものを出版するのに忙しいという口実で、十二曲をわずかに百六十フロリンで引き受けても、シューベルトは文句を言えなかった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中の「さすらい人」一曲だけでも、出版屋は一八二二年から四十年間に二万七千フロリンを儲けている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "畢生の大傑作「冬の旅」二十四曲は、一曲わずかに一フロリンずつで買われた。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺されたガラクタ――古靴や古寝台や古ズボンは六十三フロリンで評価された。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
