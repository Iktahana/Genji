        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ギリシャのファランクスは前者に便にして、ローマのレギヨンは後者に便なり。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギリシャ人は強大な大集団を作りこれをファランクスと名付けた。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "又例えばフーリエ F. M. C. Fourier（1772-1837）のコンミュニスト的ファランジュ phalange の試みは、幼稚園の起原の一つに数えられている等々。",
              "citation": {
                "source": "辞典",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "（１）ファランステールとは、フーリエーの考案になる社會的宮殿の名稱。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　黄色い家で「アルルの女」第二組曲４の「ファランドール舞曲」。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央の床の上で、十七、八の女ラシェルが、すぐ裏にあるレストランから聞えて来る「ファランドール舞曲」の笛の音に合せて、手振り足振りスカートをなびかせて、自己流に踊っている。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけがわからない、わからなくなった、わ、わ、わ――（言葉の間から裏のレストランからのファランドールの笛が曲の途中から鳴りはじめる）ラシ　あら、また、裏で笛を吹きはじめた。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランラ、ラー、ラー、（ファランドールに合せて三つ四つ踊りの身ぶりをして靴を鳴らしてから、戸を押してサッと出て行く）取り残されたゴーガンとヴィンセント。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……鳴りつづけるファランドール。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファランドールに聞き入っているだけ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファランドールやむ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハミングの波の上に、チラホラと極く低く、少し調子の歪んだ、そして時々とぎれながら「ファランドール舞曲」が浮びあがって来る。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ハミングは既にやんでおり、ファランドールもやむ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、それにダブッて、狂うように追って来る「ファランドール」）ヴィン　……（それらを聞きすまして、ジッとしていたが、不意にキョトキョトと周囲を見まわしてから）よし俺も行くぞ、ラシェル。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファランドルのように何度も繰り返し引きつづく律動をもって、蜿蜒とつづいてる険しい小山を、曲がりくねって降りてゆく列車。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルドー研究所の先駆者であり、楽観的に運動を進め、組織の出来ることをニューヨーク保険局において示したファランドの強い指導のもとにおける全国結核予防協会の活動は、この全世界の危機にあたって大きな貢献を行った。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジャーヴィス君、ファラントを一滴と、スライドの上につけるガラスをたのむ。",
              "citation": {
                "source": "オスカー・ブロズキー事件",
                "author": "THE CASE OF OSCAR BRODSKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジャーヴィス君、スライドの上にファラントを一滴たらしてくれ。",
              "citation": {
                "source": "オスカー・ブロズキー事件",
                "author": "THE CASE OF OSCAR BRODSKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファラン先生は長いこと東洋航路汽船の船医をしており、問題の名前はイスラム教徒か、少なくとも極東の現地人由来だというのです。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "喧嘩でファランがやられて、アーノットと医者が逃げたことを忘れているな。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと不安になったのはファランの連れが襲われた事件で、動機を聞いたことだ。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの夜の大騒ぎのあと、ファランから手に入れた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくファランが手に入れた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファランを二、三回見舞いに行ったら、とても石を家から持ち出したがっており、警察の急襲を怖れて私に託した。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろんファランには幾らか金をやらざるを得なかった。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの場でファランはキミらにとても怒っていたぞ。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日ファランを見舞ったら、やっとのことで黙らせた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしキミらが私の忠告を受け入れるなら、すぐ現場へ行って、ファランをなだめることだな」　バンストンが言った。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずファランを安全な場所に隔離しました。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファランの情報をすべて仕入れて、それを言ったらすぐ乗りました。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
