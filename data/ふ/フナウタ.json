        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "漁師たちは、網を引きながら景気づけに威勢のいい舟歌を歌った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "静かな入り江に、櫓を漕ぐ音と、どこからか聞こえてくる物悲しい舟歌が響いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は、世界中の港で船乗りたちが歌う舟歌を収集し、研究している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "頃くして席は遊藝を競ふところとなり、ポツジヨは得意の舟歌（バルカルオラ）を歌へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟歌畢りしとき、主婦は我に對ひて、君は歌ひ給はずやと問ひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「矢の倉まで行かう、風琴は持ち合さなかつたが、舟歌は一手に引きうけたぞ、ヘツヴ・ハウ、ヘツヴ・ハウ My heartful......sky wearing my solitary heart upon thy sleeve ……どんなもんだい。",
              "citation": {
                "source": "ダニューヴの花嫁",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして半ば呟くやうに秘かに感心しながら、「舟歌はやはり舟で歌はなければ――滑稽なものだな。",
              "citation": {
                "source": "円卓子での話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "末に「此外に数曲ありといへり、撫院の云、文中に東都の地名あれば東都御舟歌ならんと、定て然らん」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い源平の旗みたいなので、両方掛声をかけて舟歌を歌って分乗して朝もやのなかをいくと、そのうちに旭がさしてひらめいている旗しかみえない。",
              "citation": {
                "source": "美術学校時代の岡倉先生",
                "author": "板谷波山",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまは舟歌もない、千鳥の声もしない。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏鳴き、ふなうた遠く聞こゆ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか中国辺の船唄だったと思います。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "この信濃追分が北越の航路から蝦夷地へ流れ流れてゆくうちに、いつとなく波の響きや艪拍子の中で洗われ揉まれて、遂にはあの船唄としての追分の哀調になったのでしょう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "靜かに心を靜めて、この波のなす曲節を聞いて居ると、かの漁夫の集會の時に歌ふ「船唄」の調子を思ひ出さずには居られなかつた。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は水上の、燈あかるき船から船唄が聞えてきた。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "隨つて鹿島踊、鹿島の事つげ、船唄の類もまだ全國の諸所に殘つて居るかも知れないが、然し盆踊はつい近頃まではあんなに盛であつたのが、今は殆ど全廢してしまつた。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "船唄と鹿島歌との掛合の間に、「え、どつこい、どつこい」と云ふ refrain で金剛杖で船の板をうつ拍子が明かに聞えて來て、こなたの濱も色めき出した。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の船唄も明かになる。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "船唄及び鹿島踊の事に關しては予は何の知識をも持つて居ない。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母なるヴォルガ河、船唄で世界に知られているこの大河の航行は、実に心地のいい休養だ。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで三津浜出船の時などは、旧藩主が江戸へ出発する時、御曳船といって数多の小舟が印の旗を立てて御船唄というを歌いながら、沖まで漕ぎ連れて藩主の船を送ったものだが、その例を再び用いて、盛んに県令の出発を送ったので、岩村氏も頗る満足せられた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は入江を見※し、そうしながらひとりで口笛を吹いていたが、それから突然、その後もたびたび歌ったあの古い船唄を歌い出したのだった。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は頭がもたないほどのたくさんのラムを飲む晩もあったが、そういう時には、時としては、坐りこんで例のいやな古い奇怪な船唄を歌い、だれをも念頭に置かなかった。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "葬式の前の晩にも彼は相変らず酔っ払っていたが、その喪中の家で、例のいやな古い船唄を彼がのべつに歌っているのを聞くのは、たまらないことだった。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼子を吹いて号令する水夫長や、弁髪を垂れて船唄を歌う海員たちと一緒に、スクーナー船に乗って航海に出ようとしているのだ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "唄の方は、男性風な処は、却て鄙びて聞えましたが、念仏調子の外に、船唄から、木遣りの類の労働唄の心持ちが出て居ました上に、西洋の声楽もとり入れてある様に聞えましたのは、ひが耳でせうか。",
              "citation": {
                "source": "芝居に出た名残星月夜",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、「さあ、みんなで何か歌ひたまへ」四　田丸の声に応じるやうに、それらの娘たちのなかから、最初はか細く、が、次第に張りのある調子で、「ヴオルガの船唄」を歌ひだしたものがある。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕太郎が、シヤリヤピンを真似て、ヴオルガの船唄を口吟む声が聞える。",
              "citation": {
                "source": "頼母しき求縁（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "水面を渡る微風のまにまに、不敵な曲者が悠々として漕ぎ去りつつ唄う船唄が流れて来る。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "十の指は椅子の下、ぱたりぱたりと弾きますれば、かなし船唄ひたひたと、聞こえ来るよな思ひにて、さてこそ奴等の頭は、恋々として横に揺れ。",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐘の響き、司祭達の歌聲、居酒屋の内には荒々しい單調な唄、水夫等を搖り眠らす古い船唄、海からか、また時の深い夜の底からか、どことも知れず、やつて來る昔ながらの哀哭の節々、水夫等の群は、まろびつこけつする癖のあるためか、また醉が初まつたためでもあらう。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞黒な土人に小舟を漕がせて亡國の船唄を聞き、水中から頭だけを出してゐる神祠の屋根に登るのは、珍らしい見物であつたが、「ダム」の長堤を走つては、此の世界有數の大工事に驚嘆する外はなかつた。",
              "citation": {
                "source": "埃及雜記",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「船唄（作品六〇）」は幽遠な海洋の幻想である。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
