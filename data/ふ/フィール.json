        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "英国人で五十歳ぐらいの背の高い肥ったそしてあまり品のよくないブラムフィールド君が独唱をやると、その歌はだれでも知っているのだと見えて聴衆がみんないっしょに歌い出してせっかくの独唱はさんざんに押しつぶされてしまった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラムフィールドという名前がこの人とこの小事件とになんとなく調和していると思った。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくジミー・デュラントを聞いていると頭が痛くなるだけでちっともおかしくないが、あまりしゃべらないフィールズやローレル、ハーディのほうは楽しめる。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年の悪戦苦闘ののち、一九八一（昭和五十六）年十月にオフィスコンピューター用のアプリケーション開発を担当するフィールドサポート部に配置替えになったとき、早水にはパーソナルコンピューターに対する潜在的な恐怖がしみついていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九八一（昭和五十六）年十月にフィールドサポート部に移って間もなく、早水は小型システム事業部長代理の浜田俊三から「裏の仕事」を仰せつかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィールドサポート部にとって、プログラムを買うことは日常の業務だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがフィールドサポート部に籍を置く早水には、いかにもオフィスコンピューター用のプログラム開発を打診するかのようにして彼らを訪ねることができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも「フィールド・オブ・ドリームズ」なんて映画を見たせいだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ず、オレが何でここまで「フィールド・オブ・ドリームズ」にはまりこんだかからかたづけよう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フィールド・オブ・ドリームズ」のテーマを二十五字以内で述べよと言われたら、どう答えよう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の父はチェスタフィールドで学校長をしていて、そこで僕もすぐれた教育を受けました。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "サリィの方はペッカム、メイフィールド・プレイス三の下宿におります。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ときイギリスのシェフィールドといふ町の警察へ、一人の泥棒未遂の犯人があげられました。",
              "citation": {
                "source": "勇士ウ※ルター（実話）",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈抱きしめたい〉〈プリーズ・プリーズ・ミー〉〈アイ・フィール・ファイン〉〈フロム・ミー・トゥ・ユー〉……。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だから、いってみな」「じゃあ、〈アイ・フィール・ファイン〉は？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま、四階は〈アイ・フィール・ファイン〉、慶一と柾生は〈キープ・オン・ラニング〉、二階は〈スループ・ジョン・Ｂ〉をやっている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきからずっと、この〈ストロベリー・フィールズ・フォーエヴァー〉を、くりかえし、くりかえし、かけている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈ストロベリー・フィールズ〉は、もういちどフェイドインしたら終わる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ブラックスフィールド」？",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）早い話が、俺にデイヴィッド・カパァフィールドが書けるか、どうか、考えて見た。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰色のチェスターフィールドを脱いで、一振り振って投げた時はいつもよりよほど重く感じた。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "倫敦亜細亜協会の「孔雀王呪経」初版、暹羅皇帝勅刊の「阿※曩胝経」、ブルームフィールドの「黒夜珠吠陀」をはじめ、シュラギントヴァイト、チルダース等の梵字密教経典の類。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "またミカウバーと住んでおったデヴィッド・カッパーフィールドのような感じもする。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "（もっとも写生文家のかいたものにもこれぞという傑作はまだないようである）オーステンの作物、ガスケルのクランフォードあるいは有名なるジッキンスのピクウィックまたはフィールジングのトムジョーンス及びセルヴァンテスのドン・キホテのごときは多少この態度を得たる作品である。",
              "citation": {
                "source": "写生文",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八六五年板、シーフィールドの『夢の文献および奇事』二巻附録夢占字典にいわく、女がバシリスクを産むと男が夢みればその男に不吉だが、女がかかる夢を見れば大吉で、その女富み栄え衆人に愛され為すところ成就せざるなしと。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、それじゃあ、なんでお前さんはスプリングフィールドの一件でここにぶちこまれたっていうんだ。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "所長さん、スプリングフィールドになんて行ったことないですって。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんせ、スプリングフィールドが強く言いやがるもんだから、知事だってもうすぐで思いとどまるとこだったんだ。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
