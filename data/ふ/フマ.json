    "definitions": [
      {
        "index": 1,
        "gloss": "permanence",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼らが築き上げた友情は、時を経ても変わることのない不磨のものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "この文学作品は、時代を超えて読み継がれる不磨の名作と言えるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "法隆寺の五重塔は、千数百年もの風雪に耐えた不磨の建築物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "二句実に不磨の金言なり。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「正統記」は実に明治維新の大原動力をなした千古不磨の著述である。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて、明治二十二年二月十一日、紀元の佳節を期して、わが万世不磨の大典は全国に発布されたのである。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "『千九百○六年……此年○月○日、Ｓ――村尋常高等小學校内の一教場に暴動起る』と後世の世界史が、よしや記さぬまでも、この一場の恐るべき光景は、自分並びに五十幾人のジャコビン黨の胸板には、恐らく「時」の破壞の激浪も消し難き永久不磨の金字で描かれるであらう。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『千九百○六年……此年○月○日、Ｓ――村尋常高等小学校内の一教場に暴動起る』と後世の世界史が、よしや記さぬまでも、この一場の恐るべき光景は、自分並びに五十幾人のジヤコビン党の胸板には、恐らく「時」の破壊の激浪も消し難き永久不磨の金字で描かれるであらう。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "問うに落ちずして語るに落ちるという千古不磨の格言のあらわれだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "横額の一つは「玉不磨則無光　為速水桃子女史　駿堂書」といふ類ひのもの。",
              "citation": {
                "source": "速水女塾",
                "author": "四幕と声のみの一場よりなる喜劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も公は政治家たるの識見と立法家たるの才智とを兼備するの資を以て、純然たる君主的立憲制の日本の國性に適合するを確信し、且つ之れを確立するに於て周到なる意匠と愼重なる考慮を凝らし、以て遂に千古不磨の大典を立案するを得たり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も公は政治家たるの識見と立法家たるの才智とを兼備するの資を以て、純然たる君主的立憲制の日本の国性に適合するを確信し、且つ之れを確立するに於て周到なる意匠と慎重なる考慮を凝らし、以て遂に千古不磨の大典を立案するを得たり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "滔々たる流俗に抗する万古不磨の穴の集合体であって、大に吾人の尊敬に値する凸凹と云って宜しい。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　　十、安天山夏雪（南米）林渓深処踞清陰、夏白安天一帯岑、対此千秋不磨雪、何人不起自彊心。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "大師在唐の間に於て一の秘密を傳受せられ、深く之れを心中に藏し、遂に日本國に於て千歳不磨の方法に於て、國民の腦底に印象せんことを計りたるものなるべし。",
              "citation": {
                "source": "弘法大師と景教との關係",
                "author": "イー、エー、ゴルドン",
                "note": "青空文庫"
              }
            },
            {
              "text": "二千年前の立法者の定めた所のものを不磨の経典として少しも疑うこと無く、これに違える新来の思想をばことごとく異端視するが如くんば、なんに由ってその国歩を進め新文明と対抗することが出来よう。",
              "citation": {
                "source": "婦人問題解決の急務",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "「不磨の大典」と称し、天皇のほかには、憲法の改正をおこない得ないことを、旧憲法が定めたのは、そのためである。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇はそれを「不磨の大典」と称して、変更をゆるさず、自分だけに変更の権利があるとして、人民をおさえつけた。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは云ふまでもなくセンチメンタルであることに他ならない。",
              "citation": {
                "source": "菊岡久利著「貧時交」",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔青びかる天弧のはてに〕宮沢賢治青びかる天弧のはてにきらゝかに町はうかびて六月のたつきのみちはいまやはた尽きはてにけりいさゝかの書籍とセロを思ふまゝ〔以下空白〕",
              "citation": {
                "source": "〔青びかる天弧のはてに〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は言ふまでもなく、目指す方ではない。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども竹山俳優監督係夫人といふことは、盲同然の人間の寄り集つてゐる所ではその人間の価値如何のどんなに大切な標準器になるかは言ふまでもない。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "惡しきものに逢ひけるよ、と思ふまもなく、つかつかと歩みよりて、なつかしげに物言はるるに、こはけれど遁れゆくべきにあらず。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に両人ともまだ琉球のことばを忘れて居ないで、たやすく思ふまゝに言ふことが出来て居たといふことは謝源をムシヤウに嬉しがらせた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなフウだつたからそれから一年もたゝぬ中に石垣島のもとの兵に首里が襲はれて易々と復讐されたのは言ふまでもないことである。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "物語を創作するといふまことに奇異なる術を體得してゐる男なのだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは言ふまでも無い事だが、それゆゑ、私は日本一の桃太郎を描寫する事は避け、また、他の諸人物の決して日本一ではない所以をもくどくどと述べて來たのだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌は作者に依て作られること云ふまでも無いが、作者の為めに作者を伝へんが為に作らるべきものでは無い。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩も以上のやうな歌は非常に面白く佳作であると思ふのであると云ふまでゞある。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "否、かゝる事は思ふまじ。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、私があの素ばらしい芸術に接して、どんなに驚異と嘆美の瞳をみはつたかと言ふことは、殊更らに言ふまでもないことであらう。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからもう少し先のところで、マルテとあるのは、あの有名な「手記」の主人公マルテ・ラウリッヅ・ブリッゲを指してゐることは言ふまでもない。",
              "citation": {
                "source": "或女友達への手紙",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "水野が私の中學時代からの友人である事は云ふまでもあるまい。",
              "citation": {
                "source": "疑惑",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
