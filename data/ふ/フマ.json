[
  {
    "uuid": "9bb8d41d-2bb6-5c05-a022-97661bac83c2",
    "entry": "不磨",
    "reading": {
      "primary": "ふま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
