          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "提出された議案は、さらに詳細な審議を行うために常任委員会へ付託された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "裁判所は、専門的な判断を仰ぐために鑑定を専門機関に付託した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "議長は、紛糾する議論を収拾させるべく、審査を小委員会に付託することを提案した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そうか、未来から付託された理想主義はそれほどに重いか。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その議事日程の中、委員付託による四つの問題の検討がされている。",
              "citation": {
                "source": "ペンクラブのパリ大会",
                "author": "――議題の抜粋についての感想――",
                "note": "青空文庫"
              }
            },
            {
              "text": "云わばこれらブローカーへの未組織的集団的圧迫が付託されている。",
              "citation": {
                "source": "「壇」の解体",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、今やこうした組織すらもが――困ったことには――その経済的機構を付託され得なくなって来た様である。",
              "citation": {
                "source": "「壇」の解体",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この集団的機能的組織性が利潤的企業性を逃れて、清新な委員付託的なる構造をもつことの出来る日は先ず遠い、寧ろ近いとも云えるが、待つが故にのみそれは遠い。",
              "citation": {
                "source": "「壇」の解体",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "機能性 Funktion の上より、あるいは、付託統体 Veiweisungsganzheit の立場より論ずるよりも、むしろ Sache としてのものそのものについて、委員会的にあるいは集団研究的に同人あるいは読者に一つの提案を提出するほかはない。",
              "citation": {
                "source": "リズムの構造",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこではボートにおけるように記録的報告と、それについでなされる企画的実験、それらのものが数学的機能的目算と、存在論的付託的目標によって繰り返さるるのである。",
              "citation": {
                "source": "リズムの構造",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがはかりしれないのは、人間の無知、すなわち機能的凾数の計算の不正確と、付託的目標の見透しの不明のゆえである。",
              "citation": {
                "source": "リズムの構造",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この見かたは実に、人間が付託したところの物質の見かたである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学者は、社会全体からの暗黙の付託によって生まれ、それへの責任をせおって立っているものです。",
              "citation": {
                "source": "抵抗のよりどころ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "命をうけて以来、夙夜憂歎し、付託の効あらずして、以て先帝の明を傷つけんことを恐る。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもさういふたくらみをなして彼等が利得する量といふのは一體何程であらう。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　役所風に堂々とはしているけれども無味乾燥なウンテル・デン・リンデンの大通りへでたところで、伸子たちはその大通りのつき当りにそびえている元宮殿の美術館の方へ、川瀬たちは地下鉄の方へとふたくみにわかれた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小林団長のひきいる八人の少年探偵団は、四人ずつ、ふたくみにわかれて、園井家のへいのまわりを巡回していました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけ玉　そこで、小林団長は二十人の団員を十人ずつふたくみにわけ、ひとくみの十人には、八幡神社の森の中を見はらせることにしました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "のこる十人を、また五人ずつ、ふたくみにわけました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホルム氏自身北京に出掛け、總税務司のハート（Robert Hart 赫徳）氏に談判して、差押へを解除して貰ひ、漢口から上海へ、上海から米國に送り、千九百八年（明治四十一）六月から、この模造碑はニューヨークの藝術博物館（Metropolitan Museum of Art）に附託品として陳列された。",
              "citation": {
                "source": "大秦景教流行中國碑に就いて",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "この模造碑がニューヨークの博物館に附託されて居る時から、ホルム氏は、その同大の石膏模型を、各國の大學や博物館へ、希望に應じて｛實費で？",
              "citation": {
                "source": "大秦景教流行中國碑に就いて",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "お銀様は今も、持てる金のすべては兵馬に附託して、これで旅の用意の万事をととのえるように、そうして乗物も二人分、通しを頼んでもらいたいということをいいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "附託されたかなりの大金は、いやでも自分が保管するのが義務のようになっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "（『思想』一九二九年四月号）スポーツ気分の構造一　人間が自らを動物より区別するにあたって、道具をもったこと、又その道具の附託するものを指ししめす言葉をもったこと、そしてその道具の使用にあたって計画性と労働をもったことが指摘される。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る考え方では生産的技術の一つの準備として、その生産的附託性より遊離して、技術の抽象化をもつと言う。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイデッガーが空間性の概念を道具のもつ附託性の構造の中に見出し、その存在性格を範疇的意味と実存疇的意味に分類したところの仕方は、今私達の解釈に対してよき出発線を描いて呉れる。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、スポーツに於いて浮上り来るものは、その共同に顧慮する道具の附託性よりも、寧ろその相互の共同性そのものなのである。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "又この共同存在の気分的開示こそスポーツのもつ特異なる存在性格であると共に、道具の附託が漸く機械的構成に深入りするにしたがって、それに適応する現存在は共同相互存在としての性格を漸次判然と示すに至る。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに　王弟オットー殿下も亦、久しきにわたって病褥にあり、摂政の任務に適せざるをもって、バイエルン憲法は執政の全権を予に附託せしめた。",
              "citation": {
                "source": "泡沫の記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "王はこの申出でを委員会に附託したが、委員たちはコロンブスを夢想家として斥け、王も彼を熱狂的なお喋舌と見たらしい。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち議院法中改正法律案を日程にのぼして委員附託にしておくべしというのであった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家は自分を附託した人物を描いてその人物にいろいろのことを語らせるのだが、しかし、それはおほむね彼の勝手な想像である。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
