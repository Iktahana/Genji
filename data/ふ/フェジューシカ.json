        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カシタンカは、ルカー・アレクサンドルィチや、せがれのフェジューシカや、仕事台の下のいごこちのよい場所を思いだしたのだ。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……長い冬の夜、さしもの師がかんなをかけたり、声をたてて新聞を読んだりしているとき、よくフェジューシカが、自分をあいてにふざけたことが思いだされた。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……フェジューシカは、たびたびカシタンカのあと足をつかんで、仕事台の下から引きずりだし、目がまわって、体じゅうの関節がずきずきいたむほど、いろいろないたずらをした。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……とりわけ、苦しくてやりきれなかったのは――フェジューシカが糸のはしに肉の切れっぱしを結びつけて、カシタンカに食べさせ、カシタンカが十分のみこんだのを見ると、大声で笑いながら、胃の中から引っぱりだすことだった。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェジューシカがのみを片手に、このむく犬を追っかけて行く。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、こんどはとつぜん、フェジューシカがふさふさした毛におおわれて、楽しそうにほえながら、カシタンカのそばにあらわれた。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "カシタンカとフェジューシカは、なかよく鼻をかぎあってから、通りを走って行った。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェジューシカ、ありゃ、――ちぇっ、しょうのねえやろうめ、――カシタンカだぜ！",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ルカー・アレクサンドルィチと並んで、せがれのフェジューシカが父親の帽子をかぶって歩いていた。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
