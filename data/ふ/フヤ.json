[
  {
    "uuid": "0281300a-35d7-558a-9c2f-ac7aea668586",
    "entry": "麩屋",
    "reading": {
      "primary": "ふや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
