        "examples": {
          "standard": [
            {
              "text": "大学でフィジオロジー（生理学）を専攻し、人体の仕組みを学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は大学院で運動のフィジオロジーを専攻し、筋肉の疲労回復メカニズムを研究している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "宇宙空間での長期滞在が人体に与える影響について、フィジオロジーの観点から詳細なデータ検証が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "近頃読んだ本でありませんがマンテガッツァの『フィジオロジー・エンド・エキスプレション』という本の中にイミテーションということについて例を沢山挙げてありましたが、私は今｜一々人間という者は真似をするものであるということの沢山な例を記憶しておりませんが、茲処に二つ三つあります。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリティクス、タイラニー、デモクラシー、アナーキズム、フィロソフィー、フィジオロジー、ジオロジー、ヒストリー、はすべてギリシャの言葉である。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
