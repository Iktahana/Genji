          "literary": [
            {
              "text": "フウルというものだ。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンプランの遠望は、リヨン市のフウルヴイエルの丘の上から、遙かに遠く、まつたくかすかな物影の如く眺めるのでは、物たらない。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "保吉はたちまち机に向うと、インク壺へペンを突こむが早いか、試験用紙のフウルス・カップへ一気に弔辞を書きはじめた。",
              "citation": {
                "source": "文章",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "十九世紀中葉の古典学者にして珍本蒐集家でもあつたエドゥワアル・フウルニエが著はした『史的文学的雑録』（一八五五年）といふ書物がある。",
              "citation": {
                "source": "書狼書豚",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
