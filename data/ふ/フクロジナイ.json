          "literary": [
            {
              "text": "武者窓からさしている日の光に、袋竹刀の片側が光って、半面が薄黒くぼけている。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八十前後の老人が三人ほどイソイソと袋竹刀や木刀を振って道場に立つ。",
              "citation": {
                "source": "馬庭念流のこと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の物とはまるで違う昔のままの面小手をつけ袋竹刀で試合する。",
              "citation": {
                "source": "馬庭念流のこと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "素面素小手に袋竹刀でやるがよい」「へい。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "両名素面素小手、袋竹刀を握って立合うことになった。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は二人きりでこの曲輪の草地へ出て来て、袋竹刀で烈しく打合った。",
              "citation": {
                "source": "松風の門",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小次郎は避けきれずとみたか、遽に構えをたて直して向って来たが、そのとき彼の袋竹刀の尖が強たかに宗利の右の眼を突いた。",
              "citation": {
                "source": "松風の門",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
