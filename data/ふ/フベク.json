          "literary": [
            {
              "text": "彼ハ再建ヲ云フベク我ハ改造ニ進ムベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ小地主ト小作人ノ存在スルコトハ神意トモ云フベク、且ツ社會ノ存立及發達ノ爲メニ必然的ニ經由シツツアル過程ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹田本位ノ心身ヲ鍛冶シ十年間一貫ノ常識教育ヲ施サバ以テ海兵ニ用フベク以テ陸兵ニ用フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "無月謝ヨリ生ズル負擔ハ各市町村此レヲ負フベク、教科書ハ國庫ノ經費ヲ以テ全國ノ學校ニ配布スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ對外行動ハ取ルベカラザル者ヨリ寸土ヲ得ザルト共ニ、天日照覽ノ下苟モ奪フベクンバ全地球ヲモ大ナリトセザルベキ大丈夫ノ健脚ニ立ツベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "仍リテ両者ハ根本的ニ構造ヲ異ニスルモノト謂フベク、従テ本願ハ、援用立像ヲ以テ拒絶セラルル理由ヲ発見シ得ザルモノナリ。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬ヘバ漢ノ文帝ノ如キハ、識ニ長ズルノ人主ト謂フベク、宋ノ徽宗ノ如キハ、才ニ饒カナレドモ、識ハ短ナルガ如シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
