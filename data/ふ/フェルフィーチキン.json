        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「いったい諸君は」ご主人の将軍が持っている勲章を自慢する、厚かましい下男のような態度で、フェルフィーチキンが熱くなってえらそうに口を入れた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とフェルフィーチキンがぞんざいな調子で口を入れた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とフェルフィーチキンが、わたしのほうを顎でしゃくりながら、小さな声でいいかけたが、急にぴったり言葉を止めた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それほど来たいなら、来させるがいいさ」「だって、これは、ぼくら親友だけの、内輪の集まりじゃないか」やはり帽子に手をかけながら、フェルフィーチキンは憎々しげにいった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルフィーチキンは帰りしなに、てんでわたしに挨拶しなかった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、あの虫けら同然のフェルフィーチキンが、ズヴェルコフのお気に入ろうと思って、さぞ厚かましいいやらしい声で当てつけがましく、ひひひひと笑うことだろう。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の後から、まるで小犬のように響きの高い下劣な声で、フェルフィーチキンの畜生がきゃっきゃっと笑いだした。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」わたしはますますいら立ってゆきながら、フェルフィーチキンにどなりつけた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「もしぼくがそんな目にあわされたら」フェルフィーチキンが口を入れた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルフィーチキンは彼とならんで、トルドリューボフの隣りに陣取った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルフィーチキンはぷっと噴きだした。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とフェルフィーチキンが厚かましい調子でいい足した。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そう人をまごつかすのはたくさんだよ」フェルフィーチキンは、ひひひと笑いながら、こう叫んだ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムシュウ・フェルフィーチキン」「なあーんだって！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "きみはまるで……」フェルフィーチキンは茹で蟹のように真っ赤になり、喰いつきそうな目つきでわたしを睨めながら、くってかかった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルフィーチキンは変な黄いろい声さえ立てた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、おれはフェルフィーチキンにあんまり勝手な口を叩かせ過ぎた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フェルフィーチキンがわめいた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう承知ならん、あんなことをいうやつは、びんたを喰らわしてやるのが当たり前だ」とフェルフィーチキンは金切り声を立てた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「諸君の好意は感謝するが、しかしぼくはね、どれだけあの男の言葉を尊重しているか、自分で立派に証明して見せるから」「フェルフィーチキン君、きみはいまいった言葉に対して、さっそくあすにも、ぼくの満足するような処置をとってもらわなくちゃ！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」わたしはものものしくフェルフィーチキンのほうへ振り向いて、声だかにこういった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルフィーチキンもそれに倣った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フェルフィーチキン、きみにも謝るよ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フェルフィーチキンは毒々しい調子で、歯の間から押しだすようにこう言った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、ぼくは決闘を恐れているんじゃないよ、フェルフィーチキン！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルフィーチキンは横のほうからしがみついて、きっと髪の毛をつかむだろう。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきフェルフィーチキンが、お役所という代わりにおやくじょといったっけ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
