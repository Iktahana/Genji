  {
    "uuid": "4e98d114-2820-565b-91fa-c417a9f82054",
    "entry": "風寒",
    "reading": {
      "primary": "ふうかん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今宵、風寒く、身の置きどころなし。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "水は漫々として藍を湛へ、まばゆき日のかげも此処の森にはささで、水面をわたる風寒く、颯々として声あり。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜はいよいよ更けて、風寒きに、怪者の再来を慮りて、諸君は一夜を待明かさむ。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼光鋭く、意気激しく、いづれも拳に力を籠めつつ、知らず知らず肱を張りて、強ひて沈静を装ひたる、一室にこの人数を容れて、燈火の光｜冷かに、殺気を籠めて風寒く、満州の天地｜初夜過ぎたり。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "晦冥陰慘、雲冷たく、風寒く、征衣纔に黒くして髮忽ち白し。",
              "citation": {
                "source": "花間文字",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "水は漫々として藍を湛え、まばゆき日のかげもここの森にはささで、水面をわたる風寒く、颯々として声あり。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼光鋭く、意気激しく、いずれも拳に力を籠めつつ、知らず知らず肱を張りて、強いて沈静を装いたる、一室にこの人数を容れて、燈火の光｜冷かに、殺気を籠めて風寒く、満洲の天地初夜過ぎたり。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そぞろありき風寒き師走月、それの港をわれひとり、夕暮のそぞろありきす。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "向つべの山は明れど、こなたなる高山の岨、風寒く木の葉ちるのみ。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "下りになりてより霧深く、背後より吹く風寒く、忽夏を忘れぬ。",
              "citation": {
                "source": "みちの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "□夜、戸の外に西風寒く吹く。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩に及びて、雨ふり、風寒し。",
              "citation": {
                "source": "國府臺",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "空晴れて、月明かなるが、向ひ風寒く且つ鋭くして、面痛く、體を進むるに勞多し。",
              "citation": {
                "source": "川越夜行記",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "路は惡るし、風寒し。",
              "citation": {
                "source": "春の郊外",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "空くもりて、風寒き冬の朝なり。",
              "citation": {
                "source": "房州紀行",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "連日の雨は霽れたれど、空はくもりて、風寒き春の朝なり。",
              "citation": {
                "source": "春の筑波山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "風寒ければ、汽車の窓は開かず。",
              "citation": {
                "source": "親馬鹿の旅",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "日は赤々と照りたれど朝の風寒し。",
              "citation": {
                "source": "赤城山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして、風寒くして、路伴なきに於てをや。",
              "citation": {
                "source": "赤城山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて或人にかく申候処、その人が「川風寒み千鳥鳴くなり」の歌は如何にやと申され閉口致候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て或る人に斯く申し候処其人が「川風寒く千鳥鳴くなり」の歌は如何にやと申され閉口致候。",
              "citation": {
                "source": "再び歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て或る人に斯く申し候處其人が「川風寒く千鳥鳴くなり」の歌は如何にやと申され閉口致候。",
              "citation": {
                "source": "歌よみに與ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつてある人にかく申し候ところその人が「川風寒く千鳥鳴くなり」の歌はいかがにやと申され閉口｜致候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠く来つ友もはるけく出でて来て此処に相逢ひぬ笑みて言なく無事なりき我にも事の無かりきと相逢ひて言ふその喜びを酒のみの我等がいのち露霜の消やすきものを逢はでをられぬ湖べりの宿屋の二階寒けれや見るみずうみの寒きごとくに隙間洩る木枯の風寒くして酒の匂ひぞ部屋に揺れたつ　十一月二日。",
              "citation": {
                "source": "木枯紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは山の上には風寒く北向きにて日あたり悪しくまたあまりに寂寞なるためでした。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "山里は風寒く梅の盛に万歳来らん。",
              "citation": {
                "source": "芭蕉雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "名も懷しき梅津の里を過ぎ、大堰川の邊を沿ひ行けば、河風寒く身に染みて、月影さへもわびしげなり。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二十二　或日、天長閑に晴れ渡り、衣を返す風寒からず、秋蝉の翼暖む小春の空に、瀧口そゞろに心浮かれ、常には行かぬ桂、鳥羽わたり巡錫して、嵯峨とは都を隔てて南北、深草の邊に來にける。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
