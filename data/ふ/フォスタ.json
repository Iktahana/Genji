        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼女のは、そんなむづかしいオペラなんぞではなく、大抵フォスターの甘い曲ばかりである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女のは、そんなむずかしいオペラなんぞではなく、大抵フォスターの甘い曲ばかりである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場所をうずめているのはフォスターなどの古典歌謡である。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "哈利発オマルの派遣したアムル・イブン・エル・アジという猛将が攻め込んで来て、バビロンの城砦を陥れ、エル・フスタト（フォスタト）と呼ばれる都市を作った。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミス・アーノルド・フォスター氏の一家は、当地にて一、二に数えらるる富豪にして、すこぶる有力有望をもって聞こゆ。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョン・フォスター、アン・ダン、クライク未亡人のすべては上の患者たちと一緒になっていて、予告的に具合が悪くなったが、しかし抑えられた。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャールズ・Ｅ・ウイルスン、ジョージ・ハンフリー、シンクレア・ウイークス、ジョン・フォスター・ダレスなどが入閣し、アイクの組閣は「一〇人の億万長者とひとりの配管工」と呼ばれた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一〇人の億万長者とは、ジェネラル・モーターズのチャールズ・Ｅ・ウイルスンや企業弁護士のジョン・フォスター・ダレスなどのことで、ひとりの配管工とは、配管工ユニオンのリーダー層からえらばれた労働相のことだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "補遺フォスター（Stephen Collins Foster 1826―1864）「故郷の人々」「懐かしきケンタッキーの家」や「黒ん坊のジョー爺や」の歌がアメリカばかりでなく、世界の国々に愛唱されていることは言うまでもない。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "このフォスターの愛すべき歌は夥しくレコードされているが、まとまったものではビクターに「フォスター名曲集」と「フォスター民謡集」が入っている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この後のアメリカに、サン＝サーンスやエルガーに匹敵するあるいはそれ以上の作曲者はたくさん出て来るだろうが、フォスターのような母なる大地にしかと足を踏みしめた、民族的な音楽家はそうザラに生まれては来ないだろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、いや、間違いじゃないぜ」「でもフォスタ、あり得ないぞ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "カールトンホテルで食事する予定だから、すっぽかせん」　フォスタがにやり。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "下手人はコプリとフォスタの野郎だ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォスタの呼び出しには乗るもんか、おあいにく様だ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間にコプリと仲間のフォスタが町から帰ってきた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食前に書斎へ行くと、フォスタが待っていた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手紙は来てないか」　フォスタが答えた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "万事休すだぜ」「フォスタ、手前のことを考えろ」「え、俺がどうだって？",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォスタは多少引き下がっていた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食後、ビリヤード室へ移動し、気がつけば、フィールデンはジョージ卿とフォスタの三人でゲームにはまり、その間、メイ嬢とコプリは見学していた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォスタがけさ何か掴んだかな」　フォスタはすぐやってきた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "「会いたかったぞ、フォスタ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら最後の瞬間に入れ替えたようで、誰も知らねえ、もしおいらが、けさ小耳に挟まんけりゃ」　コプリとフォスタが見合った。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "小僧がコプリに買収されていることは知らないし、ましてやあの早朝の併せ馬をコプリとフォスタが見ていたことも知るまい。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、そうだろうが、なかろうが、ラッフル爺はコプリとフォスタをはめた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "知りたいな」　フォスタがいらついて尋ねた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
