        "examples": {
          "standard": [
            {
              "text": "彼女は二藍の着物をさらりと着こなし、お茶会に現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "平安時代の若き貴族は、若々しさを表す二藍の色を好んで身につけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "夕暮れの空が、徐々に美しい二藍に染まっていくのを眺めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "非参議級とかまだそれにならない若い人などに二藍というものは似合うものだよ。",
              "citation": {
                "source": "源氏物語",
                "author": "藤のうら葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の飯がすんで、後は寝るばかりだといふたあいなさでもないが、私は結局寝床に入いつて、夜中に二度目をさまして二度目に眠れないで煙草をのんでゐたりするのだ。",
              "citation": {
                "source": "障子のある家",
                "author": "尾形亀之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
