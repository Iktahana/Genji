[
  {
    "uuid": "9b0d9178-8ca5-5c26-8f3e-de6a450ac39f",
    "entry": "脹脛",
    "reading": {
      "primary": "ふくらはぎ",
      "alternatives": [
        "ふくろはぎ"
      ],
      "is_heteronym": false
    },
    "grammar": {
