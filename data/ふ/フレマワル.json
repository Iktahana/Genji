    "entry": "触れ回る",
    "reading": {
      "primary": "ふれまわる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
