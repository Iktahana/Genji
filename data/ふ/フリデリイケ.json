        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なにしろ総領のフリデリイケが、フリイデマン氏より十七も年上だったのである。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリデリイケとその妹ヘンリエッテは、少しひょろ長すぎるし、末のプィッフィのほうは、あまり小柄でふとりすぎていた。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ともかく、」とフリデリイケがいった。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とフリデリイケが問うた。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "七時半が鳴った時、フリデリイケが入って来て、円卓の上にコオヒイを置いた。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ、フリデリイケ、お気の毒だけど、姉さんたちだけでお客に行ってもらわなくてはならないんですよ。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、まあ、お願いだから……」　フリデリイケは答えた。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そしてフリデリイケは去った。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
