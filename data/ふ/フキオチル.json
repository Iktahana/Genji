          "literary": [
            {
              "text": "吹き落ちる気配も見えないあらしは、果てもなく海上を吹きまくる。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西風は川に吹き落ちる時西岸の篠をざわ／＼と撼がす。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "立春の日を過ぎてから、却て黄昏の果敢ない薄い光の空に吹き落ちる筈の西風が何を憤つてか吹いて／＼吹き捲つて、夜に渡つても幾日か止まぬ程な稀有な現象に伴うて、鬼怒川の淺瀬が氷に閉されて、軈て氷の塊が流れたといふ噂が立つたことがあつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹き落ちるような星、秋の声。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
