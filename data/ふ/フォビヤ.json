          "literary": [
            {
              "text": "こういう患者が公式フォビヤとなるのは、臨床的に研究済みのようなものであろう。",
              "citation": {
                "source": "ひと吾を公式主義者と呼ぶ",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ、その相手の、先に一人で自殺したと言う娘さんの方に一種のパラノイヤのような――つまりセックス・フォビヤがあったのではないかな。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "セックスに対する恐迫観念が固定してフォビヤになるには、それだけでも充分だ。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォビヤが彼女をなぎ倒した。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "死んだ恋人をフォビヤに追いこんだ実体、その父と母が前に立ちふさがっている。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
