        "examples": {
          "standard": [
            {
              "text": "彼は懐銭をはたいて、子供におもちゃを買ってやった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅の途中で懐銭が尽きてしまい、困った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「お小遣い、いくら懐銭として持ってるの？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "江戸ッ児はその刹那の清々しさを買うに、決して懐銭を読む悠長をもたぬのである。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は原料の藁を勘次に要求せずに五｜錢か十｜錢位づゝ懷錢を出して能く選つた藁を其處此處で買つて、穗先の處を持ては肩から打つ掛けてがさ／＼と背負つて來るのである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "軈て老人等が互の懷錢を出し合うた二｜升樽が運ばれて酒が又沸された。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
