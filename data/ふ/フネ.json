        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――ナストウリ、モノサシトハサミ、カガミガアリマス、イケニフネ……」大急ぎでそれだけ読んだが、そこで息が切れた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "また十何年か前のフネノフネ時代にかえったんでは意味が無い。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "フネガデルデルカラフトヘ　小樽を出る時、私は小田原の妻子へ、こう打電したものだ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼサンヤンドクレパパノオフネアブナイヨ　汽車が停った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "天神これを見て「なべて世の愚者が衆愚を導びかば、井戸の月救う猴のごと滅ぶ」コラサイと唄うたと出づ（英訳シーフネル『西蔵譚』三五三頁）。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "老姉｜謀ってその身に芥子と胡麻の油を塗って死骸に似せ（シェッフネルの『西蔵諸譚』にこうある。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アポロ」「ダフネ」「デダルス」「イカルス」、その他多くの制作がある。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "宛名、神奈川県小田原町新玉町二丁目牧野英雄――尋常二年生、長男）　ヤクソクノ汽船ガ見ツカラヌノデ、フネノダケオクル。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オモチヤノ　オフネハツンツンツン。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日も、浮舟楼の前の、クロフネ第三楼の息子が出征だとかで、ぎらぎらした絹地の祝出征ののぼりが軍艦型に装飾した家の前へ林立してゐたし、花輪型の円い藁を芯に、沢山の日の丸の小旗が、強い十二月の風に激しくはためいてゐた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イワハ十三ニチフネデトウキョウニカエッテクルゾ。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フネデトウキョウヘカエッテクルゾ……東京へ帰るというからには、芝浦へ着くのか、それとも横浜に着いて東京へ入るのか」　課長は大いに迷った。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしようか」「フネをかえしてやったのに、なんだかおだやかでないことをやるじゃないか」「ロロー殿下に相談してみよう。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚、海野ニセ武官の冥福を、読者諸君と共に祈り上げる次第であります）（×月×日、モンテヴィデオ、先払電報）　マタ、フネハシズンダ。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりによく似ているので、人々は、ゼフネルが、多分ひそかにバッハの肖像画を見て、それを参考にして作ったのだろうと噂したくらいです。",
              "citation": {
                "source": "頭蓋骨の秘密",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔡家溝駅長オグネフ、同駅駐在中隊長オルダコフ大尉、同隊付セミン軍曹、チチハル・ホテル主人ヤアフネンコ、露国蔵相ココフツォフ、随行員、東清鉄道関係者、露支顕官、各国新聞記者団、写真班、ボウイ、日本人警部、日露支出迎人、露支両国儀仗兵、軍楽隊、露国憲兵、駅員。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "安重根、禹徳淳、劉東夏、蔡家溝駅長オグネフ、同駅駐在中隊長オルダコフ大尉、同隊付セミン軍曹、チチハル・ホテル主人ヤアフネンコ、支那人ボウイ、兵卒、ロシア人の売春婦三人、相手の男達。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドアが細く開いてホテルの主人ヤアフネンコの禿頭が現れる。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "女一　あら、ヤアフネンコのお父つぁん、もう大丈夫？",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤアフネンコ　やれやれ、一組挙げて帰ったらしいよ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤアフネンコ　（ドアから顔だけ入れて）お騒がせしましたな。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "劉東夏があわてて寝台に掛けてあった外套を持って来て渡す時、扉がいっぱいにひらいて、警備中隊長オルダコフ大尉が、兵卒四五名と何食わぬ顔のヤアフネンコ、支那人ボウイを随えて厳然と立っている。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尉　（ヤアフネンコへ）飴屋というのはこいつらか。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェルフネウジンスク――一度で言えたら豪い。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェルフネウジンスクでぞろぞろ降りて行く。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとにオフネだ、オフネだ！",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い立派なオフネが一そう真下の水に泳いでいる。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
