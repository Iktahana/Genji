        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "コンクリートミキサー車の船に、セメントが投入される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "豆腐屋は、大きな船に水を張って豆腐を冷やしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "左官は船の中で漆喰を丁寧に練り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": []
        }
      },
      {
