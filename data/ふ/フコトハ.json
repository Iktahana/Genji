          "literary": [
            {
              "text": "モウ誰モ俺ニ構フコトハ出来ナイゾ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大資本ガ社會的生産ノ蓄積ナリト云フコトハ社會主義ノ原理ニシテ明白ナルコト説明ヲ要セズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ王朝貴族ニ朝鮮人ノ血液ガ多量ナリト云フコトハ、實ニ其ノ貴族ノ血液ガ皇室ニ入リ得ベキ特權階級タリシ點ニ於テ、日本ノ元首其者ガ朝鮮人ト沒交渉ニ非ズト云フコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツアール」ガ侵略シ來レルト「レニン」ガ幾多ノ謬妄ヲ附帶セル社會革命説ヲ奉ジテ殺到シ來ルベキト、日本ガ國防上朝鮮ニ據リテ戰フコトハ國家ノ國際的權利ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國防上朝鮮ヲ獨立セシメズト云フコトハ、英人ガ印度ヲ獨立セシメズ又亞佛利加植民地ヲ獨立セシメズト云フコトトハ全ク別事ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
