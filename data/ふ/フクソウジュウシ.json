        "examples": {
          "standard": [
            {
              "text": "副操縦士は、機長と共に安全な飛行を支える重要な役割を担っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "機長が急病で倒れたため、副操縦士が冷静に緊急着陸の操作を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は国内線の副操縦士として三年間の経験を積み、まもなく機長への昇格試験を受ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それに、どこへいっても腰の落ちつかぬ男で、先ごろまで、エジプトのミスル航空会社で副操縦士をしていたが、そこでも、喧嘩をしたらしくモザンビイクに帰ってきたのである。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "サングラスをかけたパイロットが、かたわらの副操縦士に、笑いながらなにか言っていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
