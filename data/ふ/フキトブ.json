    "definitions": [
      {
        "index": 1,
        "gloss": "to be blown off",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "強風で帽子が吹き飛んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "勢いよく開いたドアに、テーブルの上の書類が吹き飛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の突然の言葉に、彼女の希望は跡形もなく吹き飛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "二階の窓から狂風に吹き飛ぶ雲を眺めながら考えるともなく二十年前に見たベルリンのメトロポール座のレビューを想い出していた。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "高貴性も何も、一ぺんに吹き飛ぶ。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根｜瓦が吹き飛ぶので、街に出られなかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に凄じい風が吹き附けて唸りを上げ、どーんと勝手口の扉が吹き飛ぶような音が無気味に響いた。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根の煙抜きの吹き飛ぶ家。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうしたうららかな日は、ヒルテルフィンゲンに着いて十日あまりもつづいたろう、西の風が急に吹き初めて、湖水の波は、泡立つばかり渦まいて来た日の暮れから、板屋の軒は吹き飛ぶばかり暴れに暴れて、暁方かけて雨となった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルシカ島に『ナポレオン』あり※　汝のごとき張子の牛は、ナポレオンの鼻息で吹き飛ぶであろう！",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（窓を閉めて寝たのだから、風で吹き飛ぶはずもないが……）　夜卓の下を覗いてみた。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "口火を点けさえすればいい、お前の身体は金庫の扉と一緒に、微塵になって吹き飛ぶのだ、いいか」　荒縄で縛られた半裸体の女の肉は、冷たい金庫に凍て付いて寒天のように慄えました。",
              "citation": {
                "source": "青い眼鏡",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……どうしていけないのよ」　声が風に吹き飛ぶ。",
              "citation": {
                "source": "一人ぼっちのプレゼント",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わしは本当に新聞記者を見直したぞ」　天井板が吹き飛ぶかとばかり、豪快に笑った風貌を、あの時代の軍人の、一つのタイプとして、印象が深い。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "助かろうなどとは考えるなよ」「では、では、どうしても」「あたりまえだ」「お慈悲ですッ」　しがみついて泣き吠える又八を、沢庵は立ち上がりざま蹴放して、「ばかっ」　と小屋の屋根も吹き飛ぶような大喝を吐いて睨めつけた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉を殺した記憶もふっ飛ぶ。",
              "citation": {
                "source": "犯人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一メートル五十五の日本人に、一メートル八十二の雲をつくようなアメリカ人、一｜撃でふっ飛ぶか？",
              "citation": {
                "source": "柔道と拳闘の転がり試合",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "グワンというアッパーカット、向こうの壁までふっ飛ぶ肉団、その反動で、足から先に飛び返り、その足が相手の腹をけって、逆に相手が反対側の壁にぶっつかる。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場の屋根が、吹きとぶほど大きな歓声が、ドッと下の方から湧きあがった。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲板上の灯火が、暗い海を船のまわりだけを、ほの明るく照らしていたが、その光の中に、突然｜海豚の群のようにきらきら光る銀色の魚雷が群をなして船側目がけてとびこんだ――と思ったら、次の瞬間、天地も裂けとぶような大爆発が船内にひびきわたり、汽船は吹きとぶような大衝動をうけた。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここも焼けるか、吹きとぶか、どちらかです。",
              "citation": {
                "source": "水鳥亭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして酒の副作用で翌朝酔いがさめてから陰鬱になるというようなことが昔の人々に知りうるわけはなく、酒の力はその酒をのみ直接きいて愉しい時だけが作用の全部で、酒こそはたのしいもの、酔って泣くことはあっても、それ又たのしく、陰鬱なフツカヨイの如きは別の何かで、又酒をのめばそんなものは吹きとぶではないか。",
              "citation": {
                "source": "人生三つの愉しみ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに気押されて、敵の前側の列が、ぐっと凹んだせつなが、血の吹きとぶ途端である。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと十分もすれば、原子爆弾の爆発がおこって、あの研究所はこっぱみじんに吹っとぶんだ。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すくなくとも原子爆弾は二十個以上は完成されてあったのだし、原料ウラニウムも、一トンはおいてあったはずだから、それが次から次へと爆発すれば、三角岳がぜんぶ吹っとぶくらいの大爆発を起こしていいはずなのに、あのぐらいの爆煙ですむはずはない。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to vanish",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
