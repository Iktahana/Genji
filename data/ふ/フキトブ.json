        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "楽しかった時間はあっという間に吹き飛んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の失敗談を聞いて、私の悩みもどこかへ吹き飛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "夢のような出来事が終わり、現実に引き戻されて、すべてが吹き飛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
