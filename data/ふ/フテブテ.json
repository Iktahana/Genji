        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "余りにフテブテしい女の態度に立腹したものらしい。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは実に大胆な、宇宙にも挑戦しかねまじい、不敵な、フテブテしい一つの主張なのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分では媚びるような気持のときに、逆に変にフテブテしくジロリとやるようなアンバイであるらしい。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男といいオタツといい何たるフテブテしい神経であろうか。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ霊験があるように信じたがっているだけですよ」　安福軒は自信にみちたフテブテしい目で遠慮なく川野を見つめた。",
              "citation": {
                "source": "神サマを生んだ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、安福軒はその自信にみちたフテブテしい目で相手を遠慮なく見つめながら、あなたは信心がないのだ、ただ霊験アラタカのように信じたがっているだけだ、と教団を裏切る放言を吐いているのだ。",
              "citation": {
                "source": "神サマを生んだ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんてフテブテしい宗教への不信だろうか。",
              "citation": {
                "source": "神サマを生んだ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼の自信マンマンたるフテブテしい目は、宗教を信じたことのない人間の目ではないかと考えた。",
              "citation": {
                "source": "神サマを生んだ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は自分が意外にもフテブテしいのを、このときはじめて見たのである。",
              "citation": {
                "source": "握った手",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "最新型の背広に赤ネクタイ、眉目秀麗の青年であるが、なんとなくフテブテしく尋常ならぬ凄みがある。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は催眠薬でねむっているのを起されて取調べをうけた時の由之の傲慢非情のフテブテしさを思いだす。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "小娘だと思っていたときはフテブテしいイヤらしいところが目立って見えたが、本当の齢を知ってみると、それもうなずける。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに對して久しぶりにフテブテしい鬪志のようなものが私の胸の中に萠して來た事も事實だつた。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮山　……（それを見ているうちに、はじめてフテブテしくニヤリとして）あんたも、しかし、いいかげんにするがいいなあ。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その死にかけているような、とぎれとぎれの低い調子と、誇張されたフテブテしい言葉の意味との甚だしい背反が、奇怪にもコッケイにもきこえる）……おい、よせ！",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまでの言葉が虚勢を張ったフテブテしいものであっただけ、この絶望の調子に完全に救いはない）……けどよ、これ、……もう、ダメかも知れんなあ、こいつ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花岡　……（フテブテしくニヤリとして）最初、君に三万だけ、くれてやったな？",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
