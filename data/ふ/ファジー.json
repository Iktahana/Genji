        "examples": {
          "standard": [
            {
              "text": "彼女の指示はいつもファジーで、具体的に何をすればいいのか迷ってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そんなファジーな言い方じゃなくて、もっとはっきりした数字で教えてよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "厳密なルールよりも、ある程度のファジーさがあったほうが組織はうまく回ることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ファジーエフの「壊滅」の中のレビンソンなどつよく心にのこっています。",
              "citation": {
                "source": "これから書きます",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "情報処理学者たちはＡＩやニューロコンピュータやファジー理論を駆使して人間の意識をコンピュータでシミュレートしようと試みる。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
