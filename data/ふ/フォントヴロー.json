          "literary": [
            {
              "text": "小修道院に、フォントヴローの修道院からやってきた百歳ばかりの女が一人いた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "またフォントヴローの修道院に関して種々大げさなことを話していた、フォントヴローは大都市であるとか、修道院の中に多くの街路があるとかいうようなことを。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォントヴローの規則はそういうことを禁じなかったのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
