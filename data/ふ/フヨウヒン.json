    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "実はな、ここへ今に三四人ばかり、いりもしない首飾りや指環をつけた夫人連がやってくるので、その不要品を頂戴して、貧しい者に恵んでやろうと思っていたのだ。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし、私は皆さんのご不要品を頂戴しっぱなしで、あとでお返ししないという点だけがちがうのです。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は貴女がたの不要品をいただいていって、それを金にかえて、困っている者に取り次ぐだけです。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、一旦北支まで行って、不要品整理で送りかえしてよこしたもの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "時計を売ったから、むしろ腕輪の不要品が一ツふえた筈なのに、腕輪を買って戻ったから、甚だ奇異に思ったと時計屋は語っているのである。",
              "citation": {
                "source": "南京虫殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
