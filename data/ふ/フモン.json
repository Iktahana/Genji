[
  {
    "uuid": "628e13d0-a3b7-594c-85d1-41b6ccf1a712",
    "entry": "不問",
    "reading": {
      "primary": "ふもん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
