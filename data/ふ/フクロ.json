[
  {
    "uuid": "efb789d4-1fcd-5467-82c6-0c6bfbfa849f",
    "entry": "袋",
    "reading": {
      "primary": "ふくろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
