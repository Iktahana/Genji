        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フクロウは、たいこがないので、かわりに、自分のおなかをたたきました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "フクロウはたいこをたたき、コオロギは口笛を吹き、黒いキリギリスはハーモニカを吹き鳴らしました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、あたしがオンドリだったら、そんなメンドリは、けいべつしてやるわ」　ニワトリたちのいるすぐ上に、フクロウのおかあさんが、だんなさんと子供たちといっしょに、すわっていました。",
              "citation": {
                "source": "ほんとにそのとおり！",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "フクロウのおかあさんは、羽をばたばたさせながら、言いました。",
              "citation": {
                "source": "ほんとにそのとおり！",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "メンドリのくせに、自分が、メンドリであることを忘れてしまってね、自分の羽をみんなむしりとって、オンドリの気をひこうっていうんですからね」「プルネー　ギャルド　オー　ザンファン（子供たちに、気をおつけ）」と、フクロウのおとうさんが、フランス語で言いました。",
              "citation": {
                "source": "ほんとにそのとおり！",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんな話は、子供にはよくないからね」「でも、おむかいの、フクロウさんには話してやりましょう。",
              "citation": {
                "source": "ほんとにそのとおり！",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人は、だれとおつきあいしても、評判のいいひとですからね」こう言って、フクロウのおかあさんは飛んでいきました。",
              "citation": {
                "source": "ほんとにそのとおり！",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホー、ホー、ホホー」と、二羽のフクロウは鳴きながら、おむかいの、ハト小屋にいる、ハトにむかって言いました。",
              "citation": {
                "source": "ほんとにそのとおり！",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "フクロウだけは、まだ、巣にかえっていませんでした。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大丈夫、フクロウだよ」　フクロウって、ヘビを食べるんじゃなかったかな。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イフト、ヒヤクシヨウハ、「イイトモ、ホラ、ヤキタテノ　パンヲ　五ツ　アゲヨウ」ト　イツテ　セナカノ　フクロカラ　パンヲ　ダシマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」Ｂの走り書の一節「フクロ！",
              "citation": {
                "source": "晩春日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかの森の方で、フクロウが鳴いています。",
              "citation": {
                "source": "ふしぎな岩",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子には物売り（一人）、教師（一）、看護婦（一）、監獄看守（オフクロがそうなのだ）（一人）、工場労働（数人）という割合だ、七八歳の子供が女の子でも何になりたいということをこの位まで――労働と結びつけて考えるところ、自分面白いと思った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あすこに、椎の木のなかに、フクロウがいるって、幹夫さんが言いますのよ。",
              "citation": {
                "source": "古木",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "フクロウや狐の夜曲にあやされ、時折り間近に名も知らぬ鳥のキイキイごえを聞きながら。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある午後、わたしは縞フクロウ（Strix nebulosa）がシロマツの地面に近い枯枝の、幹に近いところに停まっているのを、一ロッドとはない距離に立っておもしろく見まもった。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の夜――昼であることもちょいちょいあった――音としては、どの辺から聞こえてくるのか見当がつかない、ホーホーフクロウのものさびしい、しかし旋律ゆたかな歌声があった。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然、まぎれもない猫フクロウがわたしのすぐ間近で、森の住人からわたしの聞いたことのある最も荒々しく物すごい声で一定の間隔で鵞鳥に応答した。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "フクロウも啼きたてたし、サモワールもひっきりなしに唸りましたっけ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "住む家もなく、生活の心当りもないから、オフクロにひきずられてゐるだけのことだ。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オフクロがまた我慾一方、人のために我身の損のできないタチだが、天妙教にすがつてゐると野たれ死だけまぬかれる、この目当は老いの身の頼みの綱だから、オイボレ廃人狐つきの集団生活、不愉快きはまるけれども教会を裏切られない。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレの気に入ったのは、引揚げ者の風体と、何よりもそのフクロウだな。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はオフクロの命日だなんて、誰一人きてくれやしませんよ。",
              "citation": {
                "source": "曾我の暴れん坊",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の、ふるさとがネ、オヤジもオフクロもウソなんだ、そんなケチなもんじゃないんだ、人間には、ふるさとが有るんだ。",
              "citation": {
                "source": "死と影",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレのオフクロ、子供んときから、成田のオマモリなんか持たせやがって、それが割れちゃったりして、つまらねえことまで、ネザメが悪くって、どうも、気分がよくねえよ。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちは、みんな死んじゃったよ」　とオフクロは面白くもなさそうな顔をあげ、ちょッと仕事の手を休めて言ったゞけであった。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬吉は見上げたオフクロだと思った。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しいオヤジとオフクロは大変仲がよろしい。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
