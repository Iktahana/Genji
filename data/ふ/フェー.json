          "literary": [
            {
              "text": "カフェーに這入つてゐた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処は銀座の裏通りのカフェー、卓子の上で扇風器は、哀しげな唸りをつづけてゐる。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "観音様が流行らないなら、モガの一人も張り飛ばして、食堂でアイスカフェーの食券一枚。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフェーでもいれますか？",
              "citation": {
                "source": "職業婦人気質",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフェーを沸かしながら彼女は卓上電話をとると、麹町にある彼女の経営している店に電流を通じて、その日のスケジュールをつくるために店員たちと約束客の時間の繰合わせについて打合せを始めた。",
              "citation": {
                "source": "職業婦人気質",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども家業柄――家業は、土地の東の廓で――近頃は酒場か、カフェーの経営だと、話すのに幅が利くが、困った事にはお茶屋、いわゆるおん待合だから、ちと申憎い、が、仕方がない。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――呆れもしない、目ざす敵は、喫茶店、カフェーなんだから、めぐり合うも捜すもない、すぐ目前に顕われました。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子大の校庭のあさましい垣のぞきをしたり、ミス何とかの美人競争の会場にかけつけたり、映画のニューフェースとやらの試験場に見学と称してまぎれ込んだり、やたらと歩き廻ってみたが、いない。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）※（Ｆ・Ｉ）は「フェード・イン」、（Ｆ・Ｏ）は「フェード・アウト」",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "女を一人｜宛相手に快活に喋舌って居る二人の男は中央アメリカの高山へ望遠鏡を運んで天文学の生きた証拠を把んだベンアリ・マッツカフェーと弟のベンアリ・ハギンだ。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は兎に角、子供だけは持ち度いものだ――室子は、流れの鴎の翼と同じ律に櫂をフェーザーしては蓑吉を待っていた。",
              "citation": {
                "source": "娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イギリスの家庭の美風は、｜お茶時で維持されている」「フランス人の機智は、珈琲店（日本のカフェーとは違います）で培養される」。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子どもが学校の寄宿へはいり私達がベルリンに移り住む前夜のオペラ見物のかえりに三人はまたカフェー・ド・ユ・ラ・ペイユに行った。",
              "citation": {
                "source": "オペラの辻",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子よ、太郎よ、今、巴里のカフェー・ド・ユ・ラ・ペイユの張り出し椅子の並ぶあたりに春の夕陽が斜にさしかかってはいないだろうか。",
              "citation": {
                "source": "オペラの辻",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくにカフェーに行こうと誘ったので、ぼくは身体にさわるからと断り、この辺のカフェーは淫をひさぐ家であるから、あなたも後で後悔しない為には今夜は行かぬ方がいいだろうと言うと、彼は、そうだそうだといい出し、あなたは身体に気をつけて丈夫になってくれ、自分はもう駄目だ、とおいおい泣き出した。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪に帰ると、彼は道頓堀や千日前のカフェーを飲み歩いた。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "肺が悪く、一度三合許りの血を吐いたが、翌日もカフェー遊びはかゝさなかった。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "千日前楽天地（現在歌舞伎座）横町のカフェー喜楽の年増女給とねんごろになり、宝塚旧温泉で関係を結んだ。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "女ばっかり並びくさって、こら、カフェーやな。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おん者らカフェーの女給や。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "三亀雄もその博奕に加っていたが、途中で勝逃げし、道頓堀のグランドカフェーに出掛けた。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月だから帰っている筈だと、カフェーに出掛けたのだ。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所のカフェーから流行歌が聞えて来た。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフェー廻りはどないや。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それともダンスホールか」カフェーやダンスホールの評判記でかなりの読者を獲得している新聞だったのだ。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（この時から一年余り後にハンブルヒである大きいカフェーにはいったら、そこのオーケストラの中でバイオリンをひいているマクスを見いだした。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり東京のカフェーかバーにいた女だそうでそれからまもなく帰京したとのことである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在でも月刊雑誌の編集部では随筆の類は「中間物」と称する部類に編入され、カフェーの内幕話や、心中実話の類と肩をならべ、そうしていわゆる「創作」と称する小説戯曲とは全然別の繩張り中に収容されているようである。",
              "citation": {
                "source": "科学と文学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
