[
  {
    "uuid": "7109991f-ddbc-50a8-a425-adf1066fe4c4",
    "entry": "吹き募る",
    "reading": {
      "primary": "ふきつのる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
