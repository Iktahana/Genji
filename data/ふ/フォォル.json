        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ポォル・フォォルの夫人が令嬢を伴れて奥の方に来て居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの文人も皆最初にフォォル夫人に挨拶して握手した。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポォル・フォォル氏が遅れて遺つて来た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が持合せた紹介状を出すと「おお是れは※レツト君の手跡だ、中を見ないでも解つて居る」とフォォル氏が云つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォォル氏はいろんな文人を僕に引合せた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォォル氏は僕に名刺を呉れると云つて夫人と一緒に探して居たが、やつと一枚服の衣嚢の何処からか見附出して皺を直し乍ら呉れたのは黄色く成つた古名刺であつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
