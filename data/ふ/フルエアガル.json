[
  {
    "uuid": "6b612dce-dae2-5add-bea8-a00d8b10f365",
    "entry": "震え上がる",
    "reading": {
      "primary": "ふるえあがる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to tremble violently",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "闇夜に響いた正体不明の不気味な叫び声に、キャンプ中の若者たちは恐怖で震え上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "普段は温厚な上司の凄まじい怒鳴り声を聞いて、その場にいた社員全員が震え上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "零下三十度の極寒の世界では、どれほど厚手の防寒着を着ていても骨まで震え上がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "葉子は新聞記者と聞くと、震え上がるほどいやな感じを受けた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時候も今日のように冬に入る初めでなく、陰暦の十一月ですから、筑波颪がまともに吹いて来て震え上がるほど寒い。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "熊手を拵えて売ったはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は隣の者にニャルラトホテプを見に行けと薦め、震え上がるのです。",
              "citation": {
                "source": "ニャルラトホテプ",
                "author": "NYARLATHOTEP",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉱山技術者として私は地質学をある程度知っており、これら石材は震え上がる位太古のものだということができます。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも震え上がる。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "震え上がるほどはにかみやだからね。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその水のつめたいのにふるえあがるように思いました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それですから、あなたとわたくしとが押掛けて行けば、こっちで何も云わなくっても、先方は脛に疵でふるえあがるんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "おのれが拷問にかけられると、ふるえあがるから、吾等も白状するかと、ははははは。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "当てられて、織子、ふるえあがる）……熱も少しある。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺の子は馴れているからよかろうが、春があの水につかったら、いっぺんにふるえあがる。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャツ一枚でいるとふるえあがるようであった。",
              "citation": {
                "source": "八※岳登山記",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本だけではない、世界じゅうの人が、ふるえあがるような、おそろしいことになる。",
              "citation": {
                "source": "透明怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、そうしてしばらく穴ぐらを見まわしているうちに、こんどは、いきなり背中につめたい水をかけられでもしたように、心の底からふるえあがるほどの、おそろしいことがおこりました。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく、えたいのしれない、ふるえあがるような出来事でした。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京じゅうが、ふるえあがるような恐怖の仮面だ。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人は意気地が無いから、蒼くなって震え上るに相違ない。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やいこら、とこんな工合いに男のひとみたいな太い声で呼びとめると、どんな旅人だって震え上るにきまっている。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "団九郎の天狗は悠々と現れ出て、Ｔ「我名を騙る　憎い人間ども」　山賊達、震え上る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは何、これは何と、一々見分け得る判断力だの……知識だの……又は、若林博士の説明を震え上るほど深刻に理解して行く学力だの……そんなものはどこで自分の物になって来たのか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由に勝手に盗み取るのが、震え上るほどの嬉しさだった。",
              "citation": {
                "source": "川端柳",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕を見たら、嬉しくて震え上るだろう。",
              "citation": {
                "source": "華厳経と法華経",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてここにこうして半分震えている亭主やお内儀さんは、いっそう震え上るであろうし、こういうことはすぐに噂を呼びやすいものであったから、私は怖いならば怖い、恐ろしいならば恐ろしいで、自分だけでこの秘密を胸に畳み込んでしまって、もうこの上｜由ない恐怖に人を陥れることは止めにしようと決心したのであった。",
              "citation": {
                "source": "逗子物語",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者は、軽業師でも震え上る様な、目もくらむ鉄骨の上を、スルスルと進んで、頂上の孔から、屋根の上へと這い出した。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "広い東京とは云いながら、三つや四つ、血なまぐさい、震え上る様な犯罪の行われぬ日とてはない。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴリラの脱走を聞いて震え上るのは、一般市民でなくて、寧ろ彼の首領の恐怖王その人ではあるまいか」　蘭堂は苦笑しないではいられなかった。",
              "citation": {
                "source": "恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨と一緒に横しぶきに吹きつける河霧がふるえ上がるように寒かった。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "盗むということがすでに悪いのに、それを盗んだ品が更に悪いのであるから、どうでも無事に済む筈がないと、彼はふるえ上がるほどに驚いたのである。",
              "citation": {
                "source": "半七捕物帳",
                "author": "正雪の絵馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナイアガラ見物の際に雨合羽を着せられて滝壺におりたときは、暑い日であったがふるえ上がるほど「つめたかった」だけで涼しいとはいわれなかった。",
              "citation": {
                "source": "涼味数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に女中共も調べられたが、かれらは初めてそんな話を聞かされて唯ふるえ上がるばかりであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
