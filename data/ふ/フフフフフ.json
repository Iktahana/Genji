          "literary": [
            {
              "text": "「コン畜生め、惚れやがった癖に、フフフフフ。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "のっそり降りると、「ウフフフフフ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "くやしくてならねえんですよ」「ウフフフフフ、そんなことで泣くのがあるかよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッハッハッハッハッ……ゴホンゴホン……妙な顔をしているじゃないか……ウフフフフフフ是非とも吾輩が死んでいないと具合がわるいと……ゲッヘンゲッヘン……云うのかね。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフフフフフフ……ゾッとする筈だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴方の天才的頭脳によって仕組まれた一つの恐ろしい喜劇に過ぎないと、私が断定している理由がおわかりになりますか」「……………」「……フフフフフ。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうでしょう……どうです……」「……………」「……ウフフフフフ、私がこの眼で見たのですから、間違いは無い筈です。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハハハハ」「オホホホホホホ」「ウフフフフフフ」　泥棒は夢中になって逃げ出すと、すぐに通りがかりの巡査さんに捕まりました。",
              "citation": {
                "source": "雪子さんの泥棒よけ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "見込みがあるぞッ」「ワハハハハハ……」「フフフフフフ……」　昂作はそんな笑い声を耳にしながら、静かに頭を横にして起き上りかけた。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｗは女の意味だの、女のアレ……」「ウフフフフフフ」「……だの奥様だのいう……」「Ａと同じだね」「ウン。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――そう云って、自分でムフフフフフと笑った。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "フフフフフフ、と陰性の中音、絶えず笑いを響かせながら、分を盗み寸を奪い、ジリジリと爪先で寄って来る。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フフフフ、フフフフフフ」　突然太刀を左手に引き付け右足をトンと踏み出したが、「いや貴殿を討つことはならぬ。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い光が「彼の人を恋人にしてやろうか」とつぶやくと青い光は「フフフフフ」と笑って笑いも消える時には「恋人にしてやろうか」と云う光は消えてしまって居た。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フフフフフフ」　鼻の先でとび出した様に女はそれを見て笑った。",
              "citation": {
                "source": "お女郎蜘蛛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の精霊　だが及ばぬ事じゃ、いかな物ずきでもしわくちゃなはげおやじに……ウフフフフフおかしい様な気もするワ、いい年をして子の様な精女の姿にうなされるとは――はかりきれない美くしさをもって居ると見える。",
              "citation": {
                "source": "葦笛（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとたんに、「ウフフフフフ、だいぶ胆をひやしたようじゃが、その調子では、墓埋めなどというすごい仕事はつとまるまいテ、わっはっはっは」　また大声が、眼の前に爆発して、暗黒が凝ったかと見える一｜塊の人影が、ノッソリ立ち現われた。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフフフフフ……と、ふすまのかげから、源三郎の低い笑い。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "折々、「フフフフフとか、「いやだねえ」などと云うお金の声が押しつぶされた様に響いて来た。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人が動く跫音が――、何か云い、圧しつけたように、「フフフフフフ」笑う声がした。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、見ろそっくりこのままの面になるからハハハハハ」「フフフフフフフ」　振り向くと、笑いながらかたまっている顔が、石鹸のあぶくを掻きまわしたように見える間から、今いつの間にか作られたと見える一つの滑稽な人形がのぞいている。",
              "citation": {
                "source": "日は輝けり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
