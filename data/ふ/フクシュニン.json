          "literary": [
            {
              "text": "第一製鋼工場の副主任の中野学士と、職工の戸塚と、事務室の若い人間が三人来て軟球の乱打ちを初めていた。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお女学員バラに臨時副主任を命ずる。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあそこで副主任バラ女史に命ずる。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ案内にたつように」　副主任と呼ばれてバラはいささか得意だったけれど、アリシア区を案内することは彼女にとってむしろ迷惑なことだった。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "右方に副主任の青木がゐるところからして、このとき昌造は主任であるわけだが、前方の「役人」たちは三人共若い丁髷で、何の某と名乘る大官でもなささうだから、主任ではあつても技術面の昌造らの位置といふものは今日の常識からは、はるかにひくいものだつたのであらう。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "1927年に彼はその部門の副主任になり1930年には正式の主任になった。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            }
          ]
        }
