        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あの頃フィリッポフという白系露人の知人がいて、その生活をかいているのですが、こういうものになると、今日の読者が面白さを見出すとしても、作者はそれで満足しないものがあって、出すのはいやです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリッポフのところへゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙの点カラし、二人でフィリッポフの部屋に行く。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙそれからフィリッポフ。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえりフィリッポフ　真直かえる。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう、ガウズネルにきいたフィリッポフの店で食事す。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "翻訳をはじめてから、素子はちょいちょいした相談相手としてフィリッポフというロシアの人と知りあいになっていた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老松町に間借り暮しをはじめた頃のある夜、伸子も素子につれられてフィリッポフというその男の住居を訪ねたことがあった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九一七年の革命のとき極東のどこかの小さい町に両親と生活していて、騒動の間に親たちは死に、自分は日本へ逃げて来たというフィリッポフは二十八九歳で、鴨居に頭のつかえる背たけをしていた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "亜麻色の髪をすこし長めに後へなでつけ、水のような瞳をしたフィリッポフは神田に二階借りして、ロシア風の襞の多いスカートをつけた若いからだの大きい妻と、生れて間のない赤ん坊とで暮していた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリッポフはその二階の二つの小さい座敷の唐紙をはずして、椅子、テーブル、大きい本箱、赤ん坊の揺籃、ミシン、赤ん坊に湯をつかわせるブリキの大盥、食器棚など、生活に必要なあらゆるものを、その室内に持ちこんで暮していた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子はフィリッポフに会って、はじめてロシア人の口から話されるロシア語の魅力を感じた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリッポフは、しかし、素子が必要としただけの教育をうけていないらしかった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "話す母国語は勿論わかっているが、文学として、こまかい語義の詮索になると、図ぬけて背の高いやせたからだに黒い服をつけたフィリッポフは、水のような瞳に半ば絶望の表情をうかべた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリッポフの万端が庶民風なのにくらべると、ワーリャと呼ばれているその人の生活は、伸子に、ロシアの首府がペテルブルグと呼ばれていた時代の知識人の空気を思いやらせた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリッポフ夫婦の生活やワーリャの家の人たちは、伸子に、昔から今へ生きているロシアの社会のひとこまを見せるようだった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フィリッポフさんの眼だって、そうだわ」「あれゃ、色のせいじゃない」　断定的に素子がいったので、蕗子も伸子も笑い出した。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
