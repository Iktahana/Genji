        "examples": {
          "standard": [
            {
              "text": "「このTシャツ、フィフティーオフになってるよ！」「やった、買っちゃおうかな。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私は今、人生のフィフティー代に差し掛かっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "宝くじでフィフティー万円が当たったら、何に使おうか夢が膨らむ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "嬢次様のお話に依りますと、初め道化役者が幕を出て行きます前に、演技の時間は何分ぐらいにしたら宜しいのですかと云ってハドルスキーさんに聞きましたら、ハドルスキーさんはフィフティ（五十分）と云って指を五本出されました。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを道化役者の支那人はフィフティン（十五分）と勘違いをして、一生懸命に時間を急いで済ましたのだそうです。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィフティ、フィフティ（半分半分）」　ホンモノのピストルをとりだしてギャングのマネをしてみせたそうです。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
