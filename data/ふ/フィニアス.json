        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まづ大きな市ファリアス、それから光りかがやくゴリアスとフィニアス、ずうつと南の方にムリアスがあつた。",
              "citation": {
                "source": "四つの市",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィニアスからは「勝利の槍」。",
              "citation": {
                "source": "四つの市",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その四つの市についてフィオナ・マクラオドの随筆では、むかし、イデンの園の四方にゴリアス、ファリアス、フィニアス、ムリアスの市があつた。",
              "citation": {
                "source": "四つの市",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィニアスの市はイデンの南の方の門で、ムリアスは西の門であつた。",
              "citation": {
                "source": "四つの市",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダムの側にイヴが目をさまして、とこしへの不思議を湛へた眼でアダムを見た時、黄昏の嘆きと告別の声が市々にきこえてゐた、海ぎしのムリアスに、高山の嶺に立つゴリアスに、ひそかな静かな園のファリアスに、月光が槍のやうに射す平野のフィニアスに。",
              "citation": {
                "source": "四つの市",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼ごろイヴはフィニアスに来た。",
              "citation": {
                "source": "四つの市",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はゴリアスで見つけた火焔とフィニアスで見つけた白い光の槍をアダムにやつた。",
              "citation": {
                "source": "四つの市",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オスカ・ピータスンやフィニアス・ニューボーンは、ブルースをやっているけれど、それはジャズのブルースなのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
