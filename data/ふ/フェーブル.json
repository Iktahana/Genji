        "examples": {
          "standard": [
            {
              "text": "イソップのフェーブルは、動物を通じて人間の本質を鋭く描いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "子供の頃に読んだフェーブルの教訓が、大人になった今でも心に残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は現代の社会問題を寓話的なフェーブルの形式で表現した小説を発表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "何冊かあった関連の本の中でも、リュシアン・フェーブルとアンリ＝ジャン・マルタンというフランス人の書いた『書物の出現』には、腰を据えて読んでみたいと思わせる手応えを感じました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等が私を直ぐに徒刑場に送ってくれたら、オルフェーブル河岸[88]で私のことをじろじろ見る犯罪捜査課の連中が目障りだが、そのうち私は自分の仕事に戻れるんだがなあ。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
