        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ファイエルマン退院をするので、噪いで аптека へ買物に出かける話だ。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し　室にはまだファイエルマンの臥て居た寝台がある。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝同室患者のファイエルマンが彼女の一日分五十｜瓦のパンの端から一切をきり乍ら――あなた我々の隣の病人の呻るのをききましたかと云った。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わきの寝台に腰をかけ、前へ引きよせた椅子の上に新聞をひろげ、バター、キューリ、ゆで卵子二つ、茶でファイエルマンが夕飯をたべる。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファイエルマンは新聞を巻いて上手にスタンドの明りを覆うた。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファイエルマンは明りを暗くすると、寝台の横のトリムボチカをあけ乍ら　私に云った。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○日　ファイエルマンがこういう話をした。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が来た時部屋に丁度ファイエルマンと Госиздат〔国立図書出版所〕の女ともう一人の女が来て長椅子に居た。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファイエルマンが――かまわないよ、彼女だって聞く　押っつけがましくしわがれた声で云った。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
