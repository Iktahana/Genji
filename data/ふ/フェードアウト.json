        "examples": {
          "standard": [
            {
              "text": "曲の終わりは楽器の音が徐々に小さくなるフェードアウトで処理することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は周囲に気づかれないよう、賑やかなパーティーの輪から静かにフェードアウトした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "映像が黒くフェードアウトし、物語は感動的な幕切れを迎えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "終局の場面でも、人生の航路に波が高くて、舳部に砕ける潮の飛沫の中にすべての未来がフェードアウトする。",
              "citation": {
                "source": "映画雑感（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして静かにこの一編の終末がフェードアウトするのである。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、彼がこの国会図書館を去ってみると、そこには全く新しい型の、未来の意味における英雄のおもかげが、ホーフツとそこにフェードアウトしながら、映画における最も印象的な推移で、姿をあらわしている。",
              "citation": {
                "source": "組織としての図書館へ",
                "author": "――マックリーシュの業績――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
