        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "クラブ員は海賊のユニフオオムを一着すること。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから又プラツトフオオムへ出て、もう一度同じ地名を呼んだ。",
              "citation": {
                "source": "駆落",
                "author": "DIE FLUCHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリツツがふいとその方角を見ると、茶色のジヤケツを着た、小さい姿が、プラツトフオオムの戸の向うへ隠れるのが見えた。",
              "citation": {
                "source": "駆落",
                "author": "DIE FLUCHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラツト・フオオムに立つて居た日本人は私の為に出て居てくれた軍司氏であつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此辺では停車する毎にプラツト・フオオムの売店へ宝石を買ひに降りる女が大勢ある。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと目を上げると窓の外のプラツト・フオオムを横浜の英人が運動に歩いて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラツト・フオオムには良人の外に二人の日本画家と二人の巴里人とが私を待つて居て呉れた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三　先生の死　彼は雨上りの風の中に或新らしい停車場のプラツトフオオムを歩いてゐた。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラツトフオオムの向うには鉄道工夫が三四人、一斉に鶴嘴を上下させながら、何か高い声にうたつてゐた。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "うすむらさきに吐息する白熱燈あなたの微笑した顏はどこにある人影がいり亂れる蒼青なプラツトフオオムたよりない人生に嘆息はほろびず世にない人にくちびるはふるへるさびしくも唯だ一人どこへゆく？",
              "citation": {
                "source": "太陽の子",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は風の寒いプラツトフオオムへ下り、一度橋を渡つた上、省線電車の来るのを待つことにした。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、僕の歩いてゐるのはいつかプラツトフオオムに変つてゐた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは田舎の停車場だつたと見え、長い生け垣のあるプラツトフオオムだつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ汽車は煙をあげながら、静かにプラツトフオオムへ横づけになつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "外を覗くと、うす暗いプラツトフオオムにも、今日は珍しく見送りの人影さへ跡を絶つて、唯、檻に入れられた小犬が一匹、時々悲しさうに、吠え立ててゐた。",
              "citation": {
                "source": "蜜柑",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本づつ眼をくぎつて行くプラツトフオオムの柱、置き忘れたやうな運水車、それから車内の誰かに祝儀の礼を云つてゐる赤帽――さう云ふすべては、窓へ吹きつける煤煙の中に、未練がましく後へ倒れて行つた。",
              "citation": {
                "source": "蜜柑",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処に大きなプラツトフオオムが地中海の沿岸のやうに横たはり、その下に波打つ幾線の鉄の縄が世界の隅隅までを繋ぎ合せ、それに断えず手繰り寄せられて、汽車は此処へ三分間｜毎に東西南北より著し、また三分間｜毎に東西南北へ此処を出て行く。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラツト・フオオムに立つて居た日本人は私の爲に出て居てくれた軍司氏であつた。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此邊では停車する毎にプラツト・フオオムの賣店へ寶石を買ひに降りる女が大勢ある。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと目を上げると窓の外のプラツト・フオオムを横濱の英人が運動に歩いて居る。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラツト・フオオムには良人の外に二人の日本畫家と二人の巴里人とが私を待つて居て呉れた。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車が着くと、僕はプラツトフオオムを見廻した。",
              "citation": {
                "source": "世界覗眼鏡",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、あの風車のやうなプラツトフオオム！",
              "citation": {
                "source": "走るノート",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
