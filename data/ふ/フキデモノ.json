    "definitions": [
      {
        "index": 1,
        "gloss": "(skin) eruption",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ストレスで顔に吹き出物がたくさんできてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は、肌荒れを防ぐために、薬用の石鹸で吹き出物を洗うようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "夏の暑さで、背中に小さな吹き出物ができてかゆい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "人間の眼には、おぞましく気味の悪いこの樹幹の吹き出物に人間の知らない強い誘惑の魅力があって、これらの数多くの昆虫をひきよせるものと見える。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "始終吹き出物でもしそうな、膿っぽい女を葉子は何よりも呪わしいものに思っていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅斑熱の他の変異種はボタン熱（＊吹き出物のフランス語から）でマルセイユ近くのプロヴァンスで最初に記載されルーマニアにも発見された。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い熱がでて苦しむうちは、まだよいとして、全身に、すき間もなくふきでものがでて、それが膿をもって黄色に変じますと、まるであの菊人形のように……きくならば美しいですけれど、それがうみをもった黄色のできものでおおわれた有様を想像してごらんなさい。",
              "citation": {
                "source": "ジェンナー伝",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにそのふきでものが乾くときは黒赤色に変じますから、全身はあんの中へころがったようになり、顔はおはぎを見るようで、どこに目があるやら鼻があるやらさっぱりわからないのであります。",
              "citation": {
                "source": "ジェンナー伝",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エウドキアなんです――でも、ここのひとたちはわたしをニューラとしかよばないんです」　伸子は、思わずニューラの浅黒くてこめかみにこまかいふきでもののある若い顔を見つめた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫外線の不足とよくない食物のために、こまかいふきでものを出している顔色のよくない両肩の落ちた若い男女の大群集。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "背の低い顔にふきでものを出して、腕が不均斉に長いようなロンドンの人々の大群は、いつこの西にまであふれて出て来るだろうか、と。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は元来｜脾弱かつたうへに生れると間もなく大変な腫物で、母の形容によれば「松かさのやうに」頭から顔からいちめんふきでものがしたのでひきつづき東桂さんの世話にならなければならなかつた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は身体ぢゆうのふきでものを痒がつて夜も昼もおちおち眠らないもので糠袋へ小豆を包んで母と伯母とがかはるがはる瘡蓋のうへをたたいてくれると小鼻をひこつかせてさも気もちよささうにしたといふ。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "額の邊にあはつぶのやうな小さい吹出物がでてきた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が顏の吹出物へ、三角形や六角形や花の形に切つた絆創膏をてんてんと貼り散らしても誰も可笑しがらなかつた程なのである。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの吹出物には心をなやまされた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその吹出物を欲情の象徴と考へて眼の先が暗くなるほど恥しかつた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟も私の吹出物を心配して、なんべんとなく私の代りに藥を買ひに行つて呉れた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃になつて私の顏の吹出物もどうやら直つてゐたが、それでも惰性で、私はなにかと顏をこしらへてゐた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "首がふとく、襟脚はいやに鈍重な感じで、顎の下に赤い吹出物の跡を三つも僕は見つけた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "深夜、裸形で鏡に向い、にっと可愛く微笑してみたり、ふっくらした白い両足を、ヘチマコロンで洗って、その指先にそっと自身で接吻して、うっとり眼をつぶってみたり、いちど、鼻の先に、針で突いたような小さい吹出物して、憂鬱のあまり、自殺を計ったことがある。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "地球の物理を明らかにしないで地震や火山の現象のみの研究をするのは、事によると、人体の生理を明らかにせずして単に皮膚の吹出物だけを研究しようとするようなものかもしれない。",
              "citation": {
                "source": "地震雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が顔の吹出物へ、三角形や六角形や花の形に切つた絆創膏をてんてんと貼り散らしても誰も可笑しがらなかつた程なのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟も私の吹出物を心配して、なんべんとなく私の代りに薬を買ひに行つて呉れた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついつい、わがままも出て、それだから、こんどのように、こんな気味わるい吹出物に見舞われるのです。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬を塗ってもらったせいか、吹出物も、それ以上はひろがらず、明日は、なおるかも知れぬと、神様にこっそり祈って、その夜は、早めに休ませていただきました。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなに皮膚のやまいを嫌っているので、自然と用心深く、いままで、ほとんど吹出物の経験なぞ無かったのです。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに、吹出物してしまって、くやしく、うらめしく思います。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "からだじゅう、トマトがつぶれたみたいで、頸にも胸にも、おなかにも、ぶつぶつ醜怪を極めて豆粒ほども大きい吹出物が、まるで全身に角が生えたように、きのこが生えたように、すきまなく、一面に噴き出て、ふふふふ笑いたくなりました。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼だけが、まだ生きていて、巷の初夏のよそおいを、ぼんやり眺めて、路行く女のひと、男のひと、誰も私のように吹出物していないのが不思議でなりませんでした。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと、この大勢の患者の中で、私が一ばん重い皮膚病なのかも知れない、ということに気がつき、びっくりして眼をひらき、顔をあげて、患者ひとりひとりを盗み見いたしましたが、やはり、私ほど、あらわに吹出物している人は、ひとりもございませんでした。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひょっとしたら、この吹出物も――と考え、一時に総毛立つ思いで、あの人の優しさ、自信の無さも、そんなところから起って来ているのではないのかしら、まさか。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかしから、ちゃんと泥沼が、明確にえぐられて在るのだと、そう思ったら、かえって心が少しすがすがしく、爽やかに安心して、こんな醜い吹出物だらけのからだになっても、やっぱり何かと色気の多いおばあちゃん、と余裕を持って自身を憫笑したい気持も起り、再び本を読みつつけました。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
