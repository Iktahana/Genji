        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドリアスあれは闇の女フォルキアデスです。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇の女フォルキアデスきょうだい達。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルキアデスこの幽霊は物の分かる男らしいね。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルキアデス寂しい暗い所に引っ込んでいるものですから、8000ついそこに気が附きませんでしたよ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルキアデス　　　　お黙。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルキアデスの一人　　　　　　どうだろうね。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルキアデス　　　　　　　　　　　　好うござんす。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "メフィストフェレス（横顔をフォルキアデスにする。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルキアデスそれはわたし達が混沌の娘だと云うことは確かです。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルキアデス改めてのきょうだい三人の中で誰が美しかろう。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "（フォルキアデス閾の上、戸枢の間に現る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇の女フォルキアデスの娘の中で、お前はどれだえ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルキアデスの一人のお前が、事に依ったら来たのだね。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇の女フォルキアデス美しさと廉恥とが、下界の緑の道を手を引き合って一しょに歩かぬと言う諺は8755古いけれど、その意味はいつまでも高尚で、真実だ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "（フォルキアデス手を打ち鳴らす。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを合図に、戸口に覆面したる侏儒等現れ、以下のフォルキアデスの命令を、一々即時に執行す。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
