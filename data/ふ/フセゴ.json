[
  {
    "uuid": "6ef8bc00-79ac-54b0-8237-cf78bac88e57",
    "entry": "伏せ籠",
    "reading": {
      "primary": "ふせご",
      "alternatives": [
        "ふせかご"
      ],
      "is_heteronym": false
    },
    "grammar": {
