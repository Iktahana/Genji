        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭先の伏せ籠の中で、新しく買ってきたヒヨコたちがピヨピヨと鳴きながら身を寄せ合っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "イタチに狙われないよう、夜間はニワトリたちを頑丈な伏せ籠の中にしっかりと入れておく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "お祭りの屋台でヒヨコ釣りを見かけ、竹で編まれた小さな伏せ籠に入った姿が懐かしかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
