        "examples": {
          "standard": [
            {
              "text": "専門の職人が瓦屋根を丁寧に葺き替えたので、雨漏りの心配がなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "築50年の家の屋根を葺き替えるのに、かなりの費用がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "台風で被害を受けた屋根を、地域の人々が協力して葺き替えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "関東地方では茨城県の筑波とか、遠くは福島県の会津地方のような、田畠がすくないか、または秋の農作のはやく片づく村から、群れをなしてその屋根葺き職の者が出てきて、大よそけんとうをつけ、または前の年からやくそくをして、今年葺きかえる家々を廻っていた。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
