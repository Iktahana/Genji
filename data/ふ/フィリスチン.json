        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはどんなものであるかと言えば、先ずそれは頭の中で一切の現世的なもの、フィリスチンのものを否定する。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん、自分の中にある現世的なものフィリスチン風な要素をも否定する。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "否定しながら、彼自身の実生活はまったく現世的に常識的で、中庸がとれていて、百パーセント・フィリスチンだ。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じくフィリスチンの敵ではあっても、これは、他人のうちのフィリスチニズムを撃破するのと同時に、それと同じ程度の無慈悲さでもって自分のうちのフィリスチニズムをも撃破する。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵のフィリスチン人は静かに眠ることができた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
