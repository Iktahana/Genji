          "literary": [
            {
              "text": "ハ行の子音は、現代ではｈであるが、方言によってはＦであって「は」「ひ」「へ」をファフィフェと発音するところがある。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして現に日本の方言にも東北地方や沖縄の方でも出雲地方でもハ行音を「ファフィフェ」など言うのは、昔の音が田舍に遺っているのです。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
