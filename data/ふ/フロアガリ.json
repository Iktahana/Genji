        "examples": {
          "standard": [
            {
              "text": "汗を流した後の風呂上がりに飲む、よく冷えた一杯のビールは格別だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "風呂上がりの濡れた髪をタオルで拭きながら、リビングのソファに倒れ込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "冬場は風呂上がりにすぐ保湿クリームを塗らないと、肌がカサカサになってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "チェックのパンツ一枚に、首からバスタオルを下げ、ゴム草履といういでたちで、風呂上がりの大魔神かなんかに見える。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、ガラッと障子が開いて、風呂上りのおしまが、Ｔ「何で御座いますの　今の音は？",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処へ風呂上りのお類入って来て、　「おや何うしたのさ」　「お、お類さん」と伊吉。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆき子は風呂上りとみえて、血色のいゝ手をしてゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂上りの、けだるい五體が、まるで、ぼつてりと水を含んだやうに重い。",
              "citation": {
                "source": "暗い花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂あがりのせいか、安福せっけんの匂いが、肌にぷんぷん匂う。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "曇った日の黄昏どきで、栄三郎は風呂あがりの浴衣になり、ぼんやり広縁へ出たところだったが、誰か声をひそめて呼ぶ者があるので見ると、裏木戸のところにおさとがいて、手招きをしているのが見えた。",
              "citation": {
                "source": "扇野",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
