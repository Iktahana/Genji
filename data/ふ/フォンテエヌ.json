        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "プロロオグフォンテエヌブロオの古城――池のほとり――日盛り過ぎ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕たちはもうラ・フォンテエヌの時代に住んでるんじゃないからね」と、懐疑主義者の鷓鴣の子が言う。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしたちはもうラ・フォンテエヌの時代にいるのではありません」と、懐疑主義者の鷓鴣が言う。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　氣取つた恰好をして、彼女はラ・フォンテエヌのお伽噺の“La Ligue des Rats”（鼠の同盟）をはじめた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、難行苦行のすえ、フォンテエヌブウロオの森をはるか左に見、ロアンの運河にそったモレという町に到着したのは夜の九時過ぎ。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "合乗り乳母車　――仏蘭西縦断の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
