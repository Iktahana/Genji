        "examples": {
          "standard": [
            {
              "text": "失敗を自分のせいだと責めて、彼は自室に閉じこもってふさぎ込んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "雨の日が続くと、なんとなく気分が晴れずにふさぎ込んでしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「いつまでそうやってふさぎ込んでいるつもりだい？外の空気を吸いに行こうよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "さらに次の事実は、マーフィ少佐のほか話をした五人中三人の士官の心に残っていたのだが、時折、妙にふさぎ込むことがあったという。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
