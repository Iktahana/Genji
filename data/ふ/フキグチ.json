          "literary": [
            {
              "text": "つまり犯人は、笙の吹き口に酒精を詰めて、それを縦にした根元を日光へ曝したのだ。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新世帯にうれしいものは、紅のついたる火吹き竹――なるほど、この火ふき竹にも、吹き口にはお藤姐御の寒紅がほんのりついていますけれど、うらむらくはこの左膳との生活に、それらしい新婚のよろこびは、すこしもございませんでした。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎの室の人々の中に立った桃子が、フルートの吹き口を唇に持って行っている姿。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
