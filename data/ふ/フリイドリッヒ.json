        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕はフリイドリッヒ・ニイチェだ。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度、私はその息子のフリイドリッヒが彼を養子にした叔父のシモンの悪い感化の下で次第に村のならず者になってゆく宿命的な経路を描いた物語の半ばを読みかけていた。",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ず嫌疑はフリイドリッヒにかかる。",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎの日曜の明け方、教会に往こうとして月あかりのなかに台所で祈祷書を捜していたフリイドリッヒは、戸口で寝巻姿の儘の叔父のシモンに呼びとめられる。",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三の押し問答の末、フリイドリッヒは例の殺人犯人は実はその叔父であるのを知る。",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリイドリッヒもヨハンもゆくえ知れずになる。",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「巴里控訴院に於てジュウル・ファーブルが故シャルル・ギュイヨーム・ノオンドルフの相続者のためになしたる弁論」（フリイドリッヒ）は、この訴訟が如何なるものであったかをよく説明してくれる。",
              "citation": {
                "source": "カストリ侯実録",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
