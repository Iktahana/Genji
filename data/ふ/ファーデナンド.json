        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ファーデナンドという小作の青年が地主の娘に恋をしたんだね。",
              "citation": {
                "source": "田園情調あり",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファーデナンドは発憤して村を出る。",
              "citation": {
                "source": "田園情調あり",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへファーデナンドが帰って来るんだ。",
              "citation": {
                "source": "田園情調あり",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論ファーデナンドの為めでない。",
              "citation": {
                "source": "田園情調あり",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人がロンドンから帰って来るという電報が着いたから待っているというので、ファーデナンドも夫人と一緒に待っていた。",
              "citation": {
                "source": "田園情調あり",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「三四年待った時、もう亡くなったのだろうから結婚しましょうとファーデナンドが言い出したけれど、夫人は亡くなった証拠が手に入るまでは堪忍して下さいという。",
              "citation": {
                "source": "田園情調あり",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人の心は初めからファーデナンドの方へ行っているんだけれど仕方がない。",
              "citation": {
                "source": "田園情調あり",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファーデナンドが六十なら、奥さんは五十幾つでしょうに」　と朝子さんが残念がった。",
              "citation": {
                "source": "田園情調あり",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
