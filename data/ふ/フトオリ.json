    "definitions": [
      {
        "index": 1,
        "gloss": "thick silk cloth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
