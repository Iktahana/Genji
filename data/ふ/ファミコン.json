        "examples": {
          "standard": [
            {
              "text": "子供の頃、ファミコン（家庭用ゲーム機）で熱中して遊んだ思い出がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "今でもファミコン（ゲーム機）で遊ぶのが好きな人は多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "レトロゲームとして、ファミコン（ゲーム機）のカセットがコレクターの間で高値で取引されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "こうした経緯があって６５０２はアップル、ＰＥＴなどに使われ、任天堂のファミコンに採用されて大増殖を遂げた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
