        "examples": {
          "standard": [
            {
              "text": "修学旅行の宿泊先では、仲の良い友達と二人部屋になれて大喜びした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "病院に入院することになったが、大部屋がいっぱいで個室か二人部屋しか空いていなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "出張の際、会社の経費削減のために同僚とビジネスホテルの二人部屋に泊まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "もっともフランスの船の三等というのは、ちょうど郵船の特別三等みたいなもので、二人部屋と四人部屋とあるのだが、僕はその二人部屋にはいった。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "○夜、二人部屋で方々にハガキを書いた。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
