    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "むしろ進んで、暗合的なものと因果的なものとを含めた全体のものを取って、何かの合理的な篩にかけて偶然的なものと必然的なものとを篩い分ける事に努力したほうが有利ではあるまいか。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「自然」を実験室内に捕えきたってあらゆる稚拙な「試み」を「実験」の試練にかけて篩い分けるという事、その判断の標準に「数値」を用いるという事によって、はじめて今日の科学が曙光を現わしたと思われる。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "努力は実に人を石から篩い分ける大事な試金石だ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそういうことと、人間生活の諸事象を、之は善之は悪という風に篩い分けるということとは別だ。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
