        "examples": {
          "standard": [
            {
              "text": "新曲が大ヒットして、街中が彼の話題でもちきりになり、まさにフィーバー状態だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "パチンコでついにフィーバーを引き当て、周りの客からも注目を浴びてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "1970年代のディスコフィーバーは、当時の若者文化に多大な影響を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この曲はたちまちヒットチャートをかけ上がり、翌年二月七日に彼らがケネディー空港に降り立ってからは、すさまじいビートルズフィーバーが巻き起こります。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、で見た、マコーイズ（うっかり、マッコイズなどと発音すると、ワラに死ぬほど馬鹿にされる）の〈ハング・オン・スルーピー／フィーヴァー〉というシングル、そして、『ポップ・ギア』と同時上映になっていた、『五人の週末』という映画に出ていた、デイヴ・クラーク・ファイヴのＥＰを、友人の長兄にさしだした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
