        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "訪ねようとしているのはラクス東部の山脈に私有地をもつフェレンツィ男爵で、郵便はラクスのこの男爵気付で届くはずだとのことだった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "曰く、自分は現在の住処を離れることができず、一方、フェレンツィ男爵の城の状況は訪問に適していないと。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "中身はこうだった：フェレンツィ城一九二八年三月七日。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つはラクスの東にあるトランシルヴァニアの山岳地帯で起きた巨大な爆発で、悪い噂の絶えなかったフェレンツィ城が住人ごと根絶されたというものであった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
