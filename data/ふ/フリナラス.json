          "literary": [
            {
              "text": "しとしとと雨のふる夕かた、巫子が來て振り鳴らす鈴…………生鼠壁の黴に觸る外面の人靈の燐光。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "講堂の方で学校の小使が振り鳴らすベルの音は朝の八時頃の空気に響き渡りつつあった。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮山　よしよし私が――（棚の上の大きい鈴を取って振り鳴らす。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "振り鳴らす鈴の音も、凡な力ではないのだった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "主君の妹に指でもさしてご覧、おまえたちの首は、わたくしの母君が、半日だってそのままにしておきはしませんから」　と、鈴音を振り鳴らすように声を張っていった。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
