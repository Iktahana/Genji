        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "感情に任せて厳しい言葉をぶつけそうになったが、ぐっとこらえて踏みとどまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "借金をしてまで高級車を買おうとしたが、妻の説得でなんとか思いとどまり、購入を踏みとどまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "退職願をポケットに入れて出社したが、上司の顔を見るとどうしても提出するのを踏みとどまってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
