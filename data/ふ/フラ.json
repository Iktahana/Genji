    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hula (dance)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は健康づくりのために、毎週火曜日に近所のカルチャーセンターで開かれているフラの教室に通っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ハワイ旅行の最後の夜、ホテルのディナーショーで本場のダンサーたちが優雅に踊るフラに見入ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "地域の夏祭りのステージで、色鮮やかな衣装を着たおばあちゃんたちが笑顔でフラを披露し、観客から大きな拍手を浴びていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それは夢多かりし幼時を過ごしたフランドルの哀愁にも因るのであらう。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルスリーヌはフランス女流詩人中の第一人者であつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々は此のフランスのサッフォを、幼年用の教訓詩人とさへ思ひ誤つた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その教会は板で囲つてあり、六百坪位の庭園を有し、フランス人のからだの大きい、学者肌の神父がゐて、その神父は大きい望遠鏡を持つてゐて、甞て夏の静かな夕べ、その庭に立つて空の星を見せて呉れた。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "フライイング犯した罰として、他の選手よりは一米うしろの地点から走らなければならない。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はフランス叙情詩の講義を聞きおえて、真昼頃、梅は咲いたか桜はまだかいな。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たったいま教ったばかりのフランスの叙情詩とは打って変ったかかる無学な文句に、勝手なふしをつけて繰りかえし繰りかえし口ずさみながら、れいの甘酒屋を訪れたのである。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "孤高｜狷介のこの四十歳の天才は、憤ってしまって、東京朝日新聞へ一文を寄せ、日本人の耳は驢馬の耳だ、なんて悪罵したものであるが、日本の聴衆へのそんな罵言の後には、かならず、「ただしひとりの青年を除いて」という一句が詩のルフランのように括弧でくくられて書かれていた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手はフランスがよかろう。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君はたしかにずば抜けて語学ができる様子だから、僕たちの書いた原稿をフランス語に直しておくれ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ルフラン附きの文章か」つまらなそうにそう言って、スケッチブックをぱちんと閉じた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザール・フランクが、或はスクリャビンがやつたあの旋廻は、蓋し彼等の抽象情緒の周囲を旋廻したのである。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――このことがよく了解された時に、ベートーベンの、ドビュッシイの、フランクの、スクリャビンの、その各々の欠陥を点検する長々しい言葉は無用となる。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの場合に、外国人に好評される日本の者は、真の純粋の日本ではなく、彼等のフジヤマやゲイシヤガールの概念性に、矛盾なく調和して入り得る程度の、テンプラフライ式の似而非日本である。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか浅井和田両画伯の合作であったかと思うがフランスのグレーの田舎へ絵をかきに行った日記のようなものなども実に清新な薫りの高い読物であった。",
              "citation": {
                "source": "明治三十二年頃",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内容はすっかり忘れてしまったが、それを読んだときに身に沁みた平和で美しいフランスの田舎の雰囲気だけが今でもそっくり心に残っているようである。",
              "citation": {
                "source": "明治三十二年頃",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリに滞在中下宿の人達がある夜集まって遊んでいたとき「ノーフラージュ」をやろうと云い出したものがあった。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長がいきなり「ノーフラージュ（難船）」と怒鳴ると、移動がぴたりと止まるのである。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして妙にフラフラになつて「郭光」といつた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ醉ひの勇氣がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処に僕はゐて、お魚フライにレモンの汁をしたたか掛けて、これから食べようとしてゐたのです。",
              "citation": {
                "source": "夜汽車の食堂",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が美味しい美味しいと、そのお魚フライを食べてゐると、やがてツカツカと、白い大きい※ーレをかぶり、青い洋服に薄い焦茶のストッキングをはいた、大きなアメリカの小母さんが這入つて来ました。",
              "citation": {
                "source": "夜汽車の食堂",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊主の除れたフランスのセーラーの被る毛糸帽子。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "行李は私のようにフラフラしながら流れて行った。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス展の影響が著しく眼についた。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは普通の積雲とは全くちがって、先年桜島大噴火の際の噴雲を写真で見るのと同じように典型的のいわゆるコーリフラワー状のものであった。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばガラスなどは絹で摩擦すれば陽電気を帯びるがフランネルで擦れば陰電気を生ずる。",
              "citation": {
                "source": "猫六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
