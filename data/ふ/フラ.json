  {
    "uuid": "0bf33a21-fb51-5d90-a6ee-60ebaffc6e9f",
    "entry": "ふら",
    "reading": {
      "primary": "ふら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "長雨のふらくやまねば二荒の瀧見の旅を行きがてにすも根岸庵よりされ歌来る。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の通りつき当って右へまがり又右へまがりいつも先生の庭の方へゆく門の所までくると又ふらふらと気が動いて此門へはいった。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はただかぶりの動くのとへこ帯のふらふらするのをしばらく見つめておった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は民さんは何をしているかナと思い出すと、ふらふらッと書室を出る。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹽花こそふらね跡は一まづ掃き出して、若旦那退散のよろこび、金は惜しけれど見る目も憎ければ家に居らぬは上々なり、何うすれば彼のやうに圖太くなられるか、あの子を生んだ母さんの顏が見たい、と御新造例に依つて毒舌をみがきぬ。",
              "citation": {
                "source": "大つごもり",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いざ雪ふらば降れ、風ふかば吹け、我が方寸の海に波さわぎて、沖の釣舟おもひも乱れんか、凪ぎたる空に鴎なく春日のどかになりなん胸か、桜町が殿の容貌も今は飽くまで胸にうかべん。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくたまさかに取出るにも指の先こわきやうにて、はか／″＼しうは得も縫ひがたきを、かの人あらばいかばかり言ふ甲斐なく浅ましと思ふらん、など打返しそのむかしの恋しうて、無端に袖もぬれそふ心地す。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "我れはその袖をつと捉らへて放つ事をなすまじく、母は嬉しさに物は言はれで涙のみふりこぼし給ふや、父はいかさまに為し給ふらんなど怪しき事を思ひよる。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "渝らぬ契りの誰れなれや千年の松風颯々として血汐は殘らぬ草葉の緑と枯れわたる霜の色かなしく照らし出だす月一片何の恨みや吊ふらん此處鴛鴦の塚の上に。",
              "citation": {
                "source": "別れ霜",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "恭助は太く疲れて禮服ぬぎも敢へず横に成るを、あれ貴郎お召物だけはお替へ遊ばせ、夫れではいけませぬと羽織をぬがせて、帶をも奧さま手づから解きて、糸織のなへたるにふらんねるを重ねし寐間着の小袖めさせかへ、いざ御就蓐と手をとりて助ければ、何其樣に醉ふては居ないと仰しやつて、滄浪ながら寐間へと入給ふ。",
              "citation": {
                "source": "われから",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩花こそふらね跡は一まづ掃き出して、若旦那退散のよろこび、金は惜しけれど見る目も憎ければ家に居らぬは上々なり、どうすればあのやうに図太くなられるか、あの子を生んだ母さんの顔が見たい、と御新造例に依つて毒舌をみがきぬ。",
              "citation": {
                "source": "大つごもり",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "幻の寢臺薄暮の部屋つかれた心臟は夜をよく眠る私はよく眠るふらんねるをきたさびしい心臟の所有者だなにものか　そこをしづかに動いてゐる夢の中なるちのみ兒寒さにかじかまる蠅のなきごゑぶむ　ぶむ　ぶむ　ぶむ　ぶむ　ぶむ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはくびのない猫のやうで　墓場の草影にふらふらするいつそこんな悲しい暮景の中で　私は死んでしまひたいのです。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ　こんな陰鬱な季節がつづくあひだ私は幻の駱駝にのつてふらふらとかなしげな旅行にでようとする。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "をとめは戀戀の羞をふくんであけぼののやうに爽快な　別製の皿を運んでくる仕組私はゆつたりとふほふくを取つておむれつ　ふらいの類を喰べた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君よ君よ疲れて草に投げ出してゐるむつちりとした手足のあたりふらんねるをきた胸のあたりぼくの愛着は熱奮して　高潮してああこの苦しさ　壓迫にはたへられない。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "をとめは戀戀の羞をふくんであけぼののやうに爽快な　別製の皿を運んでくる仕組私はゆつたりとふほくを取つておむれつ　ふらいの類を喰べた空には白い雲がうかんでたいそう閑雅な食慾である。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅上ふらんすへ行きたしと思へどもふらんすはあまりに遠しせめては新しき背廣をきてきままなる旅にいでてみん。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さんさんとふきあげの水はこぼれちりさふらんは追風にしてにほひなじみぬ。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の感情ふらんすからくる煙草のやにのにほひのやうだそのにほひをかいでゐると氣がうつとりとする。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠く市街を離れたところでだれも訪づれてくるひとさへなく林間の　かくされた　追憶の　夢の中の珈琲店であるをとめは戀戀の羞をふくんであけぼののやうに爽快な　別製の皿を運んでくる仕組私はゆつたりとふほふくを取つておむれつ　ふらいの類を喰べた。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは首のない猫のやうで　墓場の草影にふらふらする。",
              "citation": {
                "source": "定本青猫",
