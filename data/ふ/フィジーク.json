        "examples": {
          "standard": [
            {
              "text": "彼は、ボディービルの大会でフィジーク部門に出場し、見事入賞した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は来月のフィジークの大会に向けて、徹底した食事制限とトレーニングで体を極限まで絞り込んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ボディビルとは異なり、フィジークでは筋肉の圧倒的な大きさだけでなく、Vシェイプのバランスやサーフパンツの着こなしも評価される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "メタフィジークが哲学と同じ言葉として慣用されている国（例えばフランス）は別として、日本などで自分の哲学を形而上学と呼んで欲しいと思っている哲学者は決して多くはない。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            }
          ]
        }
