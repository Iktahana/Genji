        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "プログラムを見ると、第五番「アメリカのフォクストロット」。",
              "citation": {
                "source": "踊る線条",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三はやがて食事を部屋へ持ちこませて、フォクを執ったが、葉子はコンソメの幾匙かを啜って、オレンジを食べていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　チキン・ソオテにフォクをつけながら、庸三は生返事をした。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その騒ぎの間に、一種｜生臭いような暖かい蒸気が甲板の人を取り巻いて、フォクスルのほうで、今までやかましく荷物をまき上げていた扛重機の音が突然やむと、かーんとするほど人々の耳はかえって遠くなった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "航海の八日目かに、ある老年の水夫がフォクスルで仕事をしていた時、錨の鎖に足先をはさまれて骨をくじいた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォクスルで起重機の音がかすかに響いて来るだけで、葉子の部屋は妙に静かだった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "井田は自分の室からソフォクレースの悲劇集を持つて來て開いて讀まうとすると、書生が來て湯の事を云ふので這入りに行つた。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "書齋の唐紙を開けると明るいランプの下に井田はソフォクレースを讀んで居た。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「唯今……湯に這入りましたか」と云つて相島は井田の机の上に眼をやつて、「其のソフォクレースの表裝は大したものですね」と腕を伸してそれを取つた。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソフォクレースの悲劇集の中にはさんであつた、内山の去年の夏の手紙の中の、「われとわが思ひ定めし人の行末は、知る人も知る神もなし……彼女は益※われに忠實なれば、わが心は切らるるが如し……煙を見よ」と云ふ樣な煩悶の句がちぎれ／＼に頭に浮んで來る。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソフォクリスが傑作を出して天下を驚かしたのは、ほとんど百歳の高齢だった。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟾蜍を欧人は大変な毒物とするところから拡げて、すべての悪性動物を制禁して生ずるなからしめたというたんだそうな（チャンバース『日次事纂』二、『フォクロール』五巻四号）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はボードレール、ヴェルレエヌ、ワイルドなどとともにウォーズウォースやミルトン、マーテルリンクを読み、フローベルやモーパッサンのためにソフォクレス、シャックンタラなどを忘れなかった。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "謙さんにソフォクレスを送ってもらいました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソフォクレスの悲劇について　よいクリスマスをあなたに祈ります。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソフォクレスのフィロクテテスを読みました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はソフォクレスはたいへん好きになりました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日もソフォクレスの彫像の写真を出してながめました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の為、ギリシア、テキストから訳したソフォクレス二巻、□□□□□二巻、チェックスロバキアの現代作家のものを集めたもの一冊、ハンデルのピアノアルバム、ヴェートウベンの歌曲を集めたもの等。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "フログネルセテレンとフォクセンコウレンの山へのぼる。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後もまたホテルに閉じこもり、仕事にもまだ手のつかないまま、結局、ソフォクレェスの悲劇を再びとりあげて、ずっと読んでしまった。",
              "citation": {
                "source": "大和路・信濃路",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その著書『民衆劇論』はなかなか傾聴すべき議論であつて、当時一部の活動家を刺戟して、危くソフォクレスの時代を夢想せしめたことは事実である。",
              "citation": {
                "source": "文学か戯曲か",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてソフォクレスにも、シェクスピイヤにも、コルネイユにも、シルレルにも、イプセンにさへも「メロドラマチック」な、「お芝居式」なものを発見して、それを弁護しようとするものがもうないではありませんか。",
              "citation": {
                "source": "演劇一般講話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはかえって鰻の蒲焼を西洋皿に盛って、ナイフとフォクを付けて出すようなものである。",
              "citation": {
                "source": "勝太郎",
                "author": "兼常清佐",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラトラン聖殿の黒布をまとった一ソフォクレスによって簡潔に言われた事柄が、今日では、真裸な姿を見せる猥らなメナードどもによって喚きたてられている。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "シューシェが「降伏せよ」と言う時に、パラフォクスは答える、「弾丸の戦いの後には刃物の戦いのみだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォクスルから海中へ、兵員が撥ね飛ばされた。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "とくに戦争の後1874年にフォクマンはハレの外科臨床における「リスター法」の素晴らしい成功について報告した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私はフォクスという、ベイスフォード警察の警部なんですが、今朝の新聞はごらんになったでしょう？",
              "citation": {
                "source": "予謀殺人",
                "author": "A CASE OF PREMEDITATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フォクス警部はこたえた。",
              "citation": {
                "source": "予謀殺人",
                "author": "A CASE OF PREMEDITATION",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
