        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また次に聖なる爽明の女神はフォスフォロス（Fosforos）（注五）を生みぬ。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、今ここに素人にも解りやすい一、二点を例示すれば、アリストーテレスと同時代のエフォロスの「クレート誌」には、石壁法で始めて定められた法則の事を書いているから、アリストーテレス時代より前に出来たものであるとのこと。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロメトイスの亦の名はピルフォロステオスと云う。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリクレトの『ドリフォロス』だ。",
              "citation": {
                "source": "金色の死",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
