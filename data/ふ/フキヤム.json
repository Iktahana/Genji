        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ようやく嵐が吹き止み、雲の間から日の光が差し込んできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "風が吹き止むのを待って、ドローンを離陸させる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "あれほど荒れていた海も、風が吹き止むと鏡のように静まり返った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "蚊遣の煙古井戸のあたりを籠むる、友の家の縁端に罷來て、地切の強煙草を吹かす植木屋は、年久しく此の森に住めりとて、初冬にもなれば、汽車の音の轟く絶間、凩の吹きやむトタン、時雨來るをり／＼ごとに、狐狸の今も鳴くとぞいふなる。",
              "citation": {
                "source": "森の紫陽花",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "木枯しがだんだん吹きやむと共に東の空もうす明かるくなって来たので、三人は自分たちのあゆんでいる路筋がおぼろげに判って来た。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その嵐が吹きやむと間もなく暖かい春が訪れてくるであろうか。",
              "citation": {
                "source": "子どもの世界",
                "author": "村山俊太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七日は午後まで風が強く、林の枝が鳴るくらいだったが、吹きやむと共に、ひとかけの雲もないほどに晴れて、夕空は眼をおどろかすばかり、美しかった。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
