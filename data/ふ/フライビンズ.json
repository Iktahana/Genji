          "literary": [
            {
              "text": "ラムネをのみ、フライビンズをかじり、写真が佳境にはいって来ると、よう！",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大ジョッキとフライビンズを註文し、息の根の停りさうな苦しさを我慢しながら、三分の一ばかり飲んで、ゲエーとおくびを出して、フーフー赧い顔で唸つてゐると、いきなり耳を引つ張られた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代りソバ以外に肴は何もなく、フライビンズや金平糖のたぐいを近くの小店から買って来て貰うのだった。",
              "citation": {
                "source": "庶民生活",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
