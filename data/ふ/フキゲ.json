          "literary": [
            {
              "text": "Ｙも出がけフキゲンであった。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（手入れ）　夜、食後、又仕事、十時すぎやめ、自分何だかフキゲンになった。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "不安なり、フキゲンでもある。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "不キゲンなり、そしてフキゲンなことを恥辱とも思わぬらしく人に当る。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十八日（火曜）　Ｙ、フキゲンなり、　散歩、ふみ子洗髪のまま出た。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○自分寂しいときＹはフキゲンとなって怒る。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに自分は又、ああいう状態であったから、余り気の利いた迎えようもせず、ためにＹまるでフキゲンなり。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二十八日（日曜）　Ｙ今日又朝からフキゲン。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、午後になってもフキゲン。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "フキゲンだし、しょげた手紙だ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ときいた時フキゲンそうに「知らない」と云ってたわけだ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙の小さい表現、フキゲンの表現などにそれほど動かさるべきではないのだ。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだったか」　花田はフキゲン千万な面持だった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
