    "definitions": [
      {
        "index": 1,
        "gloss": "driftwood",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "嵐の後の海岸には、たくさんの浮木が打ち上げられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は海岸で拾った浮木を組み合わせて、ユニークなオブジェを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "無人島に漂着した男は、浮木を集めて火をおこし、暖をとった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "』と言ふ中、浮木がグイと沈んだから合すと、餌釣としては、中々大いのが上つた。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に餌の中でも、御馳走の川蝦は、あの松がしんせつに、そこらで掬って来てくれたんで、それをちぎって釣る時分は、浮木が水面に届くか届かぬに、ちょろり、かいず奴が攫ってしまう。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな御幣の、廻りながら、遠くへ離れて、小さな浮木ほどになっていたのが、ツウと浮いて、板ぐるみ、グイと傾いて、水の面にぴたりとついたと思うと、罔竜の頭、絵ける鬼火のごとき一条の脈が、竜の口からむくりと湧いて、水を一文字に、射て疾く、船に近づくと斉しく、波はざッと鳴った。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト雪枝の作品と並べた処は、恰も釣糸に繋けた浮木が魚を追ふ風情であつた。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すこし飽きて来て、もう浮木の方へは眼もくれず、足もとに乱れて咲いている草の花などをながめているうちに、ふと或る小さい花が水の上に漂っているのを見つけた。",
              "citation": {
                "source": "水鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな御幣の、廻りながら、遠くへ離れて、小さな浮木ほどに成つて居たのが、ツウと浮いて、板ぐるみ、グイと傾いて、水の面にぴたりとついたと思ふと、罔竜の頭、絵ける鬼火の如き一条の脈が、竜の口からむくりと湧いて、水を一文字に、射て疾く、船に近づくと斉しく、波はざツと鳴つた。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その替りの外題は「優曇華浮木亀山」の通しで、切に「本朝廿四孝」の十種香から狐火をつけた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "人形使い",
                "note": "青空文庫"
              }
            },
            {
              "text": "通し狂言の「浮木亀山」は、いうまでもなく石井兄弟の仇討で、紋作は石井兵助をつかい、冠蔵はかたきの赤堀水右衛門を使っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "人形使い",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは阿波の鳴門の渦に巻込まれて底へ底へと沈むようなもんで、頭の疲れや苦痛に堪え切れなくなったので、最後に盲亀の浮木のように取捉まえたのが即ちヒューマニチーであった。",
              "citation": {
                "source": "二葉亭追録",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛行島の前後左右は、それをまもる艦艇がぐるっととりまき、一片の浮木も飛行島に近づけまいとしている。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼に行かれては、漢青年は浮木にひとしかった。",
              "citation": {
                "source": "西湖の屍人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私事かの浮木の亀と申ハ何やらはなのさきにまいさがりて、日のかげお見る事ができぬげな。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年四月初旬　坂本乙女あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等が尋ねた時は、丁度午時で島吉が帰つて来て火を焚いて居たが、其の焚火の料と云ふは、女房が渡良瀬へ膝まで浸つて、浮木を拾つて積んで置くのだと云ふ。",
              "citation": {
                "source": "政治の破産者・田中正造",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お姫様には神通力、お鏡を通して浮世の相を、ご覧になることが出来ましょうが、この浮木はほんの凡人、何にも見えませんでございます。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はい」と云うと老女の浮木は逞しい声で呼ばわった。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち他ならぬ浮木であった。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「民弥という娘を捕らまえて、唐姫様のお言葉を、是非ともお伝えしなければならない」　こう云ったのは浮木である。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「丁寧にあつかうでございましょう」「南蛮寺の裏の貧しい家に、住居をしているということだ」　またも浮木は云い出した。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあそれが心配でね」浮木の声は心配そうである。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも浮木の一団が、民弥の居場所を探し出すかしら？",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "他でもない浮木である。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……がそれは後でお訊ねするとして、大丈夫でござるお助けいたす」　ここで浮木は庭師達を見たが、「あいや方々お聞きの通り、人買共が民弥殿を、誘拐そうと致したそうな。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮木の姥の傍に立って、乱闘を見ていた娘の民弥が、何と思ったか身を飜すと、町の方を目掛けて一散に、野草を蹴散らして走り出したのである。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰天したのは浮木の姥で、「民弥殿、民弥殿、逃げてはいけない。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮木の姥が走って来て、その連中とぶつかった時、大体身分の見当が付いた。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」こう云ったのは浮木である。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「珍らしいの、浮木の姥か」　こう云って進み出た壮漢は、この一党の頭と見え、荒々しい顎鬚を顎に貯え、手に鉄棒をひっさげている。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うむ」と云ったが浮木の姥は、かなり周章た様子であった。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「唐姫殿が欲しいからよ」「ふふん」と浮木は嘲笑った。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「が、腕ずくでも手に入れて見せる」　浮木の姥はまた笑ったが、「我等の勢力を知らぬと見える」　すると左門も笑ったが、「そういうことを云うお姥こそ、我々の勢力を知らぬと見える。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
