        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――すなわち船長服、携帯用の床几、小形の望遠鏡、煙草の鑵、いくつかのパイプ及び水煙管――ちなみに、この水煙管は船長が戦争に参加したというミルン氏の物語に少しく色をつけるが、その連想はむしろ当たらないらしい。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒い長服を着て、すっかり宣教師タイプに出来ていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ノ井も川上も艇長服を着たがいこつには、びっくりして顔色をかえたが、わけのありそうながいこつ艇長のようすに、こわいのをがまんして、紙きれに書いてある文句をひろって読んだ。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長服を身に纏い、船長の帽子を冠っている。",
              "citation": {
                "source": "死の航海",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒ビロオドの長服に、宝石のボタンをつけるなど、いかめしい人物だった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "エセックスは黒い帽子に黒い長服の姿で、三人の僧職を伴いながら現われた。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "願わくば、列席の諸卿、わが祈りに諸卿の魂を和し給え」　彼は息を入れ、長服を脱ごうとした。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はそれを果たし、それから長服と襞襟を脱ぎ捨てると、黒の胴着一つになって、首台の前に膝を折った。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かがわたくしに白い長服を着せました。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
