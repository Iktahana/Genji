[
  {
    "uuid": "eaa8771d-7ada-5c5d-be9d-7a3c8df7f02a",
    "entry": "ふて腐れ",
    "reading": {
      "primary": "ふてくされ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
