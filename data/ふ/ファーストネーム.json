        "examples": {
          "standard": [
            {
              "text": "初対面の人と話す時、まずはファーストネームで呼び合うと親近感が湧きやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "海外では、ビジネスシーンでもファーストネームで呼び合うのが一般的だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女のファーストネームは珍しいが、とても響きの良い名前だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "スティーヴ・ウィンウッドは、いまや、ジョン、ポール、ジョージ、リンゴとおなじく、ファーストネイムだけで呼ばれる存在になった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうは、義隆という、ごついファーストネイムをもっている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝口です」「慶一、おれだ」　最近は、ファーストネイムで呼びかけて、オレだ、などという人間は、そうたくさんいるわけではない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
