          "standard": [
            {
              "text": "電子は負の電荷を持っており、正の電荷を持つ原子核の周りを回っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "静電気が発生した際、プラスチックの下敷きは負の電荷を帯びやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このイオンは負の電荷を持っているため、陽極に向かって移動する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "通常の原子とは逆に、負の電荷を持った電子の周囲を正の電荷を持った陽子が回転しているという反物質はの構成要素ではあり得ないだろう。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
