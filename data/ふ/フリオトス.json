[
  {
    "uuid": "7694a65a-e8de-5ad9-bb1e-f91cdf9bf071",
    "entry": "振り落とす",
    "reading": {
      "primary": "ふりおとす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
