        "examples": {
          "standard": [
            {
              "text": "このオーディオシステムは、原曲のフィデリティー（忠実度）を損なわずに再生できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ハイレゾ音源は、CDよりも高いフィデリティーで音楽を楽しめる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「コンサートホールの臨場感を再現するには、高いフィデリティーが求められる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ハイ・フィデリティのビクター、ヴィヴァ・トーナルのコロムビア、ポリファのポリドール、それぞれの特色はあろう。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビクターのハイ・フィデリティ録音は、分離の美しさと、立体感においては、驚くべき域に達している。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
