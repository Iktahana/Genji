        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "戸外には風の音、さらさらと、我家なるかの楓の葉を鳴して、町のはずれに吹き通る、四角あたり夕戸出の油売る声｜遥なり。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何をしに自分は来たのだ」　街へ出ると吹き通る空っ風がもう人足を疎らにしていた。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こやつが軒下をカラカラと吹き通るようになると、奇態なものできっと火事がある。",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "涼しい風が玄關からも、裏庭からも吹き通る。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の間を吹き通るのは、涼しい暁の風である。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月十五日（土曜）　快晴、すずしく寒い西南の風が吹き通る。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのすき間を風が吹き通るとき笛のように小音を立てる。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "田圃向うの杉の森を掠めて、白い風が弗、弗と幾陣か斜に吹き通る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりにこうもいえるなら、深い地の底で地虫が鳴くような、高い梢を微風が吹き通るような、何とも形容出来ぬ仄かな状態でどこからともなく響いて来る。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "安部は流血の場からそろそろと退却し、船室の扉に鍵をかけて冷たい風の吹き通る遊歩甲板へ出ると、今晩もまたお祭りがあるのだとみえ、舞踏室のほうからさかんなジャズの音がきこえてくる。",
              "citation": {
                "source": "予言",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "また数日の後、風の良く吹き通る二階で、私は友と、その母親と、ねそべりながら話している。",
              "citation": {
                "source": "おみな",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "また数日の後、風の良く吹き通る二階で、私は友と、その母親と、ねそべりながら話してゐる。",
              "citation": {
                "source": "をみな",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "山寄りの土地だからただでも寒気がきびしいのに、カラッ風が最高潮に達して吹きまくっているから校舎は鳴動し、ストーブにいくら石炭をついでも、一陣の隙間風が吹き通ると、鋭い刃物で骨のシンまで斬られたような痛みを覚える。",
              "citation": {
                "source": "牛",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "涼しい風の吹き通る甲板で〈アリアーヌと青髯〉のロマンスを聞きながらラムネを飲んでいると、あまり楽しくて戦争に負けたことをふと忘れている瞬間がある。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽田の空港とそっくりな、風の吹き通る広々とした構内をドライヴして行くと、間もなく司令部の建物が見えてきた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "睾丸が凍えるわ」　師走からこのかた湿りがなく、春とはほんの名ばかり、筑波から来る名代の空ッ風が、夕方になると艮へまわり、梢おろしに枯葉を巻き土煙をあげ、斬りつけるようにビュウと吹き通る。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "初春狸合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲の上の散歩　新聞記者の一団を置きざりにして、『アラミス』を飛びだすと、狭い通りを吹き通る風のあおりで、サト子はそこにパークしている車にぎゅっとおしつけられた。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから、灰色の雲が破れて、息の吹き通るような穴の出来るのを待っているようだ。",
              "citation": {
                "source": "悪魔",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は涼風の吹き通る旅館の部屋で、ビールを汲み交わしながら、来年の花時に妻の故郷を訪ねようと、話を決めた。",
              "citation": {
                "source": "落日の光景",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなことを書くのは、よしたまえ」　初夏の風の吹き通る十二畳の日本間。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人で来るんでもあるまいし、……だけれど、来たら放っちゃおけないよ」　この家へ、おつまさんが京都からもって来るある空気が吹きとおるのだろうか。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "空の高みをそよ風が吹きとおるように、どこからともなく漂い寄ってくる感じで、かそけくもまたほのかに、白川の耳うらにひびいてくるふうであった。",
              "citation": {
                "source": "雲の小径",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "身体のうちが爽やかで、頭のなかを風が吹きとおるように思われた。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "節子は胸の中を風の吹きとおるような、爽やかな気持で彼の眼を見あげた。",
              "citation": {
                "source": "おばな沢",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹きとおる風だけが爽やかであった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
