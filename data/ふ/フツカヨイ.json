[
  {
    "uuid": "2989f216-7f8e-5c4f-8bac-6db9fcc61d77",
    "entry": "二日酔い",
    "reading": {
      "primary": "ふつかよい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
