  {
    "uuid": "eee14d99-478e-5c6d-a03e-1f9a04874be3",
    "entry": "付従",
    "reading": {
      "primary": "ふじゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どこまでも付従いて行ったら生命を取られるかも知れねえだ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこまでも忠実に付従して来るはいいとしても、まさかに手洗い所までものそのそついて来られては迷惑を感じるに相違ない。",
              "citation": {
                "source": "案内者",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、人ノ子女ヲ金談上ヨリ養女ノ名目ニ為シ娼妓芸妓ノ所業ヲ為サシムル者ハ其実際上則チ人身売買ニ付従前今後可及厳重ノ所置事。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "無智無識の青年輩が、糊口の策に苦んで何か依頼者あらば、之に依て己が目下の窮乏を救ひ、歳月を経過する内には、何か僥倖もあらんもの位にて、意を迎へ説を作て、附従するとも知らず、断金の交友と認め、他日志を得て、内閣を組織するの時には、股肱の輔翼となる者かと、馬鹿々々しき夢を楽むに外ならざるべし。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
