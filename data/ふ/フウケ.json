          "literary": [
            {
              "text": "四、フウケーボー大｜博士はあくびといっしょにノルデの筆記帳をすぽりとのみ込んでしまった。",
              "citation": {
                "source": "ペンネンノルデはいまはいないよ　太陽にできた黒い棘をとりに行ったよ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、さすがのフウケーボー大博士も命からがらにげだした。",
              "citation": {
                "source": "ペンネンノルデはいまはいないよ　太陽にできた黒い棘をとりに行ったよ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅苦しいフウケでもなかろう。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴎外が犯罪小説に訳筆を揮ひながら、なぜノヴァリスやフウケエを訳さなかつたか。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
