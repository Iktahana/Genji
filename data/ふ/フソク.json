    },
    "definitions": [
      {
        "index": 1,
        "gloss": "insufficiency",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "食料の不足により、多くの人々が飢えに苦しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は経験不足ながらも、その仕事に果敢に挑戦した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このプロジェクトは予算不足で、計画通りに進めるのが難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "で、問題は、カマを掛ける資格が、Ａに不足してゐたといふことなのだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手は次第に気の毒さうにしはじめ、そのうち少し私を「脳不足」だといふ意味の目配せを主人やお主婦さんと交すやうになつた。",
              "citation": {
                "source": "西部通信",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "顧ふに、彼こそ「若い人に同情心は不足勝なものです」と言はれる場合の、その「若い人」である……）　扨、私は近代病者の一例を御紹介するが、その前に一言前置きしなければならない。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "親父は俺を長男に持つて不足を言ふ所はない！",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィンは、その夢が王の思うほどよい夢ではない、眠りの不足のせいでなければそれは王の身の上にかかる事だと言った。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にも土民狩と言つて人民を小鳥か何かのやうに取扱ひ弓等で射殺し、今日は獲物が不足だつたとか、多かつたとかで喜んで居たりしたことは鬼と言つてもまだ言ひ足りない気がする位である。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これだけぢや、不足なんですか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "べつに不足だなんて考へてやしないよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "物資不足は、私だつて知つてゐる。",
              "citation": {
                "source": "貪婪禍",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はなんのかのと、不足は言いながらも、しんみりと落ち着いた心持ちで、花袋が読めた。",
              "citation": {
                "source": "紀行文家の群れ",
                "author": "――田山花袋氏――",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜は、この旅行で、初めての野宿で、睡眠不足であったためか、私は眠くなった。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その私たちの登山にしてからが、時間不足のために、絶頂の剣ヶ峰ともいうべき、シャスタ・ピークまでは、達しなかったのだから、一個の予察地形図をスケッチしたぐらいの、軽い気分で読んでいただきたい、何も登山記だからと言って、死に身になってコチコチと緊張しなければならない、というものでもなかろう。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "視力の不足なのは、幼少の時からの絶えざる栄養不良と、不足から来たのであつた。",
              "citation": {
                "source": "遺言文学",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "稲の正当な発育には一定量の日照並びに気温の積分的作用が必要であって、これが不足すれば必ず凶作が来る。",
              "citation": {
                "source": "新春偶語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手の山や岳神を詮議して、とかくそれ等に不足を見付け出した。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "轍に踏まれて躍る橋板の上を曳かれて行くと、夜行で寝不足の瞼が涼しく拭われる気持がする。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども理由を運動の不足になすり付けてしまって、せっせとスポーツすれば癒る。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の二つは意味が不足しているし、 wit は意味が過剰である。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、審査の重責に在る者は、あまりに消極的な考えから、ひたすらに欠点の見落しを惧れるよりも、更に一層長所と美点に対する眼識の不足を恥ずべきではないかと思われるのである。",
              "citation": {
                "source": "学位について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだって民さんに不足を云う訣ではないよ」　民子はせきこんで、「そんな事いうはそりゃ政夫さんひどいわ、御無理だわ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの通り温和しかった民子は、自分の死ぬのは心柄とあきらめてか、ついぞ一度不足らしい風も見せなかったです。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の一昨年うせたる時も、母の去年うせたる時も、心からの介抱に夜るも帯を解き給はず、咳き入るとては背を撫で、寐がへるとては抱起しつ、三月にあまる看病を人手にかけじと思し召の嬉しさ、それのみにても我れは生涯大事にかけねばなるまじき人に、不足らしき素振のありしか。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢さら二タ心は持たぬまでも、我が良人を不足に思ひて済むべきや。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ残念に思うのは、外国の多くの実例と比較したときに感ぜられる音楽の容量の乏しさと、高く力強く盛り上がって来るような加速的構成の不足である。",
              "citation": {
                "source": "映画雑感（５）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお不足な空気は箱の一部に圧搾した酸素が必要に応じて少しずつ補われる仕掛けになっている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時僕が怒つたのは、家鴨の卵から鷄が生れたと言つて腹を立てたやうなもので、今思へば我ながら認識不足の滑稽である。",
              "citation": {
                "source": "悲しき決鬪",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは作者と私との趣味の相違や、私の讀み方の不足や、作者の技巧の未完成が混り合つて原因してゐるのであらうが、そんな個所は末梢的であつて、何よりも私はこの作品を貫いてゐる作者のまともな精神に觸れて心強く思つた。",
              "citation": {
                "source": "『新潮』十月新人號小説評",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「少し風過ぎる事」と、自分でらふそくに灯を入れる。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、いくら小さいとはいっても、お妃をむかえるのに、ふそくなほどではありませんでした。",
              "citation": {
                "source": "ブタ飼い",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこでも、ふそくを言わるるにわ、わしも、へいこを。",
              "citation": {
                "source": "盲人独笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "dissatisfaction",
        "register": "standard",
