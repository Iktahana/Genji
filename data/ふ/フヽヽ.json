        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「フヽヽ、言ふと、みんなが呉れ呉れ言ひ出すから嘘を言ふちやつたい。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フフヽヽ」と笑つて見た。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂ　ウフヽヽヽ、それからまだ斯ういふ話があるよ。",
              "citation": {
                "source": "ハガキ運動",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「こゝんところに、つまり、その猛獣が――かね、こゝんところに脚をかけると、フヽヽヽツ、このバネがはづれて――」「がつちりと脚をくわへてしまふといふ仕掛けなんですな。",
              "citation": {
                "source": "Ｆ村での春",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヤちゃんの入学祝いよ」「ウフヽヽヽヽ」とカヤノは胸を張った。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "フヽヽ無理はないよ。",
              "citation": {
                "source": "戦争指導者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "×「フヽヽ何方だつて、お前毎日のやうに宅へ来てえるぢやアねえか、大坂町の近江屋金兵衛だよ。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近江屋「フヽヽ其様なお顔と云ふものもねえもんぢやアねえか、何にしても眼の明いたは共に悦ばしい、ま結構な事で。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近「フヽヽあれは乾柿だ。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近「ウフヽヽ、アハヽヽ梅喜さん腹ア立つちやアいけないよ、お前ん処のお内儀さんは失敬だが余り器量が好くないよ。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近「フヽヽ何んな工合だツて……あ彼処へ味噌漉を提げて往く何処かの雇ひ女が有るね、彼よりは最う少し色が黒くツて、ずんぐりしてえて好くないよ。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近「フヽヽあれは飴やだよ。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近「フヽヽ何だい、見ともない、鳩がゐるんだ。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "長「フヽヽ返事が面白いな……さ此方へ来い。",
              "citation": {
                "source": "にゆう",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "弥「フヽヽ「ヒヂ」は道具商より畳職の方がつよいで。",
              "citation": {
                "source": "にゆう",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "長「フヽヽ其の桟留縞の布子に、それで宜い、袴は白桟の御本手縞か、変な姿だ、ハヽヽ、のう足袋だけ新しいのを持たしてやれ。",
              "citation": {
                "source": "にゆう",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴村博志は、すこし割り切れぬまゝに、釣り込まれて、ウフヽヽヽと笑つた。",
              "citation": {
                "source": "記憶のいたづら",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフヽヽヽヽ」　と、楯氏は、喉の奥で笑つた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフヽヽヽヽ」　楯氏の喉が、また鳴つた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「手が塞がつてゐるんですもの、足で障子を開けたところを、ウフヽヽ」　さう言ふお粂です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鬼女",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それをいうの、かなしいんですもの……　といって、そッと目を伏せるようにしたかと思うと　――ウ、フ、フヽヽ……　と、急に、おさわは、いかにもおかしそうに、声をだしてわらった。",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかも君、すごい美人がいてね……フヽヽ。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいていの奴は、この「フヽヽ」を変な意味に解釈して「お安くないぜ。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウフフヽヽヽ、感心感心、もう少しのしんぼうだ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
