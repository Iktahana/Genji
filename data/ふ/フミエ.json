        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代、幕府はキリシタンを発見するために踏み絵を強制した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "長崎の博物館には、当時使われていた踏み絵が展示されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "信仰を守るために、多くのキリシタンが踏み絵を拒否し、殉教した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "あの踏み絵を発明したのはあの男じゃからな。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ紹介というわけでもないが、何せそういうわけで、今までの紙の踏み絵じゃ一向役に立たぬで、何か彫り物で、いつまでもそのありがたいお像がはっきり残るような物を作る工人はなかろうかとあの男がわしのところへたずねに来たもんじゃ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて彼は思い切って自己に対する自棄な反逆から、奉行に身を売り、切支丹さがしの犬となり、踏み絵の法を案出して、奉行の歓心を得ようとした。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「踏み絵のことでしょう。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「というのは、ご存じのとおり、踏み絵のしらべは毎年正月の末に行なわれることに定まっているんで、なるべくならば来年のそれに間に合わせたいと思うんです。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからその中のいくつかは踏み絵につかわれても他の別のを残しておけるでしょう。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれが作るその踏み絵をあの人も、そしてあの弟、――立派な思想と信仰とを抱いたあの美しい有為な青年も踏むことをしいられることになるのだ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの人は今まで幾度となくあの踏み絵の試煉を経て来たのだ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「踏み絵にするといなとはとにかくとして、おれはあれをとにかく作ろう。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃ、月末の踏み絵式までにはなんとか間に合いますな。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "踏み絵の目的に成功したわけじゃないか？",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もしこの人がほんとにそうだったらなんで自分の仲間を殺すような踏み絵なんぞを作るだろう！",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしておれを切支丹だと疑うならおれはあの踏み絵を自分で踏んでやろう。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ところがあの踏み絵を作った者の罪は、それを踏まない者の罪よりは重いんだそうだ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それならいったい踏み絵というものの意味はどこにあるんだろう！",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなことならわざわざ面倒な踏み絵なんぞを踏ませなくったって疑った者をただ片っぱしから殺して行きゃいいわけじゃないか。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とにかく踏み絵を踏まない者は処刑をうけるのが掟だ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし君たちが僕を疑り出したのは君たちに頼まれたので僕が作ったあの踏み絵からではないのか。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度の踏み絵の調査においてじゃ、君の傑作がもしわれわれの不吉な想像を裏切らなかったら、君は自分の仕事の成功の証明に免じて瞑してくれなければならぬ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩長崎の町には、踏み絵の鋳造者萩原裕佐が「特別なお慈けをもって」ひそかに斬罪に処せられるそうだといううわさがひろまった。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九　正月の二十八日から三十一日まで、四日間にわたって踏み絵の儀式は奉行所において荘重に行なわれた。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "水を打ったごとき式場の中央に藁莚を敷き、その上に低い台を置き、さらにその上に踏み絵は置かれてあった。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日いつものとほり先生に引率されてすかんぽ山へ運動にいつたときに彼はひとり藪のなかへはひつて一所懸命犬じらみをとつてるので　またなにかいたづらをするな　と思つてたら、やがて両方の手にいつぱい犬じらみを握つて武智光秀といふみえで眼玉を光らせながら出てきた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の長崎にて切支丹の御検分ことのほか厳しくなり、丸山の妓楼の花魁衆にまで御奉行、水尾様御工夫の踏絵の御調べあるべしとなり。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "当日の模様、物珍らしきまゝに、われも竹矢来の外の群集に打ちまじりて見物するに、今しも丸山一の大家、初花楼の太夫職にして、初花といふ今年十六の全盛なる少女が、厳めしき検視の役人の前にて踏絵を踏む処なりとて人々、息も吐きあへず見守り居る体なり。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "金襴、刺繍の帯、裲襠、眼も眩ゆく、白く小さき素足痛々しげに荒莚を踏みて、真鍮の木履に似たる踏絵の一列に近付き来りしが、小さき唇をそと噛みしめて其の前に立佇まり、四方より輝やき集まる人々の眼を見まはし、恐ろし気に身を震はして心を取直し居る体なり。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そを懸命に踏み堪へて、左褄高々と紮げ、脛白き右足を擡げて、踏絵の面に乗せむとせし一刹那、「エイツ……」　と一声、足軽の棒に遮り止められ、瞬く間に裲襠を剥ぎ取られて高手小手に縄をかけられつ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの仰言り方があんまり突然で、何んだかあたし、踏絵を命ぜられたみたいに思えたんですもの。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「踏絵か、なるほどね。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたの身代りに、僕が踏絵をしようというときだったのに。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
