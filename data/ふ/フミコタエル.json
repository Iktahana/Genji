    "entry": "踏み堪える",
    "reading": {
      "primary": "ふみこたえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-ア行",
      "inflections": null,
