        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "プラットフォムに降り立ったら、なんだかすべて、けろりとしていた。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぞろぞろと汽車から下りる、またプラットフォムを駈けて来る。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人は別離の哀しさに興奮し、汽車の切符をとんでもない処にしまって忘れたり、トランクの蓋を何度も開けたりしめたりして、中の品物をこぼしたりした揚句、汽車がついたので泣き顔で何度もぼくのほうを振返りながら、子供の手をひき、プラットフォムを走っていった。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車が小諸を離れる時、プラットフォムの上に立つ駅夫等の呼吸も白く見えた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人は線路を越して、下りの汽車を待つべきプラットフォムの上へ出た。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "君なんかも早く切上げて了いたまえ」「君はそういうけれど、僕は外に仕方が無いし……生涯エジトルで暮すだろう……これも悪縁でサ」と言って、記者は赤皮の靴を鳴らして、風の寒いプラットフォムの上を歩いてみた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "上りの汽車が停まるべきプラットフォムのところには、姉夫婦を待受ける人達が立っていた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "三吉夫婦はプラットフォムへと急いだ。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "細長いプラットフォムを歩いて行くにしても、それから国府津行の二等室の内へ自分等の席を取るにしても、どこかこう軽々とした、わざとらしくなく敏捷なところが有った。",
              "citation": {
                "source": "船",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅のプラットフォムに沢山な労働者が塊って、誰も動かず蹲んだまま汽車を見ている。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫と白のユニフォムをそろへた「Ｗ」、海老茶と黄の「Ｐ」、そして緑と真紅の「Ｈ」大学の選手団は、夫々の出場口から、ブラス・バンドを先頭に、国旗席の前に整列して、大統領の握手を待つた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "院長や、医員や、看護婦たちが容易ならぬ気勢であちこちと立ち廻っている間に、私はクロロフォムの壜と、マスクの用意をしました。",
              "citation": {
                "source": "麻酔剤",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、私が感動のあまり度を失って、マスクをぴったりと口へ当てなかったために、その隙間から空気が入りすぎて、クロロフォムの吸入量が少なかったからです。",
              "citation": {
                "source": "麻酔剤",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "女のすうすういう呼吸がクロロフォム臭くなって来て、もうすっかり麻酔におちたのです。",
              "citation": {
                "source": "麻酔剤",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は大急ぎでマスクへまた数滴のクロロフォムを垂らしました。",
              "citation": {
                "source": "麻酔剤",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は更にクロロフォムを四滴、五滴とつづけざまにマスクへ垂らして、それを女の顔へひしと押し当てました。",
              "citation": {
                "source": "麻酔剤",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にしても、もっとよく麻酔らせて、彼女を黙らせなければならぬので、私は矢つぎ早にクロロフォムを垂らしました。",
              "citation": {
                "source": "麻酔剤",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "列車はまたも上尾を出でて、疾風のごとく馳せつつ、幾駅か過ぎて、王子に着きける時、プラットフォムの砂利踏みにじりて、五六人ドヤドヤと中等室に入り込みぬ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次ぎの駅に着くと、私は真先きにプラットフォムに飛び下りて、一人でサンドウィッチを沢山買って来た。",
              "citation": {
                "source": "麦藁帽子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は混雑したプラットフォムの上を歩き出しながら、何度も振りかえって汽車の中にいる彼の方を見た。",
              "citation": {
                "source": "燃ゆる頬",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "『イッヒ・コンメ・フォム・ゲビルゲ・ヘル』なんて、まるで叱られてるようなもんで。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
