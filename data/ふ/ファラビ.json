          "literary": [
            {
              "text": "次で現われたファラビは九世紀の後半にトルキスタンのファラブで生れ、早くよりバグダードに来てアラビア語とギリシア哲学を学び、やがて自ら講義するに至った。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はファラビの立場から出発しつつアリストテレースの教説に還って行った。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "がそれはファラビがバグダードで論理学の講義をしていた頃なのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
