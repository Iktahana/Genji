        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "暗号解読家のフランソア・ヴィエトやロッシニョールは？",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "指先に触つたのは煙草では無くて、矢張その頃の文士の一人フランソア・コツペエの詩集であつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして受附の男を見ると急に悲しさうな顔をして、「フランソア・コツペエが亡くなりました。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "『戀ゆゑにそんな悲哀と苦惱とを得た』とフランスの詩人フランソア・※ロンには歌はれ、死後には翼を比べた形を彫刻にまで造られて、それを戀とも哀傷ともされ、たゞ／＼二人にあやかりたいやうな男や女の語り草となる。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里をフランソア・コツペが書き、東京をピエル・ロチが書いて居た。",
              "citation": {
                "source": "一國の首都",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で本家本元と言つても好いフランス文学ではバルザツクあたりにその萠芽を発して、アルフオンス・ドウデエ、フランソア・コツペイ、ゾラ、それからモウパツサンの巨匠へと行つた。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フランソア一世だか八世だか、世の中にこれほど美味いものがあろうかと云って、どんなにお附きの者がとめても台所へ走って行って、こ奴にかぶりついたということだが、全くこれだけはやめられないね。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者礼拝　　　　　　フランソア・コペエさても千八百九年、サラゴサの戦、われ時に軍曹なりき。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者　礼拝　　　　　　フランソア・コペエさても千八百九年、サラゴサの戦、われ時に軍曹なりき。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "譯者フランソア・コペエ禮拜さても千八百九年、サラゴサの戰、われ時に軍曹なりき。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "この外に、水夫のフランソアとラルサンの二人。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "リーフへのしあげちまった」　水夫のフランソアがさけんだ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはゆだんがならないぞ」　このざわめき話に、水夫のフランソアとラルサンの二人は、絞首台の前に立った死刑囚のように青くなった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアとラルサンの二人はしめしあわせて、こそこそ後じさりをはじめた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、一ぱい行こう」　そういったのは、水夫のフランソアであった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして水夫のところへ行って、「おい、フランソア。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "分ったか、フランソアにラルサン」　と、二人の肩を、いくどもたたいた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴかぴか光っていらあ」「ほんとに、あれは金貨らしい光だ」　フランソアとラルサンが、小さい暗礁の上に光るものを見つけて、感心している。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の水夫フランソアとラルサンも、モレロをこのように昂奮させた岩の上の黄金色まばゆき何物かを見つけてしまった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "え、すばらしいじゃないか、恐竜は、あんなにぴかぴかと金色にひかる卵をうむんだぜ」「フランソア、気をしっかり持ってくれ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭がすごく悪いと来てやがるからね」「しかしだなあ、フランソア。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから腹が立つんだ」「まあまあ、フランソア。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "たたきのめしてやる」「何を、とんちきめ」　フランソアがつかみかかると、ラルサンも負けてはいなかった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアとラルサンは、水夫になって以来はじめて命じられたこの仕事を、とにかくはじめたのだった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モレロと二人の水夫フランソアとラルサンは行方不明だ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアとラルサンの二人の水夫はモレロの指揮にしたがって、丸木舟を作っていたことは読者のすでに承知のとおりだ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つべこべいうと、どてっ腹に風穴をあけるぞ」「へい、へい、やりますよ、やりますよ、何も海まで運ばないというんじゃありませんやね」　フランソアもラルサンも親分格のモレロにかかると、まるで赤ん坊だ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さ、フランソア、お前が先頭だ、行け！",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺たちはこっそりと、奴等の巣にしのび寄って行くんだ」「卵をとるんですかい」「卵じゃねえ、宝ものだ」「宝物、恐竜の宝ものですかい」「恐竜が、宝物なんかもっているものか、海賊ブラック・キッドの宝物だ」「げっ、ブラック・キッドの」　フランソアがたまげたようにさけんだ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアなどは、大きな口をあけっぱなしにして驚いている。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
