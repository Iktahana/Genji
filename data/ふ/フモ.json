        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と幽かにお笑ひになつておつしやつて居られた事もございますし、また、政所、侍所ナドト等シク、都所トイフモノヲ設ケタラドウカ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔沃度ノニホヒフルヒ来ス〕沃度ノニホヒフルヒ来ス、　　　青貝山ノフモト谷、荒レシ河原ニヒトモトノ、　　　辛夷ハナ咲キ立チニケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大マルズック星（木星）が天界の牧羊者（オリオン）の境を犯せば神々の怒が降るのも、月輪の上部に蝕が現れればフモオル人が禍を蒙るのも、皆、古書に文字として誌されてあればこそじゃ。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ　コノ　テフテフモ　オハネガ　ジヨウブニ　ナルト　カゼニ　ノツテ　ウマヤノ　ヤネヲ　コエタリ、ヲガハノ　ウエニ　イツテ　ミタリ　シマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シロイ　テフテフモ　ソノ　アトニ　ツイテ　ノボツテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "或者ハ此非難ニ對抗センカ爲メニ個人ノ名譽的不平等ヲ認ムル制度ヲ以テセント云フモ、コハ價値ナキ別問題ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ノ經濟的活動ノ動機ノ一ガ私欲ニアリト云フモ其一。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "新タナル試ガ公共的認識ヲ待ツ能ハズシテ常ニ個人ノ創造的活動ニ依ルト云フモ其二。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ニ發達スルモ公共的生産ガ國民生活ノ全部ヲ蔽フ能ハズシテ、現實的將來ハ依然トシテ小資本ニヨル私人經濟ガ大部分ヲ占ムル者ナリト云フモ其三。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民自由ノ人權ハ生産的活動ノ自由ニ於テ表ハレタル者ニツキテ特ニ保護助長スベキ者ナリト云フモ其四。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "等シク勞働者ト云フモ各人ノ能率ニ差等アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ理由ハ國家ガ國家ノ兒童ニ對シテ大父母タル立場ニ於テ其ノ生ミノ父母ハ單ナル保姆ノ任ヲ負フモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是レ其ノ飮食ヲナス兵卒ガ戰爭スル能ハズト云フモノ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ］人民公民ノ権ヲ失フモノ算ナクシテ町村ノ自治全ク［破壊→頽廃］セラレ［飢餓→貧苦疾病］及ビ毒ニ中リテ死スルモノ亦年々多キヲ加フ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "此比俄ニ日本古銭ヲ玩ブ人多クナリテ、其価ノ十年前ニ四五倍スル様ニナリシハ、泰西ノ風ニ化シタルナリト云フモ、失言ニハ非ザル可シ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ我邦ニハ是レ迄公私トモニ、古物館ト云フモノハ一宇モ無シ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩ガ常ニ筆墨ヲ弄シテ日ニ数千百字ヲ駢列スルモ、未ダ曾テ一人ノ笑ヲ皷シ一人ノ泣ヲ醸スコト能ハズ、其ノ無用ナル之レヲ号ケテ屎ト云フモ可ナリ、屁ト云フモ亦可ナリ。",
              "citation": {
                "source": "他山の石",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼汝ノ吾徒ニ幸スル所以ノモノハ、即チ吾徒ニ禍スル者ト謂フモ亦タ不可ナル莫ランカ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是乎千六百十一年、彼等ハ相図リテ移住ノ儀ヲ定メ、永ク英人タルヲ得、且ツ基督教団ノ基礎ヲ据ヱ得ル処ヲ求メタリケルニ、あめりかハ洵ニ能ク此等ノ目的ニ副フモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラトイフモノ、モンコチヤンハボンコチヤンヲケツシテカブラナクナリマシタカラ、オ父サント、オ母サント、オ姉サントオ兄サンハモンコチヤンニカウイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キナンカ　チガフモノカ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コレガ　センソウト　イフモノカモ　シレナイ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「計一卜紳二ハ母駒江ヲ、みどりハ、母八洲子ヲ扶養スル義務ヲ負フモノトス」つて……。",
              "citation": {
                "source": "歳月",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまだに覚えている、『儒教デモ善ト云フモ悪ニ対スルホドニ善ト悪トナイゾ、中庸ノ性ト云フタゾ』などと、幼な心に何の事とも分らず聞いておったあの咄々とした御音声が、いまだに耳の中で聞えている。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまだに覚えてゐる、『儒教デモ善ト云フモ悪ニ対スルホドニ善ト悪トナイゾ、中庸ノ性ト云フタゾ』などと、幼な心に何の事とも分らず聞いてをつたあの咄々とした御音声が、いまだに耳の中で聞えてゐる。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "レクラム文庫にはたしか『フモレスケン・ウント・ザティーレン』と題する相当分厚なチェーホフ短篇集があったと記憶する。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレ一代限りでテッペンの本丸をやめて、フモトの低いところへうつせ、と云いのこして死んだそうだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで二代目から本当にフモトへ本丸をうつしたよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "築城した当の政宗先生が音をあげて、オレの次の代からは本丸をフモトへうつせよ、と遺言するような途方もない天嶮を選んだ以上は、大天守閣を造るのが当り前さ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
