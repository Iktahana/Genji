          "standard": [],
          "literary": [
            {
              "text": "（下略）　次の手紙は巴里市民中の一老紳士ジユウル・フレエル氏から来たものだ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に「日々文芸」と縁の深い文壇の諸君子には、諸君子と同じく芸術の為に、焦慮し、悪闘し、絶望し、最後に一新生面を打開し得た、その尊敬すべきコンフレエルの事業に、一層の留意を請ひたいと思ふ。",
              "citation": {
                "source": "龍村平蔵氏の芸術",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "（エミイル・ファーブル、ロベエル・ド・フレエル等）新進作家のうちでも、その才能に於て上述諸作家と比肩し得るものが、随分あるにはある。",
              "citation": {
                "source": "仏国現代の劇作家",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ル・フィス」は「むすこ」、「ル・フレエル」は「兄弟」。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
