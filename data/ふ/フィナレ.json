        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヴェートウベンなんかのシムフォニーがフィナレに来て、もう終ろうとして、しかし未だ情熱がうちかえして響くあの心理のリズムは文字で表現されるものにもあって、終りはなかなかむずかしゅうございました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィナレ　引っ返して仮橋の袂から一隻の船を雇い、呉越同舟に洋装の婦人を交えて三人、大廻りに漕がせて、物をも言わずに崖の下へ駆け付けたのは、それから四五十分ほど後の事でした。",
              "citation": {
                "source": "呪の金剛石",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィナレにも出て、終ると座員一同に大入りを渡してやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十一日（水曜）　青い街が段々明るく白くなり切った七時頃、漸く「さらば青春」のフィナレが終った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィナレが終ったのは何と十二時近い。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四時からフィナレの歌のけい古、ホテルへ行き、チキンブロスと舌平目、コーヒーのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「弥次喜多」のフィナレ、シャン／＼／＼としめて、おめでたう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月六日（土曜）　ゆっくりねて昼頃起き、四時からフィナレのけい古し直しなので出かける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「海軍」大受け、フィナレの「愛国行進曲」客もよく歌ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィナレに、吉例「愛国行進曲」合唱。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィナレに、舞台へ軍人さんがあらはれ感謝状を授与される。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「海のローマンス」のフィナレは出ないことゝし、寸劇だけ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ出てフィナレの歌をかへるので稽古をし、鈴木静一・友田・穂積等とホテ・グリで食事、ミネストロン、フィレソール、ムサッカ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二景と九景、フィナレと、それだけしか出てゐないんだから気は楽。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊田に、フィナレをかんべんして貰って脱出、タクシー帰宅、十一時半。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィナレで、越路吹雪が、この「女優物語」で、大阪府教育委員会から芸術祭賞（奨励賞）を受賞したので、賞状持って帰った菊田一夫からそれを渡す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
