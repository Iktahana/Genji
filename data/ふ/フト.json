        "examples": {
          "standard": [
            {
              "text": "神社の境内に生い茂る太古からの杉の木が、神秘的な雰囲気を醸し出していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "国民の平和と安全を祈願するため、皇居にて盛大な太神楽が奉納された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は将来この国を背負って立つような、太器の持ち主だと誰もが認めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
