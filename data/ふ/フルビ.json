  {
    "uuid": "f937cd21-eacd-5962-9230-c281f8542fe3",
    "entry": "古び",
    "reading": {
      "primary": "ふるび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "勿論一寸見たのでは木か金かも知れないほど古びている。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこの古びたる鞄をさげてよろめけどもわれは瘠犬のごとくして憫れむ人もあらじや。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれこの古びたパノラマ館！",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人も、若者も、家婦も、子供も、すべての家族が同じ藁屋根の下に居て、祖先の煤黒い位牌を飾つた、古びた佛壇の前で臥起してゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでは古びた柱時計が、遠い過去の暦の中で、先祖の幽靈が生きてゐた時の、同じ昔の指盤を指してゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人も、若者も、家婦も、子供も、すべての家族が同じ藁屋根の下に居て、祖先の煤黒い位牌を飾つた、古びた仏壇の前で臥起してゐる。",
              "citation": {
                "source": "散文詩集『田舎の時計　他十二篇』",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでは古びた柱時計が、遠い過去の暦の中で、先祖の幽霊が生きてゐた時の、同じ昔の指盤を指してゐる。",
              "citation": {
                "source": "散文詩集『田舎の時計　他十二篇』",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかなれば涙を流してかくも黄色く古びたる紙頁の上にわが情熱するものを情熱しつつ寂しき人生を語り續けん。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに好い加減古びてゐるのと場所柄とで、何となく物寂びた雅致を帯びて、静かな廃屋といつたやうな情趣がある。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞黒に古びてはゐるが極めて正確な懸時計の針が八時五十分を指した時、小使がまた現はれて解剖室の用意が出來てゐる事を報告した。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "千万年も、古びた夜の空気を顫はし、除夜の鐘は暗い遠いい空で鳴る。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "古びた唐草模樣の壁紙の處處はげかかつた四方の壁には、三色版の平凡な風景畫が一つ掛かつてゐるきりで、がらんとした、空氣の冷えきつた部屋の中には裝飾品らしい何物も見えなかつた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　三田の文科生になつてからは、さすがに寫眞熱もさめてしまつたが、旅行の時だけは、もう可なり古びた上に舊式になつたその寫眞器を相｜變らず伴侶にしてゐた。",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっぷり沈んで、遠くで雨戸を繰る響、台所をぱたぱた二三度行交いする音を聞きながら、やがて洗い果ててまた浴びたが、湯の設計は、この邸に似ず古びていた。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人寢の寛りとした立派なもので、一面に、光を持つた、滑らかに艶々した、絖か、羽二重か、と思ふ淡い朱鷺色なのを敷詰めた、聊か古びては見えました。",
              "citation": {
                "source": "人魚の祠",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと圧えに舌長姥、古びて黄ばめる練衣、褪せたる紅の袴にて従い来る。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところで、とぼけきった興は尽きず、神巫の鈴から思いついて、古びた玩弄品屋の店で、ありあわせたこの雀を買ったのがはじまりで、笛吹はかつて、麻布辺の大資産家で、郷土民俗の趣味と、研究と、地鎮祭をかねて、飛騨、三河、信濃の国々の谷谷谷深く相｜交叉する、山また山の僻村から招いた、山民一行の祭に参じた。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "原稿は稍古びたる半紙に筆と墨をもつて書かれたり。",
              "citation": {
                "source": "遺稿",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこれじゃ、（萌黄古びて茶となりたるに大紋の着いたる大風呂敷を拡げて、膳を包む）――お銚子は提げて持って行くわさ。",
              "citation": {
                "source": "錦染滝白糸",
                "author": "――其一幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "筮竹の長袋を前半じゃ、小刀のように挟んで、馬乗提灯の古びたのに算木を顕しましたので、黒雲の蔽かぶさった、蒸暑い畦を照し、大手を掉って参ります。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子も普通よりは幅が広く、見上げるような天井に、血の足痕もさて着いてはおらぬが、雨垂が伝ったら墨汁が降りそうな古びよう。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……が、なぜか、物の本の古びた表面へ、――来れや、来れ……と仮名でかきちらす形がある。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちとその古びておりますので。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　木地の古びたのが黒檀に見える、卓子台にさしむかって、小村さんは襟を合せた。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、お宗旨｜違の神社の境内、額の古びた木の鳥居の傍に、裕福な仕舞家の土蔵の羽目板を背後にして、秋の祭礼に、日南に店を出している。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さながら野晒の肋骨を組合わせたように、曝れ古びた、正面の閉した格子を透いて、向う峰の明神の森は小さな堂の屋根を包んで、街道を中に、石段は高いが、あたかも、ついそこに掛けた、一面墨絵の額、いや、ざっと彩った絵馬のごとく望まるる。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
