        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "白身魚と旬の野菜を、ビール入りの衣でサクッと揚げたフリッターを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "デザートは、熱々のリンゴのフリッターに冷たいバニラアイスを添えたものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "パーティーの前菜として、エビとアボカドのフリッターが大変好評だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "渡辺篤を誘って、アラスカで夕食、トマトのポタアジュと、チキンクリーム煮にコーン・フリッター。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "青豆ポタージュに、豚のグリル、コーンフリッター。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタージュ・アスパラガス、チキン・ソティーにコーン・フリッター、それに野菜のカレーライス、うまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "平目のグラタン、チキンの挽肉のスフレ（スフレと言ってたのが、かまぼこみたいになってしまった）、チキンのフリッターにバタライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
