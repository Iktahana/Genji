[
  {
    "uuid": "36e51861-e952-54c7-b184-fbb713298379",
    "entry": "吹き下ろす",
    "reading": {
      "primary": "ふきおろす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to blow down upon",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冬の季節風が山頂から谷へ向かって吹き下ろしてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "強風がビル群の谷間を吹き下ろし、冷たい風が通りを駆け抜けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夕方になると、いつも決まって海から陸へ向かって風が吹き下ろす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "槍肩から吹き下ろす風の強いのには驚いた。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "槍肩は西から吹き上げた風がすぐ槍沢へ吹き下ろすので、雪庇はできないらしい。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スウィス境の雪の山は、もうマストに近く屹えて、ピオナの鼻を右に廻ると、岸は冬枯れのままの雑木林で、山が近いせいか、空は次第に掻き曇って、吐息でもつくように、思い出してはさっと吹き下ろす夕風も、白樺の香をつたえてうそ寒い。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "折り折り、吹き下ろす風は、なかなか寒く、村路のここかしこに、野の花は咲き初めてはおるが、春は一と月も遅れていると思われる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "朗らかな奥にも絶えず、何とも云えない寂しさのただようている、花は高原を覆うても、冷たい風を吹き下ろす山の雪から離れ得ない、たとえばうれしさに躍る胸の底にも、冷やかな思いの絶えない、――綺麗なメロディーに静かな沈んだ伴奏をつけたような――此のクラリヨンを以てして、初めてアルプの春は表わせると思う。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ろの胆吹山が大きな鳴りを立てたかと思うと、さっと吹き下ろす風が千丈の枯葉を捲いて、原も、村も、里も、一度に裏葉を返す秋の色を見せました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "山路が嶮しい上に、あの烈風がまともに吹き下ろすのだから、たまったものではありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "表面からは濛々と立ち昇る烟のような霧が、吹き下ろす風に捲かれて、雪渓の真中を渦を巻きながら押し寄せて来る、凝っと見ていると霧に足が生えているようだ、あの中を魔が通っているのではないかと想った。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪渓を吹き下ろす冷い風に、蒸し暑い谷の瘟気がとれて、久し振りに蘇ったような気持になった。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高地から吹き下ろすぞっとするような暴風や嵐はほとんど常に問題になったのだが、それでも我々は中間基地を設営しないですますことに決めた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、ついにある音が意識に上ってきた――この世ならぬ高みから吹き下ろす山々の風が微かに響く外界を離れて以降、初めて耳にした音だった。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "時は夏五月、日盛りは過ぎたが、葭簾の蔭で、地はそんなに焼けてもいなかったのに打水が充分に沁みて、お山から吹き下ろす神風が懷に入る時は春先とも思うほどの心地がします。",
              "citation": {
                "source": "大菩薩峠",
                "author": "三輪の神杉の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "特にフェーン（＊吹き下ろす乾熱風）が吹いて暖かいときにアルプスは身近に見られ驚くべき山々であり不思議に魅惑的であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "立秋、雲のない大空から涼しい風がふきおろす。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "時は二月｜初旬、ここらの高地は海風がぶつけてくる、山風もふきおろす。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――恐らくあのデボチンは、農村に育って、歴山から吹きおろす南風に、その歌を、幼時から歌いなれたものだろう。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "街路樹のマロニエの梢に切られて吹きおろす風は遊び女たちの肌にかみそりの刃のように当る。",
              "citation": {
                "source": "オペラの辻",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "下りざまに、おゝ、一手桶持つて女中が、と思ふ鼻のさきを、丸々とした脚が二本、吹きおろす煙の中を宙へ上つた。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "外洋の霧は山陰の梢を吹きあげて蓬々として更に吹きおろす。",
              "citation": {
                "source": "鉛筆日抄",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを、吹きおろす風は七十メートルを越え、伏しても、はるか谿底へ飛ばされてしまうのだ。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、この開口をのぼった間近で合している二つの氷河の、右側のを吹きおろす大烈風だ。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い峰から吹きおろす山風が小屋の戸をぐらぐらと揺すって、どこやらで猿の声がきこえた。",
              "citation": {
                "source": "木曽の旅人",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "２薔薇色ごろも靡けたる朝の童女はなやかに、曙の戸をひきはづし、天の榮をかたむけて、注ぐや黄金、しろ金の照の亂れをもろ肩に、やをら國見の目蔭して、遠方の空を眺むれば、天そそり立つ大峰や、また峰中の山ぞひに、風は疾渡り駈けめぐり、玉置山のかなたよりさと身隱れて眞下りに吹きおろすらむ熊野浦。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、たちまち、ヘルゼッゲンの峰越しに吹きおろす風のために、船は裏帆（10）になってしまいました。",
              "citation": {
                "source": "メールストロムの旋渦",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに御本丸から吹きおろす大体｜颪に、返咲きの桜が真白く、お庭一面に散乱した。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――空から吹きおろす無邊の風の聲がいふ、「おい、おい、ばかもいゝ加減にしなさい。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹きおろす夜風も受けながしていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのぼのと有明の月の月影に紅葉吹きおろす山おろしの風（信明）　これも客観的の歌にて、けしきも淋しく艶なるに、語を畳みかけて調子取りたる処いとめづらかに覚え候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほの／＼と有明の月の月影は紅葉吹きおろす山おろしの風　（信明）　これも客觀的の歌にてけしきも淋しく艶なるに語を疊みかけて調子取りたる處いとめづらかに覺え候。",
              "citation": {
                "source": "歌よみに與ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのぼのと有明の月の月影は紅葉吹きおろす山おろしの風　（信明）　これも客観的の歌にて、けしきも淋しく艶なるに語を畳みかけて調子取りたるところ、いとめずらかに覚え候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
