          "literary": [
            {
              "text": "見えるものは、裸の岩山と、細長く入りこんだ峡湾（フヨルド）だけである。",
              "citation": {
                "source": "白い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸には、至るところにフヨルドがよく発達していて、細長い湾が、ずっと奥まではいりこんでいる。",
              "citation": {
                "source": "白い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "急峻な岩山はそのまま海にはいって、このフヨルドの両岸をなしている。",
              "citation": {
                "source": "白い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
