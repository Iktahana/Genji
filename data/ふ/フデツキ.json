        "examples": {
          "standard": [
            {
              "text": "彼の水墨画は、力強い筆付きが特徴で、見る者を圧倒する迫力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "繊細な筆付きで描かれた桜の花びらは、風に舞うかのように生き生きとしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "書道教室の先生は、生徒一人ひとりの筆付きを見て、的確なアドバイスを与えていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "……モウ沢山だ……モウ沢山だ……と叫んで逃げ出したい気持になりながらも、息も吐かれぬ心苦しさに惹き付けられて読んでいる彼を……これでもか……これでもか……と押え付けるかのように、峻烈を極めた筆付きで、今までの事件の記録が繰返されてあった。",
              "citation": {
                "source": "老巡査",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
