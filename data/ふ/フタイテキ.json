        "examples": {
          "standard": [
            {
              "text": "このソフトの主な目的は画像編集だが、付帯的な機能としてファイル管理も行える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "本来の業務に付帯的な作業が多く、残業時間がなかなか減らないのが悩みだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "損害賠償請求に際し、利息などの付帯的な権利についても主張した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "あらゆる付帯的気象条件がちがい従って人間の感受性に対するその作用は全然別物ではないかと思われるのである。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論恐らく事実上は之が北支の安寧秩序を確保することは或る限度まで必ず出来るであろうが、それは付帯的な結果であって、本当の目的でも何でもない。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がいつも宙ぶらりんではっきりと割り切らないのは、彼に決断がないからではなく、物事をその表面の付帯的な事象によって速断しまいとするからであって、矛盾した様々な事柄を面白おかしく並べたてながら、物事の本質核心にふれさせようと思えばこそである。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
