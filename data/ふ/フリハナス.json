[
  {
    "uuid": "3d4fb39d-6b98-5e13-bb84-f69b95ffaf82",
    "entry": "振り放す",
    "reading": {
      "primary": "ふりはなす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
