[
  {
    "uuid": "7f3d93f5-213e-5bbf-8dca-26ea3b23b0a8",
    "entry": "糞土",
    "reading": {
      "primary": "ふんど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
