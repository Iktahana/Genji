  {
    "uuid": "6022d24a-2e13-5003-8b73-d441bc25ca19",
    "entry": "フナ",
    "reading": {
      "primary": "ふな",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さて人が若しこの境地に陥ると、ネズミが甕に堕ちフナが釣針に掛ったようなもので、脱しようとしても脱せず、忘れようとして忘れられず、様々に思い悩み手段を尽くし悩み苦しんでも、さてどうすることも出来ない。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっぱり面白くもない夢だったり（たとえばベロヴゾーロフは、愛馬にフナを食わせたが、その馬の首が木になっていた――という夢を見た）、あるいは不自然な、わざとでっちあげた夢だったりした。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポールは、いつものカール・ヘフナーではなく、リッケンバッカーのベースだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイツ語でホオフナルと云うのだ。",
              "citation": {
                "source": "かのように",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ印度ノ獨立ヲ欲スル如ク支那ノ保全ヲ希フナラバ、眼前ニ迫レル支那ト英國トノ衝突ハ日英同盟ヲ存立セシメザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何をわけのわからないことを云ひ出したんだ（コイツ、ギリシヤ語ヲ使フナ、バカバカシイ）」　ジャッキーは赤くなつてわらつた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ヲ害シテ私ヲ利スルノ義ニモ非ラズ、唯心身ノ働ヲ逞シテ、人々互ニ相妨ゲズ、以テ一身ノ幸福ヲ致スヲ云フナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、フナ（１）という小さな魚がいる。",
              "citation": {
                "source": "死生に関するいくつかの断想",
                "author": "BITS OF LIFE AND DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "一匹か二匹のフナがどの井戸にもいて、幼虫から水を綺麗にする。",
              "citation": {
                "source": "死生に関するいくつかの断想",
                "author": "BITS OF LIFE AND DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の井戸にも一組のフナがいることを知ったのも、井戸浚い職人たちが来たこのときであった。",
              "citation": {
                "source": "死生に関するいくつかの断想",
                "author": "BITS OF LIFE AND DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "井戸水が溜められている間には、フナは冷たい水を張った桶に入れられていた。",
              "citation": {
                "source": "死生に関するいくつかの断想",
                "author": "BITS OF LIFE AND DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "注（１）フナは、小さな銀色をした鯉の一種。",
              "citation": {
                "source": "死生に関するいくつかの断想",
                "author": "BITS OF LIFE AND DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕○丁度一八六〇年頃フナロードの始った頃。",
              "citation": {
                "source": "一九二五年より一九二七年一月まで",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "相当に大きな真赤なの二つ、白がちの二つ、黒いフナのようなの一つ、目高？",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ヲ以テ之ヲ観レバ、支那ハサテ置キ、我邦ホド古物ヲ疎略ニスル国ハ有ルマジト思フナリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハヤ、フナ、ハゼ、ドンコ、時には、アユ、ナマズ……雑多なものが捕れる。",
              "citation": {
                "source": "田園の幻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "今一人はソフイア・イワノフナと云ふ貴夫人で、此女はセルギウスの草庵の側へ来て住んでゐて、始終セルギウスの跡を付いて歩くのである。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはソフイア・イワノフナと、さつき倒れさうになつた時支へてくれた商人とである。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのソフイア・イワノフナ夫人はどうだらう。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の名はブラスコヰア・ミハイロフナと云つてゐる。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男の細君エレナ・イワノフナが一月十三日午後〇時三十分に突然かう云ふ事を言ひ出した。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが病人の妻グラフイラ・イワノフナである。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "フナは面白いやうにかゝるし、稻の葉はさら／＼と鳴つて、一望たゞ青き野中に立つたのです。",
              "citation": {
                "source": "花守",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "右方にはセントアーン山高くそびえ、左方にはボウフナルト湾のきわまるところに、参差として白雪が隠見している。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからなら、ヤマベ、ハヤ、アユ、川エビ、フナ、海ではカサゴ、メバル、カイヅ、キス、スズキ、と、五月は海が開く、地球が若がへつて、たつぷり水を持ち、熱を持ち、美しい魚を自由に釣らしてくれる。",
              "citation": {
                "source": "釣心魚心",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他にはヤマメ、フナ、カイヅと、専門に釣り歩いてゐる人があるが、樺太から台湾まで、一つの魚を漁つて歩くのも面白いとして、更に地理的に、一つの河川、一つの江湾を研究するのも面白からうと思ふ。",
              "citation": {
                "source": "釣心魚心",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "フナは町娘だ、歩いて捜す。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "アモトフォス――イダネ――ファエラス――スクラトコフ――スタフナス――オルメ――スワルタ――ファラ――これがみんな停車場の名。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根川べりの小さい町で、本屋のオヤジはこゝをフナ釣りのメッカみたいなことを云っていたが、これを割引して考えても、魚というものは、よほど釣れない仕掛けになっているようである。",
              "citation": {
                "source": "釣り師の心境",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
