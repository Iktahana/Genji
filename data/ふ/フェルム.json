        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "入れちがひに市長が詩人の婚約者フェルムを連れて登場、市長はすぐ退場する。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤナアン、シヤナアン、とフェルムが呼んでも、詩人はまだ空を見てゐる。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルムは手を貸して詩人を卓のところまで連れて来て腰かけさせ、パンを酒に浸して食べさせやうとする。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルムが答へる、私をすこしでも愛するのなら、この小さい一きれを食べて下さい。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルムは両手に彼を抱き、私はあなたと離れない。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいえ、詩人の特権をお許し下さるまでは、食べません、とフェルムが答へる。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤナアンは王自身が進めるパンをフェルムの手を借りて押し退ける。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルムと弟子たち退場。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルム（鉄）　水の中でしばしば消すとそれはかなりの乾燥力を与える。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
