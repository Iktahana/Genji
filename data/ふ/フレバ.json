          "literary": [
            {
              "text": "温柔ニシテ馴レ易ク、又能ク鼠ヲ捕フレバ畜フ。",
              "citation": {
                "source": "澄江堂雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "○因循姑息ノ意ヲ以テ考フレバ、旧来ノ政府ハ一旦軽卒ノ挙動ニテ変ジ難シト思フベシ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ唯本邦學術ノ沿革ニ據テ之ヲ考フレバ、少シク顧ミザル可ラザル者アルニ似タリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "夷カニコレヲ考フレバ則チ古器ハ雅ナリトイヘドモイマダ新器ノ時用ニ適シテシカモ便ニカツ利ナルニ若カザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど山鹿素行の兵書によると、車ガカリハ敵方ノ備ヘ立テ三段四段ナルニ用フレバ功大ナリ。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
