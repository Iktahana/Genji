          "literary": [
            {
              "text": "その一は（一）フェラヒン（農民）と呼ばれ、エジプト人の人口の大部分を占め、すべて耕作者で、主としてニルの上流地方に居住している。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔からエジプト人と反が合わないで、今日でもエジプト人（フェラヒン）との間では婚姻が行われないそうだ。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイロは何といっても上に述べた十または九つの人種（フェラヒンだけは地方居住者だから取り除けにして）の寄合世帯の町という外はない。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
