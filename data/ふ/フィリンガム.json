        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フィリンガムと申します。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム氏は偉大な肖像画家で、名声やら姿をよく知っている。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューバート医師は車寄せを歩いて行き、刈りこんだ芝生を通り、フィリンガム夫人の腕を抱え、正面扉から中にはいった。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死んでませんか」　と尋ねるフィリンガム夫人の声は消え入りそう。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム氏はまだ息がある。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム画家で、私の近くに住んでいます。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は私の用法に従い、第一段階を行い、フィリンガム氏を治療した。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は家に帰って寝なさい」　　　　　＊　フィリンガム夫人はヒューバート医師と一緒にアトリエにいた。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旦那さんは体が丈夫ですから」　フィリンガム夫人が応えて、「主人は最近働き過ぎでした。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "間違いなくジフテリアの仲間だが、血中の毒が悪さをする」　　　　　＊　やがてフィリンガム夫人と別れた後、レイブル博士はヒューバート医師を連れだした。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "博識のレイブル博士が指摘した事実、これら全てが前夜フィリンガム氏の粘液にあった。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム氏を看病中の看護婦だ。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム氏と同じ症例を二件かかえて、途方に暮れておられます」　ヒューバート医師は帽子と電気針をひっつかんですぐ出発した。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "今回はデヴォンシャイア公園の豪邸に住む子供が二人、まさにフィリンガム氏と同じ苦しみにあえいでいた。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　午後二時過ぎになり、ヒューバート医師はやっと再びフィリンガム家に立ち寄った。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトリエに突っ立ってフィリンガム夫人を待った。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム夫人が尋ねた。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣装が無いですね」　フィリンガム夫人が物憂げに答えた。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてフィリンガム家で、レイブル博士がヒューバート医師に合流した。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇帝陛下は昨日フィリンガム画家とここにおられました。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
