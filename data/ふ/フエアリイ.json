        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして詩の芽生えが、子供の心意する夢の世界と、その幻想的なフエアリイランドに苗づいてることは言ふ迄もない。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、フロラの椅子の片端に凭りかゝつて、フロラの膝に翻つてゐるフエアリイ・ブツクの画を見てゐた。",
              "citation": {
                "source": "鸚鵡のゐる部屋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "と僕の友達は云つた、フエアリイ・ランド！",
              "citation": {
                "source": "籔のほとり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると眞夜なかに、異樣な羽ばたきが彼等の夢を打つた……　Ｕ塔のある丘つづきに、フエアリイ・ランドと呼ばれる丘があつた。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女に變裝する――それがうまく行けば、彼は、誰にもジジであることを氣づかれずに、フエアリイ・ランドのやうな盛り場へも平氣で行かれるといふものだ。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエアリイ・ランドの入口で、彼は、キキ等が自分とすれちがひながら自分にすこしも氣づかないのを見て、滿足した。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエアリイ・ランドではすべてが新しかつた。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから毎日のやうに、ジジは女の子に變裝してフエアリイ・ランドへ遊びに行つた。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
