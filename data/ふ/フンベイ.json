        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "皿には三角な黄粉餅を三つ刺した串が一串置いてある。",
              "citation": {
                "source": "松蟲草",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "）蕨粉餅を売る、妙なり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "金竜山浅草寺名代の黄粉餅、伝法院大｜榎下の桔梗屋安兵衛てんだが、いまじゃア所変えして大｜繁昌だ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖母さんは、それから、大急ぎで、次郎のため黄粉餅を作った。",
              "citation": {
                "source": "次郎物語",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄粉餅たべようよう。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の乗っている牛の手綱は、城太郎の手に曳かれているため、彼の歩き出さぬうちは、どう焦々思っても、黄粉餅屋の軒先を、通り越えることができないからである。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛の背から降りてしまったので、お通は、仕方なしに、「さ、はやくお喰べなさい」　と、黄粉餅屋の陰へはいって行く。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
