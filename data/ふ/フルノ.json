          "literary": [
            {
              "text": "ムネイタイノ、ト君チャンガキクト、イヤト頭ヲフルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "熟土ヲ耕ストハ事変リ、前人未開ノ地ニ、原始ノ鍬ヲ用フルノ困難ハ知ル人ゾ知ラン。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ皇上ノ民ヲ憂フルノ深キコト此クノ如シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤハリ脳貧血ダソウデ、「御心配ハアリマセン」ト云ッテ、ヴィタカンフルノ注射ヲシテ児玉氏ガ帰ッテ行ッタノハ、夜中ノ二時デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
