    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to blow out",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地下から熱湯が吹き出ている現場を見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "圧力が高まりすぎたのか、配管の継ぎ目から蒸気が吹き出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "突然、火山のような勢いでガスが吹き出してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "鍛冶屋の煙突から吹き出る真赤な焔が黒い樹に映えて遠い森の上に青い月が出ている絵も欲しかったが、何となく静かなこの「森の絵」にきめた。",
              "citation": {
                "source": "森の絵",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、思はず瞬きして、眼を注いだ時、吹き出るやうに切り口を流れた血潮が助手の左手のガアゼを眞赤に染めてゐた。",
              "citation": {
                "source": "疑惑",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹き出る血潮は、心臓の鼓動の弱るがままに、小きざみになって行った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう暗くてよく判らないが、吹き出る水が、ぴちょん、にょん、にょんというように聞え、またその響きの勢いによって、全体の水が大きく廻りながら、少しずつ水嵩を増すその井戸の底に、何か一つの生々していてしかも落ちついた世界があるように、お涌には思われた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう暗くてよく判らないが、吹き出る水が、ぴちよん、によん、によんといふやうに聞え、またその響きの勢ひによつて、全体の水が大きく廻りながら、少しづつ水嵩を増すその井戸の底に、何か一つの生々してゐてしかも落ちついた世界があるやうに、お涌には思はれた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はがたがたふるえながら出て来ますと、そこいら一面は、きれぎれになった大じゃの胴体から吹き出る血でいっぱいになっておりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮らしの金はどこからわいて出るんですえ」「いらぬお世話じゃねえか、縁の下に小判の吹き出る隠し井戸がねえともかぎらねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーメン」　お松は、黒い血が頭のてっぺんからドクドクと吹き出るような気がした。",
              "citation": {
                "source": "反逆",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "機械の中から吹き出る綿菓子を雪のように積らせた店や、彩色入りの長い飴棒を束ねた店や、玩具店などと並んだところは、日本の縁日に似た町祭だったが、その間を歩く人人はあまり嬉しそうな様子もなかった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "疱瘡のように細かな腫物が全身に吹き出ると、焼けるように身体が燃えて、始めは赤くなった。",
              "citation": {
                "source": "悪魔",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴丸君が頑強に否定すると、水の吹き出るホースを口にさし込み、連日にわたって繰り返したという。",
              "citation": {
                "source": "戦争医学の汚辱にふれて",
                "author": "――生体解剖事件始末記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、そのからだから首が離れて、血が吹き出るまでは、兇暴な打撃はなお二度までも繰り返された。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "繩や蓆やわら束などを売るのがしょうばいで、五尺そこそこの肥えた躯で、十二月だというのに吹き出るような汗をかく躰質だった。",
              "citation": {
                "source": "枡落し",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏帽子のふち金で辛うじて眉間に迫った切先をうけとめたものの、しかし頭から吹き出る血は早くも顔に流れ、浅黄の紋服に沁みわたった。",
              "citation": {
                "source": "本所松坂町",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六号艇からふきでる火災の煙が、地上の場合とははんたいに、照明をたすけた。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、二、三、四、五と、五つ数えるほどのまをおいて、はじめてドッと血がふきでるのだった。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "池は浅間大社のうしろの熔岩塊、神立山の麓から噴き出る水がたたえたもので、社の神橋の下をすみ切って流れる水は、夜目にも冷徹して、水底の細石までが、うろこが生えて、魚に化けそうだ。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳶よ、栗の木の花は噴き出る、鮮かに緑はそよぐ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "釘から噴き出る貴い犠牲の血潮であつたのである。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集のはじめに",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから片隅の手洗場のコックを捻って、勢よく噴き出る水のシブキに噎せかえりながら、ゴクゴクと腹一パイになるまで呑んだ。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "稀に、山越えの諸国担ぎ売りが宿をとるくらいのもので、もとより浴客などはないのだから、温泉とはいっても、沢の底の奇巌のあいだに噴き出るに任せ、溢るるままに、ちょうど入浴りごろの加減のいい湯が、広やかに四季さまざまの山の相をうつしているだけ、村びとは屋根ひとつ掛けず、なんらの手も加えていない。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "噴煙は噴き出る端から雲と成つて薄いオレンヂ色に染まつて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "真ん中はすなおに升るが、脇からは形が変って小さく噴き出る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸口に立っていると、私たちの家から十間あまり離れて立っている美しい樫の老木から、とつぜん炎が噴き出るのが見えたが、眼のくらむようなその光が消えるか消えないうちに、樫の木がなくなっており、枯れた切り株が残っているだけであった。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると蒸気がはげしい勢で球にはいって、それから出口から噴き出るのにつれて、球はぐるぐる廻り出すのです。",
              "citation": {
                "source": "ジェームズ・ワット",
                "author": "石原純",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその代りに、湯気の柱が、凄まじく咆りながら、雷のやうな音を立てゝ上の方に噴き出る。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と反感的に考え込むと何故かふらふらと酔が一時に噴き出るようにやってきた。",
              "citation": {
                "source": "香爐を盗む",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身は戦慄し、冷汗が噴き出る。",
              "citation": {
                "source": "日を愛しむ",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっぱりと絶ち切られた動脈から、血が噴き出る決定的な感触を、トモは空気のなかに感じた。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌しゆうしゆうと花火ふき出る竹の筒｜幼らすでに勢ひそめにし青銭青銭は穴あき銭よ、字のおもて寛永通宝、裏に波文久永宝、よく数へよく刺し貫くと、手もすまにそろへて締むと、幼な児や息づかし我、青太藺綯ひし小縄の、撚りつよきその緒くくりて、夜々をなげきし。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
