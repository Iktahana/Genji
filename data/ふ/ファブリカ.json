        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ВОКС へ行って紹介を貰って油橋さんをさそってファブリカ・クーフニヤ〔調理工場〕に行って見せて貰った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "八時開会というのに自分たちファブリカ・クーフニャ〔調理工場〕を見たかえりなのでつかれ、九時二十分前に行った。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故かと言うと「ファブリカ」の第２版で彼は500人以上の観衆が入ることのできる素晴らしい講義室を持っていたと言っているからである（p.681）。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「ファブリカ」について控え目に話すことはできない。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ファブリカ」の図および文には我々の知っている解剖学が存在している。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに示している第66図は「エピトーム」からのもので多分「ファブリカ」より前に刊行された簡単な内容のものであり、図はむしろ大きい。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ファブリカ」の出版は医学界を根底からゆるがした。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "これについて彼は数年後に著書「山帰来についての手紙」に「ファブリカ」について詳しく書いて抗議の記載をしている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "1555年に彼は「ファブリカ」の第２版を刊行した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェサリウスの豪華な「ファブリカ」に比べるとこれは貧弱な小冊子であった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "1542年の８月１日までに解剖の大作「人体の組立についての７冊の本」（＊略称ファブリカ）の原稿を書き上げた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼の「ファブリカ」は人体解剖学について歴史で知られている最初の完全な教科書として記念碑として残った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
