        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "穏やかだった空に、突然、強い風が吹き寄せ始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "窓の外で木々が大きく揺れ、いよいよ嵐が吹き寄せると感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夕焼け空の下、冷たい風が吹き寄せ、冬の訪れを予感させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
