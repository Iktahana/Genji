          "literary": [
            {
              "text": "（Ｆ・Ｏ）Ｔ「翌る朝」Ｓ＝ファーストシーンの町角　てっきり鉄と三次が今日も亦ばったり出会った。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ、ファーストシーンにしようぜ」　こんどは山崎の声だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ、田舎道で牛車に乗り、村へ着くファーストシーン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファースト・シーンね。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷静に子細に観察なさって、西本くん、きみの言うとおりだ、ファースト・シーンはここだよ、とおっしゃったの。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
