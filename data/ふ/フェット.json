          "literary": [
            {
              "text": "赤石山の、てっぺんへ、寝台へ寝たまま持ち上げられた、胃袋の形をしたフェットがあった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンフェットウをなげるもの、盃をあげるもの。",
              "citation": {
                "source": "ポランの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "拍手、コンフェットウ、）葡萄園農夫（演壇に立つ。",
              "citation": {
                "source": "ポランの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰か六七人コンフェットウや紐を投げましたので、それは雪のように花のようにきらきら光りながらそこらに降りました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーライルの『英雄崇拝論』を繙いてみると、ある古代のヨーロッパ語ではポエット（詩人）とプロフェット（予言者）とは同義語であって二者を表わすべきヴァーテスという語は別にあるとのことでありますが、前に申上げたおもろねやがりもきやのうちぬきまるも詩人・予言者を兼ねたヴァーテスの類であったろうと思われます。",
              "citation": {
                "source": "ユタの歴史的研究",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "チタへつく午前十時頃、ブフェット〔軽食堂〕でハム、ピローシュカ〔あげパン〕、パンその他買う。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すいませんが、　ここは　マフェットちゃんの　おたくでは　ない？",
              "citation": {
                "source": "おねずみおばさんのはなし",
                "author": "THE TALE OF MRS. TITTLEMOUSE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
