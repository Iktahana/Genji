        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "地獄内の諸水にはアケロンテの川、スティージェの沼、フレジェトンテの流れあり、名異なれども實一なり、クレタ島の巨人よりいでて地獄にくだり或ひは川、瀑、沼となりてあらはれ或ひはまた地下にかくれて次第に地底にむかひ、遂に凍りてコチートの池となる。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のエギュイユ・ドゥ・ドゥリューの直下から左に切れて、ラ・フレジェールの真下まで撮影に出かけた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ逸することの出来ないのは、グリンカの『疑惑』とフレジェの『角笛』だ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
