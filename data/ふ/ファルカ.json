        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「無言」と綽名されたファルカは一艘に十人を乗り組ました四十の櫓船を以て彼に当った。",
              "citation": {
                "source": "かなしき女王",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンラはファルカの傍に在って勝利の威勢のよい歌をうたっていた。",
              "citation": {
                "source": "かなしき女王",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの働き中にスヴェンはよろけた、ファルカは彼に槍を突き通した。",
              "citation": {
                "source": "かなしき女王",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「掃泡」が沈み、それに引かれて「死鴉」が沈み、二人の王は出会った、しかしファルカはもう其時はあっちこっちと揺り上げられる重い死魚のようであった、スヴェンはその死体を自分の愛していたガンヒルドの死体かと思って、それに接吻しようとしたが、彼を檣にくぎづけにした槍と七本の矢のためにそれも出来なかった。",
              "citation": {
                "source": "かなしき女王",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "スヴェンの別手の軍かそれともファルカのかと思った。",
              "citation": {
                "source": "かなしき女王",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私はスカァアだ、お前方はロックリンのスヴェンとミドル・アイルのファルカか」彼女は問うた。",
              "citation": {
                "source": "かなしき女王",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
