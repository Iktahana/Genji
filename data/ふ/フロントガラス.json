        "examples": {
          "standard": [
            {
              "text": "高速道路を走っていたら、飛び石でフロントガラスにひびが入ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "冬の朝はフロントガラスが凍結していて、お湯をかけないと出発できない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ワイパーのゴムが劣化していて、フロントガラスの雨粒が全然拭き取れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "往来で、オート三輪のフロントガラスがキラリと閃いたりして。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "日の出間近の淡い明るさの中に浮かんだ街の光景を構成する空間が、車の形に歪曲されてボンネットとフロントガラスの表面をなめらかに流れていく。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
