    "definitions": [
      {
        "index": 1,
        "gloss": "pen or brush stand",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "散らかった机の上を片付け、使用済みのペンをすべて筆立てにまとめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "誕生日に、友人から手作りの温かみのある美しい筆立てをプレゼントされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この筆立ては、様々な太さの筆やペンを効率よく収納できる優れものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そこへ持つて來て、行李のあると反對の壁ぎはに、古道具屋で買つた古い／＼ちやぶ臺を机がはりに据ゑて、その上に義雄が持つて來た雜誌現代小説や趣味や中央公論などが載せてあつて、レツテルに桃の繪を出した鑵詰のあき鑵が筆立てになつてゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "机にかける布切り子やセルロイドの筆立て、万年ペンのクリップ、風呂敷、靴にまで現われている趣味を通じて、その子女が世紀末的思想から生れた頽廃趣味に陥っていることを見破り得る親は先ずあるまい。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この上にある端渓の硯、蹲※の文鎮、蟇の形をした銅の水差し、獅子と牡丹とを浮かせた青磁の硯屏、それから蘭を刻んだ孟宗の根竹の筆立て――さう云ふ一切の文房具は、皆彼の創作の苦しみに、久しい以前から親んでゐる。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから廊下に接した南側には、殺風景な鉄格子の西洋窓の前に大きな紫檀の机を据ゑて、その上に硯や筆立てが、紙絹の類や法帖と一しよに、存外行儀よく並べてある。",
              "citation": {
                "source": "東京小品",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "この上にある端渓の硯、蹲※の文鎮、蟇の形をした銅の水差し、獅子と牡丹とを浮かせた青磁の硯屏、それから蘭を刻んだ孟宗の根竹の筆立て――そういう一切の文房具は、皆彼の創作の苦しみに、久しい以前から親んでいる。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ僕は筆立ての中に孔雀の羽根が二本ばかり鮮かに挿してあったのを覚えている。",
              "citation": {
                "source": "彼",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の上は筆立てやら硯やらで、狭くなっているが、その狭いところから、例の机掛けの花模様が毒々しく、この室に一種の光を放っているようだ。",
              "citation": {
                "source": "北国の人",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆の軸へも喰い入ればまた竹の筆立てなども喰い荒し沢山な黄粉（糞）を製造し孔を明ける。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すみれはそこで、目ざまし時計や、きれいな表紙のついている雑誌や、筆立てや、また、竹子さんが、学校で稽古をなさるいろいろな本などを見ることができました。",
              "citation": {
                "source": "つばきの下のすみれ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、こちらのすみで、すずりと筆立てが、あちらの人形を見て冷笑していました。",
              "citation": {
                "source": "三つのお人形",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の上には大きな硯や厚い帳簿や筆立てや算盤がごだ／″＼と一杯に置かれてあつた。",
              "citation": {
                "source": "入江のほとり",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "余も一度探検に出かけその音を聞いたが、狸の仕業でないと思い、よくその方角、位置を聞き定め、翌日再びここに至り、屋後を探り見るに、大いなる竹の筒（筆立てのごときもの）が雨滴の落つる所に立ちおり、これに屋根の雪がとけて落つるときに、その一滴一滴がこの筒の中に落ち込み、ために発したる音なることが分かった。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の上には、置時計と、きれいな花を生けたむらさき色のガラスの花びん、筆立てなどが置いてあります。",
              "citation": {
                "source": "おれは二十面相だ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんはそれを大事さうに家へ持つて帰つて、自分の机上の筆立に挿す。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このごろ毎日、竹藪の中をうろついて、ぼんやり帰つて来て、けふはまた何だか、いやに嬉しさうな顔をしてそんなものを持ち帰り、もつたい振つて筆立に挿したりなんかして、あなたは、何か私に隠してゐますね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんはそれを大事さうに家へ持つて歸つて、自分の机上の筆立に※す。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このごろ毎日、竹藪の中をうろついて、ぼんやり歸つて來て、けふはまた何だか、いやに嬉しさうな顏をしてそんなものを持ち歸り、もつたい振つて筆立に※したりなんかして、あなたは、何か私に隱してゐますね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上に色々の形をなしたる筆立に絵筆を立てあり。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆立の中には銅器にて腹のふくらみたるも交れり。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "坐舗の一隅を顧みると古びた机が一脚｜据え付けてあッて、筆、ペン、楊枝などを掴挿しにした筆立一個に、歯磨の函と肩を比べた赤間の硯が一面載せてある。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の下に方一尺五寸に切りたる炉あり、一日に一度位は豆大の火種もなくなりて、煙草を吸ひつけるに燐寸を擦る事はあれど、大方は昼も夜も、五合入りの古鉄瓶にしにしたる水瓶など筆立や墨汁壺に隣りて無雑作に列べらる。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父はわたくしの申したことが聞こえた顔もせず、筆を筆立へ納めて、大欠伸をし、母に命じて捲いた書物を待たせて置いた小僧にやらせ升た。",
              "citation": {
                "source": "黄金機会",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやんなってしまう」　私はわきの筆立にみっともない形をして立って居た面相をとって歯の間でそのこじれてかたまった穂をかんだ。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こないだ注文してやった筆立の形も思う通りに出来るかと思って不安心だし、下絵の出来て居る絵の色の工夫も気にかかる。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "孔雀の羽根の長いのが筆立に一本さしてもあつた。",
              "citation": {
                "source": "日本橋あたり",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うの隅の、英子の小さな机、婦人雑誌、鳥の羽をさした筆立、電燈の笠にかかってる、凉しい色どりのリリアンの編物……。",
              "citation": {
                "source": "傷痕の背景",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもその上には種々な貝殼を鏤めた筆立が置いてあって、鵞ペンでない只の美しい鳥の羽が四五本※っていた。",
              "citation": {
                "source": "運命のままに",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "脇の方に小さい机を前に置き、其の上に易書を五六冊積上げ、傍の筆立には短かき筮竹を立て、其の前に丸い小さな硯を置き、勇齋はぼんやりと机の前に座しました態は、名人かは知らないが、少しも山も飾りもない。",
              "citation": {
                "source": "怪談牡丹灯籠",
                "author": "怪談牡丹灯籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「殿様、うまくひとつ書いてやっておくんなさいましよ、贔負分にね」「ふーん」　神尾は鼻であしらいながら、筆立の中から木軸の大筆を取って、ズブリと大硯の海の中へ打ち込みました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "安房の国の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にしたって、こんな恥かしいところをかかれちゃいや」　兵部の娘は手をさしのべて、筆立から筆を抜き取り、墨を含ませると、ズブリとその絵を塗りつぶしてしまったから、清澄の茂太郎が、その勇敢に、あっ！",
              "citation": {
                "source": "大菩薩峠",
                "author": "Ocean の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
