[
  {
    "uuid": "e3d9267c-713a-5872-a349-45c53a03547a",
    "entry": "増える",
    "reading": {
      "primary": "ふえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
