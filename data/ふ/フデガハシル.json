        "examples": {
          "standard": [
            {
              "text": "久しぶりに書く故郷への手紙だったので、様々な思いが溢れて筆が走った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "議論が白熱する中、彼は一言一句聞き逃すまいと、メモを取る筆が走るのが見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "締め切りが迫ってくると、不思議と集中力が増して筆が走るようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ウェルスのは、筆が走る方ではないか。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノートの上を、思ひだしたやうに鉛筆が走る。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
