        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "岡山の近くの三箇の信者たちも勿論会堂の新築に協力したのであるが、その中で特に著しかったのは、三箇の城主の姉妹で、キタという武士に嫁していたフェリパである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "またクリスマスや復活祭に他の地方から三箇に集まってくるキリシタンの貧しい女たちで、フェリパの世話にならぬものはなかった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬になるとフェリパは侍女たちと共にせっせと機を織り、衣服に仕立て、京都の宣教師のもとへ持ってくる。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
