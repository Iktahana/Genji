[
  {
    "uuid": "9fa74672-9494-553a-8dce-f9b87741f1c8",
    "entry": "ふくふく",
    "reading": {
      "primary": "ふくふく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこはまっ黒な土があたたかにしめり湯気はふくふく春のよろこびを吐いていました。",
              "citation": {
                "source": "若い木霊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その窪地はふくふくした苔に覆われ、所々やさしいかたくりの花が咲いていました。",
              "citation": {
                "source": "若い木霊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でもおれのきくとこに依ると、あいつらは海岸のふくふくした黒土や、美しい緑いろの野原に行って知らん顔をして溝を掘るやら、濠をこさへるやら、それはどうも実にひどいもんださうだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でもおれのきくとこに依ると、あいつらは海岸のふくふくした黒土や、美しい緑いろの野原に行って知らん顔をして溝を掘るやら、濠をこさえるやら、それはどうも実にひどいもんだそうだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は下態はそのままで、上態は七分通り水の方へ捩じ向け、ふくふく水溜りの底から浮く、泡の湧玉を眺めている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっさと風のように八丁堀へ帰っていくと、ぶつぶつと口の中で何かいっている伝六をしりめにかけながら、ふくふくと夢路を急ぎました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに貴方の書き方は絹漉し豆腐のように、又婦人の餅肌のように柔らかなのです、上部ばかり手触りが好いのかと思うと、中味迄ふくふくしているのです。",
              "citation": {
                "source": "木下杢太郎著『唐草表紙』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくふくと　なほしめやかに香気をふくんで霧のやうにいきりたつあなたの　ゆびのなぐさみのために、この　月の沼によどむやうな　わたしのほのじろい頸をしめくくつてください。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度二人が電車に乗った頃千世子はふくふくの布団にくるまりながら自分で自分をねかしつける子守唄をうたって居た。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「べつのオやつてみんしや」　八ツ口からふくふくした腕を出してゐたのを、その女の子は腕をまた袖口へもどして、今度は袂を持ち添へて栓抜きの上から押すのです。",
              "citation": {
                "source": "小さい花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "真白いふくふくした大きな枕があつたが、富岡は手枕のまゝ知らん顔をしてゐたし、ゆき子も、その枕には無関心でゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメルの駱駝がふくふくに暖かい色彩だつた。",
              "citation": {
                "source": "雨",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "早苗は、何となくよい子供がさづかりさうな、そんなふくふくした、氣持ちになるのであつた。",
              "citation": {
                "source": "風媒",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくふくに腫れ上った四肢を支えてやると、少女の躯とも思えぬほど無気味だが、水を欲しがる唇は嬰児のように哀れだ。",
              "citation": {
                "source": "火の唇",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくふくに腫れ上つた四肢を支へてやると、少女の躯ともおもへぬほど無気味だが、水を欲しがる唇は嬰児のやうに哀れだ。",
              "citation": {
                "source": "火の唇",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "その度に、葉子のふくふくとした肩が、いくらか固くなった黒吉の体に触れた。",
              "citation": {
                "source": "夢鬼",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、尤もらしい顔をして、京子の美を讃嘆する、倉さんや、順平や、その他多くの間抜けた顔が眼に浮ぶ度に、京子を固く抱いた腕は、彼女のふくふくした躰が、くびれはしまいかと思われるほど、力を加えられて行った。",
              "citation": {
                "source": "鉄路",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくふくの枕に頬をおっつけて私はポロポロ涙をこぼして居た。",
              "citation": {
                "source": "日記",
                "author": "一九一四年（大正三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "お布団はふくふくして、なんとももうされないよい気持ちで御座います。",
              "citation": {
                "source": "テンコツさん一家",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "皿を持っているうちに、ヴァニラとカラメルの焦げるいい匂いがして、黄色い捏粉がセピア色になってふくふくと膨れあがった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓬を刈払って厚く下敷にしてあるので、ふくふくしている。",
              "citation": {
                "source": "朝香宮殿下に侍して南アルプスの旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくふくと太って、顔がむやみに小さく見える。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう杉苔は、四季を通じて鮮やかな緑の色調を持ち続け、いつも柔らかそうにふくふくとしている。",
              "citation": {
                "source": "京の四季",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋ごろには、京都の杉苔の庭と同じように、一坪くらいの地面にふくふくと生えそろった。",
              "citation": {
                "source": "京の四季",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、そうした疑問を抱きながらも、寝台や羽根蒲団は、相変らずふくふくとして柔らかく、円かな夢を結ぶには、好適この上もありません。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "つやつやしい皮膚の色をした、丸ぽちゃで、ふくふくとし肉づきは今にもはちきれそうである。",
              "citation": {
                "source": "本所松坂町",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あした死骸を取りに来ねえ」　ふくふくな気もちで、宵闇、わが家の門口まで帰って来た蔡福はそこでふとギクとした。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝のやうな形のいい※がふくふくとうごく。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹はふっくらと実のいった長い指に折紙をあちらこちらに畳みながらふくふくした顔をかしげて独り言をいったり、たわいもないことをいいかけたりする。",
              "citation": {
                "source": "折紙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
