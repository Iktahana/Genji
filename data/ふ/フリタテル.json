    "definitions": [
      {
        "index": 1,
        "gloss": "to toss (i.e. one's head)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "馬は乗り手に反抗するように、激しく頭を振り立てていなないた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼女は「違うわ」と言いながら、長い髪を翻して首を振り立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "不機嫌な子供は、いやいやをするように何度も首をぷいと振り立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "それは頓狂な、両肩両腕を大袈裟に振り立てる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　広い通りを隔てた向うの理髪店から、椅子に掛け、姿見に対ったまま、その鏡の中から、ザッと刈ったばかりの坊主頭をしきりに振り立てるのはわが友庄亮である。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして餌をねらう猛獣のような姿勢をして抜き足で出て来て、いよいよ飛びかかる前には腰を左右に振り立てるのである。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "師直の一家中もその数には洩れないで、かれらが生い立った武蔵野の芒をそのままという髭面をそらせて、坂東声を遠慮｜会釈もなしに振り立てるいわゆる「猛者」の巣窟である中に、かの采女ばかりは都びとにも笑われないような優美の風采を具えていた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その橋のまんなかに逞ましい牛が眼を怒らせて伏していて、近づけば角を振り立てる。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "閲微草堂筆記（清）",
                "note": "青空文庫"
              }
            },
            {
              "text": "妖魔亡びよ」　鉞をとり直して階段を登ろうとすると、女は金鈴を振り立てるような凛とした声で叱った。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲の町内で阿夫利山の木太刀を担ぎ出すと、乙の町内では鎮守の獅子頭を振り立てるものがあります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "桑畑で草雲雀が小さな銀鈴を鳴らすような涼しい声を振り立てる。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貧乏教師の癖に生意気じゃありませんか」と例の金切り声を振り立てる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんと同役、とてものことにその山崎という奴を、うまく賺して押片付けてしまおうじゃねえか」「そいつは駄目だ」　同役の木村は、せっかく太く結い上げて来た髷を惜気もなく左右に振り立てる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白根山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「古川の――」と安直が、らっきょう頭をゆらりと一つ振り立てると、「はい、安直｜兄い、何ぞ御用で……」としゃしゃり出たのが、古川の英次という三下奴です。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "）の法然頭を振り立てるためには、素であった方が見栄えがする。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "振り立てる頭の赤さが、周囲の沈んだ色調から、飛び抜けて眼を奪う。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし大きな頭に大きな目玉をぐるぐる動かし、短かい触手をふりたてるところは火星人の大人とかわらなかった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "後足でける、首輪をゆすぶる、頭をぐっと上へむけて角をふりたてる、といったありさまです。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の顏からはあの憂鬱な表情が消え、長い身體をふり立てるやうにして、あちらこちらと歩きまはり、十歩ばかり走つて見、誰彼となく「今日は」と云ふ。",
              "citation": {
                "source": "南方",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆のいふ言葉がわからないのと、乱暴なのは、私の学校嫌ひをます／＼あふり立てる。",
              "citation": {
                "source": "転校",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯ぎしりして口惜しがった僧兵達は白山｜中宮の神輿をふり立てると、山門に訴えようと、比叡山に行進を開始した。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、耳元で振立てると、はっと呼吸が一つあって、振一振、左の小手が動いたかと見えると、天地振分けを四箇まで隠した五本（？",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "鵜匠の振立てる松明の火の粉が岸の柳に散りかかる、という意味らしく思われる。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
