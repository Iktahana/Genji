  {
    "uuid": "7bb25b29-056f-54f7-ab6f-36b744dc0823",
    "entry": "フクレ",
    "reading": {
      "primary": "ふくれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サツソク、モルモツトノ　オヰシヤガ、イタチノ　ポンポコニ　フクレタ　オナカヲ　シンサツシマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは阿部｜正精が蘭軒にゴロフクレンの服を与へた事を紀するものだからである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「教師の赤にしては忌々しいほどミットモねえなあ――赤もフクレてるし、子守もフクレてるし、よく似合ってらあ」　お雪も他の娘も笑わずにいられなかった。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ見タトコロデモ死骸ハ大概同ジヤウナ形ニナツテヰタ頭ガヒドクフクレ　顔ハマル焦ゲ　胴体モ腕モケイレン的ニフクレ上ツテヰル　火傷者ノ腕ニ蛆ガ湧イタリスル　十三日後ニナツテモ広島市デハマダ整理ノツカヌ死骸ガ一万モアルラシク　夜ハ人魂ガ燃エテヰルト云フ。",
              "citation": {
                "source": "原爆被災時のノート",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は彼女に時々フクレタリヤと呼んでいた。",
              "citation": {
                "source": "ふもれすく",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "フクレタリヤに野天生活をさせることは衛生にとってあまり好ましいことではないが、入るべき家がなければ致仕方がない。",
              "citation": {
                "source": "ふもれすく",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに大衆作家としての僕の猟奇的精神がこの言葉を耳にした時フクレ上がったか、友よ、想像してくれたまえ。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この扁桃腺のフクレでズコズコ云っていたのもすっかり解決いたしさっぱりした気分になりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　子供たちは支那金魚の目玉のやうに、灸のあとのフクレたのを見て悲しみあつた。",
              "citation": {
                "source": "お灸",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治の初年から明治二十三年までに至るこの第一期の哲学を中心としたる思想の潮流はだいたいアウフクレールングスツァイトで、英、米、仏の思想が優勢を占めておった。",
              "citation": {
                "source": "明治哲学界の回顧",
                "author": "序論",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから日本語の「啓蒙」が当時実際意味したものが何であるにせよ、之はアウフクレールングの訳に当ると云っても誤っていなかろう。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が夫にも拘らず啓蒙という言葉を云い表わすアウフクレールングというドイツ語は、他の国語では云い表わせない「啓蒙」に固有な或るものを意味している。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日わが国で啓蒙と訳されるドイツ語・アウフクレールングは恐らく英語のエンライトゥンメント――文明――からの訳ではないかと思う。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "処でエンライトゥンされアウフクレーレンされるものは、例えば闇とか妖雲とかいうものでなければなるまい。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史上では、それは封建的な残存機構から自然生的に発生した不合理な（アウフクレールング自身から見て不合理な）観念・イデオロギーのことだったのである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論ここで文明と云いアウフクレールングというのは、社会の経済的又技術的な機構の発達のことであるよりも、寧ろ主に社会に於ける文化的観念の発達を意味するのである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本がプロイセンの憲法に則って憲法を制定したと云われる（今日迄の多くの権威ある法学者や歴史家の間ではこの点科学的常識になっている）のも亦、日本の極めて長い封建制から自然生的に生じた観念的残存物に対するアウフクレールングとしてだったと考えられる。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々は今やドイツ・アウフクレールングを少くともここまで遡って、その第二の規定をこの悟性の哲学に、その合理主義に見出すことが出来るだろう。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しこの第二の規定は実は、ドイツ・アウフクレールングでは単に最も極端なドイツ式な形で現われたと云うまでで、広くフランスの唯物論にも共通な一つの論理機構に他ならない。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "論理的な機構だけを見ている限りこの結果のもつ具体的な意義は判りにくいが、実際はこの結果は、歴史に関する認識について所謂アウフクレールングが免れ得ない不吉な宿命と関係があるのである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くともドイツ・アウフクレールングはその悟性の立脚点からして歴史の観念に注意を払うことの尠ないのが特徴をなしている。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "之と略同じことは啓蒙（アウフクレールング）という観念に就いても云われるのである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にアウフクレールングはクラシシズムとロマンティシズムとに対立した処の一つの文化理想であった。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にアウフクレールングの時代は過ぎて文化史上ではクラシシズムやロマンティシズムがすぐその後に之に代わったと考えられる。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "福沢式或はアウフクレールング的啓蒙とどこまで同じでどこから違うか、又違わねばならぬか、そういう問題には今まであまり世間では答えていないのではないかと思う。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "処がこの常識という観念も亦一方に於て或る歴史的な特定な意味を有っているので、所謂常識学派の「常識」を参照しないでは科学的に分析出来ないものなのだが、この常識学派なるもの自身が実は、もっと広く之を文化史的に云い表わせば、所謂アウフクレールング（特にイギリス啓蒙期）の哲学学派の一つに他ならない。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            }
          ]
        }
