        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ結果、俺ハ双生児ノ片割レデアルトイフコトガ判明シタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ誰モ俺ニ構フコトハ出来ナイゾ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌フコト数｜※、美人之ニ和ス。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ原則ト云フ者アラバ、只國家ノ保護ニヨリテノミ各人ノ土地所有權ヲ享受セシムルガ故ニ、最高ノ所有者タル國家ガ國有トモ民有トモ決定シ得ベシト云フコト是レノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大資本ガ社會的生産ノ蓄積ナリト云フコトハ社會主義ノ原理ニシテ明白ナルコト説明ヲ要セズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "壹千萬圓以上ノ生産業ガ國營タルベキ爲ニ起ル疑惑ハ事業家ノ奮鬪心ヲ挫折セシムベシト云フコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ農業發達ノ程度ニ於テハ婦人ヲ炎天ニ晒ラシテ其ノ美ヲ破リ、又ハ貧困者多キ近キ將來ニ於テハ婦人ヲ工場ニ驅使シテ其ノ樂ヲ奪フコトモ止ムヲ得ザル人間生活ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ王朝貴族ニ朝鮮人ノ血液ガ多量ナリト云フコトハ、實ニ其ノ貴族ノ血液ガ皇室ニ入リ得ベキ特權階級タリシ點ニ於テ、日本ノ元首其者ガ朝鮮人ト沒交渉ニ非ズト云フコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツアール」ガ侵略シ來レルト「レニン」ガ幾多ノ謬妄ヲ附帶セル社會革命説ヲ奉ジテ殺到シ來ルベキト、日本ガ國防上朝鮮ニ據リテ戰フコトハ國家ノ國際的權利ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國防上朝鮮ヲ獨立セシメズト云フコトハ、英人ガ印度ヲ獨立セシメズ又亞佛利加植民地ヲ獨立セシメズト云フコトトハ全ク別事ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ積極的發展ノ爲メニ戰フコトノ單ナル我利私欲ニ非ザルコトハ、他ノ民族ガ積極的覺醒ノ爲メニ占有者又ハ侵略者ヲ排除セントスル現状打破ノ自己的行動ガ正義視セラルル如ク正義ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ米獨其ノ他ヲ糾合シテ世界大戰ノ眞個決論ヲ英國ニ對シテ求ムベシト云フコト是レナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又上タル者ヨリ下ヘ許シ、コノ事ヲ為シテ差構ナシト云フコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "又好悪ノ出来ルト云フコトナリ、危キ事ヲモ犯シテ為サネバナラヌ、心ニ思ハヌ事ヲモ枉ゲテ行ハネバナラヌナドト、心苦シキコトノナキ趣意ナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "定メテ其ノ心ニ逆カフコトモ有ランナレド、ソハ余ガ一家言トシテ宥シ給ヒネ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "況テ宝器什物ノ有ル可キ様無ケレバ、必ズ曝サネバナラヌト云フコトモ無ケレド、午熱烈シキ比快キ風ノ吹キ入ルヽ小楼ニ、独リ古キ櫃ドモ取出デヽ、手ニ触ルヽ物ヲ列ラネ曝ス程面白キコトハ有ラジ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道ハ、タイヘン寒イトユフコトヲキイテタマゲマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、コノ前アナタノ十家ヘアガッタ時ハ、ヒドイ御病気デ、トウ／＼アナタニアフコトガ出来ナクテ、ザンネンデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子十二歳ニ至レバ総テ剣法ヲ学ビ、夜間就眠スル時ノ外ハ剣ヲ脱スルトイフコトナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ私ハ自分デヌフコトガデキマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ聖人賢人ノ智ト雖ドモ、其元行ハ云々ノ源因ニハ云々ノ結果アリト云フコトニテ、之ヲ澤山ニ知リ、且又之ヲ結構組織シテ事ノ全體ニ渉リ、細大トモ一聯絡タルヲ知ルニ外ナラズ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "供養万出、以テソノ力ヲ尽スモ参価ナホ償フコト能ハズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔五十｜纔カニ過ギテ鬢已ニ華／悠悠心迹残涯ヲ送ル／詩夢ノ春草ヲ尋フコト無カル可ケンヤ／未ダ朝衫ヲシテ酒家ニ付セ使メズ／老後功名古暦ノ如シ／酔来顔色唐花ノ似シ／東風料峭トシテ天街遠ク／疾ヲ力シテ還タ下沢車ニ登ル〕」云々としてある。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十四年八月に、飛騨の高山の町で同町の二木長右衛門氏に聞いた話では、「馬糞ナドニ生エル馬糞菌ヲ喜ンデ食フコトガアル」とのことであった。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那の初唐時代での有名な詩の「葡萄ノ美酒夜光ノ杯、飲マント欲シテ琵琶馬上ニ催ス、酔テ沙場ニ臥ス君笑フコト莫カレ、古来征戦幾人カ回ヘル」はよく人口に膾炙した七絶である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土人ノ伝ヘニ往古日本武尊東夷征伐ノ時コノ郡中ニカカリ、此ノ山ヲ見給ヒテ通行セシメタマフコト八日ニ及ベルヨシ、故ニ名ツクト云。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
