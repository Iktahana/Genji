        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「クックックッ」とか、「ウフッフッフッ」とかいって。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウッフッフッフッフッ」　と正木博士は噴飯した。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハハハハハハ……お伽話だ……地底の蜃気楼……アッハッハッフッフッフッ……アスタ・セガンチニ……あの近眼婆さん……オースタリ人の志村のぶ子……アハハハハ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハハハハハハ……｜お伽話だ……｜地底の蜃気楼……アッハッハッフッフッフッ……アスタ・セガンチニ……あの近眼婆さん……オースタリ人の志村のぶ子……アハハハハ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋田は、それを一寸見ていたが、直ぐに、幾分得意然として、「――判ります、つまりこれが、そのマーチ・フォックストロットのステップの跡、と言うか、足取りの跡を、先生が図にしたものなんでしょう」　すると大月は笑いながら、「――ウッフッフッフッフッフッ……まあ、そうも言える。",
              "citation": {
                "source": "花束の虫",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "無駄だから止めにしな」「アッハッハッ」「ヒッヒッヒッ」「フッフッフッ」「ヘッヘッヘッ」　みんなが揃って笑い出した。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フッフッフッフッ貧乏でがしてな。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリッとしたご器量で、時々冗談もおっしゃいますが、厭らしいところはちょっともなく、あの、そうして……よいお方で」　どうしたものか彦兵衛老人、フッフッフッと含み笑いをした。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが無理にもくださるというなら、フッフッフッフッ、もらいますねえ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "気に入ったぞ、フッフッフッ」　含み笑いも幽鬼さながら、「討て！",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "擽ったがってフッフッフッって笑うよ」　ふき子が伸びをするように胸を反して椅子から立ちながら、「みんな紅茶のみたくない？",
              "citation": {
                "source": "明るい海浜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フッフッフッフ」　いや、どうも、深川オペラ劇場主人は冷水を浴びたやうにぞッとした。",
              "citation": {
                "source": "盗まれた手紙の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハッハッハッハッ…………ヘッヘッヘッヘッヘッ…………フッフッフッフッ…………」　彼は身を悶えて笑い続けた。",
              "citation": {
                "source": "恐ろしき錯誤",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
