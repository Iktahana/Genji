        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "月明かりの下で酒を酌み交わし、友人と共に秋の夜長を賦詠した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "皇帝の御前で、見事に咲き誇る牡丹の花を題材に賦詠するよう命じられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "美しい湖畔の景色に心打たれ、思わずその情景を賦詠せずにはいられなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「病というものは仕方がのうてな、身共も至ってこの賽ころが大好物じゃが、その方共が用いるところはどこの寺場じゃ」「ふえい？",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
