        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "窓の真ん中には飼い犬のスパニエル、フィッファーロが大きな金メッキのフロアランプから後脚でぶら下げられて身悶えし、悲しくキャンキャン鳴いていた。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィッファーロはますます悶え、悲しく鳴き立てた。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "警官の一人がフィファーロの紐を外して腕に抱いた。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私の可愛いフィッファーロですけど――強制収容所に連れ去られてとっても惨めなことだけはわかっています。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "全部あなた方が悪いんじゃありませんか――チェルカソフさん――私がフィッファーロのことをぽんぽん叩いてやると、フィッファーロは膝の上に飛び乗ってキスして尻尾を振って、それだけで。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかしながら、貴女の可愛いフィッファーロは、お話にあった通り、恐らくは純粋な Canis aureus の血統で、極めて入念に繁殖されたものでしょう。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
