        "examples": {
          "standard": [
            {
              "text": "公園の噴水から、水がダイナミックな吹き上げを見せている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夜になると、広場の吹き上げがライトアップされて幻想的な雰囲気になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは夏の暑い日、水の吹き上げの周りで涼んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
