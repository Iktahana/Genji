          "literary": [
            {
              "text": "それから第二には非常にファナチックな行為を嫌つたこと。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴎外はファナチックを排斥したけれども、かれの内心にはロマンチックの夢想なら全くないでもなかつた。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファナチックを嫌つたのは知性の喪失を嫌つたのである。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "イカナル父親モ、自分ノ娘ヲファナチックニ愛スル奴ハイナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
