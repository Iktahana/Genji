        "examples": {
          "standard": [
            {
              "text": "その著名なフィロソファーは、大学で倫理学を教えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "フィロソファーとしての彼の主張は、多くの学生に影響を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古代ギリシャのフィロソファーたちは、今なお研究の対象となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "フィロソファーとは愛知者という語義だという。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田先生から教へられたのは英文法と英文和譯、譯の教科書はアチック・フィロソファーとイナックアーデンとであつた。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            }
          ]
        }
