    },
    "definitions": [
      {
        "index": 1,
        "gloss": "activation",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地域の伝統産業を賦活させるため、若手クリエイターを誘致するプロジェクトが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "脳の血流を測定し、特定の作業がどの部位を賦活させるかを詳細に調査した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このサプリメントに含まれる成分は、細胞の代謝を賦活する効果が期待されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "代助は、たゞ、「思ふかつて、誰だつて左様思はざるを得んぢやないか」と半ば口から出任せに答へた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "‥‥そこへ、田舎大尽風に狐の毛皮をふかふかつけたコートを着て、蒼ざめた顔色のお粒が這入つて来た。",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンカチーフは片手で一握りのまゝきゆつとしぼつて、べとついたまゝのを、ほんの一寸、躯にこすりつけて拭いたと云ふかつかうだけで、生がわきの躯へ、汚れたシュミーズをわざと裏がへしにして着るものがゐる。",
              "citation": {
                "source": "暗い花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゼビイラの理髪師」や「フィガロの結婚」のフィガロから来た名称らしく、なぜ私が笑ふかつて言ふのですかい。",
              "citation": {
                "source": "茶番に寄せて",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "母　　母さんが、なぜそんなことを云ふかつて云へば、あんたを不幸な目に遭はせたくないからだよ。",
              "citation": {
                "source": "あの星はいつ現はれるか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠町ぞらにつたふ　もの音かつ／″＼に務めを頼む人にあへば、務めがたきを　ひたすらに言ふかつ／″＼も　生きむと思へば、した心　かひなきものを頼み来しかも師にむきて言あらゝにもの言ひて、悔ゆるさびしさの　身に沁みにけりあたゝかきみ心知らぬにあらねども、告げ易からず。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふかつり道具と、ふかの油をしぼる道具を取りそろえた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふかつりだ」　船が碇泊すると、すぐにふかつりをはじめた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ふかつりの方は成績がよく、三時間も錨作業をしているうちに、二メートルもある大ふか数十尾を甲板につみあげた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふかつかうで地球は廻つて來てをります。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
