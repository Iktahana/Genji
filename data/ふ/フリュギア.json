          "literary": [
            {
              "text": "「氣息を嘘く」は靈感を與ふるなり〔マルシーア〕フリュギアのサテュロス、マルシュアス。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカエメネスの財宝をも、ゆたかなフリュギアの王ミュグドンのあらゆる富をも、また、富めるアラビアの家々をも、汝はリキニアの髪一筋と取換えるにあらずや。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
