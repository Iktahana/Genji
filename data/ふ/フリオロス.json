[
  {
    "uuid": "fdbd2e74-6b28-5d79-ab1e-a519c1736577",
    "entry": "振り下ろす",
    "reading": {
      "primary": "ふりおろす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
      "ctype": "五段-サ行",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to swing downward",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "薪を割るために、斧を真っ直ぐに振り下ろした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "犯人は躊躇することなく、金属バットを力いっぱい振り下ろした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "剣道部の主将が、竹刀を鋭く振り下ろす音が体育館に響く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "振り下ろす刃は、ピーンと、弾き返されるような気がした。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよもう、勘弁ならねえ、こッ此の野郎ッ」　どおーンと突き当ったのはいいが拳固を振り下ろすところを、ヒラリと転わされて、「ぎゃーッ」　と叫ぶと、酔漢は舗道の上に、長くのめった。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "小癪とも言わずに右手を伸べた竜之助は、狂人の脇差の柄を握って、邪慳にそれをひったくると、高く振り上げて、水を掻くように無雑作に振り下ろすと、左の肩から垂直に胸の下まで斬り下げました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "小名路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "急所急所で横に縦に、あるいは斜めに振り下ろすのであった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　米友は振り上げた棒を振り下ろすことなしに、この時ようやく犬の声音を聞き咎めました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "如法闇夜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "もやい綱に手をかけてナイフを振り下ろすと、綱が切れた。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人殺しの卑怯者、丸腰の男をやみ打ちするか」　ラリが素早く向きを変え、腕に浅傷をうけながらも、振り下ろすナイフを避けた直後、敵は鼻が顔にめり込んで泥に突っ伏した。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽の下、振り下ろす鍬の下には、いかなる暗も秘密もつつみ得ません。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "司令官は、第七編隊を率いて進撃しつつ、ニヤリと笑って、「さあ、これからいよいよ日本帝国を亡ぼし、東洋全土をわがＳ国植民地とするその最初の斧をふりおろすのだ。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "減圧幕に穴があけば、私たちは、一ぺんに死んでしまう」　と、怪物たちは、声をそろえて、新田先生が鉄の棒をふりおろすのをとめた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしや振りあげた刹那はいかにいきおいこんでいようとも、その手は、ふりおろす途中に力を失ってお艶の身に触れる時は、おのずから撫でるがごとくであった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "すきだらけのように見えて案外すきがなく、大きくふりおろす太刀先にはきびしい力がこもっていた。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "斎戒沐浴して、お鍬入れの儀式と称し、対馬守が自身で第一の鍬を振りおろす。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "気がうわずっていれば、これに釣られて羽織へ刀を振りおろす。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやその馭者の振りおろすむちの痛いのなんのって……。",
              "citation": {
                "source": "夢がたり",
                "author": "TO, CHEVO NE BYLO",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この雑草を刈り取らねばなりません」　かまを振りおろすがごとく秋月君はぱっさり言った。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふりかぶって振りおろす剣には広さが必要だが、四尺二寸の杖は、四尺二寸の手の幅が上下にありさえすれば自由自在にあやつり得るもので、これもまた意外の一ツ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたいと思えば、彼女はいつでも振りおろす言葉の槌の柄に、いいたい意味を打ち込めることができ、またかつて誰も故意に曖昧な味をつけた言葉のお菓子を彼女より上手につくった者はなかった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "（こんな重いものが、ふりまわせるかしら）と、始め隣りの御隠居さんから借りて来たときは心配した一郎だったけれど、そのつるはしをうまいことふりあげて、下ろすときにはつるはしの重味で、さっとふり下ろすと、うまい具合につるはしは土の中にくい込むのだった。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『いゝかえ、なえ本家、いゝがえ……』と、幸吉は一語一語に力を入れて、その度に恰も何かを抑へつけでもするやうに、腕に力を入れて手を上から下へと振り下すのであつた。",
              "citation": {
                "source": "醉ひたる商人",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "又は鉄塊上の一点を狙って大ハンマーを繰返し繰返し振り下す青服の壮漢の、焦らず弛まぬ純誠純一な身心の活動美も、又ソックリそのまま能のソレに当てはめられはしまいか。",
              "citation": {
                "source": "「生活」＋「戦争」＋「競技」÷０＝能",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一瞬もその気配を察知し得なかった米屋のアンニャ、すでに相手が間にはいっているから、いきなり振り下す。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "飛燕流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず小次郎は速剣で、この長い剣を振り下すと同時に返して打つ。",
              "citation": {
                "source": "青春論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍刀を壁に沿って振り下すと、体を開いてこぶしを目の所まで上げた。",
              "citation": {
                "source": "桜島",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどそは、怒れる神の振り降ろす懲戒の笞ではない。",
              "citation": {
                "source": "霊訓",
                "author": "SPIRIT TEACHINGS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
