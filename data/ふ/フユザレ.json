        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "冬ざれや北の家陰の韮を刈る　薄ら日和の冬の日に、家の北庭の陰に生えてる、侘しい韮を刈るのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これと同想の類句に冬ざれや小鳥のあさる韮畠　というのがある。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬ざれた溪間の旅館は私のほかに宿泊人のない夜がある。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――場所は大川筋もずっと繁華の両国、冬ざれの師走近い川風が、冷たく吹き渡っている宵五ツ頃のことです。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの橋手前の乱杭際に片寄せて、冬ざれの夜には珍しい夜釣りの舟が一艘見えるのです。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だのに、釣れぬと知りつつ、こんな冬ざれの寒風をおかしながら、わざわざ夜釣りにやって来たのは、タナゴ釣りの豪奢極まりない清興に心惹かれたからでした。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「船頭々々」「へッ」「獲物はないが、冬ざれの大川端の遠灯眺むるもなかなか味変りじゃ。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮れ易い冬ざれの陽はいつか黄昏そめて、訪れるは水の里に冷たい凩ばかり。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "声もなくさしうつむいて、駕籠のあとから急ぐ京弥の背に、冬ざれの大江戸の街の灯がゆらゆらゆらめきました。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "・冬ざれの水がたたへていつぱい・ひとりの火の燃えさかりゆくを　十二月廿七日ウソもマコトもない世界に生きたい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・松葉ちる石に腰かける・藪から出てくる冬ざれの笹をかついで・落葉ならして豆腐やさんがきたので豆腐を　十二月六日　午前はうらゝか、午後はくもり。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにも冬ざれといふ感じである。",
              "citation": {
                "source": "樹木と空飛ぶ鳥",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬ざれた半農半漁の村が、一筋寂しく横仆わっている。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は去年の冬ざれ、例の野見と洒落たときに、その寺の境内で、休んだことを思い出した。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "踏み辿る野辺山が原の冬ざれも今日のわたしには何となく親しかつた。",
              "citation": {
                "source": "木枯紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内に冬ざれた路の上にも、たまに一日か二日づつ暖い日かげがさすやうになつた。",
              "citation": {
                "source": "あばばばば",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの庭々の冬ざれの樣子が、巧みに配された人事と相俟つて、たいへん興趣深く語られてゐる。",
              "citation": {
                "source": "「文藝林泉」讀後",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬ざれし溝川の汚きながめはわが思出の世なりけり。",
              "citation": {
                "source": "偏奇館吟草",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つの窓から日暮れ前の広場の冬ざれた樹立が見える。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山内の松と落葉樹とが冬ざれの中に立つてゐて、池を抱きこんでゐる姿がそのままに筋ばかりの美しさを見せてゐた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "するともう冬ざれの草原を踏んで、がさがさと歩いて来た四、五人がある。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぜひなく、両使とも、そこに佇んでいたが、だいぶ手間どれるので、何故待たせるのかと疑いながら、広縁へ出て、折ふし冬ざれの寺の庭面に、霜除けをかぶって、仄かな紅を見せている寒牡丹など眺めていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "その茶寮の縁先からは、遠からぬ所の御行の松が、夜の空を摩してのぞまれますし、広い庭は、雪見燈籠も空堀の那智石も、落葉に埋まって冬ざれの霜の荒れにまかせてあります。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……須磨、明石も塩屋のけむりのみにて、冬ざれ、うら淋しうは候へど、汀々、千鳥の賑はひをかしくて、うかうか、都の師走も忘れ歩きをり候ふままに。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
