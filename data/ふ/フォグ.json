        "examples": {
          "standard": [
            {
              "text": "山道に入ると急にフォグが発生し、前方の視界がほとんどなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夜の港町が、深いフォグに包まれて幻想的な雰囲気を醸し出している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "フォグの中を、船の汽笛が低く遠くまで響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "寒い曇天無風の夜｜九段坂上から下町を見るといわゆるロンドンフォッグを思わせるものがある。",
              "citation": {
                "source": "LIBER STUDIORUM",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
