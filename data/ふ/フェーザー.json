        "examples": {
          "standard": [
            {
              "text": "ギタリストは足元のフェーザーを踏み、うねるようなサイケデリックな音色を作り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "SF映画の中で、主人公は未知の生物に向けてフェーザー銃を構えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "シンセサイザーにフェーザーのエフェクトをかけると、独特の空気感が生まれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "男は兎に角、子供だけは持ち度いものだ――室子は、流れの鴎の翼と同じ律に櫂をフェーザーしては蓑吉を待っていた。",
              "citation": {
                "source": "娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
