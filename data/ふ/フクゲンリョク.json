        "examples": {
          "standard": [
            {
              "text": "船の転覆を防ぐためには、十分な復元力が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この素材は、外部からの力に対して高い復元力を発揮する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地震に強い建物は、揺れに対する復元力が高く設計されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これは芸術的統一の面がそれ自身に復元力を持つことを意味する。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この画の本来の統一に注意を集め、その復元力にまで迫って行く努力をしなければ、毀損の個所の方がかえって強く目につくであろう。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
