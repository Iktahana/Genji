        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は若い頃、船軍に身を投じ、世界中の海を航海した経験を持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "その国は、強力な船軍を背景に、海洋貿易で大きな利益を上げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は、国の将来のためには船軍の近代化が不可欠だと強く主張した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": []
        }
      }
