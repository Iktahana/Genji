          "literary": [
            {
              "text": "米国にやや野槌に似た俗信ある蛇フップ・スネークを産す。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "フップとは北※翁が、「たがかけのたがたがかけて帰るらん」と吟じた箍すなわち桶輪だ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また女史の名を聞いたフップェルト会社が、その自働ピアノのために一曲女史に弾いてもらいたいと望んだ事があった。",
              "citation": {
                "source": "久野女史をいたむ",
                "author": "兼常清佐",
                "note": "青空文庫"
              }
            },
            {
              "text": "樽前山の北にフップシヌプリという山があるけれども、之は噴火には関係なく、トドマツある山の意である。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
