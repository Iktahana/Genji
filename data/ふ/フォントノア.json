          "literary": [
            {
              "text": "――あるいはフォントノア。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々はブーヴィーヌやフォントノアなど（訳者注　昔フランス王によって得られた戦勝の地）のことを昨日の事のように語り、アウステルリッツは既に老い朽ちてしまった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォントノアの剣は笑うべきものであり、一つの錆くれにすぎなかったと言う。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
