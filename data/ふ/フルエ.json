    "definitions": [
      {
        "index": 1,
        "gloss": "shivering",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "緊張のあまり、スピーチ原稿を読み上げる手が自分でも分かるほど震えが止まらなくなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大手術を終えたばかりの彼は、麻酔が切れてきたのか全身に小刻みな震えが起きている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "裏切られた怒りで体中の震えがどうしても収まらず、彼は一言も言葉を発することができなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」そう小声で尋ねて、妹から手紙を受け取る私の指先は、当惑するほど震えていました。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寂しい、孤独の中に震える人生の姿である。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋ふかき隣は何をする人ぞ秋さびし手毎にむけや瓜茄子　芭蕉の心が傷んだものは、大宇宙の中に生存して孤独に弱々しく震えながら、葦のように生活している人間の果敢なさと悲しさだった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "側でお絹が小鳩の様に震えて居る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一杯機嫌の此村大吉、ニタニタ笑い乍ら仲蔵を睨んでいたが、　ノッシノッシ花道へ上って、　震え上って居る仲蔵の傍へ寄り、Ｔ「よくも、この大吉と　定九郎とを　一緒にしやがった」　物凄い権幕に仲蔵蒼くなる。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "大吉、又、他の男に「貴様か」　その男、震え上って小さくなる。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　進藤、ガタガタ震え出す。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "若侍の一人が「オオＴ「いい所へ、進藤氏　中村座へ行こう」　進藤、震え上って「馬鹿な事」　若侍が、Ｔ「日下部先生をお頼み　したから　今日は大丈夫」　成程、強そうな日下部典六の一党。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "典六が、Ｔ「日下部典六、一党　引き連れ乗り込むと　聞いたなら　大吉奴、驚くぞ」　と云えば、若侍が「左様Ｔ「震え上って　よう来ぬかも知れぬ」　云い乍ら一同歩いて居る。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大吉、Ｔ「御身の為なら……」　雪枝の声が震えて来た。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）○＝（Ｆ・Ｉ）森の中　駕籠の中の君江が怖ろしさに震えている。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "団九郎の天狗は悠々と現れ出て、Ｔ「我名を騙る　憎い人間ども」　山賊達、震え上る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "杖が先きまで震えている。",
              "citation": {
                "source": "小さき良心",
                "author": "断片",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は黙々として寝台の枕もとに立っていましたが、しばらくすると寒さのために震えながら私の××に這入ってきました。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と言った主人の少女の声は震えて居た。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "怒っちゃ宜ないことよ、」とお富の声も震えて左も気の毒そうに言った。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声さえ震えるに、人々気の毒がりて笑うことを止めつ。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "動かぬもののたとえに引かれるわれわれの足もとの大地が時として大いに震え動く、そういう体験を持ち伝えて来た国民と、そうでない国民とが自然というものに対する観念においてかなりに大きな懸隔を示しても不思議はないわけであろう。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は立ちながら背を擦って、わなわな震えた。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は買い物籠をかかえて、こまかく震えながら一心に一心に待っているのだ。",
              "citation": {
                "source": "待つ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄馬が、ちゃんちゃんと頸の鈴ならして震えながら、よろめき歩くのに適した町だ。",
              "citation": {
                "source": "八十八夜",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひやと寒く、ぶるっと震えた。",
              "citation": {
                "source": "美少女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は黙って、しゃがんで、ガラスの破片を拾い集めましたが、その指先が震えているので苦笑しました。",
              "citation": {
                "source": "春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にのこのこついてきて、何かそれが飼われているものの義務とでも思っているのか、途で逢う犬、逢う犬、かならず凄惨に吠えあって、主人としての私は、そのときどんなに恐怖にわななき震えていることか。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "その朝、父は私にも一緒に行くようにすすめて下さったのですが、私は何だか、こわくて、下唇がぷるぷる震えて、とてもお伺いする元気が出なかったのです。",
              "citation": {
                "source": "千代女",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身が震えて恥ずかしい程だった。",
              "citation": {
                "source": "十二月八日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "或いはまた、桃の花を一ぱいに染めてある寝巻の浴衣を着ていると、私は、ご難の楽屋で震えている新派の爺さん役者のようである。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「雑誌社のものですけど、水原先生に、ちょっと、画の相談、……」　語尾が震えている。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれが悪魔の聖書とでもいったものでしょうか……これこそ世界中にタッタ一冊しかないと噂に聞いたシュレーカーのＢＯＯＫ　ＯＦ　ＤＥＶＩＬ　ＰＲＡＹＥＲ（外道祈祷書）かと思うと私は気が遠くなって、真夏の日中にガタガタ震え出したものでげす。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年は眉香子の中でガタガタと震え出した。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
