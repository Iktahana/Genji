  {
    "uuid": "6b0b8494-3bb5-5dc0-9e3c-e9331f6dc958",
    "entry": "古枝",
    "reading": {
      "primary": "ふるえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "汁気の多い稚木の茎は、斧の一振でサクリと気持よく切れるが、しなやかな古枝は中々巧く切れない。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "正木の籬をめぐらし、梅の古枝が交叉し、五本の棕櫚が屋根よりも高く葉を拡げていました。",
              "citation": {
                "source": "渡舟場",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "根かぶが張りひろがり、幹がまっすぐにつき立ち、頂の方は、古枝が枯れ落ちて、新たな小枝がこんもりと茂っていました。",
              "citation": {
                "source": "椎の木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の野に菫つみにと　来しわれぞ、野をなつかしみ、一夜寝にける明日よりは春菜つまむと標めし野に、昨日も、今日も、雪はふりつゝ百済野の萩が古枝に、春待つと　来居し鶯、鳴きにけむかも（万葉巻八）此等は、美は美であつても、趣味に触れると言ふ程度のものである。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "「百済野のはぎが古枝に、春待つと、来居し鶯、鳴きにけむかも」の歌は、純な拍子で統一してゐる様だ。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る冬、葡萄の栽培をやつて居る時のこと、老人は太いこぶした古枝を鋸で引いて居たが、其葡萄樹を撓はめやうとすると、不幸にして樹は其切口から半ば割れて了つた。",
              "citation": {
                "source": "馬鈴薯からトマト迄",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○百済野の萩の古枝に春待つと居りし鶯鳴きにけむかも　〔巻八・一四三一〕　山部赤人　山部赤人の歌で、春到来の心を詠んでいる。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「萩の古枝」は冬枯れた萩の枝で、相当の高さと繁みになったものであろう。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "萩の古枝　明治三十七年の戦役なかばに、田山花袋君と協力して此本を出した。",
              "citation": {
                "source": "予が出版事業",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "不退の輦一　庭造師が入って、古枝を刈ったり、病葉をふるい落したり、五条西洞院の別荘は、きれいな川砂に、箒の目が立っていた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
