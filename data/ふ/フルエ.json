[
  {
    "uuid": "47c1cadf-71f4-5966-8f83-87c6fd3cb5ed",
    "entry": "震え",
    "reading": {
      "primary": "ふるえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
