[
  {
    "uuid": "1992ff40-d8f7-5c03-a0ad-189bd87b690d",
    "entry": "吹き回し",
    "reading": {
      "primary": "ふきまわし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
