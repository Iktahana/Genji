        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし家庭の経済は楽でなかったから、ともかくも自分で働いて食わなければならないので、シャフハウゼンやベルンで私教師を勤めながら静かに深く物理学を勉強した。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それにくらべると、楢雄はだいいち眉毛からしてフハフハと薄くて、顔全体がノツペリし、だから自分は父親に嫌はれてゐるのだと、次第にひがみ根性が出た。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の道をさまよひ歩いて来たことが一眼に判り、どうしたのかと肩を掴んだが答へず、栓抜きへうたんのやうなフハフハした足取りで二階へ上つてしまつた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルリンのカウフハウスでは穀類や生魚を売っていた、ロンドンの三越のような家では犬や猿や小鳥の生きたのを売っていた。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの岩の上に、どうです、ラフハエルのマドンナを置いちや。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの岩の上に、どうです、ラフハエルのマドンナを置いちゃ。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフハ　花トハ　チガヒマス、オハネガ　アツテ　アチラ　コチラ　トビマワル　コトガ　デキマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　アカチヤンハ　モウ　オメメヲ　アイタカ　ミテ　キテ　チヨウダイ」　テフテフハ　スグ　ウマヤノ　マドカラ　ナカニ　ハイツテ　イキマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　テフテフハ、キノハノ　アヒダヲ　クグツテ　ソラ　タカク　トンデ　イキマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケフハ　クルマヲ　ヒカセテ　ミヨウ」　ソコデ　ウサギハ　クルマニ　シバリツケラレマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフハ　タクサンノ　フウセンノ　ウチ、イチバン　チヒサイ　アカイ　フウセンダマト、タイヘン　ナカヨシデシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「テフテフサン、サヨナラ」　ケレド　シロイ　テフテフハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イイエ、ワタシハ　ツイテ　イキマス」　ソシテ、テフテフハ　ヒラヒラト　アカイ　フウセンダマニ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ソノ　アトカラ　シロイ　テフテフハ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シロイ　テフテフハ　シンパイサウニ、「コレカラ　ドコヘ　イクノ」ト　フウセンニ　キキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イイエ　ワタシ　ツイテ　イキマス」ト　シロイ　テフテフハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンダマト　テフテフハ　タカイ　タカイ　トコロマデ　キマシタノデ、マチガ　ツミキザイクノヤウニ　チヒサク　ミエマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、シロイ　テフテフハ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナク、アカイ　フウセンダマト　シロイ　テフテフハ　ミエナク　ナツテ　シマヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうした機会を逸しては……」　さう心の中で思ふと、信一郎の心は、籠を放れた鳩か何かのやうに、フハ／＼となつてしまつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "技において、ミケルアンゼロに及ばず、巧みなる事ラフハエルに譲る事ありとも、芸術家たるの人格において、古今の大家と歩武を斉ゅうして、毫も遜るところを見出し得ない。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その価値がモジフハイされたのであると思う。",
              "citation": {
                "source": "作物の批評",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "處々乾きかゝつてゐる赤土の運動場には、今年初めての黄ろい蝶々が二つ、フハ／＼と縺れて低く舞つてゐる。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "違反者ニ對シテ死刑ヲ以テセント云フハ必ズシモ希望スル所ニ非ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義的議論ノ多クガ大地主ノ土地兼併ヲ移シテ國家其者ヲ一大地主トナシ以テ國民ハ國家所有ノ土地ヲ借耕スル平等ノ小作人タルベシト云フハ原理トシテハ非難ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "和服ノ不便ナル裁方ナリト云フハ別問題ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ有婦ノ男子ガ淫ヲ買フハ明カニ一夫一婦ノ大本ヲ紊ル者ナルヲ以テ別個ノ意味ニ於テ加罰スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
