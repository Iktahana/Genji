        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "1467年に特別講義としてラージーの「アルマンソール」が行われ、フェラリの持っている図書カタログで半分以上はギリシア医学のアラビア人たちによる注釈であった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの影響のもっと驚くべきことはフェラリの教科書に見られる。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェラリ教授は大学で重要な役割をし、多くの診療を行っていた。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェラリの臨床において瀉血が行われなかったことは殆どなかった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェラリウスの名前。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
