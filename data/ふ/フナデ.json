    },
    "definitions": [
      {
        "index": 1,
        "gloss": "setting sail",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "銅鑼の音が港に響き渡り、豪華客船は世界一周の航海へと壮大な船出を飾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "家族や友人が見守る中、彼は小さなヨットで太平洋横断への船出を果たした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "朝靄が晴れ渡る静かな海へ向けて、漁師たちは大漁を祈願して船出していく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ホワイトマンによって教練された女達のなかにまじって、十九世紀の万国旗に包まれた太田ミサコが船出する。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "失敬なことをいう、盲人がどうした、ものを見るのが私の役か、いざといって船出をする時、船を動かすのは父上の役、錨を抜くのは慶造貴様の職だ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "孤獨な思想家の VISION に浮ぶ、あのうれしき朝の船出を語るのである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故にこそ、あの Auld lang syne（螢の光）の旋律が、古き事物や舊知に對する告別の悲しみを奏しないで、逆にその麗らかな船出に於ける、忘却の悦びを奏するのである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は北海道へ渡るのに、かならず三厩から船出する事になつてゐたので、この外ヶ浜街道はそのための全国の旅人を朝夕送迎してゐたのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いざさらば船宿まで行かめ、船出す出さぬは船頭こそ判じ定むべけれ、我等の今こゝにて測り知るべきにはあらず、行かめ、行かめと手疾く衣を更へて立出づ。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れば平日然までに臆病ならざる輩も、船出の際は兎や角と縁起を祝ひ、御幣を擔ぐも多かり。",
              "citation": {
                "source": "旅僧",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩も水も真白な日当の中を、あの渡を渡って見ると、二十年の昔に変らず、船着の岩も、船出の松も、確に覚えがありました。",
              "citation": {
                "source": "薬草取",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらこそ安易の夢、無智の快楽、十年まえ、太陽の国、果樹の園をあこがれ求めて船出した十九の春の心にかえり、あたたかき真昼、さくらの花の吹雪を求め、泥の海、蝙蝠の巣、船橋とやらの漁師まちより髭も剃らずに出て来た男、ゆるし給え。",
              "citation": {
                "source": "喝采",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして明日はまた海に行く船出の日だ。",
              "citation": {
                "source": "海から歸る日",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三章　御船出男声女声（独唱竝に合唱）その一日はのぼる、旗雲の豊の茜に、いざ御船出でませや、うまし美々津を。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "海凪ぎぬ、朝ぼらけ潮もかなひぬ、艫舳接ぎ、大御船、御船出今ぞ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "大御稜威い照らすと御船出成りぬ、日の皇子や、御鉾とり、かく起ちましぬ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四章　御船謡男声（独唱竝に合唱）その一御船出ぞ、大御船出、御伴船挙りさもらへ、御伴びと挙り仰げや。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三章　御船出男聲女聲（獨唱竝に合唱）その一日はのぼる、旗雲の豐の茜に、いざ御船出でませや、うまし美々津を。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "海凪ぎぬ、朝ぼらけ潮もかなひぬ、艪舳接ぎ、大御船、御船出今ぞ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四章　御船謠男聲（獨唱竝に合唱）その一御船出ぞ、大御船出、御伴船擧りさもらへ、御伴びと擧り仰げや。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一囘の移住者等が國を船出する時は三百戸ばかりであつたが、紀州の熊野沖で難船し、百五十戸分の溺死者を生じた爲め、半數だけ（それが現今では僅かに三十戸）が北海道開拓の祖である。",
              "citation": {
                "source": "日高十勝の記憶",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "この高浜は、盆前から夏一杯、入船出船で繁昌し、一浦が富貴する。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に船頭衆が大晦日の船出をしねえというような極ったんじゃアありません。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいとふなでは格段にふなが美味く、伊勢えびと車えびでは車えびが調子高く、うなぎ・どじょうの洗いを酢味噌で食う手もあるが、夕顔棚の下ででもなければうつらない。",
              "citation": {
                "source": "洗いづくりの美味さ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "おじいさんは、とった魚は、ふなでも、なまずでも、またあゆでも、みんな町へ持っていって売ったのであります。",
              "citation": {
                "source": "都会はぜいたくだ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の晴雨を詳に考ふるなるべしと思へば、天のさま悪しゝ、舟出し難しなど云はれんには如何せんと、傍観する身の今さら胸轟かる。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜襲　天氣好き日の朝舟出して、海より望めばサレルノの美しさは又一しほなるを覺えぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "いでわれ親ら往いて求めんとて、朝まだきに力強き漕手四人を倩ひ、湊を舟出して、こゝかしこの洞窟より巖のはざまゝで、名殘なく尋ね給ひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "『なかなかに己が舟出の旅しもぞ昨日の淵を瀬とも知りぬる』この歌の心をお解し下さりませ。",
              "citation": {
                "source": "誠心院の一夜",
                "author": "今井邦子",
                "note": "青空文庫"
              }
            },
            {
              "text": "浦を一周して、もと舟出せし處に來たる。",
              "citation": {
                "source": "常磐の山水",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽船の方が急なりとて、舟の大なる渡舟を艀舟にせしむといふに、乘り込むもの多かりしかど、舟夫不平を起して舟を出さざれば、また乘りかへ、漸くにして一の艀舟出でむとすれば、衆先を爭うて乘る。",
              "citation": {
                "source": "金華山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の判断に従って果して誤りはないか、大丈夫だろうか、そこが不安というわけで、一旦は否定してそこからはもう自分の生活感情が舟出してしまっている筈の女の歴史の旧の港をふりかえるのである。",
              "citation": {
                "source": "女の歴史",
                "author": "――そこにある判断と責任の姿――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから新しいおわんのお舟に、新しいおはしのかいを添えて、住吉の浜から舟出をしました。",
              "citation": {
                "source": "一寸法師",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
