        "examples": {
          "standard": [
            {
              "text": "新入社員たちは希望に胸を膨らませ、社会人としての新たな船出の日を迎えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "何度も困難を乗り越え、ついに自分たちの店をオープンするという船出を遂げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "卒業式を終えた生徒たちに、校長は輝かしい未来への船出を祝う言葉を贈った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
