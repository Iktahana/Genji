        "examples": {
          "standard": [
            {
              "text": "デパートの屋上から手を振る子供に、笑顔で振り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "窓越しに見送ってくれる母に、電車が走り出すまで何度も振り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "遠くから友人が手を振ってきたので、私も大きく振り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "折角の喧嘩が又ブリ返すたい」「その禿頭をタタキ割るぞ畜生」「止めとけ止めとけ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "辰夫は出張で不在だったが、あの母がヒステリイの翳みじんもなく現れて、神への如き感謝の言葉をのべるのをきき、僕はもう少しで病気をブリ返すところであった。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "辰夫は出張で不在だつたが、あの母が、ヒステリイの翳みぢんもなく現れて、神への如き感謝の言葉をのべるのをきゝ、僕はもう少しで病気をブリ返すところであつた。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
