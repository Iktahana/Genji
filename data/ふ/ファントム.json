        "examples": {
          "standard": [
            {
              "text": "夜の森で、まるでファントムのような白い影が横切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "舞台上に突然現れたファントムは、観客の度肝を抜いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "霧の中に浮かび上がる古城は、まるでファントムのように幻想的だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "子供の恐怖した心持は、切な、ファントムに追われるような、大人の感情に対してよりずっとモンストラスなものだろう。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "探偵小説には、フランスの「ファントマ」や、イギリスの「セキストン・ブレイク」があるが、あれは一人の作者でない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがやがて、ファントマになり、ルパンになったのかもしれないが、そこまでは詮索の限りでない。",
              "citation": {
                "source": "随筆銭形平次",
                "author": "捕物小説は楽し",
                "note": "青空文庫"
              }
            },
            {
              "text": "探偵小説にはフランスの『ファントマ』や、イギリスの『セキストン・ブレーク』があるが、それは多勢の作者が力を協せた作品で、一人の頭脳と手から生まれたものではない。",
              "citation": {
                "source": "随筆銭形平次",
                "author": "平次身の上話",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはルパンの先輩に当る仏蘭西の大盗賊、ジゴマと共に世界にその名をうたわれた、かのファントマの考案した大からくりだ。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "兇賊ファントマの世にも驚くべき創案だ。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "（このにせ腕のトリックはフランスの「ファントマ物語」に使われている。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
