[
  {
    "uuid": "3441d6f4-7665-5a52-984c-b12a132fa5e6",
    "entry": "付保",
    "reading": {
      "primary": "ふほ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
