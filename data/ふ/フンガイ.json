        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "木炭を持つてきてくれないのにフンガイする、油虫の横暴にもフンガイする、フンガイしたところでどうにもならないけれど。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを御覧になった前の奥様はフンガイされまいことか、土けむりを蹴立てて怒鳴り込まれましたが、もはやアト、ノ、マツリでした。",
              "citation": {
                "source": "奥様探偵術",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕達が直ぐフンガイする者だといふことはよく知つてゐるから大丈夫だ。",
              "citation": {
                "source": "〔編輯余話〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "又も自分の話　△又も自慢とでも書かうと思つたけれどさう続いては、あべこべにフンガイのお株を占領されて仕舞ふおそれを感じたので、自分の話……と、これならおとなしくして大丈夫。",
              "citation": {
                "source": "〔編輯余話〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供っぽい正義派的フンガイなんかよりもね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "つかれて、おしまいまでいず（音楽でない音のボリュームで、つかれるの）、寿江子とかえって来て、寿江子は又テクニックの上で不親切な教えかたと、フンガイして居りました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯浅さん、自分の居る間にも仕事をしなければフンガイすると云ってよこした、心持わかる、同時に微笑する。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "フンガイしてかえって来る。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月二十二日（月曜）曇　歯イシャ　娘さん、学校の入学試験があったと云って、先生、治療して居るわきに来て話して居るのをきく、学制の不備にフンガイを感ず。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "広津の「白霧」評、合評、その他、Ｙフンガイしてもう「浦島」をよまず。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙと私、先客のあくのを待って居たのに、ヨゴレタ男に入られ、Ｙフンガイ、迚も湯をアビルこと、あびること！",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓがブローカーだからと云ったと云って彼フンガイする。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "New York でこのことを知った時、自分は和田さんが、その妹の生活を生かすどんな力も働きかけなかったという点に、一種のフンガイを感じた。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙフンガイして「一番慾がないと思った夫婦が一番欲ばりになった。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今栄さんからきいて、自分非常にフンガイしているのに、Ｇ子傍で変に白ばっくれたような顔をしている。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今議会へケンチク士法案を出したいとてアッセンして居る由、佐野利器が利己心からジャマするとフンガイして居られた。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "畳に指で文字をかいてフンガイして見せるところよし。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "会社の都合のいいときはいろいろおだて、実際には「女ども」と軽蔑されるのが、みんなの共通な絶間ないフンガイの種であった。",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、会社の中でいろいろフンガイし、馬鹿にしてるわ！",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "』って云ってやらなかったかと思うわ」「ハハハハハ……でも大分みんなほかの女事務員のひと達もフンガイしたそうじゃないですか」「ええ――でも駄目です。",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい黒い男の子ウペシュは、それを眺めてフンガイするが、どうしよう？",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が尾崎士郎先生とどういう因果で友達になったかというと、今から凡そ十年、いや二十年ぐらい前だろう、私が「作品」という雑誌に「枯淡の風格を排す」という一文を書いて、徳田秋声先生をコキ下したところ、先輩に対する礼を知らない奴であるとフンガイしたのが尾崎士郎で、竹村書房を介して、私に決闘を申しこんできた。",
              "citation": {
                "source": "私は誰？",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "知りもしないくせに」「ヤア坊が言つてたぞ、横浜公園をフラ／＼してゐやがつたさうぢやないか」「あんな奴、知つてるもんか」　親分が冗談にひやかすのを、娘の方はムキになつてフンガイに及んでゐる。",
              "citation": {
                "source": "パンパンガール",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "防空演習にでたことがないから防護団の連中はフンガイして私の家を目標に水をブッカケたりバクダンを破裂させたり、隣組の組長になれと云ふから余は隣組反対論者であると言つたら無事通過した。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "進歩的人物にふさわしくないことであるが、計算に余分の手間がかかるだけだとフンガイしてメートル法の村内侵入に反対した。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、志賀が、終戦後、間の無いころ、たしか新聞紙上で、特攻隊くずれの青年がゴロツキになったりドロボウになったりしている事を、たいへんはげしい言葉でフンガイしたことがある。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そりゃ、今、世の中がこんなふうになって、みんなが増産のためにシンケンになっている最中なんだから、そこいもって来て、あんな人があらわれれば、フンガイするのも、もっともじゃあるけど――いえ、私たちだって、こんな毎日夜業までして働いているんですもの、あなたの前だけど、チョット腹が立つわ、正直いって。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、ホントウにシンから国のためを思って……つまり自分もホントウに国のために命を投げ出してかかっている人が、その事をフンガイするのなら、まだわかるけれど、たいがい、忠君愛国はおれ一人といったふうにノボセあがって良い気持になったり、人のオッポに附いて、つまり附和雷同ね、そいでワーワーいっているのよ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
