        "examples": {
          "standard": [
            {
              "text": "このブラウスは、肌触りを良くするために袋縫いで仕立てられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "袋縫いは、縫い代が表に出ないので、見た目もきれいに仕上がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "家庭科の授業で、初めて袋縫いのやり方を習った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "）　最近材料をそろえて、鷺の宮へ行って足袋縫いをいたします、ついでにお風呂に入って、国男がいるから泊って来ます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "お由は濱へ出て石炭擔ぎをやつたり、倉庫で澱粉や雜穀の袋縫ひをしたり、輸出青豌豆の手撰工場へ行つたりした。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "雉子雉子が啼いた　雉子が啼いた山で啼いた茨に刺されて雉子が啼いた雉子が言ふた　雉子が言ふた山で言ふた足袋縫ふて　はきませうと雉子が言ふた。",
              "citation": {
                "source": "十五夜お月さん",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
