        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近年殆ど漁がなく、毎年、昆布百四五十圓から二百圓、フノリ並にギンナン草二三十圓、ナマコ三四十圓ぐらゐの收入を以つて、僅かにその生活を維持してゐる。",
              "citation": {
                "source": "日高十勝の記憶",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "近年殆ど漁がなく、毎年、昆布百四五十圓から二百圓、フノリ並びにギンナン草二三十圓、ナマコ三四十圓ぐらゐの收入を以つて、僅かにその生活を維持してゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「テフテフサン」ト　トブ　コトノ　デキナイ　花タチハ　イフノデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビヨウキノ　サルヲ　キツテモ　シカタナイト　イフノデ、五人ノ　サムライハ、ソノ　サルヲ　ツレテ　ユキマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサツユハ　オツコチルト　コハレテ　シマフノヨ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウシテ、オトモダチヲ　ジユンジユンニ　タヅネテ　イキマシタガ、ドノ　トモダチモ　オナジ　コトヲ　イフノデ　アリマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモハ　ナカヨシダツタノデスケレド、アンマリ　マンナカノ　ホシガ　サムイ　サムイト　イフノデ　ホカノ　二ツノ　ホシニ　イジメラレタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌスビトト　コヒツヂ新美南吉　ヤワラカイ　クサガ　ミドリノ　モウフノヤウニ　ハヱテ　ヰル　ヒロツパニ　タクサンノ　ヒツジガ　メイメイト　ナキナガラ　アソンデ　ヰマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニシロ、イマニ、コヤミタイニ　オホキナ　ロバニ　ナルト　イフノデスカラ、チヒサナ　クルマデハ　マニアヒマセン。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、アル　ヒノ　コト　ガチヨウノ　タンジヨウビト　イフノデ、ミンナハ　ガチヨウノ　トコロヘ　ゴチソウニ　マネカレテ　イキマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ屍山血河ニヨリテ獲得シタル鑛山（例ヘバ撫順炭鑛ノ如キ）ヲ少數者ニ壟斷シツツアル現時ノ状態ハ實ニ最惡ナル政治ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ權利ハ國家ノ保障スル所有權ノ行使ニシテ其ノ消費ガ道徳的ナルト酒色遊蕩ナルトヲ問フノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈翁ノ世界統一主義ニ對シテ起レル民族主義ガ近世史ノ一大潮流ナリシハ言フノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ軍國主義ガ、單ニ自己ガ問題外ナル傭兵制ナリト云フノ理由ヲ以テ、他ノ徴兵ニヨリテ斯ル軍國主義者ノ侵害ヲ防衞セントスル者ニ己ノ冠ヲ冠セントセシハ惡ムベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボルセヴイキ」ハ此ヲ防グベク、「ボルセヴイキ」ヲ必然スル義務ノ忘却ハ可ナリト云フノ理ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ東洋ノ獨逸ナリト云ハレ、獨逸ト等シキ軍國主義侵略主義ノ國ナリト云ハレ、列國環視ノ間「ウヰルソン」輩ノ口舌ニ萎縮シテ面上三斗ノ汗ヲ拭フノ恥晒シヲ爲セシ者悉ク是レ天意。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見兩立スベカラザルカノ如キ此等ガ、其實如何ニ日米兩國ヲ同盟的提携ニ導クベキ天ノ計ラヒナルカノ如キ妙諦ハ今是レヲ云フノ「時」ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "例せばシフノス島には毒蛇あり、ケオス島に蠍、アンチパロス島には蜥蜴のみありて全く蛇なし（ベントの『シクラデス』九〇頁）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便局長の夫人も郡警察署長も、青い羽根をつけた婦人も、白い羽をつけた婦人も、ジョージヤ人の公爵チプハイヒリッゼフも、ペテルブルグから来た役人も、モスクワから来た役人も、フランス人のククーも、ペルフノフスキイも、ベレベンドフスキイも――みんな立ちあがって踊りだした……。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ノ　上カラ見テヰルトハタモ　ヒラヒラヒルガヘリケフノ　ヨキ日ヲイハヒマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "モヤー、ブフノワに話すといって、『中央公論』正月号掲載の無産階級の文学（片上伸）論の梗概を話す。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナツテシマフノデスガ、今夜ハサウナラナイ内ニ、ワザト魔法ニカカツタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "以テ昭君漢ヲ慕フノ心ヲ標スル也ト。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中『東京學士會院雜誌』第三篇八册に掲載されてある、神田孝平氏の「支那人人肉ヲ食フノ説」の一篇が、尤も傑出して居る。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二日、七時より放牧塲（ノフノヤウシ）即ち昨日見る処に至りて馬匹を観んと欲し、彌吾吉王藏同行せり。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "交番ニユキマスト、カワイラシイ女ノ子ノオマワリサンガヰテ、帳面ヲシラベテクレマシタガ、サツパリ玉ネギサンノスンデヰル村トイフノガ分リマセンデシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キノフノバン、私ノウチノ地下室ニトマツタ玉ネギサンガ、行方不明ニナリマシタ。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリヨクニアフノデ、オ母サンハ山羊ノ写真ヤサンヲヨンデ、キネンノ写真ヲトツテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オマツリガ　アルノデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
