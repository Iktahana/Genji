        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フィーザー紙に毎週六枚描いて、私にはとても大切な注文だよ」「でもそれって、盗用でしょう」　コニーが相変わらず陽気にこたえた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィーザー紙はそれよりずっといい。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにあした期日のフィーザー紙挿絵もある。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "週末までフィーザー紙からお金は出ないのでしょう？",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "スピード夫人の夜逃げでフィーザー紙の仕事を失った。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに昨夜、にべもなく告げられたのはもうフィーザー紙の仕事がない事よ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィーザー紙のおかげで、ハニザクル週刊誌から注文が取れるかも知れない。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
