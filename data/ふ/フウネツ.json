        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "全體人の頭は腦髓と云ふ極大切なるものゝ有る所なる故に、頭骨有りて其腦髓を圍み守護するなれども、猶其上風熱を防ぐ爲に自然備たる毛髮なれば、剃落す道理なし。",
              "citation": {
                "source": "養生の心得",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧風熱は沸騰して、十二年の九月には、外国役者の一座、英、米、仏人混合の一座をかけたりしたが、言葉がわからないので一般には不向きで不入りだったという、種々の経緯はあったが、新富座は劇道人の向上にはたいした役割をもった。",
              "citation": {
                "source": "朱絃舎浜子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうした部類の立てられたのは、当時の採風熱からである。",
              "citation": {
                "source": "万葉集のなり立ち",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときに明月高く懸かり、清風熱を洗いきたる（当夕満月）。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "刀よ、物の具よ、櫓よ櫂よ、と騒ぎ合ううちに、火雨のごとき投げ炬火が、一船を焼きまた一船に燃えうつり、またたく間に、水上の船影幾百、大小を問わず、焔々と燃え狂わざるなき狂風熱水と化してしまった。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ままある急な御風熱と拝されます。",
              "citation": {
                "source": "私本太平記",
                "author": "黒白帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
