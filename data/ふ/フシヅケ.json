    "definitions": [
      {
        "index": 1,
        "gloss": "setting to music",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は自作の詩に節付けをして、ギターを弾きながら歌い始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "伝統的な民謡の歌詞に、現代風のリズムで節付けを試みる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い物語を語るために、琵琶の音に合わせて節付けが行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "たとえば上例の諸句にしても、「この道や行く人なしに秋の暮」などの句にしても、言葉それ自身に節奏の抑揚があり、その言葉の節付けする抑揚が、おのずからまた内容の沁々とした心の咏嘆（寂びしおり）を表出している。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり言えば、芭蕉俳句のポエジイは、全くその声調の節付けてる音楽の中に存しているのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と鳴つて、軍歌を節付け、唱歌を習つて来る音を耳にして、凡そその吹奏者を憎む人は皆無であらう。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "と鳴つて、軍歌を節付け、唱歌を習つて來る音を耳にして、凡そその吹奏者を憎む人は皆無であらう。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、お由の家の障子に影法師が映つて、張のない声に高く低く節付けた歌が聞える。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「絵をかたり琵琶を弾きて」と註したのを見ても、絵の説明を節付けでした事が訣る。",
              "citation": {
                "source": "お伽草子の一考察",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の延寿太夫にしても、松尾太夫にしても大体は在来の清元であり常磐津であって、改変独自の節付けではないのである。",
              "citation": {
                "source": "私の陶器製作について",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつぞや、御家中の岡村の旦那から伺いますに、其角の句を読み入れた新作をお作くんなすって、それを藤七が節付けしたってお話じゃござんせんか。",
              "citation": {
                "source": "脚",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "謡曲界では観世宝生を始め、それぞれめでたい文句の小謡を新作して節付けしたのを門中へ頒つ。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "原始の旋律は、それ自ら歌詞の節づけとして唄はれたものである。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ自らが詩人の「心内の節奏」を節づけする所の「旋律としてのリズム」がある。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも彼等は、之れに外部からの音樂――詩の定まれる韻律形式――をあたへ、それの節づけによつて歌はうとする。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし単に詩の特色が、それだけの点にあるとすれば、いやしくも音律を以て本位とし、節づけられて歌われたすべてのものは、文学である限りに於て、必然に皆詩と言わねばならないだろう。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれもよく知る如く、詩は昔に於て音楽と共に――おそらくは尚舞蹈と共に――節づけされた手拍子、もしくは楽器に合せて歌われたものである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……手ン手が手本を控えて、節づけと目張りッこで、謡ばかり聞いている。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "節づけ拙けれど、人々の真面目に聴きいる様は、世の大方の人が、信ぜぬ乍らも己が厄運にかゝはる卜をばいと心こめてきくにも似たり。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば嬉しさを表現する時には躍り上るような音階を通じて最高音に達し、悲しみをあらわす事には嫋々切々として、ためらいつつ最高音に達するように節づけたとする。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏の夜更け、私は独り言葉もなく、ボロ手風琴を持ち出してサチユーロスの登場歌の節づけに余念がない。",
              "citation": {
                "source": "真夏の夜の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（逢って様子を聞きたいものだ）　その時源女が昔ながらのとはいえ少し力の弱い声で、「独楽は生独楽生きて廻る」と、口上を節づけて述べ出した。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此を節づけて語りはじめたのは、誰であらう。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "節づけの面白さは、こゝに発現する。",
              "citation": {
                "source": "玉手御前の恋",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうすれば、この不思議な台本は、何か別の理由があつて書かれ、節づけせられたものに違ひない。",
              "citation": {
                "source": "由良助の成立",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（自由に節づけられて歌ふもの、單純な作曲によるもの。",
              "citation": {
                "source": "プロレタリア童謠の活用に關する覺書",
                "author": "――兒童の指導者・保護者達に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶えず新しい作ばかりを節づけているんですよ。",
              "citation": {
                "source": "幻影の都市",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "室町小唄に私の琴の先生が節づけしたものです。",
              "citation": {
                "source": "おじさんの話",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
