[
  {
    "uuid": "d0c0e40b-0549-5a8f-b25d-4f656c2ad292",
    "entry": "フフフフ",
    "reading": {
      "primary": "ふふふふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「コン畜生め、惚れやがった癖に、フフフフフ。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "のっそり降りると、「ウフフフフフ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "くやしくてならねえんですよ」「ウフフフフフ、そんなことで泣くのがあるかよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しばかり男ぶりがいいったって、目のくらむあっしじゃござんせんよ」「ウフフフフ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫く、靴音が遠くなってから、とても若々しいハミングが、フウフウフフン、ウフフフフンとか聴えて来ました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "文をもらってさ」「それじゃやっぱり女だろう」「なあに男がさ」「男なら、その坊主だろう」「ええ、その坊主がさ」「坊主がどうして驚ろいたのかい」「どうしてって、本堂で和尚さんと御経を上げてると、突然あの女が飛び込んで来て――ウフフフフ。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "下世話にも鼻より団子と申しますれば美的価値から申しますとまず迷亭くらいのところが適当かと存じます」寒月と主人は「フフフフ」と笑い出す。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥方はちゃんといるぜ、君」「ウフフフフ」と主人は笑いながら「構うものか」と云った。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "フフフフ……そんなに固くなって座り直さなくともいい。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッハッハッハッハッ……ゴホンゴホン……妙な顔をしているじゃないか……ウフフフフフフ是非とも吾輩が死んでいないと具合がわるいと……ゲッヘンゲッヘン……云うのかね。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "フフフフ」「……………」「……とにかく奇妙奇態だろう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフフフフフフ……ゾッとする筈だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたら足を抱えていた男が、「サア……天国へ来た……」「ウフフフフ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴方の天才的頭脳によって仕組まれた一つの恐ろしい喜劇に過ぎないと、私が断定している理由がおわかりになりますか」「……………」「……フフフフフ。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうでしょう……どうです……」「……………」「……ウフフフフフ、私がこの眼で見たのですから、間違いは無い筈です。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アハハハハハハ」「オホホホホホホ」「ウフフフフフフ」　泥棒は夢中になって逃げ出すと、すぐに通りがかりの巡査さんに捕まりました。",
              "citation": {
                "source": "雪子さんの泥棒よけ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "見込みがあるぞッ」「ワハハハハハ……」「フフフフフフ……」　昂作はそんな笑い声を耳にしながら、静かに頭を横にして起き上りかけた。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
