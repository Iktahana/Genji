          "literary": [
            {
              "text": "あたかも一九一六年ファルケンハインのいわゆる「制限目的をもってする攻勢」であるベルダン攻撃に似ている。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルトケ大将はマルヌに敗れて失脚し、陸相ファルケンハインが参謀総長を兼ねる事になった。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファルケンハインは西方に於て頽勢の挽回に努力したが遂に成功しなかった。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファルケンハインの失脚に依りヒンデンブルク、ルーデンドルフの世の中となった。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
