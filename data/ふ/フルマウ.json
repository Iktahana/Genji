[
  {
    "uuid": "c87f3256-60e6-5f6a-9c83-26974b6e25de",
    "entry": "振舞う",
    "reading": {
      "primary": "ふるまう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ウ行",
