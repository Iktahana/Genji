        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我ガ日本亦五十年間ニ二倍セシ人口増加率ニヨリテ百年後少クモ二億四五千萬人ヲ養フベキ大領土ヲ餘儀ナクセラル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ日本存立ノ國防上ヨリ朝鮮ハ永久ニ獨立ヲ考フベキ者ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ノ神ハ「クエーカー」教徒ノ神ニ對シテ彌陀ノ利劒ヲ揮フベキノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ナル豐作ヲ以テストモ日本ハ數年ノ後ニ於テ食フベキ土地ヲ有セズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "外力ノ援助ナクシテ植民米人ガ戰フベキ武力ヲ有セザリシ如ク、一切ノ武器ヲ奪ハレシ印度獨立軍ニ對シテ恣ニ鎭壓軍ヲ輸送セシムルナラバ其ノ獨立ハ永久ニ期待スベカラザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國政ヲ執ツテ國ヲ亡ボサントスル斯クノ如キ者ニ加フベキ大逆罪ノ法文ナキヲ如何セン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "固ヨリ之ト離別スルノ理ヲ以テ之ト離別シ、且既ニ不覊独立ノ国ト為リタルガ故ニ、或ハ師ヲ出シ或ハ和睦ヲ議シ、或ハ条約ヲ結ビ或ハ貿易ヲ為ス等、都テ独立国ニ行フベキ事件ハ我国ニ於テモ之ヲ施行スルノ全権アリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモソノ取ツテ以テ今日ニ用フベキ者ヲ求ムレバ僅僅ノミ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ時事ノ得失人物ノ是非ニ渉レバ輙チ厭フベキヲ覚ユ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "門生田中は凡例の一に、「此篇ハ朝夕講習ノ餘話ヲ集録ス故ニ往々錯雜ヲ免レズ其説多クハ一千八百五十二年我嘉永五年撰スル所ノ和蘭人フアン・デン・ベルグ氏ノ「理學原始」ヨリ出ヅ直寫影鏡ハ數年前吾師既ニコレヲ實驗シ蒸汽船ハ本藩已ニコレヲ模製ス他ノ諸器ハ未歴驗セズト雖其理亦疑フベキコトナシ」と書いてゐる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
