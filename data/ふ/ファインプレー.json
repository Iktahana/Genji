        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "野球の試合で、外野手がダイビングキャッチを見せてファインプレーを披露した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の機転の利いた判断が、チームを救うファインプレーにつながった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "おお、今のパス、まさにファインプレーだったね！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "柳ばかりでない、手塚もいろいろな快技曲技をやって見物人を酔わした、かれはもっとも得意であった、ファインプレーをやるたびに見物人の方を見やって微笑した、ときには帽子をぬいで応援者におじぎをした。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "このバッテリーの呼吸がうまく合わないと、生命がけのファインプレイが出来ないのだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互いに舞台上の演出効果――蔭の花を持たせ合って、透かさず舞台気分を高潮させ合い、共同一致のファインプレイを演出し合うだけの虚心坦懐さがなければ仁輪加の花は咲かない。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは、日本軍の奇略縦横、疾風迅雷のファインプレイに拍手を送るものであるが、敵の執拗なゲリラ戦術とやらには業を煮やさざるを得ぬ。",
              "citation": {
                "source": "私の従軍報告",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
