          "literary": [
            {
              "text": "西海岸の有名なサーファー、チャールズ・ファーデンスだった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちがコンクリート海底による人工サーフを蹴ったことを知ったファーデンスは、西海岸からハワイへ飛んで来た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャールズ・ファーデンスが組織した人工海底の支持グループは、早くも解体のきざしを見せていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "差出人はチャールズ・ファーデンス。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "映写してくれ」　あのチャールズ・ファーデンスがわざわざ８ミリに撮り、送って来た波だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
