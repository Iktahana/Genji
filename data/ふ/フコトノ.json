          "literary": [
            {
              "text": "日本ガ積極的發展ノ爲メニ戰フコトノ單ナル我利私欲ニ非ザルコトハ、他ノ民族ガ積極的覺醒ノ爲メニ占有者又ハ侵略者ヲ排除セントスル現状打破ノ自己的行動ガ正義視セラルル如ク正義ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ一事ヲ以テモ、上方勢ト取合フコトノ無益ハ、匹夫モ覚ルベシ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
