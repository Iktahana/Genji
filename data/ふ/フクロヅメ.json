    "definitions": [
      {
        "index": 1,
        "gloss": "packing (something) in a bag",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
