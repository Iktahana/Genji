        "examples": {
          "standard": [
            {
              "text": "プロジェクトは現在、設計から開発へと移行する新しいフェーズに入っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "治験の最終フェーズでは、多くの被験者を対象に有効性と安全性が確認される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "月の満ち欠けのフェーズを観察し、天体観測の記録をノートに書き留めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "炎がやんで次の火花のフェーズに移るまでの短い休止期がまた名状し難い心持ちを与えるものである。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の母はこの最後のフェーズを「散り菊」と名づけていた。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "電電公社通信研究所の依頼を受け、日本電気は音の信号に応じてパルスの位置をずらすＰＰＭ（パルス・フェーズ・モジュレーション）と呼ばれる技術を用いた通信装置の開発を進めていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
