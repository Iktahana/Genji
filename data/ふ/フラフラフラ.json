  {
    "uuid": "56ee357f-3d9b-5ef2-837e-8474796ee4ff",
    "entry": "フラフラフラ",
    "reading": {
      "primary": "ふらふらふら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "吾輩の気焔を聞かされたら、大抵の奴がフラフラフラと……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "フラフラフラッとどこかの国へ」　漂泊の情が起こって来た。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フラフラフラフラと歩いて行く。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　フラフラフラフラと歩いて行く。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お逃げなさりませ、お逃げなさりませ」　フラフラフラフラと裏門を出た。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パチッと納めるとフラフラフラ、宗春先へ進んで行く。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　パチンと納めるとフラフラフラ！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "球を受け留めると、「フラフラフラホウ、フラアラアラキャット」なんぞと口走る。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "実にその瞬間、由也はまるで目マイでも起したのか、フラフラフラと、身ぶるいを起して、ホッと一息して、「そうか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄夫は厭な気持がして、フラフラフラッと降りてきた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　手紙の奴を二本の指につまみあげてフラフラフラッと机の前まで歩いてくると、まつさきに身体全体ぼんやりした。",
              "citation": {
                "source": "金談にからまる詩的要素の神秘性に就て",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……」　ボーッと夢見心地に包まれながら次郎吉は、そのままフラフラフラフラ薄闇の彼方へ迷いでていった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "フラフラフラと身体の中心を失い思わず前へのめっていったときツルリ小圓太右足を踏み滑らした。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
