          "literary": [
            {
              "text": "しかし私はクノオ・フィッシェルの四冊になって出ているファウスト研究を最尊重する。",
              "citation": {
                "source": "訳本ファウストについて",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがクーノ・フィッシェルやトレルチの家の門をくぐることは私には幾度も躊躇されたでせう。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "リッケルト教授はハイデルベルクの哲学を代表し、その講義はかつてヘーゲルが、クーノー・フィッシェルが、ヴィンデルバントが講義したことがあるという由緒のある薄暗い教室で行なわれた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "通訳官のフィッシェルという人もいたが、この人は面白い論文ばかり書き、いつも私にくれていた。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
