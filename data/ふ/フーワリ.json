  {
    "uuid": "16e8928b-b07c-543a-8d48-caa35b2b287d",
    "entry": "フーワリ",
    "reading": {
      "primary": "ふーわり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
