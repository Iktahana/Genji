        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "懐月堂のふくれた顔の線は彼の人物の体躯全体としての線や、衣服のふくらみの曲線となって至るところに分布されて豊かな美しさを見せている。",
              "citation": {
                "source": "浮世絵の曲線",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "師宣、政信、懐月堂等の諸家は板画と共に多く肉筆画の制作をなせしが、鳥居清信専ら役者絵の板下を描き、宮川長春これに対して肉筆美人画を専らとせしより、中古の浮世絵はやや確然として肉筆派と板下派との二流に分るるの観ありき。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは友禅の京都、懐月堂の江戸。",
              "citation": {
                "source": "偶言",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "清吉は、自分が惜しい眼でもしていないかと惧れて、床の間の懐月堂の幅を見ていた。",
              "citation": {
                "source": "春の雁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い懷月樓の三階へきりきりと繰り上ぐる氷水の硝子杯、薄茶に、雪に、しらたま、紅い雪洞も消えさうに。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
