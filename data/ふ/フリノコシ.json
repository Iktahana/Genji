          "literary": [
            {
              "text": "私は古人の「五月雨の降り残してや光堂」の句を、日を距ててではありましたが、思い出しました。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の七が降り残したるではなく、降り残してやだったことも新しい眼で見得た気がしました。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "さみだれの降り残してや光堂夏草やつはもの共が夢の跡　ああそうだ待っている。",
              "citation": {
                "source": "平泉紀行",
                "author": "──専攻科第一類歴史部──",
                "note": "青空文庫"
              }
            }
          ]
        }
