[
  {
    "uuid": "8a7df69e-8307-53c4-bff8-19c8191edcbf",
    "entry": "節榑",
    "reading": {
      "primary": "ふしくれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "knotty wood or tree",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "節榑だらけの古い木材は、家具作りには向かないかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その山の斜面には、風雪に耐えた節榑の木々が立ち並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は節榑の木を丹念に削り、美しい彫刻作品を作り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "八は節榑立つた不器用な指で、此の玉を捩つて開けたのである。",
              "citation": {
                "source": "金貨",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファウスト己は足の草臥れぬ間は、この節榑立った杖一本で沢山だ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時にステパンは節榑立つた拳を握り固めて夫人の顔の前で振つた。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨセフはそのわが子の躯を、その勤勉な性質を語り顔な大きな節榑立った掌に受けた。",
              "citation": {
                "source": "聖家族",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　年寄りはそれは御苦労なこったという顔をしてうなずいて、その節榑立った指さきで、もとの同僚の遺児の頬を不憫そうに撫でた。",
              "citation": {
                "source": "夕張の宿",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "読む人々も、恁くては筋骨の逞しく、膝節手ふしもふしくれ立ちたる、がんまの娘を想像せずや。",
              "citation": {
                "source": "甲冑堂",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふしくれだった黒い大きい右手には、先刻の菖蒲の花束を持っている。",
              "citation": {
                "source": "令嬢アユ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大の男が、あんな小さい弓を、ふしくれ立った手でひねくりまわし、百発百中の腕前になってみたところで、どろぼうに襲われて射ようとしても、どろぼうが笑い出しますし、さかなを引く猫にあてても描はかゆいとも思やしません。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "読む人々も、かくては筋骨｜逞しく、膝節手ふしもふしくれ立ちたる、がんまの娘を想像せずや。",
              "citation": {
                "source": "一景話題",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "凌霄はふしくれ立つた松の幹でも構はずに絡みかゝる。",
              "citation": {
                "source": "佐渡が島",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふしくれだつたそのからだは、ちようど、うすつぺらな石炭袋へ石炭をぎゆう／＼つめこんだやうなかつこうです。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争中は自分のようなものにも徴用ということがあって、センバンを握り、手もふしくれて、油にまみれて働いた、国にお務めをした、というような、落ちついて澄んだ心のうかゞわれることが、タド／＼しい文字で綴られており、今、宗十郎門下にいて、青年歌舞伎にでているから、見物してくれ、と書いてあった。",
              "citation": {
                "source": "死と影",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬめらかなる玉は、すべり安く、ふしくれだちし手には、あまりに痛ましく、たへがたく――すべり落つるも、ことわりなり。",
              "citation": {
                "source": "かの日の歌【三】",
                "author": "漢那浪笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い、ふしくれ立ったくるみの木が一本、そこにあったが、その樹蔭で、よく小さいヨハンネスが、低い木椅子に腰かけてくるみをかじっていると、フリイデマン夫人と、もう今は大きくなった三人姉妹とが、灰色の帆布でできた天幕の中に集っていた。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "身もだえするごとく右肩を内側にひきしめ、全身の筋肉がふしくれだってそのまま凝結したようにみえる。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈の低い、ふしくれだった頑丈なその幹と枝ぶりはゴッホの筆触を思わせた。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "からだつきは、がっしりとふしくれだっているのに、頭は小さくて、しかも、とってもおだやかな、やさしそうな顔つきをしているのです。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの痩せ細った脛は、ふしくれだった膝は、両方ぶつかりあった。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い顔が紫色に変って、ふしくれ立っていた。",
              "citation": {
                "source": "月と手袋",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "……いまのままでは」　急に、又四郎のからだが、ふしくれ立った。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "積善会の方はまた話が何とかつくだろう』ということで、白水は事務所へ、その節くれ立った木の切り株のような男と一緒に行ったんだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "小相撲ぐらい恰幅のある、節くれだった若い衆でしたが……」　場所がまた悪かった。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――　一言ずつ、呼気を吐くと、骨だらけな胸がびくびく動く、そこへ節くれだった、爪の黒い掌をがばと当てて、上下に、調子を取って、声を揉出す。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……供揃へ三十　いや、其の息の臭い事……剰へ、立つでもなく坐るでもなく、中腰に蹲んだ山男の膝が折れかゝつた朽木同然、節くれ立つてギクリと曲り、腕組をした肱ばかりが胸に附着き、布子の袖の元へ窄つて両方へ刎ねた処が、宛然の翼。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聾の、唖の、明盲人の、鮫膚で腰の立たぬ、針線のやうな縮毛、人膚の留木の薫の代りに、屋根板の臭の芬とする、いぢかり股の、腕脛の節くれ立つた木像女が何に成る！",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "激しい労働生活で節くれ立った彼の愛すべき掌へ、私は故国から来た親愛なる手紙の封書の切手を何枚もはがして乗せてやりました。",
              "citation": {
                "source": "雪の日",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手と左手との運動を巧みに対応させコーオルディネートさせる呼吸がなかなかむつかしいもので、それができないと紡がれた糸は太さがそろわなくて、不規則に節くれ立った妙な滑稽なものにできそこねてしまうのである。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱けても知らずに口を開いて、小さな舌を出したなりで、一向正体がない……其時忽ち暗黒から、茸々と毛の生えた、節くれ立った大きな腕がヌッと出て、正体なく寝入っている所を無手と引掴み、宙に釣す。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁夫たちは真新しい青畳に気をかねながら、もり上った股をきちんと揃え、節くれ立った両手をその上において窮屈そうに坐った。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　太田の聲が耳にはいると、男は一瞬ぎくりとしたふうであつたが、たちまちその節くれ立つた兩手をぴつたりと板の間につかへ、額が下につくほどに平たくなつて禮をした。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
