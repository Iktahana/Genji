[
  {
    "uuid": "4c41a275-4819-542d-b80d-1e2d0c1824a8",
    "entry": "吹き溜まり",
    "reading": {
      "primary": "ふきだまり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
