        "examples": {
          "standard": [
            {
              "text": "荒涼とした平原にぽつんと残る石柱だけが、かつて栄華を極めた王朝の故郷であることを示していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "万葉の歌人たちが愛したこの地を訪れると、いにしえの故郷にタイムスリップしたような錯覚に陥る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "草に埋もれた城跡の故郷に立ち、歴史の無常さに思いを馳せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
