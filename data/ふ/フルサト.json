  {
    "uuid": "94f7ac09-e2cc-54ed-b82d-6832ef89320a",
    "entry": "フルサト",
    "reading": {
      "primary": "ふるさと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
