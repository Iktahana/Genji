        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "うちの小さい甥は、フクチャンに絶大の親愛を傾けている。",
              "citation": {
                "source": "“子供の本”について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもフクチャンの絵本はどうにも買ってやろうという気がしない。",
              "citation": {
                "source": "“子供の本”について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一頁をいくつにも区切って、新聞の絵の一コマの狭さのものがそのまま、ただびっしり詰められてあるきりで、ゆったりと心持ちよい線で描き出されたフクチャンを子供らに見せてやろうという愛の配慮やユーモアはないのである。",
              "citation": {
                "source": "“子供の本”について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちへのおくりものは、太郎にフクチャンの羽子板。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
