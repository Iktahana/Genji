        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "入レナイドコロカ、机ノ上ニデモアッタカ、ナイフヲイツノ間ニカ抜イテ、蒼白ニナッテフルエナガラ、突然私ニ斬リツケタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイキナリ道子ノ髪ヲツカミ清三ノ持ッテ居タナイフヲ突キツケテ声ヲ立テルト殺スゾト云ッテヤリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ末廣澤田二子ヲシテ久シク囹圄ノ中ニ貴重ノ光陰ヲ消過セシメタルモ、亦汝ノ罪ニ非ズト謂フヲ得ズ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "――玉クシゲ覆フヲ安ミ、明ケテ行カバ君ガ名ハアレド、ワガ名シ惜シモ。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔不材空シク愧ヅ昭代ニ逢フヲ／多難猶｜欣ブ厄年ヲ過ユルヲ〕というを見れば、甲辰の年には二十五の厄年に一歳を加うべきである。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡ソ事ハ名実｜相副フヲ貴ブ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニウジヤアシイにては人類の前頭骨に石鏃の立ちたる儘の物を發見し、チリのコピアポにては人類の第二の脊椎に石鏃の立ちたる儘の物を發見し、フランスのフヲンリヤルにては人類の脛骨に石鏃の立ちたる儘の物を發見したる事有り。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ト云フヲ以テ直ニ範圍狹シトナス勿レ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "石器時代人民ト云フヲ以テ唯野蠻ノ一種族ニ關スト速斷スル勿レ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノタメニカルダンノ絹ノネッカチーフヲ買ッテヤル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「テキテイモ、テツノニンギョモ、ニゲサッタ、ホンテイハ、フキンノ、ケイカイニアタル、スグ、センスイフヲイレヨ」　その無電をうけたハヤブサ丸では、ちゃんと用意をしてまっていた、ひとりの潜水夫を、すぐに大洋丸へと、もぐらせました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "今川ノ古跡、千本桜ナド詳シク尋ネ聞シメサレ、阿倍川ヲ越エ給ヒ、武田四郎勝頼ガ此地ニカカラレ候折ノ持舟ノ城トイフヲ問ハセラル。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "茲にレストラントと云ふも、普通の西洋料理店と違ひ、家屋の構造、フヲルニチユーアの選択、内部の装飾等、一々西洋風簡易生活法の研究を目安として意匠をこらし、中に新聞雑誌縦覧処、簡易なる楽器、室内遊戯の器具等を置き、青年の為、清潔なる娯楽と飲食の場処を設くるにつとめつつあります。",
              "citation": {
                "source": "太平洋食堂",
                "author": "大石誠之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "“西行谷ノ麓ニ流レアリ、女ドモ芋洗フヲ見テ”として、芋洗ふ女西行ならば歌よまん　という句を遺している。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
