        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「グラナダの夕」には一九〇三年この曲の初演をしたという老ピアニストのリカルド・ヴィニエスのひいたレコードがあるのは嬉しい（コロムビアＪ七七四七）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロムビアの世界名盤集にギーゼキングのがあり、他にヴィニエスもある（コロムビアＪ五一五一）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノの一枚物では、老ピアニスト、ヴィニエスのピアノでコロムビアに「セギディリア」「グラナダ」があり、ビクターに「カディス」がある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィニエス　〔Ricardo Vin~es〕　ドビュッシー、ラヴェル等の近代ピアノ音楽の最初の紹介者にして、新人たちの崇敬の的になっているのは、スペインのピアニスト、リカルド・ヴィニエスである。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰よりも先にフランス、スペインの近代の良さを理解し、その高度の技巧を捧げて、新時代のピアノ音楽に良きスタートを開いてやったヴィニエスの先見と同情に私は敬意を表したい。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
