        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから二人でホテルを出ると、一時間ばかり古本屋だの古道具店だのをひやかしたのち、海岸通りのヴェルネ・クラブに行った。",
              "citation": {
                "source": "旅の絵",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時その婦人が風呂敷包を開けながら、ヴェルネ氏に渡したものをちらっと見ると、それは一匹の可愛らしい三毛猫であった。",
              "citation": {
                "source": "旅の絵",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ氏はそれをにこにこして受取りながら、しきりに 〔Tre`s bien ! Tre`s bien !〕 と繰り返している。",
              "citation": {
                "source": "旅の絵",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はふとヴェルネ・クラブでちらっと見た美しい婦人の抱いていた仔猫のことを思い出し（どうしてだか、それがずっと数日前のような気もしたが）、そのきたならしい猫をそっと抱き上げて、咽喉のところを撫でてやったら、すぐにそいつが咽喉をごろごろ鳴らし出したので、私はなんだか反ってさびしい気がした。",
              "citation": {
                "source": "旅の絵",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウジェニイは心ならずもさういふ弟を殘して、翌年の春巴里を離れ、メエトル夫人と共に、ニヴェルネ地方を旅しながら數ヶ月を送つた。",
              "citation": {
                "source": "モオリス・ド・ゲランと姉ユウジェニイ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はなほ、『ヴェルネ氏』『田舎の一週間』『偏屈な女』の諸作を残して劇作家としての仕事を終つてゐる。",
              "citation": {
                "source": "仏国現代の劇作家",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ喫茶店に坐っていると、海岸通りを若い奥さんの通って行くのが見えた。",
              "citation": {
                "source": "犬を連れた奥さん",
                "author": "DAMA S SOBACHKOI",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリ　……ヴェルネ、もう、なん時ごろだろう？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右腕が肩のつけ根からない）ヴェルネ　そうさな……（これは中央の板椅子にかけて、火の消えたパイプをくわえている。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　天気が良いと、こうだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　二、三日前から、ワイスの奴あ、ボウ鳴らすの、やめてるよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　だけどよ、アンリ、ボウは交替の合図だあ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　炭車も昇降機も停っちゃってるしな、ボウだけのために釜に火を入れるの無駄だってバリンゲルさんが言ったそうだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　デニスよ、まあまあ落ちつけ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネは俺たちの坑夫頭で、まあ大将だ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを俺あ――ヴェルネ　まあまあデニスよ、お前はそう言うが、ここの先生は俺たちのことをしんから心配して掛け合いに行ってくだすってるんだぞ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　そこは何ともわからねえぞデニス。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前の考えるぐれいのこと、ヴェルネが考えてねえと思うか？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを――ヴェルネ　まあまあ、まあまあ、気い立てるな二人とも！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなひでえ目に逢うのが俺たちの――ヴェルネ　俺たちのせいじゃねえよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　フフ、フフ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　お前にゃ、おっ母あが笑っているように見えるかデニス？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　笑ってる。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリ　バリンゲルの方であんまりわからねえ話をするんで、喧嘩にでもなったと言うような――ヴェルネ　いや、そんなこともなかろう。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　そうさ、喧嘩よりは、そっちの方かも知れん。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　うむ、変っていると言やあ変ってる。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　そう言ってたそうだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　いや、なんかこの、親戚の、絵を商ってる店に勤めていたそうだがな、うむ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネ　なんしろ、きとくなじんだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（デニスのえりがみをガッと掴む）ヴェルネ　おいおい！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
