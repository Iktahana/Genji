        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると、その挨拶の任に当つたのが、ほかでもない、汽車に轢かれて亡くなつた詩人ヴエルハアレンであつた。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴエルハアレンは落着いた態度で立ち上つた。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴエルハアレンは、静かに透きとほるやうな声で、「白耳義国王陛下並びに皇后陛下……」と一言言つた。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            },
            {
              "text": "一分経ち、二分経つても、ヴエルハアレンは何一つ後を言ひ足さなかつた。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
