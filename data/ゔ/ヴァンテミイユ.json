          "literary": [
            {
              "text": "４　私達はマルセイユ発ヴァンテミイユ行きのＰ・Ｌ・Ｍ列車をアンティブで見捨てたのだった。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、ふらんすと伊太利の国境駅のヴァンテミイユだった。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車が、停電中のヴァンテミイユを見棄てた。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァンテミイユの旅券係のまえで、私は、あなたの直ぐうしろに立っていました。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の眼に、ヴァンテミイユ羅馬間の国際特急を移動管轄している、ムッソリニ直属の外事課高等刑事の乳房と、彼女の下腹部の黒子が、瞬間、浮かんだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
