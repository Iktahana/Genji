        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これがヴァレンティーヌ夫人、ド・ヴァレーズ伯爵、ド・サヴィニャク伯爵へと伝播する。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばド・ヴァレーズ伯爵がけしからぬ犯行の現場から下着のままで街頭に飛び出し、おりから通りかかったマラソン競走の中に紛れ込み、店先の値段札を胸におっつけて選手の番号に擬するような、卑猥であくどい茶番はヤンキー王国の顧客にはぜひとも必要なものであろう。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『社会』第二号の口絵にのせられた貝谷八百子のヴァレー姿の写真を人々はなんと見るでしょう。",
              "citation": {
                "source": "一九四六年の文壇",
                "author": "――新日本文学会における一般報告――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれから王子の方へ行くヴァレーは僕が好んでよく散歩したところだったが今は駄目だ。",
              "citation": {
                "source": "ふもれすく",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "カリーニンはオペレット、セマシコはオペラ、ルナチャルスキーはヴァレー」　○月曜日に退院してもよいことにきまった。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハルビンにいる金まわりのいい日本人――というより、ハルビンにいる日本人が、金まわりのいいときや内地から客が来たとき、出かけてゆくレストランやキャヴァレーは、大抵、白系露人が経営しているところだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿は例によって私一人で、主人夫婦に女中が二人、気のぬけたようなポルティエと、いつも空腹と見うけられるヴァレーが一人、こう静かでも少々心細い。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓からはルーゲンの森が、霧の間に見え隠れするだけで、終日山の影は見えない、表へ出ると、昨宵の二人が玄関に立ってるヴァレーをつかまえて、しきりに何か聞いているが、相手はオーベルランデル・ドゥイッチ一点張りで、何をしゃべったって、腹がへって口がきけませんて顔をしている。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はラ・ヴァレー山脈やペー・ド・ヴォー湖も見たことがある。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "テネシー・ヴァレーの事業として有名である。",
              "citation": {
                "source": "「良書普及運動」に寄せて",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "山こえて谷こえて　わたしたちはフランスの中央の一部、たとえばローヴェルニュ、ル・ヴレー、ル・リヴァレー、ル・ケルシー、ル・ルーエルグ、レ・セヴェンネ、ル・ラングドックというような土地土地をめぐって歩いた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ド・ボナルド氏やバンジー・プュイ・ヴァレー氏にまで匹敵するほどになっていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイ十八世が国外に亡命せんとする日、それを辻馬車の中に助け入れたので公爵となされたアヴァレー侯爵が、次のような話をした。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八九〇年七歳九月、妹ヴァリー（ヴァレーリエ）が生まれる。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハッピー・ヴァレー・アライアンス」（幸せの谷間同盟）という言葉を、赤とブルーを使ってきれいにデザイン化したＴシャツだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "古くから住みついている人たちは、この高原の谷間をハッピー・ヴァレーと呼んでいる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにちなみ、抵抗運動はハッピー・ヴァレー・アライアンスと呼ばれることになった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッピー・ヴァレーのもっとも標高の高いところにある、ジョー・カラマの家から取り壊しと整地を開始する。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッピー・ヴァレーの住民たちがここを追い出されてから収容される予定になっている、高層アパートメントの写真から起こした絵だった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッピー・ヴァレーの素晴らしい環境を強制的に捨てさせ、こんな高層ビルに追いこむなんて精神的な殺人行為だ、と彼女は演説した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッピー・ヴァレーでの今日の出来事を、神に報告するのだという。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッピー・ヴァレーからの音楽、と副題がつく」「なるほど」「ジェニファーといっしょに考えたんだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッピー・ヴァレーも町も、溶岩で埋まってしまう。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッピー・ヴァレーは、もはや保養地どころではなかった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッピー・ヴァレーは、溶岩と火山灰の山の下に埋まっていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンク・トムスンのブラゾス・ヴァレー・ボーイズに、当時をみることができる。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストロムニスキー打楽器合奏団　ヴァレーズの『十三打楽器のイオニゼーション（電離）』（コロムビア）という大変な曲が入っている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻のベッシーは子供らと一しよにヴァレー・オヴ・ザ・ムーン（月の谷）のグレン・エレンという避暑地に丸太小屋を借りて住んでいたので、ジャックはその妻子の住居と船の間を往来していたが、或る晩山越えの途中、馬車が谷間におちてジャックは脚にひどい怪我を負つた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒゲ剃り断行、ヴァレーでジョリ／″＼、鼻毛も切り、ヘチマコロンつけて、さっぱりした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
