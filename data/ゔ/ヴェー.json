        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "黒き浜辺にマルガレエテが歩み寄するヴェールを風に千々にされながら。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪は船と陸とをヴェールをもってさえぎった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが少しペルヴェースな性質の人になると、わざわざその痛みを増大させる事に愉快を感ずる。",
              "citation": {
                "source": "スパーク",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方になって池の面が薄い霧のヴェールに蔽われるころになると何かしらほのかな花の匂いが一面に立ちこめる。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャン・ヴェヴェーの「銭投げ」を見れば感情と姿勢の対訳を教えられる。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　夜のヴェールが剥がれて、灰色の壁にもたれて一夜を過した失業者が、赤と黒の市場の魚のように起きあがると、高楼にあらわれた三色旗の天気予報旗をものぐさそうに眺めた。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しい女は、すっと薄色の洋傘を閉めた……ヴェールを脱いだように濃い浅黄の影が消える、と露の垂りそうな清い目で、同伴の男に、ト瞳を注ぎながら舞台を見返す……その様子が、しばらく立停ろうと云うらしかった。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一方の窓の上の壁には、人民から強奪、強姦して国を売る張作霖の漫画と、共産党とソヴェートロシアを、「共産賊党」「赤色帝国主義」と称しているポスターが、電燈の陰影の背後に、ボンヤリと並んでいた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ソヴェート同盟の国境にむかっての陣地を拡げた。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　なお、新しい帝国主義戦争の危機――即ち、三ツの帝国主義ブルジョアジーが××の××的分割をやろうとしていることゝ共に、ソヴェート・ロシアに対する他のもろ／＼の帝国主義国家が衝突しようとする危機も迫りつゝあることに、注意を喚起しておきたい。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、それはまた、労働者農民の祖国サヴェート同盟に対する戦争の準備ともなっているのだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもおまえたちは名高いヴェーッサンタラ大王のはなしを知っているだろう。",
              "citation": {
                "source": "学者アラムハラドの見た着物",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェーッサンタラ大王は檀波羅蜜の行と云ってほしいと云われるものは何でもやった。",
              "citation": {
                "source": "学者アラムハラドの見た着物",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどももしヴェーッサンタラ大王のように大へんに徳のある人ならばそしてその人がひどく飢えているならば木の枝はやっぱりひとりでに垂れてくるにちがいない。",
              "citation": {
                "source": "学者アラムハラドの見た着物",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "インドのヴェーダ神話の神が仏教に取り入れられたもので、仏法を護る神。",
              "citation": {
                "source": "インドラ［※１］の網",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "神秘的に悧巧そうな影を、額から下にヴェールのように持っているこの若い娘が、そうやって笑うとき、口の中に未だ発育しない小さい歯が二三枚｜覗かれた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな天才生活時代の前生涯と、今のプライヴェート生活のような親密な性情と両面持っている……」　かの女とむす子がプライヴェートな会話に落ちこんでいると見たらしく、アルトゥールは非常に軽快なアクセントで、他の連中に講演口調で喋っていた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯という灯はどれも白蝋のヴェールをかけ、ネオンの色明りは遠い空でにじみ流れていた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときかの女は、どやどやとエレヴェーターの前から階段へ移り動いて行く一塊りの人数を見た。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭の勾配が尽きて一筋の長閑な橋になり、橋を跨いでいる巨人の姿に見えるエッフェル塔は河筋の水蒸気のヴェールを越しているので、いくらか霞んで見える。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "木崎にとっては、ダンスとはつねに淫らなリズムに乗って動く夜のポーズであり、女の生理の醜さが社交のヴェールをかぶって発揮される公然の享楽であった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "四階でエレヴェーターを降りると、エレヴェーターのすぐ前が改造の校正室だった。",
              "citation": {
                "source": "四月馬鹿",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろエレヴェーターがきゃつらの前だからね。",
              "citation": {
                "source": "四月馬鹿",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "途端に武田さんは私の手を引っ張って、エレヴェーターに乗った。",
              "citation": {
                "source": "四月馬鹿",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "白紙の原稿を見たＡさんがあっと驚いた時は、エレヴェーターは動いていた。",
              "citation": {
                "source": "四月馬鹿",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレヴェーターを降りると、武田さんはさア逃げようと尻をまくって、はしった。",
              "citation": {
                "source": "四月馬鹿",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本もフランスも共に病体であり、不安と混乱の渦中にあり、ことに若きジェネレーションはもはや伝統というヴェールに包まれた既成の観念に、疑義を抱いて、虚無に陥っている。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのような状態がフランスではエグジスタンシアリスムという一つの思想的必然をうみ、人間というものを包んでいた「伝統」的必然のヴェールをひきさくことによって、無に沈潜し、人間を醜怪と見、必然に代えるに偶然を以てし、ここに自由の極限を見るのである。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
