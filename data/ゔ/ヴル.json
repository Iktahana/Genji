        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「オールドゥーヴル」は「前菜」に殆ど駆逐されたかたちである。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はシャヴルで、セメン桝にセメントを量り込んだ。",
              "citation": {
                "source": "セメント樽の中の手紙",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるものはネエヴルの尻のようである。",
              "citation": {
                "source": "ある心の風景",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから氣むづかしげな樣子をした、栗毛のポインタアは、金色の脚のついた圓卓子の端にその背中をこすりつけながら、漆塗りの臺の上のセエヴル製の茶碗をがたがた顫はせてゐた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと気がつくと、あれほどガツ／＼食べ始めた葛岡が、いかに話に実を入らせるとて、オードウヴルとポタージュのスープを啜った後は急にテンポをとゞめて殆ど皿の肉類には手をつけず、付け合せのつまばかり緩慢に拾って食べているのに呆れました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "足もとから不意に鋭い声でプール・レ・ポーヴルと呼びかける。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地理学書でもまた物語でも読んで知っていたアトリオ・デル・カヴルロとかソマムとか、こういう名前も何となく嬉しく、また地質学者から教わる色々の岩石の名前も珍しかったと見えてよく覚えている。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣の大将が食卓でオール・ドゥーヴルを取ってから上目で給仕の女中の顔をじろりと見る、あの挙動もやはり「生きてはたらきかける」ものをもっている。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車でアーヴルに着いてすっかり港町の気分に包まれる、あの場面のいろいろな音色をもった汽笛の音、起重機の鎖の音などの配列が実によくできていて、ほんとうに波止場に寄せる潮のにおいをかぐような気持ちを起こさせる。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはブラッドフォードのメイソン、名うてのマラー、モンペリエのルフェーヴル、ニューオーリンズのサムスン。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "コリントンの（母方の）祖父の所へ行く時は、何時も其の辺の森や川や水車に合いそうな物語を拵えて、ウェイヴァリ・ノヴルス中の諸人物を縦横に活躍させたものだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコットの四十八巻のウェイヴァリ・ノヴルズと同じ様な赤色の装釘で、全二十巻、千部限定版とし、私の頭文字を透かし入りにした特別の用紙を使うのだそうだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギョオテ、シルレルの詩抄半ばじゆしてキョオニヒが通俗の文学史を繙き、あるはルウヴル、ドレスデンの画堂の写真絵、繰りひろげて、テエヌが美術論の訳書をあさりぬ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、地域はサヴルーズ谷を模し、本館はテレーズの生家トレヴィーユ荘の城館を写し、もって懐郷の念を絶たんがためなりとぞ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "法水は考証気味な視線を休めずに、「まるで騎士埴輪か鉄の処女としか思われんね、これがコペツキーの作品だと云うそうだが、さあプラーグと云うよりも、体躯の線は、バーデンバーデンのハンスヴルスト（独逸の操人形）に近いね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に、貴女はヴルフェンをお読みになったことがありますか」　その時、鎮子の眼に不思議な輝きが現われて、「さよう、五十歳変質説もこの際確かに一説でしょう。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本物は巴理のルーヴルにあるそうです。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "邪視英語でイヴル・アイ、伊語でマロキオ、梵語でクドルシュチス。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "この邪睨は邪視と同じくイヴル・アイを意味し、支那でイヴル・アイをいい表わした最も古い語例の一つだろう。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちここに兎と書くのは英語でヘヤー、独名ハーセ、ラテン名レプス、スペイン名リエプレ、仏名リエヴル等が出た、アラブ名アルネプ、トルコ名タウシャン、梵名｜舎々迦、独人モレンドルフ説に北京辺で山兎、野兎また野猫児と呼ぶとあった。",
              "citation": {
                "source": "十二支考",
                "author": "兎に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれ、ルウヴルの屋根の上、望の色の天のおく、ちろりちろりとひとつ星。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴル宮の屋根の上、なさけの星も傾いた。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴル美術館へ絵を研究にゆくにさえ、「いつも人に附添われて、馬車を待ち、家族その他を待たねばならない。",
              "citation": {
                "source": "マリア・バシュキルツェフの日記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリス・リイヴル――偶然にも前の被害者と同じ呼名である――という女中が、ボウンマスでチャアルス・オリヴァ・ジェイムスと呼ぶ男と知りあいになった。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャアルス・オリヴァ・ジェイムスなんて、山田太郎みたいに変名変名していて、あまり上手な変名とはいえないが、とにかくこの Mr. Charles Oliver James は、知り合いになった四日目に、電光石火的にアリス・リイヴルに結婚を申し込んだ。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリス・リイヴルは、女中ながらも真面目に働いて、七十ポンドの銀行預金と家具をすこしとピアノを一台持っていた。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディエップ行の列車も明日の朝の三時が最後だとか一歩遅れれば籠城の外はないと言われる中にあって、倫敦へと志した人々があるいはアーヴル経由か、あるいはブルタアニュのサン・モアかと、戦乱を避け惑うた光景がその報告で想像された。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウヴル宮殿の古い建物やチュレリイ公園の石垣が対岸に見える河の畔まで行くと、水の流れも何となく霞んで見え、岸に立つマロニエの並木も芽ぐんで来ていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
