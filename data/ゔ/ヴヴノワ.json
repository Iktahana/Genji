          "literary": [
            {
              "text": "明日、ヴヴノワさんのところへ一寸行くつもりです。",
              "citation": {
                "source": "日記・書簡",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月十七日（金曜）　夜ヴヴノワさんのところへゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんピアノを弾いて居た、玄関からヴヴノワ一人の姿が椅子にかけて居たのが見え、一寸構図的であった。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴヴノワさん、私のポートレートをかくという、彼女にとってもそれは制作である故なるたけ都合して坐るつもり。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○安田へゆき、ヴヴノワさんへ電話したら留守。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
