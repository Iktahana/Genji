        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一九〇八年十月十六日、巴里ヴァレンヌ街七十七番地ロダン樣　私は展覽會でグレコの「トレド」の前に一時間ばかり過して歸つて參りました。",
              "citation": {
                "source": "トレドの風景",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうせ、下手人はもみあげの長いヴァレンチノだろう。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがヴァレンティーヌ夫人、ド・ヴァレーズ伯爵、ド・サヴィニャク伯爵へと伝播する。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ヴァレンシュタイン終焉の地として有名。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしオフィリアの方は、単に狂人になってから、幼い頃乳母から聴いた――（あすはヴァレンタインさまの日）の猥歌を憶い出したにすぎない。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、ジミィ・ヴァレンタインは靴の革をせっせと縫っていたのだが、獄卒に連れられて、表の事務所へ行くことになった。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいたいジミィ・ヴァレンタインのように、外にお友だちがたくさんいる人間は、刑務所にぶちこまれたからといって、いちいち頭を刈ってたんじゃ、きりがないくらいだ。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑務所長が言うには、「あー、ヴァレンタイン。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァレンタイン、さっきの話をよーく、心にとめておいた方がいいぞ。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくしてヴァレンタイン九七六二号は、名簿にこう記された――〈知事により恩赦〉。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてジェームズ・ヴァレンタインさんはおてんと様のもとへ足を踏み出した。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァレンタイン九七六二番が釈放されてから一週間後のこと、見事な金庫破りがインディアナ州リッチモンドであった。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは、“ダンディ”・ジム・ヴァレンタインの手口です。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "みなさん、私はヴァレンタインくんを捕まえたいのです。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "高飛び、素早い逃走、共犯者なし、貴族趣味――こういったやり口が、ミスター・ヴァレンタインを罪からうまく逃れる男として、有名にさせたのだ。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある昼下がり、ジミィ・ヴァレンタインは愛用のスーツ・ケースと一緒に、エルモアという小さな町で郵便馬車を降りた。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジミィ・ヴァレンタインは女の瞳に吸い込まれ、手前の分際も忘れて、違う人間になっていた。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジミィ・ヴァレンタインは突然、恋の炎に二者択一を迫られ、身を焦がして灰になった。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとともに、ラルフ・Ｄ・スペンサーなる男は消え失せ、ジミィ・ヴァレンタインが姿を現した。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジミィ・ヴァレンタインは上着を羽織って、木の柵の外に出た。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬからず帆立が、「ピ、ピーイ、ピッ……」　とヴァレンシアのメロディーを口笛で吹き始める。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもわれわれはかなりうるさく、あれは美人だとか、拙い面だとか、可愛いとかヴァレンチーノだとか勝手な批評をするのが常である。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "今や人の顔はヴァレンチーノが流行だといえば皆ヴァレンチーノとしてしまうかもしれない。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "国際作家会議　　　　　　　　　　中国作家に課せられた重荷　第二回の文化擁護国際作家会議が去る七月四日からスペインで開かれたが、この会議がヴァレンシアからマドリッドに移り、更にヴァレンシアとバルセロナへ移動して、最後はパリに移ったことは様々の点から意味ふかい関心をよびおこす。",
              "citation": {
                "source": "文芸時評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからあのヴァレンタインも」と、スクルージは云った、「それからあの乱暴な弟のオルソンも。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "波は黒く岸にうちつけて、日はとっぷりと暮れかかる、みんなに別れて宿に帰ると、ヴァレンナの灯火がちらちら光って、湖水の波音は、高く室に響いて来た。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、テルラッツオに、箒みたいに、すくすくと蒼空にぬけ出ているチプレッソの木立の奥に、ブレリヤのマドンナの塔を眺めて、東岸のヴァレンナ Varenna に渡った。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "新量子力学や波動力学では、波動とか粒子とかいう範疇を極めて空想的に使用しているが、それにも拘らず夫が依然として科学的範疇の資格を失わないということは、夫々の理論が、理論的に同価値（エキヴァレント）であることによって、実在関係の唯一の反映であることを説明しているという点から、知ることが出来る。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
