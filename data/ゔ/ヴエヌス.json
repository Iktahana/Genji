        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その又小さい部屋の隅には黒いヴエヌスの像の下に山葡萄が一ふさ献じてあるのです。",
              "citation": {
                "source": "河童",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその目は涙ぐんだまま、ぢつと黒いヴエヌスを見つめてゐるのです。",
              "citation": {
                "source": "河童",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は皆ヴエヌスの神を讚嘆しはじめた。",
              "citation": {
                "source": "創始期の詩壇",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "このヴエヌス、實は「自由」の神の本體であるといふことに氣のつくものは、さしあたり無かつた。",
              "citation": {
                "source": "創始期の詩壇",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
