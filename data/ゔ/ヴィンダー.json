        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヴィンダーブラ、ミーダと連立って、上帝の宮殿の方から、ぶらぶら自分達の住居、第二級天の方にやって来る。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー（立ち止り、無作法に大伸びをし）ああ、偉い目に会った。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー（其方は見ず）上帝の奴、手に負えない狡猾者だ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　が、まあ此処まで来れば、其の心配もないと云うものだ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミーダ（ヴィンダーブラの傍に胡坐を組んで四辺を見廻す。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　俺達のように、意志の明白な者はいない証拠だ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてヴィンダー　ああ、つまらない。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　滅多なことには驚かない俺も、あの時許りは目を瞠った。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　――兎に角仕事があれば存在も認められる。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　あの時結局勝ったのが誰だか忘れるな、矢張レーだ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　俺の大｜三叉が、恐ろしい鉄の轟きで天を震わせなくなってから、よい程時が経ったわ！",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダーブラ、やがて、きっときき耳を立て、起き上る。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー（熱心に）違う！",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮の柱激しく揺れ、その間からヴィンダーブラ、ミーダの使者一、二、翼を持ち、黒鉄の鱗片で鎧った姿を現す。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ヴィンダー　ミーダ（一緒に）云え！",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　間違いじゃあ無かろうな。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　俺の大三叉も、そろりそろりと鳴り始めたぞ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ヴィンダーブラの袖を引張り）見てくれ、俺も老いまい？",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "粉のように飛んで、光のように、人間共にからみつく、あの――ヴィンダー　仕事は分担だ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　誰が知らせた？",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　出かけよう。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "凄じい風に押されて、彼方に一団此方に一団とかたまった電光を含む叢雲が、揺れ動き崩れかかる、その隙間にちらり、ちらりヴィンダーブラの大三叉を握った姿、ミーダの鞭を振る姿、カラがおどろにふり乱した髪を吹きなびかせて怒号する姿、黒い影絵のように見える。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　さあ、時は愈迫って来たぞ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　愈事は順調に運ぶ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　活溌な火気奴！",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　――ところで、妙な軍装の奴が現れたぞ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　さてもう一息だ。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　こせついていた都会も、これで少しはからりと焼原になったな。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　そろそろ俺達は引とるかな。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンダー　俺は、当分何も手につかない戦々兢々、なかなか効果は偉大な、絶望、その従弟のもっと可愛い自暴自棄を置土産にする。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
