        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今朝はイボギンヌにせがんで巴里の東隅に在るヴァンサンヌ広場の上空で行われるフランス空軍の大演習を見に行きました。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、刑場に出るものとは思われない華やかな態度で、ヴァンサンヌの城壁の前に立つ。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで墓番のヴァンサンは、銃を手にして、四囲に気をくばりながら戸外へ出た。",
              "citation": {
                "source": "墓",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓番のヴァンサンは、やにわにその浅ましい男に躍りかかると、たちまち組み伏せてしまい、両手を縛りあげて、その男を交番へ引ッ立てて行った。",
              "citation": {
                "source": "墓",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "名称――聖ヴァンサン病院。",
              "citation": {
                "source": "従軍五十日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は『あっけらかん』と呼ばれるヴァンサン爺の戸口の前を通る。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャートレの地牢を通って来た憐れな密猟者スユルヴァンサンは『私を支えてくれたものは韻律である』と告げている。",
              "citation": {
                "source": "リズムの構造",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼にあっては、ヴァンサン・ド・ポール風な不思議な愛情だった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "背徳漢サルダナパロスであろうと、聖者ヴァンサン・ド・ポールであろうと、常に同じ無に帰する。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァンサン・ド・ポールは自由と奉仕とのこもった次のみごとな言葉のうちに、慈恵院看護婦の姿を完全に定めた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖ヴァンサン・ド・ポール派のうちに身を投ずるや、彼女は特に選んでサンプリスの名前をつけた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャートレの地牢を通ってきたあわれな密猟者スュルヴァンサンはこういった、「私をささえてくれたものは韻律である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストア主義のすべての話の中には、シエナのカサリン（1347-1380）がハンセン病患者の膿を吸ったりヴァンサン・ド・ポールのような例は無い」と。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
