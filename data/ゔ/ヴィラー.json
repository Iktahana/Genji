        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それが、史家ヴィラーレの綴った、『ニコラ・エ・ジャンヌ』なんだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「え、ヴィラー君のことですよ」　思いつきといっても、これは極めて正当の陳述であった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幽霊の移転",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィラー君というのは一個の紳士で、彼もマデライン嬢に対して大いに注目しているらしいので、僕はそれを考えるたびに、彼に対して忍ぶあたわざる不快を感じていたのであった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幽霊の移転",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなた、ヴィラーさんのことをそんなふうに言っては悪うござんすわ」と、彼女は言った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幽霊の移転",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしヴィラー君が僕の現在の地位にあれば、すぐに自分の思うことを言い出すに相違あるまいと思った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幽霊の移転",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は自分の心のうちに絶えずヴィラー君のことを考えていないということを、ここで承認したくなかったからである。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幽霊の移転",
                "note": "青空文庫"
              }
            },
            {
              "text": "器量のよくない姉さんのマノンは、昨年の秋、富裕な銀行家デュヴィラール氏と結婚しました。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はシャンチィイのすばらしい薄紗のついたレモン色のセヴィラーナを着ている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
