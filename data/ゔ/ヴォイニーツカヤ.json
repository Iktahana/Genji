        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "暫くしてヴォイニーツカヤ夫人、本を手にして登場し、腰をおろして読む。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　おお！",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　アレクサンドルに言うのを忘れたよ……どうも覚えが悪くなってね……今日、ハリコフのパーヴェルさんから手紙が来たのさ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　面白いけれど、なんだか妙な気もしますよ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　でもわたしは、話がしたいんだよ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　お前は、どういうわけだか、わたしの話を聞くのがお厭と見えるね。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　（息子に）お前は自分の昔もっていた信念を、なんだか怨みに思っておいでのようだね。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　それは一体なんのこと？",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人とテレーギンが、テーブルのそばに残る。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人はパンフレットの余白に何やら書きこんでいる。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人登場。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の気がくるったのか、それとも……それとも……ヴォイニーツカヤ夫人　ジャン、アレクサンドルに逆らうんじゃありません。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　（きびしく）これ、ジャン！",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　（きびしく）だから、アレクサンドルの言うことを聴くんです！",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中央のドアから退場）ヴォイニーツカヤ夫人、それに続く。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "セレブリャコーフ、ワーニャ、本を手にしたヴォイニーツカヤ夫人、テレーギン、ソーニャ登場。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "セレブリャコーフ　（ヴォイニーツカヤ夫人の手に接吻する）では、お母さん……ヴォイニーツカヤ夫人　（接吻を返して）アレクサンドル、また写真をとって、送ってくださいよ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）ヴォイニーツカヤ夫人とソーニャ、その後にしたがう。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人　（そろそろと登場）行ってしまった！",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォイニーツカヤ夫人は、パンフレットの余白に何やら書きこんでいる。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
