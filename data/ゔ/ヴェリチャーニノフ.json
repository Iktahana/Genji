  {
    "uuid": "5b311eb6-e5d9-520d-81eb-a26b96ef7b05",
    "entry": "ヴェリチャーニノフ",
    "reading": {
      "primary": "ゔぇりちゃーにのふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
