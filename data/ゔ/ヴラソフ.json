          "literary": [
            {
              "text": "レコードはコロムビアにマイロウィッツがパリ交響楽団とヴラソフ合唱団を指揮したのがある（ＪＷ五六三―九）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリ・トマジがヴラソフ・ロシア合唱団とパリ交響楽団を指揮し、独唱の主役アリス・ラヴォ（アルト）は練達な歌い手だ（ＪＳ一三〇―七）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "作曲者がコンセール・ストララム管弦団とヴラソフ合唱団を指揮している（コロムビアＪ七九〇四―六）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
