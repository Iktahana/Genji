        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――「わたしの可愛いヴォロージャ（彼女がわたしを愛称で呼んだのは、これが初めてだった）、あなたのいい仲間ができたわ。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "この子もやっぱり、ヴォロージャっていうのよ。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったいどうしたの、ヴォロージャ？",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「申し訳ないわ、ヴォロージャ……」と、ジナイーダは言った。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            }
          ]
        }
