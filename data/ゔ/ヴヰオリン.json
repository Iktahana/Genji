          "literary": [
            {
              "text": "「ヴヰオリンをびい／＼やられるのは困るけれど、練習は成るべく私が外出したときにすれば可いぢやないの。",
              "citation": {
                "source": "彷徨へる",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「やつぱりヴヰオリンの方が好いんだらう。",
              "citation": {
                "source": "彷徨へる",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンスホールのバンドにゐるというヴヰオリンをひく男で、三十歳、荒みきつた感じだけれども、話してみると子供のやうな純粋なところがある。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
