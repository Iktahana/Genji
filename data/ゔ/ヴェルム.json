        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "有名なバシリカ合唱団もモーツァルトの『アヴェ・ヴェルム』とハイドンの『天地創造』の一節を入れている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルマ・ラーゲルレーヴさんは、一八五八年十一月二十日にスウェーデンのヴェルムランドという地方に生まれました。",
              "citation": {
                "source": "「ニールスのふしぎな旅　上」まえがき",
                "author": "矢崎源九郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルマ・ラーゲルレーヴさんは、一八五八年、スウェーデンのヴェルムランドという地方に生まれました。",
              "citation": {
                "source": "「ニールスのふしぎな旅　下」まえがき",
                "author": "矢崎源九郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなは南へ南へと飛びつづけ、イエムトランドをすぎ、ダラルナをへて、やがてヴェルムランドにはいりました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "このおばさんはヴェルムランドうまれの人でした。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、まず故郷のヴェルムランドのことから書いてみようと思いました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            }
          ]
        }
