        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それに対して周囲の先生たちの舎宅をヴヰラと呼んでいました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兼て知った近道を走って、息も切れ、身体もへと／＼になって、わたくしは安宅先生のヴヰラの玄関へ馳せつけました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "歳暮の風呂敷包は元通り踏石の上にありながら、ヴヰラの扉には学園の用箋へ先生の太い万年筆の文字で、先生は、今年は少し早くスキーに出かけます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしにはいくら安宅先生がヴヰラに帰って急にわたくしたちを呼び集めるにしろ、葛岡というものを今迄に来たこともないわたくしの家へ寄越すなんて、あんまり到り過ぎる。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "理想に対する欲望はあっても、今までに嘗てその実現を見なかった安宅先生は、葛岡に対して、夜店に出ていた少年の時代から、鉢を届けてヴヰラに来るような場合には必ず引留めて、そして自分の考えやら、考えの行われない悲憤やらを力を極めて注ぎ込んだ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年の十二月のクリスマスの前日、わたくしは安宅先生のヴヰラへ御歳暮を持って行き、先生の留守に出会い、遥かに雑木林の中に先生が射たれる猟銃の音を聞きました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どう、この私、真珠貝の中から生れたヴヰーナスの像に見えない※」　もう一声、「死の果から生れる、美の戯れ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "安宅先生のところへ御歳暮を届けに行き、ヴヰラにいない安宅先生を探しに先生の猟銃らしい音の聞える学園の川上の丘の櫟林に入りました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただいろんなことを記憶しておくと、何か書く場合に、それを取入れて、いくらかヴヰヴヰッドに描けるといふ程度である。",
              "citation": {
                "source": "佗しい放浪の旅",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヴヰオリンをびい／＼やられるのは困るけれど、練習は成るべく私が外出したときにすれば可いぢやないの。",
              "citation": {
                "source": "彷徨へる",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「やつぱりヴヰオリンの方が好いんだらう。",
              "citation": {
                "source": "彷徨へる",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇士等は皆サー、ランスロツトを推尊し（admired）、又王と其の美はしい妃のギネヴヰーアの寵遇も彼に頗る厚かつた（was in great favour with）。",
              "citation": {
                "source": "アーサー王物語",
                "author": "KING ARTHUR'S ROUND TABLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は比古君の好意で、琴人君に案内されて、カフヱーヴヰナスにとぐろを巻く、酔つぱらつて比古居には帰れなくなつたので、裏町の宿屋に泊つた。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "紐育に愛蘭生れの音楽家ヴヰクトル・ヘルバルトといふ男が居る。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかし英吉利にダヴヰツド・ヒユウムといふ懐疑派の哲学者があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　これはダヴヰツド・ベラスコの言葉である。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは何か彼の女は悲しい思ひに駆られて――たゞでさへ、故もなくたゞわけもなく、月見れば涙、花咲けば涙、お星様よ何故泣くの、すゝりなくヴヰオロンの音、あゝ悲しき星よ！",
              "citation": {
                "source": "美智子と日曜日の朝の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども、セルヴヰ、モンテネグロの政治家が、歐洲の權力平衡を知るが如く、彼等は列國の愼僞を知る。",
              "citation": {
                "source": "深憂大患",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウカサス人種あり、蒙古人種あり、マレー人種あり、ドラヴヰタス人種あり。",
              "citation": {
                "source": "世界の日本乎、亞細亞の日本乎",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しヴヰ※イの考へ方によつては母親にあゝまでみぢめな態度をしなくつても済むことだ。",
              "citation": {
                "source": "ウォーレン夫人とその娘",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯だ幾分気丈とでも云ふやうな点のある、ヴヰ※イよりも気持ちのいゝ女だ。",
              "citation": {
                "source": "ウォーレン夫人とその娘",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴヰ※イ　ねえお母さん正直に云ひますけれどそんな風にまでしてお金をこしらへるのをいやしむと云ふ見識もあなたの云ふ女の性根つ玉ぢやありませんか？",
              "citation": {
                "source": "ウォーレン夫人とその娘",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴヰ※イ　でもあなたは仕甲斐のある仕事だと思つてゐらつしやるのでせう。",
              "citation": {
                "source": "ウォーレン夫人とその娘",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論よくないことさヴヰ※イ、それにました職業が女にないといふのは。",
              "citation": {
                "source": "ウォーレン夫人とその娘",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴヰ※イ　（ます／＼深く感動して）お母さん、かりに私たちが昔のあなたのやうに貧乏であつたとしたら屹度あなたはすゝめないでせうか私にワーテルローの酒場へ出ろとか労働者へ嫁入りしろとか又は製造所へさへも入れとすゝめないでせうか。",
              "citation": {
                "source": "ウォーレン夫人とその娘",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正二年八月九月の二箇月間私は信州上高地の清水屋に滞在して、その秋神田ヴヰナス倶楽部で岸田｜劉生君や木村荘八君等と共に開いた生活社の展覧会の油絵を数十枚画いた。",
              "citation": {
                "source": "智恵子抄",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンスホールのバンドにゐるというヴヰオリンをひく男で、三十歳、荒みきつた感じだけれども、話してみると子供のやうな純粋なところがある。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
