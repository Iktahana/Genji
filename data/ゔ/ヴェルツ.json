          "literary": [
            {
              "text": "ヴェルツ美術館――ドュ・ヴォウティア街。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントニイ・ヴェルツ――一八〇六・一八六五――の個人美術館。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルツはよく狂人だったと誤りつたえられているが、それほどの血みどろさ、ゆがんだ見方、変態さだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "使命をもつ絵――ひっきょうヴェルツは十九世紀の漫画だった。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こういうとヴェルツは、その「自画像」に記して時人に示した著名な文句を、そのまま繰り返すに相違ない。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八三三年二十歳にしてヴェルツベルクの劇場の声楽教師となり、ケーニヒスベルクの指揮者となり、続いてリガの指揮者となり、六年間小都会の劇場に職を求めて、人生の辛労の種々相を嘗め尽した。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
