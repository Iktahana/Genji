        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "文章に就いて云っても、言葉のヴェイルがあり過ぎる。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、ヴェイルに似た靄が軽く全面に向って万遍なく展びて来た。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのシャンデリアの重く光る切子硝子の房の間へ、婚礼の白いヴェイルを裾長くひいた女の後姿が朦朧と消えこむのを、その天井の下の寝台で凝っと暗鬱な眼差しをこらして見つめている女がある。",
              "citation": {
                "source": "雨の昼",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭壇に近い柱のかげに坐り、包みから白い布を出してヴェイルとする。",
              "citation": {
                "source": "長崎の印象",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士は昨日よりよく見えたが、それでも顏だけはヴェイルを取らなかつた。",
              "citation": {
                "source": "湖水めぐり",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖の中程から美人はとうとうそのヴェイルをとつてしまつた。",
              "citation": {
                "source": "湖水めぐり",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻柱へ輪のついた棒みたいな物を立てて、黒いヴェイルを垂らしてるじゃないか。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい君、そばへ寄ってそのあらたかなヴェイルを引っ張ってみたりしちゃあいけないよ。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "その山肌一めんに日が赤あかとあたり出すのを眺めてゐると、山自身が見る間に淡い雲を湧き立たせ、ヴェイルのやうに漂はせ、だんだんそれが濃くなつていつて、しばらくする裡に自分自身を半分以上その雲のなかに隱してしまふ。",
              "citation": {
                "source": "初秋の淺間",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただそれを私の言葉に飜譯することを許して貰ふならば、それは「詩のヴェイルを通して人生を見る」ことから「人生のなかへ詩を象篏する」ことへの變化だつたといふことになります。",
              "citation": {
                "source": "室生さんへの手紙",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "見るとそれは陽炎のヴェイルを頭にかけた小さなものだつた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう二百年も以前のことですよ――それはもう、あのモオトン・ヴェイルのオリヴァさまの大きなお邸とは比べものにならない小さな田舍｜染みた所ですがね。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたはヴェイル莊には久しく顏を見せない方ね。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、ヴェイル莊の客間と平和の爲めに、傳道戰の曠野を捨てることも出來なかつたし、また、したくもなかつた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "また次の日に、ヴェイル莊で晩を過すようにと云ひ張つた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十になると彼と離婚し、アメリカの画家ヴェイルと結婚して、フランス、オースタリー、イギリスなどで暮す。",
              "citation": {
                "source": "「ザイルの三人」訳者あとがき",
                "author": "妹尾韶夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九三六年、アルプスのモンブランの麓、サヴォイのメジェーヴのシャレーを買って、六人の子供といっしょにそこで暮した（ボイルの四人の娘と、ヴェイルの前夫人との息子一人と娘一人）。",
              "citation": {
                "source": "「ザイルの三人」訳者あとがき",
                "author": "妹尾韶夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度貴婦人が厚いヴェイルで彼女の顔を隠す様に、彼は土蔵の厚い壁で、彼自身の姿を、世間の視線から隠してしまいたかったのである。",
              "citation": {
                "source": "蟲",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
