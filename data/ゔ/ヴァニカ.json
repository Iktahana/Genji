          "literary": [
            {
              "text": "その後ろには大きなフェルトの長靴をはいて、小さな甥のヴァニカが坐っている。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァニカは笑っている。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……また橇が行き、ヴァニカが笑い、お馬鹿さんのアクーリカが毛皮外套の前をあけて、足を突き出す。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            },
            {
              "text": "『みんな御覧よ、あたしの靴はヴァニカみたいなお古じゃないわよ』とでも言うように。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            }
          ]
        }
