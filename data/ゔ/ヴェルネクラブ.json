        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もうそこには、今は無いのだが、ヴェルネクラブが、あったからである。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五銀行の地下に、仏人ヴェルネさんの経営する、ヴェルネクラブがあった。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネクラブの、安くてうまい洋食は、先ずそのランチに始まった。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、僕は、その辺を通る度に、ちらっと、在りし日のヴェルネクラブの方を見るのである。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルネクラブのあった、十五銀行の方を又振り返り、そしてその向うの、海の方も気にしながら――　というのは、此処の海には、フランス船の御馳走の思い出があるからだ。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
