          "literary": [
            {
              "text": "どういうわけだかあなたはきっとヴェエルを被っていらっしゃるはずのように思っていたもんですから。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな風な訪問を致す時はヴェエルを被るものでございましたかねえ。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだかヴェエルで顔をすっかり包んだ女のような姿がちらと見えたらしかった。",
              "citation": {
                "source": "白",
                "author": "リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘一人、徐に歩み入る、派手なる模様あるあっさりとしたる上着を着、紐を十字に結びたる靴を穿き、帽子を着ず、頸の周囲にヴェエルを纏えり。",
              "citation": {
                "source": "痴人と死と",
                "author": "ホフマンスタアル　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏国ニヴェエル県シヤアロンに生る。",
              "citation": {
                "source": "「葡萄畑の葡萄作り」後記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニヴェエルのサン・ルイ寮に入寮、こゝより小学校に通ふ。",
              "citation": {
                "source": "「葡萄畑の葡萄作り」後記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス国ニヴェエル県シャアロンに生る。",
              "citation": {
                "source": "「ぶどう畑のぶどう作り」後記",
                "author": "岸田国士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニヴェエルのサン・ルイ寮に入寮、ここより小学校に通う。",
              "citation": {
                "source": "「ぶどう畑のぶどう作り」後記",
                "author": "岸田国士",
                "note": "青空文庫"
              }
            },
            {
              "text": "建築では三月堂や唐招提寺に確かにあの気分のヴェエルがかかっていると思うが、これは比較すべき唐の遺物がないのであるから断言はできない。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
