        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "リュックサックに一ぱい用意の品物をつめて、十時半にウ氏の先頭、ヴンテン、孝ちゃん、坊城、松方、僕の五人が出発した。",
              "citation": {
                "source": "山と雪の日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "スキーの足も自ら遅く、ヴンテンさんの影が五色の空の中へ遠くなるのもかまわず、うっとりと雪の平原を滑って行く。",
              "citation": {
                "source": "山と雪の日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴンテンさんは、もっと上手だと主張した。",
              "citation": {
                "source": "山と雪の日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヴンテンさん」と意外な答に孝ちゃんは、闇に不平をまぎらして上へ登り出した。",
              "citation": {
                "source": "山と雪の日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴンテンさんに追いつくことも、木にぶつかることもある。",
              "citation": {
                "source": "山と雪の日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウ氏とヴンテンさんが天気を見に行った。",
              "citation": {
                "source": "山と雪の日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
