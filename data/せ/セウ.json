        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すなわちeu→〔yo_〕または〔-yo_〕、例えば「用」ヨウ→ヨー、「笑」セウ→ショー、「妙」メウ→ミョー、「料」レウ→リョー。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "春宵一刻、――」などと、つまらぬ事を呟きながら木の虚から這ひ出ると、オヤ　ナンデセウ　サワグコヱミレバ　フシギダ　ユメデシヨカ　といふ事になるのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キイテ　タイソウ　ヨロコンデ「ヨシヨシ　ワタシモ　コノコブヲゼヒトモ　トツテ　モラヒマセウ」　と勇み立つ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こは今こそ陸つゞきになりたれ、古のキルケが島にして、オヂツセウスが舟の着きしはこゝなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ホメロスの詩に徴するに、トロヤの戰果てゝ後、希臘イタカ王オヂツセウスこの島に漂流せしに、妖婦キルケ舟中の一行を變じて豕となす、オヂツセウス神傳の藥草にて其妖術を破りぬといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "大酋長セウマヌが自分の称号の一つを私に贈って呉れた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "みなこれ『コロッセウム』、『ヰクトリア』などいふ舞踏場のあくを待てるなるべし。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ナント　イフ　カナシイ　オトデ　フイタ　コトデセウ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ　コノ　コノ　トコロニハ　ウグヒスハ　アソビニ　コナカツタデセウカ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、「オンモハ　ドンナ　トコロデセウ」ト　ドノ　ツボミモ　オモツテ　ヰルノデ　アリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナント　イフ　キレイナ　コヱデセウ」「アンナニ　ヨイ　コヱデ　ウタフ　コトノ　デキルノハ　タレデセウ」ト　ナタネノ　ツボミタチハ　ウツトリシテ　ササヤキアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ　オドロキガ　トマルト、「イマノ　フトイ　コヱハ　ダレデセウ」「キツト　オソロシイ　モノニ　チガヒナイネ」ト　ヒソヒソ　イヒアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン、コノ　セカイハ　ナント　イフ　ウツクシイ　ヨイ　トコロデセウ」ト　花ノ　ヒトツガ　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　アンナニ　マドガ　タカクテ、ドウシテ　ナカヲ　ノゾク　コトガ　デキマセウ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ　シタノデセウ」「マダ　ネンネシテルノカシラ」「ワタシタチガ　モウ　オメメヲ　ヒライタ　コトヲ　シラナイノカシラ」「モウ　ハルガ　キテルノヲ　シラナイノカシラ」　ソコデ　花タチハ　マダ　ヒラカナイ　ツボミヲ　オコシニ　カカリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボウヤノ　アタマノ　トコロニ　大キナ　モノガ　アルデセウ？",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キレイデセウ」「キレイダナア、キレイダナア、マンマルダナア。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　イママデ　ウツカリシテ　ヰタケレド、ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルデハ　ナイカ」　コノ　カナシミハ　ドウ　シタラ　ヨイデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　ナント　イフ　フシアハセナ　モノデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコガ　メヲ　サマシテ　ミルト、コレハ　マタ　ドウシタ　コトデセウ、メノ　マエノ　オ花バタケガ　ムチヤクチヤニ　フミニヂラレテ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシタチハ　コレカラ　ドウ　シタラ　ヨイデセウ」ト　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、オバサンノ　ソバニ　ヨツテ、「アカチヤン　ダイテテ　アゲマセウカ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サア　カンザシヲ　オカヘシシマス」　ヲンナノ　コハ　ドンナニ　ヨロコンダ　コトデセウ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレデ、イタチサヘ　ヨンデ　クレバ、ミンナ　オキヤクガ　ソロフ　ワケデスガ、サテ、イタチハ　ドウ　シマセウ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ　シテモ、ケイキキユウハ　ナント　イフ　リツパナ　マルイ　カゲヲ　モツテ　ヰル　コトデセウ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラセウムとは、岩狸が尿所へする尿の水分が、蒸発した残りのねばねばした粘液で、カークはこのヒラセウムのある樹洞のまえに、陥穽を仕掛けようとしたのであった。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
