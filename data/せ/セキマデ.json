        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それで、待ちあぐんで、兎も角建物の玄関迄出て見た。",
              "citation": {
                "source": "或る母の話",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助は玄関迄｜馳け出して行つて、手を執らぬ許りに旧友を座敷へ上げた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助も玄関迄送つて出たが、又引き返して客間の戸を開けて中へ這入つた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "八の六　平岡の帰りを玄関迄見送つた時、代助はしばらく、障子に身を寄せて、敷居の上に立つてゐた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助もつゞいて玄関迄｜出た。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "誠太郎はそれで納得して、玄関迄出て行つたが、沓脱へ下りながら振り返つて、突然「何処へ入らつしやるの」と代助を見上げた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助は急ぎ足で玄関迄｜出た。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人は肩を揃へて玄関迄｜出た。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰る時、三千代は玄関迄送つて来て、「淋しくつて不可ないから、又｜来て頂戴」と云つた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助は女の声を聞き付けた時、自分で玄関迄飛び出した。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "門から玄関迄は御影石で敷きつめてある。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ御上がりと云ふ所を、一寸御目にかゝりたいからと主人を玄関迄呼び出して、実は是々だが君どこか心当りはありませんかと尋ねて見た。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくすると、赤シヤツがランプを持つて玄関迄出て来て、まあ上がり給へ、外の人ぢやない吉川君だ、と云ふから、いえ、此所で沢山です。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "山嵐はさうですかと玄関迄出て行つたが、やがて帰つて来て、君、生徒が祝勝会の余興を見に行かないかつて誘ひに来たんだ。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関迄出て見たが矢っ張り居ない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一二時間の講義位聴き損なつても構はないと云ふ気で、真直に青山内科の玄関迄乗り付けた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "潜りから這入ると玄関迄の距離は存外短かい。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "美禰子は玄関迄送つて来た。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "門から玄関迄はからりとして何にもない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "門から、玄関迄は四間位ありました。",
              "citation": {
                "source": "ある抗議書",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子をあけ、唐紙の開く音がし、やがて半分も経つと、また、のぶ子が、玄関迄出て来た。",
              "citation": {
                "source": "黄昏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ニ私ニ非レバたれか上関迄出し候心積ニ候所、此頃御国より相廻り候船、下の関ニ参候時節、人なく幸ニ黒田了介殿御出ニ候得共、今少し御留りの儀故ニ無是非候。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年十二月十四日　岩下佐次右衛門、吉井友実あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "長尾半平氏死亡のくやみに玄関迄行き、神田教育会館のビクター実演大会の練習に行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗出の木目の立た高からぬ塀にかゝりて、盛はさぞと思はるゝ櫻の大木、枝ふりといゝ物好な一構、門の折戸片々いつも内より開かれて、づうと玄關迄御影の敷石、椽無の二枚障子いつも白う、苔井のきわの柿の木に唯一ツ、光程じゆくした實の重さうに見へる、右の方は萩垣にしきりて茶庭ら敷折々琴の昔のもるゝもゆかし。",
              "citation": {
                "source": "うづみ火",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と彼は玄關迄駈出して、泣聲を上げて怒鳴る。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
