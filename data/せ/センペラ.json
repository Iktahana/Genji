          "literary": [
            {
              "text": "「にがブナ」、九州地方では「シビンタ」、「猫マタギ」、中京では「センペラ」といって、相手にしない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣友がこれを見ていたが、「スカタラン、トロクセエ、オキャーセ、センペラなぞ釣って競技会だガナモ」　などといっていた。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりぼくが釣るので、しまいに大勢集まって感心して見ていたが、翌日、中日新聞の釣り座談会にセンペラ釣りを公開しろといわれた。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
