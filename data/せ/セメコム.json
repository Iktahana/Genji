        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敵兵は、城壁を乗り越えて、街に攻め込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "敵軍は夜中に突然村へ攻め込んできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "野球では相手の弱点を突いて攻め込む戦略が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "向こうところに敵なくして剣の力で信仰と権勢を植え付けて行った半生の歴史はそれほど私の頭に今残っていないが、全盛の頂上から一時に墜落してロシアに逃げ延び、再びわずかな烏合の衆を引き連れてノルウェーへ攻め込むあたりからがなんとなく心にしみている。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さア、南京まで攻め込むつもりかな。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの砂漠の地平に、東の海の真珠のような月が昇るまでに、合爾合姫が城を抜け出ぬ場合には、条件を受け入れぬものと見て、一刻の猶予もなく攻め込む手筈になっているのだ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうすれば、そとからせめこむことは、ぜったいにできませんから、いちおう安心ですが、そのかわり、四十面相と、あの美しい女の人と十人の部下は、洞窟の中にとじこめられて、いつまでもそとへ出ることができないのです。",
              "citation": {
                "source": "奇面城の秘密",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカグマ国に、こうした優秀な艦艇がありそしてわがキンギン国へ攻めこむほどの積極作戦があるとは、これまでに一度も報告に接していない。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、おれたちは日本の別働隊になって、敵の本陣へ攻めこむんだ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが別働隊は、闇にまぎれて、そこへ攻めこむんだ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "坦々たる大道を走るが如く、京城へ攻めこむことができた。",
              "citation": {
                "source": "鉄砲",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナはハワイ島に近いという地理的な条件のため、カメハメハ・ザ・グレイトがハワイ王国を統一するまでは、敵に攻めこむための前線基地であり、敵から攻めこまれて戦う戦場でもあったのだ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれも一緒になって火をつけながら、呶鳴りちらす」「火の手と共に、城外から太史慈様が攻めこむことになっている。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私の内藤は早くより、丹波国に住んでいて小さな領地を持っていたが、織田信長の手の明智光秀が丹波へ攻込む時打ち負けて、その後は宇野姓を名乗って、越中守宗音入道と称して潜んでいたらしい、その人の自ら署名した略系図は今も存在している。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
