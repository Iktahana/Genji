[
  {
    "uuid": "c2fa8949-e09d-5eeb-952f-117500e77971",
    "entry": "説法",
    "reading": {
      "primary": "せっぽう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
