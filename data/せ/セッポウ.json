        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「いつまで起きてるんだ！」と、父から小一時間ほどお説法を食らってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "嘘をついたことがバレて、先生の長いお説法が始まるのを覚悟して職員室に向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「またお説法ですか、勘弁してくださいよ」と、彼は耳を塞ぐような仕草を見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
