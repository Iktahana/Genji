      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "lecture",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "高名な僧侶による説法を聴くために、早朝からお寺の本堂には多くの参拝者が集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "おじいちゃんが話してくれる昔話は、いつも最後にはちょっとした説法のような教訓が含まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は説法の名手として知られ、難解な経典の内容を現代風のユーモアを交えて解説してくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "仏教では彼岸の中日｜時正の日で、一切の諸仏三世の諸尊および無数万億菩薩説法して衆生に楽しみを与うというので春分の時と同様｜阿弥陀詣などをする。",
              "citation": {
                "source": "歳時記新註",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "出家のいうことでも、教だの、戒だの、説法とばかりは限らぬ、若いの、聞かっしゃい、と言って語り出した。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "若不順我呪　悩乱説法者頭破作七分　如阿梨樹枝如殺父母罪　亦如厭油殃斗秤欺誑人　調達破僧罪犯此法師者　当獲如是殃　と一心不乱、さっと木の葉を捲いて風が南へ吹いたが、たちまち静り返った、夫婦が閨もひッそりした。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……また、こりゃお亡くなんなすった父様に代って、一説法せにゃならん。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その爾迦夷さまへのご説法ぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづれの説法の座でも、よくよく心をしづめ耳をすまして聴くことは大切なのぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "則ち説いて曰くと、これは疾翔大力さまが、爾迦夷上人のご懇請によって、直ちに説法をなされたと斯うぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このご説法のころは、われらの心も未だ仲々善心もあったぢゃ、小禽の家に至るとお説きなされば、はや聴法の者、みな慄然として座に耐へなかったぢゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ならば疾翔大力さま、まだまだ強く烈しくご説法であらうぞよ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その爾迦夷さまへのご説法じゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれの説法の座でも、よくよく心をしずめ耳をすまして聴くことは大切なのじゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "則ち説いて曰くと、これは疾翔大力さまが、爾迦夷上人のご懇請によって、直ちに説法をなされたと斯うじゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このご説法のころは、われらの心も未だ仲々善心もあったじゃ、小禽の家に至るとお説きなされば、はや聴法の者、みな慄然として座に耐えなかったじゃ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ならば疾翔大力さま、まだまだ強く烈しくご説法であろうぞよ。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の目から見るとただ自分の心の中へ中へと引っ込んで行く亮を、どうでも引き立てて外側へ向け直してやる事が自分の務めのように思っていたので、機会あるごとに口をすくして説法のような事を聞かせた。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それさえ像法時代といって、人々を眼で見ることから、崇高な感じを起させ、道に入れなければならない時代になって来ると立派な寺院を造り、立派な仏具を用いて説法の助けにしました。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "釈尊が菩提樹下で正覚後四十五年の説法、それに次いで代々の宗祖、高僧がたの利生方便はみなこれであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、今から二千五百年の昔、中印度、迦毘羅城に、釈迦族の王子として生れ、現実の悲哀を観じ、二十九歳にして出家せられ、六年苦行、三十五歳にして道を得られ、四十五年間説法の後、八十にして入滅せられた釈尊も、仏陀と称するのであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "経典を読みますと、釈尊が説法せられるのに「仏陀はかく言われる」「仏陀はかく説かれる」といった言葉ぶりが沢山出て来ます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは釈尊が、応身の仏陀の位置から、法身の仏陀の説法を取次がれるところから、こういう第二人称の敬語を用いられるので、自覚された仏陀が、いかに自身とは言え、その自覚を尊ばれ敬重の念を払われたところに何とも言えない奥床しさを感ずるのであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "釈尊自身は、そのことについてはあまり説法中に述べておられない。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（釈尊の説法が終ると教団の人々は立ちて三拝する。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝ヒームキャの向こう岸でご説法のをハムラの二人の商人が拝んで参ったと申します」　「そうか、それではまちがいあるまい。",
              "citation": {
                "source": "四又の百合",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "説法が旨いで、因果を含めるに可いわい。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あとで一説法｜刎ねかすが。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二の烏　道理かな、説法かな。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「魚説法、というのです――狂言があるんですね。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "必要なのは――魚説法――に続く三番目に、一、茸、（くさびら。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかな事はいえませんが、私の知っている限りでは、米斎君がはじめて舞台装置をなすったのは、明治三十七年の四月に歌舞伎座で、森鴎外博士の『日蓮上人辻説法』というものを上演しました。",
              "citation": {
                "source": "久保田米斎君の思い出",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時に、森鴎外博士作「日蓮聖人辻説法」を上演して、好評。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
