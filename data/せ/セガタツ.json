        "examples": {
          "standard": [
            {
              "text": "川の浅瀬に入ってみたら思ったより流れが強く、背が立つ場所まで後退した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子どもが「ここ背が立つ！」と声を上げたので、両親は一安心して見守ることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "プールの端まで泳いだ彼女は背が立つことを確認してから、ゆっくり立ち上がって息を整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ふと気がつくと、背が立つのです。",
              "citation": {
