        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この白ワインは、セミヨンのフルーティーな香りが特徴で、魚料理によく合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "唯二ヶ｜月に一｜度丈け、理髮師のセミヨン、ラザリチ計り此へ來る、其男は毎も醉つてニコ／＼しながら遣つて來て、ニキタに手傳はせて髮を刈る、彼が見えると患者等は囂々と云つて騷ぎ出す。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "「セミヨン・セミヨンニツチユさん。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは当市の判事セミヨン・イワーノヴィッチ・カチャリニコフが、ある集会の席で彼を批評したことばである、彼はフロックコートのボタンをきちんとかけて、黒の手袋をはめ、絹帽子を手に持って、申し分のない瀟洒な服装ではいって来た。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も彼もがげっそり憔悴してしまって、裁判所長も痩せ、医務監督も痩せ、検事も痩せ、またいつもただセミョン・イワーノヴィッチと呼ばれて決して姓を呼ばれたことのない、人差指に大きな指輪をはめて、それを婦人連に見せびらかしてばかりいる男までが、げっそりと痩せ細っていた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「八時十分です」　リザ・セミョンノヴナは裸足のまま寝台の前の小さい古い絨毯布の上に立っていた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女には、この金髪の、足の裏まで柔いみたいなリザ・セミョンノヴナが好もしかった。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リザ・セミョンノヴナはナースチャが来て半月後、アンナ・リヴォーヴナが出した貸間広告で来た銀行員である。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リザ・セミョンノヴナは、　　脚をぶらぶらふりながら、　　わたしは樽にかけている。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リザ・セミョンノヴナが赤い手提に身許証明書と八カペイキのパンとを入れて出て行く。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナースチャは寝室と、リザ・セミョンノヴナの室掃除をする。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナースチャはリザ・セミョンノヴナがそのうえで白粉もつけるし、手紙も書くたった一脚の、いつも一晩で散らかるテーブルの上を、彼女独特の原則にしたがって片づけた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リザ・セミョンノヴナは帰って来て――夕方か夜更けかに――興業銀行で百八ルーブリの月給をもらう代り、怠ることの出来ない英語勉強のために、音読用エルマー・ガントリーをとろうとすると、それがまた彼女の金髪らしい性質で、いつの間にか机一杯に白粉箱や古手紙が散らばってしまうのであった。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウカーズの上靴を寝台の下にしまって、ナースチャがリザ・セミョンノヴナの室に鍵をかけ終ると、アンナ・リヴォーヴナは廊下で黒麦わらの帽子をかぶっている。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リザ・セミョンノヴナも陽気でなくはなかった。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リザ・セミョンノヴナは時々は夜も、台所へ入って来ることがある。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ・リヴォーヴナとリザ・セミョンノヴナがとり交した契約書には、モスクワの借室がたいていそうであるように台所は利用せぬことになっているのであった。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミョンノヴナでも、しかし時には、夜、茶と一しょに熱いものが食べたかろうではないか。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムをあぶりながら、リザ・セミョンノヴナは綺麗な水色の瞳で、じろじろナースチャを眺めて、云うのであった。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナースチャ、なぜおかっぱにしないの」「わたし似合わないんです」　リザ・セミョンノヴナの小料理は手伝うこともないので、かえってナースチャは間がわるい表情だ。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいえ、伯母さんも似合わないというし、シューラも似合わないって云うもんだから」「ばかなナースチャ、おかっぱにしないのなんか禿げ頭の爺さんか豚だけよ――ごらん、わたしだってよく似合ってるじゃないの」　ナースチャは、感嘆して、紫苑色のリザ・セミョンノヴナのすらりとしたスウェーター姿を眺めた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あきあきしちゃう」「ホウ、ホウ、ホウ」　肩をすぼめ、唇を丸め、ホークで器用に小鍋をひっかけながら、「そら出来た」　リザ・セミョンノヴナはガスを消す。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その心持をあらわす暇のないうちに、「じゃおやすみ、ありがとうよ、ナースチャ」　リザ・セミョンノヴナは裾の端を台所の戸がしめこみそうにひらり、小鍋を持って自分の室に行ってしまうのであった。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下のあちらでリザ・セミョンノヴナの戸が閉った。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、リザ・セミョンノヴナのところへ茶を運んだ時、ナースチャは、「聞いて下さい。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リザ・セミョンノヴナ」　例の、もう散らかりかけている小机の隅へ膝をついた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　肌の綺麗な顔を少し反らせ、湿っぽくて臭そうなナースチャの綿繻子の前垂を眺めながら、リザ・セミョンノヴナはきいた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　リザ・セミョンノヴナは無頓着に云った。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は自分用の茶碗を持って台所へ行こうとして小熊の剥製や帽子掛のある廊下でリザ・セミョンノヴナに出喰わした。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こんにちは」「こんにちは」　行きすぎようとするリザ・セミョンノヴナを遮って、「一分間おじゃまさせていただきます。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞあなたの美しいお手を――わたしはオルロフ、経済をやっています」　リザ・セミョンノヴナは手の甲を接吻させ、自分の名は云わず室に入って勢よく戸を閉めた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
