        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕の如き鹽センベイにて晩酌する徒輩にとつて、室生君酒席の贅澤は羨望の至りである。",
              "citation": {
                "source": "歳末に近き或る冬の日の日記",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「朝　ヌク飯三ワン　佃煮　梅干　牛乳一合ココア入リ　菓子パン　塩センベイ……」こういう記事が毎日毎日繰り返される。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "足を「一寸」すべらすと、ゴンゴンゴンとうなりながら、地響をたてて転落してくる角材の下になって、南部センベイよりも薄くされた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "南部センベイは安いんだ！",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のは俺のセンベツだよ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "下宿の壁はセンベイのやうに青くてわたしの財布に三十銭はいつてゐる。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月五日　晩十一時半　今ズボンをたたんでいて、一寸考えた事であるが、日本を出る時にセンベツにもらった品物の中で、何が一番重宝で役に立っているかと云うと、おとよはんとこのお師匠はんに貰ったズボンツリだ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれが少々本物になりかかって、きのうは体じゅうこわれたセンベのようになって床について居りました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "百合ちゃん、これお上り、あれがいいじゃないか、そう云いながら女中には、ホンのおしるしばかりのセンベイをやって、これを女中が　恐れ入ります、いただきます。",
              "citation": {
                "source": "日記",
                "author": "一九三一年（昭和六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに菓子でも三盆や大白といったような、おそろしく人工化された砂糖を使ったものよりは、かの大島の黒砂糖を主にした大島羊羹・大島センベイといったふうのものが、よりいっそう悦ばれるような世の中となって来ておりますことは、私どもの注意すべき点ではなかろうかと存じます。",
              "citation": {
                "source": "自力更生より自然力更生へ",
                "author": "三澤勝衛",
                "note": "青空文庫"
              }
            },
            {
              "text": "これよりやゝ以前にハイセンベルヒ（獨人）が數學的難澁な經路を踏み、同樣なる結果に到達する方法を考へ出したけれども、難易の見地から、波動力學が專ら行はるゝやうになつた。",
              "citation": {
                "source": "物理學革新の一つの尖端",
                "author": "長岡半太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の主人が工面をしてくれたセンベイ布団にくるまる前に、入口に投げ込んであつた一通の手紙をひろいあげる。",
              "citation": {
                "source": "火の扉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「センベの方が、うめえな」「これ、桃よ。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オセンベだのシャガ芋の蒸したのなんか食べないわよ」「モンジャ焼知らねえだろ」「知らないわね」「うめえぞ。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼飯の代用に蒸したジャガイモと一人当り三枚ほどのセンベイのモテナシをうけただけであるから、一行は腹の皮が背中にひッつく状態で溜息をもらす力もなく帰京した。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "センベツ包んでくんないか」「よしやがれ。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらか包んでくれねえか、センベツよ。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房と二人、夜ナベにセンベイを焼き、アメをつくる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "元祖チョーセイアメ、ホラセンベイといえば近郷近在になりとどろき、遠い所から珍芸を見物がてら買いにくる人もある。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺小屋はアメとセンベイの製造工場に早変りして、ガキどもはせッせとセンベイをやいている。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄賃にアメとセンベイがもらえて、面白くもない字を習う必要もなく、皿まわしを習うことができるから、大そうな喜びようで、寺小屋の繁昌すること、みんな心をそろえて、「チョーセイ、チョーセイ、チョーセイ、チョーセイ」　と、咒文を唱えながら、一心不乱にセンベイをひっくりかえして焼いている。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫の手もかりたいような百姓の子供をセンベイ焼きにコキ使われてたまるものか。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前のような札ツキに寺小屋をまかせたのが、こっちの手落ちだが、今日かぎりセンベイ焼きにコキ使うのをやめるか、やめないか、ハッキリ返事をきかせてもらおう」「アッハッハ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "心得た」　翌日から子供たちに、日に五ツずつ字を教えて、センベイに書かせる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "できたセンベイを重箱につめて、辻に立って、「東西々々。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ元祖の梵字センベイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョーセイ元祖の梵字センベイ」　売れるわ、売れるわ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
