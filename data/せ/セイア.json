  {
    "uuid": "eb89cfd6-1d19-5961-9a6f-eecbd78f649f",
    "entry": "セイア",
    "reading": {
      "primary": "せいあ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
