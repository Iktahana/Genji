    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オデュッセイアと、ルクレティウスと、毛詩｜鄭箋と、それさえ消化しかねるほどの・文字通りの「スモオル・ラティン・アンド・レス・グリイク」と、それだけで生活は足りると思っていた俺は、何という人間知らずだったことであろう！",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェームズ・ジョイスの『ユリシーズ』物語つまりオデュッセイア物語の主人公は、ディーダラスで、之はオデュッセイア（ホメロスのものと云われるあのオデュッセイア）に於ける主人公テレマコスに該当すると、評論家は云っている。",
              "citation": {
                "source": "技術的精神とは何か",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて、ホロウェイ、セイア、コックス等のプライス批判が現れたが、なかんずく最も重要なのはエドモンド・バアクのそれである。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蚊は空をかける『イリアス』であり『オデュッセイア』であり、それ自身の怒りと放浪とを歌っているのであった。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "元祖チョーセイアメ、ホラセンベイといえば近郷近在になりとどろき、遠い所から珍芸を見物がてら買いにくる人もある。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとで、イーリアスやオデュッセイアやまたは千一夜物語などに読みふけって、ようやく安心するのだった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」(11)　何世紀にもわたってエジプトの医師たちは高名であり、オデュッセイアでトニスの妻ポリダムナはエジプトのヘレンに薬草を与えて言った。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを享楽のためにやっているのは、『オデュッセイア』のなかに奢侈の国として描かれているあの神話的なプァイエーケスの国である。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オデッセイア」第４巻　第１歌　320-25行（アレクサンダー・ポープの英訳による）　ヘロドトス（歴史の父：紀元前485年：Herodotus）はエジプトを最も健康な国であると宣言したが、「あるものは眼の病気だけを取り扱い、他は頭だけ、歯だけ、腹だけ、または内臓だけを、取り扱う」と言っている。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　ホメロスの『オデュッセイア』の中に出て来る魔女。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "[4] テレマック　ホメロスの〈オデッセイア〉の英雄オデッセウスの息子テレマックを主人公とした物語〈テレマックの冒険〉は一六九九年にフェヌロンによって書かれた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "[5] カリュプソ　ホメロスの〈オデッセイア〉に出てくる不死のニンフ。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
