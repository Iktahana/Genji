        "examples": {
          "standard": [
            {
              "text": "川沿いを散歩していると、岩の上で背黒鶺鴒が尾羽を上下に振っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "背黒鶺鴒は日本固有種で、黒と白のコントラストが美しい鳥だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "庭先に背黒鶺鴒が来るようになり、毎朝その鳴き声で目が覚めるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そこは水が見えるし、水際には背黒鶺鴒がゐて尾を振つてゐることだらう。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
