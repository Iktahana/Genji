          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ちょっとセブンに行って、明日のお昼ご飯を買ってくるよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "セブンのホットスナックの中では、レジ横の唐揚げが一番のお気に入りだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "喉が渇いたので、近くのセブンに寄ってアイスコーヒーを頼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "（時計を出して見ようとして、なくなっているのを発見）時計もセブンか。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セブンどころじゃないイレブンくらいだろう。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セブンなんだけれど、ということである。",
              "citation": {
                "source": "まちがい",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ラッキーセブンだ」「ぼくにラッキーはない、だめだ」「ばかいえ、きみはたしかに勝てるのに勝たずにいるんだ」「どうして？",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "調べが付いてみると、アメリカ現代史のキーワードであることがわかって恥ずかしい思いをしましたが、何の説明もなく監督のコメントの中に出てくる〈シカゴセヴン〉が理解できませんでした。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ナンバ・セヴンのお椀まだですか。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "１２３４５６７８９　これだけの文字を横の方から持って行って白墨で書いて、ワンツースリーフォーアファイヴシキスセヴンエイトナイン　それを擂粉木のような棒で、いちいちコツコツと叩きながら一通り読み立て、「サア、茂ツァン、読ンデミナサイ」と言って１を指すと、茂太郎は勢いよく、「棒！",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サア、皆サン、イッショニ読ミマショウ」　かくて、マドロスの音頭で、お松も、乳母も、茂太郎も、金椎だけは別、ワン、ツー、スリー、フォーア、ファイヴ、シキス、セヴン、エイト、ナイン――　幾度も繰返して、「コレガ日本ノ数字、一、二、三、四、五、六、七、八、九デス、ヨク覚エナサイ」「先生！",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツー、スリー、フォーア、ファイヴ、シキス、セヴン、エイト、ナイン……」　ここでとぎれて、暫くして、「みんなで九つであります、九頭の鯨が押寄せたのであります、素敵！",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんはゴールドとグリーンが好きだから」「僕はこれを買います」「ハウ・オールド・ア・ユー・ナウ、ヨシオ」「セヴンティーン」　というヨシオの答えに、ジョイスリンはうなずいた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「連れて来れば、ほんとに似合うかどうか、よくわかるから」「美人です」「ジ・イアリングス・クッド・ルック・アウト・オヴ・プレイス・オン・ア・ガール・オヴ・セヴンティーン。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その買物はセヴンダイアルのある店で行われたが、そこには、かたつむりからアンゴーラ猫にいたるまでの、あらゆる動物がならべてあった。",
              "citation": {
                "source": "予謀殺人",
                "author": "A CASE OF PREMEDITATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "邸を借り、その門のとこと、庭で、ラッキー・セヴンといふ漫才が喋ってるところへ僕がワリ込むカット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
