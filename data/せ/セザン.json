        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然るにこの一方には、ミケランゼロや、チチアンや、応挙や、北斎や、ロダンや、セザンヌやの如く、純粋に観照的な態度によって、確実に事物の真相を掴もうとするところの、美術家の中の美術主義者が居る。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "特にこの派の巨匠の中、セザンヌは観照に於て最もよく徹底している。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザンヌは一の哲学（形而上学）である。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美術にあっては、一方にミレーやゴーガン等の、抒情派があり、一方にピカソやセザンヌ等の、歪んだ科学的の叙事詩派がある。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザンヌが謂ふ「空と樹木」が、申すまでもなく都より豊富だからです。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "十字軍や一九一四年の欧洲大戦のごときは世界人類の歴史の橋の袂であり、ポール・セザンヌと名づけられた一人の田舎爺は世界の美術史の上の橋の袂である。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルーベンスやゲーンスボローやないしはアルマタデマに無くしてセザンヌ、ゴーホあるいはセガンチニなどに存するところのものである。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田君の日本画とセザンヌやゴーホの作品との間の交渉は種々の点で認められる。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは津田君の画にしばしば出現する不恰好な雀や粟の穂はセザンヌの林檎や壷のような一種の象徴的の気分を喚起するものである。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある批評家はセザンヌの作品とドストエフスキーの文学との肖似を論じている。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう立場から見た時にセザンヌやゴーホの価値が私には始めて明らかになると同時に、支那や日本の古来の名画までも今までとちがった光の下に新しく生きて来るような気がする。",
              "citation": {
                "source": "帝展を見ざるの記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃の新しい畫學生の間に重寶がられるセザンヌ式の切通し道の赤土の崖もあれば、そのさきには又舊派向きの牛飼小屋もあつた。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "光琳の躑躅などは、セザンヌ、モネー、ゴーギャン、誰の画よりも、すぐれていると思われました。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分たちの少年の頃には、日本ではフランスの所謂印象派の画が大流行していて、洋画鑑賞の第一歩を、たいていこのあたりからはじめたもので、ゴッホ、ゴーギャン、セザンヌ、ルナアルなどというひとの絵は、田舎の中学生でも、たいていその写真版を見て知っていたのでした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザンヌはそれをよく知つてゐました。",
              "citation": {
                "source": "或女友達への手紙",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は書画に携る輩に向ってはデッサンを説き、ゴッホとかセザンヌとかの名を口にした。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザンヌが「わかりますか、ヴォラール君。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザンヌはやはりこの手品の種を捜した人らしい。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしてもセザンヌが同じ「静物」に百回も対したという心持ちがどうも自分にはわかりかねていたが、どうしてもできあがらぬ自分の自画像をかいているうちにふとこんな事を考えた。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "思うにセザンヌには一つ一つの「りんごの顔」がはっきり見えたに相違ない。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろの新しい画学生の間に重宝がられるセザンヌ式の切り通し道の赤土の崖もあれば、そのさきにはまた旧派向きの牛飼い小屋もあった。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそうでなかったら曇り日に見たセザンヌと晴天に見たセザンヌは別物に見えなければならないわけである。",
              "citation": {
                "source": "蓄音機",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かな田舎で地味な教師をして、トルストイやドストエフスキーやロマン・ローランを読んだりセザンヌや親鸞の研究をしたり、生徒に化学などを授けると同時に図画を教えたり、時には知人の肖像をかいてやったりするような生活は、おそらく亮が昔から望んでいた理想によほど近いものではなかったかと思う。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザンヌの好きであった彼のそのころの日記にこんな事がある。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「セザンヌの絵のような境地に至りたいと思いながら、今までその内容すなわちそれまでに至る努力を考えなかった。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてシンプルな、落ち着いた、セザンヌの絵のような境地に達しよう。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「猿蓑」や「炭俵」がナンセンスであり、セザンヌやルノアルの絵がナンセンスであり、ドビュシーやラベールの音楽がナンセンスであると同じような意味において立派なナンセンス芸術であるように思われる。",
              "citation": {
                "source": "映画雑感（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザンヌがりんごを描くのに決して一つ一つのりんごの偶然の表象を描こうとはしなかった、あらゆるりんごを包蔵する永遠不滅のりんごの顔をカンバスにとどめようとして努力したという話がある。",
              "citation": {
                "source": "ジャーナリズム雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞記者が新聞紙上に日々の出来事を記載するにこの意図があるかどうかは明らかでないが、もしそういう意図があってそうしてそれを実行し成就しようとするならば新聞記者というものは、セザンヌやまたすべての科学者を優に凌駕すべき鋭利の観察と分析の能力を具備していなければならないことと思われるのである。",
              "citation": {
                "source": "ジャーナリズム雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
