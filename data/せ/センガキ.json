        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "支那や朝鮮では、目下製造されつつあるようだが、それは主として支那絵や日本画の方法と同じく墨をもって線描きが施され、泥絵具が膠で溶解されて塗られているものである。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "膠　それ等の絵具は日本絵を描く時と、同じ方法で膠を以て絵具をとき、墨を以て線描きを施した上を塗って行くのです。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "線描きなしに、うちつけに繪具を塗り進めた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "線描きなしに、うちつけに彩色を塗り進めた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "線描きなしに、うちつけに絵具を塗り進めた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰いで見ると、墨絵の線描きのような恰好である。",
              "citation": {
                "source": "楡の花",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから前述の赤絵や線描きの手法でも、充分将来を期待することが出来るのです。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　と、ジッと見つめていると、単調な線描きの女の顔が、自分に微笑を向けてくるように感じられだした。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
