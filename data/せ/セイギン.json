          "literary": [
            {
              "text": "これは幕府時代からの正銀の使用に慣らされて来たためでもある。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜開港当時の経験が教えるように、この際、利に走る商人なぞが旧正銀｜買〆のことも懸念されないではなかった。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "十万｜磅を時の相場にすればメキシコ弗で四十万になるその正銀を、英公使セント・ジョン・ニールに渡して先ず一段落を終りました。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
