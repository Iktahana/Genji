          "literary": [
            {
              "text": "小説においては、済勝の足ならしに短篇数十を作り試みたが、長篇の山口にたどりついて挫折した。",
              "citation": {
                "source": "なかじきり",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "迥にわたくしに優った済勝の具を有していた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントニオ、アントニオと呼ぶ公子の聲｜歩に蹇める處を、渠は能く飛行すと誇るなるべし、いざ我が濟勝の具の渠に劣らぬを證せんとて、我傍に引き傍うて走り出しぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
