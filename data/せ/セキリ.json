[
  {
    "uuid": "de4b4ebb-ac83-50f1-8f9d-611b380fb3ea",
    "entry": "赤痢",
    "reading": {
      "primary": "せきり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
