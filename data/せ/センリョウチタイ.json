        "examples": {
          "standard": [
            {
              "text": "占領地帯は国連の監視下に置かれ、今後の地位について交渉が続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その占領地帯には、紛争の爪痕が随所に見られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "占領地帯の非武装化に向けて、国際社会が協力することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "７　ベルギーにおけるドイツの占領地帯にはいり込んでいたフランス密偵部員の一人に、イグナチオ・ヴィテリオというイタリー人があった。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "占領地帯は満目荒凉、徴発すべき人夫もなければ物資もない。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしたちは、絶えず統領から助言をうけ、命令を受取っている」「すると、その統領なる人物は、ドイツ本国にいるのですね」「いいえ、ドイツの占領地帯である某高山地方におられる。",
              "citation": {
                "source": "宇宙尖兵",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の軍部のように、八紘一宇と国民儀礼のような神話時代の文化しか持ち合せがなく、自分の貧乏やマイナスを占領地帯へ分ち与えるようなヤリ方では、占領された人たちが大迷惑であるが、ソビエトの場合が、又、そうである。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
