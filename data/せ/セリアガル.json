  {
    "uuid": "f47b7823-032c-52b8-bb07-9cde4d819bcb",
    "entry": "迫り上がる",
    "reading": {
      "primary": "せりあがる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null,
      "ctype_source": "existing",
