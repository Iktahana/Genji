    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こうなると摂心と云うものは戦場と等しい、一所懸命となって来る、学校の試験などと違って真剣勝負である。",
              "citation": {
                "source": "鹿山庵居",
                "author": "鈴木大拙",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し実際を云うと、一旦の見処を得てから後は、摂心でない方がよいかとも思う。",
              "citation": {
                "source": "鹿山庵居",
                "author": "鈴木大拙",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、初心の人にとりては、この摂心を何遍もやるに越したことはあるまい。",
              "citation": {
                "source": "鹿山庵居",
                "author": "鈴木大拙",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
