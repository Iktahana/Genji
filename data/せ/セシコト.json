        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本ハ建國精神ヨリ、又現代國民思想ノ凡テニ於テ、日本帝國ヲ契約ニヨリテ組織シタル者ト一考セシコトモナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵、喜色｜面ニ顕シ、願望達セシコトヲ謝ス」　とある。",
              "citation": {
                "source": "巌流島",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾来歳月ヲ経過セシコト茲ニ四十年。",
              "citation": {
                "source": "西周伝",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ヤ菲才浅学ニシテ府県ニ文部省ニ奉職シ育英ノ任ニ叨リ、尺寸ノ功ナク、常ニソノ職ヲ曠シクセシコトヲ羞ル耳。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "名ヲ聞キシ初メハ、聖人ノ妙釈ヲ礼サントヨロコビ、巻ヲ披クノ今ハ恨ム、念仏ゾ真宗ヲ黷セシコトヲ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
