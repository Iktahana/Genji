  {
    "uuid": "be91269e-e4c7-5698-8763-cd22f3d8e33e",
    "entry": "政風",
    "reading": {
      "primary": "せいふう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
