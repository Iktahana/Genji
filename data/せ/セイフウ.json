[
  {
    "uuid": "141448f7-55e4-572b-8d89-7e37e062e2a4",
    "entry": "清風",
    "reading": {
      "primary": "せいふう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
