[
  {
    "uuid": "6549d854-25bd-5c61-af35-5cf907bb345a",
    "entry": "逝去",
    "reading": {
      "primary": "せいきょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
