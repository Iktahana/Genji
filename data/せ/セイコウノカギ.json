        "examples": {
          "standard": [
            {
              "text": "チーム全員が目標を共有し、密にコミュニケーションを取ることがプロジェクト成功の鍵を握る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "徹底的なリサーチと準備こそが、海外市場進出における成功の鍵だと言えるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "プロジェクトマネージャーは「チーム全員が同じ目標を共有することが成功の鍵だ」と会議で強調した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そして、驚くべきことには、その上なほ「成功の鍵」を、あまりにも、「流行」脚本の中に求めすぎてゐたからである。",
              "citation": {
                "source": "俳優養成と人材発見",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり彼は、そうしたロパーヒンこそこの「喜劇」の成功の鍵だと信じたのだ。",
              "citation": {
                "source": "チェーホフ試論",
                "author": "――チェーホフ序説の一部として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり彼は、そうしたロパーヒンこそこの「喜劇」の成功の鍵であると信じ、このデリケート極まる人物をスタニスラーフスキイにこなして貰おうと望んだのだ。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "実力のある者には誰にでも成功の鍵を与えて、天下に覇を成さしめる。",
              "citation": {
                "source": "青年の天下",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
