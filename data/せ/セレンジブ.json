        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから、私に、王さまはセレンジブさまというお名前で、世界じゅうで一番えらくて、一番の金持だと、話して聞かせました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "セレンジブ王の御殿は、大へんりっぱなものでした。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてすぐに、カリフさまの御殿へ行って、手紙と、セレンジブ王からいただいたみやげ物とを、さし上げました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、「さあ、シンドバットや、セレンジブ王が、どんなにお金持で、どんなにりっぱであるか、話してごらん。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "セレンジブ王は、いつも大きな象に乗っておいでになりますが、おそばには、金色の着物を着た千人の騎兵が、つかえているのでございます。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは、セレンジブ王に、手紙と、おくり物とを、さし上げたいと思うのだが、お前、持って行ってくれまいか。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、おだやかな航海をつづけた後、セレンジブの島へつきました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
