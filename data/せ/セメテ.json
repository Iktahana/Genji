[
  {
    "uuid": "a4cfe52d-ef78-5aee-b6d1-42fcf2ffc87f",
    "entry": "せめて",
    "reading": {
      "primary": "せめて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "at least",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "せめて一言だけでも、出発前に挨拶がしたかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "遠くへ行けないのなら、せめて近所の公園でピクニックを楽しもう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "全部は無理でも、せめてこの資料の半分だけでも今日中に目を通してほしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その後、せめて木村夫婦の所を訪ねようといふ気もあるのだが、まだ訪ねない。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いゝえ、私がせめてもの気晴らしに、嫌な湯槽の中をさへ慕つて来たから思ふことなのであらう。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて、窓ぐらいにしてもらいたい。",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆっくりかまえて、一日一日を、せめて悔いなく送りたまえ。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて、妹さえ丈夫でございましたならば、私も、少し気楽だったのですけれども、妹は、私に似ないで、たいへん美しく、髪も長く、とてもよくできる、可愛い子でございましたが、からだが弱く、その城下まちへ赴任して、二年目の春、私二十、妹十八で、妹は、死にました。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たち、さびしく無力なのだから、他になんにもできないのだから、せめて言葉だけでも、誠実こめてお贈りするのが、まことの、謙譲の美しい生きかたである、と僕はいまでは信じています。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――私は父が私のことで悄気たりしてゐる時はせめてもの務めででもあるかのやうにさう言つた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の江戸時代には帰らないでも、せめて巴里かロンドン位の程度にまで、余裕のある閑散の生活環境を作りたい。",
              "citation": {
                "source": "喫茶店にて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御殿場にて乗客更に増したる窮屈さ、こうなれば日の照らぬがせめてもの仕合せなり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて状袋にでも入れて「正岡子規自筆根岸地図」とでも誌しておかないと自分が死んだあとでは、紙屑になってしまうだろうと思う。",
              "citation": {
                "source": "子規自筆の根岸地図",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私には、實の生みの母もあるのだが、いろいろの事情から、いまは音信不通になつてゐて、親孝行したくても、なかなか、それの許されない立場に在るのであるから、せめて、この家内の母にだけでも子としての務めを、ほんのわづかでも、無力の私にできる小さい範圍内でも、何かしたいと念じてゐるのだ。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて、桃太郎の物語一つだけは、このままの單純な形で殘して置きたい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお鈴さんは口調を改めて言ひ、「せめて、雀の里のお土産のおしるしに、この葛籠のうちどれでもお氣に召したものをお邪魔でございませうが、お持ち歸り下さいまし。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまさらどうしやうもないことではあるが、せめてこれだけ知るがいい――ごく自然に、だが自然に愛せるといふことは、　　そんなにたびたびあることでなく、そしてこのことを知ることが、さう誰にでも許されてはゐないのだ。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "IIIIせめて死の時には、あの女が私の上に胸を披いてくれるでせうか。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "頑なの心は、不幸でいらいらして、　　せめてめまぐるしいものや　　数々のものに心を紛らす。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめてその時、私も、すべてを感ずる者であらんことを！",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "又兎も角も折角其家を目指して遙々遠方から尋ねて來た客を、どうしても收容し切れない場合なら、せめて電話で温泉旅館組合の中の心當りを聞いてやる位の便宜をはかつてやつてはどうか。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて郊外へでも行けばさういふ點でいくらか工合のいゝ場所があるだらうと思つたが、併し一方で又餘り長く電車に乘り、又重いものをさげて長途を歩るくのは今の病氣に障るといふ掛念があつた。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近年急に襲うて來た「改造」の嵐の爲に、我邦の人の心に自然なあらゆるものが根こぎにされて、其の代りにペンキ塗りの思想や蝋細工のイズムが、新開地の雜貨店や小料理屋のやうに雜然と無恰好に打建てられて居る最中に、それ程とも思はれぬ天然の風景が方々で保存せられる事になるのは、せめてもの事である。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて代わりの人のあるまで辛抱してくれと、よしやまだ一介の書生にしろ、とにかく一家の主人が泣かぬばかりに頼んだので、その日はどうやら思い止まったらしかったが、翌日は国元の親が大病とかいうわけでとうとう帰ってしまう。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩秋の夕の露気に亀縮んだ山の祖神の老翁は、せめてこのかがり火に近寄ってあたりたかったが、それは許されないことである。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて娘の姿の望まれるところでしばらく心を宥めよう。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "東国へ思い捨てたこどもに邂逅う望みを、姉の福慈岳の女神に失望した山の祖神は、せめて弟に望みを果し度いものだと、なおも東の方を志して尋ね歩るき出した。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "取り付きようもない娘の心にせめて親子の肉情を繋ぎ置き度い非情手段から、翁は呪いという逆手で娘の感情に自分を烙印したのだったが、必要以上に娘を傷けねばよいが。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて悩んでいてやることが娘に対する理解の端くれになりそうに思えた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さほど醜くもなく、これだけ物事ができる自分が、せめて、どうして男の縁が薄いのだろうか。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで退屈な時は、せめて街の自動車を眺める。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、こういう身の中の持ちものを、せめて文章ででも仕末しないうちは死に切れないと思った。",
              "citation": {
                "source": "桃のある風景",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしても古代に溯りたいなら、せめてサイラスやアルタセルキセスなどは節約して、文化に貢献したアルキメーデス、プトレモイス、ヘロン、アポロニウスの事でも少し話してもらいたい。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
