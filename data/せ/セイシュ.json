  {
    "uuid": "27515e52-4e0e-57a4-9951-d867637b14ec",
    "entry": "星主",
    "reading": {
      "primary": "せいしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
