    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「聖者星の星主、城中にござる！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が、「日本」という宇宙に於ける地理的歴史的社会的な具体的一存在を勝手に持って来て、之が何か哲学の原理になれると考えることが、元来少し常識で考えて見ても変なことで、もしこれが「金星主義」や「水仙主義」とでも云ったような哲学（？",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "まぎれなくそれは人の気配にちがいなく、「星主さま。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "星主さま……」　と、二人の青衣の童子が左右から自分を呼んでいるのであった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "宋星主さまを、お迎えにあがりました」「星主？",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱の柱に彫られてある龍鳳もともに嘯くかとあやしまれ、やがて珠の簾のうちに、薫々たる神気がうごいて、「星主、お久しぶりでした。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「星主には、おつつが無うて」　と、女神のきみは、あくまで、宋江を初めてみる者とはしていず、お久しぶりゆえ、と祝いで、すぐ侍女に酒を命じた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
