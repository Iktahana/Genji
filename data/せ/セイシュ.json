[
  {
    "uuid": "76fc8e14-85a1-51f0-9e06-0a8449eb8ea9",
    "entry": "清酒",
    "reading": {
      "primary": "せいしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
