    "definitions": [
      {
        "index": 1,
        "gloss": "seoi nage (judo)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "柔道の試合で、見事な背負い投げが決まって一本勝ちとなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は得意技の背負い投げで、次々と相手を投げ飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "背負い投げは、相手の力を利用する柔道の基本的な技だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いい加減なものであるから、それを取り上げるのはどうかと思うけれども、志賀という個人に対してでなく、そういう言葉に対して、少し言い返したいのである）作品の最後の一行に於て読者に背負い投げを食わせるのは、あまりいい味のものでもなかろう。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思い入って急所を突くつもりらしく質問をしかけている父は、しばしば背負い投げを食わされた形で、それでも念を押すように、「はあそうですか。",
              "citation": {
                "source": "親子",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつての新聞班パンフレットによる農山漁村の対策に期待した日本の無産者の一部分は、その後の国防絶対至上主義化によって見ごとに背負い投げを食わされたが、政治家風の空頼みが今回国民に多少の期待を吹き込んだということも、話は小さくて稀薄だが、別に之と異った現象ではないかも知れぬ。",
              "citation": {
                "source": "近衛内閣の常識性",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "（決然と）腹の底から引っくり返るようにやつらに、背負い投げを食わしてやるのだ――。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男には、何度も背負い投げを食わしたけれど、私はこんなアナキストは嫌いなのだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉本は背負い投げを喰わされたようにどきまぎした。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互いに背負い投げをいくども喰い、そしてにがい水をお互いにふんだんに呑ませ合った仲であった。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "帆村の力にひかれて、お竜は強く前の方にグッとひかれ、ヨロヨロとなったところを帆村はすかさず、さっと身をうしろに開いたから、大きなお竜の身体は見事に背負い投げきまって、もんどりうって前に叩きつけられ、したたか腰骨を痛めた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりにも鮮やかな背負い投げです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "忍術指南",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなに見えていながら、いざという土俵際で、巧く自分に背負い投げを食わせた、真田奴！",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "反対派の面々にまんまと背負い投げを食わされたかたちとなった自己の忿懣よりは、それ程までにしなければ、御着の城も個々の運命も支えてゆけないと思いつめている老臣たちの頑固な旧観念と妄動を愍れまずにいられなかったのである。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　何か、鮮やかに背負い投げでも食わされたような顔つきである。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところでこの直次郎がひと通りの青年でなかった、色白の美男で武芸もでき、学問にも秀でているが、なにしろ眼から鼻へ抜けるような性質で、――十五万石をぐわんと圧えている勘兵衛が、直次郎のためにはいつも見事な背負い投げを喰わされる。",
              "citation": {
                "source": "嫁取り二代記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又背負い投げを食わしたのか。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり技がキレイなんで、唯あッと云って感心しちまうばかりですな」「まるで相撲の手か何かで、スポリと背負い投げを喰わされたようなもんですからね」「同感々々、全くお説の通りですよ。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンは、戸口に、佇立したまま、したたかに、背負い投げを食わされた思いだった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "したたかに、背負い投げで、地面へ叩きつけられた気持である。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "糠喜びをさせやがった」　と村上君は背負い投げを食った形だった。",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分だけが、いっぱし世の中も観、人生もわかったつもりで、少しばかりかち得た地位に思い上がって、ともすると、女に対しても、臆面のない振舞に出るものだから、おのれのような失敗を――運命の神から背負い投げを喰わされるのだ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "背負い投げがみごとにきまったのです。",
              "citation": {
                "source": "少年探偵団",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々、詭弁を用いて、ひとに背負い投げを喰わす秀吉の癖を知っているからである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで尺取は、どたん場へ来て見事に背負い投げをくわされた形となって、「あっ、野郎」　と、釘抜きの姿が消えた腕木門まで駆けて来てみましたが、南無三です、そこの門札には、何人の目にも分らせずには措かないようなお役所流の書体で、「甲府｜町方衆詰所通用口」　と、認めてある。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "口が達者で図々しく、反省するところも何も無い奴には、ものも言いたくないし、いきなり鮮やかな背負投げ一本くらわせて、そいつのからだを大きく宙に一廻転させ、どたん、ぎゃっという物音を背後に聞いて悠然と引上げるという光景は、想像してさえ胸がすくのである。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを聞くと葉子はみごと期待に背負投げをくわされて、その場の滑稽に思わずふき出そうとしたが、いかに事務長に対する恋におぼれきった女心の残虐さからも、さすがに木村の他意ない誠実を笑いきる事は得しないで、葉子はただ心の中で失望したように「あれだからいやになっちまう」とくさくさしながら喞った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くとも仙子氏には自己の能力を放圖もなく買ひ被つて、自分に背負投げを喰ふやうな醜いことは絶對にしなかつたといつていゝだらう。",
              "citation": {
                "source": "水野仙子氏の作品について",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡瀬に残されたただ一つのことは、どたん場で背負投げを喰わない用心だけだ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな大活動が演ぜられるかと待ち設けた私の期待は、背負投げを喰わされた気味であったが、きびきびとした成功が齎らす、身ぶるいのする様な爽かな感じが、私の心を引っ掴んだ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声の大きさに背負投げを喰わしてファニーの「Here you are」という返事は、すぐ二階に通う戸の後ろから来た。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとかどの異端評論家（『国民新聞』記者命名）、サニズムの主唱者（『時事新報』記者命名）、社会主義研究者（『万朝報』記者命名）と人も許し自分も許していた大の男が、新しい女なぞというアバズレの小娘に、見事背負投げを食わされた形になったのだ。",
              "citation": {
                "source": "男女関係について",
                "author": "女房に与えて彼女に対する一情婦の心情を語る文",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ううっッ」　何が幸いになるか分らないもので、博士の身体は背負投げを食ったように大きく半回転して海底に叩きつけられたが、そのはげしい衝撃によって今まで喪っていた意識を恢復した。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
