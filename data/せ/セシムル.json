        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「文字ノ害タル、人間ノ頭脳ヲ犯シ、精神ヲ痲痺セシムルニ至ッテ、スナワチ極マル。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ歴史ト現代トヲ理解セザル頑迷圃體論者ト歐米崇拜者トノ爭鬪ハ實ニ非常ナル不祥ヲ天皇ト國民トノ間ニ爆發セシムル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ヲ口舌ノ鬪爭ニ慣習セシムルハ其天性ヲ殘賊スルコト之ヲ戰場ニ用ユルヨリモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ限度ヲ破ル目的ヲ以テ財産ヲ血族其他ニ贈與シ又ハ何等カノ手段ニヨリテ他ニ所有セシムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ガ國際間ニ生活スル限リ國家ノ至上權ニ於テ國家ノ所有ニ納付セシムル所以。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此限度ヲ破ル目的ヲ以テ血族其他ニ贈與シ又ハ其他ノ手段ニヨリテ所有セシムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ納付ヲ拒ム目的ヲ以テ血族其他ニ贈與シ又ハ其他ノ手段ニヨリテ所有セシムルコトヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ原則ト云フ者アラバ、只國家ノ保護ニヨリテノミ各人ノ土地所有權ヲ享受セシムルガ故ニ、最高ノ所有者タル國家ガ國有トモ民有トモ決定シ得ベシト云フコト是レノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ利己的欲望中ニ含有サルル斯ル幾多ノ動機ハ、其ノ事業ヲ發展セシメタル國家的認識ト、國家ニ移レル事業ヲ其人ニ經營セシムル手腕發揮ノ自己滿足トニヨリテ、實ニ爭ヒテ私人生産業限度ヲ超越セントスル奮鬪心ヲ刺※シ鞭撻スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鑛山土地等其者ハ全ク自然ノ存在ニシテ其レヲ所有セシムル凡テノ力ハ國家ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ、勞働的株主ヲ併存セシムルコトハ内容的根本的ニ常ニ該事業ヲ健確ニ支持スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度以上ノ土地ヲ分有セシムル大本ハ別ニ存セリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "舊社會ノ惰勢ヲ存セシムル凡テノ處ニ、舊世紀ノ革命論ハ繁殖スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實男子又ハ養男子トシテ婦人ニ扶養ノ義務ヲ負荷セシメザル所以ハ、婦人ハ自己一人以上ヲ生活セシムル勞働力ナキ原則ニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ其ノ女ガ他家ニ嫁シテ餘力アル者ト雖モ、其老親ノ扶養ヲ夫ノ資産勞働ニ依頼セシムルコトハ、父母ノ屈從不安ヲ招キ更ニ婦人ヲシテ夫ノ前ニ其ノ人格的尊重ヲ傷クルニ至ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實男子又ハ養男子ニ貧困ナル老親ヲ扶養セシムルハ歐米ノ贋的個人主義ト雲泥ノ差アル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "時ニ女子ヲシテ優美纎麗ノママニ發達シタル強健ヲ得セシムルニハ丹田ノ根本ヲ整フル以外一ノ途ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ昏迷セル自由ノ解釋ハ、自由ヲ以テ放火ノ自由殺人ノ自由モ自由ナリト結論セシムルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ職業辯護人ト限ラルルガ爲メニ被告ノ平常事件ノ眞相ニ通ズル者ヲ以テ直接ニ法官ト對セシムル能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ガ平等ニ國家的保障ヲ得ルコトハ益々國民ノ自由ヲ伸張シテ其ノ差別的能力ヲ發揮セシムル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ將來益々國民ノ大多數ヲシテ數十萬數萬ノ私有財産ヲ有セシムルコトヲ國策ノ基本トスルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母ノ愛ノ百千分ノ一ニ足ラザル長子ノ愛情利害ニ一切弟妹ノ運命ヲ盲從セシムルハ沒人情ノ極。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "爲メニ遂ニ國家ノ法律ヲ抂ゲテ自國民ヲ保護シ彼等ノ財産ヲ奪ハントスル非違ヲ頻出シ不仁ノ名ヲ國家ニ冠セシムルニ至ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮臺灣樺太等ノ改造ハ此ノ三大原則ヲ決定スルニ止メ、漸ヲ追ヒテ其ノ餘ヲ施行シ、十年乃至二十年後ニ於テ日本人ト同一ナル生活權利ノ各條ヲ得セシムルヲ方針トス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ三年間ノ日月ハ日本ノ整然タル改造組織ヲ傳聞セシムルニ十分ナルガ爲メニ、日本大多數國民ノ歡喜ヲ傳ヘテ彼等ノ大多數國民亦速ニ其ノ福利惠澤ニ浴センコトヲ欲スルニ至ルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コーラン」ト共ニ劒ヲ示シテ殺スベシト云フ信仰ト殺ス勿レト云フ信仰トヲ兩立セシムルニ、liberty ナル「アルフアベット」七個ニ依頼セントスルガ如キ淺薄ナル信念ニテ何ノ信仰ゾ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ其ノ兵質ガ、前註説明ノ如ク今ノ少尉級ニ匹敵スベキヲ以テ自ラ現役年限ノ短縮トナルベク、一年又ハ一年半ノ軍隊的軍艦的訓練ハ如何ナル專門的使命アル者モ身心ノ根源ヲ培養シテ其ノ使命ノ大成ヲ準備セシムル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "外力ノ援助ナクシテ植民米人ガ戰フベキ武力ヲ有セザリシ如ク、一切ノ武器ヲ奪ハレシ印度獨立軍ニ對シテ恣ニ鎭壓軍ヲ輸送セシムルナラバ其ノ獨立ハ永久ニ期待スベカラザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐洲諸國ガ數百年以上ニ「ジンキス」汗「オゴタイ」汗等蒙古民族ノ支配ヲ許サザリシ如ク、「アングロサクソン」族ヲシテ地球ニ濶歩セシムル尚幾年カアル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗旨ノ自由トハ、何宗ニテモ、人々ノ信仰スル所ノ宗旨ニ帰依セシムルコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
