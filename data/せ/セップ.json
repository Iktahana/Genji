[
  {
    "uuid": "ad9b1f8d-1bf2-5c0a-8dc8-e120975c033a",
    "entry": "節婦",
    "reading": {
      "primary": "せっぷ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "chaste wife",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夫を亡くした後も再婚せず、操を守り通した彼女は、村中の人々から節婦として尊敬された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "講談の中で語られる節婦の物語は、古くから日本人の道徳観に大きな影響を与えてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史の教科書には、戦乱の世で力強く生きた節婦たちの逸話がいくつか紹介されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "色黒く眉薄く、鼻は恰もあるが如く、唇厚く、眦垂れ、頬ふくらみ、面に無数の痘痕あるもの、豕の如く肥えたるが、女装して絹地に立たば、誰かこれを見て節婦とし、烈女とし、賢女とし、慈母とせむ。",
              "citation": {
                "source": "醜婦を呵す",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと人間がそういうことを拵えたのなら、誰だって同一人間だもの、何｜密夫をしても可い、駈落をしても可いと、言出した処で、それが通って、世間がみんなそうなれば、かえって貞女だの、節婦だの、というものが、爪はじきをされようも知れないわ。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "南へ南へと道を取って行くと、節婦橋という小さな木橋があって、そこから先にはもう家並みは続いていない。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "強い人は幸にして偉人となり、義人となり、君子となり、節婦となり、忠臣となる。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さぞかしそちとしては辛くもあろうし、きくもけがわらしい事であろうが、一つには可哀そうな十一人の女子のために、二つにはその女子共を掠められて恨み泣きに泣き恨んでおる領民共のために、三つには八万騎旗本一統の名誉のために、そちが重責｜荷った節婦になるのじゃ。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "なれども、天下の御政道のために、是非にも節婦となって貰わねばならぬ。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうして優しく夫に劬られると、感心な節婦の話ででもあるかのやうに自分が眺められる。",
              "citation": {
                "source": "神樂阪の半襟",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やれ節婦だ、孝子だッておだてあげて、――抑えて置くのよ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤレ農村美談だ、ヤレ何々村の節婦だ、孝子だ、ヤレ何青年団の美挙だ、ヤレ何の記念事業だッて、ムキになって農村の太鼓ばたたいているんでねえか。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "節婦　任士田という人が話した。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "閲微草堂筆記（清）",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば古の忠臣義士の君國に殉せるもの、孝子節婦の親夫に盡せるもの、彼等は其の君國に殉し、親夫に盡すに當りて、果して所謂る至善の觀念を有せし乎、有して而して是に準據したりし乎。",
              "citation": {
                "source": "美的生活を論ず",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠臣孝子義士節婦の笑う可く泣く可く驚く可く歎ず可き物語が、朗々たる音吐を以て演出せられて、処女のように純潔無垢な将軍の空想を刺戟して、将軍に睡壺を撃砕する底の感激を起さしめたのである。",
              "citation": {
                "source": "余興",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "孝子でも水には溺れなければならぬ、節婦でも火には焼かれるはずである。",
              "citation": {
                "source": "寒さ",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞女、節婦とも、称められんこともない――と――某は――見ておるが――」　月丸は、綱手の上げた眼へ、美しく、澄んだ眼で、笑いかけた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば鰥寡孤獨を憐れみ、孝子節婦を賞するが如し。",
              "citation": {
                "source": "帝室論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "孝子節婦の徳義の輕重、固より量る可らざるのみならず、或は戰場の武功とても、其大小を區別して、何を大功と稱し、何を小功と評するは、甚だ難きことならん。",
              "citation": {
                "source": "帝室論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝室は人心收攬の中心と爲りて國民政治論の軋轢を緩和し、海陸軍人の精神を制して其向ふ所を知らしめ、孝子節婦有功の者を賞して全國の徳風を篤くし、文を尚び士を重んずるの例を示して我日本の學問を獨立せしめ、藝術を未だ廢せざるに救ふて文明の富を増進する等、其功徳の至大至重なること擧て云ふ可らず。",
              "citation": {
                "source": "帝室論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠臣、孝子、義夫、および節婦らの聞こえあるものへは、それぞれ褒美をやる思し召しであるから、諸国の役人どもにおいてせいぜい取り調べ、書面をもって本陣へ申し出よ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお委しくいいますと聖人といえば孔子、仏といえば釈迦、節婦貞女忠臣孝子は、一種の理想の固まりで、世の中にあり得ないほどの、理想を以て進まねばならなかった。",
              "citation": {
                "source": "教育と文芸",
                "author": "――明治四十四年六月十八日長野県会議事院において――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お石はあんな性分だ、良妻でもなし烈女節婦でもない、みんなには気にいらなかったろう、いやな女だと思ったかもしれない、だがおれのためにはずいぶん苦労して呉れたんだ、ひと口に貧乏というけれども、おれたち夫婦がどんな貧乏ぐらしをしたか、本当のことを知っている者はここにはいやあしない。",
              "citation": {
                "source": "おれの女房",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に読み書き、ついで論語のわかりやすい講話、また孝子節婦の伝など、かれらの興を唆るようにつとめて話した。",
              "citation": {
                "source": "ちくしょう谷",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恩賞目見というのは、孝子、節婦、篤農などを、城中に呼んで藩主が褒賞する。",
              "citation": {
                "source": "若き日の摂津守",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま机の上にひろげている稿本「松の花」は、藩譜のなかに編まれる烈女節婦の伝記と、紀州家中、古今のほまれ高き女性たちを録したものである。",
              "citation": {
                "source": "日本婦道記",
                "author": "松の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤右衛門はその表紙の「松の花」という題簽をあらためて見なおした、松の緑はかわらぬ操の色だ、そこに撰まれたのはあらゆる苦難とたたかった女性たちの記録である、いまの世にひろめ、のちの世に伝えて、人の心をふるいたたしめる烈女節婦の伝記だ。",
              "citation": {
                "source": "日本婦道記",
                "author": "松の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「烈女節婦はこのように伝記に撰せられるものだけではない、世の苦難をたたかいぬいたこれらの婦人は頌むべきだ。",
              "citation": {
                "source": "日本婦道記",
                "author": "松の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……この婦人たちを忘れては百千の烈女伝も意味がない、まことの節婦とは、この人々をこそさすのでなくてはならぬ」　藤右衛門は呟きおわって空へ眼をあげた。",
              "citation": {
                "source": "日本婦道記",
                "author": "松の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつりごとをあずかるものの心すべきは、みえざるところをおろそかにせぬことだ、「松の花」はあらわれた烈女たちを伝えるだけでなく、世にかくれたる節婦のおおいことをもあきらかにすべきである、「……やす」藤右衛門は夜の空に妻のおもかげを描きながら呟いた。",
              "citation": {
                "source": "日本婦道記",
                "author": "松の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、カレンは、おのをつかった役人の手にせっぷんすると、あれ野を横ぎって、そこを出ていきました．（さあ、わたしは十分、赤いくつのおかげで、苦しみを受けてしまったわ。",
              "citation": {
                "source": "赤いくつ",
                "author": "DE RODE SKO",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊＊じぶんの手にせっぷんしてみせて、はなれている相手にむかってその手をなげる形。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おお、ありがたい神さま、こんないいことをわたしたちにしてくださって、この世界にあるかぎりのすばらしいものを、惜しまずみせてくださいますあなたに、まごころのせっぷんをささげさせてください。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
