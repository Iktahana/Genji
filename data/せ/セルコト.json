        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "人類ヲ公共的動物トノミ考フル革命論ノ偏向セルコトハ、私利的欲望ヲ經濟生活ノ動機ナリト立論スル舊派經濟學ト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不幸ナル幸ハ中學教育ニ英語ヲ課シ來レル慣習ノ爲ニ、其ノ程度ノ教育者モ被教育者モ、何等カノ言語ヲ習得スベキコトヲ必須的ニ確信セルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ガ早ク已ニ支那ヲ財政的准保護國トセルコトハ説明ノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナオ戦闘開始ノノチハ、トキドキニセノ無電ヲウチ、アタカモ日本潜水艦デアルヨウニ、アメリカ艦隊ニ思ワセルコト」　と、命令をだした。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二十六日（火曜）　東京より電報、新聞、ハガキにて芥川龍之介劇薬自殺セルコトを知る。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ、予ト二人キリノ時ニ限ッテワザト昔ノ俤ヲチラツカセルコトハアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノミナラズ、モデルガ誰デアルカト云ウコトヲ彫リ手ニ知ラセズニ彫ラセルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ五子ヲ佐々木ノ案内役ニ附ケテ行カセルコトニシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大正六年五月中旬頃、滋賀県｜大津市太湖汽船会社防波堤附近ニ男ノ水死体漂着セルコトアリ。",
              "citation": {
                "source": "陰獣",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
