        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "郵便局へ出かけたついでに、冬村君の仕事場に立ち寄る、君はもう快くなつて金網機をセツセと織つてゐる、よかつた／＼。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "クツヤノ　ヂイサンハ　一リデ　セツセト　クツヲ　ツクツテ　ヰテ、フエフキガ　フエヲ　フキハジメルト、「ウルサイカラ　イツテ　オクレ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ヒトビトハ　ウマヤ　ウシト　イツシヨニ　ハタケニ　デテ　キテ　セツセト　ハタラキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝飯が濟むと看護婦とその二人の助手とはセツセと色々の器械を予の室に持ち込んだ。",
              "citation": {
                "source": "郁雨に與ふ",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "――自分は、その薪のやうな腕を拾ひあげると、ボコボコといふ音をたてゝ木魚に似た頭を、痴呆的な顔をしてセツセツと叩いてゐた。",
              "citation": {
                "source": "冬の風鈴",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "賢太郎は、シヤツ一枚になつてセツセツと、もう一つの包みを拵へてゐた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母は、セツセツと手の先を動かしてゐる。",
              "citation": {
                "source": "公園へ行く道",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、鼻頭をあかくしてセツセツとステーションを眼指して歩いて行つた。",
              "citation": {
                "source": "スプリングコート",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヅアソビハダシデ　ミヅクミセツセツセ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアサン　イツシヨニセツセツセ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の女猿曳は話し乍ら實にスタ／＼歩いてゆく地の上はすつかり暗くなつて坂の向ふには建て込んだ都會の家々の間から赤い廣告燈の上に大きな滿月が浮び上るのに息をつく隙も無く二人はセツセツと歩いてゆくあたりの騷ぎにはまるで頓着無く月の下では町の生活の呼聲が寄せては返へす波のやうに恐ろしく聞える。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "雁暖い靜かな夕方の空を百羽ばかりの雁が一列になつて飛んで行く天も地も動か無い靜かな景色の中を、不思議に默つて同じ樣に一つ一つセツセと羽を動かして黒い列をつくつて靜かに音も立てずに横切つてゆく側へ行つたら翅の音が騷がしいのだらう息切れがして疲れて居るのもあるのだらう。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "前のものが後になり、後ろの者が前になり心が心を助けて、セツセセツセと勇ましく飛んで行く。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "現はれては消えるどん／＼空氣と一緒に流れて行く一人でセツセと歩いてゆく誰も見てもしないのに元氣づいてます／＼歩くうしろから何かに押されてゐるやうだ。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "女も小供も彼等になつく空には田圃が近いので夜かせぎに圓こい鳥がセツセと飛んで行く見榮もなく翅の破れたのや拔けて落ち相な羽をぶらさげてゐるのがあり／＼見える然うして乘合馬車が、往來の上に水のやうな空氣の中に二つのランプを輝かして走つて行く何と云ふ慕しさだ。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ、草ノ葉ノカゲデ、セツセト縫物ヲシテヰタコホロギサンガミツケマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見てばかりゐないで、犬を引つぱり上げて、セツセとつれて行きなよ。",
              "citation": {
                "source": "プールと犬",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今迄通りいくらセツセと画を描いても、なんにも解決されないやうな気がするんだ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年志願をするならするで願書を出さなければならないが、放つておいたら期限に後れる、いゝ加減に帰つて来たらどうだと、苦労性な親父は私のずべらを知つてゐるのでセツセツ催促する。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人の死んだのを良いことにして、番頭の嘉七はセツセと取込んでゐる樣子だし、下女のお友はつまみ食ひばかりしてゐるし、後家のお染は取濟して冷んやりとしてゐるし、弟の米吉は、姉の部屋へばかり入り込んで、こちとらには鼻汁も引つかけないし――あの米吉といふ野郎は、氣の知れない若造ですよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "毒酒藥酒",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
