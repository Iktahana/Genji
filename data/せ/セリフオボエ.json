        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二時二十五分、熱海発、「蛇姫様」のセリフ覚えたり、半分は清にかまける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時頃から、「歌へば天国」の稽古、藤山がまるでセリフ覚えてゐないので「シャレに書いてるんじゃない、チャンと覚えて呉れ」と度々怒鳴った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねころんで「適齢記」のセリフ覚える。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和九年九月九月一日（土曜）　涼しい朝、十一時半頃までねてゐたが、起きて食事し、セリフ覚えようとしてたら眠くなり一時頃までねた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はセリフ覚えようといふ殊勝な心がけで夕刻帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "日記をたまってたのをつけ、それからセリフ覚えにかゝる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、武智豊子、セリフ覚えず、不愉快。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで、十一時二十何分に大阪へ着き、梅コマへ辷り込む予定だから、セリフ覚えねばならない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
