        "examples": {
          "standard": [
            {
              "text": "キャンプをしながら全国を旅するという、自由な生活スタイルに憧れを抱いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "テレワークの普及により、朝はゆっくりコーヒーを飲むといった新しい生活スタイルが定着した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「自分に合った生活スタイルを見つけることが、幸せへの近道だと思うんだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼女はこうして彼女のところの下宿人は既に、彼女の表現によれば、彼らの生活スタイルが出来ていることに気づいた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は五十歳になっているだろう、私はまだぼろぼろにはなっていなくて、私は自分の生活スタイルを楽しんでいることだろう。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
