[
  {
    "uuid": "288bf4db-625d-5b25-b71a-f71447577986",
    "entry": "背比べ",
    "reading": {
      "primary": "せいくらべ",
      "alternatives": [
        "せくらべ"
      ],
      "is_heteronym": true
    },
    "grammar": {
