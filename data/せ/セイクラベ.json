    "definitions": [
      {
        "index": 1,
        "gloss": "comparing heights",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちは背比べをして、誰が一番背が高いか楽しそうに競い合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの二人のチームはいつも背比べばかりしていて、なかなか協力しない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しい技術と既存の技術とで、どちらが優れているか背比べする時期が来た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "どんぐりの背比べの中から物の弾みでひょいと頭一つ飛び出せば、後はこの空間を支配する標準化の力学が、あれよあれよというまに絶対的な強者に押し上げてくれた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "疎らな杉の木立の中に絲のやうな菜種のひよろひよろと背比べをして咲いて居る所へ出た。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとには鎌髭のいかめしい鬼奴が二人、山王の大華表と背比べでもするようにのさばり返って続いて来た。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お信さんは私に近く身を寄せて、自分と背比べでもして見るやうにして言ふのだつた。",
              "citation": {
                "source": "乳の匂ひ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの閨の背比べ――恥ずかしがりやの私には、これまで貴方のお身体を、しみじみ記憶に残す機会がございませんでした。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（以下四七一字削除）しかし、その中でただ一つ、はっきりと頭の中に残っておりますのは、あの背比べなのでございます。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハカリに記された背比べのシルシが正しい安彦氏の身長だということを裏付ける方法がありません。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルティネリなどが、テナー歌手の代表的なもので、群雄割拠的にその勢威を競ったが、結局は団栗の背比べで、カルーソーの魅力の十分の一にも及ばず、イタリー歌劇は顛落の運命を辿って、無残レヴューやショーやコミック・オペラに押されるの已むなきに至ったのである。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎朝実枝にさんざん急きたてられるまでクニ子はひと時花畑に入りこんでジキタリスの花の数をかぞえてみたり、向日葵と背比べをしたり、薔薇の匂いに小鼻をうごめかしては悦に入ったりするのであった。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからごらんのとおりいつまでたつてもどんぐりのせいくらべである。",
              "citation": {
                "source": "雑文的雑文",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コスモスとお母さま櫻間中庸コスモスの　咲いてるお庭お母さまは　せんたくなさるコスモスの　花より高くお母さまは　竿をあげなさるコスモスと　お母さまとせいくらべ　せいくらべコスモスは　とても咲いてるミルクの色の　雲も浮いてる",
              "citation": {
                "source": "コスモスとお母さま",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "○いざり三、子供達にはマラソン競争を申込まれるし○いざり二、物乞ひもしねえのに、帽子を脱いだら、チャリンと金を放りこみやがるし、○いざり四、大の野郎まで、（泣きながら）馬鹿にしくさつて、背くらべにやつてくる○いざり一、そこでたまらなくなつて、村に引こんで百姓だ。",
              "citation": {
                "source": "きのふは嵐けふは晴天",
                "author": "小熊秀雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この国境では、国と国とが寝ながらお話のできるくらいですから、両国の山々も背くらべをしては楽しむほど仲がいいところです。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ以上文藝時代ともあらうものが、背競べをさせられて、しかも平氣で背くらべをして大家を持ち上げて默つてゐると云ふその顏つきは見てゐられないではないか。",
              "citation": {
                "source": "書翰",
                "author": "大正十三年十一月四日　川端康成宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづれあんな背くらべをマークでされてゐて、默つてゐる奴ばかりもなからうと思ふが。",
              "citation": {
                "source": "書翰",
                "author": "大正十三年十一月四日　川端康成宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんぐりの背くらべの身すぎ世すぎでいて、この仲間の意地の悪さに腹が立つ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何、背くらべをしている！",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆さんは今まで、私を世界一の小男と見て、子供さんまでが私と背くらべをしたりしまして馬鹿になさいましたが、ただ今は世界一の大男となりました。",
              "citation": {
                "source": "曲馬団の「トッテンカン」",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "くやしかったらここへ来て私と背くらべをしてみなされ、エヘン。",
              "citation": {
                "source": "曲馬団の「トッテンカン」",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "小田原の北条氏は全関東の統領、東国随一の豪族だが、すでに早雲の遺風なく、君臣共にドングリの背くらべ、家門を知つて天下を知らぬ平々凡々たる旧家であつた。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "小田原の北条氏は全開東の統領、東国随一の豪族だが、すでに早雲の遺風なく、君臣共にドングリの背くらべ、家門を知つて天下を知らぬ平々凡々たる旧家であつた。",
              "citation": {
                "source": "黒田如水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで背くらべをしているような屋根・屋根・屋根。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まさか」「いいえ、ほんとうに照彦様の方が少しお高いです」　と正三君が花を持たせたにもかかわらず、照彦様は、「内藤君、も一ぺん背くらべをしてみよう。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の背くらべ　石が出しぬけに大きくなろうとして、失敗したという話も残っております。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "福島県｜岩城郡草野村絹谷）　駿河の足高山は、大昔｜諸越という国から、富士と背くらべをしに渡って来た山だという話があります。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも大山と背くらべをするために、わざわざ韓から渡って来た山だから、それで韓山というのだといい伝えております。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊本県阿蘇郡｜白水村）　山が背くらべをしたという伝説は、ずいぶん広く行われております。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮崎県｜児湯郡都農村）　山が背くらべをしたという古い言い伝えなども、後には児童ばかりが笑ってきく昔話になってしまいました。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "富山県｜上新川郡）　それから越前の飯降山、これは東隣の荒島山と背くらべをして、馬の沓の半分だけ低いことがわかったそうであります。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛知県｜八名郡石巻村）　有名な多くの山々では、みんなが背くらべのためではなかったかも知れませんが、非常に土や石を大切にして、それを持って行くことをいやがりました。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
