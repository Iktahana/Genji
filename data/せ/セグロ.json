          "literary": [
            {
              "text": "そらその菰に三升ばかり背黒鰯があらあ。",
              "citation": {
                "source": "新万葉物語",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは水が見えるし、水際には背黒鶺鴒がゐて尾を振つてゐることだらう。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キセキレイ、セグロ、コマ、ルリ、ウソ、ヤマガラ、ヤマバト、ヒバリ、とても書いていられないほど多い。",
              "citation": {
                "source": "山の春",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十二年九月一日の関東地震の前に、千葉県鴨川辺ではセグロイワシが多獲されたが、地震の後はさっぱり漁獲がなくなった（水産講習所、激震地方における海洋と漁業）。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
