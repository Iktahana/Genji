          "literary": [
            {
              "text": "ナポレオンはまだ学生だつた時、彼の地理のノオト・ブツクの最後に「セエント・ヘレナ、小さい島」と記してゐた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナポレオンはまだ学生だった時、彼の地理のノオト・ブックの最後に「セエント・ヘレナ、小さい島」と記していた。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は永代橋を渡る時活動するこの河口の光景に接するやドオデエがセエン河を往復する荷船の生活を描いた可憐なる彼の『ラ・ニベルネエズ』の一小篇を思出すのである。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            }
          ]
        }
