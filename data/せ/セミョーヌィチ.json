        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「あれは宅の弟の、エゴール・セミョーヌィチですの……」と、わたしの驚きを見てとって、チカマーソフ夫人が説明した。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはエゴール・セミョーヌィチが手ずから刺繍していたもので、いずれ教会へ寄進することになっていた。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "僧正の肖像の横に、ピョートル・セミョーヌィチの肖像がかけてあって、母も娘も喪服をきていた。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピョートル・セミョーヌィチは、将官になって一週間目に死んだのである。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「ピョートル・セミョーヌィチは――御承知ですかしら？",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、エゴール・セミョーヌィチは生きていますけど、あの人のことでは、いいお話は何ひとつありませんでねえ。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あれがエゴール・セミョーヌィチだな、てっきりそうだ』と、わたしは思った。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "だってエゴール・セミョーヌィチは、わたくしたちが縫いためるはしから、何もかも持ちだして、後世のためとか申して、どこやらへ寄進してしまうんですもの。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもないとエゴール・セミョーヌィチが、また持ちだしますものね。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、これも次手に伺いたいですが、喜劇役者のチャージン――あのパーヴェル・セミョーヌィチですが、あれは今どこにいますかな？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
