    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして部屋の中が再び煽動的氣分に卷き込まれようとした時、放課の鐘がさわやかに鳴り響いた。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐の像が多い、読経の調子も煽動的である。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "艶書、バイオリン弾奏、文学書閲読、遊廓散歩等の悪事を発いて制裁を加へる一味の不良正義党が学生間に自づと組織されて、彼はその党の一員だつたが、彼等のその他の生活は悉く当局の忌諱に触れることばかりで、その方面では彼は煽動的張本人であつた。",
              "citation": {
                "source": "貧しき日録",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "煽動的なストライキの記事とか、大きな「火」のやうな見出しが斜めになつたり、倒になつたり、半分隱れたりして貼られた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔を布で包んだ上に、塗り笠でさらに顔をかくした武士が、煽動的に喋舌っていた。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからこの上、新聞の一種の煽動的報道の尻馬に乗って、ウッカリ犯人××というような犯罪を犯さないために、五・一五事件というテーマ自身を積極的に黙殺するのが、私の方針である。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは勿論、煽動的大衆劇のことを云ふのではない。",
              "citation": {
                "source": "新劇の始末",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "煽動性万能岸田國士　演劇は、それ自身、多少の煽動的要素をもつてをり、この煽動性によつて、最も民衆に受け容れられるのであるが、また一方、劇的美の厳密な批判からは、所謂「煽動性」なるものを重要な要素と見なすことはできないのである。",
              "citation": {
                "source": "煽動性万能",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで問題は、作品の「調子」に関係して来るのだが、好んで大声で語る作品、何らかの気負ひを示す作品の標題には、一種煽動的な大がかりな響が含まれることは自然であらう。",
              "citation": {
                "source": "標題のつけ方",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は別段、戦争に協力するやうな一行の煽動的な文章も書いてはゐない。",
              "citation": {
                "source": "通俗と変貌と",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はダイアナを隨分｜煽動的だと思つた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の農民は最早煽動的政談演説と党派的新聞紙とに満足する者にあらず。",
              "citation": {
                "source": "学校教育における図書館の利用",
                "author": "佐野友三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が、独身ならばと内心思っているのだけれど――』『いやに煽動的だね。",
              "citation": {
                "source": "縁談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "今去って行った隊士が、屯所へ行って、いきなり何か煽動的なことを言ったらしく、右手少し離れた所で多人数がワーッと喊声をあげる。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……遊一と遊二が互いにマジマジ顔を見合っている）（今去って行った隊士が、屯所へ行って、いきなり何か煽動的なことを言ったらしく、右手少し離れたところで多人数がワーッと喊声をあげる）遊一　……ムッ！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は多く書を読み、なまぬるい煽動的な書物を少し書き、遠くインドや極東の無政府主義運動に――（人の噂によれば）――関係をもち、世界の革命に従事し、また同時に、同じく世界的ではあるが外見上もっとやさしい研究に従事して、音楽の通俗教育のために、世界的言語と新しい方法とを求めていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、或は私をして、最も騒乱煽動的な文句を吐かしめたかどうか、僅かな日本語と表現としか知らなかった私には、知る由もない。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間、国香も、むずかしい顔して、疎髯を指でまさぐりながら、チロ、チロと兄弟たちの顔を見たり、良正の煽動的な語気へ、大きく頷いてみせたりしていた。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
