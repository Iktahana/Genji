        "examples": {
          "standard": [
            {
              "text": "占領地域の再建には、国際的な援助が不可欠であった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "占領地域における民間人の権利を守るため、国連が監視団を派遣した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その占領地域の経済復興は、長期にわたる計画に基づいて進められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、実感として私はこの判断に誤りがないことを信じ、短時日の旅行に総てを観ることができなければ、せめてこれだけは腰をおちつけてと思つたのは、所謂、そここゝに散在する占領地域の、小部隊を以てする警備と討伐と宣撫工作の実情である。",
              "citation": {
                "source": "従軍五十日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方で占領地域の治安工作は着々その実績を挙げつゝあるにもせよ、かゝる偶発事件の真相に我々は多大の関心をもつものである。",
              "citation": {
                "source": "従軍五十日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本軍の過ぐるところ、残虐きはまり、韓民悉く恐怖して山中に逃避し去り、占領地域に徴発すべき物資なく、使役すべき人夫なく、満目たゞ見る荒蕪の地、何の用にも立ち申さぬ。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本軍は進撃また進撃、勝利がつづいて大喜びだろうが、その実、占領地域がふえて大変な負担だ。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘇州河の上流の、日本軍の占領地域に行ったのである。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
