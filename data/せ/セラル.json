        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」『スズサン、リヨウジカンケイサツニコウリユウセラル、ドナタカスグゴライセイヲコウ――ハナカワヤ』「おや、すゞがあげられた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今後不幸至親ヲ害セラルル者有之ニ於テハ、事実ヲ詳ニシ、速ニ其筋へ訴へ出ヅ可ク侯。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ日本亦五十年間ニ二倍セシ人口増加率ニヨリテ百年後少クモ二億四五千萬人ヲ養フベキ大領土ヲ餘儀ナクセラル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "上院が中世的遺物ヲ以テセズ各方面ノ勳功者ヲ以テ組織セラルル所以。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "従テ假令國外出征中ノ現役將卒ト雖モ何等ノ制限無ク投票シ且ツ投票セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ母國民ノ妻タル權利ヲ擁護シ得ル制度ノ改造ヲナサバ日本ノ婦人問題ノ凡テハ解決セラル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ大資本ガ私人ノ利益ノ爲ニ私人ノ經營ニ委セラルルコトハ、人命ヲ殺活シ得ベキ軍隊ガ大名ノ利益ノ爲ニ大名ニ私用セラルルコトト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ト同時ニ一百萬圓以下ノ株券ヲ有シ合資ヲ有スル者ハ、其ノ干與セル株式會社合資會社ノ徴集セラルル時一ノ傷害ナキ賠償ヲ受クル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ利己的欲望其者ヲ解剖スルモ、事業家ノ事業經營ニ於テハ其ノ手腕ノ發揮ヲ見ル自己滿足、其ノ經營的手腕ノ社會ニ認識セラルルヲ欲スル功名的動機ガ多大ニ含有セラルルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "臺灣ニ於ケル糖業及ビ森林ニ對スル富豪等ノ罪惡ガ國家ノ不仁不義ニ歸セラルル如キハ國家及ビ國民ノ忍ビ得ベキ者ニ非ラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來臺灣ノ幾十倍ナル大領土ヲ南北滿州及ビ極東西比利亞ニ取得スベキ運命ニ於テ、同一ナル罪惡ヲ國家國民ノ責任ニ嫁セラルヽコトハ日本ノ國際的威嚴信用ヲ汚辱シ、土地ノ國際的分配ノ公正ノ爲メニ特ニ日本ノ享有セル領土擴張ノ生活權利ヲ損傷シ、如何ナル大帝國建設モ百年ノ壽ヲ全ウスル能ハザルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐵道ノ國有ナルガ故ニ現時ノ如ク民間ノ鐵道布設ガ阻害セラルルハ、第一國民ノ經濟的自由ヲ蹂躙スルノミナラズ、國有鐵道其者ノ利益ヲ減殺スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐵道ノ國有タルベキ者ト民有タルベキ者ト、亦實ニ私人生産業限度ノ原則及ビ大資本ノ國家統一ノ原則ノ下ニ律セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "生産的各省ハ私人生産者ト同一ニ課税セラルルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞働者トハ力役又ハ智能ヲ以テ公私ノ生産業ニ雇傭セラルル者ヲ云フ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人ガ大經世家タルカ大發明家大哲學者大藝術家タルカハ、彼等ノ立案スル如ク社會ガ認メテ勞働ヲ免除スト云フ事前ニ察知スベカラズシテ悉ク事後ニ認識セラルル者ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人生産ニ雇傭セラルル勞働者ハ其ノ純益ノ二分ノ一ヲ配當セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家的生産ニ雇傭セラルル勞働者ハ此ノ利益配當ニ代ハルベキ半期毎ノ給付ヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家組織ガ下掲ノ如ク母トシテ又妻トシテノ婦人ノ生活ヲ保證シ、婦人ガ男子ト平等ノ國民教育ヲ受クルナラバ、其ノ妻トシテノ勞働母トシテノ勞働ガ人格的尊敬ヲ以テ認識セラルルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "男女共中學程度終業ヲ以テ國民タル常道常識ヲ教育セラルル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レ教育スベキ國家ノ窮乏セルト、教育セラルベキ國民ニ餘裕ナカリシヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又日本ハ英語ヲ強制セラルル英領印度人ニ非ラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ハ之レヲ告訴シテ其ノ權利ヲ保護セラルル法律ヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テノ自由ガ社會ト個人其人ノ利益ノ爲メニ制限サルル如ク、戀愛ノ自由亦國民道徳ト其ノ保護者トノ爲メニ制限セラルルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ハ平等自由ノ國民タル人權ヲ保障セラル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ニ對シ又ハ世界ニ對シテ勳功アル者ハ、戰爭政治學術發明生産藝術ヲ差別セズ、一律ニ勳位ヲ受ケ、審議院議員ノ互選資格ヲ得、著シク増額セラレタル年金ヲ給付セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ此ノ改造後ノ國民ニシテ如何ナル思想ニ導カルルニセヨ、國民ノ財産權ヲ犯ス者ハ、人類社會ノ存スル限リ存スベキ法律ノ原則ニヨリテ、強窃盜トシテ罰セラレ又ハ乞食トシテ待遇セラルルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
