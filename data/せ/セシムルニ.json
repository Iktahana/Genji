          "literary": [
            {
              "text": "「文字ノ害タル、人間ノ頭脳ヲ犯シ、精神ヲ痲痺セシムルニ至ッテ、スナワチ極マル。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "時ニ女子ヲシテ優美纎麗ノママニ發達シタル強健ヲ得セシムルニハ丹田ノ根本ヲ整フル以外一ノ途ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "爲メニ遂ニ國家ノ法律ヲ抂ゲテ自國民ヲ保護シ彼等ノ財産ヲ奪ハントスル非違ヲ頻出シ不仁ノ名ヲ國家ニ冠セシムルニ至ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ三年間ノ日月ハ日本ノ整然タル改造組織ヲ傳聞セシムルニ十分ナルガ爲メニ、日本大多數國民ノ歡喜ヲ傳ヘテ彼等ノ大多數國民亦速ニ其ノ福利惠澤ニ浴センコトヲ欲スルニ至ルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コーラン」ト共ニ劒ヲ示シテ殺スベシト云フ信仰ト殺ス勿レト云フ信仰トヲ兩立セシムルニ、liberty ナル「アルフアベット」七個ニ依頼セントスルガ如キ淺薄ナル信念ニテ何ノ信仰ゾ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "千載ノ下猶多情ノ人ヲシテ、冷風淡月ノ夕、香ヲ焚キ花ヲ奠シ、遠ク青塚ヲ望ンデ、其艶魂ヲ吊セシムルニ至ル亦宜ナリ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生ヲシテ診セシムルニ一劑ニシテ癒ユ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
