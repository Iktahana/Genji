          "literary": [
            {
              "text": "広岡がじぶんのギターを教壇に寝かせ、ヤマハのセミアコ・ベースをファズにつなぎ、テニスシューズでフット・スウィッチをゆっくりと踏み、四本の開放弦を鳴らした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミア島に着陸の用意をしているのであろう。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミア島の滑走路の照明である。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミア島の画面をカットすれば、前どおりの景色の連続である。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
