          "literary": [
            {
              "text": "三「私は言わば偶然にセリストになった。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "セリストもピアニストも目ざすところは音楽であるように、われわれ物理学者も専門のいかんによらず目ざすところは物理であろう。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても魔術師ないしセリストと麻束との関係はやはり分らない。",
              "citation": {
                "source": "夢判断",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "風月ではドイツ人のピアニストＳ氏とセリストＷ氏との不可分な一対がよく同じ時刻に来合わせていた。",
              "citation": {
                "source": "コーヒー哲学序説",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
