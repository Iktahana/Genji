        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その映像は、デジタル処理によって輪郭が先鋭化され、より鮮明になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "論争は先鋭化し、双方の主張はますます尖鋭になっていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "画像編集ソフトで先鋭化フィルターを使用すると、写真がくっきりします",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
