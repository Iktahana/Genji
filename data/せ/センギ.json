        "examples": {
          "standard": [
            {
              "text": "盗難事件の容疑者として、彼は厳しい詮議を受けることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「身に覚えのないことで詮議されるのは、実に不愉快だ」と彼は憤慨した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "役人は疑わしい人物を次々と捕らえ、その正体を暴くべく詮議を尽くした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
