[
  {
    "uuid": "d76f8f13-901d-514f-9eb4-2d240b705c04",
    "entry": "正鵠",
    "reading": {
      "primary": "せいこく",
      "alternatives": [
        "せいこう"
      ],
      "is_heteronym": false
    },
    "grammar": {
