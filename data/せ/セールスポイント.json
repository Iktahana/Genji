        "examples": {
          "standard": [
            {
              "text": "この新製品の最大のセールスポイントは、競合品を圧倒する耐久性にある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "セールスポイントを顧客にしっかり伝えることが、マーケティング活動の基本中の基本だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "セールスポイントを伝え忘れてしまうと、営業活動の成果に直結する影響が出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "Ｚ80を採用した八ビット機に、ソニーは新しいハードウエアの工夫を盛り込んで使いやすさを高め、この点を家庭に食い込んでいくにあたってのセールスポイントとしようと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
