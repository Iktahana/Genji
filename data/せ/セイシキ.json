        "動詞-他動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "bed bath",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "入浴が困難な患者のために、毎日全身の清拭を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "看護師が丁寧に清拭してくれたおかげで、体も気持ちもさっぱりした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夏場は特に、清拭で体を清潔に保つことが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "病床の日課は割合忙しくて朝、午後、夕方の検温や、その間に巡ってくる院長の回診日や、清拭日やいろいろあった。",
              "citation": {
                "source": "草藪",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊は碁石の清拭きせよ。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "パンティやスカートがあつても、みな清拭されてゐる物ばかりであつたから、あん子の心はやすらかであつた。",
              "citation": {
                "source": "神のない子",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして貴重な材料を最後まで利用する為に午後一時に初まる実習時間が日暮に近く実習場の整理と清拭の為に使丁が鈴を振って定刻を告げても屍体の傍を離れようとはしない。",
              "citation": {
                "source": "屍体異変",
                "author": "森於菟",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのお台所の下ばたらきむすめも、いまではせいしきに、宮中づきのごぜん部係にとりたてられたので、ひろ間のとびらのうしろにたつことをゆるされました。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
