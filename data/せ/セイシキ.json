  {
    "uuid": "f80f9123-fbf2-57c5-bc9b-f2e7023fd439",
    "entry": "制式",
    "reading": {
      "primary": "せいしき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
