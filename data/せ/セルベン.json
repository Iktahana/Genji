          "literary": [
            {
              "text": "セルベン号・サンフランシスコ「あっぼくの国の船だ！",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまたま貨物船セルベン号がチリーのバルパライソにむかって航海するうわさを耳にした夫妻は、手をうって喜んだ、さっそくケートが走って船長に便船かたをたのんだ。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルベン号は、船長とふたりの運転手と、八人の水夫からなる、旧式の船だった。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪漢どもは完全にセルベン号を占領した。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴルドン君、ぼくはひとりで、ドノバン君が発見したというセルベン号のある海岸へいってみようと思う。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうです、セルベン号の船長や、あなたのご主人たちに対して行なったように、皆殺しにしようというのです、やつらに慈悲心を求めるのは愚の骨頂です！",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨熊岩の下、砂場の上に、セルベン号の伝馬船がひきあげてある。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
