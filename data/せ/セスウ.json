          "literary": [
            {
              "text": "此世数は京水本に従つて記し、復た諸本の異同を問はない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代に於ける無限主義・連続主義はアナクサゴラスによって、又有限主義・不連続主義はデモクリトスによって代表されたと云われるが、近世数学に於ける無限主義・連続主義はライプニツ又はニュートンの微分の概念によって確立されたと云って好い。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "政教子曰く、これ、その人はじめより正直なるにあらず、数世数百年回、社会の事情によりて淘汰せられたる結果なり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
