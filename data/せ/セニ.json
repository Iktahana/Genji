  {
    "uuid": "db208039-f318-530e-87c2-d146bd2383f0",
    "entry": "セニ",
    "reading": {
      "primary": "せに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「われも片隅なる一榻に腰掛けて、賑はしきさま打見るほどに、門の戸あけて入りしは、きたなげなる十五ばかりの伊太利栗うりにて、焼栗盛りたる紙筒を、堆く積みし箱かいこみ、『マロオニイ、セニョレ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この津藤セニョオルは新橋山城町の酒屋の主人であった。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモスセニス曰く人もしその敵を苦しめんとせば、わが女を敵に与うるより策の得たるはあらず。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンセニイなどもよんだ、ダンセニイなどは、僕が日本で一番早くよんだのではないかと思ふ。",
              "citation": {
                "source": "世に出る前後",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "故厨川博士が、ダンセニイを紹介した一年も前から読んでゐた。",
              "citation": {
                "source": "世に出る前後",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七世紀末の雑誌『アセニアン・マーキュリー』は、予が年久しく寄稿する『随筆問答雑誌』の前身といえる。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る人がサンヂカリズムを「熱烈なる社會的ジャンセニスム」（〔ardent janse'nisme social〕）と呼んだのは理由なきことではないであらう＊＊＊＊。",
              "citation": {
                "source": "唯物史観と現代の意識",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里のラセニール街二十九番に住んで居るポール・レペル先生です」扨は日影色の着物から出た彼の医学士の名刺に、御身を助けるは広い世界に此の人の外にないと書いて有った其の人だ、事の符号して居る所を見ると満更嘘らしくもない。",
              "citation": {
                "source": "幽霊塔",
                "author": "黒岩涙香",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の翌日の午後には早や巴里へ着した、ラセニール街二十九番館へ尋ねて行った。",
              "citation": {
                "source": "幽霊塔",
                "author": "黒岩涙香",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢張｜山籠をしてゐるアルセニイと云ふ僧の監督を受けて、折々此人に手紙で教を授けて貰つて、厳重な僧尼の生活を営んだ。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォクセニスカという村へ辿りつくと、この機を逃さず珍種日本人を見学せばやとあって、黒土道の両側に土着の人民が堵列している。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "隙を見て巡航船へ避難し、ほうぼうの態でヴォクセニスカをあとにサイマ湖へ出た。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "さては騎士だの侍従だの詩人だの、例の主馬頭夫人の魅笑に惹き寄せられた恋のすぺいんの亡霊たちが何か感違いして現れたとみえる――こう思ってＧＡＢＡと寝台を跳ね下りた私が、せいぜい歌劇的に窓へ進んで、そのむかしセニョラがしたであろうように窓を開いて見下ろすと――。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうの闘牛ドン・カルヴァリヨ氏――現在ここであばれてる牛の名――を出したヴェラガ公爵の闘牛場と、もう一つセニョオラ・ＭＩＵＲＡのガナデリアと、このふたつとも南のアンダルシア地方にある。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――プロセニウムに近く、炬燵に向ひ合つて、文六とおせい。",
              "citation": {
                "source": "遂に「知らん」文六（三場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "クセニエンわたし共は小さい剪刀を持った虫になって来ています。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰色の壁の低い空を思はせる陰鬱さもさることながら、アーチ形のプロセニウムが階段でオルケストルにつながつてゐる、その冷たく重い線のなかに、僕は、もう、「北方」を感じて、思はず肩をすぼめてしまつた。",
              "citation": {
                "source": "芝居と僕",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハ　テガツカヘルクセニ　アシデ、ナンキンマメノ　カハヲムイテ、タベルヂヤナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロセニウムにはボエックリンの半身像円柱の上に立つ。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロセニウムはしばし暗きままに止る。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "と言つて、たれかれの私に寄するクセニエに、一向私は恐れない。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし安穏を私は愛するので、その片よつた力で衆愚を唆すクセニエから、私は自分を衛らねばならぬ。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは自分で自分にクセニエを寄することである。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそのクセニエの中で、いかにも悠々と振舞ふ。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "たれかれの私に寄するクセニエに、寛大にうなづき、愛嬌いい挨拶をかはし、さうすることで、彼らの風上に立つのである。",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうして私は静かなクセニエを書かねばならぬ！",
              "citation": {
                "source": "わがひとに与ふる哀歌",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "コポオは、これを呼んで「常設舞台」（セーヌ・ペルマナント）と言い、プロセニウムの客席に通じる半円形の階段とともに、彼の目指す「演劇の再演劇化」を象徴するものとさえなったのです。",
              "citation": {
                "source": "あるニュウ・フェイスへの手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく右手、プロセニウムに近く、事務所の出入口。",
              "citation": {
                "source": "浅間山",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手、プロセニウムに近く、書棚を背にして塾長用のデスク。",
              "citation": {
                "source": "速水女塾",
                "author": "四幕と声のみの一場よりなる喜劇",
                "note": "青空文庫"
              }
            }
          ]
        }
