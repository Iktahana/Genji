        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "代診のセルゲイ、セルゲイチは、いつも控所に院長の出て来るのを待っている。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "代診のセルゲイ、セルゲイチが時々手を擦り擦り口を入れる。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "病院に来てより間もなく、代診のセルゲイ、セルゲイチとも、会計とも、直ぐに親密になったのである。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、敬虔なるセルゲイ、セルゲイチは云いながら。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝セルゲイ、セルゲイチはここに来て、熱心に十｜字架に向って祈祷を捧げ、自分等が前の院長たりし人の眼を合わしたのであった。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
