          "literary": [
            {
              "text": "現行法律ガ買淫婦人ヲノミ罰シテ買淫男子ヲ罰セザルハ姦通罪ガ婦人ヲノミ罰シテ男子ニ及バザルト等シキ片務的横暴ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ガ日本ノ西海道ナル所以ヲ明ニスルトキ百般ノ施設悉ク日鮮人ノ融合統一ヲ來サザル者ナク、獨立問題ノ如キ希フト雖モ生起セザルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "相士ノ曰日光ノ及ブ所照臨セザルハ無シト。",
              "citation": {
                "source": "茶漬三略",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
