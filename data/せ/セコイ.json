    "definitions": [
      {
        "index": 1,
        "gloss": "petty",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "それはせこい（ pettry）行為だったね。もっと寛大になれたのに。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、常にわずかな利益を得ようとするせこい（ pettry）態度で知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "最後のケーキ一切れを分けるのに、そんなにせこい（ pettry）ことしないで。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "旦那がたに門口から追い返されるようでは、どうせこいつも、いい加減の碌でなしに違いない！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "せこい偽造屋の小男は顔を上げなかった。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人のせこい友人が守りの弱点を見つけて、機会を逃しません。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "せこいやり方でしょ？",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「とてもせこいなあ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしクラレットのせこい冗談が立ち消えたら、たぶん国王はもっと喜んだかも知れない。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "近江の口ぐせで言へば、セコい／＼。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそのエコノミカルは、四六時中忙がしげに、コセコセ働らくといふ意味のエコノミイではない。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへ俺は行こうってんだ」　樫の盆見たいな顔を持った、セコンドメイトは、私と並んで、少し後れようと試みながら歩いていた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ろ頭か、首筋に寒気でもするんかい」　私は又、実際、セコンドメイトが、私の眼の前に、眼の横ではいけない、眼の前に、奴のローラー見たいな首筋を見せたら、私の担いでいた行李で、その上に載っかっている、だらしのないマット見たいな、「どあたま」を、地面まで叩きつけてやろう！",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、セコンドメイトは、私に訊いた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを、お前が無茶云うから、船長だって憤るんだ」　セコンドメイトは、栗のきんとん見たいな調子で云った。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "セコンドメイトの猫入らずを防ぐと同時に、私の欺され易いセンチメンタリズムを怒鳴りつけた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "セコンドメイトは、私と並んで、私が何を眺めているか検査でもするように、私の視線を追っかけていた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "な、お前がいくら頑張ったって、船長も云ったように、一億円の船会社にゃ、勝てっこないんだから」　セコンドメイトは、デッキの上と橋板の上とでは、レコードの両面見たいに、あべこべの事を云い始めた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "セコンドメイトは、私が行李を担ぎ上げたので、二足許り歩いた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体、お前気でも狂ったんじゃないのか」　セコンドメイトは、ポシャッと云った水音で振りかえってそう云った。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "セコンドメイトは、私が、どんなに非常識な事をいっても「憤ってはならない」と心の中で決めているらしかった。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　セコンドメイトが、油を塗った盆見たいに顔を赤く光らせたのから、私は、彼の考えを見てとった。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "セコンドメイトは、私が頭を抱えて濡れた海苔見たいに、橋板にへばりついているのを見て、「いくらか心配になって」覗き込みに来るだろう。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、私の手か頭かに、セコンドメイトの手の触れるのを待っていた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけにセコンドメイトまでも、待ち切れなくなったと見えて、消え失せてしまっていた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、セコンドメイトは、海事局に行っているに違いない。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついに野球のセコチャンが一人｜溺死した。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "セコチャンは、自分をのみ殺した湖の、蒼黒い湖面を見下ろす墓地に、永劫に眠った。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "セコチャンが溺死して、一週間目の晩であった。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その風の姿は、一週間前、セコチャンが溺死した沼のほうへと飛んだ。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "深谷は、一週間前に溺死したセコチャンの新仏の廓内にいた！",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなにセコチャンと親密ではなかった。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "――物理的操作とはセコンドメートの口吻を借りたのである――そして、糞の分子と分子とがやや空隙を生ずる時において熱湯を――この時決して物惜しみしてチビチビあけてはならない、思い切って――どっと一時に打ちあけるのである。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
