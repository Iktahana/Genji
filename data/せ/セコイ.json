        "examples": {
          "standard": [
            {
              "text": "チームのパフォーマンスはせこかった（poor）。ほとんど点を取れなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その映画の筋書きはせこかった（poor）し、予測可能だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "遅刻の言い訳はかなりせこかった（poor）。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
