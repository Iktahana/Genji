    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "分割センガ為メニ弾圧スル――コレガ支那ニ於ケル帝国主義者共ノ政策デアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米人ノ持續セントスル國際的特權ノタメニ宣傳サレツツアル平和主義非軍國主義ガ、其ノ特權ヲ打破センガ爲メニ存スル日本ノ軍備及ビ戰鬪的精神ニ對スル非難トシテ輸入サレツツアル内容皆無ノ文化運動。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮其者ノ歴史ガ示ス如ク、又清國ガ此レヲ屬國トセンガ爲ニ起リタル日清戰爭、及ビ滿洲ニ來タレル露西亞ガ其ヲ侵略セントセシガタメニ破レタル日露戰爭ニ示ス如ク、其ノ亡國タルベキ内外呼應ノ原因ハ統治者ガ日本タラザル時ハ露支兩國ノ焉レカナリシハ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（則チ當面ノ現實問題トシテ濠洲又ハ極東西比利亞ヲ取得センガタメニ其ノ領有者ニ向テ開戰スル如キハ國家ノ權利ナリ）。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ハ見タワケデハアリマセンガ、確ニ私ハソレヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ気モチハ一寸オワカリニナラナイカモ知レマセンガホントウデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンガ何故殺害サレタカ分リマセンガ、其ノ殺害ヲ一番早ク云イ当テタノハ動坂三郎氏デス。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアこれは一寸耳をこちらへ出して、ソコイラノ評論ヲ評論ト云イ得ルトハ思ッテ居リマセンガ、私ニハホントノ評論ヤソノ骨格ガワカッテイルカラケンソンスルノデス。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダサウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダソウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本帝国　東京　大関久五郎　地理学を修むる者　此宿ノ人ノ話ニ拠レバ、コレ迄吾日本帝国民ニシテコヽニ泊ッテ Jungfrau ニ登ツタ人ハ無イトノコトデス、本当カウソカハ私ハ知リマセンガ、兎ニ角コヽニ吾邦人ニシテコノ後コヽニ来リ宿ル方ニ対シ御免ヲ蒙ツテ私ノ名ヲ日本語デ書イテ置キマス。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、皆サンゴゾンジナイカモ分リマセンガ、ジヤガイモサンハ大ヘンナオ寝坊サンデシタカラ、人参サンニゴツンゴツンタタカレテモ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "国民酒場のオヤジに向って、旦那、スミマセンガ、モウ一杯ナントカ、と頼んでいるのはオ客の方で、ダメだよ、ウルセエナ、と言っているのはオヤジの方なのである。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル予言ニヨラバ、閣下、定メラレシ年月過ギシノチ、コノ世ニ甦リ、コノ家カラコノ地ヲ再ビ征服センガタメ、崇拝者ヲ連レテ立ツ、トアリ。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "我国の本草学者などは中国でいう草とはチョウセンガリヤス（Diplachne serotina Link. var. chinensis Maxim.）の漢名である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし日本人は恐らくこのチョウセンガリヤスを染料として黄色を染めた経験は誰もまだもってはいまい。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コブナグサの漢名として草というのはコブナグサではない、しからば何かというとチョウセンガリヤスです。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョウセンガリヤスというのは、日本に限ったことはない。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが草はチョウセンガリヤスといわなければならない。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンガ　オツムノナカデ　クルクルマハツテ　パチント　コワレタノヂヤナイカト　オモツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "カキノウエニ　アカイフウセンガ　ノゾイテル　キミノブンモ　オカアサンガ　カツテアゲタヨト　イツテル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンガ　イツテルヤウダ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "(*6) lingulae and gasteropods、「シャミセンガイ」だとちょっとアレなので……(*7) わざわざ canned じゃなくて tinned と言っています。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツデモ来ルガイヽ」「有難ウ存ジマス、オ言葉ニ甘エテコレカラチョク／＼伺イマス、毎日ト云ウ訳ニモ参リマセンガ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネエオ爺チャン、颯子ガソンナモノヲ持ッテタ筈ハアリマセンガ、………」婆サンノ追及ハコヽヘ来テ俄ニ急デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ノコトデスカラ多少ノ変化ハ已ムヲ得マセンガ、コノ前測ッタ時ト比ベテ異状ハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレデ結局墓石ノ形式ハドレニオ決メナサイマスカナ、実ニイロ／＼ト専門家モ及バヌホド御存知デイラッシャイマスノデ、私ナゾハ何トモ申シ上ゲヨウガゴザイマセンガ」「僕自身モドウシテイヽカ分ラナイノデ迷ッテルンデスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当分オ目ニ懸リマセンガ、イズレアナタガ新夫人トナラレタ暁ニ改メテ拝顔ノ機会ノアルコトヲ望ミマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
