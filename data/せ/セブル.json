        "examples": {
          "standard": [
            {
              "text": "「昨日は夜通しゲームをしていたから、今日は一日中せぶっていたよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "縁側で猫が気持ちよさそうにせぶっているのを見て、私も眠くなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "授業中にこっそりせぶっていたのが先生に見つかり、廊下に立たされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "カツレツなんか注文したら、そんな吝くさい物を食べずにたまにゃ最と上等の料理おあがりよ、そしてあたしにも驕って頂戴ってせぶるんだ。",
              "citation": {
                "source": "女給",
                "author": "細井和喜蔵",
                "note": "青空文庫"
              }
            }
          ]
        }
