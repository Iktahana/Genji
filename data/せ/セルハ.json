          "literary": [
            {
              "text": "滿十六歳以下トセルハ下掲ノ國民教育期間ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ兒童ノ權利トシテ兒童其者ヲ權利主體トセルハ、父母ノ如何ニ係ラズ、第二ノ國民タル點ニ於テ國民的人權ヲ有スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "拘留罰金ヲ以テセルハ婦ノ訴ナキ場合ニ於テ姦通罪ヲ檢擧セザル原則ニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "獨身ノ男子ヲ除外セルハ決シテ其性慾ヲ正義化スル所以ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "検案ノ医師カ右ハ生前ノ切傷ニシテ死因ヲ為シ、尚腹部ニ多少ノ水ヲ蔵セルハ、殺害ト同時ニ水中ニ投棄セラレタルモノナル旨ヲ断定セルニ依リ、茲ニ大事件トシテ俄ニ捜査官ノ活動ハ始マレリ。",
              "citation": {
                "source": "陰獣",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
