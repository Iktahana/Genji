          "literary": [
            {
              "text": "330破滅を來す敵將のおのが持ち場に攻め寄るを、ペテオースより生れたる＊メネスチュウスは見て震ひ、畏れ、アカイア軍勢の＊塔を見｜※し、將軍の一人友の災を防ぎ救ふを乞ひ求む。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "奮戦力闘、攻め寄る敵を殱滅して、かえって、良兼の筑波勢に、手痛い損害を与えて、見事、追い返してしまったのである。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
