          "standard": [
            {
              "text": "選挙管理委員会は投票日程と各候補者の届け出状況を公式サイトで公表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "投票所の設置場所に疑問があり、地元の選挙管理委員会に電話して確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "選挙管理委員会の担当者が学校を訪れ、生徒たちに選挙の仕組みをわかりやすく説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "この解散、総選挙を前にいたしまして、ＮＨＫ、選挙管理委員会、さらには公明選挙連盟が主催をいたしまして自民、社会、民社の代表を集めて、その総選挙に臨む態度を表明する機会を与えられましたことを、まことにけっこうなことだと考え、感謝をするものであります。",
              "citation": {
                "source": "浅沼稲次郎の三つの代表的演説",
                "author": "浅沼稲次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
