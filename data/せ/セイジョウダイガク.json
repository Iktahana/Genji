        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "成城大学は東京都世田谷区に位置し、落ち着いたキャンパスの雰囲気が評判の私立大学だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼は成城大学の経済学部を卒業後、志望していた大手商社の採用試験に合格した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "成城大学の文芸学部で近代日本文学を専攻し、卒業論文では太宰治を取り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "○「鼠の浄土」は成城大学紀要『伝承文化』一号（昭和三十五年十月）に発表。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
