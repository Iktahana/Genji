  {
    "uuid": "70f13244-6595-5b27-9bf5-99dc9f50e02c",
    "entry": "千変",
    "reading": {
      "primary": "せんぺん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
