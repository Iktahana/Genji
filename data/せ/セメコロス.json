        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あまり頻繁に拷問をつづけると、彼を責め殺す虞があるからであった。",
              "citation": {
                "source": "拷問の話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち遣つて置くと、あの人達は人一人責め殺す位平気なのだ。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "お腹の赤ン坊を責め殺す積りなんかしら」　春三郎は赫と怒つた。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――まるで鼠花火に火をつけたように、これが次から次へとひろがってゆき、弥七の家から逃げだした者が、各自の家でまた同じように狂いだし、互いに責め殺すという結果になった。",
              "citation": {
                "source": "ちくしょう谷",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
