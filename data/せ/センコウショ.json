        "examples": {
          "standard": [
            {
              "text": "この選鉱所は1日に数千トンの鉱石を処理している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "選鉱所の環境対策が強化された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "選鉱所で働く労働者は重い責任を負っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それを選鉱所で、銅をふくんでいる石と、ふくんでいない石とによりわけ、ふくんでいるものを熔鉱炉に入れてとかすという順序なのだ。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は坑内の見学をおわると、選鉱所を見て、それから熔鉱炉の工場へと案内してもらった。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "選鉱所でよりわけられた鉱石は、熔鉱炉でとかされ、むだなものをとりのぞく。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
