        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "色鮮やかなセロハンを重ねて、光を透かすステンドグラス風の工作を作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "花束を包む透明なセロハンが、花の美しさをより一層引き立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "セロハンは木材パルプを原料とした天然由来のフィルムなので、環境に優しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが末起にとってみれば生みの父親であるところの、さいしょの養子は間もなく死に、二度目の、いまの謙吉は事業慾がつよく、連綿とした、老舗を畳んでセロハン会社などをやっていた。",
              "citation": {
                "source": "方子と末起",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらもセロハンの包装が開かれないままの状態だ。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "中身は飛び飛びの頁で読まれたものでないから、その場で読めぬようあらかじめセロファンで包んで置くと、如何にも新本だ。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在、感じている日本文学のもの足りなさは、それが未熟だからでも、稚拙だからでもなく、それどころか、どの作品も趣向はそれぞれにこらしてあって、手綺麗に色もとりどりであるけれども、そのあまりにも多くが、駅の売店につられている派手なセロファン人形だ、という、そのもの足りなさである。",
              "citation": {
                "source": "「下じき」の問題",
                "author": "――こんにちの文学への疑い――",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは、セロファンのように薄い服を着て、みるからに、昔、田舎にも来ていた事のあるサアカスの女になつたような気がしてくる。",
              "citation": {
                "source": "淪落",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫｜除けの薬をいれる、ホドヂンと云うセロファンの薬の袋を貼っているひとたちのなかに、眼鏡をかけた赤い着物のおばあさんもいました。",
              "citation": {
                "source": "新生の門",
                "author": "――栃木の女囚刑務所を訪ねて",
                "note": "青空文庫"
              }
            },
            {
              "text": "衰弱した異常なセロファンのような空気が僕の眼の前から、その食堂の円天井まで漲っているのだった。",
              "citation": {
                "source": "夢と人生",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "バッグの口を開けて、中からセロファンに包んだガムを取りだして、嫌がる絹坊の顔に押しつけた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人たちのためには、セロファンで作った透明な袋があって、これを頭から被ってやれば、髪は湯に濡れずに済んだ。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれでは濡れるとすぐピリピリ感電するので、過日用心のため、その上にセロファンに糊のついたテープを巻き、さらにその上から油紙（といっても昔のものとは違い、あぶないものだ）を細く切って巻いておいた。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "テーブルのうえに張ってある耐水セロファンの帯が、鉢をのせたまま、うごくのじゃ。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の顔色がセロファン製のマスク越しにサッと変ったのが二人に分った。",
              "citation": {
                "source": "月世界探険記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしたからおろしてはくための新しい靴下がセロファン袋のまま裁縫袋のわきに出ている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いセロファンのようなエプロンをつけたつや子が、伸子の洗った鍋は鍋のあったところに、大杓子はそれがかかっていた釘へかけて片づけを手伝っている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "千種は縁の広いセロファンの帽子に黒いヴェールをかけ、足許の危険に備へて、スカアトにゴム長靴といふ不恰好を我慢しなければならなかつた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから戸棚をあけてセロファンで包んだ大きな箱を持ちだしてきた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「煙草吸うんやろ、わかっとる」　彼は、白いセロファンの下に、くっきり赤い丸のある煙草の箱をポケットから放り出した。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで早速、便を少しとって、セロファンで包んで乾かないようにして、飛行便で慶応病院あてに送ってみた。",
              "citation": {
                "source": "ジストマ退治の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｃレーションのは厚いセロファンに包んであり、そのままボソボソ食ってもいいし、もみつぶして食器に入れ、水をかけてもいい。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「自分の方からはせっせと書いているのに、ひどい女もいるものだ」――これがそれだと、サムは札入のセロファンの中に入っている写真を見せた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいろいろ考えて、試みにスコッチ印のセロファンテープの六〇〇番を適当の長さ（測ってみたら五センチ三ミリあった）に切り、帳面の表紙の或る一箇所を選んで、表と裏とをそのテープで封じてみた。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セロファンテープは大体元の位置に貼ってあった。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐに私は、書棚の蔭に隠してある日記帳を取り出して、念のために調べてみたが、セロファンテープで封をしておけばよかったのであるが、まさかそこまで用心深くはしなかったので、盗み読まれていたにしても、証拠を見付けようはなかった。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "では何のために音のしない雁皮紙を使ったり、セロファンテープで封をしたりしたかといえば、用もないのにそういう秘密主義を取るのが生来の趣味であったのだ、というよりほかはない。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が面倒な手数を厭わずセロファンテープ等を使ったのは、自分だけでなく、夫の趣味に迎合するためでもあった。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中へ水を透かさぬ用心であろう、函の裏側には一面に、セロファンのごとき物で内貼りがしてあった。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたして水は一滴も浸みてはいなかったが、問題はこのセロファンのごとき物であった。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙ともつかず、金属ともつかず、硝子よりもっと透明であり、セロファンよりもっと薄く、もっと柔軟に、しかも刃物で切っても切れず、錐の先で突いても穴一つあかず、何という物か、頓と得体のわからぬものであった。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして函の内側一杯に、例のセロファンようの物が貼ってあることも、また前のごとし。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
