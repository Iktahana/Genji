        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "之レ教育スベキ國家ノ窮乏セルト、教育セラルベキ國民ニ餘裕ナカリシヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "……曰く……　――余ノ調査研究セルトコロニ依レバ、既ニ往昔ヨリコノ種ノ犯罪ガ行ワレツツアリシ事実ヲ認ムルヲ得ベシ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルトの種族の前へいつも誘引の魅力を見せる自然は、彼にも同じ力を及ぼさずにはゐなかつた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "「氷島の漁夫」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の藝術の最初の出發點は、同じセルトの先人シャトオブリアンの歩みを起したると、同一點である。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "「氷島の漁夫」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くもシングはロチのこの作によつて、彼らの中に眠つてゐる共通なセルトの靈の目醒める機會を與へられたに異ひない。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "「氷島の漁夫」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "この不可抗の力に對する一種の默聽、それこそはセルト種族の他とは異つた特徴ではあるまいか。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "「氷島の漁夫」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞセルトの種族が他よりもより多くその傾向を持つてゐるといふに過ぎないのである。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "「氷島の漁夫」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルナンの内心の默示に聽け、シャトオブリアンの漂泊の思ひ、そしてロチの哀歡に想到せよ、セルト種族の心理、セルト種族の生命の一端に接し得らるるに異ひない。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "「氷島の漁夫」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時ハ何処ノ国籍ニ属スルヤ全ク不明ナリシガ只今マデ数日間観察セルトコロニヨレバ○国人ナルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンクウルのジェルミニー・ラッセルトオを読む。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "臣夙ニ鉱毒ノ禍害ノ滔滔底止スル所ナキト民人ノ痛苦其極ニ達セルトヲ見テ憂悶手足ヲ措クニ処ナシ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "その話で私はウセルトセン一世のオベリスクの下で包囲されたきたない年若な親たちの群を思い出した。",
              "citation": {
                "source": "処女の木とアブ・サルガ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　嘗て、ロクロワ氏が文部大臣在職当時、同じゴンクウル氏の「ジェルミニイ・ラツセルトゥウ」をオデオン座で、上演した際、検閲官は作者にある部分の修正を希望し、作者はこれを快諾した事実もあります。",
              "citation": {
                "source": "仏国議会に於ける脚本検閲問題",
                "author": "――ゴンクウルの『娼婦エリザ』――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ等の一つで、其處では小徑が急に暗い壁と壁との間で、セルト人の小屋のやうな尖つた高い草葺屋根の間で、狹くなつてゐたが、其處の或る居酒屋の看板が、彼女を微笑させた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い綿紗の戸帳をつけたゴオドの寢臺は、室の片隅に置いてあつたが、かうしたセルト人の小家のなかでは、ことに目立つて新らしく立派に見えた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "九十ニナッテモ子ヲ産ンデミセルト云ウ久原房之助ノヨウナ精力ハナク、既ニ全ク無能力者デハアルガ、ダカラト云ッテイロ／＼ノ変形的間接的方法デ性ノ魅力ヲ感ジルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「興奮サセルトイケナイカラ、アダリンヲ飲マセタゲマショウカ」颯子ガ予ニコウ云ウ種類ノコケトリーヲ云ウノハ始メテデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不便ト思ウノハイヽケレド、オ爺チャンヲ楽シマセルタメニ、アタシガ犠牲ニサレルノハ嫌ダワ」「犠牲ト云ウコトハナイデショウ、僕ヲ楽シマセルト同時ニ、君自身モ楽シムンジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その奏状の後段には、「臣夙ニ鉱毒ノ禍害ノ滔々底止スル所ナキト民人ノ痛苦其極ニ達セルトヲ見テ、憂悶手足ヲ措クニ処ナシ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンクール兄弟は1861年の「フィロメヌ姉妹」で病院と診療所における生活を1865年の「ジェルミニ・ラセルトゥ」においては下層階級の一夫人の生活を描写した。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "メンゲルベルクが手慣れた管弦楽団アムステルダムのコンセルトヘボウを指揮している良さであろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
