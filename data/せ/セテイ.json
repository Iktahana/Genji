          "standard": [],
          "literary": [
            {
              "text": "かうした事実は、古代埃及人の天体の運行に関する智識から生れたものであつて、テーベ（ナイル河の上流の古都）にある紀元前千三百年頃のヱジプト王セテイ一世の墳墓の天井には星座の図が描いてあるのを見ても判る。",
              "citation": {
                "source": "星",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に、セテイ一世より五十年許り後のラムセス二世の墓にも星を描いた壁画がある。",
              "citation": {
                "source": "星",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "街衢ノ寒サ――一九三三　二月十七日ノ室内ノコト――李箱ねおんさいんハさつくすふおおんノ様ニ痩セテイル。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ニ算盤ヲ弾カセテイルコトモアルガ、大概ハ颯子ガ自ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルマヽニサセテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ彼女ヲソウサセタノニハ予ニモ責任ガナイコトハナイガ、浄吉ノ奴ハ亭主ノ癖ニ最初カラ彼女ニ一目置クヨウナ素振ヲ見セテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ小サクッテイラッシャルノニ、ヤッパリオ爺チャンノコトヲ心配ナスッテイラッシャルンデゴザイマスネ」「子供ノ癖ニ変ニマセテイヤガッテ小生意気デイヤナ奴ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手ハモウスッカリオ直リニナッタンデスカ」来ルトイキナリ気ヲ呑マレタ形デ眼ヲ白黒サセテイタ五子ハ、コヽデ辛ウジテ嘴ヲ入レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ川勝氏ノ著書ニ上京区紫野今宮町ノ今宮神社ノ線彫四面石佛ト云ウモノヲ載セテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ソノ外ニ蜻蛉石線彫阿弥陀三尊石佛ノ一ツトシテ勢至菩薩坐像ノ拓本ヲ載セテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女等ハ茫然トシテ無言デ顔ヲ見合ワセテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ足音ヲ忍バセテイッタン寝室ヲ出、二階ノ書斎ノデスクカラ螢光燈ランプヲ外シテ、ソレヲ持ッテ戻ッテ来、ナイトテーブルノ上ニ置イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一々フラッシュヲ用イナケレバナラナイヲ見合ワセテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
