    "definitions": [
      {
        "index": 1,
        "gloss": "anthology",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大石千代子さんは、ブラジルに十年の余も暮し、南洋にも暮し、書きたい題材はいっぱいあって苦しいくらいだという状態で、『山に生きる人々』という作品集を大陸開拓文芸懇話会の選書で出版していられる。",
              "citation": {
                "source": "文学の大陸的性格について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は創元社の編輯長だつた岡村政司君に会つたとき、「春日」に就て多々弁じて、創元選書へ入れるやうに大いにすゝめた。",
              "citation": {
                "source": "蟹の泡",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月の人件費にも足りない金で図書館の選書とカードができるのである。",
              "citation": {
                "source": "図書館法と出版界",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "公共図書館と、学校図書館は、その協議体を協同的二大組織として、選書およびカード操作において、その歩調をととのえるべきである。",
              "citation": {
                "source": "図書館協会六十周年に寄せて",
                "author": "――大衆に奉仕する一大組織体へ",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛讀者の中には、之を「選書十種」の中に入れる人もゐるに違ひない。",
              "citation": {
                "source": "人間惡の創造",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「測量船」はそつくりそのまま、後に出した創元社の選書中の一冊『春の岬』にをさめてある。",
              "citation": {
                "source": "測量船拾遺",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一定の限られた解決を必要とするような形での研究上の選書法は、恐らくその時々で異るだろう。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が考えて見たのは、半ば研究的で半ば教養のための、選書法のことである。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野に“全国児童選書展覧会”というのが開催され、ぼくのお清書も入選して展示された事かもしれない。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "西行についてはすでに、尾山篤二郎氏の実証に徹した『西行法師評伝』という名著があるし、川田順氏に『俊成・定家・西行』という叡智ににおう好著と、『西行』（創元選書）という手頃の本がある。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「工芸選書」第一篇と第二篇とは同君等の仕事である。",
              "citation": {
                "source": "和紙十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
