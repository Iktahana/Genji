  {
    "uuid": "0c329af5-c9c1-5ec7-8d9a-09a01795b659",
    "entry": "千緒",
    "reading": {
      "primary": "せんしょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
