        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供の頃、戦国時代の武将の物語を読むのが好きだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "中国の戦国時代には、多くの思想家が登場した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この城は、戦国時代に築かれたもので、歴史的価値が高い。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "competition in which there are several evenly matched participants",
        "register": "standard",
