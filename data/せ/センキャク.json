[
  {
    "uuid": "56b2d057-a391-5878-8e70-d2bb343f805c",
    "entry": "先客",
    "reading": {
      "primary": "せんきゃく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "the preceding visitor",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人気のラーメン屋に行ったらすでに先客が十人以上並んでいて、一時間待ちだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「すみません、この席は先客がいらっしゃいますので、あちらの席へどうぞ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "貸別荘に着くと、すでに先客の猫がテラスでくつろいでいて思わず笑ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "丁度先客と對談中であつた彼は、ひどく憔悴して見えた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先客が歸つたあとで、彼は再度、前の日の鋭い質問を繰返した。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときすでに、ひとりの先客があった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先客の恰好が、どうもなんだか奇態に見えたからである。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "年賀に行くと大抵応接間か客座敷に通されるのであるが、そうした部屋は先客がない限り全く火の気がなくて永いこと冷却されていた歴史をもった部屋である。",
              "citation": {
                "source": "新年雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先客の三人も今来た一人も、みな土方か立ちんぼうぐらいのごく下等な労働者である。",
              "citation": {
                "source": "窮死",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "床の上を足を動かすたびに、先客の喰荒らした広東豆（南京豆のこと）の殻が気味悪くつぶれて音をたてた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は先客の人に対して議会解散の予想などを喋喋述べて居たが、「こんなへつぽこ役人ではね、」と云つて湧き上る様に笑つた。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "五人の先客が、それぞれ新聞をひろげて見ていた。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "縄のれんをはじいて中へはいると、この早朝に、もうはや二人の先客があった。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときすでに、ひとりの先客があつた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に、先客が一人ありまして爐の右に居ました。",
              "citation": {
                "source": "雪靈記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "失禮ながら、此の先客は邪魔でした。",
              "citation": {
                "source": "雪靈記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に、先客が一人ありまして炉の右に居ました。",
              "citation": {
                "source": "雪霊記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "失礼ながら、この先客は邪魔でした。",
              "citation": {
                "source": "雪霊記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めその婦人達は先客としての日本の男女を紹介されてちょっと気負いを挫かれた形だったが、直き又揃えたような美貌を正面に立ててガルスワーシーに逢えた光栄を得意の英語の大げさな口調でしゃべり始めた。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "送って玄関まで行ったガルスワーシー夫人が応接間へ帰って来た時、何んとなく取り散らかされたような室内の気配のなかに少し不興気な先客を置くのを恐縮しながら夫妻は裏庭のサンルームの方へ更めて二人を案内した。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先客にはすでに白髪白髯の和製タゴール老人がいた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ桟敷――東のずっと末でした――その妙に、同じような先客が、ふと気がさしたと見えて――挨拶をした時は、ふり向きもしなかったのが――お絹をこの時見返って、愕然とした様子です。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人の僧は先客があってもその上にどうかしてこの連中を泊めようとして、道に出て頭を掻きながら、ひょこひょこと追従をしていた。",
              "citation": {
                "source": "源氏物語",
                "author": "玉鬘",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶店には二人の先客があった。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は今夜来ない筈になっていたのであるから、先客に座敷を占められても苦情はいえない。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等のほかにもう一人の先客があつた。",
              "citation": {
                "source": "木枯紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "先客のために屋根の中に入り得ない私たちは艫の荷物の上に辛うじて腰掛けたが、ツイ眼の前には昨夜真夜中に著いた停車場が見えた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰らかと云えば、小心な信一郎は、多くの先客を押し分けて、夫人の傍近く坐ることが、可なり心苦しかった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、その的は、六人の先客の背中でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな所に既に先客があると誰が想像するものがあろう。",
              "citation": {
                "source": "動物園の一夜",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "小石川の竹早町で電車にわかれて、藤坂を降りる、切支丹坂をのぼる、この雪の日にはかなりに難儀な道中をつづけて、ともかくも青蛙堂まで無事にたどり着くと、もう七、八人の先客があつまっていた。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階へ案内されて、十畳と八畳をぶちぬきの座敷へ通されて、さて先客の人々を見わたすと、そのなかの三人ほどを除いては、みな私の見識らない人たちばかりであった。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
