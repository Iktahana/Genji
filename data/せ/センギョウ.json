  {
    "uuid": "7f5fd9a1-c973-5b8e-b1fc-c331d9997dcf",
    "entry": "瞻仰",
    "reading": {
      "primary": "せんぎょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
