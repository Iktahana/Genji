        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ルーベンスやゲーンスボローやないしはアルマタデマに無くしてセザンヌ、ゴーホあるいはセガンチニなどに存するところのものである。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂本｜繁二郎氏のセガンチニを草体で行ったような牛の絵でも今見てもちっとも見劣りがしない。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "開けた処には、セガンチニの死ぬるところが書いてある。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "セガンチニが一度も窓を開けず、戸の外へ出なかったら、どうだろう。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "中巻新来朝五国聯合　バード・ストーン一座大曲馬プログラム　（午後一時開演）（同　五時終了）★１……君が代行進曲　専属音楽団★２……文字を解し、計算し、地図を読む馬　米国理学博士　アスタ・セガンチニ夫人★３……二頭立戦車曲芸　◇第一戦車　〔伊太利〕　ルビヤ・ベルチニ嬢。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ホオオオ……それは……ミセス・シムラは何という名前になっておりますか」「……アスタ・セガンチニ……一番初めのプログラムに出ておいでになります。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハハハハハハ……お伽話だ……地底の蜃気楼……アッハッハッフッフッフッ……アスタ・セガンチニ……あの近眼婆さん……オースタリ人の志村のぶ子……アハハハハ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "欺されている事……」「……………」「ジョージはマダム・セガンチニと夫婦になるために逃げたのです。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワハハハハハハハハハハ……｜お伽話だ……｜地底の蜃気楼……アッハッハッフッフッフッ……アスタ・セガンチニ……あの近眼婆さん……オースタリ人の志村のぶ子……アハハハハ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今おもふとたしか、あれは、イタリアのセガンチニイだつたらしい。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "セガンチニイは今でこそ日本のどんな畫學生でも知つてゐるが、その頃はたづねる友人もなかつた。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで學校の歸途丸善にセガンチニを買つて、電車の中でも歸つてからも貪り見た。",
              "citation": {
                "source": "三太郎の日記　第三",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜十時半、客が歸つてから又セガンチニを見る。",
              "citation": {
                "source": "三太郎の日記　第三",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてセガンチニの愛を以つて我子Ｋ子のことを思ふ。",
              "citation": {
                "source": "三太郎の日記　第三",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は暫く下界に住んで来て、さてこの山嶽をば通りしなに既にセガンチニの画境の種々相を感得することが出来た。",
              "citation": {
                "source": "リギ山上の一夜",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "セガンチニもいろいろなものを画いた。",
              "citation": {
                "source": "リギ山上の一夜",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "セガンチニは、すべてそういうものをば種々の原色の顔料で、一筆一筆に盛りあげている。",
              "citation": {
                "source": "リギ山上の一夜",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
