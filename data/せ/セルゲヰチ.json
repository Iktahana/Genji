        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "代診のセルゲイ、セルゲヰチは、毎も控所に院長の出て來るのを待つてゐる。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "代診のセルゲイ、セルゲヰチが時々手を擦り／＼口を入れる。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "病院に來てより間もなく、代診のセルゲイ、セルゲヰチとも、會計とも、直ぐに親密になつたのである。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、敬虔なるセルゲイ、セルゲヰチは云ひながら。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝セルゲイ、セルゲヰチは此に來て、熱心に十｜字架に向つて祈祷を捧げ、自分等が前の院長たりし人の眼を合はしたので有つた。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
