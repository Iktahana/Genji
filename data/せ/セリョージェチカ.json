          "literary": [
            {
              "text": "「ねえ、セリョージェチカ、なんて素晴らしい晩だろうねえ！",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょいと、セリョージェチカ、こっちへおいでな。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうやら私たちの元手ができたらしいよ、セリョージェチカ。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "三度目か四度目の宿営地に着いた日、カテリーナ・リヴォーヴナは薄暗くなるかならなぬうちから例の袖の下を使って、可愛いセリョージェチカとの逢曳の手筈をととのえ、一まず横にはなったが眠らずにいた。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうしたらいいだろうねえ、セリョージェチカ？",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
