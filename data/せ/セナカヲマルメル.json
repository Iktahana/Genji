        "examples": {
          "standard": [
            {
              "text": "寒さに震えながら、コートの襟を立てて背中を丸めて歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "自信がないのか、彼はいつも背中を丸めて下ばかり向いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スマホに熱中するあまり、無意識のうちに背中を丸める姿勢になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "つい熱心にそれに耳を傾けてゐた私は、その時はじめてその女と自分とがいつか知らず識らずの裡に暖爐の方へ背中を丸めるやうにして互に身をよせてゐるのに氣がついた位だつた。",
              "citation": {
                "source": "生者と死者",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕り方たちは、御用提灯を振りかざして、獲物を狙う獣物のように、背中を丸めるようにして、押しつけて来るのだったが、さりとて急には飛び込めない。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
