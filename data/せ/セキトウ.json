        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "墓地には、故人の名前が刻まれた石塔が並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は亡き妻の石塔に、静かに花を手向けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "石塔には、生前の彼の功績が記されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
