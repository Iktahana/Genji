        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「マドンナ・デラ・ピエタ」「幼児虐殺」「聖セバスティアン」「勝利者サムソン」、その他の名作がある。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る朝、私はサン・セバスティアンのヴィラ「ラ・クンブレ」の日陰の涼しいヴェランダで、デッキ・チェアに足を踏み伸ばして、読めもしない西班牙語の新聞の見出しを拾っていた。",
              "citation": {
                "source": "闘牛",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土曜日（八月二十日）からサン・セバスティアンで始まる。",
              "citation": {
                "source": "闘牛",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度サン・セバスティアンに来るベルモンテはその息子で、若くて色男で人気者だ、ということだった。",
              "citation": {
                "source": "闘牛",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "折よくサン・セバスティアンに来たのは、サン・セバスティアンは北の海岸の避暑地で、其処では夏の季節が選ばれるからであった。",
              "citation": {
                "source": "闘牛",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイツが突然ソヴィエトと握手したといふ報道がサン・セバスティアン（公使館所在地）に傳はつたのは八月二十二日（一九三九年）だつた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・セバスティアンからサン・ヂャン・ド・リュズまでは僅かに三〇キロに過ぎない。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・セバスティアンそのものがエスパーニャとしてはエスパーニャらしくない、謂はばフランスらしい感じのする土地であるが、それでもイルンの川を通り越すと、同じバスクの地域でありながら、國境一つでかうも變るものかと思はれるほど、急に沿道の形貌が一變したやうな印象を與へられた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "文房具屋のかみさんとバーの前の年とつた女の影像がサン・セバスティアンに歸りつくまで私のあたまの中にあつた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その實感はサン・セバスティアンの宿の空氣の中にもひろがつた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日（二十八日）の午後一時、私たちはサン・セバスティアンを出て、四時半にブルゴスを通り、一望涯もない赤土の曠野を横斷して、日歿にガダラマ山脈の東の肩を越し、夜マドリィに着いた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・セバスティアンからブルゴスまで二四〇キロ、ブルゴスからマドリィまで二四〇キロ、合計四八〇キロ。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌日（三十日）はヴァヤドリィを見物して、ブルゴスに出て、もう一度ブルゴスを見直し、エスパーニャのボルドーといはれるログローニョからエステヤを通り、アルトー・デ・リサラガの壯大な景觀を賞翫して、夕方サン・セバスティアンに歸つた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・セバスティアンに歸つてから手に入つたニューズに據ると、ドイツの動員はすでに五百萬に達したといふことだつた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "住み馴れたサン・セバスティアンの山の上のヴィラ「ラ・クンブレ」を出たのは八時ごろだつた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳澤氏にはこの間サン・セバスティアンで逢ひ、その晩矢野公使と一緒に海岸の見晴らしのよい料理屋で晩餐を共にした。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・セバスティアンの公使館の食堂で、その話が出た時、矢野公使は、明日はオニャーテの古い大學とビルバオの新らしい戰場に案内しようと思つてゐたが、ついでにロヨラにも寄らうといつた。",
              "citation": {
                "source": "聖ロヨラ",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・セバスティアンのヴィラ「ラ・クンブレ」を車で出かけたのは朝の八時半だつた。",
              "citation": {
                "source": "聖ロヨラ",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "がセバスティアン・コカールにたいしてはもっと同情がもてた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖セバスティアヌスのお助けだ！",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "パラティノ丘の大きなアポロの神殿は同じように破壊され同じ石を使って同じ場所にペストから守ってくれるキリスト教殉教者セバスティアヌスに最初の教会が献堂された。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして７世紀以降に聖セバスティアヌスはペストから人を守る守護聖人になった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝説の結果としてセバスティアヌスがペストの聖人になった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "セバスティアヌスは矢による死よりも強かったのでペストからの救助者になった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "14世紀にペストは再び世界に流行し聖セバスティアヌスの助けによっても何百万人が死亡した。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような時に人々はペストが終わったら聖セバスティアヌスと聖ロクスの祭壇を建てたりヴェネチアのサンタマリア・デラ・サルーテのような誓願の教会を建てるというような誓いを行った。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は嘗て古物屋で無名の作曲家による聖セバスティアヌスを賛美した音楽の興味深い本を見つけた。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペストの特別の守護者、神聖にして光栄ある殉教者セバスティアヌスの生涯と行為。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "本文にはセバスティアヌスの誕生から殉教までの話がラテン語とドイツ語で書かれている。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
