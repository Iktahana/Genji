          "literary": [
            {
              "text": "幸ひに小生の知友達は、悉く健やかなる至上芸術派として専念斯道に励みつゝあるブセハラスの矜持豊かなる騎手達です。",
              "citation": {
                "source": "附「歌へる日まで」",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は、強欲者の酒倉を襲って酒樽を奪掠するこの泥棒詩人の、ブセハラスではなかったか！",
              "citation": {
                "source": "ゼーロン",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジョセハ、うれしいことをきかせてあげるよ。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "日記ノ内容ヲ読マセハシナイガ、コウ頻繁ニ看護婦ノ必要ガ起ルト、佐々木ニハ或ル程度察知サレテモ仕方ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ勿論颯子ヲモデルニスル※ヲ石屋ヤ五子等ニ悟ラセハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セハランチンの注射液がおありになるとかなので、太宰さんを愛している大勢の男のひとのために、大勢の女のひとのために、一日でも早く養生して、注射してみて下さるよう御願いする。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            },
            {
              "text": "鏡ヲ把テ之ヲ照セハ。",
              "citation": {
                "source": "『雪華図説』の研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
