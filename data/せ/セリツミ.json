          "literary": [
            {
              "text": "お道もその後から續いたが、また途中で別れて芹摘みに行つた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "御前はそんな形姿で地体どこへ、行ったのぞいと聴くと、今｜芹摘みに行った戻りじゃ、和尚さん少しやろうかと云うて、いきなりわしの袂へ泥だらけの芹を押し込んで、ハハハハハ」「どうも、……」と老人は苦笑いをしたが、急に立って「実はこれを御覧に入れるつもりで」と話をまた道具の方へそらした。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方近くになると、芹摘みから戻って来た綿屋の娘が彼の前を通り抜けて行った。",
              "citation": {
                "source": "菜穂子",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏にやる田芹摘みにと来し我ぞ二月一日　在小諸。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも御馳走になるで、きょうは肴だけは持参しようと、芹摘みを始めたが、芹は少い、蓼ばかりじゃ。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
