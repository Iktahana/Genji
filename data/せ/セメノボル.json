[
  {
    "uuid": "12d7b4d0-05e8-58fb-b5c0-83f41c57421f",
    "entry": "攻め上る",
    "reading": {
      "primary": "せめのぼる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
