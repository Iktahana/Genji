        "examples": {
          "standard": [
            {
              "text": "ブランドのセカンドハンドショップで、定価の三分の一以下でコートを手に入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "環境への関心からセカンドハンドの家具や衣服を積極的に選ぶ若者が増えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女はセカンドハンドの楽器でも丁寧に手入れすれば十分使えると言って、中古のバイオリンを買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "勿論資料の点ではセカンドハンドのものが多く、資料的オリジナリティーを期待するのは控えねばならぬ（鈴木茂三郎氏の独占資本に関する数著を最も屡々引用している）。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
