        "examples": {
          "standard": [
            {
              "text": "体がストレスに晒されると、様々な生体反応が現れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "薬の副作用として、予期せぬ生体反応が起こることがあるので注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "植物は、光や水分といった外部からの刺激に対して複雑な生体反応を示す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "熊城君、君は、心臓停止の直前になると、皮膚や爪に生体反応が現われなくなるのを知っているだろう。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は外からの刺激にたいし生体反応の役割を主張し自己の学説を30の命題にした。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
