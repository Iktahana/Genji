      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to take by storm (e.g. a castle)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "城壁は固かったが、兵士たちは奮闘の末、ついに敵の砦を攻め落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "織田軍は三日三晩の激戦の末、ついに城を攻め落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海賊の砦を攻め落とすために、海軍は上陸作戦を決行した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "人間の力で攻め落すことはむつかしい」　と、恐れているのである。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "到底攻め落すことが出來ずば、自から責を引いて處決する位の覺悟があつて欲しい。",
              "citation": {
                "source": "支那人の文弱と保守",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月十五日を期し、堀秀治の軍兵を城内へ引入れて、一挙に攻め落すといふ手筈をたてた。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "城中よりはその後再び軍勢を差し向けたけれども、それも負け戦に終ってしまい、勝ち誇ったる檜垣衆は日増しに猛威を逞しゅうして、領内を荒らし廻り、僅か一と月ばかりの間に方々の子城を攻め落すと云う有様であった。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "論争は、ここ二十日ほどの間に、前後して、伊勢の戦野に参加した新鋭の援軍の将たちの間に闘わされて、一部は、「伊勢の南を先に席巻して高岡の城は、後にすべし」　と、いう意見であり、一方は、「いや、敵が難攻不落と恃む高岡の城こそ、先へ懸って攻め落すべきである」　と、いう二者の対立だった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "たれか宮路の城を一気に攻め落す自信のあるものはないか」　ことばの下に。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「急ごしらえのコケ脅し、攻め落すに何の手間ひまやある。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "後陣の滝川、加藤、早川、下方などの諸隊は、先鋒軍の木下、池田の二隊が、今に全滅の傷手を負って退くだろうと、味方ながら、むしろ冷やかに見ていたが、そのうちに、岐阜本城から早打ちが戻って来て、「高岡の城を先に攻め陥すこそ上策なれ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "――伊丹一城を攻め陥すは至難でない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こん夜から三日のうちに、寿春を攻め陥すのだ。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、毛利方の吉川、小早川の大軍が上月城を攻め陥すとまもなく、戦況の持久的になるのを察して、吉川元春は出雲へ、小早川隆景は安芸へ、それぞれ退いてしまったことにある。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そしていかに主君信長の軍がよく迅く伊丹の逆臣を攻め陥すかを千秋の思いで待っていた。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の戦は瞬間に攻落すことを欲したから、北村、名古屋の輩までに力を出させたのである。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "縦、数千万騎を以ても攻落すべき様もなし、況や、桟梯引落して楯籠らば、馬も人も通ふべき所にあらずと。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに勇敢無比なわが海軍の精鋭をもってしても、これは相当の犠牲を出さないでは攻めおとすことができないと分かった。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「石田治部少輔の軍勢でございます」「石田、……治部少輔が攻めこんで来たのか」「なんでも三万の軍勢で、館林を攻めおとすなりまっすぐに押寄せたのだそうです」七兵衛老人は次ぎのように語った。",
              "citation": {
                "source": "荒法師",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下の諸雄はほとんどその旗下にはせ参じ、明けて今年の三月には小田原城をまったく包囲してしまい、さらに石田三成、大谷吉継、長束正家らをして上野、武蔵、下総の諸国にある北条氏の属城を攻めおとすべく軍を進めさせた。",
              "citation": {
                "source": "日本婦道記",
                "author": "笄堀",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで龍太郎さまは、これからいずれへおいそぎですか」「されば小太郎山へまいって、三百人の兵をかりあつめ、ここ四日ののちに、人穴城を攻めおとす計略」「わたくしがやる仕事も四日目です。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
