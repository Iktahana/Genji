    "entry": "攻め落とす",
    "reading": {
      "primary": "せめおとす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
      "ctype": "五段-サ行",
      "inflections": null,
