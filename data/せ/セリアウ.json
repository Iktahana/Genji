        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちは、おもちゃの取り合いで激しく競り合っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "限られた資源を巡って、複数の企業が激しく競り合っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "王座を巡る二人の剣士は、一歩も引かずに剣を競り合っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "出世を競り合うて呪咀い合うものと聞いた、蔵元屋の前の御寮さんが、コッソリ里子に遣ったままにして置いた芋屋の娘……正しく蔵元屋の血統を引いた、お熊さん同様の一点の疵もない卵の剥き身、生さぬ仲の芋屋の老人夫婦を真実の親と思い込んでの孝行振りまで、お熊さんと瓜二つの生き写し。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きて行く場面で互が苦しく競り合うものとして現れているとすれば、今日目の前にそういう現象を持ち来している社会的な動機への洞察がいつかよびさまされずにいない。",
              "citation": {
                "source": "異性の間の友情",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」せりあううちに後毛はらはら、さっと心も乱髪、身に振かかる禍のありともあわれ白露や、無分別なるものすなわちこれなり。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "レースは相手とせりあうことによって、相手をぬいて行く力を言うのである。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく病気の後では健康がいよいよ美しいものに思われるものであるが、思うにそれは、両者があまりにも接近しているために、両方が互いにしのぎをけずってせりあうところを、目のあたり見ることができるからなのではあるまいか。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "地表を蔽った武器の爆薬の堵列した進行のさま、鉄、石炭、石油の獲得、も早や後へは退けぬ、せり合う戦備の雲行き烈しい各国の目まぐるしさも、矢代は見てきた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ある日から、アイヌのクシュンコタンは日本人とロシヤ人のせり合う土地となった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "二位をずっと引き離したのか私とせり合う相手はなかった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれから二人はせり合うように、代る代る泣き声をはり上げた。",
              "citation": {
                "source": "次郎物語",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の終りころに鰯の漁が初まり、李一も出かけなければならず、みんな沖へ出たのでしたが、鰯というものは、海の中に一かたまりに群れていて、その盛んに群れている時はせり合うた鰯が水面へ跳ね上るくらいで、鴎なぞがそれを捕って食うほどです。",
              "citation": {
                "source": "不思議な魚",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
