        "examples": {
          "standard": [
            {
              "text": "昔の犯罪では、死刑の一種として截頭が行われることがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古代の処刑方法には、截頭も含まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "（※比喩表現として）困難な問題に直面し、頭を截頭される思いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "つまり、その結果実現された怪屍体の制作が、胎龍の大脳を、厨川君が理論的に歪め変形して行った結論だったのだ」　それから筒提灯が何をしたか――法水の説明は、最終の截頭機に及んで行った。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "shaping the flowers and leaves of a plant",
        "register": "standard",
        "nuance": null,
