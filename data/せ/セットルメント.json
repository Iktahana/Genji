        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "純益は、あすこで北京に開いている女学校と東北農村セットルメントに捧げるのですって。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "相原は、諸戸と同郷で、ころがり込んでいるうち、府下のセットルメント・ワークを任され、今では一方の主になっている男であった。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえりに彼女はセットルメントへ寄って見た。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、セットルメントの仕事で世界に知られているトインビー・ホールを訪問して、そこの労働者大学の課目を帳面に写してもっていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トインビー・ホールはオックスフォードおよびケムブリッジ大学卒業生によって経営される知らぬ者のない英国セットルメント事業の本山である。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀行会社の休日にはセットルメント事業も休日だということは知らなかった。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
