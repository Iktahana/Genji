          "literary": [
            {
              "text": "之レ教育スベキ國家ノ窮乏セルト、教育セラルベキ國民ニ餘裕ナカリシヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ露西亞ノ脅威ハ過渡時代ノ「レニン」ニ非ズシテ「レニン」無キ後眞ニ再建セラルベキ十年後ノ將來ニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "改造組織ノ全部施行セラルベキ新領土。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ本国いぎりすノ国家ノ強ヒル宗教ヲ信ズルコトヲ肯ンゼザルナリ、制度ハ国ノ制度ヲ遵奉セザル可カラズトイヘドモ、信仰ハ自由也、国家ヨリ賦課セラルベキモノニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
