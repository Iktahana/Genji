        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "河川の護岸工事のために、砕石を詰め込んだ巨大な石籠がいくつも積み上げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "伝統的な石籠は、水の流れを適度に逃がしながら土砂の流出を防ぐ優れた工法だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この石籠の編み目が緩むと崩落の危険があるから、定期的な点検が欠かせない」と技師が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
