          "literary": [
            {
              "text": "そのタバコもナーシャマルカ〔わが国の商品〕、デリ、その他、モッセルプロムは時々だけ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルプ・イ・モロト〔「鎌と槌」工場のこと〕へ出かけたら丁度ゆき違ってクルジョーク〔サークル〕だめだった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "タバコの（モッセルプロムの）露店、どこもしまってしまった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はセルプ・イ・モロトの日だがＹ工合わるいのでやすみ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その点オソアビアヒムともセルプ・イ・モロトとも違う。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、つかれたので М・Х・А・Т の横のモルセルプロムに Coffee をのみに出かけたら何もなく、ノアールにスハリ〔菓子の名〕だけ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
