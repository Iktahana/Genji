        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "支那ノ労働者農民ノ国民革命運動ヲ、血ヲ以テ窒息セシメタ各国ノ帝国主義ハ、干渉カラ土地掠奪ニ移ロウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "太ッタ大資本家共ハ、鈴文ヤ松駒ノ如キ階級的裏切者ヲ買収シ、諸君カラノ搾取ヲマスマスヤサシクシ、諸君ノ妻ヤ子ヲ、飢ニヒンセシメ、諸君ヲモ絞殺スル反動ノ城塞ヲ固クスルモノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "和尚、一転語ヲカエテ、ネガワクハ野狐ヲ脱セシメヨト。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "天ノ命、二十世紀ノ第一年ヲ以テ此ノ法案ヲ起草セシメタルヲ拜謝ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代世界ヲ展開セシメタル三大發明ノ中火藥ガ人類ヲ殺スヨリモ甚シク、印刷術ノ害毒全世界ノ頭腦ヲ朽蝕腐爛シ盡クセリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一歩ヲ誤ラバ宗祖ノ建國ヲ一空セシメ危機誠ニ幕末維新ノ内憂外患ヲ再現シ來レリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ納付ヲ避クル目的ヲ以テ血族其他ニ分有セシメ又ハ贈與スルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ中世貴族ノ所有地ヲ現今ニ至ルモ解決スル能ハズシテ終ニ獨立問題ニマデ破裂セシメタル愛蘭ノ土地問題ト、此ノ私有地限度制トハ其思想ニ於テモ進歩ノ程度ニ於テモ雲泥ノ差アルヲ知ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ日本改造法案ヲ一貫スル原理ハ、國民ノ財産所有權ヲ否定スル者ニ非ズシテ、全國民ニ其所有權ヲ保障シ享樂セシメントスルニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ利己的欲望中ニ含有サルル斯ル幾多ノ動機ハ、其ノ事業ヲ發展セシメタル國家的認識ト、國家ニ移レル事業ヲ其人ニ經營セシムル手腕發揮ノ自己滿足トニヨリテ、實ニ爭ヒテ私人生産業限度ヲ超越セントスル奮鬪心ヲ刺※シ鞭撻スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ改造後ノ大方針トシテ國家ハ終ニ婦人ニ勞働ヲ負荷セシメザル國是ヲ決定シテ施設スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ノ使命的勞働ヲ廢セシメテ全ク天性ニ合セザル勞働ヲ課スルハ、啻ニ婦人其者ヲ殘賊スルノミナラズ、直ニ其ノ夫ヲ殘賊シ其子女ヲ殘賊スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ妻タリ母タル勞働ノミトナラバ、夫タル勞働者ノ品性ヲ向上セシメ、次代ノ國民タル子女ヲ益々優秀ナラシメ、各家庭ノ集合タル國家ハ百花爛漫春光駘蕩タルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母ノ遺産ヲ相續セル兒童、又ハ母ノ資産或ハ特種能力ニ於テ教養セラレ得ル兒童ハ、國家ト協議ノ上此ノ權利ヲ放棄セシメラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實男子又ハ養男子トシテ婦人ニ扶養ノ義務ヲ負荷セシメザル所以ハ、婦人ハ自己一人以上ヲ生活セシムル勞働力ナキ原則ニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ婦人ニ老親ヲ負擔セシメザルハ日本古來ノ不文律ニシテ同時ニ婦人々權ノ擁護ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ母又ハ女子ニ負荷セシメザル所以ハ、愛情アリト雖モ扶養能力ナキガ故ニ、結局其ノ兄弟又ハ娘ノ夫ノ負擔トナリテ立法ノ精神ヲ殺ス者トナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "學制ヲ根本的ニ改革シテ、十年間ヲ一貫セシメ、日本精華ニ基ク世界的常識ヲ養成シ、國民個々ノ心身ヲ充實具足セシメテ、各其ノ天賦ヲ發揮シ得ベキ基本ヲ作ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "下掲國家ノ權利ニ説ク如ク、日本ハ最モ近キ將來ニ於テ極東西比利亞濠洲等ヲ其ノ主權下ニ置クトキ、現在ノ歐米各國語ヲ有スル者ノ外ニ新タニ印度人支那人朝鮮人ノ移住ヲ迎フルガ故ニ、殆ド世界凡テノ言語ヲ我ガ新領土内ニ雜用セシメザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "中食ノ學校支辨ノ理由ハ第一ニ登校兒童ノタメニ毎朝母ヲ勞苦セシメザルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ幼童ノ純白ナル頭腦ニ口腹ノ欲ニ過ギザル物質的差等ヲ以テ一切ヲ高下セントスル現代マデノ惡徳ヲ印象セシメザルニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "保姆ノ一方ガ殘虐ナル苦痛ヲ他ノ一方ニ加ヘテ横暴ト悲慘トヲ居常見聞セシメラルル兒童ノ惡感化ニ對シテ、國家ハ大父母ノ權利ニ於テ殘虐ナル一方ヲ處罰スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レヲ途方モナキ一夫一婦制ニ對スル反逆ト考フルハ、恰モ政治的特權者ニ向ツテ叫バレタル政治ノ自由ヲ平等ナル國民間ニ脱線セシメテ、相犯サザル各自ノ自由ヲ蹂躙スルコトモ等シク政治ノ自由ナリト云フ低能者ノ昏迷ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國防上朝鮮ヲ獨立セシメズト云フコトハ、英人ガ印度ヲ獨立セシメズ又亞佛利加植民地ヲ獨立セシメズト云フコトトハ全ク別事ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本皇室ト朝鮮王室トノ結合ハ實ニ日鮮人ノ終ニ一民族タルベキ大本ヲ具體化シタル者ニシテ、泣ク／＼匈奴ニ皇女ヲ降嫁セシメタル政略的ノ者ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來ノ帝國領土中、先住國民ノ大富豪大地主アリテ多大ノ土地ヲ獨占シ又ハ生産業ヲ專有スル時是ヲ是認スル如キアラバ、日本國家ハ只彼等ノ不義ナル財産ノ保護ヲ負擔セシメラレ、日本國民ハ只其ノ小作人タリ勞働者タルニ過ギザル可シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ノ國家觀ハ國家ハ有機的不可分ナル一大家族ナリト云フ近代ノ社會有機體説ヲ、深遠博大ナル哲學的思索ト宗教的信仰トニヨリ發現セシメタル古來一貫ノ信念ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
