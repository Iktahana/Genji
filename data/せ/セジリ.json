          "literary": [
            {
              "text": "咲かない馬酔木の芽のうつくしさ平山から瀬尻へ。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀬尻平山橋、それから架設中の大和橋、渡船で、大井橋、そして西ノ渡（三味線が鳴りラヂオが叫ぶ！",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝壺の瀬尻のせせらぎに、ガバと波紋を描いたものがある。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、用水から余った瀬尻が深く水底を穿ってどんよりと蒼蒼しい淵をつくっていた。",
              "citation": {
                "source": "性に眼覚める頃",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
