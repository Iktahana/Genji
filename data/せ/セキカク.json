        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おそろしい大関格のお岩さまの顔であっても、腫物のためなどで左右の目がやや対称をかいているが、全体から見ると顔の軸を中心として左右対称である。",
              "citation": {
                "source": "断層顔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本でいえば、相撲の大関格ぐらいのからだの所有者だった。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この碁会所はアマチュアの大関格が沢山集つてゐるのである。",
              "citation": {
                "source": "生命拾ひをした話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌劇「天国と地獄」の序曲などは通俗音楽の大関格だろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧盤のメルバは骨董レコードの大関格の名盤だが、電気以後にはパンゼラの歌ったものがある（ビクターＪＤ一二五一）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛇使いの見世物――これは維新後の取締規則で、すっかり影を没してしまいましたが、轆轤首、鳥娘、などと共に、娘形を主人公にした見世物では大関格で、特にその時両国へ小屋を掛けて居た金之丞一座は物凄い当りでした。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第八夜　蛇使いの娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして本｜科二三年の時分には百五十｜點にまでせり登つて、球突塲の常連でも大｜關格ぐらゐになつたが、何としてもその折々の氣分に左右され勝ちな自分の本｜性は爭へなかつた。",
              "citation": {
                "source": "文壇球突物語",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
