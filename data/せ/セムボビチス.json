        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "追随するのは魔法師のセムボビチスと宦官のメンケラとである。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "みちみち、セムボビチスが王に遊星の力や宝石の徳を教へたり、メンケラが尊い秘文の歌を謡つて聞かせたりする。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "『踊は祈祷ぢや』と魔法師のセムボビチスが云ふ。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "『陛下、女王と都合のよい商業上の条約を結ぶのを御忘れなさいますな』とセムボビチスが小声で云ふ。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの賢いセムボビチスも宦官のメンケラも差上げる』とかう叫んだ。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "『陛下、都合のよい商業上の条約をお結びになりましたか』セムボビチスはかうたづねた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時アブナアの側に立つてゐた魔法師のセムボビチスと宦官のメンケラとが、おそろしい叫び声をあげた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬物の学に精通してゐるセムボビチスは、王がまだ呼吸のある事がわかつた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつと十六日目に王は眼を開いて床の側にゐるセムボビチスとメンケラとを見た。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "『きつと商品を交易する契約を致して居るのでございませう』と賢人のセムボビチスがつけ加へた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　王は三週間人事不省のまま横はつてゐたが、二十二日目に人心地がついて、メンケラと共に看病してゐたセムボビチスの手をとつた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『智慧は幸福を与へまする』とセムボビチスは答へた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "王は毎夜、魔法師のセムボビチスと宦官のメンケラと共に王宮の露台に坐して、地平線を遮つてそよりともせずに立つてゐる椰子の木を見つめたり、材木のやうにナイル河を下つて来る鰐の群を月あかりで見守つたりした。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "『自然の美しさはたたへて倦む事を知りませぬ』とセムボビチスが云つた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれ共年老つたセムボビチスが答へるには、『勿論ナイル河の氾濫の様な現象もございます。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "『それは何でございませうか』とセムボビチスが問ふと、王はかう答へた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処で賢人セムボビチスの指導の下に天文の研究をするのである。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "『天上の星宿は人間の運命を示すものでございます』とセムボビチスが云つた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "セムボビチス、お前は己に知識を教へてくれるがよい。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　之がセムボビチスの王に知識を教へた理由であつた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "綿密な注意を払つて星の交会を研究したり、セムボビチスと寸毫も変らず正確に星占図を引いたりする。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "『セムボビチス、お前は己の星占図の真だと云ふ事を首にかけてもうけ合ふ心算か』かう王が尋ねたことがある。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、学者は度々間違ひを致します』と賢人セムボビチスが答へた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "セムボビチス、此愛らしい美しい星がどんなに己たちを照してゐるか見たがよい』とかう云つた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもセムボビチスは星を見なかつた。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            },
            {
              "text": "王の傍には身をひれ伏して、セムボビチスとメンケラとが面を石につけて礼拝してゐる。",
              "citation": {
                "source": "バルタザアル",
                "author": "BALTHASAR",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
