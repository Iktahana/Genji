        "examples": {
          "standard": [
            {
              "text": "その独裁政権は反政府的な言論に対して露骨な政治抑圧を行っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "歴史学者たちは過去の政治抑圧の実態を記録に留め、後世に伝えようとしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "政治抑圧から逃れるため、亡命者たちは国外への脱出を余儀なくされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その証明として、今度の第二次世界大戦に参加した日本の非道な軍事強行が進むにつれ、他ならぬこの純芸術性の擁護者であった中村武羅夫が先頭の一人となって、急速に、徹底的に日本の旧文学を、軍事暴力の政治抑圧に屈伏させた。",
              "citation": {
                "source": "生活においての統一",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
