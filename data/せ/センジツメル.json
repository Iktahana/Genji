        "examples": {
          "standard": [
            {
              "text": "議論を煎じ詰めた結果、革新的な解決策が見つかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の提案は、多くの時間をかけて煎じ詰められたものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "複雑な問題を、一歩一歩煎じ詰めていくことで理解を深めた。",
              "citation": {
