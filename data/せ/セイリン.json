        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "况んや星林の兩氏の如きは、共に材幹手腕ある一廉の人物にして、若し之れを善用すれば、相應の治績を擧げ得可き望みあるに於てをや。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "况んや星林の両氏の如きは、共に材幹手腕ある一廉の人物にして、若し之れを善用すれば、相応の治績を挙げ得可き望みあるに於てをや。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            }
