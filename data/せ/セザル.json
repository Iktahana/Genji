        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "全日本國民ハ心ヲ冷カニシテ天ノ賞罰斯クノ如ク異ナル所以ノ根本ヨリ考察シテ、如何ニ大日本帝國ヲ改造スベキカノ大本ヲ確立シ、擧國一人ノ非議ナキ國論ヲ定メ、全日本國民ノ大同團結ヲ以テ終ニ天皇大權ノ發動ヲ奏請シ、天皇ヲ奉ジテ速カニ國家改造ノ根基ヲ完ウセザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ歴史ト現代トヲ理解セザル頑迷圃體論者ト歐米崇拜者トノ爭鬪ハ實ニ非常ナル不祥ヲ天皇ト國民トノ間ニ爆發セシムル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私有財産ヲ尊重セザル社會主義ハ、如何ナル議論ヲ長論大著ニ構成スルニセヨ、要スルニ原始的共産時代ノ回顧ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ皇室下附ノ土地及私有地限度超過者ヨリ納付シタル土地ヲ分割シテ土地ヲ有セザル農業者ニ給付シ、年賦金ヲ以テ其所有タラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱心ナル音樂家ガ借用ノ樂器ニテ滿足セザル如ク、勤勉ナル農夫ハ借用地ヲ耕シテ其勤勉ヲ持續シ得ル者ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "都市ト限リテ町村住宅地ヲ除外セル所以ハ、公有トスベキ理由ガ町村ノ程度ニ於テハ完成セザルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ日本ニ於テハ國民生活ノ基礎タル土地ノ國際的分配ニ於テ將來大領土ヲ取得セザルベカラザル運命ニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ事業ガ未ダ私人生産業限度ノ資本ニ達セザル時ト雖モ、其ノ性質上大資本ヲ利トシ又國家經營ヲ合理ナリト認ムル時ハ、國家ニ申達シ双方協議ノ上國家ノ經營ニ移スコトヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "經濟界ノ好況ヲ却テ反對ニ國民生活ノ憂患トスル現下ノ大矛盾ハ一ニ國家ガ「金權」ヲ有セザルニ基ク。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸上ノ鐵道ナルガ故ニ山間僻村ノ支線ヲモ國有トシ、海上ノ鐵道ナルガ故ニ全世界ニ通ズル幹線ヲモ民有トスベシトハ道理ニ合セザルモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ又生産方針ニ干與スルノ權ハ國家全局ノ生産成績ヲ達觀シ得ベキ衆議院ニ於テセザルベカラザル所以トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ノ使命的勞働ヲ廢セシメテ全ク天性ニ合セザル勞働ヲ課スルハ、啻ニ婦人其者ヲ殘賊スルノミナラズ、直ニ其ノ夫ヲ殘賊シ其子女ヲ殘賊スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ夫ト子女ト婦人其者トノ爲ニ其ノ義務ヲ完ウセザル可ラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母共ニナキ兒童ヲ孤兒院ニ收容セザル所以ハ、孤兒院ノ弊害甚ダシキト、兒童ノ保護者トシテ血族長者ノ保護ニ優ル者ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ理由ハ其ノ中食ニ一塊ノ「パン」薩摩芋麥ノ握飯等ノ簡單ナル粗食ヲナサシメ、以テ滋養價値等ヲ云々シテ眞ノ生活ヲ悟得セザル科學的迷信ヲ打破スルニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由ハ自由ノ侵害者ヲ拘束セザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現行法律ガ買淫婦人ヲノミ罰シテ買淫男子ヲ罰セザルハ姦通罪ガ婦人ヲノミ罰シテ男子ニ及バザルト等シキ片務的横暴ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "拘留罰金ヲ以テセルハ婦ノ訴ナキ場合ニ於テ姦通罪ヲ檢擧セザル原則ニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ之レヲ罰セザル理由ハ、未婚婦人ガ純潔ヲ破ルモ法律ノ干與セザルト等シク道徳的制裁ノ範圍ニ屬スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "未決監ニアル刑事被告ノ人權ヲ損傷セザル制度ヲ定ムベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ政治ニ干與セザル原則ニヨリテ審議院議員ノ互選資格ヲ除ク。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義共産主義ヲ誤解シテ其ノ私有財産ヲ分與スルモノナルカノ如ク考ヘ、又ハ國民ノ凡テニ其日暮シ其年碁シノ生活ヲナサシムル者ト考フルガ如キハ、現實的改造ノ要求セラレツツアル現代社會革命説ノ躍進的進歩ヲ解セザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "年々多大ノ收益アリテ近ク私産限度ヲ超過スベク而シテ超過額ヲ國家ニ納付スルヲ欲セザル目的ヲ以テ、限度以下ノ時ニ於テ、自己自身ノ欲望ニ從ヒテ消費セントスルハ亦國民ノ權利ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ其ノ消費セル所ヲ收得スル者ハ國家ノ手ヲ經由セザル國民ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私産限度制ハ國家ト國民ヲ害セザル程度ノ富ノ限度ヲ定ムル者ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特定ノ意志ヲ表示セザル限リ、父ノ遺産ハ其ノ子女ニ平等ナル分配ヲ以テ相續セラル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ハ講和會議ニ於テ其ノ獨立ヲ承認セザルノミナラズ明ニ其ノ領有ヲ主張スベキハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ガ日本ノ西海道ナル所以ヲ明ニスルトキ百般ノ施設悉ク日鮮人ノ融合統一ヲ來サザル者ナク、獨立問題ノ如キ希フト雖モ生起セザルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國際間ニ於ケル民族ノ老幼ヲモ壓迫シ虐遇セザルベキ人道主義ガ則チ民族主義ノ終局理想タルベキ者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
