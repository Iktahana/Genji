[
  {
    "uuid": "931daa31-e3ec-5276-ba12-502ac2921eee",
    "entry": "正出",
    "reading": {
      "primary": "せいしゅつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "legitimate child",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「歴史ドラマでは、正出の長男と側室の子との間で家督争いが描かれることが多い。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「かつての貴族社会では、正出であるかどうかが社会的地位を大きく左右した。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「彼は正出の嫡子として大切に育てられ、厳格な帝王学を叩き込まれた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "どうしたらこの状態を正常の位置まで匡正出来るでしょうか。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "村のもの全體が更正出來る道を知りたいと思つた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "入学試験の弊害位は制度の改革によって矯正出来そうに想像されるかも知れないが、夫が決してそうではない。",
              "citation": {
                "source": "学生の技能と勤労大衆",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分でもこの気持ちや生活を排斥していながら、死にでもしなければ改正出来そうもないありさまに呆れている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで彼らは言葉を尽して夫人にその校正出版の事を勧めた。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし反動が恐しいの、騒動が大きくなるのと姑息な事を云つた日には此弊風はいつ矯正出来るか知れません。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし反動が恐しいの、騒動が大きくなるのと姑息な事を云った日にはこの弊風はいつ矯正出来るか知れません。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "○二十日頃増版出来る由〔欄外に〕多賀ちゃん面会十月五日　十日、『日本評論』「朝の風」四十一枚〔欄外に〕六十八信十月十二日　河出の本の校正出る。",
              "citation": {
                "source": "日記",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の根本的生活に対する責任の感情は正出といふ俗論に依て弱められ、子供の養育に対する責任の感情は私生といふ俗見に依て又弱められる。",
              "citation": {
                "source": "恋愛と道徳",
                "author": "エレン・ケイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "分り切ってると思う方は、科学普及書の改善によってあるいは是正出来るかもしれない。",
              "citation": {
                "source": "『西遊記』の夢",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれは長い月日には自分の指導によって矯正出来ると清之介君は高を括っていた。",
              "citation": {
                "source": "女婿",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "入学試験の弊害位いは制度の改革によって矯正出来そうに想像されるかも知れないが、夫が決してそうではない。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うのは、単にそのやり方が都合のよい法律の施行を前提するという意味で（改正出版法、新聞紙法、治安維持法、不穏文書取締法、治安警察法、其の他）合法的であると云うだけではなく、その取締りと同時に世間の常識を牽制することを忘れず、又世間の一般常識に多少でもアッピールすることを忘れないからである。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校教育行政組織やそれと裏表にあざなわれている師範教育の根本特色を訂正しない限り、先生方の「人格」も訂正出来ない。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "中公の年表の校正出たら一息で、さち子さんが校正見ていてくれます、これはうれしかったわね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "病癖については士君子の口にし難いところとして明言を避けたが、自分の力で矯正出来るから御安心下さるようにと繰り返して主張した。",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "数正出奔の件も、まあ、これくらいな気まずさですめば」「いや、実はまだ、大事な件が、一つ残っておりましてな。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
