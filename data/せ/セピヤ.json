          "standard": [],
          "literary": [
            {
              "text": "セピヤ色の水分をもって飽和したる空気の中にぼんやり立って眺めている。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ブリュー・ブラックの性来｜嫌な余は、わざわざセピヤ色の墨を買って来て、遠慮なくペリカンの口を割って呑ました。",
              "citation": {
                "source": "余と万年筆",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸にして余の原稿が夫程の手数が省けたとて早く出来上る性質のものでもなし、又ペンにすれば余の好むセピヤ色で自由に原稿紙を彩どる事が出来るので、まあ「彼岸過迄」の完結迄はペンで押し通す積でいたが、其決心の底には何うしても多少の負惜しみが籠っていた様である。",
              "citation": {
                "source": "余と万年筆",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう秋ですね、浜の方は靄でセピヤ色になつた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう秋ですね、浜の方は靄でセピヤ色になった。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "深い碧りの上へ薄いセピヤを流した空のなかに、はっきりせぬ鳶が一羽舞っている。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "親爺はセピヤ色に汚れた口から脂臭い息を遠慮なく隆造の、少し汗をかいてゐる鼻先で呼吸した。",
              "citation": {
                "source": "白明",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術写真とでもいふのであらうか、本の上に肘を突いた大学生が上目をつかつてゐるセピヤ色のプロフイルが額に収つてゐた。",
              "citation": {
                "source": "街角",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "見渡す限りセピヤ色の砂丘が連続し、蘇西の市街や運河の其処此処にある信号所の附近を除いては全く一草一木も生えて居ない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "筵を剥ぐと、五十五六の立派な體格で、顏はセピヤ色に焦けて居りますが、眼鼻立も見事、小鼻の脇の黒子が妙に氣になります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "眞珠太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "硬きに過ぎず、軟きにすぎず、中庸を得て、それが適当な長さを保ち、密度こまやかにセピヤの色調おつとりとしぶい美観を呈し、時にはややうぐひす色を帯びたものなどもよろしく、必ずしも黄金色でなくてもよい。",
              "citation": {
                "source": "黄金綺譚",
                "author": "潔癖の人必ず読むべからず",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
