          "literary": [
            {
              "text": "昨夜医者へ先生と奥様がいらしった時、私もイセレマクシする為に赤ちゃんと一しょにお供致しました。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔へばはしゃいで、知らぬ人々と話し、十二時近く、セレマゝと共に、すし清へ寄り、こはだ、卵を何個かやり、タクシー帰宅、一時か。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
