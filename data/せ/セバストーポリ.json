        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "このクリミヤ戦争にはトルストイが一士官としてロシヤ軍に加わっており、セバストーポリについた第一歩に負傷者の哀れな有様に激しく心を動かされたのが、この同じ年の十二月であったことも思い出される。",
              "citation": {
                "source": "フロレンス・ナイチンゲールの生涯",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤルタから、セバストーポリまでは、黒海の海岸ぞいのドライヴ・ウエイで、その眺望は極めて印象に強く残ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "セバストーポリの町に入る手前に街道が急カーヴしている処があって、其処に一つ大理石のアーチが立っています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤルタの方から来るとそのアーチは、まるで天の門のように青空をくぎって立って居り、其処をくぐってセバストーポリの古戦場の曠野の方からそっちをふり返ると、同じように道は見えず、四角いアーチが空に立っていて、その感じは実に独特でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "セバストーポリもヴェルダンも遠い彼方に山々が連って、まわりは広茫とした平野で、新市街はずっとその先にあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "セバストーポリの塹壕の中でトルストイは幼年時代を書いたし、カロッサにしろアランにしろ塹壕生活の時期を泥にまびれただけではすごして居りません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "・アルプカよりセバストーポリまで自動車（三時間）は急に陸におれこんで。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "セバストーポリは人気がわるい。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "八時三十分セバストーポリ発、ハリコフに向う。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "セバストーポリは海と山との複雑な、山は荒々しく、樹のない、反射光線のつよい街だ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "・セバストーポリの旧戦場をぬける。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "セバストーポリ附近、あの海から急に野にまがるアーチのある道の感情。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "特にフランスへ帰ろうとしていたセバストーポリの宿で、ジイドは、彼の親愛な若い友人ウージェヌ・ダビを、猩紅熱で失った。",
              "citation": {
                "source": "ジイドとそのソヴェト旅行記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十四歳になったとき、既に「幼年時代」「地主の朝」「コサック」「少年時代」「セバストーポリ」「三つの死」「結婚の幸福」の作者であったトルストイは、三年の間心に思いつづけて求婚する決心のつかなかったソフィヤと遂に結婚した。",
              "citation": {
                "source": "ジャンの物語",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
