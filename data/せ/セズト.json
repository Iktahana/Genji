        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一百萬圓以上ノ富ハ國有タルベキガ故ニ、工夫ハ多クノ賃金ヲ要セズ商家ハ廣キ買客ヲ欲セズト思考スル者ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "少シモ頭腦ノ思慮ニ關セズト言フニハ非レドモ、思慮ノ專ラ頭腦ニ關スルトハ自ラ別ナリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾テ都下狭斜ノ巷ニ在テ左褄ヲ取リシモノ亦無シトセズト。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生射ヲ善クシ、四矢反セズトイヘドモイマダカツテ※ヲ出デズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔宅ハ三遷セズトイヘドモ孟母ノゴトク賢ナリ〕と言うを見ればこの年益斎の母はなお健在であったと思われる。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "門生田中は凡例の一に、「此篇ハ朝夕講習ノ餘話ヲ集録ス故ニ往々錯雜ヲ免レズ其説多クハ一千八百五十二年我嘉永五年撰スル所ノ和蘭人フアン・デン・ベルグ氏ノ「理學原始」ヨリ出ヅ直寫影鏡ハ數年前吾師既ニコレヲ實驗シ蒸汽船ハ本藩已ニコレヲ模製ス他ノ諸器ハ未歴驗セズト雖其理亦疑フベキコトナシ」と書いてゐる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲夏五月ニアラザレバ宿雪消尽セズト云フ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
