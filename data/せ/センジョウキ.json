        "examples": {
          "standard": [
            {
              "text": "この最新式の野菜洗浄器は、泥や農薬を徹底的に洗い流してくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この洗浄器で食器を磨くと傷がつきにくい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医療現場では専用の洗浄器で器具を消毒する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "途端に私は、巨大な「洗浄器」を錯覚して、よろよろッとその低い白く塗られた垣に靠れてしまった。",
              "citation": {
                "source": "腐った蜉蝣",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はカテーテル使用、顔の形成外科手術、胸壁の膿瘻治療のための肋骨切断、白内障手術、洗浄器を使って治癒できる耳の病気、および甲状腺腫の手術、を記載している。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
