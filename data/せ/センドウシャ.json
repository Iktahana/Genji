  {
    "uuid": "ab13b016-8e42-5839-b866-cf74fc679263",
    "entry": "扇動者",
    "reading": {
      "primary": "せんどうしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
