        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は生来の視覚障害があるため、盲導犬と生活している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その犬は生来の病気で、獣医の治療を受けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は生来の才能に恵まれ、幼い頃から音楽の道に進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
