[
  {
    "uuid": "e2d66d3b-641c-5b4f-b0a7-2df5959e2b90",
    "entry": "切願",
    "reading": {
      "primary": "せつがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
