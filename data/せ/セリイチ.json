        "examples": {
          "standard": [
            {
              "text": "卸売市場の競り市（せりいち）では、毎朝新鮮な魚介類が取引される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この農産物専門の競り市（せりいち）は、地元で高く評価されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "競り市（せりいち）の独特の活気は、訪れる人々に活気を与えてくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "反歌青銭の穴あき銭をかなしよと父のみ前に貫きて数へつ魚市魚市は師走の市、歳のすゑ、大つごもり前の三日、雪よ霰ふる中を、塩鰤や、我が家の市、競り市や、魚市場、戦や、船に馬に大八車、わさりこ、えいやえいや、かららよ、えいやえいや、人だかりわらわら、はいよ、天秤、担棒、走る走る、えや肩掻きわけて。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
