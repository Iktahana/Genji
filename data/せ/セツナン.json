          "literary": [
            {
              "text": "入口の石の鳥居の左に、就中暗く聳えた杉の下に、形はつい通りでありますが、雪難之碑と刻んだ、一｜基の石碑が見えました。",
              "citation": {
                "source": "雪靈記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪難之碑のある處――　天狗――魔の手など意識しましたのは、其の樹のせゐかも知れません。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――七｜年前――　雪難之碑は其の記念ださうであります。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口の石の鳥居の左に、とりわけ暗く聳えた杉の下に、形はつい通りでありますが、雪難之碑と刻んだ、一基の石碑が見えました。",
              "citation": {
                "source": "雪霊記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪難之碑のある処――　天狗――魔の手など意識しましたのは、その樹のせいかも知れません。",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――七年｜前――　雪難之碑はその記念だそうであります。",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
