        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は天国へも昇れば、シルレルのところへお客にも行く――ところがまるで霹靂のように、こうした致命的な言葉が突然、彼の頭上で鳴り渡ると共に、彼はやはり自分が地上にあって、それも＊３センナヤの広場か、酒場の近くに佇んでいるのに気がつく、そして又もや味気ない日常生活が彼の面前にそそり立つのである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊３　センナヤ　ロシアの大抵の市にある特殊な一角。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ああ、センナヤ広場でね。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "七年ばかり経ったら、いよいよセンナヤ広場の穴蔵まで行きついてしまうわけさ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、きみはどこかほかの家へ住み替えるが、やがて第三の家へ移り、更にまたどこかへ転々して、最後にはセンナヤ広場に転落するだろう。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの暮らしは、雑巾のようにくたくたに使われて、センナヤ広場の居酒屋で、酒といっしょに呑まれてしまったのです。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
