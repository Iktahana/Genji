        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二　その日の音楽会は、露西亜のピアニスト若きセザレウ※ッチ兄妹の独奏会だつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザレウッチの何処か東洋的な、日本人向きの美貌が、兄妹の天才的な演奏と共に、楽壇の人気を浚つてゐた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度、その時に兄のニコライ・セザレウ※ッチが壇上に姿を現した。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　丁度その時、兄のセザレウ※ッチの奏き初めた曲は、ショパンの前奏曲だつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が、軽い駭きを感じて、見上げると、階段の中途を静に降りかかつてゐるのは、今日の花形なるアンナ・セザレウ※ッチと瑠璃子夫人とだつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処で、後から来た兄のセザレウ※ッチを待ち合はすと、兄妹が自動車に乗つてしまふ迄、主催者の貴婦人達と一緒に見送つてゐた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　その日の音楽会は、露西亜のピアニスト若きセザレヴィッチ兄妹の独奏会だった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "セザレヴィッチ兄妹もやっぱり、漂泊の旅の寂しさを、背負っている人だった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、妹のアンナ・セザレヴィッチの何処か東洋的な、日本人向きの美貌が、兄妹の天才的な演奏と共に、楽壇の人気を唆っていた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度、その時に兄のニコライ・セザレヴィッチが壇上に姿を現した。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　丁度その時、兄のセザレヴィッチの奏き初めた曲は、ショパンの前奏曲だった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が、軽い駭きを感じて、見上げると、階段の中途を静に降りかかっているのは、今日の花形なるアンナ・セザレヴィッチと瑠璃子夫人とだった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処で、後から来た兄のセザレヴィッチを待ち合わすと、兄妹が自動車に乗ってしまう迄、主催者の貴婦人達と一緒に見送っていた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ニ禮式作用ガ必須課目ナラバ男子ニモ男子ノ其レガ然ルベク、茶ノ湯生花ガ然ルナラバ男子ニ謠曲ヲ課セザレバ不可。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ分配ヨリモ國際間ノ分配ヲ決セザレバ日本ノ社會問題ハ永遠無窮ニ解決サレザルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（８）原文ニハ「自云」トノミアリテ、何人ノ言タルヲ明言セザレドモ、家ノ主人ノ語ト見ルベキヲ以テ「あるじ」ヲ加ヘタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀行の法律顧問を勤めている弁護士のセザレ・アルバラードを呼んで、もう一度とっくりと、ベナビデスに対する報復の手段を相談してみようかと考えたからであった。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、本遺言状は余の銀行の顧問弁護士たるセザレ・アルバラード氏において、余の死後即時効力を発生せしむるよう法律上の手続きを踏んでもらいたい。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場合は顧問弁護士セザレ・アルバラード氏においてはマジャルドー氏らと力を協せ、極力法廷に係争して余のために最善を尽し、決して彼らの手に一物たりとも渡らぬよう余は特にこの点をアルバラード氏に依頼しておきたい。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、セザレ・アルバラード氏が顧問弁護士たると否とにかかわらず、同氏存命の限りバルセローナ銀行は尠なくとも年額三十万ペセタ以上の金額を終身年金として同氏に贈与せられたい。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九四五年四月二十一日サンタルシアが丘別荘においてロドリゲス・アレサンドロ　認め終ってからこれを厳重な二重封筒に入れて私は弁護士セザレ・アルバラードの宛名を書いた。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
