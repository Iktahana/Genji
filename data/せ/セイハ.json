    },
    "definitions": [
      {
        "index": 1,
        "gloss": "conquest",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "織田信長は天下制覇を目指して、次々と近隣の諸大名を撃破していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "人類はついに、エベレストの全ルートを制覇することに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は若くしてビジネス界を制覇し、今や世界的な大富豪として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その市場独占の経過をたっぷり見てきた後で再刊するのなら、せめて長めの後書きを用意して、ＰＣ―９８０１が市場を制覇する、その後の流れにも触れておきたい。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九八〇年代、日本の市場を制覇した日本電気の歩みは、こうした事情を雄弁に物語っている。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで世界を制覇してきた産業分野で、米企業がまず最初に競争に直面するのは、低価格帯製品と海外市場においてであると師匠は語る。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これをきっかけに日本電気はクローズに大きく傾き、日本のパーソナルコンピューター市場を制覇した。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "金融資本制覇の一つの過程だな。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくしてムツソリーニに始められた全体主義は、ヒトラーによつてより巧みに利用され、日本等またこれに從つて國力の飛躍的發展をはかり、遂にデモクラシーによつて順調に進んでいる富裕なる先進國の支配力を破壞して世界制覇を志したのが、今次の大破局をもたらしたのである。",
              "citation": {
                "source": "新日本の進路",
                "author": "石原莞爾將軍の遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、帝国主義の物狂おしい世界制覇の欲望に抗し、世界人民の平和と民族の独立を守らなければならないということです。",
              "citation": {
                "source": "国際婦人デーへのメッセージ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば仏教の一派であって、もっとも侵略的な闘争主義を精神の中にもっている日蓮宗は、戦争中まっさきに超国家主義と日本の世界制覇を激励した。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして丁度二、〇〇〇年を迎えて、敢然立って、太青洋の制覇と、イネ帝国再建の戦を起したというわけだった。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "イネ帝国の再建、そして太青洋の制覇は、もう目前に追っているのだ。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "オランダの東印度会社設立は一六〇二年のことで、ポルトガル、イスパニヤの勢力を駆逐して東洋貿易制覇の野心に燃えてゐたから、その仇敵たる国々を陥れるためには、卑劣な手段も択ばなかつた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでに書かれた空想科学小説などに、原子爆弾の発明に成功した国が世界を制覇するであろうと書かれているが、まさに今日、そのような夢物語が登場しつつあるのである。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧米の国力は殆ど世界を制覇していたので、今日まで彼等の美は即ち世界の美となった。",
              "citation": {
                "source": "美の日本的源泉",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここがわからなければ米英の名において描かれる世界制覇の筋書も背景もわかるはずがない。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして更にロシヤの極東制覇を溯つてゆくならば、アラスカ經營、カムチヤツカ統治、沿海州のモンゴリヤ人種打倒と、ヨアン四世がはじめてヴオルガ河を渡つて東漸しはじめた一五三〇年に至る二百餘年の歳月があつた。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイゼルの世界制覇の犠牲者というところか。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがきっかけとなって、北条早雲の関東制覇の仕事が始まったのである。",
              "citation": {
                "source": "埋もれた日本",
                "author": "――キリシタン渡来文化前後における日本の思想的情況――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　産業合理化はドイツの国内に進んでいるばかりでなく、製鋼その他は国際カルテルにまでひろがっているということを、津山進治郎は「新興ドイツ」の制覇として話すのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐竜をやっつけて絶世の美女アリアドネ姫を三人の魔女から救い出し、宇宙制覇に乗り出しましょう。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "スーパーテセウスの使命は宇宙を制覇して大魔王ミノスを倒すことです。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アテネはアトランティス帝国と国名を変え、地球制覇に乗り出す。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして両者は宇宙制覇のロマンを賭けて、今最後の決戦に臨もうとしている。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「恐竜をやっつけて絶世の美女アリアドネ姫を三人の魔女から救い出し、宇宙制覇に乗り出しましょう。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "インド洋制覇地図四　インド洋制海権の争奪　がこの貫徹は同時に新しい海の企業の出発であった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "松永久秀と篠原長房とのいずれが勝つかは、――況んやこの二人のいずれもが制覇に成功しないであろうなどとは、当時何人にも解らなかったのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗麟の北九州制覇が都合よく進み、毛利の軍勢を北九州から追い払ったのは、一五六九年の夏から秋へかけて半年に亘る大仕事であったが、この際逸早く山口の教会の回復を思ったのは、トルレスであった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして安政六年には横浜その他の貿易港が開かれ、神奈川在の一寒村横浜は彼らの商業的制覇のもっとも有力な基地として繁栄したのです。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に――　この計画は数年来のものであり、今川家の軍備も内政も、あらゆる施設の方向は、義元の上洛と天下制覇の目標にあったのである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは戦術よりも外交、小局の快勝よりも、大局の制覇を――手のろくても、望んでいる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ねえお父さん、お互にまんざら覚えのないことでもないしさ」　おせいはこんなことをいわれるのを聞いていると、とてもこの話は承諾はできないと思った。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "winning (a championship)",
