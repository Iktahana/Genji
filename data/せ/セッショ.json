        "examples": {
          "standard": [
            {
              "text": "お恥ずかしいのですが、私の拙書が重版されることになり、驚きを隠せません。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "以前お話しした拙書をお持ちしました。お時間のあるときにご一読いただければ幸いです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "専門家から見れば拙書に過ぎませんが、一般の方向けに入門書として執筆いたしました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "男Ｂ　せっしょうだなあ。",
              "citation": {
