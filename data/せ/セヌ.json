        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人モ家モ、暗イウチハマダ滅亡セヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホカニ功徳ハアリマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」無理カモ知レマセヌガ　とまた、うつむいて、低く呟くやうにおつしやつて、ソレダケガ生キル道デス　尼御台さまは、すつと細い頸をお伸ばしになり素早くあたりを見廻しました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子孫ハ、ドコニモ居リマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」タツタ一年ノオ留守番モデキヌヤウデハ、重臣ノ甲斐ガアリマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　無理カモ知レマセヌガ　とまた、うつむいて、低く呟くようにおっしゃって、　ソレダケガ生キル道デス",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ときディオニシアスは、フィロセヌスという学者が、自分の作った詩をけなしていると聞いて、大層｜怒って、すぐにつかまえて牢屋へ入れました。",
              "citation": {
                "source": "デイモンとピシアス",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自分では、こんな立派な詩はちょっとだれにも作れまいと大得意になって、早速フィロセヌスを牢屋からよび出して見せつけました。",
              "citation": {
                "source": "デイモンとピシアス",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィロセヌスがその詩を読んでしまいますと、ディオニシアスは、どうだ、それでもまだ悪いというか、と言わぬばかりに、相手の顔を見下しました。",
              "citation": {
                "source": "デイモンとピシアス",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとフィロセヌスは、何にも言わずに、くるりと獄卒の方を向いて、「おい、もう一度牢屋へ入れてくれ。",
              "citation": {
                "source": "デイモンとピシアス",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、政事ノ自由ト云ヘバ、其国ノ住人ヘ、天道自然ノ通義ヲ行ハシメテ、邪魔ヲセヌコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、政事ノ自由ト云ヘバ、其国ノ住人ヘ、天道自然ノ通義下ニ詳ナリヲ行ハシメテ、邪魔ヲセヌコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "身体ハ押エラレテ動ケマセヌ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論逃ゲルヒマハアリマセヌ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ大変大キナ声デアリマシタカラ、聞キマチガイハアリマセヌ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "南はチセヌプリ、イワタヌシの山岳に圍まれ、その後方に、コトニプリ、オサツペヌプリ、サマツケヌプリの山々が流れてゐる。",
              "citation": {
                "source": "摩周湖紀行",
                "author": "――北海道の旅より――",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月三十日　日　第三日はかくの如くしてボシャル、一般報告草案も討ギ採択セヌママ。",
              "citation": {
                "source": "日記",
                "author": "一九五〇年（昭和二十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダタイインセヌカ、ワイチローケツコン三カツ一四ヒ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、他人ヲ挑発スルガ如キ華美ナル服装ヲ慎ミ、歩行中、嬌声ヲ発シ、マタ進駐軍ニ笑顔ヲ見セヌヤウニスルコト。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "アゴラ（アテネの要塞）はディドローを監禁するであろうが、それと同じくヴァンセヌの要塞はソクラテスをつかみ取るであろう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "モデルニスル颯子ニモ、浄吉ニモ、婆サンニモ、誰ヲモデルニシテイルカヲ悟ラセヌヨウニスルコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "４番目はタカの頭のケベフセヌエフで、肝臓と胆嚢が入っている）。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
