        "examples": {
          "standard": [
            {
              "text": "紛争は新たな戦域に拡大した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "司令部は戦域全体の地図を前に、各部隊の配置と進軍ルートを検討した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "戦域に投入された医療チームは前線近くに野戦病院を設営し、負傷兵の治療にあたった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "今次の戦域は前のそれに比べて東西両域にわたり、激闘の程度も比較にならぬ程ひどい。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "はつきり云へば、サイパンの喪失は疑ひもなく戦局の一大危機を意味するであらうけれども、また、それは、大東亜全戦域の態勢からみれば、明らかに一局部の戦闘消息であり、しかも、国民の知り得る範囲を超えた軍事的秘策善謀の一環のなかで、如何なる役割を果しつつあつたかを静かに思ひめぐらすべきである。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
