        "examples": {
          "standard": [
            {
              "text": "壁の仕上げに石灰乳を塗布した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "石灰乳は防水性と耐久性を提供する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "昔の民家では石灰乳が一般的な塗料だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "温室の温度と日光を弱めるために、わざわざ石灰乳をガラスのフレームにぬった温床の下で、フクシアやきょうちくとうがさきかけていた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一階も二階もすべての室はみな、ことごとく石灰乳で白く塗ってあった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ今では、石灰乳で白くぬられた古い壁紙の私どもの二つの室は、お宅のようなりっぱなお住居にも比べて恥ずかしからぬほどになりました。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "石灰乳で洗われた四つの壁、祭壇と向かい合った扉、二つの小さな弓形の窓、扉の上の大きな木製の十字架像、十字架像の上にある一束の乾草でふさいである四角な風窓、片すみの床に落ちてるまったくこわれたガラス付きの古い額縁、まずそんなありさまを礼拝堂は呈している。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
