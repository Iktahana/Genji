[
  {
    "uuid": "4a868b63-6b76-54a3-84a5-39d45d224ecb",
    "entry": "切磋",
    "reading": {
      "primary": "せっさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
