    },
    "definitions": [
      {
        "index": 1,
        "gloss": "working hard",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はライバルたちと切磋琢磨し、ついに念願の全国大会出場を果たした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "同じ夢を持つ仲間との切磋は、自分を成長させるための最高の刺激になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "厳しい環境の中で互いに切磋することで、新しいアイディアが生まれてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "次第次第に濃い嘘を吐いていって、切磋琢磨され、ようやく真実の光を放つ。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "己は詩によつて名を成さうと思ひながら、進んで師に就いたり、求めて詩友と交つて切磋琢磨に努めたりすることをしなかつた。",
              "citation": {
                "source": "山月記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "己は詩によって名を成そうと思いながら、進んで師に就いたり、求めて詩友と交って切磋琢磨に努めたりすることをしなかった。",
              "citation": {
                "source": "山月記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもなお、講誦を止めず切磋を怠らず、孔子と弟子達とは倦まずに国々への旅を続けた。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "弱冠ニシテ至芸、切磋一家ヲ成ス。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鄭玄（中国、後漢の儒学者・訓詁学者）は云う、「同門の者を朋と云い、志を同じくする者を友と云う」と、師を同じくして教えを受け、願いを同じくして術芸を習い、道を同じくして学問に従い、志を同じくして徳の向上に努める、このような環境において人は自然と朋友助け合い、切磋琢磨して次第に成長を遂げる。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "朋友切磋琢磨して、術芸は日々に進み、徳は日々に成ろうとする。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "学問思弁の道に切磋琢磨の努力を重ねるのが聖学の建前である。",
              "citation": {
                "source": "一貫章義（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私が心の中に描いている理想的な演出、もしくは完成されつくした演技指導の型といったようなものの特色は、著しく静かでほとんど無為に似た形式をとりながら、その実、当事者間には激しい精神の交渉、切磋、琢磨がつづけられ、無言のうちに指導効果が刻々上昇して行くといった形において想像される。",
              "citation": {
                "source": "演技指導論草案",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "川端康成氏は、今日の文壇で、自身としての芸術的境地を守ること、切磋琢磨することのきびしい作家の一人として一部の尊敬を得ているのであるが、今月の「父母」（改造）の最後の章の効果を、作者自身は何と見るであろうか。",
              "citation": {
                "source": "十月の文芸時評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが日本の文明も、そのはじめは朝鮮・支那より来たり、爾来わが国人の力にて切磋琢磨、もって近世の有様に至り、洋学のごときはその源遠く宝暦年間にあり〔『蘭学事始』という版本を見るべし〕。",
              "citation": {
                "source": "学問のすすめ",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "若殿様はこの少納言の御手許で、長らく切磋琢磨の功を御積みになりましたが、さてその大食調入食調の伝授を御望みになりますと、少納言はどう思召したのか、この仰せばかりは御聞き入れになりません。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが何よりのご恩返しだ」　それからの彼と云うものは、武事に文事に切磋琢磨し、事ごとに他人の眼を驚かせた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに、共通の「夢」をもち、共通の生活環境にある同僚友人との間に、絶えざる切磋琢磨が行はれるといふことは、青年にとつて最も大きな結果をもたらすものです。",
              "citation": {
                "source": "青年の矜りと嗜み",
                "author": "――力としての文化　第四話",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの湯宿の一室にして、年少の日の圓朝が切磋琢磨の修業の上に自分自身を見出したことによって初めて私は、豁然と音立てて心の壁の崩れ落ちるものを感じた。",
              "citation": {
                "source": "小説　圓朝　あとがき",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他高杉に与うるの書、久坂に与うるの書の如き、互に切磋、砥※、感激、知己の意を寓するもの、一にして足らず。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "切磋琢磨はこの停まるところのない無限の道の合い言葉にほかならぬ。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何と云つても切磋琢磨は若い同士の間のことだ。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　それ以来、まる十年、奥山恩とその妻凜子との間には、切磋琢磨の甲斐あつて、一種の新日本語ができあがりつゝあつた。",
              "citation": {
                "source": "菜の花は赤い",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "切磋骨を刻むが如き努力の成果と、金剛不壊の真名古の信念は、こういう恍けた二つの現象によって、今やガラガラと音を立てて崩壊してしまったのである。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから日本の科学者は、僅少の寄付からでも、先ず切磋琢磨して世界民衆の大勢を支配する業績を挙げようじゃないか、というのだ。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、この国の科学界が金が少ないのでどうにも動きがとれないのなら、勿論、科学者の切磋琢磨や一意専心の努力も必要には違いない。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "」○　原文「如切如磋如琢如磨」は詩経（一八章參照）の衛風洪澳の篇に出ている句で、「切磋琢磨」という熟語はここから出ている。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしんば、男と同量の其をもっているにしろ、自由に切磋琢磨する機会を失っているうちに、その可能も萎縮して、境遇の範囲の形に従ってしまうのね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時代人というものの切磋琢磨的相互関係は残酷というくらいですね、同時代人は容易に自分たちの同時代の才能を承認しません、試しに試すのね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は芥川の長所は充分に認めた上でのことなのだし、また芸術上の友達と云ふものは歯に衣被せず感じたことを云ひ合つて切磋琢磨することは当然のことだと考へるので、忌憚なくどん／＼と何でも云つて除けると云ふ風があつた。",
              "citation": {
                "source": "芥川龍之介を憶ふ",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「見よ、善信をはじめ、この禅房の誰も彼も、御仏の胸にしっかり抱かるるまでには、みな切磋琢磨、幾十年の苦しみや迷いをしてここに至るものを、そちは、わずか一日のうちに、御仏の手から生れ変った嬰児のように誕生したではないか。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は京都聖護院の御内の修験者であるから、元より武人ではないが、また世間にありふれた凡庸な山伏とは異なって、羽黒山に籠っては七年の行を遂げ、妙見山に入っては十年の間、切磋琢磨の工夫を積んで、金剛杖と戒刀をもって天下無敵の玄妙を自得したのである。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、人は昔に変らぬ新九郎だが、兄重蔵の一死に迷夢を醒まして、江戸｜愛宕下の松平家を去ってここに三年、人知れぬ密林の切磋琢磨に剣の妙髄を工夫し、女滝男滝の水に打たれて禁慾苦行の難道に、いまほとんどその相貌さえ変り果て、昔の寮の御方を悩ませた、あの水々しい美男の面影はいずこにかある。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「咽喉渇いて仕様ねえがら、蜜柑買わせっさやったのに、飴玉など買って……ほして、その飴玉はやあ？",
              "citation": {
                "source": "蜜柑",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
