        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――アンナ、オオキイウチガ、オマエニ、コワセルモノカ、ウソツキ！",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ大西郷等革命精神ノ體現者世ヲ去ルト共ニ單ニ附隨的ニ行動シタル伊藤博文等ハ、進ミタル我ヲ解セズシテ後レタル彼等ノ貴族的中世的特權ノ殘存セルモノヲ模倣シテ輸入シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ一夫一婦制ノ勵行ハ彼ノ自由戀愛論ノ直譯革命家ト人生ノ理解ヲ根本ヨリ異ニセルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、随ッテソノ間ニ行ワルル犯罪ノ種類モ亦、唯物科学ノ原理ヲ応用セルモノ多カルベキハ自然ノ理ナリ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは錦糸、猿江、隅田、上野等の大小公園や、寺院境内、空地などに二、三千ずつ合葬　錦糸公園　　　一万二千九百三十五柱　深川猿江公園　一万二千七百九十柱　を筆頭に、合計七万八千八百五十七柱（姓名判明セルモノ、八千五十三柱）。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "多数町村ノ［破壊→頽廃］セルモノヲ恢復スル其五ナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド万巻ノ書貯ヘタランニハ之ヲ曝ス日数モ重ナリテ、樟脳買フ銭モ夥シケレド、余ハ戊辰ノ変ニ愛ヲ割キテ尽ク売却シタレバ、今ハ唯ダ祖考ノ親写セルモノト校訂セシモノ而已ゾ存セリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ教育アリ、訓練アリ、特ニ自治ノ能力ニ於テハ優レタル天分素質ヲ有セルモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、ソノ三ヶ月ノ間ニ、コノ一行ノ死セルモノ約半数ニ及ビタリ、一日ニ死スルモノ二三人、百二名ヲ以テ上陸シタル一行ハ三ヶ月ニシテ五十名ヲ余スノミ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時代ノ人民ハ「ゼウス」神ガとねりこノ木ヨリ造リ出ダセルモノニシテ、青銅ノ家ニ住ヒ、青銅ノ武器ヲ以テ爭鬪シ、青銅ノ農具ヲ以テ耕作セリト云フ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……師範學校ノ功用ハ既ニ東京ニ設立セルモノニ於テ、其實驗ヲ表セリ。",
              "citation": {
                "source": "黒板は何処から来たのか",
                "author": "小倉金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "多数町村ノ頽廃セルモノヲ恢復スル其五ナリ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トナレハ水死者ハ主家ノ金円ヲ多ク費消シ遺書ヲ残シテ家出セルモノナリシヲ知レハ也。",
              "citation": {
                "source": "陰獣",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
