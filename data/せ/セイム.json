  {
    "uuid": "7b337e97-22ad-5f40-b79d-64d6441ad851",
    "entry": "世務",
    "reading": {
      "primary": "せいむ",
      "alternatives": [
        "せむ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
