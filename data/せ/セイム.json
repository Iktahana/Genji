  {
    "uuid": "9be3af2e-abfb-51da-bbf5-668cb5e3a372",
    "entry": "政務",
    "reading": {
      "primary": "せいむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
