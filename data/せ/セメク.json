[
  {
    "uuid": "d1ac3e60-45b9-5cb5-8c20-2a02f5d2d3a1",
    "entry": "責め苦",
    "reading": {
      "primary": "せめく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
