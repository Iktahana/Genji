          "literary": [
            {
              "text": "日の暮には多加志の洗腸をした。",
              "citation": {
                "source": "子供の病気",
                "author": "――一游亭に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "多加志は洗腸されながら、まじまじ電燈の火を眺めていた。",
              "citation": {
                "source": "子供の病気",
                "author": "――一游亭に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗腸の液はしばらくすると、淡黒い粘液をさらい出した。",
              "citation": {
                "source": "子供の病気",
                "author": "――一游亭に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓさんはまた午前中に見え、ゆうべの洗腸を繰り返した。",
              "citation": {
                "source": "子供の病気",
                "author": "――一游亭に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓさんは日の暮にも洗腸をした。",
              "citation": {
                "source": "子供の病気",
                "author": "――一游亭に――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
