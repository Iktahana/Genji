[
  {
    "uuid": "078c017e-ceec-56fd-aa00-493812d37bed",
    "entry": "責付く",
    "reading": {
      "primary": "せっつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to pester someone (e.g. to buy something)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は、客に商品を買いさせようと、しつこく責せっつく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子どもは新しいおもちゃを買ってほしいと責付く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "父親は娘に毎日その件について責付かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "抗いがたい二千の意志が責付くのを感じ取れた。",
              "citation": {
                "source": "象を撃つ",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "お初がこんなにせっつく金をせびるには、子供の頃おっ母さんに欲しいものをおねだりした時の癖が出てきているのである。",
              "citation": {
                "source": "神楽坂",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、お高への嫉妬と反感から、いっそう若松屋惣七をせっつくことであろう。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあさっさとしろ、」とせっつくぼうし屋、「さもないと話が終わるより先にこいつまたねてしまうぞ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったくせっつけばせっつくほど、それはうろたえるばかりなのだ。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物の美しさに見惚れている間にもわたくしもわたくしのどこかの一部で、これは誰やらに、そしてどこやらが肖ていると頻りに思い当てることをせつくものがあった。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と少し押へた調子でせつくやうにいふ。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「早馬鎌倉へ馳せつくのさえ、相当日数がかかる筈じゃ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は女で、こせつくようにと女がするのだから可笑しい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ポポーフという男のくせだ）それは奇麗ずきで、目先をかえたがってこせつくことだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "関守氏は、目的地に着いたからといって、驀直に目的に向ってこせつくような軽策を取らない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大府卿と主殿とで己をせつくのだ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついこの間まで身の周りを包んでいてくれた青空が跡形もなく失せつくして、あべこべに漠々たる暗雲が十重二十重に、前後左右を追っ取り囲んできた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、あまりせつくと、かえって故意に遅らせるような傾向さえ見て取れるのである。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
