        "examples": {
          "standard": [
            {
              "text": "昔のコンピュータは、情報を穿孔カードに記録して読み込んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "貴重なデータが含まれる穿孔カードは、厳重に保管されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「まさか、今でも穿孔カードを使っているとは思いませんでしたよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ジャカードも自動ピアノも、カードにあけた穴の位置によって機械の動作を制御している点に着目したホレリスは、個人のデータを一人一枚同様の穿孔カードに記入することで、集計から手作業を追放できると考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
