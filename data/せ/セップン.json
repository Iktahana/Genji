    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「新婦は新郎にセップンしろ。",
              "citation": {
                "source": "花火",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めはきまりが悪かつたけど、だつて、さうですもの、こつちで何もあげないのに、あら、ほんとよ、セップンぐらゐさせてあげないといけないのかと思つちやつて、マッカになつちやつたんですもの」「あらまア、あのときは、それでマッカになつたのね」「えゝ、まア、そんなものなのよ」　タイタイ先生は心中おだやかでない。",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うれしいわ、先生」　顔をよせてさゝやいたと思ふとセップンした。",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "君はさつき大先生にセップンしたが、セップンも一つの方法としてはよろしいが、セップンそれ自体がエロサービスだといふ観念は浅薄通俗、大先生の学説以前のものだ。",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しない」「まア、うれしい」　マリマリ嬢は大先生にだきついてセップンした。",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "終戦以来、セップン映画というものを見て、彼女はキモをつぶし、にわかに歯をみがくことを覚えたが、もう、おそい。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦前の宝塚は女学校の表向きのタブーがそっくり演劇のタブーでもあって、セップンなどという言葉すら用いてはならないものであったらしい。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "宝塚女子占領軍――阪神の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "セップンという言葉も使うし、そのマネゴトも実演する。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "宝塚女子占領軍――阪神の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "セップンという言葉も使わないというようなことは、善でも美でもないですよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "宝塚女子占領軍――阪神の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
