        "examples": {
          "standard": [
            {
              "text": "法廷での争いは長引くばかりなので、政治的解決を模索する方が両者にとって得策だろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "国境問題の解決には軍事的な衝突を避け、あくまで政治的解決を優先すべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "水面下での交渉が進み、ようやく政治的解決の糸口が見えてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "いま、彼の企画にある最大な宿題として、密かに手をつけている問題は、　対本願寺との政治的解決　であった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
