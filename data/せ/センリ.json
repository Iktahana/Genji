[
  {
    "uuid": "6c09780e-ea86-50b1-8f09-d3a2c75f3889",
    "entry": "千里",
    "reading": {
      "primary": "せんり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
