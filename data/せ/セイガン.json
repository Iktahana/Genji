[
  {
    "uuid": "dd624a94-1434-5f2c-a797-a537244167ec",
    "entry": "正眼",
    "reading": {
      "primary": "せいがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "holding one's sword pointing towards the opponent's eyes (kendo stance)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "剣道の試合で、両者が正眼に構えたまま動かず、張り詰めた空気が漂った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "正眼の構えは攻守のバランスが最も優れており、基本中の基本とされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "竹刀を正眼に構え、相手のわずかな隙を見逃さないよう集中力を高める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "うつし身のつひに果てなん極みまで　　添ひゆくいのち正眼には見よ第三五課　家庭　私は紅山茶花を見るといつも思うのです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は子供らしく、一度ちょっとドアの蔭へ顔を引込ませ、今度改めてドアを公式に開けて入って来たときは、胸は昔のごとく張り、据り方にゆるぎのない頸つき、昔のように漂渺とした顔の唇には蜂蜜ほどの甘みのある片笑いで、やや尻下りの大きな眼を正眼に煙らせて来た。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "縦しや、また花の館に恋ごもれ、君が驕楽琅※の室屋、早や飽きぬ、火炎の正眼、肉の笑、蜜の接吻、絵も香も髪も律呂も宝玉も晴衣も酒もあくどしや、今こそ憎め。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと鉢の草の花だにすゑなくに昼｜冷まじく師を儺ふとす追ひ儺ふ下心はさもあれやいふ言は皆うやうやし聞きのよろしさ事はてむ憤らくも現なり父母よ見よこは正眼なり母の館母の館は児童の母たちの建設するものなり。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "水仙と寒菊の花、現身に正眼に見れば、まこと今あはれなりけり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「明りを、明りを、早く、明りを」　監物はそう云いながらも刀を正眼にかまえて少しも油断しなかった。",
              "citation": {
                "source": "不動像の行方",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして仮想の敵を描いて、正眼の構へをした。",
              "citation": {
                "source": "或る日の運動",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この傷痕で誰と分らば、素直に致さぬと諸羽流正眼崩しが物を言うぞ。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸御免の篠崎流正眼崩しを存ぜぬかッ。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "参るぞ」　言いつつ、片手正眼に得物を擬して、すい、すい、と一二歩近よったかと思われましたが、殆んどそれと同時でした。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが主水之介の正眼くずしじゃ。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸御免なるあの月ノ輪型の向う疵と、諸羽流正眼崩しのあのすさまじい剣脈で行くのです。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いざッ」　さッと身を引いて六寸八分南蛮鉄の只一本に、九尺柄タンポ槍の敵の得物をぴたりと片手正眼に受けとめたあざやかさ！",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸羽流正眼くずしの一刀が只の二千金とは安いぞ。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "龕灯に照し出された頼母は、寝床のそばから、飛び返って、床柱を後に当てて、二尺に足らぬ刀を正眼に構えていた。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉川が斬られたのを見て、幸田が素早く斬り込んだが、老人は床柱の陰に入って、それを小楯に取りながら、小太刀を片手正眼に構えている。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一剣に心こもりておのづから身のあはだつをかそかに知れり」「正眼に構えて敵に対ひつつしばし相手の呼吸をはかる」　これは戸山学校の剣道大会に優勝したときの緊張した剣客の歌である。",
              "citation": {
                "source": "睡蓮",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二人は正眼に構えたまま、どちらからも最初にしかけずに居りました。",
              "citation": {
                "source": "三右衛門の罪",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "warm, welcoming eyes",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "師匠はいつも正眼で弟子たちの稽古を見守り、必要があれば優しく助言をくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女の正眼に見つめられると、嘘をついている自分を恥じたくなるような気持ちになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖父は正眼の人であり、誰に対しても分け隔てなく穏やかな眼差しで接していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
    ],
