  {
    "uuid": "185023bf-4608-5dbe-89a2-ddc9854c15de",
    "entry": "晴眼",
    "reading": {
      "primary": "せいがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "晴眼者がパソコンなどの画面で読むテキスト・データを、そのまま点訳、音訳、拡大訳に利用していくというＢＢＡの構想のかなりは、今や常識的なものとなっている。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし、作品ファイルには、晴眼者がパソコンで読む以外のさまざまな利用の可能性があることを意識していなかったように、公有となった作品の取り扱いにあたって、何を重視し、どう振る舞うべきかの勘所を、我々は明確には意識できていなかった。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍はあり、草をかつぎ山のごとしづもる戦車、晴眼にひたと向ひ、未だ放たず。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
      "synonyms": [],
      "antonyms": [],
      "related": []
    },
