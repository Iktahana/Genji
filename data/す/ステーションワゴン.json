        "examples": {
          "standard": [
            {
              "text": "家族全員のキャンプ道具を積み込むには、収納力の高いステーションワゴンが一番便利だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は趣味のサーフィンを存分に楽しむため、長尺のボードが載るステーションワゴンに買い替えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "燃費はそこそこだが、ステーションワゴンならではの安定した走行性能は長距離ドライブに最適だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "私のようなか弱い女性が……」　彼女は新車で買った自分のステーションワゴンを運転して帰るんだといって聞かなかった。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            }
          ]
