        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "且ツ此ノ訴ハ必ズシモ離姻ヲ目的トセズ、實ニ婦人ガ男子ノ勞働ニ衣食スルカノ誤解アリテ、男子ノ勞働ガ其實却ツテ婦人ノ分科的勞働ノ助力アルガ故ニ行ハルルヲ忘却スル横暴ナル行爲ヲ禁ジ、特ニ法律ヲ以テ婦人ノ人權ヲ擁護スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日英兩國ハ中立的關係ニ立ツ能ハズシテ、彼ノ從屬的現状ヲ維持スルカ彼ノ分割ヲ結果スル征服者タルカノ二ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "文明推移ノ歴史ヲ只過去ノ西洋史ニ認メテ而モ二十世紀ニ至リテ漸ク眞ニ融合統一シタル全世界史ノ編纂ガ始マラントスル時、獨リ世界史ト將來トニ於テノミ其ノ推移ヲ思考スル能ハズトスルカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "不法監禁だぞ畜生……ドウスルカ見ろ……龍代の阿魔……。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モシオ前ノ友ダチガウッカリシテイテオ前ノ足ヲ踏ンダラオ前ハドウスルカ？",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶望シ、悲観シ、空シク絶滅スルカ、然ラズンバ辱ヲ忍ンデ逃ゲテ故国ノ空ニ帰ランカ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍ト云フ言葉ハ何ヲ意味スルカ余ニハ解ラヌ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ北海道ノ地ニ於テ絶滅セシカ、或ハ更ニ北方ニ移リテ今尚ホ其血統ヲ存スルカ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結句の訓、スルカモ、セスカモ等があるが、セルカモに従った。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツパラハウトスルカラアタシノハウカラヤツチマツタワ。",
              "citation": {
                "source": "狂女の告白",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガ婆サンニオ覚エノ悪イノハ、コンナ場合、婆サンヲ無視シテ予ノ気持ヲ迎エヨウトスルカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事中ノ雑談ニ、浄吉ガ二三日中ニ札幌ヘ出張スルカモ知レナイト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルカドウカ分ラナイガ、大工ヲ呼ンデ滑リ台ト滑車ヲ作ラセ、医療器械屋ヲ招イテ首ノ寸法ヲ測ッテ貰ウコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ノイナイ夜ハドウスルカト云ウト、婆サンガ代リニ佐々木ノベッドニ寝ルコトニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハソレヨリモ、春久ト颯子トガドンナ工合ニ接触スルカ、ソノ様子ガ見タカッタノデアルガ、団欒ノ中ニ加ワッテカラ三四十分モシタ時分、次第ニ脚カラ腰ノ周リガ冷エテ来ルノニ心ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ縁側カラ庭ヘ下リヨウトスルト、「佐々木サン、今日ハイヽワヨ、アタシガオ供スルカラ」ト、不意ニ颯子ガ何処カラカ現ワレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、ナカ／＼別レル気ナンカアルマイ、萬一彼女ニ疑ワシイ行為ガアッタトシテモ、見テ見ナイ振リヲスルカモ知レナイ、上手ニ振舞ッテサエクレヽバ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本日颯子同伴帰京ノ積リデイタトコロ、子供達ノ学校モ始マルノデ、豫定ヲ早メテ明二十四日皆々引キ揚ゲルコトニスルカラ、明日一緒ニ帰リマショウ、モウ一日オ延バシナサイト婆サンガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハイ、ハイ、オ爺チャン、アタシニドウシロッテ仰ッシャルノヨ、何デモスルカラ仰ッシャッテヨ」ト、ソウ来テクレヽバ締メタモンダガ、迂闊ニソウハ云イソウモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓際ニ予、ソノ隣ニ颯子、通路ヲ隔テヽ佐々木、ト云ウ目算デアッタガ、動キ出シテ見ルト窓際ハ風ガスウ／＼スルカラト云ワレテ颯子ト入レ代リ、通路ニ寄ッタ方ノ席ニ掛ケサセラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮リニ友人ガアッタトシテ、ソノ友人ガ優秀ナ技術ヲ具エテイタトシテモ、予ガ何ノ目的デ左様ナ製作ヲ依頼スルカヲ知ッタトシタラ、果シテ快クソレニ応ジテクレルデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ノ突然ノ事件ハ何ヲ意味スルカ、ソレヲ考エル利天ノ頂辺ニ登ッタノカモ知レナイト思ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………コノ突然ノ変化ガ何ヲ意味スルカハ追イ追イ分ッテ来ルデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニスルカ、キミ、ダレダ？",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "足下マデ餘ヲ虎ト揶揄スルカ」僕「三國志ナドニハ、虎侯、虎伯、虎將軍ナド、ミナ豪イ人ノ代名詞デス。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
