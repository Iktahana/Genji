        "examples": {
          "standard": [
            {
              "text": "春の野原で、雀の槍がピンと背筋を伸ばして咲いているのを見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この植物、雀の槍っていうんだ。穂の形が大名の行列の槍に似てるんだよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "雀の槍の周りには、シロツメクサやレンゲソウも顔を出している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
