        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鐵道ノ國有ナルガ故ニ現時ノ如ク民間ノ鐵道布設ガ阻害セラルルハ、第一國民ノ經濟的自由ヲ蹂躙スルノミナラズ、國有鐵道其者ノ利益ヲ減殺スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ノ使命的勞働ヲ廢セシメテ全ク天性ニ合セザル勞働ヲ課スルハ、啻ニ婦人其者ヲ殘賊スルノミナラズ、直ニ其ノ夫ヲ殘賊シ其子女ヲ殘賊スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只英語ホド普及セズシテ而モ英語思想以上ニ影響ヲ與ヘタル獨乙語ニ依リテ其ノ害毒ノ緩和セラレタル天裕ヲ有スルノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾訃ヲ聞キテ慟スルノミ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ僅ニ半部ヲ閲スルノミ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "啻ニ金石ニ画ヲ刻スルノミナラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "独｜芭蕉衢ノ屋宇｜巍然トシテ対列スルノミ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "交誼啻ニ門ヲ同ジクスルノミニアラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅ニ女史示ス所ノ者ヲ存スルノミ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐羅巴二三ノ地方ニ三時代變遷ノ跡アルハ、單ニ是等ノ地方ニ於テ偶マ斯カル變遷有リシトノ事ヲ證スルノミ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等遺物ノ比較研究ハ石器時代人民生活ノ状態ヲ明ニスルノミナラズ、又甲乙兩地交通ノ有無ヲモ表示ス。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「花ヨカラズ最下品ナリ只日ニツキテマハルヲ賞スルノミ」と出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
