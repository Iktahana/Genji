  {
    "uuid": "83e5ed09-679c-5ca9-87ce-abbe72bbab31",
    "entry": "スベシ",
    "reading": {
      "primary": "すべし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "地ノ果テヲ行ク、参照スベシ×月十五日「儂の拳骨は鉄砲の弾丸だ　武士の情けだ」　モンモンの兵、鉢巻をするあり。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "「被雇本人、軍籍ニアリ、万一不時ノ召集ヲ受ケ、労務ニ服スルコト能ハザルトキハ、前借金ニ利子ヲ附シ即時本人又ハ保証人ヨリ弁償スベシ。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家改造後ノ將來、私有財産限度ヲ超過シタル富ヲ有スル者ハ其ノ超過額ヲ國家ニ納付スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ致富ト改造後ノ致富トガ致富ノ原因ヲ異ニスルヲ了解スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "最少限度ノ生活基準ニ立脚セル諸多ノ社會改造説ニ對シテ、最高限度ノ活動權域ヲ規定シタル根本精神ヲ了解スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "前世紀的社會主義ニ對スル一般且ツ有理ノ非難、即チ各人平等ノ分配ノ爲メニ勤勉ノ動機ヲ喪失スベシト云フ如キ非難ヲ此ノ私有財産限度制ニ移シ加フルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "資本的經濟組織ノ爲ニ國内ニ不法ナル土地兼併が行ハレテ、大多數國民ガ其生活基礎タル土地ヲ奪取セラレツツアルヲ見ルトキ、國家ハ當然ニ土地兼併者ノ自由ヲ制限スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツラスト」「カルテル」ガ分立的競爭ヨリ遙カニ有理ナル實證ト理論ニヨリテ國家的生産ノ將來ヲ推定スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "改造後ノ將來、事業ノ發達其他ノ理由ニヨリテ資本ガ私人生産業限度ヲ超過シタル時ハ凡テ國家ノ經營ニ移スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ利己的欲望其者ヲ解剖スルモ、事業家ノ事業經營ニ於テハ其ノ手腕ノ發揮ヲ見ル自己滿足、其ノ經營的手腕ノ社會ニ認識セラルルヲ欲スル功名的動機ガ多大ニ含有セラルルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ利己的欲望中ニ含有サルル斯ル幾多ノ動機ハ、其ノ事業ヲ發展セシメタル國家的認識ト、國家ニ移レル事業ヲ其人ニ經營セシムル手腕發揮ノ自己滿足トニヨリテ、實ニ爭ヒテ私人生産業限度ヲ超越セントスル奮鬪心ヲ刺※シ鞭撻スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ物價ガ世界的原因、則チ世界大戰中ノ如キ世界的物價騰貴ノ爲ニ騰貴スルトキハ、國家ハ一般國民ノ購買能力ト世界市價トノ差額ヲ輸出税トシテ課税スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人生産業限度以下ノ支線鐵道ハ之ヲ私人經營ニ開放スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸上ノ鐵道ナルガ故ニ山間僻村ノ支線ヲモ國有トシ、海上ノ鐵道ナルガ故ニ全世界ニ通ズル幹線ヲモ民有トスベシトハ道理ニ合セザルモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ基本的租税以外各種ノ惡税ハ悉ク廢止スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ヲ機トシテ國家ガ收得ヲ計ラントスル社會政策者流ノ人權的思想ニ不徹底ナルヲ思考スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "例ヘバ巡査ガ生活權利ヲ主張スル時ハ其所屬タル内務省ガ決定スベク、教師ガ増給運動ヲナス時ハ文部省ガ解決スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義ノ原理ガ實行時代ニ入レル今日トナリテハ其レニ附帶セル空想的糟粕ハ一切棄却スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "農業勞働者ハ農期繁忙中勞働時間ノ延長ニ應ジテ貸銀ヲ加算スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "事業ノ經營收支決算ニ干與スル代リニ衆議院ヲ通ジテ國民トシテ國家ノ全生産ニ發言スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人生産業中株式組織ノ事業ハ其レニ雇傭サルル肉體的精神的勞働者ヲシテ、自ラ其ノ株主タリ得ル權利ヲ設定スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "別個生産能率ヲモ思考スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人生産業限度内ノ事業ニ於テ將來半世紀一世紀間ハ現代ノ如キ腐敗破綻ヲ來ス怖アル者ト推定スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ、勞働的株主ヲ併存セシムルコトハ内容的根本的ニ常ニ該事業ヲ健確ニ支持スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私有地限度内ノ小地主ニ對シテ土地ヲ借耕スル小作人ヲ擁護スル爲メニ、國家ハ別個國民人權ノ基本ニ立テル法律ヲ制定スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "舊社會ノ惰勢ヲ存セシムル凡テノ處ニ、舊世紀ノ革命論ハ繁殖スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ改造後ノ大方針トシテ國家ハ終ニ婦人ニ勞働ヲ負荷セシメザル國是ヲ決定シテ施設スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵役義務ノ爲メニ不具廢疾トナレル者ノ國家扶養ノ義務ハ別ニ法律ヲ以テ其ノ扶養ヲ完ウスベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
