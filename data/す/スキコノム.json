        "examples": {
          "standard": [
            {
              "text": "誰もが嫌がるような危険な役目を、彼は好き好んで引き受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "都会の喧騒を離れて、彼は好き好んで山奥での不便な生活を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は好き好んで苦労を買って出るような、責任感の強い性格だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "では、汝、玄正よ、この弟にもここは一番｜清水の舞台から飛び下りたつもりで、おつけ晴れて好き好む芸人修業、落語家修業をさせてやろうか。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な彼の「独行道」の言葉のうちにも、彼は、物事に好きこのむ事なし、とかまた、美宅古道具などを所持せず、とかいう箇条を挙げて、自分で贅沢を誡めているが、刀だけはべつとみえて、その一ヵ条に、兵具は格別、余の道具たしなまず　と、わざわざ云い訳のように書き添えている。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
