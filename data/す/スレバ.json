  {
    "uuid": "bc420de5-7c6b-5eac-a573-7953fb7268f9",
    "entry": "スレバ",
    "reading": {
      "primary": "すれば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "打チサエスレバ、カナラズ安打。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "走リサエスレバ、必ズ十秒四。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "的言イアテルヨリハ、ワガ思念開陳ノ体系、筋ミチ立チテ在リ、アラワナル矛盾モナシ、一応ノ首肯ニ価スレバ、我事オワレリ、白扇サットヒライテ、スネノ蚊、追イ払ウ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ元首が賣名的多辯ヲ弄シ下級俳優ノ如キ身振ヲ晒シテ當選ヲ爭フ制度ハ、沈默ハ金ナリヲ信條トシ謙遜ハ美徳ヲ教養セラレタル日本民族ニ取リテハ一ニ奇異ナル風俗トシテ傍觀スレバ足ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マルクス」ト「クロポトキン」トハ未開ナル前世紀時代ノ先哲トシテ尊重スレバ可。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ひたすら、刀ヲキ抽テ水を斷レバ水更ニ流レ、杯ヲ擧ゲテ愁ヲ銷サントスレバ愁更ニ愁フともいふべき焦燥にさへ驅られながら、思ひ出の走馬燈は限りもない勢ひで回轉するものの私は途すがら落花に遇つて長く歎息する面持で絶望と陶醉の島を遍歴して來たに過ぎない。",
              "citation": {
                "source": "文學的自叙傳",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ひたすら、刀ヲ抽キテ水ヲ断レバ水更ニ流レ、杯ヲ挙ゲテ愁ヲ銷サントスレバ愁更ニ愁フともいふべき焦燥にさへ駆られながら、思ひ出の走馬灯は限りもない勢ひで回転するものの私は途すがら落花に遇つて長く歎息する面持で絶望と陶酔の島を遍歴して来たに過ぎない。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　河部さんは詩吟が得意で、新吉に「剣ヲ抜イテキラント欲スレバ……」とか「……十年一剣ヲミガク」などゝいふ剣舞を教へた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、思はず、四観スレバ但ダ茫然、風悲シミテ浮雲去り、黄葉我前ニ墜ツ――とうたつたけれど、決してそれは憮然たる感慨ではなくつて、そんな壮麗さを唱へるには何かただ寧ろ悲し気に茫然たる言葉をもつてするより他は云ひやうもなかつたまでなんです。",
              "citation": {
                "source": "風流旅行",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「月黒クシテ雁飛ブヤ高シ　匈奴　遠ク遁走ス　軽騎ヲ能ツテ逐ハント欲スレバ　大雪　弓刀ニ満ツ」　斯く歌ふに伴れて私の挙が、閑吉の鼻先をかすめたり、五郎の胸に突きかゝつたりすると、観衆はその度に仰山な悲鳴を挙げて、益々私達を山上遥か無敵の城内に祭り上げた。",
              "citation": {
                "source": "武者窓日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ、活字ダケヲカタカナニスレバヨイトイウノダ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、一字卜為セシ者、皆新様ニ似タレドモ、敢テ古人製字ノ法ヲ倣フニ非ズ、其旁画、動モスレバ疑似ニ渉ルヲ以テ、等ノ片爿ヲ加ヘ、故ラニ字形ヲ乱シ、以テ真字ト分別アルヲ示ス、且此字ニ音無ク義無シ、即原語ノ音ヲ縮メテ、此字ノ音卜為ス者ナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由ト我儘トハ、動モスレバ其義ヲ誤リ易シ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "電源ノ消耗ト、更ニ急報スベキ事件ノ発生ヲ予期スレバナリ」僕「デハ御機嫌ヨウ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ忠告ヲ聞クコトナク出発スレバ、貴艇ノ行動ハ自殺ニ等シカラン」「自殺ニ等シカラン――か。",
              "citation": {
                "source": "月世界探険記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "計略ハ密ナルヲ良シトスだの、敵ヲ図ラントスレバ先ズ味方ヲ図レなどという格言は紅国軍部といえどもよく心得ているのであった――というような結末まで、ゆっくり探偵小説に書いていると、いくら枚数があっても……。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二酸化マンガン、酸化銅等ノ如キ酸化金属ヲ混ジテ熱スレバ已ニ二百六十度｜乃至二百七十度ニ在リテ酸素ヲ放出ス、是本品ノ高温ニ於テ最モ強劇ノ酸化薬タル所以ナリ………………又本品ニ二倍量ノ庶糖ヲ混和シ此ノ混和物ニ強硫酸ノ一滴ヲ点ズルトキハ已ニ発火ス云々」と書かれてあった。",
              "citation": {
                "source": "琥珀のパイプ",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "銅器陶器木製ノ物ハ、其ノ鑑識書画ニ比スレバ易シ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃墨ニテ石面ニ詩ヲ題スレバ、墨色渙発シテ妙ナリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "己レ能ク無用ノ費ヲ節スレバ則チ一生ヲ送リ、子孫ニ至テモ富ヲ有ス可シ。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶ホ黄道士ガ一叱スレバ頑石活シテ群羊ト為ルガ如シ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾レ又案ヲ拍チ筆ヲ按シテ姦人狡児ヲ懲罰セント一大呼スレバ、汝秩然トシテ其ノ行伍ヲ整列ス。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フランソア・ザビエル師ノ曰ク、予ノ見ル所ヲ以テスレバ、善良ナル性質ヲ有スルコト日本人ノ如キハ、世界ノ国民ノウチ甚ダ稀ナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "打スレバ則チ棒ヨリモ利アリ、刺ストキハ則チ刃ヨリモ利アリ、両ナガラ相済フ、一名ヲ棍ト曰フ、南方ノ語也、一名ヲ白棒ト曰フ、北方ノ説也。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "七――即チ毎月十二円又ハ二十円ヲ払込メバ一年後ニハ「泰平郷」分譲地域内ノ欲スル場所ニ於テ、九坪乃至十五坪ノ平家木造建一棟ヲ仮ニ所有スルコトガ出来、爾後十年間払込ヲ継続シサヘスレバ、既ニ十分利用シツヽアル該家屋卜共ニ、敷地百坪乃至二百坪トヲ併セテ、ソノ完全ナ法的名義人トナリ得ル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言スレバ、諸君ハ知ラズ識ラズコヽニ永代不滅ノ資産ヲ確立スルコトヽナルノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、政府委員は『「パノラマ」ノヤウナ一ツノ纏ツタモノデアリマスレバ、是ハ疑ナク著作物ト認メラレルカト思フ』と答へてゐる。",
              "citation": {
                "source": "演劇・法律・文化",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "苛刻ノ法令ヲ出ス毎ニ、余輩、言ヲ卑フシ謹テ願訴シタレドモ嘗テ之ヲ聴カズ、随テ願訴スレバ随テ之ニ報ユルニ惨毒ヲ以テシ、一令出ル毎ニ其暴政タルヲ証スルニ足レリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            }
          ]
        }
