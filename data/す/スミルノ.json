        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "氏が鳥井零水という匿名で、ドゥーゼの「スミルノ博士の日記」「夜の冒険」の二作をひきつづき『新青年』に連載しはじめたとき、原作の優秀と、訳文の巧妙とは相まって、私は、いまだにあの時ほど、雑誌の出るのを待ちこがれた経験はない程である。",
              "citation": {
                "source": "小酒井不木氏",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二十六日（月曜）　マールイ・テアトルで、スミルノワの引退興行があった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノワ、まだ奇麗で、声もすみ、立派であった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノワのところへ行く、五つと幾月かの女の子、音楽と踊をやって居る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は黄繻子の頭巻きで、下から黒い髪の束をこぼし、家の外羽目に打ちつけてあるＴ・Ａ・スミルノワ、黒で書いた白エナメルの表札を見上げていた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノフが、ハフィズの詩を音読していた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノフが低い声で何か云うのに対して、佃が、せわしなく、重ねて、「yes. yes.」と答える声も聞えた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ミスタ・スミルノフがこれを下さいましたよ……」　佃は、何か異常な空気を嗅いだという風に伸子を上下に眺めた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今じゃみんな目隠しをされてもコシェリョフ吟造とスミルノフ二十一番とをやすやすと利きわける始末だ。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ため息をつく）だめ、だめ、こうなったらもう、ほんとに尼寺へでも行かなくちゃ……（考えこむ）そう、尼寺へ……四ポポー※、ルカー、スミルノーフスミルノーフ　（入りながら、ルカーに）でくのぼうめ、つべこべご託をならべやがる。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "退職陸軍砲兵中尉、地主のグリゴーリイ・ステパーノヴィチ・スミルノーフであります！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　亡くなられた御主人と、おつきあいを願っておった者ですが、その御主人に、約束手形二枚で合計千二百ルーブリ、御用だてしてあります。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　わたしから、カラス麦を買われたのです。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフに）それは、宅が拝借したものでしたら、もちろんわたくし、お支払い申しますわ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ところが、今のわたしの気分は、もし明日、利子が払えんとなったら、しゃっちょこ立ちで夜逃げをせずばなるまいと、そういうわけなんで。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　こっちが金のいるのは、明後日じゃない、今日なんです。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ところがこっちは、明後日まで待つわけにゃ行かんので。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　すると、払えんと言われるのですか？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　致し方ございません……スミルノーフ　ふむ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ぎりぎりですな？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ありがたい仕合せだ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきも途中で、税務署の男に逢ったら、「なんだってあんたは、いつもぷりぷりしてるんです、ええスミルノーフさん？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　わたしは支配人を訪ねて来たのじゃない、あなたをですぞ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（足ばやに退場）五スミルノーフ（ひとり）スミルノーフ　ええ、どうだい！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "六スミルノーフ、ルカールカー　（登場）何ご用で？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ク※ス〔無色透明の清涼飲料〕か水を持ってこい！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　いやはや、なんたる論理だ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "七スミルノーフ、ルカールカー　（登場して、水を差し出す）奥様はお加減がわるくて、お相手ができねえそうで。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
