        "examples": {
          "standard": [
            {
              "text": "深夜まで論文を書き続けていたら、突然睡魔に襲われてキーボードの上に突っ伏してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "午後の会議中に睡魔に襲われ、必死にペンを走らせてどうにか目を開けていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長距離運転の途中で睡魔に襲われたので、すぐにサービスエリアに車を停めて仮眠を取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ごはんを食べてしまって部屋に一人で端座していると、さむらいは睡魔に襲われるところとなった。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "机に倚って書物を眼の前に開けている時ですら、睡魔に襲われる事がしばしばあった。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
