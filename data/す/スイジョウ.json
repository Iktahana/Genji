  {
    "uuid": "dae848fd-2245-5ce6-9dfe-151d32584cd0",
    "entry": "穂状",
    "reading": {
      "primary": "すいじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "shaped like an ear of grain",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "草原一面に、穂状の形をした美しい紫色の花が咲き乱れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この穂状の穂先を軽く振ると、甘い香りが周囲に漂った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この植物、穂状になってて面白い形だね」と彼女が指差した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "サラシナショウマの雪白なる穂状花は、角間川の渓流を挟み咲いて、女郎花、藤袴等と相靡くなど、生徒等の喜びは大したものだ。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "花は淡黄色小形で枝頭に短縮した穂状様の総状花序をなしており、葉には毛がない。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "７　あけちたんていは、へやの中へはいって、すいじょうけいさつへでんわをかけました。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "きしにつくと、中から、すいじょうけいさつのおまわりさんがでてきました。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "すいじょうけいさつでは、川におちた人をさがさなければならないことがあるのでこういうモーターボートをつくったのです。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのペリスコープのさきを見つければいいのだ」　あけちたんていがいいますと、すいじょうけいさつのおまわりさんは、すぐにボートのへさきの、サーチライトのスイッチをいれました。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
