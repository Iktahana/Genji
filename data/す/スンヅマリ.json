        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は少し寸詰まりな体型だが、そのぶん筋肉質で力持ちだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「このデザイン、全体的に寸詰まりに見えてしまって、バランスが悪いな」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "寸詰まりなコートを羽織った彼は、どこかコミカルな印象を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "春宮秘戯図といえば、これは東京の話だが、昭和戦前までいた坊主頭で寸詰まりの愛嬌のある顔をした春風亭柳丸という爺さん、売り物はおよそ前代の漫芸ばかりで百まなこ、ひとり茶番、阿呆陀羅経には犬猫の物真似。",
              "citation": {
                "source": "艶色落語講談鑑賞",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "とびがたかを産んだという話はきくが、おやじの三庵はあのとおりおでこの慈姑頭、おふくろさんは四角い顔の寸づまり、あんな似たところのねえ親子なんてものはありゃしねえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうえに肉はでっぷり、顔は寸づまり、押せばぶよんと水気が出そうなほどにもあぶらぎって、どんなにうまく化けたにしても、とうていやさ男なぞに化けきれるような女ではないのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それに応じて買えぬので、いつも、寸づまりの、手首のうんと出た洋服をきて、ぼろぼろの靴に、破れた帽子をかむっていた。",
              "citation": {
                "source": "死までを語る",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　鼓村氏は、浜子が体が弱いので、転地ばかりしているから、その時持ってゆくのに具合の好い、寸づまりで、幅の広い箏を、正倉院の御物の形ちを模して造らせた話をした。",
              "citation": {
                "source": "朱絃舎浜子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し不幸なことには、彼女等の多くは、お尻だけは比較的大きいかも知れないが、胴体も寸づまり、脚も寸づまりのちんちくりんなのである。",
              "citation": {
                "source": "ジャングル頭",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジリ、ジリ……と一寸づまりに後退った。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "がっちりしたその寸詰りの体躯にも、どこか可笑しみがあって、ダンスも巧かった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "――男はまだ学生らしく、どこか寸詰りな背広姿で、始終白い歯を見せて笑つてゐた。",
              "citation": {
                "source": "瑪瑙盤",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『闘牛学校』という看板のかかったアーチ形の入口についていた呼鈴を押すと、出て来たのは、寸詰りのモオニングを着た五尺未満のチョビ髯の紳士はこちらが述べる用向きを途中から引ったくって、「委細承知。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
