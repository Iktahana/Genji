        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "おもちゃを買ってもらえない子供が、デパートの床に座り込んで泣きわめいている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "要求が通るまで一歩も引かない覚悟で、彼は知事室の前に座り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "負けたことが悔しくてたまらず、選手はコートの真ん中に座り込んだまま動かなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
