    "definitions": [
      {
        "index": 1,
        "gloss": "to (enter and) sit down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "玄関を上がるなり、彼は疲れ果てた様子でその場に座り込んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "焚き火を囲んでみんなで座り込み、深夜までとりとめもない話を続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "公園のベンチに座り込むと、冷たい風が頬をかすめて通り過ぎた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "いずれも翁の謡振りの或る一部分を伝えたものであったらしいが、それ等の謡い盛りの一同の地謡の中に高齢の只圓翁が一人座り込むと、ほかの声は何の苦もなく翁の楽々とした調子の中に消え込んで行った。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が乗った船の名は太湖丸ですが、着物や浴衣の客が座り込むようになっていて、椅子はありませんでした。",
              "citation": {
                "source": "手紙",
                "author": "一八九三年七月二二日付　チェンバレン　宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして又もペッタリと座り込むと鬢のホツレを指先で掻上げながら咳払いを一つ二つした。",
              "citation": {
                "source": "骸骨の黒穂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "債権者は、先ず債務者の門前数尺の地に麦を蒔き、その中央にドッカと座り込む。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "（２）うそ泣きなのか　セイウチさん　　　子どもよりも　大食らいして　　　ぼくらはただの薬味かよ　　　ごめんなさい　ああ（セイウチうめく）　　　あ　こんにゃろめ　ああ　　　できるのは　ふんづけることだけ　座り込む二匹のカキ、そこへ三匹目が登場。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を見付けたと思います、親分」「知るものか」「路地の中にソロソロして居る男――そいつは、御用ッ、と襟髪を掴むと、ヘタヘタと腰を抜かして、泥の中へ座り込むじゃありませんか。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "腰抜け彌八",
                "note": "青空文庫"
              }
            },
            {
              "text": "早まって死なれちゃ、おっ母さんばかりじゃ無い、この綾麿も不本意だ」　いきなり飛込んだ綾麿は、香折の手から短刀を奪い取って、母娘の間へどっかと座り込むのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "観音様の頬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘレナ、椅子に座り込む。",
              "citation": {
                "source": "ＲＵＲ――ロッサム世界ロボット製作所",
                "author": "R.U.R. (ROSSUM'S UNIVERSAL ROBOTS)",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は座り込む姿勢になってマストを担ぎ直し、道を眺めた。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっとサンゴを取り除き、財宝の輝きを見た時、うぉっと座り込むしかなかった。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "座り込むと、顔色がどんより憂鬱な表情になった。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔面蒼白、震えながら椅子に座り込む様子を、メアリがじっと見て言った。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "お茶の時間になる頃には頭がずきずきして、ため息をついて惨めに椅子に座り込む始末だ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "うらぶれ、痛めつけられた霊魂は、もう一度、瑞穂の国、大八洲にすわりこむか、その黄色い皮膚を漂白するか、それとも、惰性の波に消えるか。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくもその子のそばにすわりこむ。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは中途に止まって無精らしくすわりこむ。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "お留守だよ」「…………」「ほんとにお留守だってば」「…………」「お帰り」　童子は、去ってまた、竃の前にすわりこむと、薪などくべて、振り向きもしない。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから私たちは、仙台の浅草とも称すべき東一番丁に行って、彼の所謂「行きあたりばったり」の小料理屋にはいり、これまた彼の言葉にしたがえば「無難」の鳥鍋をつつく事になったのであるが、彼は私と卓をはさんで坐り込むと、まず一葉の名刺を差し出した。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥には庭伝いで行けるような小座敷もあったが、坐り込むと又長くなるというので、二人は店口の床几に腰をおろして、有り合いの肴で飲みはじめた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "なりひらニヤッと笑って、先ず先ずと其処へ坐り込む。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「久し振りだなァ」　と坐り込む浪之助。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "何時も何か充らないやうな、物足りぬ顔で大きな古｜机の前に坐り込むでゐるが、飽きるとゴロリ横になツて、貧乏揺をしながら何時とはなく眠ツて了ふ。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父はお庄の背後の方に坐り込むと、時計を見あげて懈い欠をしていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」こちらは女の心が分つたかの樣にして女を呼びとめ、「實は、持つてゐるよ」と、また火鉢のそばへ坐り込む。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だい」といきなり机の横へ坐り込む。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "席次を目安に人を採る今の習慣を利用しようと思えば、随分友達を羨ましがらせる位置に坐り込む機会もないではなかった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来、この弥三郎は道楽者の上に、その後はいよいよ道楽が烈しくなって、結局屋敷を勘当の身の上、文字友の家へころげ込んで長火鉢の前に坐り込むことになったが、二人が毎日飲んでいては師匠の稼ぎだけではやりきれない。",
              "citation": {
                "source": "鯉",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "父が凝と坐り込むようになると、やはり元の方が達者だったのだという気が起った。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "またそこへ坐り込むと臆劫になるから」　津田は仕方なしに手を出して手拭を受取った。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "コック部屋の横の帳場に坐り込むと、電話帳を調べてから念入りにダイヤルをまわした。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
