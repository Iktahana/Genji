          "literary": [
            {
              "text": "「あ、あすこ石炭袋だよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふしくれだつたそのからだは、ちようど、うすつぺらな石炭袋へ石炭をぎゆう／＼つめこんだやうなかつこうです。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソローハは、こんな大兵なお客をいつたい何処へ隠したものかと、暫らく思案に迷つたが、最後に一番大きい炭袋を選んで、中の炭を桶へぶちまけた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
