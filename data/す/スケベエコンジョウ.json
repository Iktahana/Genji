        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "投資で儲けようと助兵衛根性を出したのが仇となり、結局大損してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "相手の弱みに付け込んで一儲けしようとする助兵衛根性が、彼の評判を落としている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「もう十分利益は出ているんだから、助兵衛根性を出さずに利確しなよ」と助言された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
