          "literary": [
            {
              "text": "スキヤンダルになるかならないかは、姉さんの態度ひとつだわ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは試験があつて、よほどうまく答案を書かないとあぶない、聖書の点数を落第点なぞ貰つたら、ミツシヨンの方面にはスキヤンダルみたいな一大事なのである。",
              "citation": {
                "source": "身についたもの",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ過去の話も警察が聞き出すと、すぐそこに一つのスキヤンダルがあつたとして、或る手がかりを握つたやうに騒ぎ立てた。",
              "citation": {
                "source": "Ｌ氏殺人事件",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            }
          ]
        }
