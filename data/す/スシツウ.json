          "literary": [
            {
              "text": "寿司通と自称他称する連中もたいていはいい加減な半可通で、それならこそまた寿司屋も息をつけるというものである。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "島田髷の時代には売物にならなかった御面相が、口紅、爪紅、ハイヒールで堂々と寿司通仲間に侵入し、羽振りを利かす時代になってしまった。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "すし屋についても、僕は、すし通は、並べられない。",
              "citation": {
                "source": "うどんのお化け",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
