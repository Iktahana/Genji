        "examples": {
          "standard": [
            {
              "text": "古くなった下駄の鼻緒を新しいものにすげ替えると、まるで新品のような履き心地になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "電池を新品にすげ替えたら、止まっていた時計が再び動き出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "偽物と本物を密かにすげ替えるという、大胆な犯行の手口が明らかになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それで、そしてその切れたあとへ犬の頸を持ってきてすげかえるんだ。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
