        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "静かな会議室に、彼の素っ頓狂な笑い声が響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "予想外の質問に、彼は素っ頓狂な声を上げて驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "素っ頓狂な格好で街を歩く彼に、周囲の視線が集まっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "令嬢があるじゃない」　知子が、キャッハッハと素っ頓狂な声で笑った。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはさておき、一同がおとし穴に気をとられているとき、キョロキョロとあたりを見廻していた牛丸平太郎が、突然、「あっ」と、素っ頓狂な声をあげた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう素っ頓狂な環境で、どんなことがはじまろうというのか、石田氏でなくとも、ちょっと聞いてみたいところだった。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分を皇帝の身代りに処刑するなどという考えはどうも素っ頓狂なばかりでなく、かりにもしそうだとしたら自分を釈放する筈はなく、まして皇帝として待遇する謂なぞない。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後かけ違って碌すッぽ挨拶も申さず御無沙汰ばかり致しておりながら、こんなところ素っ頓狂にとび出して声をかけるんだから、聞こえぬふりをして礫き倒して行かれたって文句のねえところなのに、よくまァ停めて下すった。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの男は素っ頓狂でいうことは馬鹿馬鹿しいが、腹の中は良い人間だよ、――それから、これはいくらでもないが、香奠のしるしだ」　平次は妙に湿っぽい心持になって、財布と煙草入に投り込んで置いた小粒を五、六枚、平次にとって、それは今の全財産ですが――鼻紙にひねって、女房の前に押しやるのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あッ、親分」　先に入った八五郎は、思わず素っ頓狂な声を張り上げます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「代地のお秀さん――船宿の――」「来たよ、親分」　ガラッ八は素っ頓狂な声を出しました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "青い帯",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーバー所長が素っ頓狂に叫んだ。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかに何か言いましたか」　とハロルドが素っ頓狂な声を上げた。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなことを聞いたのは初めてですよ」　とジェシが素っ頓狂に叫んだ。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時メイが素っ頓狂な声を上げて振り向き、グラントの腕を掴んでささやいた。",
              "citation": {
                "source": "鉄面皮",
                "author": "A Front of Brass",
                "note": "青空文庫"
              }
            },
            {
              "text": "スカースデールが素っ頓狂に叫んだ。",
              "citation": {
                "source": "鉄面皮",
                "author": "A Front of Brass",
                "note": "青空文庫"
              }
            },
            {
              "text": "一万ポンドですって、とイズリアルスが素っ頓狂な声を上げた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし人類の生き残りの可能性がここ以外にないとすれば、いかにすっとんきょうであったとしてもこの道を切り開く以外にはない。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　警部は、すっとんきょうな声をあげた。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ起きて待ってた松若さんが、すっとんきょうな声を立てました。",
              "citation": {
                "source": "千代次の驚き",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と里好はすっとんきょうな声を出した。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっくら、いますぐだ』すっとんきょうな南京さんすっとんきょうな南京さんがお三かたござった。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人だけの自慢にしようとしたのに、マスノはすっとんきょうに叫んだ。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "助ちゃんにはそんなすっとんきょうなところがあった。",
              "citation": {
                "source": "桜林",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "朧の明りにすかし見た与の公、素頓狂な声をあげて、「やっ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二人の女給は意味ありげな目配せをしあって、素頓狂な大きな声で、登美子さあん……と叫びたてた。",
              "citation": {
                "source": "南さんの恋人",
                "author": "――「小悪魔の記録」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこんところで、突然に現われた赤い褌の若造が一人、素頓狂な声を張り上げて、万人堂の杉のスッポンコラ槍のようでさジョや、てんとさまオカなかろう　この素頓狂で、一同がドッと笑う。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "七兵衛もおかしいと思ったが、右の素頓狂な唄が何の意味だかよくわからない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "格子に掴まって素頓狂な声。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "春霞のかかったような、とろんとした眼つきで藤波の顔を見あげながら、素頓狂な声、「いよウ、藤波さん、これは、これは、珍客の御入来。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "菊香水",
                "note": "青空文庫"
              }
            },
            {
              "text": "低俗な民衆の眼には、どうも、すこし素頓狂に見えるらしい。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘイありがとうござんす」　ピョーイと素頓狂に飛び上がると、「じゃひとつねえ師匠、縁起に歌いましょ、都々逸でも」　ニッコリ笑って、柄になく錆びのある中音で、※異人館の屋根に異国の旗が風に吹かれてブラブーラ　これがほんとの異国（地獄）の旗（沙汰）も風（金）次第イイ……　と一気に歌った。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「タ、大変だ大変だ師匠、お前はん」　例によって素頓狂な顔をして萬朝がアタフタ表から飛び込んできた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
