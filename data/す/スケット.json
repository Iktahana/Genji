        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はチームに助っ人（すけっと）として参加し、すぐに貢献した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "引越しの日は、友人たちが助っ人（すけっと）に来てくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "困っているときは、誰か助っ人（すけっと）が現れると心強い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "あくまでマイクロコンピューターの販売を本業とし、パーソナルコンピューターに割くマンパワーを限られる渡辺の部隊にとって、アスキーはこの分野により大きな力を注いでいくうえで絶好の助っ人となった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな出版の世界で、二つの願いの片割れである「読まれたい」には、助っ人らしきものもいなかった。",
              "citation": {
                "source": "短く語る『本の未来』",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃になると、助っ人が続々到着。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のステージではギターの西田増美とサックスのケリー田口が正規のサイバネテイック・スキゾイドのメンバーに助っ人として加わっていた。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今回西田増美とケリー田口の二人を助っ人として調達できたのも彼の顔のおかげだった。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が助っ人になりましょう。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "助っ人は虐待しないものだぞ。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、説明を買ってでたレスラアＢ氏の説明が出鱈目で、たとえば≪助ッ人≫と読むべきところを≪助人≫と読みあげるような誤りが、ぼくには奇妙な哀愁となって、引きこまれるのでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは、いささか本草と物産に眼があいているから、そのほうの助ッ人をやる。",
              "citation": {
                "source": "ボニン島物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことからおいらが思いつき、一人いい人を助ッ人に出すから、おいらに小遣いを一両くれろ、然し一昼夜限りでその人は返してくれといったんだ。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "おろく　一両はまことにいいけれど、ばくち打ちの喧嘩に助ッ人に行くのはねえ。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（喧嘩の助ッ人と知られたかと驚く）おきぬ　女は浅はかだ。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "お話の助ッ人の方に、至急おいで願いたい――かようでござんす。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さんが向けてくれた助ッ人は沓掛時次郎さんという商売人だと、あとで聞いて成程そうかと膝を叩きましたよ。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
