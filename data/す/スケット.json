        "examples": {
          "standard": [
            {
              "text": "その野球チームは、強力な助っ人（すけっと）外国人を獲得した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "弱小チームに、助っ人（すけっと）選手が加入して活気が戻った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "サッカーの試合で、助っ人（すけっと）として活躍する選手がいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
