[
  {
    "uuid": "1bfa0664-b9e6-5975-9c57-4df3e6771a65",
    "entry": "スッテン",
    "reading": {
      "primary": "すってん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
