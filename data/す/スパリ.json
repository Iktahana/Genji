[
  {
    "uuid": "f3d18aca-1419-58d8-b16b-7e4c2cdbb336",
    "entry": "すぱり",
    "reading": {
      "primary": "すぱり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
