          "literary": [
            {
              "text": "向こう側にジェスウィトの寺院がある。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国にてスウィトブレッド即ち甘きパンという。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから犢のシブレといって喉の処に極く僅かばかりある肉ですが、米国ではスウィトブレッド、甘いパンといって非常に珍重するものをお料理に使うつもりですけれどもこれは滅多にない肉で犢一頭に必ずある訳でありません。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "莨の味など、たゞもう辛いものになり果てた、バットの箱には、恐らくむかしの、スウィト・エンド・マイルドとは書いてあるまい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物は焼き立てのスウィトポテト。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
