        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ツマラヌ取次ハスルモノデナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場ヤ、銀行ヤ、病院ハ誰レノ所有ニ属スルモノデアルカ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "太ッタ大資本家共ハ、鈴文ヤ松駒ノ如キ階級的裏切者ヲ買収シ、諸君カラノ搾取ヲマスマスヤサシクシ、諸君ノ妻ヤ子ヲ、飢ニヒンセシメ、諸君ヲモ絞殺スル反動ノ城塞ヲ固クスルモノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "桑名藩　　新谷格之介　右者京畿ニ於テ錦旗ニ発砲シタルニ依ツテ羽津光明寺ニ謹慎仰付候ニモ拘ラズ潜カニ脱走ヲ企テ江戸ニ下向再ビ錦旗ニ抵抗致サントシタル段重々不埒至極依テ銃殺ノ上梟首スルモノナリ　　戊辰二月官軍参謀　格之介を除いた十二人の人々は、その年の四月、なんのお咎めもなく無事に帰藩を許された。",
              "citation": {
                "source": "乱世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧富ヲ無視シタル劃一的平等ヲ考フルコトハ誠ニ社會萬能説ニ出發スルモノニシテ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "以テ之ヲ市有トスルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐵道ノ國有ナルガ故ニ現時ノ如ク民間ノ鐵道布設ガ阻害セラルルハ、第一國民ノ經濟的自由ヲ蹂躙スルノミナラズ、國有鐵道其者ノ利益ヲ減殺スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ノ形式的又特殊的課目ヲ廢止シ小學、高等小學、中學校ニ重複スルモノヲ廢シテ一貫ノ順序ヲ正シクス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ將來益々國民ノ大多數ヲシテ數十萬數萬ノ私有財産ヲ有セシムルコトヲ國策ノ基本トスルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義共産主義ヲ誤解シテ其ノ私有財産ヲ分與スルモノナルカノ如ク考ヘ、又ハ國民ノ凡テニ其日暮シ其年碁シノ生活ヲナサシムル者ト考フルガ如キハ、現實的改造ノ要求セラレツツアル現代社會革命説ノ躍進的進歩ヲ解セザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲシテ日本ノ愛蘭土タラシムル如キコトアラバ、將來大羅馬帝國ヲ築カントスル日本ハ全然其ノ能力ナキコトヲ第一歩ニ於テ立證スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ現時ノ對鮮策ナルモノハ甚ダシク英國ノ植民政策ヲ摸倣シタルガ故ニ、根本精神ヨリシテ日韓合併ノ天道ニ反スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカルニ草書ト楷書ハ、コレヲ混ゼコジヤニ布置シタ場合ケツシテ調和スルモノデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽然茂ヨリ走リ出デ九郎右衛門ニ向カッテ跳躍スルモノアリ。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ国家ノ秩序ヲ紊乱スルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ憲法ノ実施ヲ害スルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ立法権ヲ抛棄シ之ヲ裁判官ニ委スルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ国家ノ経済ヲ攪乱スルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "延期論者を呼んで「痴人ナリ」「狂人ナリ」また「国家ヲ賊害スルモノ」といい、その結末に至って、「特リ怪ム、是時ニ当リテ敢テ法典ノ実施ニ反抗セントスル者アルヲ、此輩畢竟不法不理ナル慣習ノ下ニ於テ其奸邪曲策ヲ弄セントスル者ノミ、咄何等ノ猾徒ゾ」と言うておるが如きは、頗る振っている。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ亦ラジオヲ以テ長年ノ趣味トスルモノニシテ、予ガ組立テタル愛機『スーパーヘテロダイン』ヲ携エテ今回｜此途ニノボレリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "仍リテ両者ハ根本的ニ構造ヲ異ニスルモノト謂フベク、従テ本願ハ、援用立像ヲ以テ拒絶セラルル理由ヲ発見シ得ザルモノナリ。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二条　土地ハ一切ノ（公然タル若クハ隠蔽サレタル）賠償ナクシテ今日限リ全労働大衆ノ使用ニ帰スルモノトス。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ］人民公民ノ権ヲ失フモノ算ナクシテ町村ノ自治全ク［破壊→頽廃］セラレ［飢餓→貧苦疾病］及ビ毒ニ中リテ死スルモノ亦年々多キヲ加フ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "設シ之ヲ名ヅケテ黒塚ト云フガ如キ有ラバ、則チ是レ鬼女ノ窟ニ適当スルモノ、何ゾ絶代ノ麗※ガ艶魂ヲ葬ルノ地ト認ル者有ランヤ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ列スルモノハ古貨幣ナリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
