[
  {
    "uuid": "e29e11a8-12d8-578a-93df-55348022edec",
    "entry": "睡蓮",
    "reading": {
      "primary": "すいれん",
      "alternatives": [
        "スイレン"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
