    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "このときに一挺の駕籠がここの店さきに卸されて、垂簾をあげて出たのは、かの中年増の女であった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "「寄ってらっしゃいたって、僕が食うようなものはありやしまいじゃないか」「そりゃどうせ、しがない垂簾の食もの屋ですからねえ」　こんな応対で通り過ぎてしまう店先が多かった。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は僅かばかりの荷物のなかを掻き廻して、よれた麻の垂簾を探し出した。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "垂簾には潤ひのある字で『鶉居』と書いてあつた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその垂簾の皺をのばして、小屋の軒にかけた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自信を失ひながらなほ安定した気持になりたかつたので、その垂簾を軒にかけたのだつた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうした字のある垂簾をかけた小さい自分の家を外へ出て顧りみると、世界にたつた一つ住み当てた自分の家といふ気がして、そのとき、もはや老年にいりかけて居た彼は、こどものやうになつて悦んだ。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その悦びも大して長く続かず、六年目には垂簾を巻いて京都へ転居したのをきつかけに、再び住居の転々は始つた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "垂簾はかなりよごれてゐた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小庵は新しいので垂簾のよごれは目立つた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と彼は垂簾に向つて云つた。",
              "citation": {
                "source": "上田秋成の晩年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "負けずに立看板や色垂簾で店を武装している雑誌店。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯一條の岩面を露出するもの、其水形垂簾を懸くが如し。",
              "citation": {
                "source": "草津行",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、そうだろうと思うんだが、ばたばたと早足に駆け出して来た奴があって、暗やみからだしぬけに駕籠の垂簾へ突っ込んだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "槍突き",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよやられたに相違ねえと、駕籠屋は気味わるそうに垂簾をあげて見ると、中には人間の姿が見えねえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "槍突き",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりの武士らしい男が垂簾をはねて、彼女のそばにつかつかと進み寄った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "あま酒売",
                "note": "青空文庫"
              }
            },
            {
              "text": "（三人は繩からげの勘太郎を引摺つて駕籠のなかへ押込み、外から垂簾をおろす。",
              "citation": {
                "source": "權三と助十",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（捕方は駕籠の垂簾をあけて、勘太郎をひき出す。",
              "citation": {
                "source": "權三と助十",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきから駕籠のうちで、お峰の親子はこの問答を聞いていたのであるが、もうこうなっては聞き捨てにならないので、お峰は駕籠を停めさせて垂簾をあげた。",
              "citation": {
                "source": "経帷子の秘密",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お妻も駕籠の垂簾をあげて覗いた。",
              "citation": {
                "source": "経帷子の秘密",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お峰も垂簾をあげた。",
              "citation": {
                "source": "経帷子の秘密",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その草鞋を穿き替えている間に、次郎左衛門は垂簾のあいだから師走の広小路の賑わいを眺めていたが、やがて何を見付けたか急に駕籠を出ると言った。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気をつけてお出でなんし」　綾衣が駕籠の垂簾を覗こうとする時に、白粉のはげた彼女の襟もとに鳥の胸毛のような軽い雪がふわりふわりと落ちて来た。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "垂簾をあげて這い出したお絹は、よろけながら下駄を突っかけて立った。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "取り分けて肝腎の花形の六三郎の顔が駕籠の垂簾にかくされているのを、残り惜しく思う若い女もたくさんあったでしょう。",
              "citation": {
                "source": "子供役者の死",
                "author": "岡本椅堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "綾衣は駕籠の垂簾をあげて、見返る。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "四挺の駕籠が宿の中まで来かかると、左側の小さい旅籠屋のまえに一挺の駕籠のおろされているのが眼についたので、半七は自分の駕籠の垂簾をあげて透かして視ると、その駕籠は今この旅籠屋に乗りつけたらしく、駕籠のそばには二人の男が立っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "狐と僧",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では、御免を蒙って、ちょっとのぞかせて頂きます」　再び丁寧にことわって、半七は桐油紙を着せてある駕籠の垂簾を少しまくりあげると、中には白い着物を着ている僧が乗っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "狐と僧",
                "note": "青空文庫"
              }
            },
            {
              "text": "『山院黄昏雨、垂簾坐小※、相思人不見、中夜涙雙々。",
              "citation": {
                "source": "『聊斎志異』より",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
