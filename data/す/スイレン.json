        "examples": {
          "standard": [
            {
              "text": "小さな庭の池には、可愛らしい pygmy waterlily（睡蓮）が植えられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "睡蓮（Nymphaea tetragona）は、その小さな花と葉で知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この品種の睡蓮は、水深が浅い場所でもよく育つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
