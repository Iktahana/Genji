  {
    "uuid": "fc61106e-a9bc-5790-9dd2-d114c529ffdb",
    "entry": "垂簾",
    "reading": {
      "primary": "すいれん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
