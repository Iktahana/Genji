        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「文字ノ精ハ人間ノ鼻・咽喉・腹等ヲモ犯スモノノ如シ」と、老博士はまた誌した。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハ　カンザシト　イツテ、アタマニ　サスモノデス」ト　ヲンナノ　コハ　オシヘテ　ヤリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民教育ノ兒童ニ對シテ無月謝教科書給付中食ノ學校支辨トスル所以ハ、國家ガ國家ノ兒童ニ對スル父母トシテノ日常義務ヲ果スモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ純潔ノ朝鮮人ノ血液ヲ多量ニ引ケル者ハ彼ト文明交渉ノ密接セシ王朝時代ノ貴族ニ多ク、現ニ公卿華族ト稱セラルル人々ノ面貌多ク朝鮮人ニ似タルハ凡テ其ノ類型ヲ現スモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ倫理ノ破頽ヲ来スモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントウニ、ヨシヲサンノオ母サンノ言ツタトホリナンデスモノネ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツフヱーノ婢ハ世人ノ呼デ女ボーイトナシ又女給トナスモノ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木可笑の『江戸外史』に「官舟ヲ備ヘテ窮民ヲ府内ノ逆旅ニ致スモノ五千余人。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、我等ハ右条項ヲ確守シテ所期ノ目的ヲ貫徹スベク、茲ニ一死以テ精神的契約ヲ為スモノ也。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "山則ニ依ッテ罰スモノ也　　　　　　　　　　　　　　　　　　東光坊役僧｜了範　と読まれた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "官辺でも、折紙付きの毛無シ虎には、手を焼いていたところだし、吟味役人から牢番にいたるまでが、ことごとく楊志の同情者であったことも、情状の酌量を容易にしたらしく、「――北京ノ地へ流罪トナシ、大名府留守司ノ軍卒ニ貶スモノ也」　これが、罪の判決であった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マスモノ　五穀の總稱として桝物といふ語がある（土佐方言の研究）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マスモノ　五穀の総称として桝物という語がある（土佐方言の研究）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――が、我聞く、天下ニ仁政ヲ施スモノハ人ノ祭祀ヲ絶タズ――と」「…………」　曹操は、何とかして、陳宮を助けたいと思っていた。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
