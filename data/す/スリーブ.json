        "examples": {
          "standard": [
            {
              "text": "レコードを傷から守るために、内側の保護スリーブを新しいものに交換した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "トレーディングカードを汚れから防ぐため、二重のスリーブに入れて厳重に保管している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "コーヒーショップで熱いカップを持つための段ボール製のスリーブをもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それはピゲエの千九百四十二年の｜変り型なんだよ」「あら、そうなの」　おチビさんは機嫌をなおして、鏡にむかって裾をひっぱったりスリーヴをなでたりしはじめた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネガは特注して作った透明なヴィニールのスリーヴに入れなおす。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十六枚撮りを六齣（こま）ずつ切って、一本を一枚のスリーヴに収める、というのが原則だけれど、戦後はいろんなフィルムを使ってるからね。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "35ミリ以外はいまある既製品のスリーヴを使う。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "使えばもとのところに戻さないし、スリーヴは破れてめちゃくちゃ、切り離した無数の齣が無数の封筒に入れられて、箱や袋のなかに詰まっている。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネガを入れたパラフィン紙のスリーヴは、どれもみな変色し、破れ果てていた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "フレンチ・スリーヴを私が着ると、いやらしくなるのよ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡い水色のショート・パンツに、たいへん薄い黄色のフレンチ・スリーヴのシャツを着て、花模様のハンカチで髪をうしろに束ねていた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
