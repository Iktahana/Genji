          "literary": [
            {
              "text": "が、体の弱いツルゲーネフはすっかり打撃をうけ、しかも居住制限によってその後何年か自分の領地スパツコイエに釘づけにされるという不法の拘束をうけたのであった。",
              "citation": {
                "source": "ツルゲーネフの生きかた",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "振返つて、いきなりスパツと相手の頬に平手打ちを喰はせるスミ。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……どうだ留さん、君ひとつ、スパツと金を出して、製板へ乗り出して見ちやあ？",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早いとこスパツと帰つて来ねえかのう。",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴の上にはスパツツをかぶせました。",
              "citation": {
                "source": "佐渡が島のこと",
                "author": "江南文三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
