    "definitions": [
      {
        "index": 1,
        "gloss": "common purslane (Portulaca oleracea)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭の隅に自生している滑りひゆを摘んで、お浸しにして食べてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "滑りひゆは雑草として扱われることが多いが、実はオメガ3脂肪酸を豊富に含んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "炎天下でも枯れずに地面を這うように広がる滑りひゆの生命力には驚かされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ことに蜀葵、すべりひゆの眩い程の群団、大きな花のかたまりを持つ青紫の紫陽花等は、見事であった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそれ以外の食物は、すべりひゆと筍――長くのびた奴の頭のほう二寸ばかり――に昼顔の葉である。",
              "citation": {
                "source": "飢えは最善のソースか",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私などの郷里では畠に夏生える草の「すべりひゆ」を蛸草またはタコといっていた。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンボは九州の北部、筑後の三池郡などで、メハリコンボというのがまた「すべりひゆ」のことである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
