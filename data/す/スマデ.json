          "literary": [
            {
              "text": "）と、思う胸騒ぎを、じっと抑えて、読み下すと、アスマデニ三〇〇エンツゴウシテクレ、イノチガケニテタノム、アネ　と、いう電文だった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンクリートヲ乾カスマデニ時間ガカヽルンデ、今カラ工事ヲ始メテモ完成スルノニ四カ月グライカヽルソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神慮ニ任セ、闇々トシテ明ケ暮スマデ也。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
