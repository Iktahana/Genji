        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昔し其國王と二弟がスクタリ砦を立てた時晝間仕上げた工事を夜分鬼が壞して已まず。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで僕は翌日女をスクタリへ連れて往つて、そこに終日ゐると云ふことになつた。",
              "citation": {
                "source": "不可説",
                "author": "UNERKLARLICHT!",
                "note": "青空文庫"
              }
            },
            {
              "text": "スクタリの墓地は実に立派な所である。",
              "citation": {
                "source": "不可説",
                "author": "UNERKLARLICHT!",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は度々スクタリで話をした時の事を思ひ浮べて見た。",
              "citation": {
                "source": "不可説",
                "author": "UNERKLARLICHT!",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで僕はジユリエツトの姿、薔薇の谷の小さいトルコの珈琲店、糸杉の木、スクタリの柱形の墓石、ベゼスチンの刀剣商を思ひ浮べるのだ。",
              "citation": {
                "source": "不可説",
                "author": "UNERKLARLICHT!",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
