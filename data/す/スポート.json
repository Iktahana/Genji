        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "云いつけると、外交部から交付される筈の、外国へのパスポートまで、ちゃんと、印まで間違いのない印を捺して拵えてきた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、日本でパスポートがおりない者でも、ここで、支那人に化けて、支那の名前をつけさえすれば、陳の手でロシヤへのだって作ることができた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩餐会で腹をかかえて哄笑するのもキュラソのビンで自分の肖像のどてっ腹に穴をあけるのも、工場と富とを投げ出してギャングの前にたたきつけるのもみんな自由へのパスポートである。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きるものの証である生命のパスポートの最終ページには、地獄行きか天国かは知らないが、ともかくもあの世行きの出国スタンプがあらかじめ押してある。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "立派な生れで立派な教育のある男なんだが、競馬ですっかり失敗して、今ではロンドンのスポート倶楽部で、内々小さな賭事の胴元をやって暮してるということだ。",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷物を税関に運んで、調べて貰ふ間にパスポートにスタンプを押して貰ひました。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パスポートを調べられるのは勿論ですし、所持金まで聞かれました。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "本場で寒中用、スポート用ですから内側が暖く出来ていて、編上げだから丈夫ですし。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、宿の主人やってきて、パスポートを渡しいろんなことを喋った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニングラードへ独り出て銀行、パスポートその他やってかえって来る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "食後、Ｙパスポートの為に大使館へ行く。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十五日（月）　パスポート出国許可が出来て居ないと駄目というので、Ｙ、ВОКС へ出かける。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の間切符しらべパスポートしらべその他おちおちねて居る暇もなかった。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○アオムスでパスポートの後からシールをこわして居住証をはがされたときの感じ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スポートのことかいていた時代から見ると小説達者になって、そして、活々とした、しな、になった。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、そういうようなやつらにとっちゃあ、山登りは趣味だの、またスポートだのって思ってはいないかも知れないぜ。",
              "citation": {
                "source": "涸沢の岩小屋のある夜のこと",
                "author": "大島亮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スポート、趣味、勿論そうじぁないだろう。",
              "citation": {
                "source": "涸沢の岩小屋のある夜のこと",
                "author": "大島亮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺だっていま現在、俺の山登りはスポートだとも思ってやしないし、趣味なんかでもないや、なんだかわからないが、そんなものよりもっと自分にピッタリしたもんだ。",
              "citation": {
                "source": "涸沢の岩小屋のある夜のこと",
                "author": "大島亮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伸子、きのうパスポート（旅券）の査証をし直しに行ったのかい？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――パスポートを持って歩いてたのか？",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "上海は、租界なるものがあるために、パスポートなくして上陸出来る恐らくは世界で唯一の海港であろう。",
              "citation": {
                "source": "上海の渋面",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "海からはパスポートなしに上陸されるが、上海の上空は一層無防禦で各種のラジオ放送が自由に流れこんでくる。",
              "citation": {
                "source": "上海の渋面",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は春先きのことで、ウィンタースポートの連中は、みんな帰ってしまった後だから、大抵の宿は閉まってて、停車場のトレーガーに聞いて見たが、泊ろうと思っていたワルトハウスに行くことが出来なかった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "卒業免状は、いはば、入国困難な国へ足を踏み入れる、パスポートでしかないんです」「講義をはじめる」　と、守屋教授は、静かに、ノートのペーヂを繰つた。",
              "citation": {
                "source": "計算は計算",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "パスポートに判を捺すのとはどつちが楽だ？",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャルロッタ　（思案のていで）わたし、正式のパスポートがないもので、自分が幾つなのか知らないの。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に、作品に描いてある諸事実が事実としてプロバブルなパスポートを持っているだけにとどまっていて、それらの客観的な実在についてまったく疑いを※しはさむ余地が起り得ないほどに煮つまったものでないことである。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "広大号を選んだ理由は、中国船に乗れば苦力同様パスポートがいらないし、第一船賃がうんと安かったからだ。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の大型無線機は外界との交信を行い、報道機関向けのレポートをマサチューセッツ州キングスポート岬にあるアーカム・アドヴァタイザー紙の強力な無線局に送信するものとなっていた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーカム号はキングスポート岬局に即刻中継のこと。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
