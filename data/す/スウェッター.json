          "literary": [
            {
              "text": "お嬢さんはニッカースもスウェッターもまっ白にした。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢さんの赤くほてった頬が、白い雪と、白いスウェッターと、白い帽子とに、可愛らしく輝いた。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いスウェッターの襟から、下に着た赤いスウェッターがチラリと見えている。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は固い布団の中から、スウェッターを頸にまいた頭だけ出して、半分ウトウトしながら話を聞いていたが、何でも年内に婚礼があるので村中でその準備をしていると、急病人が出来て死んだ。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
