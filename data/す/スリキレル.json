        "examples": {
          "standard": [
            {
              "text": "長年愛用しているジーンズの膝が、ついに擦り切れる寸前だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "靴の底が擦り切れるほど、営業のために街中を歩き回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「袖口が擦り切れるまで着てくれて、服も本望だろうね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "服が擦り切れると、これは兎の皮で代りを作りました。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "プウランジって言ったものですけれどね、擦り切れるなんていうことはありませんでしたよ」「まったく、もつにゃもった。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴の底がすり切れるまでほうぼうの事務所の階段を上ったり下ったりしました。",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分を打ちあて輝かせるものを失うわけ、それですり切れるか、益※輝くか、此が自分の天才の星によって決せられる処ではないか。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルセットが古くなってすり切れると、すぐに裂けそうなキャラコの布でつぎを当てた。",
              "citation": {
                "source": "レ・ミゼラブル",
