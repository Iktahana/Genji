    },
    "definitions": [
      {
        "index": 1,
        "gloss": "garden sorrel (Rumex acetosa)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供の頃、帰り道で見つけた酸模の葉を噛んで、その独特の酸味を楽しんだものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "酸模はシュウ酸を多く含んでいるため、大量に摂取すると健康に影響が出る可能性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "野原に自生している酸模の赤い花穂が、夕日に照らされて美しく輝いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "……　松杉、田芹、すつと伸びた酸模草の穂の、そよとも動かないのに、溝川を蔽ふ、たんぽゝの花、豆のつるの、忽ち一｜所に、さら／＼と動くのは、鮒、鰌には揺過ぎる、――昼の水鶏が通るのであらう。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこな、酸模、蚊帳釣草の彼方に、きれいな花が、へ、へ、花が、うつむいて、草を摘んで居なさるだ。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢名は酸模または※蕪である。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "■　菠薐草――酸模っていうのは、あたしのことよ。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "酸模――うそよ、あたしが酸模よ。",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもなければ、しゃがんで、酸模を、また細かな砂を指の先でほじくっている。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "信州の下水内郡のイタズイコなども、スイコは東京でいうスッパグサ即ち酸模のことであるらしいから、イタドリのイタは元来独立して、この植物を意味していたのかも知れぬ。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから山ズイコ、木ズイコ、棒ズイコは明白であるが、北安曇のカラスッパも同じく稈酸模で、この種の特徴が長大にして幹を存する点にあるからであろう。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも竹のような酸模ということで、元はそれぞれ何とかいう名があったろうと思うのに、こうしてよく似た動機に基いて、新らしい方言を造っているのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧語保存　虎杖を信州更級などでウマズイコ、上総の望陀方面でウシノスカッポというに対立して、自分の生地中部播磨では酸模をウシダンジと称し、ダンジは即ち虎杖のことであった。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋田県の鹿角地方でこの草をマンジュシカシカと呼ぶのも、マンジュは不明だがシカシカはすかな（酸模）という草の方言だから、やはり酸いという所から付けた名である。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "花のき村の入り口のあたりは、すかんぽやうまごやしの生えた緑の野原で、子供や牛が遊んでおりました。",
              "citation": {
                "source": "花のき村と盗人たち",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ではすかんぽといふ。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その「すいは」と云ふのはここに云ふすかんぽではない。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この川に添うて、またかのすかんぽが簇生して居り、幼年の者しばしばそれを嗜むのである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる因縁の有るすかんぽだから學校の庭にそれを見付けると、ああこんな處にも生えてゐると思つて、なつかしく感じたわけであつた。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これだけの事を思ひ出すのも、これから話すすかんぽからの聯想ゆゑである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の流の一方にさはさはと、其すかんぽの一群が繁茂してゐたのである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すかんぽに關する第二の話は正味これだけである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月、すかんぽの花のくれなゐ。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所がすかんぽの話に後日譚が湧出した。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで最後に殘つたすかんぽの話へと急ぐ。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大學構内の公開の場所には今やどこにもすかんぽは見つからなかつた。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すかんぽの話は之を以て終る。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「や、すかんぽだ、すっかり枯れてる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "や、また、すかんぽだな。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎杖とすかんぽばかりだな。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "木柵、木柵、木柵、　海老茶だ、あ、すかんぽだ、あ、お襁褓だ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほう、すかんぽだ、枯れ花だ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "すかんぽ、すかんぽ、紅更紗。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
