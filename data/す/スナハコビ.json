          "literary": [
            {
              "text": "料理当番のほか、総員、砂運び作業にかかったのだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな、砂運びにせいをだせよ」　一同は、思わず笑顔になる。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、苦しい砂運びを、愉快につづけるのであった。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここから、砂運びをする人たちの、働くすがたを見ていると、みんな病人で、ゆるやかに動いている。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂運びをする人たちは、砂山つくりの目的に、身も心もうちこんで、全員一かたまりとなって、下痢や腹痛に苦しみながら、たださかんな精神力だけで、動作はゆっくりだが、たゆまずに進んでいるのだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "見はり番　砂運びは、朝から晩まで、八日間つづけた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            }
          ]
        }
