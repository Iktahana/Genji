        "examples": {
          "standard": [
            {
              "text": "晴れ渡った夏の海を思わせる、鮮やかなスカイブルーのワンピースがよく似合っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "部屋の壁紙をスカイブルーに張り替えたら、空間がパッと明るくなった気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スカイブルーのインクで綴られた手紙には、涼しげな近況報告が書かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "色は、陽ざしのなかで見るといっきに目が覚めるような、鮮やかなスカイ・ブルーだった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車とおなじようなスカイ・ブルーのパンプスであることに、ぼくはそのときはじめて気づいた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来は鮮やかなスカイ・ブルーだが、車体のペイントはいまではすっかり色あせていた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
