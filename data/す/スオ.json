        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドクトル、オルデスオル、パーポンは顔を上げた。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（第二回のところで「デツスオブダンス」とあつたのは「ダンスオブデツス」の誤りだつたと思ふから訂正する。",
              "citation": {
                "source": "海浜日誌",
                "author": "六月創作評",
                "note": "青空文庫"
              }
            },
            {
              "text": "と訊ねると、私がメイ子の家に置き忘れて来たフエンシング・スオルドだといふのです。",
              "citation": {
                "source": "東京駅にて感想",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が、その家を出て、この村に移つた時には、二つとも私の書斎に永い間壁飾りとなつて懸つてゐたアメリカ・インヂアンのガウンと一対の錆びたフエンシング・スオウルドだけが私の所持品だつたのである。",
              "citation": {
                "source": "歌へる日まで",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人は同時に私を指差し、「あなたの書斎の壁に懸つてゐる二つのフエンシング・スオウルドが僕等の主張に黒白をつけて呉れるでせう。",
              "citation": {
                "source": "歌へる日まで",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨ふり花咲いた　咲いたよ雨ふり　花が雨は　ふらないオヤ　ヤノヤ　「雨ふり花　なら　空見て　咲きな　お天気花　なら　河原で　咲きな　河原の　小石の　上で　咲きな」雨が　ふるかと雨ふり花は咲いた　咲いたよオヤ　ヤノヤ赤イガラス青イガラス赤イ赤イガラスオ顔ガ見エル赤イ赤イオ顔ガラスニウツルオ顔ハ赤イ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "青イ青イガラスオンナジオ顔青イ青イオ顔ガラスニウツルオ顔ハ青イ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "『黄銅時代』六を書き、ガルスオーシーのタッターデマリオンを少しよむ。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十二日（水曜）晴　プリンスオブウェールスの着京されるのを奉迎に行くと云って居るので、早く起きる。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、プリンスオブウェールス歓迎のアーチ、花電車を見に行く。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "馭者は鞭を鳴らせながら、「スオ、スオ」と声をかけた。",
              "citation": {
                "source": "馬の脚",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スオ、スオ」は馬を後にやる時に支那人の使う言葉である。",
              "citation": {
                "source": "馬の脚",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに馭者の「スオオ」と言ったのはまだしも俺のためには幸福である。",
              "citation": {
                "source": "馬の脚",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "遂ニ熄ムコトノナイ軋轢ニ　タチクラム濛気ノ中ヲ　荊棘ヲ※ツテ　起チナホル身ヲ震ハスオレダ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィンランド国――芬蘭土語ではスオミ、Suomi ――の首府へルシングフォウス――芬蘭土語でヘルシンキ――は、密林と海にかこまれた、泣き出したいほどさびしい貧しい町だった。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三はアデレード市（サウスオーストラリア州首府）、人口十八万一千二百八十五人。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、マスマスオコリマシタガ、シカタガナイノデ、オザシキノアンラクヰスニコシヲカケマシタラ、タウトウキモチガヨクナツテ、マユヲシカメタママネムリコンデシマヒマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "天然のアイスオーターでございます。",
              "citation": {
                "source": "職業（教訓劇）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「卵が神様ですか」「祭っている神様はアマテラスオオミカミ」　村長の御返事は川の流れのようにサラサラしたものであった。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカに置いて来た十九歳の娘を呼んで、共にミュンヘンにつれ帰ったが、丁度フランスオーストリアの戦争で、選挙公はミュンヘンから逃げ出したので、ルムフォードが選挙公の代理として総指揮官となり、ミュンヘンを防ぎ、中立を厳守して、フランスオーストリア両軍とも市内に入れさせなかった。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "スオウの煮出した汁で凧などが赤く染めてありますが、あのスオウで染めた木綿布をその時分はスオウとはいわずに茜染といって居った。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
