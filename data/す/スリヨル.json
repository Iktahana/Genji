    "definitions": [
      {
        "index": 1,
        "gloss": "to draw close to",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "野良犬が食べ物をねだるように、クンクンと鼻を鳴らして擦り寄ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "権力者に擦り寄って出世しようとする彼の態度は、周囲から白眼視されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "焚き火の暖かさを求めて、みんなが自然と火のそばに擦り寄る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」　と、つかつかと擦り寄ると、思わずたじろいで退ったが、「ああ、神様だ。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "微笑みながら擦り寄るたびに、たじたじと退って、やがて次の間へ、もそりと出る。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "参木はやがてお柳が自分に擦り寄るであろう誘いをお杉が自分にするものとして思いたかった。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、良人の扇折りの机へ擦り寄るなり、夫婦は、しびれたように、二つの顔を寄せ合って、扇の文字に、一とき、息も絶えたような容子であった。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、彼は飛鳥のように身をかわして、出入口にすりよると、警備隊と入れかわって、さっと外にとびだした。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "何て名なのお前さん」「――ろく――ろくってんだけど……ね、あのね」　ろくは、せきにすりよるようにし、真心を顔に現わして訊いた。",
              "citation": {
                "source": "小村淡彩",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　われわれが卓子へすりよると、彼は次ぎのやうに語りはじめた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛇の感じで、地べたを這つてすりよる感じ、細い目が底光りをたゝへてゐる。",
              "citation": {
                "source": "暗い青春",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "すりよるヒロシの体臭が不快であつたが、それを邪慳にするだけの潔癖もなかつた。",
              "citation": {
                "source": "母の上京",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "高速艇がそばへすりよると、白い鉄兜をかぶった背の高い海兵がランチへ飛び移ってきて、運用長になにかいっている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹童、耳を……」「はい」　とすりよると、果心居士は白髯につつまれた唇からひそやかに、二言三言の秘策をささやいた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「万吉さん――」　いきなりすりよると、万吉の手を痛いほど握り取って、「な、なぜ、こうならこうと、明らさまにいっておくれでない。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "）夫人　（すり寄る）先生。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彦三郎　（すり寄る。",
              "citation": {
                "source": "權三と助十",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "李中行　（すり寄る。",
              "citation": {
                "source": "青蛙神",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（夫のそばにすり寄る。",
              "citation": {
                "source": "蟹満寺縁起",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでまたしても逢ふほどの哥薩克たちを残らず寄せ集めて、飲めや唄への乱痴気さわぎをおつぱじめて、銭をばら撒く、火酒は浴び放題……美しい娘つ子には、そつとすり寄るやうにして、リボンだの耳環だの頸飾だのを、もてあますほど呉れてやる！",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "十本あまりの毒刃は、ズ、ズ、ズと、趾先ですり寄る刺客たちと一緒に、二人の前後に押し迫る。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａ、Ｂは旅人の傍にすり寄る。",
              "citation": {
                "source": "旅人（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（すり寄る）栄二　こら（つき飛ばして）彼方へ行け！",
              "citation": {
                "source": "女の一生",
                "author": "五幕七場",
                "note": "青空文庫"
              }
            },
            {
              "text": "文六　　（何かしら、思ひ当つたやうに、慌てゝ表に飛び出し）廉坊、廉太、おうい、廉坊……（声がだんだん遠くなる）おちか　　（京作の方にすり寄る）京作　　（遂におちかを抱きかゝえる）おせい　　（逃げるやうに走り出で）お父ツつあん……（泣き声になる）文六の声　　（遠くの方にて）廉坊……――幕――",
              "citation": {
                "source": "麺麭屋文六の思案（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "乾はそのほうをチラリと見送ってから、葵のそばへすり寄るようにして、「ちょっといないたって、そんなにしょげるテはないでしょう。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、すり寄るように、体は戸棚の前へ近寄った。",
              "citation": {
                "source": "おせん",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            },
            {
              "text": "つなと名乗る女は、膝ですり寄るようにしながら云った。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はなにか言おうとするように見せかけて、玉藻のそばへひと足｜摺り寄ると同時に、手に持っている太刀を颯とひらめかせると、刃は空を切って玉藻の姿は忽ち消えた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はなにか言おうとするように見せかけて、玉藻のそばへひと足摺り寄ると同時に、手に持っている太刀を颯とひらめかせると、刃は空を切って玉藻の姿は忽ち消えた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "）おつや　（摺り寄る。",
              "citation": {
                "source": "影",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔から男おんなの影法師は憎いものに数えられているが、要次郎とおせきはその憎い影法師を土の上に落としながら、摺り寄るように列んであるいていた。",
              "citation": {
                "source": "影を踏まれた女",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれ、三五郎さん、惡いのはお前さんぢやない、――どうぞ私を」　お貞も一緒に縛られて行くつもりでせう、後ろに手を廻して、困じ果てた八五郎の膝に摺り寄るのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "百足屋殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "さア」　お市は大地に膝を突いたまゝ、喜三郎の足許に摺り寄るのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "三つの死",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
