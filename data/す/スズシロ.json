[
  {
    "uuid": "08f8f150-9ae7-5c12-aa69-64da6f9f18c2",
    "entry": "蘿蔔",
    "reading": {
      "primary": "すずしろ",
      "alternatives": [
        "らふく"
      ],
      "is_heteronym": true
    },
    "grammar": {
