          "literary": [
            {
              "text": "「スムーロフ、やっつけろ、くらわしてやれ！",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、左ききのスムーロフは言われるまでもなく、すぐにまた復讐をした。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、またみんなでやっつけろ、スムーロフ、やりそこなったらだめだぞ！",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやだって言ったら、君はぶんなぐられるよ」とスムーロフが大きな声で警戒した。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕だってスムーロフの頭へ当ててやったんだ！",
              "citation": {
                "source": "カラマゾフの兄弟",
