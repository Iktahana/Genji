          "literary": [
            {
              "text": "きょうは君のスウェエデン風の斬髪を拝見するね。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢を見ているように美しい、ハムレット太子の故郷、ヘルジンギヨオルから、スウェエデンの海岸まで、さっぱりした、住心地の好さそうな田舎家が、帯のように続いていて、それが田畑の緑に埋もれて、夢を見るように、海に覗いている。",
              "citation": {
                "source": "冬の王",
                "author": "ハンス・ランド　Hans Land",
                "note": "青空文庫"
              }
            },
            {
              "text": "一団の低い家々の真ん中にあって、木で葺いた塔が、砂浜とスウェエデンの海岸とを見渡していた。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "トニオ・クレエゲルは砂に坐ったなり、その漁船に背をもたせていた――スウェエデンの海岸でなく、ひろびろとした水平線が眼に入るような向きに。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラットシュトレエムは、防水布の廂の突き出たスウェエデン式の水夫帽を、おれは丸いヘルゴランド風の毛の鳥打――いわゆる大黒頭巾というやつを。",
              "citation": {
                "source": "なぐり合い",
                "author": "WIE JAPPE UND DO ESCOBAR SICH PRUGELTEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
