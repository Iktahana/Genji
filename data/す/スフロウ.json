          "standard": [],
          "literary": [
            {
              "text": "オテル・スフロウの二階で近いスルボン大学の鐘を聞き乍ら病院に居る様な気持で白い寝台の上から窓を眺めた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一月十六日）（三）　パンテオンの側のオテル・スフロウに泊つてから一箇月近く経つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其頃のスフロウは随分きたない宿だつたと聞くが、今は電灯やスチイムの設備も出来て居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
