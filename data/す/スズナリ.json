        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人気アーティストのライブ会場は、開演前からファンの人々で鈴なり状態だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "セールの始まったデパートの入り口には、開店を待つ買い物客が鈴なりに並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "通勤ラッシュ時のホームでは、電車が到着するたびに人が鈴なりになって乗り込んでいく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
