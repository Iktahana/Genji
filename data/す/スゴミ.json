[
  {
    "uuid": "a7a6b2e2-368e-5fd2-86fe-c994b1352c36",
    "entry": "凄み",
    "reading": {
      "primary": "すごみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
