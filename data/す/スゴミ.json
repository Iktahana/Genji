        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「いやいや、大して違ひはありますまい」と語尾を上げて、爺々ィが云つた、「音羽屋の方が所作はうまいかしれないが、ハリマ屋の方はスゴミがあるツ。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論、喧嘩なんぞは絶対に出来ないヘロヘロ腰の臆病者で、精神的のスゴミなんぞはミジンもない。",
              "citation": {
                "source": "実さんの精神分析",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜間金太郎氏の演出なぞは素人眼にはスゴミが横溢しているようであるが、よく見ているとそのスゴ味は金春一流の意識的な気合い（アテ気と言っては過ぎる）から生まれたものであることが次第次第にわかって来る。",
              "citation": {
                "source": "実さんの精神分析",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その点古橋は野性的で未完成のスゴミがある。",
              "citation": {
                "source": "スポーツ・文学・政治",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝煙の中に立つたお咲は先刻よりもつと、スゴミのあるぎらぎら眼になつてゐた。",
              "citation": {
                "source": "命",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
