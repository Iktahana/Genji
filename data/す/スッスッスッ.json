        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "廊下に跫音、ばたばたと早く刻んで、羽織袴の、宝の市の世話人一人、真先に、すっすっすっと来る、当浪屋の女房さん、仲居まじりに、奴が続いて、迎いの人数。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "シルエットが不意に動き出し、スッスッスッと寝室を出て階段を下りアトリエの中央に立つ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長五郎が右へジリッと廻り込み、突き出した刀がスッスッスッと揺れはじめる。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
