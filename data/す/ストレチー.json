        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ストレチーという伝記作家が「エリザベスとエセックス」というのを書いているのを片岡鉄兵さんが訳して其をもらいましたが、この人がポープをかいているらしい様子です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのポープの型にはまってしかも常識的なひややかな詩をストレチーはどう見ているのでしょうね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストレチーはヴァージニア・ウルフなどのグループに属していた人で、やはり歴史を心理的機微をモメントとして見る人です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今ストレチーの『クイーン・ヴィクトリア』をよんで居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃ツワイクの仕事、このザイレの本、イギリスのストレチーの「ヴィクトリア」をよみ合わせ、伝記又は伝記小説について、学ぶところがあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストレチー「エリザベスとエセックス」など。",
              "citation": {
                "source": "でんきアンケート",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストレチーにしたがえば、一五九四年六月、三人の男は橇につながれて、ホルボオンの博士邸の前を通ってチパーンの刑場に曳かれてゆく。",
              "citation": {
                "source": "せいばい",
                "author": "服部之総",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
