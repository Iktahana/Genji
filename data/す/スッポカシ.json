    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その周りに私をお嫁に貰って置きながら、すっぽかした男がうようよ居たわ。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼間セントルイスでは約束をすっぽかしたが、もう亭主の所を飛び出して来た芳子には自分の所しか行く所がない。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人もの中で姫君と言わせている守の秘蔵娘があるそうです」「しかしだね、初めから申し込んでいた相手をすっぽかして、もう一人の娘に求婚をするのも見苦しいじゃないか。",
              "citation": {
                "source": "源氏物語",
                "author": "東屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ドームを借り切った電脳遊園地という名のはでな発表イベントを南野陽子がすっぽかし、宣伝担当が宮沢りえに、さらに観月ありさへと移り変わったあのマシンだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっぽかしちまえよ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ君、だからソバケーヴィッチなんかすっぽかしちまってさ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロッパから最近帰って来たある日本人が、今日の日本をみて、みんなの生活が無計画で、食えないといいながらたかいタバコをプカプカふかしている、政府はから約束をして、内閣がかわればそのまますっぽかしている。",
              "citation": {
                "source": "新しい卒業生の皆さんへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、最もおどろくべきことは、政治の面で、内閣のからやくそくとすっぽかしに対して、わたしたちの抗議がどんな形で示されているかまるで知らないことです。",
              "citation": {
                "source": "新しい卒業生の皆さんへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お前さん槍祭あすっぽかしけえ？",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "槍祭夏の夜話",
                "note": "青空文庫"
              }
            },
            {
              "text": "掃除をすっぽかして横になる。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六日から月番という当番で、隣組全体に関係するから、すっぽかしがきかず時間的に私一人ではやれないので、咲が十七日頃来るのでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "立役は一人の背に負わされていても、何かの必要から一旦舞台へ立ったら、仮令椅子の足になっても、心をすっぽかしていてはなるまい。",
              "citation": {
                "source": "印象",
                "author": "――九月の帝国劇場――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日すっぽかしては自分向ける顔なし。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっき覚えるともう今皆どっかへすっぽかして来るんですからね。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾世川は昨日稽古をすっぽかしたことを頻りに弁解し、「どうです、よかったらこれから少し埋め合わせしましょうか」と云った。",
              "citation": {
                "source": "帆",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、会うとあれ程よろこびで輝くような父が、誕生日を楽しんで宏子が祝おうと思っていることなど自分から忘れて、すっぽかして行ってしまったところ、母もすっぽかして留守にしているところ、そういう点で、宏子は何か両親とは一致し切れない感情の肌理をもっているのであった。",
              "citation": {
                "source": "雑沓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "構わないから、すっぽかして、出てしまった方がよくはないか。",
              "citation": {
                "source": "常識",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "わざと、電話もかけないで、一晩すっぽかしてやったが、翌朝行ってみると、あの人はけろりとしていた。",
              "citation": {
                "source": "好人物",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "第十四章　第一撃　私はのっぽのジョンをすっぽかしてやったのがひどく嬉しかったので、愉快な気持になって、自分の今いる奇妙な土地を多少の興味をもって見※し始めた。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなフォン・ゾン式を発揮して、うまうまお食事をすっぽかして来たんだい？",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして君らはおれをすっぽかしたんだ？",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、彼らの中で少しは年功もあり、地位もあるような連中は、申し合せたように、みんなすっぽかしてしまった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがどうでしょう、悧口じゃありませんか、どのみち、事面倒と見たから、あの方は、その晩のうちにこの土地をすっぽかしてしまいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いないとすれば、ドコぞへすっぽかしたのか、そうでなければ向うの岸へ舟を渡して行って、向うからまた人をその舟へ乗せて渡るという段取りだろう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "俊亮は格別彼をちやほやするのでもなく、どうかすると、公園につれて行ってやる約束をしておきながら急用が出来たと言っては、彼をすっぽかしたりするようなこともあった。",
              "citation": {
                "source": "次郎物語",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっぽかしはあやまるぜ。",
              "citation": {
                "source": "つゆのあとさき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、貧乏な詩人仲間は東京の下宿を食いつめると、地方にいる投書家詩人で比較的余裕のある家に、一月とか二ヵ月とか滞在して食い延しをし、帰京後は先の下宿をすっぽかして新しく宿をとる転換期を用意していたものだ。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、貧乏な詩人仲間は東京の下宿を食いつめると、地方にいる投書家詩人で比較的余裕のある家に、一と月とか二か月とか滞在して食い延しをし、帰京後は先の下宿をすっぽかして新しく宿をとる転換期を用意していたものだ。",
              "citation": {
                "source": "わが愛する詩人の伝記（三）",
                "author": "――萩原朔太郎――",
                "note": "青空文庫"
              }
            },
            {
              "text": "応接室につめかける雑誌記者に締切りを控えての居催促を裏口からすっぽかして遊里にかくれたり……」　当時を吉川さん自身が『忘れ残りの記』にかいているような場合、僕はいつもその飲み歩き――のお伴だった。",
              "citation": {
                "source": "吉川さんの声と眼",
                "author": "平野零児",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
