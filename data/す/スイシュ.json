[
  {
    "uuid": "30729d21-7e08-54a4-8924-155d92593e0b",
    "entry": "水腫",
    "reading": {
      "primary": "すいしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
