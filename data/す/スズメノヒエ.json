        "examples": {
          "standard": [
            {
              "text": "雀の稗は生命力が強く、どんな荒れ地でもたくましく根を張っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "道端に生えている雀の稗の穂を指でなぞると、ザラザラとした感触がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「畑の隅に雀の稗がはびこっていて、草むしりが本当に大変なんだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その菫もどんな貧弱な花でもつけているのはまだよい方で、中には菫か雀の稗か分らぬようなものもある。",
              "citation": {
                "source": "科学と文化",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
