        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "わたくしは既に梅泉の生歿年を明にし、又｜略その江戸に来去した月日を推度した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "読詩の妙は漸々遅々たる推度の裡に存す。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "讀詩の妙は漸々遲々たる推度の裡に存す。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
