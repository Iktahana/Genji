        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "相手の方から誘ってくるとは、まさに据え膳という状況で彼は困惑した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "隙だらけの彼女の態度は、彼にとって据え膳も同然だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "誘惑に負けそうになったが、据え膳に乗るような真似はプライドが許さなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
