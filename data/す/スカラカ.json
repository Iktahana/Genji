        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まかり出でたるキチガイ坊主……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スカラカ、チャカポコ外聞晒す。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "たたく木魚に尋ねてみたら……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタ一人のスカラカチャンだよ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏も素性もスカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナント恐ろし地獄の話じゃ……スカラカ、ポクポク。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチガ――ア――イ――地イ獄ウ――……スカラカ、チャカポコチャカポコチャカポコチャカポコ……　　　　　　　一　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……スカラカ、チャカポコチャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけのわからぬ物じゃとわかる……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがホンマの阿呆陀羅経だよ……スカラカ、チャカポコチャカポコチャカポコチャカポコチャカポコチャカポコ……　　　　　　　二スカラカ、チャカポコチャカポコチャカポコチャカポコ……　▼あ――ア――ああア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "日々に明るく輝やき渡るよ……スカラカ、チャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチガイ地獄のイロハのイの字じゃ……スカラカ、チャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "言えぬどころか、今少と非道いよ……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スチャラカ、チャカポコチャカポコチャカポコ……　　　　　　　三……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "九尺二間に雨戸が二枚じゃ……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテモ気楽なキチガイ医者だよ……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテモ恐ろしキチガイ地獄じゃ……スカラカ、チャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "地獄ゥ――めぐりィ――はァ――サテこれェ――かァ――ら――じゃァ――い……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコチャカポコチャカポコチャカポコチャカポコ……　　　　　　　四　▼スカラカ、チャカポコチャカポコチャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……スカラカ、チャカポコチャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞いたらビックリ……スカラカ、チャカポコチャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャチャラカ、チャカポコチャカポコチャカポコチャカポコチャカポコ……　　　　　　　五　▼スカラカ、チャカポコチャカポコチャカポコチャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "切羽、詰まった大罪犯す……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチガイ地獄のドン底地獄じゃ……スカラカ、チャカポコチャカポコチャカポコ……　　　　　　　六　▼チャカポコチャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きて出られぬキチガイ地獄じゃ……スカラカ、チャカポコチャカポコチャカポコ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "精神病医の手品の種だよ……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはドウジャと魂消るばっかり……スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコ……　　　　　　　七　▼スカラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
