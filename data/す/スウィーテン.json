        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "最後の希望としてライデンで高名なファン・スウィーテンが呼ばれた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　少しのあいだ考えてファン・スウィーテンは招聘を受け入れ1745年夏にウィーンに到着した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンはブールハーフェの弟子の１人で多分もっともお気に入りだったであろう。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンはライデンで診療し大学で非常に素晴らしい講義を行った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブールハーフェが死去したときにファン・スウィーテンは大学を去らなければならなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンは学生たちをなだめ法律に従わないわけには行かないと説明した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かブールハーフェと親しい人がいるとしたらそれはファン・スウィーテンであった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "女帝の主治医としてウィーンに着くとファン・スウィーテンはすぐに帝国首都ウィーンで講義を始めた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィーン滞在が４年になる前に女帝はファン・スウィーテンにこの目的のための提案を作成するように依頼した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "1749年１月にファン・スウィーテンは覚え書きを女帝に提出した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ女帝命令でファン・スウィーテンは学部の指導者および総裁に任命された。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国人のファン・スウィーテンによって地位を奪われることに反対した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンは解剖学講座と外科学講座を分離した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "1754年にファン・スウィーテンの学生仲間であったデ・ハーエンが帝国首都に来た。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "古いライデンからの幹はファン・スウィーテンによって育てられ新しい若枝を出した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "この任務におけるファン・スウィーテンの活動はこれまで述べた広範な改革で終わりはしなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "医学関係の仕事だけでなくファン・スウィーテンは他の領域のことでも忙しかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "国家の中に国家があり政府権力に匹敵するものがあってはならないというのがファン・スウィーテンの方針であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィーン国立図書館には3120編の論文についてファン・スウィーテンが検閲官として書いたノートがありこのうち595編以上は刊行を拒否された。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンの毎日についてその当時の記載がある。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンの業務は純粋な科学ではなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ファン・スウィーテンの死去によって今日の午後に私が受けた損害は私のすべての喜びを悲しみに変えた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ファン・スウィーテンが死去して私はますます寂しく思っている。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日はファン・スウィーテンが死去した信心の日で私にとって彼は特別に取り返しのつかない喪失である。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンと同じようにデ・ハーエンはオランダ人でカトリックでブールハーフェの弟子であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "デ・ハーエンはファン・スウィーテンよりほんの４歳だけ年下であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンの頭部は自信を持った気品のある男のものである。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンとデ・ハーエンのような強い個性を持った２人は学派を作るであろうことが期待できる。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンの弟子の１人であるクランツは外科学と助産学を学ぶためにパリに送られた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の弟子のシュテルクは教師としてだけでなく宮廷医としてファン・スウィーテンの後を継ぎ薬使用の知識を進歩させるのに特に優れた仕事をした。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
