          "literary": [
            {
              "text": "スリヌギ　稗の粉の最も精選したものを佐渡の外海府などではスリヌギと謂ふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤兒の乳の代りに用ゐ、又病人も稗のスリヌギを食べても全快せぬやうなのは、醫者に見せても見込は無いと謂つて居た。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "スリヌギ　稗の粉の最も精選したものを佐渡の外海府などではスリヌギという。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤児の乳の代りに用い、また病人も稗のスリヌギを食べても全快せぬようなのは、医者に見せても見込みはないといっていた。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
