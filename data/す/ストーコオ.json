        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「一八一八年十月十六日及び一八二一年五月五日の検診に対する備考」　一、十四日、午後五時、コンケラア号のストーコオを訪問。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストーコオ、君もたいへんなところへやってきたものだという。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ストーコオは皇帝派）。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストーコオが正直な臨床報告を出すと、総督派のアーノッドがかならず反対報告をするので困るという。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、ストーコオ、皇帝の希望によって専任になった由。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "三、十月十六日、午前十時、ストーコオと共にロング・ウッドへ行く。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストーコオの検案に同意、診断書に署名す。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ストーコオは一八一八年末までナポレオンの専任を担当していたが、「ナポレオンと親昵す」という理由で罷免され、一八一九年一月十日、トリコロール号でロンドンへ送還。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
