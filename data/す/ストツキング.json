          "literary": [
            {
              "text": "イギリスのブルウストツキングであるといふことだけは、間違ひないやうだ。",
              "citation": {
                "source": "音について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがもとになつて、かうした社交談話会を「ブリユー・ストツキング・クラブ」と呼ぶやうになり、そんなところへしげ／＼出入りをする婦人達をも、おなじやうな名前で呼ぶやうになつたのである。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが人夫でもなければ駅員でもなく、薄色のストツキングに踵の低い靴を穿いた細い足である。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長いストツキングを引つぱつて見たり。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
