  {
    "uuid": "d159c178-9723-5a9e-8799-a007e3aa7274",
    "entry": "擦り寄せる",
    "reading": {
      "primary": "すりよせる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-サ行",
      "inflections": null,
