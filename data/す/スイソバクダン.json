        "examples": {
          "standard": [
            {
              "text": "水素爆弾は、核分裂反応と核融合反応を利用した、極めて破壊力の大きい兵器である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "冷戦時代、世界は水素爆弾による全面的な破壊の脅威にさらされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「もし水素爆弾が使われたら、地球はどうなるんだろう…」「考えたくもないね。平和が一番だよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "原子爆弾だか水素爆弾だか、悪魔の発明にかかるものが、人類虐殺のために、明日の日にも落ちて来ないかと、漠然ながら今気遣っているのである。",
              "citation": {
                "source": "ペンクラブと芸術院",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に水素爆弾で大騒ぎをしているのは、それを作り得る国、アメリカ自身である。",
              "citation": {
                "source": "老齢学",
                "author": "――長生きをする学問の存在――",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学の発達は、原子爆弾や水素爆弾を作る。",
              "citation": {
                "source": "茶碗の曲線",
                "author": "――茶道精進の或る友人に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして水素爆弾にも関係はない、簡単にいえば疑心暗鬼にすぎない、ブラジルへいっても、北欧、南洋へいっても、おそらく心の安まることはないだろう、そう思ったけれども、むろん口にだしてはなにも云わなかった。",
              "citation": {
                "source": "おごそかな渇き",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
