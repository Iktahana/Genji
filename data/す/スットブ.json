        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夢中でゲームをしていたら、試験勉強の記憶がどこかへ素っ飛んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "貯金していたはずのお金が、一晩の遊びで素っ飛んでいった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼の姿は、人混みに紛れてあっという間に素っ飛んで消えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
