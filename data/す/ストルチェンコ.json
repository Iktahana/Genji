        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まあ、お聴き、イワン・フョードロッチ・ストルチェンコといふ、独身の古狸の手に握り潰されてゐるのに違ひないと、妾は睨んでゐます。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「叔母さん、それは僕が宿場で知合ひになつた、あのストルチェンコぢやありませんか？",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "二時間ばかりの後、馬車が玄関さきに停つた――いふまでもなくストルチェンコ家の玄関さきである。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            }
          ]
        }
