        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "会社に入って五年目、一九九〇（平成二）年に参加したピースボートの韓国クルーズは、大きな転機になりました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "設計事務所の日常に戻って間もなく、ピースボートのスタッフから連絡が入ります。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピースボートには、運営にあたる会社や恒常的な組織はありません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "遭遇したアメリカ海軍の航空母艦から飛び立った戦闘機は、ピースボートを敵に見立てて、爆撃の練習でもやっているとしか思えない飛び方をします。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポイントを突いて効果的に働きかければ、物事は動くというピースボートで味わった気分を、エキスパンドブックは久しぶりに思い出させてくれました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピースボートで知り合った研究者やジャーナリスト、自費出版でユニークな本を出している書き手たち三十人ほどに連絡を取り、電子本をどう見るか、出してみる気はないかをたずねて回りました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこだかわからないが自分の故郷は、石狩川の上流に在るような気がするから、そこに行ってみたら、何もかも解るに違い無い……といったような、タマラない悲壮な気持になりましたので、人知れず小型のカンバスボートや、食料などを買込みまして、無断で家を飛出しますと、一直線にエサウシの別荘に向ったものです。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹が立ち、彼等が作家のクラブであるスボートニク〔土曜集会〕を背景にしてのみニキーチナに対し個人的に自由に話したり喋ったり出来ないけちな心持で憤慨した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四日にスボートニックで日本文学の夕をする由。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤ブドー酒、オトカ、キューリ、カプースタ〔キャベツ〕、鶏、腸詰、クルミ、干アンズ、サモワール　○ニキーチナ夫人のスボートでは二十一日に話すことになった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月三十一日（土曜）　ニキーチナさんがなおってはじめてのスボート〔土曜集会〕であった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、胃の工合がわるいと云ったり、昨夜眠らなかったりでキゲンわるく、一時間おくれてスボートに行った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　アランと呼ばれるやうになつたのは、ポーの全集を編纂したグリスボートといふ男が故意に書き加へたことによつて初まつたのです。",
              "citation": {
                "source": "ポーの片影",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　ポーは斯く死後迄不幸な人だつたのです、殊に不幸の最大なるものは、その全集編纂が、「敵」であつたところのグリスボートの手に依つて為されたことです。",
              "citation": {
                "source": "ポーの片影",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
