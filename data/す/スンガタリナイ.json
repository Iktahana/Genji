        "examples": {
          "standard": [
            {
              "text": "急いで作ったカーテンだが、窓にかけてみると少し寸が足りない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "成長期の息子に去年のズボンを履かせたら、すっかり寸が足りなくなっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "材料をケチってしまったせいで、棚の高さが少し寸が足りない仕上がりになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「クセルクセスとか、すべてそういった役をするにはあの靴底直しでは寸が足りないという結論を、君にさせたのはね」「果物屋だって！",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はそれが手提袋を縫うのに寸が足りないと知ったら、代りに人形の着物を思いつこうというものだ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はそれが手提袋を縫ふのに寸が足りないと知つたら、代りに人形の着物を思ひつかうといふものだ。",
              "citation": {
                "source": "茶話",
                "author": "昭和三（一九二八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その形相、米友のことだから、仁王立ちとはいうものの寸が足りない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
