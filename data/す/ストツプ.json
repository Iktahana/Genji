        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私は祖父から教會にあるやうな立派な燭臺やストツプのついたオルガンを買つて貰ひ、母親の琴と、六段や春雨を合奏した。",
              "citation": {
                "source": "文學的自叙傳",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は祖父から教会にあるやうな立派な燭台やストツプのついたオルガンを買つて貰ひ、母親の琴と、六段や春雨を合奏した。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々の肩の間から事故の焦点を注視すると、交叉点のゴー・ストツプに故障が生じたのである。",
              "citation": {
                "source": "街上スケツチ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあ、ゴー・ストツプが眠つてしまつた。",
              "citation": {
                "source": "街上スケツチ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――街々の光りを映して流れる河のやうな往来は、もうそんなことには気もつかず、目眩しく、とうとうと流れて止まなかつたが、その真ン中の動かぬゴー・ストツプの上で、飽くまでも修繕の仕事に没頭してゐる係員のシヤツ一枚の姿が、夢幻的に、巨大な蛾のやうに見へた。",
              "citation": {
                "source": "街上スケツチ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「――ストツプ――タキシー。",
              "citation": {
                "source": "出発",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と私は何気なさゝうに応へてゐたが、ストツプの声を聞くと同時に夢中で石段を駆け降りた。",
              "citation": {
                "source": "サロメと体操",
                "author": "ヘツペル先生との挿話",
                "note": "青空文庫"
              }
            },
            {
              "text": "線路の十字路になつた、分岐点の処で、日本人の巡査がゴオ・ストツプの合図を不器用な手つきでやつてゐる。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "直吉は珍しいものでも見るやうに、暫く、その騒々しいゴオ・ストツプの合図に見とれてゐた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう少しだ、ストツプ！",
              "citation": {
                "source": "喧嘩上手",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　……（せつせと噛み込んでゐたが、息苦しくなつてハアハア言ひながら）……チヨツト、ストツプ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
