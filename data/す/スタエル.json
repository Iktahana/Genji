        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一人のスタエル夫人も、ジョルジ・サンドも、日本の近代文学はもっていなかった。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスでは、スタエル夫人をはじめ、日本の読者にもなじみの深いジョルジ・サンドなど。",
              "citation": {
                "source": "女性の歴史",
                "author": "――文学にそって――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして注目すべきことは、これらの婦人作家たちがスタエル夫人のほかはみんな中流階級の女性たちであったことである。",
              "citation": {
                "source": "女性の歴史",
                "author": "――文学にそって――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョルジ・サンドやマダム・ド・スタエルのないのはなぜか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸善へ行ったとき文芸評論のところ見ていたら『六つの肖像』という女のひとのかいた本があって、エリオット、ド・スタエル、マンスフィールド、オースティンその他の伝記があったの、十五円。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイツのロマンチシズムをフランスに紹介しナポレオンをひどくきらったスタエル夫人。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑場に於ける彼女の気高い態度、そして従容たる死に就いては、スタエル夫人も麗筆を振ひ、また手近かな所では漱石の所謂「仄筆」も振はれてゐる。",
              "citation": {
                "source": "ジェイン・グレイ遺文",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく引照せられるスタエル夫人の「全てを理解するといふことは全てを許すことである。",
              "citation": {
                "source": "婦人解放の悲劇",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
