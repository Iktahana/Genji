          "literary": [
            {
              "text": "スペシアル・ゲイシャ・ガールだ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、コロンビア会に彼がスペシアルゲストとして呼ばれて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "おひるになったんで御飯たべようとすると、いまはまだ食堂があいていません、というんで、高価いスペシアルを部屋へとったの。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでは腹張らず、今日のスペシアルの中、ボイルドビーフ、ブリスケット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スープ抜きで、毎金曜日のスペシアル、コーンビーフキャベッジ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
