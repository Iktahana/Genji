[
  {
    "uuid": "9fc73f60-78ba-5faf-bc9b-8ca7ac58a244",
    "entry": "済事",
    "reading": {
      "primary": "すみこと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
