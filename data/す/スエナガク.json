[
  {
    "uuid": "0fb16ecc-1940-5bd3-8240-c0bdc9a04db3",
    "entry": "末永く",
    "reading": {
      "primary": "すえながく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
