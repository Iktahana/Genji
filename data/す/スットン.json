        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし人類の生き残りの可能性がここ以外にないとすれば、いかにすっとんきょうであったとしてもこの道を切り開く以外にはない。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "御前だってお怪我の一つぐらいはなさるかも知んねえ、すこしも早くお屋敷へとすっとんでいったら、有がてえ！",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "横っ飛びにすっとんで来たが――若旦那」　と、いって、片手で、何かを拝んで「死んだ大旦那様の御加護だ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "餅は黒いかたまりになって線をひいてすっとんだ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉本は窓の外に身体を外らして雲のすっとんでいる怪しいこの空模様が川上忠一にこんな話題を憶い起さしたのか、それとも年に一度の身体検査にひねくりまわされた彼らの皮膚の、いやな感覚がそうさせたものかと思い、話手の顔を見なおした。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっとして身をねじると腹のあたりをかすって轟然たる響きとともに砂煙りを上げてすっとんで行く。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "チラホラ先へ行く旅人のなかに壺をしょって、恐ろしく早足にすっとんで行く若党姿を認めたのは与吉が六郷の川を渡って、川崎の宿へはいりかけたころだった。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "侍、いずくへまいった」「ソレ、とりにがしてはならぬぞ」「ナニ、拙者が見つけて、一刀両断に――」　提灯の灯といっしょに、司馬道場の若侍の声々が、妻恋坂をすっとんでゆく。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と里好はすっとんきょうな声を出した。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところを賊のやつ、一間ほどうしろとびにすっとんで、三尺の閃光、瞬間正眼に直したと見るや、「往生しろ！",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽系も、じつは銀河系の一つの星ですが、銀河のどのへんにある星だか、やがて分るでしょう」　ポーデル博士の話しているうちに、樽ロケットは何百万光年の空間をすっとんだ。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　警部は、すっとんきょうな声をあげた。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カズ子さん、このままあなたがこの小路を奥へ駆込めば、あなたの首はすっとんで、あたり一面はそれこそ唐紅ですぞ」「まあ、恐ろしいことを仰有る」「これを見てごらんなさい」　帆村は前へ三歩進んで、洋杖を前方へ斜に突出し、それから徐々にその洋杖を奥の方へ深入りさせた。",
              "citation": {
                "source": "千早館の迷路",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくらい頼みに思う教授が、糸の切れたたこのようにすっとんでしまって、いつまでたっても姿をあらわさないのであるから、気になって、しかたがない。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼は、畦道をすっとんで、舗道の上へおどりあがった。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにない洋酒をいうと、倉庫にあるから只今持ってまいりますと、奥の方へすっとんでいった。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ起きて待ってた松若さんが、すっとんきょうな声を立てました。",
              "citation": {
                "source": "千代次の驚き",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「勇ちゃんの角は強いなあ、辰ちゃんの一つしかないべいがすっとんでしまった。",
              "citation": {
                "source": "赤土へくる子供たち",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ふたりを辻番所へあずけて、すぐ赤坂御門へすっとんで行き、門帳をくりながら手きびしく突っこんで見ると、……いや、どうも、まんの悪いときはしょうがないもの。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "御代参の乗物",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ほんのちょっとでも箒の柄や柄杓をふりあげようものなら、悲鳴をあげて、戸口のほうへすっとんでゆくのだ。",
              "citation": {
                "source": "リップ・ヴァン・ウィンクル",
                "author": "ディードリッヒ・ニッカボッカーの遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "れいの古びたシルクハットは、とっくにどこかへすっとんだらしく、頭へのっかっていなかった。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、すっとん狂な声を立てて、Ｅ衛生曹長に飛びついた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめはおとなしくおとずれて、病気見舞にことよせて斬ってしまうつもりでいた計画も、たちまちどこかへすっとんでしまって、まなじりをつるしあげてキリキリと歯をかみならしました。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のうちによくかわいがって置いてやろう」　と言いながら、カラのべんとう箱をかかえて食堂の方へすっとんで行く。",
              "citation": {
                "source": "愉快な教室",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "すばらしい気合で、直衛の躯はすっとんだかとみえたが、すっとんだのは岡倉自身で、直衛はふわっと左へよけたまま向き直り、岡倉が「まいった」と叫んだ。",
              "citation": {
                "source": "改訂御定法",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "刀を上段にあげ、おがみ打ちの姿勢で、跳躍しながら踏み込んだが、半兵衛は少し身をひねっただけで、手にある刀がひらめいたと思うと、斬り込んだ相手はすっとんでゆき、襖といっしょに長四帖へ倒れた。",
              "citation": {
                "source": "艶書",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は右腕を曲げたまま獣のようにうめきごえをあげて横ざまにすっとんだ。",
              "citation": {
                "source": "合歓木の蔭",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽く躱す手や足が、みな要所に当るので、かれらは四五間もすっとんだり、みごとに転倒したり、こぶの八兵衛などは殺されるような悲鳴をあげたりした。",
              "citation": {
                "source": "雪の上の霜",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スットントン　漁師の一人娘で生れつきの盲目が居た。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時、近くの村の青年の寄り合いに雇われたが、案内に来た青年は馬方で、馬力の荷物のうしろの方に空所を作って、そこに座布団を敷いて、三味線と、下駄を抱えた女を乗せると、最新流行のスットントン節を唄いながら、白昼の国道を引いて行った。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
