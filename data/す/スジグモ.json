        "examples": {
          "standard": [
            {
              "text": "高い空に白いすじ雲がたなびき、すっかり秋の訪れを感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "すじ雲が空一面に広がると、天気は下り坂になるという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夕焼けに染まったすじ雲が、空に筆で描いたように伸びている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この巻雲のことを国際語では Cirrus（略称 Ci）といい、俗にはすじ雲と呼ぶ。",
              "citation": {
                "source": "雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
