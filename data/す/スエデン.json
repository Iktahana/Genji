          "standard": [],
          "literary": [
            {
              "text": "エレン・ケイの論旨は、要するに、スエデンの青年社会民主党に対して、「ひまな時間を増やす事の為めに闘うと共に、其のひまな時間の悪用されないように休養的教養を獲得しなければならない。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしスエデンボルグのいうがごとく、天国にも階級のあるものであるならば、フランシスはトルストイより上座に着くであろう。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる想像力が、恵みによって、照らされたるときこそ、かのヨハネやスエデンボルグのごとき宗教的天才の見たる黙示と称すべきものであろう。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十年も（一八八〇年以後）ストックホルムの民衆大学でスエデン文明史の講義をしていた由です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "万事がそうだけれど、たとえば文学などでいうと、こう怪奇的な、変に秘密がかった、そうだね、日本でいえば平田篤胤だとか、上田秋成だとか、外国でいえば、スエデンボルグだとかウイリアム・ブレークだとか例の、君のよくいうポオなども、先生大すきだった。",
              "citation": {
                "source": "百面相役者",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
