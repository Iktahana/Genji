          "literary": [
            {
              "text": "フレデリックもイングンもスウエーデン貴族社會の甘やかされた子供達で、共にウプサラの大學に學んでゐたが、不良な道樂者のお先棒だつた。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると月あかりの泉水のふちで誰かゞ無言のまゝでしきりとスウエーデン式の体操を行つてゐた。",
              "citation": {
                "source": "サロメと体操",
                "author": "ヘツペル先生との挿話",
                "note": "青空文庫"
              }
            },
            {
              "text": "○石時代ト稱スベキモノヽ存在ハ今ヨリ凡六十年前「デンマルク」及ビ「スウエーデン」ノ學者ノ考定セシ所ニシテ、此名モ彼等ニ由リテ始メテ用ヰラレタルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
