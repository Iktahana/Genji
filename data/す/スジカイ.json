        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "耐震補強のために、壁の内部に太い筋交いを追加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "柱と柱の間に筋交いを渡して、建物の構造を安定させる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "DIYで棚を作る際、横揺れ防止のために筋交いを付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "或る暗い夜、悪い運命の橋が筋交いに十字を切る所の私の室から、私と云う一つの蝋燭が消えたとする。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "上半身を両手で支えて、ジロジロと眼を見開いてみると、自分の頭の上には誰の仕業かわからないが、湿っぽい木炭の俵が一枚、横すじかいに載せてあった。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして右手で襟元を繕いながら、左手で前裾をシッカリと掴むと、白足袋を横すじかいに閃めかして、汽鑵車の前に飛び込もうとしたが、線路の横の砂利に躓いて、バッタリと横向きに倒れた。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バットがありますか」「入らっしゃいませ」　とステキに明るい声が奥の方からして、デブデブに肥った四十恰好のお神さんが、乳呑み児を横すじかいに引っ抱えながら出て来た。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙突の中の黒い煤の間を、横すじかいに休らいながら飛びながら、上って行く火の子のように、葉子の幻想は暗い記憶の洞穴の中を右左によろめきながら奥深くたどって行くのだった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると浅い桐の底に、奥の方で、なにかひっかかるような手ごたえがしたのが、たちまち軽くなって、するすると、抜けてきたとたんに、まき納めてねじれたような手紙の端がすじかいに見えた。",
              "citation": {
                "source": "手紙",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒絽の羽織をひっかけた、多少は酒気もあるらしい彼は、谷村博士と慇懃な初対面の挨拶をすませてから、すじかいに坐った賢造へ、「もう御診断は御伺いになったんですか？",
              "citation": {
                "source": "お律と子等と",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも御守殿風の長笄を横すじかいに崩し傾けて、緋緞子揃いの長襦袢の襟元を乳の下まで白々とはだけたダラシなさ。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして階段を降りて行く女の姿を見送った人々は、直ぐに視線を転じて、あとに残った男の方を凝視するのであったが、男はそんな事に気も付かない体で、椅子の背に横すじかいに凭れかかったまま女の出て行ったあとをじいーっと見詰めているようであった。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし真中の鬚男だけは、なおも金口煙草に気を取られているらしく片眼をつぶって、唇を横すじかいにしいしいプカプカと紫色の煙を吸い味わっていた。",
              "citation": {
                "source": "老巡査",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その馬の影が、黒く地面に焼きついた上を、燕が一羽、ひらり羽根を光らせて、すじかいに、空へ舞い上がった。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼の様子に安心した、猪熊の爺は、そろそろ遣戸の後ろから、にじり出ながら、太郎のすわったのと、すじかいに敷いた畳の上へ、自分も落ちつかない尻をすえた。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまた、右京左京の区別なく、どこも森閑と音を絶って、たまに耳にはいるのは、すじかいに声を飛ばすほととぎすのほかに、何もない。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "心配せんとついて来まっせ」　空駕籠をかついで仲町から飯倉片町のほうへやって来ると、おかめ団子のすじかいに、紺暖簾に『どぜう汁』と白抜にした、名代の泥鰌屋。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "初春狸合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お豊さん、驚いちゃいけません、金蔵です、金蔵がこうして生き返って来たのですよ」　藪蔭から出て来た金蔵は、糸楯を背に負って、小さな箱をすじかいに肩へかけて、旅商人｜体に作っていました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "三輪の神杉の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ、程近いすじかい見附の夜を見守るお火の見の上から、不意に、耳おどろかす半鐘の音。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その四本の足の下部を筋かいに連結する十字形のまん中がちょっとした棚のようになっている。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋かい方杖等いろいろの施工によって家を堅固な上にも堅固にする。",
              "citation": {
                "source": "鎖骨",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていち早く部屋を横筋かいに戸口まで逃げのびて、ハンドルに手をかけながら、「あなたはけさこの戸に鍵をおかけになって、……それは手籠めです……わたし……」　といって少し情に激してうつむいてまた何かいい続けようとするらしかったが、突然戸をあけて出て行ってしまった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎が見ると、二人の姿が筋かいに見える。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い空の静まり返った、上皮に白い薄雲が刷毛先でかき払ったあとのように、筋かいに長く浮いている。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな門が道の向きにまるで関係のないような位置に筋かいに立っていた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな翻訳ですか」「なにつまらない――かわいそうだたほれたってことよというんです」「へえ」と言った野々宮君は椽側で筋かいに向き直った。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "絨毯とは不調和な位置に筋かいに尾を長くひいている。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その懐中電燈の光線が、鋭い抛物線を描いて、横｜筋かいに照し出している茶色のリノリウム張りの床の上には、そうと察して見なければ解らない程のウッスリとした、細長い、女の右足の爪先だけの靴痕が印されているのであった。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車はもう、日比谷公園の中から虎の門を横筋かいに、溜池の通を突き抜けている。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼が再びもとの繁みのなかへ潜りこんでからも、ナーヂャは相變らず眼をきらきらと光らせて、兩手を前に合わせて組んで、まるでわれを忘れたもののように、庭の小徑を筋かいに行きつ戻りつしつづけていた。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "図355は、私のいる所から筋かいの向こうに見える、古い家屋である。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "石から石の上を飛びめぐる鶺鴒と筋交ひに、舟は両崖の迫つた間の急湍を、櫂を休めて悠々と乗つ切る、川には筏に組む材木が漂ひながら岩に堰かれてゐる、王子製紙会社の紙の原料で、中部の支社で、製するのだといふ。",
              "citation": {
                "source": "天竜川",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎坊へ着いて見ると、戸は厳重に釘づけにされ、その上に材木を筋交えに抑えにして、鋼線で結びつけてあるが、寂ッそりとして、人の気はなく、案内者の咳払いが、沈んだ空気を乱しただけだ。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
