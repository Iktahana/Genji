        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "現にウラルの或る地方では「木魂に呼びかけられると三年｜経たぬうちに死ぬ」という伝説が固く信じられている位であるが、しかもその「スダマ」、もしくは「主の無い声」の正体を、心霊学の研究にかけてみると何でもない。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "買ったり買ったり」「薄荷を買わんかなスダンの薄荷を！",
              "citation": {
                "source": "死の航海",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スダレがいりますね、これでは駄目だから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは、この手紙を、林町の日本間の方の客間のスダレの下っているところで、大きい四角い机に向って書いています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、今年は大助り、多賀ちゃん、竹スダレのことお話しいたしましたろう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "車がついていてね、糸でスルスルと巻き上る竹スダレの下から、まんまるなお月様が遠いむこうの屋根を眺めるという風流な姿を御想像下さい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の方は、スダレをはったりして、結局二階へ籠城よ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は室の内で、スダレをおろしカーテンで光線を柔らげ、足元を暖かくこの手紙をかいているという、そういう光景。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてそれから四半の廊下の隅につっこんである小さい方のテーブル出しかけて布をさがしてかけて（手が汗だらけだもんで、こすれて痛いから）あっちこっちあけて、スダレかけて、さて、と昨夜はそこに腰かけてかなりエンジョイしました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですからスダレがおろされないでもう西日が眩しいのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい道をへだてて、バラックのトタン屋根が暑い日をてりかえし、スダレの奥から大きな声でラジオのニュースが響いている。",
              "citation": {
                "source": "いまわれわれのしなければならないこと",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の婆やが酒屋の裏にスダレを下げて賃仕事をしている、そこに一日いたこともある。",
              "citation": {
                "source": "年譜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、国男さんが伊吹山さんの弟と来て、ジェームスダンの切符を買わせられる。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがスダーク〔とげ魚〕が55к 位だったのだが、75к になった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "◎今日の обед はスダークの入ったじゃがいもスープ、スダーク、マカロニ、カーシャ〔おかゆ〕、ソーセージという献立だ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スープ、スダークにマカロニをとり、二人でわけてたべ、夜は早くおなかがすいて、Ｙオリガさんへ出かける前、青葱の汁をつくり御飯をたき玉子をかけて日本飯をくった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙはらをすかせたが、買っといたスダークたべられず、おそくめしをたいた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリガさん来、仕立やはゴスダルストボォ〔国家〕の仕事をしてだめ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊ゴスダルストヴェンヌイ Магазин〔国営の商店〕でバタ、砂糖、ムイロ〔石けん〕、カルタ〔券〕なしで売り、バタ５р、ムイロ１р、さとう２р50だそうだ！",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキツト私ヲ返スダラウト思ヒマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキット私ヲ返スダロウト思イマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一部　日本語の語序　　　　　一　下何後代の語序からすれば、「簾下」「沓下」と言ふ所を、古くは、下簾「シタスダレ」、韈「シタウヅ」と、全く逆装法を以つて言つてゐる。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後｜和蘭に入った時、ハークのメスダック美術館で、二枚の単色のパステルを見たが、その一つはキヤロ・ディ・ルーナ Chiaro di luna で一つはサン・モリッツにある大作、“〔Die beiden Mu:tter〕” と同じコムポジションであった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校でもクリスマスにはクリスマスダンスが御座いました。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スノードン富士見し人に恥かしく思ひけるにや姿かくせり　また一日、ベセスダ（Bethesda）と名づくる山間の都邑に遊ぶ。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸をあけると、四間にしきられていて、藤兵衛の居間へ行くに四畳ぐらいの寄りツキがあり、その隣に納戸があって、ここには仏壇だのクスダマだの、いつ用いたのか知れないが、よそなら使って捨てるものを、雑然とほうりこんである。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二　密室大犯罪",
                "note": "青空文庫"
              }
            },
            {
              "text": "通訳として和蘭の甲必丹マンスダール、商人シクス、手代ヰッセールそれに羅甸語のやゝ解るドューウといふ者が立合ひ、彼等はこの日取調べる二十五箇条を箇条書にしたものを持ち、その答弁を書きこむ手筈になつてゐた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンコウのドブ煮　冬になると東京の居酒屋では「アンコウ鍋」が江戸前の肴として珍重されるが、だいたい居酒屋で食べさせる江戸前の肴は、湯どうふ、サシミ、スダコ等というものだから、その中ではたしかにアンコウ鍋は抜群だ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、その婦人は、宛も往時の猶太人が病人をベテスダの池に送つたやうに、この娘の病氣を癒す爲めにこの學校へ送られたのである。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
