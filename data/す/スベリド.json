          "literary": [
            {
              "text": "一方の壁には、坐っていて眼の高さに小さな窓のような枠があり、縦三寸横一尺ほどの滑り戸が付いていた。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通のパリ風の家で、門があり、その片側にガラス窓のついた番小屋があって、窓に一つすべり戸がついていて門番小屋と記してあった。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
