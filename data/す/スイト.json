        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カアテンの間から明るい青空の光りが流れ込んで、寝台の枕元から私の顔の真上に垂れ下っているスイトピーを美しく輝かしている。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る日、彼の所へ、知人から思わぬスイトピーの花束が岬を廻って届けられた。",
              "citation": {
                "source": "春は馬車に乗って",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "-------------------------------------------------------　　　　　一　初秋の夜で、雌のスイトが縁側の敷居の溝の中でゆるく触角を動かしていた。",
              "citation": {
                "source": "火",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月九日（日曜）　元禄、安政の大地震のときにも、スイトン、ゆであずき類大繁昌であったらしい。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのうも到るところに、スイトン一杯十銭、奉仕的努力などと云う旗を出した小車の店を見た。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "）〔欄外に〕　Ｙの眼鏡、出来たが、かけると心持わるい由、ロシアでは、インク、メガネ、スイトリ紙、写真の道具、化粧品までわるし。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり間借りですが、スイト・ホームよ。",
              "citation": {
                "source": "氷蔵の二階",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヤは方面委員の世話で慈恵病院に入ったが、附添はこっち持ちで、そのための交通費がいったし、祖父ちゃんがもって行く弁当にうちで皆のたべているスイトンをあてがうわけには行かなかった。",
              "citation": {
                "source": "小祝の一家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "天川から兵士に扮して潜入した三人のゼスイトがあり、カストロは肥後島原に潜伏布教して一六二六年島原山中で行き倒れ。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "博文館の工場に勤めておられたという、鬚を生やした罹災者某君が、夫人とその門前に「社会奉仕スイトン一杯五銭」の店を出したが、一向売れなかったようだ。",
              "citation": {
                "source": "震災後記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "事務所ではスイトンをつくって待っていてくれた。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "日比谷の外食券食堂で雑粉入りのスイトンを一丼とって汁だけ飲み、汁の実のスイトンは、家から持ってきた空の弁当箱へさらえこむ。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて夕飯になり、「ホート」と言うスイトンのような汁を僕にもくれた。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スイトピーを日本の豌豆に較べてみるもいい。",
              "citation": {
                "source": "味覚の美と芸術の美",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "スイトピーの花の美しさなどというものは、実にうすっぺらな造花美に過ぎない。",
              "citation": {
                "source": "味覚の美と芸術の美",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、ふじ色一色の温室咲きのスイトピーであった。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "目的さえ正しければ、方便は問う所にあらずとの「ジェスイト」派の慣用手段は、不謹慎に不謹慎を増し、遂にはその目的すら教化の外に逸出し、漸く識者の厭う所となる。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "他にロンの「レントより遅く」、シャンピの「花火」、ロンの「アラベスク」二曲、ギーゼキングの「スイト・ベルガマスク」四曲（このうちの「月光」が有名だ）（以上コロムビア）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "『スイト・ベルガマスク』も『水の反映』もその意味で推奨される。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この家の主人は文学者を愛好してゐたので、それに花の多い季節で、卓上にはどつさりスイトピーや薔薇などが盛られてあつた。",
              "citation": {
                "source": "芥川龍之介を憶ふ",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "雜誌富士の“大衆文藝家の過去を語る”座談會のなかに、講談社の舊幹部のひとりが、ぼくが、大正大震災のときに、スイトン屋をしたといふことを話してゐるので、應接間の客から、よくほんとですかと笑つて訊かれる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとの話をよそ事にして、上野に一個の床几と葭簀とをもち出して、軒なみのスイトン屋牛めし屋さんの一軒にわりこんだのである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「美国製の、アメリカ製のスイトサ（清涼飲料水）だ」と丸万が言った。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
