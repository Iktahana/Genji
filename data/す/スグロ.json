[
  {
    "uuid": "6992dce1-fdca-588a-96fc-1636a15a22c1",
    "entry": "末黒",
    "reading": {
      "primary": "すぐろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
