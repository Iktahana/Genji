        "examples": {
          "standard": [
            {
              "text": "筆を滑らせて、半紙に「心」という文字をすっすっと書いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "障子がすっすっと軽やかに開く音に、職人の技を感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スケート靴で氷の上をすっすっと滑っていく爽快感は格別だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "僕がこいつをはいてすっすっと歩いたらまるで芝居のやうだらう。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがカン蛙は一言も物を云はずに、すっすっとそこらを歩いてゐたばかりです。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カン蛙はまだすっすっと歩いてゐます。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がこいつをはいてすっすっと歩いたらまるで芝居のようだろう。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがカン蛙は一言も物を云わずに、すっすっとそこらを歩いていたばかりです。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カン蛙はまだすっすっと歩いています。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下に跫音、ばたばたと早く刻んで、羽織袴の、宝の市の世話人一人、真先に、すっすっすっと来る、当浪屋の女房さん、仲居まじりに、奴が続いて、迎いの人数。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこで恰も木馬に乗った勇士のようにすっすっと彼等の傍を突き進んで行った。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "大勢の鉛筆の音がすっすっと走っている。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっすっと彼らがはいって来た。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええ面白いわ、早く来て御覧なさい」　蛸は八本の足を真直に揃えて、細長い身体を一気にすっすっと区切りつつ、水の中を一直線に船板に突き当るまで進んで行くのであった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は日陰になってる人通りの少い方の側を、新橋の方へ真直に、わき目もふらず、草履の裏を見せないですっすっと歩いていた。",
              "citation": {
                "source": "道化役",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は追風を受けて鳥のようにすっすっと走り、島の岸は閃くように過ぎ去り、眺望は一分毎に変って行った。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを我慢して、彼女の手を取りながら、踵を浮かし、爪先ですっすっと、ダンスの真似をやってのけた。",
              "citation": {
                "source": "裸木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "狼は三之丞の方を時々するどく睨みながら、反対の端を走っているが、その全身の動きは頗る軽く、すっすっとまるで四足が地を踏んでいるとは思えないほどであるが……三之丞は眼も放さず狼をみつめながら、ほとんど同じ速度で矢来の外を廻ること二周、三周。",
              "citation": {
                "source": "備前名弓伝",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "七十郎の躰はかれらのあいだをすっすっとぬけるように見え、その棒は直角に三度ばかりひらめいただけであった。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第三部",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後にスッスッと足音が聞える。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また背後に、スッスッと足音が聞える。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の写真館と隣合う、向う斜の小料理屋の小座敷の庭が、破れた生垣を透いて、うら枯れた朝顔の鉢が五つ六つ、中には転ったのもあって、葉がもう黒く、鶏頭ばかり根の土にまで日当りの色を染めた空を、スッスッと赤蜻蛉が飛んでいる。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "親爺のちぎれた趾からは、紅い血が、ガーゼで拭かれたあとへ、スッスッと涌きあがった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、スッスッと乗り出した。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の孫が死んだばしのごと歎いてなあ……」　あとはスッスッという啜り泣きの声が聞こえるばかりであったが、彼はそれでも別段に気に止めなかった。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとはピッタリと静かになって、スッスッという啜り泣きの声ばかりが、海の水に沁み渡って来た。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "速度計は最高の数字を表わし、放熱器からは、小さな雲のような湯気がスッスッと洩れては千切れ飛んだ。",
              "citation": {
                "source": "白妖",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ははあ、大奥のお伽衆だな」　その時スッスッと足音がして、軈て襖が静かに開いた。",
              "citation": {
                "source": "天主閣の音",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時正面の切り戸から悠然と立ち出でた小兵の人物、年格好は五十五、六、木綿の紋付に黄平の袴、左手に一刀を引っさげてスッスッと刻み足に進んで来る。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うとすぐ京子が何か云ったのを後にきいて大股にスッスッと歩いた。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩きじょうずの人の草鞋は、つまさきのほうがすり切れても、かかとには、土ひとつつかなかったものだそうで、つまり、足の先で軽くふんで、スッスッと行く。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝幹が茶がかり残った緑葉が、スッスッと斜に緑青でもかすったように見える。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その堂々たる大門のなかへ駕籠はスッスッと入って行きました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "市中騒動の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
