        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ベルリン飛行場からルイットポオル・ストラッセまで自動車で行く。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月廿五日　ルッツェンブルガア・ストラッセ三十三番地に宿泊す。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋服屋はモッツストラッセにあった。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "約束の二週間の後、私はその洋服を受取りに一人で出かけたものだが、ところがどうしてもモッツストラッセへ出られないのだ。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてモッツストラッセ55と命じた。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁にモッツストラッセ55と書いてあった。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、かねて中館公一郎に教えてもらってあったモルツ・ストラッセのルドウィクというパンシオン（下宿）に部屋をとった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら、あすこに、そばへ寄るときっとラックフォルト乾酪と酸菜のにおいのしそうな、伯林ドロティン・ストラッセ街から来た紳士がいるでしょう？",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "落ち合う場所はアンダーストラッセ十四番の廃屋にする。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
