          "literary": [
            {
              "text": "「スヴァルト・アルフ」に乗っていた海賊たちはそれを見て笑った。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スヴァルト・アルフ」は、「しろき」オラウスの鴉の旗の下にロックリンを船出して来た三十の櫓船の一隊の先頭であった。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が明けて太陽の雨がうれしそうに流れ、あたらしい東風が海峡を横ぎって吹きはじめた時、とおく北の方に吹き流されていたスヴァルト・アルフは青い空いろの眼の激しい光と笑いを載せて飛ぶように西南に走った、海賊たちは橈をうごかしたり塩水によごれた剣や短剣をみがいたりしていた。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビルロートはグライフスヴァルトとゲッチンゲンで学び次いでベルリンで医師となった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
