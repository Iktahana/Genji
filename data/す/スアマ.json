    "definitions": [
      {
        "index": 1,
        "gloss": "sweet mochi cake",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
