        "examples": {
          "standard": [
            {
              "text": "牛のすね肉を赤ワインでじっくり煮込み、とろけるような柔らかさに仕上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "すね肉は硬いが、長時間加熱することでコラーゲンが溶け出し、深いコクが出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "カレーを作るなら、安いすね肉を使って時間をかけて煮込むのが一番美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "別に御飯を少しばかり、そうですね肉が一斤なら御飯を大匙三杯位擂鉢で擂ってやっぱり裏漉しにします。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
