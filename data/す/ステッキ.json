[
  {
    "uuid": "cd8d8b95-ee3d-504a-beeb-2af40297e889",
    "entry": "ステッキ",
    "reading": {
      "primary": "ステッキ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
