        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鼻水が出てきたので、ティッシュがない彼は何度も鼻をすすり上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の寒空の下、彼は真っ赤な鼻をすすり上げながらバスを待っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "風邪気味なのか、隣の席の人がずっと鼻をすすり上げていて気になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "うつ向いていると水洟が自然にたれかかって来るのをじっとこらえている、いよいよ落ちそうになると思い切ってすすり上げる、これもつらかった。",
              "citation": {
                "source": "花物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　さうしてひたすらに自分を責め、あなたを劬る心で充ちながら、一層激しくすすり上げるのでした。",
              "citation": {
                "source": "道",
                "author": "――ある妻の手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "洟をすすり上げる音だけがきこえた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ええ、言わんでもいいことを、と気もちがたかぶり、つい、むかむかと良人に食ってかかりますと、ただ申訳ない、ゆるしてくれの言いつづけ、仰山な恰好にてその場へ泣き崩れるのを、芝居は家では沢山だ、と思いもよらぬたんかなどきったわれとわが身の浅間しさに良人をかき抱いてすすり上げるという仕末。",
              "citation": {
                "source": "旅役者の妻より",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣いては顔を上げて、風に揺れる旒をしみじみと眺め、そしてまたしくしくとすすり上げるのである。",
              "citation": {
                "source": "一老人",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "あぐね果てたお妙はクスンクスンと涙をすすり上げる。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、長い間泣いて、やっと泣きやんだ子供が、もうすっかり気がまぎれていながら、何かの拍子でまたすすり上げるように、時々しくしく泣いていた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見たこちらの心は、心からすすりあげるほどのもろい情に打たれた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親のすすりあげる声がしきりに聞こえる。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかで女のすすりあげる声がした。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他には、誰々、誰々」　一人一人、名を数えあげると、「とても人ごととは思われません、いつ我が身のことになるかも知れぬのに」　とすすりあげるのであった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "敦子も泣きだしている、二人の女の泣声にまじって、木戸と金吾と杉夫も泣いてるようで洟をすすりあげる音。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、眼をあけるとすぐ手に持った蜜柑の皮をむき、白いすじを一つ一つとってから、それをそっとテーブルの上に置き、あつい番茶を、茶碗のふたをなめるようにしてすすりあげると、「じゃあ」　と、典獄の方を向いてうながすように立ちあがりました。",
              "citation": {
                "source": "蜜柑の皮",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと、私は、空襲で兄が死んじまったので行く先は無し、困っていたら――兄が昔、先生から教えていだいた事が有ると言う縁で、こうしてお手伝いしながら、御厄介になっているだけなんですから、出て行けとおっしゃれば――誠　（子供のようにすすりあげる相手が憐れになればなる程イライラして来る）そんな！",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……信三は両手で彼女を抱いた、むすような香料の匂いと、身をふるわせてすすりあげる声が、急にひっそりとなった寝室いっぱいにひろがるようだった。",
              "citation": {
                "source": "四年間",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
