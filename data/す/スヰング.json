          "literary": [
            {
              "text": "とびかゝつたとはいふものの、実は二三｜米離れてをり、彼は髪ふりみだしてピストンの連続、ストレート、アッパーカット、スヰング、フック、息をきらして影に向つて乱闘してゐる。",
              "citation": {
                "source": "二十七歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "左側にしきりの壁、一番手前がスヰングドア、それを出た軒下にビリヤード旭亭の柱看板、その奥に階上への階段（下手寄り）。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
