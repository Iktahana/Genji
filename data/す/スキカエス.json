        "examples": {
          "standard": [
            {
              "text": "古くなった和紙を水に溶かして、もう一度新しい紙に漉き返す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この工房では、廃棄される紙資源を漉き返して再生紙を作っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "思い出の詰まった手紙を漉き返して、卒業証書の台紙にすることにした。",
              "citation": {
