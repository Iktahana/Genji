    "definitions": [
      {
        "index": 1,
        "gloss": "sand",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "波が引くたびに、濡れた砂が足の指の間からこぼれ落ちていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "砂漠の砂は驚くほど細かく、風が吹くたびに美しい紋様を描く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "靴の中に入り込んだ砂が気になって、歩みを止めて脱ぎ捨てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "秋日行語〔菊もうららに〕萩原朔太郎菊もうららに咲きいでたれど我身は砂丘に寄りて悲しめりさびしや海邊のおくつきに路傍の草を手向くることこのわびしきたはむれにひとり樹木にすがりつきたましひも消えよとむせびなく。",
              "citation": {
                "source": "秋日行語",
                "author": "〔菊もうららに〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者不詳　寒い、乾燥した砂混りの風が吹いてゐる。",
              "citation": {
                "source": "一つの境涯",
                "author": "――世の母びと達に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の顔は蒼ざめ、指は此の通り、握つた砂の半分はサラサラとわけもなく落ちさうな程です。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "所詮は、十一月の曇つた午後に、風が往来の砂塵を巻きあげてゐるやうなもんだと、僕の、心はともかく肉体は、左様に今はや観念してゐるやうな具合だ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂混りのおからを食つて、箸の置きやうもないやうなもんだ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和十一年に、砂子屋書房から出ました。",
              "citation": {
                "source": "私の著作集",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨年は、竹村書房から「愛と美について」砂子屋書房から「女生徒」女生徒は、ことしの五月に再版になりました。",
              "citation": {
                "source": "私の著作集",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、すぐまた砂子屋書房から「晩年」の新版が出るそうです。",
              "citation": {
                "source": "私の著作集",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちなみに、書房の名の砂子屋は、彼の出生の地、播州「砂子村」に由来しているようであります。",
              "citation": {
                "source": "砂子屋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故ならば、芸術の存在理由は芸術自身の裡にあること、恰も塩ッからいものが塩ッからく、砂糖が、甘いが如きものであり、恍惚は恍惚であれ、恍惚は直接｜他に伝達出来るものではなく、恍惚の内部がよく感取され、即ち他の恍惚内部との相関関係に於て僅かに暗示・表現することが出来るに過ぎないから。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "又校内の空気には、毎日蒙古砂塵が漂つてるやうな気がされた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "火に充ちし手のナポリの聖女、心菫に泣ける薔薇、聖ギヂルが花、汝は見しや天の砂漠に汝が十字架？",
              "citation": {
                "source": "ヂェラルド・ド・ネルヴァル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "衰へや歯に食ひあてし海苔の砂この秋は何で年よる雲に鳥蝙蝠も出でよ浮世の花に鳥秋近き心の寄や四畳半　こうした句の詩情しているものは、実に純粋のリリシズムであり、心の沁々とした咏嘆である。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "衰へや歯に喰ひあてし海苔の砂　独居する芭蕉の心に、次第に老が近づくのを感じて来た。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「歯に喰ひあてし」という言葉の響に、如何にも砂を噛むような味気なさと、忌々しさの口惜しい情感が現われている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂礫のごとき人生かな！",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "路上に行人は散らばり去り烈風は砂を卷けどもわが古き感情は叫びて止まず。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひそかに家を脱して自轉車に乘り、烈風の砂礫を突いて國定村に至る。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいていの店は早く仕舞って、寂れた町に渦巻き立つ砂ほこりの中を小きざみに行く後姿が非常に心細げに見えた。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺碧のナポリの湾から山腹を逆様に撫で上げる風は小豆大の砂粒を交えてわれわれの頬に吹き付けたが、ともかくも火口を俯瞰するところまでは登る事が出来た。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋上の砂利の上に関東八州の青空。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が強くて干し物がいくつか砂利の上に落ちている。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂書きの御婆さん「ヘー有難う、もうソチラの方は御済になりましたかなー、もうありませんかなー。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うへ越して交番に百花園への道を尋ね、向島堤上の砂利を蹴って行く。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分も陳列所前の砂道を横切って向いの杉林に這入るとパノラマ館の前でやっている楽隊が面白そうに聞えたからつい其方へ足が向いたが丁度その前まで行くと一切り済んだのであろうぴたりと止めてしまって楽手は煙草などふかしてじろ／＼見物の顔を見ている。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄霧北の山の根に消えやらず、柿の実｜撒砂にかちりと音して宿夢拭うがごとくにさめたり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関を出れば人々も砂利を鳴らしてついて来る。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水害の名残棒堤にしるく砂利に埋るゝ蘆もあわれなり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "港口浅せたるためキールの砂利に触るゝなるべし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――記憶も、去るにあらずや……湧き起る歓喜のためには　人の情けも、小さきものとみゆるにあらずやああ、神様、これがすべてでございます、　尽すなく尽さるるなく、心のままにうたへる心こそ　これがすべてでございます！",
              "citation": {
                "source": "夏は青い空に……",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
