        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山奥にある炭窯から、白い煙が細く立ち上っているのが見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "伝統的な炭窯でじっくり焼かれた炭は、火持ちが非常に良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖父は若い頃、この炭窯で毎日汗を流して働いていたそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "いつか父親がスワを抱いて炭窯の番をしながら語ってくれたが、それは、三郎と八郎というきこりの兄弟があって、弟の八郎が或る日、谷川でやまべというさかなを取って家へ持って来たが、兄の三郎がまだ山からかえらぬうちに、其のさかなをまず一匹焼いてたべた。",
              "citation": {
                "source": "魚服記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭窯まであつた広い山荘を歩き廻つた時、山桑が紫の実をつけてゐるのを先生が戯れにうどんげの実といふ名をつけて珍重する由など話されたのであらう、それを直ちに主人の現在の心境を写すに借用した訳で、情景相即した趣きの深い歌である。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷底へついて見ると紐のちぎれさうな脚袢を穿いた若者が炭竈の側で樫の大きな榾へ楔を打ち込んで割つて居るのであつた。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈の口を突き崩したら焔がぽつと一時に吹き出した。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈のなかは眞赤なうちに黄色味を帶びた烈々たる凄じい火である。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈の前は眉毛も焦げるかと思ふ程熱い。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "お秋さんは一人で醋酸石灰――之はどういふものかといふと炭竈の煙を横につないだ土管のなかを濳らせれば、煙は其間に冷却して燻り臭いひどくすつぱい液體になる。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "お秋さんはまあ濟みませんといひつつ丁寧に辭儀をしてすぐに炭竈の方へ行つた。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "六疱瘡やみ、鼻がつまれば、枳※、實を採り來、ひだりの、孔にさし、みぎりの、孔にさし、忽ちに、息は通へど、炭竈の、烟噴き孔、土崩えて、塞がりてありしを、知らずと燒きし、かゝり炭、いぶり炭、へつひには、火が足らず、火鉢には、烟立つ、いぶり炭、かゝり炭。",
              "citation": {
                "source": "長塚節歌集　中",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから本館を出て赤塗の古風な門をくぐって、農舎の方へ行って見ると、そこで自家用の木炭製造の炭竈が調子よく煙を吐いていた。",
              "citation": {
                "source": "百姓弥之助の話",
                "author": "第一冊　植民地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　普通木炭を焼くには一定の炭竈を築いてする一定の方法がある、が、弥之助がはじめたのはそういう本格的のやり方でなく、軽便実用を主とした即成式のものであった。",
              "citation": {
                "source": "百姓弥之助の話",
                "author": "第一冊　植民地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その和炭に対して炭竈で蒸し焼きに焼いた炭を荒炭と云い、荒炭和炭の名は既に天平時代の正倉院文書に往々見えている。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "山城では小野の炭竈がつとに歌人の口に上っている。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "「真木立つ山の奥、檜原の蔭、岩の蔭道たど／＼しく、谷深き木の間より立ちのぼりたる煙の有様、世にたぐひなきは炭竈の風情なり」などと、人の苦労も知らず顔に床しがったものであったのである。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈に立ち上るかすかな煙は、藻汐焼く火とともに恋のほむらの譬喩ともなった。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれから奥地の山々には、今でもずいぶんと遠国から、炭竈に入って永く稼いでいる者が多い。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "『白河風土記』巻四に、「鶴生（福島県西白河郡西郷村大字）の奥なる高助と云ふ所の山にては炭竈に宿する者、時としては鬼魅の怪を聴くことあり。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "東北の山奥には思いがけぬ地方から入って炭竈を築いて火を焚いている者が今でも多い。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈をぬりて冬待つ嵐かな　　　　吏明　山家の句であろう。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬が近くなったので、炭を焼くべく炭竈を塗り、もう何時冬が来ても差支ない用意がととのった。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし「炭竈をぬりて冬待つ山家かな」だったら、それこそ平凡極るものだけれども、作者は句に一転化を与えるため、嵐というものを持出して来た。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈や両膝抱て髭男　　　　散木　炭竈を守るためであろう、ぼうぼう髭を生した男が、両膝を抱いてそこにいる、というのである。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「炭焼のひとりぞあらん竈の際」という其角の句は、炭竈の様子を想いやったのであるが、これは炭竈のところにいる男の様子を、的確に現した点に特色がある。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈の髭男はもともとそこに一人しかいない役者であろうが、これは鷹野における人数の中から、特に若衆役を持出した点に一種の技巧がある。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
