          "literary": [
            {
              "text": "ひろい海を航海するのに、なくてはならぬ海図と、海や島や海流のことなど、くわしく説明してある海の案内書、すなわち水路誌。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海図も、水路誌も、コンパスも、波がさらっていった。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、海図と水路誌の記憶によって、一同に申しわたした。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            }
