        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "新しいハーフに詰め替えたら、こんどはテープが切れちゃって、スプライシング・テープでつなげて、フィルターかけて、ノイズを洗いながらＤＡＴにコピーして、マスターをつくったの。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大通りの横断歩道を渡り、大きく〈不二屋〉と書かれた看板のあるビルの地下に降りて行き、ロッテリアでエビハンバーガーとスプライトを注文する。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "スプライ老人がキセルに煙草を詰めると、指に火が当たり、キズになり、焼き印のように火傷になった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "スプライ老人が言った。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "スプライ老人が悠然と言った。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ここが一番奇妙なところだが、スプライ老人が本当のことを言っていると、見えざる聞き手、トリガーセンが悟ったことだ。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スプライ老人に賛成だ」　とジョンソンが厳かに言った。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "何があろうと絶対に」　とスプライ老人がきっぱり言った。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
