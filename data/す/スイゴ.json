          "literary": [
            {
              "text": "それが一睡後、今目をさましたら、重荷をおろした樣にからだが輕くなつたのをおぼえる代りに、また氣拔けがした樣だ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして一睡後、「あすは、必定、敵に会おう」　と、ここで、初めて、甲冑を身に着けた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝目がさめるとながいあいだの習慣にしたがって睡後のけだるさが心臓から指の先まですっかりきえてしまうまでは静に床のなかに仰臥している。",
              "citation": {
                "source": "島守",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
