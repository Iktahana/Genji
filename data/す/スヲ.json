        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コノ　ウグヒスハ　オカアサンウグヒスデ、センダツテノ　コト、ボウヤノ　ウグヒスヲ　ナクシタノデ、タイヘン　カナシンデ　ヰタノデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ下掲ノ如ク日本國民ハ永久ニ兵役ノ義務ヲ有シ、且ツ一年志願兵特權ハ此等ノ訓練アルヲ一理由トナスヲ以テ其レヲモ廢止スルガ故ニ、兵役ニ於テスベキコトハ凡テ兵營ニ於テスベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不用ナルベキ各地ノ中學女學校舍ハ或ハ此レヲ取リ毀チ、又ハ大學豫備校ノ校舍又ハ單科大學ノ校舍トナスヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一八一一年版エリス著、初世英國律語體傳奇集例、卷一、二〇五―四三頁）英國デヴォン州ホルスヲーシーの寺の壁を十五世紀に建てる時人柱を入れた。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ヲ害シテ私ヲ利スルノ義ニモ非ラズ、唯心身ノ働ヲ逞シテ、人々互ニ相妨ゲズ、以テ一身ノ幸福ヲ致スヲ云フナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソコデ出来ル限リ彼女ノ心ヲ戻スヲウニ申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ブジゴコウカイヲイノルマスヲ」　大連にゐる弟からである。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡ソ人ノ子トナルヤ父母ヲ顕スヲ孝ノ終トス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔為ニ惜ム先生ノ空シク道ヲ講ズルヲ／嗤フ可シ豎子ノ漫ニ名ヲ成スヲ〕の聯句を見る。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔白雲明月夜悠悠／一酔何ゾ百憂ヲ消スニ堪ヘンヤ／怪シム莫カレ江湖閑散ノ客／也世故ニ因リテ中秋ヲ廃スヲ〕　湖山はこれより先嘉永四年の冬｜褐を釈き、参河国吉田の城主松平伊豆守｜信古の儒臣となっていたので、海防に関する意見書を藩主に呈し、また人を介して老中阿部伊勢守正弘の手許にも建白する所があった。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔多ク慚ヅ緑酒｜沽ヒテ我ヲ留ムヲ／惜マズ金釵｜抜キテ郎ニ附スヲ〕と言ってあるから決して形容の辞ではない。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "此土ノ厚サハ遺物ノ新古ヲ測ル一根據トナスヲ得。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全日本バンタム一位ノ坂本春夫ガタイノバンタム一位ノシリノイ・ルクプラクリスヲノック・アウトシテ初代チャンピオンガ生レタアノ晩デスヨ、―――」ソノシリノイ・ルクプラクリスト云ウ名ヲ陸子ハ流暢ニペラ／＼ト云ッテ退ケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤリングヤネックレスヲシテナイトコロガ気ガ利イテルネ」「オ爺チャンナカ／＼分ルノネ」颯子ノ後カラオ静ガ草履ノ箱ヲ持ッテ這入ッテ来、草履ヲ取リ出シテ彼女ノ前ニ揃エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ誰々サンノ所ノ老人ハ、チョットシェパードガ足元ニ絡ミ着イタヾケデ転ンデ大怪我ヲシ、三カ月モ入院シテ未ダニギプスヲ篏メテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喉ガ渇クカラトボーイニ茶ヲ持ッテ来サセ、コンナ時ノ用意ニポケットニ忍バセテ来タセデスヲ二錠、颯子ニモ佐々木ニモ見ラレヌヨウニ、ソット口ヘ放リ込ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（地味ナスーツヲ着テイルガ、ブラウスガ派手ナノト、フランス製ラシイ模造宝石ノ五聯ノネックレスヲ頸カラ胸ヘ垂ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ昨日一日ノ無理ナ活動ガ祟ッテ、頸ノ周リ、肩、腰、等々ノ痛ミガ激シク、昨夜モ夜ッピテ安眠出来ナカッタノデ、再ビアダリン三錠トアトラキシン三錠ヲ飲ミ、佐々木ニ命ジテ背中ヤ肩ヤ腰ニサロンパスヲペタ／＼貼ラセテベッドニ這入ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーソドックスヲ好ム彼女ハ毎年ノ吉例ニ従イ、必ズソノ行事ヲ厳粛ニ行ワナケレバ承知シナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ晩僕ハ、木村ニ対スル嫉妬ヲ利用シテ妻ヲ喜バスヲ知ルニ至ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――聖人ノ治ハ、徳ヲ以テ、民ヲ化スヲ本トナス。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三益愛子よりＯ・Ｋの電報来る、「ミマスヲタノムナカノ」と中野英治からも電報、その旨川口に言ふと、「あれは要りません」といふ返事、それじゃこっちの立場がない、大いにフンガイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "能ク八石ヲ載セテ、一人ニテ推スヲ得ベシ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "純』『アノネ、コノオ店デタラネ、十カゾエルアイダニキスヲシテネ』『出発』『出発』　……筆談は、どうやらそこで終っていた。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
