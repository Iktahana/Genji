        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "プランクトンの豊富な錫色の海をゆく、砕氷や氷山の涯しない行列。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには、錫色の帆も砲門の緑も、まるで年老いて、冷たい眠りに入ったかのようであった。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウルリーケは爽やかな大気を大きく吸い込んだが、おそらく彼女の眼には、その燦かな光が錫色をした墓のように映じたことであろう。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが水平線の方へ下るにつれて、次第に暗くなり、鉛色に變り、錫色のどんよりした陰影に變つてゐた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
