          "standard": [],
          "literary": [
            {
              "text": "戦後派の諸氏の大半が、これを混同――と言うよりも――スリカエようとしているように私には見える。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞして、スリカエてほしく無い。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
