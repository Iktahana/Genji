[
  {
    "uuid": "272c8b7f-81ef-5e36-b436-4d1bf1cff86d",
    "entry": "掏り替え",
    "reading": {
      "primary": "すりかえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
