          "literary": [
            {
              "text": "象印のグリーン氏にガロン薬缶五十、温め鍋二十、ベイクケトル十五、スモークドタン十枚。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、スモークド・サーモン。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "スモークド・サーモンにベイゲルとクリーム・チーズがついてきた朝食のとき、ぼくはそのクリーム・チーズにウースター・ソースをかけて楽しんだ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だったら、それにスモークド・サーモンをつけよう。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "透明なプラスティックの袋のなかに真空パックしたスモークド・ソーセージが見えた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
