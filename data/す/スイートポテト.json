    "definitions": [
      {
        "index": 1,
        "gloss": "small cake made from sweet potatoes",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "文化祭の模擬店で手作りのスイートポテトを販売したら、あっという間に完売してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "卵黄を塗ってこんがりと焼き上げられたスイートポテトは、秋のティータイムに欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お土産にいただいた老舗のスイートポテトは、バターの香りとサツマイモの甘みが絶妙だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その夜、私はスイートポテトの如くパラフィン紙に包まれた象の幽霊と称するものを人から貰った。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤオヤ、大きなスイートポテトを持ってきやがったなア、と思ったら、これがサツマ芋の皮に入れてむした茶碗ムシ（芋ムシですかな）であった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでクラムベークというのは、この貝と蝦と玉蜀黍とスイートポテトなどを、クラントウ風に「浜焼」にした料理である。",
              "citation": {
                "source": "西洋の浜焼",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥棒と間違えられては大変と思いましたので……どうぞ御勘弁を……」スウィートポテトー　心中のし損ねが村の駐在所に連れ込まれた……というのでみんな見に行った。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つまりお前達二人はスウィートポテトーであったのじゃナ」　硝子戸の外の暗の中で二三人クスクスと笑った。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋井が来り、守衛を連れて、又風月堂の二階、ポタアジュ（ぬるいのでいつもクサる、何ういふわけか）チキンソティ、マカロニとスウィートポテト、コーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五時半、風月へ行き、コンソメ、きすとスピナチ、チキン・パテ、エスカロップビーフとスウィートポテト。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "sweet potato",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "幼稚園の行事で芋掘りに行き、大きなスイートポテトをたくさん収穫してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "寒い冬の夜、屋台から流れてくる石焼きスイートポテトの香りに、つい足が止まってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この地域特産のスイートポテトは糖度が高く、蒸すだけで天然のスイーツのような味わいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
