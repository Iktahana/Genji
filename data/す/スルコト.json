        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と御冗談めかしておつしやいましたけれども、或いは、御陽気に見えながらその御胸中には深い御憂悶を人知れず蔵して居られたのでもございませうか、その辺の事は私どもには推量も及ばぬところでございまして、ナンニモ、スルコトガナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ山東侵略ノ命令ニ服スルコトヲ止メヨ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒトノ後ヲ尾行シタリ隣室ヘハイツテ散々俺ノ悪口ヲ言ツタリ、俺ノ生活ヲ覗イタリスルコトハ、今後絶対ニヤメテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「被雇本人、軍籍ニアリ、万一不時ノ召集ヲ受ケ、労務ニ服スルコト能ハザルトキハ、前借金ニ利子ヲ附シ即時本人又ハ保証人ヨリ弁償スベシ。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ヲ口舌ノ鬪爭ニ慣習セシムルハ其天性ヲ殘賊スルコト之ヲ戰場ニ用ユルヨリモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ小地主ト小作人ノ存在スルコトハ神意トモ云フベク、且ツ社會ノ存立及發達ノ爲メニ必然的ニ經由シツツアル過程ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レニ反シテ、此ノ私有地限度超過ヲ徴集スルコトハ近代的所有權思想ノ變更ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ大地主ノ土地ヲ徴集スルコトハ最高ノ所有者タル國家ノ權利ニシテ國有ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地ノ國際的分配ニ於テ不法過多ナル所有者ノ存在スルコトニ革命的理論ヲ擴張セズシテハ、言論行動一瞥ノ價値ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ安寧秩序ヲ保持スルコトガ國家ノ唯一任務ナリトセバ、國民ノ死活榮辱ヲ日夜ニ亘リ終生ヲ通ジテ脅威シツツアル此等ヲ處分セズシテハ國家ナキニ同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ガ國家自ラノ義務ト權能トヲ無視スルコトヲ畏ルベシトナス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民膏血ノ貯金又ハ事業ノ運命ヲ決スベキ預金等ガ銀行ノ破産ニヨリテ消散スルコトハ國民生活ノ一大不安ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民教育ニ於テ英語ヲ全廢スベキハ勿論、特殊ノ必要ナル專攻者ヲ除キテ全國ヨリ英語ヲ驅逐スルコトハ、國家改造ガ國民精神ノ復活的躍動タル根本義ニ於テ特ニ急務ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語ノ統一ナクシテ大領土ヲ有スルコトハ只瓦解ニ至ルマデノ槿花一朝ノ榮ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "更ニ他ノ一理由ハ日本ノ將來ハ陸上ニアルト同一以上ノ程度ニ於テ海上ニ在ルガ故ニ、國民教育ニ於テ只陸軍的模倣ヲナサシメテ海兵的訓育ヲ閑却スルコトノ矛盾ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ中學程度ノ男生徒ニ制服トシテ靴洋服ヲ強制スルコトハ實ニ門戸閉鎖ノ有力ナル一理由ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ノ姦通罪ヲ罰スルコトハ第一ニ一夫一婦タル國民道徳ノ大本ヲ明カニスルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レヲ途方モナキ一夫一婦制ニ對スル反逆ト考フルハ、恰モ政治的特權者ニ向ツテ叫バレタル政治ノ自由ヲ平等ナル國民間ニ脱線セシメテ、相犯サザル各自ノ自由ヲ蹂躙スルコトモ等シク政治ノ自由ナリト云フ低能者ノ昏迷ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ純潔ヲ維持スル如ク男子ガ其ノ童貞ヲ完ウシテ結婚スルコトハ双方ノ道義的責務ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ノ正義ヲ規定スルニ見ルモ、合理的改造案ガ必ズ近代的個人主義ノ要求ヲ一基調トスルコトヲ知ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "醫學ニ萬能ノ藥品ナキニ係ラズ政治學ニ參政權ヲ神權視スルコトハ歐米ノ迷信ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ナル地圖上ノ彩色ヲ擴張スルコトハ兒戲ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ無産階級ガ組織的結合ヲナシテ力ノ解決ヲ準備シ又ハ流血ニ訴ヘテ不正義ナル現状ヲ打破スルコトガ彼等ニ主張セラルルナラバ、國際的無産者タル日本ガ力ノ組織的結合タル陸海軍ヲ充實シ、更ニ戰爭開始ニ訴ヘテ國際的劃定線ノ不正義ヲ匡スコト亦無條件ニ是認セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ日本ノ實力援助ニツキテ大方針トスベキハ海上ニ於テノミ彼ノ獨立ヲ援護スルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ講和會議ニ於テ英國ノ保護ヲ蒙リテ獨逸ノ利權ヲ繼承スルコトヲ認容セラレタルトキ相賀シテ「國難去レリ」ト云ヘリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ自由主義ガ各其ノ民族思想ノ結ベル果實ナル如ク、濁人タル「マルクス」ノ社會主義露人タル「クロポトキン」ノ共産主義ガ幾多ノ相異扞格セル理論ヲ以テ存立スルコトハ各其ノ民族思想ノ開ケル花ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "東西文明ノ融合トハ日本化シ世界化シタル亞細亞思想ヲ以テ今ノ低級ナル所謂文明國民ヲ啓蒙スルコトニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "屡雲上高貴ニ咫尺シ、身ヲ持スルコト謹厳｜恬淡ニシテ、芸道ニ精進シテ米塩ヲカヘリミズ。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "“U. S. R. S. Flanklyn”フランクリン号ナル、レシービングシツプデアル、大概港ノ中ニ碇ヲ降シテヰルノデ危険ノ憂ヒハナイガ、僕ニハヤハリ水雷艇ノ方ガ面白イ、君ノ冒険心ガ健ヤカニ成長スルコトヲ望ンデヰル。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
