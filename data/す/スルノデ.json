        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マアこれは一寸耳をこちらへ出して、ソコイラノ評論ヲ評論ト云イ得ルトハ思ッテ居リマセンガ、私ニハホントノ評論ヤソノ骨格ガワカッテイルカラケンソンスルノデス。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ以上ノ具体的ノ事ハ釈放時ノ事情ニヨッテ決スルノデアルカラ今カラ何トモ言ヘナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モアノ若サデアノ大役ヲスルノデアルカラ無理モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガヒドク心配スルノデ、又三十分ホド粘ッテカラ漸ク立チ上ッテ部屋ニ帰ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼ヲ害スルノデ夜ハ読書セズ、テレビモ殆ド見ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トキ／″＼台所ヘ行ッテ冷蔵庫ヲ開ケテ調ベタリスルノデ、若奥様ト聞クト女中達ハチリチリシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大キナ複雑ナ部分ヲ持ッタ機械ヲ遠クカラ操作スルノデ、一ミリ違ッテモ工合ガ悪ク、ナカ／＼注文ノ対象ノ上ニ持ッテ来ラレナイデ調節ニ時間ガカヽル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕モマダ寝床ニイタガ、彼ノ声ガスルノデ起キテ茶ノ間ニハイルト、「先生、オーケーデス」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
