[
  {
    "uuid": "d0a7376a-13f9-5254-b4a6-7b35accea66b",
    "entry": "須佐之男",
    "reading": {
      "primary": "すさのお",
      "alternatives": [
        "スサノオ",
        "スサノヲ"
      ],
      "is_heteronym": false
    },
    "grammar": {
