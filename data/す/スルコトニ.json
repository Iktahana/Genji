          "literary": [
            {
              "text": "土地ノ國際的分配ニ於テ不法過多ナル所有者ノ存在スルコトニ革命的理論ヲ擴張セズシテハ、言論行動一瞥ノ價値ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "東西文明ノ融合トハ日本化シ世界化シタル亞細亞思想ヲ以テ今ノ低級ナル所謂文明國民ヲ啓蒙スルコトニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ探求シ、分析シ、整頓シ、再現スルコトニヨッテ、ワレワレハ自然界ノ新シキ神秘ニ触レルコトガ出来ルノデハナイカト思ウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "時世ヲ徴シ風土ヲ察シ、工業ノ進歩如何ヲ考フル為メナレバ、泰西諸国ニハ殊ニ貴重スルコトニテ、博物館ノ如キハ観客日ニ麕集ス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局コルセットハ止メルコトニシ、滑リ台ニ寝テ頸ノ牽引ダケヲスルコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予、五子、佐々木ノ三人ハ瓢亭ノ半月弁当デ晝食ノ後、鹿ヶ谷ノ法然院カラ始メテ黒谷ノ真如堂、一乗寺ノ曼殊院｜辺ヲドライブスルコトニ決メル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ終日ホテルデ休養スルコトニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様モ陸子モ人ヲ煽テタリ騙シタリスルコトニカケチャア昔カラ大シタ腕前ダカラナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
