        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ワインの栓がすぽんと抜ける瞬間は、何度聞いても気持ちがいい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "詰まっていたパイプのゴミが、水圧ですぽんと飛び出してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ラバーカップを使ったら、トイレの詰まりがすぽんと取れた感覚があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
