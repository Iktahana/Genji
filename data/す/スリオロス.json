        "examples": {
          "standard": [
            {
              "text": "蕎麦の薬味にするために、わさびをサメ皮でおろし器の上に摺り下ろす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「生姜を摺り下ろして、紅茶に入れると体が温まるよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "風邪を引いた時、母がリンゴを摺り下ろして食べさせてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼らは「やりじまい」という「わさびおろし」で自分をすりおろすのだ！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
