[
  {
    "uuid": "7d0821f4-0f21-5e31-8225-a36a860c4aef",
    "entry": "擂り粉",
    "reading": {
      "primary": "すりこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
