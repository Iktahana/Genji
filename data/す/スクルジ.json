        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "愛なく情なく血なく肉なくしてただ黄金にのみ執着する獰猛なスクルジは過去現在未来の幽霊に引っ張り回されて一夜の間に昔の夢のようなホームの楽しさと冷酷なる今と身近く迫れる暗き死の領とを痛切に見せられた。",
              "citation": {
                "source": "霊的本能主義",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スクルジはなんとなく愉快でたまらぬ。",
              "citation": {
                "source": "霊的本能主義",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スクルジは黄金の執着を脱して perfect life of love and peacefulness（Dante）に一歩踏み入った。",
              "citation": {
                "source": "霊的本能主義",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
