        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今度は、加藤がスポムサーらしく、おそめへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スポムサーなしか、弱った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "神戸といへば、蒋さんがまだ来ない、スポムサーなきは困る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿の勘定その他（宿は引雑用の千五百円では不足、こんな部屋でも千八百円で、三百円の足し前）で随分知らず／″＼に金が出てゐるが、毎夜スポムサーが附いたので今回は大助かりだった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "天、日水（日本水産）スポムサーに恵みをたまひしか、雨は殆んどあがりて、曇り空。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹こはしてるときいたから見舞でもあり、伝言もありしが、実は、今夜のスポムサーにといふさもしき心からかも分らない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜のスポムサーを、たのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
