        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "渠は垂死の病蓐に横たわらんとも、けっしてかくのごとき衰容をなさざるべきなり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "理切めて荒尾もその手を払ひかねつつ、吾ならぬ愁に胸塞れて、実にもと覚ゆる宮が衰容に眼を凝しゐたり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
