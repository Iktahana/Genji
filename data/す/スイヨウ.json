        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手の抜ける水妖は、あいぬの間にもあつた。",
              "citation": {
                "source": "河童の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其が一歩、河に踏み入ると、水に没して居る小さな水妖の為に、引きこまれる事があると考へた。",
              "citation": {
                "source": "河童の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを切払って水妖の囚われから救おうとする竜次郎の苦心。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロパーヒン　オフメーリア、おお水妖よ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
