    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ところが、ある露の深い朝、頭がびしよ濡れになつた土鼠が、ちよろちよろと無花果の幹を滑り下りるのを見た時から、この謎はわけもなく解かれてしまつた。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯は微かに慄えながら、天井を滑り下りると、壁を照らした。",
              "citation": {
                "source": "疑問の金塊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「滑り下りると、そこには一つの関所がある。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "後でタクマ少年から聞いたところによると、博士は僕の盗難を大学の人からの急報によって知り、ベッドを滑り下りると寝巻のまま大学へ駆けつけ、それから捜査に移ったそうである。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かな谷の湯の宿に別れを告げて谷に沿うた道を二本杖で滑り下りる。",
              "citation": {
                "source": "山と雪の日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして其中には大きな倒木が横たわっているので、調子に乗って滑り下りると向う脛が逆に曲る程痛い目に遭う。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "急な下りに向うと私達は源次郎の真似をして、立った儘滑り下りる稽古をした、幾度か筋斗打って倒れたが、稍や慣れて来た頃には梯子谷の落口に着いていた。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来るだけしかめっ面をして、真向うの斜面を見上げ見下しすると、はるか上の方を、えらい勢で滑り下りる人がいる。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを滑り下りる遊び　海に沿ったハイウエイを北に向かった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "スロープから飛び出さないための操縦もこなしつつ、その人は橇とともにスロープを滑り下りる。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "橇で滑り下りるにあたっては、スロープのぜんたいに上から下まで、樹の葉をびっしりと敷きつめる。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "激しく雨の降る日に、橇とひとつになって、水しぶきとともにスロープを滑り下りる。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　という声を背に、伊兵衛は裏梯子を滑り下りると、逃げ惑う宿の人々のあいだをぬけて、裏手へとびだした。",
              "citation": {
                "source": "夜明けの辻",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄板をこじ明けて、二人がハッチを猿のように滑り下りる。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "椅子からすべり下りると敷石の上に身を投げ出して、思い存分泣いた。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "愈丘の畑をすべり下りると平たい、かつと明るい渚に出る。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつ帰ってきたの」　道夫はそういって、寝台からすべり下りると、雪子の方へかけよった。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへスキー回転競技式の曲線型にレールをしいてオモチャの自動車にお客をのッけてアッというまにすべり降りる仕掛けがあった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっとの思いで密林の急斜面をすべり降りると、池の縁についてゆっくりと梓さんのほうへ近づいて行き、スキーをぬいで、黙ってそのそばに並んで坐った。",
              "citation": {
                "source": "キャラコさん",
                "author": "雪の山小屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "斜面を滑りおりると、こんどはソリを引き上げなければなりませんが、ただ後からついてゆくだけで、あの人が独りで引き上げてくれました。",
              "citation": {
                "source": "旅だち",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "樋から滑りおりると、そのまゝ身をかくして、建物にそつて逃げだしました。",
              "citation": {
                "source": "エミリアンの旅",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
