[
  {
    "uuid": "e6ec0e17-1415-5873-9d89-ed5445a3b361",
    "entry": "住処",
    "reading": {
      "primary": "すみか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
