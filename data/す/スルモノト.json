          "literary": [
            {
              "text": "仍リテ両者ハ根本的ニ構造ヲ異ニスルモノト謂フベク、従テ本願ハ、援用立像ヲ以テ拒絶セラルル理由ヲ発見シ得ザルモノナリ。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二条　土地ハ一切ノ（公然タル若クハ隠蔽サレタル）賠償ナクシテ今日限リ全労働大衆ノ使用ニ帰スルモノトス。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "賢兄心ニコノ義ヲ主トシサキニ先人ノ遺稿中ニ就テ曾撰ノ二首ト自ラ賦スルモノトヲ合セテ天下ノ一大壇場ニ上シ以テ不朽ニ垂レシム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "因テ二、三ノ従游スルモノト相謀リ諸家ノ麗藻ヲ選ンデ梓シテコレヲ伝ヘントシタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
