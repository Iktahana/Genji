        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三月二十六日（月曜）　マールイ・テアトルで、スミルノワの引退興行があった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノワ、まだ奇麗で、声もすみ、立派であった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノワのところへ行く、五つと幾月かの女の子、音楽と踊をやって居る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は黄繻子の頭巻きで、下から黒い髪の束をこぼし、家の外羽目に打ちつけてあるＴ・Ａ・スミルノワ、黒で書いた白エナメルの表札を見上げていた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
