          "literary": [
            {
              "text": "アツハハ、ハツハ、アツハハハ神鳴り四、五匹ゴロ／＼／＼、雲の上からスツテンコロ／＼、物ほし台にひかかつた。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "借金スルノハツライモノ鍋釜マデモミンナ取ラレテスツテンテンと、途方もない自暴を飛ばしたのもある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしさう云ふ奴が敵に廻つてゐるときつと儲けた金以上のものをスツテしまふのがきまりであつた。",
              "citation": {
                "source": "吸血鬼",
                "author": "ジョン・ポリドリ",
                "note": "青空文庫"
              }
            }
          ]
        }
