        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "高邁ノ精神ヲ喚起シ兄ガ天稟ノ才能ヲ完成スルハ君ガ天ト人トヨリ賦与サレタル天職ナルヲ自覚サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "巧言令色足恭、怨ヲ匿シテ其ノ人ヲ友トスルハ、丘｜之ヲ恥ヅ　とか、生ヲ求メテ以テ仁ヲ害スルナク身ヲ殺シテ以テ仁ヲ成スアリ　とか、狂者ハ進ンデ取リ狷者ハ為サザル所アリ　とかいうのが、それだ。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "誠ハ天ノ道ナリ、コレヲ誠ニスルハ人ノ道ナリ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ヲ殺スハ、国家ノ大禁ニシテ、人ヲ殺ス者ヲ罰スルハ、政府ノ公権ニ候処、古来ヨリ父兄ノ為ニ、讐ヲ復スルヲ以テ、子弟ノ義務トナスノ古習アリ。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "華族制ヲ廢止スルハ歐洲ノ直譯制度ヲ棄テテ維新革命ノ本來ニ返ヘル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ此ノ改造ヲ行ハズシテ而モ徒ラニ同盟罷業ヲ禁壓セントスルハ、大多數國民ノ自衞權ヲ蹂躙スル重大ナル暴虐ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ノ使命的勞働ヲ廢セシメテ全ク天性ニ合セザル勞働ヲ課スルハ、啻ニ婦人其者ヲ殘賊スルノミナラズ、直ニ其ノ夫ヲ殘賊シ其子女ヲ殘賊スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "不具廢疾者ヲ其ノ兄弟遠族又ハ慈善家ノ冷遇ニ委スルハ不幸ナル者ニ虐待ヲ加フルト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸ク文字ヲ解シ得ルカ得ザルカノ小學程度ヲ以テ國民教育ノ終了トスルハ國民個々ノ不具ト國家ノ薄弱ヲ來ス者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者ヲ強制スルハ無用ニシテ有害ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義者ノ或者ノ如ク一切ノ犯罪ナキ理想郷ヲ改造後ノ翌日ヨリ期待スルハ空想ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "年々多大ノ收益アリテ近ク私産限度ヲ超過スベク而シテ超過額ヲ國家ニ納付スルヲ欲セザル目的ヲ以テ、限度以下ノ時ニ於テ、自己自身ノ欲望ニ從ヒテ消費セントスルハ亦國民ノ權利ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ其ノ國防ニ於テモ組合ト組合員トノ間ニ雇傭契約ヲ締結スルハ、米ノ建國トシテ英ノ國家組織トシテハ少シモ不可ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ一點ヲ寛過スルハ實ニ國家ノ大網ヲ紊ル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度ヲ基點トシテ已ニ阿富汗ニ及ビ波斯ニ及ビタル彼ガ中央亞細亞ニ進出スルハ論ナク、極東海上ノ基點香港ト相應シテ中部支那以南ノ割取ヲ考ヘ始メタルハ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、人身ヲ売買スルハ古来ノ制禁ノ処年期奉公等種々ノ名目ヲ以テ其実売買同様ノ所業ニ至ルニ付娼妓芸妓等雇入ノ資本金ハ贓金ト看做ス故ニ右ヨリ苦情ヲ唱フル者ハ取糺ノ上其金ノ全額ヲ可取揚事。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ国家ノ秩序ヲ紊乱スルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ倫理ノ破頽ヲ来スモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ国家ノ主権ヲ害シ独立国ノ実ヲ失ハシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ憲法ノ実施ヲ害スルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ立法権ヲ抛棄シ之ヲ裁判官ニ委スルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ各人ノ権利ヲシテ全ク保護ヲ受クル能ハザラシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ争訟紛乱ヲシテ叢起セシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ各人ヲシテ安心立命ノ途ヲ失ハシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ国家ノ経済ヲ攪乱スルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
