        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは、オールドカルトンとかニューカルトンとかカフェマキスィムとか云ったたぐいの家々と共に上海一流の酒樓であるところの、「上海の赤風車亭」と呼ぶ家の地下室にあった倶楽部なのです。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝手を知つた小徑々々を暫くぶらつき、ヂョーヂ・スィドモア氏の碑の手前に腰を下す。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "次から次へと球を渡しながら、十人ばかり横に並んだのが一斉にグラウンド一杯に走り出して、パススィングの練習をはじめた。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、しとやかな畳障り、玄関の障子がスィーと開いた。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尻当を逆さまに結びつけて、一気にスィッティング・グリセードで滑り下りた。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メェルスィ・ビヤン！",
              "citation": {
                "source": "田舎がえり",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その奈落には、火薬炉が大きな口をあけて待っているのだ……」「能書はあとにして、金博士を骨にして見せて下され」「いざ、いざ、これを見よや」　王水険老師は、この寒中に汗だくだくとなって、廊下の床をおとすスィッチを引いた。",
              "citation": {
                "source": "大使館の始末機関",
                "author": "――金博士シリーズ・７――",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気炉のスィッチは入った。",
              "citation": {
                "source": "大使館の始末機関",
                "author": "――金博士シリーズ・７――",
                "note": "青空文庫"
              }
            },
            {
              "text": "後年、社会が私たちに、冷たく冷たく感じられるのも、こうしたスィートな幸福を知っているからだ。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでスィッチをひねります。",
              "citation": {
                "source": "画筆に生きる五十年",
                "author": "――皇太后陛下御下命画に二十一年間の精進をこめて上納――",
                "note": "青空文庫"
              }
            },
            {
              "text": "スィトピーはよいとして白いカード？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、コミッスィオンヌイ・マガジン〔古道具屋〕に入って何かＹのお祝いにないかさがす。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと一人、第一部からの中心人物である、プリスィプキンが、その見本に、博物学教室で飼われている。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "清潔な社会主義社会にとって有毒な官僚主義、俗人趣味のバチルスとしてのプリスィプキンは仮死状態で発見されたがそれをどう処理するか。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでホテルに行くと、トルーソツキイさんは、このごろこの中庭につき出ている翼屋のマリヤ・スィソエヴナの家具つきの部屋に『御逗留中で』という挨拶だった。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリヤ・スィソエヴナのところに洗濯に出してあるんですよ。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへマリヤ・スィソエヴナもやって來た。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「もういいじゃないかね、マリヤ・スィソエヴナさん」とパーヴェル・パーヴロヴィチは呟きかけた。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あらまあ、マリヤ・スィソエヴナさんだなんて！",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでマリヤ・スィソエヴナはリーザと接吻を交わした。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふとわれに返ると、彼はぺっと唾を吐いて錠前を思いきり、マリヤ・スィソエヴナのところへ案内をたのんだ。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日あの『孃っちゃん』を連れて行った先の首尾を手短かに問い訊してから、マリヤ・スィソエヴナはすぐさまパーヴロヴィチの行状に話題をむけた。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリヤ・スィソエヴナはなおも言葉をついで、次々にいろんな話をしてきかせた。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばある時のごときは、幸いそばにマリヤ・スィソエヴナがいたからよかったものの、さもない日にはリーザはきっと窓から飛び降り自殺を圖ったに違いない、とも言った。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて彼がクラーヴヂヤ・ペトローヴナに會って、マリヤ・スィソエヴナから聞いた話や、今しがたの葬列のなかでの奇怪な邂逅のことを傳えると、夫人はすっかり物思いに沈んでしまった。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリヤ・スィソエヴナは見るに見兼ねて、パーヴェル・パーヴロヴィチは夜の明けるまではとても歸って來まいと斷言する始末だった。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "パーヴェル・パーヴロヴィチは例によって不在だったので、彼はその手紙をマリヤ・スィソエヴナにたのんで歸った。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "『もうこれで三日も、寢に歸って來るどころか、てんで寄りつきはしないんですよ』というのがマリア・スィソエヴナの返事であった、『そうかと思うと、ひょっこり醉っ拂って歸って來ちゃ、一時間もしないうちに、またひょろひょろ出かけて行くんでございますよ。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあまあ、なんてお馬鹿さんなの、プレドポスィロフ！",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「私は請合いますがね、そんな入れ知惠をしたのは、あの――なんとか言ったっけ――あのプレドポスィロフでしょう？",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
