        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼等ノ欲スルトコロハ領土ニアラズ、物資ニアラズ、己レノ良心ト信仰トノ活路ヲ見出サンガタメニ新天地ニ出デタルモノ也。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "水ガ口ヨリ鼻腔ニ及ビ、完全ニ窒息スルトコロニテ止ム。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来テハイケナイッテ仰ッシャッタケレド、浄吉ガ行ケッテ云ウカラ来タワ」「浄吉ハドウシタンダ」「今又何処カヘ出テッタワ、チョット飲ンデ来ルッテ」「浄吉ガコヽヘ君ヲ連レテ来テ、僕ノ眼ノ前デ君ニ命令スルトコロヲ見タイト思ッタンダガナ」「命令ナンカ出来ヤシナイワ、工合ガ悪イカラ逃ゲチャッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハモウ少シデ怒号スルトコロデアッタガ、怒号シタラ動脈ガ破裂スルノヲ怖レテ、辛ウジテ怺エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ豫想スルトコロデハ、妻ハコノ記事ヲ読ンデモ読マナイフリヲシテ、マスマス淫蕩ニナルデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "検視スルトコロ五百余種。",
              "citation": {
                "source": "『雪華図説』の研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高弁、年来｜聖人ニ深キ信仰ヲ懐キ、聞ユルトコロノ邪見ハ、在家ノ男女等、聖人ノ高名ヲカリテ妄説スルトコロト思イ居タリ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
