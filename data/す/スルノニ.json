          "literary": [
            {
              "text": "ヤキユウヲスルノニ、ダマツテデキナイナンテ、ナンテ、バカナ小僧タチダ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤキユウヲスルノニ、コエヲダサナイデスルトイフワケニハユカンモンデスカネ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ洋式便所ヲ可トスルノニ、婆サンハ日本式デナケレバ困ルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシアスピリン系統ノ薬ナノデ、甚シク発汗スルノニハ閉口スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ母屋デモ家族全部ヲ収容スルノニ狭過ギルト云ウコトハナイガ、予ガイロ／＼ト企ンデイル悪事ヲ実行スルノニハ少シ不便デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンクリートヲ乾カスマデニ時間ガカヽルンデ、今カラ工事ヲ始メテモ完成スルノニ四カ月グライカヽルソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ睡ル真似ヲスルノニ都合ガヨカロウト思ッテ飲マシテヤッタノデアル）　彼女ガ睡リ込ンダ（モシクハ睡リ込ンダ風ヲシタ）ノヲ見定メテカラ、僕ハ最後ノ目的ヲ果タス行動ヲ開始シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
