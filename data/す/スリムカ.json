          "standard": [
            {
              "text": "経営を安定させるため、不採算部門を廃止して組織のスリム化を図る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この製品は機能を厳選して本体のスリム化に成功し、大幅な軽量化を実現した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "肥大化した官僚組織をスリム化するのは、一筋縄ではいかない課題だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "石井善昭の指揮のもと、情報処理事業グループの開発体制のスリム化が進められる中で、ＩＴＯＳの要員にも容赦なく人員削減の波は及んでいた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
