    "definitions": [
      {
        "index": 1,
        "gloss": "to attract",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "磁石を砂場に入れると、砂に混じっていた砂鉄が表面にびっしりと吸い付けられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "静電気を帯びた下敷きを頭の上にかざすと、髪の毛が逆立って吸い付けられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "強力な掃除機を使って、カーペットの奥に潜む細かい埃を根こそぎ吸い付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "だから惣兵衛の横に腰をかけてバットを一服吸い付ける迄の吉之介には、殺意なんか無論、無かった。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッチを擦って徳市のにつけてやり自分も吸い付けると、先に立ってあるき初めた。",
              "citation": {
                "source": "黒白ストーリー",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人はスバスバ吸い付ける。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのさらの上に、まだ火のついているすいがらをのせておき、つぎのたばこにすいつけるための道具なのだそうである。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄をすいつける磁石の力のことらしいのですが、そんな強い磁石があるのでしょうか。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　なんのッて、ひらひらと来る紅色の葉から、すぐに吸いつけるように煙草を吹かした。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（這出して、画家の金口から吸いつける）罰の当った――勿体ない。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "若いものは心付いたように、ハアトと銘のあるのを吸いつける。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは一服吸いながら聞くぜ」　半七は腰から筒ざしの煙草入れを取り出して、しずかに煙草を吸いつけると、清吉はやがて崩れるように両手をついて平伏した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "新カチカチ山",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇悪人の手…………かすかにふるえつつ、自分でマッチを擦り、葉巻に吸いつける。",
              "citation": {
                "source": "涙のアリバイ",
                "author": "――手先表情映画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんまに、えらいすんまへんな」と、やつと彼女は納得して云つたが、それでもまだ――「ほんまにかましまへんか」と、尚も云ひながら、そこに坐り直すと、バットの箱から吸ひさしの煙草を出し、ちやうど彼がつけた燐寸の火に、頭をかがめて、吸いつけるのであつた。",
              "citation": {
                "source": "釜ヶ崎",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニュース」はその「凄いこと」を書く奴を、その「無茶なこと」を書く奴を、砂の中に交っていても、その中から鉄片を吸いつける磁石のように吸いつけなければならなかった。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "女持の細い煙管で煙草を吸いつけるお新の手付には、さすがに年齢の争われないものがあった。",
              "citation": {
                "source": "ある女の生涯",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "一句写してはペンを擱き、一首書いては一服吸いつけるという風で、一向に為事がはかどらない。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、いやにつるつるしているくせに、すうーッと吸いつけるような肌ざわりのものであった。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者は煙草に火を吸いつけると、その煙草をすーっと吸い込みながら、「うー、」と長く引いた音を喉から出した。",
              "citation": {
                "source": "理想の女",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで煙草入を取り出して、燧を切って一ぷく吸いつけると、松風の響きが鼓のように頭上に鳴り渡ります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことに、まことに、プロメシウスが肝臓を食わして手に入れて来た火で、パンパンがタバコを吸いつけるのだ。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人影　……や……どうも……（吸いつける。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……長く書いたが、二人の人間と穴の中が照らし出されたのは、ホンのタバコを吸いつける七八秒のフラッシュに近い間のことである。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "村子　しょうがないわね……（わきの地めんに立っているロウソクに、右手と、くわえたタバコを近づけて、吸いつける。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は優しくて人を吸いつけるようであった。",
              "citation": {
                "source": "夏目先生の追憶",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小山の磁石は、敏ちゃんのより、形は小さいけれど、赤いところも全部ついていて、吸いつける力は強かったのでした。",
              "citation": {
                "source": "白い雲",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "磁石が鉄を吸いつける力を持っている事は誰でも知っています。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の消えない吸殻を掌に入れて転がしながら、それで次の一服を吸付けるという芸当も真似をした。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのせいではないが往来で葉巻を買って吸付けることはその時限りでやめてしまった。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
