          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「静かにして！ あそこに雀蜂の巣があるから、絶対に近づいちゃダメよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "黒い服を着て山に入ると、雀蜂に襲われる危険性が高くなるので注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "軒下に作られた雀蜂の巣を駆除するために、専門の業者が防護服で現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "スズメバチの巣に頭を突っ込むとなれば躊躇しますよ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "アプリアでは咬まれたスズメバチや雄鶏は踊るので不思議なことであった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヴィディウスはウェルギリウスと同じような考えをもっていて、ただスズメバチはウマの死体から、カブトムシはロバの死体から生じると考えていた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたがその女と過ごす楽しいはずの家庭は何とスズメバチの巣のような鬱陶しい所なんだ。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "スズメバチの巣に、頭を強引に突っ込むようなものだ。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそすずめばちにでも貸してやったら、いたずら者が寄りつかなくていいかと思っているのです。",
              "citation": {
                "source": "谷間のしじゅうから",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの、すごい剣を持っているすずめばちにですか？",
              "citation": {
                "source": "谷間のしじゅうから",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "がき大将の真坊は、先にたって、寺のひさしに巣をかけたすずめばちを退治にゆきました。",
              "citation": {
                "source": "真坊と和尚さま",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、かぶと虫のほかに、さいかちがいたし、また大きなありが動いていたし、しかもすこしはなれたところに、姉さんの欲しがっていた玉虫がとまっていて、それらを護衛するように、すずめばちが、怖ろしい目をして、あたりをきょろきょろながめていたのです。",
              "citation": {
                "source": "玉虫のおばさん",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、もうだれか捕ってしまったのか、それとも、どこへか飛んでいっていないのか、ただ大きなすずめばちだけが二、三びき前後を警戒しながら、幹から流れ出る汁へ止まろうとしていました。",
              "citation": {
                "source": "真昼のお化け",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "Asian giant hornet (Vespa mandarinia)",
        "register": "standard",
