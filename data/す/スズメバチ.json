        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "世界最大の雀蜂である大雀蜂の羽音は、まるで小型のヘリコプターのようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この雀蜂は猛毒を持っているから、一箇所刺されただけでも命に関わるんだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "森の中で巨大な雀蜂と遭遇し、息を殺して通り過ぎるのを待った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
