        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "百本杭といつて、われわれ子供にはこれは願つても無い陸釣りや蟹つりのスタヂアムだつた。",
              "citation": {
                "source": "両国橋の欄干",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日から「おとうちゃん」の撮影、第一日は後楽園スタヂアムでロケだが、上山や大西が気をきかして呉れないから無駄と分ってながら砧へ行き、簡単なカツラ合せして、改めて後楽園へ向ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月十七日（月曜）　今日は後楽園のスタヂアムで職業野球の試合があり、その中へまぎれ込んで撮影をする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コマスタヂアム、大阪のははじめてだが、やっぱり相当ひどいところなり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和三十三年六月六月一日（日曜）晴　梅田コマスタヂアム千秋楽。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "タクシー、すぐだが、梅田コマスタヂアムへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
