          "literary": [
            {
              "text": "「君、あそこの隅にスラッピングがあるだろう。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は「日本の軍隊では、スラッピングは非常に簡単に、かつしばしば行われる習慣であり、撲る方も撲られる方も、そう重大に考えないのである。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、何にしてもスラッピングはいい習慣ではない。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本軍隊におけるスラッピングの習慣については、昨日石川から聞いた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
