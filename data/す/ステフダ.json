        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代の処刑場近くには、罪状を記した捨て札が掲げられ、見せしめにされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "捨て札には罪人の名前だけでなく、その凄惨な犯行内容が詳しく書き連ねられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史資料館で展示されている古びた捨て札が、当時の厳しい法制度の面影を伝えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
