[
  {
    "uuid": "803c3954-e110-5904-8392-0dbc652fd4d2",
    "entry": "すり抜ける",
    "reading": {
      "primary": "すりぬける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-自動詞"
      ],
