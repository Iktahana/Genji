          "literary": [
            {
              "text": "音楽と夕陽と郷土服の女給たちが、スウェイデン料理とともに一夕の旅愁を慰めるだろう。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "古いストル・トルグの広場――一五二〇年｜丁抹の暴王クリスチャン二世がここでスウェイデンの貴族達を虐殺したという、歴史に有名な「血の浴み」のあと。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "国語もふたつ使われて、上流と知識階級はスウェイデン語を話し、他はフィニッシである。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            }
          ]
        }
