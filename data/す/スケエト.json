        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは丘の上にある大きなロオラア・スケエト場のためだつた。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、スケエト場の入口の凸凹鏡の中に、見知らない少女の顏がへんてこに歪んで映つてゐるのを見て、噴き出しさうになつた。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日のやうに、スケエト場は滿員だつた。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            },
            {
              "text": "キキ等はスケエト場の一隅で、自分等のスケエテイングの番を持ちながら、滑つてゐる天使たちを眺めてゐた。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの小さな探偵たちはジジを追跡するために、いそいでスケエト場を去つた。",
              "citation": {
                "source": "羽ばたき",
                "author": "Ein Marchen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
