        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "有島武郎氏と独逸娘７・５（夕）　有島武郎氏が独逸へ行つた時、スツツトガルト行きの汽車のなかで、独逸人の夫婦ものが、妙齢の娘をつれてゐるのに一緒になつた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「スツツトガルトへ行くつもりです。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「スツツトガルト？",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車は程なくスツツトガルトに着いて、皆はどやどやと歩廊へおりた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "したが、明日またスツツトガルトの何処かでお目にかゝるかも知れませんね。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の娘をつかまへて明日またスツツトガルトの何処かで会はうなんて、怪しからん事を言ふ奴ぢや。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
