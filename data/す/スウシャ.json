          "standard": [],
          "literary": [
            {
              "text": "同人の末に連つてゐる行きがゝり上、從順な會員に、濁りを帶びた歌を見せて、趨舍に當惑させるのは、或は單純に考へれば、罪惡ともいふべきものでせう。",
              "citation": {
                "source": "茂吉への返事",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "西園寺公望侯、渡邊國武子、金子堅太郎男の三氏に至ては、是れ純然たる伊藤侯の門下生なれば、則ち侯と進退趨舍を倶にするは亦怪む可きなし。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "（七五）巖穴の士、（七六）趨舍（七七）時有り、此の若きの類、名（七八）湮滅して稱せられず、悲しい哉。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "伯夷列傳第一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
