        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古民家の鴨居にある透かし彫りをよく見ると、波に千鳥の意匠が凝らされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "透かし彫りの技法を用いた木製のランプシェードが、壁に美しい模様を映し出している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この家具には、職人の手による繊細な透かし彫りが施されており、非常に価値が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "下の方は、足をのせる金属の台があつて、それには透かし彫りの模様があります。",
              "citation": {
                "source": "疣",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "お宮の扉の上にある象鼻や獅子頭の彫刻、それから宮の中の透かし彫りの鳩やにわとりなども、昔手をふれたままなのがたまらなくなつかしい。",
              "citation": {
                "source": "落穂",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "沈の木の透かし彫りの箱に入れて、同じ木で作った上飾りを付けた新味のある御贈り物であった。",
              "citation": {
                "source": "源氏物語",
                "author": "絵合",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさしく、だきみょうがの透かし彫りが見えるのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭には朝鮮風の金銅彫りの妙異な冠が飾られ、それから宝石をちりばめた透かし彫り金物の長い飾り紐が垂れている。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "振子は、金メッキされて居り、透かし彫りにした朝顔が、その肩のところに花を開いている。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "簀戸の腰板に、観世水が透かし彫りになっていた。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "下の方は、足をのせるかねの台があって、それにはすかしぼりの模様があります。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一階の上にある長い張出窓には、図456に示すように、松、竹、その他をすかしぼりにした繊美な木細工が、ちょいちょい見られる。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時まで嗜んで持っていたか、懐中鏡やら鼈甲に透彫の金｜蒔絵の挿櫛やら、辺に散ばった懐紙の中には、見覚のある繿縷錦の紙入も、落交って狼藉極まる、蝶吉はあたかも手籠にされたもののごとく、三人｜懸りで身動きもさせない様子で、一｜人は柄杓を取って天窓から水を浴びせておった。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の襟脚、黒髪と水際立って、銀の平打の簪に透彫の紋所、撫子の露も垂れそう。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と莞爾と笑み、はじめて瞳を座敷に転じて、島田の一にぐいとさした、撫子の花を透彫の、銀の平打が身じろぎに、やや抜け出したのを挿込みながら、四辺を視めて、茶棚に置いた剃刀にフト目が留まった。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……蓋は黄金無垢の雲の高彫に、千羽鶴を透彫にして、一方の波へ、毛彫の冴で、月の影を颯と映そうというのだそうですから。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いざ、金銀の扇、立つて舞ふよと見れば、圓髷の婦、なよやかにすらりと浮きて、年下の島田の鬢のほつれを、透彫の櫛に、掻撫でつ。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面中央には伊太利産らしい、大理石の枠を持った大煖炉があり、丸透彫の前飾も、確に勝れたものでした。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺｜天鵞絨を敷きつめた、燭光の強い光の海に近頃流行のビーズ細工の袋や、透彫の飾ピンが、影もなく輝いている。",
              "citation": {
                "source": "氷蔵の二階",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デッサンはちがうけど、帯はマァベルのゴブランで、帯留は沈香の花鏡の透彫りというのは、いったいどういうことなんでしょう……へんだわ、どころの話ですか。",
              "citation": {
                "source": "姦（かしまし）",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "また振返って階段の下なる敷石を隔てて網目のように透彫のしてある朱塗の玉垣と整列した柱の形を望めば、ここに居並んだ諸国の大名の威儀ある服装と、秀麗なる貴族的容貌とを想像する。",
              "citation": {
                "source": "霊廟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "デッサンはちがうけど、帯はマアベルのゴブランで、帯止は沈香の花鏡の透彫りというのは、いったいどういうことなんでしょう……へんだわどころの話ですか。",
              "citation": {
                "source": "猪鹿蝶",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝塔は木造で斗※以上を極彩色とし、軸部には全面に蝋色地、高蒔絵を施して、これに七宝入りの精巧な透彫金具を打ち、眼もさむるばかりに美しい。",
              "citation": {
                "source": "増上寺物語",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史画に見る古羅馬貴族のように襞の多い折目の付いた寛闊な麻の外衣を着け、肩には精巧なる金の透彫りの外衣吊りを懸けていた。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっ、こ、これは……」「覚えがあるか」「仁木さんこりゃあ、こりゃあ」　お天気安、眼を剥いて吃った、――兵馬はひたと木剣をつけたまま、「龍の透彫、金象眼の眼、耳に疵のあるところ、きさまがあの晩、大先生のお手へ預けた物に相違あるまい」「ま、まさに、まさにこれです」「甲子雄、尻尾を掴んだぞ！",
              "citation": {
                "source": "初午試合討ち",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず、一切の建物が美しい朱や緑に塗られ、透彫りの金具や軒の風鐸や箜篌がきらびやかに相映った」と。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこの百済観音の時代が下ることに就いては、その台座の蓮弁に胡桃形の隆起が作られていることや、宝冠の透彫意匠が白鳳的になっていることからも考えられる。",
              "citation": {
                "source": "百済観音と夢殿観音と中宮寺弥勒",
                "author": "野間清六",
                "note": "青空文庫"
              }
            },
            {
              "text": "それについて一つのヒントを与えるのは宝冠の透彫である。",
              "citation": {
                "source": "百済観音と夢殿観音と中宮寺弥勒",
                "author": "野間清六",
                "note": "青空文庫"
              }
            },
            {
              "text": "この像は見事な透彫の壮麗な宝冠をいたゞき、この像の美しさを一層引き立たせているが、実はその透彫の文様なり技法が、法隆寺金堂の四天王像の宝冠にも似ているのである。",
              "citation": {
                "source": "百済観音と夢殿観音と中宮寺弥勒",
                "author": "野間清六",
                "note": "青空文庫"
              }
            },
            {
              "text": "引戸や小引出の多いもので、しばしばその横桟には透彫を施します。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "西欧のあの中世紀において、工人たちはあの美しい絵硝子やまたは透彫の窓枠に、彼らの名をいちいち刻んだであろうか。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "透彫や浮彫や、また線彫や、模様もまた多種である。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "無地のものもあるが多くは模様附で透彫かまたは線彫である。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
