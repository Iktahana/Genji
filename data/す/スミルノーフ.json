        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（ため息をつく）だめ、だめ、こうなったらもう、ほんとに尼寺へでも行かなくちゃ……（考えこむ）そう、尼寺へ……四ポポー※、ルカー、スミルノーフスミルノーフ　（入りながら、ルカーに）でくのぼうめ、つべこべご託をならべやがる。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "退職陸軍砲兵中尉、地主のグリゴーリイ・ステパーノヴィチ・スミルノーフであります！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　亡くなられた御主人と、おつきあいを願っておった者ですが、その御主人に、約束手形二枚で合計千二百ルーブリ、御用だてしてあります。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　わたしから、カラス麦を買われたのです。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフに）それは、宅が拝借したものでしたら、もちろんわたくし、お支払い申しますわ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ところが、今のわたしの気分は、もし明日、利子が払えんとなったら、しゃっちょこ立ちで夜逃げをせずばなるまいと、そういうわけなんで。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　こっちが金のいるのは、明後日じゃない、今日なんです。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ところがこっちは、明後日まで待つわけにゃ行かんので。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　すると、払えんと言われるのですか？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　致し方ございません……スミルノーフ　ふむ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ぎりぎりですな？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ありがたい仕合せだ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきも途中で、税務署の男に逢ったら、「なんだってあんたは、いつもぷりぷりしてるんです、ええスミルノーフさん？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　わたしは支配人を訪ねて来たのじゃない、あなたをですぞ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（足ばやに退場）五スミルノーフ（ひとり）スミルノーフ　ええ、どうだい！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "六スミルノーフ、ルカールカー　（登場）何ご用で？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ク※ス〔無色透明の清涼飲料〕か水を持ってこい！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　いやはや、なんたる論理だ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "七スミルノーフ、ルカールカー　（登場して、水を差し出す）奥様はお加減がわるくて、お相手ができねえそうで。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　出て失せろ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　お加減がわるくて、お相手が！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ヴォー※カを一杯もって来い！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ふうっ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ルカー　（登場、ヴォー※カを差し出す）旦那、あなたも相当、気ままでいらっしゃるね……スミルノーフ　（ぷりぷりして）なんだと？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルカー　いえなに……わしは……ただその……スミルノーフ　相手をだれと心得とるか？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ああ、腹が立ってならん！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　金さえ払ってくださりゃ、出て行きますよ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミルノーフ　ところがわたしも、やはりロシヤ語で、こう申しあげましたよ、――金のいるのは明後日じゃなくて、今日ですとね。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
