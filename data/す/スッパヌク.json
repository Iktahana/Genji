    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さっきまで迷亭の悪口を随分ついた揚句ここで無暗な事を云うと、主人のような無法者はどんな事を素っ破抜くか知れない。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸ッ子衰亡の巻日本第一の無自覚　何でも裡面の消息を素っ破抜くと、大抵は皮肉か憎まれ口になる。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "親が破産しかかって、せっぱつまり、見えすいたつらい嘘をついている時、子供がそれをすっぱ抜けるか。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを読んでくれると、私がさきにもちょっと言って置いたような「親が破産しかかって、せっぱつまり、見えすいたつらい嘘をついている時、子供がそれをすっぱ抜けるか。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「蒲鉾小屋に住んで、襤褸を着て、名刀を所持してスッパ抜く、ちゃァんと敵討ちに出来ている。",
              "citation": {
                "source": "首頂戴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "うるさいことをスッパ抜く奴と思われることを必定として、ここにもう一ぺん念のため語らざるを得ないのはなんとしても翁の驚くべき勘違いである。",
              "citation": {
                "source": "素人製陶本窯を築くべからず",
                "author": "――製陶上についてかつて前山久吉さんを激怒せしめた私のあやまち――",
                "note": "青空文庫"
              }
            },
            {
              "text": "お婆さんに取ってしまったんですもの」　と秀子さんが素っぱ抜く。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
