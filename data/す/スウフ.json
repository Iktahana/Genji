          "literary": [
            {
              "text": "それだのに我国の文教の枢府ではこの事実に無神経である。",
              "citation": {
                "source": "教育映画について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木貫太郎海軍大将は、枢府議長の任にあったが、今度大命を拝した。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日にはすでに明倫会が、政府の声明書の微温的なのを慊らぬものとして、一木枢府議長の引退を希望するという態度を明らかにした。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "身命を投げだして、内閣や枢府の知人の政治家らに訴えた。",
              "citation": {
                "source": "私の歩んだ道",
                "author": "蜷川新",
                "note": "青空文庫"
              }
            },
            {
              "text": "枢府の原嘉道氏は、私に鄭重に回答された。",
              "citation": {
                "source": "私の歩んだ道",
                "author": "蜷川新",
                "note": "青空文庫"
              }
            }
          ]
        }
