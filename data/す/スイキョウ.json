  {
    "uuid": "00027674-4f1e-5b71-8ef3-aca11de7a4d4",
    "entry": "酔狂",
    "reading": {
      "primary": "すいきょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
