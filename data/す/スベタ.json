    "definitions": [
      {
        "index": 1,
        "gloss": "bitch",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あんなスベタに騙されるなんて、君もよっぽどお人好しだね」と彼は吐き捨てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔の映画に出てくる悪役の女性が、ヒロインを「このスベタ！」と罵るシーンがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スベタという言葉は差別的な響きを含むため、現代の日常会話ではまず使われない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "マダムはシヤン、お嬢さんはスベタ、まことにお気の毒なことですが。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分には今のところ場末の酒場でスベタ女給を相手に悪酒に泥酔する能力さえなくなってしまっているのである。",
              "citation": {
                "source": "変なあたま",
                "author": "――最近の心境を語る――",
                "note": "青空文庫"
              }
            },
            {
              "text": "都城で、嫌でも眼につくのは、材木と売春婦とである、製材所があれば料理屋がある、木屑とスベタとがうよ／＼してゐる、それもよしあし、よろしくあしく、あしくよろしく。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの、やきもちやきのスベタのことを？",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「スベタとはなに？",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ヘヽヽヽ、スベタとは、見目かたちよからぬ女房のことで……」「わかつた、わかつた……。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「帰してあげよう……そのスベタとやらのそばへ……」「では、早速にも……？",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すべため、お前なんかの相手になるもんか……」と、ひよいと私を振り返つて聲高な日本語で云ひながら、水島君は冷たい笑ひを浮べた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙は雪の振袖をふすべた。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はお君が来てからも、まるで女工と女中を兼ねたような申し分無い働き振りのお君に家の仕事を任して、相変らずあちこちの遊廓を遊び廻り、どこでやるのか博奕に負けて帰ると、理由もなしにお君の横面を撲ることを常とし、そんな時必ず使うどすべた！",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなすべた女郎を相手にしたつて始まらねえ。",
              "citation": {
                "source": "權三と助十",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "けえって、おもしれえや」一八「そりゃあ、そうだとも、気ちげえだって普通の女だって、恋に狂えば紙一重――どうせ、おら達だって、食い酔や、気ちげえだでなあ――へ、へ、へ」　と、相棒も、いやしく笑って、「気ちげえの、普賢菩薩なら、正気のすべたと、比べものにゃあならねえ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍛冶屋の富五郎さんだって、それから当り矢の店へ来てくだすった大店の若旦那やなんか……」「すべたッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "老嬢などという手合いの中からでも世間のばか者どもはどうしてこれに気がつかずに、むざむざ年を食わしてしまったのかと、驚くようなところを捜し出すことがときどきあるのだよ、はだし女やすべたには、初手にまずびっくりさせてやるのだ――これがこういう手合いに取りかかる秘訣なのさ、おまえは知らないかい？",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "『それに、あいつ、あの「すべたあま」、出してもらえないんだ』とわたしは考えた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべたのくせに」「どうせすべたさね」「すべたならもっとおとなしくしておいで」「すべたとはお前さん達のことじゃないかよ。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、おそくなっても、今日は一日アゼ豆の植え込みで忙しいから迎えにゃ行かねえからな、あい、むすべた。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お咲はまつつぐ松原への道のりを行き、家の前に鳥渡立ちどまつたが、すぐ爐端にしやがみこんで榾をくすべた。",
              "citation": {
                "source": "命",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべた奴、親分の智恵がどんなに働くか、今にみろ――といった恰好です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金蔵の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべた奴、親分の智慧がどんなに働くか、今に見ろ――と言つた恰好です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "金藏の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何を、すべた奴ッ、誰がお前なんかに怖れるものか、奥村の殿様の手前、許しておけば際限の無い女だッ」　主殿の後ろから躍り出したのは、好い男の鶴次郎です。",
              "citation": {
                "source": "天保の飛行術",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（又さがる）茂兵衛　すべたじゃあない。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "弥八　　すべただ、大すべただ、父なしッ子を生みやがって。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべたの知ったことかッ」　恐ろしい怒号と共に、彼女は再び投げ飛ばされた。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この阿魔、早くしろ、文句ウぬかすな、すべた野郎め、来ておれの足を洗え、……女ッてやつアこれに限るんだ、おらあこの式だ、本当だぜおやじ、女アね、女ッてやつアそれでちょうどなんだ、……嘘だと思うんなら」　信吉の唇がふるえながら歪んだ。",
              "citation": {
                "source": "嘘アつかねえ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おら自分でその女に会って、その女の口からじかに聞いただ、よくもあんなすべたあまと見替えやがった、もう騙されやしねえぞ。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいかげんにしろすべた阿魔、恐れながら十八万六千石の御尊体だ。",
              "citation": {
                "source": "若殿女難記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わっちだって一升一匁八分なんて酒より、剣菱か三鱗の生一本とくるほうが正月だからね、あんなおこぜの生れかわりみてえなすべたの代りに御殿女中だのお姫さまと浮気を」「その口を閉めろ、ばか者」紋太夫は低く叱りつけた。",
              "citation": {
                "source": "若殿女難記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫も殺さねえ面をしやがって、このすべた阿女の潘金蓮め。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかみさんは、蒋門神親分のお持ち物でございますからね」「だからよ……蒋門神を呼びにやるより、そこのすべたを泣かした方が、野郎をここへ素ッ飛ばせて来る早道だろうじゃあねえか」　聞くと、帳場の女は、横の肉切り台に向って包丁をうごかしていた数名の料理人に向って、女将軍のように、往来を指さして叫んだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
