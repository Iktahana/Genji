        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "花札の勝負で、最後に引いた札がスベタだったので、結局役を作ることができなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「カスばかり集めても点にならないよ、それはスベタだ」と祖父が教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "運悪く手札がスベタばかりで、今回の回回しは早々に諦めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
