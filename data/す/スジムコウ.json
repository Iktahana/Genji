        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "私の実家は、あの小学校のちょうど筋向こうに位置している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "筋向こうの古いビルに、深夜まで営業している人気の店がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大きな通りの筋向こうにあるコンビニで、10時に待ち合わせよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ただ女が三四郎の筋向こうに腰をかけたばかりである。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ筋向こうにすわった男が、自分の席に帰る三四郎をちょっと見た。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると筋向こうにいたさっきの男がまた三四郎の方を見ていた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎の筋向こうにすわっていた色の白い品のいい学生が、しばらくナイフの手を休めて、与次郎の連中をながめていたが、やがて笑いながら Il a le diable au corps（悪魔が乗り移っている）と冗談半分にフランス語を使った。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学のほうでいうと、イブセンのようなものじゃないか」と筋向こうの博士が比較を持ち出した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝沢の家の筋向こうに、『万葉堂』という貸本屋があった。",
              "citation": {
                "source": "暴風雨に終わった一日",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋向こうの屋根船には当時の落語家番付で勧進元の貫禄を示している初代春風亭柳枝が、でっぷりとした赦ら顔を提灯の灯でよけい真っ赤に光らせながら門人の柳條、柳橘を従え、苦が苦がしくこちらを見守っていた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋向こうの屋根船には、当時の落語家番付で勧進元の貫禄を示している初代春風亭柳枝が、でっぷりとした赤ら顔を提灯の灯でよけい真っ赤に光らせながら門人の柳条、柳橋を従え、にがにがしくこちらを見守っていた。",
              "citation": {
                "source": "圓朝花火",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレベーターを三階で降りてうろうろしてたんですが、何もないので四階から五階へと階段を上がっていくと、ちょうどエレベーターを降りた一人の男が、筋向こうのドアの前に立って、こつこつとやっているんです。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは己の下宿のすじむこうの雑貨店の二階から裁縫学校へ通っている小柄な色の白い女であった。",
              "citation": {
                "source": "牡蠣船",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右側の車線のすじむこうにある高層ホテルには、ＳＥＩＫＯの英文字がブルー地に白。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "處でひよいと顏を上げて筋向うの座席を見ると、馬鹿に綺麗な女がゐるぢやあないか。",
              "citation": {
                "source": "Ｓ中尉の話",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "床店の筋向うが、やはりその荒物店であります処、戸外へは水を打って、軒の提灯にはまだ火を点さぬ、溝石から往来へ縁台を跨がせて、差向いに将棊を行っています。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、筋向うの格子戸の鼠鳴に、ハッと、むささびが吠えたほど驚いて引返して、蔦屋の門を逆に戻る。",
              "citation": {
                "source": "第二菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "菩提寺の寺は、町の本陣の位置に在るわたくしの実家の殆ど筋向うである。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日比野の家は、この町内で子供達が遊び場所にしてゐる井戸の外柵の真向ひで、井戸より五六軒｜距つたお涌の家からはざつと筋向うといへる位置にあつた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その筋向うに瓦斯器具一切を売る安普請の西洋館がある。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日比野の家は、この町内で子供達が遊び場所にしている井戸の外柵の真向いで、井戸より五六軒｜距ったお涌の家からはざっと筋向うといえる位置にあった。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の夜から、筋向うの其の土藏附の二階家に、一人氣が違つた婦があつたのである。",
              "citation": {
                "source": "霰ふる",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜から、筋向うのその土蔵｜附の二階家に、一人気が違った婦があったのである。",
              "citation": {
                "source": "霰ふる",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと筋向うのが柳屋のだと、声をさえかけて下すったら、素通りにされても怨まない。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "うなぎ屋は筋向うで、時々行ったこともあるし、またそこのかみさんがお世辞者だから、僕は遠慮しなかった。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」筋向うに座を占めてこちらを見詰めていた男がまた笑った。",
              "citation": {
                "source": "猫八",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳やイタヤもみぢなどが青い葉を飾つて路傍に立ち並んでゐるその角は、ちひさい個人的な鐵工場で、その筋向うに、「北海實業雜誌社」といふおほきな看板が出してあつて、「島田氷峰」といふ表札が打つてあるのがそれである。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "却つてこの家の筋向うに當る鐵工場で鐵板か、何かをかん／＼云はせてゐる音だ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "義雄は立つて行つて、おもて座敷の窓から、脊延びして、板壁越しにのぞくと、筋向うの道ばたに姿のいいしだれ柳が立ち並んでゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして碌でもない炭屋の亭主――義雄の家の筋向うだ――にくツ付いて見たり、神田にゐる國のものだと云ふ人の、そしてちよツと同居した家の細君に疑はれて追ひ出されて來たり――それでゐて、こツちの本妻に立ち直らうとするなどとは以つての外だ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "敬太郎が立ち退いたので大いに安心したらしい彼女は、その中で最も熱心に何かを待ち受ける一人となって、筋向うの曲り角をじっと注意し始めた。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "松本の家はこの車屋の筋向うを這入った突き当りの、竹垣に囲われた綺麗な住居であった。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは荒川の家の筋向うになつてゐる、杉垣の家の門である。",
              "citation": {
                "source": "金貨",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
