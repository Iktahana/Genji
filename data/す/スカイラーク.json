        "examples": {
          "standard": [
            {
              "text": "早朝の草原で、スカイラークが天高く舞い上がりながら美しいさえずりを響かせている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "麦畑の上でホバリングするスカイラークの姿を見つけると、春の訪れを感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あそこのスカイラークで待ち合わせよう」と、友人からランチの誘いが来た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "父親のスカイラークのうしろに、停めた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
