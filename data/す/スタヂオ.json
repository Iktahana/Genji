        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私はそのスタヂオ・チューブを、色によって二本から五本位まで、十三四種選んだ。",
              "citation": {
                "source": "未来の天才",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "日活スタヂオの近くの家では彼はいつも運轉手と二人暮しだつたから、ついお酒をのむのであらうと思うた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "先の自叙伝にはまたいふ、「中学の三年の頃だつたと思ふ、若い図画の先生がある時英国の美術雑誌スタヂオを見せてくれた。",
              "citation": {
                "source": "オルゴール",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "映画人、スタヂオ生活者は、芝居人にくらべて活気が無い、ハリキってゐないとは、常々僕の思ってゐることだが、実際、つきあってみればみる程、夢が無いのでおどろく。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "永年の映画生活、此の連中はちゃーんとスタヂオの中で楽しめるやうに色々用意してゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "読み合せをやり、十時すぎからスタヂオへ入る、第一夜分を二度くり返す、「当世三人兄弟」浪六ものだが、何うも面白くないのでクサる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「映画之友」の小倉浩一郎が迎へに来り、徳山・藤山と共に、スタヂオめぐり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又放送局へ引返し、読み合せをして、スタヂオへ入り、テスト。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三夜の読み合せ、十一時すぎからスタヂオの風のないとこで二度通す、ねむし辛し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月のプラン　一、移民物　大陸の花嫁　二、新版小言幸兵衛　三、女優と詩人　四、スタヂオもの　活動のロッパ七月二十七日（水曜）　国際劇場の都築文男が見たくて、母上を誘ひ、国際へ、客種ひどし、子供泣く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東発のスタヂオは楽屋などきちんと出来てゐて居心地よく、他に一組も撮ってゐないのだから静かでいゝ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "近藤日出造が、スタヂオめぐりに来り、徳川夢声が「はたらく一家」で徳永直そっくりで、こっちが内田百間そっくりだといふ話。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "例によって読み合せから、スタヂオへ入ってテスト二回。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタヂオのみ冷房あり、八時二十分より「ベンシといふものがあった」を三十分間。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和十四年十二月十二月一日（金曜）　七時半起き、今日は東京発声のスタヂオで撮影、砧と違って寒々としてゝ淋しい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時すぎ迄うだ／″＼してゝタクシー、浜町スタヂオへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "かなりおざっぱいであったが、客は年配者多く、スタヂオ受けはよかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタヂオ内で、九時すぎ迄。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田より電話、明日の連合スタヂオ入りは一時となったので、十時半に東京へ帰り、日劇の喜劇まつりの稽古に顔出しすることゝなる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時すぎ迄これをやり、タクシー、船橋の連合映画スタヂオへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタヂオ入りは九時半。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一スタヂオで、「夢を呼ぶ歌」の歌だけ録音に行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあと引つゞき、「私のレコードアルバム」ってのを、ＣＢＣラヂオの方から頼まれ、一階の小スタヂオへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間一寸で、宝映画スタヂオ着。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、ひどいスタヂオだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間足らずで、宝映画スタヂオ着。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
