    "definitions": [
      {
        "index": 1,
        "gloss": "ornament",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "床の間に飾られた立派な据え物が、部屋全体の格調を上げている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その高価な据え物には手を触れないよう、子供たちに厳しく言い聞かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "骨董品店で見つけた奇妙な形の据え物に、彼は一目で心を奪われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "剣道にかけては柳生流の免許、大力ではないが業には達し、据え物斬りでは名人である。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "びっくりするなよ、据え物斬りのいき！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たしか剣法は柳生流、据え物切りではご名人。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海底には人魚の母が、桜貝と藻の花を、据え物として待っている。",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一歩一歩と足場をかためて、一つ一つの点では二度と気を煩わされなくてもよいように、きちっと片をつけて進むといっても、それは相手であるところの自然法則を据え物と見ているのではない。",
              "citation": {
                "source": "実験室の記憶",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おめえさんはどんなに腕が立つか知らねえが、先様だって、藁人形や据え物じゃアあるめえし、そう口で言うように、立派なお侍さんの首がスパスパ転がってお堪り小法師があるもんか」「ふうむ。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "斬り手はちゃんと定まっていて「すえものし」（居物師）といい壇術家ともいって、三家の師範がありおのおの門弟があった。",
              "citation": {
                "source": "せいばい",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラ据物斬りでもあれだけに腕の冴えた町人が、福岡博多におる筈はない……」　良助が独言のように言った言葉を聞咎めた和尚はギックリとして又立止まった。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさかあの女房が据物斬りの名人では通りますまい」「な……な……なるほど……」「ハハハ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあしっかり、まだまだ」　と、藁人形の据物斬、立木を打つ斬込の練習、宝暦九年まで隣近所で称めぬ者の無い位必死の稽古を試みた。",
              "citation": {
                "source": "相馬の仇討",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京では祝賀會に、豚の据物斬をして、豚汁をつくり、祝酒を飮むことが多かつた。",
              "citation": {
                "source": "日本橋あたり",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は豚の据物斬りが自慢だつたが、そんな時の父を、私はあんまり好かない。",
              "citation": {
                "source": "日本橋あたり",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "一體辻斬といふものは、据物斬の要領で、最初の一と太刀を損ずれば、刀を引いて引揚げるのが本當です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "辻斬綺談",
                "note": "青空文庫"
              }
            },
            {
              "text": "据物斬の腕がなきや人間の首は切れねえ」「――」「奧座敷か奧庭で斬つたから、荒筵でも菰でもない、大納戸にでも入つて居る疊表に包み、荷造の麻繩で縛つて、不淨門から持出させたのさ」「――」「殿樣の無體の折檻、女は言ふ事を聽かずに死んだ――可哀想に」　平次はもう一度美女の死骸に首を垂れるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "十手の道",
                "note": "青空文庫"
              }
            },
            {
              "text": "「据物斬の名人だらう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "迷子札",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手がやくざ者なら背中の方がもつと割けて居る筈だ、――ところが、權次は背後から斬られて居るくせに、切先が胸の方へ下がつて居る、これは据物斬の名人の腕前だ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "突つ込むやうに、前下がりに斬つた傷だ」　据物斬りの口傳を平次は聽覺えて居たのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へエ、へエ」「その髷切りの曲者は、――据物斬の名人だらうが、髷を切られた武家が、振り返つても姿は見えないさうだ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "髷切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "重ね着をした人間を、たった一と太刀で、これだけ斬り下げるのは、据物斬の名人でなければなりません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "やくざ剣術は刀を引きながら斬るから、傷口は手前が下がる、まして権次は逃げるところを後ろからやられたんだ、相手がやくざ者なら背中の方がもっと割けているはずだ、――ところが、権次は背後から斬られているくせに、切先が胸の方へ下がっている、これは据物斬りの名人の腕前だ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "突っ込むように、前下がりに斬った傷だ」　据物斬りの口伝を平次は聴き覚えていたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘエ、ヘエ」「その髷切りの曲者は、――据物斬の名人だろうが、髷を切られた武家が、振り返っても姿は見えないそうだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "髷切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "北の方は左から緩く引下して来た線が右へ緩く引上げて、眉の高さに大なる弧を描き、弧の内面には美しい笹を青｜天鵝絨のようにくけて、其上に銀を象嵌した金字形の八海山と中ノ岳とが程よく安置された据物のようだ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "重ね着をした人間を、たつた一と太刀で、これだけ斬り下げるのは、据物斬の名人でなければなりません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "お菊を殺したのは徳松なんかぢやない、据物斬の名人だよ」「えツ」「前から拔く手も見せず喉笛を切つて、噴き出す血を浴びる前に逃出したんだ」「――」「後ろから徳松が來た筈ですぜ、親分」　ガラツ八が口を出します。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "玉の輿の呪",
                "note": "青空文庫"
              }
            },
            {
              "text": "體術と据物斬に秀でたといふ、お菊殺しの下手人は誰？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "玉の輿の呪",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮から始まつて、幾人かの人を斬つた曲者――その中には相當の腕のある武家もあり、ヤハな腕前では、あの据物斬の凄い業が、出來る筈もありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "その養子の孫三郎さんは、据物斬の名人で、足は不自由だが、大した腕前であつた」「――」「その腕に慢じて、人を斬つて見度くなつた。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "身體が惡い爲に、朋輩にも馬鹿にされ、祿を奪はれて浪人したのを口惜しがり、裏の空地を道場にして、獨りで業を勵んで据物斬の名人になつた。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "女辻斬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは据物斬の名人だ」「ヘエ――、してみると女じゃありませんね」「女にも腕の出来るのはないとは限るまいが、据物斬の名人なんて女は聞いた事もない」「八人芸の名人とは異いますか、親分」、「馬鹿、手前もそんな事を考えているのか」　平次は少し険しい顔をガラッ八の方へ向けました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "八人芸の女",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "dead body used to test a blade",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "かつて名刀の切れ味を試すため、据え物を用いた残酷な儀式が行われたという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い記録には、試し斬りの際に据え物をどのように固定したかが詳しく記されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "刀剣愛好家の間では、据え物斬りの跡がある刀は非常に珍重される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "unlicensed prostitute who always works out of the same cathouse",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い廓言葉では、特定の場所に居着いて客を待つ女性を据え物と呼んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小説の舞台となった路地裏には、かつて据え物たちが集まる場所があったという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は据え物として生計を立てていたが、いつかはこの街を出たいと願っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
