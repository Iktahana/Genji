[
  {
    "uuid": "94b370db-ad95-5a2c-bd72-defde087c74f",
    "entry": "筋向かい",
    "reading": {
      "primary": "すじむかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
