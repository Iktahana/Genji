  {
    "uuid": "6bc99c25-5c97-5e62-be19-934b7984012b",
    "entry": "スジ",
    "reading": {
      "primary": "すじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ジェームスジョイスなどこの紋切型を破ろうとして大胆不敵な「ユリシイズ」を書いたが（「……」と彼は言った）などという月並みな文章がやはりはいっていて、何から何まで小説の約束から逸れるというわけには参らなかったようだ。",
              "citation": {
                "source": "神経",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが京から三河、三河からこの身延路へと退屈男の健脚は、今はもうスジ金入りでした。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいいち、これはスジがとおっているから、マシなほうだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　知子が妙にスジのとおった反撃をした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのときは、いろんなことがいっぺんに起こったし、おれは子どもだったし、いま考えるとスジがとおらないんだけど、もう、令子ちゃんのことは考えちゃいけないと思ったらしい」「なぜ？",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　シロイ　ミチヲ　ヒトスジニ　ハシリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スジヒトツバという羊歯は、本州には伊勢の外宮にのみ残り、熊野で予が発見せしは合祀で全滅せり。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "……のみならず、その君の言明を、自分の畢生の事業としている『精神科学的犯罪とその証跡』の第一例として掲げようと巧らんでいるスジミチが手に取る如くわかって来たのだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒眼鏡が酔いつぶれる時に、きまってあげる『オダ』に依れば、彼はどうにもしようのないやくざ者で、人の女房と姦通して、おまけに亭主の頭の鉢を金テコで打破って、無期徒刑を喰ったのだが、御大典のおかげで、二度と出られる筈のなかったこの社会に舞い戻って来たという札つきの『金スジ』だった。",
              "citation": {
                "source": "放浪の宿",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "堺筋では例の画家達のやっているというミス・サカイスジの相貌が見たいので私は苦しい流れを行進した。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、当惑して原稿をさし出し、何しろ赤鉛筆のスジのところはいけないって云うんですが、ということだった。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第五巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめから赤鉛筆を手にもって、べたスジをひくことにして読みはじめたものであることが一目瞭然であった。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第五巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤スジのないところには、文章さえのこっていないのだから、小説として発表が出来るわけもない。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第五巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "首スジまで赤くなるタチであった。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "毛スジほどのなつかしさも浮かべず、折れた歯でもこぼすように呟いたのは、それだけだった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "織田作ゆかりのコンドルというのを、まだその時は知らないから、とにかくカルピスジンではないピリリとした洋酒をのませる店を見つけようというので、ずいぶん歩いた。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "道頓堀罷り通る",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルピスジンでは仕上げになりませんや。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "道頓堀罷り通る",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせカルピスジンのたぐいだろうと思われるからである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "道頓堀罷り通る",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が鮎川の大洋漁業で仕込んだ智識の中でコレハ、コレハとおどろいたのを二三御紹介に及ぶと、ラケットのガットはクジラのスジで作るものの由。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "台風が来そうになると、海にむいた広縁の雨戸にスジカイを打って、ここへ逃げこむ。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "お家騒動とか、お家乗っ取りとか、そういったスジなんですか」　カオルは、下目に曽根を見おろすようにしながら、「お家騒動どころの、だんじゃないのよ。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しみったれたことや薄手なことはなによりきらい、好物はかん茂のスジと初茸のつけ焼。",
              "citation": {
                "source": "ユモレスク",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその色の濃い品を特に紅スジと称して珍重する。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花蓋片の中央｜紅色の深いものはベニスジユリと唱え珍重せられるが、これは園芸的の品である。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちそれはジャガタラズイセンとキンサンジコとベニスジサンジコ（牧野命名）の三種である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベニスジサンジコは昔アロエと誤称せられていたこともあった品だが今日絶て無くして僅かにある位のものである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その左手のシワの中に、かたまりかけた血液が、赤黒くスジになって光る。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他クラヴサン演奏家としてはレスジャン＝シャンピオンがあり、ビクターにあるクリスチャン・バッハの『クラヴサン協奏曲』（Ｋ六四二三―四）が可愛らしい。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
