        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大阪の街を南北に貫く御堂筋は、銀杏並木が美しいことで有名だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
