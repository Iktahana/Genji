        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "おでんの具材として人気の筋は、魚の軟骨などが含まれていて独特の食感がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
