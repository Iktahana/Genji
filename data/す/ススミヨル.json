        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三造はコンノート殿下のやうに進み寄る。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一足二足進み寄るのを見ると足も片方不随であるらしい。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ね、向うと此方に立ってね、剣を持って互に真中に進み寄ると、突き合い切り合いをやったんだよ、凄かったんだろうな。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と言つたまゝいと懷かし氣に進み寄る。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おいよは答えず、低く唸りながらお妙の方へ這うようにじりじりと進み寄る。",
              "citation": {
                "source": "人狼",
                "author": "――Were-Wolf――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（おずおず進み寄る。",
              "citation": {
                "source": "勘平の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっと御免ください」　諸人を押し分けて死骸のそばへ進み寄ると、あたりの人々は俄かに路を開いた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "足音に我が動くを知るものの、音なければ動く事を忘るるか、ウィリアムは歩むとは思わず只ふらふらと池の汀まで進み寄る。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "と彼女は、一層鬱憤を助長されたかの如くに、ツカツカと進み寄ると、一寸冷い笑ひを浮べて、低い垣根越しに斯んなことを云つた。",
              "citation": {
                "source": "秋晴れの日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母さんはさつさと大股に進み寄るなり、非常に素早く片方の足をにゆつと前へ踏み出して、声高らかに次ぎのやうな挨拶をのべた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼び醒されて、「眠り過ごした」　刀を取って一座の方へ進み寄ると、土方歳三が、「吉田氏、いずれもかくの通り用意が整うた」「ほう、拙者も仕度を致そう」　竜之助は、身ごしらえ、足ごしらえ、黒い頭巾を取って被ろうとしながら、「相手は清川一人か」「さいぜんも申す通り、別に苦手が一人」「苦手とは？",
              "citation": {
                "source": "大菩薩峠",
                "author": "甲源一刀流の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "局長は部屋の真ん中に突っ立ってジッと首を垂れていたが、やがて真名古の傍へ進み寄ると、何とも形容の出来ぬ凄然たる声で、一言、「真名古君！",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、また、ひと足進み寄ると、すこし厳しい声で、いった。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「恐れ入りますが、そのお腰の物を」　平次は死骸の側に進み寄ると、其処に並べてあった大小を取上げ先ず長い方を先に抜いて見ました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "恋患い",
                "note": "青空文庫"
              }
            },
            {
              "text": "「恐れ入りますが、そのお腰の物を」　平次は死骸の側に進み寄ると、其處に並べてあつた大小を取上げ、先づ長い方を先に拔いて見ました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "戀患ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一箇の人間の魂が、かくも壮絶な、かくも荘厳な――終滅の美を発するものかと、それへかかって行く者も、討って取らんと進み寄る者も、ひとしく、今は敵味方というけじめがない。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち土を掘り返して日の光が一面に当り、静かに進み寄る小草のまだ乏しい間に、たとえば植民地の最初の自然移民などのように、ここに暫くの盛りを息づくのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて彼は急ぎ足で進み寄るやうに見えた。",
              "citation": {
                "source": "吸血鬼",
                "author": "ジョン・ポリドリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラルフが進み寄ると、両手を差し伸べて、こう言われた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "親皇がお部屋の御簾を高く掲げて、お招きになったので、経正は前に進み寄ると、供の藤兵衛｜有教に赤地の錦の袋に入れた物を持って来させた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第七巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「本当に執拗い空瓶だこと」と、今度は妹娘が拾って投げようとすると、その時｜背後の方より、「二人とも何をしている、拾ったのは何んだ」と呼んだ者がある、振り向いて見ると父のモンテス博士で、ニコニコしながら進みよる。",
              "citation": {
                "source": "南極の怪事",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "お作　（進みよる）早速でござりますが……。",
              "citation": {
                "source": "近松半二の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（笑いながら進みよる。",
              "citation": {
                "source": "青蛙神",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "李中行　（進みよる。",
              "citation": {
                "source": "青蛙神",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりも心得て進みよる。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚作は笑ひながら進みよる。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて二人はうなづき合ひて稽古をやめ、左右をみまはして進みよる。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」こうチチコフは冷然と言い放って、将棋盤に進みよるなり、駒を引っ掻きまわしてしまった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切の準備の終った時、役人の一人は物々しげに、三人の前へ進みよると、天主のおん教を捨てるか捨てぬか、しばらく猶予を与えるから、もう一度よく考えて見ろ、もしおん教を捨てると云えば、直にも縄目は赦してやると云った。",
              "citation": {
                "source": "おぎん",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、竜太郎は、どうにも辛抱が出来かねる気持になってきたので、思い切ってそのそばに進みよると、こんふうに、声をかけた。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
