  {
    "uuid": "5a0ab2d2-ae93-5b9b-8e70-36d5ee5683dd",
    "entry": "すかすか",
    "reading": {
      "primary": "すかすか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "れいによりてのしのしとあゆみながら、茨など生ひしげりて、衣の袖をさへぎるにあへば、すかすかと切つて払ひて、うつくしき人を通し参らす。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "邸にはこの頃じゃ、その魅するような御新姐も留主なり、穴はすかすかと真黒に、足許に蜂の巣になっておりましても、蟹の住居、落ちるような憂慮もありません。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "急に斜に外れて巴里昼間新聞を買う人の起すかすかな空気のうずまき。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "れいによりてのしのしとあゆみながら、茨など生いしげりて、衣の袖をさえぎるにあえば、すかすかと切って払いて、うつくしき人を通し参らす。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親は額に汗をにじませながら、荒い鼻息の音をさせて、すかすかと乳を貧っている碧児の顔を見入っていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもその夜にかぎりてその怪物はすかすかと磐治が小舎にはいってきて、じつは己は汝を見こんでぜひ頼みがあって、いままで毎夜ここに通うたが、今夜は思いきって打ち明ける。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "椅子にかけて、遠くの野外音楽が送ってよこすかすかな音の波紋に耳をあたえていると――。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "三鴨倉太は、鼻をすかすか云はせながら、閾の外へ手をついた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんか、かう、すかすかした、興醒めな気持しか起らないのね。",
              "citation": {
                "source": "モノロオグ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "すかすかするような、それでいて馬鹿に甘ったるい乾藁の蒸れる匂いがいつもむんむん籠っていた。",
              "citation": {
                "source": "田舎医師の子",
                "author": "相馬泰三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」って返すだけでどんどん早足、追い風がふいてるせいか、ますますかすかになっていくうらぶらげな声。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」って返すだけでどんどん早足、追い風がふいてるせいか、そのうちますますかすかになっていくうらぶらげな声――よお〜おるの　す〜ううぷ！",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎧窓からさすかすかな光線で、三坪ほどの小屋の一隅に、土間に半分埋められた木臼が、三つならんでいるのがわかる。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
