          "literary": [
            {
              "text": "ストライキを起すとスワコソ社会主義という風に、手近い経験から来た概念的な犯罪常識をもって、一直線に片付けて行こうとする癖があるようだね。",
              "citation": {
                "source": "無系統虎列剌",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十何人も弟子をもって、東京にも大阪にも、都会という都会から招かれて、ラジオでしゃべり、新聞に記事がのり、ジャパン、スワコ、タニガワは、アメリカでもフランスでも知れ渡っているのよ。",
              "citation": {
                "source": "鋏と布と型",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            }
          ]
