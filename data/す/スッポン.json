    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今朝、ふるさとの新聞にて、なんとか家なる料亭、けしからぬ宿を兼ねて、それも歌舞伎のすっぽん真似てボタンひとつ押せば、電気仕掛け、するすると大型ベッド出現の由、読みながら噴き出した。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "池には鯉と緋鯉とすっぽんがいる。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "反対に宗右衛門町では、弦歌のなかで、河合屋芸妓の踏む床の足音がチャルストンの音律となり、はり半のすっぽんの霊に幻怪な世界を展開している。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "するともう一人が「なに、ありゃあふくろうじゃない、すっぽんだろう」と言った。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく顔を見合わせていた仲間の一人が「だって、君、すっぽんが鳴くのかい」と聞くと「でもなんだか鳴きそうな顔をしているじゃないか」と答えた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その席に居合わせた学生の一人から、この話を聞かされた時には、自分も大いに笑ったのではあったが、あとでまたよくよく考えてみると、どうもその時にはやはりすっぽんが鳴いたのだろうと思われる。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……過去と未来を通じて、すっぽんがふくろうのように鳴くことはないという事が科学的に立証されたとしても、少なくも、その日のその晩の根津権現境内では、たしかにすっぽんが鳴いたのである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きなすっぽんもいるそうだが、私はまだ見た事がない。",
              "citation": {
                "source": "池",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの火事では鯉やすっぽんもずいぶん驚いた事だろう。",
              "citation": {
                "source": "池",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯉やすっぽんのほかに、ブルフログを養殖しようという話もあったと記憶しているが、結局おやめになったと見える。",
              "citation": {
                "source": "池",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌舞伎座のすっぽんから糶上りそうな美しいんだから、驚きましたの何のって、ワッともきゃっともまさかに声を上げはしませんが、一番｜生命がけで、むっくり起上ると、フイと背後向になって、風を切るようにすっと引返しました。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえやにお茶をいいつけておいて、すっぽんと煙管筒をぬきながら、こういった。",
              "citation": {
                "source": "おじいさんのランプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮒、鯉、どしょう、お好みならばいもり、すっぽんもおりましょうぞ。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "川を見晴らした中二階で、鯉こくと鯰のすっぽん煮か何かを喰わされて、根が悪党でもない長助は、何もかも正直に話してしまった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "幽霊の観世物",
                "note": "青空文庫"
              }
            },
            {
              "text": "清河の宋士宗という人の母が、夏の日に浴室へはいって、家内の者を遠ざけたまま久しく出て来ないので、人びとも怪しんでそっと覗いてみると、浴室に母の影は見えないで、水風呂のなかに一頭の大きいすっぽんが浮かんでいるだけであった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "たちまち大騒ぎとなって、大勢が駈け集まると、見おぼえのある母のかんざしがそのすっぽんの頭の上に乗っているのである。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お母さんがすっぽんに化けた」　みな泣いて騒いだが、どうすることも出来ない。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、そのまわりを取りまいて泣き叫んでいると、すっぽんはしきりに外へ出たがるらしい様子である。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとて滅多に出してもやられないので、代るがわるに警固しているあいだに、あるとき番人の隙をみて、すっぽんは表へ這い出した。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "又もや大騒ぎになって追いかけたが、すっぽんは非常に足が疾いので遂に捉えることが出来ず、近所の川へ逃げ込ませてしまった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから幾日の後、かのすっぽんは再び姿をあらわして、宋の家のまわりを這い歩いていたが、又もや去って水に隠れた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中庭を廊下づたいに奥座敷へ通ることになっているのですが、ここに不思議な話というのは、その中庭には大きい池があって、そこにたくさんのすっぽんが放してある。",
              "citation": {
                "source": "魚妖",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "天気のいい日には、そのすっぽんが岸へあがったり、池のなかの石に登ったりして遊んでいる。",
              "citation": {
                "source": "魚妖",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、客がその奥座敷へ通って、うなぎの蒲焼や泥鱒鍋をあつらえた時には、かのすっぽん共は平気で遊んでいるが、もし泥鼈をあつらえると、かれらは忽ちに水のなかへ飛び込んでしまう。",
              "citation": {
                "source": "魚妖",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはまったく不思議で、すっぽんという声がきこえると、たくさんのすっぽんがあわてて一度に姿をかくしてしまうそうです。",
              "citation": {
                "source": "魚妖",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらに耳があるのか、すっぽんと聞けばわが身の大事と覚るのか、なにしろ不思議なことで、それをかんがえると、泥鼈を食うのも何だか忌になりますね。",
              "citation": {
                "source": "魚妖",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の名は忘れましたが、京に名高いすっぽん屋があって、そこへ或る人が三人づれで料理を食いに行くと、その門口にはいったかと思うと、ひとりの男が急に立ちどまって、おれは食うのを止そうという。",
              "citation": {
                "source": "魚妖",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "御褒美に遣わさるる石臼なれば可けれども＝＝この坊主を輪切りにして、スッポン煮を賞翫あれ、姫、お昼寝の御目覚ましに＝＝と記してあろうも計られぬ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "柴田さんいう人でしょう」「スッポンいう渾名や」　いつの間にか並んで歩きだしていた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "スッポンいう綽名や。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
