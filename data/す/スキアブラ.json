        "examples": {
          "standard": [
            {
              "text": "舞妓さんは、艶やかな髪を保つために伝統的な梳き油を使っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "梳き油のほのかな椿の香りが、部屋の中に優しく漂った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔ながらの梳き油は、髪を保護するだけでなく美しい光沢を与えてくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "梳き油や鬢付けの匂いだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "蝶合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、鬢附と梳油と水油とこの三種の油必要なり。",
              "citation": {
                "source": "当世女装一斑",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
