        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから消化不良のうどんを食つて煤けた電氣の下に寢そべつてゐた。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頸を伸ばして隣りの三畳間を覗くと、三畳間の隅に、こわれかかった七輪が置かれてあって、その上に汚く煤けたアルミニュームの薬鑵がかけられている。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この盛んな勢いで生長している植物の葉の茂りの中に、枯れかかったような薔薇の小枝から煤けた色をした妙なものが一つぶら下がっている。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その新たに延びた部分だけが際立って生々しく見え、上の方の煤けた色とは著しくちがっているのであった。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は大きな火鉢に炭火を温かに焚いていたのが、今は煤けた筒形の妙なストーブのようなものが一つ室の真中に突立っていた。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の入口の壁に立っているスチームヒーターの上に当る白壁が黒く煤けているのが特に目立って不愉快であった。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワシントンからマウント・ウェザーの気象台へ見学に出かけた田舎廻りのがたがた汽車はアメリカとは思われない旧式の煤けた小さな客車であったが、その客車が二つの仕切りに区分されていて、広い方の入口には「ホワイト」、狭い方には「カラード」という表札が打ってある。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤けた天井から、よれよれになつた電線を引いて、傘もない塵芥だらけの電燈の球が黄色い光をとろんとあたりへ投げてゐた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤けたる行燈の横長きが一つ上にかかりて、ほととぎすの画と句など書いたり。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "框がだだ広く、炉が大きく、煤けた天井に八間行燈の掛かったのは、山駕籠と対の註文通り。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと、軒に乾した煙草の葉と、蕃椒の間に、山駕籠の煤けたのが一挺｜掛った藁家を見て、朽縁へ道を向うへ切って、樗の花が咲重りつつ、屋根ぐるみ引傾いた、日陰の小屋へ潜るように入った、が、今度は経肩衣を引脱いで、小脇に絞って取って返した。",
              "citation": {
                "source": "栃の実",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と何もない、煤けた天井を仰ぎ仰ぎ、帳場の上の神棚へ目を外らす。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……赤黒くどんより煤けた腰障子の、それも宵ながら朦朧と閉っていて、よろず荒もの、うどんあり、と記した大な字が、鼾をかいていそうに見えた。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう五にもなって真白でしょう、顔はむらになる……奥山相当で、煤けた行燈の影へ横向きに手を支いて、肩で挨拶をして出るんなら可いけれど、それだって凄いわね。",
              "citation": {
                "source": "第二菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お妻は石炭｜屑で黒くなり、枝炭のごとく、煤けた姑獲鳥のありさまで、おはぐろ溝の暗夜に立ち、刎橋をしょんぼりと、嬰児を抱いて小浜屋へ立帰る。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と親仁が喚くと、婦人は一寸立つて白い爪さきをちよろちよろと真黒に煤けた太い柱を楯に取つて、馬の目の届かぬほどに小隠れた。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おふくろが、昔、雨の日に、ぶん／＼まわして糸を紡いだ糸車は、天井裏の物置きで、まッ黒に煤けていた。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁の影太く壁に映りて動き、煤けし壁に浮かびいずるは錦絵なり。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤けし壁の四隅は光届きかねつ心ありて見れば、人あるに似たり。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "足も立てられないような汚い畳を二三枚歩いて、狭い急な階子段を登り、通された座敷は六畳敷、煤けた天井低く頭を圧し、畳も黒く壁も黒い。",
              "citation": {
                "source": "非凡なる凡人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の寝ている六畳の間すら煤けた天井の影暗く被い、靄霧でもかかったように思われた。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしてそんならいまのやうに、三毛だの赤だの煤けたのだの、斯ういろいろになったんだい。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その煤けた天照大神と書いた掛物の床の間の前には小さなランプがついて二｜枚の木綿の座布団がさびしく敷いてあった。",
              "citation": {
                "source": "泉ある家",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかアルコールがなくなったとき石油をつかったら、罐がすっかり煤けたよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかアルコールがなくなつたとき石油をつかつたら、罐がすつかり煤けたよ。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかアルコールがなくなったとき石油をつかったら、缶がすっかり煤けたよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "をぢさんは行止りに突きあたるまで調べ盡さうといふ息込みで、煤けた紙に殘つてゐる薄墨の筆のあとを根好く辿つて行つた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからバロツク式の木の柱の立つてゐる、レクトリウムを通つて、その奥の方に行くと、段々暗くなつて、そこには煤けた聖者の像の前に点してある、小さい常燈明が、さも意味ありげに瞬をしてゐる。",
              "citation": {
                "source": "駆落",
                "author": "DIE FLUCHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の屋根の上に例の仁丹の広告がすすけよごれて見すぼらしく立っていた。",
              "citation": {
                "source": "神田を散歩して",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "奇妙にすすけた無表情の家々が立ち並び、何事も旅人に呼びかけようとはしないやうである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
