        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "発掘されたポムペイ市街の、蠅も鳴かない夏の午、鋪石や柱に頭を打ちつけ、ベスビオの噴煙を尻目にかけて、死んで沙漠に埋められようとも、随分馬鹿にはならないことなのを、それでもまあ、日本は東京に、慎しく生きてゐるのだ。",
              "citation": {
                "source": "散歩生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウリの蔓になったナスビというわけであった。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウリの蔓になつたナスビといふわけであつた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "現持主のムッシュウ・ルスビナッスが入口寄りの窓下でむっつりして皿鍋を掻き廻して居る。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――前刻、菅さんに逢つた時、私は折しも紅インキで校正をして居たが、組版の一面何行かに、ヴエスビヤス、噴火山の文宇があつた。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "教へをうけようと、電氣を點けて、火鉢の上へ、あり合せた白紙をかざして、その紅いインキで、ヴヱスビヤス、ブエスビイヤス、ヴエスヴイヤス、ヴエスビイヤス、どれが正しいのでせう、と聞き／＼――彩り記した。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただベスビオの山だけは、あいもかわらず永遠の讃歌をとどろかしていました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "背景にはベスビオの山が黒々とそびえていて、そこから噴きでる火は笠松の幹のように立ちのぼっていました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そこへ行ったら、黒い鉄なべをのぞいてこよう」――黒い鉄なべと言ったのは、エトナとかベスビオスとか言われている、火をふきだす山のことだったのです。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっちにしろ、政治への傾斜とか、ギター小僧の天下とか、洗練や完成度が重んじられたり、ただのダンスビートになったり、さんざんだ」　足を手すりの下の桟にのせる高志のしぐさが、慶一の記憶を刺激する。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロスビーと、グレース・スリックと、あとひとりはだれだっけ、ポール・カントナーだったかな」　tri- は三を示す接頭辞で、triad というのは、たとえば「三和音」のように、なんであれ、三つでひと組のものをいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "べつに、クロスビーたちみたいに、セックスはからまっていなかったけど、おなじことだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "プレスビテリアンの中心たる此の都が、彼には悉く偽善の府と見えたのである。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも当市では、プレスビテリアン教会総会と芸術｜倶楽部と、都合二回講演をした。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤキムスビ、――犬に十分与へておいて残飯をそれに。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチノ　上ニ　ヒカツテ　ヰタ　モノハ、ナクナツタ　ホシデハ　ナクツテ、ガラスビンノ　カケラダツタノデス。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌスビトト　コヒツヂ新美南吉　ヤワラカイ　クサガ　ミドリノ　モウフノヤウニ　ハヱテ　ヰル　ヒロツパニ　タクサンノ　ヒツジガ　メイメイト　ナキナガラ　アソンデ　ヰマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソコヘ　ヒトリノ　ヌスビトガ　トホリカカリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オナカガ　スイテ　ヰル　ヌスビトノ　メニ、フト　マルマルシタ　コヒツジガ　一ピキ、ミンナト　ハナレテ　アソンデ　ヰルノガ　ウツリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アノ　コヒツジハ　ウマサウダ」ト　イツテ、ヌスビトハ　ソノ　コヒツジヲ　コツソリ　ヌスンデ　フトコロニ　イレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、コヒツジハ　コロサレルトハ　チツトモ　シラズニ　ヌスビトノ　カホヲ　ミアゲテ　ヰルノデ、ヌスビトハ　キウニ　カワイサウニ　ナリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヌスビトハ　パント　コヒツジト　トリカヘツコ　シマシタガ、ヒヤクシヨウノ　テニ　ブラサゲラレタ　コヒツジガ　カワイソウニ　ナツタノデ、トリカヘツコヲ　ヤメテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コマツタ　ヤツダナ、オレニハ　オチチガ　デナイカラ　ヤツパリ　モトノ　マキバヘ　ツレテツテ　ヤラウ」ト　イツテ、ヌスビトハ　ペコペコノ　オナカヲ　オサヘナガラ　マタ　モト　キタ　ミチヲ　カヘツテ　ユキマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで、僕等が何より注目しなければならないのは、博士がただの一日も黒死館に住まなかったと云うばかりか、明治二十三年には、わずか五年しか経たない館の内部に大改修を施したと云う事で、つまり、ディグスビイの設計を根本から修正してしまったのだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何だあれは、家族の一人が殺されたと云うのに」「今日は、この館の設計者クロード・ディグスビイの忌斎日でして……」と真斎は苦し気な呼吸の下に答えた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「館の暦表の中に、帰国の船中｜蘭貢で身を投げた、ディグスビイの追憶が含まれているのです」「なるほど、声のない鎮魂楽ですね」と法水は恍惚となって云った。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと、最初の英人建築技師ディグスビイの設計を改修した所に、算哲のウイチグス呪法精神が罩もっているに違いないのだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
