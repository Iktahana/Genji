        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新大久保の韓国料理店で、初めて本格的なスンデを食べてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スンデは見た目こそ独特だが、食べてみるとコクがあって非常に美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ソウルの屋台で、熱々のスンデを塩につけて食べるのが地元流の楽しみ方だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「アノ　コヒツジハ　ウマサウダ」ト　イツテ、ヌスビトハ　ソノ　コヒツジヲ　コツソリ　ヌスンデ　フトコロニ　イレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガチヨウノ　タンジヨウビ新美南吉　アル　オヒヤクシヨウヤノ　ウラニハニ　アヒルヤ、ガチヨウヤ、モルモツトヤ、ウサギヤ、イタチナドガ　スンデ　ヲリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ上ルノニ、トチュウデ何ンベンモヤスンデ、イキヲ入レナケレバナラナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤウヂキ　ヂイサンキタナラバハタオリ　ヤスンデチヤン　カラ　チヤンミンナデ　ゴチソウイタシマセウチヤン　カラ　チヤン　カラチヤン　カラ　チヤン。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "スンデの事にタッタ今だって、Ｓ・Ｏ・Ｓだったじぇねえか」「ああ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル日、アヒルサンガカゼヲヒイテ学校ヲヤスンデヰルト、オネコサンガキテイヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "交番ニユキマスト、カワイラシイ女ノ子ノオマワリサンガヰテ、帳面ヲシラベテクレマシタガ、サツパリ玉ネギサンノスンデヰル村トイフノガ分リマセンデシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ト申シマスノハネ、アノ顔ヲ見テルト、昔アタシガ贔屓ニシテイタレオ・エスピノザヲ思イ出スンデスノ」「又変ナ名前ガ出テ来タジャナイカ」「エスピノザッテノハフライ級世界選手権ノタイトル・マッチニモ出タコトノアル、フィリッピンノボクサーナノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙デハナク、新サンカ、ワタシカガ、出カケナクテハナラナイノデスケド、マダ宴会ハスンデ居ランシ、後始末モアルノデ、手紙デ、許シテ下サイ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
