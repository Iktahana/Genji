    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "第一｜彼奴は水道鼠のごとスバシコイ上に、坑長の台所に取り入っとるもんじゃけんトウトウ一度も問題にならずに済んで来とるが、用心せんとイカンてや。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "左翼の左翼の共産党の中でも一等スバシコイあばれ者だと自分で白状していたが、それはハラムの童貞とおんなじにホントウらしかった。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方に青山あたりのバラック民は敷地が陸軍省のものなので、市役所から立ち退きの日を限られると、すぐに陸軍省へ行って、別に延期の約束をして得意になっているといったようなスバシコイのも居る。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの野郎め、スバシコイヨ、白昼これだけの品物を堂々と運びだしやがつたからな。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "半平と才蔵も女の子の次ぐらいはスバシコイ人物だから、白衣の人物などにオサオサつかまる筈はない。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
