          "literary": [
            {
              "text": "これまでが闘牛の第一段で、スエルテ・デ・ピカルといい、その次がスエルテ・デ・バンデリヨである。",
              "citation": {
                "source": "闘牛",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから第三段の、最後のスエルテ・デ・マタルの場面となる。",
              "citation": {
                "source": "闘牛",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後にスエルテ・デ・マタルの場面となり、小ベルモンテが立ち向うと、牛は血だらけになっていても少しも弱りを見せず、砂場を一ぱいに駆けまわって、却って闘牛士たちを翻弄するような状態であった。",
              "citation": {
                "source": "闘牛",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
