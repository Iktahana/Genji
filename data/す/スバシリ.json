        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "浅瀬を群れで泳ぐ洲走を、地元の漁師たちが投網で見事に捕らえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "釣り上げたばかりの洲走は、まだ幼魚ながらも銀色の鱗がキラキラと輝いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今日の川遊びでは洲走がたくさん見られたね」と父が楽しそうに話してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "戯にともづなの舫を解いて、木馬のかわりにぐらぐらと動かしても、縦横に揺れこそすれ、洲走りに砂を辷って、水に攫われるような憂はない。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さいのが洲走りといつて、此奴は釣れないが、オボコとなるともう四五寸あるから、夕方の上げ潮なら何処の川口でも釣れる。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　※の洲走り　さけのすばしりは雪前に河原などにある事也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
