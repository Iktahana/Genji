        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その時鋭い匕首を以て、果実へ三筋切傷を付ける。",
              "citation": {
                "source": "天主閣の音",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、また、釣り手が一筋切られた。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯那山　東ハ万力筋切差、西保等ト山脊ヲ界シ、北ハ西奥仙丈ノ高屏風、玉小屋ニ至リ、西ハ荒川ノ中央ヲ限ルト云フ。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尊き内的生命を放棄してただ懸命にすがる命の綱が一筋切れ二筋絶ち、まさに絶望に瀕している。",
              "citation": {
                "source": "霊的本能主義",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その針線も烟突が新しく出来始めの頃に張ったもので、糸のように痩せてこれすら中には一筋二筋切れ離れていた。",
              "citation": {
                "source": "暗い空",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
