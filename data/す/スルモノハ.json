          "literary": [
            {
              "text": "次ニ列スルモノハ古貨幣ナリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ皆、祈ルコトヲ知リタレドモ、祈ルコトヲ職業トスルモノハ一人モコレ有ラザリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ欲スルモノハ進ンデ植物タルコトヲ希望セヨ！",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "――勝チヲ天下ニ制スルモノハ法ヲ用ウルコト明ラカナルニ依ル――と。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
