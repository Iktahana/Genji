          "literary": [
            {
              "text": "私の私のスウィートピイちゃん。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スウィートピイは、蘇鉄の真似をしたがる。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月の中旬のことで、庭の隅には丈の高い紅と白とのスウィートピイが美しく簇り咲いていた。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スウィートピイなんて子供めいているようですが、でもあの花々の柔かい色合いはやはりやさしいものを語って居りますから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "お恭ちゃんがスウィートピイをさしておいてくれました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "しーんと日がよく当って暖いところに花の匂りがかすかに漂っていて、スウィートピイやバラのところに早いこと、もう蜂がかぎつけて来て働いています、それを眺めています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
