        "examples": {
          "standard": [
            {
              "text": "「このすっとこどっこい！何度同じ失敗をすれば気が済むんだ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あんな男に騙されるなんて、あたしもすっとこどっこいだったわ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "落語の中では、すっとこどっこいなキャラクターが騒動を巻き起こす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "（しどろもどろに「心」は答えた）　……いいんだろう、いまのほうがいいんだろう、ざまアみやがれ、すっとこどっこい、そうなくっちゃならねえところだ。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この古浴衣はおれの心ざしだ」と松田が怒ったように云った、「こんな物くその役にも立たねえと思うだろうが、もしそんなふうに思うなら、すっとこどっこいのぼけなす野郎のおけら頭だ」　相変らずだな、と思いながら栄二は微笑したが、おすえは怯えたような眼をしていた。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
