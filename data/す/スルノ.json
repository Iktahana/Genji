        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "千代紙｜貼リマゼ、キレイナ小箱、コレ、何スルノ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花火一パツ、千円以上、ワザワザ川デ打チアゲテ何スルノ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間ト絶縁スルノガ俺ノ生キル道ダ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『エノシマヲフタリッキリサンポスルノイヤ？",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺命ニ、吾レ死スルノ後、速ヤカニ火化ヲ行ヒ骨灰ヲ太平洋ニ散ゼヨ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之、甚シキニ至リテハ、其事ノ故誤ヲ問ハズ、其ノ理ノ当否ヲ顧ミズ、復讐ノ名義ヲ挟ミ、濫リニ相構害スルノ弊往往有之、甚ダ以テ相不済事ニ候。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ此ノ合理的勤勞ニ對シテ其ノ納付金ヲ國家ニ對スル獻金トシテ受ケ明カニ其ノ功勞ヲ表彰スルノ道ヲ取ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐵道ノ國有ナルガ故ニ現時ノ如ク民間ノ鐵道布設ガ阻害セラルルハ、第一國民ノ經濟的自由ヲ蹂躙スルノミナラズ、國有鐵道其者ノ利益ヲ減殺スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞働者ガ經營計劃ニ參與スルノ權ハ此ノ一方ノ提供者トシテナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ又生産方針ニ干與スルノ權ハ國家全局ノ生産成績ヲ達觀シ得ベキ衆議院ニ於テセザルベカラザル所以トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ノ使命的勞働ヲ廢セシメテ全ク天性ニ合セザル勞働ヲ課スルハ、啻ニ婦人其者ヲ殘賊スルノミナラズ、直ニ其ノ夫ヲ殘賊シ其子女ヲ殘賊スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本婦人ノ人格ハ歐米ノ如ク男子ノ職業ヲ爭ヒテ認メラルベキ將來ヲ假想スルノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只英語ホド普及セズシテ而モ英語思想以上ニ影響ヲ與ヘタル獨乙語ニ依リテ其ノ害毒ノ緩和セラレタル天裕ヲ有スルノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人ノ一般生活ニ沒交渉ナル直譯的遊戲ヲ課スルノ滑稽サハ床柱ヲ背ニシテ小猿ノ如ク跪坐スル洋服姿ト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ノ亡國史ヲ知リ露國ノ脅威ニ戰慄シタル危機ヲ顧ルナラバ、愛蘭土獨立問題ヲ朝鮮ニ直譯シテ論及スルノ理ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍隊ノ強盛ヲ念トスル軍事當局スラ此ノ強兵ヲナス根源ヲ提唱スル者無ク、凡テノ國民ハ國民ノ義務ナル道念ニ忍ビテ一ニ只忘却ニ封ジツツアルトキ、兵卒其者ガ憤恨ニ爆發スルノ日ハ則チ勞働者ト結合シタル勞兵會ノ出現ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ自己防衞ノ外ニ不義ノ強力ニ抑壓サルル他ノ國家又ハ民族ノ爲メニ戰爭ヲ開始スルノ權利ヲ有ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ又國家自身ノ發達ノ結果他ニ不法ノ大領士ヲ獨占シテ人類共存ノ天道ヲ無視スル者ニ對シテ戰爭ヲ開始スルノ權利ヲ有ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "敢テ軍閥内閣ト黨閥内閣トニ差等ヲ附スルノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去ニ歐米ノ思想ガ日本ノ表面ヲ洗ヒシトモ今後日本文明ノ大波濤ガ歐米ヲ振撼スルノ日ナキヲ斷ズルハ何タル非科學的態度ゾ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、君チャンハヨナカニ目ヲサマスト、ブルブルフルエナガラ、何ンダカオッカナクテ、オ母ッチャトコエモ出セズニ、ソート手ダケヲノバシテヤッテ、ユスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヤミノナカデ、オ母ッチャノコエガスルト、ヤットアンシンスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ヲ害シテ私ヲ利スルノ義ニモ非ラズ、唯心身ノ働ヲ逞シテ、人々互ニ相妨ゲズ、以テ一身ノ幸福ヲ致スヲ云フナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「顛狂スルノ柳絮ハ風ニ随ツテ舞ヒ、軽薄ノ桃花ハ水ヲ逐フテ流ル――」　杜工部の詩を吟った時には湖水に掛けた浮き橋を島の方へいつか渡っていた。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアこれは一寸耳をこちらへ出して、ソコイラノ評論ヲ評論ト云イ得ルトハ思ッテ居リマセンガ、私ニハホントノ評論ヤソノ骨格ガワカッテイルカラケンソンスルノデス。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダサウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾ガ汝ヲ眷愛スルノ念、豈ニ我ガ子弟ニ異ナランヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾レ且ツ汝ニ謝スルノ暇有ラザラントスルナリ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
