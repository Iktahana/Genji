          "standard": [
            {
              "text": "古代の石造建築には、現代の技術でも説明がつかないほど寸分の狂いもない加工が施されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "舞台の上で、ダンサーたちは寸分の狂いもない一糸乱れぬパフォーマンスを披露した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "数学の証明において、論理の組み立てには寸分の狂いもない厳密さが求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "大きく衣紋をぬいた着附だが、襟元はきっちり合さって、帯は常に寸分の狂いもない位置に定着している。",
              "citation": {
                "source": "白木蓮",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
