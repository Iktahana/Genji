        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "女が好きで註文したものか彼等の食卓の前で給仕頭がこの店の名物、レ・クレープ・スゼットを手際よく作って居る。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、デザートには、パンケーキ・スゼット。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでは、12のクレープ・スゼット、13のバヴァロアの二種。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、クリームスープ、ビフテキシャリアピン、それにパンケーキスゼット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから神戸のベルネクラブ、オルドヴルから、えびのニューバーグ、鶏、しまひに火のついたパンケーキ・スゼット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "元町のベルネクラブ、オルドヴル、フロッグレッグー脂こくなくてうまかった、次の犢の煮込、シャムピニオンのうまかったこと、パンケーキ・スゼット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢蝦のチーズ焼、鳥のクリーム煮、次にパンケーキ・スゼットでおしまひ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
