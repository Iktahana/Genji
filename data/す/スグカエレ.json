        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "例のスグカエレであるから、早速舎監に話をして即日帰省した。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チチビヨウキスグカエレ」　いきなりこう書いて出した。",
              "citation": {
                "source": "電報",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際をいうと、園は帰京せずに、札幌で静かに父の死を弔らいもし、一家の善後ということも考えてみたかったのだが「スグカエレ」という電文に背くべき何らの理由もなかった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は「チチキトクスグカエレ」という電報を見て急いで帰って来たのであった。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（七月×日）――ビョウキスグカエレタノム　母よりの電報。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注26］九月十五日――十月九日の昼頃、顕治は『デタラスグカエレ、シユクシヤノヨウイアリ』という電報を東京からうけとった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハハワルシ、スグカエレ」――彼は始こう書いたが、すぐにまた紙を裂いて、「ハハビョウキ、スグカエレ」と書き直した。",
              "citation": {
                "source": "お律と子等と",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "デタラスグカエレイエノヨウイモアル。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――サカモトシススグカエレ、というのだ。",
              "citation": {
                "source": "道連",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その三　練兵場の犬　スグカエレ――これが大きく俺の眼に迫った。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうとしか思えぬが、そうすると、慷堂のよこしたこのスグカエレには北槻中尉の意見もふくまれているわけか。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "スグカエレ――そう言われても、俺としてはこのままのめのめと帰れはしない。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "スグカエレと言っても、猫は家へ戻って、家で死のうとはしない。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
