        "examples": {
          "standard": [
            {
              "text": "複雑な数学の難問を、彼は迷うことなくスイスイと解いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「このアプリを使えば、確定申告の手続きがスイスイ終わるよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "平日の昼間ということもあり、道路が空いていて車がスイスイ進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
