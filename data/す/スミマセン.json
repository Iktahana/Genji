        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「済みません、この近くに郵便局はありますか？」と通りすがりの人に尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あ、済みません！足を踏んでしまいました」と満員電車の中で慌てて謝った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「会議中にお電話してしまい、済みませんでした」と取引先に丁寧にお詫びをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」「今日牛乳がぼくのところへ来なかったのですが」「あ済みませんでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんたうに、済みませんでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「えゝ、どうも済みませんでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は学校へ行ったて千葉だもの、盆正月の外にも来ようと思えば土曜の晩かけて日曜に来られるさ……」「ほんとに済みません。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎度、御面倒ばかりお掛けして相済みません。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうぞ」　「や、こりゃどうも」　「あら随分破けてんですねえ」　「え」　「縫いましょうか」　「いや、どうも済みません」　お静、糸と針を取りに立つ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すこし馴染になった顔にたまたま小初は相手をしてやると、「へえ、へえ、済みません」　お客にするように封建的な揉み手をして礼をいう。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おらあ黙って聞き手になるから」「どうも相済みません」「済むも済まねえもあるもんか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうもお構い申しませんで、済みません」「なに、少しお前に訊きたいことがある。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "お見それ申して相済みません。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはどうもおみやげを戴いて済みません。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとうに、済みませんでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、どうも済みませんでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あ、どうも済みません。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（何、いけませんければ跣足になります分のこと、どうぞお構いなく、嬢様にご心配をかけては済みません。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスケツトを圧へて、吻と息して、「何うも済みません、少し、うと／＼しましたつけ。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつかり夢でも視たやうで、――郡山までは一｜度行つた事があるものですから……」　園も窓を覗きながら、「しかし、何うも済みません、第一｜見た事もありませんのに、奥州二｜本松と云ふのは、昔話や何かで耳について居たものですから、夢現に最う其処を通つたやうに思つたんです。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今また雑と一｜日、五｜日ばかり、私ども一｜行に対し……申尽くせませんまで、種々お心づかひを下さいましたのも、たゞ御礼を申上げるだけでは済みません。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御やすみになっているところを御起しして済みませんが、夜前からの雨があの通り甚くなりまして、渓が俄に膨れてまいりました。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんのご用ですか」「今日｜牛乳がぼくのところへ来なかったのですが」「あ、済みませんでした」その人はすぐ奥へ行って一本の牛乳瓶をもって来てジョバンニに渡しながら、また言いました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとうに済みませんでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではいただいて行きます」「ええ、どうも済みませんでした」「いいえ」　ジョバンニはまだ熱い乳の瓶を両方のてのひらで包むようにもって牧場の柵を出ました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」給仕、（周章てゝ来る）「はいはい、相済みません。",
              "citation": {
                "source": "ポランの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、せっかく、遠い故郷から、私たち二人を、わざわざ助けに来て下すった皆様の御親切に対しても、こんなことをする私たち二人はホントにホントに済みません。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ほんとにお手数をかけまして済みませんでした。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お手紙はお返しいたします」「……ハ……たしかに……」「……で……あの新聞の原稿は、お持ちになりまして……」「相済みません。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "済みませんが莚を二つばかり貸いて下さらんか……」「ヘイヘイ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうも……済みません」",
              "citation": {
                "source": "お茶の湯満腹談",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとに、済みませんで御座います」　女中は礼を繰返しながら蝙蝠をお涌の手から抓み代えて受取ろうとする。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、商売ものを貰っちゃすみませんな。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
