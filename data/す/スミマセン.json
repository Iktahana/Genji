        "examples": {
          "standard": [
            {
              "text": "「わざわざ駅まで迎えに来ていただいて、本当に済みません」と友人の厚意に感謝した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「お口に合うか分かりませんが」と手土産を渡され、「ああ、済みません、いただきます」と答えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "落とした財布を拾ってくれた学生に、「ああ、済みません、助かりました」とお礼を言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
