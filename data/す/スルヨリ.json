        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "實ニ國家ノ生産的利益ノ方面ヨリ見ルモ、幼童ニシテ殘賊スルヨリモ其ノ天賦ヲ完全ニ啓發スベキ教育ヲ施シタル後ノ勞働ガ幾百倍ノ利益ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸ク中世史ノ革命ヲ學ビツツアル未開後進ナル彼ニ對スルニハ現代的再建ヲ想像スルヨリモ、反動ノ襲來又ハ眞乎ノ建國者ニヨリテ「ピーター」大帝ノ再現ヲモ打算外ニ置ク能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代ニ至テ世界列強ガ戰爭ヲ開始セントスルトキ悉ク自他ヲ欺ク舊道徳的名分ヲ掲ゲ、又ハ之ヲ自己防衞ノ口實ニ求ムルハ國家生活ノ權利ヲ半解スルヨリ來ル卑怯ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英人ヲ直譯スル輩ハ「レニン」ヲ宣傳スルヨリモ百倍ノ有害ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "山東苦力トシテ輸出セザルベカラザルホドニ人口漲溢セル支那ノ貧弱ナル一角ニ沒頭スルヨリモ、支那其ノ者ヨリ廣大ニシテ豐饒ナル英國ノ濠洲ヲ併合セヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女王ゑりざべすノ治世ニ於テ、英国教会ノ制度礼儀ニ一大改革ヲ施スベキヲ主張スル一宗派起リ、教会ヲ清ムルヲ旨義トスルヨリ、コノ宗徒ハ自ラ称シテ『清教徒』トイヘリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "前述拙著『牧野日本植物図鑑』せんじがんぴの文末「せんじゅハ其意味不明ナリ」を取り消し、今これを「野州日光山ノ中禅寺湖畔ナル千手崎ニ産スルヨリ云ヘリ」と訂正する。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
