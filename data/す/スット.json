          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冷たい水を一杯飲んだら、胸のつかえがすっと取れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "言いたいことを全部伝えたら、心がすっと軽くなった気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "湿布を貼ると、患部の痛みがすっと引いていった。",
              "citation": {
                "source": "Illusions AI",
