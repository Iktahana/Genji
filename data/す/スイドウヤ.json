        "examples": {
          "standard": [
            {
              "text": "トイレが詰まって自分ではどうにもならず、慌てて近所の水道屋さんに電話した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "水道屋の主人は、熟練の技であっという間に水漏れ箇所を修理してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "24時間対応の水道屋さんが来てくれたおかげで、真夜中の水トラブルが解決した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ある井戸の所有者が修繕費を節約するために水道屋にポンプの鉛を普通の２倍の厚さにするように注文した例をラム博士が述べている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして職業上で数多くの同様な例を経験したと述べられない水道屋は１人も居ないであろう。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして屋敷の所有者と水槽に欠陥があると告発された水道屋のあいだの争いを調停する法律論争の例を私は引用することができる。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "故郷では、たとえば水道屋はいまだに水道屋のままだから」　フィーリングの解放は成功物語でもあり、ジャニス・ジョプリンは、一回のステージで三〇〇〇ドルはとれる。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
