        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "墨摺りの浮世絵は、シンプルだからこそ彫師の技量が試される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "色彩豊かな多色摺りもいいが、私は渋い墨摺りの版画の方が好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "博物館のワークショップで、初めて墨摺りの体験をしてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "十二月｜一月は、月の初めから、ほかの學課はなく、その習字の稽古と、お墨摺りで日をおくつて樂しんでをりました。",
              "citation": {
                "source": "吾が愛誦句",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "墨摺りたるついで桜木の老婦に請はれし短冊に、悪筆を揮ふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
