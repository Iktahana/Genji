          "literary": [
            {
              "text": "車が馳け出すと冷たい風が膝掛と杉箱の間から吹き込んだ。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかあさんは、娘たちが年ごろになったら与えようと考えて、むかしのはなやかだった時代の記念品のしまってある杉箱を開けて、絹の靴下と、きれいな彫刻のある扇子と、かわいい青いかざり帯を下さいました。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちよつと見ると、すばらしい絲目杉の厚い一枚板に見えるが、じつは杉箱なのである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
