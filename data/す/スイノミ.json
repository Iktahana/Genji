        "examples": {
          "standard": [
            {
              "text": "病み上がりの子供に、おかゆを吸い飲みで与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "看護師が患者に吸い飲みで水を飲ませた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤ちゃんの吸い飲みは清潔に保つ必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "前句の世界と前々句の世界とは部分的にオーヴァーラップしており、前句と後句ともまた部分的に重合しているのであるから単にプロバビリティーから言ってもそうなりやすいのみならず、まだその上にいっそうそうなりたがる心理がある。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕元には薬瓶、薬袋、吸呑み、その他。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど枕｜擡ぐることも懶くて、湯なども吸呑てふ物より臥しながら飲みて、厠に往かむにも、人の肩に掛かりて、一人には背を押さへられつつ、虫などのはふさまして行きぬ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ゲヘゲヘ……ゲヘンゲヘン……そ……そんな馬鹿な話が……あるものか……アレが夢なら何もかも……夢だ……」「静かに……静かに……」「……ぼ……僕と一緒に助かった者はおりませんか……一緒に幽霊を見た……現実の証人が……」　私は黄色い吸呑を抱えながらキョロキョロとそこいらを見まわした。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉は薬をオブラートに包み、吸呑の水で服用さした。",
              "citation": {
                "source": "猫捨坂",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて『レモナーデがほしい』との事で早速作つていつもの樣に私が一口のませますと『みんなの手からのませて頂戴ね』といふので、其通りに一口づゝ吸呑からのませました處『アヽおいしい／＼』と一口毎に申しました。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            }
          ]
        }
