        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "とまれ詩の方が、小説よりも人をスツキリとした気持にするには適してゐるのである。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "縮緬の桔梗の模様の浴衣が、そのスツキリとした身体の輪廓を、艶美に描き出してゐた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、怎やら頭の中の熱が一時｜颯と引いた様で、急に気がスツキリとする。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処をどうさがしても江戸ツ子らしいスツキリしたところがない。",
              "citation": {
                "source": "妾の会つた男の人人",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "長方形な滑かな頭と胴体をぐつと掴んで、しみじみと見ると、キララともせず、柔かく、素直で、スツキリとして、方に清長の美人の体駆である。",
              "citation": {
                "source": "魚美人",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
