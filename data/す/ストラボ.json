          "standard": [],
          "literary": [
            {
              "text": "日本でも熊野人は以前黐で猴を捕えたと伝え、その次第ストラボンの説に同じ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこれを上演するバイロイトの祝典劇場というのが大変で、ワグナーが自分のもっている楽劇の理想を実現するために、特別の設計をして建てたもので、百何十名の大オーケストラが入るオーケストラボックスを舞台の椽の下に半円形で作った特殊な構造の劇場なのです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーケストラボックスは取払われ、舞台から客席まで、平面の大広間になっている。",
              "citation": {
                "source": "アーニイ・パイルの前に立ちて",
                "author": "小林一三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この学者たちとしてアルキメデス、エウクレイデス（ユークリッド）、ストラボン、プトレマイオス（天文学者）が含まれる。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
