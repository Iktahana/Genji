        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "民族国家の問題、経済革命の問題もその根本を一度神学的に批判されるのでなければ、全人類を福祉あらしめる恒久の平和の原理を見いだすことは不可能であろう。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度來るのは、私は經濟革命であろうと思う。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            },
            {
              "text": "パンパンにされた日本　私は今度は經濟革命が來ると思つている。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
