          "literary": [
            {
              "text": "「工場中にある anti コルホーズの分子が、ウダールニクをころす、村ではスレドニャク〔中農〕のコムソモールがベドニャーク〔貧農〕でエンスディアスティックな若者を殺す。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、我諸州ニ内乱ヲ起サシメテ、我州内ノ人民ヲ印度ノ野人ト同様ニ御セント欲スレドモ、印度人殺伐不仁ノ戦ト之ヲ同日ニ論ズ可ケンヤ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ラバ果シテ前段ニ云ヘル、早歳能語ヲ記スレドモ、結合ノ力乏シキ者ニ非ルヲ得ムヤ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "獲ント欲スレドモ由ナシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲ハ種々ノ織リ物編ミ物ヲ有スレドモ乙ハ之ヲ有セズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
