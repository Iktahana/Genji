  {
    "uuid": "ed83b822-0269-59f8-9a36-7043b6ddd8ba",
    "entry": "スベキ",
    "reading": {
      "primary": "すべき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
