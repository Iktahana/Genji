        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔の人は、火打ち石や磨り出しの道具を使って火を熾していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この古いマッチ箱には、立派な磨り出しが付いているね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "磨り出しの部分が湿気てしまい、なかなか火がつかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
