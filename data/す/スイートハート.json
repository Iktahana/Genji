          "literary": [
            {
              "text": "それはさうと、あんた、もう、スイートハート出来たつて、あんまり運がよすぎはせん。",
              "citation": {
                "source": "すべてを得るは難し",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたのスイートハート、大学出つていふけど、調べてみたの。",
              "citation": {
                "source": "すべてを得るは難し",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたのスイートハート、どんな人相か、みてあげるから、写真送りなさい。",
              "citation": {
                "source": "すべてを得るは難し",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大学出のスイートハートに違ひないわ。",
              "citation": {
                "source": "すべてを得るは難し",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしのスイートハートどんな男かみてやらうと思つて、そんなこといつてるわ。",
              "citation": {
                "source": "すべてを得るは難し",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンドは、ラストの「グッドナイト・スイートハート」を奏でていた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの娘は、お前のスイートハートなのか」「ノオ」はげしく彼はいった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この少年は、お前のスイートハートだろう？",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
