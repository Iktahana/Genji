        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ヒトノ後ヲ尾行シタリ隣室ヘハイツテ散々俺ノ悪口ヲ言ツタリ、俺ノ生活ヲ覗イタリスルコトハ、今後絶対ニヤメテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ小地主ト小作人ノ存在スルコトハ神意トモ云フベク、且ツ社會ノ存立及發達ノ爲メニ必然的ニ經由シツツアル過程ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レニ反シテ、此ノ私有地限度超過ヲ徴集スルコトハ近代的所有權思想ノ變更ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ大地主ノ土地ヲ徴集スルコトハ最高ノ所有者タル國家ノ權利ニシテ國有ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民膏血ノ貯金又ハ事業ノ運命ヲ決スベキ預金等ガ銀行ノ破産ニヨリテ消散スルコトハ國民生活ノ一大不安ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民教育ニ於テ英語ヲ全廢スベキハ勿論、特殊ノ必要ナル專攻者ヲ除キテ全國ヨリ英語ヲ驅逐スルコトハ、國家改造ガ國民精神ノ復活的躍動タル根本義ニ於テ特ニ急務ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語ノ統一ナクシテ大領土ヲ有スルコトハ只瓦解ニ至ルマデノ槿花一朝ノ榮ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ中學程度ノ男生徒ニ制服トシテ靴洋服ヲ強制スルコトハ實ニ門戸閉鎖ノ有力ナル一理由ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ノ姦通罪ヲ罰スルコトハ第一ニ一夫一婦タル國民道徳ノ大本ヲ明カニスルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ純潔ヲ維持スル如ク男子ガ其ノ童貞ヲ完ウシテ結婚スルコトハ双方ノ道義的責務ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "醫學ニ萬能ノ藥品ナキニ係ラズ政治學ニ參政權ヲ神權視スルコトハ歐米ノ迷信ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ナル地圖上ノ彩色ヲ擴張スルコトハ兒戲ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ自由主義ガ各其ノ民族思想ノ結ベル果實ナル如ク、濁人タル「マルクス」ノ社會主義露人タル「クロポトキン」ノ共産主義ガ幾多ノ相異扞格セル理論ヲ以テ存立スルコトハ各其ノ民族思想ノ開ケル花ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ果シテソレガ雑音ナドトイワレルニ十分ナ屑電波ダトスルコトハ早計ニ過ギルト思ワレル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那ヨリ旧ク舶来セシ器物ヲ愛玩スルヲ以テ、好古々々ト唱フルハ昔ヨリ有リシコトナレド、我邦ノ古物ヲ貴重スルコトハ、近比泰西ノ事ヲ観聴キシテヨリ、始メテ盛リニ流行シ出シタル様ニ思ハル。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "老イタル父母アラバ、責任ハ更ニ重ク、病弱ナ妻、発育不良ノ子女ヲ有スルコトハ、男子一生ノ損失デアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫婦揃ッテ外出スルコトハ近頃珍シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「君ト一緒ダトイツモ興奮サセラレル」「アンナ顔ヲ見テ興奮スルコトハナイデショウ」「アノ顔ヲ見タ上デ君ノ顔ヲ見ルト、溜ラナク興奮スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モデルニスル颯子ニモ、浄吉ニモ、婆サンニモ、誰ヲモデルニシテイルカヲ悟ラセヌヨウニスルコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハオマエニ関スルコトハ何デモ知ッテイル。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたがそういう選択肢を選んだときは、“ソレヲスルコトハデキマセン”という金属音が聞こえます」「なるほど」「ゲームはＡコースとＢコースの二種類があります。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“ソレヲスルコトハデキマセン”　あなたはあきらめてもう一度正面を向き、仕方なくそちらの方向に歩き出す。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“ソレヲスルコトハデキマセン”「この魔法の杖の威力を知るがいい」　老婆は手にしていた杖であなたの肩を激しく叩く。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“ソレヲスルコトハデキマセン”　銀色の流線型をした宇宙船はますますこちらに近づいてくる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“ソレヲスルコトハデキマセン”　あなたは自分がまだ擬似体験ゲームの世界にいるのだろうかと一瞬自問する。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "“ソレヲスルコトハデキマセン”　やれやれ、どうやら俺は精神科医に見てもらわなくてはならないらしいなあ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
