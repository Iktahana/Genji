        "examples": {
          "standard": [
            {
              "text": "素敵なステーショナリーを揃えると、それだけで仕事へのモチベーションが上がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "銀座にある大型の文房具店には、海外製の珍しいステーショナリーが豊富に並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「このステーショナリー、デザインが個性的で可愛いね」と雑貨好きの友人が喜んでくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "Ａ夜出て行き、まつのために蚊帳、ステーショナリー等買って来る。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
