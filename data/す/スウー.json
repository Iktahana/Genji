        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スウーと歯ぜせりをしながら、「天気は極上、大猟でげすぜ、旦那。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人、胸がスウーッと致した。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女の枕元に当る大きな硝子窓の向うを、何かしら青白いものが、一直線にスウーと横切って行った。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、その吾輩の生涯を賭した事業の功績が、スウーッと奪い去られて行くのを、手も足も出ないまま見たり聞いたりしていなければならない状態に陥って行くとしたら、吾輩にとってコレ以上の拷問があり得るかドウか考えてみるがいい。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピカピカ光る太陽の下を傲華な流線スターがスウーと横切る。",
              "citation": {
                "source": "書けない探偵小説",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "両親の墓に線香を上げるとスウーッとしてしまいます。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの異人の坊主の云う事を聞きよる内に俺あ死にたいような気持になったもんじゃが、今の貴様の御祈祷を聞いたりゃ、スウーとしてヤタラに目出度うなった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下に真黒く横たわる谷郷村の盆地を冷やかに流れ渡る夜風に背中を向けた草川巡査は、来るともなく深良屋敷に通ずる国道添いの丁字路の処まで来ると突然、頭の上の天の河の近くで思い出したように星が一つスウーと飛んだ。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "身体中の血がスウーと暖かくなって、今にもかけ出せそうな元気で一パイになってしまったわ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして横にスウーと硝子の面を流れた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその夕立の来はなに、大粒の奴がパラ／＼パラ／＼と地面を打つ時、涼気がスウーッと催して来ると同時に、プーンと土の臭いが我々の鼻を撲つのであった。",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "小暗い隅へ走りこむと、やっと萩乃をはなして、左手に持ちかえた濡れ燕を、自分の着物の裾でスウーッとふきつつ、「萩乃さんとやら、おどろくことはねえ。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "音もなく引きわけになって、そこをスウーッとお通りになります。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その刀身に、スウーッ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラガラと左右に揺れると、スウーッと薄明いプラットホームに這入った。",
              "citation": {
                "source": "急行十三時間",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日始めて、ミスウーレーと話を今学期になってしたら、何だか、少し分りにくくなってしまって居た。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い家だから何なに密と歩いても足音が聞えます、早四郎は床の内で来たなと思っていますと、密と障子を開け、スウー。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、帆まへ船は、スウーと音もなく動き出して、また行く手をさへぎつてしまひました。",
              "citation": {
                "source": "海坊主の話",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらからよけて行かうとすると、スウーと動いて行く手をさへぎります。",
              "citation": {
                "source": "海坊主の話",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "スウーッとその蛾が吸いこまれてしまった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
