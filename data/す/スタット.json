        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "細いニクロム線を格子状に組んだものを美濃紙ではさみ、本の表紙などに使われていたレザークロスでおおっただけのこの代物には、断熱材も温度調節用のサーモスタットも組み込まれていなかった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処では、恰度イプセンのノラが、クログスタットの手紙を夫のヘルメルに見せまいとする必死の努力と同じ様な努力が、繰返されたに違いない。",
              "citation": {
                "source": "花束の虫",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十二日、クロンスタットの大衆が革命の側に立った。",
              "citation": {
                "source": "労働者農民の国家とブルジョア地主の国家",
                "author": "――ソヴェト同盟の国家体制と日本の国家体制――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　（廊下への入口で）私です、奧さん。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　銀行の用事――といつてもいゝでせうな。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　ごく詰らない用事ですがね、奧さん、たゞそれだけですがね。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "（クログスタット行く。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノラ　クログスタットさんといつて、もと辯護士をしてゐた人です。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランク　あのクログスタットといふ奴ですよ。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノラ　私はちつとも、あいつが――あのクログスタットさんが銀行に關係してゐるといふことを知りませんでしたわ。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて扉が半ば開いて、クログスタットが出て來る。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "）クログスタット　奧さん、ご免なさい。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　失禮致しました。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　承知してをります。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　あなたに少しお話し申すことがありましてね。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　はい。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "だつてまだ一日にはならないぢやありませんか――クログスタット　なりません。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は私少しも用意してませんから――クログスタット　その方はいまご心配には及びません。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノラ　さうですね、構ひませんけれど、たゞ――クログスタット　よろしうございます。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　一人のご婦人と。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　もしやあのご婦人はリンデンの奧さんといふのぢやありませんか？",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　此方へお出でになつた許り？",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　お親しくしておいでなさるのでせう？",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　私もあの婦人とはもと知合ひでしてね。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　あゝ、すつかりお聞きなすつた？",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノラ　クログスタットさん、何であなたはそんなに嵩にかゝつて根掘り葉掘りお聞きになるの？",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "わかりましたか、クログスタットさん。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "クログスタット　やつぱり思つた通りだな。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "女だからつていつもさう――ね、クログスタットさん、下に立つ者は氣をつけて失禮なことのないやうにしないと、私のやうに――クログスタット　權力のある場合にですか？",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
