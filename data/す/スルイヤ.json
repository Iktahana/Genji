        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それ等の家の内で No.1 の奥さんはスルイヤと言って赤毛で赭ら顔で、小肥りの勝気な女。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルイヤの夫は工業学校出の機械屋であったが、あの全欧洲の男性を人殺し機械にした欧洲大戦の際、英国陸軍工兵中尉として、生れた許りのアグネスに頬ずりして、白耳義の戦線へ出征して行った。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫を失ったスルイヤは一人娘を育てる傍ら新しい進歩主義を奉ずる婦人団体へ入って居た。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘の性格や傾向に深い理解を持つ母親のスルイヤは流石に真正面から反対はしなかったが、全宇宙に唯一人の頼りにする者、そして自己の延長である娘を危険な仕事につかせる事は堪えられないように感じた。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルイヤは娘が、一たん云い出した希望に向っていらいらして居る有様を見てすっかり途方にくれて仕舞った。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の手紙はスルイヤ、アグネス母娘の感情のもつれを少し離れて冷静な立場から考えさせる余裕を与えるものとして、二人に喜んで迎えられた。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "以下アグネスがロンドンに残した母スルイヤに宛てて寄こした通信である。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンドンの母親スルイヤは巴里に居る娘の許へ手紙を寄こした。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫の戦死以来の悲しい追憶が次ぎから次ぎへとスルイヤの胸をついて出た。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
