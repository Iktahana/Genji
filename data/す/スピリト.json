          "literary": [
            {
              "text": "この頃毎日スピリト〔アルコール〕探しにうろつく。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "リトフォンドまで歩き дом　писателей〔作家の家〕へ電報を打とうとしたが、どうせだめだというのでやめ、ニキーツキーにスピリトのために一町以上の列がある。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから『コン・スピリトォ（活溌に）』でお歌ひ遊ばせ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かがスピリト・サント教会のメルルッツォ神父(*27)を起こしに行くと、神父は陰鬱なスクエアに急行し、どんなものでもいいから助けになる言葉を発そうとした。",
              "citation": {
                "source": "闇をさまようもの",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
