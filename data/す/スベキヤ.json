          "literary": [
            {
              "text": "而シテ此ノ如キ犯罪ニ対シテ、吾人法医学者ハ、如何ニシテ犯罪ヲ調査シ、兇器ヲ研究スベキヤ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ナル基礎知識ニ照シテ、犯行ノ径路、手段ノ内容ヲ明カニスベキヤ――云々――　……どうです諸君。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ貴局ヨリノ受信シタル通信文ヲ逆ニ送信スベキヤ」相手「ソノ必要ナシ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ今摸傚ノ弊ヲ矯メムト欲セバ、何如ナル道ニ從事スベキヤト云フニ、余ガ見ル所ニテハ、唯二道アルニ過ギズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
