        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "やっと外へ出て見るとそこは上野公園のような処で、自動車やボーイスカウツが群集している。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "御存知には違ひなからうがスカウツ・ペースといふのは一哩を十分強で驅るハイキングの術語である。",
              "citation": {
                "source": "文學的自叙傳",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "御存知には違ひなからうがスカウツ・ペースといふのは一哩を十分強で駆るハイキングの術語である。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年たちは、これはスカウツの制服であると云つた。",
              "citation": {
                "source": "神、國王、國家",
                "author": "エム・ケー・ガンヂー",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は彼等がスカウツとしてどんな働きをしたかを知りたいと思つた。",
              "citation": {
                "source": "神、國王、國家",
                "author": "エム・ケー・ガンヂー",
                "note": "青空文庫"
              }
            }
          ]
        }
