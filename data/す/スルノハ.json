          "literary": [
            {
              "text": "借金スルノハツライモノ鍋釜マデモミンナ取ラレテスツテンテンと、途方もない自暴を飛ばしたのもある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "真理デアル以上ハ実践スルノハ当然デアル。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ颯子ヲ愛スルノハ、彼女ニイクラカソンナ幻影ヲ感ズルセイデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "体ガ妙ニ柔軟ナ感ジガスルノヨ」「ハヽア、オ前ガ春久ヲ贔屓ニスルノハ、色ノ黒イトコロガ黒人ニ似テルカラダナ」「春久サンハ胸毛ガ一杯生エテルケレド、黒人ハ毛ガ少イワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ椅子ニ仰向ケニナッテ彼女ニ顔ヲ剃ッテ貰ッタラ、彼女ノアノ鼻ノ孔ガ奥ノ奥マデヨク見エルダロウナ、薄イ鼻ノ肉ガ紅ク透キ徹ッテ見エタリスルノハ悪クナイナト、ソンナコトモ考エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "知リモシナイＰＱ病院ノベッドナンカニ運バレテ、ドンナニ偉イ博士タチカハ知ラナイガ、会ッタコトモナイ整形外科ノ先生ダノ麻酔ドクターダノレントゲン科ノ先生ダノニ囲マレテ、サモ大層ラシク取リ扱ワレテ、息ガ詰マッテ死ニカヽッタリスルノハイヤダナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母ヤ祖父母ノ墓石ノ形式ニ反スルノハ申シ訳ナイガ、予ハドウシテモ五輪塔ニシタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妻ハソレヲ口ニ出シタ※ハナイガ、ジェームス・スチュアートノ映画ダト缺カサズ見ニ行クラシイノデアル）モットモ妻ガ木村ニ接近スルノハ、僕ガ彼ヲ敏子ニ妻ワセテハドウカトイウ考エガアッテ、家庭ニ出入リサセルヨウニシ、妻ニソレトナク二人ノ様子ヲ見ルヨウニト命ジタカラナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
