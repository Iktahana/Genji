  {
    "uuid": "d5c6be06-ac3f-5ce0-a00a-871eef55b0b8",
    "entry": "容",
    "reading": {
      "primary": "すがた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
