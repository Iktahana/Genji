    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また起首の示す二元性と、全節の下向的進行との関係は、あたかも「いき」な模様における、縞柄と、くすんだ色彩との関係のごときものである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄生蟹のうた潮みづのつめたくながれて貝の齒はいたみに齲ばみ酢のやうに溶けてしまつたああここにはもはや友だちもない　戀もない渚にぬれて亡靈のやうな草を見てゐるその草の根はけむりのなかに白くかすんで春夜のなまぬるい戀びとの吐息のやうです。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄生蟹のうた潮みづのつめたくながれて貝の齒はいたみに齲ばみ酢のやうに溶けてしまつたああ　ここにはもはや友だちもない戀もない渚にぬれて亡靈のやうな草を見てゐるその草の根はけむりのなかに白くかすんで春夜のなまぬるい戀びとの吐息のやうです。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一通り仕事がすんだ後で、彼女はすっかり疲労を感じていた。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "下　戦争がすんでから、重吉は故郷に帰った。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "渚にぬれて亡靈のやうな草を見てゐるその草の根はけむりのなかに白くかすんで春夜のなまぬるい戀びとの吐息のやうです。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその纖毛の先から更に無數の生毛が光り出し、煙のやうにかすんで見える。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の日は鈍くかすんで、煙突から熊のやうな煙を吹き出してゐた。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラトンにあっては、イデヤが感情の中に融かされ気分の情趣ある靄でかすんでいる。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "反対にまた詩人の書いた小説は、観照が主観の靄でかすんでいるため、どこか感じが生ぬるく、真の小説的現実感に徹しない。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに山の霧が多いので、いつも水蒸気で町の軒灯が紅色にかすんで、一層山間都市の華やかな感じを深める。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "粗末な造作なので、私のゐる部屋の上に當る寢室では、三人の兄弟が半分怒つたり、半分ふざけてゐるらしく、どすん／＼と痛い足音を響かせた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷君の方で早速遠慮を示したので、結局出掛けないことになつて、「では二階に行かうか、此処は子供が目を覚ますんで話が出来ないんだ」と牧野さんは云つた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "行つて見るとまだ叔母は朝御飯が漸くすんだばかりで、ゆるゆるとお茶を飲みながら近所の人とトラックの話をしてゐるのだ。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　ふーん、ぢやまた来て話すんだらう。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "すんだ空は息吹がかかったように、サッと曇って、今までどこにいたろうと思われる霧がかかる。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "つばきの葉を見るような、厚い革質のくすんだ光沢があって、先端の丸い、細長い楕円形の葉を群がらしている。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨あがりのすんだ空に、第一噴火口と、第二噴火口の馬の脊道に立って見あげる。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "川俣川にかけた橋を渡って、大門川の峡流を見下しながら、弘法水に立ち寄り甘美な泉をむすんで飲む。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンクリがすんで終業時間になった。",
              "citation": {
                "source": "セメント樽の中の手紙",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "――今日は土曜じゃないか、それにどうして午後面会を許すんだろう。",
              "citation": {
                "source": "牢獄の半日",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、もう夕食になろうとするのに、何だって今日は面会を許すんだろう。",
              "citation": {
                "source": "牢獄の半日",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、今、お前はその実際の力も、虚勢も、傭兵をも動員して、殺戮本能を満足さすんだ。",
              "citation": {
                "source": "牢獄の半日",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "引っ張り出すんだって、よっぽど、力を入れなけりゃ抜けやしないじゃないか。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、小さな傷から命とりの破傷風が起こった時に、慌てて騒ぎ出すんだわ」「うめえことを言やがるなあ。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　彼は、恐しい夢でも見てるような、無気味な気持に囚われながら、追っかけられながら、デッキのボースンの処へ駆けつけた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ボースンは、からかわれていると思って、遂々憤り出してしまった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "不人情なことを云うと承知しねえぞ、ボースン、ボースンと立てときゃ、いやに親方振りやがって、そんなボーイ長たあ、ボーイ長が異うぞ！",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとかい」「ほんとだとも」　水夫たちは、ボースンと共に、カンカン・ハマーを放り出したまま、おもてへ駆け込んだ。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「時間中に、おもてへ入ることは能きないって、おもてへ行って、ボースンにそう云って来い」「ハイ」　彼が下りかけると、浴せかけるように、一運はつけ加えた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
