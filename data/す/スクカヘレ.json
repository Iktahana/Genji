          "literary": [
            {
              "text": "台所でやっていたらＹ子のところへ電報ハハキトク、スクカヘレ。",
              "citation": {
                "source": "日記",
                "author": "一九五〇年（昭和二十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "上衣のポケツトには、「アニキトクスクカヘレ」の電文が這入つてゐる。",
              "citation": {
                "source": "青年",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日の午後飛んで帰ってきたＹ君の話によると、何でも家から「テラダシキキヨウマツスクカヘレ」という電報が郷里へ行って、それが丁度Ｙ君が親類の結婚披露とかの席に列っている所へ配達され、それという勢いでＹ君は今朝の三時に起きて一番で帰ってきたという話なのである。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
