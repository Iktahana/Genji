        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "汗かきコースの後で入浴者は身体の汗をストリジル（肌かき器）で除く。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "グトゥスは首が細い小さい瓶でストリジルに油を塗るためのものであった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウスによると弱い者はストリジルの代わりにスポンジを使うこともあった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストリジルを使ったあとにタオルで擦り、入浴者は最後にテピダリウムに入り、外気に出る前に種々の時間を費やした。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
