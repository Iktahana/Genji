          "literary": [
            {
              "text": "彼らにとつては、將來の世界歴史は、彼らの社會組織案の宣傳と實行とに歸着すべきものであつた。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし彼らは、その組織案が、社會の最も痛ましい階級たる、勞働階級の利益を代表することをさとつてゐた。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            }
