          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "円周の長さを測るために、まず外回りの距離を計算する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この公園のジョギングコースは、池の外回りを一周する設計になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "台風の進路が日本の外回りを通過したので、大きな被害はなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "さて、此中に入った平次は、二人の下っ引に案内されて、ざっと店の外回りを見た後、主人初め家中の者に逢って見ました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "猿回し",
                "note": "青空文庫"
              }
            },
            {
              "text": "外回りから想像したよりも多くの手が入っており、ウォードは優美な渦巻きと瓶の模様のついたオーバーマントルと貝殻の彫刻がある食器棚の半分がそっくり失われているのを見てがっかりした。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "といっても、ただ働き同然の丁稚奉公のようなもので、仕入れや配送の手伝いといった外回りが主な仕事であった。",
              "citation": {
                "source": "くじらようかん",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一週間とたたないうちに、バベとブリュジョンとは、ひとりは「審理」に行きひとりはそれから戻ってきながら、フォルス監獄の外回りの道で行き合った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはフォルス監獄の外回りの路地の壁だった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "宰八が言続いで、「……（外廻りを流れて来るし、何もハイ空家から手毬を落す筈はねえ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、せきこんで、「……外廻りをするにして、要心に事を欠いた。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからお嬢さんのナイフやフオオクの置いてあるところへは、中に寄せて小さい花を、外廻りに大きい花をばら蒔く。",
              "citation": {
                "source": "薔薇",
                "author": "ROSEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度は師匠にあずけてある瑠美子の春着を作るために、デパアトの外廻りの店員を呼び寄せて、派手な友禅ものを、部屋一杯にひろげていたし、一度はベッドの上から手拍子を取って、いつもの童謡を謳いながら、瑠美子を踊らせていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お島は頭髪を丸髷に結って、少しは帳場格子のなかに坐ることにも馴れて来たが、鶴さんはどうかすると自転車で乗出して、半日の余も外廻りをしていることがあった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "百六　小野田は時々外廻りに歩いて、あとは大抵店で裁をやっていたが、隙がありさえすれば蓄音器を弄っていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "外廻りには茶店が出来ている。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その店に縁故の深い人の世話で、叔父の三吉にも身元保証の判を捺かせ、当分は見習かたがた外廻りの方をやっていた。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨探偵も届いたか、いよ／＼今夜は福澤を片付けると云うので、忍び／＼に動静を窺いに来た、田舎の事で外廻りの囲いもなければ戸締りもない、所が丁度その夜は私の処に客があって、その客は服部五郎兵衛と云う私の先進先生、至極磊落な人で、主客相対して酒を飲みながら談論は尽きぬ。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅田は無雑作に投出した名刺を拾上げて、暫時見ていたが、気をかえて立上った時、外廻りの社員が汗を拭き拭き入ってきた。",
              "citation": {
                "source": "秘められたる挿話",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "その裏門が海に向いた、わけても宏壮な一宇の屋敷の外廻りの土塀まで来た時であった。",
              "citation": {
                "source": "柳営秘録かつえ蔵",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "余り冴えないものだが、外廻りの雨の掛かる所、殿堂なら外廓に用いられる。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "彫刻修行のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "建仁寺のひどく壊れた外廻りを見廻し、自分は黙って潜り戸をあけた。",
              "citation": {
                "source": "又、家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十日の日に煤掃きを若い者の居た時はさせたと云う事だけれ共、女ばかりで、寒いのにガタガタするでもないと、三、四月の暖くなるまでのばして、外廻りを村の者に一通り掃いてもらった。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　佐々は、外廻りを一通り眺め、入口の段を昇った。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝統的というのか本質的というのか、とにかく女性にはこの外廻りの小さな注意が沢山いります。",
              "citation": {
                "source": "今日の女流作家と時代との交渉を論ず",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "外廻りの仕事に行った人達は幾度も雨に妨げられて空しく帰って来た。",
              "citation": {
                "source": "少年の死",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから外廻りは、家の広い外郭になつて居て、大炊屋もあれば、湯殿｜火焼き屋なども、下人の住ひに近く、立つてゐる。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから外廻りは、家の広い外郭になって居て、大炊屋もあれば、湯殿｜火焼き屋なども、下人の住いに近く、立っている。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "外廻りは白い漆喰ぬりで、瓦ぶきの屋根に剥げっちょろけの煙突を立てているその家は、現在の主人の祖父や曾祖父が植えこんだ桑やアカシヤやポプラの緑のなかに、すっぽり埋まっていた。",
              "citation": {
                "source": "嫁入り支度",
                "author": "ПРИДАНОЕ",
                "note": "青空文庫"
              }
            },
            {
              "text": "白衣の女のある者は、鈴をふり、横笛をふいて、その外廻りを歩いた。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "壊れた外廻りの垣根から、廃屋を取毀したあとの整理、井戸浚い、母家の修繕……と数え立てると眼前に待っている仕事だけでも限りがない気がする。",
              "citation": {
                "source": "沼畔小話集",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚伍　それでは外廻りの警固が手薄になります。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手のくぐり戸が開いて、外廻りを警固していた士の甲が入って来る。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長いお島の病院がよいの間、小野田が、多く外まわりに自転車で乗出した。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
