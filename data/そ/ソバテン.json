    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "臨川寺は駅路｜蕎麦店間より二丁｜許の坂を下りている。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "調合｜畢れば、柏軒が門人等を神田大横町の蕎麦店今宮へ率て往き、蕎麦を振舞つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、歩いているうちに空腹を覚えて来たので、路傍で蕎麦店を見つけて入り、そこで蕎麦を喫ってまた歩いた。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜時なり、三社の祭りなり、賑い言わん方なしといえば、携え来りし着替を出し、独り夕方より観音へ参詣し、夜に入り蕎麦店へ入りて京味を試み、ゆらりゆらりと立帰りしところ、裏のうち騒がしく「さても胆太き者どもかな」と口々に言う。",
              "citation": {
                "source": "良夜",
                "author": "饗庭篁村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
