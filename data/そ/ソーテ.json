          "literary": [
            {
              "text": "まだスープも出ないうちから客の大きなコップへなみなみとポルトワインを注ぎ、また、別のコップへは擬いの＊５ソーテルンを注いだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、そんな県や郡の田舎｜市に、本物のソーテルンなどある筈がないからである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊５　ソーテルン　産地ソーテルン市の名を冠したフランス産の白葡萄酒。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "つる　　オート・ソーテルヌでございませう。",
              "citation": {
                "source": "落葉日記（三場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "オゥ・ソーテルヌならあてがありますが」「ああ、それをもらおう。",
              "citation": {
                "source": "黄泉から",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、蛙のソーテは乙だつたな」といふと、並んで歩いてゐた石田が、「おれもそれを考へてゐたところだ。",
              "citation": {
                "source": "蛙料理",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれがやる」　三十何匹おさへつけて帰つたが、間もなく石田がソーテにして持つてきた。",
              "citation": {
                "source": "蛙料理",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食＝白葡萄酒（ソーテルン）小壜一本。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食＝ソーテルン一本。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "１人はエジプト王プトレマイオス１世ソーテール（Ptolemy Soter 367-282BC）の侍医でエラシストラトスの教師であった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて彼はソーテルヌの一壜をぶら下げて出て来ると、サロンの卓の上にそれを置いて、「｜へい旦那之が最後の壜で御座います。",
              "citation": {
                "source": "二人のセルヴィヤ人",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            }
          ]
        }
