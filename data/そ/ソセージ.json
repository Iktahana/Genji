          "literary": [
            {
              "text": "骨つきのチキンの場合だけでなく、お母さまは、ランチのお菜のハムやソセージなども、ひょいと指先でつまんで召し上る事さえ時たまある。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スープとお馬鈴薯と、ソセージ、ね、たしかそうだったわ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だけど、もう、ぶらぶらしたって、ソセージみたいで、ただ長くなっているだけよ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はベルリンの歴史よりソセージの美味なのを一つ食べあてれば、それで心は満足しきって煙草を吹かしている。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
