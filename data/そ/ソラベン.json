        "examples": {
          "standard": [
            {
              "text": "空港で時間を節約するため、空弁を買って機内で食べることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "羽田空港で出発の時間まで余裕があったので、気になっていた空弁を一つ買って搭乗ゲートで食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "地元の食材を使った空弁が旅行者の間で話題を呼び、土産品としても人気が出ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "その後より続いて出てお出でなさるは孰れも胡麻塩頭、弓と曲げても張の弱い腰に無残や空弁当を振垂げてヨタヨタものでお帰りなさる。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分を出させ、紺木綿の風呂敷でしばった空弁当がつんであるごたごたした臭い廊下へ出るといきなり、「女中さんが暇を貰いたいらしい様子ですよ」と云った。",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "火ともし頃になって恭二と良吉が局から空弁当を下げて帰るまで枕元に座ったっきり栄蔵はお君のそばをはなれなかった。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
