        "examples": {
          "standard": [
            {
              "text": "彼の乱暴な言葉遣いは、育ちが悪いと思われても仕方がない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "育ちが悪いせいで、人前でどう振る舞っていいか分からない時がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "いくら才能があっても、育ちが悪いと人間関係で苦労するだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "岩山には土が浅いと見えて松の育ちは悪いのであるが、育ちが悪いだけに松の枝振りは風流である。",
              "citation": {
                "source": "淡紫裳",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうクリストフを育ちが悪いとも思っていなかった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
