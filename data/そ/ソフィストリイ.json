          "literary": [
            {
              "text": "精力と論理と一貫性を欠いたソフィストリイの堆積である。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二に新劇人たちのソフィストリイ。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、このように目まぐるしいソフィストリイについて歩くのは、たいへんくたびれる仕事である。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の言っているのはそんなむずかしいソフィストリイの事ではありません。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
