      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "broad bean (Vicia faba)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旬のそら豆は、塩茹でにして食べるのが一番美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "春先の居酒屋で、塩茹でしたそら豆と冷たいビールの組み合わせを心ゆくまで楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "祖父の畑でそら豆が豊作だったと連絡があり、大きな袋いっぱいに詰めて送ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "どこからかそら豆を茹る青い匂がした。",
              "citation": {
                "source": "みちのく",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚の方でも時々は、あの小さなそら豆形の怒ったような眼をあげて、そちらをちらちら見ていたのだ。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹がへったなあ」「いま、したでヨシ子がそら豆を煮ている」「ありがてえ。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "罪のアントは、蜜豆、いや、そら豆か」　ほとんど、ろれつの廻らぬくらいに酔っているのでした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「罪と空腹、空腹とそら豆、いや、これはシノニムか」　出鱈目を言いながら起き上ります。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつのまにか、背後に、ヨシ子が、そら豆を山盛りにしたお皿を持ってぼんやり立っていました。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、根を抜かれた、肥料になる、青々と粉を吹いたそら豆の芽生に交って、紫雲英もちらほら見えたけれども。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "郊外へ出ると麦の緑に菜の花盛りでそら豆も咲いている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大根、桜島、蕪菜、朝鮮芋（さつま芋）、荒苧（里芋）、豌豆、唐豆（そら豆）、あずき、ささげ、大豆、なた豆、何でもあった。",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず日曜が豆腐汁、それから油揚と菜、大根の切干、そら豆、うずら豆、馬肉、豚肉など大がい献立がきまっている。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑平居に多いのは、そら豆、蕗、金盞花である、主人公も奥さんも物事に拘泥しない性質だから、庭やら畑やら草も野菜も共存共栄だ、それが私にはほんたうにうれしい。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮れの築地小劇場で「子供の日」のあったおりに、たしか「そら豆の煮えるまで」に出て来る役者から見て来たらしい身ぶり、手まねが始まった。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "（略）さて当日の模様をざっと書いて見ると、酒の良いのを二升、そら豆の塩茹に胡瓜の香物を酒の肴に、干瓢の代りに山葵を入れた海苔巻を出した。",
              "citation": {
                "source": "深川の散歩",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "春深くなればそら豆やゑんどう。",
              "citation": {
                "source": "季節の変るごとに",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "茉莉花や菊をつくるのの巧かつた彼は、食糧事情が窮迫して來るにつれ、そら豆とか莢豌豆とか菠薐草とか、さういつたおばあさんの口に合ふものの方へ轉向して行つた。",
              "citation": {
                "source": "おばあさん",
                "author": "ささきふさ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うちじゃ、チェチェヴィーツ（そら豆）は、きのうこしらえたわ。",
              "citation": {
                "source": "少年たち",
                "author": "МАЛЬЧИКИ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ばあやが言ったけど、精進期には、えんどうやチェチェヴィーツ（そら豆）を食べなければいけないんですって。",
              "citation": {
                "source": "少年たち",
                "author": "МАЛЬЧИКИ",
                "note": "青空文庫"
              }
            },
            {
              "text": "興趣つきない手長エビ釣り〈七月〉手長エビぼろのかかったように釣れ　毎年食膳にそら豆が出るころになると、手長エビ釣りを思いだす。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "そら豆腐屋さんの」　おおそう言われると想い出した。",
              "citation": {
                "source": "故郷",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はふくぶくしい丸顔の頬についたそら豆大のほくろを看板に学校ぢゆうの愛嬌者になつてたが、ひとが面白半分に「蟹本さん、頬ぺたに墨がついてるよ」といふと　ふ、ふ、ふ　と笑つて「すーみーぢやーなーいーんーだ。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "仁太は用心ぶかく、シャツやズボンの四つのポケットを、そら豆の煎ったのでふくらましていた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じような見舞いを聞いたあと、「こないだはどうも、きれいなそら豆をありがとうございました」　すると、その人は少し笑って、「いやァ、うちは、胡麻をあげましたんじゃ」　じぶんの馬鹿正直さに気がつき、これからは米とも豆ともいわないことにきめた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "炬燵の中で小さい孫を膝にのせ、暑い夏の日、日陰の涼み台の上で、ある時はそら豆の皮などむきながら、またある時は孫と向い合ってひき臼を回しながら、歌でも歌うような調子でかやの甚作どんの話はくり返された。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかのこと、そら豆の煎ったのを一握りずつ添えたことがあった。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いねは聞きとがめて二人の前に立ち、「数をよんでみい、少いもんにそれだけやるせに」　二人はそら豆を一つ二つと数えた。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方の、むし暑い風が、せまい銀座横町の馬糞いろの埃と、蠅とを、塀ごしに運んできて、そら豆の色が青いほか、ちゃぶ台の上は、白っぽくなった。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "待合茶屋の豆腐やそら豆ではあきたらない。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そらまめのは其色を嫌ふ人もあるべけれど、豌豆のは誰か其姿を愛でざらむ。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "『そらまめの花』の巻の「すたすた」と「そよそよ」は四句目に当たる。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば『そらまめの花』の巻には「七夕」の七の字があるだけで本来の「数字」は一つもないのに、『八九間』の巻には「小鳥一さけ」にすぐ続いて「十里あまり」が来る。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
