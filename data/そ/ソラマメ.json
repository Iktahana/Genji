[
  {
    "uuid": "6101d3a2-b8db-56a9-891f-30d00f21f2c9",
    "entry": "そら豆",
    "reading": {
      "primary": "そらまめ",
      "alternatives": [
        "ソラマメ"
      ],
      "is_heteronym": false
    },
    "grammar": {
