          "literary": [
            {
              "text": "外町の方へは、と言つて其の某邸で斷つた。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへは紀伊国熊野浦長島外町の漁師｜定右衛門と云うものが毎日｜魚を送ってよこす。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで行き逢う人々の多くは――近在から買物に来た男女だとか、旅人だとかで――案外町の人の少いのに気が着いたことが有るだろう。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの五左衞門は女癖は惡いが、金放れがいゝから、思ひの外町内では評判のいゝ男だ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お篠姉妹",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
