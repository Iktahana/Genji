  {
    "uuid": "08ff1b3c-5576-552a-9914-ebbf82244b8a",
    "entry": "ソウシテ",
    "reading": {
      "primary": "そうして",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
