          "literary": [
            {
              "text": "髭むじゃの男の顔も、そそけ髪の淫らがましい女の顔も、むさくるしい二階の窓から好奇らしく私たちを眺めていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもそそけ髪で、子供を背負って働いていた先妻の顔を思い出しました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一男か、よく帰って来てくれた」　そそけ髪の頭をあげて、母は幾日か夢に描きつづけた一男の顔を、じっと眺めた。",
              "citation": {
                "source": "秋空晴れて",
                "author": "吉田甲子太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
