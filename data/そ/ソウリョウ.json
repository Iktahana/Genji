  {
    "uuid": "77b8e039-d6b9-5e20-bda1-7f13e6ddfa10",
    "entry": "爽凉",
    "reading": {
      "primary": "そうりょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "cool and refreshing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "秋の爽凉とした空気は、心地よい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "爽凉な風が吹き抜け、夏の暑さを和らげた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "爽凉とした朝の散歩は、一日の始まりに最適だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "旧弊で煩瑣なものは、みんなぶちこはされて、一種の革命のあとのやうな、爽凉な気がゆき子の孤独を慰めてくれた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "爽凉の気、外苑あたりの叢園に漂ふ昭和二年の秋の一日である。",
              "citation": {
                "source": "呉清源",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [
        "総量",
        "総領",
        "送料",
        "蒼竜"
      ],
      "synonyms": [],
      "antonyms": [],
      "related": []
    },
