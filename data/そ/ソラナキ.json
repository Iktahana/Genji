        "examples": {
          "standard": [
            {
              "text": "彼の空泣きには、誰も同情しなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供は空泣きをして、お菓子をねだっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そんな空泣きでは、何も解決しないよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "何からお話ししてよいやら」　と、わっと泣き伏さんばかり空泣きに身をふるわせて見せた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "生ひ立たんありかも知らぬ若草をおくらす露ぞ消えんそらなき　一人の中年の女房が感動したふうで泣きながら、初草の生ひ行く末も知らぬまにいかでか露の消えんとすらん　と言った。",
              "citation": {
                "source": "源氏物語",
                "author": "若紫",
                "note": "青空文庫"
              }
            },
            {
              "text": "姦夫の足業は武大を悶絶させ、妖婦は砒霜の毒を秘めてそら泣きに泣くこと　武大はいつもの公園に出て、蒸饅頭の蒸籠店をひろげていた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
