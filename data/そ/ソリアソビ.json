          "literary": [
            {
              "text": "友達同士の遊びや宴会は下町でしても、こっそり遊びにはここもまた肩が凝らなくてよかった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思っても、お艶の夢八、とっさに立つわけにもゆかず、さりとてそのままはいる気にはなれず敷居のところでモジモジまごまごしていると、こっそり遊びに来て芸者を呼ぶとそれが昔のお艶だったので、より驚いたのは鍛冶富だ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お芝居、そり遊び、氷すべり、にぎやかな夜会、たのしい談話。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
