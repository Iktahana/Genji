  {
    "uuid": "e32157d4-bd24-5193-b6ef-5ebf1d1ca622",
    "entry": "其の方",
    "reading": {
      "primary": "そのほう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "代名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自分の其の方面に於ける能力の限度が、少しずつ見えて来た。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「繪をおかきになるなら、向ふの原つぱへ御出になるといゝ處がありますよ」と教へられた儘に其の方へ行つて見る。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「でも、妙ね、然ういへば……何ですつて、蛙の聲が、其の方には、こがれる女の小玉だ、小玉だと聞こえたんですつて、こたまだ。",
              "citation": {
                "source": "遺稿",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は其の方を枕にして居たのぢやから、つまり枕元の戸外ぢやな。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎蔵と半次其の方を見れば、　仲蔵とお光。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ハッと仲蔵や嘉助や雪枝が其の方見れば、　五郎蔵始め、一味の奴が現れた。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "お殿様が、Ｔ「其の方」「娘があった喃」　と訊ねられた老臣。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿様が「分らん奴だＴ「其の方が、誰かに　斬られて死ぬのじゃ」　あの拙者が、と老臣「メッ、滅相も無い」　殿様が「イヤイヤＴ「心配致すな　其の方の娘に　立派な仇討を　させてやる」　老臣も呆れ果てた。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿様が、Ｔ「其の方、真は　武士であろう？",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「非人に迄、身を落し　さだめて辛いであろう」　とハラハラと落涙して、Ｔ「其の方の至孝　天に通ぜぬ　道理が無い」　と乞食の手を掴んで、Ｔ「仇討本懐の日を　祈り申すぞ」　と老臣に金子を包ませて、　それを乞食に与え、Ｔ「些少乍ら　余の志じゃ」　乞食はまるで、鳩が豆鉄砲を喰った形。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が、おふみは其の方へ行こうとせず、ふいと立上るや、Ｔ「妾帰ります」　と来た。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは其の方へ持って行って読みこなして貰う方が早道と思うが」　先ずこんな調子の人物でした。",
              "citation": {
                "source": "茶屋知らず物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "萬事其の方に相まかせる、此女何處にても伴ひ行き、妙齡を我が手に入れんまで、人目にかけず藏し置け。",
              "citation": {
                "source": "妙齡",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の御本の先生を、最う其は……贔屓な夫人があつて、其の方が私を飼つて、口移しに餌を飼つたんです。",
              "citation": {
                "source": "貴婦人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の方が、どれほどお情か分りませぬ。",
              "citation": {
                "source": "妖魔の辻占",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――糸崎行――お恥かしいが、私に其の方角が分らない。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "備中驚き嘆じ、無事に渉り果てた按摩を、床几に近う召寄せて、「あつぱれ、其の方、水にせかるゝ大巌を流に逆らひ押転ばす、凡そ如何ばかりの力があるな。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の方が将門を我が意の下に置くに便宜ではないか。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして劇しく揺られたりぎう／＼圧されたりしてゐると、其の方に気が褫られて、今まで煮返るやうに思ひ詰めてゐたことが、何うかすると寂しい影のやうに薄らぐのを感じた。",
              "citation": {
                "source": "復讐",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし氷川は其の方が、寧ろ感じがよかつた。",
              "citation": {
                "source": "倒れた花瓶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の方を向くと船渠の黒い細い煙突の一つから斜にそれた青空をくっきりと染め抜いて、真白く一団の蒸気が漂うて居る。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一かどの專門家たり得べき才能を持ちながら、それを其の方向に用ゐようとはしない。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんぢやおとつゝあ水飴でも買つて來てやつたらよかつぺな、與吉げ隱して置けば何でも有んめえな」おつぎは更に卯平を顧みて「なあ爺、其の方がよかつぺ」といひ掛けた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の方角から歌声が洩れて来た。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は其の方面の教育を受けてもいるし、又、そうした人柄でもあるのだから。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ぐ其の方向に振向いた時、私は、今しも白塗の欄干を越えて海の上へと躍つた島民少年の後姿を見た。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、然らば假名遣を若し國民に教へようとするならば、どうしたらば好いかと云ふ其の方法手段であります。",
              "citation": {
                "source": "假名遣意見",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の場合では殊に少數のむつかしい假名から教へるといふ手段を研究して、其の方法をもう少し完全に作れば、假名遣を廣く教へることが出來ようかと思ひます。",
              "citation": {
                "source": "假名遣意見",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
