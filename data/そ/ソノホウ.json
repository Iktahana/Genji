        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "失礼ですが、その方のお名前をお聞かせいただけますか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "もしその方がよろしければ、この件について詳しくお話ししましょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この手紙は、その方にお渡しください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
