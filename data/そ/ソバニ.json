          "literary": [
            {
              "text": "ミチコサンハ、オバサンノ　ソバニ　ヨツテ、「アカチヤン　ダイテテ　アゲマセウカ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンザシハ　サカナノ　ソバニ　シヅンデ　キマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "心をおどらせてひろげ、むこうの街燈の所まで行つて開いて見ると鉛筆の走り書きで今スグ行クカラムコウノポストノソバニイテオクレというのです。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワカラナイシ、ヨソノオジサンガ、ソバニイテ、コワイカオシテ、ナニモイッテハ……」　バッタリ声が切れた。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
