[
  {
    "uuid": "777a09f5-f03e-5c08-813f-590d8afe8dbf",
    "entry": "僧尼",
    "reading": {
      "primary": "そうに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
