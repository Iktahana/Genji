          "literary": [
            {
              "text": "私がソーニヤを愛さずにいられないわけがわかりますよ。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドストイェフスキイは癲癇持ちで、病身で、神經過敏で、人と會つても自由に話の出來ないやうな、僻みの強い、そして極端に嫉妬の深いと同時にパッショネートで、交際社會などへは出られぬ人間であつたと云ふことが、ソーニヤ・コワレーフスキィ女史の自傳の中に書いてある。",
              "citation": {
                "source": "人間の本性",
                "author": "片上伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一人は、ロシヤの数学者として名だかいソーニヤ・コヴァレフスカヤです。",
              "citation": {
                "source": "キュリー夫人",
                "author": "石原純",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
