        "examples": {
          "standard": [
            {
              "text": "彼は大人になっても、時々いたずらっぽく戯えることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子どもたちは毎日戯えて、元気よく遊んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子猫が戯えるように、紐を追いかけて飛び回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ちらほら梅の咲きそうな裏庭へ出て、冷い頸元にそばえる軽い風に吹かれていると、お島は荐に都の空が恋しく想出された。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
