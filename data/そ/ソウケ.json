    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「はあ、そうけえ。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "年取った祖母と幼い自分とで宅の垣根をせせり歩いてそうけ（笊）に一杯の寒竹を採るのは容易であった。",
              "citation": {
                "source": "郷土的味覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「姫君がお聞きになりましたら、いっそうけしからん考えを持っておいでになるとお思いになって、御同情が減るでしょう。",
              "citation": {
                "source": "源氏物語",
                "author": "竹河",
                "note": "青空文庫"
              }
            },
            {
              "text": "電光のひらめきのごとく彼女はそれを感じたが、同時にそうけだつ思ひで、船室に歸つた。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、従姉もそうけ立った頭髪を押えながら呟いた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚兵衛　はあ……そうけ、嫌か。",
              "citation": {
                "source": "義民甚兵衛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうしてあんたはそうけちけちなさるのです？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうけえ、新郷へ行くけえ、あそこはどうもな、吝嗇な人間ばかりで、ねっかららちがあかんな」と言って声高くその中年の男は笑った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「文句がなければ、金はいまでも渡そう」「そうけえ。",
              "citation": {
                "source": "疑問の金塊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のすごみのある顔が、一そうけわしくなり、頬はひっきりなしにけいれんし、眉はぴくぴくと上ったり下ったり。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうけえ、そうけえ。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな団子を食わせるからだ」「あんだって、この人は団子にばかりそうけちイつけるだんべ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの金は、いまでも返すよ」「いりませんよ、あんなお金――」「そうけんけんいうな。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「高音、そうけんけんいわずと、ここへ帰って来なさい。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうけ、じゃあやめべえ、おやすみなんしょ」　翌日、勇吉は、麦粉をもって勘助のところへ行った。",
              "citation": {
                "source": "田舎風なヒューモレスク",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろんな話していたときＫ、「あなたがやるんじゃない、僕らがやるんだよ」　自分がやる　と、思っていたわけではないが、自分は何となしそうけじめのつけられたことをおどろいた　そんな感情○二人の青年はいずれも社会の下積になっていればいるほど、ますます高い目で社会を判断するのであった。",
              "citation": {
                "source": "バルザック",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "袖を取りて読むくだりは、例のめちやめちやにて、宋蘇卿を「そうそうけい」と云ふなど大愛嬌なり。",
              "citation": {
                "source": "両座の「山門」評",
                "author": "三木竹二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあ……そうけええ。",
              "citation": {
                "source": "特殊部落の犯罪",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋はほんとうにからっぽで、からっぽなだけにこの前の日曜日よりもいっそうけちくさく見えた。",
              "citation": {
                "source": "審判",
                "author": "DER PROZESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の口から下はナプキンにかくれて見えないが、青いめがねをかけたその顔は、頭から顔じゅうをほうたいでぐるぐる巻き、ほうたいの白い中から鼻だけが赤くのぞいていて、そのぶきみさは、全身の毛がそうけ立つほどだった。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついてはそれがし、いずこまでも夫婦いっしょにとおもいきわめていたけれども、しかしつく／″＼かんがえてみるのに、そなたはそうけんいんさまの妹御であらせられるし、そのうえこゝにいるひめたちは故備前守のわすれがたみのことでもあるから、やはりこれは助ける方が道だとおもう。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いえ、ちがうでおじゃる、」と白ウサギ、「そこがたいそうけったいで。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
