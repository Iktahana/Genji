        "examples": {
          "standard": [
            {
              "text": "このスマートフォンは操作性に優れており、高齢者にも使いやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新しいインターフェースの操作性を改善するために、ユーザーテストを行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "リモコンの操作性が悪いため、メーカーに改善を要望する声が上がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ちっぽけなディスプレイに表示される文字数が少ないことで、使いにくくはないかとも心配しましたが、綴りを入れるとすぐに意味が現れる操作性の良さには、いっぺんにつかまります。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "物の本や雑誌などによると、Ｗｉｎｄｏｗｓ環境ではアプリケーション間で操作性が統一されるのでよろしいとある。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
