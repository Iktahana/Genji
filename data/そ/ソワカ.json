[
  {
    "uuid": "15b27a68-b1ea-5d4c-baf8-5879b0890ab3",
    "entry": "薩婆訶",
    "reading": {
      "primary": "そわか",
      "alternatives": [
        "そばか"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
