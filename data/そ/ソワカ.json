      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "svāhā",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "僧侶たちは読経の最後に「薩婆訶」と唱え、祈りを締めくくった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この秘法を成就させるには、真心を込めて「薩婆訶」と三度唱えるべし。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古文書には、呪文の結びに必ず「薩婆訶」を添えるよう記されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "次に「菩提薩婆訶」という事ですが、菩提は菩提すなわち悟りのことです。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "「薩婆訶」は、速疾とか、成就とか、満足というような意味で、どの真言の終わりにも、たいていついている語です。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶わんから上がる湯げをよく見ると、湯が熱いかぬるいかが、おおよそわかります。",
              "citation": {
                "source": "茶わんの湯",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのめくは髪のなよびか、衣の香か、えこそわかたね。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ホームズがたいへん満足げなことは、私なればこそわかった。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あびらうんけんそわかと唱えて、押頂いて飲んだですて……（お気をつけられい。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蕨の茎葉で蝮に咬まれた創口を撫でてかの歌を誦すと越後でいう由なるが、陸中の俚伝を佐々木喜善氏が筆したのには、蛇に逢いて蛇がにげぬ時「天竺の茅萱畑に昼寝して、蕨の恩を忘れたか、あぶらうんけんそわか」と三遍称うべし。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、寄進についている六地蔵のその施主は、身分素姓年ごろこそわからぬ、いずれもなまめかしく艶な下町女らしい名まえばかりでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "お顔色こそわかりませんでしたが多分、真青になっておられたことでしょう。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人立候補者たちは、あれほどくりかえして女のことは女にこそわかり思いやれるのだから、婦人の辛苦を解決するためには婦人代議士を、と演説した。",
              "citation": {
                "source": "世界の寡婦",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「どうとも御判断に任かせます」　すると、嘉吉は褞袍を蹴るやうにして起きあがると、冷へた茶をごくんと飲んで、「仕末して、いつそわかればなしが決まつたんだ、温泉にでも行つてみるか」と云つた。",
              "citation": {
                "source": "朝夕",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "戀のみぞ知る深き夜の祈祷は永劫に金泥の紺紙にきえぬ世のまこと、――あだしごころのえこそわかたね。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "病気程度も凡そわかっているし。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣きつらをごまかさむとて四十人一ときあまり共に踊れり踊りうる原田なにとて輪に入らぬ泣きつらなせそわかるるきはに輪に入りて踊らでひとり泣くもののある故足の亂るるにこそ　全く狂亂の體で踊りました。",
              "citation": {
                "source": "佐渡が島を出て",
                "author": "江南文三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのためにこそわかい教師たちの正しいふるいたちをねがうのである。",
              "citation": {
                "source": "石をしょわずに",
                "author": "――わかい女教師の自殺",
                "note": "青空文庫"
              }
            },
            {
              "text": "「所司代の番士の長屋の土塀へ、楽書きをした心持ちも、これでおおよそわかって来た。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはまんまと騙されたんだ……今こそわかった――きれいさっぱり騙されたんだ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一草ごとに天にむかい手を合わせ、「朝日が下の三の葉草付くるととまる血がとまる、あびらうんけんそわか」と三度唱え、一草よりまたはじめのごとく唱えて一草とり、また唱えて一草とり、以上三草をもみて付くるときは、たちまち血とまること神のごとし。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、梵語の言で「あびらうんけんそわか」という語を唱えるのであります。",
              "citation": {
                "source": "妖怪学一斑",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ではよくわからんとはいっていたけれども、大よそわかったらしい。",
              "citation": {
                "source": "魯迅さん",
                "author": "内山完造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「假名で十九文字、斯う書いてある、『よさくさにやれみりゐけひぬげやいほてぬ』――解つたか、八」「――あびらうんけんそわか――見たいなもので」「馬鹿だなア」「でなきや、火傷の禁呪」「こいつは隱し言葉だよ」「へエ？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "櫛の文字",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それがよくわからないんですが、おおよそわかってはいます。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですもの……およそわかるわ、一日にどんなに少ししか歩かなかったか……」　前の晩、おそくまでお客があって、その朝、ひろ子は、起きぬけからすこしあわてた。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なるほどね、それで先生のお心持も大よそわかる。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あたしには、おおよそわかりますわ。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「塾生たちの様子は、あとで、集まっているところをまわってお歩きになっても、大よそわかると思いますが。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "内容のたちがそれで凡そわかるでしょうと思って。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この我々の家を四方からかいて、並べるとマア凡そわかる、そういうお年玉をあげとうございます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無延命地蔵大菩薩、おん、かかか、びさんまえい、そわか」「そういえば、そうだなあ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "』変なことをいう神主様だと思いましたが、その時に、またふとわたしの胸に浮んだのは、では、自分でこそわからないが、このごろのわたしの顔色は、いつもと違っているのではないかしら。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
