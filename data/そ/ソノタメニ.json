        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "可ナリ激シクテモソノタメニ寝ラレナイト云ウコトハメッタニナイノニ、昨夜ハ夜中ニ眼ガ覚メ、耐エ難イノデ佐々木ヲ起シ、ノブロンヲ注射シテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ッテ尿量ガ多ク、夜中ニ二回カ三回ハ起キルガ、ソノタメニ寝ソビレテ眼ガ冴エルナンテコトハ一度モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコノ女ハ枕サガシダト分ッテモ、却テソノタメニ興味ヲ惹カレテ、枕サガシヲ承知ノ上デ関係ヲ結ブ、ソノ誘惑ニ抗シカネルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分ソノタメニ和服ヲ着、ソレヲ見セルベク予ノ面前ニ現ワレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ種類ノネックレスハ国産品ニモシバ／＼見受ケルガ、背後ノ後頭部ニ附イテイル留金ニイロ／＼ナ宝石ガ鏤メテアッテ、コノ真似ガ国産品デハ出来ナイノデアル）血壓ノ高イ時ハ頻尿ニナル癖ガアルガ、頻尿ニナッタト思ウト、逆ニソノタメニ一層血壓ガ上ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノタメニ脳ガ充血シ、眩暈ヤ複視現象ガ起ッタリ意識ノ昏濁ガ生ジタリスル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
