    "definitions": [
      {
        "index": 1,
        "gloss": "wiping out",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "害虫を掃滅するために、広範囲にわたる徹底的な薬剤散布が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "敵の残党を完全に掃滅するまで、決して警戒を解いてはならないと命じられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この新しいワクチンが、世界中から恐ろしい感染症を掃滅してくれることを願っている」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "残ったものの命をのばすため、それらを掃滅する非常手段をとることにきめ、その役を二宮一等兵に命じた。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "麗わしき神の御業は、無残にも脚下に蹂躙せられ、人間が額に汗して築き上げたる平和の結晶は、一朝にして見る影もなく掃滅せられ、夫婦骨肉の聖き羈は断たれ、幾千幾万の家族は、相率いて不幸の谷底に蹴落され、大地の上は、至る所に屍の山を築く。",
              "citation": {
                "source": "霊訓",
                "author": "SPIRIT TEACHINGS",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒木一類の掃滅も完了した。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小栗上野介は、綿密な作戦を立て、断固として、西軍を掃滅することを主張した。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして戦後あんなにも沢山な源氏方が、毎日のように、目のさきの河原で斬られたり、各地で掃滅されているのを見ながら、のめのめと、自分のみ助かって来たか。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――が、ご不平とは、いったいどういうご不平ですか」「なぜ一日も早く、平家を掃滅し給わぬか。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の帰京は、朝廷、鎌倉への報告と共に、平家方の打首や擒人の処分、その他の軍務を果たすためで、心は、一日もはやく再び西下して、今のうちに、平家の全勢力を掃滅しておかなければ後日の大患と考えていたのである。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「義経、このたび罷り下るうえは、断じて、平家を掃滅しつくさねば、生きて還らぬ所存である。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやく、いまのうちに味方の兵をだして、それらの者を、掃滅しなければ一大事で。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "平和はまだ洛中洛外だけのこと、各地の逆徒は、一時、影を潜めておるが、掃滅され尽したのではありません。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いよいよ、御決心かの」「されば、機の到るを、ずいぶん根気よく待ち申したゆえ、この秋こそは、どうやら信玄にも、やや時運がひらけて来たようにぞんずる」「この九月にはいって、織田の衆は、またも大挙して西へうごき、叡山を掃滅するとて、去年にもました大軍を催しておるそうな」「そこでおざる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――その反対に、万一、高山父子がそれを拒み、飽くまで信長に楯つくときは、伴天連一門の徒、すべて彼らと同意と見なし、南蛮寺の破却はもちろん、宗門｜掃滅、信徒宣教師の輩、ことごとく馘るから左様心得ておくがいい。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の精兵は、たちまち、地方の鼠賊を掃滅してしまった。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "西国にある皇子のおひとり懐良親王に、遺勅を送って――「わがなきのちも、朝敵｜掃滅のはかりをおこたるな」　と、激励しておられたほどであった。",
              "citation": {
                "source": "私本太平記",
                "author": "黒白帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "白君は涙を流してその一部始終を話した上、どうしても我等｜猫族が親子の愛を完くして美しい家族的生活をするには人間と戦ってこれを剿滅せねばならぬといわれた。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "今や天下にありては、相将その相将に非ず民心動揺して天朝の恢復と胡虜｜剿滅の天の瑞兆あるを見る。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚お爰にモウ一つ断って置きたいことは、われ等の使命が、ありとあらゆる形式の利己主義を剿滅せんとすることである。",
              "citation": {
                "source": "霊訓",
                "author": "SPIRIT TEACHINGS",
                "note": "青空文庫"
              }
            },
            {
              "text": "天草、島原の切支丹一味が亡びてから、長いあいだ経ちましたが、全国に隠れた切支丹宗徒は、容易に剿滅したわけではなく、現に二年前の万治元年には大村領の邪宗徒六百三人を死罪にし、幕府は切支丹禁制の令を厳にし、奴僕を召抱えるのに、檀那寺の証文を必要としました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "火の呪い",
                "note": "青空文庫"
              }
            },
            {
              "text": "天草、島原の切支丹一味が亡びてから、長い間經ちましたが、全國に隱れた切支丹宗徒は、容易に剿滅したわけではなく、現に二年前の萬治元年には大村領の邪宗徒六百三人を死罪にし、幕府は切支丹禁制の令を嚴にし、奴僕を召抱へるのに、檀那寺の證文を必要としました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "火の呪ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二月以来、信長は入洛していて、岐阜は留守だし、加うるにその以前、信長が長嶋門徒の剿滅にかかったとき、家康から援軍を送らなかったので、二国同盟の信義も、このところ少しおもしろくない感情に疎隔されている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜならば、これより前に、黒田官兵衛の手勢は、鳥取城の陥落も見ずに、寄手の陣から後退して、急に、淡路へ渡り、四国に散在している雑然たる敵性の烏合に、しらみつぶしの剿滅を加えていたからである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを討つに先駆した木曾の郎党も没落し、また、あの華やかな勲功を持った義経すらが、またたくまに帷幕の人々と共に剿滅されて、社会の表からその影を失ってしまった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その源氏が、隆々と興って、治承、寿永の世にわたって、平家を剿滅して行ったころには、源平両軍が戟を交えるところに、佐々木三郎｜盛綱の名が功名帳に輝かないところはなかった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとつ、彼を用いて、社稷に巣くう奸党を剿滅なされたら如何なものでしょう。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに反して、呂布は、ぞんぶんに残敵の剿滅を行い、意気揚々、徐州へひきあげて、盛大なる凱旋祝賀会を催した。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵を誘い、敵を分離させ、また個々に敵団を剿滅して、はじめ五千といわれた越境軍も、やがて樊城へ逃げ帰ったのは僅々二千にも足らなかったという。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
