          "literary": [
            {
              "text": "墨汁で顔まで汚したり、袖カバーをはめたまま戻ってきたりすることがよくあった。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "買ったものは品が弱く、すぐ破いてくるので、清子は姑の不用になった毛繻子の帯をもらって、二つも三つも丈夫な袖カバーをつくっておいたのだった。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "くたびれた背広をきちんと着、古ぼけたネクタイもきちんと結び、肱まで隠れる黒い袖カバーをつけている。",
              "citation": {
                "source": "超過勤務",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
