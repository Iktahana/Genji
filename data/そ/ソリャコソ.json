          "literary": [
            {
              "text": "氏郷及び氏郷の諸将は之を聞いて、ソリャコソ政宗めが陰謀は露顕したぞ、と思って眼の底に冷然たる笑を湛えて点頭き合ったに違いあるまい。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソリャコソと文三が、まず起直ッて突胸をついた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでソリャコソ喧嘩だとなると、二間なり三間なりバラバラと逃げてしまうのでございますな。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
