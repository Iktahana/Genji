        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると、勇吉は、炉ばたでちびちび酒を飲みながら、「そげえに若えもん叱るでねえよ、今に何でもはあ、ちゃんちゃんやるようになる、おきいはねんねだごんだ」「何がねんねだ！",
              "citation": {
                "source": "田舎風なヒューモレスク",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……けんど、俺どうしっぺえ、そげえに悪く集団農場については思えねえ……残っのあ俺のつみかよ。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は掛声をかけながら、だんだん肌脱ぎにさせたとき、いつの間にかそこにおって、様子を見ていた若い者がいきなり、「そげえなことーするでねえぞ。",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そげえじゃらくらした阿魔ッちょに何出来ッペ！",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こげえな極道者の行く先あ大方定ってら」「お前等今頃んなって、そげえなことほざくんか？",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ、そげえに怒んなよ、おっかあ！",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "厭んだあ、俺れそげえなこと、やんだあ、おめえ等も一緒に来よ！",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何いそげえに狼狽ててんだ？",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そげえなとこさえぐでねえぞ。",
              "citation": {
                "source": "禰宜様宮田",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺らほんにはあお使えいただいただけで、結構でござりやす……　何もそげえに……　そんに決して俺らの力ばっかじゃあござりましねえから……」　彼は下さる物は、自分のような貧乏人にとって不用ないはずはないことは知っている。",
              "citation": {
                "source": "禰宜様宮田",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ぼうはあ貧乏してても、もとあ歴として禰宜様の家柄でからに、人に後指一本差さっちゃことのねえとっさん捕めえてよくもよくも……　よくもよくもそげえな法体もねえことを吐かしてけつかる！",
              "citation": {
                "source": "禰宜様宮田",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "地体、どなたか様は、そげえな区切りい付けて、地面お作りなすっただべえか？",
              "citation": {
                "source": "禰宜様宮田",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そげえして下さりゃ、わたしも一所懸命やります」　大石鶴松は、やっと機嫌をなおした。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイチェの比喩を借りれば、音楽こそげにデオニソスである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、左の手は、ぶらんと落ちて、草摺の断れたような襤褸の袖の中に、肩から、ぐなりとそげている。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "容顔が美麗なで、気後れをするげな、この痴気おやじと、媼はニヤリ、「鼻をそげそげ、思切って。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の病院で、二月以上煩ったが、凍傷のために、足の指二本、鼻の尖が少々、とれた、そげた、欠けた、はて何といおう、もげたと言おう、もげた。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ背後の土間じゃ七十を越した祖母さんが、お櫃の底の、こそげ粒で、茶粥とは行きません、みぞれ雑炊を煮てござる。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と撮んで宙で下げたから、そそげた黒髪がさらさらと動きました。",
              "citation": {
                "source": "湯女の魂",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやりした景色のなかで、白いくるまやさんの足はいそげども、ゆくゆく車輪がさかさにまわり、しだいに梶棒が地面をはなれ出し、おまけにお客さまの腰がへんにふらふらとして、これではとてもあぶなさうなと、とんでもない時に春がまつしろの欠伸をする。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一鼻が思っていたよりもずっと高くいかにも憎々しいように突き出ていて、額がそげて顋がこけて、おまけに後頭部が飛び出していてなんとも言われない妙な顔であった、どこかロベスピールに似ているような気がした。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "とじり／＼と吸込んで吹殼のこそげ附いて拔けない奴、よこなぐりに、並木の松へトンと拂つて、花の霞の江戸の空、筑波を横に急ぐ。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八郎は、框の冷い板敷に、ひたりと膝をついたが、そのいわゆる……餅屋は餅屋か、どこに用意をしていた知らん、扇子を帯にさしながら出迎えたのを、きちんと前に置いて、酒の勢で脱いでいたから、着流しのそげ腰で、見すぼらしく、土間に乗出すばかり手をついて、お辞儀をしている。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……お久という人の、めんてんの足袋で帰るのを、立合わせた台所から、お悦が送り出すと、尖った銀杏返を、そそげさして、肩掛もなしに、冷い頸をうつむけて、雨上りの夜道を――凍るか……かたかたかたかたと帰って行く。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "花の中のそげものとや梨をばいふべき。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡れた地下足袋を脱ぎ、底の泥をこそげ落し、穴の明いた眞黒な軍手と一緒に、火箸や爐せんで支へをして火鉢の縁にならべ、ひどい臭氣をさせてゐるものもある。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の顔は海綿によってこそげ落ちた。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "この憂き旅の道づれには、フエデリゴこそげに願ひても無かるべき人物なりしなれ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "今しこそ、ゆめの歓楽降りそそげ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつしかに、暮るとしもなき※あかり、七月の夜の銀座となりぬれば静こころなく呼吸しつつ、柳のかげの銀緑の瓦斯の点りに汝もまた優になまめく、四輪車の馬の臭気のただよひに黄なる夕月もの甘き花※子の薫してふりもそそげば、病める児のこころもとなきハモニカも物語のなかに起りぬ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
