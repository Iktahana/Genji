[
  {
    "uuid": "8fbc11ed-9dc5-5030-89be-1d1768e56879",
    "entry": "村議",
    "reading": {
      "primary": "そんぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
