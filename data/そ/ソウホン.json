  {
    "uuid": "a17d5387-4786-5e0a-a54e-24e2db5384da",
    "entry": "宋本",
    "reading": {
      "primary": "そうほん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その目を挙ぐれば、煩悶異文弁、仏説阿弥陀経碑、春秋外伝国語｜跋、荘子注疏跋、儀礼跋、八分書孝経跋、橘録跋、冲虚至徳真経釈文跋、青帰書目蔵書目録跋、活字板｜左伝跋、宋本校正病源候論跋、元板再校｜千金方跋、書医心方後、知久吉正翁墓碣、駱駝考、、論語義疏跋、告蘭軒先生之霊の十八篇である。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩集に「癸酉早春、飜刻宋本国策、新帰架蔵、喜賦」として二絶が載せてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "経籍訪古志に「戦国策三十三巻、清刊覆宋本、漢高誘註、清嘉慶中黄丕烈依宋木重刊、末附考異」としてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是が文政九年に成つた「狩谷望之審定宋本」の「御注孝経」である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸友人諸門人と倶に北宋本太平御覧、我国伝ふる所の千金方、医心方等に就いて、その引く所の文を摘出し、自ら古本草経のルコンストリユクシヨンを試た。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "宋本御覧や、千金方や、医心方や、其中に存ずる所の古本草経の遺文は学者の共有に属する。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "又參考せる書中、太平御覽は未だ宋本を見るの機會を得ざれば我が倣宋活字本を主として、極めて希れに鮑刻本を參照したり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮑刻本は明板本を宋本にて校したる者によりたるが、四夷部倭國の條は、明板の粗惡殊に甚しく、鮑刻本は又之を汲古閣本の三國志にて校改したる跡ありて、校宋本として取るべき處殆ど之なく、我が活字本の影宋本を墨守せるに如かざるなり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの宋本は市野迷庵の舊藏にして、經籍訪古誌にも出でたる者なり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "對馬國、一大國、末盧國、伊都國、奴國、不彌國、　　對馬は宋本に對海に作れるは誤なり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "宋本三國志、宋本太平御覽、皆智に作れば宜しく之に從ふべし。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "梁書及び北史には並びに臺與に作り、宋本御覽には臺擧に作れり、證とすべし。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "注に魏略を引きて正歳四時とある時を宋本には序に作り。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "記春耕秋收とある記を宋本には計に作れり、從ふべし。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "重者滅其門戸及親族の滅を宋本は沒に親を宗に作れり亦從ふべし。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "に作れるが、隋書、通典は全く後漢書に據り、北史は桓靈間を靈帝光和中に作り、餘は後漢書に同じ、梁書は漢靈帝光和中に作ることは北史と同じく、歴年の下に無主二字なきことは三國志に同じ、宋本御覽は三國志を引きて住七八十年を靈帝光和中に作れり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "宋本御覽が三國志を引て靈帝光和中の句を殘せるは、當時の異本或はかく作りし者ありけん。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "又忠孝篇は老子一派の説を駁撃して、韓非子の持論と相合せず、人主篇は韓非子の諸篇を割裂補綴し、飭令篇は商子本は、其二篇を佚し、明の趙用覽に至り、更に宋本を得て、缺を補ひ誤を正して舊本に復したり。",
              "citation": {
                "source": "韓非子解題",
                "author": "小柳司気太",
                "note": "青空文庫"
              }
            }
          ]
        }
