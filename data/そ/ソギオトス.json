        "examples": {
          "standard": [
            {
              "text": "木材の表面をカンナでそぎ落とし、滑らかに仕上げる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の彫刻は、余分なものをそぎ落とし、本質を追求している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "必要のない情報をそぎ落として、簡潔な資料を作成した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そういう口上そのものが年を経るとともに一層固くなりつよく膠着するものであって、物識り顔からそういう謬見をこそぎおとすにはよっぽど鏝でごしごしやらなければならない。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
