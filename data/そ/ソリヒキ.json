          "literary": [
            {
              "text": "映画で見る樺太犬の橇引きとたいして違いはなかった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "橇引きの伝は、名前よりも狼といふ仇名の方が有名で、何年か前に村里の居酒屋で酌婦の奪ひ合ひから大立廻りを演じて、相手の炭焼の男を殴り殺した。",
              "citation": {
                "source": "山男と男装の美女",
                "author": "ミツキイのジヨンニイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ところがね、それを、橇引きのミスター伝に発見されたことを、さつき知つたのさ。",
              "citation": {
                "source": "山男と男装の美女",
                "author": "ミツキイのジヨンニイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "橇引きの連中は、胴切りの大木を荷にして、隊をつくつて、鈴を鳴しながら橇道を滑走して行つた。",
              "citation": {
                "source": "山を越えて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂の中から橇引きの降つて来る行列などが眺められた。",
              "citation": {
                "source": "山を越えて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
