        "examples": {
          "standard": [
            {
              "text": "神社の手水舎で、柄杓で水を汲んで清め、手を清め、口を注ぐ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭師は植物の根元にたっぷりと水を注ぐ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祭りの最中、人々は互いに酒を注ぎ合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
