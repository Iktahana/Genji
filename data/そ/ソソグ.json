    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "麥萩原朔太郎麥はさ青に延び行けり遠き畑の田作りの白き襦袢にえんえんと眞晝の光ふりそそぐ九月はじめの旅立ちに汽車の窓より眺むれば麥の青きに驚きて疲れし心が泣き出せり",
              "citation": {
                "source": "麥",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その凝固した空気の中から絞り出されるように油蝉の声が降りそそぐ。",
              "citation": {
                "source": "夕凪と夕風",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手も清め、口もそそぐ。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "加奈江は茶の間の隅に坐って前の坪庭の山茶花の樹に雨が降りそそぐのをすかし見ながら、むかしの仇討ちをした人々の後半生というものはどんなものだろうなぞと考えたりした。",
              "citation": {
                "source": "越年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（蓮月、偈を繰り返し乍ら香湯を盥の仏にそそぐ。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "外には程近い山王台の森から軒の板庇を静かにそそぐ雨の音も佗しい。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "つらつらつらつらと、動くのに濡色が薄油に、ほの白く艶を取って、降りそそぐ雨を露に散らして、細いしぶきを立てると、その飛ぶ露の光るような片輪にもう一つ宙にふうわりと仄あかりの輪を大きく提灯の形に巻いて、かつそのずぶ濡の色を一息に熟と撓めながら、風も添わずに寄って来る。",
              "citation": {
                "source": "遺稿",
                "author": "遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って女の口を洩るる点々の血も、彼処に手洗水に湧く水脈に響いて、緋葉をそそぐ滝であった。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉がまず水をそそいで、皆がつぎつぎとそそぐ。",
              "citation": {
                "source": "紅黄録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "下宿屋の状態から、諸商人のようす表通りの商店の風などにも、目がとまり、自分の周囲がすべて明るくなって、ようやく身外の事物に目をそそぐ余裕ができてきた。",
              "citation": {
                "source": "廃める",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "往來の人が彼女に瞳をそそぐ爲めに、つまづくのを見た。",
              "citation": {
                "source": "三十三の死",
                "author": "素木しづ子",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京の中央にこんな所があるかと思われるほど物さびしく静かで、街灯の光の届く所だけに白く光って斜めに雨のそそぐのがほのかに見えるばかりだった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず、無名の雪嶺を名づけた、Ｐ１峰を越えたのが始め、火箭のように、細片の降りそそぐ氷河口の危難。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえって、物語を綴り縫う謎の一つ一つに、一脈の冷視をそそぐことができると信ずるのである。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十一年十二月　　濃霧濃霧はそそぐ……腐れたる大理の石の生くさく吐息するかと蒸し暑く、はた、冷やかに官能の疲れし光――月はなほ夜の氛囲気の朧なる恐怖に懸る。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃霧はそそぐ……そこここに虫の神経鋭く、甘く、圧しつぶさるる嗟嘆して飛びもあへなく耽溺のくるひにぞ入る。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃霧はそそぐ……さながらに戦く窓は亜刺比亜の魔法の館の薄笑。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃霧はそそぐ……甘く、また、重く、くるしく、いづくにか凋れし花の息づまり、苑のあたりの泥濘に落ちし燕や、月の色｜半死の生に悩むごとただかき曇る。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃霧はそそぐ……いつしかに虫も盲ひつつ聾したる光のそこにうち痺れ、唖とぞなる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃霧はそそぐ……数の、見よ、人かげうごき、闌くる夜の恐怖か、痛きわななきにただかいさぐる手のさばき――霊の弾奏、盲目弾き、唖と聾者円ら眼に重なり覗く。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃霧はそそぐ……声もなき声の密語や。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "濃霧はそそぐ……香の腐蝕、肉の衰頽、――呼吸深く※謨や吸ひ入るる朧たる暑き夜の魔睡……重く、いみじく、音もなき盲唖の院の氛囲気に月はしたたる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる間も、底ふかく青の魚｜盲ひあぎとひ、口そそぐ夢の豹水の面に血音たてつつ、みな冷やき石の世と化りぞゆく、あな恐怖より。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はた、あかあかと蒸気鑵音なく叫び、そこここに咲きこぼれたる芹の花、あなや、しとどにおしなべて日ぞ照りそそぐ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "つとこそ一人、手を棚へ延すより早く、とくとくと、赤き硝子のいんき罎傾むけそそぐ一刹那、壺にあふるる火のゆらぎ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄昏のとりあつめたる薄明そのもろもろのせはしなきどよみのなかに、汝は絶えず来る夜のよき香料をふりそそぐ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "また古き日のかなしみをふりそそぐ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄ばみたる青葱色の眼の光来る夜の恐怖にそそぐ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "……くわつとふりそそぐ日光、冷たい風、春と夏との二声楽、……緑と金……四十三年五月　　五月新しい烏竜茶と日光、渋味もつた紅さ、湧きたつ吐息……さうして見よ、牛乳にまみれた喫茶店の猫を、その猫が悩ましい白い毛をすりつける女の膝の弾力。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "……雨はふる……やるせない春機発動期の憂欝病……神経の哀しい衰弱……黄色い胃病患者の腐つた気分にふりそそぐ雨。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
