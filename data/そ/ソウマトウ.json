[
  {
    "uuid": "0ae4cd37-38a2-5478-bfa5-8d1806e2fd99",
    "entry": "走馬灯",
    "reading": {
      "primary": "そうまとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
