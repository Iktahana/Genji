  {
    "uuid": "7beaa62c-4050-546c-8ff2-3e3727231980",
    "entry": "ソンナニ",
    "reading": {
      "primary": "そんなに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一日、一日、カク手ガ氾濫シテ来テ、何ヲ書イテモ、ドンナニ行儀ワルク書イテモ、ドンナニ甘ッタレテ書イテモ、ソレガ、ソンナニ悪イ文章デナシ、ヒトトオリ、マトマリ、ドウニカ小説、佳品、トシテノ体ヲ為シテイル様、コレハ危イ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナニ外ガ見タカッタラ、教場ノ外ヘ出テイナサイ」　窓の外へ立たされて、殊勝らしくじっとうつむいていた顔をひょいとあげると、先生は背中を向けて黒板に字を書いていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの眼もソンナニ光ッタラ面白イケレド。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ西洋デハ、大工ノ子ノ生レタ年ヲ、年号ノ初メニスルノカ」「左様でございます」「基督トイウ人ハ、ソンナニ豪イ大工デアッタノカ」「大工さんの子としてお生れになりましたけれども、基督様は救世主でございました、神様の一人子でございました」「神様ノ一人子トハ？",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間ノナカデモ、ソンナニ、利口ナ子供ハ、アマリイマセンヨ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナニ高イ所ニイラツシヤラナイデ、コノ涼シイ草ノ葉ノカゲヘイラツシヤイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………浄吉ハ今デハ颯子ヲソンナニ愛シテハイナイヨウニ見エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ本来ソンナニ悪イ性質デハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハソンナニ子供ガ好キジャゴザイマセンノ」トカ、「死ノ灰ガ降ルッテ云ウノニ沢山生ンダッテ仕様ガナイジャアリマセンカ」トカ云ッタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニワタクシドモガ嫌イナラ、イッソ別居サセテ戴キマショウヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナ黒人ノ俳優バカリ使ッテアルノ」「ソレガソンナニイヽノカネ」「ブレノ・メロッテノハサッカーノ選手上リデ、素人ナンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ恐々拭カナイデ、モット手ニカヲ入レテシッカリト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽワヨ、ソンナニ慌テナイデモ、度胸ヲ据エテ悠々トオ帰ンナサイヨ」ト、颯子ノ声ガ聞エル気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪ノ形ガソンナニ委シク見エタノニ顔ハドウモハッキリ見エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥サンノ見タトコロデハキャッツ・アイト云ッタッテアンナ大キナ立派ナ石ハ、ソンナニザラニアルモンジャナイ、恐ラク十五カラット以上アルコトハ確カダト云ウンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「プールッテソンナニ早ク作レルンデショウカ、モウ秋ジャアリマセンカ」ト、陸子ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ詰メテ書キ物ヲナサラナイ方ガヨクハゴザイマセンカ、又痛ミ出スト心配デゴザイマス」予ガ日記ヲツケテイルノヲ見テ佐々木ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アンマリ大事ヲ取リ過ギルンダワ、アノクライ血ガ出タッテ、何モソンナニ恐ガラナイデヤッテ下サル訳ニ行カナイノカシラ」ト、佐々木ガヒソ／＼声デ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食事ノ後ダカラ一本グライイヽデショ佐々木サン、コヽナラソンナニ籠リャシナイワ」颯子ハハンドバッグカラ愛用ノクールヲ一本取リ出シテ吸ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモソンナニ古イ形ノモノデナクテモイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレナラソンナニムズカシクハナサソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハソンナニ強クハナイ。",
