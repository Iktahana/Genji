[
  {
    "uuid": "cf3d6938-37ba-5455-99f4-1e6cc7d04f72",
    "entry": "そんなに",
    "reading": {
      "primary": "そんなに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
