          "literary": [
            {
              "text": "トルコのソリマン二世一日睾丸抜いた牡馬が戯るるを睹、宦者も丸を去ったばかりでは不安心とて、その根部を切り尽さしめ後帝世々その制を沿襲した。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーノー仏訳、九世紀のアラビア人、ソリマンの『支那記』四一頁にいわく、支那には市ごとに知事の頭の上に鐘を釣るしてダラー（銅鑼？",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルヴ大佐はソリマン総督になるためにエジプトに赴いた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は８万人の隊員を集めてハンガリーのサルタンであるソリマンに向かった。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
