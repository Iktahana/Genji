        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スラヴ人は元来空想に耽る国民性だから、無教育者の中にも意外な推理力や想像力を蓄えて人生をフィロソファイズするものがある。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔第一巻　甦る〕〔第一章　時代〕イギリスの玉座には…………　　当時のイギリスの国王はジョージ三世（一七三八―一八二〇）、王妃はシャーロット・ソファイア（一七四四―一八一七）であった。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ソファイ殿といふ歌もある。",
              "citation": {
                "source": "伊豆大島の話",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソファイドノの方は殊に支離滅裂の文辭で或は氣まぐれに色々の唄を、繋ぎ合せたかとも思はれる上、歌の題からして何を意味するかを知らぬのである。",
              "citation": {
                "source": "伊豆大島の話",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
