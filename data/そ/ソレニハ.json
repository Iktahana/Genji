        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ソレニハオヨバヌ」という返電が、ようやく十日ほど経って来て、復一はやっと安心した。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困ッタナ、僕ハトウニ食ベチャッタンデ、梅肉ヲ下ゲテ行ッチャッタンダ」「梅肉ダッテコヽニアルワ」ト、颯子ハ鱧ト一緒ニ自分ノ梅肉ヲ廻シテヨコシナガラ、「梅肉ダケ別ニ取リマショウカ」「ソレニハ及バナイ、コレデ結構」颯子ハタッタ二片ダケシカ食ベナイノニ、梅肉ガワリニ穢ラシク喰イ荒サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ辻堂ノ中デ五六丁離レタ所ニオ誂エ向キノ家屋ガ一軒売リ物ニ出タノデ、何トカシテソレヲ買イタイノダガ、ソレニハ金ガ二三百萬足リナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マサカソレニハ及バンサ」「イヽワヨ、飲マセタゲルワヨ」彼女ガ薬ヲ取リニ出テ行ッタ間ニ、予ハ又一ツノ楽シミヲ考エツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今浴ビテルトコロナノ、チョウドオ晝寝ノ時分ダト思ッテ覗イテ見タノ」「今日ハ日曜ダッタッケナ、浄吉ハイナイノカ」ソレニハ答エナイデ別ナコトヲ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソレヲ取リ壊シテ近代建築ニ作リ直し、ソコニ今度ハワレ／＼ノ隠居所ヲ作リタイ考デアルガ、ソレニハ今日マデ婆サンガ反対シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ行ッテ来タノカ」ソレニハ答エズ、黙ッテ掌ノ上ニ一箇ノ石ヲ載セテ見セル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ直スニハギプスベッドカ牽引法デ神経ノ壓迫ヲ取リ除クヨリ外ハナインデスガ、ソレニハ三四カ月ノ御辛抱ガ必要ナンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カヨイ治療法ハナイモノデショウカ、御老人デイラッシャルノデ、牽引法ソノ他手数ノカヽル面倒ナ方法ハオイヤナンデスガ、ト云ッタトコロ、ソレニハ方法ガナイコトハナイト、博士ガ云ワレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前ガツイテ行クカラ悪イ、二人キリデ出シテミナサイ」ト云ウノダガ、妻ハソレニハ不賛成デ、母親トシテ監督スル責任ガアルト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシソレニハ一切、加勢無用」と。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
