  {
    "uuid": "0049b6de-6c65-51e2-ab97-37bf42f755aa",
    "entry": "桑中",
    "reading": {
      "primary": "そうちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
