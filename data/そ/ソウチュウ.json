[
  {
    "uuid": "f2b97f31-59b0-5064-9610-773d713dc224",
    "entry": "叢中",
    "reading": {
      "primary": "そうちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
