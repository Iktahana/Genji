        "examples": {
          "standard": [
            {
              "text": "クレメンティのソナチネは、ピアノ入門者が最初に弾く曲のひとつだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "発表会でソナチネを暗譜で弾き、緊張しながらも最後まで弾ききった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "先生からソナチネの練習を勧められ、毎日三十分欠かさず取り組んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ちっちゃい御弟子さんが、ソナチネなどひいている間、私は昔を思い出しました。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱりソナチネをやったのですもの。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子はやがてソナチネからソナタを弾くようになった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
