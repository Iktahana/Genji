        "examples": {
          "standard": [
            {
              "text": "彼は空合いを読むのが上手で、いつも有利な状況を作り出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試合の空合いが変わったのは、彼の投入後だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "場の空合いを察して、彼は何も言わずに席を立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
