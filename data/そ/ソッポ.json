[
  {
    "uuid": "4c5c61bb-73e4-5613-8d4c-c3fe9faa55f5",
    "entry": "外方",
    "reading": {
      "primary": "そっぽ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
