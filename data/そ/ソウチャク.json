        "examples": {
          "standard": [
            {
              "text": "新しいレンズの装着は非常に簡単でした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この銃にはサイレンサーが装着されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はスマートフォンに保護ケースを装着した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "胡同様、無慙にも顔面の皮膚を剥ぎそられ何処の者とも判明せざれど年齢二十三四歳位にて、サムライの仮装着を着けたるところより多分前夜何処かの仮装舞踏会に出席したる日本人にあらざるかと推測さる。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "とはや晴れの衣装着て馬車に乗らんとする前に父の書斎に呼ばれてねんごろに言い聞かされしを忘れしにはあらねど、さて来て見れば、家風の相違も大抵の事にはあらざりけり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――」「お母さん」　おせんは、部屋の隅に立てかけてある人形の傍へ、自分から歩み寄ると、いきなり帯に手をかけて、まるで芝居の衣装着けがするように、如何にも無造作に衣装を脱がせ始めた。",
              "citation": {
                "source": "おせん",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
