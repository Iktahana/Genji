        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アルバート〔骨董品、古本屋の多い広場と街路の名〕のソブキノ〔ソビエト映画社〕を見た。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男、ソブキノの工場と、Мать〔「母」〕、ポチョムキン、新しき Мой　Сынというのを見せて貰れることになった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソブキノには十時半前についたが、例の人まだ来て居ず。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニングラードのソブキノの我息子で主人公をピカ一にさせた傾向ここにも現れて居るのではないか。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十一日　金　ソブキノへ行って（袋さんと）ロームのバルビュスのものをとったのを見た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのソブキノのズブコボイ〔音声〕のように Но　Живёт〔しかし、生きている〕とパッ、パッ、一コマずつぶつける出しかた或は非常によい。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二十五日　第一ГОТОБ〔第一国立歌劇舞踏劇場〕〔入場券、配役表貼付〕「ボリス・ゴドノフ」三月二十六日　第一ソブキノ〔入場券貼付〕　今日ロシヤのトーキー＝ズブコヴィ・フィルム、又はトン＝フィルムなるものを見る。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソブキノの Hall はいつにない緊張ぶりだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソブキノの撮影隊はカメラをもって、「トルクシブ鉄道」布設工事の現場へ、ヴォルガ地方の集団農場へ、バクーの油田へ、出かけて行く。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
