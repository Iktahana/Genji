  {
    "uuid": "4b2942c2-6d2c-54d9-9957-9aa25465f2eb",
    "entry": "ソウイウ",
    "reading": {
      "primary": "そういう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソウイウ種類ノ人間ハ、案外身辺ニ少ナクナイノデアル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ニソウイウ自覚ヲ与エルヲ禁ジ得ナイノデハナカロウカ）僕ハ彼女ノアノ長所ヲ考エタダケデモ嫉妬ヲ感ズル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハソウイウ「不自然ナ遊戯」ニ耽ルヲ説明シテモ、彼女ハココデモ「女ラシイ身嗜ミ」ヲ固守シテソレニ反スル行為ヲ嫌ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノクライマデ行クハデキソウモナイケレドモ、ソウイウ風ニシテ努メテ僕ヲ刺戟シテクレル※ハ、彼女自身ノ幸福ノタメデモアルト思ッテ貰イタイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ワレテ僕ハ直チニ一ツノ着想ヲ思イツイタガ、シカシ、僕ニソウイウ機械ノアルヲ、ドウシテ木村ハ察シタノデアロウカ、ソレガ不思議ダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイウ彼ニ委嘱スルニナリハシナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ間、先週ノ月曜日ノ朝、木村ガ登校ノ途中ダトイッテ立チ寄ッタ日ノ朝デアッタ、僕ハ木村ガ来タノデベッドカラ起キ上ッテ茶ノ間ヘ行コウトシタノデアッタガ、ソノ時奇怪ナハ時々アッタガ、ソウイウモノトハ明ラカニ違ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ佛蘭西人ノ名前ハ思イ出セナイケレドモ、ソウイウ佛蘭西人ガイルハ分ッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ敏子ガドウイウ底意デソウイウ、彼女ガ故意ニ二人ヲ置キ去リニシテ、二十分以上モ途中デ時間ヲ費シテ（二十分ヤ三十分デハナイノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイッテ、僕ハ全然ソウイウヲ考エナイヨウニシテイタノニ、イキナリハッキリト聞カサレタノデギクリトシタ、トイウノガ偽ラザル気持カモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………従来僕ガ妻ノ貞節ヲ信ジテ疑ワナカッタ一ツノ理由ハ、彼女ガドンナ場合ニモ僕トノ情交ヲ拒マナイガ明ラカデアル時ニモ、ソノ夜夫カラ挑マレテ怯ム色ヲ見セタガアッテ夜ニ及ンデマタアッタトシテモ、―――ソウイウ日ガ数日続イタトシテモ平気ナ体質ナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕ニソウイウ機械ノアルヲ、ドウシテ木村ハ察シタノデアロウカ、ソレガ不思議ダ」と云っているが、それは私にも不思議であった。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、木村は何のために「ソウイウ機械」のあることを夫に教えたり、私の裸体を撮影することを示唆したりしたのであろうか。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイウテ、帰リマシタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
