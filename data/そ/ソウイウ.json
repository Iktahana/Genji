[
  {
    "uuid": "bc681787-83b5-5009-847a-72090a2f2587",
    "entry": "そう言う",
    "reading": {
      "primary": "そういう",
      "alternatives": [
        "そうゆう",
        "そーゆー",
        "そーいう"
      ],
      "is_heteronym": false
    },
    "grammar": {
