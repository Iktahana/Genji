        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夜明け前、空には薄い層雲が広がり、幻想的な景色を作り出していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "山の斜面をゆっくりと流れる層雲が、まるで生き物のように形を変える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今日は一日中、低い層雲が空を覆い、肌寒い日になりそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "窒素工場の火の映えは、　　　層雲列を赤く焦き、鈍き砂丘のかなたには、　　　海わりわりとうち顫ふ、さもあらばあれ啜りても、　　なほ啜り得ん黄銅の月のあかりのそのゆゑに、　　こたびは牛は角をもて、柵を叩きてたはむるゝ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（「層雲」大正三年九月号）",
              "citation": {
                "source": "砕けた瓦",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏へは層雲を通して親しみを持っていたが、こうしてまとめられた文と句とをしみじみ読み味わって、氏の純情と敬虔とにうたれた。",
              "citation": {
                "source": "三八九雑記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の前には一筋の白い路がある、果てしなく続く一筋の白い路が、……（大正五年十一月廿七日の生活記録より）（「層雲」大正六年一月号）",
              "citation": {
                "source": "白い路",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（「層雲」昭和十年十月号）",
              "citation": {
                "source": "鉄鉢と魚籃と",
                "author": "――其中日記から――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる傾向は層雲を中心とする人々ばかりの間に起ったのではかい。",
              "citation": {
                "source": "俳句に於ける象徴的表現",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――木の芽草の芽歩きつづけるはてもない旅のつくつくぼうしけふはけふの道のたんぽぽさいた　　　　　□どうしようもないワタシが歩いてをる（「春菜」層雲二百五十号記念集　昭和七年五月刊）",
              "citation": {
                "source": "歩々到着",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "飲みすごしても、層雲を借覧して、句稿整理することは忘れなかつた、句は酒と共に私の生命の糧である。",
              "citation": {
                "source": "行乞記",
                "author": "広島・尾道",
                "note": "青空文庫"
              }
            },
            {
              "text": "発動機も機体もまだシッカリしているんだが、みんな乗るのを厭がるもんだから、天井裏にくっ付けておいたんだ……止せ止せ……」　そう云って忠告した司令官の言葉も、心配そうに見送った同僚の顔も、みるみるうちに旧世紀の出来事のように層雲の下に消え失せて行った。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが……ソンナような反感も、ヒイヤリと流れかかる層雲の一角を突破して行くうちに、あとかたもなく消え失せて行った。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……層雲が無ければここいらで一つ、高等飛行をやって驚かしてくれるんだがナア……。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……なぞと思い続けながら、軽い上げ舵を取って行くうちに、私はフト、私の脚下二三百米突の処に在る層雲の上を、１１機の投影が高くなり、低くなりつつ相並んで辷って行くのを発見した。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……黄色く光る層雲の海……。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬も早や絹のつや雲、巻雲の巻きのなびきに、氷凝り雲｜層雲の群、重ね雲、寂び金の雲、下｜明り雲ともわかず、薄ぎらひ山ともわかず、たださへも現ならぬを、たださへも果てしわかぬを、日の射すか末広の虹、幾すぢか透きて落せり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬も早や絹のつや雲、巻雲の巻きのなびきに、氷凝り雲｜層雲の群、重ね雲、寂び金の雲、下｜明り雲ともわかず、薄ぎらひ山ともわかず、たださへも現ならぬを、たださへも果てしわかぬを、日の射すか末広の虹幾すぢか透きて落せり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "空は、一面にどんよりとした層雲で包まれているのに、街の裾から、カッと落日の光がさし込んで、暗い通りに、建物の倒影が、クッキリ落ち、行きずりの人の顔など、眩しいほど、鮮に見える。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "地平線に近き邊には、層雲｜堆を成して、稻妻の其間より閃發せるさま、幾箇の火山の噴坑を開けるに似たり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "真勲別に至りて、山の根に取りつき、層雲別に至りて、いよいよ層雲峡に入る。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "大雪山の腰を貫く処、即ち層雲峡也。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "層雲峡はいまだ世に知られざるが、天下の絶勝也。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "層雲峡に至りては、澄みて底石数うべし。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "五里の層雲峡中、人家あるは、加藤温泉と塩谷温泉との二軒のみ也。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "明くれば一行の外、温泉の若主人塩谷忠氏、画家吉積長春氏加わりて、層雲峡を溯る。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日層雲峡に入りて、鬼神の楼閣かと思いしも、今日より見れば、まだほんの鬼神の門戸なりし也。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "世に材木巌の奇少なしとせざれども、天上に楼閣を造り、谷底に幽室を造ることは、層雲峡の外には求むべからず。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩谷温泉は五里の層雲峡の中央にあり。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "層雲峡を窮めたる者にして、始めて巌峰の奇を説くべき也。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　大雪山の第一夜　層雲峡は石狩川の有する一大偉観なるが、その鬼神の楼閣と思わるる巌峰は、大雪山の腰なれば、大雪山の有する一大偉観なりといいても可也。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "層雲峡の楼閣脚底に落ちて、留辺志部平原も見ゆ。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
