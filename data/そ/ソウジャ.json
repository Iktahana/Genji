[
  {
    "uuid": "acab519e-6c7a-5463-8ee5-08e9ae03345f",
    "entry": "惣社",
    "reading": {
      "primary": "そうじゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
