        "examples": {
          "standard": [
            {
              "text": "彼は会議中にこっそり空眠りをしていたが、すぐにバレてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "弟は怒られたくなくて布団の中で空眠りを装っていたが、笑いをこらえきれずにすぐばれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "サンタクロースを信じていた頃、子どもたちは枕元にプレゼントが置かれることを期待して空眠りをしながら朝を待った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "最初眠った時には、私があまり熱中しているのを気の毒がって空眠りしたのではないかと、この子の足の裏へ大きな灸をすえてみたが、それは本当だったので可哀想でした」とはブラックの述懐。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
