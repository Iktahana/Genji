        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "計画が当初の目的から削げ、全く別の方向へ進んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "話し合いの論点が削げ、個人的な感情論になってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の発言は、本筋から削げたものばかりだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
