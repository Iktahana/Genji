[
  {
    "uuid": "0667f4b2-16e0-5dc3-a116-00cc827e564b",
    "entry": "訴追",
    "reading": {
      "primary": "そつい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
