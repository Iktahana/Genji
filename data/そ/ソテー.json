        "examples": {
          "standard": [
            {
              "text": "フライパンで玉ねぎをソテーして甘みを引き出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鶏肉をきのこ類と一緒にソテーすると、風味豊かな一品になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "シェフは手際よく魚をソテーし、皿に盛り付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ポークソテーが店の自慢になつてゐたが、ほかの料理もみな美味く、ことに野菜は全部｜酢漬けで、セロリーはいつもただで食べさせてくれ、なほ、毎月新譜のレコードを購入して聴かせてゐた。",
              "citation": {
                "source": "木の都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラメは嫌いではないが、ヒラメのソテーとはどういうものか、わからなかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "親愛なるシャーク殿はソテーになっていて、グリルしたカイザー・ロールの上に乗っている。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "トマトポタアジュ、ラビオリ・ニコアス、松茸ソテーベーコン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スクラムルエッグ・ウィズ・ハムとチキンソティー・ライスにシユガーコーン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ミネストロン、チキンソティー、アイスクリーム。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "生椎茸をソティーして食べる、納豆も東京より来り美味き朝食。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱海の椎茸をソティーして食べる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタージュ・アスパラガス、チキン・ソティーにコーン・フリッター、それに野菜のカレーライス、うまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時半起き、宿の払ひをすませ、女房と、アラスカ迄歩いて、食事、冷房なし、いや暑いの何の、これじゃ料理はうまくてもダメ、ポタアジュにチキン・ソティーと野菜カレー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
