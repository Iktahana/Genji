        "examples": {
          "standard": [
            {
              "text": "食品に含まれるソディウムの過剰摂取は、高血圧の原因となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "実験では、水とソディウムの反応を観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "体内のソディウムとカリウムのバランスは、健康維持に重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は、金属ソジウムが水に会うと劇しく爆発する性質のあるのを利用しようと思った。",
              "citation": {
                "source": "仲々死なぬ彼奴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その金属ソジウムは中々高価な薬品なので、多量は手に入らないのが普通であるが、幸にも研究所へは先頃三十キログラムほど納入され唯今彼の許で試験をすることになっているから、これを持ち出して使えばよい。",
              "citation": {
                "source": "仲々死なぬ彼奴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその金属ソジウムを一度に爆発させるため、別に溜めて置いた水を一時にザブリと懸けようと思った。",
              "citation": {
                "source": "仲々死なぬ彼奴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう金屬ソジウムが水分を引いて発熱し、竹筒の青い色がすこし変ってきては居ないかと思ったのであるが、別にまだ異状は認められなかった。",
              "citation": {
                "source": "仲々死なぬ彼奴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
