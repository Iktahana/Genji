        "examples": {
          "standard": [
            {
              "text": "彼は熟練した測量家（そくりょうか）として、多くのプロジェクトに携わってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "測量家（そくりょうか）は、正確な地図を作成するために欠かせない存在だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "測量家（そくりょうか）の資格を取得するために、専門学校で学んでいます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "よしよし、楼閣の割れ目の沢を登らば、登られぬことなしと見当を付け、昨日の一行に、榊原与七郎氏という測量家と人夫とが加わりてまさに発せんとせしに、水姓吉蔵氏｜※然として来る。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
