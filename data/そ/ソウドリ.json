        "examples": {
          "standard": [
            {
              "text": "この大会では、決勝戦の勝者が全ての賞金を総取りする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "オークションでは競り勝った者が出品物を総取りする仕組みになっており、二位以下には何も渡らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "今期の販売コンテストは首位が賞金を総取りするルールだったため、営業部全員が必死で顧客を回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「多勢が総取りする」　とホークスが応じたのは、いかにもこの地らしい。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父を出し抜き、手柄を総取りして、叔父は無一文のままだろう。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
