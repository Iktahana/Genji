  {
    "uuid": "4855b08e-f571-5702-91b5-6cfaf21301ff",
    "entry": "ソレガ",
    "reading": {
      "primary": "それが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ト屋根ヤブレルホドノ大｜喝采、ソレモ一瞬ノチニハ跡ナク消エル喝采、ソレガ、ホシクテ、ホシクテ、一万円、二万円、モットタクサン投資シタ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日、一日、カク手ガ氾濫シテ来テ、何ヲ書イテモ、ドンナニ行儀ワルク書イテモ、ドンナニ甘ッタレテ書イテモ、ソレガ、ソンナニ悪イ文章デナシ、ヒトトオリ、マトマリ、ドウニカ小説、佳品、トシテノ体ヲ為シテイル様、コレハ危イ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ　ヤマ　ノ　オヒサマ　ニ　カガヤイテ、チョウド　クンショウ　ノ　ヨウニ　ミエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガシハ非人ナリ、過去、迦葉仏ノ時ニ於テ、カツテコノ山ニ住ス。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガシ答エテイウ。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人、言下ニオイテ大悟シ、作礼シテイウ、ソレガシ已ニ野狐ノ身ヲ脱ス。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者様――アノ鯉幟ノ棹ハ、私ガ酔ッタ勢イデ立テタモノデスガ、ソレガ記者様ノオ眼ニ止マッテ、コンナ不孝ナ恥ヲ晒ソウトハ夢ニモ思イマセンデシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「紳士は、ソレガシといふ、レデイは、ワラハとかワチキとか云ふが、それがまた階級に依つて様々に異るのだし……」「それを覚えるには、あたしは完全に別の国を訪れなければならないね。",
              "citation": {
                "source": "舞踏会余話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ父ッチャハ、工場デヤスリヲトイデイルウチニ、グルグルマワッテ居ルト石ガカケテトンデキテ、ソレガムネニアタッテ、タオレテ家ヘハコバレテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この猿松め馬鹿野郎めと独り心の中で罵り、ソレカラ山本の家にも事実は云われぬ、若し是れが顕われて奥平の不面目にもなれば、禍は却て私の身に降て来て如何な目に逢うか知れない、ソレガ怖いから唯母の病気とばかり云て暇乞をしました。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯旅館中の廊下の道に迷わぬように、当分はソレガ心配でした。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ果シテソレガ雑音ナドトイワレルニ十分ナ屑電波ダトスルコトハ早計ニ過ギルト思ワレル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガコマルナラ、コンヤ十一ジニ、クロカワダンチョウト、ハナガタフサエト、マルノウチ、ネオン・ビルノマエニキナサイ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "石黒氏ノ近業ハソノ名ノ示スガ如ク往昔郷閭ノ私塾ナリシ有隣舎ノ沿革ヲ調査シソレガ師弟ノ伝ヲ述ベタルモノニシテコレスナハチ拙稿『下谷叢話』ノ記述スル所トホボソノ事ヲ同ジクスルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ悲シイ悲シイデス。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "――家ガ仲ノ町デ、引手茶屋ヲシテイマシタカラ……　――ソレガ、ドウシテ、後ニ、赤坂ダノ、葭町ダノヽ住人ニナリマシタカ？",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘弥ノ助六デハ物足リナイガ、訥升ガ揚巻ヲスルト云ウノデ、ソレガドンナニ美シイカト思イ、助六ヨリモ揚巻ノ方ニ惹カレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ヲ云ウト予モ彼女ノ食イ残シガ廻ッテ来ルコトヲ豫期シテ―――或ハソレガ今夜ノ目的デ―――コヽヘ来タノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時ハ非常ナ恐怖感ヲ伴ッタガ、今デハソレガ幾分楽シクサエアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガトウダンスノ胼胝ノオ蔭デスッカリ穢クナッチャッタンデ、トウヲ止メテカラ一生懸命モトノヨウニシヨウト思ッテ、毎日々々軽石ダノ鑢ダノイロンナモノデ擦ッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ心理状態ニナッタノハ最近デアルガ、ソレガマス／＼極端ニナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナ黒人ノ俳優バカリ使ッテアルノ」「ソレガソンナニイヽノカネ」「ブレノ・メロッテノハサッカーノ選手上リデ、素人ナンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ又愉快ナノヨ」予ハコノ話ノ途中カラ左手ガヒドク痛ムヨウニ感ジ始メタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガタシナミナノカ、気味ガ悪イセイナノカ、ドッチダカ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ却テ予ヲ喜バス所以デアルコトヲ心得テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンニハソレガ相当ヨ」「セメテコウシテル間、シャワーヲ止メテ貰エナイカナ」「止メル訳ニ行カナイ、触ラレタ傍カラ直グト綺麗ニ流シチャワナイト気味ガ悪イ」予ハタヾ水ヲ呑マサレタ気ガシタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ自分ノ喉ガ鳴ッテイルノダトハ思エナイデ、自分ノ体以外ノトコロカラ鳴ッテ来ルヨウニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ成立シタバカリデナク、母ノ忰デアル予ガ孫ノ嫁ノ魅力ニ溺レ、彼女ニペッティングヲ許シテ貰イ、ソノ代償ニ三百萬圓ヲ投ジテ猫眼石ヲ買ッテヤルナンテ事件ガアッタラ、母ハ驚イテ気絶スルダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ、婆サント連レ立ッテ這入ッテ来タノハ何カ仔細ガアルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
