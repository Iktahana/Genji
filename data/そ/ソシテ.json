  {
    "uuid": "60397891-1d6e-5524-a150-78d36199685c",
    "entry": "ソシテ",
    "reading": {
      "primary": "そして",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シカシヨク泳ギ、ソシテヨク遊ビマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、タカ　ニ、ドウカ　アソコヘ　ツレテ　イッテクレ　ト、タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヒバリハ　スガタガ　ミエナク　ナルホド　タカク　ノボツタ　トキ　ウツクシイ　コヱデ　ウタヒハジメマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　シツカリト　カナヅチヲ　ニギリシメテ、コウババカリノ　マチヘ　マツスグ　アルイテ　ユキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、アメガ　フツタ　アトナドニ　ポコポコト　ツチカラ　アタマヲ　ダスノデ　アリマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ドンドン　ハナレテ　イキマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　スタスタト　モリノ　ハウヘ　イツテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ　フトコロニ　コヒツジヲ　イレテ、「シカタガ　ナイカラ、コノ　コヒツジハ　オレガ　ソダテテ　ヤラウ」ト　ヒトリゴトヲ　イヒナガラ　ヤツテ　ユクウチ　トツプリ　ヒガ　クレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヨルニ　ナツテカラ　ネシヅマツタ　ヒトツノ　ムラニ　ツキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　イヒマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、オマエタチノ　オトウサンヤ　オカアサンタチハ　ヨク　コノ　バシヤノ　ゴオンヲ　ウケタノサ」　ソシテ　ソンチヨウサンハ　イヒツヅケマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「アア　キコエル　キコエル、ナツカシイ　ムスコノ　コヱガ　キコエル。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、ソノ　トキ、ジブンノ　アタマニハ　カンザシハ　サセナイ　コトガ　ハジメテ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ、ホカノ　ヒトニハ　トウトイ　モノデ　アツテモ、ジブンニハ　チツトモ　トウトクナイ　コトモ　アルノダ、ト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「エエ、ケツシテ　シマセン」ト　コタヘマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヤツパリ　イタチハ　ヨブンヂヤ　ナカツタト　オモヒマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ハンノキノ　シタニ　コロガツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　フタリハ　イツテ　シマヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　トクイサウニ、「アレハ　ワタシノ　カゲダ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イイエ、ワタシハ　ツイテ　イキマス」　ソシテ、テフテフハ　ヒラヒラト　アカイ　フウセンダマニ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ソノ　アトカラ　シロイ　テフテフハ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、ソノママ足ヲフミハズシテ、ヒドイ音ヲタテナガラ、マヨナカノ高イカイダンヲコロゲオチテシマッタ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、急ニワットナキ出シテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
