          "literary": [
            {
              "text": "ボーデュアンの旅団はウーゴモンを北方より強取せんとして成らず、ソアイの旅団はその南方をわずか突入し得たのみで、それを抜くことはできなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてソアイの旅団はそこで粉砕された。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソアイの旅団が粉砕された意外の城壁。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
