        "examples": {
          "standard": [
            {
              "text": "不況もようやく底を打ち、景気は回復傾向にある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "人生のどん底だと思ったが、ようやく底を打ったようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長らく続いた物価高も、そろそろ底を打つだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ぴしや／＼と落ちる涓滴が暫く彼の耳の底を打つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッダッダッと地の底を打つような音――ゴゴゴゴゴという騒音――それがだんだんに近づいてくる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
