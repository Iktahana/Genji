    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユヒソメテ馴レシタブサノ濃紫オモハズ今ニアサカリキトハ、といふお歌など、これがあの天才将軍のお歌かと蓮胤はいぶかしく存じました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく入院しなければならぬ、あとは自分たちにまかせなさい、とヒラメも、しんみりした口調で、（それは慈悲深いとでも形容したいほど、もの静かな口調でした）自分にすすめ、自分は意志も判断も何も無い者の如く、ただメソメソ泣きながら唯々諾々と二人の言いつけに従うのでした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「帰れよ、なッ」　と言うと、今度は勝坊メソメソ泣き出した。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三はやがて食事を部屋へ持ちこませて、フォクを執ったが、葉子はコンソメの幾匙かを啜って、オレンジを食べていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お庄はメソメソしながら、母親の側へ寄って行った。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "厨房一同入寮晩餐会メニューチキンコンソメ　　アスパラガスのサラダマッシュポテト　　ヒラメのソテコールドミート　　パンデザートはバニラアイスクリーム　慶一は、「厨房」という字を、とりあえず「とうぼう」と読み、コックかなんかの意味だろうと考えた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "『でも奥様、プーリはほんとうに困ります、お台所の戸をあけましても、ただの一度だつて閉めたことは御座いませんの、そのおかげで空巣にわたしの下駄を盗まれました』　女中は俄然、勇弁になつてゆくのであつた、でも彼女の眼頭がしだいに熱くなるのであつた、彼女が顔をあげたとき、彼女はメソメソと泣いてゐた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに付き添っていたお作が濡れ手拭で、汗と、血と、泥と、吹っかけられた水に汚れた顔を拭いて遣りながら、メソメソと嬉泣きをし始めたが、それでも福太郎はまだキョトンとした瞳をラムプの光りに据えていたので、背後の方に居た誰かが腹を抱えて笑い出しながら、「まあだ解らんけえ。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳市はメソメソ泣きながらも何もかも白状した。",
              "citation": {
                "source": "黒白ストーリー",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしゃ嬉しくって嬉しくって、胸がモウ一パイ……」　と云ううちに吾輩の胸へ縋り付きメソメソ泣き出した。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "万公は上り框に両手を突いたままメソメソ泣出していた。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その矢先に突然にレントゲン室から帰って来た弟が、私の枕元に突立ったままメソメソ泣出したのだから、面喰わざるを得ない。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "メソメソと泣出した少年も居た。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありがたい事じゃ」　と云ってメソメソ泣き出した。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今更の事のようにメソメソ泣きながら出迎えた一知夫婦と一緒に、一言も口を利かないまま、井戸端の混凝土の上に並んで突立って、検事や、予審判事や、警官連の行動をオドオドと見守ってばかりいた。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、その独言で、勝手にテレて――さうしてまた彼はそのテレた気持を回復しようと努める為に、稍暫く絵葉書屋の前に立つて、ヨソメには如何にも熱心な絵葉書の愛好者であるが如く見ゆる程、凝と絵葉書を眺めた。",
              "citation": {
                "source": "失題",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親のことを考えて、メソメソしてもならないそうだ――人はそう云う。",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤枝と私はほんとうにくつろいだ気もちでコンソメのスプーンを取つた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでここに偶然が非常な働きを見せている」　藤枝は手早くコンソメを片付けて次に出て来た伊勢海老をほほばりながらつづけた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "相当｜奇抜な娘だナ、こいつは」　取りつく島がなくなって、両手を眼に、メソメソ泣き出したお美夜ちゃんだった。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の男をとった女と向きあってメソメソ泣くやつもないもんだ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの面さげてメソメソと帰りおった――ウヌッ」　というわけで、おさよには碌にものも言わせず、いきなり責め折檻にかかったから、五十六歳になるおさよ婆さん、苦しさのあまりあたりかまわず悲鳴を上げる。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の身躾みの一つであるポケット・ランプをパッと點けると、まずネオン横丁の入口に最も近いカフェ・オソメの前に跼んで戸口の前や、ステンド・グラスの入った窓枠などを照し、なにか異常はないかとさがしたが、そこには血潮も垂れていなければ、泥靴の生々しい痕もない。",
              "citation": {
                "source": "ネオン横丁殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではこのカフェ・オソメも大丈夫であろう。",
              "citation": {
                "source": "ネオン横丁殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾の口から申しますのも何でございますが、ここから四軒目のカフェ・オソメの旦那、女坂染吉がたいへんいけないんでございますよ。",
              "citation": {
                "source": "ネオン横丁殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフェ・オソメの女坂も怪しいですがね」「そうかね。",
              "citation": {
                "source": "ネオン横丁殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから無論、カフェ・オソメの主人女坂染吉も、主犯として即日、捕縛されたことは言うまでもありません。",
              "citation": {
                "source": "ネオン横丁殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし不審は打ったもののメソメソ泣かれたり悲しまれたり、訴えられたりするよりは、却って気持はよいのであった。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "穢ないといえば穢ないが、その触感は、朝湯のコンソメよりもすてがたい味を持っている。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            }
