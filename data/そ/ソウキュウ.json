        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ヴィーナス像の双丘は、豊穣の象徴とされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は服の上からでもはっきりとわかる双丘を持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "女性の健康診断では双丘の発育を確認する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「ばかいえ貴様、そうきゅうにわかってたまるものか。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも大石自身は、後を清くして立つためには何かと用事もあって、そうきゅうに京師を引払うわけにも行かない。",
              "citation": {
                "source": "四十八人目",
