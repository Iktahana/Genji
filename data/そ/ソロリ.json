    "definitions": [
      {
        "index": 1,
        "gloss": "slowly and quietly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "眠っている赤ちゃんを起こさないように、そろりそろりと部屋を出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は足音を立てずに、そろりと相手の背後に回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "獲物を狙う狐が、そろりと茂みから顔を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」そろりとわづかに動いて、またも屹つと月を見上げて端凝たり。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「庭へ出たらどこか逃げ路が見付かるかも知れない」　お蝶は一生の勇気をふるい起して、息を殺しながらそろりそろりと滑っこい畳の上を忍んであるいた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　竜巻がそろりそろりと立ちあがりました。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "上下左右、うしろにまで気をつけながら、そろりそろりと進んでいきます。",
              "citation": {
                "source": "かぶと虫",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてからだをかがめて、そろりそろりと、そっちに近よって行きました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "進んで行った鹿は、首をあらんかぎり延ばし、四本の脚を引きしめ引きしめそろりそろりと手拭に近づいて行きましたが、俄かにひどく飛びあがって、一目散に遁げ戻ってきました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこでまた一疋が、そろりそろりと進んで行きました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "進んで行った一疋は、たびたびもうこわくて、たまらないというように、四本の脚を集めてせなかを円くしたりそっとまたのばしたりして、そろりそろりと進みました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「行ってみろ」　三番目の鹿がまたそろりそろりと進みました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども鹿はやっとまた気を落ちつけたらしく、またそろりそろりと進んで、とうとう手拭まで鼻さきを延ばした。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　五番目の鹿がまたそろりそろりと進んで行きました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」いまや楢ノ木大学士はそろりそろりと後退りして来た方へ遁げて戻る。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「此は、そろり／＼と參らう。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとテねずみはぶるるっとふるえて、目を閉じて、小さく小さくちぢまりましたが、だんだんそろりそろりと延びて、そおっと目をあいて、それから大声で叫びました。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてからだをかゞめて、そろりそろりと、そつちに近よつて行きました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "サタンの死に顔か、メデュサの首かと思われる乱脈な青筋を顔一面に走り出さしたまま、手探りをするようにしてドクトルの椅子の方へソロリソロリと近付いて来るのであった。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロリソロリと音さえ立てない。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロリソロリと二階を降りた。",
              "citation": {
                "source": "黒白ストーリー",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに慶北丸はソロリソロリと沖合いに出る。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに連れて煤けたお面を冠った、奇妙な着物を着た人間が、ノロマが蜘蛛の巣を取るような恰好でソロリソロリとホツキ歩くのだからトテモ退屈で見ていられない。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は鼻の頭からやさしい長い触覚を出して、ソロリソロリと動かしながら、リンリンと人を哀れがらせ、嘴と鼻を兼帯にして阿呆阿呆と鳴き渡り、又は百獣を震い戦かせんと鼻息を吹き立てております。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに連れて煤けたお面を冠った、奇妙な着物を着た人間が、ノロマが蜘蛛の巣を取るような恰好でソロリソロリとホツキ歩くのだから、トテモ退屈で見ていられない。",
              "citation": {
                "source": "能ぎらい／能好き／能という名前",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると成る程、今までに見たことのない奇妙な夫婦が、馬車の上に乗ってソロリソロリとやって来ますので、皆不思議がってワイワイ云い初めました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オシャベリ姫は、猫が本当に牢屋の外へ連れて行ってくれるのか知らんと変に思いながら、真暗な中で時々ふりかえる猫の眼を目あてにしてソロリソロリとあるき出しますと、不思議にも狭いと思った牢屋は大変に広くて、どこまで行っても突き当りません。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな事を考えているうちに、小娘がお茶とお菓子を持って階段をソロリソロリと上って来たから、受け取って飲んで見るとなかなか上等のものである。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてソロリソロリ歩き始めました。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヨイショ」「ドッコイ」と忍び音に互いに声を掛け合いながらソロリソロリと下りて来る。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まずあれから探ってみよう」　そこでソロリと立ち上がり、小一郎は忍びやかに歩き出した。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔭へ身を隠した小一郎は、刀の鯉口をプッツリと、切り、ソロリと抜くと左手を上げ、タラリと下がった片袖の背後へ、右手の刀を隠したが、自然と姿勢が斜めになる、鐘巻流での居待ち懸け、すなわち「罅這」の構えである。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロリと立ち上がった姿を見れば、手に小脇差しを引っ下げている。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
