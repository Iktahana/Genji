  {
    "uuid": "88338459-6a32-5e50-8bb8-f523da2f869f",
    "entry": "宗女",
    "reading": {
      "primary": "そうじょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "復立卑彌呼宗女壹與年十三爲王。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑彌呼の宗女といへば、即ち宗室の女子の義なるが、我が國史にては崇神天皇の皇女、豐鍬入姫又豐耜姫命の豐といへるに近し。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は宗女を與へ、或は金帛を贈り、或は土地を割いて彼等の歡心を買ひ、彼等の掠奪を緩和するのが、歴代慣行の政策であつた。",
              "citation": {
                "source": "支那人の妥協性と猜疑心",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "この妥協の犧牲となつて塞外に嫁する宗女を、唐時代には和蕃公主と稱した。",
              "citation": {
                "source": "支那人の妥協性と猜疑心",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みに秦以後の支那の外交史を達觀すると、漢の高祖は群雄平定の餘威を藉り、三十萬の大軍を率ゐて匈奴を親政したが、白登の一敗に意氣銷沈し、或は宗女を與へ或は金帛を遺り、ひたすら彼等の歡心を買うた。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "女王死して後國中また亂れしが、其宗女壹與なる一小女を擁立するに及んで國亂定りぬ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "又卑彌呼の嗣者壹與が十三歳にして女王となりしは、必しも之を卑彌呼の宗女たりし門閥上の關係にのみ因れるものと見るべからず。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに其後女王の宗女壹與を奉戴するに及んで、國中の混亂一時に治れり。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "復立卑彌呼宗女壹與年十三爲王、國中遂定。",
              "citation": {
                "source": "魏志倭人傳",
                "author": "陳壽",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
