        "examples": {
          "standard": [
            {
              "text": "「このプリンター、紙詰まりの直し方がわからないんだけど、操作方法の動画ってあるかな？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "おもちゃの操作方法が非常にシンプルだったので、3歳の息子もすぐに一人で遊び始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "エアコンのリモコンを買い替えたらボタン配置が変わり、以前の操作方法が通用せず戸惑った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "いまさら逃げだすんじゃねえぞ」　一年生にむかって、テープデッキの操作方法をおさらいしていた高志が、念を押した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがすべてのアプリケーションで、ワードプロセッサーで使っているのと同じ辞書が利用でき、同じ操作方法で日本語が入力できるとなれば、ユーザーの使い勝手が著しく向上することは間違いがなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてと、二度とこんな穴に首を突っ込みたくないから、操作方法を教えておこう。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
