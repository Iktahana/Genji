        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四十五年四月　　白い月　　　　わがかなしきソフイーに。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い月が出た、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "出て御覧、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿忘草のやうなあれあの青い空に、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、何んて冷つこい風だらうねえ、出て御覧、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "綺麗だよ、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま、やつと雨がはれた――緑いろの広い野原に、露がきらきらたまつて、日が薄すりと光つてゆく、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして電話線の上にね、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "びしよ濡れになつた白い小鳥がまるで三味線のこまのやうに留つて、つくねんと眺めてゐる、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしてあんなに泣いたの、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "細かな雨までが、まだ、新内のやうにきこえる、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "空いろのあをいそらに、白い月が出た、ソフイー。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "其自由貿易と云ふフイロソフイーは吾々は西洋の學者から習つたのでありますが、併しながら學者が説を立てる以前に日本には事實に於て自由貿易はあつたのです。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
