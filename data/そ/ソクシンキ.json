        "examples": {
          "standard": [
            {
              "text": "この釣り船には高性能な測深機が搭載されているので、魚群がいる深さを正確に把握できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "調査船は、未知の海域の地形を詳細に記録するため、最新鋭の測深機を使用している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "沈没船の捜索活動では、測深機が水中の障害物や船体の位置を特定するのに役立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "艫のほうでは引っ切りなしに測深機を投げて船あしをさぐっている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
