          "standard": [
            {
              "text": "彼の素行不良は、学校だけでなく地域社会でも問題になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会社の評判を落とすような素行不良は許されない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若者の素行不良が目立ち、治安の悪化が懸念されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "寺田は素行不良の理由で免職になったことをまるで前科者になってしまったように考え、もはや社会に容れられぬ人間になった気持で、就職口を探しに行こうとはせず、頭から蒲団をかぶって毎日ごろんごろんしていた。",
              "citation": {
                "source": "競馬",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
