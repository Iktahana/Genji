    "definitions": [
      {
        "index": 1,
        "gloss": "drizzling (rain)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "朝から雨がそぼそぼと降り続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は窓の外を眺めながら、そぼそぼと降る雨の音を聞いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昨夜からそぼそぼと降る雨で、庭の植物が生き返ったようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "わたしが學校から歸る頃から寒い雨がそぼそぼと降り出して、日が暮れる頃には可なりに強い降りになつた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "千束の寮のやみの夜、おぼろの夜、そぼそぼとふる小雨の夜、狐の声もしみじみと可懐い折から、「伊作、伊作」と女の音で、扉で呼ぶ。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしが学校から帰る頃から寒い雨がそぼそぼと降り出して、日が暮れる頃には可なり強い降りになった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「豊世、お前も行って了うかい」「母親さん達は昨夜遅くまで話していらっしゃいましたネ」「碌に寝すか」「何だかぼそぼそぼそぼそ声がしてましたが、そのうちに私は寝て了いました」「豊世――俺はツマランよ」　お仙は未だ眼を覚さなかった。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "秩父の山ふところ、武田の残党として近郷にきこえた豪族のひとりが、あてもない諸国｜行脚の旅に出でて五十鈴川の流れも清い伊勢の国は度会郡山田の町へたどりついたのは、ちょうど今ごろ、冬近い日のそぼそぼ暮れであった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうそぼそぼ暮れだが、与吉はこんなつれといっしょに旅籠をとる気にもなれない。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日のそぼそぼ暮れであった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽もそぼそぼと暮方になると、どこからともなく蹣跚い出てくるお艶は、毎日決まって近江屋の門近く立って、さて、天の成せる音声に習練の枯れを見せて、往きし昔日の節珍しく声高々と唄い出でる。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "お茶漬音頭",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　成田の祇園会を八日で切上げ九日を大手住の宿の親類方で遊び呆けた小物師の与惣次が、商売道具を振分にして掃部の宿へかかったのは昨十日そぼそぼ暮れ、丑紅のような夕焼けが見渡すかぎりの田の面に映えて、くっきりと黒い影を投げる往還筋の松の梢に、油蝉の音が白雨のようだった。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "槍祭夏の夜話",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の後を小雨がそぼそぼ降って、道は泥田のようだった。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そぼそぼとすすり泣くような小雨の音が、晩春の夜をひとしお心細く降ってきた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
