        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チャブダイの上の買いたてのソースビンを手につかみ、フタをとって口につけようとすると、「この野郎！",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オタツがソースビンをひッたくった。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソースビンを部屋の片隅へ持ち去る。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "その調子だから、ソースビンをひッたくッてソースをぶッかけるかと思ったら、ソースをテイネイに隅の戸ダナへしまってきて、水をぶッかけたから感心したのさ。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
