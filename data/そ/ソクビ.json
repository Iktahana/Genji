        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は素首をかしげ、不思議そうな顔をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "時代劇では、敵の素首を打ち落とすシーンがよく登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は素首を振って、きっぱりと拒否の意思を示した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「どうぞ、おゆるしなされてくださりませ」「ならん、たわけめ、素首を打ち落とす奴だが、薬を取りかえしたことだし、それに、昨日立てかえた金をかえせば、生命だけは助けてやるが、其のかわり汝の指を、一本一本折るからそう思え」　小平は身をふるわせた。",
              "citation": {
                "source": "南北の東海道四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その素首の飛ばぬ間に、語れ。",
              "citation": {
                "source": "袈裟の良人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いけませんね、そんなにだだっ子を言っちゃ、私はずっとあれから貴方を愛しつづけているじゃありませんか」　彼は彼女の薄化粧をした素首にキッスした。",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜、公園のベンチの上で、妾たちの唇と唇とが触れあったとき、妾はすぐその場で断頭台へつれて行かれて、二十秒以内に素首にぎらぎら光る斧をあてがわれてもいいと思ったわ。",
              "citation": {
                "source": "オパール色の手紙",
                "author": "――ある女の日記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども大体の丈格好といい、髪の結びかたから、素首の辺の髪の生えぎわから、着物の柄にいたるまで、妻のみな子にそっくりなのだ。",
              "citation": {
                "source": "秘密",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "驕った敵の素首を、足の台にして遣りたい。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日は、この穴の中へ、自分の素首が斬り落されて、文字通り身首ところを異にする運命をまざまざと見せつけられながら、米友は何も言わない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しからば、約束どおり、この小屋を踏みつぶし、そちの素首をたたき落して持ち帰るぞ」すでに一人は土足を板縁にかけ、一人は善信の腕くびをつかんで、外へ引きずり出そうとする。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――出てこずば、踏みこんで、愚禿の素首を打ち落すがよいか。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "清水の三年坂では、まんまと、討ち洩らしたが、きょうこそ、その素首は、この婆がもろうたぞ」　軍鶏のように細ッこい皺首が、背の高い武蔵へ向って伸び上がっていうのだった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやだと申す者は、素首をぶった斬るぞ」　剣把をたたくと、人々は、もう顫えあがって、唯々諾々と、彼の命のままうごくしかなかった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやく名字を申さぬと、一｜颯のもとに、素首を払い落すぞ」　と、まず一圧を加えてみた。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よし、これからもう一度引っ返して行って、あいつの素っ首を叩き落してやろう」　彼はむらむらとして、ふた足三足行きかけたが又かんがえた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "やる気だな」　うめいた左膳さっと、足をひいたのが突進の用意、即座に、左膳、半弧をえがいて豆太郎の素っ首を掻っ飛ばそうとしたが、土をつかんで身をかわした豆太郎、逃げながらの横投げ、錦糸、星のごとく、飛翔して左膳の右腕へ命中した。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ名乗らねえと、あとで見つけて、素っ首をへし折るぞ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……一言でももらしたが最後、貴様の素っ首を、そのままにはしておかぬぞ！",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに主水正親業という者が、薄青の狩衣の下に萌黄縅の腹巻を着こみ、白月毛の馬にまたがり、河原を上に逃げていたが、これを追ったのが今井四郎兼平、馬上にて矢をつがえ満月に引きしぼってひょうと放てば、狙い誤たず親業の素っ首を射当て、そのまま馬より逆さになって落ちた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第八巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "よい、河原に引き出して、その素っ首を打ち落してやる。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔に対しては、降魔の剣、邪に対しては破邪の拳、まごまごすると、おのれらの素っ首から先に申しうけるぞっ」六　薪に油である、覚明の投げたことばは、山法師たちの顔を、すべて火にさせた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「言語道断な奴めが」「お場所がらをわきまえぬか」と、叱咤して、「こりゃ平次、いつもの仕事場とはちがうぞ、ゆるし難い狼藉、きょうこそ、その素っ首を打ち落してやるから立てっ」襟がみを引摺ると、平次郎はもう痩せ犬のように身を縮めているだけだった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "速やかに、帝の御身を渡さぬにおいては、立ちどころに、その素っ首を百尺の宙へ刎ねとばすぞ」「なにをっ、小ざかしい」「帝を渡すか、生命を捨てるか」「問答無用っ」　李※は、槍を振って、りゅうりゅうと突っかけてきた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その素っ首の落ちかけているのも知らずに」「待たしゃれ。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "かならず素っ首を引き抜くぞ」　まるで旋風でも立つように、彼はたちまち号令して陣屋を畳ませ、馬具兵糧のととのえもあわただしく、すべてを打ち捨てて本軍のあとを追った。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
