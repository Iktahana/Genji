  {
    "uuid": "45f793da-0647-54c5-9495-e26e55ea6b69",
    "entry": "ソレカラ",
    "reading": {
      "primary": "それから",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "焼津　八月十七日パパカラ可愛イ子ニ、ソレカラ皆ノ人ニヨロシク。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔、昔、ギリシャ詩人タチ、ソレカラ、ボオドレエル、ヴェルレエヌ、アノ狡イ爺サンゲエテ閣下モ、アア、忘レルモノカ芥川龍之介先生ハ、イノチ迄。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "所詮ハ筏ノ上ノ組ンヅホツレツデアル、ヨロメキ、ヨロメキ、君モ、私モ、ソレカラ、マタ、林氏、寝ル間モ烈シク一様ニ押シ流サレテ居ルヨウダ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、アソコニハ、サカナ　ト　イウ　キレイナ　オヨグ　モノ　ガ　イテ、ソレハ、ソレハ、オモシロイ　トコロダ　ト　タカ　ハ、ヤマキチ　ヘ　オシエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　ツギツギニ　ツボミタチハ　上ノ　方カラ　下ノ　方ヘ　ヒライテ　イキマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　スコシ　イクト　フエフキハ　小サナ　クツヤノ　マエニ　キマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　一ツキホド　タチマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、コハレナイ　ウチニ、ムカシ、コノ　バシヤガ　マイニチ　カヨツタ　カイドウスヂヲ　ミセテ　ヤツテ、ソレカラ　モヤシテ　シマツタ　ハウガ　ヨイト　オモフ」　コドモタチハ　ミナ　サンセイイタシマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、オテテデ　ミチコサンノ　ネクタイヲ　ツカミマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、君チャンハヨナカニ目ヲサマスト、ブルブルフルエナガラ、何ンダカオッカナクテ、オ母ッチャトコエモ出セズニ、ソート手ダケヲノバシテヤッテ、ユスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒダノナマリハオバエナ、マタクルワイナ、ソレカラナンジャナ、ムテンクテンニオリャコワイ、ウソカイナ、ウソジャアロ、サリトハウタテイナ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ天保七年六月、父が不幸にして病死。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ段々｜年を取るに従て仕事も多くなって、固より貧士族のことであるから、自分で色々工風して、下駄の鼻緒もたてれば雪駄の剥れたのも縫うと云うことは私の引受けで、自分のばかりでない、母のものも兄弟のものも繕うて遣る。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ進んで本当の内職を始めて、下駄を拵えたこともあれば、刀剣の細工をしたこともある。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ又家に客を招く時に、大根や牛蒡を煮て喫せると云うことに就て、必要があるから母の指図に従て働て居た。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ江川太郎左衛門も幕府の旗本だから、江川様と蔭でも屹と様付にして、之も中々評判が高い。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "或時兄などの話に、江川太郎左衛門と云う人は近世の英雄で、寒中｜袷一枚着て居ると云うような話をして居るのを、私が側から一寸と聞て、何にその位の事は誰でも出来ると云うような気になって、ソレカラ私は誰にも相談せずに、毎晩｜掻巻一枚着て敷蒲団も敷かず畳の上に寝ることを始めた。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "母が一疋取て台石の上に置くと私はコツリと打潰すと云う役目で、五十も百も先ずその時に取れる丈け取て仕舞い、ソレカラ母も私も着物を払うて糠で手を洗うて、乞食には虱を取らせて呉れた褒美に飯を遣ると云う極りで、是れは母の楽みでしたろうが、私は穢なくて穢なくて堪らぬ。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "門閥の不平ソレカラ私が幼少の時から中津に居て、始終不平で堪らぬと云うのは無理でない。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ私も次第に成長して、少年ながらも少しは世の中の事が分るようになる中に、私の従兄弟などにも随分｜一人や二人は学者がある。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この猿松め馬鹿野郎めと独り心の中で罵り、ソレカラ山本の家にも事実は云われぬ、若し是れが顕われて奥平の不面目にもなれば、禍は却て私の身に降て来て如何な目に逢うか知れない、ソレガ怖いから唯母の病気とばかり云て暇乞をしました。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "就ては壹岐様から斯様々々の御伝言で、お手紙は是れですからお届け申すと丁寧に認めて遣って、ソレカラ封をせずに渡した即ち大橋六助に宛た手紙を本人に届ける為めに、私が手紙を書添えて、「この通りに封をせぬのは可笑しい、こんな馬鹿な事はないがこの儘御届け申します。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し騙したら乃公が払う、サアお上りなさいと云て、船頭も是れに安心して無理も云わず、ソレカラ私はその下ノ関の男に厚く礼を述て船を飛出し、地獄に仏と心の中にこの男を拝みました。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ始終道を聞くには、幼少の時から中津の倉屋敷は大阪｜堂島玉江橋と云うことを知てるから、唯大阪の玉江橋へはどう行くかとばかり尋ねて、ヤット夜十時過ぎでもあろう、中津屋敷に着て兄に逢たが、大変に足が痛かった。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ何処かで法螺の貝を借りて来て、面を隠して二人で出掛けて、杉山が貝を吹く、お経の文句は、私が少年の時に暗誦して居た蒙求の表題と千字文で請持ち、王戎簡要天地玄黄なんぞ出鱈目に怒鳴り立てゝ、誠に上首尾、銭だの米だの随分相応に貰て来て、餅を買い鴨を買い雑煮を拵えてタラフク喰た事がある。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ唯今申す通り実父同様の緒方先生が立会で、内藤数馬先生の執匙で有らん限りの療治をして貰いましたが、私の病気も中々軽くない。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ私は母にとっくり話した。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ母子の間と云うものはちゃんと魂胆が出来て仕舞て、ソレカラ愈よ出ようと云うことになる。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
