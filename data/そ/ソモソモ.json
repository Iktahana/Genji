        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "問題を再検討するために、最初（そもそも）に戻りましょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "物語は、謎めいた旅人が町に到着するところから始まる（そもそも）。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は複雑なトピックを説明する際、いつも最初（そもそも）から始めたがる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
