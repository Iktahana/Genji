  {
    "uuid": "851a2679-a65a-5895-bfb7-300b4db91947",
    "entry": "総譜",
    "reading": {
      "primary": "そうふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
