  {
    "uuid": "879d1d5d-07be-5afc-ab5c-4cf07295cb7f",
    "entry": "ソレヲ",
    "reading": {
      "primary": "それを",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スルト　モリヤ　ヤブノ　ナカニ　ヰタ　ウグヒスタチハ　ソレヲ　キキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ　キイタ　コノ　マヅシイ　ヲトコノ　ヒトハ、「ヨシ、ソレデハ　ジブンモ　センサウノ　アル　トコロヘ　イツテ、リツパナ　テガラヲ　タテ　タイシヨウニ　ナラウ」ト　ヒトリゴトヲ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　バシヤニ　フトイ　ツナヲ　ツケ、コドモタチハ　ソレヲ　エンヤ　エンヤト　ヒイテ　ユキマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ハ見タワケデハアリマセンガ、確ニ私ハソレヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハタシカニソレヲ覚エテ居ルノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ソレヲ聞カナケレバアンナニ憤慨ハシナカッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ道子ガ裏切ッタノダ、ダカラ今ココデ罰シテヤルンダ」　ト云ッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新シイ人間ガ生レツツアル　ソレヲ見ルノハ※シイ　早クヤツテキタマヘ　と、東京の友は云つて来た。",
              "citation": {
                "source": "氷花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ探求シツクスコトハ容易デナイト思ウガ、ゼヒトモ速カニソノ研究ニ着手スベキダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシモソレヲ怠ッタルトキハ、彼ノ神通力ハ瞬時ニ消滅シ、物ミナ旧態ニ復ルベシ、仍リテアダムハ、飼育セル多数ノ鼠ヲ変ジテ多クノ男女ヲ作リモロモロノ物品ヲ作リナセリ』　読み終った梅田十八は、非常なる恐怖に襲われた。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキツト私ヲ返スダラウト思ヒマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキット私ヲ返スダロウト思イマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ、草ノ葉ノカゲデ、セツセト縫物ヲシテヰタコホロギサンガミツケマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルトソレヲミテ、親切ナコホロギサンハイヒマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲキテ記念ノタメニコホロギサント一シヨニ写真ヲウツシマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ私ハ持ツテヰマス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三　三匹ノコグマサンハ、ソレヲキイテ、方々サガシマシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ　見テミンナ　ガ笑ツタ　ノヨ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ　糸デシバツテネ山羊サン　ノ　アゴ　ヘツケタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便配達ノダテウサンハ、キシヤヨリモハヤクカケテ、ソレヲ、モンコチヤンノオ家ヘトドケマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲタベテ、晩ゴハンヲタイテオイテネ。",
              "citation": {
                "source": "母子ホームの子供たち",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹ハソレヲキイテ噴キダシタ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "米ヲ作ルノワ　僕達デソレヲ取ルノワ　鬼ダ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ技巧ヲ以テソレヲ感知セシメナカッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ頸椎ヤ腰椎ヲ矯正スルニハ寝台ヲ斜面ニシタ上ニ寝テ首ヲ上方ニ吊リ上ゲタリ、腰ニギプスデコルセットヲ作リ、当分ソレヲ篏メル必要ガアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日辻堂カラ陸子ガ子供達ヲ連レテ来ルノデ、ソレヲ心待チニシテイルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ辻堂ノ中デ五六丁離レタ所ニオ誂エ向キノ家屋ガ一軒売リ物ニ出タノデ、何トカシテソレヲ買イタイノダガ、ソレニハ金ガ二三百萬足リナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
