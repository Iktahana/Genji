        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君ハソンナモノヲ担ギ込マセテドウスルンダ」予ハ婆サンノイナイ所デハ、颯子ノコトヲ「オ前」ト呼ンダリ「君」ト呼ンダリスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ彼等ノ貪ル羊ノ肉ダノチキンノ手翅ナドニハ一向食慾ヲ感ジナイノデ、ソンナモノヲ喰ウ積リハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト颯チャンノ石ダッテ餘程ノモノデショウネ」「ソンナモノヲ誰ガイツノ間ニ買ッテオヤリニナッタンデショウ」ト、コヽデ又婆サンガ一言シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネエオ爺チャン、颯子ガソンナモノヲ持ッテタ筈ハアリマセンガ、………」婆サンノ追及ハコヽヘ来テ俄ニ急デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
