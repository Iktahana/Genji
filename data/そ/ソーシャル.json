        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "現代社会では、ソーシャルメディアが人々の情報収集源として大きな影響力を持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の新しい研究は、ソーシャルワーカーの倫理的な問題に焦点を当てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "イベントの成功には、ソーシャルな繋がりをいかに活用するかが鍵となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あす着港というので今日は大分ソーシャルルームで手紙をかいている人が多い。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらのいわばソーシャル・エンジニーアがなければ、現代の複雑な社会は運転することができなくなっている。",
              "citation": {
                "source": "調査機関",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "国際労働局次長のモーレット氏によれば、最近の日本製品の世界的進出は、日本のソーシャル・ダンピングに基くのではなくて、日本に於ける産業合理化と技術の優秀と、それら日本国民従って又日本労働者の特殊な生活の簡易にあるのだという。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "相川氏側によると、少なくともソーシャル・ダンピングのことが顕著に理解出来そうだ。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "医師は科学者、ソーシャルワーカー、教育者として公僕となり医学はますます病気から健康へ重点を移すことになるであろう。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "「懇親会ってのはソーシャル・ガザーリングかい？",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポケット・ビリアードとソーシャル・ダンシングだ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "手を握りあうことすらまれで、かつてのグレン・ミラーやベニー・グッドマンの演奏にあわせて踊られたソーシャル・ダンスのように、男女が一定のフォームで触れあうことは、なかった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "到頭私はソシアル・ダンスと紅い文字で出てゐる、横に長い電燈を見つけることが出来た。",
              "citation": {
                "source": "町の踊り場",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "週刊『ル・リベルテエル』（自由人）月刊『ラ・ルヴィユ・アナルシスト』（無政府主義評論）との事務所になっているほかに、ラ・リブレリ・ソシアル（社会書房）という小さな本屋をもやっているので、店はみな地並みにあるわけなのだ。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論ステージ・ダンスなら、こんな滑稽など朝飯前ではあるけれど、少くもダンスホールのソシアル・ダンスに於てこんな飛び離れたフィギュアをするものがあろうか？",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシアル・ダンスの天才は日本人だよ。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "構内監倉の入口にて、枯川は、送れる人々を見返りて、「こゝからは本人だけしか入れないよ」と呵々大笑して、フロツク着たる影は、ツカ／＼と小暗き廊下に没し去れり、皆相顧みて語なし、彼の手には、「エンサイクロペヂヤ、ヲブ、ソシアルレフオーム」伝習録其他数巻を携へたりき。",
              "citation": {
                "source": "筆のしづく",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "むずかしい、ああ云うソシアル・リフォーマーの戦わなければならない或危期であろう。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "茂木清ベエ氏、（まだ若く、丸く、長椅子にかけるところ、どっか重役風なところ、一寸見えたが）よく話し、イギリスのソシアリズムに疑問なきソシアル・エボリューショニストだ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コントラ・ソシアル街らしい一つの街路に達した時、一発の銃弾が、どこからともなくやみを貫いてき、そばをかすめ過ぎ、すぐ頭の上で、ある理髪屋の店に下がっていた銅の髯剃り皿に穴をあけた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八四六年にはなお、コントラ・ソシアル街の市場町の刑柱の角に、この穴のあいた髯剃り皿が見えていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――今度ソシアル・ダンスの倶楽部を拵えるから、是非あたしにも這入ってくれッて云いに来たのよ」私は多少不愉快だったのは事実ですが、しかしだんだん聞いて見ると、その少年が全くそれだけの話をしに来たのであることは、嘘でないように考えられました。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜田さんに聞いたんだけれど、ダンスは非常に巧くって、ソシアル・ダンスばかりじゃなく、希望者があればステージ・ダンスも教えるんだって。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉崎先生の御｜親戚が会社の重役をしておられるので、その方からの御紹介だそうですがね」東洋石油の会社員とソシアル・ダンス！",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するにまだ世間ではソシアル・ダンスと云うものの意義を諒解していない。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
