[
  {
    "uuid": "df7b1752-08c8-568f-8d32-dfcec0e4e404",
    "entry": "装置",
    "reading": {
      "primary": "そうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
