        "examples": {
          "standard": [
            {
              "text": "演劇の舞台では、照明装置や背景が物語の世界観を表現する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "セットの装置を数分で切り替えるために、舞台スタッフが綿密に計画を立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音楽コンサートの装置には、最先端の映像技術が採用されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
