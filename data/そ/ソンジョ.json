[
  {
    "uuid": "d8c9ef3a-87a2-5a91-b669-03c30e64fd12",
    "entry": "孫女",
    "reading": {
      "primary": "そんじょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
