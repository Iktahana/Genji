        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "記者様――アノ鯉幟ノ棹ハ、私ガ酔ッタ勢イデ立テタモノデスガ、ソレガ記者様ノオ眼ニ止マッテ、コンナ不孝ナ恥ヲ晒ソウトハ夢ニモ思イマセンデシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ迄私ハ心中デハ非常ニ煩悶シテ居リマシタガ、殺ソウトハ思イマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉体ガナクナレバ意志モナクナル道理ダケレドモ、ソウトハ限ルマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
