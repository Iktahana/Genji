          "literary": [
            {
              "text": "白々とした女の首や、手足や、唇や、腹部の幻像を、真暗な彼の眼の前に、千切れ千切れに渦巻かせながら、全身が粟立って、クラクラと発狂しそうになるまで、彼の盲情をソソリ立てるのであった。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんともお痛わしいことで」　とソソリをかけ、媚びるように雅楽頭の顔を見あげた。",
              "citation": {
                "source": "無惨やな",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部も非常時なので、あんまりソソリもなく、とん／＼行って、ハネ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
