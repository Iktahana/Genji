    "definitions": [
      {
        "index": 1,
        "gloss": "to feign ignorance",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
