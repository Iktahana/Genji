        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "特に西洋人の中でも私は、アンドレーフ、ガルシン、メーテルリンク、ダンヌンチオ、アルチバセフ、ポー、※ルレーヌ、ソログープ、アレキセイ・トルストイ（大トルストイは私とは共鳴がない）かういふ人たちが好きである。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、近時のロシアの文壇――アルツイバセフとか、クウプリンとか、ソログープとかいふ人達の作を見ても、ペチヨリンほどのすぐれた人物の描写を私は余り見かけない。",
              "citation": {
                "source": "ペチヨリンとゲザ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここは、もと象徴派の詩人ソログープの邸宅だった。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソログープのための相談、指導部だ。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここはソログープの書斎だった室だ。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリモント、メレジェコフスキー、ソログープ、チェホフもトルストイも、ロシアにどのような力ですでに労働階級が発育しつつあるかを理解しなかった。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九一六年にロシアの警保局が莫大な金をつかって『ロシアの意志』という、殆ど革命的な新聞を発刊し、アンドレーエフや、ブーニン、クープリン、ソログープなどを動員したことがあった。",
              "citation": {
                "source": "マクシム・ゴーリキイの発展の特質",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
