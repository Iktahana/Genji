[
  {
    "uuid": "592736f3-c45d-55a3-ba9c-e09ddeb1de13",
    "entry": "其れに",
    "reading": {
      "primary": "それに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
