        "examples": {
          "standard": [
            {
              "text": "「作麼生（そもさん）！」と師は湯呑みを指して言った。「何が見えるかね？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「作麼生（そもさん）？ このありふれた石にも宇宙は宿っているのだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その僧侶は、公案を瞑想していた：「作麼生（そもさん）？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「仏子、仏域を穢すときいかに」「鯉魚」「そもさんか、出頭、没溺火坑深裏」「鯉魚」「這の田舎奴、人を瞞ずること少なからず」　「鯉魚」「ほとんど腐肉蠅を来す」「鯉魚」　これでは全く問答になっていません。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間のしょうそく、そもさんか、偈無可為証。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分彼の悟道の方には、「ガンコウ地に堕んと欲する時そもさんか何れの処に達せん。",
              "citation": {
                "source": "明治の地獄",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
