        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一ぽう技師アソーリンは人間をも生活をも愛さず、創造の幸福なる瞬間にあってすら、死、滅亡、有限性の観念を排しえなかった。",
              "citation": {
                "source": "妻",
                "author": "ЖЕНА",
                "note": "青空文庫"
              }
            },
            {
              "text": "――三幕と四幕のあいだに二年間が経過第一幕ソーリン家の領地内の廃園の一部。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あなたには、わかってもらえそうもないけど……右手から、ソーリンとトレープレフ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　（ステッキにもたれながら）わたしはどうも、田舎が苦手でな、この分じゃてっきり、一生この土地には馴染めまいよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　（マーシャに）ちょいとマーシャさん、あの犬の鎖を解いてやるように、ひとつパパにお願いしてみてはくださらんか。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　すると、夜どおしまた、吠えられるのか。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　結構だな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ソーリン　（髯をしごきながら）これで一生、たたられたよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　（笑う）まさか、そう気を回さんでも……トレープレフ　おっ母さんはね、この小っぽけな舞台で喝采を浴びるのが、あのニーナさんで、自分じゃないのが、癪のたねなんですよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　お前さんは、自分の脚本がおっ母さんの気に入らんものと、頭から決めこんで、しきりにむしゃくしゃ――とまあいった次第だがな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　劇場がないじゃ、話になるまい。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　ところでわたしは、文士というものが好きでな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ソーリンの手を握りしめる）ソーリン　（笑って）どうやらお目を、泣きはらしてござる。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　では、わたしがちょっくら、とまあいった次第でな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナがソーリンと腕を組んで、つづいてトリゴーリン、シャムラーエフ、メドヴェージェンコ、マーシャが登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　二十万年したら、なんにもないさ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　なあ、おっ母さん、こりゃいけないよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　だって、恥をかかしたじゃないか。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　まあさ、それにしたって……アルカージナ　ところが、いざ蓋をあけてみたら、大層な力作だったわけなのね！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　あの子は、お前のつれづれを慰めようと思ったんだよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アルカージナおよびポリーナとキスを交す）ソーリン　ブラボー！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　（哀願するように彼女に）もっと、いてくださいよ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニーナ　駄目なんですの、ソーリンさん。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　せめて一時間――とまあいった次第でね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　（冷えた両手をこすりながら）われわれももう行こうじゃありませんか、皆さん。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　ほら、また犬が吠えている。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　駄目ですな、ソーリンさん、穀倉に泥棒がはいると困りますからな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "手近なところで、たとえばこのわたしとトリゴーリンだっても……ソーリンが杖にたよりながら登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　（子供をあやすような調子で）ああ、そうなの？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
