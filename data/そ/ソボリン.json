        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "種子島では、私は島の藥屋で、ソボリンとノーシンを買つた。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "上でこの葉書を書き、ひどい風が外で吹き荒れて私は気分が悪くソボリンをのんで、はいが一匹その箱にとまっています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜はソボリンをのんですぐねむり、いい気持だった。",
              "citation": {
                "source": "日記",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月二十四日（水曜）　歯をぬく、薬がきかなくて四本も注射した、夜気分わるくて食事出来ず、ソボリンのんで眠って、十一時頃おかゆたべ、又眠った。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
