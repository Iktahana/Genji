        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼はコレクティーブの秘書ソモフの踵へくっついて歩きながら頻りにぐずぐず云っている。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソモフは、出身から云えばボルティーコフと同じ労働者である。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソモフに、たしなめられると、ボルティーコフはふてくされて悪態をついた。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　怒鳴り出したのはソモフだ。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今もソモフにそう云ったら、奴は貴様こそ偏見で腐ってると云った。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソモフやドミトリー、その他多勢の労働者にとりまかれ、活々した明るい声で計画を、今度工場で拵えようとしている服の型について説明している。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、彼女に当てこすって、傍にいるソモフに大声でからんだ。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレクチーブ秘書のソモフが、人のいい胡麻塩髯をふるわしてとび込んで来た。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことについてグラフィーラは、胡麻塩頭のソモフを忘れることは出来ない。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの晩、熱にうかされ、半分うわごとのようにドミトリーの名を呼んでいる彼女のわきに坐って、やさしく鼓舞してくれたのは、組織の古い働きてのソモフだった。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソモフは、子供を托児所にあずければいいとその時も云った。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソモフは、万事を約束通りにしてくれ、彼女は工場へ働き出した。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
