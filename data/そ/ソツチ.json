        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ハ「オヤ、オカシイナ、ソツチノミミモ立テナサイ」トイヒマシタケレドモ、ウサギハシランカオシテヰマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシネエチヤンガ足ヲオハナシニナルト、ソツチノミミハマタパタリトタオレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今越前から来て居るのをソツチのけにして置て自分勝手な話し斗りするとは怪しからぬ、と散々叱つて貴様の様な奴は役に立たぬから帰つて仕舞へと怒つて居りました。",
              "citation": {
                "source": "千里駒後日譚",
                "author": "楢崎龍、川田雪山",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
