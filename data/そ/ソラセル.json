  {
    "uuid": "02b4b254-50f8-5f78-aaae-c87acd3f17e6",
    "entry": "逸らせる",
    "reading": {
      "primary": "そらせる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-サ行",
      "inflections": null,
