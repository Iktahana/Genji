        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "べこは油橋さんにスピルトーフカ〔アルコールランプ〕をかえしてソヴキノでニューヨークのドック、日本では何とか云った題のを見た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ソヴキノにモスク※第一回目発声映画が封切だ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "トゥウェルスカヤ界隈で伸子たちのよく行った映画館は、第一ソヴキノや、音楽学校の立派なホールを利用したコロスなどだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十月」につぐエイゼンシュタインの代表作と云われていて、モスク※第一ソヴキノ映画館で伸子がそれを観たとき、彼一流の辛辣な諷刺が、画面をきもちよくひきしめていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モスクにいてソヴキノの仕事ぶりを研究したりもした。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴキノが照明燈をもやして労働宮とそこへ向う群集を撮影している。",
              "citation": {
                "source": "子供・子供・子供のモスクワ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その門から処女製作のソヴェト・フォード第一号が、歓呼の声に送られて動き出した時の光景は、ソヴキノの映画ニュースをとおして、モスクワの労働者の胸にまでつよく刻みこまれている。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴキノが、赤軍文化教育部と連絡をもって「極東特派軍」という興味ふかい記録映画をこしらえた。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九二八――二九年の例をとって見るとソヴキノでは、芸術映画　　　五三同　喜劇　　　　八児童用　　　　　九文化啓蒙　　　九〇という数にのぼっている。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころの私はレーニングラードにいて、「ソヴキノ」試写室で世界的映画監督プドフキンによって映画化されたゴーリキイの「母」を見たりしたところである。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
