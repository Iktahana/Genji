  {
    "uuid": "9df86981-2b88-5a91-bb33-c74c914581fd",
    "entry": "草種",
    "reading": {
      "primary": "そうしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "開墾費並びに牧草種代その他一千二百五十圓也。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "此草、支那に於てすら「羊負来」と呼ばれる通り、異郷の草種だつたのです。",
              "citation": {
                "source": "翁の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋となれば樹類と草種の区域を限定し、沼面の水草より変色し、黄色と赤色、紫色と種々の草の秋色が劃然としている、その美観！",
              "citation": {
                "source": "尾瀬沼の四季",
                "author": "平野長蔵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
