  {
    "uuid": "f8a8483d-74b7-5447-a988-ba2cfb97066e",
    "entry": "総結",
    "reading": {
      "primary": "そうけつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはだれだ、下総結城の人長塚｜節である。",
              "citation": {
                "source": "正岡子規君",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本の蘆を杖つき、片手に緋総結びたる、美しき文箱を捧げて、ふらふらと出で来る。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "並んで、萌黄紗に朱の総結んだ、市女笠を捧げて従ったのは、特にお珊が望んだという、お美津の爺の伝五郎。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすれば、科学はその方法とイデオロギーとの構成過程を通じての総結果として、この統一的な科学的世界像に、科学的な世界観に、世界直観に、即ち世界の統一的な模写・反映に到達する、ということになる。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　科学的世界　科学が実在を認識（＝模写・反映）する最後の段階、その総結果、夫が科学の「世界」、科学的世界である。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "之は、私が今まで分析しながら触れて来た一切の規定を、最後に統一総合した総結論なのである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二には補助艦総トン数対米七割・大型巡洋艦対米七割・潜水艦七七八〇〇トンの確保を三大原則としたが、第三の潜水艦トン数が米国と同じく五二七〇〇トンに切り下げられたとしても、総結果から云えば、まず三原則の主旨は貫徹したと見てよく、大体に於てロンドン条約は成功であったと見るべきだということ。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年辛丑十月に枕山は下総結城に赴き十一月半頃まで弘経寺に留っていた。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "毅堂が壮年の頃より茗茶と菜蔬とを嗜んだことは、嘉永四年北総結城にあった時の詩賦にも見えている。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "民土にひそむ敵愾心を、戦いへ総結させるためにもこの際――と秀吉は大規模にそれへ取りかからせた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず領民を総結するためである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
