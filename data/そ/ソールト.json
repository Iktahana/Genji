        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今日メキシコとの国境に近いカリフォルニア州の南部に、ソールトン湖という湖がある。",
              "citation": {
                "source": "日本の将来",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらミスカトニック・アヴェニューやハイ街やソールトンストール街の身なりのよい人々が知らぬ振りをしていても、常にそれはアーカムでは極めて悪い時期だった。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行がドースンに着いた時から七日目に、彼等は峻しい岸を下りてバラックス河上をユーコン路へ出て、ダイエイとソールト・ウォーター〔沿海地方〕へ向つた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボルダー・ダムの下流、コロラド河の孫支流に、ソールト・リヴァーという川がある。",
              "citation": {
                "source": "北海道開発に消えた八百億円",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソールト・リヴァー計画の全経費と同額の金を、五カ年間つづけて北海道へ入れて、その最終年度の冬には、北海道の農民の一部は、明日の食糧にもこと欠いている。",
              "citation": {
                "source": "北海道開発に消えた八百億円",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番ひどいところが、今日ソールトン湖として残っている場所の真中で、それは海面下二百四十尺の低地である。",
              "citation": {
                "source": "アメリカの沙漠",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在のソールトン湖の前身は、水深僅か七尺の小さい池であったが、そこをめがけて、コロラドの奔流が流れ込み、それが二年間も続いた。",
              "citation": {
                "source": "アメリカの沙漠",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
