        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その政党は、選挙で議席の過半数を総なめにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は今大会で全種目を総なめにし、五つの金メダルをひとりで持ち帰った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その新人バンドはデビュー年に音楽賞を総なめにし、業界を驚かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
