  {
    "uuid": "5d97dd91-0e1a-55ba-854e-844d973b7db3",
    "entry": "総嘗め",
    "reading": {
      "primary": "そうなめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この分では総勢撫斬りであろう、余興とは言いながら、毛唐風情のために、浦方すべてが総嘗めとは――残念である、業腹である。",
              "citation": {
                "source": "大菩薩峠",
                "author": "Ocean の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八九一年から翌年へかけてヨーロッパ・ロシアの数県を総嘗めにした大飢饉は、社会情勢一変の転機をなしたと言われるほど深刻なものだった。",
              "citation": {
                "source": "チェーホフ試論",
                "author": "――チェーホフ序説の一部として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八九一年から翌年へかけてヨーロッパ・ロシヤの数県を総嘗めにした大飢饉は、社会情勢一変の転機をなしたと言われるほど深刻なものだった。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸の素人天狗なら三目置かせて総ナメにしてみせらアと猪のように鼻息の荒い奴だが、棋力はたしかに素人抜群、専門棋士の二段ぐらいの腕はあった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "生馬の目玉をぬく江戸の天狗連を総ナメのアンチャンだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎碁打じゃアあるまいし、賭け碁で江戸の天狗連を総ナメの甚八が、この筋を見落すとは！",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
