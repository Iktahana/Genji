[
  {
    "uuid": "a4c09537-1ecc-5009-8e68-15ac3de47bc2",
    "entry": "そマ",
    "reading": {
      "primary": "そマ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "表現"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "are you serious?",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「明日から海外出張？ そマ？ 急すぎるでしょ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「宝くじ当たったって？ そマ！ 信じられない！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「え、まさかあの二人が付き合ってるの？ そマ…」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "でも今こそママの苦しかったことを察することが出来ます。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてこそマケドニアの画聖パムフィロスは、画師は画のほかの一切の智識をも具えにゃならぬと力説した（プリニウス『博物志』三五巻三六章）。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治維新を「その被圧迫階級の立場から描くことこそマルクス・レーニン主義的であり、唯物弁証法的であり、今日の闘争と切々脈打つところのわれわれの歴史小説でなければならぬのだ。",
              "citation": {
                "source": "文学に関する感想",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこそマルクシズム・レーニズムの旗の下にすすむプロレタリア芸術のつきない創造性というものだ。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこそマグダラのマリヤのように毎日『ダッチェス・オブ・ヨーク』で足を洗ってあげるわ。",
              "citation": {
                "source": "ハムレット",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "で今こそマリヤ・コンスタンチーノヴナの前で、きっとあの借金は返しますと誓いたかったが、こみ上げて来る歔欷と羞恥とで口が利けなかった。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし人間は死ねば、天の智慧をもらい、マコトもウソも一と目で見とおすといいますから、村上さんはいまこそマリハツ・シロウのほんとうの心を知られたのにちがいない、そうおもって、私は満足いたします。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそマジナイが人の心を安んずるを得るは、思想連合の道理にもとづくもの多しとす。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これこそマンダプーツさまの大貢献だ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日こそマルクス主義理論は常識化され日常化され、その意味に於て道徳化され気質化される時であり、又現にそうなりつつある時期なのである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "と共に、今日こそマルクス主義理論が、理論として可能な限りに於て、専心に研鑽され整備されるべき時期なのである。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "哲学者達によれば、それだからこそマルクス主義哲学は素朴で誤謬そのものだと云うのである。",
              "citation": {
                "source": "現代唯物論講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューマニズムこそマルクス主義に代るものだ。",
              "citation": {
                "source": "現代唯物論講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューマニズムこそマルクス主義を止揚＝廃棄するものだ、ヒューマニズム万歳、其の他其の他。",
              "citation": {
                "source": "現代唯物論講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから私、いっそマス・コミの中からあなたを消し、いっしょに自分をあなたにあわす顔のない女、顔をあわす資格のない悪い女にしてしまおうと考えたの。",
              "citation": {
                "source": "愛の終り",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしがマスコット姿でそちらへ通うということこそマスコットなのだわ私たちの暮しの、ね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "たちまち上を下への大騷動になったが、それこそマリヤ・ニキーチシナの思う壺だったのである。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話の模様によっては、言いにくいことも今日こそマジャルドーに打ち明けて、当分家へ来ることは遠慮してもらわなければならぬと咄嗟に決心していた胸の閊えが跡形もなく消え失せて、私は電話口を抑えて吻と深い溜息を洩らした。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――その大佐の言葉こそマリユスが絶えずいだいていたところのもので、その遺言状がなくなったので胸にはいだいていなかったが、心のうちにいだいていたのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
