        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ポークソテーが店の自慢になつてゐたが、ほかの料理もみな美味く、ことに野菜は全部｜酢漬けで、セロリーはいつもただで食べさせてくれ、なほ、毎月新譜のレコードを購入して聴かせてゐた。",
              "citation": {
                "source": "木の都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "厨房一同入寮晩餐会メニューチキンコンソメ　　アスパラガスのサラダマッシュポテト　　ヒラメのソテコールドミート　　パンデザートはバニラアイスクリーム　慶一は、「厨房」という字を、とりあえず「とうぼう」と読み、コックかなんかの意味だろうと考えた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラメは嫌いではないが、ヒラメのソテーとはどういうものか、わからなかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それではあんなに色が白いのは牛乳のように……」「仏蘭西の砒素鉄剤を召していらっしゃるのです」「ヒソテツ？",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六一一年、新イスパニヤの大使ドン・ヌーニョ・デ・ソトヌヨールがフランシスコ会のソテロを伴つて来朝、日本の海辺測量の許可を受けた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て支倉六右衛門をローマへ伴ふた伴天連ソテロは日本人入満ルイス笹田を随へて潜入、直ちに捕へられて、二人共に火あぶり。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方、紹介役のソテロは、日本の布教がイエズス会に牛耳られているのが不満で、自己の所属するフランシスコ会にも司教をおかせ、自分が司教になりたい考えであった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "両者の希望は食い違っているが、田舎策師の政宗も、日本渡来のバテレン中で最大の策師たるソテロも、それは充分心得ていたであろう。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕府がソテロの口車にのって動く見込みがないからソテロとしては田舎豪傑の政宗でやってみる以外に手がなかったかも知れないが、そうカンタンに外国がだませるツモリの政宗が、つまり田舎豪傑であったのである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソテロと支倉はエスパニヤ国王に歎願書をだして「家康が迫害したって、政宗は保護する。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "支倉もソテロも政宗が家康に対立し独自の政策を断行しうる唯一の人物だなどと毛頭考えていなかったであろうが、こう云わなければほかに相手を説得できそうな口実がないから仕方がない。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが館の中に三人の息女あり、＊クリュウソテミス、ラーオヂケー、イーピアナッサ――其中の　145一人、彼の望む者、＊結納なくて彼の父、ペーリュウスのもと彼連れよ、その時われは何人も未だ其女に與へざる多量の贈遺致すべし。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来あがったチキン・ソテェ、豚カツ、シチュウといった三文洋食を、冷めぬように特製の大岡持へ入れ、山内が監視付で勾配三十度の急な坂を、山の上の将校集会所まで運びあげる。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "池野は非常に学問の出来る秀でた頭脳の持主で、かの世界的発見たるソテツの精虫の発見などは、あまりにも有名な業蹟である。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第一部　牧野富太郎自叙伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "四五年来メキシコ通商のことで幕府の役人との間に山師的に活動していたフランシスコ会士ルイス・ソテロも、この時には信者と共に捕えられていたのであるが、巧みに出獄して伊達政宗に取り入り、この年の十月には支倉常長たちをつれて日本を出発した。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "がこれもソテロの山師的な計画によるものであって、日本における大きい社会的情勢の現われではなかった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "親愛なるシャーク殿はソテーになっていて、グリルしたカイザー・ロールの上に乗っている。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "必要なら命も捧げるよ」第三章　ホレイス・メイフィールド　伝統にならい敷布を取り除くと、古い銀燭台の蝋燭が、ぴかぴかのマホガニー食卓を茶色に照らし、ヤシや花々やソテツ、熟れたブドウや桃に差し込み、透明瓶入り深紅ワインをほのかに染めた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "スクラムルエッグ・ウィズ・ハムとチキンソティー・ライスにシユガーコーン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "トマトポタアジュ、ラビオリ・ニコアス、松茸ソテーベーコン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ポタアジュ、チキンソティ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴル、ミネストロン、チキンソティー、アイスクリーム。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "生椎茸をソティーして食べる、納豆も東京より来り美味き朝食。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱海の椎茸をソティーして食べる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタージュ・アスパラガス、チキン・ソティーにコーン・フリッター、それに野菜のカレーライス、うまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時半起き、宿の払ひをすませ、女房と、アラスカ迄歩いて、食事、冷房なし、いや暑いの何の、これじゃ料理はうまくてもダメ、ポタアジュにチキン・ソティーと野菜カレー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋井が来り、守衛を連れて、又風月堂の二階、ポタアジュ（ぬるいのでいつもクサる、何ういふわけか）チキンソティ、マカロニとスウィートポテト、コーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかめしい鉄のとびらの門をはいると、大きなソテツが、ドッカリと植わっていて、そのしげった葉の向こうに、りっぱな玄関が見えています。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
