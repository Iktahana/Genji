          "literary": [
            {
              "text": "最終的な期は、卒業年度によって決まる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "古顔の連中は一高や大学で漱石に教わった人たちであるが、その中で大学の卒業年度の最もあとなのは安倍能成君であって、そのあとはずっと途絶えていた。",
              "citation": {
                "source": "漱石の人物",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カードの下には、彼の名前とハイスクールの名称、そして卒業年度が印刷してあった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
