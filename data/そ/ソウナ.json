        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、ソウナルト実際ニ使用スル文字ト活字ノ文字ガ違ツテ不都合ダトイウカモシレヌガ、西洋ノホウデハドコヲ見マワシテモ書ク文字ト同ジ活字ヲ持ツテイル国ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シ未ダソノ時道子ヲ殺ソウナドトハ考エマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナッテシマウノデスガ、今夜ハソウナラナイ内ニ、ワザト魔法ニカカッタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、毎日、ダレカヌツテクレソウナ人ガ通ラナイカトミテヰルノデス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウナルト今ノ辻堂ノ家ハアマリニ狭イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステージダンサーデモ幾分カソウナルケレドモ、アタシハ幸イニシテナラナカッタワ」浄吉ガ彼女ニ魅セラレタノハ彼女ノ姿態ニアルコトハ確カダガ、ロク／＼学校モ出テイナイノニ、頭モ悪クハナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウソウナルト婆サンモ颯子モイキリ立ッテ、浄吉デハ手ガツケラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ意地ノ悪ソウナ顔ヲ見ルト、イヨ／＼痛ミガ増シ、イヨ／＼快味ガ増シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ偶然ニソウナッタノデアルガ、午後ノ六時ニ今夜ハオ暇ヲ戴キマスト云ッテ、佐々木ガ子供ノ所ヘ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭デバーベキューガ始マッタノハ夕刻六時半頃ダッタガ、賑カデ景気ガヨサソウナノデ、予モツイ若イ者タチノ中ヘ参加スル気ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウナルト予ハイツモノ癖デ依怙地ニナリ、直グニハ立チ上ロウトシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕ニモ分ラン、僕ハアンマリ浄吉ノコトヲ考エナイヨウニシテイル」「アタシモソウナノ、聞イテモ彼ハ面倒臭ガッテホントノコトヲ云ッテクレナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ヲ生ンデカラ特ニ際立ッテソウナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "話シカケレバ叱ラレソウナ気ガシタノデ黙ッテイタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンダッテソウナンダカラ、ウチノ子供ハ可哀ソウダヨ」「ダケドプールガ出来タ以上ハ経チャンダッテ飛ビ込ミマスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前ニモ度々コンナツメタサノ経験ヲシタコトガアルガ、ソシテ大体真冬ノ寒中ニソウナルコトガ多イノダガ、必ズシモ冬トハ限ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスガソウナルト薬デ一時ヲ糊塗ナサルヨリ方法ハゴザイマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ自分ノ女房ハ踊リ子上リダト云ウ負ケ目ガアルタメニ、自然ソウナッタノデアルガ、ソレガ一層「若奥様」ヲ増長サセル結果ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死ンダッテ何ダ」ト思ッテイタガ、死ニソウナ気ハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現金ナモノデ、コノ程度ナラ墓地ヲ見ツケニ行ケソウナ気ガシテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日一日ダケ確カニ佐々木サンヲオ預リシマス、オ爺チャンモドウゾ御無理ヲナサラナイヨウニ」「オ早ウ」ト、颯子ガ睡ソウナ眼ヲコスリ／＼隣室カラ這入ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシソウナラバソレハ誤リデ、僕ハ彼女ラヲ同等ニ愛シテイルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不恰好デ背ノ低イ河合女史ニ比ベルト、優雅ナ体ツキノ妻ノ方ガ似合イソウナモノダケレドモ、身ニツイテイナイ感ジデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の方言分布に照して見て、大体に狩谷翁の挙げた通りである上に、関東東北にはソウナという例も弘く、宮城秋田等のスナゴドリの如きも、更にそのソナから進化したことが察せられる。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
