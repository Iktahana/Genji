        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "手紙の本文を書き終え、最後に「追伸」として添え書きをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "契約書の末尾に、変更点を明記する添え書きがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この件については、別途ご説明いたします。」という添え書きが、メールの最後に付け加えられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
