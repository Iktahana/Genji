        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ソーラーパネルを屋根に設置して、ソーラーエネルギーを家庭で利用する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ソーラーランプは、電源がない場所でも手軽に明かりを確保できる優れものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "宇宙探査機には、ソーラーバッテリーが搭載されており、長期間のミッションを可能にしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "朝から机に向い、ダーヴィッシのことを書くために考えて居るうち、ペルシア神話のうち、シャナーマのソーラーブ譚をよみ美にうたれ、書く気になる。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが先頃ゴビの沙漠の砂の中から地質時代の大きな爬虫のディノソーラスの卵を発見した米国の学者達は、今度はまた中部アジアの大沙漠へ、地質時代の人間の祖先の骨を捜しに出かける準備をしている。",
              "citation": {
                "source": "鑢屑",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「拙者、天下の浪人　宮本武蔵政名と　申す者」　「ソーラ来た」と取次の侍早顔色が無い。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、象牙の塔のガラス窓の中から仮想ディノソーラス「ジャーナリズム」の怪奇な姿をこわごわ観察している偏屈な老学究の滑稽なる風貌が、さくら音頭の銀座から遠望した本職のジャーナリストの目にいかに映じるかは賢明なる読者の想像に任せるほかはないのである。",
              "citation": {
                "source": "ジャーナリズム雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "有史以前の生物であるマンモスとかライノソーラスとかいろいろ難しい名の巨獣類は、みんな武器たる爪や甲羅のために、亡んでいる。",
              "citation": {
                "source": "大阪夏之陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と笑顔を作つて、『ソーラ御覧なさい。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "然うだ、一昨年の秋の展覧会――ソーラ、お前も行つて見たぢやないか？",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ソーラ、彼は屹度昌作さんよ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーええこと、ソーラ。",
              "citation": {
                "source": "御身",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソーラ、おいでなすった」「このおれを盲目にする気か！",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソーラね」とばかり薬草道人、紅丸へ囁いたものである。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソーラね、あれもあぶない口だ」　つづいて現われたのはお吉である。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソーラね、あれもあぶない口だ」　やや暫時はしずかであった。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーラ大風が吹き出した」　はたして道人の言葉の通り、颶風ともいうべき烈しい風が、沖の方から吹いて来た。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーラぶつよ」　そこで繊手がひらめいて、すぐピチャピチャと音がした。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも大満足です、遂に見つけたから（あなたは又ソーラ、そうだと思ったという顔でしょう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば山城の「サガラ」は最もこれに近い音を有する相（サング）樂（ラー）の二｜字によつてあらはされたのが、今は「ソーラク」と讀ませてをり、能登の「ワゲシ」は最もこれに近い音を有する鳳（フング）至（シ）の二｜字によつて示されたのが、今は「ホーシ」と讀む者がある。",
              "citation": {
                "source": "國語尊重",
                "author": "伊東忠太",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソーラ、これが魔法博士の魔法の虎じゃ。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
