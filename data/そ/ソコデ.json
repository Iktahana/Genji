[
  {
    "uuid": "d7a143c8-5e44-5461-89a7-22187593e98c",
    "entry": "其処で",
    "reading": {
      "primary": "そこで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "接続詞"
      ],
