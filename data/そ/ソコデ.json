  {
    "uuid": "6e54761e-741a-587a-b247-65a7f7e6b9b6",
    "entry": "ソコデ",
    "reading": {
      "primary": "そこで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
