        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "正月の床の間にそなえ餅を丁寧に重ねて飾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "神棚にそなえ餅を供え、家内安全を祈願した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "鏡開きの日、そなえ餅を下げて雑煮に入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "○おかしいおそなえ餅が組合から来ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそなえ餅だって、栄介の家のものにくらべると、四倍ぐらいの容積があった。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
