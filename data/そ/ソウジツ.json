          "literary": [
            {
              "text": "馬車とまりし或小屋にては、白き桑実を売れり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊崎島も見ゆる」「安土川はこれか」「桑実寺もある。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿には、どこにおられますか」「今朝から天守でおさしずでしたが、今し方、お退りあって、桑実寺で御休息中です」「では、それへ参ろう」「羽柴どの。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "……蘭丸どの、どうじゃ、それがしの方が、はるかに人相観の上手であろうが、はははは」　いつか桑実寺の山門がそこに見える。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとまず、城下へ降って」　旅舎は秀吉の胆いりで、桑実寺の奥院をあててある。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ十日以上も、直家は桑実寺に逗留したまま沙汰を待っていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀吉の一行が泊った桑実寺の宿所は、まだ混雑していた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "桑実寺の宿所へ帰ると、彼はその日、手紙をかいた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "桑実寺の広間小間には、また燈火を立てている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀吉の行装一列が、まばゆい朝日の下を、桑実寺の門前町から流れ出てゆく時、使者の蘭丸もまた安土の城門へむかって帰っていたが、何ぞ知らん、この地上におけるこう二人の相識は、この時が終りだった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうも彼は、すぐ麓の桑実寺から登って来て、「わしの住居はまだか。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はもうこの十一月の初めに、岐阜の城を一子信忠に譲って、自分は、ほんの手廻品と、茶道具一揃い携えただけで、安土の桑実寺に移り来ていた。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれ見せい」「いや、ご普請場へお渡りとのことに、それは桑実寺のお台所へあずけて参りました。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
