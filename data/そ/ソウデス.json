        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「この店のケーキ、すごく美味しいそうです。」「そうですか、今度行ってみます。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「新しい映画、もうすぐ公開だそうです。」「そうですか。楽しみですね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「彼は来月から東京へ行くそうです。」「そうですか。それは大変だ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
