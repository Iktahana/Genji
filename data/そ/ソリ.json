  {
    "uuid": "0cb35322-9628-5c5b-8af6-fd79aace77e4",
    "entry": "剃り",
    "reading": {
      "primary": "そり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "剃りたての、頚条も手頸もどこもかしこもそはそはと、寒かつた。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつでもちゃんとした礼装をして、頭髪を綺麗に分けて、顔を剃り立てて、どこの国の一流のレストランのボーイにもひけを取らないだけの身嗜みをしていた。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　もっとも河野は、綺麗に細眉にしていたが、剃りづけませぬよう、と父様の命令で、近頃太くしているので、毛虫ではない、臥蚕である。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "或時、大奮発じゃ、と言うて、停車場前の床屋へ、顔を剃りに行かれました。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "次のは、剃りたての頭の青々とした綺麗な出家。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はね、軍隊で、あんまり殴られるので、こっちも狂人の真似をしてやれと思って、工夫して、両方の眉を綺麗に剃り落して上官の前に立ってみた事さえありました。",
              "citation": {
                "source": "母",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大本教主の頭髪剃り落した姿よりも、さらに一層、みるみる矮小化せむこと必せり、　学問の過尊をやめよ。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉ふとく、鬚の剃り跡青き立派な男じゃないか。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬚の剃り跡の青い、奇怪の嬰児であった。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　けばけばしいなりをして、眉毛を剃り落した青白い顔の女中が、あ、と首肯き、それから心得顔ににっと卑しく笑って引き込み、ほとんどそれと入れちがいに、とみが銘仙を着て玄関に現われた。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "高橋は、両の眉毛をきれいに剃り落していました。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年も、もう、いまでは鬚の剃り跡の青い大人になって、デカダン小説と人に曲解されている、けれども彼自身は、決してそうではないと信じている悲しい小説を書いて、細々と世を渡って居ります。",
              "citation": {
                "source": "おしゃれ童子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂へはいって鬚を剃り、それから私は、部屋の炉の前に端然と正座した。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中津はひげ面のひげを青く剃り、稍々ちゞれる癖のある、ほこりをかむった渦まける髪をきれいに梳って、油の臭いをプンプンさしていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は關羽が鬚髯を剃り落して退隱したやうな中老以上の人物。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつきりと額を剃りしすがめの子、　　しきりに立ちて栗をたべたり。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "顎から頬へかけて剃りあとの青い男らしい風貌を持つてゐた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の癖もない大柄の青年で、剃りあとの、がっしりした顎に見事な青い色を残していました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "顎から頬へかけて剃りあとの青い男らしい風貌を持っていた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十の声をきいてから、敬吉の頬にはめきめき肉がついて、ふっくらとし、おまけに商売柄いつも剃り立ての髭あとがなまなまと青かった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、見習小僧に代って、客の顔を剃りながら、かねがね理由もなしに母親に頭の上らぬ自分の顔を、しょんぼり鏡に覗いていると、何となく気が滅入ったが、ふと、「良え薬でもくれるのんか。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "十　この唇……この耳……この首筋……この肩……この手……この胴……この腰……この足……をあの首ったけ侯爵が髭の剃り跡のような青い触感と蛇の動きにも似たリズムで濡らしたのか、――という視線で陽子の体をジロジロなめまわしているうちに、京吉の眼は次第に妖しく据って、ジリジリ迫る男の眼になっていたのだ。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前もおれも何思ったか無精髭を剃り、いつもより短く綺麗に散髪していた。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十の声をきいてから永助の頬にはめきめき肉がついてふっくらとし、おまけに商売柄いつも剃り立ての鬚のあとが生々と青かったから、何か年より老けて見えていた。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "永助はこそこそ店へ引きかえすと、職人に代って客の顔を剃り、かねがね理由もなく母親に頭の上らぬ自分の顔をしょんぼり鏡に覗いてみた。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "初枝「あら、蜂谷さん、お髭お剃りになったの？",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "中風で寝ている父親に代って柳吉が切り廻している商売というのが、理髪店向きの石鹸、クリーム、チック、ポマード、美顔水、ふけとりなどの卸問屋であると聞いて、散髪屋へ顔を剃りに行っても、其店で使っている化粧品のマークに気をつけるようになった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆるナッパ服を着て、頭を光らせ、もみ上げを剃り上げた、眼の鋭い若者が二人来て隣に腰かけた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭はむさ苦しく延び煤けているかと思うと、惜しげもなくクリクリに剃りこぼしたままを、日に当てても平気でいる。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてまたみんな申し合わせたように眉毛をきれいに剃り落としてそのあとに藍色の影がただよっていた。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
