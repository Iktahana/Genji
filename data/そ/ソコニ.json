  {
    "uuid": "63bc4430-56fe-5077-8be5-d736eb5af60b",
    "entry": "ソコニ",
    "reading": {
      "primary": "そこに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレカラ、アソコニハ、サカナ　ト　イウ　キレイナ　オヨグ　モノ　ガ　イテ、ソレハ、ソレハ、オモシロイ　トコロダ　ト　タカ　ハ、ヤマキチ　ヘ　オシエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコニハ自然の約束があるから即ち一定の有様をなして、左り巻なら左り巻、右巻ならば右巻でちゃんと螺旋をなして這いまわるのだ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドレ　ドコニ」「ソラ、ソラ、ソコニ」　ナルホド、ミルト　ナタネノ　ミキニ　マダ　ヒラカナイ　ツボミガ　ヒトツ　ノコツテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツ、ヰルヨ」「エ、ドコニ」「ホラ、アソコニ」　ズーツト　下ノ　ハウノ　アル　マチノ　ホソイ　ミチノ　上ニ　キラキラト　ヒカル　モノガ　アリマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストハ　ウシロヲ　ミルト、ソコニ、ホントウニ　ブカツカウナ　ジブンノ　カゲガ　アリマシタノデ　アカク　ナリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソコニ　トナリノ　ポチガ　ノンキナカホデ　ネソベツテヰマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソコニアルタオルヲ取ッテ、背中ヲ拭イテ頂戴。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソレヲ取リ壊シテ近代建築ニ作リ直し、ソコニ今度ハワレ／＼ノ隠居所ヲ作リタイ考デアルガ、ソレニハ今日マデ婆サンガ反対シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ガ颯子ヲ妻ニシタ重ナ理由モソコニアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「カツノリ、ミツマル、フタリトモ、モンダイカイケツスルマデ、ソコニカクレトレ――ちゅうてな」「ウフフ、お父さんの芝居のうまいこと」　玄関で、朝刊を投げこむ音がした。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、ソコニー・ヴァキュアム・オイル・カンパニーが大学の就職係りに三〇万部も配った就職ガイダンス本に書かれていた「個人的な見解を語ると、いろいろと面倒なことになります。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "●オタケサン――●ボウヤ――●ア、ココニモアッタワヨ――●ア、アソコニモオチテイルワヨ――●オバサン――●ソオネ――●ワタシオコルワヨ――●ワタシオトナシクマッテ（ナッテ？",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、マダアルワヨ」「ソコニモオチテイルワヨ」　この言葉をロオラが覚えたのは、きっと、こういう風に小さな飼主たちから食べ物を貰った時のことでありましょう。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪人は、よほどふしぎに思ったらしく、銀仮面を空にむけて、身うごきもせず見つめていましたが、やがて、たまらなくなったのか、「ダレダ、ソコニイルヒト、コタエナサイ、ダレダ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソコニ、アケチガイルダロ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
