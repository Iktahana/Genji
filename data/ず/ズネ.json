        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タカ　ニ、アレハ　ドコカ　ト、タズネマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じことなら葬ひを見届けて置いてと云ふビズネスライクな気持に、少しはやつらに対する意地も手伝つてゐた。",
              "citation": {
                "source": "現代詩",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで奇態なことに、重要な本件の共犯者がウォズネセンスキイ通りのインチキ理髪師でしてね、現に留置所へぶちこんでありますよ。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「千二ヨ、タズネルモノハ、コノサキニアル。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガウズネル、米川、秋田、鳴海さん達を迎えに来た。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "勉強していると、ガウズネル、秋田さん鳴海氏と来。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○夜七時よりボズネシェンスキーを訪ね、ブハーリンの父という人と二人で、狭い、ひどい部屋に暮している。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボズネシェンスキー会があると云って中座した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十一日（日曜）　ガウズネルと、六時頃ベラ・イムベルの家へ行く。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう、ガウズネルにきいたフィリッポフの店で食事す。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、ガウズネルが来た。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月二十三日（水曜）　メリー、ヴェラ、ガウズネル来。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はガウズネルのところへゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、肩をふって歩いてクズネツキー・モスト〔古本屋の多い街路名〕の方でカゴ、アディアロ〔掛蒲団〕を見つけ、待たした из〔辻馬車「イズヴォーシック」〕でかえった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月二十六日（金曜）　○朝、荒野の詩人を演じたメイエルホリドのガーリン、ガウズネルと来る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "生ける屍のフェージャをしたクズネツォフ息子トレプレフを演じた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっすぐにクズネツキー・モスト〔街の名〕へ行って、あっちこっちへのお菓子を買う。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○通り　モスク※のクズネツキー　きれいな肌色の女の下着類、レース、衣服、装身具、皮類の店ぎっしり並んで、間に本やは一軒、キモノ！",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十五日　土　ガウズネルさんとキム夫妻がお茶に来る。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人でクズネツキー〔古本屋の多い街路名〕へゆき、眼鏡をあずけ時計のふたのガラスを入れ、大きな夕立に芸術座の中で会った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月十日　火　仕事して居ると、ガウズネルが寺島さんをつれて来た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夏は、モスクワばかりでなく、イワノヴォ・ヴォズネセンスクにもロストフの工場にも消費組合監督の突撃隊が出来た。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――どげえなもんが出来あがるっぺ……イワノヴォ・ヴォズネセンスクには風呂場までついて、栓ねじると湯の出る托児所があるそうだで。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめてデスクにおくスタンドのかさでも気に入ったのにしておちつこうと、伸子はそのシェードをきょうモスク※の繁栄街であるクズネツキー橋の店から買って来たのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタンドのかさを買う道で、伸子はクズネツキー橋の行きつけの理髪店によった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モスク※河岸の大建造物の足場を往復している労働者の姿にも、クズネツキー橋のわきで、赤旗を立てた起重機が鉄のビームをつり上げている轟のかたわらにも、工業生産高は戦前の水準にくらべると三倍以上に拡大されようとしているのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この台所工場はモスクワとイワノボズネセンスク（ここは非常に大きな工場市だ。",
              "citation": {
                "source": "ソヴェト・ロシアの素顔",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時からロシアの主要工業地帯であったモスク※県、イワノヴォ・ヴォズネシェンスク市、ハリコフ、オデッサ、ペテルブルグ市その他では、ナポレオン侵略の一八一二年頃に比べ、全住民の四パーセントしかなかった労働者が一八九七年には十三パーセントにのぼった。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　その一方ヴェリチャーニノフは、いろんな話のあいだに、ふとポクローフスキイ・ホテルの給仕の口から、パーヴェル・パーヴロヴィチが以前よくヴォズネセンスキイ通りに巣喰ういかがわしい女たちのところへ出かけたものだ、という話を聞きこんだ。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "バカレーエフの持家なんで……」「ああそれはヴォズネセンスキイ通りだ」とラズーミヒンがさえぎった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
