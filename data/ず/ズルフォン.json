          "literary": [
            {
              "text": "右頬に氷をのせ、ズルフォン剤をのんで、ねている。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズルフォン剤を三箱カラにしたが、痛みがとまらない。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の申上げることも、ズルフォン剤をのんで、氷嚢をあてる、それだけです。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房がズルフォン剤のガラスビンを縦に立てようとして、ガチャリと倒す。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラジオもプロペラもズルフォンアミドも日本人が発明したものではない。",
              "citation": {
                "source": "外来語是非",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
