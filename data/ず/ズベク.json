        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「喧嘩口論、悪人成敗、命ノヤリトリ、白刄クグリ、ヨロズ退屈凌ギトナルベキ荒事ナラバ何ナリトモ御相談ニ応ズベク候間、遠慮ノウ当館ヘ申出デ可然候。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウズベクスキー〔ウズベク人〕の芝居を見た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この表でも分るように、例えば婦人の文盲率の最も高いトルクメン、キルギース、ウズベクでさえ、一九三〇年の夏、モスクワで演劇オリムピアードが開催された時はどうだったろう。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "總テ識アルノ人ハ大事ニ任ズベク、才アル人ハ藝術ニ長ズ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "法隆寺壁画の西方浄土の脇仏の顔は、パミールに近い僻地に残っているウズベクの女の顔であるという説まで出ている。",
              "citation": {
                "source": "雷神",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
