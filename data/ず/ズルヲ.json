        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此ノ餘儀ナキ明日ヲ憂ヒ彼ノ凄慘タル隣邦ヲ悲シム者、如何ゾ直譯社會主義者流ノ巾幗的平和論ニ安ンズルヲ得ベキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ賠償公債ヲ交付シ且ツ繼承シタル該事業ノ當事者ニ其人ヲ任ズルヲ原則トス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "生産的各省ヨリノ莫大ナル收入ハ殆ド消費的各省及ビ下掲國民ノ生活保障ノ支出ニ應ズルヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "……コノ余儀ナキ明日ヲ憂イ、彼ノ悽惨タル隣邦ヲ悲ム者、如何ゾ直訳社会主義者流ノ巾掴的平和論ニ安ンズルヲ得ベキ」云々（『日本改造法案大綱』）と喝破している。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "「他ノ珍宝ヲ数エテ何ノ益カアルト、従来ソウトウトシテ、ミダリニ行ズルヲ覚ウ……」と神尾主膳が柄にもないことを呟きました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬ヘバ醫術ノ上手ハ、人身ニ於テ内景臟腑ノ結構ノ状、筋骨、皮肉、動靜脈、神經等ノ連絡ヲ其全體ニ渉リテ知ラザル莫キガ如ク、カノ政事家ノ如キハ、大ニシテハ地球上人間社會ノ連絡、小ニシテハ一國中人民社會ノ連絡ヲ知リテ、其一部ニ源因ヲ施セバ他ノ一部ニ結果ノ生ズルヲ知ルニ外ナラズ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ識ニ長ズルヲ賢者ト云ヒ、才ニ長ズルヲ才子ト云フ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊人嘔唖歌吹シ遅遅タル春日興ヲ追ヒ歓ヲ尽シテ、惟夕照ノ西ニ没シ鐘声ノ暮ヲ報ズルヲ恨ムノミ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔為ニ惜ム先生ノ空シク道ヲ講ズルヲ／嗤フ可シ豎子ノ漫ニ名ヲ成スヲ〕の聯句を見る。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔流落何ゾ恨マン千里ニ投ズルヲ／猶幸ヒニ今年モ窮スルモ死ナズ〕また「佳麗江都幾時還。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔去年地ヲ買ヒ新タニ家ヲ移ス／家具一担書五車／閑園日ニ渉レバ能ク趣ヲ成シ／五畝ノ間｜純テ是レ花／敢テ期ス戸外香ニ停マルノ騎ヲ／却テ喜ブ門前古寺ニ通ズルヲ〕云々。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔松本佐藤ノ二子鷲津知事ニ従ヒテ登米県ニ之クヲ送ル　馬前落葉離愁乱レ／朝雨江頭猶未ダ収マラズ／部伍令明ラカニシテ尤モ整粛／使君政簡ニシテ太ダ風流／過ギル時ハ感ズルヲ休メヨ白河ノ暮／到ル日ハ須ク観ルベシ松島ノ秋／語ヲ寄セヨ厳冬大雪多カラン／一領ノ白狐ノ裘無カル可ケンヤ〕となすものを見た。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔特ダ喜ブ厨婢ノ食性ヲ諳ズルヲ／香蔬軟飯槃喰ヲ薦ム〕　明治十年丁丑の年毅堂は慶応以後十余年間の詩文稿を編して梓刻に取りかからせた。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "吏事君、怪シムヲ休メヨ山城、門ヲ閉ズルヲ好ムヲコノ山、長物ナシ唯、野ニ清鶯アルノミ「貼っておきましょうか」　文八が伺うと、いいとも、いけないともいわず、老公はまた、窓から見える彼方の山と対していた。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "右がわの聯には、吏事君ヨ怪シムヲ休メヨ山城門ヲ閉ズルヲ好ムヲ　また、左の柱には、此山長物無シ唯野ニ清鶯ノ有ルノミ　武蔵は、凝然と、その詩句をにらんでいた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "山城門ヲ閉ズルヲ好ムヲ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ君モ共ニ漢朝ノ臣タリ、マタ民ヲ泰ンズルヲ以テ徳トシ任トスル武門ノ棟梁デハナイカ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "豆ヲ煮ルニ豆ノ※ヲ燃ク豆ハ釜中ニ在ッテ泣ク本｜是レ同根ヨリ生ズルヲ相煎ルコト何ゾ太ダ急ナル「…………」　さすがの曹丕もついに涙を流し、群臣もみな泣いた。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
