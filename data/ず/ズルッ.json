          "literary": [
            {
              "text": "地面がズルッと足の下で滑った。",
              "citation": {
                "source": "美しき月夜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、二―三段、はいおりたかとおもうと、ズルッと、足をすべらせました。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　幾度も同じ思案をつぶやきながら、その一端に手をかけて、ズルッと引いてみますと、帯は大蛇のように地にすべって、彼の手に小さく巻かれてゆくのでした。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンと囲いの中へ、身軽に跳び下りようとすると、疾走してきた人影が、「待てッ」　と、お十夜の片足を捕って、ズルッ――と外へ引きずり下ろしてしまった。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、つかれきっているので、ズルッ、ズルッと、手がすべって、からだが水の中へ、しずんでいきます。",
              "citation": {
                "source": "怪人と少年探偵",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
