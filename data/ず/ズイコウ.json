        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "首相の外遊に随行し、現地でのスケジュール管理や連絡調整にあたった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "若手社員の彼は、部長の出張に随行して商談の進め方を間近で学んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史的な和平交渉に随行した記者たちは、刻一刻と変わる状況を世界に発信した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それから一つの特徴としては、王の軍中に随行して、時々の戦の模様や王の事蹟を即興的に歌った詩人（Scalds）の歌がところどころにはさまれている事である。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "技術官に随行する測夫というのがまた隠れた文化の貢献者である。",
              "citation": {
                "source": "地図をながめて",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "随行の官人、伊吉連博徳、下問に応じて蝦夷の種類を説いて云はく、類に三種あり近きを熟蝦夷、次を麁蝦夷、遠きを都加留と名くと。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "明史外国伝西南方のやゝ詳なるは、鄭和に随行したる鞏珍の著わせる西洋番国志を採りたるに本づく歟という。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "査閲の時点呼執行官は私の顔をジロリと見ただけで通り過ぎたが、随行員の中のどうやら中尉らしい副官は私の鼻を問題にした。",
              "citation": {
                "source": "髪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といふをあとに聞きなして随行くに、尖塔の下の園にて姫たちいま遊の最中なり。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも又次郎にかぎらず、たとい部屋住みでも十五歳以上の者は見習いとして、その父や兄に随行することを黙許されていた。",
              "citation": {
                "source": "鷲",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その文に曰く、拙者儀今般政府へ尋問の廉有之、明後十七日県下｜登程、陸軍少将桐野利秋、篠原国幹及び旧兵隊の者随行致候間、其台下通行の節は、兵隊整列指揮を可被受、此段｜及照会候也。",
              "citation": {
                "source": "田原坂合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "随行の書記が帳面を開いた。",
              "citation": {
                "source": "或る嬰児殺しの動機",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また吹箭もて猟に行く人の跡を随行また呼び戻すために追い駆ける者を虎｜疾んできっとこれを搏ちに掛かると。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "随行者たちももう寝たようである。",
              "citation": {
                "source": "源氏物語",
                "author": "帚木",
                "note": "青空文庫"
              }
            },
            {
              "text": "随行するのは特にまたその中から選ばれた至誠の士である。",
              "citation": {
                "source": "源氏物語",
                "author": "須磨",
                "note": "青空文庫"
              }
            },
            {
              "text": "廷臣たちが我も我もと随行を望んだ。",
              "citation": {
                "source": "源氏物語",
                "author": "澪標",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへ、何んなに本社で歓迎して呉れると言つても、又理事級の人達のみが貰ふやうな高い旅費を呉れて、大切なお客様として随行員をつけて何処でも自動車で案内させると言つても、かれは決してそれを承諾しなかつたに相違なかつた。",
              "citation": {
                "source": "時子",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "随行の俺までが鼻が高いんだ。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四日にあたかも露西亜から帰着した後藤男を敦賀に迎え、その翌日は米原まで男爵と同車し、随行諸員を遠ざけて意見を交換したそうだ。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "虚堂墨蹟といえば、足利の初めから茶人仲間に大層珍重がられたもので、松平不昧なども秘蔵の唐物茶入｜油屋肩衝に円悟墨蹟を配したのに対して、古瀬戸茶入｜鎗の鞘には虚堂墨蹟を配し、参覲交代の節には二つの笈に入れ、それぞれ家来に負わせて、自分の輿側に随行させなければ承知しなかったものだそうだ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ氏の話にもあると思うが（私はそばできいていたので）彼が講和会議へ随行したとき、欧州へ旅をして、まず第一に彼が憧憬のまととなったのは世界の賭博の本場であるモナコであったということである。",
              "citation": {
                "source": "黒岩涙香のこと",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして汽車の中で、通訳として随行していたＳ氏にノートブックを幾冊となく買わせ、何をするかと思うと、帽子をぬいで、その中へ骰子を二ついれて、帽子を揺り動かしては中の骰子をころがして二つの骰子の表へ出た数の和を記していき、それを記したノートブックが欧州旅行中に十数冊もたまったということである。",
              "citation": {
                "source": "黒岩涙香のこと",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "小野妹子の帰朝に際し煬帝は裴世清という家臣を随行させ煬帝よりの国書を奉呈せしめた。",
              "citation": {
                "source": "日本上古の硬外交",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはグラツドストオンが何かの用事で倫敦からエデインバラに出掛けた旅行中の事で、その折はどういふものか新聞記者といつたら、某社の記者がたつた一人随行してゐるに過ぎなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔡家溝駅長オグネフ、同駅駐在中隊長オルダコフ大尉、同隊付セミン軍曹、チチハル・ホテル主人ヤアフネンコ、露国蔵相ココフツォフ、随行員、東清鉄道関係者、露支顕官、各国新聞記者団、写真班、ボウイ、日本人警部、日露支出迎人、露支両国儀仗兵、軍楽隊、露国憲兵、駅員。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは九月の九日に将軍｜家茂が明年二月を以て上洛するという令を発して、柏軒はこれに随行する準備をしたからである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百は用人｜河野六郎の内意を承けて、久次郎の随行を謝絶した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭軒の長崎行は、長崎奉行の赴任する時に随行したのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」是に由つて観れば、榛軒庚戌の遊は正弘に随行したものと見える。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "随行の少年輩が一人飲み二人飲み、遂に先を争つて群り飲むに至つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　松田氏の此談話中に見えてゐる随行医官の名の中に、猶奥医師林洞海法眼が漏れてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その三百十四　癸亥の歳将軍徳川家茂が上洛した時、柏軒は随行を命ぜられた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、清作さんは、村の子供たちをつれて、帰ったら、かならずいこうと思っていた、源吉さんのお墓へお詣りをしました。",
              "citation": {
                "source": "村へ帰った傷兵",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
