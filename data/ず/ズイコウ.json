        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "骨折部位を固定するために、髄腔内に金属製のロッドを挿入する手術が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "解剖学の実習で、長管骨を割って内部の髄腔を確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "髄腔を満たしている骨髄は、血液細胞を作り出す重要な工場のような場所だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ある日、清作さんは、村の子供たちをつれて、帰ったら、かならずいこうと思っていた、源吉さんのお墓へお詣りをしました。",
              "citation": {
                "source": "村へ帰った傷兵",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "よかったら雪をさかなに飲み明かしても結構――河上、まずいこう」　雪と聞いて座の空気が更に浮立った。",
              "citation": {
                "source": "山椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもわずいこう喰べふくれておざる」　いうとおり、家康は、馳走攻めにあっていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
