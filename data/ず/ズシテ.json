  {
    "uuid": "218b0bd7-c4c6-5917-9642-8f3b62a8a36f",
    "entry": "ズシテ",
    "reading": {
      "primary": "ずして",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然ルニ大西郷等革命精神ノ體現者世ヲ去ルト共ニ單ニ附隨的ニ行動シタル伊藤博文等ハ、進ミタル我ヲ解セズシテ後レタル彼等ノ貴族的中世的特權ノ殘存セルモノヲ模倣シテ輸入シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "經濟的組織ヨリ見タルトキ現時ノ國家ハ統一國家ニ非ズシテ經濟的戰國時代タリ經濟的封建制タラントス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私産限度超過者ガ法律ヲ遵守セズシテ不可行ニ終ルベシト狐疑スル勿レ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑法ヲ遵守セズシテ放火殺人ヲ敢テスル者アルガ故ニ刑法ハ空想ナリト云フ者ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "維新革命ハ所有權ノ思想ガ強力ニヨル占有ニ非ズシテ勞働ニ基ク所有ニ一變スルト共ニ、強者ガ其強力ヲ失ヒテ其所有權ヲ喪失シタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ中世貴族ノ所有地ヲ現今ニ至ルモ解決スル能ハズシテ終ニ獨立問題ニマデ破裂セシメタル愛蘭ノ土地問題ト、此ノ私有地限度制トハ其思想ニ於テモ進歩ノ程度ニ於テモ雲泥ノ差アルヲ知ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ日本改造法案ヲ一貫スル原理ハ、國民ノ財産所有權ヲ否定スル者ニ非ズシテ、全國民ニ其所有權ヲ保障シ享樂セシメントスルニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "都市地價ノ騰貴スル理由ハ農業地ノ如ク所有者ノ勞力ニ原因スル者ニ非ズシテ大部分都市ノ發達其者ニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地ノ國際的分配ニ於テ不法過多ナル所有者ノ存在スルコトニ革命的理論ヲ擴張セズシテハ、言論行動一瞥ノ價値ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "新タナル試ガ公共的認識ヲ待ツ能ハズシテ常ニ個人ノ創造的活動ニ依ルト云フモ其二。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ニ發達スルモ公共的生産ガ國民生活ノ全部ヲ蔽フ能ハズシテ、現實的將來ハ依然トシテ小資本ニヨル私人經濟ガ大部分ヲ占ムル者ナリト云フモ其三。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ安寧秩序ヲ保持スルコトガ國家ノ唯一任務ナリトセバ、國民ノ死活榮辱ヲ日夜ニ亘リ終生ヲ通ジテ脅威シツツアル此等ヲ處分セズシテハ國家ナキニ同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ大資本ヲ奪ハズシテ物價調節ヲ云フ如キハ抱腹スベキ空想政治ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ此ノ改造ヲ行ハズシテ而モ徒ラニ同盟罷業ヲ禁壓セントスルハ、大多數國民ノ自衞權ヲ蹂躙スル重大ナル暴虐ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞理ハ一社會主義ノ專有ニ非ズシテ自由主義經濟學ノ理想ニ亦犯スベカラザル者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人ガ大經世家タルカ大發明家大哲學者大藝術家タルカハ、彼等ノ立案スル如ク社會ガ認メテ勞働ヲ免除スト云フ事前ニ察知スベカラズシテ悉ク事後ニ認識セラルル者ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ原野ハ六千年間婦人ニ耕ヤシ播カレズシテ殘レリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只英語ホド普及セズシテ而モ英語思想以上ニ影響ヲ與ヘタル獨乙語ニ依リテ其ノ害毒ノ緩和セラレタル天裕ヲ有スルノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國語問題ハ文字又ハ單語ノミノ問題ニ非ズシテ言語ノ組織根底ヨリノ革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "劣惡ナル者ガ亡ビテ優秀ナル者ガ殘存スル自然淘汰律ハ日本語ト國際語ノ存亡ヲ決スル如ク、百年ヲ出デズシテ日本領土内ノ歐洲各國語、支那、印度、朝鮮語ハ亦當然ニ國際語ノタメニ亡ブベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ今ノ日本教育ノ凡テハ教育ニ非ラズシテ唯外形ノ摸倣ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲ領有スル結果ヨリ見テ、恰モ百萬圓ヲ貯蓄シタル結果ヨリ見テ、其レガ高利貸ニヨルト忠實ナル勞働ニヨルトヲ考査セズシテ等シク守錢奴ト詈リ侵略者ト誣ユルハ昏迷者ノ狂言ナリ、重大ナル罪惡ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ露西亞ノ脅威ハ過渡時代ノ「レニン」ニ非ズシテ「レニン」無キ後眞ニ再建セラルベキ十年後ノ將來ニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ラバ「ウヰルソン」ハ「ヴェルサイユ」ニ行カズシテ瑞西ノ社會黨大會ニ列席スベカリシナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ國情ニ於テハ必ズシモ強兵ヲ意味セズシテ、日本ノ建國ト信念トニ於テハ傭兵ハ必ズ弱兵ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ利己其者ハ不義ニ非ズシテ他ノ正當ナル利己ヲ侵害シテ己ヲ利セントスルニ至テ正義ヲ逸ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日英兩國ハ中立的關係ニ立ツ能ハズシテ、彼ノ從屬的現状ヲ維持スルカ彼ノ分割ヲ結果スル征服者タルカノ二ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ罪正ニ大帝ノ陵墓ヲ發クノ大逆政策ヲ改メズシテ支那ノ排日ヲ怒リ米國ノ排日ニ憂ヘ尚且ツ茫々然トシテ天佑ヲ夢ム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "驕兒「カイゼル」ハ世界的排斥ニ反省セズシテ陷穽ニ墜落シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ今次ノ大戰ニ際シテ大西郷アリ明治大帝アリシナラバ、獨逸ノ陸軍ト東西呼應シテ一擧露國ヲ屈服セシメ、海軍亦東西ニ相分レテ英國艦隊ヲ本國ト印度濠洲トノ防備ニ兩分セシメ十分ナル優勢ヲ持シテ各々之レヲ撃破シ、朞年ナラズシテ早ク已ニ北露南濠ニ大帝國ヲ築キタリシ筈。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
