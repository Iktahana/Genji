        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君ハ必ズコノアワレナ男ニ同情ヲ持ツデアロウコトヲ我輩ハ疑ワナイノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は風邪で　ズコズコですが、これは大したものではありません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のズコズコも悪化しない代り少々万年で。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですからきっと私のズコズコもなおるでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この扁桃腺のフクレでズコズコ云っていたのもすっかり解決いたしさっぱりした気分になりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "咳が出て、鼻ズコなり。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……私が〈危険、警戒ヲ要ス〉という信号をすると、〈イカナル危険ナリヤ、場所ハイズコナリヤ〉という返事が来ます。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "信号手",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言スレバ、諸君ハ知ラズ識ラズコヽニ永代不滅ノ資産ヲ確立スルコトヽナルノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この菌はまたアスナロに近縁異属のクロベ一名ネズコすなわち Thuja Standishii Carr.（＝Thuja japonica Maxim.）にも寄生するのだが、この樹のものは瘠小で緑色を呈しすこぶる貧弱な姿を呈している。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "針葉樹の主なるものは唐檜白檜であるが、栂・姫小松・ネズコ（黒檜）等の大木も少くない。",
              "citation": {
                "source": "黒部峡谷",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネズコは俗に黒部杉と称する程あって、中流の区域に広く散生している。",
              "citation": {
                "source": "黒部峡谷",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ日ハバーベキュー、昨日ハ病気デ静養中デアッタガ、ソノ間モ予ノ頭ニハ絶エズコノ言葉ガ引ッカヽッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アールズコート（＊ロンドン西部）に大地主の邸宅を買った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "アールズコートは18世紀には田舎だったからである。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「オクズス」という言葉をローマ字で書いて、逆に読んでいくと、ＳＵＺＵＫＯ（スズコ）となるのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "音盤の詭計",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてイズコ（何処）をドコというようになったのは近世だとすれば、その頃以前の世の小児遊戯にも、なおその中間の同じ類の語があったことが知れる。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中には、蒼白をおびた黒部杉（ネズコ）などもまじる。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はディクソン・ウェルズ、会社はＮ・Ｊ・ウエルズコーポレーション、つまり父のだが。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "御意で」「何やらの書にも――ソノ味ハ醇厚、久シキヲ経テモ損セズ、故ニ古ヨリ大宋、南蛮ニ往来スル倭船モ、必ズココニテ酒壺ニ吉備酒ヲ満タシ、長キ船中ノ用ニ充ツ――とか。",
              "citation": {
                "source": "私本太平記",
                "author": "筑紫帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでは、小ダイを「チャリコ」、「カズコ」などという。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
