          "literary": [
            {
              "text": "タトエバ我々ノ映画事業ニシテモ、何カ会ダノ組織ダノガデキルタビニ、ズラリト重要ナ椅子ヲ占メラレルノハ、必ズ、全部ガ全部映画ニハ何ノ関係モナイ人バカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オモテニハ　タタミガ　ズラリト　ナラベテ、タテカケテアツテ、　トン　トン、バタ　バタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三条局は蒲生｜氏郷の妹、三丸殿は信長の第五女、姫路殿は信長の弟｜信包の娘、主筋の令嬢をズラリト妾に並べてゐる。",
              "citation": {
                "source": "黒田如水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
