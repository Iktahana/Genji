  {
    "uuid": "7cd03424-f2d5-57d3-917f-1bc2719e7bbe",
    "entry": "ズバ",
    "reading": {
      "primary": "ずば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
