    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――したがって日本人に最も接近させられる――であるけれども、彼等の極端なるジャズバンドの音楽でさえ、日本俗謡の八木節や安来節の類に比し、尚｜遙かに貴族感的で、どこかに＊シルクハットや燕尾服を着たところの、儀礼正しき紳士道を聯想させる。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日牛乳や鶏卵チーズバターをさえとらざるビジテリアンがある。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は二人一度にズバリ――　平土間騒然たり。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同「ドッコイやらぬ」と立廻り――　＝道――　大吉、縄持ってた奴をズバリ斬って、　其処に現れた数名の捕吏と立廻り。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪劇場の地下室で無料の乙女ジャズバンドをきき、それから生国魂神社前へ行った。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「小郷虎吉に会いに来たのよ」　弓子はズバリと言った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この男は世の中に怖いものがないのであろうか」　弓子はピシャリと小郷の顔を撲りたい衝動を感じながら、「それから、もう一つ投書が来てるんですが……」「あはは……小郷虎吉ついに投書欄の人気者になったか」「投書の内容は、実は……」　居並ぶ芸者や舞妓の顔を、素早く見廻して、弓子はズバリと言った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしの罪じゃないわ」　寝る前とは打って変ったように、娘はズバリと言ってのけた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――それとも、あなたは自分自身を一流だと思いますか」　喋りつづけて来た信吉は、最後にズバリとそう言った。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪劇場の地下室で無料の乙女ジャズバンドをきゝ、それから生国魂神社前へ行った。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャズバンドの音が気おくれした豹一を押しのけるようになかからきこえて来て、道頓堀のアスファルトを寒く乾かしていた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "対岸のキャバレエ「銀座会館」からジャズバンドの騒音がきこえていた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも鞘へは納めないで、大刀を、ズバツと畳に突刺したのである。",
              "citation": {
                "source": "妖魔の辻占",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏郷は是の如く厳しい男だったが、他の一面には又人を遇するにズバリとした気持の好いところも有った人だった。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩歌以外に於いても遠い昔から、四季が人間に及ぼすところのものを、ズバリと言い切っているものは決して少なくない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　しやがれた大聲で一と口にズバリと言つてのけて、それから、ざまア見やがれ、おどろいたか、と言はんばかりの調子でヘツヘツヘツとひつつるやうな笑ひ聲を長く引きながら監房の中に消えて了つた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェムズバードって名付けてね。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "逮捕時に自分から白状したところでは、実はダートムアまで出張ってきたのは、キングス・パイランドの持ち馬や、第二人気のデズバラ、すなわちケープルトン厩舎サイラス・ブラウン管理の馬の情報を得たかったからとのことだ。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこのデズバラという馬が二番人気ですから。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五対五でデズバラ！",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが我々の前へ来るまでにデズバラの脚色は鈍り、そこへ大佐の馬が仕掛けて抜き去り、ゆうに六馬身の差で決勝標に入る。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "――行くぞッ」　ズバリと叫んで、今こそまことに冴え冴えと冴えやかに冴えまさったあの眉間｜傷に、凄婉な笑みを泛べつつ、ずいと前なるひとりにつめよろうとした刹那！",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "焚いてそのお膝の前に格之進が捧げ持っていったのをズバリと言った。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "待ちに待った名人のすっと胸がすくような伝法句調が、はじめてズバリと言い放たれました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズバリといった看破の一言に、居合わした供頭らしい尾州家の藩士が、ぎょッならんばかりにうろたえながら、荒々しくこづき返すと、江戸八百八町の大立て物をなんと見誤ったものか、けわしくきめつけました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あたし、チーズバーガーも。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サブマリンサンド」とか、「チーズバーガー」とか、「ペストリー」とか、「ワッフル」とか、知らない食べ物ばかりだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
