        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "從テ傭兵ト徴兵トノ強弱ヲ論ズルコトハ無用ナル詮議ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "金椎は心得て、その紙片を取って見ると、主人の筆でサラサラと、「金椎ヨ、余ハ急ニ感ズルコトアリ、今朝ヨリ暫時ノ旅行ヲ試ミントス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ本国いぎりすノ国家ノ強ヒル宗教ヲ信ズルコトヲ肯ンゼザルナリ、制度ハ国ノ制度ヲ遵奉セザル可カラズトイヘドモ、信仰ハ自由也、国家ヨリ賦課セラルベキモノニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十方三世ノ諸仏、ナラビニ本師釈迦牟尼仏、本来ノ願望ハ遂ゲザレドモ、父母、朋友、信者ノタメ、イマイチド生レ変ッテ仏法ノ恩ヲ報ズルコトガデキマスヨウニ」――この手が岩角から離れたときが今生の命の終りと、朦朧と偈をとなえていると、テンバが精気の霊薬だというコカの葉を智海の口もとにさしつける。",
              "citation": {
                "source": "新西遊記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "傲骨崚※、詩ヲ論ズルコト尤精厳ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ今ノ兵ヲ説ク者コノ篇ノ晩出ヲ以テコレヲ軽ンズルコトナクンバ則可ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "途ニ上ルノ日｜復ビ慈顔ヲ奉ズルコト能ハザルヲ知リ、話シテ刻ヲ移ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "冀クハ心ヲ同ジクシ力ヲ協セ余ガ及バザル所ヲ輔翼シ以テ聖旨ノ万分ノ一ニ報ズルコトアレト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
