[
  {
    "uuid": "52af458a-b911-5e09-a0c6-6d2a8b645c83",
    "entry": "寸々",
    "reading": {
      "primary": "ズタズタ",
      "alternatives": [
        "ずたずた",
        "ずだずだ",
        "ズダズダ"
      ],
