        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "暫くたたずんで内の様子を見ると云うでもなく考えて居ると云うでもなく只ぼんやりしていたのである。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いき」は色っぽい肯定のうちに黒ずんだ否定を匿している。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "空は紺碧に深まり、山は紫緑に黒ずんでいる。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る理由の知れないはにかみと、不安な懸念とにせき立てられて、私は女づれを後に残し、速足でずんずんと先に行つてしまつた。",
              "citation": {
                "source": "夏帽子",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし少時の後には、会話が非常にはずんで来て、皆が快活にしゃべり始めた。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "危險なる新光線疾患せる植物及び動物の脊髓より發光するところの螢光又はラジウム性放射線が、如何に我我の健康に有害なるかを想へ、斯くの如き光線は人身をして糜爛せしめ、侵蝕せしめずんば止まず。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しからずんば、死を樂しめ、理窟なしに。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "むげんにさびしい工場がならんでゐる、煤煙で黒ずんだ煉瓦の街を、大ぜいの勞働者がぞろぞろと群がつてゐる。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無限にさびしい工場がならんでゐる、煤煙で黒ずんだ煉瓦の街を、大ぜいの労働者がぞろぞろと群がつてゐる。",
              "citation": {
                "source": "散文詩集『田舎の時計　他十二篇』",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の伊香保は、何となく感じが黒ずんで陽快な所がない。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と知つてか、芳は苛つて圖に乘り、無理にも賣らずんば止まざる底の心掛。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから面喰つてゐる私に對して、ずんずん次のやうなことを話し出した。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから友はくるりと背後を向き、いかにもすげない冷やかな顏付をして、一人でずんずんと歩いて行つた。",
              "citation": {
                "source": "田端に居た頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋の上に一人の男がたたずんでゐる。",
              "citation": {
                "source": "橋上",
                "author": "――詩壇の議論家に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪に埋み盡された地面――そこには黒ずんだ常盤木の外に緑といふ色の夢にもない――が見る／＼黒土に變り、黒土が見る／＼若草の野に變つて行くあの華々しい變化は、雪國に越年しない人の想像する事が出來ない所だらう。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と雨が――忘られさうだつた雨がしと／＼と黒ずんだ雪の上一面にそゝぎかゝる。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "濕地には水芭蕉の青々とした廣葉が枯葦の間から、谷間には蕗の薹や福壽草が腐つた蕗の葉を蹴破つて、ずん／＼と延びて行く。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車が一台、（何時見てもそれは黒ずんだ緑色に塗られてゐたから同一の一台だと思ふ）時々「鍔甚」の前にとまつた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "シ※ークスピヤか、然らずんば際物かといつた調子である。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "真昼の光はあつても少しくであり、それもやがて暮れるとしてのことのやうであり、此処では、紅の花も、やがて萎れて黝ずんだ色になるとしてのことである。",
              "citation": {
                "source": "宮沢賢治全集",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷風がさやさやと、川楊の葉に衣擦れのような音をさせて通行する、雲はずんずん進行して、山の緑は明るくなったり、暗くなったりする。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "神さびた境内にたたずんで、夜山をかけた参詣の道者が、神前に額ずいての拍手を聞きながら、「日本の山には、名工の建築があるからいいなあ」と思った。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "沈黙してたたずんでいると、鶯鳴き、ホトトギス鳴き、カケスが鳴き、眼覚めた鳥が、一せいに声を合せて鳴き立てる。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
