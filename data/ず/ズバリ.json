        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "私の隠していた悩みを、占いの先生がズバリと言い当てたので驚愕した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「君が言いたいのは、ズバリこういうことだろう？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "天気予報がズバリ的中し、週末は予告通り抜けるような青空になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
