        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「よしたらいいだろうそれは」　ズケリと鉄ぶちは言った。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オオ、こら、どうも」　思いは同じだったのだろう、あわてて海老団治も頭を下げたとき、「御無心があるのや、海老やん」　ズケリと麦松は言った。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「似てるからよ」　ややしばらくいおうかいうまいかためらっていた杉大門が、やがて思い定めたようにズケリといった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前のほうも無理でねえんだ」　またズケリと文楽がいって、「つまり両方とも、無理でねえ、至って人間らしい了見の持ち方なんだ。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "須田栄君が応待に出ると、いきなり懐中から短刀を取り出して彼、ズケリと卓子の上へと置いた。",
              "citation": {
                "source": "艶色落語講談鑑賞",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　ズケリといって、ぼくは、おさわの顔をみたのである。",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
