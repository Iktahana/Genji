[
  {
    "uuid": "a8a3c519-e354-50fe-ac6d-3b3fb3ac6e37",
    "entry": "ズキズキ",
    "reading": {
      "primary": "ズキズキ",
      "alternatives": [
        "ずきずき"
      ],
      "is_heteronym": false
    },
    "grammar": {
