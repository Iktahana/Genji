    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "糸屋六兵衛一家の者が総動員でこしらえた十枚の建札を、ズラズラと縁先へ並べさせると、墨痕琳璃と書きしたためた文句がまた不思議です。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれこれ二十人ばかり、あまり風体もよろしくないごろつき付らしいのが、これが頭と見える白覆面を先頭に、ズラズラと白刄をならべているのです。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズラズラズラズラッと辷り出したが最後の助。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、これから述べてゆく其の物語の中には、日本人の名前ばかりが、ズラズラと出てくるのだが、読者諸君は、それ等を悉く真の日本人だと早合点されてはいけない。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "友達がいに、ここへズラズラッと並べてやるから耳の穴をかっぽじって、よく聞いていねえ。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "かごやの客",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでガリガリズラズラ出かけて行って了う。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
