        "examples": {
          "standard": [
            {
              "text": "彼は深夜までデスクに向かい、新しいエンジンの図面を引いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "独学で建築を学び、自分の手で理想の家の図面を引くのが夢だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "設計士が正確に図面を引かなければ、安全な建物は建設できない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ちょうど家を造るために図面を引くと一般で、八畳、十畳、床の間と云うように仕切はついていても図面はどこまでも図面で、家としては存在できないにきまっている。",
              "citation": {
                "source": "中味と形式",
                "author": "――明治四十四年八月堺において述――",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の図面を引くことを、彼は再び初めた。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
