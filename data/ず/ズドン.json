  {
    "uuid": "ea8cbcf9-fee9-5248-b1b7-eaafef35e800",
    "entry": "ずどん",
    "reading": {
      "primary": "ずどん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "有頂天の直後に、かならずどん底の失意に襲われるのは、これは、どうやら僕の宿命らしい。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――きりょうも、いろも、雪おんな……　ずどんと鳴って、壁が揺れた。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三木はよろよろ立ちあがって、こんどは真正面から、助七の眉間をめがけ、ずどんと自分の頭をぶっつけてやった。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三木はよろよろ立ちあがつて、こんどは真正面から、助七の眉間をめがけ、ずどんと自分の頭をぶつつけてやつた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尉が、いかんいかん、と云って手をふりますと、山烏はピカピカする拳銃を出していきなりずどんと大尉を射殺し、大尉はなめらかな黒い胸を張って倒れかかります。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちはあいかわらずどんどんやって行きます。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが娘さんは、私に箱を与えると、いつもの懐しげな様子に似ずどんどん早足に帰ろうとします。",
              "citation": {
                "source": "伯林の降誕祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尉が、いかんいかん、と云つて手をふりますと、山烏はピカピカする拳銃を出していきなりずどんと大尉を射殺し、大尉はなめらかな黒い胸を張つて倒れかゝります。",
              "citation": {
                "source": "烏の北斗七星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こつちはあひかはらずどんどんやつて行きます。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "税務署長がまた見掛けの太ったざっくばらんらしい男でいかにも正直らしくみんなが怒るかも知れないなんといふことは気にもとめずどんどん云ひたいことを云ひました。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨強く風｜烈しく、戸を揺り垣を動かす、物凄じく暴るる夜なりしが、ずどんと音して、風の中より屋の棟に下立つものあり。",
              "citation": {
                "source": "一景話題",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずどんずどんとどこかで短銃の音がしたので、真蒼になって遁げて帰ると、朋輩のお方が。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "凄じく嘶いて前足を両方｜中空へ翻したから、小さな親仁は仰向けに引くりかえった、ずどんどう、月夜に砂煙がぱっと立つ。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小なりといえどコンピューターの機能を持ったマイクロコンピューターを売っていくには、まずどんな使い道があるのかを顧客とともに開発していくエンジニアがいる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボウトは、かまはずどん／＼走つていきます。",
              "citation": {
                "source": "一本足の兵隊",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車へなんか乗らなけりゃよかったじゃねえか」「だって……」「畑の中へでも、構わずどんどんと逃げていってしめえばよかったじゃねえか」「そしたら、お嬢さまは兄さんに、捕まえておいで！",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずどん云う大砲の音を初めて聴いた時は、こおうてこおうて堪らんのやけど、度重なれば、神経が鈍になると云うか、過敏となるて云うか、それが聴えんと、寂しうて、寂しうてならん。",
              "citation": {
                "source": "戦話",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "』て、二人ともずどんずどん一生懸命になって二三十発つづけざまに発砲した。",
              "citation": {
                "source": "戦話",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「小野さん三条に蔦屋と云う宿屋がござんすか」　底知れぬ黒き眼のなかに我を忘れて、縋る未来に全く吸い込まれたる人は、刹那の戸板返しにずどんと過去へ落ちた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "海いつぱいにひろがつてゐる軍艦にしろいしやつぽがいちれつにいかにも退屈に左右にならんでゐるずどん……と大砲を撃つてやつたら兵隊がまりのやうにとびあがるだらう。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし商人たちは、かまわずどんどん、いろんなごちそうに作っていました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "迷亭は構わずどんどん話を進行させる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると直ぐ後から江川がずどんと口火をきつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
