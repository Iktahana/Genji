        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "丁度後にドイツの本を読むことになってからズウデルマンよりはハウプトマンが好だと云うと同じ心持で、そう云う愛憎をしたのである。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "頓陳漢５・２（夕）　政友会の三｜土忠造氏が、会の本部で退屈｜凌ぎに、ズウデルマンの『マグダ』を読んでゐた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズウデルマンのマグダの言った通り、父の手からすぐに夫の手に移るような意気地なしでは為方が無い。",
              "citation": {
                "source": "蒲団",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハウプトマン、ズウデルマン、カルル・ブライブトロオなどがこの上もない好い伴侶となつたのである。",
              "citation": {
                "source": "『蒲団』を書いた頃",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズウデルマンは、「芸術家よ、画け、語る勿れ。",
              "citation": {
                "source": "茗荷畠",
                "author": "眞山青果",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が故郷への初興行は、たしかズウデルマンの「故郷」のマグダであったかと思う。",
              "citation": {
                "source": "松井須磨子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
