          "literary": [
            {
              "text": "おのれやれ万一思い通りになったらば、三日と傍へは寄せ附けずに、天の橋立の赤前垂にでもタタキ売って、生恥を晒させてくれようものを……という大阪町人に似合わぬズッパリとした決心を最初からきめていたのであった。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯うはっきり云われているとズッパリして、快活な勇猛心を励まされます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして、ズッパリと、何故娘を殺した！",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
