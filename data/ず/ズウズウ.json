[
  {
    "uuid": "a74c98f8-31bc-54a6-8940-6d3969ddf3d2",
    "entry": "ずうずう",
    "reading": {
      "primary": "ずうずう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
