          "literary": [
            {
              "text": "道傍、溝の畔に萩みだれ、小さき社の垣根に鶏頭赤きなど、早くも園に入りたる心地す。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "岬頭赤壁幾千尋、攀到三更日未沈、踞石銜杯呼北極、一宵養得百年心。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "お町は到頭赤ん坊をお負つたまゝ、土蔵の中へ逃げて行つてしまつたのである。",
              "citation": {
                "source": "河原の対面",
                "author": "小寺菊子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
