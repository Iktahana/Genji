        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ちょっと」　とおかみさんは呼びとめて、「ここへも二本」　と笑いながら言い、「それからね、キヌちゃん、すまないけど、裏のスズヤさんへ行って、うどんを二つ大いそぎでね」　私とチエちゃんは長火鉢の傍にならんで坐って、手をあぶっていた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤヂのワカラズヤであるに驚く、彼はガムシヤラで世の中を渡る男に過ぎない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジキ一神教ニ於テ「マホメツト」ハ刄ヲ出サンガ爲メニ來レルヲ明言シテ「殺スベシ」ト教ユルニ非ズヤ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレ豈ニ遠大ノ業ニアラズヤ――」　これは云うまでもなく政府の方針になっていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえりにスズヤでものをのむ。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼四県ノ地亦陛下ノ一家ニアラズヤ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "四県ノ民亦陛下ノ赤子ニアラズヤ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノコトハ、交際上ニ於テハ毫モ論ズ可キコトニ有ラネド、尚古ノ道ニ取リテハ口惜キコトナラズヤ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ吾ガ高橋子ヲシテ数月ノ間櫛風沐雨ノ苦ヲ兵馬ノ地ニ嘗メシメタルモ、亦汝ノ事ニ関セシニ非ズヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈不肖余ノ故ヲ以テニアラズヤ感歎ニ堪ヘズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔君見ズヤ去年堤上此ノ時節／禁奢令厳ニシテ春淒絶タリシヲ〕また「近日漸復旧繁華。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕山は出遊の途次結城を過ぎ請わるるがままに、『論語』の「学ンデ而シテ時ニコレヲ習フマタ説シカラズヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈故ヲ忘レザルノ最ナルモノニ非ズヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "易ニイハズヤ往イテ雨ニ逢ヘバ吉ナリト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "足ガ自慢ノ彼女ハ、自分ノ足ガ佛陀ノ足ニ比セラレテ朱印ヲ紙ノ上ニ落スノヲ見テ、必ズヤ心ニ喜悦ヲ禁ジ得ナイデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が「モシ昔ノ島原ノヨウナ妓楼ニ売ラレ」た女であったとしたら、「必ズヤ世間ノ評判ニナリ、無数ノ嫖客ガ競ッテ」「周囲ニ集マ」ったであろうことを、私は始めて知ったのであった。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼四県ノ地亦陛下ノ一家ニアラズヤ、四県ノ民亦陛下ノ赤子ニアラズヤ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿の朝食、はかなく食べたとこへ博多の興行組合長の神保栄氏来訪、宿の前のスズヤへ行き話す、リプトンがまだある。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、スズヤへ寄り昼食。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思ってるがだ、君があまりにも身勝手で、ワカラズヤだから――」「なに。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕のどこがワカラズヤだ。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "すこしは損得を考えてみたらどうだ」「イヤだ」　四万円貰って立退けば、こんな身勝手なワカラズヤと同居しないで済む。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
