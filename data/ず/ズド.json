        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "人相と言い、場合と申し、ズドンとやりかねない勢いでごさいますから、画師さんは面喰らったに相違ございますまい。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズドンと大砲をぶっぱなしたら、陰気くさい支那人が『デモだ』なんて云ってるのよ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那で金を多額に懐中していることは、ズドンとやられる機会を、より多く持つことだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ズドンと一発やられたあとで、来なけゃよかったと、後悔したって、もう追っつかねえでがすよ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "強い男、半次を肩に担いでズドンと投げた。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "小十郎はぴったり落ち着いて樹をたてにして立ちながら熊の月の輪をめがけてズドンとやるのだった。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ズドンと一発やりたいなと署長は思った。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズドンの音とともに僕自身が後ろに倒れた。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく幼少なる「加八」君はここでそのありたけの深謀をちゃんちゃんこの裏にめぐらして最後の狙いを定めて「ズドーン」と云って火蓋を切る真似をする。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "うしろ向きになって、的の姉さんを袖姿見に映して狙いながら、銃口を、ズッと軽く柔かに肩に極めて、そのうしろむき曲打にズドンと遣るんだ。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもなかったら、馬に一発ズドンとやってしまうぞ」　ホームズは私の膝の上に手綱を置いて、馬車から飛び降りた。",
              "citation": {
                "source": "自転車嬢の危難",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵隊は鉄砲をとりあげると、あおむけに寝たまま額の真上の空にねらいをつけてズドンと射ち放した。",
              "citation": {
                "source": "兵隊の死",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "16権太郎は殆んど全身をむき出しにしてズドン、ズドンと何時までも射撃してゐるばたり、ばたりと山鳥は果実でも落ちるやうに足元へ落ちてきて地上で狂はしく羽を舞はしてゐる。",
              "citation": {
                "source": "小熊秀雄全集-6",
                "author": "詩集（５）飛ぶ橇",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽やかな夏の新装を身に着けた貴婦人たちの群が、ウヤズドフスキェの大通りを、いくつも流れていった。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も先方は君を恋しい恋しい兄さんと認めてくれたので、まず半分は成功した訳だが、御本尊の君自身が、あの美少女にズドンと肘鉄砲を喰わせた……自分の従妹とも許嫁とも、何とも認めなかったので、今度は手段をかえて、君をこの室に連れて来る様子だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち絵巻物探索の唯一無上の手がかりとして、手を換え、品を変えて機嫌を取っていたＴ子から、抵抗不可能ともいうべき自分の急所に、思いもかけぬ肘鉄砲を一発ズドンと喰わされたのであった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっちでもズドン、こっちでもビシンと爆発して、生き残った魚群の神経に猛烈な印象をタタキ込むばかりでない。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち本店を復興すると同時に、東京市内各区に一つ宛デパート式のデパートを作ったが、それがズドンと当って繁昌するわ繁昌するわ。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間、ここで地主のノズドゥリョフと知合いになったが、それは年のころ三十ぐらいの、すばしっこい元気者で、二言か三言、口をきいただけでもう、『君、君』と言うようになった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察部長や検事に対しても、ノズドゥリョフはやはり『君、君』で、極めてざっくばらんに振舞っていた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　チチコフは、それが検事の家で午餐を共にした、あのノズドゥリョフだと気がついた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言いながら、その返事も待たずに、ノズドゥリョフはこうつづけた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そういいながら、ノズドゥリョフは連れの男を指さした。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だが懐中に、せめてもう二十ルーブリあったらなあ、」と、ノズドゥリョフは語を継いだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、ノズドゥリョフが言った。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、ノズドゥリョフが言い返した。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがノズドゥリョフは、『おい、助けてくれ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、ノズドゥリョフは呶鳴った。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とこの時、老婆がノズドゥリョフの傍へ近よりながら、訊ねた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
