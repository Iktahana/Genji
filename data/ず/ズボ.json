[
  {
    "uuid": "111e5ef8-04e8-58d7-98a8-f30d7ddddc29",
    "entry": "ずぼ",
    "reading": {
      "primary": "ずぼ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "沖の方では波が鳴らうと、私はかまはずぼんやりしてゐた。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "教師も生徒も、抜出して見れば是といつて悪くなつたわけではなかつたが……可なり目に立つのは小使共のずぼらであつた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、其の頭へ、棕櫚の毛をずぼりと被る、と梟が化けたやうな形に成つて、其のまゝ、べた／＼と草を這つて、縁の下へ這込んだ。",
              "citation": {
                "source": "人魚の祠",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、おかしな売方、一頭々々を、あの鰭の黄ばんだ、黒斑なのを、ずぼんと裏返しに、どろりと脂ぎって、ぬらぬらと白い腹を仰向けて並べて置く。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭からずぼりと黒い奴で、顔は分んねえだが、こっちを呼びそうにするから、その後へついて行くと、石の鳥居から曲って入って、こっちへ来ると見えなくなった――　俺あ家へ入ろうと思うと、向うの百日紅の樹の下に立っている……」　指した方を、従七位が見返った時、もうそこに、宮奴の影はなかった。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思うと、ずぼりと出る。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と兄は私のずぼらに呆れたやうに苦笑しながら首を振つて、それから立ち上つてお婿さんに、「それぢやあ、わたしは農会へちよつと行つて来ますから、そこらにある本でも御覧になつて、どうも、けふはお天気がわるくて。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その荒物屋というのは、ばけもの歯みがきや、ばけもの楊子や、手拭やずぼん、前掛などまで、すべてばけもの用具一式を売っているのでした。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん狐の洋服ですからずぼんには尻尾を入れる袋もついてあります。",
              "citation": {
                "source": "茨海小学校",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はい」白い太いずぼんをはいた人がすぐ出て来て立ちました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくみると、みんなそれは赤いずぼんをはいたどんぐりで、もうその数ときたら、三百でも利かないようでした。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "郡役所の技手の、乗馬ずぼんをはいた足よりまだりっぱだ。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の雑貨商店や金物店の息子たち、夏やすみで帰ったあちこちの中等学校の生徒、それからひるやすみの製板の人たちなどが、或は裸になって二人三人づつそのまっ白な岩に座ったり、また網シャツやゆるい青の半ずぼんをはいたり、青白い大きな麦稈帽をかぶったりして歩いてゐるのを見て行くのは、ほんたうにいゝ気持でした。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは忙しく靴やずぼんを脱ぎ、その冷たい少し濁った水へ次から次と飛び込みました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こはいかに赤きずぼんに毛皮など、　　春木ながしの人のいちれつ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日｜実習が済んでから農舎の前に立ってグラジオラスの球根の旱してあるのを見ていたら武田先生も鶏小屋の消毒だか済んで硫黄華をずぼんへいっぱいつけて来られた。",
              "citation": {
                "source": "或る農学生の日誌",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物もシャツとずぼんだけ、もちろん財布もありません。",
              "citation": {
                "source": "バキチの仕事",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」白い太いずぼんをはいた人がすぐ出て来て立ちました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "変てこなねずみいろのだぶだぶの上着を着て、白い半ずぼんをはいて、それに赤い革の半靴をはいていたのです。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」白い太いずぼんをはいた人がすぐ出て來て立ちました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "相変らずぼんやりして店へ坐っていた久次郎は、母のまえに出てその詮議をうけたが、かれの答弁はすこぶるあいまいであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の厚いところも、だいぶ軟かになっていて、わたくしはとき／″＼ずぼりと腰の辺まで雪の中へ踏み込みます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど今きいてゐれば、あの無頓着な、どちらかと云へばちとずぼらのすぎる男の胸にも、女に逃げられた時の寂しみを味つてゐるんだと私は思つた。",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふつさりと柔かい髪の毛を真中からきれいに左右に分けて、細目のずぼんの縞のもうにんぐを行儀よく着こなし、すらりとした身体を鷹揚に運んで居る処は、寔に上品な紳士である、否さながらの貴公子である。",
              "citation": {
                "source": "瘢痕",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "」彼はずぼんのかくしのあたりへ無意味に手をやりながら、いくらか思切つて云つてのけると云ふ風を示してかう云つた。",
              "citation": {
                "source": "瘢痕",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "小麦を粉にする日ならペムペルはちぢれた髪からみじかい浅黄のチョッキから木綿のだぶだぶずぼんまで粉ですっかり白くなりながら赤いガラスの水車場でことことやっているだろう。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくみると、みんなそれは赤いずぼんをはいたどんぐりで、もうその数ときたら、三百でも利かないやうでした。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "郡役所の技手の、乗馬ずぼんをはいた足よりまだりつぱだ。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだなとスリム氏が答えて、掘り下げた穴の側面を何回か、ずぼっと削った。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハロルドが船長の喉からゴム管をずぼっと引き抜くと、著しい変化が起こった。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
