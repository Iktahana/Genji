            {
              "text": "「オヤ、ヲバサン、アカンボガ　ウマレルノデスカ」「モウ　ウマレテ　ヲリマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハ　コレカラ　ドチラヘ　イクノデスカ」ト　シンセツナ　トシヨリハ　ワカイ　ヲトコニ　タヅネマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニシロ、イマニ、コヤミタイニ　オホキナ　ロバニ　ナルト　イフノデスカラ、チヒサナ　クルマデハ　マニアヒマセン。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダイジナ　モノデスカ」「エエ、ワタシニハ　ダイジナ　モノデス」　ソコデ、サカナハ　ヨクガ　デマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキツト私ヲ返スダラウト思ヒマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキット私ヲ返スダロウト思イマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女ノ子ノオマワリサンガ、カウホメテクレタノデスカラ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエ、イエ、ハデダナンテ　ソンナコト　アルモノデスカ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マルコオバサンガ「ソンナコト――アル――モノデスカ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ナニヲキタライイカ、イロイロト　サウダンシテヰルウチニ、アマリ　ポカポカト　アタタカイモノデスカラ　ダンダント　ネムクナツテキマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　マルコオバサンガ「イエ、イエ、ハデダナンテ　ソンナコト　アルモノデスカ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ガンバリ、　マルコオバサンガ「ソンナコト――アル――モノデスカ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "３オ染サンガ新聞ヲ読ンデクレタラ日本軍ガ合戦ニ勝ッタソーデスネオジサンモ戦ッタノデスカソシテ敵ヲ殺シタノデスカ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家ニアルツワイス・イコンヲ使ッテ写シテミヨウカト思ウ」ト云ッタラ、「現像ハ外ヘオ出シニナルノデスカ」ト彼ガ聞イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度ハコレヲ聞キタイノデスカ？",
