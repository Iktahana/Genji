        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "額の油汗拭はむと、ぴくとわが硬直の指うごかした折、とん、とん、部屋の外から誰やら、ドアをノツクする。",
              "citation": {
                "source": "音について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノツクは、無心に、つづけられる。",
              "citation": {
                "source": "音について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人の部屋の扉をノツクしてから、廊下の東南の隅につるされてある丸い金魚鉢を見あげ、泳いでゐる四つの金魚について、その鰭の數をしらべた。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一年｜経って、昭和十八年の早春に、アス五ジ　ウエノツクという君からの電報を受け取った。",
              "citation": {
                "source": "未帰還の友に",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」光線の關係で内部がよく見えなかつたのであらう、コトコトとノツクする音が聞えたが、やがて焦立たしげにののしる聲がきこえ、次に鍵がガチヤリと鳴り、戸が開いた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度ノツクの練習をしてゐたところで、今度は私に打つて呉れと云ふのでした。",
              "citation": {
                "source": "初夏",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はダイヤモンドに立つて、全身に力をこめて強くノツクバツトを振りました。",
              "citation": {
                "source": "初夏",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、エノツク・アヽデンや、モウパツサンの小話や、さういふものと同じに見せかけておいて、それをあの結末のところでひつくり返した形は、遉はこの作者だと思つた。",
              "citation": {
                "source": "三月の創作",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "お起きなさいよ、――オートミールが冷えてしまふ――」　フロラの烈しいノツクで彼は、漸く目を醒した。",
              "citation": {
                "source": "鸚鵡のゐる部屋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一層ノツクして見ようか――と彼が気色ばんで立ち直つた時「村瀬さんでせう！",
              "citation": {
                "source": "女に臆病な男",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか選手も繰込んでゐてノツクが開始されてゐました。",
              "citation": {
                "source": "早春のひところ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉を誰かゞノツクしたと見える――二人は、一斉に其方を向いて、「入つてはいけません。",
              "citation": {
                "source": "風媒結婚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある朝、早くからこの部屋をノツクするものがあつた。",
              "citation": {
                "source": "災厄の日",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かが僕の部屋の扉をノツクして、濁み声で「杉本さん」と叫ぶ。",
              "citation": {
                "source": "災厄の日",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一一、一二）野球王子電氣會社の前の草原でメリヤスシヤツの工場の若い職工達がノツクをして居る。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "――チチシスアサ七ジウエノツク――私はガアーンと頭を殴られた気がして、呆然としてしまった。",
              "citation": {
                "source": "父の出郷",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういふ人物に扮して見たいかといふ問題は、自分の素質よりも趣味に即してゐると思ひますが、例へば「どん底」の男爵、「クノツク」の主人公などです。",
              "citation": {
                "source": "俳優志望者メンタルテスト",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノツク・アウトと云ふ手だ。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖母さんがはひつて來て、彼をなぐさめ、彼が靴のボタンをはづすのを手つだひ、着物をぬがせ、彼をベツドに入れてくれ、そしてそこを立ち去る前に、もし夜中に何か彼女にして貰ひたいことがあつたら、彼の部屋と彼女の部屋との間の仕切りをノツクするやうにと言ひ殘して行く。",
              "citation": {
                "source": "旅の繪",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がノツクをすると、お祖母さんはすぐ來てくれる。",
              "citation": {
                "source": "旅の繪",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、幾島の部屋の扉をノツクした。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "大沼博士の部屋をノツクすると、中から扉が開いた。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが結局、事を面倒にしてるんですから……」　扉をノツクするものがあるので、二人は一斉にそちらを見た。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その時、ドアをノツクする音。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、扉をノツクするものがあつた。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は扉を軽くノツクする音で、ふと我れに返つた。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヨクキノツクオイヌサンガ、オネコサンノ耳ノトコロデイヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時、扉をノツクする音。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラの釦をはめようとしてゐる時、扉をノツクする音。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂの部屋の扉をノツクする音。",
              "citation": {
                "source": "音の世界",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
