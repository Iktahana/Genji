        "examples": {
          "standard": [
            {
              "text": "歓迎会で羽目を外しすぎた主役が、一番先に飲みつぶれてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はいつも飲みつぶれるまで飲み、翌朝には何も覚えていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "床の上で飲みつぶれている彼を、何とかベッドまで運び込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "伊三が半日がかりで訊きまわり、毎晩、必ずこの「吉兵衛」へあらわれて飲みつぶれる、ということをさぐり出したのだ。",
              "citation": {
                "source": "おさん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
