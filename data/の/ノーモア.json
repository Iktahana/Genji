        "examples": {
          "standard": [
            {
              "text": "「ノーモア、戦争！」と平和を訴えるデモ隊が街を練り歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、二度とあんな失敗はしないと心に誓い、「ノーモア！」と叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ノーモア、この苦しみ！」と患者は痛みに耐えながら言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "どうして僕は原子爆弾のことばかり書いたり考へたりするのだらう、ノーモア・ヒロシマ、ノーモア・ヒロシマ……と。",
              "citation": {
                "source": "長崎の鐘",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノーモア・ヒロシマズ！",
              "citation": {
                "source": "いまわれわれのしなければならないこと",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノーモア・ヒロシマズの声は世界に拡がりつつある。",
              "citation": {
                "source": "ヒロシマの声",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
