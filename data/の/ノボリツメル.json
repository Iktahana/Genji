[
  {
    "uuid": "5ea0ec2d-d28b-5ddc-a918-a8f7a9782020",
    "entry": "上り詰める",
    "reading": {
      "primary": "のぼりつめる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-自動詞"
      ],
