      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to go to the top",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は努力の末、会社のトップまで上り詰めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "厳しい競争を勝ち抜き、彼はその分野の頂点に上り詰めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "どんな困難があっても、必ず目標を上り詰めるという決意を胸に抱いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一度は落ちた男が、将来どんな高みに上り詰めるか、我らに見せつけるがいい。",
              "citation": {
                "source": "三枚の学生",
                "author": "THE ADVENTURE OF THE THREE STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、先に上った警部は、上り詰めると、急に身体を右に避けるようにするのです。",
              "citation": {
                "source": "島原心中",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "此谷を上り詰めると殆ど頂上直下に出で、其処から絶頂まで二十分で達せられる。",
              "citation": {
                "source": "越中劒岳",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その右手の頑丈な踏み心地のいい階子段をのぼりつめると、他の部屋から廊下で切り放されて、十六畳と八畳と六畳との部屋が鍵形に続いていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "常設館の角を曲がってＡ川に沿って坂をのぼりつめるところ、Ａ橋と小さい公園の入口とが、丁字形に接して居た。",
              "citation": {
                "source": "十姉妹",
                "author": "山本勝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十分もかかつて、やうやく一つの坂をのぼりつめるとそこで一段落がつく。",
              "citation": {
                "source": "遍路",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十分もかかって、ようやく一つの坂をのぼりつめるとそこで一段落がつく。",
              "citation": {
                "source": "遍路",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてはしごをのぼりつめると、ギンネコ号の横っ腹にあいた穴の中へもぐりこんでいった。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "元気がいい人ですね」「いずれ、あとで、おもしろい話を、たくさん、聞かせてくれるだろう」　階段をのぼりつめると、りっぱな円形の広間へ出た。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かすかに残っている野馬の踏附け道をたどりながら頂きまでのぼりつめると、なんの前触れもなく、いきなり眼の下に現出した壮大な景観に思わず声をのんで立ちすくんだ。",
              "citation": {
                "source": "新西遊記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　細長い棒を地につきさして、それに一ぴきの百足虫を這わせると、百足虫は、まっしぐらに棒の尖端までのぼりつめる。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "一さんに徒歩軽装の早さで峠をのぼりつめる。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "登りつめると綺麗な芝を植ゑた斜面から玉川沿の平野一面を見晴す事が出來た。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "登りつめると其處は一面の原で、道からも時時見えた修道院の建物が遙かの丘に高く聳えてゐた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "石段を登りつめると或家の中庭らしい處へ出た。",
              "citation": {
                "source": "少年の悲哀",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "石段を登りつめると、ある家の中庭らしい所へ出た。",
              "citation": {
                "source": "少年の悲哀",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "登りつめるときれいな芝を植えた斜面から玉川沿いの平野一面を見晴らす事ができた。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しの坂路を登りつめると、草の生えた路が、なだらかに越後の國へ向いて降りて行く。",
              "citation": {
                "source": "霧の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "登りつめると、うぐいすだにの駅にかかった陸橋。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切の強欲の軋轢の苦役から放免せられてゐる山々一寸きざみに山へ登りつめる廣い天と地鋭利な知能を必要とはしない自然老境にはいつた都會を見捨てゝ柔い山ふところに登りつめる私私はその樂しみの飽くことを知らない。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "石段を登りつめると、家の横から表通りへ出る路地があつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜜柑畑の間を登りつめると、急に線路は下りになつた。",
              "citation": {
                "source": "トロツコ",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜜柑畑の間を登りつめると、急に線路は下りになった。",
              "citation": {
                "source": "トロッコ",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "緩い傾斜を中程登りつめると、黒板塀に西洋式の庭園の樹木の茂りの蔭に赤い壮麗な煉瓦の宮殿が聳えて見える。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程銅の大鳥居から四十二丁の上宮迄は樹海の中を登りつめるので、見はらしはなし、谿流は添わず、大英彦全体を眺める事の出来ない凹凸の多い山なので、ひととおりの登山丈では、一向変化のないつまらぬ山と思えるのもむりはない。",
              "citation": {
                "source": "英彦山に登る",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪をさんざん登りつめると、急な崖に取っついた、北へ切れれば、シュレック・フィルンから落ちる深い氷河で、雪の反射から黒い崖に移った私たちは、薄暗いランターンに足元の幾平方尺を照らしながら、石垣の塗土のように、岩のかけらに食い込んだ氷に杖を打ち込んで、また東へ向かって登って行った。",
              "citation": {
                "source": "登山の朝",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪を散々登りつめると、急な崖に取っついた、北へ切れれば、シュレック・フィルンから落ちる深い氷河で、雪の反射から黒い崖に移った私達は、うす暗いランターンに足もとの幾平方尺を照しながら、石垣の塗土のように、岩のかけらに喰い込んだ氷に杖を打ち込んで、又東へ向って登って行った。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　漸っとその小屋まで登りつめると、私はそのままヴェランダに立って、一体この小屋の明りは谷のどの位を明るませているのか、もう一度見て見ようとした。",
              "citation": {
                "source": "風立ちぬ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく一つの険しい坂を登りつめると、其処はやや平坦な崖地になっていました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "登りつめると、水色の高級車が一台とまつてゐて、その先にいきなり、思ひもかけぬ別天地がひらけた。",
              "citation": {
                "source": "ハビアン説法",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to be engrossed in",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
