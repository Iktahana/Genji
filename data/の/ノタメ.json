        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "子孫ノタメトハ唐突デス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ゾウワイジケンノタメシユウヨウチユウノ××ハフキソトケツテイシマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "満鉄ヤ撫順ノタメニ諸君ノ暮シガチットデモラクニナッタカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "植民地再分割ノタメ帝国主義戦争ガ勃発スル可能性ガ十分ニアルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那革命擁護ノタメニ、諸君ハ支那ノ労働者、農民、兵士達ト力ヲ結合セヨ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿ニ似テ非ナル猿面冠者ハオノガ立身出世ノタメニハ、主人ヨリ猿々ト呼ビ捨テラレルモ、ヘイヘイト追従笑ヒナド泛ベタルハ、即チ羞恥ヲ知ラザル者ト言フガ如シ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "電報は「ゾ　ウサンノタメシヨウガ　ツヤスミヘンジ　ヨウ」カエラヌ」ツルキチ」鶴さんからオトラ婆さんに宛てたものだった。",
              "citation": {
                "source": "電報",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "封建時代ノ武士ガ凡テ後顧ノ憂ナキガタメニ其ノ道義的奮進又ハ犧牲的冒險ヲ敢行シ得タル如ク、國民ハ其ノ子女ノ國家的保障ノタメ戰場ニ於テモ平和ノ其レニ於テモ何等後顧ノ憂ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米人ノ持續セントスル國際的特權ノタメニ宣傳サレツツアル平和主義非軍國主義ガ、其ノ特權ヲ打破センガ爲メニ存スル日本ノ軍備及ビ戰鬪的精神ニ對スル非難トシテ輸入サレツツアル内容皆無ノ文化運動。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "劣惡ナル者ガ亡ビテ優秀ナル者ガ殘存スル自然淘汰律ハ日本語ト國際語ノ存亡ヲ決スル如ク、百年ヲ出デズシテ日本領土内ノ歐洲各國語、支那、印度、朝鮮語ハ亦當然ニ國際語ノタメニ亡ブベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "中食ノ學校支辨ノ理由ハ第一ニ登校兒童ノタメニ毎朝母ヲ勞苦セシメザルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ此ノ改造組織ヲ其等ノ領土ニ施行シテ主權國民自ラ私利横暴ヲ制スルト共ニ、先住ノ白人富豪ヲ一掃シテ世界同胞ノタメニ眞個樂園ノ根基ヲ築キ置クコトガ必要ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ妻子ヲ失ッタ悲シサノタメニ酒色ニ溺レテ、恵ミ深イ大恩アル祖母ノ事ヲ忘レテオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "水産翁、轟雷雄先生ガ免職ニナリマシタ裡面ニハ、国家ノタメニナラヌ重大秘密ガアリマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウゾドウゾ国家ノタメニ御調ベヲ願イマス」　ウーム。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く同じ造りの二階家が数軒並んで、隣の二階にもわたしと同じやうな姿の若い士官がゐて夜更まで灯りの下で勉強して居り、そのまた隣も海兵の合宿所で時々、今日ハ手ヲ取リ語レドモ　明日ハ雲井ノヨソノ空　行クモ留ルモ国ノタメ　勇ミ進ミテ行ケヨ君――と合唱する聞くだに健やかな血の湧き立つ軍歌が響いた。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く同じ造りの二階家が數軒並んで、隣の二階にもわたしと同じやうな姿の若い士官がゐて夜更まで燈りの下で勉強して居り、そのまた隣も海兵の合宿所で時々、今日ハ手ヲ取リ語レドモ　明日ハ雲井ノヨソノ空　行クモ留ルモ國ノタメ　勇ミ進ミテ行ケヨ君――と合唱する聞くだに健やかな血の湧き立つ軍歌が響いた。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈石ニ矢ノ立ツタメシアリ、石ニ立ツ矢ノタメシアリ……）　ケラア先生もお葉も、そして太郎も夫々の魂をひたすら楽器に打ち込んで夢中となつた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十一日（火曜）〔発信〕第六十二信〔受信〕電報　フツカトモ　ナンラ　メンカイヲコトワツテイルニアラズ　ネンノタメニ」アサ九ジハン　ケンジ　白いきちんとした背広、紳士、そり跡蒼きやせ面。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮から又電報、シゴトノタメオクレル、と。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "各幹事ハ打合セノタメ至急庶務ヘオ出デ下サイ。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十四日に間に合うように和一郎と小枝との結婚を祝う電報をうったなかに伸子はハハノケンコウノタメアメリカケイユデコラレヨと云ってやった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五ヵ年計画第三年目完成ノタメニ諸君用意シロ！",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デハ、ワタシ、アナタノタメニ唄ヲウタッテ上ゲル、コノ手風琴デ、世界ノ国々ノ、港々ノ唄ヲウタッテアナタヲ慰メテ上ゲルデス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サ、ワタシ、オ嬢様ノタメニ、世界ノ国々ノ、港々ノ唄ヲ何デモウタッテ上ゲルデス、オ望ミナサイ、外国ノ唄オイヤナラ日本ノ唄、ワタシタイテイデキルデス、八重山、越後獅子、コンピラ船々、追分、黒髪、何デモオ望ミナサイ」と言ってマドロスは、立って一方の隅から手風琴を提げて来ました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのたわけ物語の書出しに、「オレホドノ馬鹿ナ者ハ世ノ中ニモアンマリ有ルマイト思ウ故ニ、孫ヤ彦ノタメニ話シテ聞カセルガ、ヨク不法モノ、馬鹿モノノイマシメニ話シテ聞カセルガイイゼ」と言っている通り、馬鹿も度外れの馬鹿になっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
