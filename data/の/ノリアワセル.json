    "definitions": [
      {
        "index": 1,
        "gloss": "to happen to ride together",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
