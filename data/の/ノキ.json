  {
    "uuid": "f6077fb7-bff4-5a09-9a4c-86719cb09ac8",
    "entry": "ノキ",
    "reading": {
      "primary": "のき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "熔岩の岩盤からは、白糸のようにさばかれた千筋のたき津瀬がたぎり落ちて、どれが道やら、わらじやら、ミヤマハンノキやら、無分別になった。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの、（リノキ、チツキテビー）よ。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斜面に根を張ったエノキは左右に大きく枝を広げ、窓の向こうの五階の廊下にまで少し先をのぞかせていた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の向こうに一つの傘におさまったバアサンと女の子が消えていくのを見届けてから、オレはエノキの葉についたしずくをバシバシ払いながら五階の廊下を歩いた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "七ジノキシヤデオイデマツ。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "小鳥たちは、トチノキのこずえにとまって、ピーチク、ピーチク、さえずっていました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "日の光は形円きトベラノキに遮られて空気｜冷やかに風うすく匐ひくねれるサンザシに淡紅緑の芽は蕾み、そのもとに水仙の芽ぞ寸ばかり地を抽きてうち戦ぐ。",
              "citation": {
                "source": "春の暗示",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "巣は懸る、高くのみ、ウメノキゴケ、気色のみ、母鳥や姿、羽ぶり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "巣は懸る、高くのみ、ウメノキゴケ、氣色のみ、母鳥や姿、羽ぶり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に見たとき、この土地には二軒しか建物がなく、セイタカアワダチソウや、アキノキリンソウばかりがめだった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側はトド丸太の桁、アカダモの縁ぶち、並びに板、蝦夷松及びヒノキの垂木。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "┌ツツジ├ヒノキ苗└散松葉墓碑、（自然石）“降るとまで人には見せて花曇り”（井月にふさはしい）墓石、“塩翁斎柳家井月居士”俗名塩原清助位牌、“塩翁院柳家井月居士”夕日をまともに、明るく清く。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "カハノ　キシニハ　ハンノキガ　シゲツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンノキノ　シタデ　オカアサンノ　タヌキガ　コドモノ　タヌキニ　バケル　コトヲ　ヲシヘテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ハンノキノ　シタニ　コロガツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが同じ熊野でも安堵峰辺で自ら聞いたは、山神女形で、山祭りの日一山に生えた樹木を算うるになるべく木の多きよう一品ごとに異名を重ね唱え「赤木にサルタに猴滑り」（いずれもヒメシャラ）「抹香、コウノキ、コウサカキ」（皆シキミの事）など読む。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "オガタマノキは、神道に古く因縁深き木なるが、九州に自生ありというが、その他に大木あるは紀州の社地のみなり。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツグノキ、バクチノキなどは半熱帯地の木で、田辺付近の神林にのみ多かりしが、合祀のため今わずかに一、二株を存す。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
