[
  {
    "uuid": "04392161-3863-5cea-980f-f150a0d5c676",
    "entry": "軒",
    "reading": {
      "primary": "のき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
