        "examples": {
          "standard": [
            {
              "text": "イベント会場には、色とりどりののぼり旗がたなびいていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "道の駅の前に、地元の特産品を宣伝するのぼり旗が立てられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "商店街の活性化のため、新しいデザインののぼり旗を制作した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "武運長久を願ってのことだが、五月雨に濡れそぼり、染色を流したそれらののぼり旗は暗い木下蔭で、幽霊じみて見えた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
