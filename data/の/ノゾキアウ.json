          "literary": [
            {
              "text": "人と人とは互いに心を覗き合うことを恐れている。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘達は籠を覗き合う。",
              "citation": {
                "source": "顔",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "九　自分で人を食えば、人から食われる恐れがあるので、皆疑い深い目付をして顔と顔と覗き合う。",
              "citation": {
                "source": "狂人日記",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、そのまま二人は、お互の目の中を覗き合うようにして、いつまでも黙り込んでいた。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
