        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ホンヤクノコトデ　タノミアルスグ　キテクレ」　彼は、わたしの部屋の壁、ライフル銃もロビンソンもオルゴールも、ペナントも、昆虫標本の額も、みんなどこかへ棄てられて、それらのものゝかゝつてゐた痕だけ白い壁に、途徹もない論文の抜き書ばかりが落書されてゐるのを発見した。",
              "citation": {
                "source": "幽霊の出る宮殿",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本帝国　東京　大関久五郎　地理学を修むる者　此宿ノ人ノ話ニ拠レバ、コレ迄吾日本帝国民ニシテコヽニ泊ッテ Jungfrau ニ登ツタ人ハ無イトノコトデス、本当カウソカハ私ハ知リマセンガ、兎ニ角コヽニ吾邦人ニシテコノ後コヽニ来リ宿ル方ニ対シ御免ヲ蒙ツテ私ノ名ヲ日本語デ書イテ置キマス。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　オマツリニジブンノ　キルキモノト、コドモタチニ　キセルキモノノコトデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノオマツリニ　ジブンノ　キルキモノト、コドモタチニ　キセルキモノノコトデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ前ノ木エウ日ノコトデシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬘ヲツケタマヽ舟底形ノ枕ニ寝、暗イ部屋ノ褥ノ中デ、友禅ノ長襦袢ヲ着テノコトデハアルガ、実ニ異常ナ技巧ヲ持ッテイタモノデ、マコトニ不思議ナ経験デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモノコトデ珍シクモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春久ガシャワーヲ浴ビニ来サセテクレト云ウノハ、タヾソレダケノコトデナク、何カ魂胆ガアルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩ヤ肘ヤ膝頭ガ僂麻質ノヨウニ痛ムノハ前カラノコトデレスリーノセイデハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ノコトデスカラ多少ノ変化ハ已ムヲ得マセンガ、コノ前測ッタ時ト比ベテ異状ハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ御老人ノコトデスカラソノ御辛抱ガ辛イト仰ッシャルノモ無理ハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤットノコトデ出テ見タラ三島ニ近クナッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鑿ト云ウノハアノコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
