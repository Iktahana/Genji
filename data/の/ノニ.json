  {
    "uuid": "92482790-6375-5d23-8594-e6321783103c",
    "entry": "ノニ",
    "reading": {
      "primary": "のに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "甚だしきは、かつてニイチェズムの名が、本能主義や享楽主義のシノニムとして流行した。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうしたイメーヂの聯絡は、極めて飛躍的であり、突拍子もない荒唐のものに思はれるだらうが、作者の主觀的の心理の中では、その二つの言葉をシノニムに結ぶところの、歴とした表象範則ができてるのである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ深イ慾モ捨テルトヨイノニ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はベグノニアの花園を踏んで商業的騒音に生きる、商権の雑音を愛した。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術家ハ、イツモ、弱者ノ友デアッタ筈ナノニ。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "星と菫だって、シノニムじゃないか。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花のアントはね、……およそこの世で最も花らしくないもの、それをこそ挙げるべきだ」「だから、その、……待てよ、なあんだ、女か」「ついでに、女のシノニムは？",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「罪と空腹、空腹とそら豆、いや、これはシノニムか」　出鱈目を言いながら起き上ります。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしも、あのドスト氏が、罪と罰をシノニムと考えず、アントニムとして置き並べたものとしたら？",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔沃度ノニホヒフルヒ来ス〕沃度ノニホヒフルヒ来ス、　　　青貝山ノフモト谷、荒レシ河原ニヒトモトノ、　　　辛夷ハナ咲キ立チニケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしこれはＡ語一つに対するＢ語に同じｉ級のシノニムが他にないと仮定する場合で、もしシノニムがそれぞれ si 個ずつあるとすればこの確率は si 倍に増加する。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしここでは最も簡単な場合として、同数シノニムというまでにとどめると結局ＡＢ両国語彙一般の比較によって得らるべき純偶然的一致の確率は、P = s1a1b1ν + s2a2b2ν2 + s3a3b3ν3 + ……で与えられるはずである。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお、もしも、シノニムの数が、上記４の二倍であるとすれば、以上の百分値はやはり二倍になるだけであるから、このほうから結果の桁数に著しい影響は起こらない。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）私ノ町ノ知的素養ノイクブンナリトモアル青年デモ、自分トイウモノニツイテ思イヲメグラス人ハ少ナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "△ホントウとアタリマヘとはシノニムである。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "（孤高といふやうな言葉は多くの場合に於て夜郎自大のシノニムに過ぎない。",
              "citation": {
                "source": "草木塔",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ　オドロキガ　トマルト、「イマノ　フトイ　コヱハ　ダレデセウ」「キツト　オソロシイ　モノニ　チガヒナイネ」ト　ヒソヒソ　イヒアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナンダ　カナヅチカ、オンナジヤウナ　カタチヲ　シテ　ヰルガ、フエハ　ヨイ　オトヲ　タテヽ　ナルノニ、カナヅチハ　ナンニモ　ナラナイ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フエフキハ、タカイ　トコロデ　ハタライテ　ヰル　ダイクノ　テニ　カナヅチガ　ニギラレテ　ヰルノニ、ハジメテ　キガ　ツイタヤウニ　オドロキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチデハ　トウサン　トツテモ　ヤサシイノニ　ガクカウデハ、ドウシテ　コンナニ　キツイノダラウ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　ワカイノニ　オトウサンモ　オカアサンモ　キヨウダイモ　ナク、ホントウニ　ヒトリボツチデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンザシヲ　ジブンノ　モノニ　シタイト　オモヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルホド　マルイ　トコロヲ　ミルト　ケイキキユウノニ　チガヒ　アリマセン。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧富ヲ無視シタル劃一的平等ヲ考フルコトハ誠ニ社會萬能説ニ出發スルモノニシテ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ眞個父兄的愛情ヲ以テ、斯ル短時日間ニ此ノ道義的使命ヲ果タシ、以テ異民族ヲ利得ノ目的トセル白人ノ所謂植民政策ナルモノニ鐵槌一下セザル可カラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ傭兵ト獨逸ノ徴兵トノ優劣ハ實戰ニヨリテ立證セラレタルモノニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
