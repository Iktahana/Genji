[
  {
    "uuid": "7806a88a-b61d-522e-a040-76255437f7df",
    "entry": "野太鼓",
    "reading": {
      "primary": "のだいこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
