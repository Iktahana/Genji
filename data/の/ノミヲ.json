          "literary": [
            {
              "text": "「註」ハ固ヨリ説明解釋ヲ目的トセルモ、語辭悉ク簡單明瞭、時ニハ只結論ノミヲ綴リシ者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ土地問題ハ單ニ國内ノ地主對小作人ノミヲ解決シテ得ベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "體育ヲ丹田本位ト決定スル所以ハ、只肉體ノ一面ノミヲ見ルモ根本的體育タルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド故サラニ穢ナゲナル物ノミヲ喜ビ選ンデ、其ノ形ノ極メテ見悪クキヲ取ル人有リ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那ノ古物ヲ愛スル人ニテ、本邦ノ古器ヲバ和臭有リトシ、又本邦ノ物ノミヲ玩ンデ、外国製ノ物ハ観ルヲモ厭フ輩モ無キニ非ズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ一証ヲ申サバ、日本古代ノ鋳銭ハ僅カ十二種ナレド、其レサヘ識ラヌ者多ク、却テ支那ノ半両五銖ノ類ノミヲ古イ銭ナリト思フ人ノミ有リキ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来ノ殺害目的者ニ対シテハ、殺害ノ予告ノミヲシテ方法及ビ期日ヲセザリシ為メ普通月並ナル脅迫状位ニ思フテ覚梧（死ノ）モセズ、遺言モセズ、不意ニ我党ノ手ニ掛リ、卑怯ナル不敏ナル最後トナリシ者アリシニ付キカク明ラカニセリ。",
              "citation": {
                "source": "編輯室より（一九一三年六月号）",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實驗ヲ主トスルハ言ハズトモ知レタル事ナレドモ、只管ニ歐洲ノ事ノミヲ主トシテ、本邦ノ利害得失ヲ審カニシ、本邦並ニ亞細亞東方ノ歴史、人情、風俗ニ通ジ、殊ニハ又自己ノ經歴、體驗ヲ主トスル事ナリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "北亞米利加ノ南部ヨリ南亞米利加ノ北部ニ掛ケテ古代開化國ノ存在セシ證跡甚ダ多ク、諸建築諸彫刻ノ外形ノミヲ見ル時ハ殆ト「ヱジプト」ノモノニ亞グガ如キ觀有リ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
