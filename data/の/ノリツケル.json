[
  {
    "uuid": "2a6f447d-25f5-582c-802f-e558efaaaea2",
    "entry": "乗り付ける",
    "reading": {
      "primary": "のりつける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
