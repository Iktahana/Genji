    "definitions": [
      {
        "index": 1,
        "gloss": "to arrive (by car, bike, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "豪華なリムジンがホテルの前に乗り付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はスポーツカーを乗り付けると、颯爽と店に入っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "仕事帰りに友人の家に自転車を乗り付け、少しだけおしゃべりをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ポルチコ型の玄関先へ乗り付けると、私はその屋敷を正面から見やった。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二の二　三四郎は、しばらく先生の後影を見送つてゐたが、あとから、車で乗り付ける人が、下足の札を受け取る手間も惜しさうに、急いで這入つて行くのを見て、自分も足早に入場した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人が白昼自動車でのりつけるなんて。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆さんはトラックをのりつける。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰が先にその求人の事務所に乗りつけるか、まるで自転車競走です。",
              "citation": {
                "source": "褐色の求道",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが玄関の戸口に乗りつけると、その前面は、テニスコートの横であったが、黒い戸の建物と、台の上に乗っている日時計が目に止まった。",
              "citation": {
                "source": "暗号舞踏人の謎",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅館は新宿のカフエ街の垠れの細かい小路にあったが、いつか一度泊まったこともあるので、すぐ円タクを手前まで乗りつけることができたが、車をおりて前まで歩いて行くと、上から葉子の呼ぶ声がした。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "――急ぎに急いで、察しの通りまだカンカンと灯をともしている糸屋六兵衛方の店先へ乗りつけると、これがまたわるくないのです。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもゆっくりでよいぞ」　のみならず、八丁堀のそのお組屋敷へ駕籠を乗りつけると、意外や事件にさじを投げてしまったといったような面持ちで、ぬくぬくと置きごたつの中にはいりながら、草双紙かなんかをべらべらとやりだしたものでしたから、当然のごとくに口をとがらしました者は伝六でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒色のくちびる",
                "note": "青空文庫"
              }
            },
            {
              "text": "――まだそんな門限の刻限ではないのに、さながら退屈男の乗り込んで行くのを看破りでもしたかのごとく、奥平屋敷の江戸詰藩士小屋を抱え込んだお長屋門が、ぴたりと閉じられてありましたので、乗りつけるや、怒髪して退屈男が呼び叫びました。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　時刻はすでに四ツを回って、普通ならばとっくに寝ついているべきはずでしたが、昼の大売り出しの勘定がつかないとみえて、まだ生島屋ではいずれもが起きていましたので、右門はかって知った内玄関のほうへ駕籠を乗りつけると、案内も請わずにずかずかと門内へはいっていきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいらもう尾っぽを巻いて小さくなっているから、ひとっ走りにやってくんな」　走らせて景気よく永住町のその大園寺へ乗りつけると、ものごし態度の鷹揚さ、あいさつ口上のあざやかさ、まことにみずぎわだった男ぶりです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "２　もちろん、北松山町を目ざしたからには、お駒の住まいの岩吉店へ乗りつけるだろうと思われたのに、しかし、捜し捜し訪れていったところは、意外なことにも音蔵の住まいでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に北陵から帰りがけに、宿近く乗りつけると、左り側に人が黒山のようにたかっている。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎は、しばらく先生の後影を見送っていたが、あとから、車で乗りつける人が、下足札を受け取る手間も惜しそうに、急いではいって行くのを見て、自分も足早に入場した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、娘の親たちへ知らせなければなるまい……というので、とりあえず青年会員が二人、娘のうちへ自転車を乗りつけると、晴れ着をホコリダラケにしたその娘が、おやじに引き据えられて、泣きながら打たれている。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いがけなく、まるで天からでも降って来たように、不意にリンリンと鳴る鈴の音が聞こえ出すと、やがてこの家の玄関へ乗りつけるらしい馬車の車輪の音がはっきり聞こえて、それから、ついに停ったらしい三頭立の癇の立った馬の荒い鼻嵐と重苦しい息切れが部屋の中まで響いて来たのである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かしらぴいんと来るものを感じたガフは、直ぐその足で問題のハイランド・アヴェニウの家へタクシを乗りつける。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車で乗りつける人もある。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは小船を島に乗りつけると、桃林の中に毛布や、茣蓙を敷いて、ひょうたんの酒を汲み交わした。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり馬を乗りつけるのも、ちょっと気が咎めるからね。",
              "citation": {
                "source": "三つの悲憤",
                "author": "――近代伝説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラックで乗りつける団体などもあった。",
              "citation": {
                "source": "山上湖",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもその代わり、ドゥーネチカの無実を心底から信じ切って、さっそくあくる日ちょうど日曜だったので、いきなり町の中央公会堂へ乗りつけると、ばったり床に膝を突き、どうかこの新しい試みに堪えて、自分の務めを果たすことのできますよう、力を与えてくださいましと、涙ながら聖母マリア様に祈りました。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　わたしはもう前の日から、自分が第一番に乗りつけるのを承知していた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちも礼装して自動車を乗りつける。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでこうして自家用自動車を自家用運転手に運転させて巴里からすっ飛ばして来たもののごとく見せかけてホテルの玄関へ乗りつける必要があったのだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひたひたと漕ぎつけて来て、桟橋の際へ素気なく乗りつけると共に、乗組の者が、バラバラと岸へ飛び移ったことの体が尋常ではありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして毬栗と筒袖とを風に靡かせながら、一文字に鷲をめがけて乗りつけるのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちよつと、外から家を見たいから……」　十町あまりの道を、急がせて、門まで乗りつけると、梨枝子はそこにゐなかつた。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぢや、考へてもきりがないから、よかつたら、これだけ残して、あと、その値段で持つてつてちやうだい」二　大都市の真珠専門の宝石店へ一台の新型自動車が乗りつける。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
