        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎日バイクに乗っているうちに、すっかり乗り付けるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この自転車は少し特殊な形をしているが、すぐに乗り付けるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "初めての馬だったので不安だったが、調教の甲斐あって少しずつ乗り付けてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
