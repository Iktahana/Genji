        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ロダンさんはコート・ダジュールの華美なノアイユ旅館から、度々妾のお芝居を見にいらっしゃったのだそうです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "若さを喪失することにある悪は、フランスの貴族的な女詩人マダム・ノアイユが詠歎したような哲学的な哀愁ではなくて、きわめて現実に人間の善意に対して無反応になったり、嘲笑的になったりすることである。",
              "citation": {
                "source": "ものわかりよさ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（７）　一八九六年三月一日、ノアイエンに於いて。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノアイダ、オクッテ、クダサッタ、ハナノクスリ、オツイデノトキニ、スコシオクッテクダサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語も達者だつたけれども、佛蘭西語もうまくて、時々ノアイユ夫人の詩なんかを譯して生徒に讀んできかせる粹なところもある先生であつた。",
              "citation": {
                "source": "婚期",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノアイダ、オクツテ、クダサツタ、ハナノクスリ、オツイデノトキ、スコシオクツテクダサイ、センジテノムト、ノボセガ、ナオツテ、カホリガ、ヨロシイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して今夜｜此稿を書いて居ると、氏の手紙が届いて、早速僕等夫婦の為に書かれた女詩人ノアイユ公爵夫人｜其他への紹介状が同封せられてあつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メーターない taxi ばかり故イズボーシチクにのってノアイユ〔ホテルの名〕へ行く。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルセーユの駅からホテル・ノアイユへよって、パリの日本大使館のムシュウ・マスナガが契約しておいた部屋と云って一応たしかめておいてから、埠頭へ迎えに行けばよいだろう。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子はそう決心して、マルセーユのホテル・ノアイユの一晩を、早くから横になった多計代のベッドのわきにいて過したのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテル・ノアイユへ着いてひと休みし、和一郎と小枝とが自分たちの室へひきとってゆくと、多計代はそれを待っていたように、「お父様、すみませんが、あれを出して下さいまし」と、泰造に云った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノアイユでの午後に見られたいくつかの情景――たとえば、マルセーユ市街見物に泰造と和一郎が出かける。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ホテル・ノアイユには、その日カトリ丸から上陸するとすぐにパリ行の列車へのってしまわなかった、幾組かの日本人がとまっていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代でも詩人のノアイユ夫人。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロダンのノアイユ夫人などは最も優れた作の方で、この高雅な女流詩人の精神と肉体との美が遺憾なく表現されていて、それを見ていると人間の誇を感ずる。",
              "citation": {
                "source": "自作肖像漫談",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルセーヌ・ルパン二　スパルミエント大佐は、フェイザンドリイ街とジュフレノアイ街の角にある邸宅をかまえた。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一番に、庭の方に向いている、家の正面だけを警戒したら足るようにと、裏の方のジュフレノアイ街に向いた方は、下から上まで、窓も入口もすっかり壁を塗りつぶしてしまった。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その窓はジュフレノアイ街に向いていたから。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュフレノアイ街にはピストルを上げて、すわと云えば一斎射撃、窓々をねらっています。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕があれほど言ったのに‥‥ジュフレノアイ街の方だ‥‥』　ガニマール刑事は怒りの歯噛み荒々しく、『それなら、なぜ射ち留めないだろう？",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノアイユ夫人の小説「｜玉の顔」を通読す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳田君によれば、ノアイとも、川原乞食とも呼ぶことがあるという。",
              "citation": {
                "source": "サンカ者名義考",
                "author": "――サンカモノは坂の者",
                "note": "青空文庫"
              }
            },
            {
              "text": "空はノアイユ夫人が形容したような子供らしいすき透った青さで、むこうの黒い森のうえに議事堂の塔が薄月の光をうけて白く立っている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "すごい｜お夜食で、ノアイユ伯爵夫人の夜会のようだったわ」　ママがパパと眼を見あわせながらいった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスの航空大尉の軍服を着たシゴイさんのパパは、短い口髯をはやした、シゴイさんとそっくりなやさしそうな感じで、ママのマダム・ジャネットはノアイユ伯爵夫人によく似た悧巧そうな方だった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のように骨を折って、今晩のように手はずをきめて、ここにきてる人たちを見てもわかるとおり万事うまく仕組みをした以上は、わずかデノアイエ料理店で十五スーの赤い奴を飲み肉をつっつくぐらいの金じゃすまされねえってことは、お前さんにもわかるはずだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "モカノアイスクリームト冷紅茶デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "端ナクモ、過グル頃ヨリ敵味方トワカレ、矢石ノアイダニ別ルルモ、旧情ハ一日トテ、忘レタコトハナイ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
