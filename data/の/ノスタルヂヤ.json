        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "・けふの散歩は蜩ないて萩さいて・かんがへがまとまらないブトにくはれる・山のいちにち蟻もあるいてゐる何だかノスタルヂヤにでもかゝつたやうだ、これも造庵や生活やすべてがチグハグになつてゐるせいかも知れない。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "漂泊の旅にはつねにさだかに捉へ難いノスタルヂヤが伴つてゐる。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊かなノスタルヂヤの中に馬鹿！",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里で嗅げば、これもノスタルヂヤの種だ。",
              "citation": {
                "source": "アトリエの印象",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "織田が二流文学といふときには、一流文学へのノスタルヂヤがある。",
              "citation": {
                "source": "大阪の反逆",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽の記憶われに宿れば、怪しき律のうごきはノスタルヂヤのわが胸に昔を覚す。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
