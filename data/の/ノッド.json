        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アンリ・デュヴェルノア、ジョゼフ＝ルノー、ピエール・ミール、アンドレ・ワルノッド、モーリス・ルヴェルの五人のフランスの作家のものを英訳したものだ。",
              "citation": {
                "source": "ウイツテ伯回想記その他",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "これをシノッドという。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまたのシノッド相合して大会議区を組成す。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストーコオが正直な臨床報告を出すと、総督派のアーノッドがかならず反対報告をするので困るという。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度またアーノッドにひっくりかえされると、非常に苦しい立場になるから、一緒に行って立会診察をしてくれという。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "六ちゃんは電車へ乗り、まず名札を札差に入れ、ハンドルをコントローラーのノッドへ篏め込む。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
