[
  {
    "uuid": "3c1f0421-a396-5b69-ac8c-f444f5b74c1e",
    "entry": "野良",
    "reading": {
      "primary": "のら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
