          "literary": [
            {
              "text": "しまいには錦絵まで出来て、西郷｜桐野篠原らが雲の中に現われている図などが多かった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "石榴口には花鳥風月もしくは武者絵などが画いてあって、私のゆく四丁目の湯では、男湯の石榴口に水滸伝の花和尚と九紋龍、女湯の石榴口には例の西郷桐野篠原の画像が掲げられてあった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治のはじめには七八町しか隔たらぬ坂井の村が、野篠で見えなかつた。",
              "citation": {
                "source": "筑波ねのほとり",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
