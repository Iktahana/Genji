        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンニモシナイ、コレダケノモノ、キレイデショ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒ハ酔フタメノモノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち「脳髄ソノモノ」が「脳髄ソノモノ」を追っかけまわすという……宇宙間最高の絶対的科学探偵小説なんだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……のみならず……その脳髄自身は、ソレ自身がトテモ一キロや二キロの物質の一塊とは思えないほどの超科学的な怪能力、神秘力、魔力を上下八方に放射して、そうした科学者たちの脳髄ソノモノに対する科学的の推理研究を、片端からメチャメチャに引掻きまわしている。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在カタカナガ一般ニ使ワレテイルノハ数学書、法律書、官報、軍関係ノ書類ナドデアルト思ウガ、イズレモ最モ正確ヲ期セナケレバナラヌ種類ノモノバカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『近年村々ヘ浪人体ノモノ参、合力ヲ乞、ネだりヶ間敷儀申モノ数多有之候間、右体ノモノ召捕候ハバ、直ニ訴可』――合力もするな、捕えて突き出せ、こう残酷に命じているのだ。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "材料ノ不足ニヨリテ意ノ如キ波長ノモノヲ作ルコトヲ得ザルコトヲ発見シタルトキハ絶望ノ泪ニ暮レタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒褐色ノ煙ノ柱徑一町以上ノモノガ天ニ沖シ、中空以上ハ擴ガツテ雲ノヤウデアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ内ニ音ガ小サクナリ、風モ治マリ、柱状ノモノモ以前ノノヤウニ明瞭ニハ見エナクナツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、自分の原子ガ別ノモノニナッタトキ、自覚シナイカラツマラナイ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ甘ジテ之ヲ為ス所以ノモノハ洵ニ国家生民ノ為ニ図リテ一片ノ耿耿竟ニ忍ブ能ハザルモノ有レバナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣裳ハ寒暑ヲ凌グ計リナレバ曝ス可キ程ノモノトテハ無シ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼汝ノ吾徒ニ幸スル所以ノモノハ、即チ吾徒ニ禍スル者ト謂フモ亦タ不可ナル莫ランカ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "或者ハ、耶蘇ノ面貌ヲ以テ、醜悪ニシテ、怖ルベキ勁烈ノモノトナシ、或者ハ、温厳兼ネ備ヘタル秀麗ノ君子人トナス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、アナタ、モウ、ワタシノモノアリマス、逃ゲラレマセン」「ばかにおしでないよ、お前さんなんて、ウスノロのくせに」「アナタ、モウ、ワタシニ許シタデス、ワタシモウ、アナタ離サナイデス」「しつこい奴ね」「アナタ、ワタシノモノデス」「あ、畜生！",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、彼ニ従フトコロノモノモ、屈強ナル壮年男子ニ限リタレドモ、コノ信神渡航者ノ一行ニハ、オヨソ信仰ヲ共ニスル限リ、老幼男女ノアラユルモノヲ抱容スルコトヲ許サレタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「翌日、拝領屋敷ヘ行ッテ、家主ヘ談ジテ金子二十両借リ出シテイロイロ入用ノモノヲ残ラズ拵エテ、十日目ニ出勤シタ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "挑みかかり、ムシャぶりかかるような食い方は、いくら空腹の時でも、サシミだのスノモノなどを相手に人間はしないものである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "道頓堀罷り通る",
                "note": "青空文庫"
              }
            },
            {
              "text": "爆心地の記念館には、昭和二十四年度訂正として、死者（検視済ノモノ）　七三、八八四名行方不明　　　　　　　　一、八八七名重軽傷者　　　　　　　七六、七九六名とありました。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ淫肆放縦ニシテ獲ル所ノモノハ直ニ濫費シテ惜シマザルモノアリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "古墳ノ掃苔ニオケルヤマタ彼ハ専ラ尾陽所在ノモノニノミ精シキコトアタカモ我ノ東都ニ限ラレシニ似タリトイフベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ニオイテカ彼ニナキ所ノモノ往々我ニアリテ我ニ闕キシ所ノモノ彼｜悉クコレヲ補ヘリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "以て当時この犬神人に対して、サカノモノの語が普通に用いられたことを知るに足ろう。",
              "citation": {
                "source": "サンカ者名義考",
                "author": "――サンカモノは坂の者",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてそのサカノモノがサンカモノと呼ばるるに至ったのは、極めて自然なる転音と言わねばならぬ。",
              "citation": {
                "source": "サンカ者名義考",
                "author": "――サンカモノは坂の者",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日浮浪民の事を、地方によって「サンカモノ」と云うのは、「坂の者」の転訛で、サカノモノがサカンモノになり、転じてサンカモノとなったのである。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
