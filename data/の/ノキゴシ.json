          "literary": [
            {
              "text": "旅人甲は碗を持ったなりに、旅人乙は煙管を口から離して、ちょっと体を前屈みにし、涼亭の軒越しに眼をやる。",
              "citation": {
                "source": "涼亭",
                "author": "――序に代へて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀吉は、手を拭きながら、軒ごしに月の位置をながめ、佐吉、助作の二小姓を顧みて、「お汝らも、寝たか」　と、訊いた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            }
          ]
