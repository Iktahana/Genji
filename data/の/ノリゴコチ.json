[
  {
    "uuid": "8721f269-78bb-53aa-a62e-9dca22fdded7",
    "entry": "乗り心地",
    "reading": {
      "primary": "のりごこち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
