    },
    "definitions": [
      {
        "index": 1,
        "gloss": "one's feeling while riding",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この車の乗り心地は最高で、長距離運転でも疲れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新幹線の乗り心地は静かで快適なので、すぐに眠ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古いバスだったので、乗り心地はあまり良くなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "初めて牛に乗ったお杉は、案外に乗り心地のよいのを喜んでいた。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一分ののちには一同、乗り心地のよい四輪のランドー馬車に座を占めて、趣あるデヴォンシアの古風な街並みを揺られて進んだ。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つて、路の高低などが一致しなくつて、車の乗り心地が頗ぶるわるい。",
              "citation": {
                "source": "初冬の記事",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち乗ればもう直参千二百石、京弥をつれての道中も悪くないが、乗り心地もまた悪くない。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "古くなつて乗り心地でも悪いのか、杉田が恰で顧みなかつたので樽野は、始終これに乗つて、あの日以来あのやうに彼方此方と駆け回つたのである。",
              "citation": {
                "source": "Ｆ村での春",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲平は六尺位の大男で太良は五尺足らずの小男であったから、随分乗り心地の悪い駕籠であったが、私には彼等に担がれていくのが何よりも楽しみであった。",
              "citation": {
                "source": "私の子供時分",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうですか乗り心地がいいでしょう」彼は私たちを下ろしながら云った。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手の平野を越して、羽黒、湯殿、月山、三山の重なりを見ていると、それと自然に対抗したくなって来る鞍乗り心地で、むかしこの地を本陣とした西羽黒の対立心が、向うの東羽黒に敗れ、滅亡の因を作ったことも頷かれる眺望である。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "駕籠の乗り心地は思ったよりも好い。",
              "citation": {
                "source": "長江游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗り心地は、いかがですな」　そういっているのは、外ならぬ沖島速夫であった。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、地底戦車の乗り心地をうかがっているだけです」　沖島速夫は、えらいことを、やってのけた。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時諸君はなるべく乗り心地のいい円タクを選ぶであろう。",
              "citation": {
                "source": "音楽界の迷信",
                "author": "兼常清佐",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗り心地のいい円タクは、音のいいピアノである。",
              "citation": {
                "source": "音楽界の迷信",
                "author": "兼常清佐",
                "note": "青空文庫"
              }
            },
            {
              "text": "頬の切れさうに冷たい風をきつて滑つてゆく橇の乗り心地はなかなか愉しく、馬の首についた鈴がチリン、チリンなりますの。",
              "citation": {
                "source": "早春箋",
                "author": "辻村もと子",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の曲がり角で、急に車が停まるとか、また動き出すとか、何か私たちの乗り心地を刺激するものがあると、そのたびに次郎と末子とは、兄妹らしい軽い笑みをかわしていた。",
              "citation": {
                "source": "分配",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "凍てたる夜深の巷を乗り行く時なぞゴム底の足袋はパタパタ音して不愉快極まりなくゴム輪は轍の砂利を輾る響せざるが故矢張初めの中は乗り心地よろしからず世の中段々いやなものが流行出したりと思いき。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかここで馬車が墜落して、乗客が残らず惨死した話を聞かされて以来、馬車も自動車も此処を通る時は余り乗り心地よくはなかった。",
              "citation": {
                "source": "三国山と苗場山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮中にまでその名が知られた逸物で、乗り心地といい、走り具合といい抜群の鹿毛で、恐らく世に二匹はいまいといわれたほどである。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　夏の朝の、ラグスビーホールあたりの河景色や、船の乗り心地を愉快に思った私は、乗りきになってそういった。",
              "citation": {
                "source": "歌う白骨",
                "author": "THE ECHO OF A MUTINY",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しどうかして御機嫌の麗しいときには頼みもしないのに「あたいが馬になつてやらう」なんといふこともあつたが、馬としては背は高し、力はあり、ぶくぶく太つて乗り心地のいい名馬だつたけれど、気がむかなくなると大将同士の組み討ちの最中でもなんでも棒立ちになつてしまふ手のつけられない悍馬でもあつた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "長老や、人々の満足そうな微笑みのうちに轎は静かに舁ぎ上げられて、ゆらりゆらりと進み始めるのであったが、その乗り心地のよさというものは！",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロケットは、たいへんのりごこちがよく、見る見る空中にとびあがり、雪をかぶっている山の上をとびこし、それから、緑のもうせんを、きちんと、ごばん目にしきつめたような緑地帯の上をはしりぬける。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "我国の各航路でも、どうかもう少し速くて乗心地のよい船をドシドシ造ってもらいたいものである。",
              "citation": {
                "source": "汽船の改良",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、川の幅一｜杯に、森々、淙々として、却つて、また音もなく落つる銚子口の大瀧の上を渡つた時は、雲もまた晴れて、紫陽花の影を空に、釣舟草に、ゆら／＼と乗心地も夢かと思ふ。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出口に無蓋馬車の用意をして来ましたから、暗くならない中に、何より先きに現場をごらんになりたいでしょうから、委しいことは馬車の中で申し上げることにしましょう」　一分間の後、私たちは乗心地のよい回転馬車に座を占めて、見馴れぬ古風なデヴォンシャの市を駆らせていた。",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう戸外は暑い、今日は一日ゆつくり遊ぶつもりだつたが、三時には戻つてきた、バス代を倹約して半分は歩いた、途上、感じのよい若いマダムを見た、山口小郡間のバスが乗心地のよいやうに、気持がよかつたことです！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが日曜の好天気にもかかわらず、平常よりは乗客が少ないので例になく乗心地が好かった。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "売春はいつも女のたそがれだ念入りな化粧がなおさら犠牲は美しいと思いこんでいる物語鐙のない馬　汗をかく裸馬レースのたびに白い息を吐くああこの乗心地騎手は眼を細めて股で締める不思議な顔でのぼせかえっている見物客遊廓で馬の見立てだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一等に乗って乗心地は日本の汽車の方が、ずっと広くて清潔である。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンクリイトで堅めた大通を柔かに走る馬車の乗心地が第一に好い。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
