[
  {
    "uuid": "b61772a8-53b5-5094-8408-fee9593e5f94",
    "entry": "野伏せり",
    "reading": {
      "primary": "のぶせり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
