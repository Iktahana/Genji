    },
    "definitions": [
      {
        "index": 1,
        "gloss": "mountain-dwelling robber",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あの山道は野伏せりが多くて危険だ」と旅人は言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "侍は、山賊ではなく「野伏せり」と名乗る者たちに襲われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "昔話には、旅人を待ち伏せる野伏せりの話がよく出てくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "野伏せり見たいな野郎で、八｜卦も祈祷も禁呪も心得てゐる上に法螺と武術の達人で」「妙な取合せだな」「菊屋の用心棒に入り込んだのは一年前、おべつか將棋の敗けつぷりが上手で、主人市十郎の御機嫌に叶ひ、今では菊屋の支配人のやうな顏をしてゐますよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "影法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、命知らずな野伏せりも魔魅も道を避けるにちがいない。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "素より其のつもりぢや来たけれど、私だつて、これ当世の若い者、はじめから何、人の命を取るたつて、野に居る毒虫か、函嶺を追はれた狼だらう、今時詰らない妖者が居てなりますか、それとも野伏り山賊の類ででもあらうかと思つて来たんです。",
              "citation": {
                "source": "二世の契",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "亦四条隆資は、河内等の野伏の混成隊を以て、生駒山方面の敵を牽制して居る。",
              "citation": {
                "source": "四条畷の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "小太郎が振向いて、声のした家を、睨むと不憫や、明日から、野伏りかあ　二人の職人が、家の中の板の間へ坐って、雨の降ってくる往来を見ながら、小太郎の振向いた顔へ、にやっと笑った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　野伏し・山伏し気質彼等は、先、人里離れた山奥に根拠を据ゑ、常には、海道を上り下りして、他の豪族たちの家々にとり入り、其臣下となり、土地を貰ひなどしたのであつたが、又中には、其等の豪族にとつて替つたものなどもあつた。",
              "citation": {
                "source": "ごろつきの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖の形の野伏し群と、少数の遊行聖と。",
              "citation": {
                "source": "小栗判官論の計画",
                "author": "「餓鬼阿弥蘇生譚」終篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "武士の語以前、野伏・山伏等の語があり、これは仏教上の修行者です。",
              "citation": {
                "source": "無頼の徒の芸術",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この野伏・山伏が脱離して武士の語が出来たのではないかと仮に考へてゐます。",
              "citation": {
                "source": "無頼の徒の芸術",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "今までこの深い山々谷底を野伏同様の姿で道行をして来た仲じゃありませんか、あたしの身になっても、あたしの家と名のつくところで、一晩でもあなたを泊めて上げたい、そうしなければ、あたしの胸が納まらない、あたしの意地も立たないわよ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "手ごわいと見てとってか、今度は、高野山から雪曽という人相見の法印を呼びよせ、端午の節句の当日、家中列座のなかで、源次郎さまの相は野伏乞食の相であると憚りもなくのべさせるという乱暴。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "野伏大名",
                "note": "青空文庫"
              }
            },
            {
              "text": "『野伏大名』のときの例もあるでしょう、突っぱらずに、あたしの言うことを聴いてください。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "かごやの客",
                "note": "青空文庫"
              }
            },
            {
              "text": "石垣の中、土手の横腹、河原の熱くない石の間、そこに何物かが生きて居り、むすめだちは琴を彈き、親は野伏に出てむすめに食べさせる料をさがしてゐた。",
              "citation": {
                "source": "末野女",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "「野伏、そちが先に立て。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　あだ名を野伏ノ勝というわかい男は、もう馬を引き出していた。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして一緒にやらないのさ、野伏と一緒だからやきを廻しているのねと、すては密林がそよともしない山凪の中でいった。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも仕様がない、お前は一日ずつ女になって行くばかりで、おれはそのわかさを趁っかけている、おれの外はみなわかい男ばかりだ、殊に野伏はわかい、野伏はお前のそばに寄りたがっているし、お前は焚火の座でも野伏の向う座にすわるようにしている。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを下げて塞に戻ると、野伏の下著は野伏の物の中につき込み、袴野の物は袴野のしきりのある塞の奥にしまい込んだ。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然、袴野の小方の野伏が、立ち上っていった。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すて一人でも沢山だ、だが、小方二人あてを両方から従けさそう、しかし野伏はならぬ。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　野伏は苦り切って引き退がり、すては表には眉も眼もうごかさなかった。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、両方から小方二人ずつが従いて、都の女をすてが送ることになり、野伏ノ勝は居残ることになった。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は野伏ノ勝を思った。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "袴野は勿論野伏にも合す顔がない、なんだか合す顔がないということが、合されない顔になると考えこむと、凜乎として来た。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "わかい野伏と事をはかっておれにかかって来ることがないとも限らない、きょうは今までにない不思議な美しさを、彼はすての全面に感じた。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ以来、彼は塞の中に何時も二つの瞳が、昼も夜もぎらぎらして近寄る気にもならなかったが、ようやく、野伏ノ勝が不浄物の始末をしているのを今は見遁す気になっていた。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "野伏ノ勝は夜も昼もすてに附添ってみとりを続けたが、そんな小汚い女は汝にくれてやると、袴野はやけくそになって呶鳴った。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "全山全塞に緑の季節が来て、媼は登山し、野伏ノ勝は白鼠のようにはたらいて、ついに、すては一人のでかい赤ん坊を生み放った。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその頃には、野伏ノ勝もそばによせつけなかった。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "又は野臥り山窩にまじって。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
