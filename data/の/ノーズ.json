        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "愛車のノーズが少し上向きで、威厳のある佇まいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "犬が興奮して、私のノーズをクンクンと嗅いできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "飛行機は滑走路を離陸し、ゆっくりとノーズを上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ストーニー・ポイントの攻撃で戦死したという人もいるし、アントニーズ・ノーズのふもとで嵐にあって溺れ死んだという人もおるがね。",
              "citation": {
                "source": "リップ・ヴァン・ウィンクル",
                "author": "ディードリッヒ・ニッカボッカーの遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "（クランチャー氏自身はわが主の紀元のことをいつもアナ・ドミノーズと言っていた。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドミノーズ　　二十八箇の牌子を使って二人または数人でやる遊戯。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをわがクランチャー君はアナという名の女がドミノーズを発明した年という意味だと思っていたのである。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボードの前部に体重をかけたノーズ・ライディングだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さく空中にアーチを描いた赤いボードは、ノーズから海に落ちて波間に軽く浮かんだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっと、古いけどさ、〈ガッド・オンリー・ノウズ〉は？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈トゥマロウ・ネヴァー・ノウズ〉にはじまる『リヴォルヴァー』セッションから、ビートルズのチーフ・エンジニアをつとめて、スタジオ・テクニックに革命を起こしたジェフ・エメリクが、きょうもチーフだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "変な奴が立っているから天孫一行も行悩み、天ノウズメの命という女神に命じて、お前は面勝だから、あの怪物をまるめてこいと使者に立てたのだそうだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　アメノウズメの命の子孫。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで天照らす大神は怪しいとお思いになつて、天の岩戸を細目にあけて内から仰せになるには、「わたしが隱れているので天の世界は自然に闇く、下の世界も皆闇いでしようと思うのに、どうしてアメノウズメは舞い遊び、また多くの神は笑つているのですか」と仰せられました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでアメノウズメの命が、「あなた樣に勝つて尊い神樣がおいでになりますので樂しく遊んでおります」と申しました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで天照らす大神・高木の神の御命令で、アメノウズメの神に仰せられるには、「あなたは女ではあるが出會つた神に向き合つて勝つ神である。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてアメノコヤネの命・フトダマの命・アメノウズメの命・イシコリドメの命・タマノオヤの命、合わせて五部族の神を副えて天から降らせ申しました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにアメノウズメの命に仰せられるには、「この御前に立つてお仕え申し上げたサルタ彦の大神を、顯し申し上げたあなたがお送り申せ。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
