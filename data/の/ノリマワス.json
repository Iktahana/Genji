[
  {
    "uuid": "bb7d6332-ffb2-592d-bf65-1f7256bd59ac",
    "entry": "乗り回す",
    "reading": {
      "primary": "のりまわす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
