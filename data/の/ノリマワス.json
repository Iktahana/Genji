    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to drive (a car) around",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は休日に、愛車を乗り回して気分転換している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "レンタカーで沖縄を乗り回し、美しい景色を満喫した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "父は昔、バイクを乗り回すのが好きだったと懐かしそうに話していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "わざわざ旅費を出して幾日も汽車を乗り回す必要などはないように思われる。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "野々宮君の先生のなんとかいう人が、学生の時分馬に乗って、ここを乗り回すうち、馬がいうことを聞かないで、意地を悪くわざと木の下を通るので、帽子が松の枝に引っかかる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "車へ乗つて、当もなく乗り回すより、三十分でも好いから、早く此所へ遊びに来れば可かつたと思ひ出した。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "車へ乗って、当もなく乗り回すより、三十分でも好いから、早く此所へ遊びに来れば可かったと思い出した。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "外を乗り回す人の絹帽子の光が見えた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の話、天狗煙草で通った銀座の岩谷松平君、例の宣伝半分、なんでも赤づくし、店舗も赤ペンキで塗りまくり、洋服も赤｜羅紗のフロック、帽子だけは黒のシルクハットで、一頭立ての赤塗り馬車、いつも葉巻をくわえ込み、意気揚々と自身手綱を取ってどこへでも乗り回す。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人がもっともっとりっぱな行いをするようになって、世界の人々から信用されるようになったら、そのときには日本人にも飛行機をのりまわすことが許されるだろう。",
              "citation": {
                "source": "洪水大陸を呑む",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "席亭から席亭へ自動車でのりまわすような気楽な生活ではないことが分る。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、一日に十三時間も乗り廻すので、時々目が眩んだ。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "野々宮君の先生の何とか云ふ人が、学生の時分馬に乗つて、此所を乗り廻すうちに、馬が云ふ事を聞かないで、意地を悪くわざと木の下を通るので、帽子が松の枝に引つかゝる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "仔馬、たてがみもまだ生えた許り、可愛い奴に私はまたがる、私の唯一の乗物、そいつを乗り廻す途中にはいかに大泥棒といへども風邪もひけば女にもほれる、酒ものめば、昼寝もする、すべてが人間なみの生活をする。",
              "citation": {
                "source": "小熊秀雄全集-4",
                "author": "詩集（３）小熊秀雄詩集１",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから珈琲店に時刻を移して、帰り道には街燈｜丈が寂しい光を放つて、馬車を乗り廻す掃除人足が掃除をし始める頃にぶらぶら帰る。",
              "citation": {
                "source": "妄想",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その杉山清次郎氏が、電鉄部長といふ職掌柄から、市電の操車振を見ようとして時々電車で市内を乗り廻す事がある。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "男が運転して、あちこち乗り廻す。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "章介　へえ、すると紫の袴で上野の森を自転車で乗り廻す組か。",
              "citation": {
                "source": "女の一生",
                "author": "五幕七場",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの鴨をねらって、発動機船を乗り廻すのである。",
              "citation": {
                "source": "鴨猟",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間私は、まあ焼け出されるまではと、度胸をきめて、時折、自転車を乗り廻すのを楽しみにした。",
              "citation": {
                "source": "楊先生",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだか、あんな馬に馬勒をかけて、乗り廻すなんてことを考えるのは、おそろしいような気もしました。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日都市に多く見られるのは自転車で、ハーグでは市民も官吏も自転車が多く、大臣も女王さえも自転車を乗り廻すと聞いた。",
              "citation": {
                "source": "レンブラントの国",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで、偉い人間といふのは、なんとなく勲章を沢山つけた人とか、自動車を乗り廻す人とかいふ風に考へられがちだつた。",
              "citation": {
                "source": "既往文化と新文化",
                "author": "――某氏との談話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたくしやつぱり、移民の娘らしく、珈琲畑を馬車で乗り廻すのが一番しつくりするつていふことがわかりましたの」　さう云つて、彼女は、眉を引きあげるやうにして大きく微笑んだ。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年つきグラッドロンのただ一つの歓びといっては、大きな黒馬モルヴァアクに乗って、さかまく海の浪のそばを、何処までも何処までも、何時間も乗り廻すことであった。",
              "citation": {
                "source": "髪あかきダフウト",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "――乗り廻すとはなんだ。",
              "citation": {
                "source": "墓地へゆく道",
                "author": "DER WEG ZUM FRIEDHOF",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓地へゆく道を乗り廻すとは。",
              "citation": {
                "source": "墓地へゆく道",
                "author": "DER WEG ZUM FRIEDHOF",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は小型飛行機を乗り廻すのが道楽だという。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日に十三時間も乗りまわすのでふら／＼に疲れ、時々目が眩んだ。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体この頃のように下手な素人がむやみに自転車を乗りまわすのは、まったく不用心ですよ」　その頃は自転車の流行り出した始めで、半七老人のいう通り、下手な素人がそこでも此処でも人を轢いたり、塀を突き破ったりした。",
              "citation": {
                "source": "半七捕物帳",
                "author": "少年少女の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の手許には、どじを踏んだ時の用心にもと隠しておいた僅々一万ルーブリの金と、オランダ製のシャツが二ダースばかりと、よく独身者が乗りまわすような例の小型の半蓋馬車と、二人の農奴――馭者のセリファンに従僕のペトゥルーシカ――とが残っているだけであった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　東京湾で舟を乗りまわすのは面白い。",
              "citation": {
                "source": "女人禁制",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗りまわすといっても、和舟にモーターのついた、舟宿から出してくれるあれだ。",
              "citation": {
                "source": "女人禁制",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
