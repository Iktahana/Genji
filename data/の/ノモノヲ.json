        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "材料ノ不足ニヨリテ意ノ如キ波長ノモノヲ作ルコトヲ得ザルコトヲ発見シタルトキハ絶望ノ泪ニ暮レタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「翌日、拝領屋敷ヘ行ッテ、家主ヘ談ジテ金子二十両借リ出シテイロイロ入用ノモノヲ残ラズ拵エテ、十日目ニ出勤シタ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "安永五年（1776）に刊行せられた松平君山の『本草正譌』には「万寿菊、単葉重葉アリ俗ニ単葉ノモノヲ天林花ト云ヒ重葉ノモノヲ満州菊ト云フ万寿菊ノ訛ナリ」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ大役デモ大阪ノモノデナク、江戸ノモノヲ選ンダ方ガヨカッタト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浴室ハ「婆サンノ便利ノタメ」ト称シテ純日本式ノ木製ノモノヲ、コレモ別ニ婆サンノ寝室ニ隣接サセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "店先ニ腰掛ケテ舊知ノ主人ト挨拶ヲ交シ、中国製ノ最良ノ朱墨一｜挺、小指大ノモノヲ金二千圓デ購ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番｜肝腎ナハ、―――今度コソ郁子ハスベテノモノヲ木村ニ捧ゲ尽シテシマッタノデハナイカ、ソシテ敏子ノ口ヲ介シテソノ諒解ヲ僕ニ求メテイルノデハナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨクモテツノハコノナカノモノヲ、カクシタナ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
