        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「神主の社務所に眠る小春かな」といふやうなことを大きな聲でやりながら、願念寺はノツソリと私の邸の裏門から庭傳ひに、泉水の石橋を渡つてよくやつて來た。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒繻子の襟の中へ腮を埋めるやうにして、旦那の立つて行くのを見向きもしないでゐたお光は、旦那が直ぐ下駄を穿かずに長火鉢の前へ坐つたらしい氣色を知ると、俄に濟まぬやうな氣がして、自分も後からノツソリ立上つた。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノツソリと車室を出て來るところへ、自分がこの姿で駈け寄ると、別に會釋もしないで、「よく來られたね。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして、寝てゐた土方がノツソリ起きて、旅商人を見る。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土方はノツソリ歩き出して切符を買ひ、改札口を出て行く。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……やがて紙芝居ノツソリ立上つて振返つて見てから待合の中へ入つて行く）紙芝　やあ、御免なさい。",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其處へ、ノツソリと現はれたのは、四十年配の浪人者です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "「變でせう、親分、――勘六ほどの惡黨が、人を殺した現場に、ノツソリ血だらけな匕首を持つて立つてゐる筈はないぢやありませんか」　ガラツ八にもこれ位の眼があつたのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "十七の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度其處へ、ノツソリと錢形平次が歸つて來ました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次女難",
                "note": "青空文庫"
              }
            },
            {
              "text": "手飼ひの獅子王は嬉しいね――その怪物が大玄關で魚の骨をしやぶつてゐるぜ」　無駄口をいひながらもガラツ八はノツソリと平次の前に突つ立つて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "娘と二千兩",
                "note": "青空文庫"
              }
            },
            {
              "text": "五「お早う、姐さん」「あら、八さん大層早いんですね」　平次の女房のまだ若くも美しくもあるお靜が、入口の掃除をしてゐるところへ、大きい影法師を這はせて、ノツソリと八五郎は立ちました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "娘と二千兩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどく線の太い、ノツソリした感じの人間で、何う見てもこれが有名な釜屋の支配人とは思へません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛像の膝",
                "note": "青空文庫"
              }
            },
            {
              "text": "植木の世話も結構だが、たまには出かけて見ちやどうです」　ガラツ八の八五郎は、懷ろ手を襟から拔いて、蟲齒が痛い――て恰好に頬を押へ乍ら、裏木戸を膝で開けてノツソリと入つて來ました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "火遁の術",
                "note": "青空文庫"
              }
            },
            {
              "text": "「泥鰌見たいなことを言ふなよ、可哀想に娘は泣いてるぢやないか」　八五郎はノツソリと店先へ入つて來て、張りきつたお秀の顏と、シクシク泣いてゐる、貧しさうな娘の顏を見比べて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お秀の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十そこ／＼、小意氣な男で、八五郎のノツソリとしたのとは、巧まざる面白い對照です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "吹矢の紅",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親分、八五郎親分の手紙ですが――」　お山の熊吉といふ、ノツソリした下つ引が、蚯蚓をのたくらせた、八五郎の假名文字の手紙を持つて來たのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "歎きの幽澤",
                "note": "青空文庫"
              }
            },
            {
              "text": "肝心の作松が大きな疑ひを背負つたまゝ行方不知になつて、佐吉がカンカンに怒つてゐる最中へ、錢形平次と八五郎をつれて、ノツソリと歸つて來たのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "禁制の賦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノツソリしてゐる癖に、恐ろしく慾の深い男で、馬鹿見たいな悧口者ですね」「それつきりか」「醫者の石原全龍坊主は、思つたほどの大藪ぢやありませんが、そのうちに公儀から召出されて公方樣の糸脈を引くんだなんて大法螺を吹いてゐるところをみると、あんまり信用のできる醫者ぢやありませんね。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "棟梁の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "画室で静物を描いてゐた主人の一蔵が、食事の気配を習慣で感じて、ノツソリ入つて来た。",
              "citation": {
                "source": "姉弟と新聞配達",
                "author": "犬養健",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
