    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "長さは三間あまり、全体の重量が手にこたえるほどの調子で先穂の硬い、二、三十年も使い古したと思われるような、男竹の延べ竿であった。",
              "citation": {
                "source": "想い出",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "サナギ粉をときどきまいて、六尺くらいの延べ竿にボウフラ針という針先に赤い糸のついた返しのない針を使う。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "竿は三尺から六尺までの延べ竿を、五本ぐらい用意する。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "竿は一本十銭の五、六尺の延べ竿五、六本。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "……鈎のことはくわしくしらないが、これはいずれ曰くのあることだろうと思って、川崎屋へ行ってきいてみると、青鱚釣りの坂尾丹兵衛流という流儀では、六尺五寸の一本竹の延竿を使うのが定法だという。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "鎌いたち",
                "note": "青空文庫"
              }
            },
            {
              "text": "……渚をうろうろして眺めていると、すごんだ面のさむらいが、左の手に一本竹の延竿をもって魚を釣っている。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "鎌いたち",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕掛は六厘柄のテグス三本、その先端へ鱸鈎の寸二を結びテグスから上は人造テグスの極太二十間、テグスと人造の結び目へ一匁の噛みつぶし錘をつけ、道綸の尖端を長さ七、八尺の延竿へ結びつける。",
              "citation": {
                "source": "河鱸遡上一考",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
