  {
    "uuid": "ad6a6440-7c97-5b20-aeb1-b3d297805925",
    "entry": "ノウノウ",
    "reading": {
      "primary": "のうのう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
