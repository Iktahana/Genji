    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そうした昂奮を気持よさそうに眺めやった猪村巡査は、毛ムクジャラの両手をノウノウと後頭部に廻した。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノウノウと手足を伸ばした序に、枕元に掛けた紺背広の内ポケットから匕首拵の短刀を取出して仰向になったまま鞘を払ってみた。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者もノウノウと両脚を踏伸ばして居ねむりの準備を整える事が出来た。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの下の方へ細っそりとした鋭角はノウノウとした気分でいる子供の食慾を引きつけずには置かないのでした。",
              "citation": {
                "source": "三角形の恐怖",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅行をしたらそうノウノウと、遊び廻わることは出来ないだろう、今の中に思うさま遊んで置こうと、こう思っていたからです。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなにノウノウすることか。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "姪の病室を見舞いもしないで、パンパン宿でノウノウとしている悪どさ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "顳※に凍てついた古い昔の襤褸をほぐす、丁度あのノウノウとした反芻動物のやうに、僕はウラウラとした海岸のベンチや、たまさかに翳りの深い樹の下で、一つづつ食べ直すものの如くに襤褸をほぐすのが日課であつた。",
              "citation": {
                "source": "海の霧",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一周はみんな珍しがって窓に吸いついていたが、二周目には音がないから振りむくと、一同イスにもたれ飛行機は何百回も乗り飽いてるよとノウノウたる様子。",
              "citation": {
                "source": "新春・日本の空を飛ぶ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ううん、私なぞ居ない方がかえってノウノウと飛びまわれて、いいんでしょ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "畢竟私の微力の致すところである（ノウノウ）。",
              "citation": {
                "source": "〔憲政本党〕総理退任の辞",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚だ慚愧に堪えない（ノウノウ）。",
              "citation": {
                "source": "〔憲政本党〕総理退任の辞",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故に私は諸君に向って、どうか御別れをしたいと思う（ノウノウ）。",
              "citation": {
                "source": "〔憲政本党〕総理退任の辞",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のただいまの言葉は諸君に対する告別の言葉と、どうぞご承知を下されたい（ノウノウ）。",
              "citation": {
                "source": "〔憲政本党〕総理退任の辞",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
