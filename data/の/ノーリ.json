        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ある時下宿の老嬢フロイライン・シュメルツァー達と話していたら、何かの笑談を云って「エス・イスト・ヤー・マノーリ」というから、それは何の事だと聞いてみると、「馬鹿げた事だ」という意味の流行語だという。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ雑誌にエリク・ノーリンがタリム盆地の第四紀における気候変化を調べた論文がある。",
              "citation": {
                "source": "ロプ・ノールその他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、母の妹に当たるホノーリア・ウェストファイルという叔母がハロウの近くに住んでおりまして、父もここを訪ねることだけは許してくださいます。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "見上げればイザルへはもはや簡単なスノーリッジで、テカリへはイザルへ廻らずに直接易老沢の源頭を横切っても行けそうに思えた。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "北面を見下ろすと、快適なスノーリッジが大井川西俣にぐっと延びている。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "札にノーリンと書いてあるやつだ。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ノーリスさんが円満なる友情と題する詩の美しい写本を持っていられましたが、ほんとうに立派なものだと思いました。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "ヴィール夫人の亡霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みに今記録に残る英国商船のみを辿ってみても、ノーリッジ号一万二千｜噸……ベッドフォード号九千六百噸……カウンテス・オブ・カーナヴォン号六千八百噸……バーロー号三千噸……エクゼター号七千六百噸……クィーン・オブ・サンダーランド号四千八百七十噸……指を屈するだに痛ましき犠牲の数々であった。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぐっすり寝たよ、マノーリン」老人は答えた。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マノーリン、やられたよ」彼は言った。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
