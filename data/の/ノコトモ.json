        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナゼナラバ、我輩ハ英語ニ於イテ、聞キトルコトモ、言ウコトモ、ソノホカノコトモ、スベテ赤子ノ如キデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコレ以上生キナガラエテイタトコロデ格別ノコトモナイノダカラ、モシ今ノ世ニオ伝ノヨウナ女ガ現ワレタラ、ムシロソノ女ノ手ニカヽッテ殺サレタ方ガ幸福カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝夕ノ散歩ハ佐々木同伴、時ニハ颯子ノコトモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレラノコトモ当時ノ日記ニ委シク書イタ筈デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "在府中、ソモジトノ永キ縁モ、マタ江戸出立ノミギリ、観音堂ニテ綱女ノ顔ヲ見オサメ申シ候｜夜ノコトモ、今ナオマザマザシク覚エ候エド、コノタビコソハ、阿波ニテステベキ一命、ソモジニハ、スベテヲ忘レクルルコソ、何ヨリモヨキ餞別ニコソ……。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
