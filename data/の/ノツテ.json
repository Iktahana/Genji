          "literary": [
            {
              "text": "忽ち街上より「フエリチツシイマ、ノツテエ、アントニオ」（幸あらん夜をこそ祈れ、アントニオよといふ事なり、北歐羅巴にては善き夜をとのみいふめれど、伊太利の夜の樂きより、かゝる詞さへ出來ぬるなるべし）と呼ぶ人あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ、めでたき彩繪には候はずやと云へば、夫人、見よ、雲は今「フエリチツシイマ、ノツテ」（幸ある夜を祈る）を言ふ時ぞ、と山嶽の方を指ざし給ふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ　コノ　テフテフモ　オハネガ　ジヨウブニ　ナルト　カゼニ　ノツテ　ウマヤノ　ヤネヲ　コエタリ、ヲガハノ　ウエニ　イツテ　ミタリ　シマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンガ　ノツテ　ヰテ、カキマハシタノデシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヤウサンハ　クルマニ　ノツテ　ムチヲ　フリアゲ、「シーツ」ト　イヒマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコヘノツテヨイノヤラ　ワカラナイノデ、ヤネニノリマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、玉ネギサンノ　ノツテヰル汽車ノ中ヘハイツテイツテ、席ニコシヲ下シテ、グウ　グウ　グウ　グウ眠リコンデシマヒマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ家ヲトビダシテ、アツチコツチヲアルキマシタケレドモ、ツカレテ、ダンダンネムクナリマシタノデ、自転車ニノツテ、ホテルヘユキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
