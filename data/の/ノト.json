[
  {
    "uuid": "6bc703c0-3873-5e35-98f9-5761dfcf52a6",
    "entry": "能登",
    "reading": {
      "primary": "のと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
