    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to run up onto (e.g. sidewalk)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "運転を誤って、車が勢いよく歩道に乗り上げてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "荒波に煽られて、ヨットが浅瀬に乗り上げて動けなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "自転車が段差に乗り上げて、危うく転倒しそうになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あそこは家の蔭から急に鉄道踏切に乗り上げるばっかりじゃない。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "年を取っているポピイの体は、石ころなどに乗り上げるたんび、ばらばらになるのではないかと思うほど、ひどく揺れました。",
              "citation": {
                "source": "やんちゃオートバイ",
                "author": "木内高音",
                "note": "青空文庫"
              }
            },
            {
              "text": "北浦へ入って行って、あすこで船をそうっと浜に乗り上げるつもりなんだ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、投錨することは出来ないし、潮がもっと十分に満ちて来るまでは船を浜に乗り上げる訳にはゆかなかったので、私たちは無聊に苦しんだ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "「船を乗り上げるにゃ持って来いの処があらあ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ひは暗礁に乗り上げるとも、前進、前進、前進。",
              "citation": {
                "source": "黄色い鋼鉄船",
                "author": "三岸好太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのも、半時間は浮いているでしょうが、後の半時間で岩に乗り上げるからです。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルースがさらさらの砂浜に船を乗り上げると、ガイ牧師は慌てて飛び降りて、礼も言わなかった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら大きな最新式の軍艦でも、浅瀬にのりあげるとは変なことではありませんか。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大波のうねりにまかせて漂っているうちに、フーッと波頭に乗りあげるように、はっきりすると、彼は先ずきっと、「おかあさま」と呼びかける。",
              "citation": {
                "source": "一つの芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気をつけろよ、岩が多いから乗りあげるかもしらん、そのときにあわてないように、浮き袋をしっかりとからだにつけていたまえ」　富士男は人々に注意した。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいか、すぐにかかれ」　船が、どしいん、と岩に乗りあげると同時に、船内の灯火は、全部消えた、岩にぶつかり方がはげしかったので、室内の本棚や棚から、書籍がとび出し、いろいろの器物もころがり落ちて、船室のゆかや甲板に、ごちゃごちゃになっていた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸い明日の午後アルグーインの岩礁の沖を通るはずですから、思いきってそれに乗りあげることにしましょう。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その波は表面波としての性質を失い、そのあとで海底の珊瑚礁の棚に乗りあげる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "圧倒的な量感をたたえ、すさまじいエネルギーを内部にはらんだ波は、湾の入口でいきなり急斜面の浅瀬に乗りあげる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばこの小さな湾の沖で、海のエネルギーが波のうねりとして浅瀬に乗りあげると、青い月光のもとでいまも繰り返されているとおり、百五十メートルのチューブ波が出来ては砕ける。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして黒い砂浜に乗りあげる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかに登る道があればいいが、ないとすると、この傾斜では、馬を乗りあげることがむずかしい。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗りあげる暗礁は柔らかいサンゴだし、最少の浸水で座礁する。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つの波の絶頂に乗上げると、岩と氷河で固めた恐ろしい恰好の聖エリアスが直ぐ鼻の先に浮き上る。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は半ば陸地に乗上げる。",
              "citation": {
                "source": "風景",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "大矢野島と千束島（この島は天草の乱の策源地といわれている）の間をぬけ、やがて上島近くにさしかかると、雲はいく分切れ、風も弱まつたようであつたが、波はいよいよ高く、時にもり上がるうねりに乗上げると、からだの中心を失いそうにさえなる。",
              "citation": {
                "source": "天草の春",
                "author": "長谷健",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
