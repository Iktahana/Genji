        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "満鉄ヤ撫順ノタメニ諸君ノ暮シガチットデモラクニナッタカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那革命擁護ノタメニ、諸君ハ支那ノ労働者、農民、兵士達ト力ヲ結合セヨ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿ニ似テ非ナル猿面冠者ハオノガ立身出世ノタメニハ、主人ヨリ猿々ト呼ビ捨テラレルモ、ヘイヘイト追従笑ヒナド泛ベタルハ、即チ羞恥ヲ知ラザル者ト言フガ如シ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米人ノ持續セントスル國際的特權ノタメニ宣傳サレツツアル平和主義非軍國主義ガ、其ノ特權ヲ打破センガ爲メニ存スル日本ノ軍備及ビ戰鬪的精神ニ對スル非難トシテ輸入サレツツアル内容皆無ノ文化運動。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "劣惡ナル者ガ亡ビテ優秀ナル者ガ殘存スル自然淘汰律ハ日本語ト國際語ノ存亡ヲ決スル如ク、百年ヲ出デズシテ日本領土内ノ歐洲各國語、支那、印度、朝鮮語ハ亦當然ニ國際語ノタメニ亡ブベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "中食ノ學校支辨ノ理由ハ第一ニ登校兒童ノタメニ毎朝母ヲ勞苦セシメザルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ此ノ改造組織ヲ其等ノ領土ニ施行シテ主權國民自ラ私利横暴ヲ制スルト共ニ、先住ノ白人富豪ヲ一掃シテ世界同胞ノタメニ眞個樂園ノ根基ヲ築キ置クコトガ必要ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ妻子ヲ失ッタ悲シサノタメニ酒色ニ溺レテ、恵ミ深イ大恩アル祖母ノ事ヲ忘レテオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "水産翁、轟雷雄先生ガ免職ニナリマシタ裡面ニハ、国家ノタメニナラヌ重大秘密ガアリマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウゾドウゾ国家ノタメニ御調ベヲ願イマス」　ウーム。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十一日（火曜）〔発信〕第六十二信〔受信〕電報　フツカトモ　ナンラ　メンカイヲコトワツテイルニアラズ　ネンノタメニ」アサ九ジハン　ケンジ　白いきちんとした背広、紳士、そり跡蒼きやせ面。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五ヵ年計画第三年目完成ノタメニ諸君用意シロ！",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デハ、ワタシ、アナタノタメニ唄ヲウタッテ上ゲル、コノ手風琴デ、世界ノ国々ノ、港々ノ唄ヲウタッテアナタヲ慰メテ上ゲルデス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サ、ワタシ、オ嬢様ノタメニ、世界ノ国々ノ、港々ノ唄ヲ何デモウタッテ上ゲルデス、オ望ミナサイ、外国ノ唄オイヤナラ日本ノ唄、ワタシタイテイデキルデス、八重山、越後獅子、コンピラ船々、追分、黒髪、何デモオ望ミナサイ」と言ってマドロスは、立って一方の隅から手風琴を提げて来ました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのたわけ物語の書出しに、「オレホドノ馬鹿ナ者ハ世ノ中ニモアンマリ有ルマイト思ウ故ニ、孫ヤ彦ノタメニ話シテ聞カセルガ、ヨク不法モノ、馬鹿モノノイマシメニ話シテ聞カセルガイイゼ」と言っている通り、馬鹿も度外れの馬鹿になっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲキテ記念ノタメニコホロギサント一シヨニ写真ヲウツシマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ以テ或ハ老親ヲ養フモノアリ或ハ病夫ノタメニ薬ヲ買フモノアリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "時ニ泥江豊原生ト謀リ余ノタメニ舟ヲ堀川ニ艤ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ハ妻ノタメニハ天ナレバ高キト云ヘリ」（代匠記）等と解したが、大神真潮が、誰笥歟将持の意に解し、古義で紹介した。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『私ハソビエト社会主義共和国連邦ノタメニ命ゼラレタコトハ何事デアッテモ行ウコトヲ誓イマス。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノタメニカルダンノ絹ノネッカチーフヲ買ッテヤル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ予ノタメニ腸ダケヲ残シテオクノガ習慣ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "可ナリ激シクテモソノタメニ寝ラレナイト云ウコトハメッタニナイノニ、昨夜ハ夜中ニ眼ガ覚メ、耐エ難イノデ佐々木ヲ起シ、ノブロンヲ注射シテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ッテ尿量ガ多ク、夜中ニ二回カ三回ハ起キルガ、ソノタメニ寝ソビレテ眼ガ冴エルナンテコトハ一度モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコノ女ハ枕サガシダト分ッテモ、却テソノタメニ興味ヲ惹カレテ、枕サガシヲ承知ノ上デ関係ヲ結ブ、ソノ誘惑ニ抗シカネルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウインクガ凄クイカスノヨ」「己ガ見タッテ面白クモナサソウダナ」「アタシノタメニ見テ下サラナイ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
