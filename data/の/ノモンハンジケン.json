          "standard": [
            {
              "text": "ノモンハン事件は、第二次世界大戦前夜の国際情勢に大きな影響を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史の授業で、日本とソ連が衝突したノモンハン事件について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ノモンハン事件は、日本の大陸政策に転換を促すきっかけとなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一九三八年から九年にかけて満州と中国に侵略した日本の軍事力は、ますますあれ狂って張鼓峰事件をおこし、ノモンハン事件を挑発した。",
              "citation": {
                "source": "婦人作家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
