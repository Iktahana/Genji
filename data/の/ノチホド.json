[
  {
    "uuid": "46402729-fc8a-51eb-9b47-f7b0e7f26dc7",
    "entry": "後ほど",
    "reading": {
      "primary": "のちほど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "名詞"
      ],
