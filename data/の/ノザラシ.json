[
  {
    "uuid": "5bb4a5a7-65c5-5219-bf04-09e2256d2fb9",
    "entry": "野ざらし",
    "reading": {
      "primary": "のざらし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
