        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マサニ鬼雄トナツテ、異日兵ヲ以テ吾ガ国ニ臨ムモノアラバ、神風トナツテ之ヲ禦グベシト。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ然ラズシテ長ク毒水ノ横流ニ任セバ臣ハ恐ル其禍ノ及ブ所将サニ測ル可ラザルモノアランコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、彼ニ従フトコロノモノモ、屈強ナル壮年男子ニ限リタレドモ、コノ信神渡航者ノ一行ニハ、オヨソ信仰ヲ共ニスル限リ、老幼男女ノアラユルモノヲ抱容スルコトヲ許サレタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋ニナッテ葉ヲ落スノハ、無益ナ消耗ヲ避ケテ樹液ヲ貯エ、春ニナッタラ大イニ伸ビテヤロウトイウ樹木ノ高イ意欲ノアラワレナノダ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ、日記帳ヲ入レテアル抽出ノ鍵ハイツモ某所ニ隠シテアルノダガ、ソシテ時々ソノ隠シ場所ヲ変エテイルノダガ、詮索好キノ彼女ハ事ニヨルト過去ノアラユル隠シ場所ヲ知ッテシマッテイルカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ然ラズシテ長ク毒水ノ横流ニ任セバ、臣ハ恐ル、其禍ノ及ブ所将ニ測ル可ラザルモノアランコトヲ」　最後はまた、次のような哀切極まる文字をもって結んであった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中私は、路傍の植物にはっていた蝸牛（オカモノアラガイ科）を一握りつまみ上げた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はまた欧州の Lymnaea auriculata〔モノアラガイ科〕に類似した、淡水の螺を見出した。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "中姫の命の生んだ御子は、キノアラタの郎女・オホサザキの命・ネトリの命のお三方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
