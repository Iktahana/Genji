        "examples": {
          "standard": [
            {
              "text": "キャンプファイヤーの周りで、ワインボトルを隣の人へと飲み回すように回した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "宴会の席で、上司が自分の杯を部下に飲み回すという時代遅れの行為は控えなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このお酒は皆で大切に飲もう」と言って、グラスを一人ずつに飲み回した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "濃茶となると一つのお茶碗を三人で飲みまわすのだから、末席に坐っているお前がすっかり後始末の作法をしなければならぬ事になるのだ」　筆者はスゴスゴと頭を下げた。",
              "citation": {
                "source": "お茶の湯満腹談",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大盃が三つ組五つ組になっていたのは、つまりはその一々の同じ盃で、一座の人が順々に飲みまわすためで、三つ組の一巡が三献、それを三回くり返すのが三三九度で、もとは決して夫婦の盃には限っていなかった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
