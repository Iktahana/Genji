          "literary": [
            {
              "text": "衣裳ハ寒暑ヲ凌グ計リナレバ曝ス可キ程ノモノトテハ無シ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "或者ハ、耶蘇ノ面貌ヲ以テ、醜悪ニシテ、怖ルベキ勁烈ノモノトナシ、或者ハ、温厳兼ネ備ヘタル秀麗ノ君子人トナス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ノ地方ニ住スル「エスキモー」（自稱ニ隨ヘバ「インヌイト」）ノ容貌風俗ハ「アイヌ」間ノ口碑ト古物遺跡トニ由リテ推測サレタル「コロボックル」ノモノト誠ニ好ク類似セリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ寝室ノ右側ニ接シテイタ老夫婦専用ノ便所ヲ、予専用ノモノトシテ椅子式ニ改良シ、寝室ト便所トノ境界ノ壁ヲ刳リ抜イテ、廊下ヘ出ナイデモ行ケルヨウニ、行ケ／＼ニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシテモコレラノ二ツガ同ジ種類ノ生物ノモノトハ信ジラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
