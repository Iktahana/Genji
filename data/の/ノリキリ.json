        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "原子力エンジンをつけたロケットにのって、くろぐろとした大宇宙をのり切って、やがて火星に近づいて行く……。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "実業家マルタン氏が舵手だったが、氏は非凡なうでをあらわして、波をうまくのり切った。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その地点を、どちらかへ横切ろうとする通行人たちは車道のまんなかの三角州に立っていて、数人かたまったところで、これもパリ人らしいかんで、絶え間ない自動車の流れの間にちょっとしたいきの切れめを見つけ、一団になったままさっと車道をのり切って行く。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "賢くて人の良かつた彼は豊醇甘美な激励に乗つて、艱難な写実道をのり切ること、娘形の場合におけるが如くであつたらうにと思ふ。",
              "citation": {
                "source": "街衢の戦死者",
                "author": "――中村魁車を誄す――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、九月半ば頃、大荒の海をのり切って船が大阪港へ入った時、一通の電報が彼を待ち受けていた。",
              "citation": {
                "source": "秋空晴れて",
                "author": "吉田甲子太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、そのあと、三人が家へ帰ると、茶の間には、もう、あか／＼と眩しいほどのあかりがついて、大きなチャブ台の上に、のり切れないほどの、たくさんの料理の皿が並んでいたばかりか、長火鉢の、たッぴつにつがれた火のうえにかゝった鍋の中には、みるから食慾をそゝるおでんが、ふつ／＼と煮えていた。",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大西洋と太平洋とを共にのり切ることがいかに困難であったかは、これによって解るのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
