        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ノロミとナベタ登場。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　さうですなあ、なにかに感じるといふことも、ひとつございますネ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　それはその通りで……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　それはたしかに、金の問題ぢやないと思ひますが、しかし、社長、最もこの事業の難関といひますのは、この地方の農民の姑息因循な風習です。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　それや、厖大な数字です。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　いや、鼻毛はとにかくとして、社長もそのへんのところは考へていたゞかんと困ります。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　大した代物ですな。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　しかし、社長、わたしはちよつとさつき気になつたんですが、あの先生、こゝはダメと知つたら、東亜産業へ行つて、また同じことを言やしますまいか。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　しかし、向うへ行つて、クサビ式の難点を指摘されてですよ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　えゝと、奥さんは、どちらの奥さんで？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ノ二ノロミ、アブタ、白面の警官に案内されて登場。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　やれ、やれ、間に合つた。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　いや、多分ご面倒はかけずにすむと思ひますが、ひとつ、お序のことに、われわれの話をオブザーヴァーとしてお聞きになつてください。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　わたしを覚えておいででせうか。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　いや、昭和農工の営業部長ノロミ……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　実は、社長の命令で、是非あなたにお目にかゝり、いろいろお話し申上げたいと思つて参つたのですが、その後だいぶんご活躍の様子で……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　ごもつとも。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　それはもうよく承知してをります。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　さうおつしやるなら、こちらも申しますが……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　オガ……オガクズ式が、はゝあ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　いや、わかりました。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　それが、さうはいかないと申すのは、先日来、一旦、大量に註文して来た菌種を、ちよつと見合せたいと言つてよこした村が二、三あるのです。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　さやうではありませうが、そこをなんとか、ひとつ……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　多少、色をおつけ願つて……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　いや、クサビ式と限らなくともですな……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　別に譲歩や妥協を申込んでゐるんぢやありません。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　とんでもない。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　まあ、まあ、それは極端な言ひ方だが、さういふ意思は毛頭おありにならないことは、こちらとしても、十分認めながらもです、結果に於いて……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ　　警察はどうお考へですか？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
