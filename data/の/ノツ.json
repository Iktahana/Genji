        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「コートリ、タマゴ、ハーカマ、ハオリ……」「アーメ、カサ、カーラカサ、アサヒ……マツ、ツル、シカノ……ツノ、ウシノツーノ。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "丈が高く顔の小さい、額がノツシリしてフロックコートのよく似合ふ、前校長の容姿が何時か彼の心を離れないものとなつてゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "尻に敷いた褥は、可愛らしい高山植物で、チングルマの小さい白花、アカノツカサクラの赤い花などが、絨氈の斑紋になって、浮き上る、焚火の影に、鮮やかな織目を見せる。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "額の油汗拭はむと、ぴくとわが硬直の指うごかした折、とん、とん、部屋の外から誰やら、ドアをノツクする。",
              "citation": {
                "source": "音について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノツクは、無心に、つづけられる。",
              "citation": {
                "source": "音について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子息ハ宥免ノツモリデヰマシタ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人の部屋の扉をノツクしてから、廊下の東南の隅につるされてある丸い金魚鉢を見あげ、泳いでゐる四つの金魚について、その鰭の數をしらべた。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一年｜経って、昭和十八年の早春に、アス五ジ　ウエノツクという君からの電報を受け取った。",
              "citation": {
                "source": "未帰還の友に",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それにくらべると、楢雄はだいいち眉毛からしてフハフハと薄くて、顔全体がノツペリし、だから自分は父親に嫌はれてゐるのだと、次第にひがみ根性が出た。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "楢雄はがつかりしたが、やがてノツポの修一が身体を折り曲げるやうにして女に寄り掛りながら歩きだすと、楢雄もあわてて女中に並び、君いくつになつたの。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」光線の關係で内部がよく見えなかつたのであらう、コトコトとノツクする音が聞えたが、やがて焦立たしげにののしる聲がきこえ、次に鍵がガチヤリと鳴り、戸が開いた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち街上より「フエリチツシイマ、ノツテエ、アントニオ」（幸あらん夜をこそ祈れ、アントニオよといふ事なり、北歐羅巴にては善き夜をとのみいふめれど、伊太利の夜の樂きより、かゝる詞さへ出來ぬるなるべし）と呼ぶ人あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "姫はジエラルドオ・デル・ノツチイの名ある作なるロオト（ソドムに住みしハランの子）とその女兒との圖の前に立てり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アニメルレ、ドオラテ」に「フイノツキイ」些計あらば足りなん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ブロデツトオ」は卵の※を入れたる稀き肉羹汁、「チポレツタ」は葱、「フアジヲロ」は豆、「カステロ、デ、ロヲオ」は卵もて製したる菓子、「アニメルレ、ドオラテ」は犢の臟腑の料理、「フイノツキイ」は香料なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ、めでたき彩繪には候はずやと云へば、夫人、見よ、雲は今「フエリチツシイマ、ノツテ」（幸ある夜を祈る）を言ふ時ぞ、と山嶽の方を指ざし給ふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻子には、トクトウニカハツタ、イマヨコハマヨリ二〇〇ノツト、イチロヘイアン、アア、ヒロイウミ、アヲイウミ　また、ある東京の友人にはこうも打った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "――お米買はうか　酒買ほか石油にしようか　煙草にしようか道ばたにはタカノツメとかいふ紫の小草が咲いてゐる、ぶらぶら歩いてゐるうちに、だん／＼憂欝が軽くなる、途中一杯ひつかけた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ　コノ　テフテフモ　オハネガ　ジヨウブニ　ナルト　カゼニ　ノツテ　ウマヤノ　ヤネヲ　コエタリ、ヲガハノ　ウエニ　イツテ　ミタリ　シマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　クルツト　コチラヲ　ムイテ　タキクンヲ　ヒザノ　上ニ　ノツケマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイドウニ　ソツタ　イエイエノ　ヒトタチハ、ムカシ　ジブンタチノ　ノツタ　バシヤガ　コドモタチニ　ヒカレテ　イクノヲ　ミルト、シゴトヲ　ヤメテ　オモテニ　デテ、バシヤヲ　ミオクルノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンガ　ノツテ　ヰテ、カキマハシタノデシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンハ　マタ　ウバグルマニ　ノツケラレテ、イツテ　シマヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヤウサンハ　クルマニ　ノツテ　ムチヲ　フリアゲ、「シーツ」ト　イヒマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが第十九基督世紀のハルトマンが唯一論に取るところあるは、其れ猶レツシングが第十七基督世紀のスピノツアが唯一論に取るところありしがごときか。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "永山はモウ三十を越した、何日でも髪をペタリとチツクで撫でつけて居て、目が顔の両端にある、頬骨の出た、ノツペリとした男で、酔つた時踊の真似する外に、何も能が無い。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は稚い心で、藤野さんが二人の従兄弟に苛責られて泣いたので、阿母さんが簪を呉れて賺したのであらうと想像して、何といふ事もなく富太郎のノツペリした面相が憎らしく、妙な心地で家に帰つた事があつた。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カイモノノツゴウデトウキョウヘカエルアススグユク　　　キョウコ」　と読まれた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ロフオツデンとモスコエとの中間は、水の深さ三十五ノツトより四十ノツトに至る。",
              "citation": {
                "source": "うづしほ",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
