          "literary": [
            {
              "text": "モロビト山ニ入ラントテ、　　　朝明ヲココニ待チツドヒ、或イハ鋸ノ目ヲツクリ、　　　　アルハタバコヲノミニケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生ハ勞働ノミニヨリテ生クル者ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "古器ヲ観ルハ徒ラニ之ヲ玩ブノミニ非ズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国ナドハ埃及ヤ羅馬ノ古物ハ言フ迄モ無ク、印度ノ古物ノミニテモ一館ヲ建テ、今ハ印度ニテ見ラレヌ物マデモ、其ノ中ニハ堆積セリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "那珂氏は之に説明を與へて此ノ風俗ハ、イカナル原因ヨリ生ジタルカハ知ルベカラザレドモ、卑彌呼壹與等ガ、國人ニ畏服セラレタルハ、其ノ英略アルガ爲ノミニハアラデ、此ノ風俗アリシニモ由レルナルベシ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "交誼啻ニ門ヲ同ジクスルノミニアラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「人ハ瓦斯ノミニテ生クベカラズ」といふ文字が、ガラスの上に書かれてゐるのが、その裏から左文字になつて読めるのであつた。",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタタクマニ敵ノ討死、ココノミニテモ百五十余名ニ及ブ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ノ怨恨カアッテ、独リワレノミニ法ヲ説カザル。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
