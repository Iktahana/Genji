        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会議が予想以上に長引いて、予定終了時刻から1時間も伸びてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
