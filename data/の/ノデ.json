        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は、いつも遅刻するのです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "明日は大事な試験があるので、今夜は徹夜するつもりなのです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "実は、ずっとあなたに会いたかったのです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
