        "examples": {
          "standard": [
            {
              "text": "畑の隅に、黄色い花を咲かせた野芥子が群生している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "道端に生えている野芥子は、天ぷらにして食べられるらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子どもの頃、野芥子の花冠を作って遊んだ記憶がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ああ　みればみるほど薄月のやうな少年よ、しろい野芥子のやうにはにかんでばかりゐる少年よ、そつと指でさはられても真赤になるおまへのかほ、ほそい眉、きれのながい眼のあかるさ、ふつくらとしてしろい頬の花、水草のやうなやはらかいくちびる、はづかしさと夢とひかりとでしなしなとふるへてゐるおまへのかほ。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
