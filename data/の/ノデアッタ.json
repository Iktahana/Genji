          "literary": [
            {
              "text": "ソンナコトヲ云ッテイタラ際限ガナイカラ、予ハ近々ニ婆サンニ無理ニ承諾サセテ壊シ屋ヲ入レヨウト思ッテイタノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト乳母ガ、「ホラ、督チャン、モウ秋デゴザイマスヨ、蟋蟀ガ鳴イテオリマスヨ」ト、ソウ云ッタモノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、後カラ考エルト、ソレハ浄吉ノ意志デハナク、颯子ガ夫ニセビリツイタ結果ナノデアッタガ、最初ハソウト気ガ付カナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ婆サンニ突然急所ヲ突カレタノデ、明カニ狼狽シテ照レ隠シニ怒ッタノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガモシ読ンデイルノデアッタラ、決シテコレハ偽リノ日記デナイヲ信ジテホシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "因果ナ※ニ、僕ハソコマデ想像スルトイヨイヨタマラナイ嫉妬ヲ感ジ、ソノ嫉妬ノ快感ノユエニアエテソノ危険ヲ冒シテミタクナルノデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ間、先週ノ月曜日ノ朝、木村ガ登校ノ途中ダトイッテ立チ寄ッタ日ノ朝デアッタ、僕ハ木村ガ来タノデベッドカラ起キ上ッテ茶ノ間ヘ行コウトシタノデアッタガ、ソノ時奇怪ナハ時々アッタガ、ソウイウモノトハ明ラカニ違ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコガ淫婦ノ淫婦タル所以デアル※ヲ、僕ハ見落シテイタノデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
