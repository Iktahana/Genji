        "examples": {
          "standard": [
            {
              "text": "会社は有望な若手マネージャーを役員に伸し上げることを決定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の献身と努力は、上司から伸し上げられる機会を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "そのメンターは、教え子のキャリアを伸し上げるのを助けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "小池は滑るたびに左手の山にのしあげる。",
              "citation": {
                "source": "五色温泉スキー日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーヴになったところを曲がると、愛一郎とカオルが乗って出た車が、国道から逸れた袋のような谷の奥の崖に、のしあげるようなかっこうで止っていた。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その隙を狙って電光のように、柄を両手にひっつかみ、身をのし上げると前方へ飛び出し、相手の胸へ突きを入れる――「伏叉の構え」の恐ろしさは、こういう変化にあるのであった。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽は落ちて、水辺はくらく、ややともすると、浅瀬へのし上げる危険もあり、時を移しているうちに、小舟に乗った下市場の兵が、あとからあとから落ちのびて来る。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
