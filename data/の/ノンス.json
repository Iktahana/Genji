        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "実にフーケー氏は、二年前即ち一八九五年の八月にブノンスで行われた殺人事件の犯人を極力捜査して空しく手をひいた人である。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブノンスの殺人事件というのは、牛飼いのヴィクトル・ポルタイエという少年が、のどを切裂かれ腹をえぐられて見るも無惨な死体となって牧場で見出された、という事件であった。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その自白によると、ヴァッヘルは、ブノンス事件の犯人、モルチュリューの犯人であるばかりではなかった。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんはそのころ、ノンス街道の角の――いまだにあるそうですが――、小さい塔のような形の家に住んでいまして、それは半分ほどもこわれた古屋敷で、ウルスラン尼院の庭にむかっている所にありました。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "聖餐祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ノンスの道とパロアスの道の角まで、わけもなしにたどって来ると、そこには、おもおもしい梁に系統木（クリストの系図を装飾的に現わしたもの）の彫ってある木造の家が建っていました。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "聖餐祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "米原京都間は急行はノンストップです。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "米原を出発すると、あとは京都までノンストップなんだよ。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
