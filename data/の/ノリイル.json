    "definitions": [
      {
        "index": 1,
        "gloss": "to ride into (a place)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
