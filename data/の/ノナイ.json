          "literary": [
            {
              "text": "――ハズノナイ……。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ワカルハズノナイコトマデ……。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、ヒラガナトイウモノハ、元来毛筆ナラビニ和紙トイウモノトトモニ育ツテキタモノデ、ソレラヲ離レテハホトンド生命ノナイモノト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "遂ニ熄ムコトノナイ軋轢ニ　タチクラム濛気ノ中ヲ　荊棘ヲ※ツテ　起チナホル身ヲ震ハスオレダ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ若サデソンナ意気地ノナイコトデドウスル」「陸子ハ嫁ニ行ッテカラ今マデ一度モコンナ話ヲ持ッテ来タコトハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ代リ、全クソンナ資格ノナイ老人デアルコトヲ自分ミズカラモ認メテイルニ違イナイト、ソウ思ッテ世間ガ安心シテイルトコロガ附ケ目デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸ッ子ニ一向｜由縁ノナイ北多摩郡ノ多磨墓地ナンゾニ葬ムラレルヨリ遥カニ優シダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ヨリモ、僕ガ彼女ヲ心カラ愛シテイルハ前ニモタビタビ書イテイルガ、ソレハ偽リノナイニハ疲レヤスクナッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "情事ノハアルケレドモ、ソレモ上半身ノ一部ニ限ラレテイタノデアッテ、情事ニ必要ノナイトコロハ絶対ニ見セテクレナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ヤ自分ハ夜ダケ生キテイル動物、妻ト抱擁スル以外ニハ能ノナイ動物と化シ終ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼間書斎ニ籠ッテイル時ハタマラナイ倦怠ヲ覚エル一面、云イヨウノナイ不安ニ襲ワレル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
