[
  {
    "uuid": "1413e4f2-35d7-5d99-a2dc-1b3a77d6e954",
    "entry": "野薔薇",
    "reading": {
      "primary": "のいばら",
      "alternatives": [
        "ノイバラ"
      ],
      "is_heteronym": false
    },
    "grammar": {
