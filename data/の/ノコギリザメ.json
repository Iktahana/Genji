        "examples": {
          "standard": [
            {
              "text": "日本海の底引き網で鋸鮫が捕獲されることは稀である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "水族館の関係者は学習のために鋸鮫の生態を研究している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その漁船は鋸鮫という珍しい深海魚を科学者に報告した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その中で一番貴いバカル珠に至っては、環礁の外に跳梁する鋸鮫でさえ、一目見て驚怖退散する程の威力を備えている。",
              "citation": {
                "source": "南島譚",
                "author": "幸福",
                "note": "青空文庫"
              }
            }
          ]
        }
