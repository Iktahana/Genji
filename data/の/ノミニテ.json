          "literary": [
            {
              "text": "英国ナドハ埃及ヤ羅馬ノ古物ハ言フ迄モ無ク、印度ノ古物ノミニテモ一館ヲ建テ、今ハ印度ニテ見ラレヌ物マデモ、其ノ中ニハ堆積セリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「人ハ瓦斯ノミニテ生クベカラズ」といふ文字が、ガラスの上に書かれてゐるのが、その裏から左文字になつて読めるのであつた。",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタタクマニ敵ノ討死、ココノミニテモ百五十余名ニ及ブ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
