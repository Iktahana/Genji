        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "江戸八百八町のべたらにね――」「ウフフ……」「ウフフたア何がなんです！",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸八百八町、のべたらにね――」「あきれたやつだよ」「え……？",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸八百八町、のべたらにね――」「のべたらに何がどうしたというんだ」「駕籠なんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもからっ駕籠がね、町じゅうのべたらに乗り捨ててあるんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "町じゅうのべたらに乗り捨ててあったとかいう、からっ駕籠の話はどうなったんだ」「だから、今その話をしているんじゃござんせんか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきのお話じゃ、江戸八百八町、のべたらにあるようなことをおっしゃったはずだが、たった七丁だね」「ちぇッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "景気よく驚かしてやろうと思って、ついその江戸八百八町のべたらといったまでなんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "それどころか却って正反対の現象がのべたらに上って来るのであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処までが唄で何処までが合の手であるかわからないやうな、何方かと言へば、のべたらでだらしのない調子でゐて、それで聞くもののペイソスを誘はずには置かないやうな節廻し、成ほどこれではたまさかにやつて来た旅人が此地方から他に持つて行きたいと思つても容易に移すことが出来ないだらうと思はれた。",
              "citation": {
                "source": "島の唄",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "裁判長、要領よくのべたらどうだ、重複したところは省いて、と再三云う。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "畳が粗末な琉球表なので、余計のべたらに広く見えるのだ。",
              "citation": {
                "source": "氷蔵の二階",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
