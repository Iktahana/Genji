  {
    "uuid": "19082e82-a466-5b38-b4fd-50a8dcda67cf",
    "entry": "ノデス",
    "reading": {
      "primary": "のです",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
