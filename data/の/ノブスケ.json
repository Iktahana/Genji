          "literary": [
            {
              "text": "だんだん親しくなると私は信夫のことをノブスケ君と呼び、ノブスケと呼び放しにした。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の娘や息子もやはりノブスケさんと呼び、ノブヲとは呼ばなかった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ日の十時頃にもどった私は、よせなべの匂いをかいで、今日のお客はノブスケだね、よせなべの匂いがするといい当て、いつもノブスケとよせなべとが、付き物になっていた。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "よい家庭にそだったノブスケは神戸の父母から隔れていたから、も一軒自分が好きに遊べる家庭がいるらしく、十日めくらいに大森の私の家に通うていたのだ。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
