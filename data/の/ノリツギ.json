        "examples": {
          "standard": [
            {
              "text": "次の飛行機への乗り継ぎ時間が短いため、急いでゲートに向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "東京での乗り継ぎはいつも大変だが、今回はスムーズにいった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "海外旅行では、乗り継ぎのストレスを減らすために直行便を選ぶことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "乗り継ぎ「一銭蒸汽」　僕等はその時にどこへ行つたのか、兎に角伯母だけは長命寺の桜餅を一籠膝にしてゐた。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗り継ぎ「一銭蒸汽」　僕等はその時にどこへ行ったのか、兎に角伯母だけは長命寺の桜餅を一籠膝にしていた。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここは馬車の乗り継ぎどころである。",
              "citation": {
                "source": "帰途",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしの宝石を質に入れてでもそうしたい気分ですが、それもできないし……」「すっかり覚悟されたようですが」「あ、いや、わたくしのことなら御心配に及びません、それに列車の乗り継ぎは楽しみですわ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "江東区の高橋から出ていた通船、葛西、東湾の両汽船とも、ずっと以前に運行をやめ、もっぱらバスの乗り継ぎに切り替えられた、と聞いていたから、タクシーに掛け合ってみると「ゆきましょう」と云うので、安心してでかけた。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "駕籠と馬を乗り継ぎにして、信濃路を伊那へ入り、天竜川に沿って（舟便も利用しながら）遠江へと下った。",
              "citation": {
                "source": "雨の山吹",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は乗り継ぎの早｜駕籠で来たのだそうで、「若｜棟梁にすぐ帰ってもらいたい」と、助二郎の伝言を告げた。",
              "citation": {
                "source": "ちいさこべ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらは永野で馬を替え、槻木で乗り継ぎ、岩沼までいって宿を取った。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしておなじ電車を乗り継ぎ、いっしょに帰って来た。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はもういいですから、夏子さんが持っていてください」　来たときとおなじルートで電車を乗り継ぎ、ヨシオは下北沢まで帰った。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "来たときとおなじように乗り継ぎ、ヨシオがかよっている大学の近くまで戻った。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "下北沢まで歩き、電車を乗り継ぎ、スクール・バスでふたりは大学までいった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は明朝九時五十何分かにここを立ち七時に大阪へおりて十時にのりつぎ、十四日朝かえります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「駕屋、急ぎだぞ」　五人の侍風の者と、商人風の者とが、藤沢の立場の前で、乗継ぎの催促をしていた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "身にかのうことならば、どのようなことでもきいてとらせる」「どうか、乗継の早駕籠を一挺」「早駕籠を、どうする」「申しあげるまでもございません。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "丹頂の鶴",
                "note": "青空文庫"
              }
            },
            {
              "text": "車といっても近頃は間に合わないので、省線、目蒲線と乗継いで行くのが、もどかしくて仕方がありません。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから古口で乗継し、清川を経、雁川で下船した。",
              "citation": {
                "source": "支流",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……福田まで馬で、どのくらいかかりますの」「乗継ぎにやっても明日の朝になるだろう」　小房は胸のなかでそっと、　――どうぞ途中御無事であるように。",
              "citation": {
                "source": "柿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
