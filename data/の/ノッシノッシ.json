    "definitions": [
      {
        "index": 1,
        "gloss": "walking heavily",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ゾウがのっしのっしと大地を踏みしめて歩いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は大きな体をのっしのっしと動かし、部屋に入ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「おじいちゃん、最近のっしのっし歩くようになったね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もう空のすすきをざわざわと分けて大烏が向うから肩をふって、のっしのっしと大股にやって参りました。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "四人の、けらを着た百姓たちが、山刀や三本鍬や唐鍬や、すべて山と野原の武器を堅くからだにしばりつけて、東の稜ばった燧石の山を越えて、のっしのっしと、この森にかこまれた小さな野原にやって来ました。",
              "citation": {
                "source": "狼森と笊森、盗森",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを小十郎が、まるで自分の座敷の中を歩いているというふうでゆっくりのっしのっしとやって行く。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きげんでのっしのっしと、野原を歩いて参ります。",
              "citation": {
                "source": "葡萄水",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "居処は違ったらしいが、おなじ電車から、一歩おくれて、のっしのっしと出たのである。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "のっしのっしと階段を降り、玄関に立ちはだかり、さっきの番頭に下駄と傘を命じ、「まちを見て来ます。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの歩き方がお殿様そっくりですよ」　愁眉を開いたかのごとくに群集の中から叫んだ声が挙がったかと思われるや同時に、いかさま仲之町通りを大門口の方から悠然とふところ手をやって、こちらにのっしのっしと歩いて来る一個の影がありました。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "京というところは、ずんと面白いぞ」　声も冴えやかに、のっしのっしと降りて行くと、名代自慢の疵痕を、まばたく灯影に美しく浮き出させながら、人集りを押しわけて、新らしく降って湧いた秘密と謎とを包みながら呻き倒れている弥太一のかたわらに、ずいと近よりました。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ないところから、のっしのっしと浜街道を十三里ひと日にのし切って、群なす旅人の影に交りながら、ふらりふらりとお城下目ざして原ノ町口に姿を現しました。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "充分に用意いたせよ」　事起らばそれまた一興、不審の雲深ければさらに一興、いっそ退屈払いになってよかろうぞと言わぬばかりに、のっしのっしと通って行くと、不敵な鷹揚さを示して命じました。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "右に廻れば右に廻り、左に廻ればうしろの影もまた左に追って、奇怪な尾行者を随えながら、のっしのっしとさしかかったのが青葉城大手前の大橋――。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "指を銜えて見ていさっしゃい」　広言吐きながらのっしのっしと現れたのは、鎮西の八郎が再来ではないかと思われる、六尺豊かの大兵漢です。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――俊二郎とやら、陸奥の秋風はまたひとしお身にしみる喃」　そこへのっしのっしと来合わしたのは英膳です。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "相変らずのっしのっしと頼もしい恰好をしていらっしゃるな。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "只今御取次ぎ仕る」　のっしのっしとやって来て、ひょいと見眺めるや対手は、この上もなく意外だったに違いない。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "早乙女主水之介賞めつかわすぞ」　しらせをうけて、のっしのっしと門脇に現れると、「京弥、用意の品、これへ持参せい」　呼び招いて、小姓袴も相応しい京弥に運ばせたのは、うず高く三宝に盛られた小判の山でした。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞこちらへ……」　どんな酒肴か、槍肴、白刄肴、けっこうとばかり退屈男はのっしのっしと這入って行くと、座敷の真中にぬうと立ちはだかりました。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一杯機嫌の此村大吉、ニタニタ笑い乍ら仲蔵を睨んでいたが、　ノッシノッシ花道へ上って、　震え上って居る仲蔵の傍へ寄り、Ｔ「よくも、この大吉と　定九郎とを　一緒にしやがった」　物凄い権幕に仲蔵蒼くなる。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "法水の顔を見ると、支倉検事は親し気に目礼したが、その背後から例の野生的な声を張り上げて、捜査局長の熊城卓吉が、その脂切った短躯をノッシノッシ乗り出して来た。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その物々しい身体で私を圧迫するように、ノッシノッシ近付いて来ると冷やかに私を見下した。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……わかりまして御座います……お姫様……何もかも運命で御座います」　ハラムは、そうした気持ちの妾を又も軽々と抱き上げて、ノッシノッシと歩きながら、室の真中に在る紫檀の麻雀台の前に来た。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大股にノッシノッシと歩く又野の右側から、チョコチョコと跟いて来る小柄な男は、油差しの戸塚という青年で、敏捷らしい眼に鉄縁の近眼鏡をかけている。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう所を立派な武士が、大門札を引っ抱え、若い武士を供のように連れて、ノッシノッシと歩いて行くのであった。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平にご容赦ご容赦じゃ」　さも大仰にこう云うと、八尺もある入道がノッシノッシと現われて来た。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高く売ろうッていうんだね」　ノッシノッシ歩きだした。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノッシノッシ一廻りしてきた川田さまの顔は静かなタダの顔でした。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度は走りかけたが、やがてだしぬけにゆつくりむとんちやくにノッシノッシと歩き出した。",
              "citation": {
                "source": "緑色の人",
                "author": "THE GREEN MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お頼申します」　チグハグに二、三足汚い下足の脱ぎ棄てられてある、埃臭い楽屋口へ立って案内を乞うと、「ドーレ」　間もなくドス太い声がして、ノッシノッシと大きな荒々しい足音が聞こえてきた。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、ノッシノッシと六方を踏んで行くと、もう見物は吾を忘れて駈けている気持になってしまう。",
              "citation": {
                "source": "愛陶語録",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばし、最後の自由を与えよ」そして、ピカ一は刑事の腕をふりはらい、一人ノッシノッシとテーブルを廻って歩いて行った。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
