        "examples": {
          "standard": [
            {
              "text": "口を大きく開けると、奥に喉ちんこが見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "扁桃腺が腫れると、喉ちんこにも影響が出ることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "医者が喉ちんこの状態を診察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "男Ｂ　……（相手の言葉はわかったのだが、それに返事はせず、いきなり、ノドチンコが見えるくらいの大あくびをする）おーう。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "咽喉具合わるくノドチンコが、ひっかゝるやうでうまく喋れず、「のどか」スラ／＼行かず。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
