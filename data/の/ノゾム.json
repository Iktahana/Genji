  {
    "uuid": "5e4851d2-f072-54ed-9d2d-13515a4b43a4",
    "entry": "のぞむ",
    "reading": {
      "primary": "のぞむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
