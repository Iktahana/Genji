      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宇宙の　無限の　悠悠とした空の下ではるかに永生の奇蹟をのぞむ　熱したひとびとの群があつた。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の詩の読者にのぞむ所は、詩の表面に表はれた概念や「ことがら」ではなくして、内部の核心である感情そのものに感触してもらひたいことである。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四二課　虚栄　虚栄はその字の示すとおり、むなしい栄えをのぞむことです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "病技師〔二〕あへぎてくれば丘のひら、　　　　地平をのぞむ天気輪、白き手巾を草にして、　　　　　　をとめらみたりまどゐしき。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "必要部数一冊の本を求める者は、悪筆を呪いながら手書きでのぞむしかないのか。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "今が今まで、今日の君との話においてさへさういふ君をのぞむわしの氣持がものを云つてゐた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれが、おれが人にも自分にものぞむところのものだ。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "公判が遲かれ早かれ開かれることがわかつてゐる以上、公判廷にのぞむ態度といふものもある程度まできまつてはゐた。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "書きながらも彼女のうちに封建時代の貞女らしいものを豫想し、それをのぞむ心があり、古賀は自分の矛盾を恥ぢた。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどの公判廷にのぞむ私の態度は、（原文六字缺）格別かはりのないものとして萬事よろしくおねがひいたします、と彼はその手紙のなかで言つたのである。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその目に、ついに救えなかった依頼人に報いるまでは、命をかけても捜査にのぞむという決意の色を読み取った。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうして、わたしののぞむお礼は、お軽少なことではないよ。",
              "citation": {
                "source": "人魚のひいさま",
                "author": "DEN LILLE HAVFRUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "王さまののぞむことといったら、いつもきれいな服を着て、みんなにいいなぁと言われることでした。",
              "citation": {
                "source": "はだかの王さま",
                "author": "THE EMPEROR'S NEW SUIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが一般の画壇にのぞむことは、なるべく才能のある画家は生きてゐる間に団体として好意をみせるのがほんとうで、本人にしても死んで花実が咲くものかであるし、死んでから、急に才能を発見して騒ぎたてる傾向があるから、生きてゐるなら生きてゐる間に良い作家の真実の価値を大衆に示すやうに団体として努力すべきだ。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "しづかな朝の単調にわづかな胡椒を振りかけたばかりの食膳私の味覚はそんなぐらゐの甘つたるい料理は喰ひあきた舌なのですもつと　もつと腕利きのコックを雇つて下さいこの現代の味覚はもるひね愛好者のたゞれた舌ですねばりこく脂こい情感にふるへるやうなわたしは料理をのぞむのです。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝ我々若き思索者よこの水底にひそまれる青銅の壺はさんとして光輝を放つ愛人、我等が救ひ手を待つ思慕者、ともすれば忘れがちなる霧のやうなる対照のなかにこそ我等がのぞむ思索がありアンリー、ルーソーのなまぬるき白痴のごとき冥想のなかにこそ蒼白な激情に燃える火のごとき苦悩のひそまれることを。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "この種の商売人上がりの美女を形容する場合、おおむね世上では窈窕という文字を使いますが、しかしそれなる薄雪にかぎってはその名の示すとおり窈窕は不適当で、むしろ玲瓏としてすがすがしい玉をのぞむような美しさでありました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "達磨を好く遊女",
                "note": "青空文庫"
              }
            },
            {
              "text": "家内めが変わり果てた姿になっております……よくお見調べくださいまし」　近寄るまえに小娘はさかしくもおけの上からはいおりると、右門の狂わぬ検証を一刻も早く待ちのぞむかのように、重いふたをけんめいに取りのけました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "奉公をのぞむと申すか。",
              "citation": {
                "source": "修禅寺物語",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "柵内に繁茂してゐる、脊の高いアカダモや、ドロや、柳やの森をのぞむと、然し、渠は、數ヶ月前の月の夜に、友人と共にその間を散歩しながら、今囘着手した事業の成功を身づから保證したことがあるのを思ひ出す。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべからさう思つてゐる間は、手紙が電報の如く飛んで行つて、電報の如く早く返事の來るものならとまで思つたが、さて、筆を持つて紙にのぞむと、もう、何の手ごたへもないか知れないといふ心配が起る。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "前をのぞむと、洋々たる海だ、大規模の築港も、半ば完成してゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "東山を、月光の裡にのぞむ五條鴨の河原に近き渡邊渡の邸の寢殿。",
              "citation": {
                "source": "袈裟の良人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま死にのぞむわが乳母のかなしき眼つき…………藪椿。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
