        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "幕間になると彼女は放蕩親爺の好色眼と若い男たちの漫然とした不可解な顔と、理智的な侮蔑のなかをクジャクのように満開して、奈落から通ずる楽屋へ座頭のヤマジ・マツノスケを訪ねた。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マツノスケは彼女を見ると番頭を遠ざけてから云った。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マツノスケはわざと豪快にわらってから、「やあ、有がとう。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それはね、マツノスケ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と頭を掻きながらマツノスケは苦笑して云った。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マツノスケに別れると、ミサコはそのまま楽屋口から冷たい街路に出た。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノスケッチニ取ルベキトコロノアルモノガアルデショウカ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノスケッチデハ私ノ感ジガドウモ出ナイデコマリマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大石クラノスケをやる気なのよ、大笑いねえ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "というと、ナカジョウケンノスケと片言で申します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャイデマンやノスケは、カールやローザを殺して、一九一九年のドイツの革命をブルジョア民主革命にまでも及ばない、まがいものにすりかえることに成功した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スパルタクスブンドの偉大なる指導者が、独逸臨時政府を負うシャイデマン、ノスケ等の為めに虐殺された記念の日だ、一九二九年一月十五日今日こそその十週年記念日だ「カール、リーブクネヒト　ローザ、ルクセンブルグを打ち殺せ！",
              "citation": {
                "source": "虐殺の記念日",
                "author": "――カール・ローザ十週年――",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中、チョウノスケソウ、チングルマ、ツガザクラ、ジムカデ、タカネツメグサ、トウヤクリンドウ、イワオウギ、ミヤマダイコンソウ、等を見た。",
              "citation": {
                "source": "穂高岳槍ヶ岳縦走記",
                "author": "鵜殿正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "買ひものばかりしてゐる、ふしぎな状態である、靴下、靴などまで買ふのだから呆れる、曰く、多情物資、カヒモノスケベエとルビを振るなり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどい喜劇を一幕辛抱すると、エンタツ・エノスケで、これもいつものネタ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンタツ・エノスケを誘って、高島屋の地下室のグリルへ行き、冷房本位で食べる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ十時半、大雅へ渡辺と行くと、又エノスケ・エンタツに会ひ、大いに語り、酔ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "祇園で遊んでいた大石クラノスケの故智にならって、世間の眼をくらますためだろうか。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
