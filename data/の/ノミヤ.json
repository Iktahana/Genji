[
  {
    "uuid": "272b96c8-5df4-5840-b7d3-1143e9acef74",
    "entry": "飲み屋",
    "reading": {
      "primary": "のみや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
