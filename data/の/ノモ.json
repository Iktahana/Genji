        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンニモシナイ、コレダケノモノ、キレイデショ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒ハ酔フタメノモノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "不審に堪えず、薬の箱をよく見ると、それはヘノモチンという下剤でした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘノモチン、という」　と言いかけて、うふふふと笑ってしまいました。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "眠ろうとして下剤を飲み、しかも、その下剤の名前は、ヘノモチン。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ高木モ夜トナレバ、　　　サラニアシタヲ云ヒカハシ、ヒトビトオノモ松ノ野ヲ、　　　ワギ家ノカタヘイソギケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこの町内のある地主の子息は、工科出の地質学者であったが、召集されるとすぐ、深くも思い決した体で、心を後に残さないように、日頃愛用していたライカアやレコオドを残らず叩き壊し、潔く征途に上ったものだったが、一ト月の後にはノモンハンで挺身奮闘して斃れてしまった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "真の肉※蓉は御肉と同じく列当科に属すれど別物で、学名をフェリベア・サルサと呼び、西シベリア、蒙古、ズンガリアの産、鎖陽は蛇菰科のシノモリウム・コクネシウムで蒙古沙漠に生ず（ブレットシュナイデル『支那植物学編』三）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボールの『印度藪榛生活』にインドの海辺で猴好んで蟹を採り食う由載せ、ビルマのシノモルグスは蟹を専食する猴だ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち「脳髄ソノモノ」が「脳髄ソノモノ」を追っかけまわすという……宇宙間最高の絶対的科学探偵小説なんだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……のみならず……その脳髄自身は、ソレ自身がトテモ一キロや二キロの物質の一塊とは思えないほどの超科学的な怪能力、神秘力、魔力を上下八方に放射して、そうした科学者たちの脳髄ソノモノに対する科学的の推理研究を、片端からメチャメチャに引掻きまわしている。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オンダモダイタモエンブチハウノモオマエノコジャモノ、キナガニサッシャイ、イカニモショッショ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在カタカナガ一般ニ使ワレテイルノハ数学書、法律書、官報、軍関係ノ書類ナドデアルト思ウガ、イズレモ最モ正確ヲ期セナケレバナラヌ種類ノモノバカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『近年村々ヘ浪人体ノモノ参、合力ヲ乞、ネだりヶ間敷儀申モノ数多有之候間、右体ノモノ召捕候ハバ、直ニ訴可』――合力もするな、捕えて突き出せ、こう残酷に命じているのだ。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九三八年から九年にかけて満州と中国に侵略した日本の軍事力は、ますますあれ狂って張鼓峰事件をおこし、ノモンハン事件を挑発した。",
              "citation": {
                "source": "婦人作家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "材料ノ不足ニヨリテ意ノ如キ波長ノモノヲ作ルコトヲ得ザルコトヲ発見シタルトキハ絶望ノ泪ニ暮レタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル未知電波ノウチノアルモノハ、時ニ雑音トイウ名ノモトニワレワレニ知ラレテイル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒褐色ノ煙ノ柱徑一町以上ノモノガ天ニ沖シ、中空以上ハ擴ガツテ雲ノヤウデアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ内ニ音ガ小サクナリ、風モ治マリ、柱状ノモノモ以前ノノヤウニ明瞭ニハ見エナクナツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノ中ニハ可也信用ノ置カレルノモアリ、又可也怪シイモノモアルガ、此點ニ就テハ一切私見ヲ加ヘルコトナシニ、其儘ヲ採録シタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "談話者又報告者ノ言葉モナルベク保存シ、話ノ順序、ノ混雜シタノヤ不得要領ナノモ故意ニ其儘ニシテ置イタ、サウシタ方ガ史料トシテノ價値ヲ損ジナイト思フカラデアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、自分の原子ガ別ノモノニナッタトキ、自覚シナイカラツマラナイ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ甘ジテ之ヲ為ス所以ノモノハ洵ニ国家生民ノ為ニ図リテ一片ノ耿耿竟ニ忍ブ能ハザルモノ有レバナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
