[
  {
    "uuid": "3252a253-3a6c-564e-9ba5-dc7622c7aebc",
    "entry": "退っ引き",
    "reading": {
      "primary": "のっぴき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
