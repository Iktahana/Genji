        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一杯機嫌の此村大吉、ニタニタ笑い乍ら仲蔵を睨んでいたが、　ノッシノッシ花道へ上って、　震え上って居る仲蔵の傍へ寄り、Ｔ「よくも、この大吉と　定九郎とを　一緒にしやがった」　物凄い権幕に仲蔵蒼くなる。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "法水の顔を見ると、支倉検事は親し気に目礼したが、その背後から例の野生的な声を張り上げて、捜査局長の熊城卓吉が、その脂切った短躯をノッシノッシ乗り出して来た。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その物々しい身体で私を圧迫するように、ノッシノッシ近付いて来ると冷やかに私を見下した。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……わかりまして御座います……お姫様……何もかも運命で御座います」　ハラムは、そうした気持ちの妾を又も軽々と抱き上げて、ノッシノッシと歩きながら、室の真中に在る紫檀の麻雀台の前に来た。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大股にノッシノッシと歩く又野の右側から、チョコチョコと跟いて来る小柄な男は、油差しの戸塚という青年で、敏捷らしい眼に鉄縁の近眼鏡をかけている。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コートの襟を立て、巻煙草を口にくわえた酔漢が二人、腕を組みあって、ノッシ、ノッシと、袋小路に紛れこんだ――勿論、帆村と私とだった。",
              "citation": {
                "source": "西湖の屍人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それへ、金包みを入れた典膳は、ノッシリと立ち上がったが、礼も云わず、客人を掻き分けると、場外へ出て行った。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう所を立派な武士が、大門札を引っ抱え、若い武士を供のように連れて、ノッシノッシと歩いて行くのであった。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平にご容赦ご容赦じゃ」　さも大仰にこう云うと、八尺もある入道がノッシノッシと現われて来た。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高く売ろうッていうんだね」　ノッシノッシ歩きだした。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、ノッシ／＼と現われて来たのは中肉中背ではあるが、褞袍姿の見るからに頑丈そうな毬栗頭の入道で、色飽くまで黒く、濃い眉毛に大きな眼をギロリとさせた、中世紀の悪僧を思わせるような男だった。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、君、鳥渡降りて来て呉れ給え」　浅田は仏頂面をしてノッシ／＼と降りて来た。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "署長は柔道で鍛え上げたガッシリとした長身をノッシ／＼と運びながら、喜怒哀楽を色に現わさないと云う不得要領なボーッとした風で、何気なく刑事達に声をかけた。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると張りあいがない、ノッシ、ノッシと階段を下りて来た大男は、観念してるもののように平静に階下の刑事と面接した。",
              "citation": {
                "source": "ある遊郭での出来事",
                "author": "公娼存廃論者への参考資料としての実例",
                "note": "青空文庫"
              }
            },
            {
              "text": "身丈の気味の悪い程大きい体に玩具の様な鍬を下げて一人前の男にノッシリ、ノッシリと働いて居るのを見ると、しみじみ二十年余の月日が長かった事を思わずには居られなかった。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
