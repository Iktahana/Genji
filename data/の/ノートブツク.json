          "literary": [
            {
              "text": "そして塚原はノートブツクを持つてゐた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はたゞ教場へ出て、普通の學生のする通り、多くのノートブツクを黒くした。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は下宿の机の上に、此ノートブツクを奇麗に積み上げて、何時見ても整然と秩序の付いた書齋を空にしては、外を出歩るいた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はペンを取つてノートブツクに次のやうなことを書いた。",
              "citation": {
                "source": "明るく・暗く",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋紙のノートブツクも手元に備へられてゐる。",
              "citation": {
                "source": "入江のほとり",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
