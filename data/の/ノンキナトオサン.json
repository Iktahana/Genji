        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その次は、ノンキナトオサンである。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処へ、ノンキナトオサンがノコノコ歩いて来る。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノンキナトオサンの顔は、何時の間にか、平造の顔に変る。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノンキナトオサンは、いきなり踊り子の手を取らうとする。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ノンキナトオサンはもう足が動かなくなる。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
