          "literary": [
            {
              "text": "フキノトウはその苦味の故か知らないが確かに多少の薬効が有る。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フカイアサジナルモノトウチニナシ」　課長は呆気にとられて、電報を刑事に渡した。",
              "citation": {
                "source": "鉄の規律",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒキヨモギ　メドハギ　イヌハギ　ネコハギ　マキエハギ　アリノトウグサ　タチフウロソウ　グンナイフウロソウ　コウリンカ　ハナナヅナ　コバノイチヤクソウ　ツリガネニンジン　フシグロセンノウ　トリアシショウマ　ムシャリンドウ　角間新田の上で星糞峠の道に合した。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地面が顔を出すが早いか、忽ちここの日光をしたってフキの根からぽっかり青いフキノトウが出る。",
              "citation": {
                "source": "山の春",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『郡村誌』田代村の書上には「東南ニ浅間、三ツ尾根、水ノトウ、駕籠ノトウヲ負ヒ」と書いてある。",
              "citation": {
                "source": "上州の古図と山名",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月号の「月明」の裏表紙にフキノトウの絵のあつた所から、それを書かう書かうと思ひつゝ、少し薹が立ちすぎた嫌もあるが、在京中、きのふ鎌倉の浄智寺で、そのツクダニを食べた感興によびさまされて、遂に一筆することになつた。",
              "citation": {
                "source": "蕗の薹",
                "author": "新村出",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
