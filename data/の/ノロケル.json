    "definitions": [
      {
        "index": 1,
        "gloss": "to go on about (one's love affairs)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "みんなの前で恋人のことをのろけるのは、少し恥ずかしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は酒の席になると、決まって彼女のことばかり惚気るので、周囲は苦笑いしてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "惚気るつもりはないが、夫が私の手料理を毎日美味しそうに食べてくれるのは嬉しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "結婚写真である、盲人は首を傾けるやうにして成瀬の様子を伺ひ、写真を覆つたパラフィン紙の音を聞くと、えッへへへへと笑ひながら、惚気る訳ぢやあないがとことはつた後、結婚当時の生活が如何に幸福に溢れてゐたかをくどくどと納得させるのであつた。",
              "citation": {
                "source": "癩を病む青年達",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "生若い連中が惚気ると、惚気というもの穢く見える。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のような爺さんが惚気ると、惚気がピカリと光って来る」　薬草道人の恋物語――薬草道人恋の思い出　薬草道人の恋物語り――「昔々ある所に、一人の別嬪さんがおりました。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとえに御目玉の可恐いのも、何を秘そう繻子の帯に極ったのであるから、これより門口へかかる……あえて、のろけるにしもあらずだけれども、自分の跫音は、聞覚えている。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前ときたら、のろけるのは人前だと考えているのかね」　蓬莱建介は笑いながら云う。",
              "citation": {
                "source": "華々しき瞬間",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "のろけるんぢや無いが、心配しないでもいゝわけが有るんだから。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "のろけるんじゃないが、心配しないでもいいわけがあるんだから。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "七十九にもなっていまさらのろけるわけではないが、こんな話もあった。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "のろけるからよ」　親方は渋団扇で、膝をたたいて笑った。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "地獄ではノロケが禁じてあるから深くはいはないが、あの時はほんたうに最う命もいらないと迄思つたね。",
              "citation": {
                "source": "墓",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "地獄ではノロケが禁じてあるから深くはいわないが、あの時はほんとうにもう命もいらないとまで思ったね。",
              "citation": {
                "source": "墓",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "「不思議なものさ、馴染を重ねると、そうでもなかった人までが、ちょっと恋しくなるものだねえ」「おノロケね、ご馳走様」「ふん」と八重梅鼻で刎ねたが、その鼻の上を二つ三つ、牡丹刷毛で叩いたものである。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は子供の時から芸者達のオノロケだの、肉体のよろこびだの、きゝなれて育つた。",
              "citation": {
                "source": "花火",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下、結婚に失敗してゐるのは、私ではなくて、木村で、ミン平にお酒を飲ませて寝顔をながめてたのしんで、それを平気でノロケてゐる私の方が悪妻なのかも知れない。",
              "citation": {
                "source": "花火",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間の旦那は飯たき婆アにお妾のノロケを言うものですかえ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ゃウチの旦那からそんなノロケを承ったことがないね」　ちょッと海千山千という目附の老婆。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう縁はノロケや冗談としては結構である。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その六　暗い哉　東洋よ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなノロケをきいても、別に誰も怒りやしない。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その六　暗い哉　東洋よ",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊乃さんがそれほどの愛読者だとは思われないが、愛読者であってもなくても、要するに十七年間肌身はなさず、というようなことは酒間のノロケには適当かも知れんが、それ以上に考うべきことではなかろう。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その六　暗い哉　東洋よ",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋愛や結婚生活にとってノロケのほかには伝説や神話は介在すべきものではない。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その六　暗い哉　東洋よ",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝説や神話はノロケでしかないということはそれほど実人生は厳しく、厳粛なものだということだ。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その六　暗い哉　東洋よ",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生の菊乃さんへの愛情は一途なものであったろうが、芸者たりし故に賤の女と見、自分の妻となったのは名誉この上もなく、死すとも瞑すべきであるとなすような考えも、これまた牢固たる先生の本音であり、しかも、それすらも愛情のアカシであり、ノロケのタネであった。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その六　暗い哉　東洋よ",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄田　とんだところで、ノロケを聞かされる！",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
