[
  {
    "uuid": "8eb81566-52fc-54d3-b758-a9687ee7b9d7",
    "entry": "野太刀",
    "reading": {
      "primary": "のだち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
