          "literary": [
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ苦シイ俺ハ遊ブ▽ノすりつぱーハ菓子ト同ジデナイ如何ニ俺ハ泣ケバヨイノカ　　　　　×淋シイ野原ヲ懐ヒ淋シイ雪ノ日ヲ懐ヒ俺ノ皮膚ヲ思ハナイ記憶ニ対シテ俺ハ剛体デアルホントウニ「一緒に歌ひなさいませ」ト云ツテ俺ノ膝ヲ叩イタ筈ノコトニ対シテ▽ハ俺ノ夢デアルすてつき！",
              "citation": {
                "source": "破片ノ景色――",
                "author": "△ハ俺ノ AMOUREUSE デアル",
                "note": "青空文庫"
              }
            },
            {
              "text": "「水ガ零レルヨ、ツイデノコトニ口移シニシテクレナイカナ」「駄目々々、図ニ乗ッチャ駄目」パット予ノ口ノ中ヘ二錠、素早ク放リ込ンデ器用ニ水ヲ注ギ入レタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大切ナ忰ノコトニツイテコレホド無知ナ父親ハ少イダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ所ヘハ時々手紙ヲクレルケレドモアノ晩ノコトニハ一言モ触レテナイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
