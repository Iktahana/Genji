          "literary": [
            {
              "text": "藪地のなかで、豹にやられるらしい小野豚の声もした。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "豺が咆え、野豚が啼く熱林のなか――。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれまあお前さま、まるで野豚のように、背中から脇腹が泥だらけじゃありませんかね、何処でそんなにお汚しなすったので？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと並んで、花や、果物や、切り割った西瓜や、野豚の頭や、倒さに吊りさげた鴨を描いた大きな黝んだ油絵が壁の半ばを占領している。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へつ、この中にやあ、野豚がまるまる一匹入つてゐるよ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、まるまる一匹の野豚だとよ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうでい、この馬鹿女めが、野豚だなんて吐かしやあがつて！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな野豚があるけえ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "野豚でなきやあ、屹度、仔豚か何か、ほかの家畜に違えねえ。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は鋤を振りあげて、まるで瓜畑へ闖入した野豚に一撃を喰はせようとでもするやうに、こつそり走り寄つて、塚の前で立ちどまつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
