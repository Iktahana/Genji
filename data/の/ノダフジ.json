        "examples": {
          "standard": [
            {
              "text": "春になると、公園の藤棚に美しい野田藤の花が咲き乱れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "万葉集にも詠まれた野田藤は、古くから人々に愛されてきた花だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭に植えられた野田藤の長い花穂が、風に揺れて優雅だった。",
              "citation": {
