        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "妻子には、トクトウニカハツタ、イマヨコハマヨリ二〇〇ノツト、イチロヘイアン、アア、ヒロイウミ、アヲイウミ　また、ある東京の友人にはこうも打った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ロフオツデンとモスコエとの中間は、水の深さ三十五ノツトより四十ノツトに至る。",
              "citation": {
                "source": "うづしほ",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十五ノツトから四十ノツトまでの間といふのも、ロフオツデンの岸に近い所か、又は、モスコエの岸に近い処か、どちらかの海峡の一部分の深さに過ぎないのだらう。",
              "citation": {
                "source": "うづしほ",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに二十二ノツトも出ると言ふから、見つかつたら最後、こつちは撃沈されるか、自爆するかより外に途はない。",
              "citation": {
                "source": "怪艦ウルフ号",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レザノツトは彼の國の使者なり。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
