  {
    "uuid": "cdf0bddd-7074-5d1a-96e3-d997f92b6668",
    "entry": "仰様",
    "reading": {
      "primary": "のけざま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
