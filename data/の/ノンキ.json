    },
    "definitions": [
      {
        "index": 1,
        "gloss": "easy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験前なのに、彼は呑気な顔をして漫画を読んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "都会の喧騒を離れて、田舎でのんきな生活を送るのが夢だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そんな呑気なことを言っている場合じゃない、締め切りは明日だぞ！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "さういふ定説といふものを云ひ出す方は案外呑気に云ひ出すのであるが、云はれる方は辛いものである。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに牧野さんが酔ふと発しはじめるのなぞは、当人に自制力がないよりも、周囲が彼にとつてはあまりに不真面目に見える所から起るのであつたと考ふべき点もあるのであるから、さういふ定説が呑気に繰返されることは辛かつたのである。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから又近頃は詩の定型無定型といふことが盛んに論じられてゐますが、私は定型にしろ無定型にしろ、面白ければいいといふ程の呑気なことしか考へてをりませんが、なんだか此の問題は具体的のやうでゐて、その実途方もなく遠大か何かのやうに受取れます。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "前二者が注射や服薬ならば、之は神経衰弱や軽微な肋膜の療養に似て、呑気にブラブラすることを要請してゐるのである。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "呑気にブラブラすることか、あゝそれならば楽だよと、云はれる人が多ければ、私なぞが亦何をか云はんやである。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様に、呑気にブラブラすることも容易とは見えぬのである。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みに、呑気にブラブラしてみて下され。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "して、感情基底の確立のためには、退いて呑気にブラブラすること勘要だらうと愚考するのである。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "三造は、この世に自分くらゐ切ないがまた、呑気といへば呑気な男はないと思つてゐた。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実彼は呑気であつた。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "家敷の二方に並ぶ病室からは、患者や附添人等の呑気な饒舌が、時には高く、その余はゴトゴトと聞えて来た。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その、呑気さうな言葉付が彼女には歯痒かつたが、その社長が、自分を可なり大事な者に考へてゐたことがその口振で分ると、彼女は急に、先刻解雇者の名前をみた時から忘れてゐた、それは若い女らしい、それを頭に浮べれば乳房のくらげのやうに伸縮し始める、その理想を再生させることが出来た。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "「兵隊も呑気でいいなあ」と竹村君が云うと「あなた方も気楽でしょう」といってにやにやした。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "若くて禿頭の大坊主で、いつも大きな葉巻を銜えて呑気そうに反りかえって黙っていたのはプリングスハイムであった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄道幹線から分れた田舎廻りの支線、いわゆるクラインバーンの汽車の呑気なのに驚いたのはこの時である。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰れに恐れる事も諛う事も入らぬ、唯我独尊の生涯で愉快だろうと夢のような呑気な事を真面目に考えていた。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "呑気にあせらずよく養生したためか、あの後はからだが却って前よりは良くなった。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思うとまた反対に向うへ行く人々の中には写真機を下げて遠足にでも行くような呑気そうな様子の人もあった。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "呑気そうな顔をしている人もあるが見ただけでずいぶん悲惨な感じのする人もある。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国へ渡るとなんだか急に呑気になった、巡査を見ても牛乳屋を見ても誰を見ても一様に呑気な顔をしていた。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国へ渡ってもやはり人の顔が間延びがして呑気に見えた。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京へ帰ると英国人のように呑気な顔も少ないがドイツ式に緊張した顔も少ない。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の会場は何となく緊張していたが当人のアインシュタインは極めて呑気な顔をしていた。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中のある人は、演説のある最中に呑気相に席を立ってどこかへ出て行ったりした。",
              "citation": {
                "source": "議会の印象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の絵はある点で甚だ無頓着に自由に且つ呑気そうに見えると同時に、また非常に神経過敏にあるいは少しく病的と思われるほど気むずかしいところがある。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝坊呑気に佇んで居る。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "車夫は呑気なものだと思う。",
              "citation": {
                "source": "小さき良心",
                "author": "断片",
                "note": "青空文庫"
              }
            },
            {
              "text": "知識階級の人は、こういう種類の見物にはあまり興味を持たないのか、それとも、花火の技術や現象などはとうにもう知っているから、いまさらこんなところで見物する必要がないのか、そうではあるまい、むしろそんなものをぼんやり呑気に見ているような暇がないのだろうと思ってみた。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつは、どうも、のんき過ぎますから。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大隅君は青空を見上げて、「しかし、東京は、のんきだな。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
