[
  {
    "uuid": "a68a6b92-04fe-5281-8152-e0960448fb9c",
    "entry": "呑気",
    "reading": {
      "primary": "のんき",
      "alternatives": [
        "ノンキ"
      ],
      "is_heteronym": false
    },
    "grammar": {
