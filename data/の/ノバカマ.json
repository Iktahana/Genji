        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "野袴の裾を端折って、灸のあとを出すのがある。",
              "citation": {
                "source": "天守物語",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわんや……で、綾の見事さはなお目立つが、さながら紋緞子の野袴である。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "野袴をつけた若者が二人、畠の道具を門口へ転がしたまま、黒燻りの竈の前に踞んで煙草を喫んでいる。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこで算用が違たやら」「ようい、よい」と野袴の一人が囃す。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に格之助が着込野袴で、白木綿の鉢巻を締めて行く。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に略格之助と同じ支度の平八郎が、黒羅紗の羽織、野袴で行く。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの多くは、陣羽織に野袴を穿いて旧式の六匁銃などを持っていたが、右の肩口には、いずれも錦の布片を付けていた。",
              "citation": {
                "source": "乱世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "虹汀、何事ぞと振り返るに、その数二三十と思しき捕吏の面々、手に／＼獲物を携へたる中に、彼の海中に陥りし半面鬼相の雲井喜三郎、如何にしてか蘇りけむ、白鉢巻、小具足、陣羽織、野袴の扮装物々しく、長刀を横たへて目前に追ひ迫り来り、大音｜揚げて罵るやう、やをれ悪僧｜其処動くな。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "上方風の細折結に羽二重の紋服、天鵞絨裾の野袴、二方革のブッサキ羽織に、螺鈿鞘、白柄の大小、二枚重ねの麻裏まで五分も隙のない体構え。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "深編笠に裾縁野袴、柄袋をかけた蝋鞘の大小、スッキリとした旅装い、足を入れたは東海道で、剣侠旅へ出たのである。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見上げた小一郎の眼の上に、わずか一間の間隔を置き、その武士の穿いている野袴の裾が、風に煽られて靡いている。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "野袴を穿き、編笠をかむった、立派なみなりのお侍様五人が、半僧半俗といったような、円めたお頭へ頭巾をいただかれ、羅織の被風をお羽織りになられた、気高いお方を守り、こなたへ歩いて来るからでした。",
              "citation": {
                "source": "怪しの者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "裾べり野袴に菅の笠、柄袋をかけた細身の大小、あられ小紋の手甲に脚絆、――旅装いは尋常であった。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "峠の路は歩きにくい、野茨が野袴の裾を引いたり、崖から落ちて来る泉の水が、峠の道に溢れ出て、膝に浸くまでに溜っていたりした。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜀紅錦の陣羽織に黄金造りの太刀を佩き、手には軍扇、足には野袴、頭髪は総髪の大髻、武者｜草鞋をしっかと踏み締めて、船首に立った其姿！",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "野袴に深編笠、金銀こしらえの立派な大小、グイと鉄扇を握っている、足の配り、体のこなし、将しく武道では入神者。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "広東出来の錦襴の筒袖に蜀紅錦の陣羽織を羽織り、亀甲模様の野袴を穿き、腰に小刀を帯びたままゴロリとばかりに寝ていたが、頸の周囲に白布で幾重にもグルグル巻いているのがいつもの頭領と異っている。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陣羽織も野袴も折目ただしく端然としていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その平馬がいま打割羽織に野袴、手馴れの業物を閂のように差し反らせて、鉄扇片手に春の野中の道をゆらりゆらりと歩いて行くのだ。",
              "citation": {
                "source": "平馬と鶯",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "けんかたばみの紋服に、浮き織りの野袴を裾短かに穿き、金銀ちりばめた大小を、そりだかに差した人品は、旗本衆の遊山旅か、千石以上の若殿の、気随の微行とも想われたが、それにしてはお供がない。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋へ通った若侍、年の頃は二十四五、背割羽織に裾縁野袴、柄袋をかけた長目の大小、贅肉のないひきしまった体格、武道に勝れた証拠であろう、涼しいながらに鋭い眼、陽焼けして色こそ赭いけれど、高い鼻薄い唇、純な乙女にも鉄火な女にも、うち込まれそうな風采である。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてはいてるのは野袴で、大将ですね。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶっ裂き羽織に裾縁野袴。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その範之丞は肉痩せてはいたが、身長は普通でスラリとしてい、そういう身体へ同じように、野袴をつけ羽織をつけ、編笠を深くかぶっていた。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "群衆に雑って深編笠に、野袴を着けた九十郎が、これも深編笠に野袴を穿き、両刀さえ帯びて男装した織江を、傍らに引き付けて立っていた。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "民弥はその梶子の亭主かのように、これも旅なれた武士の扮装――すなわち野袴に背割羽織、草鞋ばきに深編笠――と云った扮装で、梶子と親しそうに連れ立って歩いた。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次には私だが、私は既に十一歳だから、大小を帯び、父と同じ野袴紋附羽織に改めて通るのである。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒羅紗の筒袖の陣羽織を着て野袴を穿いていました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "如法闇夜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「小うるさい奴等だ……久助どの、お前はお雪ちゃんを連れて、その一軒家とやらへ隠れておいで……馬も、駕籠も、近くへは寄らぬこと」　馬から飛び下りて、右の手で野袴の裾をハタいて、それから笠の紐を取った竜之助の面は例によって蒼白い。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
