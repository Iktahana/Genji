          "literary": [
            {
              "text": "颯子ハ予ノソウ云ウ気持ヲ実ニ早ク見テ取ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ノソウシテイル様子ニ何トモイエナイ色気ヲ感ジル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　デイノソウルスの卵　これもある夜の応接間での話の中の一つである。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のタイムスを見ると、例のゴビの砂漠でデイノソウルスの卵を見付けたアンドリウスが、また中央｜亜細亜へ二年とかの計画で、何百頭とかの駱駝と途方もない人数の人とを引連れて出かけたようだ。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は、辞して帰る時、玄関まで送ってこられて、私が靴の紐を結んでいるのを立って見ておられながら、「デイノソウルスの卵が見付かったって人間がどうなるというのじゃないが、……それだから益々面白いんだなあ」と独言のようにいっておられた。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして十二時過ぎまで、ディノソウルスの卵の話や、パブロワの踊りの話をきく。",
              "citation": {
                "source": "寺田寅彦の追想",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
