        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "毎日の事ではあるけれども、それを見ると、君と言わず人々の胸の中には、きょうもまず命は無事だったという底深い喜びがひとりでにわき出して来て、陸に対する不思議なノスタルジヤが感ぜられる。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノスタレジイ……ノスタルジヤにホーム・シックでゲスかい。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の魂は永遠なるものの故郷に対するノスタルジヤに悩んでいる。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "漂泊の旅にはつねにさだかに捉え難いノスタルジヤが伴っている。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士は雪の大悲殿だビュン、ビュン吹きまくれ富士山は日本のイメージイだスフィンクスだ夢の濃いノスタルジヤだ魔の住む大悲殿だ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士はヒワヒワとした大悲殿だビュン、ビュン吹きまくれ富士山は日本のイメージーだスフィンクスだ夢の濃いノスタルジヤだ魔の住む大悲殿だ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本風な――笑ひますか、こんな言葉も一脈のノスタルジヤでせう。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……茫漠として古寂びたノスタルジヤが昼の雨に甦って来るように感じた。",
              "citation": {
                "source": "長崎の印象",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "書割で、我々は絶えず築地へのノスタルジヤを感じ通しであったが、ラネフスカヤは？",
              "citation": {
                "source": "シナーニ書店のベンチ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白状すると、僕はその頃ちよつとばかりノスタルジヤにやられてゐたのかも知れなかつた。",
              "citation": {
                "source": "夜の鳥",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスの一批評家をして「物になりきりたい」といわしめる言葉の背後にも、率直と、正直が、人間を離れていくノスタルジヤを表現したかと思われる。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "はるかなるノスタルジヤの香気、又、はなやかなエキゾチシズム、雨は降る巷々、窓の灯に人の子の悲しみははじまる。",
              "citation": {
                "source": "ニューフェイス",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼自身はそれらから無心に、全てを切り放して、彼自身の土民的なノスタルジヤを満喫すればそれでいゝのだ。",
              "citation": {
                "source": "淪落の青春",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後君が「亀清」の文字を削除したことも知つてゐるが、私はそんなことを此処で兎や角云ふのではない）さう云へば「亀清」で思ひ出したが、浅草生れの久保田君が公園から竜泉寺町界隈の地域に憧れを抱いてをられるが如く、当時われ／＼は、人形町、浜町、両国、柳橋附近の空気にノスタルジヤを感じてゐた。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもジャックは死ぬ前の最後のあがきのように、なおも創作の筆をとつたが、さすがにその中には、彼の著作のうちで一番楽しいアラスカの物語といわれる「古代のアーガスのように」と、彼の青年時代のノスタルジヤとしての傑作と云われる「王女」などがある。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
