        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コノコトハ子規ノ書イタモノニカタカナ文ガ多イコトヤ、宮沢賢治ノ病中作デアル「雨ニモ負ケズ」ノ詩ガカタカナデアルコトナドデ間接ニ証明サレルガ、ナオソレニツイテイササカインチキナガラ力学的ニ考察シタ文章ヲ他ノ場所ニ発表シタカラココニハ書カナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハチヨツト最初ニモ述ベタガ、要スルニ直線運動ト曲線運動トノ比較ニナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮明度、速力ナドニ関シテハモチロン、資材ノウエカラ労力ノウエカラ大変ナ経済ダト思ウガコノ種ノコトハ私ニハヨクワカラナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ一身上ノコトハ其筋ノ好意ニヨリテ、自宅ヘ一報ヲ乞ウ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテオ前ハ俺ノ行動ニツイテ、昼間飛行島デ別レテカラ後ノコトハ、スベテミナ忘レルノダ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノコトハ、交際上ニ於テハ毫モ論ズ可キコトニ有ラネド、尚古ノ道ニ取リテハ口惜キコトナラズヤ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "キモノノコトハ、マタ　アシタ　ゴサウダン　イタシマセウ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンノ下ノ小犬ノコトハオ母サンニ言ワナイデ下サイ九月三日午後七時半　ナイテイルカラカクシテモワカッテシマウト思イマス　小犬のことは、そのほかにも数通あった。",
              "citation": {
                "source": "アンゴウ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハ絶対ニ誰ニモ話シマセン。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ思イ出シタンデスガ、オ墓ノコトハドウナサルノ」「ソウ急グコトハナイサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラ忘レッポイト云ッテモ、コノコトハヨク覚エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノコトハ「己」ト云ッタリ「僕」ト云ッタリスルガ、二人キリノ時ハ自然「僕」ガ出ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼底出血ノ恐レハナイカト、検査シテ貰ッタコトガアルガ、眼底ノ血壓ニモ格別ノコトハナク、予ノ年齢トシテハ相当デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ母ハ浄吉ガ五歳ノ時、昭和三年ニ死ンダノデ、孫ノトコロヘ嫁ニ来タ颯子ノコトハ知ル訳モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「心電図ノ結果ハ矢張格別ノコトハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ノコトハ何モ云ウナト云ッテアルノデ、颯子ハ知ラナイ筈ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先祖代々江戸ッ子ダト云ッテモ、五六代先ノコトハ分リハシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ重ナリ工合ヤ歪ミ工合ハゴク僅カデ、動作ニ不便ヲ感ズルホドノコトハナク、人ニ気付カレルコトモナイノデ、今日マデソノママニシテイルガ、アノ日カラズット、今モソノ状態ガツヅイテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ手紙ノコトハ勿論斯波君ニハ云イマセンカラ安心シテイラッシャイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アナタノ今ノ良人ノコト、及ビ弘君ノコトハ、御依頼ガナクトモ親戚ノ一人トシテ、親子ノ性質ヲ最モ良ク理解シテイル友人トシテ、及バズナガラ出来ルダケノ事ハスル積リデスカラ、決シテ心配シナイデ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――二十七日告別式――二十九日香奠帳二册一號ト二號うさぎやニ屆ケル事、菓子ノコトハツキリコトハリ八月七日大草實、小峰八郎來ル芥川サンノ伯母來訪夜伯母サンニツイテうさぎやニ禮ヲノベニユク――十日墓ヲ見ニユク　芥川の家の墓地の檢分のことである。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハタダ自己満足ヲ得ル以上ノコトハ何モシテハイナイノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
