          "literary": [
            {
              "text": "ノータリンどもが」「おい、待て。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども世間は平作に同情どころか、「ノータリンの作男でもタダで雇えやしまいし、一人前に成人した長男にヨメもとらせずタダを幸いコキ使うから、こうなるのさ」と批評はつめたい。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "箸にも棒にもかからないノータリンの風格があった。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見、ノータリンに見えないからである。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "外れても自分の損にはならないようだから、ノータリンの坊っちゃんが何をやらかすかと面白ずくも手つだって、別に不平を云う者もいなかった。",
              "citation": {
                "source": "文化祭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えてみればノータリンのこの女がこう云うぐらいだから、その辺のことは警察が心得ていない筈はない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノータリンがこう云うのだから深刻だし、こう云わせる相手の男もノータリン。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            }
          ]
        }
