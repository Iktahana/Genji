        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今アナタノ顔ヲ見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "蚤ガ群ッテ集マルノデ眠ルノハ少シムツカシイ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今アナタノ顔見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お声もさはやかに御申渡しになり、少し間を置いて、お胸に何か浮んだらしく、うつむいてくすくすとお笑ひになり、管絃ノハウガイイヤウデス　とおつしやいました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕ヘル者ノハリツメタ心モ知ラヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤツレルノハ、女性ノ苦悩デス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワダツミ」「ワダノハラ」の「ワダ」は water や露の voda やその他同類の水を意味する言葉と類し、また「ワタル」という意味の wade(L. vadere) および関係の諸語と似ている。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『センダガヤノシヨウジヨゴロシノハンニンケンキヨサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "カモノハシという動物に酷似していると言った友人がありました。",
              "citation": {
                "source": "小さいアルバム",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人間ノ浮生ナル相ヲツラツラ觀ズルニ、オホヨソハカナキモノハ、コノ世ノ始中終マボロシノゴトクナル一期ナリ、――てれくさくて讀まれるものか。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナツマラナイ素描帳ヲ見テクダサイト言ウノハタイヘンツライノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春が来て、ヒトリ寝ルノハイヤナレド、花が咲くゆえがまんできけり」「おっといけねえ、いけねえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ガ昔カラ西洋ヲ見タガッテ居タノハ君モ知ッテルダロー。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナント　イフ　キレイナ　コヱデセウ」「アンナニ　ヨイ　コヱデ　ウタフ　コトノ　デキルノハ　タレデセウ」ト　ナタネノ　ツボミタチハ　ウツトリシテ　ササヤキアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソノ　ウチニ　ノハラノ　ムカフニ　ムラガ　ミエテ　キマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アソコヘ　ユケバ　タベモノハ　アル。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　テフテフハ、キノハノ　アヒダヲ　クグツテ　ソラ　タカク　トンデ　イキマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチノ　上ニ　ヒカツテ　ヰタ　モノハ、ナクナツタ　ホシデハ　ナクツテ、ガラスビンノ　カケラダツタノデス。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ、ソノ　ムラハ　アサニ　ナツテモ　ダレモ　オモテニ　デテ　クル　モノハ　ナク、マドサヘ　アケナイノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "センサウノ　タメニ　ワタクシタチハ　ハタケヲ　アラサレ、タベル　モノハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、モウ　センサウニ　イクノハ　ヤメニ　シマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサ　イチバン　ハヤク　オキルノハ　アノ　ヲトコデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ　マイタ　タネカラ　メガ　デテ　ノハラ　イチメンニ　ムギノ　ミノル　トキガ　ヤツテ　キタノデ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナノ　モノハ　タメイキヲ　シテ　カホヲ　ミアハセマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ミンナハ、カゲト　イフ　モノハ　タイヤウガ　ツクルノダト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ此ノ場合ニ於テ國家ハ別途其ノ父ニ對シテ賠償ヲ命ジ、從ハザルモノハ勞働ヲ課シテ賠償ニ充テシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ現時ノ對鮮策ナルモノハ甚ダシク英國ノ植民政策ヲ摸倣シタルガ故ニ、根本精神ヨリシテ日韓合併ノ天道ニ反スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
