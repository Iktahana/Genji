        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アラ磯ニ浪ノヨルヲ見テヨメル大海ノ磯モトドロニヨスル波ワレテクダケテサケテ散ルカモ　一言の説明も不要かと存じます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "野原ハ、毎日ノヨウニツメタイ風ガ吹イテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ山ハ私ガ実際ニ感ジルヨリモアマリ平面ノヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オツコツタノヨ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサツユハ　オツコチルト　コハレテ　シマフノヨ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエ　アリガタウ、デモ　オイタボウデ、トツテモ　オモイノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシネ、ドコカノ　カワイイ　アカチヤンヲ　ダツコシタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アンマリ、カワイカツタノデ、マダ　ダツコシテル　ツモリデ　カヘツテ　キタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからそれ以来、一層深くこの迷信に囚われたものらしく、死人があるたんびに駈け付けると、仕事をそっち除けにして、こうした呼び役を引き受けたので、仲間からはアノヨの吉と呼ばれているのであった。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しそれでも福太郎はまだ腑に落ちない顔で口真似をするかのように、「……アノヨ……アノヨ……」　と呟いたので皆は死ぬほど笑い転げさせられたという。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時にお作がアノヨの吉と一緒に踊り出した。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く同じ造りの二階家が数軒並んで、隣の二階にもわたしと同じやうな姿の若い士官がゐて夜更まで灯りの下で勉強して居り、そのまた隣も海兵の合宿所で時々、今日ハ手ヲ取リ語レドモ　明日ハ雲井ノヨソノ空　行クモ留ルモ国ノタメ　勇ミ進ミテ行ケヨ君――と合唱する聞くだに健やかな血の湧き立つ軍歌が響いた。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノトキ、私ニハドウシテモ、君チャンタチハオソロシイ、ノドマデクチノサケタオニノヨウニオモワレタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く同じ造りの二階家が數軒並んで、隣の二階にもわたしと同じやうな姿の若い士官がゐて夜更まで燈りの下で勉強して居り、そのまた隣も海兵の合宿所で時々、今日ハ手ヲ取リ語レドモ　明日ハ雲井ノヨソノ空　行クモ留ルモ國ノタメ　勇ミ進ミテ行ケヨ君――と合唱する聞くだに健やかな血の湧き立つ軍歌が響いた。",
              "citation": {
                "source": "緑の軍港",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上デ私ノ言イ分ハホボ尽キタワケデアルガ、シカシコノヨウナコトヲ書イタカラトイツテ私ガカタカナ運動デモ開始シタヨウニ思ワレテハ迷惑デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オソラヲ　ミレバズンズントオ山ノ　上ヲワタノヨニウイテル　クモモトビマシタ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒロコノコトカナラズ　ホツテオケ　ダテノヨウスニチュウイセヨ　ひろ子の事はほつておけ！",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ニハソノ顔ガ悪魔ノヨウニ見エマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネハ、イツモノヨウニ、ハンヲ、オシテ、アリマスカラ、コノママキョクヘ、トリニユキナサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクノヨブコエワスレタカ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニカイノ　アルトコロコノヨコチョウデス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ、……」（判読不能）僕「空電妨害ニ悩サル。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ以下語レ」相手「毒草ノヨウナモノヲツケタルモ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「本艦ハ唯今、×国ノ商船隊ト覚シキモノヨリ発シタル無線電信ヲ受信シタリ。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注26］九月十五日――十月九日の昼頃、顕治は『デタラスグカエレ、シユクシヤノヨウイアリ』という電報を東京からうけとった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デタラスグカエレイエノヨウイモアル。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
