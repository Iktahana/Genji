    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "国家のためということを考えて働いた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "畜産界のためということも考えて働いた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "人民のためということも考えて働いた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもただ自分のためということは、ほとんど胸中になく働いておった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばかげているというよりも、いまはそのあさはかな結婚のために、たまらないいやなくるしみをせねばならぬことになった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛想よくいつもにこにこして、葉巻きのたばこを横にくわえ、ざる碁をうって不平もぐちもなかった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "こればかりは親の力にもおよばないとはいうものの、むすめが苦悶のためにおもざしまで変わったのを見ては、実の親として心配せぬわけにはゆかない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょう小川さんの話を聞くと、小川さんはおまえのために三｜度も学校へよばれたそうだぞ。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとはきさまひとりをたよりに思ってれば、この始末だ、警察からまで、きさまのためには注意を受けてる。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜節見訪竹の里人下総のたかし来たれりこれの子は蜂屋大柿吾にくれし子下ふさのたかしはよき子これの子は虫喰栗をあれにくれし子春ことにたらの木の芽をおくりくる結城のたかし吾は忘れず　多くの場合に人に畏敬せられた先生にして、こんなことの有ったのは世人も少しく意外に感ずるのであろう。",
              "citation": {
                "source": "正岡子規君",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し再度出京の目的は自己の私心を満足させんとの希望ではない、衣食を求むるため生活の道を得んがため、老親の短き生先を自分の手にて奉養せんとの希望のためであった。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二荒の神のたはりし歌玉の五百玉わけて君と別れん上野停車塲に着く。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "すもゝ実るみなみ独逸のたかき国の中にありといふミユンヘンの町　その語句に於て着想に於て、その題目に於て、何等の巧みも新しみもあるのではない。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも判然はわからぬけれど念のため獣医を呼んで一応見せるがよかろうと申して。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "当区内の鵞口瘡は此六日を以て悉皆主治したとの話をした十二日　午前警視庁の巡回獣医来る　健康診断のためである。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒気のためによわったのであろうと思われた。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう飲食会すら気がすすまぬ　勿論今でも飲食が一番のたのしみではあるけれども以前の様ではない。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとなしき家畜のごとき心となる、熱やゝ高き日のたよりなさ。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は人のたずねに答えないのも苦しく、答えるのはなおさら苦しい。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸に覆うてある単物のある点がいくらか動いておって、それが呼吸のために動くように思われてならぬ。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔から何ほど暴風が吹いても、この椎森のために、僕の家ばかりは屋根を剥がれたことはただの一度もないとの話だ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "国家のために死んだ人の娘だもの、民さん、いたわってやらねばならない。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬉しいにつけても思いのたけは語りつくさず、憂き悲しいことについては勿論百分の一だも語りあわないで、二人の関係は闇の幕に這入ってしまったのである。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もお民さんのためにいくら泣いたか知れない……」　見ればお増はもうぽろぽろ涙をこぼしている。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一年前までは、民子が僕の所へ来て居なければ、僕は日曜のたびに民子の家へ行ったのである。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんはただただ御自分の悪い様にばかりとっているけれど、お母さんとて精神はただ民子のため政夫のためと一筋に思ってくれた事ですから、よしそれが思う様にならなかったとて、民子や私等が何とてお母さんを恨みましょう。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子のためには真に千僧の供養にまさるあなたの香花、どうぞ政夫さん、よオくお参りをして下さい……今日は民子も定めて草葉の蔭で嬉しかろう……なあ此人にせめて一度でも、目をねむらない民子に……まアせめて一度でも逢わせてやりたかった……」　三人は眼をこすっている様子。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前のたった一人の兄として、また、なくなられたお母さんの身代りとして、僕は、断然不承知だ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴を読め、鶴を読めと激しい語句をいっぱい刷り込んだ五寸平方ほどのビラを、糊のたっぷりはいったバケツと一緒に両手で抱え、わかい天才は街の隅々まで駈けずり廻った。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、女学校の廊下を、紅色の緒のたった、襲裏の上穿草履で、ばたばたと鳴らしたもので、それが全校に行われて一時物議を起した。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
