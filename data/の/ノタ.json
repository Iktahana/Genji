  {
    "uuid": "1eff89db-8c9e-5003-afcf-7959891062f6",
    "entry": "ノタ",
    "reading": {
      "primary": "のた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子孫ノタメトハ唐突デス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ゾウワイジケンノタメシユウヨウチユウノ××ハフキソトケツテイシマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "金五百円ハヤガテ君ガモノタルベシトゾ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "満鉄ヤ撫順ノタメニ諸君ノ暮シガチットデモラクニナッタカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "植民地再分割ノタメ帝国主義戦争ガ勃発スル可能性ガ十分ニアルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那革命擁護ノタメニ、諸君ハ支那ノ労働者、農民、兵士達ト力ヲ結合セヨ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこれが村の人達の共同の所有になっているセコノタキ温泉なのだった。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ニシビラへ行けばニシビラの瑠璃、セコノタキへ来ればセコノタキの瑠璃。",
              "citation": {
                "source": "交尾",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿ニ似テ非ナル猿面冠者ハオノガ立身出世ノタメニハ、主人ヨリ猿々ト呼ビ捨テラレルモ、ヘイヘイト追従笑ヒナド泛ベタルハ、即チ羞恥ヲ知ラザル者ト言フガ如シ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "電報は「ゾ　ウサンノタメシヨウガ　ツヤスミヘンジ　ヨウ」カエラヌ」ツルキチ」鶴さんからオトラ婆さんに宛てたものだった。",
              "citation": {
                "source": "電報",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間が何千円に当った訳だ、なぞと譏る者があるが、それは譏る方がケチな根性で、一生理屈地獄でノタウチ廻るよりほかの能のない、理屈をぬけた楽しい天地のあることを知らぬからの論だ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間が何千円に当つた訳だ、なぞと譏る者が有るが、それは譏る方がケチな根性で、一生理屈地獄でノタウチ廻るよりほかの能の無い、理屈をぬけた楽しい天地の有ることを知らぬからの論だ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが一九八五年一月のレーザーライタの発表に合わせて、アドビは組版システムの専業メーカーであるライノタイプ・ヘル社と共同で、ポストスクリプトに対応した印刷用機器をお披露目します。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は白帆を張つてノタといふゆるやかな波にゆられながら舳はいつも彌彦山へ向いて居た。",
              "citation": {
                "source": "彌彦山",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "海は極めて靜穩であるが沖へかゝつてからはノタといふ波が大きく搖れるので船が大きくゆらり／＼と搖れる。",
              "citation": {
                "source": "佐渡が島",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、死体をやや斜めにすると、ドロリと重たげに流れ出した血液で、たちまち屍光に暈と赤らんだ壁が作られ、それがまるで、割れた霧のように二つに隔てられてゆき、その隙間に、ノタリノタリと血が蜿くってゆく影が印されていった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、この三人は、まるで聖餐祭の行列みたいに、ノタリノタリと歩み入って来るのだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "封建時代ノ武士ガ凡テ後顧ノ憂ナキガタメニ其ノ道義的奮進又ハ犧牲的冒險ヲ敢行シ得タル如ク、國民ハ其ノ子女ノ國家的保障ノタメ戰場ニ於テモ平和ノ其レニ於テモ何等後顧ノ憂ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米人ノ持續セントスル國際的特權ノタメニ宣傳サレツツアル平和主義非軍國主義ガ、其ノ特權ヲ打破センガ爲メニ存スル日本ノ軍備及ビ戰鬪的精神ニ對スル非難トシテ輸入サレツツアル内容皆無ノ文化運動。",
              "citation": {
                "source": "日本改造法案大綱",
