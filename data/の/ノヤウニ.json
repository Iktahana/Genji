        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "和田ノ詮議モ終ラヌサキカラ、ソノヤウニ騒ギタテテハ、モノノ順序ガドウナリマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピイチク　ピイチク　ピイチク　ピイチク」　ヒバリノ　コヱハ　タカイ　ソラカラ　キンノ　アメノヤウニ　フツテ　キテ、ウマヤノ　ソバノ　ナタネノ　マワリニ　フリソソギマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、花タチノ　オドロイタ　コトニハ　ソレハ　花タチノヤウニ　キイロイ　キモノノ　カハリニ　マツシロイ　キモノヲ　キテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タニガワノ　オトガ　ダンダン　チカク　ナツテ　キタ　トコロデ、トツゼン　カゴカラ　トビダシ、カゼノヤウニ　ハヤク　グングン　ニゲマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デキアガツタ　クワガ　タクサン　ヘイタイノヤウニ　ナランデ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌスビトト　コヒツヂ新美南吉　ヤワラカイ　クサガ　ミドリノ　モウフノヤウニ　ハヱテ　ヰル　ヒロツパニ　タクサンノ　ヒツジガ　メイメイト　ナキナガラ　アソンデ　ヰマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンダマト　テフテフハ　タカイ　タカイ　トコロマデ　キマシタノデ、マチガ　ツミキザイクノヤウニ　チヒサク　ミエマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「――遠クニ見ユル村の屋根、近クニ見ユル町の軒、森ヤ林ヤ田ヤ畑、後ヘ／＼ト飛ンデユク――廻リ灯籠ノ絵ノヤウニ、変ル景色ノ面白サ、見トレテソレト知ラヌ間ニ、早クモスギル幾十里――」「何だか面白くねえな。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネハ、イツモノヤウニ、ハンヲ、オシテ、アリマスカラ、コノマヽキヨクエ、トリニユキナサイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ内ニ音ガ小サクナリ、風モ治マリ、柱状ノモノモ以前ノノヤウニ明瞭ニハ見エナクナツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ボンコチヤンハイツモ、アタラシイ時ノヤウニ美シウゴザイマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハモンコチヤンノトコロヘ　カヘツテ来ルト、スグニ、クシヤミガトマツテ、モトノヤウニ元気ナボンコチヤンニナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　マイニチノヤウニ　カメコオバサンハ　マルコオバサンノ　トコロヘ　サウダンニ　ユキマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝原益軒の『大和本草』に『仙覚抄』を引いて「浜ユフハ芭蕉ニ似テチイサキ草也茎ノ幾重トモナクカサナリタル也ヘギテ見レバ白クテ紙ナドノヤウニヘダテアルナリ大臣ノ大饗ナドニハ鳥ノ別足ツヽマンレウニ三熊野浦ヨリシテノボラルヽトイヘリ」とある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
