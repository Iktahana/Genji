[
  {
    "uuid": "ad0298e9-ecf2-5f0d-b133-a988a6819d20",
    "entry": "野中",
    "reading": {
      "primary": "のなか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "in the middle of a field",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "野中に咲く一輪の花が、都会の風景に彩りを添えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、よく野中を駆け回って遊んだものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "突然の雷雨で、野中にいた人々は一斉に雨宿りを探した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「千羽に一羽の毒がある」と云ってこの鳥の捕獲を誡めた野中兼山の機智の話を想い出す。",
              "citation": {
                "source": "郷土的味覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その娼妓のお琴という女が京都の日野中納言家の息女だと云って、世間の評判になったことがあります。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "落着いて見ると……「あゝ、この野中に、優にやさしい七夕が……。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六　野中兼山が「椋鳥には千羽に一羽の毒がある」と教えたことを数年前にかいた随筆中に引用しておいたら、近ごろその出典について日本橋区のある女学校の先生から問い合わせの手紙が来た。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "野中兼山は椋鳥が害虫駆除に有効な益鳥であることを知っていて、これを保護しようと思ったが、そういう消極的な理由では民衆に対するきき目が薄いということもよく知っていた。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七　野中兼山の土木工学者としての逸話を二つだけ記憶している。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はどうした結縁か、その顔色から容子から、野中にぼんやり立たしましたお姿なり、心から地蔵様が気に入って、明暮、地蔵、地蔵と念ずる。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　銀行を横にして、片側は燒け原の正面に、野中の一軒家の如く、長方形に立つた假普請の洋館が一棟、軒へぶつつけがきの（川）の字が大きく見えた。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と野中の古廟に入つて、一休みしながら、苦笑をして、寂しさうに獨言を云つたのは、昔、四川※都縣の御城代家老の手紙を持つて、遙々燕州の殿樣へ使をする、一刀さした威勢の可いお飛脚で。",
              "citation": {
                "source": "みつ柏",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "菖蒲、杜若は此處ばかりではない、前日――前々日一見した、平泉にも、松島にも、村里の小川、家々の、背戸、井戸端、野中の池、水ある處には、大方此のゆかりの姿のないのはなかつた。",
              "citation": {
                "source": "飯坂ゆき",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "初の烏　あの、（口籠る）今夜はどういたしました事でございますか、私の形……あの、影法師が、この、野中の宵闇に判然と見えますのでございます。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（みずから天幕の中より、燭したる蝋燭を取出だし、野中に黒く立ちて、高く手に翳す。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎の他土地とても、人家の庭、背戸なら格別、さあ、手折っても抱いてもいいよ、とこう野中の、しかも路の傍に、自由に咲いたのは殆ど見た事がない。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり畝道をあるきつかれて野中の丘に坐すればなにごとの眺望かゆいて消えざるなし。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或日良寛さんは、野中の一本道を歩いてゐた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　良寛さんは、菫の花を摘んでゐて、その鉢を野中に忘れて来てしまつたのであつた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "野中弥一　国民学校教師、三十六歳。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥田義雄　国民学校教師、野中の宅に同居す、二十八歳。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "授業中に教師野中が書いて、そのままになっているという気持。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "」などという声と共に、上手のドアをあけ、国民学校教師、野中弥一が、ひとりの泣きじゃくっている学童を引きずり、登場。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "（野中）（蒼ざめた顔に無理に微笑を浮べ）何も、叱るんじゃないのだ。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "（野中自身の腰にさげてあるタオルを、学童に手渡す）（学童）（素直にタオルで涙を拭く）（野中）（そのタオルを学童から取って、また自分の腰にさげ）よし、さあ歌ってごらん。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "（学童）（歌い終ってうつむく）（野中）（机に頬杖をつき）ありがとう。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "（学童）（首を振る）（野中）　誰も教えてくれなくても、自然に覚えたの？",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "（学童）（だまっている）（野中）　この歌の意味が、よくわかって歌っているの？",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "（学童）（うなだれたまま、だまっている）（野中）　決して叱りやしないから、思っている事をそのまま言ってごらん。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "（学童）（だまっている）（野中）　なんとか一言でいいから、言ってくれよ。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "学童、無言で野中教師にお辞儀をし、上手の出入口から退場。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "野中は、それを見送り、しばらくぼんやりしている。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔月光の鉛のなかに〕宮沢賢治月光の鉛のなかにみどりなる犀は落ち臥し松の影これを覆へり",
              "citation": {
                "source": "〔月光の鉛のなかに〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
