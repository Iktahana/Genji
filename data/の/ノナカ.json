  {
    "uuid": "0f8ec587-b426-5d90-a020-3f7f548f47e2",
    "entry": "ノナカ",
    "reading": {
      "primary": "のなか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "從テ何等カ不穩矯激ナル者ノ伏在セルカニ感ジテ草案者ニ質問照會スル等ノナカラムコトヲ望ム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチノナカガジトジトシテ、アルクト足ガタタミニネバル。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラヤミノナカデ、オ母ッチャノコエガスルト、ヤットアンシンスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ケレド、アヒルサントオネコサンハ心ノナカデイヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間ノナカデモ、ソンナニ、利口ナ子供ハ、アマリイマセンヨ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　シカタガナクテ、汽車ノナカノアミダナニモグリコミマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キツト、オナベノナカダ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」四　ソコデ、ミンナ、ハシツテ、ダイドコロヘイツテ、オナベノフタヲトリマシタラ、ソノナカニ、ジヤガイモサンガヰマシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンダカサムクツテシカタガナイカラ、コノナカデ、ホンヲヨミマセウ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、ヨノナカハヒトノキヲシランヤツガオホクテコマル。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドロノナカニ　コロガツテヰルト、ナニカ　ウチノナカデサワガシイ　オトガ　シハジメマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンガ　オツムノナカデ　クルクルマハツテ　パチント　コワレタノヂヤナイカト　オモツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボク　オキアガツテ　キヤラメルヲ　カゾヘテ　ハコノナカヘシマツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラタチノ　カキノナカカラ　タカヲチヤンガ　ヨンデル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "目的ノナカツタ丈　冷静デアツタ太陽ガ汗ニ濡レタ背ナカヲ照ラシタ時影ハ背ナカノ前方ニアツタ人ハ云ツタ「あの便秘症患者の人はあの金持の家に食塩を貰ひに這入らうと希つてゐるのである」ト‥‥‥‥‥‥‥‥‥‥‥１９３１・６・５",
              "citation": {
                "source": "異常ナ可逆反応",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫉妬ガ醸ス激シイ情熱、妻ノ全裸体ヲ思ウ存分見ルノナカッタ法悦境ニ浸リツツアルノヲ思ッテ、自分ノ幸福ヲ感謝シナイデハイラレナイガ、同時ニマタ、コンナ幸福ガイツマデツヅクハズハナイ、イツカハ報復ガ来ルノデアル、自分ハ刻々ニ命ヲ削リツツアルノデアル、トイウ豫感モシテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨクモテツノハコノナカノモノヲ、カクシタナ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋田県の鹿角ではエノナカベンケ、是も石川・富山のエンナカと同様に、炉側のことではないかと思う。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　このホムダの天皇の御子のワカノケフタマタの王が、その母の妹のモモシキイロベ、またの名はオトヒメマワカ姫の命と結婚して生んだ子は、大郎子、またの名はオホホドの王・オサカノオホナカツ姫の命・タヰノナカツ姫・タミヤノナカツ姫・フヂハラノコトフシの郎女・トリメの王・サネの王の七人です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天皇、葛城のソツ彦の女の石の姫の命（皇后）と結婚してお生みになつた御子は、オホエノイザホワケの命・スミノエノナカツの王・タヂヒノミヅハワケの命・ヲアサヅマワクゴノスクネの命のお四方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、履中天皇・反正天皇履中天皇とスミノエノナカツ王――大和の漢氏、多治比部などの傳承の物語。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにスミノエノナカツ王が惡い心を起して、大殿に火をつけました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで河内のタヂヒ野においでになつて、目がお寤めになつて「此處は何處だ」と仰せられましたから、アチの直が申しますには、「スミノエノナカツ王が大殿に火をつけましたのでお連れ申して大和に逃げて行くのです」と申しました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇が臣下に言わしめられますには、「わたしはあなたがスミノエノナカツ王と同じ心であろうかと思うので、物を言うまい」と仰せられたから、「わたくしは穢い心はございません。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミノエノナカツ王と同じ心でもございません」とお答え申し上げました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また言わしめられますには、「それなら今還つて行つて、スミノエノナカツ王を殺して上つておいでなさい。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "スミノエノナカツ王に近く仕えているソバカリという隼人を欺いて、「もしお前がわたしの言うことをきいたら、わたしが天皇となり、お前を大臣にして、天下を治めようと思うが、どうだ」と仰せられました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
