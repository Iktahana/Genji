        "examples": {
          "standard": [
            {
              "text": "西洋哲学史の講義で、普遍概念の実在を否定するノミナリズムの立場について熱心に議論した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は中世哲学を専門としており、特にウィリアム・オブ・オッカムのノミナリズムに強い関心を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "現実の個物を重視するノミナリズム的思考は、現代の科学的アプローチにも通じるところがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "だから反封建的なノミナリズム的な経験論的機械論（之が近世ブルジョアジーの本来の世界観であった）が、絶対君主主義などと理論的に結合することも強ち不可能ではなかったので、恰もホッブズの倫理思想は、そうした場合に相当するものに他ならなかったわけだ。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々はこうした場合、ノミナリズムの真理を忘れてはならないだろう。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
