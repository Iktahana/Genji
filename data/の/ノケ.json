        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今ニ見ヨ、ナド匕首ノゾカセタル態ノケチナ仇討チ精進、馬鹿、投ゲ捨テヨ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクテアシタハヒルトナリ、　　水音イヨヨシゲクシテ、　鳥トキドキニ群レタレド、　　　ヒトノケハヒハナカリケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いッそエノケンの孫悟空と逃げて満州辺へロケに来てやろうかとも考えたり、とりとめが無い。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和九年四月、渋柿）曙町より（二十）　有名なエノケンをはじめて映画で見た。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "エノケンもそれまでにはだいぶ距離がある。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日見た「エノケンの酔虎伝」でもお客様に出してある菓子を略奪に出て来る男の子がどの俳優よりもいちばん自然で成効しているように思われた。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "野芥（ノケと読む）といふ部落があつた、珍しい地名。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、樹明君、敬治君来庵、酒と汽車辨当を買うて、三人楽しく飲んで食べて話した、夕方からいつしよに街へ出かけてシネマを観た（トーキーでないので、せつかくのヱノケンも駄目だつた）、それから少し歩いて、めでたく別れた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎は毟った花を大切そうに右手に持ち、素直に、「ウン」とついて来るから、私はまた上機嫌で、「ほら、じゃあ一緒に歌うんだよ」と音痴の大声で、「箱根の山は天下の険」一郎には文句が難しいと見え、舌を縺らし、「ハコネノヤマハエンカノケン」、「エンカじゃない、テンカ、つまり世界でも嶮しい山だと言うのだよ。",
              "citation": {
                "source": "箱根の山",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "その美しさにふさわしいこの歌を是非、一郎に覚えさせねばならぬと、「箱根の山は天下の険、函谷関もものならず」、「ハコネノヤマハエンカノケン　カンゴクカンモモノナラジュ」と親子二人、歌い喚きながら、人一人通らぬ箱根山を歩いて行った。",
              "citation": {
                "source": "箱根の山",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ母ッチャモヤセテ、目ガヒッコンデ、カミノケガヌケタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンダオ父ッチャヨリモヤセテ、カミノケガヌケテ、ネテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は泣くに泣かれぬ気持で、後にノケ反って頭髪を掻きむしった。",
              "citation": {
                "source": "苦力頭の表情",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノサワギノ最中蚊帳ノ釣手ガフッツリ切レテ上カラ下リマシタノデ、私ハ一気ニ之ヲハネノケテシマイマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わッ」　見よ、小次郎は、はじめて抜いた長目の太刀を、延び延びと構えて前へ差しつけ、その先で右衛門が海老のようにノケゾリ、まさに倒れようとしているではないか。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やや手荒く屏風をひらき……「わッ」　と陸奥守はノケゾッた。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而し手許が不如意の時は上海あたりの大きな幇匪から借りてでも彼等仲間の儀礼を尽さねばノケ者にせられてしまう。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "折角いらしたのだから上野、浅草、明治神宮、日比谷、エノケンからデパートまでおともしました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、それどころか、あの日は、まるで水浅黄の丸い雲の塊が寝台の横へおりたと思うと、エノケンの孫悟空の舞台の五色雲のつくりものではないが、忽ちスルスルと糸にひっぱられて消えてしまったというような工合でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "反宗のサノケサミが文化連盟について変なこと云ってることがわかって、大変ためになった。",
              "citation": {
                "source": "日記",
                "author": "一九三一年（昭和六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十四日に間に合うように和一郎と小枝との結婚を祝う電報をうったなかに伸子はハハノケンコウノタメアメリカケイユデコラレヨと云ってやった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時期ナンセンスな流行歌と漫才とエノケン、ロッパの大流行をみたのは、人心のどんな波動を語っていたのだろう。",
              "citation": {
                "source": "昭和の十四年間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ断つておかねばならぬことは、私は嘗て「エノケン」なるものを三十分ほど見物した。",
              "citation": {
                "source": "ロツパの「楽天公子」",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、「エノケン」は「下町式」、「ロツパ」は「山ノ手」式だといふことがよくわかる。",
              "citation": {
                "source": "ロツパの「楽天公子」",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エノケン」の場合もさうであつたが、たしかにこれらの「新興劇団」は、今日までの芝居がもつてゐないものを、それ自身の性格のなかに併せもつてゐるのである。",
              "citation": {
                "source": "ロツパの「楽天公子」",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロツパには、嘗つての「エノケン」に於ける如く、この三つの特色が、ある程度まで具はつてゐることを私はやはり感じた。",
              "citation": {
                "source": "ロツパの「楽天公子」",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エノケン」の人気は、或は一時的であるかもわからぬが、これは、必ずしも「大衆」の求めてゐたもののすべてではなくて、ただ、これまでの芝居と、「半同半異」の程度に、その「特殊さ」を独立させたことが原因である。",
              "citation": {
                "source": "演劇の大衆性",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌舞伎には歌舞伎俳優的空想があり、新派には新派俳優的空想が、曾我乃家には曾我乃家的、エノケンにはエノケン的空想があつて、それぞれ、芝居を種々な意味で「面白く」してゐるが、一方、運命的に舞台を伝統と因襲と悪趣味の虜たらしめてゐるのである。",
              "citation": {
                "source": "稽古のしかた",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アツイオ日サマノ光デ、マヒゴノカラダモアタマモ、アタマノケモヤツトフダンノ通リ、人間ノ子ドモラシクイキイキトシテキマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
