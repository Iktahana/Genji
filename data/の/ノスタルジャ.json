          "literary": [
            {
              "text": "焼いて嗅ぎましょノスタルジャア。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "大分ノスタルジャにかかって居るらしい記者に会った。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその後、リスキンとキャプラのコンビのものの基調に、かかる感じのもの「太平洋のまんなかの島に二人で住みたい」という底の恋人のセリフを見いだしたことがあったが、私が、このまる三年、東京に住みついて、このノスタルジャ、淡いユートピア気分がわかるような気がするのである。",
              "citation": {
                "source": "過剰の意識",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "織田が二流文学というときには、一流文学のノスタルジャがある。",
              "citation": {
                "source": "大阪の反逆",
                "author": "――織田作之助の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノスタルジャーがあるというのかしら。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
