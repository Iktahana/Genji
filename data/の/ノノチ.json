          "literary": [
            {
              "text": "「――コノママワガ戦隊ガ前進ヲツヅケルトキハ十分ノノチ、彼ノ艦隊卜衝突ノホカナシ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナオ戦闘開始ノノチハ、トキドキニセノ無電ヲウチ、アタカモ日本潜水艦デアルヨウニ、アメリカ艦隊ニ思ワセルコト」　と、命令をだした。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒコートウノコージハオモイノホカハヤクデキアガルコトガワカッタタブン三シユウカンノノチトオモワレル。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
