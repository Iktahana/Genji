        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さつそく店まで出かけて、米を買ひ醤油を買ひ焼酎を買ひ、煙草を買つた、そしてすつかり楽天老人となつた、ノンキナ　ヲヂサン　バンザイ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "小磯内閣の退陣に当たり印象に残ったのは、米内海軍大臣の朗々たる声と率直な物の言い方、杉山陸軍大臣の年齢に似ぬ元気な、そして円い物の言い方、町田ノンキナトウサン無任相のぼんやりした顔、前田運通相の悪相、緒方国務相の疲れた顔、まずそんなところなり。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が国でも、甘栗太郎の店頭にはノンキナトウサンの人造人間が、このような所作をして甘栗の宣伝をしていた。",
              "citation": {
                "source": "人造物語",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次は、ノンキナトオサンである。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処へ、ノンキナトオサンがノコノコ歩いて来る。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノンキナトオサンの顔は、何時の間にか、平造の顔に変る。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノンキナトオサンは、いきなり踊り子の手を取らうとする。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ノンキナトオサンはもう足が動かなくなる。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソコニ　トナリノ　ポチガ　ノンキナカホデ　ネソベツテヰマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
