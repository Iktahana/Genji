          "literary": [
            {
              "text": "國語問題ハ文字又ハ單語ノミノ問題ニ非ズシテ言語ノ組織根底ヨリノ革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反してノミノツヅリ、ノゲシ、オニタビラコなどが最もよく生えるものダ。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギシギシという草を方言にノミノフネといい、これを室内に撒いて後で集めて流すと、蚤はこれに乗って海へ行くと信ぜられている。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
