        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アノ成田様ノオ護符ノコトヲ思ウ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼナラバ、我輩ハ英語ニ於イテ、聞キトルコトモ、言ウコトモ、ソノホカノコトモ、スベテ赤子ノ如キデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "厩戸ノ皇子ノコトヲモツト知リタイ　と口癖のやうにおつしやつて、聖徳太子の御治蹟に就いて記されてある古文籍を、広元入道さまや、問註所の善信入道さまにもお手伝ひさせて、数知れずどつさりお集めになり、異常の御緊張を以てお調べなされて居られたのも、その頃のことでございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "超人説ケル小心、恐々ノ人ノ子、笑イナガラ厳粛ノコトヲ語レ、ト秀抜真珠ノ哲人、叫ンデ自責、狂死シタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉛筆持参ノコト東洋新報」　そんな三行広告が新聞に出ている朝、豹一が定刻より一時間早く北浜三丁目の東洋新報の赤い煉瓦づくりのビルへ行ってみると、もうまるで何ごとか異変の起ったような人の群が一町も列を成して続いていた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁場到着後ナルトキハ、日割ヲ以テ精算ノコト。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　――ソレハ、ナンノコト？",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ、者裏ニ向ッテ、一隻眼ヲ著得セバ、スナワチ、前百丈（野狐ノコト）風流五百生ヲカチ得タルヲ知リ得ン。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ有罪ヲ假定スルガ故ニ未決期ノ日數ヲ刑期ニ加算スル等ノコトアルニテ明カナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホンヤクノコトデ　タノミアルスグ　キテクレ」　彼は、わたしの部屋の壁、ライフル銃もロビンソンもオルゴールも、ペナントも、昆虫標本の額も、みんなどこかへ棄てられて、それらのものゝかゝつてゐた痕だけ白い壁に、途徹もない論文の抜き書ばかりが落書されてゐるのを発見した。",
              "citation": {
                "source": "幽霊の出る宮殿",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハ子規ノ書イタモノニカタカナ文ガ多イコトヤ、宮沢賢治ノ病中作デアル「雨ニモ負ケズ」ノ詩ガカタカナデアルコトナドデ間接ニ証明サレルガ、ナオソレニツイテイササカインチキナガラ力学的ニ考察シタ文章ヲ他ノ場所ニ発表シタカラココニハ書カナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キワメテアタリマエノコトナノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハチヨツト最初ニモ述ベタガ、要スルニ直線運動ト曲線運動トノ比較ニナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮明度、速力ナドニ関シテハモチロン、資材ノウエカラ労力ノウエカラ大変ナ経済ダト思ウガコノ種ノコトハ私ニハヨクワカラナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同書第一巻、政治の部の註に、本文自主・任意・自由ノ字ハ、我儘放盪ニテ、国法ヲモ恐レズトノ義ニ非ラズ、総テ其国ニ居リ、人ト交テ、気兼ネ遠慮ナク、自分丈ケ存分ノコトヲナスベシトノ趣意ナリ、英語ニ之ヲ「フリードム」又ハ「リベルチ」ト云フ、未ダ的当ノ訳字アラズ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "お沙汰書に――向後、土地｜墾闢、人民｜蕃殖、北門ノ鎖鑰厳ニ樹立シ　皇威御更張ノ基ト可相成――とあり、黒田清隆の上書にもちゃんと明記されている、「開拓ノコト宜シク漸ヲ以テソノ成功ヲ責メ、官吏ヲ減ジ、煩擾ヲハブキ、仁政ヲ施シ、人心ヲ安ンジ、賦税ヲ軽クスルニアリ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒロコノコトカナラズ　ホツテオケ　ダテノヨウスニチュウイセヨ　ひろ子の事はほつておけ！",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ一身上ノコトハ其筋ノ好意ニヨリテ、自宅ヘ一報ヲ乞ウ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワシハオ勝ノコトガ心配デナラン。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ライヨウマルノコトヲ、オモイダシテクダサイ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテオ前ハ俺ノ行動ニツイテ、昼間飛行島デ別レテカラ後ノコトハ、スベテミナ忘レルノダ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "出勤次第、第二号「テレビジョン」機ヲ「スタート」ノコト。",
              "citation": {
                "source": "ある宇宙塵の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "受影機ノ同調周波数ヲ七万付近ニ選ビ、調整ノコト。",
              "citation": {
                "source": "ある宇宙塵の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「清サンハ、ホントニ、キカイノコトガ、オ上手デス」",
              "citation": {
                "source": "杏の若葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノコトハ、交際上ニ於テハ毫モ論ズ可キコトニ有ラネド、尚古ノ道ニ取リテハ口惜キコトナラズヤ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
