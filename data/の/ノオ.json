        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アノ成田様ノオ護符ノコトヲ思ウ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年私ハ、小サイタライノオ風呂ニ二三日ゴトニ入リマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝成田様ノオマモリガ参リマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "以下該詩集に関するルネ・マルチノオ氏の論文の概要を記さうと思ふ。",
              "citation": {
                "source": "トリスタン・コルビエールを紹介す",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩は鋼鉄のように硬くなりながらも、イワベンケイ、ミヤマダイコンソウ、ムカゴトラノオなど、黄紫のやさしい花を、点々とその窪洞に填めながら、ギザギザに尖っている輪廓を、無数に空に投げ掛けている。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "人から借りていた書籍はそれぞれ返却し、手紙やノオトも、屑屋に売った。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史なんかも、教師はわざわざノオトを作らせてそれへ講義の要點を書き込めと言ひつけたが、教師の講義は教科書を讀むやうなものであつたから、自然とそのノオトへも教科書の文章をそのまま書き寫すよりほかなかつたのである。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノオトを貸してもらい、また試験の時には、お前の座席のすぐ隣りに坐ってもらうためであります。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言ってノオトブックを僕の鼻先に突きつけた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と僕は、ノオトブックの問題を、ろくに見もせずに言ったら、「だって、あんたは大学へはいったんでしょう？",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから「築地小劇場史」だの「演出論」だの「映画俳優術」だの「演出者ノオト」だの、それから兄さんが貸してくれた「花伝書」。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエスですか、ノオですか。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな花火なんかやめて、イエスかノオか、言って下さい。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しずつノオトに書きしるしていっているのであるが、いま、「文芸雑誌。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "」創刊号になにか書くことをすすめられ、何を書こうかと、ノオトを二冊も三冊も出してあちらを覗き、こちらを覗きして、夕暮より、朝までかかった。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども将軍家は、例のあの、何もかも御洞察なさつて居られるやうな、また、なんにもご存じなさらぬやうな、ゆつたりした御態度で、すこしお笑ひになつて、世ヲ捨テタ人ノオ気持ハ　と更にお尋ねになりました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」タツタ一年ノオ留守番モデキヌヤウデハ、重臣ノ甲斐ガアリマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八頭の大蛇を「ヤマタノオロチ」という。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、昨年の暮に仏国で試験したペルジョンノオ式というのは、長い導線を引かずに無線で写真を電送するのだそうな。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私があまりに唯々諾々と従ったら、周さんは敏感に察したらしく、声を挙げて笑い、「しかし、あさってからは学校へ出て、僕と一緒に講義のノオトをとりましょう。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のノオトは、たいへん下手ですが、ノオトは僕たち学生の、」と言って、少しとぎれて、「Preiszettel のようなものです。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白くなくても、ノオトをとらなければいけません。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分もこれから周さんに負けずに先生の崇拝者になろう、先生の講義の時には、必ず最前列の席に陣取ってノオトをとろう、周さんはきょう学校に出ているかしら。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は学校の帰りに周さんを私の下宿に引っぱって来て、こたつにあたり、まんじゅうを食べながらいろいろ話をして、そのうちに周さんは、妙な笑いを顔に浮べて、周さんの鞄からノオトを一冊取り出して私のほうにのべて寄こした。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、藤野先生の解剖学のノオトである。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノオトを持って来て見せなさい。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
