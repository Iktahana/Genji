        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはノオトル・ダァム・デ・シャン街の町角であつた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは氣持のよい、人出入りの多い病院ではあるけれど、私達はノオトル・ダァム・ド・パリの正面を眺めようとしたら、ほとんど命がけだ。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めて欧羅巴の土を踏んだ岸本は、上陸した翌日、マルセエユの港にあるノオトル・ダムの寺院を指して崖の間の路を上って行った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァヴァンから下宿をさして歩いて行くと、丁度｜羅馬旧教のコンミュニオンの儀式のある頃で、ノオトル・ダムの分院の前あたりで寺参りの帰りらしい幾人かの娘にも行き逢った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はセエヌの河岸についてサン・ルイの中の島へと橋を渡り、そこから古いノオトル・ダムの寺院の裏手が望まれるところへ出た。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "モン・パルナッスの並木街をノオトル・ダムの分院の前あたりまで歩いて行くと、その辺には漸くマロニエの青い芽が見られた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　セエヌの河岸の中でも、オステルリッツの橋の畔から古いノオトル・ダムの寺院の見える中の島あたりへかけては岸本の好きな場所で、過ぐる三年の月日の間、彼はよくその河岸へ旅の憂さを忘れに来た。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "市街の向つて右の石山の上にはノオトル・ダムの尖塔と黄金の女神像とが聳えて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "未だ巴里のノオトル・ダムを観る暇の無かつた晶子は之に見恍れて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノオトル・ダム（晶子）ああ巴里の大寺院ノオトル・ダム。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "御寺は巴里のノオトル・ダムやツウルのカテドラルと同期に建てられたゴシツクではあるが少し様子が異つて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "高台と低地との間の傾斜地に属する街が最も旧い街なのでサン・ギユドユルだの、ノオトルダム・ド・サブロンだのと云ふ十三四世紀のお寺や、奇体な窓を幾つも屋上に建て出した古風な老｜屋などが其処に多く見出される。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して京都の八坂神社の塔を意外な建込んだ街中に発見する如く、広場の一方の人家の上に有名なノオトル・ダムのカテドラルが古色を帯びて屹立する雄姿を仰ぐのであつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時半頃に、それは極く小さい煙花の一つがノオトル・ダムのお寺の上かと思ふ空に上つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいでせう、ランスには巴里やアミアンのノオトル・ダムと同じ古さのカテドラルがありますわ、それから三鞭酒の名高い産地ですわ。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面に近く脂色をしたのがオペラだ、左に遠く、ちいさく、日を受けてうすもも色をしたのがノオトル・ダムだ。",
              "citation": {
                "source": "梅原良三郎氏のモンマルトルの画室",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャアトルの本寺は、巴里のノオトル・ダァムよりも、ずつと傷んでゐるやうに私には思へる。",
              "citation": {
                "source": "日時計の天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "）先生は、あたかもノオトル・ダァムにでも居るかのやうに、もの靜かに、落ち着いて、それ等のものを深く理解し、受け入れてゐられた。",
              "citation": {
                "source": "日時計の天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノオトル・ダム寺院　よく見る絵だ。",
              "citation": {
                "source": "巴里素描",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里にノオトル・ダアムがある。",
              "citation": {
                "source": "伝通院",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは十二月八日、漁夫達の護神、ノオトル・ダアム、ドゥ・ボンヌ・ヌウヴェルの祭日で、――行列が濟んだ少し後であつた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ理由から、この花は、ほかの所では、ノオトルダムの手袋だとか、マリアのてぶくろだとか、又指袋だとか云はれてゐます。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
