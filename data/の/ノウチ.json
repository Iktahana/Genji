[
  {
    "uuid": "8f896d8d-8fb5-50af-aa00-4f39df1a5844",
    "entry": "農地",
    "reading": {
      "primary": "のうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "agricultural land",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "開発計画のため、広大な農地が宅地に転用されることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地域では、高齢化により耕作放棄された農地が増加している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私たちの食卓に並ぶ野菜は、この豊かな農地で育てられています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "まわりの農地は、個人の地位身分によって、相応の分が割り当てられた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして水夫のような仕事にはとても役に立たないから、幸いオークランドに小農地を持ってとにかく暮らしを立てている甥を尋ねて厄介になる事になったので、礼かたがた暇乞いに来たというのだった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大地主は、農地全面積の四分の三を占めていたが、その五分の一しか耕作されていなかった。",
              "citation": {
                "source": "労働者農民の国家とブルジョア地主の国家",
                "author": "――ソヴェト同盟の国家体制と日本の国家体制――",
                "note": "青空文庫"
              }
            },
            {
              "text": "農民組合は日本全国にわたって供出の合理化と公正な農地調整法の実現のために闘っており、日本でははじめて全国的な農民組合婦人部の大会が近々にもたれようとしています。",
              "citation": {
                "source": "国際民婦連へのメッセージ",
                "author": "――「女性を守る会」から――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「湖水の星」は、ナチスの侵略で旧いポーランドの権力が崩壊し、西部ウクライナが解放され、そこに新しい農地と新しい人間関係が生れいく姿が描かれた。",
              "citation": {
                "source": "ワンダ・ワシレーフスカヤ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "社説は輿論の中心題目であった天皇制の問題、農地改革と日本の農村民主化の問題、労働人権擁護問題、憲法改正問題、総選挙について活溌にとりあげた。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "敷地外には借地も含めて約三〇ヘクタールの農地があり、野菜類や牧草などを栽培している。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい時代に新しく起すここの農業は、旧藩に於ける農地の概念を当てはめることは出来ない。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の眼中に新しい農地法なぞはない。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "農地解放なぞということでは人一倍痛めつけられ、家事を委せきっていた妻の死後のことであるから、これらの甚だ不馴れなことに彼自らかかりきって浮世の汗水にまみれなければならず、日夜悲涙をのまなければならなかった。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまたま小山内歌子が女学校を卒業し、当時農地解放なぞで家が困窮していたので、小学校の教員になった。",
              "citation": {
                "source": "女剣士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他「イペリット眼」は興味ある題材だが人物の捉へ方が浅く、「雪明り」は確かな眼は感じられるけれども、感覚の旧さが気になり、「北農地」は克明といふだけで飛躍がなさすぎる。",
              "citation": {
                "source": "清潔な文章を買ふ",
                "author": "――芥川賞（第二十一回）選評――",
                "note": "青空文庫"
              }
            },
            {
              "text": "越後の西蒲原といえば小作争議発祥の地で日本一の貧農地帯であった。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の農地を持たない百姓である。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦後には農地解放となり、全農家が自作農になるに及んでさらに大変化が起った。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "農地のマンナカにつくられた農学校は生徒がいなくてガラあきだというのである。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "農地解放をもっと利用すればよかったんだ。",
              "citation": {
                "source": "スポーツ・文学・政治",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "農地解放という与えられた革命すらできないくらいの国民なんだ。",
              "citation": {
                "source": "スポーツ・文学・政治",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つは農地の解放で、一つは戦争抛棄という新憲法の一項目だ。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "農地解放という無血大革命にも拘らず、日本の農民は全然その受けとり方を過ってしまった。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "占領軍の指図による農地解放などは、古今東西の歴史に照しても大革命の一種である。",
              "citation": {
                "source": "戦後合格者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "恵まれた平和な時に於て、外交に貿易に工場経営に農地経営に医療施設に文化施設に、良き実際の仕事を行って真価を問い、大多数の中間人を納得させることこそ、本当にやらねばならぬことではないか。",
              "citation": {
                "source": "戦後合格者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "試衛館何天王に数えられる沖田、山南、原田、井上、永倉らといった手合のうちに、白河、仙台、松山諸藩の脱藩士があるが、このやり方ですべて多摩地方の豪農地盤と多年密接に結びつけられてしまっている。",
              "citation": {
                "source": "新撰組",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことは今でも他の酪農地ではそうであろうと私は信じている。",
              "citation": {
                "source": "イングランドの西部の諸州とくにグルスターシャーで見つかった病気で、牛痘の名で知られているウシ天然痘の原因および効果についての研究",
                "author": "AN INQUIRY INTO THE CAUSES AND EFFECTS OF THE VARIOLAE VACCINAE, A DISEASE DISCOVERED IN SOME OF THE WESTERN COUNTIES OF ENGLAND, PARTICULARLY GLOUCESTERSHIRE, AND KNOWN BY THE NAME OF THE COW POX.",
                "note": "青空文庫"
              }
            },
            {
              "text": "何といっても、小さい島のことであるから、農地が住宅地に食われると、新しい農地を探さねばならないが、可耕農地はほとんど使いつくされている。",
              "citation": {
                "source": "霧を捕える話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、ある一定の農地について、土地が豊富に産出するに比例して、全生産物中のより大なる分量が地主に支払われるならば、マルサス氏は疑いもなく正しいであろう。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "農地のすべての必要費のそれに比例する下落によって十分にかつ直ちに相殺されない所のあらゆる価格下落、土地に対する租税、農業資本に対するあらゆる租税、農業者の必要品に対するあらゆる租税は、計算に現われて来るであろう。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボルダー・ダムの例でいえば、あの巨額の予算が通ったのは、洪水の防止、舟運改善及び流量調節、河水調節による農地の開発、水力の発電という、この四つの項目が目的としてあげられ、その各々が、絶対必要で且つ実現が可能であるということが確認されたからである。",
              "citation": {
                "source": "アメリカの沙漠",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢のうちなる遠近法、夏の夜風の小鎚の重量、それ等は既になし。",
              "citation": {
                "source": "地極の天使",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヤリの煙がユラユラと壁に映つて、十一時頃であり、そのうちまた出掛けさうな気配にもなつたりして、時は刻々に過ぎつゝあつた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
