  {
    "uuid": "6e0d8f00-210d-5517-a618-c189ddc7c54c",
    "entry": "ノウチ",
    "reading": {
      "primary": "のうち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニハ何十人トイウ人ガ、ゴジャゴジャ住ンデイテ、ヤカマシイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オヽ、頼モシキ思想ノ持主ヨ、新日本ノ後継者ハ立派ニ新シイ騎士道ヲ樹立セナケレバナランノダ、女学生ト附キ合ツテ Girl-shy（助平心）ヲ起スヨウナ習慣ハ少年ノウチカラ彼女等トノ交遊ニヨツテ振リ棄テルヨウニシナケレバナランノダ。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "天と地の折目をのばして、一折りずつひろげると、先ず主人邦夷の名が例の通り低く書かれて、「其方へ、石狩国石狩郡ノウチ、トウベツノ地一帯ノ貸付｜被仰付候事」と二行に書き、「明治四年六月、開拓使」と署名されていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に、マルノウチ一帯へ、一｜噸爆弾を三個、半噸爆弾を十二個、叩きつけます。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マルノウチ爆撃用意！",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカル未知電波ノウチノアルモノハ、時ニ雑音トイウ名ノモトニワレワレニ知ラレテイル。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチ事件関係者ノ指紋ハ、旗田鶴彌、土居三津子、本郷末子ノ三名ノ分。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガコマルナラ、コンヤ十一ジニ、クロカワダンチョウト、ハナガタフサエト、マルノウチ、ネオン・ビルノマエニキナサイ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "手袋の上から手を握らせながら、おれの頬に唇を触れたあとで、　――タケノウチさん、あなたの仕事のお邪魔になりはしないこと。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "――マダム・タケノウチの写真がオペラの前の店に並んで居るのを。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノウチを女は露西亜人の名のやうにタケノウイツチと発音するのが習慣になつて居る。",
              "citation": {
                "source": "素描",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノウチニワタシハ、コタンヘカヘリマスガ、マタ、コンド、アガリマスカラ、ドウカ、ヨロシクネガヒマス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言いながら、手帳と鉛筆をさしつけると、兵部の娘は、直ちに鉛筆を取って認めました、「海岸ヲ西ノ方ヘ向イテ行ッテシマイマシタ、ソノウチ帰ルデショウ」　それを見ると、金椎の眉根が不安の色に曇り、思わず窓の外から海の方を見ますと、真の闇ながら、空模様が尋常でない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フランソア・ザビエル師ノ曰ク、予ノ見ル所ヲ以テスレバ、善良ナル性質ヲ有スルコト日本人ノ如キハ、世界ノ国民ノウチ甚ダ稀ナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "即チ、コノ信神渡航者一行百二名ノウチニハ、僧侶ト名ノルモノ一人モコレ有ラザリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ茅屋ヲ訪ルル客人ノウチ目立ツテ軍人諸君ガ多イノハ不思議ナ現象デアル。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾシ、私ノウチニハ、オ皿トナイフトフオークガ一ツヅヽシカアリマセンカラ、オイデ下サル方ハ、ドウゾ、ゴジブンノオ皿ト、ナイフト、フオークヲモツテイラシツテ下サイ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キノフノバン、私ノウチノ地下室ニトマツタ玉ネギサンガ、行方不明ニナリマシタ。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメノ　カメコオバサンハ、キンジヨノ　マルコオバサンノウチヘ、ノソリノソリト　ハツテユキマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチ、カメコオバサンモ　トロトロト　マブタガ　オモクナリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニ、オ母サンハネムクナツタノデ、パラソルノ下デ、グツスリネムリコミマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカヲチヤンノウチハ　クルリト　カラタチノカキヲマハツタ　アソコダ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクウレシクテ　ウレシクテ　タカヲチヤンノウチノ　ゴモンノハウヘ　カケテツタ　カケテツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "「少シハ痛クッテモコンナコトヲシテイル方ガ気ガ紛レルヨ、痛クテ溜ラナクナッタラ止メル、今ノウチハ仕事シテイル方ガイヽ、アッチヘ行ッテヽクレ給エ」午後一時ヨリ午睡、一時間ホドトロ／＼トスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼モコノトコロ努メテ宵ノウチニ帰ルヨウニシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニヨクナリマスヨト婆サンハ云ッタガ、ドウヤラコウヤラ少シ楽ニナリカケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いづうノ鱧鮨ヲ昨日ノウチニ買ッテ置キマシタカラ、ツイデニ持ッテ参リマシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
