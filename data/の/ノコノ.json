        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そうかといって、わが万寿丸が、不良少年のように、ノコノコ佐渡までも女狂いには出かけられないのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "哲学ハ、知ヘノ愛デハナクテ、真実ノ知トシテ成立セシムベキ様ノ体系知デアル、ヘエゲル先生ノコノ言葉、一学兄ニ教エラレタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」日本、古来ノコノ日常語ガ、スベテヲ語リツクシテイル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケサノコノ走リ書モマタ、純粋ノ主観的表白ニアラザルコトハ、皆様承知。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供は其処に暫時立っていたが、やがて三次の後からノコノコついて行く。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "不審に思った鉄五郎が物蔭から出てノコノコ勝坊の傍へ寄り、Ｔ「あのおじちゃんは何処へ行った？",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは怪しからん奴じゃ、他の領分の扉を無断で閉ざす奴があるものかと、吾輩は用捨なくすぐに開けると、暫時してまたノコノコ手を伸ばして閉める。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿飛という奴はオッチョコチョイだから、山賊の噂をきけば、直ぐノコノコと山賊退治にやって来るに違いねえ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、逃げるように飛び出して来たのだが、もう二度と会わす顔がないと思うと、京吉はノコノコとまたアパートの中へ逆戻りして、陽子の部屋へ上って行った。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つには電車の中でいきなり話しかけて、ノコノコ劇場までついて来たよれよれのレインコートの中年男を、まく積りだったのだ。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に習慣となっていた卑屈さのせいで、ギラ・コシサンはリメイと共にア・バイに留まって勝利の歓喜を頒つことはせず、意気地なくも敗けた女房のあとについてノコノコと帰って来た。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その泥棒にしても、桂子がフラフラと出て、連れてきたのではなく、マーケットで一度、逢っただけの男が、彼女の家を探りあて、麻雀で夜明しした後でつかれているから休ませてくれ、とノコノコ上りこんできたのだという、桂子の話も信じる。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、啄木鳥に穴の底を叩かれて、ノコノコ這い出すような謙信ではなかった。",
              "citation": {
                "source": "川中島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だったら、なぜ、お礼を云っただけで帰って来ないの、物ほしそうな顔をして、そんな大金を貰って来るの、まるで、泥棒猫が、投げてくれた魚の骨に味をしめて、ノコノコお座敷へ上り込んで行くような恰好じゃないの。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここで待っていると、先生きっとノコノコはい上って来ますよ。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "南洋ヴァトム島人話すは、ト・コノコノミャンゲなる者、二少年に火を取り来らば死せじ、しからずば汝ら魂は死せず、身は死すべしと言いしに取り来らず。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのお蔭で色々な失策を連発して、方々で首種が尽きるくらい馘られ続けながらノコノコサイサイ生き永らえて来たものであるが、今度という今度ばっかりはそうは行かない。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年はノコノコ上って来た。",
              "citation": {
                "source": "怪青年モセイ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の伯母さんと言う髪結い職の婦人は、早くもその日の夕方にノコノコと私の自宅へ遣って来た。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ水を向けると一も二もなく承知して、「オヤまあ」と思う間もなく、ノコノコサイサイ永田秀次郎氏があと釜に座ったのが、丁度十月の初旬のことであった。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旧い人は駄目だなんて、言ったって……新しい時代の人だって、頼甲斐があるとは言われないネ」「ナカナカ」　その時、種夫が一生懸命に楼梯につかまってノコノコ階下から上って来た。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい近藤、行ってみるがいい」「あいよあいよ」と厭な奴またノコノコ出かけて行き、「鏡氏、一本お稽古を」「アッハハハハ」と大きな声で突然葉之助は笑い出した。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだのにノコノコ今日行っては、あんまり俺がオッチョコチョイに見える。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この屋敷へノコノコはいって行くには、俺のみなりは悪過ぎるなあ」　中身は銘ある長船だが、剥げチョロケた鞘の拵えなどが、旗二郎を気恥ずかしくさせたのである。",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで親父のホーキンめが一人でノコノコやって来た。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどあらかじめ云っておくがな、あんまりノコノコ歩き廻らぬがいい。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは驚いた、貧乏神が行く」　なるほど、彼から五間ほどの前を――例の駕籠のすぐ後から――後ろ姿ではあるけれど、渋団扇を持ち腰衣を着けた、紛うようもない貧乏神がノコノコ暢気そうに歩いて行く。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "といって壺をかついで一人でノコノコ江戸入りするのは、危険千番。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして日光御造営が始まって、周囲四十里、お山どめになってからは、人別のきびしいことは天下周知のことだから、なにも今頃ノコノコ母娘連れで、この騒がしい日光へ出かけてくるものずきも、ないであろうテ」「それはそうだとも。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
