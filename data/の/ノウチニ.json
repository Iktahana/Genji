        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノウチニハ何十人トイウ人ガ、ゴジャゴジャ住ンデイテ、ヤカマシイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノウチニワタシハ、コタンヘカヘリマスガ、マタ、コンド、アガリマスカラ、ドウカ、ヨロシクネガヒマス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "即チ、コノ信神渡航者一行百二名ノウチニハ、僧侶ト名ノルモノ一人モコレ有ラザリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾシ、私ノウチニハ、オ皿トナイフトフオークガ一ツヅヽシカアリマセンカラ、オイデ下サル方ハ、ドウゾ、ゴジブンノオ皿ト、ナイフト、フオークヲモツテイラシツテ下サイ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニ、オ母サンハネムクナツタノデ、パラソルノ下デ、グツスリネムリコミマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼モコノトコロ努メテ宵ノウチニ帰ルヨウニシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニヨクナリマスヨト婆サンハ云ッタガ、ドウヤラコウヤラ少シ楽ニナリカケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いづうノ鱧鮨ヲ昨日ノウチニ買ッテ置キマシタカラ、ツイデニ持ッテ参リマシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
