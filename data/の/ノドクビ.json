  {
    "uuid": "b92b365d-1445-5d15-a356-0592f024380c",
    "entry": "ノドクビ",
    "reading": {
      "primary": "のどくび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "石巻から出発して渡波港、ここが牡鹿半島の南側のノドクビに当るところだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "現像してみると新火山の横ッチョに（まア山のノドクビ、あるいはハナや口ぐらいの高さのところ）孔ができてるのですよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ず勝たねばならぬ、否、敵を倒す、否、一撃もって敵のノドクビを切断する、というような気魄が充満しているし、寸時といえども攻撃がゆるみ、斬り込みの脚力も刀さばきも休むようなところがない。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "宝塚女子占領軍――阪神の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙台から北の牡鹿半島のノドクビに石の巻という漁港がある。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がこれをノドクビにくッつけて歩いていても、誰もダイヤと思わぬ。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
