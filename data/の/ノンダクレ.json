[
  {
    "uuid": "f47cd8c1-1d82-562c-baba-055325147f58",
    "entry": "飲んだくれ",
    "reading": {
      "primary": "のんだくれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
