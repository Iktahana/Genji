        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "いくつかの企業が乗合で新しいプロジェクトを立ち上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地域活性化のため、商店街の店主たちが乗合でイベントを企画した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今回の事業は、二社の乗合で行うことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
