[
  {
    "uuid": "1fcd9111-45da-5fb6-be13-ee620a94b2e2",
    "entry": "野垂れ死に",
    "reading": {
      "primary": "のたれじに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
