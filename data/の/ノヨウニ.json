  {
    "uuid": "ce125a42-5960-5c3a-99b0-4e61fdcc78b2",
    "entry": "ノヨウニ",
    "reading": {
      "primary": "のように",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "野原ハ、毎日ノヨウニツメタイ風ガ吹イテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノトキ、私ニハドウシテモ、君チャンタチハオソロシイ、ノドマデクチノサケタオニノヨウニオモワレタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ニハソノ顔ガ悪魔ノヨウニ見エマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカネハ、イツモノヨウニ、ハンヲ、オシテ、アリマスカラ、コノママキョクヘ、トリニユキナサイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒燿石の微塵ノヨウニ。",
              "citation": {
                "source": "「草野心平詩集」解説",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハオ魚ヲ食ベルノガ下手デスカラ、オ婆チャンノヨウニ綺麗デハゴザイマセンケレド」颯子ノ鮎ノ残骸ハ成ル程マコトニキタナラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガトウダンスノ胼胝ノオ蔭デスッカリ穢クナッチャッタンデ、トウヲ止メテカラ一生懸命モトノヨウニシヨウト思ッテ、毎日々々軽石ダノ鑢ダノイロンナモノデ擦ッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ未ダニ前ノヨウニハナラナイワ」「ドレドレ、チョットオ見セ」ハカラズモ予ハ彼女ノ素足ニ触レ得ル機会ヲ掴ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ顔ノ女ヲ見ルト、顔ダケデナク、性質モ残虐デアルカノヨウニ思イ、又ソウデアルコトヲ希望スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダケドレスリングノヨウニワザトジャナイカラ、アンナニ沢山ハ出ナイワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年前ノ出来事ガマルデ新シイ事実ノヨウニ感ゼラレ、興味津々盡キルトコロヲ知ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ入浴ノ助手ハ、婆サンハ転ンデカラ以後勤メナイノデ、颯子カ女中ガ勤メルノデアルガ、佐々木ノヨウニ上手ニ親切ニハ助ケテクレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "急イデ便所ニ走リ、排尿シテ見ルト、尿ガ牛乳ノヨウニ白濁シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、止メヨウト思エバ思ウホド、マス／＼気狂イノヨウニナッテシャブッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴虫ヤ松虫ノヨウニ沢山ハ集ッテ来ナイ、常ニ必ズ一匹デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ足ハ柳鰈ノヨウニ華奢デ細長イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白ノ一越縮緬ノ裾模様ニ図案化シタ樹木ノ枝ヲ黒ノ濃淡デ現ワシ、周囲ヲ淡イブルーデ影ノヨウニ絵取ッタモノヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯締メハ金ト銀トヲ縄ノヨウニ撚ッタモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ裏側ガ葡萄ノ実ノヨウニ腫レ上ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩ヤ肘ヤ膝頭ガ僂麻質ノヨウニ痛ムノハ前カラノコトデレスリーノセイデハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日ノヨウニ、九月中ニコンナコトガアルノモ珍シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、予ハ子供ノヨウニ泣キ喚ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尺骨ト橈骨ノ茎状突起カラ五本ノ指ノ尖端ヘカケテ手ガ一本ノ棒ノ塊ノヨウニ突ッ張リ、掌ノ内側ト外側トガチリ／＼トコキザミニ小サク細カク痛ミ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウナサイマスカ、博士モ決シテ無理ニスヽメテハオラレマセン、オ気ガ向カナケレバオ止メニナッタ方ガヨロシイト云ッテオラレマスカラ、マアヨクオ考エニナリマシテ、―――」コノ間ノ晩、子供ニ不意討チヲ喰ッテ泣カサレタコトガ未ダニ胸ニ残ッテイ、コンナ場合ニ何トナクアレガ不吉ノ前兆ノヨウニ思イ出サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "定メシソノ刹那ニハ七十年来ノ生涯ニ積ミ重ネタ悪事ノ数々ガ走馬燈ノヨウニ次々ト現レルダロウナ、アヽ貴様ハアンナコトモシタ、コンナコトモシタ、ソレデテ楽ニ死ノウナンテ虫ガヨスギル、今苦シムノハ当リ前ダ、ザマア見ヤガレ、―――ドコカデソンナ声モ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ餘リ大事ヲ取リ過ギタノガ失敗ノ原因ダッタ、萬々一ノ場合ニ備エテ仰山ナ準備ナドヲセズ、イツモノヨウニ手軽ニ考エテスレバヨカッタ、博士自身ガ神経過敏ニナッテイタノガイケナカッタノダ、ト云ウ点デハ二人ノ意見ガ一致スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本橋ヤ、鎧橋ヤ、築地橋ヤ、柳橋ノ、アノ綺麗ダッタ河ヲ、オ歯黒溝ノヨウニシチマッタノハミンナ奴等デハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ鑿師ニハソノ図ヲ示シテ、ソノ図ノヨウニ線彫リサセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ白イ美シイ皮膚ニ包マレタ一個ノ女体ガ、マルデ死骸ノヨウニ僕ノ動カスママニ動キナガラ、実ハ生キテ何モカモ意識シテイルノダト思ウヲ日記ニ書カナイ方ガヨイノデハアルマイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
