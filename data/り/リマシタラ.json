          "literary": [
            {
              "text": "貴官ガコノ事件ヲ、本気デ調査サレタ事ガワカリマシタラ私ガ貴官ノ御宅ニ出頭シテ、真相ヲオ話シシマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　シカタガナイノデ、ユカノウヘニスワリマシタラ、洋服ガドロダラケニナリマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」四　ソコデ、ミンナ、ハシツテ、ダイドコロヘイツテ、オナベノフタヲトリマシタラ、ソノナカニ、ジヤガイモサンガヰマシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイ、オ帰リニナッタコトヽ存ジテオリマシタラ………」「アヽソウカイ」「………オ二階デ涼ンデイラッシャイマシタンデ、………」コップガ二ツトコカコラノ壜ガ二ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガ云ウノニ、自分ハ昔ＰＱ病院ニ勤務シテイタコトガアッタガ、昨日午後一時間ノオ暇ヲ戴イテ歯ノ治療ノタメ品川マデ参リマシタラ、ソノ歯科医院デ偶然ＰＱ病院時代ノ福島博士ト云ウ整形外科ノ先生ニ出会ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
