        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "科学がキャピタリズムやミリタリズムやないしボルシェヴィズムの居候になっているうちは、まあ当分見込がなさそうに思われる。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらミリタリストのチャキチャキでも、むちゃくちゃに百姓を殺す訳にや行かなかった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、主として、力点をアンチ・ミリタリズム文学に置くと云ったまでのことである。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なか／＼ユテリタリアンだが明快ですね。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は、かういふ種類のミリタリスティックな気風は余り好かない、……ミリタリズムは嫌ひぢやないんだが。",
              "citation": {
                "source": "或る日の運動",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この分だと君らのミリタリズムは、当然ロシアと衝突せずにはおられまい。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミリタリズムがロシアと衝突すれば、君、印度はどうする？",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のミリタリ・サーヴィスも、出獄後なお三年は延ばせる。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私には父の態度が、祖父母や母の古風なミリタリズムの教育風とは全くその趣きを異にして、突ぴよう子もなく自由気なのが余程の驚きであつた。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミリタリズムの気風が、最もさかんな中学であつた。",
              "citation": {
                "source": "塚越の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪鬼のごときミリタリズムがこの街にのしかかって来たのは、ずっと後のことのやうだ。",
              "citation": {
                "source": "広島の牧歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "再びナチかミリタリズムの世になつて晶子歌が全部亡ぼされる日が来たら、私はこの一首だけを石に彫して地に埋めるであらう。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "予等ハ九月四日只今ノ地点ニ通リカカリタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ隣室ニ監禁セラレタル予ノ案内人ノ室ノ更ニ隣室ニシテ、同様物置ナル所ヘ一時｜抛ゲ入レラレタルヲ知リタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタ『パチノ』ガ『オスミ』と称スル日本婦人ト契リシガ、彼女ハ災害ニテ死シ、両人ノ間ニ生レタル一子（姓不詳）ハ生死不明トナリタリ。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "当分手当ヲ受ケルコトトナリタリ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「各部長会議ハ食糧、空気、燃料等ノ在庫数量ヲ再検討シタル結果、隊員ヲ今一名増員可能ト認ムル者五名、不可能ト認ムル者四名トナリタリ。",
              "citation": {
                "source": "断層顔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（数字抹消）事ハ決マリタリ。",
              "citation": {
                "source": "断層顔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスに電報を打ち、クラルテの仲間は、決してアンリー・バルビュスの想像するように十人ぼっちの者ではないし、此処に集ったアンティ・ミリタリストは今後も団結して仕事に当り、今夕、万堂一致で、再びルール占領に反対の意を表する、と云って遣ろうと発議する。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、一朝事が目前に迫り、前田駸一郎が熱を以て説いたように、近い将来に於て、日米が衝突でもすることが起ったら、彼等は、どんな態度を以て、アンティ・ミリタリストとしての正義を体顕するだろう。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アンチミリタリズムの）　かえって仕事しようとして居たらオリガさんが居て実は悄気た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二十五日　火　海外ニュース（と云っても或見地をもった）にチャストーシカ〔四行詩の俗謡〕をつけてポーランドのミリタリズムを見せるところなど凄いぞ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "正義の防衛的圧力とミリタリスムとの対比。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に、海外ニュースにミリタリズムやキャピタリズムの映画にストーシュカ〔たたく音〕を入れたのなど、どうしてエイゼンシュテインのおかめとまけぬ皮肉さだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男の白い腕章には英語でミリタリ・ポリスと書かれていた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "刀剣ハ既ニ牛犢ニ換タレバ枕刀一腰ゾ残リタリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ということの根拠もあったわけだが、同時に之が学生に夫々のユニフォームを着せるという教育上のミリタリズムをも産んだわけだ。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "職業的ユニフォームは、ミリタリー・システムによって指揮したり指揮させたりする場合に、欠くことの出来ぬ服装である。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "――処が更に、職業でなくて単に臨時の共通な任務にすぎぬ場合でも、それがミリタリー・システムを必要とする場合にはユニフォーム制度となるのである。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
