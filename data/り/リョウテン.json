          "literary": [
            {
              "text": "日本商店滝波および婦野両店を訪う。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、日本商松浦、滝波両店を訪う。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "両店を往復しているうちに、私はメイテイしてしまった。",
              "citation": {
                "source": "西荻随筆",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
