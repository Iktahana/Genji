        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は何かと理由をつけては飲み会への参加を断り、早々に帰宅してしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "宿題を忘れた生徒が、飼い犬がノートを噛んだなどと苦しい理由をつけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "適当な理由をつけて外出許可をもらい、こっそりと映画館へ足を運んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "先程から余り落付かないでゐるのに理由をつけるつもりだつた。",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は、自分の弱点に理由をつける。",
              "citation": {
                "source": "日記",
                "author": "一九二〇年（大正九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつは（と寢臺を指して）いづれ私が何とか理由をつけるとしませう。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
