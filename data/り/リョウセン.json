[
  {
    "uuid": "b9c3e740-6a19-525a-94cf-4d21564c8e75",
    "entry": "僚船",
    "reading": {
      "primary": "りょうせん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "consort ship",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "荒れた海で僚船とはぐれてしまい、一晩中不安な時を過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "漁を終えた船団は、僚船と連絡を取り合いながら、そろって港への帰路についた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "海賊の襲撃を受けた際、僚船の援護射撃のおかげでなんとか難を逃れることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "舳に立つと、互に離れないように、艫と艫とを太い縄で結びあわせた僚船の姿が、まだ寝足りなそうに浮かんでいるのが見えた。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それによると、船に乗つて海に漁猟に出たものが、午飯時にこの小魚を焼いて食べると、そのうまさに自分の飯櫃を空つぽにした上、その近くにゐる僚船を呼びとめて、飯の残りを無心したので、いつのまにか「ままかり」といふ名で呼ばれるやうになつたといふのだ。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二｜隻の僚船が従いて来る。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僚船二隻ぶつかったのである。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
