          "literary": [
            {
              "text": "「ジューリエト３、こちら、タンゴ・ウィスキー４０７。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "――Ｊ・Ｂ・ステェア「サモア地誌」――　一八八一年、五つの称号の中、「マリエトア」「ナトアイテレ」「タマソアリィ」の三つを有つ大酋長ラウペパが推されて王位に即いた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤ハンカチの鉢巻が、マリエトア（ラウペパ）軍の制服なのだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラウンの怪我は早く直つたので、ブラウンか細君かのうちが、始終ジユリエトと僕との間に介まつてゐる。",
              "citation": {
                "source": "不可説",
                "author": "UNERKLARLICHT!",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッシ・リエトの寒村が山側の高原に点在するうしろには、ブリュームリスアルプの山塊が屹えておる。",
              "citation": {
                "source": "続スウィス日記（千九百二十三年稿）",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
