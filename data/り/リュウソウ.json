      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "平野にいぢけくねつた槲の木、海濱に赤い實を結んだ濱なす、どこまでも一直線に氣持ちいい道路、木材流送の爲めに毎年汎濫して沖積土の堤防をずぶ／＼解き崩す鵡川などが義雄の心に最も深い印象を與へた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　シップの聚落から駈りだされた男たちは、今はトビであり土方であり流送人夫であった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もはやどう見ても、押しも押されもしない立派な流送人夫どもであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき彼は、今回の普請に流送人夫をやってのけた大沼喜三郎を考えていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
