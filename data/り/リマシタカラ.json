        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『コチラノオクサマガ、サクバンオナクナリニ、ナリマシタカラ、オシラセシマス』彼は、こうした文句から激動を受けながら、差出人の名を探ったが、夫は何処にも書いてなかった。",
              "citation": {
                "source": "大島が出来る話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテカラ二人ノ様子ガオカシイト感ジテ居リマシタカラ、其ノ時何トナク気ニナリマシタノデ暫ク経テカラ私モ便所ニ行ッテクルカラト申シテ室外ニ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ大変大キナ声デアリマシタカラ、聞キマチガイハアリマセヌ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ時主人ハチャント私ガワカッテ居タヨウデアリマシタカラ、勿論私ヘ伝エタモノト思イマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ボンコチヤンハイツモ、モンコチヤンノアタマニイヤイヤノツカリマシタカラ、アマリニアヒマセンデシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラトイフモノ、モンコチヤンハボンコチヤンヲケツシテカブラナクナリマシタカラ、オ父サント、オ母サント、オ姉サントオ兄サンハモンコチヤンニカウイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハボンコチヤンデイヤイヤモンコチヤンニカブサリマシタカラ、ソレハソレハオカシクミエマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノオ父サンハボンコチヤンガカハイサウニナリマシタカラ、クワイ中電燈ヲモツテ、ワンコチヤンヲツレテ、ボンコチヤンヲサガシニユキマシタケレド、アタリハマツクラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ、ハジメニモ申シ上ゲタ通リ、モンコチヤンハ大ヘンモノヲ大切ニスル子デスカラ、ボンコチヤンニツイテヰタホコリヲ、テイネイニブラツシデハイテヤリマシタカラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、モンコチヤンノアタマニデキルダケカツカウヨクカブサリマシタカラ、ソレハソレハヨクニアフヨウニナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コルセットト滑リ台ガ出来テ参リマシタカラ、思イ切ッテヤッテ御覧ニナリマスカ」気ハスヽマナイガ、コノ調子デハ試験的ニシテ見ヨウカト云ウ気ニモナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガドウシタンダ」「アタシモ覚エテナインダケレド、鉾田トハ仕事ノ関係カラ近頃懇意ニオナリニナッテ、時々オ目ニカヽルコトガアルンデスッテ」「ダカラサ、ソレガドウシタト云ウノサ」「イヽエネ、ソノ油谷サンガ先週ノ日曜ニ御近所マデ参リマシタカラッテ、御夫婦デ鉾田ノトコロヘオ寄リニナッタンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
