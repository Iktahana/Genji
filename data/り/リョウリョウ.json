  {
    "uuid": "9d4e63a5-c970-58ce-b0bd-6364340c130d",
    "entry": "喨々",
    "reading": {
      "primary": "りょうりょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞-たる",
