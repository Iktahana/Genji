        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は毎朝、鏡の前で丁寧に櫛を使い、自慢のリーゼントを整える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "古い映画を見ると、ポマードで固めたリーゼントの登場人物がたくさん出てくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "「見て、あの人すごいリーゼント！」「本当だ、タイムスリップしてきたみたいだね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "私はただ「亀さん」の亭主がまかり間違っても白いダブルの背広に赤いネクタイ、胸に青いハンカチ、そしてリーゼント型に髪をわけたような男でないことをしきりに祈りながら、赤い煉瓦づくりの自安寺の裏門を出ると、何とそこは「いろは牛肉店」の横丁であった。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "二度と戦争にやア行きたくねえし、お前だつて、馬鹿々々しい目を見たンだもンな‥‥」　隆吉は誰かに貰つたと見えて、水色の派手なジヤケツを着込み、油で光つたリーゼントの頭を板壁に凭れさせて、立つて膝を抱きかゝへて煙草を吸つてゐる。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "姿は生気がなかつたが、それでも、頭髪だけは、リーゼント型にして、こはさうな毛は油で光つてゐた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは、おしゃれなので、床屋がぼくの頭をリーゼントスタイルにしたとき、あわてた。",
              "citation": {
                "source": "鈍走記（草稿）",
                "author": "竹内浩三",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺も描いてくれ、と言ってる兵隊がいまでもいるそうです」「ヨシオのあのリーゼントの頭は、なんとかならないかしら。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシオを真似してリーゼントのように整えてみた。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっそく、誘ってみよう」「僕からも言っておきましょうか」「リーゼントのことを言っといてよ。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは髪をリーゼントにしてもみあげを長くのばしているから、風圧で横に流された涙は、もみあげのなかに入りこんでいった。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やめられない」「ベトベトで、さわれないんだもの、そのリーゼント。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずはリージェント街のグロス＆ハンキィに寄って、それからエッジウェア通りの聖モニカ教会だ。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "早春のある日、ホームズはのんびりとした気持ちで散歩に出、私も同行してリージェント・パークをぶらついた。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "リージェント公園では冬の鳥の囀りがいたるところにきこえ、春の匂いが甘くただよっていた。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "市街はロンドンを模し、街名もグリニッジ、ウォータールー、オックスフォード、リージェント等、みなロンドンの名称をとり、街路の狭くして曲折せるところも、ロンドンを擬するもののごとくなれば、よろしく南球の小ロンドンと名づくべし。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "リージェント・ストリート・ヘッドン・コート６番地で死んだ仕立師は多くの時間をブロード・ストリートで過ごしていた。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "死亡した人たちの大部分はボンド・ストリートやリージェント・ストリート周辺の店で働いている、仕立師その他の職人およびこれらの妻および子供である。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと仕掛けをリージェント公園に見に行く。",
              "citation": {
                "source": "四日闇夜",
                "author": "THE FOUR DAYS' NIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに気流が穏やかなら、リージェント公園の着陸は難しくない」　弁を開くと、飛行機が閃光鳥のように降下。",
              "citation": {
                "source": "四日闇夜",
                "author": "THE FOUR DAYS' NIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "リージェント公園の木々が妙に分厚く化粧し、その黒さと言ったらまるで塗装したかよう。",
              "citation": {
                "source": "四日闇夜",
                "author": "THE FOUR DAYS' NIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "霧を追い払うことはできたが、恐ろしい損害を与えた」　こうグリンファン卿が不機嫌に言ったのは、その晩遅く二人がリージェント公園にとことこ歩いて戻るときだった。",
              "citation": {
                "source": "四日闇夜",
                "author": "THE FOUR DAYS' NIGHT",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
