        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五月二十三日夜八時半に作家クラブでリビディンスキーの「英雄の誕生」についての討論会があるので出かけたら中止。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはラップが主催で、主としてリビディンスキーのテクニックのことを云うと云って居た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりリビディンスキー個人としての進みか、プ文全線上に一歩進んだのか。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日こそ作家クラブでリビディンスキーの討論があるというので出かけたら、何もありゃしない。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "リビディンスキーがトルストフカのカフスに腕時計を光らして「自分はまるで下手に読む。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「英雄の出生」についての質問に答えリビディンスキーはソヴェートの新らしい家庭の意味というようなものの視点からそれを書いたと説明する。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」六月三日　作家クラブにリビディンスキーの「英雄の誕生」のための討論会があるというので出かけたところ、何もなし。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
