        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "過去の旅嚢から取り出される品物にはほとんど限りがない。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "作品第三番　　　　九月二日雷(1)　精神の圧迫されることは肉体の笞撻されるよりも苦しみを私はよく感ずるだが、私は屈服の奴隷ではない若し異郷に客死せねば或ひは旅嚢を背負つてどこへも渡つて行かれるならば行動の自由によつて種種の太鼓を敲く、その太鼓の音に数知れず群衆の吶喊を昂揚させる。",
              "citation": {
                "source": "小熊秀雄全集-13",
                "author": "詩集（12）その他の詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "惜しいかな旅嚢バイロンの詩集を携へず、その游泳の歌をこの浪上に吟ずるを得ざるを。",
              "citation": {
                "source": "客居偶録",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "その側には、旅嚢でも置いてあると見え、まるで警戒されていなかった。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、宿からここへ送らせた旅嚢を、すっかり座敷へブチまけて、植物と押葉の分類をはじめたのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度こそ――という目あてがついたようなものですから、旅嚢の欠乏も、さのみ気にはかかりません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが急に君と同伴することになり、いきおい古美術に熱心な君にひきずられて、僕までも一しょう懸命になって古い寺や仏像などを見だし、そして僕の旅嚢はおもいがけなくも豊かにされたのでした。",
              "citation": {
                "source": "大和路・信濃路",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅嚢も包みも持っていないのを見てもわかる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互に、旅嚢いつぱい、旅愁をぶらさげて。",
              "citation": {
                "source": "独楽",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋霖が車窓にかけた、寒い簾のむかうで、旅嚢がゆれてゐる。",
              "citation": {
                "source": "独楽",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は肩に掛けている旅嚢を揺りあげ、持っている萱笠をふらりと、その岩のほうへ振った。",
              "citation": {
                "source": "似而非物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おすえは云われたとおりにし、書き物や、筆などを片づけて包み、脇にあった旅嚢へ入れた。",
              "citation": {
                "source": "失蝶記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主計は旅嚢を背に結びつけて立ち、戸口から外へ出た。",
              "citation": {
                "source": "失蝶記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い旅をつづけて来たものとみえ、肩へかけた旅嚢も、着ている物も、すべて汗じみ、埃まみれであるが、笠をぬいだところを見ると、いま洗面したばかりのように、さっぱりと冴えた顔つきをしていた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "万三郎も片手で刀を押え、片手では旅嚢の紐を押えながら、少年のあとを追ってけんめいに駆けていった。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六兵衛は笠をぬぎ、旅嚢を取って投げると、林の下草の上へぶっ倒れた。",
              "citation": {
                "source": "ひとごろし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その手だ」と彼は笑いやんで呟いた、「おれの臆病者はかくれもない事実だからな、いまさら人の評判を気にする必要はない、よし、この手でゆこう」　双子六兵衛は立ちあがり、旅嚢を肩に、笠をかぶって松林から出ていった。",
              "citation": {
                "source": "ひとごろし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昂軒はその茶店へはいり、笠をぬぎ旅嚢を置いて腰掛けに掛けて汗をぬぐった。",
              "citation": {
                "source": "ひとごろし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その道傍のひとところに、松林で囲まれた三尺ばかり高い台地がある、昂軒はそこへあがってゆき、大きな編笠をぬぎ旅嚢を投げやって、大きな太息をついた。",
              "citation": {
                "source": "ひとごろし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は首を傾けながら両の袂を捜し、「ちょっと待って下さい」と云って、背負っていた旅嚢を解いてしらべ、小さな財布をみつけてまた首をひねった。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「失礼しました」と菅田平野は云った、「――そこでうかがいたいのですが、井坂さんが奸物粛清をやろうとした計画と、その盟友の人数を聞かせてくれませんか」　十郎太は旅嚢をひらいて、一通の封書をみつけ、中から巻いてある紙を取出した。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十郎太は旅嚢の中からそれらを取出して渡し、黒い目出し頭巾をかぶって出ていった。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家扶が現われて奥へとおれと云う、菅田平野は足を洗い、袴の裾のはねを払い、肩から旅嚢を取り、刀を脱して、右手に持ちながら広縁へあがった。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅田平野はちょっと考えたが、旅嚢の脇へ刀を置いて立った。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は旅嚢から油綿の入っている油紙包と、燧袋とを取り出して（いつでも使えるように）旅嚢の下へ隠して置き、それからそこへ横になって、この家の動静に耳を澄ませた。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも菅田平野は動かなかった、旅嚢を枕にして、じっと眠ったふりをしていた。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は燧袋と旅嚢を持って、こんこんと咳きながら廊下へ出た。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅田平野は走りながら旅嚢と燧袋を投げだし、「待て、その蔵に手をつけるな」　と、叫んだ。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "片方の手には泥まみれで空っぽの旅嚢をさげ、足にはやはり黒藤邸でつっかけて来た、ちびた古下駄をはいていた。",
              "citation": {
                "source": "日日平安",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
