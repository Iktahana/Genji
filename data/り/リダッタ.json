        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君チャンタチハ、オ母ッチャガ死ヌ四五日モマエカラ、何ンニモタベルモノガナク、目マイガシ、ムネガヒクヒクシ、ペッタリネタキリダッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　被告ハ道子ヲ何処デ殺スツモリダッタカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　然ラバ、清三ガオキタラドウスル積リダッタカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　如何イウ方法デ殺ス積リダッタカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "隙ヲ狙ッテ出タ積リダッタガ、ワタクシモオ供イタシマスト、看護婦ガ見ツケテ附イテ来タノデ一向面白クナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ薬ガ利イタト見セカケテ寝タフリヲスル積リダッタガ、ツイ本当ニ寝テシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デ、已ムヲ得ズ、隠居所ダケヲ新築スル積リダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヽ、直キナオルヨ、………早ク二階ヘ行ッテオ寝、………」予ハソウ云ッタ積リダッタガ、「早ク二階ヘ」アタリカラハ妙ナ濁声ニナッテ何ヲ云ッテルノカ自分デモ分ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ヤッパリ推察通リダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………夫は二月二十七日に、「ヤッパリ推察通リダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
