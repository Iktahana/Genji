        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あれなども、ユークリッド的には真実を曲げた嘘の写真であるが、心理的には却って真実に近くなるという場合もあるかもしれない。",
              "citation": {
                "source": "観点と距離",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾等の祖先から二千年来使い馴れたユークリッド幾何学では始末が付かなかった。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "哲学の講義のようでもあり、また最も実用的な処世訓のようでもあり、どうかするとまた相対性理論や非ユークリッド幾何学の話のようでもある。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "イベット、済まないけど今居る安宿の諸払いとマドリッドまでの汽車賃とそれから当座のお小使だけあたしに呉れない。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ね、マドリッドで逢いましょうよ。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "非ユークリッド幾何学の出発点がいかに常識的におかしく思われても、これを否定すべき論理は見つからない。",
              "citation": {
                "source": "相対性原理側面観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてみるとわれわれが人の顔を見る時に頭の中へできる像は決してユークリッド幾何学的のものではないと思われる。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ショウスキーやレーマン（リーマン、ドイツの数学者）が非ユークリッド幾何学を唱えるも、唱え得てつまりは得られなかったのではないのか。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "気にかけて、「ウインドウズでも読めるよう、ハイブリッド化を急げ」と励まして下さる方もあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイブリッド化の作業の直前までは、同じくボイジャーから出る『ヒロシマ・ナガサキのまえに』の翻訳と制作にあたっていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "エキスポ騒動がおさまって間もなく、『パソコン創世記』のハイブリッド化にかかることになり、ＣＤ―ＲＯＭを差し込んで久しぶりにブックを開いた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンプをとおさない、ソリッド・ボディのエレキだから、ペラペラした情けない音色だが、それでも充分だった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "道がひろくなったところで、慶一は立ちどまり、右肩にひっかけていたナップザックをおろし、高志のソリッド・ステート11をひっぱりだして、スウィッチを入れ、またナップザックにもどした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、今日の君はロバチェフスキイ（非ユークリッド幾何の創始者）だよ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンカ島のマレー人はを古酋長の化身とし、セネガル河辺ではに殺された者、雷死刃死の輩と同じく虹の宮殿に住むとした（コムベス著『ミンダナオおよびヨロ史』一八九七年マドリッド版六四頁）。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "例せば一六七六年マドリッド板、ナヴァレッテの『支那帝国誌』一二頁にいわく、すべて支那の裁判所はその高下に随って大小の太鼓を備え、訟あるごとにこれを打つ、南京の法庁にある者、殊に大きく象皮一枚を張り、大なる棒を高く荒縄で釣るしてこれを打つと。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドリッドの南西にある。",
              "citation": {
                "source": "落穴と振子",
                "author": "THE PIT AND THE PENDULUM",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドリッドにて二月三十日　さて、おれは西班牙へ來てしまつた。",
              "citation": {
                "source": "狂人日記",
                "author": "ZAPISKI SUMASHEDSHAWO",
                "note": "青空文庫"
              }
            },
            {
              "text": "言換えれば椿岳は実にこの不思議な時代を象徴する不思議なハイブリッドの一人であって、その一生はあたかも江戸末李より明治の初めに到る文明急転の絵巻を展開する如き興味に充たされておる。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "椿岳の画を愛好する少数｜好事家ですらが丁度朝顔や万年青の変り種を珍らしがると同じ心持で芸術のハイブリッドとしての椿岳の奇の半面を鑑賞したに過ぎなかったのだ。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人は画の理解があればあるほど狩野派とか四条派とか南宗とか北宗とかの在来の各派の画風に規矩され、雪舟とか光琳とか文晁とか容斎とかいう昔しの巨匠の作に泥んだ眼で杓子定規に鑑賞するから、偶々芸術上のハイブリッドを発見しても容易に芸術的価値を与えようとしない。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも球体の幾何学の非ユークリッドに似ていて、ギリシアのユークリッドみたいなあんな平面幾何じゃない、もっと高級なものが御本体になっていたんですね。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、あとでスペインの国境に向けて追放されようとした時にも、マドリッドよりもバルセロナの方に君等の仲間は多いんだからと言って、わざわざ地図や時間表などを探して来て、そこへ行く道筋や時間を教えてくれたりもした。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "沙漠のような高原にぽっちり建っている太陽の都マドリッド。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｈ２１がマドリッドへ着いてまもなく、クルウプ博士という土地在住のドイツ密偵支部代表者が訊ねて来て、こんな話をしてゆく。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、マドリッドに光っている特務機関の眼が、ドイツばかりではない。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "大尉はにわかにマドリッドを退去してパリーへ北上すべしという厳命を受け取った。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "保証と脅迫に押し出されるようにしぶしぶマドリッドをあとにパリーへ向う。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドリッドのドイツ大使館から、オランダのドイツ大使の許へ、マタ・アリがパリーへ着いたら、同市のオランダ大使館をつうじて、三万五千マルクの正金を支給するようにと暗号電報が飛んでいる。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
