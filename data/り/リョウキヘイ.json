          "literary": [
            {
              "text": "『緑の猟騎兵』にしろ。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "年を取つた方は、参謀本部付のノビス工兵大佐で、その副官らしい青年将校は、ルナアト・パリヤアニと呼ぶ猟騎兵中尉です。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて定刻間近く檸檬と夾竹桃におおわれたるボロン山の堡塁より、漆を塗ったるがごとき南方｜藍の中空めがけて、加農砲一発、轟然とぶっ放せば、駿馬をつなぎたる花馬車、宝石にも紛う花自動車、アルプス猟騎兵第二十四連隊の軍楽隊を先登に、しずしずと競技道路に乗り込み来る。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "南風吹かば　――モンテ・カルロの巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
