          "literary": [
            {
              "text": "これを採掘したプレミアー会社社長の名を取ってクリナンダイアモンドと命名されている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人公「にんじん」に扮するリナン少年は若干美少年過ぎるところが欠点。",
              "citation": {
                "source": "“にんじん”を観て",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントウニ、ヨシヲサンノオ母サンノ言ツタトホリナンデスモノネ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ颯子トノ結婚ニ反対シタ当時、「踊リ子上リナンゾッテ云ウケレド、キット彼女ハ家政ノ切リ盛リナンカモ上手ニヤッテ行キマスヨ、ソウ云ウ才能ノアルコトヲ僕ハ見抜イテルンデス」ト浄吉ハ云ッタガ、アノ時ハ恐ラク当寸法ヲ云ッタノデ、先見ノ明ガアッタ訳デハアルマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「経助ノコトナンゾ考エテヤルヨウナマヽジャナインダカラネ、学校ノ宿題ダッテアルバイトノ学生ニ任セッキリナンダカラ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
