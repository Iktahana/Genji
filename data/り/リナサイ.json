          "literary": [
            {
              "text": "僕は机の上の用箋に、「草田ノ家ヘ、カエリナサイ」と書いて静子さんに読ませた。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "草田ノ家ヘ、カエリナサイ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トニカク、カエリナサイ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとにはいつもつづけて、ハヤクオカエリナサイ、と書いた覚えがある。",
              "citation": {
                "source": "父の手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、いや、唄なんか聞きたくありません、唄どころじゃないわ」「船カラオ茶少シ持出シテ来マシタ、オアガリナサイ」「何も欲しくありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "三オ友達　ノ　オ猫サン　ガハサミ　デ　切リナサイ　トイツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モンコチヤン、チツトモオカシクナイカラボンコヲカブリナサイ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
