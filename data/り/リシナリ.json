          "literary": [
            {
              "text": "然ラバ「ウヰルソン」ハ「ヴェルサイユ」ニ行カズシテ瑞西ノ社會黨大會ニ列席スベカリシナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "他語ヲ以テ之ヲ云ヘバ、或ル一種族ノ石器時代人民日本ノ大部分ニ通ジテ生存シ居リシナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔「アイヌ」ノ日本々州ヨリ北海道ノ地ニ移リ來リシヤ、此地ハ决シテ無人ノ境ニハアラザリシナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
