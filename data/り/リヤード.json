        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一方ノーラン・ブッシュネルはミニコンピューターではなく、ボーリング場やビリヤード場の隅に置けるような小さなシステムにこうしたゲームを収めたいと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "サニーベイルのビリヤード場にピンボールのマシンと並べてためしに置かせてもらうと、ポングには順番待ちの列ができ、コインボックスはたちまち硬貨でいっぱいになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、君はビリヤードの際、キューがすべらないよう、いつもその部分にチョークをつける。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "三、君のビリヤードの相手は、サーストンだけ。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方、一風呂浴びて一本傾けて、そしてぶら／＼歩く、こゝにも温泉情調はある、カフヱーと自称するもの二軒、百貨店と自称するもの一軒、食堂二三軒、そこかしこに三味線の音がする、……いやまて、ビリヤード二軒、射的場も一軒ある。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のやうに馬には乗れないし、テニスは私の不熱心な弟子だし、ビリヤードは二十だし、思索は悉く妄想で、おまけに無学で……」　何とでも云へ／＼――彼は、眼をつむつてゐた。",
              "citation": {
                "source": "或る五月の朝の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大都会に詩を認めた点において「探偵小説はたしかにイリヤード〔叙事詩、長編詩〕というべきである」と彼は主張する。",
              "citation": {
                "source": "二つの文学論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イリヤード」や「オデッセイ」にしろ、経験された事象が、その経験された時間と空間との中から、もっと雄大な歴史的時間の感覚のなかに放たれて、そこでうたわれ、描き出されているために、その芸術性の故に、普遍性をもっている。",
              "citation": {
                "source": "文学は常に具体的",
                "author": "――「国民文学」に望む――",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故ならば考えても御覧なさい私はきのう　イリヤードと　ディビナ・コメディアをよむ。",
              "citation": {
                "source": "初夏（一九二二年）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの帰航の船長のビリヤードを思い出す。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "復活祭の夜チェホフがその欄干によってモスクワの寺院の鐘が一時に鳴り出すのを聴いたという石橋の方から或は猟人リヤードの方から、クレムリンの｜赤い広場へ出る。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "末次内務大臣は、大学専門学校等の周囲三百米から喫茶店、ビリヤード、マージャン等の店を撤廃するように命じ、従来の自由主義的な学生の取締方法を変更するべきことをすすめた。",
              "citation": {
                "source": "今日の文学の展望",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "射的及び弓術はその気分の最も類型化したるものであるが、ラグビーにせよ野球にもせよ、そのシートよりシートへの間に引かれたる線、殊にバッテリーを結ぶ線、ビリヤードのキューの狙い等の凡ては単なる方向 Richtung をして定向 Ausrichtung に転ぜしめたところの特有なる集中的緊張的気分である。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一幕　ビリヤード旭亭内場内一杯に音楽、――アコーデオンに依る急テンポのダンス曲。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガランとさびれ果てたビリヤード室。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左側にしきりの壁、一番手前がスヰングドア、それを出た軒下にビリヤード旭亭の柱看板、その奥に階上への階段（下手寄り）。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――幕――第三幕（第一幕に同じ）ビリヤード室一騒動あつた直後らしく、殺気立つた顔で総立ちになつて睨み合つてゐる五人――彦六とミルは畳敷の上に。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イリヤードの中の神々は美しい力強い不徳な人間である。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "一戦闘をもって一万二千の句を満たす（訳者注　イリヤードのごとく）の権利は、ただ叙事詩のみが有するのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビリヤードはプロの腕前だ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣りの建物は一階がビリヤードで二階はダンス教室だった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして外に出て、隣りのビリヤードの植え込みの前で、ヨシオと向き合って立った。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学の構内やその周辺を散歩し、ビリヤードに入って玉突きをした。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「高校生のとき、自宅の近くのビリヤードでアルバイトしてたことがあるのよ」「知らなかった」「知らないことが少しはあったほうがいいと思って、黙ってたの」　周囲の台で遊んでいた暇な学生たちが、日比谷優子に気づいた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリヤードを買ったのはペルシャ子羊のコートを着たマーサ・ストーナリー。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーサは鼻眼鏡の下でぞっとする顔を膨らませ、ハリヤードのフックの一つに金属の輪を止めた。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリヤードの固定具の前に立ちはだかって、旗を広げると自分の周りに巻き付けた。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば、今見ている、二つのビリヤード球の激突から起こる運動の伝達は、十二ヶ月前に見た、同様の激突から起こる運動の伝達と（同じ軌道であっても）全く別々の現象である。",
              "citation": {
                "source": "人間本性論（人性論）",
                "author": "A Treatise of Human Nature",
                "note": "青空文庫"
              }
            },
            {
              "text": "確かめようと、ビリヤード室へぶらりと入った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "それなりに賢くて、左手は使えないが、ビリヤードはうまい。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
