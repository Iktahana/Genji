  {
    "uuid": "85954ea8-1c62-5ec0-8f80-45de7fd82d1b",
    "entry": "両京",
    "reading": {
      "primary": "りょうきょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
