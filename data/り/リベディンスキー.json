        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アプトン・シンクレアの「ジャングル」「ボストン」、エルンスト・トルラーの戯曲、リベディンスキーの「一週間」、ロープシンの作品など。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラトコフの「セメント」、リベディンスキーの「一週間」等の小説のほか、マルクス主義芸術理論叢書としてプレハーノフ『芸術論』、同『階級社会の芸術』、ルナチャルスキーの『芸術の社会的基礎』などが出版されていた。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーの作品「英雄」が一九三〇年前後のソヴェト大衆から逃げ場のない批判をうけたのも、彼が新しいおもちゃとしかけた心理分析の興味とそれによる失敗のせいであった。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間、六七年ぶりで、戸塚の母さんに会って、暫く話しました、五月初旬の詩の話も出たりしてね、そしたら、その頃、リベディンスキーの「一週間」を又よみ出したのですって。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つ一つの名を、伸子は何となし文学の世界でバルビュスとかリベディンスキーという名が云われるときのように、そのひとひと固有の達成の素晴らしさとしてききなれた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーは、こっちへ来ないで、「文学の夕べ」の会場で、彼の近作であって、自然主義と心理主義がこねまわされている点からさまざまの議論をまきおこしている「英雄の誕生」について大衆質問に答えていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうリベディンスキーは「英雄の誕生」のややふるくさい肉感的な心理主義で、若い読者から批判されているけれども、彼には「一週間」がある。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、十三年前にリベディンスキーが民衆の一人として、「十月」をまともに生きたという証明だった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルストイ、トゥルゲニェフ、チェホフ、ゴーリキー、リベディンスキー、グラトコフ。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論グラトコフや、リベディンスキー、セラフィモヴィッチなんか読まれているが――　女党員は、考えた後、　――近頃は古典を非常によみます。",
              "citation": {
                "source": "子供・子供・子供のモスクワ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家も仕事をもってる」それから丁寧に鉛筆の削り屑を机の下の紙くず籠へすてて「……リベディンスキーの『一週間』というのは日本に知られてるだろうかな？",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一週間」の作者リベディンスキーは、ソヴェトのプロレタリア作家として、世界的に知られている。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　こういうベズィメンスキーの機械的マルクシズムを、リベディンスキーは、「ラップ」の中でも、盛に批判した。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへリベディンスキーが「射撃」と全く反対な立場で執筆している「英雄の誕生」をもって現れた。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーは、この党員の私的な家庭生活を主題にとった。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーが、「射撃」の作者に対して、心理描写も、プロレタリア・リアリズムにとって欠くことの出来ない一つの要素だと云った時は、間違っていなかった。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「英雄の誕生」でリベディンスキーは、では、どんな階級性や、社会性をもった心理を描写しているだろうか？",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "党内の或るものや、コムソモールはリベディンスキーを公然と非難した。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーは、彼の持論である心理描写において、全く個人主義的な立場での心理穿鑿に陥ったばかりではない。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーは、この「英雄の誕生」において、生物としての人間が社会的な階級人として成長をとげた歴史的な現代のソヴェトでは人間本能＝性的慾求、食欲、知識欲という諸要素をどんな自主性と社会的見とおしで処理しようとしているかという事実について初歩的な理解と共感さえもっていないような態度を示した。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーは、「英雄の誕生」の弁明において云った。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、この云いわけは、リベディンスキーが連載した小説そのものが曝露している誤謬を訂正しまい。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故なら、リベディンスキーが男と女とが同等なものとして結合する、という同等の焦点が性にだけ集中されているのだから。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴェト大衆が盛に「英雄の誕生」について議論し、「射撃」でやっつけられたベズィメンスキーが、今度は逆に、リベディンスキーとその前進性のない心理穿鑿主義をやっつけている四月に、「ラップ」に加盟したばかりだった「革命戦線」の詩人マヤコフスキーが自殺した。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、リベディンスキーは自分の誤謬と、大衆の批判が正当であることを承認し、「英雄の誕生」連載を中止した。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーは「一週間」を。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルストイ百年記念祭が一九二八年にモスクワの大劇場で行われたが、そのとき、外国からの客、ツワイグやケレルマンがそこに立って挨拶した演壇へ出て祝辞をよんだソヴェト作家代表はリベディンスキーでも、キルションでもなかった。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーの「英雄の誕生」等がある。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "リベディンスキーは、ロシア・プロレタリア作家の頭株の一人であるが、その長篇「英雄の誕生」は一般の注意を呼び起すと同時に、疑問をも引おこした。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代のものでは、ニェヴェーロフの「パンの町・タシュケント」、カターエフの「使いこみした男」、ポドヤッチェフの「労働者の中」、セイフリナ「プラボナルーシチェリ」、リベディンスキー「一週間」その他。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
