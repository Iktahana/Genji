        "examples": {
          "standard": [
            {
              "text": "最新のテクノロジーは、すでに多くの分野で利用可能になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "本日お配りしたこの割引クーポン券は、全国のチェーン店で明日から利用可能です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "新しく導入された社内システムは、専用のアプリを入れれば個人のスマートフォンからも利用可能となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "加えてマルチメディア・ビュアーを利用すれば、Ｗｉｎｄｏｗｓの流儀にしたがった出来合いの環境も利用可能である。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＩＢＭはＰＣの開発中に、ビジネス用として人気を博しているソフトウエアのメーカーを中心に移植を働きかけ、マシンと同時にビジカルクやイージーライターなど、利用可能なアプリケーション八本を発表していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＩＢＭ ＰＣが、マシンの発表と同時に利用可能なアプリケーションを示したように、新一六ビット機の発表時点でかなりの数の対応プログラムを確保することを、浜田は目標として示した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
