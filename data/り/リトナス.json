          "literary": [
            {
              "text": "読書｜木魚琴瑟等ノ声｜最然リトナス。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "正肥コレヲ然リトナス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "五名ヲ以テ限リトナス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "惟公論ヲ然リトナス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯｜畢ツテ再ビ茗ヲノ竟リトナス。",
              "citation": {
                "source": "下谷叢話",
