        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "六年前の建暦元年六月三日丑剋、将軍家御寝の際、高僧一人御夢の中にあらはれて、汝はもと宋朝医王山の長老たり、とお告げになつたのださうで、誰ニモ言ハズニ居リマシタガ、ソナタノ物語ト符合シテヰルトハ面白イ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ迄私ハ心中デハ非常ニ煩悶シテ居リマシタガ、殺ソウトハ思イマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ガ主人ヲ抱キ起シタ時、主人ハサキ申シタ通リ殆ド死ンダヨウニナッテ居リマシタガ、私ガ旦那様旦那様トクリ返シマスト、カスカニ目ヲアキマシタガ、不意ニ思イガケナイ位大キナ声デ、「大寺……大寺ダ」ト申サレマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、マスマスオコリマシタガ、シカタガナイノデ、オザシキノアンラクヰスニコシヲカケマシタラ、タウトウキモチガヨクナツテ、マユヲシカメタママネムリコンデシマヒマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ「ソンナラ私ガ立テテ上ゲヨウ」トイツテ、手デ立テテヤリマシタガ、手ヲハナスト、スグマタパタリトタオレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――………ネエチヤンモウサギノミミヲツマンデ、立テテオヤリニナリマシタガ、ネエチヤンガソノミミヲオハナシニナルト、マタパタリトタフレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
