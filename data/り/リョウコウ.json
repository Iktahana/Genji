[
  {
    "uuid": "a9429722-bf1a-52e2-ad2d-360b504963f0",
    "entry": "良好",
    "reading": {
      "primary": "りょうこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
