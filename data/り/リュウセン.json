    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此歳永楽帝は去年｜丘福を漠北に失えるを以て北京を発して胡地に入り、本雅失里（Benyashili）阿魯台（Altai）等と戦いて勝ち、擒狐山、清流泉の二処に銘を勒して還りたもう。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「流泉」と云う曲を弾くと谷間を流れる水の音がこれに和するかの様に聞えて来るのである。",
              "citation": {
                "source": "現代語訳　方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしあまりの興あれば、しばしば松のひゞきに秋風の樂をたぐへ、水の音に流泉の曲をあやつる。",
              "citation": {
                "source": "方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
