          "literary": [
            {
              "text": "当時有名ノフランキリンガ云ヘルニハ、我身ハ居ニ常処ナシ、自由ノ存スル所即チ我居ナリトノ語アリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ、コノ信念ハ外ニ於テハ国家ニ不忠、内ニ於テハ国教ニ不信ナリトノ理由ヲ以テ、彼等ハ自国ニ住ムコトヲ極度ニ圧迫セラレタルヲ以テ、故国ヲ逃レテ和蘭ノ地ニ来リ、更ニ北米ノ天地ヲ求メタルモノナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ニ於テ人類ハ石時代ヨリ、青銅時代ニ移リ、青銅時代ヨリ鐵時代ニ移リタルモノナリトノ説廣ク世ニ行ハルヽニ至レリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ始メカラ、ダンサー上リトノ結婚ナンテ考エラレモシナカッタ筈ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
