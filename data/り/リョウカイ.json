        "examples": {
          "standard": [
            {
              "text": "「明日の会議の資料、今日中に作成しておいて」「はい、了解しました。すぐにとりかかります」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「帰りにスーパーに寄って牛乳を買ってきてくれる？」「了解。他に必要なものはある？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「先行チーム、目標地点に到着しました」「了解、そのまま待機せよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
