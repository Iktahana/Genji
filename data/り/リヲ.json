        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハルサメノ露ノヤドリヲ吹ク風ニコボレテ匂フヤマブキノ花　天真爛漫とでも申しませうか。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青キ朝日ハコノトキニ、　　　　ケブリヲノボリユラメケバ、樹ハサウサウト燃エイデテ、　　カナシキマデニヒカリタツ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ、アノクスリヲノムカラ！",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事が済んでから、おくみはその痛む虫歯へ、婆やに買つて来て貰つたケリヲソートを附けたりして、やうやく坊ちやんを泣寝入りに寝せつけて、一人枕もとに坐つてゐた。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケキヨケキヨケキヨ、ヨ、　ケキヨケキヨ、ヨ」　ミンナハ　アタタカク　ナツテ　クルト　ハヲリヲ　ヌイデ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ　ツヨイ　ヒカリニ　ナレテ　クルト　ナタネノ　花タチハ　アタリヲ　ミマハシテ、木ヤ　ハタケヤ　ミチヤ　イヘヤ　ソラヤ　ミズヲ　ミマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、オモヒダセナイノデ、トウトウ　オコツテ、カタツムリヲ　ツブシテ　シマハウト　シタ　トキ、フツト　オウサマノ　ココロニ、「デンデン　ムシムシ　ツノ　フレヨ、夜アケニ、ヌストガ　ヤツテ　クル」ト　イフ　ウタガ、ウカビマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　王サマハ、カタツムリヲ　ツブサナイデ、青イ　ハノ　上ニ　ソツト　ノセテ　ヤリマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　コトリヲ　ミセテ　ヤリマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、アカチヤンハ、コトリヲ　ミナイデ、ミチコサンノ　カホヲ　ミテ　ヰテ　ニツコリ　ワラヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イツテ　ミチコサンハ　ムネノ　アタリヲ　カギマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此新たに掘り出された『ローゼッタ石』の、表に刻まれた神聖文字は、如何にトマス・ヨングでもシャムポリヲンでも、プシウスでも、とても十年二十年に讀み了る事が出來ぬ樣に思はれる。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "此新たに掘り出された『ローゼツタ石』の、表に刻まれた神聖文字は、如何にトマス・ヨングでもシヤムボリヲンでも、レプシウスでも、とても十年二十年に読み了る事が出来ぬ様に思はれる。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ元首が賣名的多辯ヲ弄シ下級俳優ノ如キ身振ヲ晒シテ當選ヲ爭フ制度ハ、沈默ハ金ナリヲ信條トシ謙遜ハ美徳ヲ教養セラレタル日本民族ニ取リテハ一ニ奇異ナル風俗トシテ傍觀スレバ足ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今ヲ去ル千八百余年前日本武尊御東征ノ砌海上浪高ク激シキ風雨ニ遭セラレルヤ、妃｜弟橘媛命ハ竜神ニ祷リヲ捧ゲ、身ヲ以テ尊ニ代ラントシテ入水シ給ヒシ為御安行ヲ得タリト云フ。",
              "citation": {
                "source": "或るハイカーの記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ父ッチャハ、工場デヤスリヲトイデイルウチニ、グルグルマワッテ居ルト石ガカケテトンデキテ、ソレガムネニアタッテ、タオレテ家ヘハコバレテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンハホットシテ、ネガエリヲウッテ、足ヲチヂメテ、ネルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ひとわたり悪態の連ねが回ると、もとの太十に戻つて、「詩は此方のお手のものだ――世人交リヲ結ブニ黄金ヲ須フ――」　と私達の声よりも遥かに朗々たる喉で、月の光りをふるはせると、閑吉が次いで、「黄金多カラザレバ交リ深カラズ――てえんだあ！",
              "citation": {
                "source": "武者窓日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、政事ノ自由ト云ヘバ、其国ノ住人ヘ、天道自然ノ通義下ニ詳ナリヲ行ハシメテ、邪魔ヲセヌコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ急所ヲサケテ右ノ乳ノアタリヲ突イテヤリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "清三ハ息ヲフキ返シテ起キアガロウトシテ居マシタカラ、私ハ之モ膝ノ下ニ組ミ敷イテ胸ノアタリヲ一突キニ刺シタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミズガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリッタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボロウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行っただろうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミヅガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリツタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボラウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行つただらうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "安着の電報に添えてチチウエ、オクスリヲヨクメシアガレとうったら、この頃お母さんや達ちゃんたち、閉口するとそれを護符のようにもち出す由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "芋売リ茄子売リヲ始メ、日毎ニ門過グル人々ノ歌合ナリ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタリヲ見テ）そんならもう行かしやんしたか。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ岩ヨロ／＼トシテ、アタリヲ尋ネ、泥火鉢ヲ出シ、蚊遣リヲシカケル思ヒ入レ。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月九日さよなら　幸恵より　愛する御両親様　　　　　　　　御前に伊藤元子宛（北海道・名寄）大正十一年五月頃（東京発信）御タヨリヲ下サイマシテ、ホントウニ有難ウゴザイマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
