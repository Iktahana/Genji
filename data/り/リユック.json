        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "若い洋髪の女性は、片手で寝乱れた髪を撫で上げながらも、こうした大邸宅にふさわしい気品のうちにユックリユックリと白｜羅紗のスリッパを運んで来たが、やがて棕櫚のマットの中央まで来ると、すこし寒くなったらしく、襟元を引き合わせて立ち止まった。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはやはり、福太郎の麻痺した脳髄の作用に支配されているらしく、高速度活動写真機で撮った銃弾の動きと同様にユックリユックリした、何ともいえない、モノスゴイ滴たり方であった。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の男は大きな声で話をしいしいユックリユックリと室を出て行ったの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして胸の上までユックリユックリ解いてしまうと、「サアサア。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はソウ思う……」　とユックリユックリ断言しながら、食堂のマン中に引返した。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨大な旧式洋館の大沢子爵邸内の春の夜はヒッソリ閑と静まり返って、階下玄関の大時計のユックリユックリとした振子の音が冴え返っていた。",
              "citation": {
                "source": "継子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お客様のお買物について何か二言三言お尋ねになりましたきりで、その椅子に腰を卸して煙草を召あがりながら、表の通りをボンヤリと眺めてお出でになる様でしたが、そのままユックリユックリ出てお出でになったんですが……」　と云う雄弁な中小僧の言葉を片耳に残しながら……。",
              "citation": {
                "source": "殺人迷路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に、学士はユックリユックリ歩いた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝手の流許には、老婆が蹲踞んで、ユックリユックリ働いていた。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "学士がユックリユックリ歩くので他の二人は時々足を停めて待合わせては復たサッサと歩いた。",
              "citation": {
                "source": "岩石の間",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、トリユックは？",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリユックは何処へ行つた？",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリユックが主人公の傍にゐないでは……トリユック、トリユックと、アンネット嬢さんはやさしい声で犬を呼ぶのであるが、トリユックは何処へ行つたか見付からない。",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんながトリユックの怜悧さうな顔を映したいといふので……アンネットさんはやさしく媚びるやうに笑つて是をすかさんと試み、園丁は拳固を振り上げて威嚇して見たが、犬は少しも肯くどころか、いこぢになつてお尻の方を写真師に向けてゐる。",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しそこは商売柄だけあつて写真師のアンリー・メレーはトリユックがちよつと首を後へ向けた時、がちやん！",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            },
            {
              "text": "レインハットをかぶり、汚れたレインコートを羽織り、しぼんだリユックを肩にしたところは、身支度の板についた山林官の姿である。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして最後にリユックサックを脊負つた中年の日本紳士がついて來たが、その人だけが私たちの休んでゐる家に入つて來て、桃太郎君と長いこと話をしてゐた。",
              "citation": {
                "source": "湖水めぐり",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日は武穴の対岸馬頭から○○部隊の陽新攻撃を見に行くといふので、リユックサックに入れる品物を撰り分ける。",
              "citation": {
                "source": "従軍五十日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "上海租界について　汽車から降りると、私は重いリユックを背負ひ、両手に若干の荷物を提げて長いガードを渡つた。",
              "citation": {
                "source": "従軍五十日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユックリユックリと手足や胴をくねらして踊るシャムの踊りを僕は一度見たことがありますけど、あの踊りをもつとユックリとスローモーションにしたような動作です。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "登美が立って、縁側をユックリユックリ歩き出す）……（間）登美　……ええと……（ユックリ引返して来、又向うへ歩き出しながら、庭を見、はじめ低く、でたらめの鼻唄）……フン、フン、フーンと。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度｜反芻動物が、一度胃の腑の中へ納ったものを、また吐き出してニチャリニチャリと噛みしめては、楽しみを繰返す様に、北川氏は、今日の野本氏との会談の模様を、始めから終りまで、文句の細い点まで注意しながら、ユックリユックリ思出して行った。",
              "citation": {
                "source": "恐ろしき錯誤",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
