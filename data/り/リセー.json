        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "尻当を逆さまに結びつけて、一気にスィッティング・グリセードで滑り下りた。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月　一〇日　始めて河を越してパリセードに行く。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミス　コーフィールドに電話で歎願して、パリセードに行く。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、パリセードに行く。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリセードよりダイクマンまで長く歩き、夜道をしながら。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "数日後高垣氏と三人でパリセードにゆく。",
              "citation": {
                "source": "「伸子」創作メモ（一）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、エリセーフへよって、ビクトリア・ゲンリホブナの見舞、夢の話をきいた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃エリセーフの店までがらがらだ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "麗人ブリセーイス陣に歸りてパトロクロスを哭す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "又アルゴスの衆中に立ちて誓言彼述べむ、　175世間の習ひ、兩性の間に常にある如く、ブリセーイスの床の上、未だ上りしことなしと、しかせば君の胸中に心おのづと鎭まらむ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "『神明すべての頭たる至上のヂュウス初めとし、日輪、大地、及びかの世上僞盟の罪惡を犯せる者に地の底に罰を加ふるエリンニュス、　260わが證者たれ、妙齡のブリセーイスに我觸れず、彼と臥床を倶にせず、何らの害も施さず、わが陣營の中に善く彼女操を保てりと。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯くして王者プリアモス其傳令の使者と共、思慮を抱きて室の外、柱廊の中、床に就き、アキルリュウスは堅牢の其陣營の奧深く　675眠り、かたへに紅頬のブリセーイスは又眠る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アガメムノーン其戰利の美人クリセーイスを失へる償として、アキリュウスの美人ブリイセーイスを奪ふ。",
              "citation": {
                "source": "「イーリアス」例言",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "リセーは皆コレージュと呼ばれていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も二十年前に、パリのサツマ会館の管理者としてのエリセーフ氏を知っていたので、今度の渡米には、久しぶりの邂逅を楽しみにしていた一人である。",
              "citation": {
                "source": "エリセーフ氏",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてエリセーフ氏を真っ先に訪ねた。",
              "citation": {
                "source": "エリセーフ氏",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリセーフ氏も非常に喜んで、有名なボストンの美術館を案内したり、オルコット夫人の家の近くにある料理店で、劒魚を御馳走してくれたり、大いに歓待してくれた。",
              "citation": {
                "source": "エリセーフ氏",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリセーフ氏は、東大の卒業論文に『芭蕉の研究』を書き、菊五郎について踊りも習ったことがあるという先生である。",
              "citation": {
                "source": "エリセーフ氏",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年エリセーフ君が、振袖を着、かつらをかぶった舞台姿の写真が、壁にかかっているのだから、フジヤマや日光の話をしたわけではない。",
              "citation": {
                "source": "エリセーフ氏",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしエリセーフ氏の真意は、『三四郎』時代の日本だけにあるのではなさそうであった。",
              "citation": {
                "source": "エリセーフ氏",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "技術に関する無理とは、たとえば岩を登って墜ちたり、雪渓をグリセードして転倒したりすることである。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　雪渓に両足を揃え、杖を後斜めに構えてすべり下るグリセードは、誰にでも出来そうだが、子供の時から馴れている人は別として、やはり相当な練習を必要とする。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリセーフ父子　ロシア人で、私が日本文の手紙をやっても平気で読める人は、後にのべるネフスキーの他にもう一人いる。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "今パリにいるエリセーフがそれである。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔エリセーフが東京に勉強に来たころから、つきあっていたが、非常に変った人で、モスクワの有名な百貨店の持主で、大変な金持であった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは現在ハーバート大学で、極東美術の主任教授をしている、エリセーフ氏の話である。",
              "citation": {
                "source": "日本のこころ",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリセーフ氏は、生まれはロシア人であるが、若い時に日本へ来て、主な教育は東京で受けた人である。",
              "citation": {
                "source": "日本のこころ",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も二十年前に、巴里でエリセーフ氏に大分厄介になったことがある。",
              "citation": {
                "source": "日本のこころ",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年の夏、ボストンで、二十年ぶりに、このエリセーフ氏に会った。",
              "citation": {
                "source": "日本のこころ",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはエリセーフ氏が、東大の学生時代に、北海道へ旅行した時の話である。",
              "citation": {
                "source": "日本のこころ",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
