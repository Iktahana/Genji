[
  {
    "uuid": "45d52327-d344-5ba2-9dc1-18e4ed42af6c",
    "entry": "臨在",
    "reading": {
      "primary": "りんざい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
