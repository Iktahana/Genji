[
  {
    "uuid": "86f1b65b-f233-5f8f-b9e9-1e6bd9a1a0ef",
    "entry": "両辺",
    "reading": {
      "primary": "りょうへん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
