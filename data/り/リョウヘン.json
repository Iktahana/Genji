          "literary": [
            {
              "text": "藤陰は初二両編を併せ贈らうとした。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前三時、喫煙室、食堂車、寝台を含む七両編成の特別列車は、数カ月前まで世界の最強国に最高の権力をもって君臨する皇帝だったその人と家族をシベリヤへ運ぶために歩廊から辷りだした。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "町を、二両編成の電車がゆっくりと走って行く。",
              "citation": {
                "source": "湯けむり",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
