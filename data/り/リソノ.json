        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "防衛ノ程度ヲ超エタル行為ハ情状ニ因リソノ刑ヲ減軽又ハ免除スルコトヲ得。",
              "citation": {
                "source": "黄昏の告白",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖護院親王｜固ヨリソノ名ヲ聞ケリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "客歳常房ノ間ヲ周遊シ、頃ロ江戸ニ還リソノ詩ヲ刻セント欲シテ余ノ題言ヲ索ム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ奇禍測リガタキヲ以テ京師ヲ去リソノ故里松坂ニ潜マント欲シ、天明ヲ待テマサニ発セントセシナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモ耳目ヲ憚リソノ人ヲ難シトス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこれらも元来はシバグリの内のものであって、このシバグリについては同書に「又シバグリアリ一名ササグリ（和名鈔）ヌカグリ［牧野いう、漢名｜糠栗に基づいての名だろう］モミヂグリ木高サ五六尺ニ過ズシテ叢生ス房彙モ小ナリソノ中ニ一顆或ハ二三顆アリ形小ナレドモ味優レリ是茅栗ナリ」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀行デ借リルツモリデアルガ、差当リソノ利息ダケ二萬圓ホド助ケテモラエマイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ヨリソノ後ノ経過ニツキ詳細ナ説明ガアリ、頸椎ヤ腰椎ノレントゲン写真ヲ見テ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
