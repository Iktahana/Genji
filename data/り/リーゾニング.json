          "literary": [
            {
              "text": "リーゾニングとは事物の道理を推究して自分の説を付くることなり。",
              "citation": {
                "source": "学問のすすめ",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一面から云えば、クラシカルな、リーゾニングと、ゆたかな想像、描写の腕が如何に必要か。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故、活動の動機が箇性的で、或場合、野上さんと同一物に同様の見解を抱くとしても、彼女の普遍的観察の後に来るリーゾニングに依拠したものとは、性質に於て全然違って来る。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
