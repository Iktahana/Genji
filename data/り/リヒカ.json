        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして胸の辺りからずっとリヒカが掛けられて、物々しく毛布がたれて居た。",
              "citation": {
                "source": "青白き夢",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫れ此「ユングフロイリヒカイト」は人間界の清潔、温和、美妙を支配する唯一の重宝なり。",
              "citation": {
                "source": "舞姫",
                "author": "石橋忍月",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユングフロイリヒカイト」の尊重すべきを知る者なり。",
              "citation": {
                "source": "舞姫",
                "author": "石橋忍月",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の主体性の自覚においてペルソナ（格人）とは異るペルゼーンリヒカイト（人格）が成立するのである。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "倫理学はこの道徳盲を克服して、あらゆる人と時と処とにおいて不易なる道徳的真理そのもの、ジットリヒカイトを見出すことを任務とする。",
              "citation": {
                "source": "学生と教養",
                "author": "――教養と倫理学――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジットリヒカイトの場合にも厳密にこれと等しい。",
              "citation": {
                "source": "学生と教養",
                "author": "――教養と倫理学――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
