        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "丁度ソノ時下カラ人ノ来ル足音ガシタノデ、私ハイソイデ立チ上リ、ナイフデ死ノウカドウシヨウカト迷ッテ居タノデス、清三ハ未ダ死ニ切レナカッタト見エ又起キ上リカケマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十四日に間に合うように和一郎と小枝との結婚を祝う電報をうったなかに伸子はハハノケンコウノタメアメリカケイユデコラレヨと云ってやった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリカケというのが一番便利である。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯カラ上ルト、ウシロカラタオルデ拭キ、ベビーパウダーヲ振リカケ、扇風機ヲカケテクレルガ、決シテ前ヘハ廻ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナコトヲ繰リ返スコト四五回ニ及ンダガ、佐々木ガシノミンヲ四錠スヽメ、尿道ヲ湯タンポデ温メテクレタノデ、ヤット鎮マリカケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ馬鹿々々シイ真似ガ出来ルト云ウノガ、モウ気狂イニナリカケテル證拠ヨ」声ノ調子ニ、頭カラ水ヲ浴ビセルヨウナ皮肉ナモノガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニヨクナリマスヨト婆サンハ云ッタガ、ドウヤラコウヤラ少シ楽ニナリカケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "用ハナイカラサッサト帰レ」「帰ルワ」ト云ウト、茶碗ニ飯ヲ盛リカケテイタノガ、ソノ飯ヲパット飯櫃ヘ投ゲ込ンデ出テ行ッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州では大分市の附近などでオリカケバナ、やはりこの草の花茎を細かく折って、珠数にして首に掛けるのでこの名があるという。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
