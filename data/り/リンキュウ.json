        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鹽釜祠の林丘、曉靄の外に依稀として、我を送れり。",
              "citation": {
                "source": "金華山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆくりなくうき世につれてめぐるらん水におさるる井出の小車天田鐵眼の髪おろして林丘寺に入りし時。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            },
            {
              "text": "林丘あり河流ありて、夏時の遊歩場に適す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "多少の林丘あるも、概して麦田なり。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "市外に林丘あり草野あり、碧湾これをめぐり、大いに風光に富む。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "林丘抱海小湾円、翠影参差映碧漣、霜雪不侵墨南地、水明山紫是終年。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
