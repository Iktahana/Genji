          "literary": [
            {
              "text": "コノ　ヲトコノ　ヒトハ、ナニカ　ヒトノ　ビツクリスルヤウナ　コトヲ　シテ　エラク　ナリタイト　カンガヘテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヒルサンハ、ハヅカシクテ穴ガアツタラハイリタイト思ヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリクルシイノデ、ボンコチヤンハオイシヤサマノイツタヤウニ、ビヨウキガナホルノナラ、モンコチヤンノオ家ヘカヘリタイトイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニハ彼女ガ、ソレヲ知ッタ上デ、自分ノ朱色ノ足ノ裏ノ形ガ白唐紙ノ色紙ノ上ニ印セラレルノヲ見タ時ノ彼女ノ心持、ソレヲ知リタイト思ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ君ガソノ地ニ於テ、ソノママ、富貴ヲ望ムナラバ、セメテ今日マデ、酬イルコト薄キ自分トシテ、備（自分のこと）ガ首級ヲ贈ッテ、君ノ全功ヲ陰ナガラ祷リタイト思ウ。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
