          "literary": [
            {
              "text": "第二種は耳に穿ちたる孔に固く挾む棒形或はリウゴ形の物なり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唇飾とは口の周邊に孔を穿ちて是に固く挾む所の棒形或はリウゴ形の裝飾なり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高橋鑛吉氏が宇都宮近傍に於て獲られたる土製の小さきリウゴ形の物は其形其大さ誠に好く現行の唇飾に似たり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
