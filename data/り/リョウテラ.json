        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "古川重房の『筑紫紀行』十に、丹後の九世渡の犬の堂、これは戒岩寺と智恩寺と両寺して犬一つ飼いけるが、両寺一度に鐘を鳴らすを聞いて、何方にか行かんと行きつ戻りつして労れ死にせしを埋めたる跡なりとて、林道春の文を雕りたる石碑立てりとある。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "又弍両寺内ヨリ、右短刀合口コシラヘ并研。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は興福東大両寺の荘園を還附し、宣旨を以て三十五ヶ国に諜し興福寺の修造を命ぜしめしが如き、仏に佞し僧に諛ひ、平門の威武を墜さしむる、是より大なるは非ず。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも此危険に際して、猶諸国に命じて南都の両寺を修せしめしが如き、傘張法橋の豚犬児が、愚なる政策は、此声援をして更に幾倍の大を加へしめたり。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "越えて八月の半ばには等持、誓願の両寺も炎上、いずれも夜火でございます。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "越えて八月の半ばには等持、誓願の両寺も炎上、いづれも夜火でございます。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "又者於本山、平僧寺・飛檐寺両寺にて、百姓町人の旦家と一同に、穢多を旦家に持候寺も有之候。",
              "citation": {
                "source": "特殊部落と寺院",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「興福、園城の両寺とは、いろいろ因縁のある間柄故、とても味方はしまいが、山門は未だ当家に怨もないはず、山王大師に祈誓して、三千の衆徒を味方につけよう」　と、一門の公卿十人が、連署の願書を書いて山門に送った。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第七巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "案ずるに、延暦、園城の両寺は、今山門と寺門とにわかれてこそいるが、学ぶところは共に一つの天台宗である。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫衣褫奪事件とは、――嚮に家康は、京都の大徳、妙心両寺に厳命して幕閣の裁可を経ずして猥りに出世し、紫衣を用いることを堅く禁じた。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまは東に岩崎公園の森のほかに、樹の影もないが、西は兩寺の下寺つゞきに、凡そ墓ばかりの野である。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
