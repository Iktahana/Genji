          "standard": [],
          "literary": [
            {
              "text": "リツパア事件で、この辺の売春婦は顫えあがっている最中である。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ベツドをおりようとすると、スリツパアは不思議にも片つぽしかなかつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はベルを押して給仕を呼び、スリツパアの片つぽを探して貰ふことにした。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は急に無気味になり、慌ててスリツパアを靴に換へると、人気のない廊下を歩いて行つた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリアよ、マリアよ、皮膚は真黒いマリアよ、どこへ行つたのか、浴室の水道コツクからは熱湯が徐々に出ているが行つて早く昨夜を塞げよ、俺はゴハンが食べたくないからスリツパアを蓄音機の上に置いてくれよ。",
              "citation": {
                "source": "LE URINE",
                "author": "李箱",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
