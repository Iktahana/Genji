[
  {
    "uuid": "a044ae37-b0dc-50b0-a492-e2394064e88e",
    "entry": "寮長",
    "reading": {
      "primary": "りょうちょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "dormitory leader",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は学生寮の寮長として、多くの学生から信頼されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "寮長は、新入生オリエンテーションで歓迎のスピーチをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "緊急時には、寮長が迅速に対応してくれるので安心だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "子ども用のシャンペンと称する、ただの甘い炭酸水をグラスに注いで、寮長の音頭で乾杯をした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮長は、食事は全員きちんとするまで遅らせる、と宣言し、そのまま着席した部屋は着替えにもどされた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そろったところで、そのふた部屋の全員が起立させられ、寮長に面罵された。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関の左わきが事務室、右が寮長室と舎監室、そこを進むと、両側に二階の食堂にあがる階段がある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう寮長の許可ずみ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮長、いいっていったの？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一階の舎監室には、おそれていたとおり、舎監だけでなく、寮長もいた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一が、舎監の指し示した折り畳みイスに坐ると、「きてもらったのは、きみの部屋のことだ」　と、きびしい顔つきで慶一の目を見て、寮長がいいわたした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "きみたちはこの事件をどう思うんだ」　寮長は、さっきから黙りこくっている、ふたりの自治委員を見る。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「成績優秀だけでは、本校の理想を満たすわけではありません」　寮長は、厳格に批判した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮長先生は天井を仰いで、沈思黙考の体だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　という寮長の強い口調に、舎監はようやくじぶんの失策に気づいた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "わかりましたか」　寮長は、一語一語、はっきりと強調していった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もういちど、あしたの午後一時に、寮長室までくること」「はい」　慶一は、立ちあがったとき、ズボンのイスに接していたところが、汗で重くなっているのを感じた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あした、寮長室で判決だって」「サーイアク。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "冗談じゃねえよ」「じぶんで寮長にいえよ」「ちぇ、あのバカヤロ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「他人ごとだと思いやがって」「まあ、寮長はああいう人じゃねえか。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝口は寮長に呼び出されたんだぜ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一は、寮長室に入るのは、これがはじめてだった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そこへ坐りなさい」　寮長は模造革の黒い応接セットを指さし、じぶんもデスクをまわって、窓側の肱かけイスにいき、腰をおろして、タバコに火をつける。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしには、一二二人の子どもがいるんだ」　寮長は切子ガラスの灰皿に、タバコを押しつけた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "きみは、ベニー・グッドマンを聴いたことがあるか」「いいえ、名前は知っていますけど……」「そうか、そのうち聴かせてあげよう」　寮長は、慶一の硬さに気づいたようだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは、だれにもこの寮を去ってもらいたくない」　寮長はうんざりしたような表情を見せた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "暴力にかかったら、まったく手も足もでない」　寮長はひと休みして、指のあいだで、タバコを転がした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことがつづくなら、いまでさえ多すぎる規則を、さらに増やさなければならないことになる」　だれもが、寮長のことを「寮長」以外の名前では呼ばないが、この人はほんとうは理事長と呼ぶべき人で、その気になれば、校長の首だって斬ることができる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮長が、校長ではなく、寮長になることを選んだのには、いくつかの理由があるが、なによりも、この人は子どもたちと暮らすことを好んだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくタバコをくゆらし、寮長は思いなおしたかのように、「わたしはいろいろなことを試す子どもが好きだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、もうすこし、わたしらにもわかる音楽をかけてくれると、いいんだがな」「先生も起床放送を聴いているんですか」　寮長の宿舎は、寮とはべつに、野球場のむこうの丘の上にある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
