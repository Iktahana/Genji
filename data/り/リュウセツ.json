[
  {
    "uuid": "507e3ece-c074-5e77-99c2-550a084ce632",
    "entry": "流説",
    "reading": {
      "primary": "りゅうせつ",
      "alternatives": [
        "るせつ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "groundless rumor",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "銀行が倒産するという根拠のない流説があっという間に広まり、窓口には預金を引き出そうとする客が殺到した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "選挙戦の終盤になって、対立候補の不祥事に関する悪意ある流説がネット上で意図的に拡散され始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼はそのような流説には一切惑わされるなと、動揺する部下たちを強い語気で一喝した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし自分が以下に試みに随筆的に述べてみたいと思う自己流の俳句観のはしがきのような意味で、やはり自己流の俳句源流説を略記して一つには初心読者の参考に供し、また一つには先輩諸家の批評を仰ぎたいと思うのである。",
              "citation": {
                "source": "俳句の精神",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが今日のわたしたちの一方の耳からは絶えずソヴェトに対する中傷や事実の不明な流説がつぎこまれるためにソヴェト社会の実際をありのままに知りたいという気持は一層切実な要求となっている。",
              "citation": {
                "source": "あとがき（『モスクワ印象記』）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見よ其裁判の曖昧なる其処分の乱暴なる、其間に起れる流説の奇怪にして醜悪なる、世人をして殆ど仏国の陸軍部内は唯だ悪人と痴漢とを以て充満せらるるかを疑わしめたり。",
              "citation": {
                "source": "ドレフュー大疑獄とエミール・ゾーラ",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊藤が後継内閣の為め大隈板垣を推薦したので、山県と激論に及んだなど流説紛々。",
              "citation": {
                "source": "政治の破産者・田中正造",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し世上の流説は秀次の身辺ではさらに激烈な事実であつた。",
              "citation": {
                "source": "我鬼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は侍臣のさゝやきに、また世上の流説にとりまかれ、然し、ひそかに、殺さなければ殺されないと必死に希つてゐるのであつた。",
              "citation": {
                "source": "我鬼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ公の供養もすまぬのに、人の口はうるさいほど、頻繁に流説をふり撒いてゐた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ公の供養もすまないのに、人の口はうるさいほど、頻繁に流説をふり蒔いてゐた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ公の供養もすまぬのに、人の口はうるさいほど、頻繁に流説をふり撒いていた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は人間は四時間ねむればタクサンだという流説を信仰して、夜の十時にねむり、朝の二時に起きた。",
              "citation": {
                "source": "わが精神の周囲",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "下山事件が起ったときに、左翼の報復だという流説につづいて、左翼の犯行と思わせるための右翼の陰謀だという流説の応酬が起った。",
              "citation": {
                "source": "便乗型の暴力",
                "author": "――競輪その他――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この流説に便乗して起ったようなのが三鷹事件で、左翼から容疑者をあげれば、容疑者ならびに共産党側の言い分は、左翼の犯行と思わせて民心を左翼から離反させるための右翼の陰謀だというのである。",
              "citation": {
                "source": "便乗型の暴力",
                "author": "――競輪その他――",
                "note": "青空文庫"
              }
            },
            {
              "text": "思うに、日本の忍術使いが真言の九字を切るということは後世の空想的な産物で、その原型は、むしろ切支丹が胸にきる十字、そして金鍔次兵衛の存在や流説などがその有力な原型ではなかったかね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その流説を裏書するように、一個師団がゴッソリかくれて敵の上陸を待ちぶせることが出来るような洞穴が伊東の四周の山々に掘りまくられ、亮作もモッコ運びにかりだされた。",
              "citation": {
                "source": "水鳥亭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "續いて今度の歸國、瀬戸内海は船で通すにしても、藝州と防州の沖を、無事には通れまい――と言つた蜚語流説が、早耳のガラツ八を通して、平次の耳へも聽えて來ました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "十手の道",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて今度の帰国、瀬戸内海は船で通すにしても、芸州と防州の沖を、無事には通れまい――と言った蜚語流説が、早耳のガラッ八を通して、平次の耳へも聴えて来ました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "十手の道",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めサラット居士が帰るや否やチベットに流説が起りました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのラマはこの前も既にこの国に来られて地図を拵えそれからチベットへ行って地図を拵えてまたこの国へ来たのであるというような流説が立って居ったです。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、その変り果てた姿にもみな驚き合い、同時にまた、「それではまだ生きていたものとみえる」　と、遭難当時の一と頃、世上に喧しく聞えた種々な取沙汰を今更のように思い出して、その流説にまどわされて、きょうまで官兵衛に抱いていた誤った認識をそれぞれ心のうちで急に是正していた。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "という流説がしきりだった。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "流説にアブノーマルな作家だとおききしていたけれど、“知らざるを知らずとせよ”の流法で御一緒に箸をとる。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸家の内事を訊ねたり、何かの流説を行わせたりするには、恰好な老人であった。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……流説流説と仰っしゃるが、その流説、何ぞ計らん、堂上方から出ているんですよ。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一部軍隊の行為には違いないが、何か命令を穿きちがえたものか、敵側の流説に乗ぜられて、逸まったものらしく想像された。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "柴田をも難じておるので、柴田から出た流説とは誰も思うまいが、それは皆、勝家がさせておる反間苦肉と観てまちがいあるまい。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
