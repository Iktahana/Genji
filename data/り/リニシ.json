          "literary": [
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ去年大改造ヲ施シ、水槽カラ何カラ何マデタイル張リニシ、シャワーノ設備ヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ浴室ハ予専用ノタイル張リニシテ、シャワーノ設備ヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ親父ノ云ウ通リニシロッテ」「ヨゴザンストモ、キット申シツケトキマスヨ」………彼ガ彼女ニドンナコトヲドンナ風ニ云イツケタノカ知ラナイ、ソノ晩ノ十時過ギニ颯子ガヒョッコリ這入ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆デ相談ノ結果、コウケチガ附イタ以上、誠ニ残念デアルケレドモ、兎ニ角コノ注射ハ一ト先ズ打チ切リニシタ方ガヨクハナイカト云ウコトニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ先ズ奈良アタリノ絵心ノアル佛工ニ命ジテ、今宮神社ノ四面佛ニ倣ッテ線彫リニシタ勢至菩薩ノ像ニ似タモノヲ描カセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「絶対ニ着物ニハ附ケナイ、朱墨ヲ塗ルノハ君ノ足ノ裏ダケダ」彼女ハ云ワレル通リニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車通リニシバラク立ッテイタケレド、何シロ時刻ガ時刻ダカラ一台モ通ラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ敏子ガドウイウ底意デソウイウ、彼女ガ故意ニ二人ヲ置キ去リニシテ、二十分以上モ途中デ時間ヲ費シテ（二十分ヤ三十分デハナイノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
