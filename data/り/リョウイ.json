  {
    "uuid": "3fcc0961-38b4-5b8f-92f8-f7e33e01986a",
    "entry": "両位",
    "reading": {
      "primary": "りょうい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
