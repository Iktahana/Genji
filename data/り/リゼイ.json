        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "デュアメルが、この特輯に短い感想をかいていて、いろいろわけのわからない考えかたもあるが、なかで、文化と文明、カルチュアとシビリゼイションとを互に関係しつつ二つは一つでないものとしているところは当を得ています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十一日（水曜）　夜になってから母様と、シビリゼイションを見に行く。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "父、母、妹たちはヴル※ール・ペレールのアパートメントに住み、百合子はヴォジラールの下宿の窓から、シトロエン６、シトロエン６、とせわしい明滅が、シャンゼリゼイの方に向って瞬くのを眺めた。",
              "citation": {
                "source": "中條精一郎の「家信抄」まえがきおよび註",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は一週の疲労を癒するためシャンゼ・リゼイの方へ散歩に出かけた。",
              "citation": {
                "source": "頸飾り",
                "author": "モウパンサン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
