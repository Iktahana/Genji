[
  {
    "uuid": "d98f90d5-8fa7-569d-90dd-6bcadbe6c0b7",
    "entry": "柳眉",
    "reading": {
      "primary": "りゅうび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
