        "examples": {
          "standard": [
            {
              "text": "異文化に触れることで、多様な価値観への理解を深めることができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "議論を重ねることで、お互いの立場に対する理解を深めることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史を学ぶことは、現代社会の問題への理解を深める上で欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ドイツ観念論の哲学について理解を深めることができたのは先生のおかげである。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学の学徒にとってはもちろんであるが、一般の知識人にとっても、この後者の方が科学の本質についての理解を深めるのに役立つことが多い。",
              "citation": {
                "source": "救われた稀本",
                "author": "――寺田寅彦著『物理学序説』",
                "note": "青空文庫"
              }
            },
            {
              "text": "就いては、隔意なき懇談を試み、相互の理解を深めるため、一夕、貴嬢を小生宅へ御招き致したく、老母もひたすらそれを希望してゐますので、明後土曜午後六時頃、御差支なくば、小生お迎へに上りたいと思ひますから、左様御承知下さい。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
