        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スルト乳母ガ、「ホラ、督チャン、モウ秋デゴザイマスヨ、蟋蟀ガ鳴イテオリマスヨ」ト、ソウ云ッタモノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「佐々木サンカラ伺イマシタガ、大丈夫デスカオ爺チャン、オ痛イコトハオ痛イデショウガ、ソンナコトヲナサラナイデモ今ニキット直リマスヨ」婆サンハ気ガ気デナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニヨクナリマスヨト婆サンハ云ッタガ、ドウヤラコウヤラ少シ楽ニナリカケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「少シヨクナルト直グソレダカラオ爺チャンハ困リマスヨ、モウ暫ク様子ヲ見テカラニナスッタラドウ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソバデ煙草ヲオ吸イニナッタラ、ゴホン／＼オ咳ガ止マラナクナリマスヨ」「ボーイサン、ソノトランクヲコッチノ部屋ヘ運ンデ頂戴」颯子ハ構ワズサッサト隣室ヘ這入ッテ行ッテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
