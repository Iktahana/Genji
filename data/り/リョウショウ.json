[
  {
    "uuid": "b2ba8af0-e3c2-5b32-a8f2-6be16d0ba449",
    "entry": "了承",
    "reading": {
      "primary": "りょうしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "acknowledgement",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "企画書の内容について、ついに社長から正式な了承を得ることができました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "システムのメンテナンス作業に伴い、一時的にサービスが停止することをあらかじめご了承ください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "申し訳ありませんが、その条件では社としての了承をいただくことは不可能です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "従って到底御用立出来ませんから、悪しからず御了承下さい。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真を提供された川本健さん、北垣内滋子さん、佐伯彩路さん、長沼毅さん、細井明子さん、細井真人さんには了承を得たが、本来の著作権者の同意を得ないまま使っているものがあるかもしれない。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他の事項も含めて、検討課題は著作権分科会の了承を得て、公表された。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "マークラーはアップルに投資し、経営に参加することを了承したが、その条件としてウォズニアックがＨＰをやめ、フルタイムでこの会社のために働くことを求めた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "西からの提案を受け入れて京都セラミツク、アスキーとの共同開発、京都セラミツクによる製造という枠組みで臨むことを了承した渡辺の部隊は、アルトの子供を作るという前提には提案側と共通の認識を持っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが二次的な加工を行っているとはいえ、第三者の製品へのバンドルを実現するためには、当然原著作者の了承が必要だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしＯＥＭに関しては条件面での話し合いがつかず、日本での事業化にもトップの了承が得られないまま、東芝は日本電気のＰＣ―８００１に先駆けて本格的なパーソナルコンピューターを市場に問うチャンスを逃した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、細根大根を漢音に読み細根大根といわば、口調も悪しく字面もおかしくして、漢学先生の御意にはかなうまじといえども、八百屋の書付に蘿蔔一束｜価十有幾銭と書きて、台所の阿三どんが正にこれを了承するの日は、明治百年の後もなお覚束なし。",
              "citation": {
                "source": "小学教育の事",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ぶん古い作品ですのでご了承ください。",
              "citation": {
                "source": "チカモーガ",
                "author": "Ａ. ビアス　A.Bierce",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では立候補の了承を得なくてもよいから、審査請求を出すという承諾を戴こうではないか」「異議なし」　かなり長い拍手が消えようとはしなかった。",
              "citation": {
                "source": "実践について",
                "author": "――馬になった話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその意味を了承して帰った。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、近くにいるのでしたら……」　と、それとなく了承の意をしめしたが、冬亭は、そっぽをむきながら、「今日の夜行で、新潟へお帰りになるように、うかがっていますから、いまごろは、上野の駅にでも、いられるのではないでしょうか」　と冷淡な口調で、こたえた。",
              "citation": {
                "source": "西林図",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し小生の見方から来る断案であることを予め了承されたい。",
              "citation": {
                "source": "古器観道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ぶん古い作品ですのでご了承願います。",
              "citation": {
                "source": "闇をさまようもの",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く見ず知らずの男であるにもかかわらず、私に対して、丁寧な口調で、私にできるでしょうか、と、問いかけ、最終的には、それならおっしゃってください、と、私の口述することの筆記を、了承されたのである。",
              "citation": {
                "source": "三重塔にて",
                "author": "福永信",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにとぞご了承下さい。",
              "citation": {
                "source": "ＲＵＲ――ロッサム世界ロボット製作所",
                "author": "R.U.R. (ROSSUM'S UNIVERSAL ROBOTS)",
                "note": "青空文庫"
              }
            },
            {
              "text": "委細を了承して、老石工はひとまず辞して帰りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大づかみに僕はそう了承しています。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ時刻にここに持ってくるのは……」　グライドがうなずき、完全に了承し、立ち上がり、退出した。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにガルシアが不気味に笑って案内を了承したのはデンも当惑したし、しばらくの間、多少不愉快だった。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミリアムを見て、うなずいて了承した。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしんば、こんな妙な組合せの結婚式の神父を拒否したとしても、誰かが執り行うだろうから、了承した。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いゝかい、判ったかい」　わたくしは諒承した旨を覚らせるべく笑顔を作って「あー　あー」と言いました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "でこの蒼古調は私の詩風のすべてを示すものではないのであるから、右は諒承せられたい。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "江雪斎も、それを諒承して帰った。",
              "citation": {
                "source": "真田幸村",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "加ふるに閑少なく、書籍の便なく、事実の蒐集思ふに任せぬことのみなるべければ、独断的の評論をなす方に自然傾むき易きことも、亦た予め諒承あらんことを請ふになむ。",
              "citation": {
                "source": "明治文学管見",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "早々全体の部会を持つ必要があると考えましたので、専断ながらわれわれ三人で一応右のように決定致しましたから何卒悪しからず御諒承下さると共に御意見御もらし願います。",
              "citation": {
                "source": "平野義太郎宛書簡",
                "author": "一九三一年九月二十日",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚その命令書には『追テ後日何等カノ命令アルマデハ本件ニ関シ総指揮官部へ報告ニ及バズ』と但書を書くから、予め諒承ありたい」　　　　　３　ゴンゴラ総指揮官は、遂に白紙命令書百枚を金博士に手交して、博士の手腕に大いに期待するところがあった。",
              "citation": {
                "source": "独本土上陸作戦",
                "author": "――金博士シリーズ・３――",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、駄目かと、彼は苦い顔をしたが、行員は、「誰方にも、只今、一日五千フラン限りとなっていますので、事情御諒承ねがいます」　といった。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貴船の申入れを大たい諒承した。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
