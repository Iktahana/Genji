        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヽ、何カノ時ノ用心ニアレハ取ットク積リナノ」「何云ッテルンダイ、オ前ノ亭主ハマダ四十台ジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女モ佐々木ノベッドヲ嫌ッテ、長椅子デ寝ル積リナノデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コリーノ方デハ戯レル積リナノダガ、思イモカケヌモノガ飛ビ着イテ来タノデ予ハ驚イタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外デハアンマリアンナ真似ハナサイマセン、旦那ガ御覧ニナッテイラッシャル時ニヨクアンナ真似ヲナサルンデス」ト野村ハ云ウガ、ソウダトスレバ、コレモ予ヲ揶揄スル積リナノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先月行カシタキリナノデ許サナイ訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ僕ガ木村デアッタトシテ、ドッチニヨケイ惹キ付ケラレルカトイエバ、ソレハ、年ハ取ッテイルケレドモ母ノ方デアルヨリモ、僕自身ハドンナツモリナノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
