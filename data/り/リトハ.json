        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "社會主義ガ私有財産ノ確立セル近代革命ノ個人主義民主主義ノ進化ヲ繼承セル者ナリトハ此ノ故ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞働者ハ其ノ勞働ヲ賣却スル者ナリトハ舊派經濟學ノ誤説ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒダノナマリハオバエナ、マタクルワイナ、ソレカラナンジャナ、ムテンクテンニオリャコワイ、ウソカイナ、ウソジャアロ、サリトハウタテイナ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸地方諸人民ヲ通ジテ石器時代ハ今ヨリ何程以前ナリトハ决シテ云フ事能ハザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央亞弗利加ノ土人ハ其開化ノ度ニ於テ古代亞米利加ノ開化人ノ上ニ在リトハ云フ能ハズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ石器時代ノ人民ナルノ故ヲ以テ甲ハ乙ノ後裔ナリトハ云フ能ハズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ石器時代ノ人民ナルノ故ヲ以テ甲ト乙トハ同種族ノモノナリトハ云フ能ハズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大部分はカロリーの計算が主であるが、中に「近年陸軍ニ於テモ胚芽米ヲ使用シアル部隊尠カラザルモ患者統計ニ現レタル脚気発生率ハ之ガ使用ニヨリ特ニ影響ヲ蒙レリトハ認メ難シ」という節があって、添えてある表を見てもその通りである。",
              "citation": {
                "source": "兎の耳",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
