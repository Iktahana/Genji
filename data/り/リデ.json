        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "子息ハ宥免ノツモリデヰマシタ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャネットの母はイリデと言うの。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イリデ叔母様とジャネットと私達二人一緒になってお店の商品を片っぱしから英仏独で呼び合いました。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたらジャネットは晩飯の時、イリデ叔母様に話したので、イリデ叔母様は非常に真剣になって自分の考えを聴かせて下さったの――「あなたのお母様ばかりでなく、全世界の母親は自分の娘が戦争を誘発するような女流軍事飛行家になるのを遮ぎるでしょう。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」暫らく言葉を切ったイリデ叔母はウイリーの方をちらっと見て――「だのにウイリーはナチスの党員になって、先日も突撃隊を志願すると言うの。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イリデ叔母様は眼も鼻も、くしゃくしゃにしてハンケチでこすって居らっしゃいました。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママは何故イリデ叔母様のように胸の悲しみを私に打ち明けて下さいませんでしたの。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はママの為めに、イリデ叔母様の為めにも陸軍飛行隊へなんか習いに行きません。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今朝六時頃、ハリデイ・プライヴェート・ホテルで殺害されました。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝も早くから始めて、八時にリトル・ジョージ街のハリデイ・プライヴェート・ホテルに行き着きまして。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう言われては秘書もやってられるかと匙を投げ、終電を逃したらハリデイ・プライヴェート・ホテルで合流という取り付けだけをしました。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ハリデイ・プライヴェート・ホテルだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつの宿泊先がハリデイ・プライヴェート・ホテルなのはわかってましたから、一日じゅう待ち伏せしたのですが、やつは一向出てきません。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "エノシマヘフタリッキリデデカケルノイヤ？",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋のみんなで、シャボン玉ホリデー風のコントをやったが、ぜんぜんウケなかったのだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニュウ・ヘブリディスから来た当座は、うちの食事が旨いとて無闇に食過ぎ、腹が凄くふくらんで了って苦しんだことがあったが。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に、義雄はお鳥に送る電報、「リヨカウチウユヘヒトリデコイ」といふのを、山形まはりの青森線に當る弘前停車場へ宛て、受信人を上野十二月二日正午發列車中の清水お鳥として打電した。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト、ツボミタチノ　アタマノ　ウエデ　ダレカガ、「ヒバリデス、ヨ」ト　フトイ　コヱデ　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "クツヤノ　ヂイサンハ　一リデ　セツセト　クツヲ　ツクツテ　ヰテ、フエフキガ　フエヲ　フキハジメルト、「ウルサイカラ　イツテ　オクレ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタバカリデハ　アリマセン。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシバカリデハ　ナイノダ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アンマリ、カワイカツタノデ、マダ　ダツコシテル　ツモリデ　カヘツテ　キタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどそれが、「ハイムスクリングラ（オーディン神より創まっている古代諾威王歴代記）」にある、僧正テオリディアルの執事そっくりじゃ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例せば医神アスクレピオスの諸祠の神蛇、デルフィの大蛇、ヘスペリデスの神竜等のごとしと。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジクッスの弟ポリデクテス、この島の王たり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて、弁士エウチアスに重罪犯として訴えられた時、その情夫の一人で大雄弁家なるフペリデースに弁護されしもややもすれば負けそうだった。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでは、ヘブリディーズ４あたりの波のように、低い下生が絶えずざわめいている。",
              "citation": {
                "source": "沈黙",
                "author": "――神話",
                "note": "青空文庫"
              }
            },
            {
              "text": "メンデルスゾーンにここの風物を――その寂寥、海の動揺、波のざわめき、海鳥の鳴声、風の号泣、大洋の怒涛などを、描いたきわめて美しい音楽、序曲「ヘブリディーズ」（一八三〇）がある。",
              "citation": {
                "source": "沈黙",
                "author": "――神話",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかの奧さんが舞踏の何とかいふ型を他の型と間違へただの、ボボフとかいふ男は襟飾をつけた恰好が鸛そつくりだつたが、その人がもう少しでころげるところだつただの、リディナとかいふ女は緑いろの眼をしてゐる癖に自分では碧い眼だと思つてゐるだのと、そんなやうなつまらない話ばかりなの。",
              "citation": {
                "source": "狂人日記",
                "author": "ZAPISKI SUMASHEDSHAWO",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
