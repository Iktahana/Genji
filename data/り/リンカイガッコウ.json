        "examples": {
          "standard": [
            {
              "text": "小学校の臨海学校で遠泳の訓練を乗り越えたことは、彼にとって大きな自信に繋がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "夏の臨海学校の夜、砂浜でクラスメイトと一緒に囲んだキャンプファイヤーの火は今でも忘れられない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "娘は初めての臨海学校に向けて、大きなリュックサックに水着や着替えを嬉しそうに詰めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "町の小学校でも石の巻の近くの海岸に十五日も生徒を連れて行きましたし、隣りの女学校でも臨海学校をはじめていました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の小学校でも石の巻の近くの海岸に十五日も生徒を連れて行きましたし、隣りの女学校でも臨海学校をはじめてゐました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「臨海学校の引率」　吐き出すように、祐子が言った。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまは夏休みだが、まもなく臨海学校の引率をしにいかなくてはならなかった。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私たちが泊まる旅館からすこし離れたところに、もうちょっとましな旅館があって、そこに百合は泊まるのよ」「臨海学校を引率するの？",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
