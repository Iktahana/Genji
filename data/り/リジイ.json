        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「伯母リジイ」というともうちゃあんと決っている。",
              "citation": {
                "source": "字で書いた漫画",
                "author": "谷譲次",
                "note": "青空文庫"
              }
            },
            {
              "text": "このリジイ伯母さんには、必ず大学へ通っている若い姪があって、伯母さんは、一年に二、三度は寄宿舎に女学生の姪を襲撃することになっている。",
              "citation": {
                "source": "字で書いた漫画",
                "author": "谷譲次",
                "note": "青空文庫"
              }
            },
            {
              "text": "姪のノウマ、伯母リジイの来襲を少しも恐れない。",
              "citation": {
                "source": "字で書いた漫画",
                "author": "谷譲次",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　リジイ伯母さんは口がきけなかった。",
              "citation": {
                "source": "字で書いた漫画",
                "author": "谷譲次",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯母リジイがぷんぷんしてさっそく帰り支度をはじめたとき、部屋のあちこちから友達の眼がのぞいて、そして、いちように笑いを堪えていた。",
              "citation": {
                "source": "字で書いた漫画",
                "author": "谷譲次",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
