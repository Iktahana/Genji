  {
    "uuid": "7d723a41-b164-52bc-bcdf-c8c7a99a8500",
    "entry": "リンカク",
    "reading": {
      "primary": "りんかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "○廊下をスエの室に向い歩いて行ったら向うから赤紫っぽいコートを着て来る女のリンカク（肩の辺）いかにも久に似ていたのでそう思ったら、片春であった。",
              "citation": {
                "source": "日記",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめてお母さんの顔をと思つて、じつと眼をつぶつてみたのですけれど、もやもやとした記憶の影が、まつたく表情のないリンカクだけを描き出しているのです。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔立も薄くすきとほるやうで、リンカクがキリリとしてゐて、幼さと、気品があつた。",
              "citation": {
                "source": "花火",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "色の白さ、リンカクの正しさとあざやかなこと、彫刻と申すほかに仕方がない。",
              "citation": {
                "source": "お魚女史",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょッとリンカクが尖っているのは、職人が南蛮渡来なんだなア。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "否、家出後の暫時の目鼻がほぼリンカクをなしていたのである。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "川木屋の内情について、ほぼリンカクをつかむことができたのである。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二　密室大犯罪",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがはからずも今回の事件が起るに至って、はじめていくらか明瞭なリンカクを知り得たと申しましょうか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに秋田犬というものもバクゼンたるリンカクだけは少しずつ分ってきた。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "整然たるリンカクに於ても、色の白さに於ても、美しいヒゲに於ても、ヘルプ紳士の最優良種に属していたが、お行儀のよさ、気のやさしさ、物やわらかさ、すべてに申し分のないヘルプ紳士中のヘルプ紳士であった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを飮みながら、女の方を見ると、まつ暗なので顏も姿も、まるで見えませんけれど、それでも眼が馴れたか、暗い中にもう一段黒く、かすかに頭髮のシルエットと、それから薄白い顏のリンカクと、その下に肩と胸らしい所が見えました。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、その時はオボロゲながら見たと思つた女の顏のリンカクなども、完全に忘れてしまつているのです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんだことになりましたね」「ええ」　下枝さんは、あどけないリンカクの美しくととのった顔をあげて、私を見た。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二十六日、月、晴改造高平キタル　リンカク校正ワタシ「三つの寶」の本文のメーク・アップのこと。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
