[
  {
    "uuid": "d62f5733-19de-54da-82ca-a06bca093fbd",
    "entry": "輪郭",
    "reading": {
      "primary": "りんかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
