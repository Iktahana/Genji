[
  {
    "uuid": "04236e41-c612-5240-b200-3da536c67eaf",
    "entry": "離岸",
    "reading": {
      "primary": "りがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
