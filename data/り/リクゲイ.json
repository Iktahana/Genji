        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "支那に於いて、君子というのは、日本に於ける酒も煙草もやらぬ堅人などを指さしていうのと違って、六芸に通じた天才を意味しているらしい。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六芸（礼・楽・射・御・書・数）に通ずるとある、六芸は皆これ物事上のことである。",
              "citation": {
                "source": "一貫章義（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは鹿爪らしい六芸の礼楽｜射御の御とは別にしてしかも同源の語で、腰を動かすてふ本義だ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "正雪は一代の反抗児、十能六芸武芸十八番、天文地文人相家相、あらゆる知識に達していたので、曾て驚いたことが無い。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして非常な風流人で、六芸十能に達していた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六芸社の本は序も簡単にしかしよくかけた方だし、好評です、全体としてそうなのは勿論当然であるが。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "『文学評論』が（六芸社の方）いろんな本屋の店頭に積まれている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当に今度は六芸社の本にしろ思いがけない役に立ちました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "待望の書として六芸社のはレビューされています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六芸社の本［自注16］などについて批評を書いた鶴さんの文章は、友愛の珠玉です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注16］六芸社の本――宮本顕治『文芸評論』。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "松本正雄というひとと鉄兵とがバックの短篇を訳したのを六芸社から送ってくれました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六芸社から出ている『文芸評論』が参考書としてとり出されています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴さんの本を殆ど終りますが、六芸社の本を出してよみ合わせて様々の感想にうたれます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六芸社の本のなかで、小説的現実と云われていること、描写で追求しなければならないと云われていること、いろいろ又味い直し、この筆者の芸術的感情の本ものであること、しかし歴史の中では、いつも全面を万遍なく云い切れないということなども感じました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう、送られて来た同人雑誌を見ていたら、六芸社から出た『文芸評論』の、芸術性の問題にふれているところ、内容とか形式とか二つに分けて芸術的感銘は語れない、その統一がいると云われているところを一つの発展としてとりあげているのをよみました、誰かの文芸評論の中で。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故なら、中公の『現代文学論』では六芸社の著者が、そこへともかく線をのばして描き出しているという文学史のステップを一つも見ていませんからね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人の六芸に達したと言ふのは。",
              "citation": {
                "source": "唱導文学",
                "author": "――序説として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗教と、音楽とは、全く離すことができません――孔夫子ですらも、楽を六芸の一つに加えているのに、今の儒者共で、孔夫子のいわゆる楽を心得た奴が幾人ありますか……それはそれとして、今度はひとつ、その山陽流をやってみましょう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして楽しみを六芸に求めたい。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "」○　六芸＝＝原文には単に「芸」とあるが、礼・楽・射・御・書・数などをいうのであろう。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "」○　射・御＝＝禮・楽・射・御・書・数の六芸のうち射（弓の技術）と御（車馬を御する技術）とは比較的容易で下等な技術とされており、とりわけ御がそうである。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが日本の従来の風はなんでも十能六芸そろわなければ人間らしくないように思う。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
