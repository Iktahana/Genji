      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "spending the night out (e.g. at a brothel)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "若旦那は放蕩三昧で、連日のように遊里に流連しては家業を疎かにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "かつての文豪たちは、旅先の宿で流連しながら名作を書き上げたという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は酒場での流連に飽き足らず、友人を誘って夜通し飲み歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして土地の妓も呼んで、浮月に流連していたの。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "在学中も、雨桐はじめ烏金の絶倍で、しばしばかいがんに及んだのみか、卒業も二年ばかり後れたけれども、首尾よく学位を得たと聞いて、親たちは先ず占めた、びきで、あおたんの掴みだと思うと、手八の蒔直しで夜泊の、昼流連。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "意気な小家に流連の朝の手水にも、砂利を含んで、じりりとする。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "四日｜流連けて石田は金を取りに帰った。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "四日流連けて石田は金を取りに帰った。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の九つ（十二時）過ぎで、栄之丞は夏の日を編笠によけながら出て行くと、八橋の座敷には次郎左衛門が流連をしていた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　次郎左衛門はその明くる日も、またその明くる日も流連をして帰った。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきおとといからの流連でも、自分が恐れていたほどに金は懸からなかった。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "けさも流連かとひやひやしていると、次郎左衛門は思い切りよく朝の霜を踏んで帰った。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "元日から七草まで流連をして、八日の午頃に初めて馬喰町の宿へ帰ると、治六は帳場の前に坐って亭主と話していた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私は村の居酒屋におしあがつて酌婦相手の流連をしたり、港町の奇怪なホテルに出没したり、銀座へ出かけてカフエーを飲み歩いたりして来た面白さに胸を踊らせた。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃の或る新聞に、沼南が流連して馴染の女が病気で臥ている枕頭にイツマデも附添って手厚く看護したという逸事が載っているが、沼南は心中の仕損いまでした遊蕩児であった。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠孝の結晶として神に祀られる乃木将軍さえ若い頃には盛んに柳暗花明の巷に馬を繋いだ事があるので、若い沼南が流連荒亡した半面の消息を剔抉しても毫も沼南の徳を傷つける事はないだろう。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうしてどこというあてもなく、ぶらりぶらりと二廻りしてしまったのが丁度四ツ半下り、――流連客以外にはもう登楼もままならぬ深夜に近い時刻です。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おやじのシャッポ（ポコペンとか駄目とかいう意味）がホームラン（流連のこと）」だの、「彼女のラジオ（色眼）がミシン（意味深長）」なぞ云って、わかる気づかいは毛頭ない。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "男が手数料を出したとすれば、高価い、まずいオイランを買って流連した気で思い切る事になる。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――随分と思ひ切つた悪計なども現れて「質屋へ用達中」とか「流連中」とかは未だしもであつたが、「入院中、但し性病科故御心配無用」などゝやられて、折悪くも国元の父親に訪ねられて途方に暮れた者やら、待合何某方へ。",
              "citation": {
                "source": "女に臆病な男",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、其頃重右衛門は湯田中に深く陥つて居る女があつたとかで、家の衰へて行くのにも頓着せず、米を売つた代価とか、蚕を売つた金とかありさへすれば、五両なり十両なりそれを残らず引攫つて飛出して、四日、五日、その金の有らん限り、流連して更に家に帰らうとも為なかつた。",
              "citation": {
                "source": "重右衛門の最後",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれはその三日前ばかりから、湯田中に流連して、いつもの馴染を買つて居たが、さて帰らうとして、それに払ふべき金が無い。",
              "citation": {
                "source": "重右衛門の最後",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　祇園の空を飛んだ若い飛行将校よ、あの折シヨペンハウエルが万亭の二階で流連をしてゐなかつたのは君に取つて勿怪の幸福であつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた幾日も二人で流連していた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに今一つの理由としては、辰之助の妹｜婿の山根がついこのごろまでおひろと深い間であったことで、恋女房であった彼の結婚生活が幸福であった一面に、山根はよくおひろをつれて温泉へ行ったり、おひろの家で流連したりして、実家の母をいらいらさせた。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「幾代で流連してゐるらしい。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日も流連や、幸ひ雨になりさうで、結構なこつちや。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "流連の意味が文吾にはよく解らなかつたけれど、雨が結構ぢやと言つた源右衞門の言葉と、女の嬉しさうな顏とから推し測つて、文吾もぞく／＼と嬉しかつた。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五　古市二日といふ村の伊勢參りの掟を破つて、三日も流連したので、日取りの狂ひは後の道中で取り返すから、下向の迎ひを平井明神の境内に待ち惚けさせる心配はないが、苦勞なのは、めい／＼の懷中であつた。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "春去夏来新樹辺、緑陰深処此留連、尋常性癖耽閑談、不愛黄鶯聞杜鵑　その時一人の旅人が――武者修行風の若い武士が、麓の方からやって来た。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今詩集に因りて其の行程を案ずるに先づ豊前に入り、筑前を経、長崎に留連し、天草洋を航して島原に上陸し、熊本に至り、南下して薩摩に入り、大隅より再び肥後に還り、更に豊後に行き、筑後河を下り、豊前より再び赤間関に至り、其所にて新年を迎へしが如し。",
              "citation": {
                "source": "頼襄を論ず",
                "author": "山路愛山",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十幾年のむかし、洲崎の遊里に留連したころ、大門前から堀割に沿うて東の方へ行くとすぐに砂村の海辺に出るのだという事を聞いて、漫歩したことがあったが、今日記憶に残っているのは、蒹葭の唯果も知らず生茂った間から白帆と鴎の飛ぶのを見た景色ばかりである。",
              "citation": {
                "source": "元八まん",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "天さばかり風景に留連するの日子をたまはず、北松浦には一歩をも踏み入れざりし、これ洵に遺憾なりとす。",
              "citation": {
                "source": "松浦あがた",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
