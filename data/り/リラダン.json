        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然し中谷小林は共に緑に圍まれた郊外の夏に籠つて、シツラーやリラダンに餘念なく、いゝ生活をしながら今度の原稿を齎らして呉れた。",
              "citation": {
                "source": "編輯後記（大正十五年九月號）",
                "author": "『青空』記事",
                "note": "青空文庫"
              }
            },
            {
              "text": "リラダンの風貌と僕の顔とを見比べてみよう。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルレエヌも、リラダンも舞台では失敗である。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "リラダンの戯曲「新世界」は、一八七五年、亜米利加独立記念賞金を受けたことで有名になつた。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のなかにはロートレアモンもゐれば、リラダンもゐる。",
              "citation": {
                "source": "三島由紀夫",
                "author": "ナルシシスムの運命",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの關係は、むしろリラダンの『未來のイヴ』におけるアダリイとエディソンの關係に似てゐる。",
              "citation": {
                "source": "三島由紀夫",
                "author": "ナルシシスムの運命",
                "note": "青空文庫"
              }
            }
          ]
        }
