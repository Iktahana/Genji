        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の仕事に対する真摯な姿勢には、心からリスペクトを抱いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "対戦相手であっても、その素晴らしいプレーにはリスペクトを送りたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "「君の決断をリスペクトするよ。最後まで応援しているからね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "自分その点は気の毒をしたと思ったが、そう勝手につねったりぶったりされること、セルフレスペクトを失って不快。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウイズ・ベスト・レスペクト……、最上なる敬意を以て、か……。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼には彼がレスペクトを以つて交つてゐる若干の友人がゐた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして彼も亦彼等からレスペクトを以つて取扱はれてゐることを感じてゐた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｑは彼の少數な友達の中でも平生特に重厚なレスペクトを以つて彼を取扱つて呉れる人であつた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
