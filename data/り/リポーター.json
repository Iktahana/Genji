        "examples": {
          "standard": [
            {
              "text": "現場のリポーターが、台風の激しい雨風に耐えながら生中継を行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「それでは、スタジオから現地のリポーターにマイクを戻します」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は持ち前の明るさを活かして、街角のリポーターとして活躍している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "といったところで、僅か六ヶ月のリポーター生活だから、僕が一九二〇年以来、たった一つの新聞社に働いているということは、驚くべき歴史的事実として彼の目に映じたらしい。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストックポート（レイナー博士とレイナー氏：リポーター）。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "リヴァプール（ヘンリー・テイラー氏：リポーター）。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒードン（サンドウィッチ博士：リポーター）。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときはすでに話が広まっていて、新聞社から記者が来ていたし、ＴＶ局からもカメラ・クルーを連れてリポーターが来ていた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
