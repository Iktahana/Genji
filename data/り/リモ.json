        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "顳をキリモミにしてゐる。",
              "citation": {
                "source": "散歩生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰途プリモースに上陸し、そこからフルードの船型試験室を訪問した。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "会のあとでプリモースへ行ってそこで始めて電話というものを実見した。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カノ昆布ノ森ノ女学生ヨリモ、モット、シズカニ考エタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして国元の西班牙へ返されたところで私に探偵を命令した反プリモ党は何時天下を覆えされるか判ら無いのよ。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――スペインの前の執権、プリモ・ド・リヴェラは、正義振って遊楽地の賭博を禁止したのよ。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モリモリ儲けてるんじゃない……？",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーイがリモナーデを持って来たのを寝台の肱掛けの穴へはめようとしたら、穴が大きすぎたのでコップがすべり落ちて割れた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜船へ帰って、甲板でリモナーデを飲みながら桟橋を見ていると、そこに立っているアーク燈が妙なチラチラした青い光と煙を出している。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョン・バリモアーなどにもちょっと似ているのがある。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに出て来るライオネル・バリモアーの役が湿疹に悩まされていることになっていてむやみにからだじゅうをかきむしる。",
              "citation": {
                "source": "破片",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョン・バリモアー役の主人公が「おれもそんなに忠実なコンパニオンがほしい」とはなはだ深刻な皮肉を言う場面がある。",
              "citation": {
                "source": "破片",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ山ハ私ガ実際ニ感ジルヨリモアマリ平面ノヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その当時売り出した、バリモアというオペラ女優の身ぶりなどを巧みにまねながら貴女は手に持っていた薔薇を無意識に胸にさしてしまった。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "型の如くトリモチ竿の長いのを手にしてはいるが、枝にも梢にも雀がいるのに一向刺そうともしないで、森のまわりを抜き足差し足でうろうろとしながら、何を探そうというのか、しきりと中の容子を覗き見している気勢でした。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――のっそり木蔭から現れて、すいすいと足早に近よりながら、血色もないもののように青ざめている鳥刺しの手元から、黙って静かにトリモチ竿を奪いとると、「御老体、なかなか御出来でござるな」　ウフフとばかり軽く打ち笑いながら、ふうわり鳥竿を神官の目の前に突き出して、いとも朗かに言いました。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソファに寝ころんだまま、ちょっとはなれたモニターに表示される電子本のページを、パソコン・ゲーム用のリモート・コントローラーでめくったりすることもできる。",
              "citation": {
                "source": "本はどのように消えてゆくのか",
                "author": "津野海太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメガ　ヤムト　マヘヨリモ　イツソウ　アタタカナ　ヒノ　ヒカリガ　ソソギマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽に惚れた人５・13（夕）　月の終りにはタゴオルが来る、七月にはゴリキイが来ると聞いてゐるのに、今度はまた露国詩壇の革新者コンスタンチン・バリモントが来るといふ噂が伝はつてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリモントは仏蘭西のユゴオのやうに太陽と美との熱愛者で、その名高い詩集にも『太陽のやうに』といふのがある位だ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その折ブラウン教授の挨拶に、「バリモントがこの世に生れたのは太陽を見るためだつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "（その自伝によると）バリモントは五歳の時に、婦人を見るとぽつと顔を赧めるやうになり、九歳の時には真剣に女に惚れるやうになり、十四の時に肉慾を覚えたと言つてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五歳といへばまだミルク・キヤラメルの欲しい年頃だ、日本では『好色一代男』の主人公が腰元の手を取つて、「恋は闇といふ事を知らずや」といつたのは、確か七歳だといふから、バリモントはそれ以上の早熟た子供で、その頃から乳母にお尻を叩かれては、くす／＼喜んでゐたに相違ない。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリモントは後にその折の事を思ひ出して、「お蔭で創が癒つてからは、人間も一段と悧巧になり、従来のやうに鬱々しないで、その日その日を娯しむやうになつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏の笑顔５・24（夕）　先日来遊した露国の詩人バリモントは、態々日光まで出掛けて往つたが、噂と違つて一向結構な点が無いので失望した、多分京都や奈良へ往つたら、この償ひがつくだらうと、心細い事を言つてゐるさうだ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "バリモントも態々日光へ出掛けるなぞ無駄な事をしたものだが、それでも感服しなかつただけが取得だ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
