    "definitions": [
      {
        "index": 1,
        "gloss": "trishaw",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い写真には、観光客を乗せて走る輪タクの姿が写っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "観光地では、今でもレトロな雰囲気の輪タクが人気を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「もしよかったら、輪タクで市内観光しませんか？」と運転手が声をかけてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その山岸敬明が経営しているのが深川新大橋にある互幸輪タク会社です。",
              "citation": {
                "source": "ファシズムは生きている",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この輪タクは「宮様輪タク」とよばれています。",
              "citation": {
                "source": "ファシズムは生きている",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山岸敬明が輪タクを開業するとき十万円ほどの資本を出して株主となったのがもとの賀陽宮、いまの賀陽恒憲だったそうです。",
              "citation": {
                "source": "ファシズムは生きている",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども輪タク一台いくらすると思って？",
              "citation": {
                "source": "ファシズムは生きている",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎の輪タク屋がわたしにいったことがあります。",
              "citation": {
                "source": "ファシズムは生きている",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十万円で輪タク五台ですよ。",
              "citation": {
                "source": "ファシズムは生きている",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラックの上から見る、サイゴンの大通りは、ヨウの大樹の並木が、亭々と並んでゐて、その樹下のアスハルトの滑つこい大通りを、輪タクに似たシクロが昆虫のやうに走つてゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "輪タクに案内させて、港に近い、千石町とか云ふところの、小さい宿屋に案内された。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が前に三度、外泊したというのは一度の誤り、それも銀座から帰る途中、リリーとふたりで輪タクの運転手と喧嘩し、Ｋ町の交番に保護検束を受けただけ、分厚い札たばというのも、十日毎位の店の収入を、纏めてみただけという、彼女の話をなんでもかんでも信じたい気持になる。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "手っ取り早く、輪タクだ。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "輪タクは、ことことことこと、走ってゆく。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子は上野から省線電車に乗り松戸の駅で降りたが、寺の名だけは思出すことができたものの、その場処は全く忘れているので、駅前にいる輪タクを呼んでそれに乗って行くと、次第に高くなって行く道が国府台の方へと降りかけるあたり。",
              "citation": {
                "source": "吾妻橋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴みがきもゾッとしねえし、輪タクでも借りて、パンパンの客引でもするか。",
              "citation": {
                "source": "渡鳥いつかへる",
                "author": "軽演劇一幕四場",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子は上野から省線電車に乗り松戸の駅で降りたが、寺の名だけは思出すことができたものゝ、その場処は全く忘れてゐるので、駅前にゐる輪タクを呼んでそれに乗つて行くと、次第に高くなつて行く道が国府台の方へと降りかけるあたり。",
              "citation": {
                "source": "吾妻橋",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "親友の南条己未男でさえ、吐きだすように、「そんなら、輪タク屋にでもなれ」　と、言つた。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うむ、輪タク、結構。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "面倒なことはないさ、じかに当つてみろよ」「当つてみてもいゝが、そこまで腹をきめたら、別に輪タクには限るまい。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「輪タクも、やりようじや、スリル満点らしいぜ。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとに輪タクをやると言つても、べつだん、驚かぬにきまつていた。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "京野等志は、もう、この者に見切りをつけて、ひそかに、輪タクで、一夜、彼をとてつもないところへ引つ張つて行つてやろうと空想した。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "京野等志が、仕事を探しあぐね、例の輪タクでもと肚をきめたとき、ひよつくりと、彼の消息がわかつたのである。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それより、おれは、輪タクでもやろうかと思つてるんだ」「輪タク……おどかすない。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
