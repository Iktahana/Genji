  {
    "uuid": "a43c7cec-c216-5dbf-bd45-ac38c34dcd37",
    "entry": "リンタク",
    "reading": {
      "primary": "りんたく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
