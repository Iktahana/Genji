          "literary": [
            {
              "text": "またベシシ族の術士はチンドウェー・リマウ（虎チンドウェー）という小草を磨潰し胸に塗ると虎に勝ち得るという。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国種のプリマウス、ロックだの、仏国種のウーダンだの、亜細亜種のブラマだのと肉用鶏も沢山あるが最上等の肉用鶏はこのドウキングだ。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きなプリマウス種の雄鶏が、鶏舎の外で死んで居た。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
