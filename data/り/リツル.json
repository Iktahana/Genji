        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "膝においた手を捻るように揉んだが、汗がまとっているからでもあろう、ツルリツルリと指がはずれた。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百の駈足が、想像外にはやいのみならず、その身のこなしが、油のように滑っこく、ちょっとやそっと捉まえたのでは、ツルリツルリと抜けられてしまうのみならず、今は片手に脇差を抜いて振り廻しているのだから、せっかく追いつめたものも、立ちふさがったものも、キワどいところでいなしてしまう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "生田葵山氏の若い時の話、永井先生の「矢筈草」の発端、フリツルンプや凡骨や都川という木下杢太郎氏の詩へ出てくる鳥屋の話など、ことに心を惹かれました。",
              "citation": {
                "source": "随筆　寄席風俗",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リツル・ハンプトンへ」とマチアが言った。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、三十七歳に「若草物語」つづいて、「グッド・ワイブス」「リツル・メン」など大作を世に送りました。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "南極のリツル・アメリカでの冬営中「夜」と「昼」とを通じて、流星の観測をした記録がある。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
