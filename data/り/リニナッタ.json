        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「コヽマデ来タンダカラチョット伊勢丹ヘ寄ロウ」ト、婆サンノ反対ヲ豫期シテ云ウト、「又冷房デモイヽンデスカ、コノ暑イノニ早クオ帰リニナッタラドウ」ト果シテ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オイデニナッテイラッシャイマシタガ、モウオ帰リニナッタヨウデゴザイマス」ト、多少曖昧ニ答エテ出テ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイ、オ帰リニナッタコトヽ存ジテオリマシタラ………」「アヽソウカイ」「………オ二階デ涼ンデイラッシャイマシタンデ、………」コップガ二ツトコカコラノ壜ガ二ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガドウシタンダ」「アタシモ覚エテナインダケレド、鉾田トハ仕事ノ関係カラ近頃懇意ニオナリニナッテ、時々オ目ニカヽルコトガアルンデスッテ」「ダカラサ、ソレガドウシタト云ウノサ」「イヽエネ、ソノ油谷サンガ先週ノ日曜ニ御近所マデ参リマシタカラッテ、御夫婦デ鉾田ノトコロヘオ寄リニナッタンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト颯チャンノ石ダッテ餘程ノモノデショウネ」「ソンナモノヲ誰ガイツノ間ニ買ッテオヤリニナッタンデショウ」ト、コヽデ又婆サンガ一言シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人キリニナッタトコロデ、サテドンナ風ニ切リ出シタモンカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤリ損ッタッテ死ニハシナイヨ」「死ニハシナイデモ、気絶シテ今ニモ死ニソウニオナリニナッタリシタラ、ソレヲ見テルダケデモイヤダワ」「コンナ思イヲシテ生キテルクライナラ死ンダッテイヽサ」予ハ殊更ニ悲壮ラシク云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手ハモウスッカリオ直リニナッタンデスカ」来ルトイキナリ気ヲ呑マレタ形デ眼ヲ白黒サセテイタ五子ハ、コヽデ辛ウジテ嘴ヲ入レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マアオ爺チャン、アタシノ云ウコトヲ聴クモノヨ」忽チ予ハ鳴リヲ静メテ云ウナリニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテソノ麻痺状態ニ置カレテイタ期間ハモノノ二三十分ニ過ギズ、間モナク遮断サレテイタ神経ノ通路ガ復舊シ、失ワレタ記憶ガ戻ッテ来テスベテガ平生ノ通リニナッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
