          "literary": [
            {
              "text": "空疎守舊ノ學説ト薄弱ナル意志ト衆愚ノ喝采ヲ足レリトスル虚榮ト、實ニ通俗政治家ノ標本タル「ウヰルソン」輩ノ通辯ニ得々タリシ所謂學者ナル者ノ反省ヲ要ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令同一人民ニシテ青銅器ト鐵器トヲ用ヰタル事有リトスルモ、鐵器ノ用ハ常ニ青銅器ノ用ニ後ルト定マリタルモノニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして私には「今日モナオ時代オクレナ舊道徳ヲ重ンズル一面ガアリ、或ル場合ニハソレヲ誇リトスル傾向モア」ったのである。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
