        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おかしいぞ、此の狸奴、おれに化けて何をするつもりだろう、と思っていると、坂をむこうにおりて往くので跟いて往った。",
              "citation": {
                "source": "怪談覚帳",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庄屋は此の狸奴、おれに化けておれの妻室をばかすと見える、と思っておると、狸は其の庄屋と同じ声で、「今もどったぞ」と云った。",
              "citation": {
                "source": "怪談覚帳",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "居るなら居るで好い、一寸お待ち下さいとは何だい、狸奴！",
              "citation": {
                "source": "熱海へ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは、若いときわしの祖父からきいた話に、殿田用水あたりには、昔から性悪の狸奴がすんでいて、とてつもない物に化けるそうじゃ。",
              "citation": {
                "source": "しゃもじ（杓子）",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "よんべのしゃもじも、たしかにその狸奴の、道楽だんべえ。",
              "citation": {
                "source": "しゃもじ（杓子）",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの狸奴、うんと取込んで居るぞ」　多賀小三郎も齒に衣を着せません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "權三は泣く",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
