          "literary": [
            {
              "text": "今日は『プラウダ』も『イズヴェスチア』も第一面に六十歳を迎えたリャザノフについて書いて居た。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "リャザノフが『シナ・インド論』の序文中に引用する箇所はちょうどこの次の行からであるが、十九世紀の極東市場史なかんずく日本開国問題を考察する場合には、太平洋に関するマルクスのこの予言部分はことに重要である。",
              "citation": {
                "source": "汽船が太平洋を横断するまで",
                "author": "服部之総",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
