          "literary": [
            {
              "text": "彼等ハ異様ノ風体ヲナシ身ノ丈程ノ雑草中ニ潜ミ居リシモノナリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "我邦ニテ古今無双ノ古貨幣家タリシ旧福知山侯ノ蔵品ハ、長持幾棹トカ有リシモ、皆徃年普魯斯人某ガ神戸ニテ買ヒ去リシト。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾テ都下狭斜ノ巷ニ在テ左褄ヲ取リシモノ亦無シトセズト。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "青銅器使用人民ノ鐵器ノ用ヲ知ルニ至リシモ亦自然ノ順序トハ考ヘ難シ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
