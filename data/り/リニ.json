        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（このニヒリズムの反射に於て、いかに世界が権力への渇仰を、あのムッソリニや、ヒンデンベルクや、レーニンやに捧げているかを見よ。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人公ラスコリニコフの心理と言行とが、小説の最初から大尾まで、魔法のやうに僕の心を引き捉へて居た。",
              "citation": {
                "source": "初めてドストイェフスキイを讀んだ頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その讀後の深い印象から、僕はラスコリニコフを以て自ら氣取り、滑稽にもその小説的風貌を眞似たりした。",
              "citation": {
                "source": "初めてドストイェフスキイを讀んだ頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "疑ひだすと果しがないけれども、いつたい、彼にはどのやうな音樂理論があるのか、ヴアイオリニストとしてどれくらゐの腕前があるのか、作曲家としてはどんなものか、そんなことさへ私には一切わかつて居らぬのだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分を、ラスコリニコフのような気がした。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "事によっては、ヴァイオリニストにもまたトロンボニストにもなったかもしれない。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……私はあらゆるものから学んだ、ヴァイオリニストからも、唱歌者からも、器楽者からも。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八九五年にはトリニティ・ハウス（海事協会）の学術顧問に聘せられた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　大掃除の午後の路地の交互点、こわれたおもちゃに葱大根の尻尾、空瓶空ボールの交響楽、マルクス、ムッソリニの赤ん坊の夢を買わないか。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "またマヤコフスキーとレーニンとピリニヤーク、パステルナックの、新刊書で埋れた。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうことを、それはくどいほどに断ってあり、またドストエフスキイほどの、永遠の愛を追うて暮した男でさえ、その作品の主人公には、ラスコオリニコフとか、ドミトリイとかいう名前を与えて、決して、「私」を出さない。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ　アサカラ　ヨイテンキヤマヘ　ユキマス　シバカリニ　このお爺さんの楽しみは、お天気のよい日、腰に一瓢をさげて、剣山にのぼり、たきぎを拾ひ集める事である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "疑いだすと果しがないけれども、いったい、彼にはどのような音楽理論があるのか、ヴァイオリニストとしてどれくらいの腕前があるのか、作曲家としてはどんなものか、そんなことさえ私には一切わかって居らぬのだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ　アサカラ　ヨイテンキヤマヘ　ユキマス　シバカリニ　このお爺さんの樂しみは、お天氣のよい日、腰に一瓢をさげて、劍山にのぼり、たきぎを拾ひ集める事である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がニュウファウンドランドの、トリニテイの港に着きましたのは、恰度大祭の前々日でありました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲ハ経紙ノ紺ニ暮レ、　　　　　樹ハカグロナル山山ニ、梢螺鈿ノサマナシテ、　　　　　コトトフコロトナリニケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処か寂然として、瓢逸な街路便所や古塀の壁面にいつ誰が貼って行ったともしれないフラテリニ兄弟の喜劇座のビラなどが、少し捲れたビラじりを風に動かしていたりする。",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人はバルベリニ広場の「貝を吹くトリトン」を童話のようだと面白がった。",
              "citation": {
                "source": "噴水物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラスコリニコフが階段の途中でペンキ屋にどうかされたとかなんとかシロサキが言っている。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴雄はその本を放うり出すと、読みさしのドストエフスキイの「罪と罰」を机の上から取って、主人公のラスコリニコフが高利貸の老婆を殺す場面から、読んで行った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラスコリニコフとは何か。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その高利貸の老婆は、ラスコリニコフの意見では、もはや生きている必要のない虫けらの如き存在である。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラスコリニコフはこう考える。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "天才は彼が生きて行くためには、多数の虫けらを犠牲にしても構わないのだ」　ラスコリニコフは自分を天才に擬している。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラスコリニコフが現われた！",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　鶴雄はラスコリニコフの心理が自分なりに判るような気がして憑かれたように読んでいた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ラスコリニコフは老婆の顔をにらみつけながら、斧を振り上げた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その時ふっと自分から力が抜けてしまったのを、ラスコリニコフは感じた……。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ラスコリニコフには人が殺せなかったのだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴雄の眼はふとラスコリニコフのような虚ろな、しかし、激しい狂暴性に燃えていた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
