          "literary": [
            {
              "text": "でこの桝形へ兵を置けば、両街道から押し寄せて来る、敵の軍勢をささえることが出来た。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「両街道へ馬でやれ。",
              "citation": {
                "source": "柘榴",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左右兩街ともに、五十五坊と一市を有するから、京城内にすべて百十坊と二市を有する譯である。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            }
          ]
        }
