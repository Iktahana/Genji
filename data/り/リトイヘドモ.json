        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "否ザレバ鳥啼虫吟沾沾トシテ自ラ喜ビ佳処アリトイヘドモ辺幅固已ヨリ狭シ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今彼我ノ二書ヲ比較スルニ東武ノ詩人｜大沼枕山ノ事ニ関シテハ彼ハ我ニ比シテヤヤ簡略ナリトイヘドモ中京ノ詩人｜森春濤ノ事ニツキテハ遥ニ精緻ヲ極メタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然リトイヘドモ上人ノ寛懐｜固ヨリコレヲ罪セズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐宋諸賢ノ集中往往ニシテ粗笨冗長ナルガ如キ者アリトイヘドモ、ソノ実ハ句鍛ヘ字錬リ一語モ苟クセズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "夷カニコレヲ考フレバ則チ古器ハ雅ナリトイヘドモイマダ新器ノ時用ニ適シテシカモ便ニカツ利ナルニ若カザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレ君ガ緒余ナリトイヘドモ、マタ以テソノ博学ノ翁ニ淵源スルヲ見ルニ足レリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "名ハ集ナリトイヘドモ実ハ子ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然リトイヘドモ余コレヲ能クストイフニ非ラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
