        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "念ノタメ予ハ手洗イニ行ク振リヲシテ便所ニ入リ、便所カラ外ノ廊下ニ出、廊下カラ浴室ノ戸ヲ開ケテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「最モ痛イ時ヲ狙ッテ」ト云ッタガ、本当ニ痛イ時デナクテモイヽ、痛イ振リヲシテヤレバイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ノキャバレノ帰リガ遅カッタノデ寝足リナイノカ、話シカケラレルノガウルサイノデ寝タ振リヲシテイルノカ、ドッチダカ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イモ寄ラヌ秘密ヲ不意ニ彼女ニ発カレタヽメカ、自分デモ疾ウカラ内々ハ気ヅイテイテ、強イテ気ヅカヌ振リヲシテイタノニ、コノ古狸ニ突如素ッ破抜カレタヽメカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フト僕ハ、妻ハホントウニ寝テイルノデハナイ、タシカニ寝タフリヲシテイルノニ違イナイト思ワレテ来タ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "覚メタケレドモ事ノ意外ニ驚キ呆レ、アマリニ羞カシイ恰好ヲシテイルノデ、寝タフリヲシテ通ソウトシテイルノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子ガ部屋借リヲシテイル家ノ名前モ、ソレガ日本人ヲ夫ニ持ツ佛蘭西婦人ノ家デ、ソノ人ハ同志社大学ノ佛語教師デアルマデハ分ルガ、吉田牛ノ宮町トイウ名ガ出テ来ナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ豫想スルトコロデハ、妻ハコノ記事ヲ読ンデモ読マナイフリヲシテ、マスマス淫蕩ニナルデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシナヲ自分ノ日記ニ書イテイルカドウカ知ラナイガ、書イテイタトシテモ僕ガソレヲ読マナイデ（アルイハ読マナイフリヲシテ）イルヲ認メサセルタメニ敏子ヲ使ッタ？",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼女ノ性質カラ推シテ、果シテホントウニ睡ッテイタノカ寝タフリヲシテイタノカ、ソノ点ハ疑ワシイ」と夫が書いているあの二日間、私は決して「寝タフリヲシテイタ」のではないが、そうかといって完全に意識を失いつづけていたとは云いがたい。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
