          "literary": [
            {
              "text": "皆デ相談ノ結果、コウケチガ附イタ以上、誠ニ残念デアルケレドモ、兎ニ角コノ注射ハ一ト先ズ打チ切リニシタ方ガヨクハナイカト云ウコトニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ先ズ奈良アタリノ絵心ノアル佛工ニ命ジテ、今宮神社ノ四面佛ニ倣ッテ線彫リニシタ勢至菩薩ノ像ニ似タモノヲ描カセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「絶対ニ着物ニハ附ケナイ、朱墨ヲ塗ルノハ君ノ足ノ裏ダケダ」彼女ハ云ワレル通リニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
