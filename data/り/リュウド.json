        "examples": {
          "standard": [
            {
              "text": "画像データの粒度を細かく設定することで、より鮮明な印刷が可能になります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この研磨剤は粒度が均一なので、金属の表面を傷つけずに磨くことができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会議の議題の粒度が粗すぎて、具体的なアクションプランに落とし込めない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "かりゅうどたちは、沼のまわりを、ぐるりと取りまいていました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "たてがみを風になびかせ、やせこけた足をした馬、かりゅうどたちのむれ、馬に乗った紳士に、貴婦人、そういったものの、影でした。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりゅうどたちが、山の中で吹いている角笛のひびきも、聞えてきました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、頭に草が生えたとみたのは、かりゅうどの矢が首に当たる知らせで、背中に雪の積もったのは、殺されて塩漬けにされる知らせだというのです。",
              "citation": {
                "source": "夢占",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「海を渡ればきっと途中でかりゅうどに射られて、殺されるかも知れません。",
              "citation": {
                "source": "夢占",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとまったく占いのとおり、海を渡る途中かりゅうどに見つかって、牡鹿は首を射られて殺されました。",
              "citation": {
                "source": "夢占",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりゅうどは、子ざるを見つけると、足音をたてぬように、近寄りました。",
              "citation": {
                "source": "子ざると母ざる",
                "author": "母が子供に読んできかせてやる童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　かりゅうどは、腰につけていた、つなで、おとしを造りました。",
              "citation": {
                "source": "子ざると母ざる",
                "author": "母が子供に読んできかせてやる童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちおとしの中へ入って、はっと思うまに、子ざるは、かりゅうどの手に捕らえられてしまいました。",
              "citation": {
                "source": "子ざると母ざる",
                "author": "母が子供に読んできかせてやる童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりゅうどは、村へ帰ると、子ざるを家の前の木につないでおきました。",
              "citation": {
                "source": "子ざると母ざる",
                "author": "母が子供に読んできかせてやる童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、かりゅうどは、答えました。",
              "citation": {
                "source": "子ざると母ざる",
                "author": "母が子供に読んできかせてやる童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "山では、母ざるが、かりゅうどにつれられていった日から、夜も昼も子ざるのことを思って忘れる日がありませんでした。",
              "citation": {
                "source": "子ざると母ざる",
                "author": "母が子供に読んできかせてやる童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の上には、二ひきのさるの足跡と、ところどころに落ちた赤い血のあとが残っていましたが、神さまは、この親子をかわいそうに思われて、かりゅうどの追いかけてこぬようにと、夜明け方から、ひどい吹雪となさいました。",
              "citation": {
                "source": "子ざると母ざる",
                "author": "母が子供に読んできかせてやる童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "かわいそうなやつだなあ、おれについてこい、犬どもから逃げだす法をきさまにおしえてやる」　そのとき、かりゅうどが犬を四匹つれてやってきました。",
              "citation": {
                "source": "狐と猫",
                "author": "ヤーコップ、ウィルヘルム・グリム　Jacob u. Wilhelm Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとたんに、鳥たちは、きゅうにざわめきたって、「かりゅうどだ！",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "海の上には、かりゅうどのおおぜい乗っている小舟がずっと並んでいて、そこからダン、ダンと鉄砲をうっているのが見えます。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤッローは、もうだめだ、とは思いましたが、かりゅうどにつかまらないように、一生けんめい飛びました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシの山のうしろには、かりゅうどが、かくれているんだよ。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
