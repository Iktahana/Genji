          "literary": [
            {
              "text": "ソノトキ、ハルカ　トオク　ノ　ホウニ、ミドリ　ノ　ミズ　ガ、カギリナク　ヒロク　ツヅイタ　セカイ　ガ　ミエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "早々ニ条約締結ノ運ビ致スヨウ、諸事抜リナク御手配可然候。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆々様オカワリナクテ、ケッコウデスネ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "早朝六時、メキシコ国サリナクルスに着岸す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "サリナクルスより六百マイルを隔つ。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "」(1)第53図　トーマス・リナクル第54図　ジョン・キーズ（ラテン名カイウス、英国の医師）　中世のあいだ至る所で学問は神学の侍女であった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "リナクルはアルドゥス社（ヴェネツィア）のためにギリシャの著書を編集し、ガレノスの著書を翻訳し、オクスフォード大学でギリシア語を教え、ラテン語文法を書き、英国医師会を創設した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "当日の天候は「賤嶽合戦記」にも、――四月二十一日、辰ノ下刻ノ事ナルニ、一天曇リナク、照リニ照リタル空ナレバ、手負共、日ニ照リツケラレ、イト苦シガリケリ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
