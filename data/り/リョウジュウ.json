    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かくてゲーテは歴史に対し一面親和的に他面敵対的に、両重の関係に立つてゐたといふことが推察されよう。",
              "citation": {
                "source": "ゲーテに於ける自然と歴史",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "その顔触れの中には梨本宮をはじめとし、広田、平沼両重臣あり、その他財閥、軍閥、言論界の有力者あり。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "法令としてはもちろん江戸国許の両重臣の副署を必要とするが、このばあいは緊急措置の手段を執り、敦信の「上意」ということで押切ることになっていた。",
              "citation": {
                "source": "いさましい話",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
