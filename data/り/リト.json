  {
    "uuid": "b4ad3338-5121-57df-b6a0-ccaaabc699aa",
    "entry": "リト",
    "reading": {
      "primary": "りと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一丁ばかり先の練瓦建の家が、泳いでゐる緋鯉のやうに、ボンヤリトキ色に見える。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "すばらしいバリトン。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらはサンスクリトとしてはきわめて明白に、それぞれ全く異なる根幹から生じたものであるのに、音のほうではどこか共通なものがあり、同時に意味のほうにも共通なものがあるから全く不思議な事実である。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンスクリトの 〔la_ngala〕 は鋤であるがしかし錨のような意味もあるらしい。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語の vex はＬの uehere に関係し「運搬」の意がありサンスクリトの vah から来たとある。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンスクリトの krudhyati のｋをｈで置き換えるとともかくも hrdt という音列を得られる。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは前記のサンスクリトの「クシューラ」とよく似ている。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンスクリトの詩句にも色々の定型があるようであるが、十六綴音を一句とするものの連続が甚だ多いらしい。",
              "citation": {
                "source": "短歌の詩形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと申すが、まず庭口と思う処で、キリキリトーンと、余程その大轆轤の、刎釣瓶を汲上げますような音がいたす。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「メチレンブリューの代りに、青いリトマスを使って見たらどうですか。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」一人が立って、リトマス液を取りに行かうとして、私にぶっつかりました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのリトマスの反応を拝見したいものですが。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青いリトマス液が新らしいデックグラスに注がれました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く槍のやうな形の、するどい鱗粉が、青色リトマスで一帯に青く染まって、その中に中軸だけが暗赤色に見えたのです。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グルルル、グルウ、ユー、リトル、ラズカルズ、ユー、プレイ、トラウント、ビ、オッフ、ナウ、スカッド、アウヰイ、テゥ、スクール。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、けれど、ごらんなさい、そら、どうです、あの立派な川、ね、あすこはあの夏中、ツインクル、ツインクル、リトル、スター　をうたってやすむとき、いつも窓からぼんやり白く見えていたでしょう。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの立派な川、ね、あすこはあの夏中、ツヰンクル、ツヰンクル、リトル、スターをうたつてやすむとき、いつも窓からぼんやり白く見えてゐたでせう、あすこですよ。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グルルル、グルウ、ユー、リトル、ラズカルズ、ユー、プレイ、トラウント、ビ、オッフ、ナウ、スカッド、アウエイ、テゥ、スクール。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「えゝ、けれど、ごらんなさい、そら、どうです、あの立派な川、ね、あすこはあの夏中、ツヰンクル、ツヰンクル、リトル、スター　をうたってやすむとき、いつも窓からぼんやり白く見えてゐたでせう。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭日〔二〕宮沢賢治アナロナビクナビ睡たく桐咲きて峡に瘧のやまひつたはるナビクナビアリナリ赤き幡もちて草の峠を越ゆる母たちナリトナリアナロ御堂のうすあかり毘沙門像に味噌たてまつるアナロナビクナビ踏まるゝ天の邪鬼四方につゝどり鳴きどよむなり",
              "citation": {
                "source": "祭日〔二〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人はバルベリニ広場の「貝を吹くトリトン」を童話のようだと面白がった。",
              "citation": {
                "source": "噴水物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上にトリトンに牽かして行く貝殻型の車駕に御して海神が嘯いている。",
              "citation": {
                "source": "噴水物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "背の低い肥ったバリトン歌手のシニョル・サルヴィは大きな腹を突き出して、「ストロンボーリ、ストロンボーリ」とどなりながら甲板を忙しげに行ったり来たりしていた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後に私は友人｜安倍能成君の「西洋哲学史」を読んで、ロイキッポス、デモクリトス、エピクロスを経てルクレチウスに伝わった元子論の梗概や、その説の哲学的の意義、他学派に対する関係等について多少の概念を得る事ができた、と同時にこの元子説に対する科学者としての強い興味を刺激された。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この事がなかったら彼はおそらく十九世紀の科学者であり得なかったに相違ない、ところでデモクリトス、エピクロス、ルクレチウスはたしかにファラデーのような実験はしなかった。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "またどこまでがデモクリトス、エピクロスの説で、どこからがルクレチウスの独創によるか、そういう考証も私の柄ではない。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまさにこの点で彼が、彼の駁撃を加えているヘラクリトス、エンペドクレース、アナクサゴラスの輩をいかにはるかに凌駕しているかを見る事ができよう。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉体の元子と精神の元子とが一つずつ対になっているというデモクリトスの説は誤りである。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらくこれらの所説も、全部がロイキッポスやデモクリトスなどが創成したものではなくて、もっともっと古い昔からおぼろげな形で伝わり進化したものに根を引いているのであろうと想像される。",
              "citation": {
                "source": "量的と質的と統計的と",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "七味唐辛子を売り歩く男で、頭には高くとがった円錐形の帽子をかぶり、身にはまっかな唐人服をまとい、そうしてほとんど等身大の唐辛子の形をした張り抜きをひもで肩につるして小わきにかかえ、そうして「トーン、トーオン、トンガシノコ」と四拍子の簡単な旋律を少しぼやけた中空なバリトンで歌い歩くのがいた。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
