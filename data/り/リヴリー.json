          "standard": [],
          "literary": [
            {
              "text": "第三編　死者への約束の履行一　モンフェルメイュの飲料水問題　モンフェルメイュは、リヴリーとシェルとの間に位し、ウールクとマルヌ両河をへだてている高台の南端にある。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはリヴリーの方へ進んで行った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルーエットと男とはリヴリーの方へ行くのが見られたそうである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンフェルメイュを出て、リヴリーへ行く道が曲がってる所まで行くと、その先は高原の上に続いているのが遠くまで見渡される。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "男はコゼットを連れて、リヴリーとボンディーの方へ行った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
