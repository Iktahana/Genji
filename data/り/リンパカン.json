        "examples": {
          "standard": [
            {
              "text": "リンパ管は全身に網目状に張り巡らされており、リンパ液を節へと運ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "がん細胞がリンパ管を通って他の臓器へ転移することを、リンパ行性転移という。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "リンパ管の詰まりを解消することで、足の重だるさが改善された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "結局のところ、真に特異的で感染性の成分を持っている人痘粒子がリンパ管によって取り込まれ運ばれて変化せずに血管に至るのであろうか？",
              "citation": {
                "source": "イングランドの西部の諸州とくにグルスターシャーで見つかった病気で、牛痘の名で知られているウシ天然痘の原因および効果についての研究",
                "author": "AN INQUIRY INTO THE CAUSES AND EFFECTS OF THE VARIOLAE VACCINAE, A DISEASE DISCOVERED IN SOME OF THE WESTERN COUNTIES OF ENGLAND, PARTICULARLY GLOUCESTERSHIRE, AND KNOWN BY THE NAME OF THE COW POX.",
                "note": "青空文庫"
              }
            },
            {
              "text": "君達は、あのフィラリヤって言う寄生虫のために淋巴管が閉塞がれて、淋巴の欝積を来した場合だとか、或は又、一寸した傷口から連鎖状球菌の浸入に依って、浮腫性の病後に続発的に現れる象皮病――って奴を知ってるかい？",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            }
          ]
        }
