[
  {
    "uuid": "f47b78cb-1ee7-58a0-8e76-d9f96dc00713",
    "entry": "離婚",
    "reading": {
      "primary": "りこん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
