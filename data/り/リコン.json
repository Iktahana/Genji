  {
    "uuid": "9a422e53-b985-544d-9ec2-f090977be53a",
    "entry": "利根",
    "reading": {
      "primary": "りこん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "intelligence",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生まれつき利根に恵まれたその少女は、大人たちが何日も解けなかった難しいパズルをほんの数分で解いてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は若くして利根を発揮し、師匠の教えをスポンジのように吸収してあっという間に免許皆伝の腕前になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "商人の息子は天性の利根を活かし、落ちぶれていた家業をわずか数年で地域一番の豪商へと立て直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "便なき幼兒のうたへる歌萩原朔太郎うすらさびしき我が身こそ利根の河原の石ひろひひとり岸邊をさまよひて今日も小石をひろふほど七つ八つとなりにけり",
              "citation": {
                "source": "便なき幼兒のうたへる歌",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まひる利根川のほとりを歩めば、二人歩めばしばなくつぐみ、つぐみの鳴くに感じたるわが友のしんじつは尚深けれども、いまもわが身の身うちよりもえいづる、永日の嘆きはいやさらにときがたし、まことに故郷の春はさびしく、ここらへて山際の雪消ゆるを見ず。",
              "citation": {
                "source": "利根川の岸邊より",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等利根川の岸邊に立てば、さらさらと洋紙は水にすべり落ち、いろあかき魚のひとむれ、しねりつつ友が手に泳ぐを見たり。",
              "citation": {
                "source": "利根川の岸邊より",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここは利根川、その氾濫のながめいちじるく、青空に桑の葉光り、さんらんとして遠き山里に愁をひたす、あはれ、あはれ、われの故郷にあなれば、この眺望のいたましさ。",
              "citation": {
                "source": "厩",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬を待つひと萩原朔太郎こほれる利根のみなかみに、ひねもす銀の針を垂れ、しづかに水に針を垂れ、さしぐみきたる冬を待つ。",
              "citation": {
                "source": "冬を待つひと",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかんぞ故郷に獨り歸りさびしくまた利根川の岸に立たんや。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "監獄裏の林　　前橋監獄は、利根川に望む崖上にあり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我れ少年の日は、常に麥笛を鳴らして此所を過ぎ、長き煉瓦の塀を※りて、果なき憂愁にさびしみしが、崖を下りて河原に立てば、冬枯れの木立の中に、悲しき懲役の人人、看守に引かれて石を運び、利根川の淺き川瀬を速くせり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根の鉄橋を越えて行くに夏｜蕎麦をつくる畑｜干瓢をつくる畑などあれば埼玉や古河のあたりの夏蕎麥のなつみこめやもおほに思はゞ麥わらをしける廣畑瓜の畑葉かげに瓜のこゝたく見ゆるなど口ずさむ。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "崖の上になってるので、利根川は勿論中川までもかすかに見え、武蔵一えんが見渡される。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はつとめて自分の感情をおしかくし、君の下宿してゐる利根川の岸の家を訪ねた。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その低い砂山の蔭には利根川がながれてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根川の河原の砂の上に坐つて懺悔をする。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根川はぬすびとのやうにこつそりと流れてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はときをり寺院の脚高な縁側から国境山脈をゆめのやうに眺めながら此の友のゐる上野国や能く詩にかかれる利根川の堤防なぞを懐しく考へるやうになつたのである。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私どもは利根川の堤を松並木のおしまひに建つた旅館まで俥にのつた。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅館は利根川の上流の、市街はづれの静かな磧に向つて建てられてゐた。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの利根川のほとりで土筆やたんぽぽ又は匂ひ高い叙情小曲なぞをかいた此れが紅顔の彼の詩であらうか。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○新川はあたかもこの川に接続するものの如く中川より東南に入るの流なるをもて、なほ東して遠く去れば、利根の分流たる江戸川の妙見島上流に出づ。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸川はこれを溯つて利根の本流に出づべく、利根川はこれを下つて銚子に至るべし。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "川続きであるから多く利根の方から隅田川へ入り込んで来る、意外に遠い北や東の国のものである。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も中川となると夜は淋しい、利根は猶お更のことだ。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車、利根川の鉄橋に差し掛かれば、雨はますます激しく、ただ見る、河水は氾濫して両岸湖水のごとく、濁流｜滔々田畑を荒し回り、今にも押流されそうな人家も数軒見える。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの利根川圖志の中に、……えゝと――安政二年乙卯十月、江戸には地震の騷ぎありて心靜かならず、訪來る人も稀なれば、なか／＼に暇ある心地して云々と……吾が本所の崩れたる家を後に見て、深川高橋の東、海邊大工町なるサイカチといふ處より小名木川に舟うけて……」「また、地震かい。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀子の父親はちょうどそのころ、田舎に婚礼があり帰っていたが、またしても利根の河原で馬を駆り、石に躓いて馬が前骨から頬へかけて、肉が爛れ血塗れになっていた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根川に近き田舍の小都市にて　　著者凡例一。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "榛名富士その絶頂を光らしめとがれる松を光らしめ峰に粉雪けぶる日も松に花鳥をつけしめよふるさとの山｜遠遠にくろずむごとく凍る日に天景をさへぬきんでて利根川の上に光らしめ祈るがごとく光らしめ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西暦一九二四年春利根川に近き田舍の小都市にて著者出版に際して　昨年の春、この詩集の稿をまとめてから、まる一年たつた今日、漸く出版する運びになつた。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この暴風雨がいつまでつづくか解らぬ、それよりも、差し当りこんなところに、今夜野宿が出来るか、否かが疑問である、思い切って谷へ下りようか、谷へ下りれば、この旅行の中止を意味することになる、一行は思い悩んで決し兼ねた……何だか筋骨を抜かれたように、気落がして、私も眼が重くなった。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんなところが登れようかね」と、岩壁の白い薙を指しながら、話の緒を引き出したところが、あすこは嘉門次が、つい去年、山葵取りに入りこんで、始めて登ったところで、未だ誰もその外に、入ったものはないと言うので、私はふと聞き耳を立てた。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
