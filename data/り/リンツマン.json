          "literary": [
            {
              "text": "ここはいつもリンツマンの檀那の通る所である。",
              "citation": {
                "source": "破落戸の昇天",
                "author": "モルナール・フェレンツ　Molnar Ferenc",
                "note": "青空文庫"
              }
            },
            {
              "text": "リンツマンの檀那と云うのは鞣皮製造所の会計主任で、毎週土曜日には職人にやる給料を持ってここを通るのである。",
              "citation": {
                "source": "破落戸の昇天",
                "author": "モルナール・フェレンツ　Molnar Ferenc",
                "note": "青空文庫"
              }
            },
            {
              "text": "リンツマンの檀那はもう疾っくに金を製造所へ持って往って、職人に払ってしまっている。",
              "citation": {
                "source": "破落戸の昇天",
                "author": "モルナール・フェレンツ　Molnar Ferenc",
                "note": "青空文庫"
