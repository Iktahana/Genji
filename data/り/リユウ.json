[
  {
    "uuid": "c9d59d2c-a4a6-52f3-b521-5c2191eba505",
    "entry": "理由",
    "reading": {
      "primary": "りゆう",
      "alternatives": [
        "わけ"
      ],
      "is_heteronym": false
    },
    "grammar": {
