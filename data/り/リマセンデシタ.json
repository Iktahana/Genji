            {
              "text": "答　ソノ時探シタノデスガ何モアリマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ時自分ノ危険ヲ考エテオリマセンデシタガ然シモシ誰カ来タラ自分ハ道子ヲ一思イニ殺シテ自殺スル気デシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ奥様モ夢中デ云ッタヨウデハアリマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "交番ニユキマスト、カワイラシイ女ノ子ノオマワリサンガヰテ、帳面ヲシラベテクレマシタガ、サツパリ玉ネギサンノスンデヰル村トイフノガ分リマセンデシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、ミツカリマセンデシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクル朝、人参サンガ起キタ時ハ　六ジニ少シシカ間ガアリマセンデシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヒハ　カン　カン　ト、マウヘカラテツテ、アツクテ　タマリマセンデシタガ、ジヨン　ト　チビスケハ　カケツコシテ　ノハラニ　ユキマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラ　オホキク　フンバツテモ、チイサナ　カゲハ　オホキク　ナリマセンデシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタ　メガサメテミルト、オホソウヂハ　モウドコヘイツタカ　カゲモカタチモアリマセンデシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタニナツテ　メガサメマシタガ、ドツチガ、サキニネムツタノカ　フタリトモ　ワカリマセンデシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「久シュウオ目ニカヽリマセンデシタガ、相変ラズオ元気デイラッシャイマスナ」「ナアニ、チットモ元気ナコトナンカナイヨ、今度ハ京都ヘ自分ノ墓地ヲ捜シニ来マシタ、イツ死ンデモイヽヨウニネ」「御冗談デショウ、ソノ勢イジャアマダ／＼大丈夫デイラッシャイマスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆ソレデ船内ニ隠レテイマシタノデ、何ニモ知リマセンデシタ」「他に怪しい船は見なかったか？",
              "citation": {
                "source": "流血船西へ行く",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
