        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "国籍不明の潜水艦が、我が国の領水に侵入したとの報道があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "海上保安庁の巡視船が、日本の領水を侵犯した漁船に対して警告を発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "この海域は歴史的に複雑な背景を持ち、二国間で領水をめぐる対立が続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "「連合国は、日本および日本の領水の上に、日本人民の、十分の主権を、承認する。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
