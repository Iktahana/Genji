    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "地は三ッ堀に属し、鬼怒川の利根川に入り、両水衝撃滾混して流るゝの処たり。",
              "citation": {
                "source": "水",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹見と丸本の両水夫は、甲板にうつぶせになって生きた心地はない。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "内田、斎藤、両水泳選手は、アントワープのオリムピックに於て、自由形を片抜手で泳いだ。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャーマンはグンナルソン及びラーセンの両水夫と共に七時三十分に離陸、途中数ヶ所から平穏な飛行状況を伝えてきた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは泗水河と沂水河に堰を作って、両水をひとつに向け、下※の孤城を水びたしにしてしまうことだった。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
