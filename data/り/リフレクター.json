        "examples": {
          "standard": [
            {
              "text": "夜間に自転車で走る時は、安全のために必ずペダルや車体のリフレクターが機能しているか確認する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "冬物のジャケットの背中にリフレクター素材が縫い付けられており、車のライトを反射して光る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "スタジオでのポートレート撮影で、モデルの顔に柔らかい光を当てるためにレフ板（リフレクター）を用いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "なぜなら光線の乏しい屋内では、あれがレフレクターの役目をしたに違いないから。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
