        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小さいリードチカはきゃっと叫んで、ポーレンカにとびかかり、姉にひしとしがみついて、全身をわなわな震わした。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて彼の視線は、片隅で発作でも起こしたように震えながら、子供らしく見張ったびっくりしたような目でじっと父を見つめている小さいリードチカ（彼の秘蔵っ子）の上に止まった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチェリーナはリードチカの手を取り、男の子を椅子からおろして、片隅の暖炉の方へ引っ込み、そこにうやうやしく膝をついた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お父さんはリードチカを一ばん可愛いがってたわ」と彼女は大まじめに、にこりともしないで、もうすっかり大人口調でことばを続けた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "だけどコーリャとリードチカは、お母さんと一緒に声を出して唱えるわ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
