          "literary": [
            {
              "text": "「まさかお父さんも羅両峯の画がお芳にわかるとも思っていないんでしょうが。",
              "citation": {
                "source": "玄鶴山房",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "両峯は冬心の御弟子だから、あの鬼趣図のプロトタイプも、こんな所にあるのかも知れない。",
              "citation": {
                "source": "支那の画",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "両峯の化け物は写真版によると、妙に無気味な所があつた。",
              "citation": {
                "source": "支那の画",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝夕の出船入船、落ち込む客の全盛は、花の晨雪の夕、十六島はいふも更なり、香取、鹿島、息栖、銚子の浦々まで一望に浮び、富士、筑波の兩峯は西南に連なり、眺望世にすぐれたる好境也』と。",
              "citation": {
                "source": "北總の十六島",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
