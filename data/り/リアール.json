          "literary": [
            {
              "text": "大きな家、上流階級、テナルディエの飲食店もそのうちにはいるのであるが、それらの家では一桶について一リアールずつで水を買っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥミ・リアール、別名ドゥー・ミルアール。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちパンショー一名プランタニエ一名ビグルナイユとドゥミ・リアール一名ドゥー・ミリアールとであって、ふたりとも審理の上十年の徒刑に処せられた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
