[
  {
    "uuid": "450c92ca-32ac-5adb-9613-80b7611c81c3",
    "entry": "臨写",
    "reading": {
      "primary": "りんしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "copying",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は書道の練習として古典の臨写を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "臨写を通じて、偉大な画家の技法を学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この絵は有名な作品の臨写である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "沢田東江の唐詩選を臨写す。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "余両三年来折々沢田東江の書帖を臨写すれど今に至つて甚悪筆なり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "うまいぞ、うまいぞ、鈴蘭なんかまるでパリパリだ」　風が来たので鈴蘭は、葉や花を互いにぶっつけて、しゃりんしゃりんと鳴りました。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども実をとられた鈴蘭は、もう前のようにしゃりんしゃりんと葉を鳴らしませんでした。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つるつるしゃん、つてしゃんりんしゃん、それお腰、やりなおし、そら御手」　腰を上手に折れば、五本の指がすきまだらけになり、目付を上手にすれば、口がぽかんとあく。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "むっとした文次、往来の上下を睨めまわすと、屋敷町の片側通りだ、御府内といえ、一つ二つ横町へそれたばかりなのにもうこの静けさ、庫裡のように寂寞としたなかに、八つ下がりの陽ざしがやけにかんかん照り返って、どの家からともなく、美しい主をしのばせぶりに、ころりんしゃん、かすかに琴の音がもれている――。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
