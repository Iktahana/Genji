      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "good medicine",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "風邪の引き始めには、温かい生姜湯とたっぷりの睡眠こそが一番の良薬だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "失敗から得た教訓は、その後の人生において何物にも代えがたい良薬となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "こんなに苦い粉薬だけど、お医者さんが特製で調合してくれた良薬だから頑張って飲んで。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "新らしき食客は、暖かき褥に臥し、良薬を賜わりて、疾病直ちに癒えたり。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "四日、己亥、晴、将軍家聊か御病悩、諸人奔走す、但し殊なる御事無し、是若し去夜御淵酔の余気か、爰に葉上僧正御加持に候するの処、此事を聞き、良薬と称して、本寺より茶一盞を召進ず、而して一巻の書を相副へ、之を献ぜしむ、茶徳を誉むる所の書なり、将軍家御感悦に及ぶと云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "良薬は口に苦けれど病をば癒すべし。",
              "citation": {
                "source": "東西伊呂波短歌評釈",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "良薬の苦味、おゆるし下さい。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たちまち丹造の欲がふくれて、肺病特効薬のほか胃散、痔の薬、脚気良薬、花柳病特効薬、目薬など、あらゆる種類の薬の製造を思い立った。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "下戸は知ったが、唯一の良薬と、沸燗の茶碗酒。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「長十郎お願いがござりまする」「なんじゃ」「ご病気はいかにもご重体のようにはお見受け申しまするが、神仏の加護良薬の功験で、一日も早うご全快遊ばすようにと、祈願いたしておりまする。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてマルコの書をユールが注して、これはの胆が小｜瘡や眼腫に無比の良薬だといったと言うたは甚だ物足らぬ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには良薬が家にあるから、後から取りに来るがいゝ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦労しなさい、苦労は薬だ、毒薬だ、良薬だ、私はさん／″＼苦労をつゞけてゐる、毎日毎日、手紙を書いては出してゐる、通信費が嵩むには閉口する、うれしい悲鳴だけれど。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵隊さんよ、あゝ、私は――たわごとそらごと、まことあるなし、――脱皮作用、酔ふぱらふごとに一皮脱ぐことは――一皮脱げることは事実である、酒は毒薬でもあり良薬でもある！",
              "citation": {
                "source": "一草庵日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に南無釈迦牟尼仏とか、病之良薬とかいふのが僅かに読める。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、その種はある神秘な力があって、彼の固疾にはなくてはならない良薬なのだし、それを今持運んでいるということが、かぎりない慰を与えてくれるとともに、何ともいえない不安な気持をそそる。",
              "citation": {
                "source": "冬日記",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日の繁栄は今日の没落、本条純八は暫くの間は夢｜現の境に彷徨したが、此の著しい変転は却って彼には良薬となり、俄然精神が一変し、現世の悦楽を求むる代りに、虚無融通の神仙道に、憧憬の心を運ぶようになった。",
              "citation": {
                "source": "高島異誌",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の友達は心に良薬、口に毒薬で、なかなかシゲキして貰える。",
              "citation": {
                "source": "生活",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間或は説あり、父母の教訓は子供の為めに良薬の如し、苟も其教の趣意にして美なれば、女子の方に重くして男子の方を次ぎにするも、其辺は問う可き限りに非ずと言う者あれども、大なる誤なり。",
              "citation": {
                "source": "女大学評論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に其分量を誤るときは良薬も却て害を為す可し。",
              "citation": {
                "source": "女大学評論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "良薬にも過量があるから、効くからといって、無闇に量を多くのんだところで、かえって害になる。",
              "citation": {
                "source": "瀞",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十八「さあ、いいかね、これから思いきったところをズバズバ言うよ、腹あ立っちゃいけねえよ、良薬は口に苦しといってね、いい医者ほど苦い薬を飲ませるんだぜ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "畜生谷の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "良薬は口に苦しということですから、見て身ぶるいするほどいやな草なればこそ、薬としての効能が強いものか。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、ハンナにとっては、はたらくということが、たいていの心配ごとをなおす良薬でありました。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はここに良薬を持っている。",
              "citation": {
                "source": "村の兄弟",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に、男はまた苦心して、目の良薬を探しました。",
              "citation": {
                "source": "木と鳥になった姉妹",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、良薬をもらって、その考えが変わりました。",
              "citation": {
                "source": "手風琴",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしこの患者に、良薬は口に苦し、とかなんとか言って、せんぶりを飲ませたらどうなるだろう？",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛔虫良薬と書いてある。",
              "citation": {
                "source": "AU MAGASIN DE NOUVEAUTES",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれでも充分役に立つので、九九パーセント効く薬ならば、それは良薬として推奨しなければならない。",
              "citation": {
                "source": "科学の限界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "火風水土の四厄を凌いで育った米の精は強大で、たいていの病人は良薬ほどにも効いた。",
              "citation": {
                "source": "藤九郎の島",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間は口癖のように良薬口に苦しと言って風邪などをひくと、顔をしかめて変なものを飲む。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
