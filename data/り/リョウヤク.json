[
  {
    "uuid": "5435543e-39af-5283-aee0-df5ac10bf33d",
    "entry": "良薬",
    "reading": {
      "primary": "りょうやく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
