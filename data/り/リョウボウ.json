  {
    "uuid": "27e8a1e9-2095-5618-8d55-9073bf5b9a6c",
    "entry": "両傍",
    "reading": {
      "primary": "りょうぼう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
