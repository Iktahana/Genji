        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あなたの奥さまを押しのけるなど、それはあさましい暴力みたいで、私はいやなんです。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "將棋では何｜糞つと力み返つて遠慮なしに負かしたり負かされたりする事既に五六年にもならうか？",
              "citation": {
                "source": "下手の横好き",
                "author": "―將棋いろいろ―",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜十郎旦那が許で、ふっくりと入れさっしゃる綿の初穂へ、その酒浸しの怪物さ、押ころばしては相成んねえ、柔々積方も直さっしゃい、と利かぬ手の拳を握って、一力味力みましけ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "色白く、鼻筋通り、眉に力みありて、眼色にいくぶんのすごみを帯び、見るだに涼しき美人なり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "物足りなく思ふもう一つは主人公の氣持が純眞ではあるが、その力み方に少し誇張したところが感じられることである。",
              "citation": {
                "source": "『新潮』十月新人號小説評",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供は烏賊鮨を喰べていたその冒険のさなか、詰めていた息のようなものを、はっ、として顔の力みを解いた。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は苦労した年嵩の男性の威を力み出すようにして「お入りなさい。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分で力み出す力には、自ずと限度があります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しょっちゅう何糞と力みかえりながら、どこかの隅に突っ立って眼を光らせていたのである。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しっかり力みなはれや。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤くなつて力みながら、最後に自分で咳込みをふつ切らうとするもののやうに、ガーツと大きく咳拂ひをしてやめる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ややうつむき加減にして、ぐつと力を入れると、顏に力みが來て、眼に血が寄り、顳※がぷくつとふくれる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "顏を眞赤にして力みながら叫んだ。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と伯父は力み返って、『メアリに言いつけろい。",
              "citation": {
                "source": "橙の種五粒",
                "author": "THE FIVE ORANGE PIPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は力みかえって帽子をうんと掴みました。",
              "citation": {
                "source": "僕の帽子のお話",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空力みでは何にもならないのだ。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "陪臣共の百人千人、いか程力み返って見たところで、手の出しようがないのです。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつも中でなにかまごまごしているな」　はいってみると、うなぎの寝床のような長いお組屋敷のいちばん奥の一軒の前に、小腰をかがめて必死に力み返っている男があるのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を力み返ってにらめっこしているんだ」「女、女！",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こととしだいによったら、与力次席の重職にある坂上与一郎といえどもその分にはすておかぬというような力みかたで――。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "剛情｜我儘の佐久間は怒って、「戦わずして崩れるのを、武田家では見崩と称して大いに笑うものだ」と力み返った。",
              "citation": {
                "source": "長篠合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と力み出すと、一人は、胡座をかいた股の間へ手焙りを擁へ込んで、それでも足らずにぢり／＼と蹂り出しながら、「さうぢや。",
              "citation": {
                "source": "我等の一團と彼",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、父さん、そう力みなさんなよ。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "また力み返って歩むを指す動詞にも雄鶏の名そのままコックというのがある。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな性慾の刺戟をダンダン感じなくなって、唯、疲れ切った神経の端々に、一種の惰力みたように浮出して来る女の屍体の幻覚に釣られながら、喘ぎ喘ぎ鍬を動かすというミジメな状態に陥っている。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」彼は急に大きな声を出して、力み始めた。",
              "citation": {
                "source": "熱海へ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "唇をギユツとかんで、顏を眞赤にして力みながら、鬪牛のやうに首を少しまげて、それを繰り返した。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かきっと悪戯をしているんだ」少年勇敢に力みながら少年「人の真似をするのは失敬だぞ！",
              "citation": {
                "source": "春",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ餡パンを啣えた宿の小さな子供が出て来て、手橇の柄を掴み、それを動かしてみようとしてうんうんと力み出した。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
