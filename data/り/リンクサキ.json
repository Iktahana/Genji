          "literary": [
            {
              "text": "リンク先の状況を確認し、新しいリンク先を求め、変化に対応しなければ、すぐに老いてしまう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これなら、リンク先の変化に、比較的素早く対応できる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "インターネットとリンクさせるという道を選んだ以上、定期的にリンク先の状況を確認して、ＵＲＬを更新することが必要です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
