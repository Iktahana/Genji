        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "田んぼの周りには、カエルやイモリといった多くの両生類が生息している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "環境汚染は、皮膚がデリケートな両生類の生存を脅かす深刻な問題となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は子供の頃から両生類が大好きで、家の水槽でウーパールーパーを飼っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "それから日本の動物分布図に載つてゐる、さまざまの両生類と、爬蟲類と、鳥類と、哺乳類とを見た。",
              "citation": {
                "source": "鳥獣剥製所",
                "author": "一報告書",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らが仄めかすには、三億年前、人類の元となる最初の両生類が熱い海から這い出しもしないうちから、信じ難い姿のものが天に届く塔を建て、自然のあらゆる秘密を掘り下げたというのだ。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "軟体動物、甲殻類、魚類、両生類、爬虫類、鳥類、及び初期の哺乳類だ――大きいのも小さいのも、既知のも未知のも。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の顔を見るなり、「なんだ、こないだの一物は、あれは両棲類中の有尾類。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学の教えるところによると、この地球にはじめて声を持つ生物が産まれたのは石炭紀の両棲類だということである。",
              "citation": {
                "source": "交尾",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人類の、両棲類ともいう沼底棲息人――。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にはその魚の前後の鰭を四足に変化さして匐いまわる水陸両棲類の姿にかわる。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな魚のようでもあり、そうでなく両棲類か爬虫頚のようでもある。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚と両棲類の合の子としか見えなかった。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは鰐と蜥蜴と蛙だ」「爬蟲類と両棲類ですね」「うん、もう一つ、牛が割合に耐えたよ。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうものとしてさしあたり、亀、蝦蟇、蝦、蟹……水陸両棲類におちつく。",
              "citation": {
                "source": "夢の図",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "人類以前に地球上に全盛を極めて居た動物の例を挙げれば、古生代に於ける魚類、両棲類、中生代に於ける爬虫類、第三期に於ける獣類などである。",
              "citation": {
                "source": "人類の将来",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明らかにこれは両棲類であり、恐らく空気の無い状態での長期の休眠に適応していた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
