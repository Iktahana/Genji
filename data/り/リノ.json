        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ポール・ヴァレリーの『ユーパリノスあるいは建築家』のうちで、メガラ生れの建築家ユーパリノスは次のようにいっている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "リノリュームが膏薬のように床板の上へ所々へ貼りついていた。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その相手の交換手はイリノイ州出の女であったが、非常に優しい声で可憐な返答をしたその声が妙に紳士の心を動かし、それが縁となってとうとう目出度く結婚する事となった。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　二千年前に電波通信法があった話　欧洲大戦の正に酣なる頃、アメリカのイリノイス大学の先生方が寄り集まって古代ギリシアの兵法書の翻訳を始めた。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　しかし、彼女は青磁のリノリウムに花の浮いた波浪をつくると、突然、佗しさを堪えた悲しみの堰がこわれるのだ。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "皺だらけの私の寝室をノックする音がして、暗闇から出た女の手が、楕円形の天井をみつめていた私の目前で葡萄蔓のようにからんで、青いリノリウムのうえにMELINSの扱帯が夜光虫のように円をつくると、私は断截された濡れた頭髪を腕の中に感じて、いつのまにか恋愛のマッフのなかに、ひとときの安息を求めた。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一面識ナキ小生ヨリノ失礼ナル手紙御読了｜被下度候。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ酔ひの勇気がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ醉ひの勇氣がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "年若くして逝つたものの傳説が、夭折者のまはりをとりかこむ人言が、彼等を覆ひかくすほどの長い歎きが、彼等を呼びかへさうとする聲、自然のなかにまで彼等を求めてやまない古代的な叫びが、――その歌のなかに彼等は一しよに入れられながら、互の姿を見ることのないあのリノス挽歌が。",
              "citation": {
                "source": "モオリス・ド・ゲラン",
                "author": "「そしてこの稀有で、偉大で、しかも果敢ないもの、一個の詩人」",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅緑のリノリュームが、室の二方を張った硝子窓から射し入る初夏近い日光を吸っている。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとを赫鬚をはやしたこわい顔の男がおもちゃの熊を片手にぶら下げてノソリノソリついて歩く。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥海山はトリノウミと言ったらしい形跡があるので、これも入れるとするとＲはさらに四分の五倍だけに増すわけである。",
              "citation": {
                "source": "火山の名について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの、（リノキ、チツキテビー）よ。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九六七年の夏、フレックスに関する報告を行うためにイリノイ大学で開かれた会議に出たケイは、ここで初めてプラズマ方式を用いて作った平面型のディスプレイを見た。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっかけは、彼がイリノイ大学の材料研究所に設置された大型コンピューターの、オペレーターになったことでした。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時イリノイ大学はすでに、インターネットのルーツとなるネットワークに連なっていました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七一年のスタート時点から、プロジェクトはイリノイ大学のコンピューターを根城にしてきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "待合せていた例の少女の姿を見た時から、モウ様子を売りだして、ノソリノソリと大股にあるいて傍へ寄りて、立ち止ッて、肩をゆすッて、両手を外套のかくしへ押し入れて、気のなさそうな眼を走らしてジロリと少女の顔を見流して、そして下にいた。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉の開く音が聞こえ、早口の言葉と、そのあとリノリウムの床をせかせかと歩く音。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イリノイにこの地をお作りになって、ミズーリもお作りになったのね。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々はイリノイの地にあるノーヴーからやって来ました。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
