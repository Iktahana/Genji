          "literary": [
            {
              "text": "之ハ見タワケデハアリマセンガ、確ニ私ハソレヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンガ何故殺害サレタカ分リマセンガ、其ノ殺害ヲ一番早ク云イ当テタノハ動坂三郎氏デス。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアこれは一寸耳をこちらへ出して、ソコイラノ評論ヲ評論ト云イ得ルトハ思ッテ居リマセンガ、私ニハホントノ評論ヤソノ骨格ガワカッテイルカラケンソンスルノデス。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダサウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダソウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本帝国　東京　大関久五郎　地理学を修むる者　此宿ノ人ノ話ニ拠レバ、コレ迄吾日本帝国民ニシテコヽニ泊ッテ Jungfrau ニ登ツタ人ハ無イトノコトデス、本当カウソカハ私ハ知リマセンガ、兎ニ角コヽニ吾邦人ニシテコノ後コヽニ来リ宿ル方ニ対シ御免ヲ蒙ツテ私ノ名ヲ日本語デ書イテ置キマス。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、皆サンゴゾンジナイカモ分リマセンガ、ジヤガイモサンハ大ヘンナオ寝坊サンデシタカラ、人参サンニゴツンゴツンタタカレテモ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツデモ来ルガイヽ」「有難ウ存ジマス、オ言葉ニ甘エテコレカラチョク／＼伺イマス、毎日ト云ウ訳ニモ参リマセンガ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネエオ爺チャン、颯子ガソンナモノヲ持ッテタ筈ハアリマセンガ、………」婆サンノ追及ハコヽヘ来テ俄ニ急デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当分オ目ニ懸リマセンガ、イズレアナタガ新夫人トナラレタ暁ニ改メテ拝顔ノ機会ノアルコトヲ望ミマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
