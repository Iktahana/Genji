        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「クエーカー」宗ノ價値ハ天理教ヨリ遙カニ以下ニシテ「リンガム」禮拜ヨリ聊カ以上ナル程度ノ者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……その運命の神様と申しまするのは、竈の神、不浄場の神、湯殿の神、三ツ角の神、四つ辻の神、火の山の神、タコの木の神、泥海の神、または太陽の神、月の神、星の神、リンガムの神、ヨニの神々のいずれにも増して大きな、神々の中の大神様で御座いまする。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸の風景を一望せんと欲し、車行してブライトンビーチおよびサンドリンガムに至る。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "著者はバーリンガム。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラモアナ・ショッピング・センターのある場所は、ディリンガムが所有するただの野原だった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのディリンガムなのか、そこまでは僕は記憶していない。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのディリンガムでも、結局はおなじことだろう。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカ海軍および空軍の海洋観測船や気象観測機から、ディリンガム空軍基地や真珠湾に向けて発信されている、さまざまな気象情報だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨晩のシェリンガムの舞踏会はどうでしたかと尋ねた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガムと申します。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム氏は偉大な肖像画家で、名声やら姿をよく知っている。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューバート医師は車寄せを歩いて行き、刈りこんだ芝生を通り、フィリンガム夫人の腕を抱え、正面扉から中にはいった。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死んでませんか」　と尋ねるフィリンガム夫人の声は消え入りそう。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム氏はまだ息がある。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム画家で、私の近くに住んでいます。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は私の用法に従い、第一段階を行い、フィリンガム氏を治療した。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は家に帰って寝なさい」　　　　　＊　フィリンガム夫人はヒューバート医師と一緒にアトリエにいた。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旦那さんは体が丈夫ですから」　フィリンガム夫人が応えて、「主人は最近働き過ぎでした。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "間違いなくジフテリアの仲間だが、血中の毒が悪さをする」　　　　　＊　やがてフィリンガム夫人と別れた後、レイブル博士はヒューバート医師を連れだした。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "博識のレイブル博士が指摘した事実、これら全てが前夜フィリンガム氏の粘液にあった。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム氏を看病中の看護婦だ。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム氏と同じ症例を二件かかえて、途方に暮れておられます」　ヒューバート医師は帽子と電気針をひっつかんですぐ出発した。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "今回はデヴォンシャイア公園の豪邸に住む子供が二人、まさにフィリンガム氏と同じ苦しみにあえいでいた。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　午後二時過ぎになり、ヒューバート医師はやっと再びフィリンガム家に立ち寄った。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトリエに突っ立ってフィリンガム夫人を待った。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリンガム夫人が尋ねた。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣装が無いですね」　フィリンガム夫人が物憂げに答えた。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてフィリンガム家で、レイブル博士がヒューバート医師に合流した。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇帝陛下は昨日フィリンガム画家とここにおられました。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
