        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私は休暇中の自分の予定が、まだ三分の一も出来てゐないことでヂリヂリしてゐた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらオリヂナルの人でもイミテーションの分子を何処かに持っている。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなオリヂナルの人でも、人から切り離されて、自分から切り離して、自身で新しい道を行ける人は一人もありません。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらオリヂナルの人でも前に外の絵を見ておらなかったならば、あれだけのヒントを得ることは出来なかったと思う。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "またオリヂナルの方が早く自然に滅亡するか、イミテーションの方が先に滅亡するかであって、大した違いはない。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし考えるとそう真似ばかりしておらないで、自分から本式のオリヂナル、本式のインデペンデントになるべき時期はもう来ても宜しい。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "日露戦争というものは甚だオリヂナルなものであります。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分でそれほどのオリヂナリテーを持っていながら、自分のオリヂナリテーを知らずに、あくまでもどうも西洋は偉い偉いと言わなくても、もう少しインデペンデントになって、西洋をやっつけるまでには行かないまでも、少しはイミテーションをそうしないようにしたい。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタバカリヂヤ　アリマセン。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが神泉フワンは、この神泉といふ作家が、これらのフワン達をヂリヂリさせるといふ特長をもつてゐる。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨年の震火災のあと、プロ階級の江戸ッ子はチリヂリバラバラになった。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あたし、ヂリヂリしてしまふわ。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論この忙がしい都会の制度に当てはまるように直して行くこと、例えば百姓がチリヂリ、バラバラに仕事をすると、どうしたってヒドイ目に会うから、まア協同組合、協同耕作、協同経営そんなものでも作って、中に入る猾るい商人に儲けさせない方法もある、然しそれも程度もので、ウマク行く筈がない。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "チリヂリバラバラに成った鳥は、思い思いの軒を指して飛んだ。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヂリヂリヂリとどこか家の奥の方で音がしました。",
              "citation": {
                "source": "都の眼",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで大きな一つ眼がぎらっと光ったかと思うと、頭の上でヂリヂリヂリと、舶来の半鐘のような音がしました。",
              "citation": {
                "source": "都の眼",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただその、眼が、眼がそのヂリヂリヂリっと言ったでがすよ」留吉は巡査に言いました。",
              "citation": {
                "source": "都の眼",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにヂリヂリと上から照り附けられる苫の中も暑かつた。",
              "citation": {
                "source": "朝",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "辯證法には確かに深い眞理があるが、ただ、初めから辯證法にとりつかれると、マンネリズムに墮して却つて進歩がなくなるとか、折衷主義に陷つて却つてオリヂナリティが塞がれるとか、すべての問題を一見いかめしさうでその實却つて安易に片附けてしまふとかいつた危險があることに注意しなければならぬ。",
              "citation": {
                "source": "哲學はどう學んでゆくか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうは云っても乱闘となったら、チリヂリバラバラに別れるかも知れない。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さっきまで囲炉裡側で、五人揃って、お頭のおいでになるのを待っていましたが、捕方どもが飛び込んで参りましたのでチリヂリバラバラ、この家のあちこちに……」「集めなけりゃアならねえ。",
              "citation": {
                "source": "猿ヶ京片耳伝説",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チリヂリバラバラになってしまった。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふるへながら、とぼしくなつた焔は底の方に沈んで行つたが、今にも消えうせさうになりながら、またぽつと明るくなり、それからヂリヂリと曇つて行くのだつた。",
              "citation": {
                "source": "小さな庭",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ブリヂイ・ウエル・サンクスだ‥‥僕達はまアまア上の部だよ」「えゝなアに？",
              "citation": {
                "source": "愛する人達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前と僕とはチリヂリ別れ別れさ。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
