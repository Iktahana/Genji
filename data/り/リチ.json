  {
    "uuid": "71247eb6-f983-5b6d-ad3b-4335915378ae",
    "entry": "リチ",
    "reading": {
      "primary": "りち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "思い出して行った午後にはもう青葉まじりになってチラリチラリと散っていた。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで機因は、宇宙の因果律が構成するところの、複雜微妙極みなきプロバビリチイの數學から割り出される。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "意志の力と自由によつて、宇宙が自分に都合よく、プロバビリチイの骰子の目が、思ひ通りに出ることを信じてゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "古來、幾多の童話と童話作家が書いたものは、かうした子供の生活のレアリチイを、その自然性のままで表現したものに外ならない。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがもし――或る人が利休に關して述べたやうに――風流といふことの生活的レアリチイが、經濟學的利用價値に於ける美の創造（廢物利用としての簡易美的生活）と言ふことになるとしたら、わが室生犀星の生活樣式などは、全く風流の極意を捉へたものである。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に◇思潮界の大權威者であり、且つ詩壇評論のオーソリチイであつた上田敏博士が、これに最大級の讚辭をあたへたことは、一躍して白秋氏を文壇の巨星にし、名詩集の定評を不動にした。",
              "citation": {
                "source": "名詩集「思ひ出」の眞價",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早春の淡紫に湿つた土の上で、独楽はチリチリヽヽといふ微かな音を立ててシンミリ廻つた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、そのうちに、金が運よくチビリチビリでも貯り出すと、子供よりも金の方を大切にし始める。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、近所のＡ家の猫と宅の猫との血族関係に関しては幾分のプロバビリチが出来ていた訳である。",
              "citation": {
                "source": "ある探偵事件",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲某は何々のオーソリチーであるとなれば、その人の所説は神の託宣のように誤りないと思われるのが通例である。",
              "citation": {
                "source": "科学上における権威の価値と弊害",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "美術家は画法に囚われて自然を見なくなり、宗教家は経典に囚われて生きた人間を忘れ、学者はオーソリチーに囚われる。",
              "citation": {
                "source": "科学上における権威の価値と弊害",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この外、近頃多く用いらるるエレクトロリチック・デテクターというのがある。",
              "citation": {
                "source": "無線電信の近状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち発信器の方では不断に規則正しい波を送りそのアンテナに電話の送話器を接続し、受信器には前述のエレクトロリチック・デテクターを用うればよいのである。",
              "citation": {
                "source": "無線電信の近状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "川千鳥がそこまで通って、チリチリ、と音が留まった。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "中に、千鳥と名のあるのは、蕭々たる夜半の風に、野山の水に、虫の声と相触れて、チリチリ鳴りさうに思はれる……その千鳥刈萱。",
              "citation": {
                "source": "玉川の草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽目も天井も乾いて燥いで、煤の引火奴に礫が飛ぶと、そのままチリチリと火の粉になって燃出しそうな物騒さ。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち上って隣室へ行き、うたはトチチリチン、と歌った。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルビーよりも赤くすきとおり、リチウムよりもうつくしく酔ったようになって、その火は燃えているのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一それを云いだしたのは、剃刀を二｜梃しかもっていない、下手な床屋のリチキで、すこしもあてにならないのでした。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらまじめに眺めていても、そんな巨きなちょうざめは、泳ぎも浮びもしませんでしたから、しまいには、リチキは大へん軽べつされました。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　というその毒もみというのは、何かと云いますと床屋のリチキはこう云う風に教えます。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "床屋のリチキは、商売がはやらないで、ひまなもんですから、あとでこの話をきいて、すぐ勘定しました。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一それを云いだしたのは、剃刀を二梃しかもっていない、下手な床屋のリチキで、すこしもあてにならないのでした。",
              "citation": {
                "source": "毒もみのすきな署長さん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
