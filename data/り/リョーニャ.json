        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「神よ、護り給え――」　然し、愛するリョーニャと自分の可愛い可愛い子と三人の暮し、その行末――その先の行末――。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リョーニャ、明日お休み？",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あとで、リョーニャが話してくれますよ」　障子の彼方側の板の間で、石油鑵に足をぶつけながら、ひどく恐縮してステパンが上衣の内｜衣嚢から一通の手紙を大事そうにとり出した。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リョーニャ、月曜日に行けたらエーゴル・マクシモヴィッチのところへ行ってらっしゃいよ、ね？",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……おまけに、なぜあんなに沢山のむことがあるの、ええリョーニャ？",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラネーフスカヤ　リョーニャ、どうだったの！",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
