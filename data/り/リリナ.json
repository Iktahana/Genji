          "literary": [
            {
              "text": "彼女はペトログラアド教育課長である『同志』マダム・リリナの注意を呼ばうと試みたが、無駄だつた。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダム・リリナは、私の友達の話を信用しなかつたのだ。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るにプラウダ紙上の一論説と、私がマキシム・ゴルキイ、マダム・リリナや、其他の多くの共産主義の首領とした話で、彼等の殆どすべてが、『先天性の道徳的堕落』と云ふ事を信じてゐる事が分つた。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "『同志リリナにお会ひなさい』と私は忠告された。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　数日の後同志リリナを訪ねた。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
