        "examples": {
          "standard": [
            {
              "text": "ダウンロード版のソフトウェアの利用権は、購入手続きを行った個人のアカウントにのみ与えられます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は共有地の利用権を巡って、隣人との間で境界線をどうするかという長年のトラブルを抱えていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "クレジットカードで年額の料金を支払うことで、クラウドストレージサービスの利用権をさらに一年更新した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "所有権から利用権への推移　今のソヴェトの若い人の心持の中で、過去の人々のもっていた所有権と云う観念が、利用権と云うようなものの観念に変って来ている。",
              "citation": {
                "source": "露西亜の実生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
