          "standard": [],
          "literary": [
            {
              "text": "その皿の數ほどの頁、そしてリフアインされたお喋り。",
              "citation": {
                "source": "『亞』の回想",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "△壺の白木槿がしほれたので、鬼百合に活けかへる、前者はリフアインされたレデーのやうだつたが、後者は厚化粧した田舎娘に似てゐる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それほど迄に、リフアインされてゐるのだ。",
              "citation": {
                "source": "「香水の表情」に就いて",
                "author": "――漫談的無駄話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "リフアインドされてゐる。",
              "citation": {
                "source": "赤い鳥居",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "利口さやリフアインさでは無い、炎天の水、饑ゑたときの食物のやうな力で、反省の暇がない位力強く生命そのものを引きつけるのは生きた健康です。",
              "citation": {
                "source": "相川おけさ",
                "author": "村松おけさ、佐渡牛などのこと",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
