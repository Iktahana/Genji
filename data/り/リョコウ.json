    "definitions": [
      {
        "index": 1,
        "gloss": "travel",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "定年退職したら、夫婦でゆっくりとヨーロッパを旅行したいと以前から話し合っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "突然まとまった休みが取れたので、計画も立てずに一人でふらりと旅行に出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女は旅行先の風景を水彩画に描き留めるのが何よりの楽しみらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "家族旅行と木箱との過剰は最早、世界をして理知にて笑はしめ、感情にて判断せしむるなり。",
              "citation": {
                "source": "地極の天使",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の書中の諸詩篇を、年代順に配列し直して読むならば、詩毎に、彼が駆廻つた短い道程、彼の旅行、彼の恋、彼の悲しい肉体を、熾な芸術家の申し分ない歎賞を以て、繰返す思ひがするのである。",
              "citation": {
                "source": "トリスタン・コルビエールを紹介す",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへ旅行する時にも、彼はいつもその妻と同伴した。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "早ク見タイモノデス』という焼津の手紙でも解るように、妻と同伴することなしには、どんな旅行も楽しくないほど、夫人を熱愛していたからだった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃のヘルンは、瞬時を惜しんで仕事に熱中していたため、以前のようには、度々妻と一所に旅行したり、散歩したりすることができなかった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼、つい旅行に出る數日前に、あれほど親しく逢つて話した彼が、眞實にも自殺をしたのだ。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "14　この會見の後、私は直ちに伊豆の温泉へ旅行した。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、旅行者にとってはのんきそうに見えながらも、帝都の人たちはすべて懸命の努力で生きているのだという事を、この北京の客に説明してやろうかしらと、ふと思った。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はこの休暇中旅行だつてしたことはないのですもの図書館位行きますよ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も私は絶対に旅行させないといふのぢやあない。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「成績が悪ければこそ旅行でもしてみる方が好いのですよ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　父も、私も漫然とそんなことを言ひ合つてる時、ヒツとした瞬間、私は一生に一度しかない此の夏休みを、旅行しないといふことがとても尊い物でも取り逃がす様な気持が矢鱈に湧き上つて来た。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お父さん、僕は旅行する。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何しても旅行しますよ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二日でも三日でも好いから旅行しますよ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "全集に網羅されてる俳句は、日記旅行記等に挿入されているものを合計して、僅かにやつと八十句位しかない。",
              "citation": {
                "source": "小説家の俳句",
                "author": "俳人としての芥川龍之介と室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して芭蕉は、好んで奥州や北国の暗い地方を旅行していた。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅行の目的は、もしも運がよかったら鯨を捕る光景が見られるというのと、もう一つは、自分の先祖のうちに一人室戸岬の東寺の住職になった人があるのでその墓参りをして来るようにという父からの命をうけていたことである。",
              "citation": {
                "source": "初旅",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝへ新に入り来りし二人連れはいずれ新婚旅行と見らるゝ御出立。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃の『ホトトギス』で虚子の満州旅行記を時々読んでみる。",
              "citation": {
                "source": "高浜さんと私",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹等はもう何処らまで行ったかと思って手近い旅行案内を取り上げてみた。",
              "citation": {
                "source": "障子の落書",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、昨年、私が仙臺地方を旅行した時にも、その土地の一友人から仙臺地方の古い童謠として次のやうな歌を紹介せられた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――これは嘗て旅行の途立寄つた兵庫県は御影師範の記憶である。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜は、この旅行で、初めての野宿で、睡眠不足であったためか、私は眠くなった。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "この暴風雨がいつまでつづくか解らぬ、それよりも、差し当りこんなところに、今夜野宿が出来るか、否かが疑問である、思い切って谷へ下りようか、谷へ下りれば、この旅行の中止を意味することになる、一行は思い悩んで決し兼ねた……何だか筋骨を抜かれたように、気落がして、私も眼が重くなった。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "この白峰山脈縦断旅行も、これでおしまいになるのかと思うと、嬉しいような、気抜けがしたような、勝利の悲哀といったような、情ない心持が身に沁み泌みと味われて来る。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その名工の建築を懐かしむ想いは、再度の富士旅行に、吉田の宿に足をとめた時に、更に新しくさせられた。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰り路に、若尾、輿石両君から、故｜大町桂月氏の、南アルプス登山旅行に同行した話を聞く。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう思って私は過去の旅行カバンの中から手捜りに色々なものを取り出して並べて見ている。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうする位ならば「旅行案内」などの廣告にちやんと其旨を明記しておく方が親切であらう。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
