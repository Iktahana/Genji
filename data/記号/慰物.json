        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それまでにして育てたお玉を、貧すれば鈍するとやら云うわけで、飛んだ不実な男の慰物にせられたのが、悔やしくて悔やしくてならないのだ。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前さん、それじゃ私を一時の慰物にしといて、棄てるんだね。",
              "citation": {
                "source": "世間師",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「慰物にしたんかしねえんか、そんなことあ考えてもみねえから自分でも分らねえ、どうともお前の方で好なように取りねえ、昨日は昨日、今日は今日よ。",
              "citation": {
                "source": "世間師",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一ダアスとなって見ると、お前は町中の慰物だ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
