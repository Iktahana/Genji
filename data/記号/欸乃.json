          "literary": [
            {
              "text": "これは美しいが、夜の欸乃は侘しい。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁舟江心に向かいてこぎ出せば欸乃風に漂うて白砂の上に黒き鳥の群れ居るなどは『十六夜日記』そのままなり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "既にして幾聲の欸乃に烟霧消え、江山こゝに始めて分明なり。",
              "citation": {
                "source": "鹿島詣",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝに至りて、商家蜒居と接し、商船漁舟と竝び、絃歌欸乃に交れり。",
              "citation": {
                "source": "金華山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
