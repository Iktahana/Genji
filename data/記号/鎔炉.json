        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "火と燃ゆる人生の鎔炉に、鉄は鍛えられんとするのである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの　ふるい手なれた鎔炉のそばにお前はいつも生生した眼で待つてゐる。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにまた、極東における文化の絶頂、諸文化融合の鎔炉、あらゆるものを豊満のうちに生かし切ろうとした大唐の気分は、全身を濃い雰囲気のごとくに包んでいる。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "研ぎすました、或は今｜鎔炉からとり出したばかりの白銀の頭蓋骨だ。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそのこね上げがすむと彼は青銅の鎔炉にかかっていた。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその捏ね上げがすむと彼は青銅鎔炉にかゝつてゐた。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
