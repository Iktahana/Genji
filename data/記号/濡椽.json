          "literary": [
            {
              "text": "下の、北向きの部屋の濡椽には雨だれのしぶきがかかって下駄がぬれてしまった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡椽の外の柱にさち子さんが蒔いた朝顔の花がこの頃咲き出し今も咲いている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大さは約二｜間四｜方、屋根は厚い杉皮葺、前面は石の階段、周囲は濡椽になって居りました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
