        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さういふ時、博士はよく「阿耶、阿耶」といふ絶叫を漏らした。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿耶は楚々たる美しい娘であつた。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿耶は拒まなかつた。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿耶のからだは、まさにガラスのやうに冷めたかつたのだ。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と阿耶は、唇を反らして冷笑した。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿耶は僕の胸のなかで失神した。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのふ僕は阿耶の葬儀に列した。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれその猿田毘古の神、阿耶訶二に坐しし時に、漁して、比良夫貝三にその手を咋ひ合はさえて海水に溺れたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またその沼羽田の入日賣の命が弟、阿耶美の伊理毘賣の命に娶ひて、生みませる御子、伊許婆夜和氣の命、次に、阿耶美都比賣の命二柱。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に阿耶美都比賣の命は、稻瀬毘古の王に嫁ひましき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
