  {
    "uuid": "6c8453be-f7b3-5b25-9f59-fb3b88afd09b",
    "entry": "菜花",
    "reading": {
      "primary": "なのはな",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
