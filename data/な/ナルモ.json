          "literary": [
            {
              "text": "」　――ワクシハ、オマエト、イッショニ、クラスコトガ、デキナクナルモノ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ現時ノ對鮮策ナルモノハ甚ダシク英國ノ植民政策ヲ摸倣シタルガ故ニ、根本精神ヨリシテ日韓合併ノ天道ニ反スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ眞個父兄的愛情ヲ以テ、斯ル短時日間ニ此ノ道義的使命ヲ果タシ、以テ異民族ヲ利得ノ目的トセル白人ノ所謂植民政策ナルモノニ鐵槌一下セザル可カラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フカイアサジナルモノトウチニナシ」　課長は呆気にとられて、電報を刑事に渡した。",
              "citation": {
                "source": "鉄の規律",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時ハ何処ノ国籍ニ属スルヤ全ク不明ナリシガ只今マデ数日間観察セルトコロニヨレバ○国人ナルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "木ヲ組合ワセテ作リタル丈夫ナルモノ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然ナルモノハ巧思ヲ以テ得ベカラズ、歳月ヲ以テ到ルベカラズ……」　そこで思い出したように、パッと枚数を飛ばしてから、「英雄、医卜ニ隠ル固ニ故有リ矣。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "真ニ二千年来ノ一人――」　二千年来ノ一人……というところにばかに調子を振込んで道庵が力み返り、「中古ニ隠士｜徳本ナルモノアリ、甲斐ノ人也――」　そこで案を一つ打って、すまし返りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈故ヲ忘レザルノ最ナルモノニ非ズヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、帝国軍人ニ俘虜ナルモノハ存在セズ。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボナパルト将軍ハスコブル健全ナルモ、病ヲ装ウ。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし同君はそれを菌類とは気づかず、何か寄生の顕花植物だと想像し、前記のように「子房ノ様ナルモノモ発見セリ」と書いている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツバキを賞讃して八千代椿と称える訳は支那に『荘子』という書物があってその書中に「大椿ナルモノアリ八千歳ヲ春トナシ八千歳ヲ秋トナス」（原と漢文）の語がある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「で、君はどうだったのだい、スーリン」と、主人公のナルモヴが訊いた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "八十にもなったお婆さんがプントをしないのを、何も不思議がることはないじゃないか」と、ナルモヴが言った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はそうは考えないね」「なんだ」と、ナルモヴが言った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "え、おまえはどうしてナルモヴが工兵隊だろうなどと考えたのだ」　こう言い捨てて、トムスキイは祖母の部屋を出て行った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしナルモヴが、工兵士官でないと聞いて、彼女は前後の考えもなしに、自分の心の秘密を気軽なトムスキイに洩らしてしまったことを後悔した。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルモヴは彼にヘルマンを引き合わせた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルモヴは笑いながら、ヘルマンが長いあいだ守っていた――骨牌を手にしないという誓いを破ったことを祝って、彼のために幸先のいいように望んだ。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こいつ、どうかしているぞ」と、ナルモヴは思った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルモヴがまだ茫然としている間に、彼はレモネードを一杯飲んで、家へ帰ってしまった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下窮乏ナルモ善良ナル市民也。",
              "citation": {
                "source": "夏向きの一夜",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「明日ハ先負、明後日ハ佛滅、二十八日ガ大安デ『たいら』デス、二十八日ニオ決メナサイヨ」「暦ナンゾ当テニナルモンカ、佛滅デモ何デモ早イ方ガイヽ」無論婆サンガ反対スルコトヲ承知デ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕コウ見エテモ必ズシモ木石漢ニ非ズ、芳子ノコトナド思イ出シテ感慨無量ナルモノアリ、唯何処マデモソウ云ウ感情ヲ後ニ残シテ斯波ノ家ヲ去ラナケレバナラナクナッタアナタノ不仕合ワセヲ歎クノミデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚｜為念、従者ラジック・シャアナルモノハ殿下御看護ニ際シ感染本日午後一時三十分死去水葬ノ趣唯今イキトス号船長ヨリノ無電ニ接ス。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "科人、毎日五十人、三十人ヅツアリ、打首ニナルモアリ、血マブレナル首ヲ俵ヘ入レ、三十荷モ持チ出シテ、大坑ヘ打捨テタリトモ聞エタリ。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――客兵倍ニシテ主兵半バナルモノハ、主兵ナオヨク客兵ニ勝ツ――と。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
