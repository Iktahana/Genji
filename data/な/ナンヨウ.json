[
  {
    "uuid": "042226ac-5406-577e-86bf-c0709f9d72b3",
    "entry": "南洋",
    "reading": {
      "primary": "なんよう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
