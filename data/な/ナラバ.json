        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナゼナラバ、我輩ハ英語ニ於イテ、聞キトルコトモ、言ウコトモ、ソノホカノコトモ、スベテ赤子ノ如キデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ、君ガ充分ノ親切心ト忍耐力トヲ保有シテイルナラバ、君ノ今日ノ用事ヲコノ紙片ニ書キシタタメテ欲シイ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "以来、十春秋、日夜転輾、鞭影キミヲ尅シ、九狂一拝ノ精進、師ノ御懸念一掃ノオ仕事シテ居ラレルナラバ、私、何ヲ言オウ、声高ク、「アリガトウ」ト明朗、粛然ノ謝辞ノミ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「喧嘩口論、悪人成敗、命ノヤリトリ、白刄クグリ、ヨロズ退屈凌ギトナルベキ荒事ナラバ何ナリトモ御相談ニ応ズベク候間、遠慮ノウ当館ヘ申出デ可然候。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來一大戰等ヲ覺悟スルナラバ特ニ非常時ニ安泰ナルベキ改造ヲ要ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家組織ガ下掲ノ如ク母トシテ又妻トシテノ婦人ノ生活ヲ保證シ、婦人ガ男子ト平等ノ國民教育ヲ受クルナラバ、其ノ妻トシテノ勞働母トシテノ勞働ガ人格的尊敬ヲ以テ認識セラルルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ妻タリ母タル勞働ノミトナラバ、夫タル勞働者ノ品性ヲ向上セシメ、次代ノ國民タル子女ヲ益々優秀ナラシメ、各家庭ノ集合タル國家ハ百花爛漫春光駘蕩タルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ男子ト等シキ牛馬ノ勞働ニ服スベキ者ナラバ天ハ彼ノ心身ヲ優美纎弱ニ作ラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ニ禮式作用ガ必須課目ナラバ男子ニモ男子ノ其レガ然ルベク、茶ノ湯生花ガ然ルナラバ男子ニ謠曲ヲ課セザレバ不可。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主權國民ガ西比利亞ニ於テ露語ヲ語リ濠洲ニ於テ英語ヲ語ル顛倒事ヲナス能ハザルナラバ、日本領土内ニ一律ナル公語ヲ決定シ彼等ガ日本人ト語ルトキノ彼等ノ公語タラシメザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ此ノ立法ガ男子ノ道念ニヨリテ行ハレザルナラバ忌ムベキ婦人勞働トナリ婦人參政權運動トナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ガ全亞細亞ノ盟主タル大使命アルナラバ、人倫ノ大本ヲ嚴守勵行スル立法ハ實ニ一日ヲ忘ルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ根本ニシテ明白ナラバ未決監中ノ人權蹂躙ハ自ラニシテ跡ヲ絶ツベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ノ亡國史ヲ知リ露國ノ脅威ニ戰慄シタル危機ヲ顧ルナラバ、愛蘭土獨立問題ヲ朝鮮ニ直譯シテ論及スルノ理ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍備ニ依頼シテ弱國ヲ併呑シ以テ私慾ヲ恣ニセントスル意味ノ者ガ軍國主義ナラバ嘗テ陸上ニ於テ濁逸ガ然リシ如ク、海上ニ於テ英國ノナシツツアル者ハ實ニ遺憾ナク完成シタル海上軍國主義ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ信仰ガ強固ニシテ犧牲ヲ甘ンズル事例ヲ擧ゲテ對抗スルナラバ宗教ノ低級ナル者ニ於テ斯ル例ノ他ニ無數ナル者ヲ擧グ可ク、更ニ斯ク頑迷移サザル者多キガ故ニ殺スベシト云フ囘教ノ信仰ニヨリテ答ヘザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那ヲ併呑シ朝鮮ヲ領有セントシタル「ツアール」ノ利己ガ當時ノ状態ニ於テ不義ナリシ如ク、廣漠不毛ノ西比利亞ヲ獨占シテ他ノ利己ヲ無視セントスルナラバ「レニン」政府現在ノ状態亦正義ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ無産階級ガ組織的結合ヲナシテ力ノ解決ヲ準備シ又ハ流血ニ訴ヘテ不正義ナル現状ヲ打破スルコトガ彼等ニ主張セラルルナラバ、國際的無産者タル日本ガ力ノ組織的結合タル陸海軍ヲ充實シ、更ニ戰爭開始ニ訴ヘテ國際的劃定線ノ不正義ヲ匡スコト亦無條件ニ是認セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ是レガ侵略主義軍國主義ナラバ日本ハ全世界無産階級ノ歡呼聲裏ニ黄金ノ冠トシテ之ヲ頭上ニ加フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ今ノ軍閥ト財閥ノ日本ガ此ノ要求ヲ掲グルナラバ獨逸ノ轍ヲ踏ムベキハ天日ヲ指ス如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令英國ガ彼等ノ所謂自治ヲ許容シテ「ヂヨンブル、ソーサイテイ」ノ組合ヲ脱セシメザラント計ルトキモ、彼ニシテ全然沒交渉ナル獨立ヲ欲シテ蹶起スルナラバ固ヨリ然ルベキハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "外力ノ援助ナクシテ植民米人ガ戰フベキ武力ヲ有セザリシ如ク、一切ノ武器ヲ奪ハレシ印度獨立軍ニ對シテ恣ニ鎭壓軍ヲ輸送セシムルナラバ其ノ獨立ハ永久ニ期待スベカラザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ印度ノ獨立ヲ欲スル如ク支那ノ保全ヲ希フナラバ、眼前ニ迫レル支那ト英國トノ衝突ハ日英同盟ヲ存立セシメザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ今次ノ大戰ニ際シテ大西郷アリ明治大帝アリシナラバ、獨逸ノ陸軍ト東西呼應シテ一擧露國ヲ屈服セシメ、海軍亦東西ニ相分レテ英國艦隊ヲ本國ト印度濠洲トノ防備ニ兩分セシメ十分ナル優勢ヲ持シテ各々之レヲ撃破シ、朞年ナラズシテ早ク已ニ北露南濠ニ大帝國ヲ築キタリシ筈。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "あげくの果は驪山宮という宏大もない宮殿の中に、金銀珠玉を鏤めた浴場を作って、玉のような温泉を引いて、貴妃ヤンと一緒に飛び込んで……お前とオーナラバ、ドコマデモオ……と来たね」「ウワア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ貴官ガ今年一パイ、コノ問題ヲ調ベズニ打チ棄テテオカレタナラバ、貴官モ爆弾売リノ仲間ト認メマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤウヂキ　ヂイサンキタナラバハタオリ　ヤスンデチヤン　カラ　チヤンミンナデ　ゴチソウイタシマセウチヤン　カラ　チヤン　カラチヤン　カラ　チヤン。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、可能ナラバ霊魂第十号ニモウ一度会イ、彼及ビ彼ノ背後ニアル心霊科学ト握手シ、同ジ目的ニ向ッテ協力シタイモノダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
