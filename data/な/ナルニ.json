          "literary": [
            {
              "text": "而シテ日本ガ小農法ノ國情ナルニ考ヘテ之ヲ自作農ノ所有權ニ移シ以テ土地民有制ヲ取ルコトモ、日本トシテノ物質生活ヨリ築カルベキ幾多ノ理論ヲ有ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "新渡ヲ棄テヽ古渡ヲ取ルハ余モ同意ナレド、其ノ形ニ就テ、新渡ノ価五十銭ナルニ、古渡ハ一百円以上ニ価スル者有リ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ説最モ確実ナルニ似タリ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "内ニ信仰ノ火燃ユルガ如ク、外ニ国民性ノ堅実｜不撓ナルニアラザレバ、イカデカコノ悲惨ニ堪ヘ得ンヤ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "海狸ハ能ク其舍ヲ作ル者ナルニ、捕ヘテ之ヲ園舍中ニ置ケドモ猶木片ヲ集メテ舍ヲ作ラムト欲スルガ如シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "夷カニコレヲ考フレバ則チ古器ハ雅ナリトイヘドモイマダ新器ノ時用ニ適シテシカモ便ニカツ利ナルニ若カザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ總テノ點ニ於テ同樣ナルニハアラズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "知覚ノ能ハ実歴親験ノ重ナルニ随ヒテ長ジ、記憶ノ能ハ同一ノ観像ヲ屡反復スルニヨリテ長ジ、弁別ノ能ハ原因結果ノ比較ヲ屡スルニヨリテ長ズ。",
              "citation": {
                "source": "呉秀三先生",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど山鹿素行の兵書によると、車ガカリハ敵方ノ備ヘ立テ三段四段ナルニ用フレバ功大ナリ。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "当日の天候は「賤嶽合戦記」にも、――四月二十一日、辰ノ下刻ノ事ナルニ、一天曇リナク、照リニ照リタル空ナレバ、手負共、日ニ照リツケラレ、イト苦シガリケリ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "――勝チヲ天下ニ制スルモノハ法ヲ用ウルコト明ラカナルニ依ル――と。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
