  {
    "uuid": "39b61d94-3652-56ad-b84d-4bda7e6c0e17",
    "entry": "ナノデ",
    "reading": {
      "primary": "なので",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "キワメテアタリマエノコトナノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "書ク文字ト活字ハチガツテアタリマエナノデアルカラ気ニスル必要ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト軈テ二階カラ人ガ降リテ来ルヨウナノデ、ソット様子ヲ窺ウトソレハ道子デシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ勿論権利ガアルトハ思イマセンケレ共、余リ乱暴ナ言イ方ナノデ私モ二言三言申シマスト、　「一体アナタハホントニ私ニ可愛ガラレテ居タト思ウノ？",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "プクントフクレテ、オハナヲナラシ、今ニモナキサウナノデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オネコサンハ似合ヒモシナイ洋服ヲキテ得意デスシ、アヒルサンハアカダラケノクサイ洋服ヲキテ大ヨロコビナノデ、誰デモ二人ヲミルト、ワラツタリ、ハナヲツマンダリシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノ行為ニヨッテ害ヲ被ッタ者ガアリトスレバ、モトヨリ彼等ガ不正ナノデアルカラ、従ッテ何等気ノ毒ニ思ヒヤウハナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎ニ角予ハ助六ノ芝居ガ好キナノデ、助六ガ出ルト聞クト、勘弥ノデモ見ニ行キタクナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモハ手頸カラ指ノ先マデガ疾患部ナノデアルガ、手頸カラ上、肘ノ関節マデガ痛ミ、時ニハ肘ヲ越エテ肩ノ辺マデ波及シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女モ訥升ガ好キナノデハアロウガ、或ハ治兵衛ノ団子ノ方ニヨリ興味ガアルノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハ焼鮎ノ骨ヲ綺麗ニ抜クノガ得意ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "負ケズ嫌イナノデ、家ヘ来テカラ勉強シテフランス語ヤ英語モ片言グライハシャベレルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マルデ地獄ノ責メ道具ダナ」日曜ナノデ、浄吉モ経助モ婆サンヤ颯子ト一緒ニ集ッテ見物シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビフテキデモ鰻デモ過度ニナラナイ程度ナラ差支エナイトノコトナノデ、何デモオイシク食ベテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今デモ本心ハ善良ナノデアロウガ、イツノマニカ偽悪趣味ヲ覚エ、ソレヲ自慢ニスルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ戒名ハ琢明院遊観日聡居士、婆サンノ戒名ハ静皖院妙光日舜大姉デアルガ、予ハ日蓮宗ガ嫌イナノデ、浄土カ天台ニ変エタイト思ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木看護婦ハ子持チナノデ、月ニ一二回子供ノ顔ヲ見ルタメニ子供ヲ預ケテアル親戚ノ家ニ泊リニ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女モ佐々木ノベッドヲ嫌ッテ、長椅子デ寝ル積リナノデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭デバーベキューガ始マッタノハ夕刻六時半頃ダッタガ、賑カデ景気ガヨサソウナノデ、予モツイ若イ者タチノ中ヘ参加スル気ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ肌ハ外人ナミニ白皙ナノデ日ニ焦ケタ部分ガ紅潮ヲ呈スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシアスピリン系統ノ薬ナノデ、甚シク発汗スルノニハ閉口スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ狙ッテイタ三百萬圓ハソノ金ノ一部ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "草履ガ新調ナノデナカ／＼趾ノ股ニ喰イ込マナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ足袋ヲ穿イタ時ニ踝ノ突起ガ目立タナイノガ自慢ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「怪我ハナカッタガ、アンナ大キナモノニ飛ビ着カレルト、ヨボ／＼ノ老人ハドウニモナランネ」「オ倒レニナッタノガ芝生ノ上ダッタノデ本当ニヨウゴザイマシタ」予モ浄吉モ元来犬好キノ方ナノデ前ニモ犬ヲ飼ッタコトハアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、後カラ考エルト、ソレハ浄吉ノ意志デハナク、颯子ガ夫ニセビリツイタ結果ナノデアッタガ、最初ハソウト気ガ付カナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先月行カシタキリナノデ許サナイ訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
