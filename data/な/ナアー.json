        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "頬ひげ５・16東京日日（夕）　バアナアード・シヨウの『シイザアとクレオパトラ』を読んだ人は、その二幕目でシイザアに鎧を着せようとする拍子に、花冠がとれて、この英雄の禿頭がひよつくり顔を出すと、目ざとくそれを見つけたクレオパトラが、「あなた、お禿さんね、それでお冠で隠してるの。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナアーンだ馬鹿馬鹿しい。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハ……」――【溶暗】――　オーヤオーヤ……ナアーンのコッタイ……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この絵巻物を見るとタッタ一眼で過去、現在、未来の三世の因果因縁がナアール程とわかった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナアーンダ……　　それ位の事か……　徳市は眼を※った。",
              "citation": {
                "source": "黒白ストーリー",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで云う通りにしてみると成る程、巻線香のカケラも見当らないから……ナアーンダイ……というので釈放する。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッ」「やはり……その動脈瘤の治療で……」「ナアーニ。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭山満　ナアーンダ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの枝からこの枝、花から蕾といくつもいくつも嗅いでみましたが、「ナアーンダ、人間がいいにおいだ、いいにおいだと言うから本当にして嗅いでみたら、つまらないにおいじゃないか。",
              "citation": {
                "source": "梅のにおい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ブル化」と云った方が早わかりするじゃないかと一時は思ったが、これは文化生活の内容を見ない前で、一度実際をのぞいて見たらナアール程と又首をひねらせられた。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアーニ姐さん心配しなさんな。",
              "citation": {
                "source": "銅銭会事変",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアーンだ、道庵先生、先生、こんなところに来ていやがらあ」　長者町の子供が、くしゃみをして呆れ返っているに相違ない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアーニ、五人力あろうが、十人力あろうが、おれの匙にかかっちゃあ堪らねえ」　道庵は、その加賀様御用の提灯をたずさえて、跣足で、尻はしょりで、とうとう問題の渦の中へ飛び込んだのは、酔興とはいいながら、本当によせばいいのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアーニ、これが本格だ」　道庵はすましたもので、向きをかえようとも致しません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
