        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユライ芸術トハ、コンナモノサ、譬噺デモナシ、修養ノ糧デモナシ、キザナ、メメシイ、売名ノ徒ノ仕事ニチガイナイノダ、ト言ワレテ、カエス言葉ナシ、素直ニ首肯、ソット爪サキ立チ、夕焼ノ雲ヲ見ツメル。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばダイナモの発明に際してある大家がその不可能を論じたにかかわらず電流が遠慮なく流れ出したのは有名な話である。",
              "citation": {
                "source": "西鶴と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　流行言葉の中でも「ソートーナモンジャ」と「ドーカと思うね」には、どこか科学的なスケプチシズムの匂いがある。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "電流と磁気との基礎的な関係をゆっくり丁寧になるべく簡単な実験で十分徹底的に諒解させれば、ダイナモやモーターの色々な様式などは三文雑誌にでも譲って沢山であろう。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、私たちは東武電鉄に乗って、越谷、草加、竹塚、西新井とおい／＼大都に近付いて参りますと、わたくしの血は控えても渦巻き上り、うつろと思っていた身体のしんに何か生活廻転のダイナモの震動が地響して感ぜられて来るのでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ唄っておみやすな」　そして芸者は、テナモンヤナイカナイカ、道頓堀よ――と唄った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイナモができてからそれが発電する理由が証明されたり、飛行機が飛んでから、それが飛べる必然性が闡明されたりする。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロイロナモノガ私ノ心ヲオドラセマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神は在る、ダイナモの霊音に在る。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "○合唱婦人、（優しく）ダイナモのやうに、いつも元気の良い、青年達よ、（愛撫的に）よく磨いた鎌のやうな、聡明な若者たちよ。",
              "citation": {
                "source": "きのふは嵐けふは晴天",
                "author": "小熊秀雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "別段腫れても、傷ついてもいないところを見ると、刺か何かを抜いたアトを消毒したものらしいが、ヨディムチンキをそんな風に使う女なら、差し詰め医師の家族か、看護婦だろう」「……フーム……ソンナモンカナ」「ところで服装を見ると看護婦は動かぬところだろう。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まア、休んで行かっし、……薬はいらないが、遠いところを来て疲れたろうナモシ。",
              "citation": {
                "source": "トコヨゴヨミ",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタガツテ楷書トヒラガナモマタ同様ニ調和シナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ他日本文化ノ普及ニ役立ツコトハ非常ナモノデアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに代って琉球の中山に君臨したのもやはり浦添の人で、時の浦添按司察度（ヂヤナモイ）である。",
              "citation": {
                "source": "浦添考",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "運転手に合図してダイナモが動き始める。",
              "citation": {
                "source": "キュリー夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイナモが水に漬かって、完全に無電能力を奪ったのである。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し其中、卑狗のヒコ即ち彦たり、卑奴母離のヒナモリ即ち夷守たるが如きは、辯證を費すを須ひざれば、主として、其餘從來未だ解釋せられざりし者に就て試みんとす。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈人生ハ百万台ノ　トラツクガ　疾走スルナカヲ　駈ケヌケル　ヤウナモノサ〉　旅に出て愛人と悲壮を得た友のハガキであつた。",
              "citation": {
                "source": "火の踵",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ナモサダルマブフンダリカサス――トラのりふれんが時々きこえて来る。",
              "citation": {
                "source": "惰眠洞妄語",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ、……」（判読不能）僕「空電妨害ニ悩サル。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ以下語レ」相手「毒草ノヨウナモノヲツケタルモ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒点ガ見エ、強イ光デ網膜ガヤケタトキノ感ジガアリ、且ツチラチラト電線ノ雑音ミタイナモノガ盛ンニ動クノデアル。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
