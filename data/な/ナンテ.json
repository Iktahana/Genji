  {
    "uuid": "1a9917dc-f1c1-5551-b7ff-adcaaaa62608",
    "entry": "なんて",
    "reading": {
      "primary": "なんて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "助詞",
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "things like",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験に落ちるなんて、夢にも思わなかったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "一人で海外旅行に行くなんて、私にはとても無理だわ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「幽霊が出るなんて、そんなの迷信に決まっているじゃないか。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "所でラヴェルなんてバッハが見たら苦労性なデコラトゥールだ。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し根が風癲（フーチヤン）だから、何かほかのことが頭を占めてる時は、金なんて忘れてるといつた塩梅だな」。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へばボートの選手が、クラッチがいたんだンで俺は負けたんだ、さもなけあ勝つに決つてたんだがと嘆くとする、するとボートの漕げない奴が、クラッチのいたんだことを経験出来るだけでも仕合せだ、それで嘆くなんて、てんで漕げもしない俺なんざ、そいぢやァどうして呉れるんだといふのと同しぢやないか。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今仮りに某が、興味を以て是々の文学書を読んだり、是々の作品を物したりして暮してゐるとして、其処へもつてきて「陽気な文学を」、なんて声がして来たらどんなものだらう。",
              "citation": {
                "source": "文学に関係のない文学者",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　社交ダンスなんて、金を貰つたつて閉口だけれど、奥さんは持ちませうかね、何処からか探して来てね。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　併し小説家の傍にゐるなんて、案外労いもんですよ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひよつとしたら、仕事したなんて人は、自分の虫をいつくしみ了せた所から出発したのかもしれない。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌舞伎通なんてのはみんな目出度くおもひあがつてるものだ。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ははじめその女が爺々ィの女房ででもあるのかと思つてゐたが、さう云つてまた忽ちその女が向ふへゆくと、爺々ィが、「まあ、どこから出て来た女か知れないけれど、勧進帳で眠くなるなんて、呆れた奴だ」と云つて笑つた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "川だなんて、ひどいじゃないか。",
              "citation": {
                "source": "海",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめて彼と銀座で逢い、「なんてまあ哀しい男だろう」と思い、私も、つらくてかなわなかった。",
              "citation": {
                "source": "織田君の死",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先輩らしい忠告なんて、いやらしい偽善だ。",
              "citation": {
                "source": "織田君の死",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自作を語るなんてことは、老大家になってからする事だ。",
              "citation": {
                "source": "自作を語る",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（なんて、こんな事を言うと、非科学的だといって叱られるかしら。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "必然的と言わなければならぬ、なんて、一言一言とがめられる、あの右翼のやっかい以前の左翼のやっかい時代が、また来るのかしら。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりで、自分あての手紙なんか書いてるなんて、汚い。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、死ぬなんて、いやだ。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ぬなんて、いやだ。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふられても恰好がつくなんてのは、てんからひとに甘ったれている証拠らしいが、――ま、落ちつく」　馬場がそう言ったのを私は忘れない。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとがひとの能力を試みるなんてことは、君、容易ならぬ無礼だからね」「そうです」「と言ってみただけのことさ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "孤高｜狷介のこの四十歳の天才は、憤ってしまって、東京朝日新聞へ一文を寄せ、日本人の耳は驢馬の耳だ、なんて悪罵したものであるが、日本の聴衆へのそんな罵言の後には、かならず、「ただしひとりの青年を除いて」という一句が詩のルフランのように括弧でくくられて書かれていた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はり合うなんて、いやなこった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、あいつに無精なんてあり得ない。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐竹の陰謀なんて糞くらえだ！",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたと仲間になるなんて！",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑誌なんて、はじめから、やる気はなかったのさ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "としをとると自然に芸術が立派になって来る、なんてのは嘘ですね。",
              "citation": {
                "source": "炎天汗談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "製作の経験も何もない野次馬たちが、どうもあの作家には飛躍が無い、十年一日の如しだね、なんて生意気な事を言っていますが、その十年一日が、どれだけの修業に依って持ち堪えられているものかまるでご存じがないのです。",
              "citation": {
                "source": "炎天汗談",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "サクラの満開の日と、生れた日と、こんなにピッタリ合うなんて、なんだか、怪しい。",
              "citation": {
                "source": "春昼",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "純真太宰治「純真」なんて概念は、ひよつとしたら、アメリカ生活あたりにそのお手本があつたのかも知れない。",
              "citation": {
                "source": "純真",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
