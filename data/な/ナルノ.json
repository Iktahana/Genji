        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ナンダ　カナヅチカ、オンナジヤウナ　カタチヲ　シテ　ヰルガ、フエハ　ヨイ　オトヲ　タテヽ　ナルノニ、カナヅチハ　ナンニモ　ナラナイ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて一八〇四年ミナルノ版『伊太利古文学全集』に収めある十五、六世紀の物に、人が大便したら必ずそれを顧み視るは何故ぞてふ論あるを読んだが書名も委細も記憶せぬ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一年ニナルノニ、彼奴ハ故郷ニジットシテイテ、ドコニモ働キニ行コウトシナイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言スレバ、諸君ハ知ラズ識ラズコヽニ永代不滅ノ資産ヲ確立スルコトヽナルノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ泰西ノ学日ニ盛ナルノ時四十年ノ間身ヲ教育ニ委ネテ幸ニシテ大過ナシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ石器時代ノ人民ナルノ故ヲ以テ甲ハ乙ノ後裔ナリトハ云フ能ハズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ石器時代ノ人民ナルノ故ヲ以テ甲ト乙トハ同種族ノモノナリトハ云フ能ハズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○日本石器時代人民ニ關スル研究ハ啻ニ日本ノ古事ヲ明カニスルニ於テ有力ナルノミナラズ、人類學上益スル所又决シテ少カラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々ヨロケテ倒レソウニナルノデ、寒竹ノステッキヲ衝イテルガ、大概颯子カ看護婦カ誰カヾツイテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ニハヒルマンヲ買ッテオヤリニナルノニ」ソウ云ワレタノガグット来テ、予ハハッキリト断ル決心ガツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折角ソコマデ習ッタノニナゼ止メタンダネ」「ダッテ、トテモ足ガ変形シチャッテ醜クヽナルノヨ」「ソレデ止メタノカネ」「アタシ、足ガアンナニナルノハイヤダワ」「ドンナニナルノサ」「ドンナニナルッテ、ソリャヒドイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ハ既ニ七歳ニナリ小学一年生ニナルノニ、ソノ後アトガ生レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ全身ニ汗ヲ掻クト、肌ガツル／＼ニ光ッテ非常ニ魅力的ニナルノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間モモウコウナッチャ哀レナモノサ」「自分ニ希望ガ持テナイカラ焼ケ糞気味ニナルノネ」「岡焼キ気味デモアルサ、不便ト思ッテクレ給エ」「巧ク云ッテルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ春久ト限ッタコトハナイガネ、甘利デモ誰デモイヽガネ」「四阿ヘ来ルト、キットコンナ話ニナルノネ、チット散歩シマショウヨ、足ノ運動バカリデナク、頭ニモ毒ダワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ家ニ来テカラ既ニ十年近クナルノニ、歳月ヲ経ルホドマス／＼美シクナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………午睡ノアト、今日ハ鍼ハ休ミデアルガ、ヤハリ気ニナルノデ寝室ニイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽジャナイノ、折角楽シミニシテルンダカラ佐々木サンヲ行カシテオヤンナサイヨ」「君ハソレデイヽノカネ」「何デソンナコトヲオ聞キニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ顔、アタシニ見セタッテ何デモナイワ、ソレヨリ自分デ自分ノ顔ヲヨク見タコトガオアリニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "直グヨチ／＼シテ倒レソウニナルノデ、縁側カラ落チヤシナイカト心配デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワア、ワア、ワア」気ガ狂ッタラ狂ッタデイヽ、モウドウナッタッテ構ウモンカ、予ハソウ思ッタガ、困ッタコトニ、ソウ思ッタ瞬間ニ急ニハット自省心ガ湧キ、気狂イニナルノガ恐クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテコノ白唐紙ノ色紙ノ上ニ朱デ足ノ裏ノ拓本ヲ作ル」「ソンナモノガ何ニナルノ」「ソノ拓本ニモトヅイテ、颯チャンノ足ノ佛足石ヲ作ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ彼女ハ、「ソンナモノガ何ニナルノ」ト、云ッタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家ニアルツワイス・イコンヲ使ッテ写シテミヨウカト思ウ」ト云ッタラ、「現像ハ外ヘオ出シニナルノデスカ」ト彼ガ聞イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "因果ナ※ニ、僕ハソコマデ想像スルトイヨイヨタマラナイ嫉妬ヲ感ジ、ソノ嫉妬ノ快感ノユエニアエテソノ危険ヲ冒シテミタクナルノデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハ、ハイニナルノガ、コワクナイノカ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
