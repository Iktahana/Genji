        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "難解な問題を前に、彼はすっかり投げ首になってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "どうすれば良いか分からず、彼は投げ首の状態で途方に暮れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プロジェクトの進捗が思わしくなく、チーム全体が投げ首になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "或る日途中で父が力を落した風で投げ首で休んでいた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "物価の塩梅にはほんとうに賢明なる政府諸公も、この猪肉の公定値段をきめるには、思案投げ首の苦境に陥るのではないかと考えられる。",
              "citation": {
                "source": "たぬき汁",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "物価の塩梅にはほんたうに賢明な政府諸公も、この猪肉の公定値段をきめるには、思案投げ首の苦境に陥るのではないかと考へられる。",
              "citation": {
                "source": "たぬき汁",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹波の思案投げ首です。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "思案投げ首といった態。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……こうなれば、皇帝が自発的にあの下へ入り込んだのだと思う外はないが、しかし、皇帝がいくら酔狂でもそんなつまらんことはしないだろう」　と呟きながら思案投げ首の態だったが、やがて急に膝を打ち、「フム、少し判りかけて来たぞ。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をまだ、そんなに思案投げ首をしているのか」「ただの囚人なら、一も二もござんせんがね、なにしろ豹子頭林冲といっちゃ、禁軍のご師範、やり損なったら」「たわけめ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで俺もどうしたものかと、まったく思案投げ首だ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご自分の悪事を言われたくないばかりに、やたらに他人の噂を大事件のように言いふらし、困ったことさ等と言って思案｜投首、なるほど聡明な御態度です。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おなまめだんぶつ、座敷牢だ、と火鉢の前に縮まって、下げ煙管の投首が、ある時悪心増長して、鉄瓶を引外ずし、沸立った湯を流へあけて、溝の湯気の消えぬ間に、笊蕎麦で一杯を極めた。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、争われないのは、不具者の相格、肩つきばかりは、みじめらしくしょんぼりして、猪の熊入道もがっくり投首の抜衣紋で居たんだよ。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と投首しつつ、また吐息。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日は折目も正しかったが、露にしおれて甲斐性が無さそう、高い処で投首して、太く草臥れた状が見えた。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と力なさそうに投首をする。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と歎息して、綾子は後に思案投首。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その様子を視て、さすがの文三も今は殆ど志を挫き、とても我力にも及ばんと投首をした。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "私二三日の内に行きますから」　されども母は投首して、「私の考量ぢや、どうも今更ねえ……」「阿母さんは！",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、平七は思案投首の體で、二箸三箸、また黒いものを挾んで、精限り根限りの味覺を舌の尖端に集めようとする状で、ぴた／＼と音させて、深く考へ込んでゐたけれど、到頭分らなかつた。",
              "citation": {
                "source": "父の婚禮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "その投首のしおらしさに、善平は一時立ち止まりて振り返りぬ。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三十三、思案投首の体の事　　　　並に意外なる成行の事　場面一転して、ここは永田町内相官邸、会議室の大テーブルを囲んでいるのは、内務、外務両大臣と各両次官、欧亜局長の五人。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐホテルへ行ってその先生を何とか宥めてくれ給え」　外務大臣は思案投首のていで、「宥めるくらいでうまくおさまるかしらん。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたら人間が住めるであろうかと皆々が思案投首というところへ、文左衛門さんがやってきて、「山寺のようでしょう」　と云う。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに作者｜俄に惑うて思案｜投首煙管銜へて腕こまねくのみ。",
              "citation": {
                "source": "矢はずぐさ",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "錢形の親分さんともあらう者が、思案投首で、私の居るのも知らずに通り過ぎたりして」「用事が無きや放つて置いてくれ、俺は忙しい」　平次はクルリと背を向けて、其儘行手を急がうとすると、「まア、待つて下さいな、親分」　ヒラリと身を飜へしたお瀧、平次の袖の下を潜るやうに先へ立塞がつて大手を擴げます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、思案｜投首の態だったのです。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "銭形の親分さんともあろうものが、思案投首で、私のいるのも知らずに通り過ぎたりして」「用事がなきゃ放っておいてくれ、俺は忙しい」　平次はクルリと背を向けて、そのまま行手を急ごうとすると、「まア、待って下さいな、親分」　ヒラリと身を翻したお滝、平次の袖の下を潜るように先へ立塞がって大手を拡げます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "花見の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたらよかろうかと思案投首をしているのを見て、繩を千束ないあげてから、それをそっくり焼いて灰にして、献上すればよいじゃないかと、注意してくれたのがその父であった。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
