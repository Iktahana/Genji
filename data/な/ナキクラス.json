    "definitions": [
      {
        "index": 1,
        "gloss": "to spend one's days in tears",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夫を亡くして以来、彼女は毎日を泣き暮らしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "困難な時期、彼は酒に溺れ、泣き暮らす日々を送った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画の主人公は、悲しみのあまり泣き暮らす生活を送っていたが、やがて立ち直った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "女とはかようなものかと夕蝉の、草の葉末に取りついて、心も空に泣き暮らすばかり。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "つれづれとわが泣き暮らす夏の日をかごとがましき虫の声かな　蛍が多く飛びかうのにも、「夕殿に蛍飛んで思ひ悄然」などと、お口に上る詩も楊妃に別れた玄宗の悲しみをいうものであった。",
              "citation": {
                "source": "源氏物語",
                "author": "まぼろし",
                "note": "青空文庫"
              }
            },
            {
              "text": "友を思うて都の高臺にいちにちを泣きくらす。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青いゆき萩原朔太郎青いぞ、ゆきはまつさを、もも、さくらぎに花咲かず、青いこなゆき、光る山路に泣きくらす。",
              "citation": {
                "source": "青いゆき",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人知らぬ思ひに秋の夜半を泣きくらす横笛が心を尋ぬれば、次の如くなりしなり。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、人前でこそ慎んでいるものゝ、絶対に人の眼に触れぬ場所では親子がひしと抱き合って泣きくらす日もあったであろう。",
              "citation": {
                "source": "聞書抄",
                "author": "第二盲目物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど、われは徒爾に哭して慟する者にあらず、女児のすなる仏いじりに日を泣暮す者にあらず。",
              "citation": {
                "source": "父の墓",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
