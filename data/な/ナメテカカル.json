        "examples": {
          "standard": [
            {
              "text": "「相手が新人だからといって嘗めてかかると、痛い目を見るぞ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はどんなに弱い相手でも、決して嘗めてかかるようなことはしない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "プロの厳しさを教えるために、先輩は嘗めてかかる後輩を圧倒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "問屋場人足や雲助が、女と思って嘗めてかかると、お仙はびくから蝮を取り出し、これを振り廻して嚇しつけた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
