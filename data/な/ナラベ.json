[
  {
    "uuid": "ff92018a-88bb-5ad8-8b40-cde695ea9b56",
    "entry": "並べ",
    "reading": {
      "primary": "ならべ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
