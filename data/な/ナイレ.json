        "examples": {
          "standard": [
            {
              "text": "誕生日の贈り物として、革の財布に彼のイニシャルを名入れしてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "卒業記念品として配る万年筆に、校章と日付を名入れする作業を進めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "オリジナルのタオルを作る際、刺繍で丁寧に名入れを施すと高級感が増す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "同時に目を射たのは、その二の腕に見える奇怪ないれずみです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな、どんないれずみでござりましょう！",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだとて、またあんないれずみをしたんです」「かわいかったから、ただもうかわいかったからでござんす」「なに！",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまえはまた、ずいぶんみっともないれんちゅうと知りあいなんだねえ。",
              "citation": {
                "source": "三人の糸くり女",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "「川にいれば、いろいろのものを食べるから、大きくなるのだけれど、こんないれものの中では、ほかに食べるものがないだろう。",
              "citation": {
                "source": "兄と魚",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "役割がすっかりきまると、豚をつぶす人は、豚になるはずの男の子へつかみかかって、ねじたおし、小刀でその子の咽喉を切りひらき、それから、お料理番の下ばたらきの女は、じぶんの小さないれもので、その血をうけました。",
              "citation": {
                "source": "子どもたちが屠殺ごっこをした話",
                "author": "ヤーコップ、ウィルヘルム・グリム　Jacob u. Wilhelm Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の大きないれものを一杯にするんだから――ふと考へてみりゃ月給が安い。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
