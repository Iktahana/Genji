    "definitions": [
      {
        "index": 1,
        "gloss": "amen",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「南無、どうかこの度の手術が無事に終わりますように」と仏壇の前で祈った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母は毎朝、お線香を上げながら「南無」と唱えるのを欠かさない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「南無、これで万事休すか……」と、彼は絶体絶命の状況で天を仰いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "小さい石祠がある、屋根には南無妙法蓮華経四千部と読まれた、大日如来と書いた木札が建ててある、私たちの一行より、二十日も前に登山した土地測量技師や、昨年登山した東京の人たち、山麓｜蘆安村でよく聞く名の森本某、名取某の名刺が散らばっている。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南無阿弥陀仏」と、丈夫な誰かが云ったようだった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京から遥々見送って来た安兵衛という男が、宿屋で毎日朝から酒ばかり飲んでいて、酔って来ると箸で皿を叩きながら「ノムダイシ、一升五合」（南無大師遍照金剛）というのを繰返し繰返し唱えたことも想い出す。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無阿弥陀仏、南無阿弥陀仏」　僕は懐にあった紙の有りたけを力杖に結ぶ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「南無三　芝居が果てた！",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人なら南無阿彌陀佛／＼と口の中で唱へる所だ。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅笠をかむり、杖をつき、お札ばさみを頸から前にかけ、リンを鳴らして、南無大師遍照金剛を口ずさみながら霊場から霊場をめぐりあるく。",
              "citation": {
                "source": "海賊と遍路",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああさっきのお百姓がものの間違でも故道には蛇がこうといってくれたら、地獄へ落ちても来なかったにと照りつけられて、涙が流れた、南無阿弥陀仏、今でもぞっとする。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（どなた、）と納戸の方でいったのは女じゃから、南無三宝、この白い首には鱗が生えて、体は床を這って尾をずるずると引いて出ようと、また退った。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と折から唸るように老人が唱えると、婆娘は押冠せて、「南無阿弥陀仏。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――青膨れの、額の抜上つたのを視ると、南無三｜宝、眉毛がない、……はまだ仔細ない。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無疾翔大力、南無疾翔大力。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "至心欲願、南無仏南無仏南無仏。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南無疾翔大力、南無疾翔大力。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手に燻りかえる安線香の束を持ち、左手に念珠を掛けながら、膝頭をガクガクさせて「南無南無南無」と言うばかり。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南無大慈大悲観世音菩薩。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなむしろ邪魔されて欲しいくらゐのところへ、この挨拶は、一寸ツカないものであつた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、するどき薄刃をさげ、左手をもつて敵手に揖す、はや東雲あくる楢の林に、小鳥うたうたひ、きよらにわれの血はながれ、ましろき朝餉をうみなむとす。",
              "citation": {
                "source": "決鬪",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "異国の遠い昔に対するあくがれの心持ちや、英雄の運命の末をはかなむような心持ちや、そう言ったようなものが、なんとなく春の怨を訴えるような「無語歌」と一つにとけ合って流れ漂って行くのであった。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三鷹の薄汚い酒の店で、生葡萄酒なんかを飮んで文學を談ずるくらゐが、唯一の道樂で、ほかには、大きなむだ使ひなどをした覺えはない。",
              "citation": {
                "source": "金錢の話",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二勺より路は黒鉄を鍛へたる如く、天の一方より急斜して、爛沙、焦石、截々、風の噪ぐ音して人と伴ひ落下す、偶ま雲を破りて額上｜微かに見るところの宝永山の赭土より、冷乳の缸を傾けたる如く、大霧を揺るよと見る間に、急瀬上下に乱流する如くなりて、中霄に溢れ、片々｜団々、がり、故郷を望んで帰り去なむを私語く。",
              "citation": {
                "source": "霧の不二、月の不二",
                "author": "――明治三十六年八月七日御殿場口にて観察――",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士のようなむきだしの石山で、しかも懐の深くない山ですら、道路の変遷と盛衰はこのように烈しい。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "健気なむす子よと言い送り度い。",
              "citation": {
                "source": "巴里のむす子へ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間映画で見たが、インドの聖地では、自分の肉体を責めさいなむことを一生の唯一の仕事にしている人間が沢山いるようである。",
              "citation": {
                "source": "山中常盤双紙",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲雀料理ささげまつるゆふべの愛餐、燭に魚蝋のうれひを薫じ、いとしがりみどりの窓をひらきなむ。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれあれみ空をみれば、さつきはるばると流るるものを、手にわれ雲雀の皿をささげ、いとしがり君がひだりにすすみなむ。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、無｜論お互に胸中｜密に「なアに己の方が……」と思つてゐる事は、それが將棋をたしなむ者の癖で御多分に洩れざる所。",
              "citation": {
                "source": "下手の横好き",
                "author": "―將棋いろいろ―",
                "note": "青空文庫"
              }
            },
            {
              "text": "憲兵伍長は、腹立てゝいるようなむずかしい顔で、彼の姓名を呼んだ。",
              "citation": {
                "source": "穴",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "工人は、不逞なむほんをたくらみ（小山の言葉をそのまま用うれば）にかゝった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、おばさんは吐息をして、なむあみだぶを唱えた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
