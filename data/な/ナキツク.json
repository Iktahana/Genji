[
  {
    "uuid": "39a55e84-505d-5c56-baaa-68aad5ceb989",
    "entry": "泣き付く",
    "reading": {
      "primary": "なきつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to cling to ... in tears",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "困った時、彼女はいつも私に泣き付いて助けを求める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供は欲しいものを買ってもらいたくて、親の足元に泣き付いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "もうどうすることもできないと悟り、彼は上司に泣き付くしかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "叔父を訪うて泣き付くと、広げさえすれば飲食思いのままに備わる机懸けをくれる。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを持ってまた同じ旅亭に宿り、前のごとく掏り替えられ、叔父に泣き付くと、仏の顔も三度と呟きながら、今度は打てと命ずれば他を打ち続け、止めと命ずれば止む杖をくれる。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、なほも泣き付くやうに言ふと、香雲はうるささうにして、「天南、……天南。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "こりゃもう仏様があなたを導き下すったのだ」と泣き付くようにいう。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の小さい仲間の者達の、羨望や嫉妬の真只中を、泣き付く父親を片手で振り払い、振り払い、片手に女を引立てて、畑地と引換えに引っ攫って来た金を鳴らしながら、悠然と闊歩してこそ、彼の生甲斐はある。",
              "citation": {
                "source": "風に乗って来るコロポックル",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "月謝が滞る、叔母に泣きつくと云ふ不始末。",
              "citation": {
                "source": "いろ扱ひ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに工事が終ると、翌日からひとり残らず失業者で、なんとかしてくれと泣きつくには、アメリカ当局はあまりに冷淡であった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣いて泣いて泣きつくして別れた二人には、またとても言い表すことのできない嬉しさを分ち得たのである。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝手にしろ、おッ母さん、とんだお邪魔をしました」　薊は身を飜して降り口へ出る、母はあとからすがりつく、お千代も泣きつく。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間は思いきり泣きつくしてしまうと、自殺などはしないものです。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "興録はいいかげんな事をいって一日延ばしに延ばしているのでたまらなくなって木村が事務長に相談すると、事務長は興録よりもさらに要領を得ない受け答えをした、しかたなしに木村は途方に暮れて、また葉子に帰って来て泣きつくように上陸を迫るのであった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰れか泣きつく人を見つけて、それに質物を出して貰つたので、目下の必要ばかりを云つて來るのだらうかとも思ふ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、また、押しかけてゐる印刷屋の主人に向つて、「どうせ、僕を責めたツて金の出ようはないのぢやから、社長へ行つて僕等と一緒に泣きつくより法はない」と、智慧をつける。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、その實、社は川崎の物だとすれば、もし衝突して追ひ出されたりなどすると、その出金者に對しても、もう、再び泣きつくことが出來ないからである。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣いて泣いて泣きつくしましたあとの空っぽのような気もちになりながら……。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こりゃあ、もうよんどころない――うちへ帰って、おふくろに、何とか泣きつく外にない――友だち一人の、一命にかかわることだ――この決心がつくまでには、ずいぶん苦しんだのだがね――」　闇太郎の顔に、苦笑がうかんだ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ううん、お客さんに、リンゴを一つ食べさせようと思つて、作さんのところへ行つて、泣きつくやうにして、リンゴを五つばかり分けて貰つて來たのを、俺は忘れてしまうてゐたよ」　老人は籠の中から、リンゴを出して、炬燵の板の上に竝べた。",
              "citation": {
                "source": "雪の町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "急に心臓がよわってしまって――磯崎は自分が死ぬなんて、夢にも思っていませんでしたわ」　須美子の、濃いおかっぱの前髪の下に、もう泣きつくして赤くはれた両方の瞼がいたましかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "淋しい泣きつくやうな氣難しい憂鬱な顏をして居る。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雪さん、捨てられたの何のって泣っ面をしながら、敵を討って下さいなんて、飛んでもないところへ泣きつくなんぞは、女の面汚し。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、思い出す丈思い出し、泣きたい丈泣きつくした時に、後には何ともいえぬしんみりと安らかな気分が私を見舞ってくれました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはもううるさいから相手にしないんだけれどね、再三、当人がやつて来て、家内に泣きつくんださうだよ。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくらでもないお魚の代金まで母に泣きつく女房のせつなさ、もとより彼自身のせつなさなのだ。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんが泣きつくと、毎月三十円ずつくれたが、後に手を合して五十円にしても貰った。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の弱小国は近所の強国に泣きつく以外に手がなかったが、当節は国連という強力な組織ができてゴタゴタには提訴である。",
              "citation": {
                "source": "悲しい新風",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、わたしが小部屋へ帰ってきて、わが身の不運を泣いて泣いて泣きつくしてしまおうと、頭を枕に埋めたとたんに、床の下から怖ろしい呻き声が聞えて来たのでした。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "それじゃ身が持たないよ――お泣き、思いっきり泣いて泣いて、泣きつくしておしまい。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのむっちりとした胸は、ついこのあいだカテリーナ・リヴォーヴナの不実な情人に、みだらな歓楽を満喫させたものに違いなかったが、今や彼女はほかならぬその胸の上で、じぶんのやるせない歎きを、泣いて泣いて泣きつくそうというのである。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の瞬間、自分が此の土地を離れて、若しも非常に窮迫して窶れ果てた最後に此の人の工場へたよつて行つて泣きつくやうなことになりはすまいかといふ厭な予感が彼を脅やかした。",
              "citation": {
                "source": "煤煙の臭ひ",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄生こころまどひて、一手に香玉、一手に絳雪を捉へて放たず、相対して愁き限りを泣きつくせり。",
              "citation": {
                "source": "『聊斎志異』より",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
