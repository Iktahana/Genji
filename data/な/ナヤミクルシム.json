        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかも志大きく、学問をして道を修めてこれを身につけ、そしてこれを世に行おうとする者に在っては、人に知られないことは心苦しい限りで、悩み苦しむところである。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は悩み苦しむ、嗚呼また悲しいことである。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧乏はつらいかな、銭がないために、人間はどんなに悩み苦しむことか。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦しみをかくまでにも秩序立て悩み苦しむ方法を私達はどこから学んできたのだらう過渡期の愛の新しい苦しみが前方に私達を待つてゐるがその新しい苦しみの性質を生活の途上で我々は知りつくす愛の大きな優位性をもつだらう。",
              "citation": {
                "source": "小熊秀雄全集-9",
                "author": "詩集（８）流民詩集１",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間だけが悩み苦しむと云ういわれを妙な事だと思う。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちその世の中を復興する力が、隠れて外にあり、それを信心によって招き寄せ得るということが、悩み苦しむ生活のせめてもの楽しみだったかと思われる。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンパシーには、同情という性質がある――打ちひしがれた人々、悩み苦しむ人々への哀れみとして、その苦しみにある人々を癒したり助けたりしたいと思う。",
              "citation": {
                "source": "朝に想い、夜に省みる",
                "author": "MORNING AND EVENING THOUGHTS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
