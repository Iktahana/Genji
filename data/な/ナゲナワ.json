          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "カウボーイは馬に乗り、素早く投げ縄を回して牛を捕らえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは公園でゴム製の投げ縄を使って遊んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "投げ縄を使うには、かなりの熟練した技術が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "驚かされたのは、自由に範囲を選んでエリアごと移動できるようにした、投げ縄のアイコンで示された機能だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが投げ縄を使えば、画面上の絵の中からハサミを使ったように自由自在に一部を切り抜いて動かすことができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "槍や刀剣や、投げ縄、弓矢。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーボロの広告をかねたもので、例のカウボーイが投げ縄を持ってポーズしている下に、ストア・アローズが表示してあった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "連中が突然消えて隠れたのはなぜですか、まるで急に命を狙われたかのよう」「下を見ろ、命に関わるぞ」　船長がこう言ったとき、どこからともなく現れた細い投げ縄のような長い巻きひげが、二十メートルほど伸びて、例の俊敏な動物の首に巻き付き、砂に叩きつけると、小動物は死んで動かなくなった。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあと、投げ縄をたぐり寄せ、少し離れた巨岩のうしろに獲物と一緒に消えた。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といったかとおもうと、老人は、小わきにかかえていた縄のはしをつかんで、まるで、投げ縄でもするようなかっこうになって、恐ろしいいきおいで、それをぱっとてんじょうに投げあげました。",
              "citation": {
                "source": "魔法博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "明智は投げ縄の術を知っていたのです。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "明智先生はカウ＝ボーイみたいに、投げ縄ができる人だよ。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "投げ縄は、みごとに命中したのです。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、きみが投げ縄の名人とは、知らなかったね。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その足音が地の下へとおざかるのを聞きながら、蚕婆はすぐもとのとおり床板や蓆を敷きつめ、壁にかかっている獣捕りの投げ縄をつかむが早いか、いきなりおもてへ飛びだした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ふいに吠えるような蚕婆の声とともに、さすがは半助、足の痛手を忘れて、ポーンと小川を跳びこえたが、よりはやく、闇のなかを飛んできた投げ縄の輪が無残、五体にからんでザブーンと、水のなかへ捕りおとされてしまった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻かけ卜斎と泣き虫蛾次郎一　さすが伊賀衆の三羽烏、菊池半助も、可児才蔵にみやぶられて、錆槍の穂先を膝にうけ、そのうえ、投げ縄にかかって五体の自由を奪われては、どうすることもできない。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "網の中に」　たちまち、熊手や投げ縄が、八方の叢林から飛び出して、彼を馬の背から搦め落した。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士達にだって幾月幾日に断定出来ないからだだただ自分の生命は非常に死に近づいている、死の手に引かれるか又再び生の力に引上げられるかあぶなげなわが生命　はかなきわが生命わが今歩める路は果して何れか一九三五・五・七",
              "citation": {
                "source": "路は果して何れ",
                "author": "今野大力",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロちゃんは、なげなわもじょうずでした。",
              "citation": {
                "source": "赤いカブトムシ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　のどかそうに庭先で、しきりに投げなわのけいこをしていた善光寺辰を呼び招くと、にこやかに笑みつつ、右門流の命令を与えました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほほう、投げなわをよくいたすとみえるな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "曲芸三人娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　叫びざまに、こぢんまりとしたからだをちょこちょこと走らせて、逃げゆく影を追跡していった様子でしたが、いかさま名詮自称のことばのとおりで、右手のうちから得意の投げなわが、するすると長いへびのごとく伸びたかとみるまに、わざは知恵伊豆守が希代の名技と折り紙つけた秘芸でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "曲芸三人娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「辰ッ、投げなわで押えろッ」　しかし、妙です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "辰ッ、相手は四人だから、投げなわの用意しっかりしておけよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょんちょんとすずめ足で追いかけながら、みごとな投げなわで押えていたのも、四尺八寸のお公卿さま、背たけに似合わずあっぱれでしたが、伝六がまたなかなかにがら相当なので――。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "のどかな顔ばかりしていねえで、たっぷり投げなわにしごきを入れておきなよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうでなくとも、おいら、ゆんべから投げなわの使い場がなくて、うずうずしてるんだから、ちょっくら行ってこようよ」　勢い込んで、手代のあとに従いながら、駆けだしていったようでしたが、ものの四半刻もたたないうちにすごすごと帰ってきたのは、伝六、辰の両名でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "――だが、われらの名人の配下には、善光寺の辰という忘れてならぬ投げなわの名手がいたはずです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "辰がはだ身離さず所持いたしている投げなわが、腰にも懐中にも見当たらない！",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "けんめいに、辰の周囲の雪をかき分けたその下から、果然出てきたのは、日ごろ手なれのその投げなわの端です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "通りかかって専介と敵とが争っている現場でも見かけ、一度はきっとみごとに相手をからめ押えたのに、敵はよほど腕がさえてでもいたとみえて、プツリと投げなわを断ち切り、しかもその一刀で辰をも切りすて、かく相討ちのごとき形をよそおっておいてから、すばやく逐電したに相違ないのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "投げなわの小さなやつも、いらぬすけだちしたゆえ、一つ刀で手にかけたが、この夜ふけに起こして、どうしようというのじゃ」「誉のあだ討ちさ！",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
