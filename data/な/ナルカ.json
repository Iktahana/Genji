        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ゾ我ニ乏シキ者ナルカノ如ク彼ノ「デモクラシー」ノ直譯輸入ノ要アランヤ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義共産主義ヲ誤解シテ其ノ私有財産ヲ分與スルモノナルカノ如ク考ヘ、又ハ國民ノ凡テニ其日暮シ其年碁シノ生活ヲナサシムル者ト考フルガ如キハ、現實的改造ノ要求セラレツツアル現代社會革命説ノ躍進的進歩ヲ解セザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍國主義ナルカ否カハ傭兵ト徴兵トニヨリテ決セラルル者ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "四千年住ミ古シタル支那ヲ富源ナルカノ如ク垂涎スル小膽國民ニシテ、如何ゾ世界的大帝國ヲ築クヲ得ベキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見兩立スベカラザルカノ如キ此等ガ、其實如何ニ日米兩國ヲ同盟的提携ニ導クベキ天ノ計ラヒナルカノ如キ妙諦ハ今是レヲ云フノ「時」ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「新吉ヨ、晴レヤカナルカ、僕ハ今度クルブラ島ヲ去ツテ、バージニヤ州ナル、ノーホーク海軍鎮守府詰メニ出世シタ。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ハ日本人ナルカト思イタレドモ、後ニ至リテ彼等ハ日本人ニハ非ザルモノノ如キコト判明セリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜ハ御客様ガ御泊リニナルカラ、寝床ノ仕度ヲシテ置イテオクレ。",
              "citation": {
                "source": "魔術",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ネギサンガ迷子ニナルカモシレナイトオモツテ、アトカラ、オツカケテキタトコロデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ此○主要ナル石器時代人民ハ何者ナルカ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナトコロデ押シ倒サレテ若シ打チドコロガ悪カッタラドンナコトニナルカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデナクテモ「若奥様」ノ権力ガ日ニ日ニ「御隠居様」ヲ凌ギツヽアルノニ、犬一匹ノ処置ノ問題ガ因ニナッテドンナ大喧嘩ニナルカモ知レナイ、ソレヲ思ウトウッカリ戦端ヲ開ク訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ニ墨グライハ磨ッテ貰ウヨウニナルカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレトモコノ花ガ、ヒョットスルト枕花ニナルカモ知レナイト考エテ特ニ念ヲ入レテ活ケタノデモアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「看護婦附キデ泊ッタリスルト手数ヲカケルコトニナルカラナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南禅寺ッテ云エバ永観堂ノ紅葉ガ綺麗デショウネ、アタシガアレヲ見テカラモウ何年ニナルカ知ラ」「永観堂ハマダ早イヨ、高尾ヤ槙ノ尾ガチョウド見頃ダガ、己モコノ脚ジャ行ケソウモナイ」……………………………………………………………………………………………………十二日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、疑イ深イ人ニ向ッテコウイウ※ヲ云ウトカエッテ疑イヲ深クサセル結果ニナルカラ、モウ云ウマイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテコレカラハドウナルカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイウノハ、木村ノ学校ガ始マッテ、ソロソロ昼間ノ逢引ガ不可能ニナルカラデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
