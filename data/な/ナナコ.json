        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この帯は七子織りで、独特の光沢と風合いがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "七子という織り方は、丈夫で型崩れしにくいのが特徴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "母が若い頃に着ていた着物には、美しい七子の模様が施されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
