[
  {
    "uuid": "fd839ad1-2857-5160-953b-239caa974515",
    "entry": "七子",
    "reading": {
      "primary": "ななこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
