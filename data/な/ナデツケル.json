        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は、外出前に寝癖を直すために、手ぐしで髪を撫で付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "母親は、子供の乱れた髪を優しく撫で付け、学校へ送り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ドライヤーで乾かしながら、ヘアブラシで髪全体を毛の流れに沿って撫で付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "出掛けるとなつて庭へ下りると、髪があんまりひどいから一寸撫で付ける迄待つて頂戴と云ふ。",
              "citation": {
                "source": "『団栗』のことなど",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出かけるとなって庭へおりると、髪があんまりひどいからちょっとなでつけるまで待ってちょうだいと言う。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとなでつけるのかと思ったら自分で新たに巻き直すと見える。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お力はあの子息さんを覚えているだろう」　髪をなでつける人、なでつけて貰う人の間には、すべてが思い出の種でないものはなかった。",
              "citation": {
                "source": "食堂",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでに、髪にも水をつけて手でなでつける。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちと遊んだり、掃除をしたりした後で、大して乱れてもいない短い毛を、さっさとなでつけるのだ。",
              "citation": {
                "source": "女客一週間",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が鏡を見るのは、髯をそる時、髪をなでつける時、まあそんなものですが、それよりももっとはっきりした鏡が頭の中にあって、それに自分の顔付が映ってきます。",
              "citation": {
                "source": "肉体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（鏡台の引き出しから櫛を出して、髪をなでつける）このようにしてなんのために身じまいをするのだろう。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪をなでつける間もなく御父さまが上野じゃなくて玄関について御しまいになった。",
              "citation": {
                "source": "日記",
                "author": "一九一三年（大正二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "立て膝して髱をなでつける婀娜女、隅っこの羽目板へへばりついている娘、小｜桶を占領して七つ道具を並べ立てた大年増、ちょっとの隙にはいだして洗い粉をなめている赤ん坊、それを見つけて叱る母親、いやもう大変なさわぎ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリヤは、イエス様の首をおのが胸に押しあてんばかりにして、香油をそそいではなでつける。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい天気でも、朝から薄い山霧が、髪をなでつけるように、また藻草のなびくさまに、おおいかかる。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノナン・ディエール街では、腹がでっぷりして、声が朗らかで、頭が禿げ、額が高く、黒い頤鬚をはやし、なでつけることのできない荒い口髭をはやしてる、相当な服装をしたひとりの市民が、通行人に公然と弾薬を配っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　一度横目を流したが、その時は、投げた単衣の後褄を、かなぐり取った花野の帯の輪で守護して、その秋草の、幻に夕映ゆる、蹴出しの色の片膝を立て、それによりかかるように脛をあらわに、おくれ毛を撫でつけるのに、指のさきをなめるのを、ふと見まじいものを見たように、目を外らした。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小格子ではあるがお職も張って、男あつかいに慣れている彼女は、燃えあがっている対手の心を撫でつけるようにして、隙を見て逃げようとしたところで、対手は野獣の本性をあらわして、帯の端を掴んで引もどそうとしたのであった。",
              "citation": {
                "source": "放生津物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今頭髪を撫でつける」と、内隠しからポケット櫛を取り出して悠々と髪を分け直して、「後に残るものだからな、出来る丈け好い男に撮って呉れ」　かちりと、カメラが鳴った。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭髪を香油で撫でつけるやら、ハンカチへ香水をしめすやら、そしてむやみにソワソワして腕時計ばかり気にしている。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "※子は朝から何となし落ち付けない気持でカタカタと机の上を片づけたりして居たが、お昼を仕舞うと先ぐ、髪を一寸撫でつけるなり飛ぶ様にして家を出て行った。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々片手を上げて指先で両の眉を内から外へ撫でつける癖がある。",
              "citation": {
                "source": "みごとな女",
                "author": "森本薫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あさ子、指先で眉を撫でつける、之で三度目くらい。",
              "citation": {
                "source": "みごとな女",
                "author": "森本薫",
                "note": "青空文庫"
              }
            },
            {
              "text": "刀の笄を抜いて、その次には、みだれた髪の毛を撫でつける――　とにかく柳生流の大祖に今朝は会うのである。",
              "citation": {
                "source": "宮本武蔵",
                "author": "水の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
