        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大資本ガ社會的生産ノ蓄積ナリト云フコトハ社會主義ノ原理ニシテ明白ナルコト説明ヲ要セズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "機械其他ノ設備ヲ資本トシテ鑛山其者ノ價格ガ資本ナルコトヲ忘レントスル誤解ヲ防グ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シナガラ實ニ他ノ歐釆諸國ニ見ザル國字改良漢字廢止言文一致羅馬字採用等ノ議論百出ニ見ル如ク、國民全部ノ大苦惱ハ日本ノ言語文字ノ甚ダシク劣惡ナルコトニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其不合理ナルコト恰モ現時ノ歐米ニ「キモノ」服ガ普及シタルヲ以テ其レヲ室内ノ制服トシテ強制セント云フト一般ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只獨逸ガ最後ニ破レタルガ故ニ徴兵制ノ價値ヲ疑フハ非常ナル妄斷ナルコトヲ注意ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而テ支那保全主義ヲ堅持スル日本ハ彼トノ衝突ニ於テ、其ノ支那經略ノ根據地香港ノ有害ナルコトハ、日露戰爭ニ於ケル旅順浦鹽斯徳ノ根據地ニ優ルトモ劣ラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只天寵ハコノ切開手術ニ於テ日本ノ健康體ナルコトニ在リトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑品倉庫ナルコトヲ知リ得タリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "無謀ナルコトヲヤメヨ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴艇ノ観測ハ誤リナルコト明カナリ。",
              "citation": {
                "source": "月世界探険記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊ニソノ整形ノ効果ノ大ナルコト、他ノ部位ノ比デハナイ。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "有力者中好古ノ名有テ其ノ実無キ輩ハ、徒ラニ古クモ有ラヌ玉瓶瑶盃ニ千金ヲ費ヤシ、反故紙ニモ劣ル偽其昌贋徴明ナドニ流涎シテ、其嚢ヲ倒ニスルハ愚カナルコトニコソ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ刀剣ノ利鋭ナルコト、コレヲ以テ欧羅巴ノ刀剣ヲ両断スルトモ疵痕ヲ止ムルナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勇気ノ盛ンナルコト、忍耐力ノ強キコト、感情ヲ抑制スルノ力ハ驚クベキモノアリ」　これは考えものだ……ことに今日のような頽廃を極めた時代を、かえって諷誡しているような文字とも思われるが、しかし、よく考えてみると、古来、日本武人の一面には、たしかにこの種の美徳が存在していた。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "此感覺ヨリ取リ得タル者ヲ記性ニ付シ、過去ノ事ヲ現在ヨリ未來ニ遺シ、保存シテ同一物ニ逢フ毎ニ、再ビ前時ニ認メ得タル者ナルコトヲ知ル上ニ在リ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "此本能ト云フ者、例スレバ蜘蛛ノ網ノ八角ニ割出シ、蜂ノ巣ノ六角ニ割出スガ如キ、巧ナル器械學者ト雖ドモ、此割方ニ上ナルコト能ハザルナリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ノ羽族ノ序ヲ逐ヒ影ヲ聯ネテ飲啄相離ルヽコトナキガ如クナルコト能ハズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ文ノ簡浄｜紆余ナルコト殆コレニ過グ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二柱六雄蕋ナルコト亦ヤナギタデノ如シ。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寛文検地帳ニハ、此社ノ跡辺皆仮名ニテフクチト記タルハ誤ナルコト知ヌベシ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一ツ気ニナルコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前ニモ度々コンナツメタサノ経験ヲシタコトガアルガ、ソシテ大体真冬ノ寒中ニソウナルコトガ多イノダガ、必ズシモ冬トハ限ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ奈良ノ寺々グライハ見テ置イタ方ガイヽシ、殊ニ今度ハ予ノ菩提所ヲ定メルニツイテモ、必ズ参考ニナルコトガアロウ、ト、ソウ云ッテヤッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯縁熏発シテ幸ヒニ信輩ノ熊野ニ詣ルモノヲ乗セタルガ為メニ、更ニ転生シテ第四生ニハ柴燈ヲ燃ヤスノ人身トナルコトヲ得タリ。",
              "citation": {
                "source": "覚海上人天狗になる事",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヨウトフウフニナルコトニナツタ」オヨウトノレイノヤクソクハトリケサレタシ」カラシシノ十ロウ」　般若の五郎がこれを読んで、「おれよりも、倅の奴の方が上手だ」　と、笑った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ヤ、人ノ性命ヲツカサドル君ト成リ、ソノ君ノ宰相、理官トナリ、政刑ノ任ニアタル者、猶更、性命ノ吟味、大切至極ナルコト、云フニモ及バザル事ナリ。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "疾キコト風ノ如ク徐カナルコト林ノ如シ　自ら掲げて自己の面目としている例の一丈八尺の大軍旗の文字は、信玄の頭上にはためいて、しきりと何事か、暗示しているかのよう思われた。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "物理マタ異ナルコト無キコトヲ。",
              "citation": {
                "source": "『雪華図説』の研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
