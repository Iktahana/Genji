[
  {
    "uuid": "de5be26f-3c94-5df0-9554-eaacc248c81b",
    "entry": "何千",
    "reading": {
      "primary": "なんぜん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
