        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼ガ多クノ點即チ軍事政治學術其他ノ思想ニ於テ遙カニ後進國ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ國家ノ生産的利益ノ方面ヨリ見ルモ、幼童ニシテ殘賊スルヨリモ其ノ天賦ヲ完全ニ啓發スベキ教育ヲ施シタル後ノ勞働ガ幾百倍ノ利益ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人亦同一ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勳功ニ伴フ年金ガ現時ノ如キ消極的ノ小額ナルハ不可ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人トシ日本人タル權利ニ於テ其ノ生長ト共ニ參政權ヲ取得スベキ者ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米國ノ建國ガ社會契約説ヲ理想トシテ植民セル者ノ契約結合ナルハ前説ノ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英米ノ國情ニ於テハ必ズシモ強兵ヲ意味セズシテ、日本ノ建國ト信念トニ於テハ傭兵ハ必ズ弱兵ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "俸給ガ傭兵ノ其レト全ク別個ノ義ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ津浦鐵道ガ南北ニ分割サレテ列車ヲ直通スル能ハズ、南段ノ英資ニ對シテ北段ノ獨資ナルハ先ヅ投資的分割ニ現ハレタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我邦モ日ニ月ニ開明ニ進ム故、今日ノ古物家ガ徃日ニ異ナルハ固ヨリ論ヲ俟タザル可シ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬ヘバ暖カナル結果ハ太陽ノ上ル源因ニ由リ、寒キ結果ハ雪ノ降ルニ由ルト言フガ如ク、人事ニテ言ヘバ、家屋ノ美麗ナルハ其家富ムト云フ源因ニ由リ、其國治ルトハ其政善シト云フ源因ニ由ルト云フガ如ク、萬事ニ其結果ヲ推シテ其源因ニ遡ル性アリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "弥※望ムニ黄茅白葦ナルハイハユル那須ノ原ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "人倫ノ大ナルハ、父子ヲ先トシ、尊卑ノコトナルハ、君臣ヲ重シトスト。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、べつな書には――曲レルハ牛ノ頭トシ、双ナルハ牛ノ脚トシ、横ナルハ牛ノ頸トシ、転ズルハ牛ノ背トシ、方ナルハ牛ノ腹トシ、立テルハ牛ノ角トシ、鞅（胸ノ綱）鞦（尾ノ綱）備ワリ、軸、双、轅（ながえ）ヲ仰グ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
