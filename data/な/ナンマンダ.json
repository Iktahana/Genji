        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "地方文化、あなどるべからず、ナンマンダ、ナンマンダ、などと、うわごとに似たとりとめない独り言を呟いて、いつのまにか眠ったようだ。",
              "citation": {
                "source": "母",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "閉口し切って、ナンマンダ、ナンマンダ、と大声挙げて、百遍以上となえたこともある。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ナンマンダブ、ナンマンダブ……。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンマンダブツ、ナンマンダブツだわ、それこそ……。",
              "citation": {
                "source": "医術の進歩",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "お寺の障子をしめきって、細目にあけて、ナンマンダブ、ナンマンダブ、ふるえながらのぞいていると、ホラブンは何の構えもなくノコノコと門の下へ行って、棒をつきだして、「チョーセイ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "老婆連は本当に祭神の化身と信じて、ありがたや、もッたいなや、ナンマンダブ、ナンマンダブと拝んでいる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はひるまず、「ナンマンダブ」をとなえた。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ「ナムアミダブツ」「ナムマミダブ」「ナンマンダ」などと称えます。",
              "citation": {
                "source": "益子の絵土瓶",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
