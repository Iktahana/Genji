[
  {
    "uuid": "d7a96683-f87f-5e64-ad61-c97af6c198b8",
    "entry": "泣きまね",
    "reading": {
      "primary": "なきまね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "feigned tears",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供は母親の気を引くために、わざと泣きまねをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の泣きまねはとても上手で、一瞬本気で泣いているのかと思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ほら、また泣きまねしてる！」と、姉が弟をからかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あしたは日曜日なのねえ、つい忘れていて、さ、あしたは早く出かけてと云ったら、たかちゃんに笑われて、アアーンアアーンと泣きまねをいたしました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ころがされるままになって、顔を塵の中にこすりつけながら泣きまねをした。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "お※ちやんは泣きまねが上手だつた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣きまねなんかなすってもだめ、ぴしりっ。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとが笑へばにやにやと、猫のなきまね、烏啼き、たまにやべそかき赤い舌、嘘か、色眼か、涙顔。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
