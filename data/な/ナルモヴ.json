        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「で、君はどうだったのだい、スーリン」と、主人公のナルモヴが訊いた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "八十にもなったお婆さんがプントをしないのを、何も不思議がることはないじゃないか」と、ナルモヴが言った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はそうは考えないね」「なんだ」と、ナルモヴが言った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "え、おまえはどうしてナルモヴが工兵隊だろうなどと考えたのだ」　こう言い捨てて、トムスキイは祖母の部屋を出て行った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしナルモヴが、工兵士官でないと聞いて、彼女は前後の考えもなしに、自分の心の秘密を気軽なトムスキイに洩らしてしまったことを後悔した。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルモヴは彼にヘルマンを引き合わせた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルモヴは笑いながら、ヘルマンが長いあいだ守っていた――骨牌を手にしないという誓いを破ったことを祝って、彼のために幸先のいいように望んだ。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こいつ、どうかしているぞ」と、ナルモヴは思った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルモヴがまだ茫然としている間に、彼はレモネードを一杯飲んで、家へ帰ってしまった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
