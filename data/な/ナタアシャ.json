        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　医専の美少年のＭがしきりに娘のナタアシャ（そういう名だったと思うがちがったかも知れぬ）へせびっていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナタアシャは顔を赤くして反射的に編針を持った片手をうち振っていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから私たちもペチカの前へ引き帰すと、娘のナタアシャも蹤いて来た。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナタアシャ、君もひとつ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ナタアシャはほっほと笑った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてイワンとナタアシャと自分とを指ざした。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナタアシャの顔も出た。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　イワンがナタアシャを突き飛ばしそうにした。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナタアシャはイワンの肩を撲った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピエールもアンドレー公も、ナタアシャも皆愛すべき人である。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナタアシャが誘惑されて行くところの心理は何と云う立派に描き出されて居ることだろう。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "イワンは石投げの支度にかかり、ナタアシャは小猫を抱いて泣いている。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "○ペーペル、ナタアシャと新しい生活にはいる希望をもつ。",
              "citation": {
                "source": "『どん底』ノート",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
