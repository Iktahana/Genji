        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「フーン、ツマンナイネ、ア、シロイ　ハツパガ　トンデ　ユク」「アレハ　ハツパヂヤ　ナイコト、テフテフヨ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ワカルハズノナイコトマデ……。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハツマリ、構成ガ単純デ、劃ガ少ナク線ガ直線的デカツ規則的ナタメ、書クニモ読ムニモマチガウ機会ガ少ナイコトヲ意味スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "再ビ生キテ皆サマニオ目ニカカレナイコトト覚悟ヲシテイマス。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、つい、その戸じまり一重次になった臨時お台所で、「ツマンナイコト無イデス」と言う、がんまりした、その上、多分の寸伸びを持った応対。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "古風ナ人情トモ云ヘルガ、嬉シクナイコトモナイ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ若サデソンナ意気地ノナイコトデドウスル」「陸子ハ嫁ニ行ッテカラ今マデ一度モコンナ話ヲ持ッテ来タコトハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハコルセットヨリ柔イ布デ頤ヲ吊ルダケデアルカラ、コルセットホド窮屈デハナイガ、首ヲ動カセナイコトハ同ジデ、天井ヲ睨ンダマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トテモソンナコトヲ予ガ許ス筈ガナイコトヲ、婆サンモ颯子モ知ッテイルカラデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿道ノ故障ハ今朝ハ一応良クナッタノデ、行ッテ行カレナイコトハナイノダガ、夜ノ外出ナド飛ンデモアリマセント云ッテ、佐々木ガ承知シナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「嘘デナイコトガ分ッタ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドッチダッテ構ヤシナイサ」「構ワナイコトハナイワヨ」「チョット云ットクガ、君ノ方ガ僕ヲ誤解シテヤシナイカ」「ドウ云ウ風ニ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚当座ノ浄吉ハ大シタ打チ込ミ方デアッタガ、今デハソレホドデナイコトハ確カダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、今朝ハ、ダン／＼意識ガハッキリシテ来ルニ従イ、ソノピイピイト云ウ声ガ、現ニ佐々木看護婦トベッドヲ並ベテイルコノ部屋ノ中デ聞エテイルノニ違イナイコトニ心ヅク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ニハヨクアルコトデゴザイマス」「ジャ、君ハ前カラ知ッテタノカ」「ハア、近頃ハ毎朝伺ッテオリマシタ、ピイピイッテ、オ可愛ラシイオ声デ」「婆サンニモコノ声ヲ聞カシテヤロウ」「知ッテラッシャイマスヨ、ソンナコト」「颯子ガ聞イタラ笑ウダロウナ」「若奥様ダッテ御存知ナイコトガアルモンデスカ」五日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ母ニ違イナイコトハ分ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ情ナイ姿ノトコロヲ彼女ニ見ラレテハ極マリガ悪イ、ト、思ッタ途端ニコノ言葉ガ出タノデアルガ、正直ヲ云ウト来テ貰イタクナイコトモナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ彼女ヲソウサセタノニハ予ニモ責任ガナイコトハナイガ、浄吉ノ奴ハ亭主ノ癖ニ最初カラ彼女ニ一目置クヨウナ素振ヲ見セテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ颯子ト同様ニ偽悪趣味ガアリ、男ノ癖ニ泣クナンテ見ットモナイト思ッテイルノダガ、ソノ実案外涙脆クッテ、屁デモナイコトニ訳モナク涙ガ出ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カヨイ治療法ハナイモノデショウカ、御老人デイラッシャルノデ、牽引法ソノ他手数ノカヽル面倒ナ方法ハオイヤナンデスガ、ト云ッタトコロ、ソレニハ方法ガナイコトハナイト、博士ガ云ワレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスルタメニハ、アマリニ颯子ノ容貌ニ露骨ニ酷似スルヨウニシナイコトダ、ボンヤリト彼女ノ感ジヲ匂ワセルヨウニスルコトダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ爺サンハ発狂シテルノデハナイカト、思ワレルダケデモ極マリガ悪イ）予ハコヽマデ思イ詰メテ、コヽニ一ツノ可能ナ方法ガアルカモ知レナイコトニ気ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘラヘラト、馬鹿ニシタヨウナ笑イカタヲシテ、「途方モナイコト、イイ出スモンジャナ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "チキュウノニンゲンノ、デキナイコト、デキル。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
