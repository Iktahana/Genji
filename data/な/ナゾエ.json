  {
    "uuid": "ac697ff8-ffc2-5a67-a831-c409f0b8b8fe",
    "entry": "謎絵",
    "reading": {
      "primary": "なぞえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
