        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "でも、のぞみとあらば、来月あたり、君たちに向って何か言ってあげてもかまわないが、君たちは、キタナクテね。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで勝ったと思っているのだから、キタナクテね。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "哲学ハ、知ヘノ愛デハナクテ、真実ノ知トシテ成立セシムベキ様ノ体系知デアル、ヘエゲル先生ノコノ言葉、一学兄ニ教エラレタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルハ　コロサナクテ　ヨイ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　五ニンノ　サムライハ　サルヲ　キラナクテ　ヨカツタ　コトヲ、メニ　ナミダヲ　タメテ　ヨロコビマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、君チャンハヨナカニ目ヲサマスト、ブルブルフルエナガラ、何ンダカオッカナクテ、オ母ッチャトコエモ出セズニ、ソート手ダケヲノバシテヤッテ、ユスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "久しいイナクティブな生活にもあきた。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニイマ一ツ活字トイウモノハ歯ギレガヨクナクテハイケナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "御客様ハ御帰リニナルソウダカラ、寝床ノ仕度ハシナクテモ好イヨ。",
              "citation": {
                "source": "魔術",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆々様オカワリナクテ、ケッコウデスネ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハ、コンゲツ一パイメッタニ雨モフラズ、カゼモナクテ、マイニチマイニチヤケルホドアツクテ、ワタシハモウスコシデ、クタバッテシマフトコロデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、コノ前アナタノ十家ヘアガッタ時ハ、ヒドイ御病気デ、トウ／＼アナタニアフコトガ出来ナクテ、ザンネンデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　シカタガナクテ、汽車ノナカノアミダナニモグリコミマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデナクテモ陸子夫婦ニ子供ガ三人デ、狭過ギテ困ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデナクテモ「若奥様」ノ権力ガ日ニ日ニ「御隠居様」ヲ凌ギツヽアルノニ、犬一匹ノ処置ノ問題ガ因ニナッテドンナ大喧嘩ニナルカモ知レナイ、ソレヲ思ウトウッカリ戦端ヲ開ク訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日デナクテモヨカッタノダガ、犬ノ事件ヲ早速佐々木ガ知ラセタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「最モ痛イ時ヲ狙ッテ」ト云ッタガ、本当ニ痛イ時デナクテモイヽ、痛イ振リヲシテヤレバイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモソンナニ古イ形ノモノデナクテモイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ若奥様マコトニ恐レ入リマシタ、折角オ寝ミノトコロヲオ起シ申シ上ゲタリシマシテ、勿体ナクテ罰ガ当リマス」佐々木ガ頻リニクド／＼ト特別ナ言葉デ礼ヲ云イナガラ五子ト共ニ出テ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデノヨウナ譫語ジミタ云イ方デハナクテ、底力ノアル、訴エルヨウナ、叫ブヨウナ声デ呼ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙デハナク、新サンカ、ワタシカガ、出カケナクテハナラナイノデスケド、マダ宴会ハスンデ居ランシ、後始末モアルノデ、手紙デ、許シテ下サイ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
