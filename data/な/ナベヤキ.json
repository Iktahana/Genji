        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山小屋の食堂で食べた、熱々の鍋焼きうどんの味が忘れられない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鍋焼きのうどんは最後まで冷めにくいので、冬のアウトドアランチに最適だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今日は疲れたから、スーパーで鍋焼きのセットを買って簡単に済ませよう」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "部屋へ持って帰って、みんなで鍋焼きにしようと思っただけよ」と、中間は大きい眼をひからせて云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はロースを註文してばさばさと飯をたべ始めたが、さっきの鍋焼きで、腹工合はいっぱいだった。",
              "citation": {
                "source": "貸家探し",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中世子の側に仕えているものは、一層謹慎しているから、外へ出て酒を飲むといっても、その頃から流行出した、軍鶏とか家鴨とかの鍋焼き店へ行く位のものであった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "何気なく、するりと抜けて、歩んで行く、闇太郎の、肩越しに追い抜きながら、「隆達くずしでもあるまいぜ、あの小屋の中に、鍋焼きを啜っていた人数は、七、八人。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "りつ子は巧みにやった、拳二つほどの大きさの石を三つ並べ、包みの中から平たい鉄の鍋を出して掛け、火を燃しつけてから、もろこしの粉を練り、鍋を油でぬぐってから、もろこしをゆっくりと鍋焼きにした。",
              "citation": {
                "source": "おごそかな渇き",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼き饂飩の熱いのをフウフウ吹いて食べ終ると、今夜の客はどうだったの、目明しがどうしたのと、お蝶には意味の分らない会話がベチャクチャ交わされていましたが、そのうちにべつの部屋で、お千代を中心に銭の音をさせて、皆も鶴吉夫婦も、それぞれ枕について寝入りました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮に時鳥の小鍋焼きの話などが、この日の耳学問の記念ではなかったとしても、その感化がなければボットサケタという啼き声は出て来まい。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "○わすれて行った本　届ける　つい　そこだって○なべやきうどんを云いつけにゆく○待っている　約束のハガキのよみちがい○お菓子のこと「あら　それをみんなたべちゃっちゃ駄目よ」○気持よさそうなので　そうすると　ローソクの灯が　急にぱっと明るくなったように　くつろいで楽に居心地よくなった。",
              "citation": {
                "source": "無題（十三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "寿の荷物のあったのは食堂の向いの板じき室、あの元の食堂、あの頃畳で、壁に深紅の唐草の紙が張ってあり、なべやき召上ったあの室。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "すし、カツサンド、なべやき、それに天丼といふ取り合せが可笑しい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼うどんや夜鷹もまたしばしば橋の袂を選んで店を張った。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでわれわれは身を投げるか、弁慶の薙刀の※となるか、夜鷹に食われるか、それともまた鍋焼うどんに腹をこしらえて行手の旅を急ぐかである。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鍋焼饂飩…」　と高らかに、舞台で目を眠るまで仰向いて呼んだ。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おでん、鍋焼、驕る、といって、一升買わせて、あの白い妾。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "新坂を下りると鍋焼うどんが居ました。",
              "citation": {
                "source": "夜の赤坂",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の中を草鞋穿いて、蓑着て揖譲するなんざ、惚気て鍋焼を奢るより、資本のかからぬ演劇だもの。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて山から出て来た猪が、年の若さの向う不見、この女に恋をして、座敷で逢えぬ懐中の寂しさに、夜更けて滝の家の前を可懐しげに通る、とそこに、鍋焼が居た。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼｜饂飩は江戸児でない、多くは信州の山男と聞く。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼が来て荷をおろす。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "却つて遠くに売りあるく鍋焼饂飩の呼び声の、幽に外方より家の中に浸みこみ来るほどなりけり。",
              "citation": {
                "source": "五重塔",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえって遠くに売りあるく鍋焼｜饂飩の呼び声の、幽かに外方より家の中に浸みこみ来たるほどなりけり。",
              "citation": {
                "source": "五重塔",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」「御膳も碌に召しやがらずに」　確められて文三急に萎れかけた……が、ふと気をかえて、「ヘ、ヘ、ヘ、御膳も召上らずに……今に鍋焼饂飩でも喰たくなるだろう」　おかしな事をいうとは思ッたが、使に出ていて今朝の騒動を知らないから、お鍋はそのまま降りてしまう。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "河岸縁には鍋焼饂飩がぱたぱたやつてるではないか。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には鍋焼饂飩さへ買つてくれた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には鍋焼饂飩さえ買ってくれた。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "『近代詩歌』の四月号に彼の詩『鍋焼うどん』といふのがあり宵暗の都市に親子の貧しい、うどん売子の熱いアルミニュームの鍋に、彼が渇いた唇をあてゝ『子がしつらへて親がはこぶなり』とせち辛い浮世の味ひを歌つてゐたので私は彼に旭川の鍋焼を喰べに来いと葉書をやつた。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの鍋焼うどんなども江戸以来の売り物ではない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼うどんが東京に入り込んで来たのは明治以後のことで、黙阿弥の「嶋鵆月白浪」は明治十四年の作であるが、その招魂社鳥居前の場で、堀の内まいりの男が夜そばを食いながら、以前とちがって夜鷹そばは売り手が少なくなって、その代りに鍋焼うどんが一年増しに多くなった、と話しているのを見ても知られる。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜そば売りも今ではみな鍋焼うどんに変ってしまった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "――鍋焼でも喰いたいな。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
