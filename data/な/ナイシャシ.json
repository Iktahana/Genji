        "examples": {
          "standard": [
            {
              "text": "幼い頃から内斜視の傾向があったため、眼科で視力矯正の訓練を受けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は左目が内斜視気味で、集中して物を見るときに少し視線が内側に寄る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "手術によって内斜視が改善され、以前よりも両眼視がスムーズになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "顔は長大で、鼻が西洋人みたように鷲型で、白い眉が房々として、高い小鼻の左右に眼窩が深く落凹んで、心持ち内斜視の老眼が鋭く光っていた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
