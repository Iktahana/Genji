        "examples": {
          "standard": [
            {
              "text": "ボクサーは相手を殴り倒し、見事なKO勝利を収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "強風が電柱を殴り倒し、一帯が停電した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は不意打ちで背後から殴り倒された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は爆弾の安全弁を外すと、そこへ飛びだした敵の水兵を片手で殴り倒すが早いか、爆弾を抱えたまま、爆弾庫の中に身をおどらせてとびこんだ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "極端な場合、殴り倒すことも出来るが、一体誰がこの勇気あるかわいい若い女性に意見したり、いさめたり出来ようか。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカ在郷軍人団の制服を着た男が、彼女を殴り、ほかに二〇名以上の男たち――男、という呼び名すらもったいない――が、ひとりの黒人女性を殴り倒すことに参加したのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "大声を上げたら、殴り倒すぞ。",
              "citation": {
                "source": "鉄面皮",
                "author": "A Front of Brass",
                "note": "青空文庫"
              }
            },
            {
              "text": "（偉張って、相手をなぐり倒す恰好）それ、みんな駄目！",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなわけで、ハーキュリーズが彼の棍棒で、その巨人をひどくなぐり倒せばなぐり倒すほど、勝つ見込みがなくなってくるような気がしました。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに気がついた透明人間は、警官をなぐり倒すと、ちくしょう！",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
