  {
    "uuid": "f9527a8b-6b57-547d-9eac-5a2723f079fb",
    "entry": "長らえる",
    "reading": {
      "primary": "ながらえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-ア行",
      "inflections": null,
