        "examples": {
          "standard": [
            {
              "text": "滋賀県の伝統的ななれ鮨は、独特の発酵臭がクセになる味わいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "なれ鮨の歴史を辿ると、寿司のルーツである魚の保存食に行き着く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "初めて食べるなれ鮨の濃厚な旨味に、日本酒がどんどん進んでしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "河鹿は縁日もの、振り売りの手合いからは決して買わぬもの、これも三歳以下なはまだ籠なれずして鳴きも歌わず、どうかすると姿ばかりがよく似た蛙めを掴まされることさえある。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
