        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女がナイティを着ているのを見て、僕は一瞬ドキッとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "バレンタインデーに奥さんがピンク色のナイティを受け取って嬉しそうに笑った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子供たちはナイティを着て元気に走り回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その中にはミネルバの像や、ゲーテや、クロムウェルや、ナイティンゲール女史やの肖像があった。",
              "citation": {
                "source": "小さき者へ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「我我は坂を登る途中、ナイティンゲエルの声に近い鶯の声を耳にした。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはルビヤック作のナイティンゲール夫人の墓である。",
              "citation": {
                "source": "ウェストミンスター寺院",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "（c）パナイティオスがプラトンを呼んで「哲学者中のホメロス」といったのは、最上級の賛辞ではなかったろうか。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある若者が哲学者パナイティオスに向って、恋をすることは賢者にふさわしいかときいた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "（c）スキピオ・アフリカヌスの賞賛すべき特質を知っていた人々は、彼が賄賂を受けなかったからといってパナイティオスが彼に与えた光栄を、しりぞけた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
