[
  {
    "uuid": "36e27319-810c-5536-b23b-1a9ca184c6e0",
    "entry": "尚々",
    "reading": {
      "primary": "なおなお",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "all the more",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は優しい人だが、困っている人には尚々親切に接する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "美しい景色だが、実際に訪れてみると尚々その魅力がわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の話はいつも面白いが、今日の話は尚々興味深かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」　ああそうかと、私は心にうなずいて今度は尚々、単純な声調で、　さくら、さくら、弥生の空は、見渡す限り。",
              "citation": {
                "source": "雪の日",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "熟柿くさい息をハーハー吸きながら売上りの銭を目の前にならべて今日の売高がすくないと小さい娘を叱かりつけて居る恐しげな父親の様子が思い出されて、娘が可哀そうだと思う心は尚々まして来る。",
              "citation": {
                "source": "同じ娘でも",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――弘雄は、斜めに画面を見あげながら、「斯くの如くロシアは、その本国に尚々強大極まりもなき兵力を抱擁するに反し、吾は既に有らん限りの兵力を用ひ尽したるなり、而して開戦以来にうしなひたる多くの将士を、今後容易に補充することも能はざる状態なり。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「尚々卿雲へこたび書状なし。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「尚々古庵様、服部氏、市川先生、凡私を存候人々へ宜奉願上候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "書牘の最初の三行は所謂｜尚々書である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「尚々松崎は作家也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「尚々私も追々と老耄、手もすこし宛かなはぬやうになり候故、本文代筆に候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「尚々｜御次御内上様、辞安様｜御内政様へ宜奉願上候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「尚々千蔵こと辞安様大に御せわ被下、可也にとりつづきゐ申候よし、忝奉存候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」その二百十　わたくしは此年壬辰｜閏十一月二十五日に頼山陽の未亡人里恵が広江秋水夫妻に寄せた書の後半より尚々書に亘る文を節略して上に挙げた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚々御隠居様御看病之儀、三好東安同様申合御介抱申上候様被仰付候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚々精次郎夫婦よりも宜しく可申上様申出候。",
              "citation": {
                "source": "独身",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやそれどころか却て前よりも尚々現実との境界があやしくなって行くのでした。",
              "citation": {
                "source": "歪んだ夢",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚々癇癖に障りますが、跣足で其処を出で、近辺で履物を借り、宅へ帰ったのは只今の七時頃でございます、母は心配して待って居ります。",
              "citation": {
                "source": "業平文治漂流奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云ったお関にも驚いたけれ共尚々その後に控えて居る重三の様子にすっかり面喰った。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "主家悲報大變到來・太守父子一病一死・怒髮冠を衝く・不動祠祈願・奸女を倒す・身命塵埃・死の妙所・生の苦尚々御賢父樣御元氣の筈、宜しく御傳へ可被下候。",
              "citation": {
                "source": "遺牘",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月六日西郷吉之助　大久保一藏樣尚々君公益御機嫌能、澁谷御屋敷へ被爲入候。",
              "citation": {
                "source": "遺牘",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "獄中の消息英艦來襲・君を思ひ祖母を懷ふ・無鳥郷の蝙蝠・學者の鹽梅にて可笑し・學問は御蔭にて上る尚々御煙草御惠投被成下、難有御厚禮申上候。",
              "citation": {
                "source": "遺牘",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月三日美静　　　森静男様　　　　尚々皆様へ宜敷御願申候也。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かしこ　　　尚々｜出来合之団扇等御笑らんに入候。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か音作に言ひなだめられて、お末は尚々身を慄はせて泣いた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "よかれとて契りしことも今ははたうらみらるべきはしとなりにき尚々、老母はじめ、家内のものどもよりも、本文の次第厚く御詫び申し上げ候よう、申しいで候。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚々、老母はじめ、家内のものどもよりも、本文の次第厚く御詫び申し上げ候よう、申しいで候。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚々順軒兄御渡海ノ節御同道、房州御一遊｜如何。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "其許好友の　　　　ポートマン　尚々　私え御出状之節宛名左之通ア・エル・セ・ポートマン・エスクエ、ネウヨルク・ユナイテツト・ステーツ・ヲフ・ヱメルケ・ヘルヲーフルレントメールフエ・マルセールス。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚々其元偏に頼入候。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚々明日にも御入洛待上候。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿体ない、私のような者の子によくもそんな男の子が……と言えば「あなたの肉体ではない、あなたの徹した母性愛が生んだのです」と人々もお前も、なおなお勿体ないことを言って呉れる。",
              "citation": {
                "source": "巴里のむす子へ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "方々の卜者にみて貰ったら、剣難があるの、水難があるのと云われたそうで、おっかさんはなおなお苦労しているんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
