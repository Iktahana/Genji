        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かっぽれは、それこそ親獅子のふところにかき抱かれている児獅子というような形で、顔を振り振り泣きじゃくり、はっきり聞きとれぬような、ろれつの廻らぬ口調で、くどくどと訴えはじめた。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と僕は、泣きじゃくりながら何度も言った。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東西を失い男泣きに泣いて、いまはわが身の終りと観念し、涙をこぶしで拭いて顔を挙げ、なおも泣きじゃくりながら、「かたじけなく存じます。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕の名はね、」あきらかに泣きじゃくりの声で、少年は、とぎれとぎれに言い出した。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　布団の下からは、それには答えずに、泣きじゃくりが聞えて来た。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　泣きじゃくりは、やはりつづけられて来た。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　おみちは泣きじゃくりながら起きあがった。",
              "citation": {
                "source": "十六日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」楢夫は泣きじゃくりながら頭をふりました。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ゲルダは、泣きじゃくりながら、いままでの物語や、カラスが自分のためにしてくれたことなどを、すっかり話しました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただただわたくしの浅果なたくらみからでございます――』彼女は泣きじゃくりながら、そう云うのだ。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あたし、何だか、そんなことになるのが前から判っていたような気もするの……」と彼女は泣きじゃくりながら云った。",
              "citation": {
                "source": "花嫁の訂正",
                "author": "――夫婦哲学――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして泣きじゃくりながら云うのである。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に婆やが畳の上に握っていた碁石をばらりと撒くと、泣きじゃくりをしていた八っちゃんは急に泣きやんで、婆やの膝からすべり下りてそれをおもちゃにし始めた。",
              "citation": {
                "source": "碁石を呑んだ八っちゃん",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹は頭からずぶ濡れになったままで泣きじゃくりをしながらお婆様にぴったり抱かれていました。",
              "citation": {
                "source": "溺れかけた兄妹",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出ていかねえか」　純次は泣きじゃくりの中から、こう叫んでいらだちきったように激しく地だんだを踏んだ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん激しくなり増さるような泣きじゃくりの声だけがもの凄く部屋じゅうに響いていた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤッ」　というようなまん丸い眼をして、しばらくちがった周囲に呆気にとられていたその子は、やがて、しくっしくっと泣きじゃくりを始め、「オジチャン、ここ、ジャッキーちゃんのお家じゃないんだね」「そうだよ。",
              "citation": {
                "source": "「太平洋漏水孔」漂流記",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体、熊本さん」あなたは顔をあげ、ひどく泣きじゃくりながら、話しだしました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡霊のような儚なさで、あなたはまた誰にか罵られたのか、両掌で顔をおおい、泣きじゃくりながら近づいて来るのです。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "」アラジンは泣きじゃくりながら見上げました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "一、アラジンとふしぎなランプ",
                "note": "青空文庫"
              }
            },
            {
              "text": "お滝は夜着に顔を埋めて泣きじゃくりしていた。",
              "citation": {
                "source": "狐の手帳",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、彼の傍を通って海岸の方へ往きかけたが、泣きじゃくりをしていた。",
              "citation": {
                "source": "蟇の血",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「此方にいるのはお袖さんか」　お袖は泣きじゃくりしていた。",
              "citation": {
                "source": "南北の東海道四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうしろから寝巻をしどけなく着た奥さんが、咽喉をピクピクさして泣きじゃくりながら、帯を捲き付け捲き付け出て来る模様であった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミは泣きじゃくりながら顔を上げて、女王様に尋ねました。",
              "citation": {
                "source": "ルルとミミ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
