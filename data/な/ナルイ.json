    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "たとい徳に反対する主義――例せば悪魔主義や本能主義――のようなものであっても、本質はやはり、別のユニックな正義を信ずるところの、同じ倫理線の上に立っているので、この本質の点から言うならば、世に無道徳的なるいかなる主義もないわけである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "下田先生の所謂、女徳のなよよかなるいはれにて、宥さばゆるせよかし。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん Elegy は過激なるいわゆるルーテル的の文章ではない。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はて、此方も、」　雨に、つと口を寄せた気勢で、「知れた事じゃ……肝心のその二度添どのはどうなるいの。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "磐城の相馬のは流山ぶしの歌にひびき渡りて、その地に至りしことなき人もよく知ったることなるが、しかも彼処といい此処といい、そのまつる所のものの共に妙見尊なるいとおかしく、相馬も将門にゆかりあり、秩父も将門にゆかりある地なるなど、いよいよ奇し。",
              "citation": {
                "source": "知々夫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "『いさや川』（犬上のとこの山なるいさや川いさとこたへてわが名もらすな）などというのも恋の成り立った場合の歌で、ここへは引けませんね」　と言って源氏はなお女房たちに何事かを頼んで行った。",
              "citation": {
                "source": "源氏物語",
                "author": "朝顔",
                "note": "青空文庫"
              }
            },
            {
              "text": "青き空をかすめて、ところ／″＼に立てるは、眞黒におほいなるいとすぎの木なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「笹村君は、これでもう何年になるいな。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が抱へとなりしより、早や二年なれば、事なく我等を助けんと思ひしに、人の憂に附けこみて、身勝手なるいひ掛けせんとは。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が抱えとなりしより、はや二年なれば、事なくわれらを助けんと思いしに、人の憂いにつけこみて、身勝手なるいいがけせんとは。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が抱へとなりしより、早や二年なれば、事なく我らを助けんと思ひしに、人の憂に附けこみて、身勝手なるいひ掛けせんとは。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれ、子はひたに聴き入る、珍らなるいとも可笑しきちやるめらの外の一節。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ想はむ、壺のまろみの幽かなるいぶしねずみに。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人なるいのちの息の、おのづから触れかよふかな。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人なるいのちの息のおのづから触れかよふかな。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "まてまて、今おれが気つけ薬を飲ましてやらあ」　いいつつ、ずかずかとそれなるいぶかしき老大尽の身近くに歩きよったかと思われましたが、こはそもいかなる気つけ薬を飲ませようというつもりでありましたろう――やにわに、ぎらりと鞘ばしらせたものは、あの蝋色鞘の細身なる一刀でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "ましてや、だんなのごとく二十五にも六にもなるいいわけえ者が、日の上がるまでも寝ているってことはねえんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは単なるいたずらでない、自分たちの意趣遺恨でもない、恐らく何者にか頼まれたのであろう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "歩兵の髪切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦なるいのち　は――繁き矢　なり――積みて　重なる　夢　の　小船。",
              "citation": {
                "source": "黒き素船",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹いはば巫覡嚴らしく皺める人に説くに似て、夢といふなるいつはりを、鼻うそやぎに見て知りぬ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ以上に明白なるいかなる規準も存在しないと私は考える。",
              "citation": {
                "source": "戦争責任者の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "空高く、とこしへに無聲なるいつの時より、空高く、奧深くして風荒るる天上のいづこの庭に、空高く、いづれの太陽を央にして、ものに譬ふれば火焔の蜂の巣をさながらに、勢力｜彌漫したる虚空の大壯觀中、幾千萬の不可思議にして壯烈なる星の巣立は飛散す。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "……死んだ母親は醫者にしたがつてましたが、本人は軍人になるいうてますよつて、軍人にしようおもてます。",
              "citation": {
                "source": "父の婚禮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それは、不浄なるいやしい笑ひでは更にない。",
              "citation": {
                "source": "美術上の婦人",
                "author": "岸田劉生",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、奉行という御役目で御出会いになるいろいろの事件の為に、その御考えのもち方は今まで可なり御変りになったように存ぜられるのでございます。",
              "citation": {
                "source": "殺された天一坊",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さえの家庭は母親のしもと、兄嫁のすぎと、その子の三郎といふ九つになる息子と七つになるいまといふ娘との四人暮しである。",
              "citation": {
                "source": "うき草",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ながいあいだ、私をいたわり、はるかなるいのりを送っていてくれた善き友を、このように、朝夕、私のそばに持つことのできるのは、神様の恵みなのでございましょう。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイツとパリとで、見当り次第に、何かおみやげになるいいものを買って帰る事にする。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "げにけふの思ひは惱みに暗くそはおもたく沼地に渇きて苦痛なりいづこに空虚のみつべきありや風なき野道に遊戲をすてよわれらの生活は失踪せり。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我れまさに年老いて家郷なく妻子離散して孤獨なりいかんぞまた漂泊の悔を知らむ。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
