          "literary": [
            {
              "text": "社會主義ガ私有財産ノ確立セル近代革命ノ個人主義民主主義ノ進化ヲ繼承セル者ナリトハ此ノ故ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞働者ハ其ノ勞働ヲ賣却スル者ナリトハ舊派經濟學ノ誤説ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸地方諸人民ヲ通ジテ石器時代ハ今ヨリ何程以前ナリトハ决シテ云フ事能ハザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ石器時代ノ人民ナルノ故ヲ以テ甲ハ乙ノ後裔ナリトハ云フ能ハズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ石器時代ノ人民ナルノ故ヲ以テ甲ト乙トハ同種族ノモノナリトハ云フ能ハズ。",
              "citation": {
