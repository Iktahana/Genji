        "examples": {
          "standard": [
            {
              "text": "古本屋で探していた希少本を見つけたが、状態は並品だったので少し迷った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "高級な贈り物には向かないが、自宅で使う分にはこの並品のタオルで十分だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ネットオークションで並品のカメラを安く手に入れたが、動作には全く問題なかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "江戸時代の第一流といわれた鳥料理店では、この原料の優良なものを集めることに非常な苦心をしたものだそうで、優等品は並品の三倍以上もするということが判った。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            }
          ]
