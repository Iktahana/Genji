[
  {
    "uuid": "f44e5f2d-4638-5c28-b093-a0fb76450f77",
    "entry": "内科",
    "reading": {
      "primary": "ないか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
