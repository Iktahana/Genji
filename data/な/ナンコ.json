[
  {
    "uuid": "4a84c7f1-1de9-5e3d-8e2b-cc29300a4179",
    "entry": "何個",
    "reading": {
      "primary": "なんこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "how many pieces",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「この箱の中にリンゴが何個入っているか、当ててみてください」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "チョコレートを一度に何個まで食べていいか、母に厳しく制限されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「予備の電球は何個残っていますか？」「棚の奥にあと3個あります」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一般に母音で始まり次にいずれか任意の一つの子音の来る場合が火山の表中で何個あるかを数えてみる。",
              "citation": {
                "source": "火山の名について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてそれらの断片が何個集まって一つの系列あるいはエピソードを成すかを決定してその全長を計算し、そういう系列の何個が全編を成すかを定めなければならない。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、此樣な絶島の事だから、决して立派な建築ではない、けれど可なり巨大な板家で、門には海軍の家と筆太に記され、長き、不恰好な室が何個も並んで見へるのは、部下卅七｜名の水兵等と同居の爲だらう。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "一個八十銭の西瓜で十銭の切身何個と胸算用して、柳吉がハラハラすると、種吉は、「切身でまけて丸口で儲けるんや。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一個八十銭の西瓜で十銭の切身何個と胸算用して、柳吉がハラハラすると、種吉は「切身で釣って、丸口で儲けるんや。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな風でこの伊豆には模範村と表彰された村が全体で何個村とかあると云う事であった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初籠に入れてあった卵は何個だったでしょうか。",
              "citation": {
                "source": "新学期行進曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初、籠にあった卵は何個だったでしょうか。",
              "citation": {
                "source": "新学期行進曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめからエクセントリックな人間なことはツインコタの人も皆知っていたが、夜になると寝室の窓に灯りが映るだけで、家は何個月経っても閉め切りである。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "集積回路ではトランジスター、ダイオード、コンデンサー、抵抗などの機能が作り込まれて回路が実現されているが、ゲートはこれらの〈部品〉がつごう何個分集められているかを示す。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、はかどらないどころか、修理の手をつければつけるほど、あっちもこっちも悪くなって、一個所を直すたびに、更に他の何個所かががたがたしてくるのであった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうへ、煙草一株につき冥加として葉の極上の部分を選んで半分とられ、又、それらの物品が揃はぬときは、茄子一本につき何個といふ割当の賦課か、或ひは、何物かの年貢を納めねばならなかつた。",
              "citation": {
                "source": "島原の乱雑記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "りんごはどれを、何個さしあげますか」　やわらかい女の声がひびいた。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「りんごは何個さしあげますか」ふたたび美しい声が、たずねた。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は四十何個条かの非常に詳細な、だから極めて平等な、十分に自由な条約を訂結している。",
              "citation": {
                "source": "幸福な家庭",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "12　あなたは、何個国語を話しますか。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手よりに、タンポポの樹海のこずえ越しに巨大なラッパの頭のようなものが大小十何個、ぬっと出ている。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一貫目の茄子が、何個ほどあるか知らない。",
              "citation": {
                "source": "食べもの",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸大名宿泊のおりの人数、旅籠賃から、入り用の風呂何本、火鉢何個、燭台何本というようなことまで、事こまかに記しつけてある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "屏風何｜双、手燭何｜挺、燭台何挺、火鉢何個、煙草盆何個、草履何足、幕何張、それに供の衆何十人前の膳飯の用意をも忘れてはならない。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩はある音楽者の客もあって、火鉢が何個も出た。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「英霊何個」　十一月の十一日にマニラに帰り着いた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々なことをいったあげく、「この中に英霊を持っている人があったら、何個あるか、その数を届けて下さい」といって立去った。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「名前を知っていますか」「Ａ大尉といいます」「あなたはＡ大尉が、たった今、英霊何個といったのを聞きましたか」「ああ、そういえば、そんなことをいっていましたね」……。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに不注意とはいえ、英霊を何個と呼ぶ大尉、それを変だとも無礼だとも思わぬ人達。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その馬具屋では英国式だと教えてくれたが、ふるくから札幌でつくるもので、皮のベルトに何個か上むきにならべてつける。",
              "citation": {
                "source": "望郷",
                "author": "――北海道初行脚――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうだ諸君こうやって出そうとすれば、何個でも出せる。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "下樣の繩暖簾とはことかはりて、醉うても聞き苦しきいさかひはなけれど、苟めの物語も高聲になり、默してやみなんことも笑ひさざめき、座中自ら春を生ずる自らはよけれど、他人の閑を破るはにくし。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、ウルスガァルでふんぞりかへつて、したい放題のことをしてゐるその死の中に……　よし誰が侍從ブリッゲに對して、そんな死ではなしに、もつと他の死を死なんことを希望したにせよ、どうして彼はそんなことに構つただらうか？",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらず、いかで自殺なる二字をもってこの二人の怪しき挙動の秘密を解き得べきぞ、貴嬢がいわゆる人とは自ら生きんことを計り自ら死なんことを謀る動物なるべし、この二つの一つを出でざる動物なるべし。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
