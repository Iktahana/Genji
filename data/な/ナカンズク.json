[
  {
    "uuid": "cd603c95-ba96-50a9-9bf6-f88ee08fecb9",
    "entry": "就中",
    "reading": {
      "primary": "なかんずく",
      "alternatives": [
        "なかんづく"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "especially",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼のコレクションはどれも素晴らしいが、就中、この希少な切手には目を見張るものがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地域の冬は寒い日が多いが、就中、早朝の冷え込みは格別だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私は旅行が好きだが、就中、歴史ある街並みを散策するのが一番楽しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "だが就中、科學はその最も代表的なものである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に就中蕪村の如く、文化が彼の芸術と逆流しているところの、一の「悪しき時代」に生れた者は、特に救いがたく不遇である。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（すべての日本的な物は梅雨臭いのである）特に就中、自然と人生を一元的に見て、季節を詩の主題とする俳句の如き文学では、この影響が著しい。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に就中、加賀千代女等によつて代表される人情的月並俳句である。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし多くの物の中で、就中最も感銘が深かつたのは、彼のシベリア流刑記を自傳した「死人の家」であつた。",
              "citation": {
                "source": "初めてドストイェフスキイを讀んだ頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中、信州の渋とか湯田中といふやうな百姓めいた温泉、言はば「田舎者の湯治場」といつた感じのする所は何より嫌ひだ。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中夏の雪は、高山の資格を標示する徽章である。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中山岳の雪は、研究の対象として最も興味のある題目である。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中高山植物の美麗は熱帯の壮大華麗なる花を凌ぐのであるが、高山植物の美観は他日題を改めて説くつもりである。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に就中、身邊記事のくだらない出來事を、茶呑み婆さんの繰言みたいに、絮々細々と――文壇の術語で言へば克明に――書き立てた日本の文壇小説に至つては、義務にも讀めた次第でない。",
              "citation": {
                "source": "芥川龍之介の追憶",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に「抒情小曲集」と「忘春詩集」の二詩集は就中また小學一年生の作文を典型してゐるが、不思議なことには、それがまた彼の作品中で一番よく、讀者の胸に乘りかけてくる、詩情の最も強いものを高調してゐる。",
              "citation": {
                "source": "室生犀星君の人物について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の◇三詩集「邪宗門」「思ひ出」「東京景物詩」は、何れも後世に傳ふべき名詩集であるが、就中その最も圓熟せるは「思ひ出」である。",
              "citation": {
                "source": "名詩集「思ひ出」の眞價",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの窓には詩話會の親しい友人、室生や佐藤や川路や福田や、それから就中百田宗治の四角な笑顏がのぞいてゐることを想像してゐた。",
              "citation": {
                "source": "大船驛で",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に就中、酒を飮む人たちはよく知つてる。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中、その性慾は、ああした病気に特有な一種の恐ろしい熱病的執拗をもつて、絶えず此の不幸な青年を苦しめたものである。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタリアでは就中ヴェネチアが好なのです。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、あらゆるものの匂つてゐる、この部屋の中に居ることは、就中、犬どもを頗る亢奮させてゐるらしかつた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中、そのいくつかの詩と、戯曲とは非常にすぐれたものである。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中近頃の小説の文章に、音律といふことが忽にされて居る、何うして忽せ處ではない、頭から文章の音律などは注意もしてゐないやうに思ふ。",
              "citation": {
                "source": "文章の音律",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅立羽、烏羽揚羽、黄と白の名からして、おつにん蝶、就中、（小紫）などといふのが周囲についてゐますから、一寸山から出さうにもありませんな。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中御徒士町仲徒士町竹町等は氾濫の中心となるの勢あり。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中、銑太郎などは、自分釣棹をねだって、貴郎が何です、と一言の下に叔母御に拒絶された怨があるから、その祟り容易ならずと可知矣。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人、日本橋に褄を取って、表看板の諸芸｜一通恥かしからず心得た中にも、下方に妙を得て、就中、笛は名誉の名取であるから。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さよう、……就中、それが、葛木さんの目と一所にぱちばちと瞬きするじゃね、――声を曇らして、姉と云う御婦人の事も言われた――　私は別世間を見たです。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "後なる一人は、中脊の細い男で、眞中の、其の盲目婦の髮の影にも隱れさうに、帶に體を附着けて行違つたのであるから、形、恰好、孰れも判然としない中に、此の三｜人目のが就中朧に見えた。",
              "citation": {
                "source": "三人の盲の話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時、就中御歳寄の君つと褥を進め給ひ、「御用の趣餘の儀にあらず、其方達も豫て存ずる如く豆州御勝手許不如意につき、此度御改革相成る奉行の儀、我等相談の上にて、杢汝に申付くるぞ、辭退はかまへて無用なり」と嚴に申渡さるれば、並居る老職、諸役人、耳を欹て眼を※れり。",
              "citation": {
                "source": "十萬石",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "素足草履穿にて、その淡き姿を顕わし、静に出でて、就中杉の巨木の幹に凭りつつ――間。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "親仁は、てくてくと歩み寄ると、閣翁父子の背後へ、就中、翁の尻へ、いきなり服の尻をおッつけるがごとくにして、背合せに立った。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中喫茶店は、貴婦人社会にさるものありと衆も識りたる深川綾子、花の盛の春は過ぎても、恋草茂る女盛り、若葉の雫滴たるごとき愛嬌を四方に振撒き、多恨多情の八方睨に大方の君子を殺して黄金の汁を吸取ること長鯨が百川を吸うがごとし。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中、風呂敷にも袂にも懐にも盗みあまって、手当次第に家々から、夥間が大道へ投散らした、霰のごとき衣類調度は、ひた流しにずるずると、山から海へ掃き出して、ここにあらかじめ纜った船に、堆く積み上げた。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
