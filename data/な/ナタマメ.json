    "definitions": [
      {
        "index": 1,
        "gloss": "sword bean (Canavalia gladiata)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭のフェンスに這わせたなた豆が、私の手のひらよりも大きな鞘をつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "なた豆茶は体に良いと聞いて、毎日欠かさず飲むようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "福神漬けの中に入っている、あの歯ごたえの良い不思議な形の野菜がなた豆だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "やれ、南瓜も飛び出せ、牛蒡も踊り出せ、枝豆、隠元、ささぎ豆、なた豆、落花生に胡麻の種、莢がはぢけた、赤ちやけた、化猫、雉猫、かま鼬、粟が尻尾を黄に垂れた。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "大根、桜島、蕪菜、朝鮮芋（さつま芋）、荒苧（里芋）、豌豆、唐豆（そら豆）、あずき、ささげ、大豆、なた豆、何でもあった。",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちらりと見ると、岸にのぞんだ大きな柳の陰に、だれを乗せてきたのか、だれを待っているのか、こざっぱりとした伝馬が一艘やはりつながれてあって、六十がらみの日にやけた船頭が、ぷかりぷかりとのどかになた豆ギセルから紫の煙を吐いているのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸徳はなた豆煙管をたゝいて、時勢を論じたさうだ。",
              "citation": {
                "source": "幸徳秋水と僕",
                "author": "――反逆児の悩みを語る――",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀のなた豆ぎせるを指にはさんでくるくるまわした。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀のなた豆きせるが、古ぼけた畳の上に白っぽく投げだされた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな話を聴いてゐる中に、地方行きの荷役をすませ、きまつた時間のありだけ、悠々と息を入れてゐた火夫は、なた豆のきせるをたばこ入れに挿んで、立ち上つた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "なた豆煙管でたばこをすぱ／＼ふかしながら、おばあさんやお母さんと、一年ぶりのあいさつをするお百姓さんの姿を、私はわきの方から見てゐました。",
              "citation": {
                "source": "柿",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日、ふんぱつして、四錢のなた豆のきせるを買つた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なた豆、ふぢ豆、ちび筆ににた葱の花。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "……こうなってみると、やっぱり、お犬様以下という値段が、人間の本当だったかもしれねえな」　立ちしびれて来ると、二人は地にしゃがみこみ、そっと、なた豆｜煙管をとり出して、煙草をつけ初めた。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "がた／＼の古馬車と、なたまめ煙管をくわえた老馭者は、乗合自動車と、ハイカラな運転手に取ってかわられた。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度その家の隣りが堀越角次郎という、唐物問屋の荷蔵の裏になって、ずっと高い蔵つづきの日かげなので、稗蒔屋はのどかになたまめ煙管をくわえ、風鈴屋はチロリン、チロリンと微風に客をよばせている。",
              "citation": {
                "source": "西洋の唐茄子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "年上のほうが莨入と燧袋を出し、なたまめきせるでゆうゆうと一服つけた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親は雨で汚れた靴の始末をして了うと、やれやれという恰好で四畳半の貧弱な長火鉢の前に坐って、濡れた紺の詰襟の上衣を脱いで、クレップシャツ一枚になり、ズボンのポケットから取出した、真鍮のなたまめ煙管で、まず一服するのであった。",
              "citation": {
                "source": "夢遊病者の死",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
