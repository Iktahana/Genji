          "literary": [
            {
              "text": "彼女はその毬のなかから生雲丹を掘じくり出すことも知っていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "盛合わせ皿には、燻製の鮭、パン片に塗りつけたキャビア、鮒の串焼、黄いろい生雲丹、ラドッシュ。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱肉色の生雲丹のあとで、苦蓬をいれたジェリィの鳥肉が出てくる。",
              "citation": {
                "source": "キャラコさん",
                "author": "鴎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の握るものは、鱧、河豚、赤魚、つばす、牡蠣、生うに、比目魚の縁側、赤貝の膓、鯨の赤身、等々を始め、椎茸、松茸、筍、柿などに迄及んだが、鮪は虐待して余り用いず、小鰭、はしら、青柳、玉子焼等は全く店頭に影を見せなかった。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
