[
  {
    "uuid": "3f2537c4-b7f3-5968-9f6a-95a0036ed188",
    "entry": "中山",
    "reading": {
      "primary": "なかやま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
