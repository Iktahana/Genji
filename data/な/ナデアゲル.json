    "definitions": [
      {
        "index": 1,
        "gloss": "to comb back",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は鏡の前で、前髪を指で撫で上げて、きれいに整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "息子は、フォーマルな場に出る前に、髪をワックスで撫で上げてピシッと決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "暑い日だったので、彼は額に汗をかき、髪を後ろに撫で上げて額を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "紺碧のナポリの湾から山腹を逆様に撫で上げる風は小豆大の砂粒を交えてわれわれの頬に吹き付けたが、ともかくも火口を俯瞰するところまでは登る事が出来た。",
              "citation": {
                "source": "二つの正月",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸ビルを撫で上げる自動車の頭灯。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴻造はやや暫く黙って髭の両端のところを下から撫で上げるようにしながら、その慎一の眼を見ていた末、「いや、案外それが当っているかもしれんね」と、あっさり納得した。",
              "citation": {
                "source": "杉垣",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　感心したように云ったが、左の掌で軽く撫で上げる彼女の髪を、なおしみじみと見惚れていた。",
              "citation": {
                "source": "特殊部落の犯罪",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "へエ」　さう言ひながら、よく光る額を逆手で撫で上げるのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先づ第一に喜三郎さんの身持はあまり良くなかつたやうに聽いたが――」「私の口から申上げ兼ねるが、全く話の外でしたよ」「では、怨んでゐる者もあつたことでせうな」「それはもう」　主人の吉兵衞は、分別らしく額を撫で上げるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "凉み船",
                "note": "青空文庫"
              }
            },
            {
              "text": "十手や捕繩を屁とも思はない爺イでしたよ」　ガラツ八はそんな事を言ひ乍ら、鼻の頭を撫で上げるのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しばかりの貯えを廻して三十年の間｜安穏に暮し、主取りをする気もなく、江戸の下町に住んだのが、私の仕合せだったかも知れません」　藤枝蔵人老人は、そんな行届いたことまで言って退けて、武士｜気質を半分ほどは銷磨してしまったらしい月代を撫で上げるのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "敵討果てて",
                "note": "青空文庫"
              }
            },
            {
              "text": "東風が吹けば死骸の裾が武蔵へ入るし、西風が吹けば鬢のほつれ毛が、下総へなびく」「馬鹿野郎」「へッへッ、そう来るのを待っていたんで」　ガラッ八が掌の凹みで、おでこを撫で上げるのも尤もでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "欄干の死骸",
                "note": "青空文庫"
              }
            },
            {
              "text": "十手や捕縄を屁とも思わない爺イでしたよ」　ガラッ八はそんな事を言いながら、鼻の頭を撫で上げるのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘエ」　そう言いながら、よく光る額を逆手で撫で上げるのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "仏敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日といふ日になれば、三輪の萬七親分の鼻の先で、あつしがこの手で下手人を縛つてお目にかけます」　八五郎は、アルコールで少し赤くなつた、鼻の先を撫で上げるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花嫁の幻想",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩のお客樣方も、前々から二人の仲を薄々知つてゐるやうだが」「へエ、何分、お若い同士のことで」　老番頭は自分のことのやうに恐縮して額を撫で上げるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "血塗られた祝言",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そうして、うっすらと、弘仁ぶりの柱と長押が、十字架のように現われると見ると、ひらひらと蝶の舞うように、細いきゃしゃな手が、宙に浮いて来て、その柱を下の方から撫で上げる、と見る間に、柱は暗に吸いこまれるように消え失せて、白いしなやかな手首だけが、暗の空中に舞っている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "宜い鹽梅に下手人の目星が付いてな」　四十男の働き者らしい留五郎は、すつかり上機嫌でやゝ光つて來た額を撫で上げるのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "子守唄",
                "note": "青空文庫"
              }
            },
            {
              "text": "布団に片膝をついて腰を上げ、立ち上がる動作に合わせながら、直子がタオルで左の太腿の内側を股間まで撫で上げるように拭うのを彼は見た。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤くにごった眼が、やがて洋服の膝がしらから美髯のある紳士の顔を撫で上げるように見つめた。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は、寝台から二メートルほどはなれたところに立って、やはり勇一少年を見つめたまま、白コウモリのようなマントを、パッとひるがえして、両手をながくのばし、ヘビのように波うたせながら、空中を、上へ上へと、なであげるようなしぐさをつづけました。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」満谷氏は飴ん玉のやうにつるつるした、そしてまた飴ん玉のやうに円い頭を掌面で撫であげる。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よわったなあ」と例の、下顎を撫であげる手つきをした。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "撫であげる髪の毛の黒いことも嬉しくありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "お銀様の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "髷節が少しゆるんで拳固で額際の汗を撫であげる樣子は尋常ではありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "紅い扱帶",
                "note": "青空文庫"
              }
            },
            {
              "text": "髷節が少しゆるんで拳固で額際の汗を撫であげる様子は尋常ではありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "紅い扱帯",
                "note": "青空文庫"
              }
            },
            {
              "text": "むうっと暑い草いきれが面を撫であげる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "くちびるの色が著しくあかく見えた事、長い髪を手でなで上げるかたちがこの人の印象をいっそう憂鬱にした事などが目に浮かんで来る。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、このすえ付け作業がすむと今度は、両手を希薄な泥汁に浸したのちに、その手で回転する団塊の胴を両方から押えながら下から上へとだんだんなで上げると、今まではただの不規則な土塊であったものが、「回転的対称」という一つの統整原理の生命を吹き込まれただけで忽然として「生きて」来る。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の中ではストーブの向かい座にあぐらをかいて、癖のように時おり五分刈りの濃い頭の毛を逆さになで上げる男ぼれのする君の顔が部屋を明るくしていた。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　素子は、顔をあかくし、例の、顎を下からなで上げる手つきをした。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "素子は、また顎をなで上げるようにしながら、「北條一雄の本ていうのも見ましたがね、どうもこっちの方がいいらしいから、こっちにした」「ずるいなあ」　伸子はまたそう云った。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、うすく顔をあからめて、片手で自分の顎をなで上げるしぐさをした。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
