          "literary": [
            {
              "text": "ある時、故郷を流れている川の南辺へ行って、洗濯をしていると、折から荷物を積んだ船が通りかかった。",
              "citation": {
                "source": "大力物語",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、そんな身の上を聴くと、すぐさま自分の思いやりの性癖から「天の網島」の小春が「私ひとりを頼みの母さん、南辺に賃仕事して裏家住み。",
              "citation": {
                "source": "黒髪",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "南辺の賃仕事して裏家住み……」という文句を思い起して、お宮の母親のことを本当と思いたかった。",
              "citation": {
                "source": "別れたる妻に送る手紙",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "「延喜式」に、凡鴨御祖神社南辺者、雖在四至之外、濫僧・屠者等不得居住。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "延喜式臨時祭の際に、凡鴨御祖社南辺者、雖在四至之外、濫僧屠者等不得居住。",
              "citation": {
                "source": "旃陀羅考",
                "author": "日蓮聖人はエタの子なりという事",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旃陀羅考」中にも引いておいた「延喜式」の臨時祭式の文に、凡｜鴨御祖社南辺者、雖在四至之外濫僧・屠者等不得居住。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして何故にそれが四至の外といえども鴨御祖社すなわち下鴨神社の南辺には住まわせなかったものであろう。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "村ノ東南ニ聳ヘ、南辺根利村ニ属ス。",
              "citation": {
                "source": "皇海山紀行",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
