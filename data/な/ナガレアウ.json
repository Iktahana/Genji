          "literary": [
            {
              "text": "描かれる美しい婦人と、描く聰明なレオナルドとの間に、いつか流れ合う一脈の情感がなかったという方が不自然である。",
              "citation": {
                "source": "女性の歴史",
                "author": "――文学にそって――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たち互の流れ合うものも、随分この頃では川床がひろく面白い起伏で飛沫もあげるようになって来ているでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その新しい流れの中へ飛びこんで行ったことで、新鮮な友情がおたがいの心に流れ合うような気持にされたのであろうか。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
