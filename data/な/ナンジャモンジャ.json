    "definitions": [
      {
        "index": 1,
        "gloss": "unusually large tree",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山道で、色とりどりの花をつけた何じゃもんじゃの木を見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "庭に植えられた何じゃもんじゃの木が、今年も見事に咲いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの珍しい花は何じゃ？」と尋ねると、「あれは『何じゃもんじゃ』だよ」と教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "そのモティーヴの必然性がより高く、よりつよく、より美しくあるためにこそ、わたしたちの人生は「風」をいとわず「猫背」をきらい、「なんじゃもんじゃ」にからめとられまいとするのです。",
              "citation": {
                "source": "鉛筆の詩人へ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "青山練兵場の「なんじゃもんじゃ」　池野がまだ学生の頃、青山練兵場のナンジャモンジャの木（この木は本名をヒトツバタゴという）の花を採ろうと話し合い、夜中に採集を強行した事があった。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第一部　牧野富太郎自叙伝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
