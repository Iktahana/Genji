          "literary": [
            {
              "text": "英国ナドハ埃及ヤ羅馬ノ古物ハ言フ迄モ無ク、印度ノ古物ノミニテモ一館ヲ建テ、今ハ印度ニテ見ラレヌ物マデモ、其ノ中ニハ堆積セリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田、石原、富永、平川、魚住、村瀬、奥屋、鬼頭ナドハ、何レモ特別ニ眼ヲカケタト云フ訳デモナイノニ、士官学校又ハ兵学校ニ入学シテカラモズツト遊ビニ来ルシ、古イトコロデハ退職後マデ機嫌ハドウカトタヅネニ来テクレル有様ダ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "家族別居ニヨリ生ズル諸君身辺ノ若干ノ不自由ナドハ論ズルニ足ラヌ。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ伏見区竹田内畑町ニアル安楽寿院五輪塔、水輪ガ下ノ方デ細マッテ壺形ニナッテオリ、火輪ノ軒ノ反リガ厚ク、ヤダルミノ工合ガ風輪空輪ノ形ト共ニ鎌倉中期カラ後期ニ移ル頃ノ代表的ナ遺品デアルト、川勝政太郎氏ガ述ベテイルアノ作品、アレナドハドウデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウセ予ハ神佛ヲ信ジナイ、宗旨ナドハ何デモイヽ、予ニ神様カ佛様ガアルトスレバ颯子ヲ措イテ他ニハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "故桑造在世中モ夫婦デ旅行シタコトナドハメッタニナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサン、　新サンモ、ワタシモ、アナタタチ夫婦ノ、昔カラノ事ヲヨク知ツテ居ルノデ、金五郎サンニ、女ナドハ作ラセナイ様、ズイブント骨折ツテ来マシタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
