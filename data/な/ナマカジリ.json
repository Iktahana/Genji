    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "生噛りの思想論を振廻して「人間の最も幸福と云ふことは絶対的に他より拘束せられざる生活より生ず」といふことなどを一つの信条であるかの如く云散らして居た。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいえ、どれもこれも生噛りだから駄目なのよ。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "決して小手先の器用や生噛りの学問で、捏ちあげたものぢやげえせん。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸事と言えば、あの通りあっちこっち生噛りですからね。",
              "citation": {
                "source": "白木蓮",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや文学の方は生噛りです。",
              "citation": {
                "source": "微笑",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "小鳥までが生噛りの外國語で歌ふやうになつたらしい。",
              "citation": {
                "source": "匈奴の森など",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "決して小手先の器用や生噛りの學問で、捏ちあげたものぢやげえせん。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            },
            {
              "text": "生噛りの科学知識があって、無線電信や写真術に興味をもち、そのほか一般病理にも通じ、応用細菌学や毒物学の本を読んでいた。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
