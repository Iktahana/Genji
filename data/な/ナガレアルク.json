        "examples": {
          "standard": [
            {
              "text": "彼は定職を持たず、あてもなく流れ歩いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "戦争で家を失った人々は、国中を流れ歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は世界中を流れ歩き、様々な文化に触れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、たまには一驚に価するがごとき落ち洩れもあって、某が何々をクズ屋の店に掘り出したなどと人の噂に尾鰭もついて、一潟千里に流れ歩くこともしばしばあり、しかるべき人物までが、ガラクタ屋の店頭に怪しい眼を光らしている珍風景が、常に跡をたたないというのがこの道の現実である。",
              "citation": {
                "source": "茶美生活",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は江戸を去って、旅から旅へと、ながれ歩くようになった。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第三部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
