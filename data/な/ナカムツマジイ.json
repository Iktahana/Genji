        "examples": {
          "standard": [
            {
              "text": "結婚して数十年経っても、あの夫婦は仲睦まじい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "仲睦まじい家族の姿を見て、心が和んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼らはいつまでも仲睦まじく暮らしていくことだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "日頃は、主従以上、親子以上、仲睦まじい叔父｜甥であったが、狎るるに過ぎて、ひとつ蹉跌が生じると、ふたりの仲には、威令や尊敬を持とうとしても持てなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
