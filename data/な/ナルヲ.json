        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "高邁ノ精神ヲ喚起シ兄ガ天稟ノ才能ヲ完成スルハ君ガ天ト人トヨリ賦与サレタル天職ナルヲ自覚サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日｜昧爽、櫛沐ニ方リ、打門ノ声甚ダ急ナルヲ聞キ、楼欄ニ憑ツテ之ヲ観ルニ、客アリ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二院制ノ一院制ヨリ過誤少ナキ所以ハ輿論ガ甚ダ多クノ場合ニ於テ感情的雷同的瞬間的ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ國有トシテ國家ノ經營スベキ土地ノ莫大ナルヲ考フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續税ハ親子ノ權利ヲ犯ス者ナルヲ以テ單ニ手數料ノ徴収ニ止ム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ヲ機トシテ國家ガ收得ヲ計ラントスル社會政策者流ノ人權的思想ニ不徹底ナルヲ思考スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "滿十六歳以下トセルハ下掲ノ國民教育期間ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ母又ハ女子ニ負荷セシメザル所以ハ、愛情アリト雖モ扶養能力ナキガ故ニ、結局其ノ兄弟又ハ娘ノ夫ノ負擔トナリテ立法ノ精神ヲ殺ス者トナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國民教育ハ國民ノ權利トシテ受クル者ナルヲ以テ無月謝教科書給付中食ノ學校支辨ヲ方針トス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "更ニ他ノ一理由ハ日本ノ將來ハ陸上ニアルト同一以上ノ程度ニ於テ海上ニ在ルガ故ニ、國民教育ニ於テ只陸軍的模倣ヲナサシメテ海兵的訓育ヲ閑却スルコトノ矛盾ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國民教育ノ根本的革命ハ戒嚴令施行中ヨリ實施スベキ者ナルヲ以テ、現時ノ校舍ヲ直チニ使用スベキコトヲ明示シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ有婦ノ男子ガ淫ヲ買フハ明カニ一夫一婦ノ大本ヲ紊ル者ナルヲ以テ別個ノ意味ニ於テ加罰スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "體刑ト明示セル所以ハ其ノ弊風實ニ體刑ヲ以テセズンバ一掃スル能ハザル官吏横暴國ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "本然ノ人情其者ガ凡テノ法律道徳ノ根源ナルヲ忘ルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ニ際シテ國家ガ課税ノ理由ナキコトハ、相續者則非相續者ノ肉體的延長ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私有財産限度私有地限度私人生産業限度ノ三大原則ハ大日本帝國ノ根本組織ナルヲ以テ現在及ビ將來ノ帝國領土内ニ擴張セラルル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大領土ヲ有スル名實具足ノ大日本帝國ヲ考フル者此ノ三大原則を確立スル日本自ラノ改造ガ實ニ將來ノ建設ニ避ク可カラザル準備ナルヲ悟得スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮人臺灣人ガ其ノ故郷ニアリテ未ダ取得スル時期ニ達セザル國民權ヲ此ノ領土ニ於テ三年後ニ取得シ得ベキ理由ハ、既ニ移住シ居住スルホドノ者ハ大體ニ於テ優秀ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國又實ニ其ノ謬説ノ誕生地ナルヲ以テ、今尚「ジヨンブル、ソサイテー」ト名クル如ク英帝國其者ヲ組合視シ會社視シテ悉ク社會契約説ニ基ク立法ナラザルナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "徴兵猶豫一年志願兵等ハ現時ノ教育的差等ヨリ結果セル者ナルヲ以テ、十年一貫ノ國民教育ニヨリテ此等ヲ存置スル善惡一切ノ理由ハ消失スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨ、ヒトリハ、チンボツオトコナルヲモッテ、ケイエンセラレ、タコマゴウニハノセラレズ、チョクセツモンテヴィデオコウニリクアゲセラレタリ。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "計略ハ密ナルヲ良シトスだの、敵ヲ図ラントスレバ先ズ味方ヲ図レなどという格言は紅国軍部といえどもよく心得ているのであった――というような結末まで、ゆっくり探偵小説に書いていると、いくら枚数があっても……。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ノ如クナルヲ以テ、芋ヲ焦焼スルコトナク（僕はいささか焦げた方が好きです）、蒸焼シ得ルノミナラズ蒸焼ヲ二回ニ順次行ウヲ以テ塩ノ浸滲ハ良好ニ行ワレ（とてもタマランです）、更ニ蓋ニ保温室ヲ設クルコトニヨリ之ヲ焼冷シトナスコトナカラシメ、常ニ保温シ得ル等ノ効果ヲ有ス。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "古物ヲ賞鑑スルニ於テ、内外ノ区別ヲ立ツルハ笑フ可キコトニテ、其ノ識量ノ狭隘ナルヲ奈何セン。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "纏頭散財積ンデ其幾千万両ナルヲ知ラズ。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ今ヤ柳北ト二子ハ皆青天白日ノ人トナルヲ得テ、高橋子モ亦筆墨ノ勲ヲ奏シテ快ク本社ニ凱旋シ、以テ本日ノ賀筵ニ盍簪相娯ムヲ得レバ、吾徒復タ何ゾ汝ヲ怨ミ汝ヲ責ムルヲ為サンヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "狗奴國に就きては、『外交繹史』に菅氏云、大隅ヨリ南ニハ、種子屋久ナドイフサヽヤカナル島々ハアレド、共ニ攻撃スル程ノ國無ケレバ、此狗奴國ハ、モト下ノ「女王國東、渡海千餘里、復有國、皆倭種」トアル地ノ内ナルヲ、陳壽ガ、東ヲ南ト誤リタルナラン。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テ此等ノ事並ニ瑣細ナル事ニ就テ、精微ナル理ヲ穿鑿スル、論辨ヲ理會スルハ、我々ニテモ力ノ及バザルコト屡々コレアルガ如ク、其理由ハ智力單素ナルヲ以テ、知覺スベキ關係ハ夾雜組織セル者ニ相應給スルコト能ハザルニ在リ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "又蜂蟻ノ類ノ如キハ、人間社會ト同ジク群居スル者ナルヲ以テ、自ラ君臣又ハ役員等ノ順序モアリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "民偕ニ之ヲ楽ンデ其大ナルヲ知ラズ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
