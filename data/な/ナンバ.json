[
  {
    "uuid": "ac641132-8c40-5b38-a3fc-495dde153f47",
    "entry": "難場",
    "reading": {
      "primary": "なんば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
