    },
    "definitions": [
      {
        "index": 1,
        "gloss": "predicament",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この先は道が険しく、初心者にはかなりの難場となるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "交渉は最終段階で難場に差し掛かり、妥協点を見出すのが難しくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この曲の後半にはバイオリンの難場があり、奏者の腕が試される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "北海道では熊におびやかされたり、食糧欠乏の難場で肝心の貯蔵所をこの「山のおじさん」に略奪されて二三日絶食した人もある。",
              "citation": {
                "source": "地図をながめて",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」さて、最も難場としたのは、山下の踏切の處が、一坂辷らうとする勢を、故と線路で沮めて、ゆつくりと強請りかゝる。",
              "citation": {
                "source": "麻を刈る",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家内が才覺して、此の避難場に近い、四谷の髮結さんの許をたよつて、人を分け、荷を避けつゝ辿つて行く。",
              "citation": {
                "source": "露宿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かなりの難場で、杉が深く繁つて居ります。",
              "citation": {
                "source": "玉野川の渓谷",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの井村のおばあさんでしたか、岩崎の避難場からお宅へおつれになつて、ひどく威張つてゐたお婆さん、あの年で荷物は何一つ焼かなかつたんですからな。",
              "citation": {
                "source": "余震の一夜",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "白耳義仮政府の所在地として聞えたアーヴルでの税関が既にもう第一の関所で、容易には人を通さなかった上に、あの港から海峡を越してしまうまでの間がまた旅するものの難場に当っていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶好の避難場所、そういう想念がすぐ閃めくのであった。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶好の避難場所、さういふ念想がすぐ閃めくのであつた。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は吻として、この難場の救主に、どうぞ／＼と言つて、自分の座蒲團の裏を返してすゝめた。",
              "citation": {
                "source": "足相撲",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその夜は古関で泊まり、翌日未明に宿を出たがこれから先は道はなく、釈迦岳の山脈と王岳連山の山骨とが一時畳まれた深い谿が、通路と云えば云えもしようか、緑樹紅葉打ち雑り秋山の眺望は美しかったが旅人にとっては難場である。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その難場の谿底路を甚太郎は先へと辿って行く。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう其難場は越したので、一息｜吐くかと思う頃。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　千鶴子の母にしても、同様今のような難場に立ち合ったことなど幾度もないことは、彼女のそういう話し方の間のろい調子にもよく出ていた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "気息の使い方で見ると、一通り、武芸の心得もある奴らしいが――　雪之丞は、とにかく、何かしら、陥し穴のようなものに、落ち込んでしまったと、ハッキリ思い知った上は、気を強めて、難場を切り抜けるだけの心支度をする外はないのだった。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "以後全く師を取らず俵屋宗理の流風を慕いかたわら光琳の骨法を尋ね、さらに雪舟、土佐に遡り、明人の画法を極むるに至れり」　云々というのが大体であるが、勝川春章に追われてから真のご難場が来たのであった。",
              "citation": {
                "source": "北斎と幽霊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯んな時に六｜疊が空いてゐれば、朝からでも引込む場所があるのにと思ふと、宗助は小六に六｜疊を宛てがつた事が、間接に御米の避難場を取り上げたと同じ結果に陷るので、ことに濟まない樣な氣がした。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人は『烏』の頂きで手の込んだ朝食をすませ、山稜に沿って南へ『｜烏の嘴』までくだり、タッコンナの氷河を渡って、いよいよそこからグラン・ミューレの大難場、氷の絶壁へととりかかる。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "上り二里、下り一里半の極の難場だ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "順序もなく降蔵が語り出したところによると、美濃から越前へ越えるいくつかの難場のうち、最も浪士一行の困難をきわめたのは国境の蝿帽子峠へかかった時であったという。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "淀川筋では難場が多く、水損じの個処さえ少なくないと言い、東海道辺では天龍川の堤が切れて、浜松あたりの町家は七十軒も押し流されたとのうわさもある。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "美濃方面から冬期にこの神社の位置に達するためには、藁沓を用意し、その上に「かんじき」をあてて、難場中の難場と聞こえた国境の加子母峠を越えねばならない。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月十八日、二度目に東京へ帰ってみると、不在中に出来ているはずの修繕がいっこう捗っておらず、相変らず避難場そのままの有様だが、それもこのさい我慢せねばならぬ。",
              "citation": {
                "source": "震災後記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやく無事にこの難場をおえ、少し上の小さい緩傾斜の台地に落着くとすぐに食事にする。",
              "citation": {
                "source": "一ノ倉沢正面の登攀",
                "author": "小川登喜男",
                "note": "青空文庫"
              }
            },
            {
              "text": "とは云え楽屋をサラケ出せば、今長庵はご難場なのよ。",
              "citation": {
                "source": "村井長庵記名の傘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所は名に負う九十九里ヶ浜、日本近海での難場であった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その御宿からは世に名高い、九十九里の荒海で、かこ泣かせの難場であった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで初めて大智恵者の花村甚五衛門様を思い出されて、久方振りでお館へ招んで、お前の技倆でこの難場を盛り返すようにと仰せられたそうだが、そこは執事のご筆頭だ、いかに主人の命令けでもへいへいするばかりが能ではない。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲州街道は日本一の難場、それを女の一人旅、これは困るのが当然である。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……お先くぐりをするようですが、つまり、私にその難場をなんとかしてくれといわれる」「はい、いかにもその通り」「して見りゃア、どうせそこへふれなきゃ筋がとおらない話。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "野伏大名",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんばん鐵のかぶとむし　月のあかりも　つめくさの　ともすあかりも　眼に入らず　草のにほひをとび截って　ひとのひたひに突きあたり　あわててよろよろ　落ちるをやっとふみとまり　いそんでかぢを立てなほし　月のあかりも　つめくさの　ともすあかりも眼に入らず　途方もない方に　飛んで行く。",
              "citation": {
                "source": "うろこ雲",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
