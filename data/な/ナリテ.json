[
  {
    "uuid": "10c4d858-2dc9-5f48-a1ea-5d50f026f0ac",
    "entry": "なり手",
    "reading": {
      "primary": "なりて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
