        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "煙のやうな水蒸氣は、一郷全體の木立を立ちこめつゝ自然の光景は如何にも靜かに、飛ぶ鳥もなく木の葉も動かずといふ有樣であるが、此の靜かな天地に包まれた人里は、どことなく賑かな鳴り音を潛めて居る。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "はてな」　ぴたりと鳴り音を止めて、ややしばしわが目を疑うように見守っていたけはいでしたが、とつぜんけたたましい声をあげました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "人工心臓のモーターと錯覚したのは、咯血によって生ずる腹の鳴り音に過ぎなかったのです。",
              "citation": {
                "source": "人工心臓",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その鳴り音をモルヒネの作用によって、人工心臓から生じた安楽の世界として誤認させられたに過ぎませんでした。",
              "citation": {
                "source": "人工心臓",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎晩ゴーゴーといって鳴り音が聞こえるだろう。",
              "citation": {
                "source": "雪の国と太郎",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜風は、木の枝に当たって、かすかに鳴り音をたてています。",
              "citation": {
                "source": "木に上った子供",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちらこちらには、たこがあがって、籐の鳴り音が聞こえていました。",
              "citation": {
                "source": "雪だるま",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく、なきだしたくなるのをこらえて立っていると、遠く石をころがすような海の鳴り音がきこえました。",
              "citation": {
                "source": "ペスときょうだい",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "このとき、すぐかたわらで、ブーン、ブーンとせわしそうな鳴り音がしました。",
              "citation": {
                "source": "サーカスの少年",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時に、ブーンといって、バイオリンの糸の鳴り音がきこえたのであります。",
              "citation": {
                "source": "海のかなた",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "海のすさまじい鳴り音が、空にまでとどろいて聞こえました。",
              "citation": {
                "source": "小さな金色の翼",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
