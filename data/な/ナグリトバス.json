    "definitions": [
      {
        "index": 1,
        "gloss": "to knock (a person) off his feet",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大男は、小さな相手を一撃で殴り飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "怒りに任せて彼を殴り飛ばしたい衝動に駆られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の強烈なパンチは、相手をリング外まで殴り飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あとで知ったことだが、この在郷軍人会の分会長は伍長上りの大工で、よその分会から点呼を受けに来た者には必ず難癖をつけて撲り飛ばすということであった。",
              "citation": {
                "source": "髪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャングルの主が野牛を殴りとばすような勢いでやったんじゃ、ヤン君もさぞ痛かったでしょう。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "他人でなかったら殴りとばすところだ。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "とどなりつけるか、彼らを撲りとばすより外には表現のしようの無いものだった。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
