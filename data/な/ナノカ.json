    "definitions": [
      {
        "index": 1,
        "gloss": "7th day of the month",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今月の7日は家族会議がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "7日は銀行が休みだから、お金を下ろしておこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "契約は7日から有効になります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "徑が曲りくねつて居るから見た所が窮屈でごちや／＼して居るので一向に興が薄ひ樣な心持がする、再び本道へ出ると桃の枝に中山こんにやくをぶらさげ自轉車へ乘つて來る人に逢つた明治36年４月７日『日本』署名　　クモ生投",
              "citation": {
                "source": "市川の桃花",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみ水は、たった７日ぶんしかなかった。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "７日目に彼は腋の下に不快感を訴え、９日目に少しばかり寒気を感じ、食欲を失い、軽い頭痛がした。",
              "citation": {
                "source": "イングランドの西部の諸州とくにグルスターシャーで見つかった病気で、牛痘の名で知られているウシ天然痘の原因および効果についての研究",
                "author": "AN INQUIRY INTO THE CAUSES AND EFFECTS OF THE VARIOLAE VACCINAE, A DISEASE DISCOVERED IN SOME OF THE WESTERN COUNTIES OF ENGLAND, PARTICULARLY GLOUCESTERSHIRE, AND KNOWN BY THE NAME OF THE COW POX.",
                "note": "青空文庫"
              }
            },
            {
              "text": "６日目に腋の下に痛みを訴え、７日目には人痘を接種した患者に共通な症状になり、発病後３日目まで終わらなかった。",
              "citation": {
                "source": "イングランドの西部の諸州とくにグルスターシャーで見つかった病気で、牛痘の名で知られているウシ天然痘の原因および効果についての研究",
                "author": "AN INQUIRY INTO THE CAUSES AND EFFECTS OF THE VARIOLAE VACCINAE, A DISEASE DISCOVERED IN SOME OF THE WESTERN COUNTIES OF ENGLAND, PARTICULARLY GLOUCESTERSHIRE, AND KNOWN BY THE NAME OF THE COW POX.",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女と一緒に住んでいたエイガー嬢は10月７日に死亡した。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "７月28日に１人、８月３日に２人、４日に４人、７日に２人、８日に４人、９日に３人、11日に１人、13日に死亡した。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "（＊クリミア戦争：1853-56）「艦隊がバルジクに戻って１週間の８月７日に4000人のフランス軍が我々の停泊地の横の高地に野営した。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことは７日および８日に行われ、９日および10日の夜にコレラは幾つかの船の乗組員のあいだで激しい勢いで発生した。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は９月７日の水曜日の夕方に聖ジェイムズ教区の管理委員会と会談して、上の状況を話した。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "これによると数人が罹患するときに街路では流行が３−４週間も続くのに住宅では６−７日しか続かないことを示している。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故かと言うと古代エジプト人は蒸留酒を飲まなかったし、彼らは現在のエジプト人と実際に同じ労働時間であったし７日毎に休日だったからである。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "）、60分、60秒）、多くの人種に共通な重さと長さのシステム、黄道の名前、12月、週７日、金と銀の価値の関係。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "（意味ある考察、たとえば四季および気候、これらの下に置く）　数の影響への信仰、そして特に７が悪いことは、医師が月の７日、14日、19日、21日、28日に患者に触れることは完全に禁じられた（すなわち、７で割り切れる日、または前の月の始まりから49番目）。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "死体は７日のあいだ水の中に寝かせておき、ふやけた外側部分は樹皮によって擦りおとし、内部を調べる。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "特に怖れられたのは総ての３元素に擾乱のある熱病であり、７日目、10日目、12日目に危険であり、終わるかまたは死の原因になる。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "１９９７年７月７日青空文庫設立呼びかけ人富田倫生野口英司浜野　智八巻美恵らんむろ・さてぃLUNA CAT初出：「青空文庫」　　　1997（平成9）年7月7日入力：青空文庫校正：青空文庫※テキストを整える際、以下の書籍を参考にしました。",
              "citation": {
                "source": "青空文庫の提案",
                "author": "青空文庫編",
                "note": "青空文庫"
              }
            },
            {
              "text": "古白が自殺を図ったのは４月７日であるから本句を作った３日後ということになり、また「遺言状」は１ヶ月前の３月６日に書き終えている。",
              "citation": {
                "source": "藤野古白句集",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "この日（1665年６月７日）にドルーリーレーンで２、３軒の家でドアの上に赤い十字の標識があり「主よ我らに慈悲を」と書かれているのを自分の意志に反して見た。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "９日目に激しい発汗を伴って解熱し７日後に再発した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "衰弱した患者はふつう７日から９日のあいだに死亡した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は７日目に死亡し栄養物摂取を拒否したので病気は悪化した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "興味あることには、放血で貧血になってすぐに鉄の吸収は増えないで、７日後に赤血球合成が増えた結果として貯蔵鉄が使い尽くされてから、吸収が増えた（112）。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            },
            {
              "text": "７日　朝悪への意志、善への意志、どちらも汝のうちにあるが、いずれを選ぶか？",
              "citation": {
                "source": "朝に想い、夜に省みる",
                "author": "MORNING AND EVENING THOUGHTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "７日　夜　道徳が人の心に伝えているのは、正しい行いとは個人の行動次第なのであって、人の考え振る舞うところからかけ離れたよくわからないものではけしてない、というわかりやすい真理なのである。",
              "citation": {
                "source": "朝に想い、夜に省みる",
                "author": "MORNING AND EVENING THOUGHTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、輝き出でるや、諸君は云ひます、「あれでああなのかねえ、不思議みたいなもんだねえ」。",
              "citation": {
                "source": "酒場にて（定稿）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その由を弁解したら、それもさうかと一応は分つたらしかつたが、それでも猶そのお説教を続けるのは、僕にやつぱり一体全体「誠意がないのか」それとも、大概の老人がさうであるやうに、たゞもう剛情なのか。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "平たい石には今もその忠魂塔の鉄銹があるやうに、雨が降ればその銹は流れ出すやうにさへ思ふのだが、それはその後もずつと肉親を離れて東京にゐる、孤独な男の妙な幻想だけのものなのかも知れぬ。",
              "citation": {
                "source": "一つの境涯",
                "author": "――世の母びと達に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "永遠にパンセは言葉にたよる他、仕方ないものなのか。",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったいやる気なのかね？",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――いや、ひょっとしたら、なんでもない俗な男なのかも知れん。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
