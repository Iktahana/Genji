        "examples": {
          "standard": [
            {
              "text": "船団の筆頭ナビゲーターとして、彼は荒れ狂う嵐の中でも沈着冷静に指揮を執った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "飛行機のコックピットで、ナビゲーターが計器をチェックしながら現在地を確認している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は熟練のナビゲーターで、星の位置だけで自分の居場所を特定できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "よく耳にするネットスケープ・ナビゲーターは、兄にあたるモザイクに一気にとって代わり、ブラウザーの代名詞になった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "リンクをたどりながら情報を見るためのブラウザーと呼ばれる小道具に、モザイクやネットスケープ・ナヴィゲーターといった優れたソフトウエアが生まれると、さまざまな組織や企業、そして夥しい個人が一斉にこの仕掛けを使って自分たちの情報を発信し始めました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "知り合った男たちはふたりいて、そのうちのひとりは、こんどの航海でナヴィゲーターを務める男だ」「ほんとにアランを知っているのかい」「間違いない」「よし。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アランを知っているのはタヒチから来た男たちだと、カアイラウは言っていた」「そうか、タヒチか」「ふたりいて、そのうちのひとりは、ホクレア号の大航海に参加するナヴィゲーターだそうだ」　後頭部で両手の指を組み合わせたラリーは、上体を反らせて天井を仰ぎ見た。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
