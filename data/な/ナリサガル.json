[
  {
    "uuid": "0958a062-ee9b-5eb8-8947-00e0357c66a1",
    "entry": "成り下がる",
    "reading": {
      "primary": "なりさがる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
