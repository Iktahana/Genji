        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "若シ將來ノ大領土ニ於ケル諸多ノ鐵道ヲ再ビ南滿鐵道ニ學バシムルコトアラバ國民ニ鬪志ナキコト明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ニ際シテ國家ガ課税ノ理由ナキコトハ、相續者則非相續者ノ肉體的延長ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲシテ日本ノ愛蘭土タラシムル如キコトアラバ、將來大羅馬帝國ヲ築カントスル日本ハ全然其ノ能力ナキコトヲ第一歩ニ於テ立證スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ強國中各種老幼ノ民族ヲ包有セザル者ナキコト各家庭ニ於テ老婆少女ヲ有スルガ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ朝鮮ハ合併以前自決ノ力ナカリシコトハ八十歳ノ老婆ノ如ク、合併以後未ダ自決ノ力ナキコト十歳ノ少女ノ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ盟ヲ破リ、異端ヲ抱ク者アラバ、ソレ天ノ冥罰ヲ受クルモ恨ミナキコトヲ天地ニ誓ウ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
