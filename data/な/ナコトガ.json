          "literary": [
            {
              "text": "オ産ヲスルマデハ、イクラ物好キナ彼奴トテモ手ヲ出ス様ナコトガアルマイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、フシギナコトガアレバ、アルモノデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ昨夜コンナコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスルト颯子ノタメニイロ／＼ト好都合ナコトガ起リソウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキハ上ガ二二三、下ガ一五〇アッタンデゴザイマスヨ」「ソンナコトモタマニハアルデショウナ」「タマニダッテコンナコトガアッチャ大変デゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日ノヨウニ、九月中ニコンナコトガアルノモ珍シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日来テ又モ失敗ト云ウヨウナコトガアッテハ困ルノデ、博士モモウ一度ト云ウ気ハナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
