    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Nara",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "奈良の都は古くは南京とも呼ばれ、華やかな文化が花開いた場所である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "南京の地で千年の時を刻む古刹を巡り、歴史の重みに思いを馳せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "南京の平城京跡に立つと、かつての壮大な都の姿が目に浮かぶようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "南京陷落の日に萩原朔太郎歳まさに暮れんとして兵士の銃劍は白く光れり。",
              "citation": {
                "source": "南京陷落の日に",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天寒く日は凍り歳まさに暮れんとして南京ここに陷落す。",
              "citation": {
                "source": "南京陷落の日に",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして造作もなく、彼の、南京虫だらけの巣へ投り込んだ。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち実験室において、南京兎を注射するごとく、もしくは解剖室において、解剖刀を揮うがごとくであった、云々」というのがあり、また「西鶴は検事でなければ、裁判官だ。",
              "citation": {
                "source": "西鶴と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "南京虫や蚤蚊に攻められながら、野羊の乳を飲み、アラビア人のコックの料理を食って、一八七二年の十二月十二日から翌年三月中旬にわたる単調な船住いをつづけた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処は南京豆と南京米とそして南京虫の本場です。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "（井上金太郎　宛）　揚子江岸に上陸して南京入城に至る迄の一ヶ月間はまことに、はや、タイヘンなもンでした。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "南京へ着いて酒保が一日開かれたので、早速一本二十銭のヨーカン五本買ってペロリと平らげて、まだ食いたい気がします。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "南京から○○方面へ廻るから先ず年中は帰れんだろうと云う噂。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた、びいどろといふ色硝子で鯛や花を打出してあるおはじきが好きになつたし、南京玉が好きになつた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の片隅にはアオイ・ホテルから小湊へ事件後返り咲いたお六が、南京刈の男のウィンクに応じて立上るとショートオオダァのために別室に消えた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "お六が南京刈の男と再びサルーンにでてきた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "南京方面の商人が前後不覚でマルセーユからベニスあたりまで寝ているなんてことはあり得ないことですからね。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにも拘らずいまでは南京と広東の提携説さえつたわるに至った。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "工人を指導した陳独秀が、いまでは南京総司令の策略によって彼の首が無産者の弗箱に変わるのであった。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "北京停車場の一号プラット・ホームに南京発列車が到着すると、奇襲弾薬が破裂して数十名の死傷ができると時刻を同じくして碼頭苦力が暴動に参加した。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾組かの拳銃隊が街の要所々々を発砲し、欧米人によって築かれた南京路のペーブメントは要撃された。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "永安公司の屋根の上の星が南京玉の八角灯のように騒乱の巷に輝いていた。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、云うのは昨日広東の事変で共産軍が敗れると、武漢、南京、広東の三政府が提携して新たに国民党中央政府の設置が提議され、俺はその委員に名を連ねたのだ。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "反｜蒋介石派の激化と、東支鉄にからんだ露支間の葛藤、南京政府の幣制の改革にたいする商人の思惑は、対支商談におけるワシントン政府の経済政策が、帝国主義戦争の一つの徴として、ワシントン当局者のからくりによって時局が平穏のうちに解決されると、南京政府は中央銀行を設け、上海造幣｜厰を開いた。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "職業は、南京路角、百貨店｜泰興公司の女店員、支配人デー・ダブリュ・クロフォードに愛さる。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
