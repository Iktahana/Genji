        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……ナアンダイ……。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ナアンダイ……これあ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――私はその時にようやっと最前日暮れ方に見た事を思い出しまして……ナアンダ、そんな事だったか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "危くまた引っくり返るところであったが、そのうちに、ようようの思いで気を取り直して、どうしてここに……と抱き上げながら、その少女を頭のテッペンから、爪の先までヨクヨク見上げ見下してみると、何の事だ……それは黛夫人の妹で、双生児の片われの芬子嬢であった」「ナアンダ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、そのうちに長い煙管が眼に付くと、　……ナアンダ朝鮮公か……コンナ処まで浮かれて来るなんて呑気な奴も在るもんだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、それがわかった時はビタミンの発見と同様、遠からず平々凡々な趣味によってしまうべき運命を持っているので、現在のように大衆を酔わせる力はなくなってしまうであろう――ナアンダ。",
              "citation": {
                "source": "ナンセンス",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、ホントの地下鉄はモウ一階下に在る事も、音響の工合でわかったので……ナアンダイ……と思ったが、しかし何となく心細くなったので、そのまま宿へ帰ってしまった。",
              "citation": {
                "source": "恐ろしい東京",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアンダ、つまらない」　ところが、その落ちて来た品物を見ますと、何か変ったものでもあればよいがと、少からず期待していた彼は、余りのことに呆れて了いました。",
              "citation": {
                "source": "屋根裏の散歩者",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアンダ、こんな弱々しい奴だったのか。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナアンダと安心したけれど、そんな際にも、彼は顔を真赤にして、まごつきながら、車の方角を換え始めた。",
              "citation": {
                "source": "蟲",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「種を明かせばナアンダという様なものさ。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアンダ、拵えもんですぜ。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
