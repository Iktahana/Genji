        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「朝は四本足、昼は二本足、夜は三本足のものは何だ」とスフィンクスが謎を掛けてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖父はいつも子供たちに難しい謎を掛けて、正解するまでおやつをくれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "王女は自分と結婚したいという男たちに、三つの謎を掛けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "謎を掛けるのは、そこらにいる人達の為事だ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "べつになぞをかけるわけじゃねえんだがね、どうですかい、だんな、だんなは何か質屋にご用はねえんですかい」「あいそがつきて、ものもいえねえや。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "数の百だったらどうだというんだ」「いいえ、その、ちっと多すぎるんでね、残ったあとをどうするんかと心配しているんですよ」「さもしいなぞをかけるな！",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "金十郎は胸とどろかせながら、去年の夏のはじめ、八条猪熊の女衒に連れだされ、大湊という、北の湊の船宿へ、飯盛に売られたひとがあったそうだが、となぞをかけると、女はうなずいて、おはずかしいが、わたくしもその一人だと、さめざめと泣きだした。",
              "citation": {
                "source": "奥の海",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「むやみに人を疑ってばかりいる役人のように思われていますが、そしてまた信者たちからはそう思われるのが当然ですが、あなた方にまでそんな疑いのなぞをかける者では決してないのです。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
