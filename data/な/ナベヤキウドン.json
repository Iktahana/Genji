    "definitions": [
      {
        "index": 1,
        "gloss": "udon, vegetables, fish, etc. in broth, served in a pot",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アルミ鍋に入った鍋焼きうどんをコンロにかけ、卵を落として食べるのが至福の時だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「お待たせしました、鍋焼きうどんです」と運ばれてきた器からは、湯気が勢いよく上がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "風邪気味の時に母が作ってくれた、具だくさんの鍋焼きうどんで元気を取り戻した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "○わすれて行った本　届ける　つい　そこだって○なべやきうどんを云いつけにゆく○待っている　約束のハガキのよみちがい○お菓子のこと「あら　それをみんなたべちゃっちゃ駄目よ」○気持よさそうなので　そうすると　ローソクの灯が　急にぱっと明るくなったように　くつろいで楽に居心地よくなった。",
              "citation": {
                "source": "無題（十三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼うどんや夜鷹もまたしばしば橋の袂を選んで店を張った。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでわれわれは身を投げるか、弁慶の薙刀の※となるか、夜鷹に食われるか、それともまた鍋焼うどんに腹をこしらえて行手の旅を急ぐかである。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "新坂を下りると鍋焼うどんが居ました。",
              "citation": {
                "source": "夜の赤坂",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "『近代詩歌』の四月号に彼の詩『鍋焼うどん』といふのがあり宵暗の都市に親子の貧しい、うどん売子の熱いアルミニュームの鍋に、彼が渇いた唇をあてゝ『子がしつらへて親がはこぶなり』とせち辛い浮世の味ひを歌つてゐたので私は彼に旭川の鍋焼を喰べに来いと葉書をやつた。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの鍋焼うどんなども江戸以来の売り物ではない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼うどんが東京に入り込んで来たのは明治以後のことで、黙阿弥の「嶋鵆月白浪」は明治十四年の作であるが、その招魂社鳥居前の場で、堀の内まいりの男が夜そばを食いながら、以前とちがって夜鷹そばは売り手が少なくなって、その代りに鍋焼うどんが一年増しに多くなった、と話しているのを見ても知られる。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜そば売りも今ではみな鍋焼うどんに変ってしまった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "時とすると冬の夜の「鍋焼うどん」の呼び声。",
              "citation": {
                "source": "続獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なるほど、この腑甲斐ない自分というものの持って行き場は、身投げあたりが相当だろう、腹を切るという代物ではない」　自分で自分を嘲っているところへ、鍋焼うどんが来る。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来たな、鍋焼が来たぞ」　米友はどうやらその鍋焼うどんを待ち構えているらしくあります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "伯耆の安綱の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「爺さん、飛んだ迷惑をかけちまった、それでもまあ、おたがいに命拾いをしてよかったね」と言って七兵衛は鍋焼うどんを慰めました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "伯耆の安綱の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「商売道具がこわれたね、爺さん、俺が立替えるよ」　七兵衛はかなり重味のある財布を首から外して、鍋焼うどんの屋台の上へ投げ出しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "伯耆の安綱の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "神田伯山扇を叩けば聴客『清水の治郎長』をやれと叫び、小さん高座に上るや『睨み返し』『鍋焼うどん』を願ひますとの声｜頻にかかる。",
              "citation": {
                "source": "一夕",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の番の拍子木の後方より『鍋焼うどん』、また来るは、よきこゑの『恋の辻占』鮭さげて小走りの町の若衆。",
              "citation": {
                "source": "霜夜",
                "author": "末吉安持",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
