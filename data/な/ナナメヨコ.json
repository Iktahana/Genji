        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "薙ぎはらいにかかる鎌の刃を斜め横にすべらした。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その美しさは、真正面から見たのではよく分らないかも知れないが、横から、斜め横から見れば、誰にでも、「素人」にでも分る。",
              "citation": {
                "source": "球体派",
                "author": "豊島与志雄著",
                "note": "青空文庫"
              }
            },
            {
              "text": "満員の電車に鮨詰めになっている雑多な人々の眼、それを斜め横から、眼瞼の下に円くふくらんでいる、そのふくらみが分るほどの角度で見れば、どれもみな素晴らしく美しい。",
              "citation": {
                "source": "球体派",
                "author": "豊島与志雄著",
                "note": "青空文庫"
              }
            },
            {
              "text": "二卓ほど距てた斜め横に、どうも見覚えのあるような中年の男がいた。",
              "citation": {
                "source": "秦の出発",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "斜め横に身体を向きかへるといふやうなわづかな動作はそれ故非常に烈しい変化を感じさせる。",
              "citation": {
                "source": "能の彫刻美",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黙って兵藤の斜め横から飛込んでダッと体当りをくれる。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵藤、吉村を斬らせじと縁側に躍り上って斜め横から仙太に迫る。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来江戸風――日本建築風――の橋の場合には、欄干から橋ゲタへかけての見付きを、横の木組み二本引きに、平行したのが、古来からの例であるが、明治初年製の橋には、これが一ころのロシヤの旗のやうに、十文字を斜め横に置いた形のぶつちがひに、木を組んだものが多い。",
              "citation": {
                "source": "東京の風俗",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "大海を思わせるような大きい軒端の線のうねり方、――特にそれを斜め横から見上げた時の力強い感じ、――そこにはこの堂をはじめて見るのでないわたくしにとっても全然新しい美が感ぜられたのである。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に、たつは反りかえる恰好になり、斜め横に倒れる。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "直子には歩いてもらったり立ちどまってもらったりし、その彼女を前からうしろから、そして斜め横などから、写真機のファインダーごしに彼は観察を繰り返した。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん、許しなしでうしろから撮ったり、斜め横から撮ることも多いけれど」「いまの人は、なぜ撮ったのだい」「たいへん魅力的な人だから」「美人だね」「ヨシオがそう言うなら、確かだよ。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "台を寄せてある壁に体をつけて、斜め横からその夏子の全身を、冬彦は撮った。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "森を背に第十九回メーデーと斜め横書きの字が赤地に白くぬかれている。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
