          "literary": [
            {
              "text": "ナアーンだ馬鹿馬鹿しい。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハ……」――【溶暗】――　オーヤオーヤ……ナアーンのコッタイ……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナアーンダ……　　それ位の事か……　徳市は眼を※った。",
              "citation": {
                "source": "黒白ストーリー",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで云う通りにしてみると成る程、巻線香のカケラも見当らないから……ナアーンダイ……というので釈放する。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭山満　ナアーンダ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの枝からこの枝、花から蕾といくつもいくつも嗅いでみましたが、「ナアーンダ、人間がいいにおいだ、いいにおいだと言うから本当にして嗅いでみたら、つまらないにおいじゃないか。",
              "citation": {
                "source": "梅のにおい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアーンだ、道庵先生、先生、こんなところに来ていやがらあ」　長者町の子供が、くしゃみをして呆れ返っているに相違ない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
