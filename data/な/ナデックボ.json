          "literary": [
            {
              "text": "其後「尾瀬紀行」が現れる迄十年余りの間に、尾瀬に行った人は可なりあったらしい、現に「尾瀬紀行」にもナデックボに在った堂小屋の左右の羽目板に、燧岳探検何某と余地なき迄に楽書がしてあったと記してある。",
              "citation": {
                "source": "尾瀬の昔と今",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "沼の西北ナデックボから登路が通じている。",
              "citation": {
                "source": "那須、尾瀬、赤城、志賀高原",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
