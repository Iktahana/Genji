  {
    "uuid": "4e8c82be-51a8-59f8-89ef-a3333dce8f17",
    "entry": "ナイデ",
    "reading": {
      "primary": "ないで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドウゾ案ジナイデ下サイ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナグサメナイデホシイ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト　モウシマス　ト、サカナタチ　ハ、サモサモ　バカ　ニ　スルヨウニ、ワラッテ　オヨギ　モ　シラナイデ　ウミ　ニ　クルナンテ、キミ　ハ　オオバカサンダ　ト　イッテ　アイテ　ニ　シテ　クレマセンノデ、ヤマキチ　ハ　コンド　ハ　ナミ　ニ　ムカッテ、ボク　ヲ　オヨガセテ　クダサイ　ト　タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ労働ニ害サレタ手ハ思ウヨウニ自分ノ感力ヲ現ワス事ガデキナイデ困リマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ私ハイツワラナイデ始メタ時カラノヲ全部送リマシタ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノスケッチデハ私ノ感ジガドウモ出ナイデコマリマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　王サマハ、カタツムリヲ　ツブサナイデ、青イ　ハノ　上ニ　ソツト　ノセテ　ヤリマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　ステナイデ、コシニ　サシ、ツギノ　ムラニ　ハイリマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドノ　ムラニモ　アマリ　ヒトハ　ヰナイデ、ノコツテ　ヰル　ヒトビトハ　ミナ　アヲイ　ヤツレタ　カホヲ　シテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、アカチヤンハ、コトリヲ　ミナイデ、ミチコサンノ　カホヲ　ミテ　ヰテ　ニツコリ　ワラヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウレ　ゴラン、オマエサンノ　カゲデ　ナイ　シヨウコニ、オマエサンガ　トンデモ、アノ　カゲハ　ウゴカナイデハ　ナイカ」ト　ポストハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "真の肉※蓉は御肉と同じく列当科に属すれど別物で、学名をフェリベア・サルサと呼び、西シベリア、蒙古、ズンガリアの産、鎖陽は蛇菰科のシノモリウム・コクネシウムで蒙古沙漠に生ず（ブレットシュナイデル『支那植物学編』三）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "「心細イコトヲ云ハナイデ欲イヨ、だつでい――僕トイフ息子ノアルコトヲ忘レタンデスカ？",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで鉛筆でだけ描いていたケーテは、筆を使いはじめたが、そのときの教師はエミール・ナイデという故郷の町の芝居がかりの田舎画家であった。",
              "citation": {
                "source": "ケーテ・コルヴィッツの画業",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハ君ヲ愛シテハ居ナイゾ、君モ道子ヲ愛シテハ居ナイデハナイカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚カナイデ、ヨクコノ手紙ヲ読ンデクレ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタ、約束ドオリ、ナイデス。",
              "citation": {
                "source": "夏の日の夢",
                "author": "THE DREAM OF A SUMMER DAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "……中に、ステパンの会話の力で判断してだろう、片仮名で、「オナツカシキペテロフサマ、ソノゴオカワリモアリマセンカ、ユウベ、マテイタノニキテクダサイマセン、ナゼデスカ、シドイシト、ワタシノココロモシラナイデ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ、ハタケモノハヨクナイデセウ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「有難うございます、手妻使いのようには見えませんか」「イヤ、ソウデナイデス、立派ナ西洋貴婦人アリマス」　こういう問答で、一座がにわかに春めいてきたが、主膳の苦々しさったらない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イヤ、馬鹿デナイデス、オ嬢サン、アナタ考エ無シデス」「お前がわたしを騙したんだわ、ああ、いやな奴。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、アナタ、モウ、ワタシノモノアリマス、逃ゲラレマセン」「ばかにおしでないよ、お前さんなんて、ウスノロのくせに」「アナタ、モウ、ワタシニ許シタデス、ワタシモウ、アナタ離サナイデス」「しつこい奴ね」「アナタ、ワタシノモノデス」「あ、畜生！",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、急に娘の言葉が甘ったるくなって、「ねえ、マドロスさん」「エ」「そんなに苛めなくてもいいことよ」「ワタシ、チットモ、アナタイジメルコトアリマセン、アナタ可愛クテタマラナイデス」「可愛がって頂戴。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですからその數行が君にロダンのダナイデの像の美しさを喚び起したなら、それはそれなりに味つてゐて好いのでありませう。",
              "citation": {
                "source": "心の仕事を",
                "author": "或未知の友への手紙",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナニ高イ所ニイラツシヤラナイデ、コノ涼シイ草ノ葉ノカゲヘイラツシヤイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤキユウヲスルノニ、コエヲダサナイデスルトイフワケニハユカンモンデスカネ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　イヂノワルイ　オサルサンガ、「ザウサンハ　タイヘン　オギヤウギガヨイトイッテ　ミンナガホメルケレドモ、バウシヲトルノニ　テデトラナイデ、ハナデトルデハナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
