          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ここを触らないで！危ないから！」と子供が叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "急がないで大丈夫だよ、まだ時間はあるから。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「心配しないで、私に任せて」と彼は力強く言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
