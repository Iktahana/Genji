        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何奈ンゾ之ヲ賜ハル恩沢ヲ忘レテ、之ヲ遣フ湯水ノ如クナルヤ。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　ミナサンモ　ゴランニナルヤウニ　カメサンハ　ミンナ　イマダニ　ハダカデ　クラシテイルト　イフワケデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモソノ考証｜研覈ノ如何ニ至ツテハ彼ノ最詳確ニシテ我ノ甚シク杜撰ナルヤ固ヨリ日ヲ同ジクシテ語ルベキニ非ラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡ソ人ノ子トナルヤ父母ヲ顕スヲ孝ノ終トス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤワガ江戸ノ大ナルヤ、文章ノ淵藪ニシテ、牛耳ヲ執リ盟主トナル者騒壇ニ角立スルヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔南坊北巷望ムコト隣リノ如シ／我往キ君来ル数武ノ塵／何ゾ幸ヒナルヤ門庭接近ヲ成シ／恰モ宜シ詩酒精神ヲ闘ハスニ／柳橋妓ニ命ズルハ少年ノ興／駒野禅ニ参ズルハ前世ノ因／廿歳旧游游ビテ未ダ了ヘズ／又台麓酔吟ノ人ト為ル〕　昆渓が下谷に来ると間もなく毅堂が下谷を去った。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸ニ登リ旗亭ニ憩ヒ、主人ニ前駅ヲ距ルコト幾許ナルヤヲ問フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "或云、大月ノ分界ニ山上ニ登ルコト六町許ニシテ、危岩峨々トシテ峙立セル所アリ、之ヲ砕ケバ菊紋アリ、此処菊花山ナリトモ云、何レガ正説ナルヤ分明ナラズ、大月、駒橋元一村ナレバ、山モ連峰ニテ分界ナシ、然レバ都テ此南山ヲ菊花山ト云シナルベシ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嚮ニ選レテ衆議院議員トナルヤ、第二議会ノ時初メテ状ヲ具シテ政府ニ質ス所アリ、爾後議会ニ於テ大声疾呼其拯救ノ策ヲ求ムル茲ニ十年。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "公卿日記のどれにも、この年の秋ごろからボツボツ「頼朝ノ舎弟九郎ナル者」という記事が見え出しているが、「――ソノ何者ナルヤヲ知ラズ」とみないっている。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
