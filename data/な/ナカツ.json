        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "厩戸ノ皇子ハ、寵臣ニソムカレタ事ハナカツタ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御度量のひろい将軍家に於いては、もちろん、御計画の頓挫をいつまでも無念がつていらつしやるやうな事は無く、あの、大かたり者の陳和卿に対してもいささかもお怒りなさらず、医王山ホド、ウマクイカナカツタヤウデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ　コノ　コノ　トコロニハ　ウグヒスハ　アソビニ　コナカツタデセウカ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コドモタチヤ、コノ　バシヤハネ、オマエタチガ　マダ　ウマレナカツタ　ジブン、マダ　ジドウシヤト　イフ　モノガ　ナカツタ　トキ、ムラカラ　マチノ　テイシヤバマデ　マイニチ　カヨツタ　モノダヨ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチガ　オナラヲ　シナカツタカラデ　アリマス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヤツパリ　イタチハ　ヨブンヂヤ　ナカツタト　オモヒマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナトカタカナハ相前後シテ生レタラシイガ、前者ハ毛筆ト和紙ニ対シ適合性ヲ持ツテイタタメ今日マデ愛用サレタニ反シ後者ハ適合性ヲ持タナカツタタメ、一千年ノ間カエリミラレルコトガナカツタ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシモコレヲ不調和ト感ジル人ガアツタラオソラクソノ人ガカタカナヲ見ナレナイセイカ、ソウデナカツタラ数学ノ本デ十分ニ痛メツケラレタ記憶ヲ持ツ人ニチガイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ後急ニ近隣ノ火ノ手ガ強クナリ、今戸八幡ノ方ニモ火ノ手ガ擴ガツテ來タタメ、大川縁ヲ傳ヒ北方ニ、逃ゲル仕度ヲ始メタノデ、後ノ状況ハ見ナカツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オネコサンハ、アヒルサンノ赤イ洋服ガウラヤマシクテナラナカツタノデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アア、チツトモ、オチツイテネムレナカツタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシガ、ヨクネムレナカツタノヲシラナイノカ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハエリマキモ外タウモキテヰナカツタノデ、ハクシヨン、ハクシヨン、ハクシヨントクシヤミガツヅケサマニデマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「中大兄」は、考ナカツオホエ、古義ナカチオホエ、と訓んでいる。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "×同ジ日ノ午後勿論太陽ガ在ツテイナケレバナラナイ場所ニ在ツテイタバカリデナクソウシナケレバナラナイ歩調ヲ美化スルコトヲモシテイナカツタ。",
              "citation": {
                "source": "異常ナ可逆反応",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "目的ノナカツタ丈　冷静デアツタ太陽ガ汗ニ濡レタ背ナカヲ照ラシタ時影ハ背ナカノ前方ニアツタ人ハ云ツタ「あの便秘症患者の人はあの金持の家に食塩を貰ひに這入らうと希つてゐるのである」ト‥‥‥‥‥‥‥‥‥‥‥１９３１・６・５",
              "citation": {
                "source": "異常ナ可逆反応",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に水底でお洗いになつた時にあらわれた神はソコツワタツミの神とソコヅツノヲの命、海中でお洗いになつた時にあらわれた神はナカツワタツミの神とナカヅツノヲの命、水面でお洗いになつた時にあらわれた神はウハツワタツミの神とウハヅツノヲの命です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また丹波のヒコタタスミチノウシの王の女のヒバス姫の命と結婚してお生みになつた御子はイニシキノイリ彦の命・オホタラシ彦オシロワケの命・オホナカツ彦の命・ヤマト姫の命・ワカキノイリ彦の命のお五方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にオホナカツ彦の命は、山邊の別・三枝の別・稻木の別・阿太の別・尾張の國の三野の別・吉備の石无の別・許呂母の別・高巣鹿の別・飛鳥の君・牟禮の別等の祖先です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またヤマトタケルの命の曾孫のスメイロオホナカツ彦の王の女のカグロ姫と結婚してお生みになつた御子は、オホエの王です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　このヤマトタケルの命が、垂仁天皇の女、フタヂノイリ姫の命と結婚してお生みになつた御子は、タラシナカツ彦の命お一方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでタラシナカツ彦の命は天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にオキナガタワケの王の子、クヒマタナガ彦の王、この王の子、イヒノノマクロ姫の命・オキナガマワカナカツ姫・弟姫のお三方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで上に出たワカタケルの王が、イヒノノマクロ姫と結婚して生んだ子はスメイロオホナカツ彦の王、この王が、近江のシバノイリキの女のシバノ姫と結婚して生んだ子はカグロ姫の命です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この王が庶妹シロガネの王と結婚して生んだ子はオホナガタの王とオホナカツ姫のお二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでこのオホナカツ姫の命は、カゴサカの王・オシクマの王の母君です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、仲哀天皇后妃と皇子女　タラシナカツ彦の天皇（仲哀天皇）、穴門の豐浦の宮また筑紫の香椎の宮においでになつて天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
