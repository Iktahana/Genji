        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」ト、ミツルクンヲ　オツカケテ　イツテ　三ツ四ツ　ナグリツケテ　ヤリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間、酔っ払った勢いでナグリ倒した救世軍士官の顔が、眼の前にチラ付いて来た。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌てて封を切ってみると、いよいよ読み難い赤インキのナグリ書きが古い号外の裏面に行列している。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をいうにも羽振学士をナグリ飛ばして、肝腎カナメのＵＴＡを放ったらかして万事を絶望状態に陥れて来たばかりのところで、将来の筋書がまだチットモ出来ていないんだから困る。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰤さえ返せば文句はないか」　と云ううちに、店の天井からブラ下っていた鰤の半身を引卸して、片手ナグリに箒売を土間へタタキ倒した。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "忌々しくて仕樣がないけれど、まさかナグリに行く譯にもゆかない。",
              "citation": {
                "source": "ハガキ運動",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ワズ右手ヲノバスト手ニ何カ堅イ物ガサワッタノデ夢中デ要之助ノ顔ヲナグリツケマスト彼ハ『アッ』ト云ッテ倒レマシタ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女によい友達の出来ぬのは、ナグリもしないがなでてもやらぬという態度による。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度に一人の馬鹿野郎があって、ある時、親爺の額へ蚊がとまったのを退治てやるつもりで、有合せた丸太ン棒を取り上げ、馬鹿野郎のこととて、力をこめて親爺の額にとまった蚊をなぐったものだから、親爺もろともにナグリ殺してしまった……この話で一座がまた笑い崩れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "高部を追いかける途端を、小癪なと、横合いから一ナグリに斬って捨てようとしたのが、案外にも、出足を進めないで、後ろへひいて構えた変化。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝ、余の死するや、女房とたんに血相変り、一生涯、私を、いじめたな、と余のナキガラをナグリ、クビをしめるべし。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この結果が秀吉の激怒となつて再征の役が始まつたが、秀吉が突立ち上つて冠をカナグリすて国書を引裂いたといふ劇的場面は誰でも知つてゐる。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々村の子供と大喧嘩して、ナグリコミをかけると、相手は三十人ぐらいかたまって逃げまわり、大人もソッポをむいて知らん顔をしたり、一しょに逃げまわッたりした。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときは生き残りの駄犬をつれて私のところへナグリ込みの危険があり、こういう物騒な新米には世話ができない。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡者を地獄へ送り込む火の車のように、めざましい焔色に塗り立てたモンテ・カルロ行きの乗合自動車は、橄欖の林と竜舌蘭と別荘を浮彫りにしてフエラの岬を右に見て、パガナグリア山の裾に纒繞する九折の道を、目まぐるしいほどの疾駆を続けてゆく。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "南風吹かば　――モンテ・カルロの巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の牛のハナグリは骨と木でできている。",
              "citation": {
                "source": "望郷",
                "author": "――北海道初行脚――",
                "note": "青空文庫"
              }
            },
            {
              "text": "足バカリジャナイ、コヽノ脹脛ダッテフックラシタ肉ガナクナッチマッテ、労働者ノ脚ノヨウナグリ／＼ガ出来ルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奉書の巻紙に、なぐり書きのような太い筆で――「前略四月八日、午前零時、貴殿宅へ、ナグリコミヲ掛ケル所存ニ付、左様、承知下サイ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "越後でも尼瀬と出雲崎との間にある暗礁の主なるものに、マクリ・シワナグリ・イスズグリ等のあること、近年刊行の書『出雲崎』に見えている。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナグリのハナは多分は突出の意味であろうに、安芸か備後かのある山村の雨乞石にこの名があり、牛の形をした霊石の鼻に当る部分の穴に、綱を通して強く牽けば雨が降るゆえに、鼻繰石という説明もあったかと記憶する。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
