        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモトキドキ私ニコンナコト云ウノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上デ私ノ言イ分ハホボ尽キタワケデアルガ、シカシコノヨウナコトヲ書イタカラトイツテ私ガカタカナ運動デモ開始シタヨウニ思ワレテハ迷惑デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ何々運動トイウヨウナコトハイツサイ虫ガ好カヌ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ産ヲスルマデハ、イクラ物好キナ彼奴トテモ手ヲ出ス様ナコトガアルマイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コノ、ニッポンノ紳士ハ、スコシ、アタマガ変デワナイノデショウカ、変ナコトバカリ云イマス』と。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎに「チクマアニノワタシタモノ……モシツカヘバ」……と、そこでしばらく考へてから、やつと「タイヘンナコトニナル」……。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、フシギナコトガアレバ、アルモノデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、大変ナコトニナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハソンナコトハシリマセンカラ大トクイデス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエ、イエ、ハデダナンテ　ソンナコト　アルモノデスカ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マルコオバサンガ「ソンナコト――アル――モノデスカ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　マルコオバサンガ「イエ、イエ、ハデダナンテ　ソンナコト　アルモノデスカ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ガンバリ、　マルコオバサンガ「ソンナコト――アル――モノデスカ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノマヒゴノヤウスノヘンテコリンナコトトイツタラ※　水ノ中ニムヤミト長クツカツテヰタトミヘテ、アタマノ毛ハ一本、一本、サカダチ、カホモカラダモマツサヲ、クチビルハムラサキ色。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクン、イマサラタイヘンナコトヲシタトオモッテモ、モウ　マニアヒマセン。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ムキミナコトダ）ラヂエエタアの近くで昇天するサヨホナラ。",
              "citation": {
                "source": "AU MAGASIN DE NOUVEAUTES",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その彼が噂でしか聞いたことのなかった、あるいは全く知らなかった書物もあった――ナコト写本、ジアンの書(*14)。",
              "citation": {
                "source": "闇をさまようもの",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの永劫の時を隔てた世界から物理的かつ直接的に残存しているものといえば、遥か遠隔の地と海底にあるいくつかの巨石遺跡と戦慄すべきナコト写本の断片のみである。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "豪胆な神秘家たちの何人かは、断片的なナコト写本は更新世より前の世界に起源を持つと仄めかし、あるいはツァトゥグァの崇拝者たちはツァトゥグァ同様人類とは異質の者だったと示唆している。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはこれらの生命の製作者であり、それらの生命を隷属させていた者であり、またナコト写本や『ネクロノミコン』といったものが戦きつつ仄めかした極悪非道な古神話の原型となったことにも何らの疑いはない。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "古のナコト写本が囁く凍てつく荒野のカダスにも極めて現実的でぞっとするような意味があるのかもしれないのだ。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "冗談ニソンナコトヲ云ッタラ、オ望ミナラサセテアゲマスト云ッテクレタ或ル待合ノ女将ガイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢丹ノ特選売場ヘ行ッタラ何カシラ見ツカルダロウ」実ハ外ニ少シ考ガアッタンダガ、ソンナコトハ口ニシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ、予ハトテモソンナコトヲスル気ハナカッタガ、外ニコレト云ウ治療法モナイカラ、マアヤッテゴランナサイト杉田氏ハスヽメル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十台クライマデハ死ノ豫感ガ何ニモ増シテ恐シカッタガ、今デハソンナコトハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ顔デ女ニ好カレヨウナンテ馬鹿ナコトヲ思ウ訳ハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ風デ何楽シミニ生キテルノカト、人モ思ウダロウシ、自分デモ思ウコトガアルガ、幸イト云ッテイヽノカドウカ、不思議ナコトニ食慾ト睡眠ト便通トハ至ッテ満足ニ行ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシナコトダガ、痛イ時デモ性慾ハ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
