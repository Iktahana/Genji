        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「こんな提案は無しだ！」と上司に一喝された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の言動は、社会人として全く無しだと思う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今回のプロジェクトから、あのメンバーは無しで進めよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "nonexistent",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
