        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だれでも目につく大室山を先手にして、その後に寄り添って、長尾山、片蓋山、天神山、弓射塚、臼山など、富士山を御本丸として大手からめ手に、火山の出城を築きあげている。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱根は二十年も昔水産関係の用向きで小田原へ行ったついでに半日の暇を盗んで小涌谷まで行ったのと、去年の春長尾峠まで足を使わない遠足会の仲間入りをした外にはほとんど馴染のない土地である。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれが富士山だし、あれが長尾山だし、あれが大室山だし、みんなに名前があるぢやないの。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士山の中腹にも小富士といふ山があるし、それから大室山だつて長尾山だつて、みんな富士山と続いてゐる山ぢやないの。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士山の中腹にも小富士といふ山があるし、それから大室山だつて長尾山だつて、みんな富士山と續いてゐる山ぢやないの。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "長尾原で夕食をなし、これから草津まで暗夜の強行軍。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "長尾原より、遅くも着くと大東館という旅館へ電話をかけておいたはよいが、来てみるとどうだ。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "稲葉卯三郎が通訳長尾房之助を帯同、政庁を訪れると、ケノン少佐は移民法に接触してはならぬからと口頭契約で、人夫九百名、石工千名、人夫頭二十名、通訳二名、合計千九百二十二名の労働者の供給を申込んだ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "下諏訪の桔梗屋で、本社の山中氏と私達父子は、支局の中島氏と、ヒユッテの持主で篤実の山の研究者であり、「山郷風物誌」などの興味ふかい著述をもつてゐる長尾宏也氏といふ霧ヶ峰スキイ場の開拓者として知られてゐる青年が、わざわざ山の案内役におりて来たのに、紹介されたりして、急に心強くなつた。",
              "citation": {
                "source": "霧ヶ峰から鷲ヶ峰へ",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日東餅屋あたりで、自動車をおりて坂を登りはじめた時、私は今年の不順な天候で夏以来悩んでゐた呼吸器に圧迫を感じ、これはちよつとこまつたと思つたが、やがて一ト休みして、宿で長尾氏に捲いてもらつた捲ゲートルを取はづしてからは、ずつと楽になつた。",
              "citation": {
                "source": "霧ヶ峰から鷲ヶ峰へ",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "長尾氏が高層湿原地といつた意味も、八島ヶ池と鎌ヶ池との水溜りをもつたこの一帯の沼地を見て成程と頷ける。",
              "citation": {
                "source": "霧ヶ峰から鷲ヶ峰へ",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "長尾氏から狐や兎や貉の話を聞きながら、たばこをふかしたり、林檎を噛つたりしてゐるうちに、銀鼠色の烟雨が、つい入口に近い叢のなかに佗しく咲いた深山竜胆や、多少薄べつたく変形した薄色の薊の花などを掠めて、這ひ寄つて来た。",
              "citation": {
                "source": "霧ヶ峰から鷲ヶ峰へ",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな火山岩の磊々した防火地帯へ来ると、やがて堂々たるホテルの体形をとゝのへた長尾氏のヒユッテが左手の少し低いところに見えて来た。",
              "citation": {
                "source": "霧ヶ峰から鷲ヶ峰へ",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は長尾氏の歓待にくつろぎつゝ、一夜をそこに明かして、翌日の午後雨のなかを上諏訪へおりて来た。",
              "citation": {
                "source": "霧ヶ峰から鷲ヶ峰へ",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "長尾鳥飛びて叫ぶに、行きなづみ蹲みて瞰れば、あな寒むや渓裾紅葉、鉾杉の暗みを出でてひと明り紅く燃えたり、その紅葉淵に映れり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "長尾鳥飛びて叫ぶに行きなづみ、蹲みてあれば、あなさむや、渓裾紅葉鉾杉の暗きを出でて、ひと明り紅く燃えたり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月三日　晴、行程八里、牟岐、長尾屋。",
              "citation": {
                "source": "四国遍路日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月卅日　晴れたり曇つたり、徒歩七里、長尾駅前の後藤屋に泊る、木賃二十五銭、しづかで、しんせつで、うれしかつた、躊躇なく特上の印をつける。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "早朝、地下足袋を穿いて急ぎ歩く、山家、内野、長尾といふやうな田舎街を行乞する、冷水峠は長かつた、久しぶりに山路を歩いたので身心がさつぱりした、こゝへ着いたのは四時、さつそく豆田炭坑の湯に入れて貰つた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五歳の姉｜安は四年前に阿部家を辞して、横山町の塗物問屋長尾宗右衛門に嫁していた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百の姉安を娶った長尾宗右衛門は、兄の歿した跡を襲いでから、終日｜手杯を釈かず、塗物問屋の帳場は番頭に任せて顧みなかった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年に五百の姉壻長尾宗右衛門が商業の革新を謀って、横山町の家を漆器店のみとし、別に本町二丁目に居宅を置くことにした。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "二年｜前から寄寓していた長尾氏の家族は、本町二丁目の新宅に移った。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百の姉壻長尾宗右衛門は、抽斎に先つこと一月、七月二十日に同じ病を得て歿した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百は敬に壻を取って長尾氏の祀を奉ぜしめようとして、安に説き勧めたが、安は猶予して決することが出来なかった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "長尾氏の遺族の如きも、もし独立せしめようとしたら、定めて心細く思うことであろう。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に晩年になっては、嘉永二年に津軽｜信順が抽斎のこの習慣を聞き知って、長尾宗右衛門に命じて造らせて賜わった椀のみを用いた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百はこれを旨がって、兄栄次郎と妹壻長尾宗右衛門とに侑め、また比良野｜貞固に飲ませた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その六十六　邸内に棲わせてある長尾の一家にも、折々多少の風波が起る。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
