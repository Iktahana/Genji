        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "我が家の新しい子犬の名前は、娘が「リク」と名付け親になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プロジェクトの成功を願って、チームリーダーがプロジェクトに「フェニックス」という名前を名付け親となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この小さなカフェのユニークな名前は、常連客の一人が名付け親になったそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
