          "literary": [
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ他日本文化ノ普及ニ役立ツコトハ非常ナモノデアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼトイヘバ、アヒルサンハ赤イモノナラ、ドンナモノデモ大キラヒダカラデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼトイヘバ、オネコサンハ赤イモノナラ、ドンナモノデモ大スキダカラデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガトウダンスノ胼胝ノオ蔭デスッカリ穢クナッチャッタンデ、トウヲ止メテカラ一生懸命モトノヨウニシヨウト思ッテ、毎日々々軽石ダノ鑢ダノイロンナモノデ擦ッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現金ナモノデ、コノ程度ナラ墓地ヲ見ツケニ行ケソウナ気ガシテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンナモノデ宜シュウゴザイマショウカ」「結構々々、コレデ早速間ニ合イマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ釈迦様ノ足ハ霊験アラタカナモノデ、佛様ガ歩行スル時ハ足ハ地ヲ離レルコト四寸、足ノ裏ニ千輻輪ノ相ガアッテソレガ地ニ現レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ガコノ日記帳ヲ盗ミ読ミシテイルヲ書イタラ今後酔ウヲ証拠立テルヨウナモノデアルカラ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
