          "literary": [
            {
              "text": "理由のない、良心の呵責に悩み疲れている。",
              "citation": {
                "source": "地虫",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後者は自己を鼓舞し激励するとともに、多くの悩み疲れた同胞を鼓舞し激励します。",
              "citation": {
                "source": "ある思想家の手紙",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たぶん我が国の政治様式の性質およびそれらの結果によるのであろうが我々はこれらの原因によって不安定な状態で悩み疲れている。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "激しい人生の戦闘に悩み疲れる時、本当に心の通ずる人にそばにいてもらいたい。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
