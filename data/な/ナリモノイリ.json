    "definitions": [
      {
        "index": 1,
        "gloss": "flourish of trumpets",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
