          "literary": [
            {
              "text": "あたし、ナジモヴの椿姫をむかし見たことあるけど、あれも良かったわ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに夏になれば鎌倉に粗末な家でもかりて、そっちへ仕事をしにゆくとか、ナジモ※の「椿姫」を見のがさず、日本橋でうまい鰆の白味噌づけを買い、はしらとわさびの小皿と並べて食卓を賑わすとか。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は、映画女優のナジモでは見なれないジャージの服を着て、赤いコーカサス鞣の室内靴をはいている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クローデット・コルベールの主演、演技指導アラ・ナジモヴァ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
