        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "外国ノ人タチナドモカナヲ一種類オボエレバイイコトニナレバ非常ニ助カルダロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナド見エ、又豐後風土記日田郡五馬山ニ、土蜘蛛五馬媛、肥前風土記佐嘉郡ニ、土蜘蛛大山田女、狹山田女ナドモアリ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ他イロ／＼医師ヤ看護婦ノ便宜ナドモ慮ッタ結果デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンノ説ニ依ルト颯子ハアレデナカ／＼計数ニ委シク、出入ノ商人ノ請求書ナドモ忽セニシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇治拾遺にいう清徳トイウ聖アリケリ、多食ノ人ナリ、四条ノ北ナル小路ニ、シ散ラシケレバ、下司ナドモ穢ナガリ、尿小路トツケタリケルヲ――　四条の南に綾小路があるゆえ、それと対比して以後は錦小路と呼ぶべしと、官から申しつけが出たことなどもあったらしい。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
