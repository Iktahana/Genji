[
  {
    "uuid": "99392f5f-5422-5326-a3cf-58bfe574786d",
    "entry": "眺め渡す",
    "reading": {
      "primary": "ながめわたす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
