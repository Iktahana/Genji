  {
    "uuid": "146fdd78-2c22-522f-a6ef-d26b07aed3fb",
    "entry": "ナレバ",
    "reading": {
      "primary": "なれば",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヤガテ高木モ夜トナレバ、　　　サラニアシタヲ云ヒカハシ、ヒトビトオノモ松ノ野ヲ、　　　ワギ家ノカタヘイソギケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「退屈ノ折カラナレバ対手欲シ。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人ガ大經世家タルカ大發明家大哲學者大藝術家タルカハ、彼等ノ立案スル如ク社會ガ認メテ勞働ヲ免除スト云フ事前ニ察知スベカラズシテ悉ク事後ニ認識セラルル者ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ賠償ヲ別途ニ命ジテ同居ヲ父ニ強ヒザル所以ハ、遺棄シタル事情ガ背徳ニセヨ又ハ積極的活動ノ爲ニセヨ干渉スベカラザル別事ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トナレバ右ノ九人ノ人間ガ死ンダ事件ノ裏面ニ潜ム恐ロシイ爆弾売買ノ真相ヲオ話シ出来ルモノハ、私一人シカ居リマセンカラ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国ノ人タチナドモカナヲ一種類オボエレバイイコトニナレバ非常ニ助カルダロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "時世ヲ徴シ風土ヲ察シ、工業ノ進歩如何ヲ考フル為メナレバ、泰西諸国ニハ殊ニ貴重スルコトニテ、博物館ノ如キハ観客日ニ麕集ス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代ノ物程貴クシテ愛ス可キハ無シト雖ドモ、千年モ古ニシテ百年モ亦古ナレバ、只管古キヲノミ喜ブハ、贋物ヲ取ルノ憂無キニ非ズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "其他ハ皆常ニ座右ニ在ル書ナレバ曝スニモ及バジ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣裳ハ寒暑ヲ凌グ計リナレバ曝ス可キ程ノモノトテハ無シ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅政友氏は「漢籍倭人考」投馬國の條に不彌國ヨリ南ニ向ヒテ進ミ行クコト二十日ノ後ニ、投馬國ニハイタルトノ義ナレバ、必ズ内海ニハアラズ、豐前豐後ノ東洋ヲ經テ、日向アタリ所謂投馬國ナラント覺シケレバ、本居翁ノ説オホカタハ違ハサルベシ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "那珂氏は菅氏の説に對しては筑前博多ヨリ贈於郡ニ至ルニ、豐前豐後日向ノ東ニ沿ヒテ、佐多岬ヲナレバ、信ゼラレズ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士ハ魏志文ヲ引クニ、伊都國ヨリ邪馬臺マデノ行程ヲバ略カレタレドモ、コレラノ行程ハ、國々ノ位置ヲ求ムルニ必要ナル者ナレバ、多少ノ誤謬ハ免レズトモ、全クハ棄ツベキ者ニアラズ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日、使ニ来リシ犬ハ、最モ愛スベキ忠犬ナレバ、ヨクイタハリ、カヘルトモ、留マルトモ、犬ノ意志ニ任セテサシツカヘナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "（２）「逢フ」ハ思ハズ出逢ヒタル事ナレバ、「ふと見れば」ト譯セリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "此處ハ便要トツヾキ、漁夫ノ斷ハルヲ先ヅ／＼ト無理ニ引キツレ往キシ、素樸ニシテ親切ナル状ヲ示シタル極メテ力強キ助辭ナレバ、數語ヲ加ヘタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ酒ト妓ト有ノミナレバ未其ノ凡且俗ナルヲ免レズ。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "左様ナレバ小官御同道ニテ帰府致ス可ク、シカシ此レハ思召ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女、四角い竹で編んだ籠の上に、此者帰国セント思ヘドモ旅金ナキ者ナレバ大方ノ御恵与を乞フ。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "其頃人丸ハ天皇ヲ始メ女御皇妃ニ交リ歌ノ御師ナレバ、其妻モ同様御所方ニ召サレ候ヘバ、下民ノ娘ニテハ不都合ユヘ、依羅氏ノ義女トナリ玉フトナン。",
              "citation": {
                "source": "人麿の妻",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るにこの三山歌は目録には「中大兄三山御歌」と「御」が入っているに就き、代匠記には「中大兄ハ天智天皇ナレバ尊トカ皇子トカ有ヌベキニヤ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ハ妻ノタメニハ天ナレバ高キト云ヘリ」（代匠記）等と解したが、大神真潮が、誰笥歟将持の意に解し、古義で紹介した。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　犯罪に因りて得た金品は何に使ったか毫モ利欲ヲ目的トシテナシタ行為デハナク、従ッテ金品ハ何等得テ居ナイ七　自分の悪癖は何と思ふか事ヲナスニ於テ散漫ニ陥ルノガ自分ノ最大ノ悪癖デアルト思フ八　是れまで何か信じて居ったか宗教ノ意味ナレバ何モナシ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪勢魔法ヲ以テ種々ノ奇術ヲ施シ、盛夏ニ雪ヲ降ラセ、或ハ火ヲ雨ラセ、王軍ヲ悩マス数々ナレバ、御進撃被遊、岩代国火打岳ヨリ神風ヲ起シ、御征伐ナシケレバ、悪勢通力ヲ失ヒ、一日ヲ不出シテ撲滅シ、賊党四方ニ敗走スト。",
              "citation": {
                "source": "尾瀬の昔と今",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "因ニ云フ、確乎タル証拠ナシト雖モ、旧来ヨリ言伝ヒ聞伝ヒヲ参考スルニ、山野等ノ名称粗々縁故アルモノヽ如クナレバ、記シテ後来ノ識者ニ俟ツノミ。",
              "citation": {
                "source": "尾瀬の昔と今",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗祗ノ旅日記ニ、日坂ニテ富士ヲ望メハ、南ハ険シク北ヘ長ク足ヲ引テ伏屋ノ形ニ似タリ、足柄嶺ニテ見ルモ同之キヨシ記セリ、山ハ伏覆ノ義ナレバ、不尽不時等ノ仮名ヲ用フルモ皆伏ス意ニテ、其訓藤蔓ニ通ヒ、ふしトモつるトモ云ヘリ、云々。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或云、大月ノ分界ニ山上ニ登ルコト六町許ニシテ、危岩峨々トシテ峙立セル所アリ、之ヲ砕ケバ菊紋アリ、此処菊花山ナリトモ云、何レガ正説ナルヤ分明ナラズ、大月、駒橋元一村ナレバ、山モ連峰ニテ分界ナシ、然レバ都テ此南山ヲ菊花山ト云シナルベシ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当村ニテ最モ高キ山ナレバ青根山トモ呼。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
