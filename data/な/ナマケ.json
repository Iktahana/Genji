[
  {
    "uuid": "ad452f69-7172-5621-b3f2-24773e40dec1",
    "entry": "怠け",
    "reading": {
      "primary": "なまけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
