  {
    "uuid": "dcc084d8-195d-5390-b253-977853c409cf",
    "entry": "ナケレバ",
    "reading": {
      "primary": "なければ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
