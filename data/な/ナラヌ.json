  {
    "uuid": "2bf3c508-0576-5ea0-8335-61ae11706dc3",
    "entry": "ナラヌ",
    "reading": {
      "primary": "ならぬ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、居留民ノ生命財産ノ保護、国旗ノ尊厳トイウガ如キ言葉ニ迷ワサレテハナラヌ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二タス二ガ四ニ相等シイのと同じように「隊長ハ鶏ノスキ焼キガ食ベタイ」「二人ハ鶏ノ徴発ニ赴カネバナラヌ」「徴発出来ナケレバ半殺シニナル」という三つの意味は相等しいのである。",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "水産翁、轟雷雄先生ガ免職ニナリマシタ裡面ニハ、国家ノタメニナラヌ重大秘密ガアリマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コレカラソノ論証ヲシナケレバナラヌガ、アマリ十分ナ紙幅ガナイカラ箇条書ニシゴク簡単ニ書ク。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在カタカナガ一般ニ使ワレテイルノハ数学書、法律書、官報、軍関係ノ書類ナドデアルト思ウガ、イズレモ最モ正確ヲ期セナケレバナラヌ種類ノモノバカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又好悪ノ出来ルト云フコトナリ、危キ事ヲモ犯シテ為サネバナラヌ、心ニ思ハヌ事ヲモ枉ゲテ行ハネバナラヌナドト、心苦シキコトノナキ趣意ナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガハバカリニ入ッタ後、私ハ床ノ中デイロイロ考エマシタガ、ドウシテモ彼女ニ会ッテ彼女ノ心ヲ飜エサネバナラヌト思イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ薯のシッポでも煮てアクを抜カネバナラヌ）　十一月二日のお手紙がけさつきました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "況テ宝器什物ノ有ル可キ様無ケレバ、必ズ曝サネバナラヌト云フコトモ無ケレド、午熱烈シキ比快キ風ノ吹キ入ルヽ小楼ニ、独リ古キ櫃ドモ取出デヽ、手ニ触ルヽ物ヲ列ラネ曝ス程面白キコトハ有ラジ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ、軍人ト軍隊ト軍部トヲ混同セシメテハナラヌ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一家ノ主人ハ自分ノコトバカリヲ考ヘテハナラヌ。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ役人サマ、と云う言葉には、その言葉に即した生活が現に存しているのだし、親分然と「オ若イ人」だの、オ若イ、オ若イ、などという、みんな言葉に即した生活が実在して、その生活が実在する限り、その言葉にはノッピキナラヌものがあり、イノチがあるではないか。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに、呉氏、キッと目をあげて、「双葉関は、どうしていますか」　有無を言わさぬ、ノッピキナラヌ語調である。",
              "citation": {
                "source": "本因坊・呉清源十番碁観戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の文章道の名人大家はノッピキナラヌ言葉などといふけれども、僕のは用を弁じて足りればよろしいタテマヘだから、こんな時にはアッサリ「カブセル」と変へて、すましたものだから、たいして驚きも困りもしない。",
              "citation": {
                "source": "新カナヅカヒの問題",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルイハ一着３　　　　　　　３　　赤二郎　　マズ見込ナシ４　　　　　　　４　　黄三郎　　油断ナラヌ。",
              "citation": {
                "source": "安吾巷談",
                "author": "今日われ競輪す",
