          "literary": [
            {
              "text": "センジュガンピの語原　ナデシコ科のセンノウ属に深山生宿根草本なるセンジュガンピと呼ぶものがある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガンピ（ナデシコ科の花草であるガンピと同名異物）は元来はこの類の総名で、昔はカニヒと称えたものである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハコベラ　ハコベラはナデシコ科のハコベである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてナデシコ科で、いずれカーネーションが咲きそろう。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれ、ナデシコ科の新種で世界を驚かそうとしている。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
