          "literary": [
            {
              "text": "六月の二日、岐阜を出た信長の列は、いま美濃から近江の境――山中越えにかかってゆく。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "山中越えの片輪の飢民たちに、木綿をめぐみ、小屋掛料を施し、あとあとの生活まで、飢え凍えぬように注意して行った人もまた同じ信長であった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の頃、駒を止めた山中越えも通って――近江路へさしかかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
