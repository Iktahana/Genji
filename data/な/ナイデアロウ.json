        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ人ガ優レタ藝術家デアレバアルホド、断乎トシテ刎ネツケハシナイデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "足ガ自慢ノ彼女ハ、自分ノ足ガ佛陀ノ足ニ比セラレテ朱印ヲ紙ノ上ニ落スノヲ見テ、必ズヤ心ニ喜悦ヲ禁ジ得ナイデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、気味ガ悪イカラ忘レヨウト思ッテモ、容易ニ、恐ラクハ一生涯、ソノ記憶ヲ拭イ去ルコトハ出来ナイデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーソドックスヲ好ム彼女ハ毎年ノ吉例ニ従イ、必ズソノ行事ヲ厳粛ニ行ワナケレバ承知シナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハカネテカラ、敏子ガ木村ヲ避ケル風ガアルヲ、彼女モ感ヅクニ至ッタカラデハナイデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ理性ハ制御ヲ命ジタトシテモ、彼女ノ飽クナキ肉体ハ理性ノ言ニ耳ヲ貸サズ、僕ヲ破滅ニ追イ込ムマデモ満足ヲ求メテ已マナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ僕モ考エルガ、ソレヨリ先ニ彼ラガ考エ出サズニハ措カナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
