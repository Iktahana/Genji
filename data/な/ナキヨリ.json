          "literary": [
            {
              "text": "なんといっても親は泣き寄りで、まさかに情なくも追い返すまい。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際挙人老爺と趙秀才はもとからあんまり仲のいい方ではないので「しん身の泣き寄り」などするはずがない。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "他人は泣き寄り、という言葉がかれらの唯一の頼りであり、信仰であるようにさえみえる。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
