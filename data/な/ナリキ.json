        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "中世ノ所有權思想ハ其ノ所有ガ奪取ナルト否トヲ問ハズ強者ノ權利ノ上ニ立テル者ナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナリキンになるなんて、云ってやったら、邪けんな親類も、冷たい友人も、驚くだろう。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナワチ、高山山巓ニ於テ、米国ノ放送ヲ如何ナル程度ニ受信シ得ラルルカヲ試ミンガタメナリキ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "於是乎千六百十一年、彼等ハ相図リテ移住ノ儀ヲ定メ、永ク英人タルヲ得、且ツ基督教団ノ基礎ヲ据ヱ得ル処ヲ求メタリケルニ、あめりかハ洵ニ能ク此等ノ目的ニ副フモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "閤竜ノ求ムルトコロハ領土ナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ、コレ等ノ小農夫及小商人ハ、皆天ヲ敬シ、人ヲ愛スルコトヲ知ルモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ教育アリ、訓練アリ、特ニ自治ノ能力ニ於テハ優レタル天分素質ヲ有セルモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "信神渡航者ガぷりもすニ到リ着セル時ハ、北米ノ天ハ寒威猛烈ナル極月ノ、シカモ三十日ナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
