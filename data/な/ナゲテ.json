          "literary": [
            {
              "text": "第一は黒住団七を狙った鉄扇の投げ手。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "手繰っては投げ手繰っては投げかけた。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はずみをくらった投げ手が、なわ尻を取ったまま二足三あし、ひかれるようにのめり出てくる……ところを！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに、ただいまのかの投げ手は……？",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、今朝江戸御留守居の大垣殿お長屋へ――国許居城の大修理は、籠城の用意と相見えた、謀叛の企て証拠の品を揃えて、公儀へ訴え出るがどうだ――という投げ手紙が飛込んだ」　石津右門はこう語り進みます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "城の絵図面",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
