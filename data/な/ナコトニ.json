        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎに「チクマアニノワタシタモノ……モシツカヘバ」……と、そこでしばらく考へてから、やつと「タイヘンナコトニナル」……。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、大変ナコトニナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ風デ何楽シミニ生キテルノカト、人モ思ウダロウシ、自分デモ思ウコトガアルガ、幸イト云ッテイヽノカドウカ、不思議ナコトニ食慾ト睡眠ト便通トハ至ッテ満足ニ行ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ一生懸命ニ気ヲ静メヨウ、興奮シテハナラナイト自分デ自分ニ云イ聞カセタガ、オカシナコトニ、ソウ思イナガラ、彼女ノ足ヲシャブルコトハ一向ニ止メナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "残念ナコトニ予ノ方ヲ見テモクレナカッタシ、口ヲ利イテモクレナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、予自身デスラ、コンナコトニナロウトハ思イモ寄ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナトコロデ押シ倒サレテ若シ打チドコロガ悪カッタラドンナコトニナルカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョットスルト、コンナコトニ涙ガ出ルノハ、イクラ涙脆イニシテモ尋常デナイ、モウ死期ガ近イセイジャナイノカナト云ウ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
