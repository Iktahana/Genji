    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "祭日〔二〕宮沢賢治アナロナビクナビ睡たく桐咲きて峡に瘧のやまひつたはるナビクナビアリナリ赤き幡もちて草の峠を越ゆる母たちナリトナリアナロ御堂のうすあかり毘沙門像に味噌たてまつるアナロナビクナビ踏まるゝ天の邪鬼四方につゝどり鳴きどよむなり",
              "citation": {
                "source": "祭日〔二〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）私ノ町ノ知的素養ノイクブンナリトモアル青年デモ、自分トイウモノニツイテ思イヲメグラス人ハ少ナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「喧嘩口論、悪人成敗、命ノヤリトリ、白刄クグリ、ヨロズ退屈凌ギトナルベキ荒事ナラバ何ナリトモ御相談ニ応ズベク候間、遠慮ノウ当館ヘ申出デ可然候。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「唖ニ候エバ、御筆問下サレ度、陰陽四十八｜占、何ナリト筆答致ベク候。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「唖ニ候エバ、御筆問下サレ度、陰陽四十八占、何ナリト筆答致ベク候。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "行クニノゾンデ、継イデ見ンコトヲ約シ、ソノ館舎ヲ詢ヘバ、豊陽館ナリトイフ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十世紀ニ命ジテ十九世紀ニ背クヲ禁ズル革命論ノ多キヲ不審ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ總代者が投票當選者タル制度ノ國家ガ或ル特異ナル一人タル制度ノ國ヨリ優越ナリト考フル「デモクラシー」ハ全ク科學的根據ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "民國八年マデノ支那が前者タル理由ニヨリテ後者タル自耳義ヨリ合理的ナリト言フ能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ノ短所ナリト考ヘテ新ナル長ヲ學ブ者ト速斷スベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "徴兵ガ「國民ノ義務」ナリト云フ意義ニ於テ選擧ハ「國民ノ權利」ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義ガ私有財産ノ確立セル近代革命ノ個人主義民主主義ノ進化ヲ繼承セル者ナリトハ此ノ故ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑法ヲ遵守セズシテ放火殺人ヲ敢テスル者アルガ故ニ刑法ハ空想ナリト云フ者ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又土地ハ神ノ人類ニ與ヘタル人權ナリト云フガ如キ愚論ノ價値ナキハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ二者ノ孰レカヲ決シ得ル國家ハ其ノ國情ノ如何ヲ考ヘテ最善ノ處分ヲナセバ可ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ動カスベカラザル原理ハ、都市ノ住宅地ト異ナリテ農業者ノ土地ハ資本ト等シク其經濟生活ノ基本タルヲ以テ、資本ガ限度以内ニ於テ各人ノ所有權ヲ認メラルル如ク、土地亦其限度内ニ於テ確實ナル所有權ヲ設定サルルコトハ國民的人權ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人類ヲ公共的動物トノミ考フル革命論ノ偏向セルコトハ、私利的欲望ヲ經濟生活ノ動機ナリト立論スル舊派經濟學ト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ニ發達スルモ公共的生産ガ國民生活ノ全部ヲ蔽フ能ハズシテ、現實的將來ハ依然トシテ小資本ニヨル私人經濟ガ大部分ヲ占ムル者ナリト云フモ其三。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民自由ノ人權ハ生産的活動ノ自由ニ於テ表ハレタル者ニツキテ特ニ保護助長スベキ者ナリト云フモ其四。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大資本ガ社會的生産ノ蓄積ナリト云フコトハ社會主義ノ原理ニシテ明白ナルコト説明ヲ要セズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ安寧秩序ヲ保持スルコトガ國家ノ唯一任務ナリトセバ、國民ノ死活榮辱ヲ日夜ニ亘リ終生ヲ通ジテ脅威シツツアル此等ヲ處分セズシテハ國家ナキニ同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ事業ガ未ダ私人生産業限度ノ資本ニ達セザル時ト雖モ、其ノ性質上大資本ヲ利トシ又國家經營ヲ合理ナリト認ムル時ハ、國家ニ申達シ双方協議ノ上國家ノ經營ニ移スコトヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ニ對シテ人類ハ公共的動物ナリト云フ共産主義者ノ人生觀ガ半面ヨリ最モ有力ニ説明シ盡シタルハ人ノ知ル如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ此ノ改造ヲ行ハズシテ而モ徒ラニ同盟罷業ヲ禁壓セントスルハ、大多數國民ノ自衞權ヲ蹂躙スル重大ナル暴虐ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞働者ハ其ノ勞働ヲ賣却スル者ナリトハ舊派經濟學ノ誤説ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ「ロイドヂヨーヂ」氏ノ試ミタル養老年金法案ノ如キハ、國民ノ大部分ガ扶養スベキ男子ヲ有スルガ故ニ、日本ニ於テハ茲ニ掲グル例外的不幸ヲ除キテ無用ナル立法ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民教育ニ於テ英語ヲ全廢スベキハ勿論、特殊ノ必要ナル專攻者ヲ除キテ全國ヨリ英語ヲ驅逐スルコトハ、國家改造ガ國民精神ノ復活的躍動タル根本義ニ於テ特ニ急務ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度人支那人ノ國語亦決シテ日本語ヨリ劣惡ナリト云フ能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
