        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "文壇、コノ四、五｜年ナカッタコトダ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　其ノ日マデ、確カナ証拠ガナカッタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ソレヲ聞カナケレバアンナニ憤慨ハシナカッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　オ前ハ二人ヲ殺スノニ何モ物ヲ使オウトハシナカッタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度ソノ時下カラ人ノ来ル足音ガシタノデ、私ハイソイデ立チ上リ、ナイフデ死ノウカドウシヨウカト迷ッテ居タノデス、清三ハ未ダ死ニ切レナカッタト見エ又起キ上リカケマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰カ来テクレタ人ニ云ウヨウスデシテ、決シテ一郎トイウ名ヲタダヨンダノデハナカッタト思イマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレカラ兄ヘ只ハ済マヌカラ、書附ヲ出セト云ウカラ、ソレモシナカッタ、姉ガイロイロ心配ヲシテ、諸寺諸山ヘ祈祷ナド頼ンダトイウコトヲ聞イタカラ、翌年春、挨拶安心ノタメ隠居シタガ、三十七ノ歳ダ」　三十七にもなるどうらくおやじを檻には入れそこなったが、隠居ということで、兄貴たちもまず安心の体。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シアナタノ作ヲ読ムノハヒマガ入ラナカッタ。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老イタト云ッテモ三十ソコ／＼デナオ美シカッタガ、見タトコロ年増女ト云ウ感ジデ、トテモ男性トハ思エナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ図ラズモ予ノ希望ハ叶エラレタガ、首尾ヨク同衾シ、事ヲ行ウニ至ッテモ、普通ノ藝妓ト普通ノ方法デ行ッテイルノト異ルトコロハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ技巧ヲ以テソレヲ感知セシメナカッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ如何ニ技巧ガ巧妙デアッテモ、モト／＼予ノ趣味デハナカッタノデ、タッタ一遍好奇心ヲ満足サセタヾケデ、ソレキリ同性ト関係シタコトハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢丹ノ特選売場ヘ行ッタラ何カシラ見ツカルダロウ」実ハ外ニ少シ考ガアッタンダガ、ソンナコトハ口ニシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紳士用ノ特選売場ハ三階ダッタガ、生憎好マシイステッキハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入梅中ハ湿気ガ多イノデソノセイモアルガ、去年ノ入梅中ハコンナデハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダケドアレヲ提ゲテ歩イタラ、僕ガ買ッテヤッタンダト、婆サンガ感ヅキャシナイカナ」「オ婆チャンハアノ時見テイラッシャラナカッタワ、ドン／＼歩イテ先ノ方ヘ行ッテラッシャイマシタワ」ヤッパリソウダッタナト予モ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテ癌デハナカッタガ、頸骨ノ六番目ト七番目ガ変形シテイルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ、予ハトテモソンナコトヲスル気ハナカッタガ、外ニコレト云ウ治療法モナイカラ、マアヤッテゴランナサイト杉田氏ハスヽメル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ放任主義ダカラ敢テ干渉シナカッタガ、婆サンハ颯子トノ結婚ニハ反対ダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステージダンサーデモ幾分カソウナルケレドモ、アタシハ幸イニシテナラナカッタワ」浄吉ガ彼女ニ魅セラレタノハ彼女ノ姿態ニアルコトハ確カダガ、ロク／＼学校モ出テイナイノニ、頭モ悪クハナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年時カラ六十三四ニ達スルマデハ、肛門周囲炎ノ手術デ一週間程度入院シタ以外、病気ラシイ病気ハシタコトガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "六十三四歳ノ時高血壓症ノ警告ヲ受ケ、六十七八歳ノ時軽微ナ脳溢血デ一カ月程寝タガ、肉体的苦痛ト云ウモノハ知ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サモナカッタラ疾ックニ死ンデイタカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚シタテハソレホドデモナカッタノダガ、コノ三四年目立ッテソンナ風ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今年ハソノ割ニ雨ガ降ラナカッタジャナイカ」「モウ今日ハ草市デスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何ダ、モウ起キテタノカ」「アタシコソ昨夜ハ寝ラレナカッタワ」予ガ窓ノブラインドヲ上ゲルト、寝起キノ顔ヲ見ラレタクナイラシク、慌テヽ浴室ヘ逃ゲテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
