        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ナンダ　カナヅチカ、オンナジヤウナ　カタチヲ　シテ　ヰルガ、フエハ　ヨイ　オトヲ　タテヽ　ナルノニ、カナヅチハ　ナンニモ　ナラナイ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウダ、コノ　キノドクナ　ヒトビトヲ　タスケテ　ヤラネバ　ナラナイ」　ヲトコハ　アチラ　コチラノ　ムラニ　ノコツテ　ヰル　ヒトビトヲ　ヒトトコロニ　アツメマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ上ルノニ、トチュウデ何ンベンモヤスンデ、イキヲ入レナケレバナラナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ気モチハ一寸オワカリニナラナイカモ知レマセンガホントウデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生はなほこれらの史料を過信することを戒められ、兎モ角モ人間ノ眼デ見タ證據程當テニナラナイモノハナイトイフ、心理學上ノ事實ハ、吾々ノ忘レテナラナイ誡デアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナツテシマフノデスガ、今夜ハサウナラナイ内ニ、ワザト魔法ニカカツタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナッテシマウノデスガ、今夜ハソウナラナイ内ニ、ワザト魔法ニカカッタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでそれが莫騎すなわちナノリソ（乗ッテハナラナイ）である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "×同ジ日ノ午後勿論太陽ガ在ツテイナケレバナラナイ場所ニ在ツテイタバカリデナクソウシナケレバナラナイ歩調ヲ美化スルコトヲモシテイナカツタ。",
              "citation": {
                "source": "異常ナ可逆反応",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ未ダニ前ノヨウニハナラナイワ」「ドレドレ、チョットオ見セ」ハカラズモ予ハ彼女ノ素足ニ触レ得ル機会ヲ掴ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジット正面ヲ視ツメタマヽデイナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビフテキデモ鰻デモ過度ニナラナイ程度ナラ差支エナイトノコトナノデ、何デモオイシク食ベテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、マダオ休ミニナラナインデスカ」「今寝ルトコロダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日マデノトコロデハ、手ノ冷感モ指先ノ感覚ノ麻痺感モ依然トシテヨクナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ聞カサレルト、予モ何トカシテ居残ル算段ヲシナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ始メテカラ一カ月ニモナラナインダカラ、今止メルノハ惜シイヨ」「ソレジャ、今年ハイラッシャラナイオ積リ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレカラ四五十分間、予ハ鈴木氏ニ体ヲ預ケナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ一生懸命ニ気ヲ静メヨウ、興奮シテハナラナイト自分デ自分ニ云イ聞カセタガ、オカシナコトニ、ソウ思イナガラ、彼女ノ足ヲシャブルコトハ一向ニ止メナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ今日ハ眼ガ赤クナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヲ止メタノハ医師トシテ実ニ立派ナ心ガケト云ハナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南禅寺ヘハオ泊リニナラナイノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアニ、明日日曜ナンデミンナ遊ンデイルンデスヨ」京都駅ハ下リノ時ハブリッジヲ沢山登ラナケレバナラナイノデ、コレガ甚ダ億劫デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ佛様達ハ東京ニ置イトカレルト、骨ニナッテカラモ始終アッチコッチヘ逃ゲ回ラナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルヘ戻ッテ何シテタンダ」「寒クナリソウダカラ着換エテ来タノヨ、オ爺チャンモ気ヲオ付ケニナラナイト風邪ヲ引クワヨ」四条通リデ買ッテ来タノヲ早速着テ見タカッタノダロウ、白ノブラウスニ、ブリューニ銀ノラメガ繍イ込ンデアルセーターヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ景観ニ接シタヾケデモ、五味溜メヲ引ックリ返シタヨウナ東京トハ比較ニナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ガ短イカラ暗クナラナイウチニ見テシマッテ、奈良ホテルデ夜ノ食事ヲシタヽメテ帰ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
