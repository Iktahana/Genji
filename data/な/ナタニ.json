        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ馬鹿サンネ、私がアナタニ身ヲ任セタノハカラカッタカラダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、コノ前アナタノ十家ヘアガッタ時ハ、ヒドイ御病気デ、トウ／＼アナタニアフコトガ出来ナクテ、ザンネンデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタニハ私ノ洋服ヲカシテカゲマセウ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たどたどしい女文字の片仮名文章は、「オマンサン、コンナコト、アナタニ知ラセタクハ、ナイノダケレド、ヨクヨクノコトト、承知ノ上、読ンデ下サイ」　と、始まる。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシモ、コンナ事、アナタニ知ラセタクナイノデスガ、ドウシテモ、コノ問題ハ、アナタニ解決シテモラウシカ、手ダテガナイト考エタノデ、急ギ、コノ手紙書クノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当ハアナタシカ存在シナイノニ、アナタノ五感ニ訴エル擬似現象ハ、アナタ以外ノ存在ヲアナタニ納得サセタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホフマンのナタニエル青年は、生きた娘よりも、人形のオリンピアに命がけの恋をしたのである。",
              "citation": {
                "source": "悪霊物語",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
