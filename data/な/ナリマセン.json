          "literary": [
            {
              "text": "トコロガ　ウサギノ　ハウハ　イクラ　ダイジニ　シテ　ヤツテモ、チツトモ　オホキク　ナリマセン。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "乙姫様は一千年の時を超えて響いてくるような声で私に語りかけます――「さあ、私の父の宮殿である、南の海の底にある龍宮城へ、ともに参りましょう」「イイエ、ワタシ、熊本ヘ帰ラネバナリマセン――サッキ電報カケマシタデス」と、私が応えます。",
              "citation": {
                "source": "手紙",
                "author": "一八九三年七月二二日付　チェンバレン　宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、私ハコヽニヰナケレバナリマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ、着物ヲコシラヘナケレバナリマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラ　オホキク　フンバツテモ、チイサナ　カゲハ　オホキク　ナリマセンデシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレデハ頁ガ多クナリマセンネ。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ハ夜デヨカッタケレドモ、コレカラダト時間ガ時間ダカラ、必ズドコカデデモ隊ニ打ツカリマス、米国大使館ト国会議事堂ト南平台ヲ結ブ線ヲドコカデ横切ラナケレバナリマセン、ソノ積リデ早目ニオ出カケニナッテ下サイト、運転手ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシモクロガコイシクテナリマセン。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
