        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "並ハズレテ、タクマシキガ故ニ、死ナズ在リヌル。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "稜大使シュレンバーグ伯、またエジプトの女王ナズリ陛下、イタリアは皇甥スポレート侯爵。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が言うべくして隠していた心事は大殿さまにイナズマの如くに閃いたのかも知れません。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの方のお部屋は二階ですから、外はクラヤミで、のぞいても外が見えよう筈はありませんが、そのときイナズマが光ったのです。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "実にその一瞬にイナズマが光って、井戸と下の塀の中間に塀際へ進んでいるらしい二人の男の姿を見た。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、井戸の水音のとき、イナズマに照しだされたのは二人の男の姿であったということと、料理屋でアイビキしていたのは由也氏と三枝子さんらしいということと、どうして二ツが関係したり組み合う必要があるのでしょうか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "イナズマが照しだしたのが二人の男の姿なら、その男が誰と誰か、それを究明することだけがその事実と組み合っているヌキサシならぬことではありませんか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしもイナズマがそのとき庭を照らさなければ、彼の計画はシッポを出さなかったかも知れません。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはユスリに有利のためであり、イナズマを忘れていたためでもあり、要するに彼の恐るべき悪度胸を物語っていますよ」　それが新十郎の推理であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔流落何ゾ恨マン千里ニ投ズルヲ／猶幸ヒニ今年モ窮スルモ死ナズ〕また「佳麗江都幾時還。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "またハナズオウ（紫荊）だと主張する人もある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナズナ　ナズナは薺であって植物学上では十字科に属しダイコン、カブなどと同科である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナズナは春の七種の中で最も著名かつ代表的の者で、秋に早く種子から生じ野外や路傍や圃地などに沢山見られる。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右は何方もナズナであって、前者をオオナズナといい後者を単にナズナと称えて区別する。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナズナを食するには※でて浸しものにしてもよく、あるいは胡麻和にしても佳い。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが誰でも知っているナズナ（ペンペン草）この実が三味線のバチに似ているでしょう。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第二部　混混録",
                "note": "青空文庫"
              }
            },
            {
              "text": "三芳　……なんだそうだね、君がいつか言ってた、ほら、一時、結婚するとかしないとか騒いでいた……イイナズケになってるんだろう？",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は私どもが農村のヤクザのように言われたものですが、今では、私どもが一番の昔者でして、私どもは親きょうだい、いとこ、たいがい親類同志みたいなもので、それぞれ団員同志結婚したりイイナズケがきまっておりますから、まるで、もう、御時世に合わなくなってしまいましたよ。",
              "citation": {
                "source": "淪落の青春",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
