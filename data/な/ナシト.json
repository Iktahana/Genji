          "literary": [
            {
              "text": "ソノ所以ハ」「サレバ、友ヲ選ベバ悪人、交レバ阿諛追従ノ徒ニ若クハナシトハ、下界人間共ノ以テ金言ト成ス所ナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ如何ナル國民モ間接税ノ負擔者ナラサルハナシト云フ納税資格ノ擴張セラレタル普通選擧ノ義ニ非ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "キサマニソウイナシトワカル。",
              "citation": {
                "source": "ざんげの塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又上タル者ヨリ下ヘ許シ、コノ事ヲ為シテ差構ナシト云フコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ是ニ繼デ思慮ノ能力ヲ練熟スルコトナシト。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "今姑ラク本邦中世以上ノ文章ハ、四六ヲ用ヒ、詩ハ白氏ノ祖トスル流ハ措テ論ゼズ、慶元以還ヲ以テ比較スルモ、惺窩、羅山、闇齋ノ程朱ハ勿論、藤樹、蕃山ノ陽明ニ於ケル、仁齋ノ呉廷翰ニ於ケル、徂徠ノ王李ニ於ケル、山本、太田諸氏ノ袁鐘並ニ清初ノ諸家ニ於ケル、並ニ近世諸大家ト雖ドモ皆蹈襲摸傚ノ跡ナシト謂フベカラズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔時ハ禽獸ハ唯本能アリテ、智ハ唯人ニノミ存シテ本能ナシト云説ナリケレドモ、近世ノ發明ニテハ、禽獸ノ本能ハ、譬ヘバ書畫ヲ能クスル者ハ、臂ノ神經ニ其作用備ハリ、歌謠ヲ能クスル者ハ、喉ノ作用ニ其作用備ハルガ如シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋シ利根ノ本根ハ古来見究タルモノナシト云フ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "因ニ云フ、確乎タル証拠ナシト雖モ、旧来ヨリ言伝ヒ聞伝ヒヲ参考スルニ、山野等ノ名称粗々縁故アルモノヽ如クナレバ、記シテ後来ノ識者ニ俟ツノミ。",
              "citation": {
                "source": "尾瀬の昔と今",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "疱瘡ヲ病ムモノ、池水ヲ飲シメ祈レバ必恙ナシトイヘリ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
