        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "競合他社の新製品開発状況を、代理人を通じて内探させることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "敵陣の動向を内探していた密偵から、夜襲の計画があるとの報告が入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "表沙汰にはできない問題なので、信頼できる部下に現場の様子を内探させている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「滅相もない、ちよつとお休みやしたのに、こないたんと載いては済みまへんどす。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こないたんと戴いては冥加に尽きまつさ。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうなんかだって普通じゃなかったわ、けれどもね、考えてみれば、あのひとは、お母さんがお選びになった人だからね、お母さんは自分で切ないたんびに、どんなにか自分の責任も感じていらっしゃるにちがいないのよ、そう思うだろう？",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに日本堤に至ると、それから北は地方今戸、地方田中から三河島、日暮里、尾久と、際限のないたんぼ続き。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしのかおを　びしょびしょにしたんだから」「しーっ、ネリー、そんな話はやめて、おねがい」「でも　ないたんだから。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
