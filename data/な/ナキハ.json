          "literary": [
            {
              "text": "數百萬數千萬數億萬ノ富ニ何等立法的制限ナキハ國家ノ物質的統制ヲ現代見ル如キ無政府状態ニ放任スル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又土地ハ神ノ人類ニ與ヘタル人權ナリト云フガ如キ愚論ノ價値ナキハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "毅堂集原文の後にしるされた諸家の賛評を見るに、松岡毅軒は「墓誌ノ銘ナキハ例ヲ帰震川ガ『亡児※孫ノ壙誌』『寒花葬志』ニ取レリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "諺にも――好キ人ノ難ハ人ミナ惜シミ、好悪ニ災ナキハ人ミナ訝カル――とある通り、天の救いといえるものか。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
