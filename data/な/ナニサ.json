          "literary": [
            {
              "text": "ナニサナニサそうではない。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ナニサこんなことはとうの昔から、俺らや姥には解っていたのさ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニサ、大芝居だと云うことさ。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うのもここにいる馬鹿亭主が、イエなに、ほんの好人物で、随分働きもありますが、悪いことには神様を、ナニサ神様も結構でがすが、拝んでばかりおりましてな、生活の足しにはなりましねえ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニサ、俺らの思うには、ああいう立派な殿様だ、時頼さんの心意気で、諸国漫遊に出られたんだろう」こう云ったのも地廻りらしい男。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニサ俺だって知っているよ、その宛てという変なものをな。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニサ寝椅子はころがるものさ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニサわしは居候だ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮「ナニサあれは篠原｜子と。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛してるわ』『君のオヘソ、カワイカッタネ』『ナニサ、１センチ５ミリのデベソ。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
