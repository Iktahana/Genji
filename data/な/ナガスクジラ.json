        "examples": {
          "standard": [
            {
              "text": "長須鯨は世界で2番目に大きな動物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "船から遠くの海で長須鯨の潮吹きが見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長須鯨の保護活動が世界中で行われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "くじらの肉は腰のあたりがひどくおいしく、なかんずく白ながすくじらといわしくじらが絶品である。",
              "citation": {
                "source": "さしみ",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、まだ南極へ行ったことがないから南極の白ながすくじらの美味を現地で味わったことはないけれど、先年宮城県金華山沖百七十海里でとれたいわしくじらの腰肉のさしみには、そのおいしさに一驚を喫した。",
              "citation": {
                "source": "さしみ",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "成る程あそこは、ナガス鯨の本場だからな」「ヘエー？",
              "citation": {
                "source": "動かぬ鯨群",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "白ナガス鯨、イワシ鯨、小さなミンク鯨というあたりが美味の由。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本で細く高くあがるのが、しろながす鯨。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりみじかいのが、ながす鯨。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            }
          ]
        }
