  {
    "uuid": "2b26ccd4-20b0-5db2-a416-de463c53e724",
    "entry": "ナノデアル",
    "reading": {
      "primary": "なのである",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キワメテアタリマエノコトナノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "書ク文字ト活字ハチガツテアタリマエナノデアルカラ気ニスル必要ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノ行為ニヨッテ害ヲ被ッタ者ガアリトスレバ、モトヨリ彼等ガ不正ナノデアルカラ、従ッテ何等気ノ毒ニ思ヒヤウハナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモハ手頸カラ指ノ先マデガ疾患部ナノデアルガ、手頸カラ上、肘ノ関節マデガ痛ミ、時ニハ肘ヲ越エテ肩ノ辺マデ波及シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハ焼鮎ノ骨ヲ綺麗ニ抜クノガ得意ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ狙ッテイタ三百萬圓ハソノ金ノ一部ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ足袋ヲ穿イタ時ニ踝ノ突起ガ目立タナイノガ自慢ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ウト、イカニモ善人臭ク聞エルガ、涙脆ク、情ニ脆イ癖ニ、本心ハヒネクレテ薄情極マル人間ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウ男ナノデアルガ、イタイケナ子供ガ突然現レテ、コンナ優シイ言葉ヲカケラレルト、モウ溜ラナイ、拭イテモ拭イテモ眼鏡ガ濡レテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妻ハソレヲ口ニ出シタ※ハナイガ、ジェームス・スチュアートノ映画ダト缺カサズ見ニ行クラシイノデアル）モットモ妻ガ木村ニ接近スルノハ、僕ガ彼ヲ敏子ニ妻ワセテハドウカトイウ考エガアッテ、家庭ニ出入リサセルヨウニシ、妻ニソレトナク二人ノ様子ヲ見ルヨウニト命ジタカラナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハコレヲ読ミサエシナケレバ、意識ヲ失ッテイル最中ニ何ヲサレタカ知ラナイハズナノデアルカラ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ愛シカタガ全然違ウダケナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハモトモト病気ニ対シテ大胆ナ方デハナク、スコブル臆病ナノデアルガ、今度ノ※ニ関シテハ、五十六歳ノ今日ニ至ッテ始メテ生キ甲斐ヲ見出シタ心地デ、或ル点デハ彼女以上ニ積極的、猪突的ニナッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ彼女ノ肉体ノイカントモシガタイ宿命ナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………従来僕ガ妻ノ貞節ヲ信ジテ疑ワナカッタ一ツノ理由ハ、彼女ガドンナ場合ニモ僕トノ情交ヲ拒マナイガ明ラカデアル時ニモ、ソノ夜夫カラ挑マレテ怯ム色ヲ見セタガアッテ夜ニ及ンデマタアッタトシテモ、―――ソウイウ日ガ数日続イタトシテモ平気ナ体質ナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
