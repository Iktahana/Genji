        "examples": {
          "standard": [
            {
              "text": "初めての大舞台で、彼は少しナーバスになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験の結果を待つ間、彼女はナーバスな様子だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「落ち着いて、ナーバスになる必要はないよ」と友人が励ました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「人の神経をナーバスにして、人の心を萎縮させて、その生活を憂鬱にさせる。",
              "citation": {
                "source": "沙漠の美姫",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わきにやけ出されの女、ナーバスになって居て、こわがり此処に居て大丈夫でしょうか、としきりにきく。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月十二日（土曜）　山内さんケイコ、今日自分少しナーバスなのを、話して居る間に感じた。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを、Ａがひどくナーヴァスになり、まるで、すね、早く眠る。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月二十三日の不が、ナーヴァスに消しをつけてやっと届いた。",
              "citation": {
                "source": "日記",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
