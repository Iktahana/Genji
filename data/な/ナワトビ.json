    "definitions": [
      {
        "index": 1,
        "gloss": "skipping rope",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "小学生の娘のために、スポーツ用品店でグリップの握りやすい縄跳びを買ってあげた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "校庭の隅で、子供たちがカラフルな縄跳びを振り回して遊んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "二重跳びの練習をしすぎたせいで、愛用の縄跳びが途中でちぎれてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "』　そう言って、彼女は縄跳びをはじめた。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで縄跳びの縄の役目をつとめるのが、つまり言葉なのだが、飜訳という仕事にとって、およそこの言葉という縄をとび越えるほど厄介なことはない。",
              "citation": {
                "source": "飜訳のむずかしさ",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとローゼマリーが現れて、垣根を躍り越えて此方の庭へ来、跣になって芝生の上で縄跳びをする。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来は水泳が好きなのですけど、プールの塩素が嫌いで、自宅の庭で縄跳びや腕立て伏せ、それにごく軽いボディ・ビルディングをしています。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆満足、Ｙ、まで愉快に仲間に入り、なわとびや円い輪を描いて一人ずつつかまえてゆく鬼ごっこやをする。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "孝ちゃんと、勇ちゃんと、年ちゃんは、石けりをしていたし、みつ子さんとよし子さんは、なわとびをしていました。",
              "citation": {
                "source": "引かれていく牛",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "子どもたちは、そこで、ボールを投げたり、なわとびをしたりして、遊びました。",
              "citation": {
                "source": "ひすいの玉",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで今度は、ドルス夫人になわとびおどりをお願いしてもらいましょうか」　カピはまた主人のかくしを探って一本のつなを出し、軽くゼルビノに合図をすると、ゼルビノはすぐにかれの真向かいに座をしめた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "カピが後足で立つのでも、ドルスがなわとびの芸当をやるのでも、みんなけいこをして覚えたのだ。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ明るい宵のうちには縄飛びをする者もあれば、写生帖を出しておばあさんの後姿をかいているのもある。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お品とおきみとは、七八人の子供達と縄飛びをしていた。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「強欲非道の男がある」　店先で子供が縄飛びして居る。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争ごっこをした、縄飛びをした。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "運動時間は一時間ごとに十分間、午の食後に三十分間であったが、別に一定の遊戯というものも無いから、男の子は縄飛び、相撲、鬼ごっこ、軍ごっこなどをする。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "畦道を縄飛びをする時のように、小刻みに跳躍しながら走った。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　急に縄飛びでもするように跳ねて、かけ出して行った。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬が風呂敷包みをくはへて駆けて来る――妹が縄飛びをしながら後をついて来る――停車場前の広い道――「焼豆腐、生あげ」と障子に書いてある店先が写る――。",
              "citation": {
                "source": "サンニー・サイド・ハウス",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たゞ、斯うやつたゞけなのよ――と云つて妾は、仕方がないから烏賊が泳ぐ見たいに体をくねらせたり、縄飛びをする時のやうに飛びあがつたりするんだけれど、お前は私を欺さうとしてゐるなんて云つて、何うしても信じないのよ。",
              "citation": {
                "source": "痴酔記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "部落前あたりの路傍で子供達が縄飛びをし、朝鮮服の下に下駄をつっかけた婦達が路地の中をうろうろ動き廻っていた。",
              "citation": {
                "source": "親方コブセ",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い町通りだつたが、両側の店からラジオで縄飛び体操の軽やかなメロデイーが流れてゐる。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日までの遊びの友達からは遽かに遠のいて、多勢の友達が先生達と縄飛びに鞠投げに嬉戯するさまを運動場の隅にさびしく眺めつくした。",
              "citation": {
                "source": "伸び支度",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の子は男同志で、舞台を駈廻り、女の子は女らしく、固って縄飛びをしていた。",
              "citation": {
                "source": "夢鬼",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒吉の恰度眼の前では、少女の座員たちが、簡単服を着て、縄飛びをしていた――。",
              "citation": {
                "source": "夢鬼",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、体操は忘れたが、縄飛びなら覚えてゐると云ふ答へがあつた。",
              "citation": {
                "source": "京都日記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでも噂で聞くと、五等官や四等官の連中、いや三等官あたりの役人までが、進んで縄飛びをやってるそうですよ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは兵馬の働きとして敢て苦しいことではなく、彼等を打つことは、大地を打つのと同じことに、それをかわすのは、縄飛びの遊びをするのと大して変ったことはありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "慢心和尚の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "前芸の棒飛び、縄飛び、輪投げ、輪廻しといったのは、鍛練した技術で、眩惑の手品ではない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "縄飛びをするもの、ブランコに乗るもの、スベリ台を滑るもの、それから、独楽を廻すもの、小さな自動車を運転するもの、其の自動車が平造の眼にとまる。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、婦人しかも老婦人が、男子とともに甲板にて縄飛びをして遊んだり、男子のする運動は、女子もたいていこれに加わりて競争しておる。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "当人も体操が一番好きだと言うとおり、器械体操の懸垂でも縄飛びででもＵ子は男女を問わず同級生中での第一人者だと言われている。",
              "citation": {
                "source": "愉快な教室",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
