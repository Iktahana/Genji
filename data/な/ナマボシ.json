          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この魚は生干しで、まだ少し水分が残っている状態です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "生干しのイカは、噛むほどに味が染み出てくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "魚を生干しにするのは、保存性を高めるための伝統的な方法だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "党からの一寸した挨拶を口実に、波多野未亡人を訪問すると、乾燥芋の生干しが茶菓子の代りに出た。",
              "citation": {
                "source": "塩花",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵隊たちはたがいに背中をむけあい、生干しの魚の乾物を食うように、歯でひき裂きながら、黙々と食った。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通、諸国へだすものは、今も久米一の邸の側の日向りに、まだ火も釉薬もかけぬ素泥の皿、向付、香炉、観音像などが生干しになって乾し並べてあるそれだ。",
              "citation": {
                "source": "増長天王",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラックアンドホワイトも一本下さり、生干しの一籠もみやげにと。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、おみやげの生干しかれひも食ひ、とりなべ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "弱い弱い視力を凝らして、堅い字を、罫紙にならべて行くうちに眉間が劇しく痛んで、疲れのために、字のかくは離れ離れになり、字と字の間から、種々なまぼしい光線が出て、こちゃこちゃに入り混って、到底見分けて居られなくなった。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに塩をふって、陽よけの屋根に干しておくと、帰るまでに、ひとしおのうまいアジのなまぼしができる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくる日、なまぼしにできあがったハゼを、さらに金網でこんがりと焼き、油を煮たててこの中へいれ、ほどよきとこで取りあげて、三杯酢に玉ねぎを輪切りしたのと、七色唐辛子を入れてつける。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、なまぼしのハゼを火にかけ、こんがり焼いて、熱いうちにソバ汁へつけ込むと、三日ぐらいで食べごろになる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが、本部島に植える草ブドウの根をほって、ていねいに、草であんだむしろでつつんでいる間に、ただ一羽舞っていた、見はり番のアホウドリが、なまぼしの魚を見つけて、何かあいずをすると、海にうかんでいた一群のアホウドリは、いっせいに舞いあがってきて、なまぼしの魚を、おおかたさらって行った。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おきゅうをすえてやれ」　と、腹を立てた漁夫が、なまぼしの残ったのにつり針をつけて、なぎさに投げておいて、一羽のアホウドリをつって、いけどりにした。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　とうら寂しげな夕間暮、生干の紅絹も黒ずんで、四辺はものの磯の風。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら底にまだ雨気がありそうで、悪く蒸す……生干の足袋に火熨斗を当てて穿くようで、不気味に暑い中に冷りとする。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……早い処が、はい、この八ツ目｜鰻の生干を見たような、ぬらりと黒い、乾からびた老耄も、若い時が一度ござりまして、その頃に、はい、大い罪障を造ったでござります。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "買物いろ／＼――夕顔の苗、蕨、生干の小鰯、小さい食卓、等々――それだけで壱円あまり。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "臠の生干の色のなまぐさに、ふとしも聞きぬ、鹹ゆき潮ざゐの音を。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のびしよ濡れの小倉服は土間の焚火のまはりにかけ、息子の褞袍を着せられて、生干の椎茸と川魚を大鍋で煮たのを肴に、空腹に熱燗をしたゝかに御馳走になつた。",
              "citation": {
                "source": "湖畔手記",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれひの生干がうまく切ってあり、子持ちでうまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "生揚げ昆布煮、さいらの生干、生卵二で、又三杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その柔い生乾きの煎餅に似たものを、食後の客の前に出してアルコールランプの皿鍋が程よく焼けると、その中でシャンパンとリキールグラシ、マルニエ、コルドン、ルージュを注ぎ込んだオレンジのバタで、料理人が揚げる。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗濯物は少しは生乾でもよい。",
              "citation": {
                "source": "旅行に就いて",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝生乾でも復た汗になるからである。",
              "citation": {
                "source": "旅行に就いて",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日のように、水に浸した乾飯や、生乾きの魚肉のあぶったものなどを口にする苦しみが、骨身にこたえてきた。",
              "citation": {
                "source": "俊寛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮠の生乾が好きなんだが、コイツはちょっと無かろうて……。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩させ裾させの虫の声は、壁も生乾きの家を争わねばならない幾百万の店子の耳にいかなる秋を告げるだろうか。",
              "citation": {
                "source": "私の感想",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "生乾きの脛に袷の裾をさばいて、うねうねとした黒土の小道を、上の森陰の部落をさしていっさんに上って行った。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口のドアをおして入ると、その大きい建物全体の生乾きのコンクリートがスティームに暖められ、徐々に乾燥してゆく、洗濯物が乾くときのような鼻の奥を刺すにおいがこめていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "神原喜作は、殊に自分が最初に口火を切つた責任者だといふ自覚があるらしく、あのづぶ濡れになつた下半身がいつのまにか生乾きになり、寒さのために硬はゞつた裾をばくばくさせ、方々を歩きまはつて説いた。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "推察通り、犯人は料理場の生乾きの壁に凭れていた、背の高い「第四の男」である。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "シガアレット・ホルダーの特徴にも、生乾きの壁に人が凭れた痕がついていたことにも、只の一と言も触れていない。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
