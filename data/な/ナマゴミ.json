        "examples": {
          "standard": [
            {
              "text": "夏場は生ゴミの袋から漏れ出す腐敗臭が、キッチンの深刻な悩みとなっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "収集日の朝、カラスに生ゴミを荒らされないようネットをしっかりと被せておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "自治体のルールに従って、生ゴミはしっかりと水気を切ってから指定の袋に入れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "致命的な災難をもたらす大量の物質や、生ゴミの山を集めて、電流で無害化できるのに。",
              "citation": {
                "source": "死の土壌",
                "author": "THE DUST OF DEATH",
                "note": "青空文庫"
              }
            }
          ]
        }
