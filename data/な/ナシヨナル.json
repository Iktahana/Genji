        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いつたい何時も誤魔化読をする時には、小説を先づ斯う開いて、其上へ、詰り英語の塾だから、ナシヨナル読本、スイントンの万国史などを載せる。",
              "citation": {
                "source": "いろ扱ひ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、毎晩母と机を並べて、母から初歩のナシヨナル・リーダーや、スヰントン・リーダーとか、論語などの講釈をきいたのであるが、その頃には自分の前で母は日記を丁寧につけてゐるのであつた。",
              "citation": {
                "source": "冬の風鈴",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼時余は、母に、論語を学び、二宮尊徳の修身を聴講し、ナシヨナル・りいどる巻の一に依つて英語を手ほどかれ、和訳すゐんとん万国史を講義された。",
              "citation": {
                "source": "余話（秘められた箱）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナシヨナル・りいどるでは、母がそれを購ふ時「なしよなる・りいどるの巻の一……」と云つたので、何やら余は、ハツとしたことを憶へてゐる。",
              "citation": {
                "source": "余話（秘められた箱）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――朝になると、その書物は何時の間にか姿を消して、書箱の観音開きには堅く錠が下され、母の机上には、不景気なナシヨナル・りいどると、灰色のすゐんとん万国史等が悄然と積み重ねてあるばかりで、徒らに余の退屈をそゝつたからである。",
              "citation": {
                "source": "余話（秘められた箱）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ部屋の丸い窓の下で、虫の穴が処々にあいてゐる机に向つて彼は母からナシヨナル読本を習つてゐた。",
              "citation": {
                "source": "地球儀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雪は、ナシヨナル・リーダーの三の巻をひろげて、師の前にきちんと坐つた。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "背広を着た若い男が小さな紙片を覗き込みながら、インターナシヨナルを歌つてゐる。",
              "citation": {
                "source": "氷花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し感服した事には教授の用語に一切英語を用ひ、小学の一年生がナシヨナル読本第二の程度の物を習つて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供が池に帆のある船を浮かべたり、独楽や輪を廻して遊んだりするのはナシヨナル読本の中の景色だ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はナシヨナル博物館で伊太利や西班牙の昔の諸大家の絵を観、テエト博物館で英国近代の名家の絵を観た事に幸ひを感じた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里で観られなかつたミケランゼロもナシヨナル博物館で観る事が出来た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナシヨナル、テエト、サウスケンシントンの三大博物館を観たことは就中感謝せざるを得ない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "足を痛めて居る晶子の為に馬車を探し乍らナシヨナル通を歩いて行く中に目的のロオヤル博物館へ来て仕舞つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時銀座出雲町のナシヨナルといふカツフヱーの女給となりゐたる事もあり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之五大正十年歳次辛酉",
                "note": "青空文庫"
              }
            },
            {
              "text": "和譯P.96　２．先づ以て吾人はインターナシヨナルの積極的諸提案を認識する必要がある、それを（提議を）公平に判斷し得るためには。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
