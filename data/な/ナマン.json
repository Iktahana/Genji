          "literary": [
            {
              "text": "猴王像に注いだ油をナマンと呼び、眼に塗れば視力強く、邪鬼に犯されず、猴王を拝むに土曜最も宜しく、鉛丹と油はその一番好物たり。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナマンダ式やアーメン式、又は無念残念式とはネタが違う。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スナマンヂウヲ　ツクラウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツイ　アツイデキタテノ　スナマンヂウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナマンヂウガ　デキタラ　パカ、パカピヨン、ピヨン、パカ、パカオウマニ　ツンデマチヘ　ウリニ　ユキマセウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チイサナ　ナミガ　ボクノ　スナマンヂウヲ　タベチヤツタ　ワツハツハ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイサナ　ナミガ　ボクノ　スナマンヂウヲ　タベチヤツタ、ワツハツハ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジヤブリ、サラ、サラ、スナマンヂウハ　ダイスキダ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
