        "examples": {
          "standard": [
            {
              "text": "あんなに強気だった彼が、ついに相手に泣きを入れたらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "締め切りに間に合わないと悟り、上司に泣きを入れるしかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供がどうしても宿題をやりたくないと泣きを入れるので、少しだけ手伝ってあげた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これには善昌もまったく困って、信者にはいい加減の出たらめを云って、誤魔化しておいて、お国の方へいろいろに泣きを入れると、お国もようよう納得して、きっと覚光と手を切るならば戻してやると云って、十五日の夜ふけにかの木像を返しに来たんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "蝶合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達だって、そんなところへ七重の膝を八重に折って泣きを入れる因縁なんか些っともないんですからね」「御道理です」「商売人として立って行くお父さんの心持を察してやって下さい」「お母さん、私はもう諦めます」「いゝえ、諦めるには及びませんよ。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
