        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「イツテ　ミヨウ」「ウン」　二ツノ　ホシハ　タカイ　タカイ　ソラカラ　コガラシノ　フク　マチノ　ナカヘ　オリテ　イツタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たち大はりきり、イナカヘイッチャウンダ、モウコナイヨと。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボク　オキアガツテ　キヤラメルヲ　カゾヘテ　ハコノナカヘシマツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
