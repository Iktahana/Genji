    "definitions": [
      {
        "index": 1,
        "gloss": "professional female mourner",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古代の葬儀では、悲しみを表すために泣き女が雇われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の嗚咽は、まるで本当に故人を悼んでいるかのように聞こえた。それは泣き女の熟練の技だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地域によっては、泣き女が葬儀において重要な役割を果たすことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "喪主らしい男は、一人だけ粗麻の喪帽をかむり、泣き女はわんわんほえながらあとにつゞいていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "行儀正しくあとにつゞいている粗麻の喪主と、泣き女はくたびれると、欠伸をして変に笑った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "源は棺桶を買ってきて泣き泣き女の死骸を中に納めて送り出そうとしたが、棺は空の時の重さと少しも変らなかった。",
              "citation": {
                "source": "緑衣人伝",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――切実な悲鳴、どこの兵隊でも死に際には切実な声をあげる――と諸君は言ふだらう、だが支那の兵隊は、特に各国の兵士よりも高い悲鳴をあげるのだ、棺はしづかに運ばれて泣き女は棺に泣きながらついてゆく、空涙をかほどまでにも真実らしく流す技術をもつた国民は世界の何処を探してもないだらう。",
              "citation": {
                "source": "小熊秀雄全集-6",
                "author": "詩集（５）飛ぶ橇",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中、笛と跫音と泣き女のいとも哀しい支那の葬式にあう。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十がらみの泣き女はもはや再び泣くことに没頭してゐた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣き女の一団へ酔つ払つた洋服男がわりこんでゐた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "大衆党幹部のポケットへ札束が入り女工たちの要求は勝手にゆがめられた失業地獄のどん底で垢ほどの手当が何になる泣き　泣き女工たちの帰って行くのは何処なのか豊年飢饉になやみ　疲れくたばりかけの農村へ！",
              "citation": {
                "source": "農村から",
                "author": "――失業反対――",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて家に着いて見ると、家の女たちや傭ってきた泣き女が、泣きつ叫びつ騒いでいた。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "（泣き女というのは、死者のあった家に傭われて慟哭する職業婦人であって、悲しみをそそり、かつ近隣への死亡通知になったものです）。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "中でも一つの車上には、髪をふりみだした“泣き女”と称する女性が、それこそ誇張でなく、白昼の下に、声をかぎり号泣をしつづけて行くのである。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "行列の中では、銅鑼が鳴り、鉦が叩かれ、泣き女の異様な啼泣と相和して、それは何とも不思議な音階を町に流しつつ練り歩くものだった。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "居留地の南京街でも、豪商とか何とかいわれる著名人の葬式でもあると、泣き女も一人や二人ではなく、彩旗はへんぽんと相沢の町に続き、五色紙の散蓮華やら餅菓が路傍の見物人へ撒かれたりして、ぼくら子供は、その演出と天来の奇観にはしゃぎ立ッて、ぞろぞろ葬列の後について駈け歩いたものだった。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日間たえまなく、議政壇上は泣き女めいた長広舌で満たされた。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、清国式の大げさな葬式にはぶたの丸煮と共に、ぜひともなくてはならない「泣き女」の職業に。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "職業婦人の「泣き女」は、その葬式の先頭に立って、人力車の上でオイオイと声をあげて泣くのが商売だった。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その「泣き女」の細君と懇意なのか、お光さんは、家の中で立ち話をしていたが、トム公の声を聞くと、すぐに出て来た。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思金神は、「それでは名鳴女というきじがよろしゅうございましょう」と申しあげました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "名鳴女は、はるばると大空からおりて、天若日子のうちの門のそばの、かえでの木の上にとまって、大神からおおせつかったとおりをすっかり言いました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、その当たった矢が名鳴女の胸を突き通して、さかさまに大空の上まではねあがって、天安河の河原においでになる、天照大神と高皇産霊神とのおそばへ落ちました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "雉名鳴女、天神の命を奉じ視に往しを天若日子射殺し、其矢天の安河の河原に達す。",
              "citation": {
                "source": "詛言に就て",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "雉名鳴女が天若日子の動静を探らんが為めに、遣わされしときも、若日子が門なる湯津楓の上に居たりと云い月読尊の保食神の許に到りしときも、其門前なる湯津楓に倚りて立ちしと云う。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに諸の神たちまた思金の神答へて白さく、「雉子名鳴女一一を遣はさむ」とまをす時に、詔りたまはく、「汝行きて天若日子に問はむ状は、汝を葦原の中つ國に遣はせる所以は、その國の荒ぶる神たちを言趣け平せとなり。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれここに鳴女、天より降り到りて、天若日子が門なる湯津桂一二の上に居て、委曲に天つ神の詔命のごと言ひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで大勢の神たちまたオモヒガネの神が申しますには、「キジの名鳴女を遣りましよう」と申しました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでキジの鳴女が天から降つて來て、天若日子の門にある貴い桂の木の上にいて詳しく天の神の仰せの通りに言いました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
