[
  {
    "uuid": "eae4a86d-6936-5b43-8edc-171a168431c7",
    "entry": "夏",
    "reading": {
      "primary": "なつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
