[
  {
    "uuid": "831c3d0d-f9bd-5f84-8f18-4a4754729169",
    "entry": "七曲がり",
    "reading": {
      "primary": "ななまがり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
