    "definitions": [
      {
        "index": 1,
        "gloss": "long, drawn-out",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の長長しい話に、皆がうんざりしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長長しい別れの挨拶に、少し寂しさを感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の長長しい手紙には、これまでの感謝の気持ちが綴られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "定刻になって、司会者のながながしい紹介が終ると、とどろくような拍手が起こり、佐伯氏が茜さんに手をひかれて、演壇あがってきた。",
              "citation": {
                "source": "キャラコさん",
                "author": "蘆と木笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会の最良の形態・我々を結束するのに最も便利な規則・に関する、あの物々しくまたながながしい論争は、ただ我々の精神を鍛練するにふさわしいだけである。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
