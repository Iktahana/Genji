        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サテ、コノ　タケノコハ　オホキク　カタク　ナツタ　トキ、リツパナ　ヨコブヱト　ナリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ツノ　ホシハ、ソノ　ヨルモ、オシダマツテ　アツチコツチト　ナクナツタ　ホシヲ　メデ　サガシテ　ヰマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチノ　上ニ　ヒカツテ　ヰタ　モノハ、ナクナツタ　ホシデハ　ナクツテ、ガラスビンノ　カケラダツタノデス。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヌスビトハ　パント　コヒツジト　トリカヘツコ　シマシタガ、ヒヤクシヨウノ　テニ　ブラサゲラレタ　コヒツジガ　カワイソウニ　ナツタノデ、トリカヘツコヲ　ヤメテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンダン　ミミガ　トホク　ナツタノデ、ミヤコニ　ヰル　ムスコノ　トコロヘ、「ミミガ　トホク　ナツタカラ、ヨク　キコエル　キカイヲ　カツテ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　オヂイサンハ、「アノ　ラツパデハ　キコエナク　ナツタカラ、モツト　ヨク　キコエルノヲ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア、チヒサイネ」「コドモデスカラネ」「コレデハ、オトナニ　ナツテモ　アマリ　オホキク　ナリマスマイ」「イヤイヤ　オトナニ　ナツタラ、コヤクラヰノ　オホキサニ　ナル」「ダマサウタツテ　ダメダヨ」「ホントウデスヨ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレハ、イタチサンガ、オナラヲ　シタイノヲ　アマリ　ガマンシテ　ヰタノデ　コンナ　コトニ　ナツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イロイロオセワニナツタコトヲシンシヤス」と書いた。",
              "citation": {
                "source": "海をわたる",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして休日毎に遥々と故郷の父母を見舞ふと、二人は仲違ひの状態で、阿母は米塩の資だけには事欠ぬと云つてゐたが阿父は西瓜畑の一隅の、漂流者の住みさうな小屋にもぐつて、「俺ニハ一文ノ金モナクナツタヨ。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今月ノ君ノ写真ハコノ前ノ君ニクラベルト見チガエルホド大キクナツタ、余モコノトホリ元気ダ、余ハ今年ノ夏ヲミシガントイフ湖ノソバデオクル。",
              "citation": {
                "source": "断唱",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕ノ親愛ナル新吉ヨ、僕ハイヨイヨ希ヒガカナツテ勇マシイ水雷艇ノ乗組員ニナツタ、ダガ僕ハ御国ノ士官ニナリ損ツタコトガザンネンダ。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "風向キガ東南ニ變リ風ガ強クナツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ内ニ音ガ小サクナリ、風モ治マリ、柱状ノモノモ以前ノノヤウニ明瞭ニハ見エナクナツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "マア、ナンテカワイイアヒルチヤンニナツタコト。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イマ、オトナリノハタケムラカラ、ヂヤガイモサンガ、アソビニキテヰタノデスガ、キウニヰナクナツタノデス。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツキヨリ、マダヤカマシクナツタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "六ヒゲナシ山羊サン　ヲ見テミンナ　オコルヤラ、泣クヤラ大ヘン　ナ　サワギニナツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八トテモ　ソノカクカウ　ガワルイノデミンナ　大ワラヒシテネオヒゲ　ガ　生エルマデホツトク　コト　ニナツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　アル日、人参サンノ所ヘ、人参サント　ジヤガイモサンノオ友達ノ玉ネギサンガ　タヅネテキテ、「ボクモ、コンナニ大キクナツタノデ、トウトウ、アシタノアサ、六ジニ　キシヤデ　マチノイチバヘ行クコトニ　キマツタヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、ナゼ人参サンノ顔ハ赤イカ、ジヤガイモサンハコブダラケカ、オ分リニナツタデセウ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ユウガタ　ヒガ　シヅミサウニ　ナツタトキ　ジヨンハ　チビスケニ　ノハラヘ　サンポニ　ユカウト　イヒマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニ、オ母サンハネムクナツタノデ、パラソルノ下デ、グツスリネムリコミマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トアタリガキウニサワガシクナツタノデ、オ母サンハ目ヲサマシマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヨウトフウフニナルコトニナツタ」オヨウトノレイノヤクソクハトリケサレタシ」カラシシノ十ロウ」　般若の五郎がこれを読んで、「おれよりも、倅の奴の方が上手だ」　と、笑った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸く昼が終ると、土地の親分が来て、たってのたのみで、意味なき奴らの前で、一席喋らされ、くさってすぐ戻り、デリケッセンで食事し、楽屋へ入ると、秦豊吉から「ニチゲキノキヤクホンドウナツタ」と電報、人の気も知らないで、畜生何言ってる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
