    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "秋ニナルト、肌ガカワイテ、ナツカシイワネ。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁場到着後ナルトキハ、日割ヲ以テ精算ノコト。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　１＋２＝３　Ａ＝Ｂ　ナルトキ　Ａ＋Ｃ＝Ｂ＋Ｃ　２＞１　私達が數學の問題を解く時、若し上のやうな公理が存しなかつたら、問題がとけるだらうか。",
              "citation": {
                "source": "海から歸る日",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ　コノ　テフテフモ　オハネガ　ジヨウブニ　ナルト　カゼニ　ノツテ　ウマヤノ　ヤネヲ　コエタリ、ヲガハノ　ウエニ　イツテ　ミタリ　シマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフガ　ミエナク　ナルト、コドモノ　デンデン蟲ハ、「アレ、ナアニ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニシロ、イマニ、コヤミタイニ　オホキナ　ロバニ　ナルト　イフノデスカラ、チヒサナ　クルマデハ　マニアヒマセン。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "涅槃堂、マタ人ノ病ムナシ、何故ニ、コノ如クナルト。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "中世ノ所有權思想ハ其ノ所有ガ奪取ナルト否トヲ問ハズ強者ノ權利ノ上ニ立テル者ナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亞ニ民有論ノ起ルハ正當ナルト共ニ、愛蘭ノ貴族領ガ國有タルベキモ可能ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ都市ノ積極的發達ハ此財源ニヨリテ自由ナルト共ニ、其ノ發達ヨリ結果スル借地料ノ騰貴ハ亦循環的ニ市ノ財源ヲ豐カニス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ハ平等ナルト共ニ自由ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ權利ハ國家ノ保障スル所有權ノ行使ニシテ其ノ消費ガ道徳的ナルト酒色遊蕩ナルトヲ問フノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、ソウナルト実際ニ使用スル文字ト活字ノ文字ガ違ツテ不都合ダトイウカモシレヌガ、西洋ノホウデハドコヲ見マワシテモ書ク文字ト同ジ活字ヲ持ツテイル国ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "新おとぎ唄（その三）赤ンぼ――黒ンぼ――泣きンぼ――きかンぼ――ぐづンぼ――弱ンぼ赤ンぼに黒ンぼ黒ンぼはきかンぼ赤ンぼは泣きンぼ泣きンぼにきかンぼきかンぼはぐづンぼ泣きンぼは弱ンぼ泣きンぼが来たらあやしておやりきかンぼが来たらお灸出して見せな丸イ目細イ目丸イ目ト細イ目夜ニナルト丸イ目丸イ目ハ梟ノ目。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "細イ目ト丸イ目夜ニナルト細イ目細イ目ハ眠イ目。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死刑ノ宣告ヲ受タル婦女懐胎ナルトキハ其執行ヲ停メ分娩後一百日ヲ経ルニアラザレバ刑ヲ行ズ」",
              "citation": {
                "source": "遺伝",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "右方にはセントアーン山高くそびえ、左方にはボウフナルト湾のきわまるところに、参差として白雪が隠見している。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、後人、耶蘇ノ像ヲ描カントスルモノ、ソノ想像ノ自由ナルト共ニ、表現ノ苦心尋常ニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタニナルトスツカリ　シヅマルヨ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシネエチヤンガ足ヲオハナシニナルト、ソツチノミミハマタパタリトタオレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――………ネエチヤンモウサギノミミヲツマンデ、立テテオヤリニナリマシタガ、ネエチヤンガソノミミヲオハナシニナルト、マタパタリトタフレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "老年ニナルト誰デモソウカモ知レナイガ、近頃予ハ一日トシテ自分ノ死ノコトヲ考エナイ日ハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウナルト今ノ辻堂ノ家ハアマリニ狭イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウソウナルト婆サンモ颯子モイキリ立ッテ、浄吉デハ手ガツケラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズレ近イウチニ、佐々木ノ留守ノ夜ハ颯子ガ勤メルヨウニナルト、予ハヒソカニ期待シテイル次第デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ休ミニナルト直グ聞エテ来ルッテ、佐々木サンガ云ッテタケド」「今日ハドウシタノカ寝ツキガ悪イ」「アタシガ傍ニイルカラジャナイ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウナルト予ハイツモノ癖デ依怙地ニナリ、直グニハ立チ上ロウトシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ノ午後、二時ニ午睡カラ覚メテ一旦書斎ヘ這入ッタ予ハ、三時ニナルト再ビ寝室ヘ戻ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
