[
  {
    "uuid": "e113b09c-b7af-5fbe-a887-24841f759642",
    "entry": "納屋",
    "reading": {
      "primary": "なや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "barn (for storage)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "農機具や肥料を保管するために、家の裏手にある古い納屋へ向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "納屋の二階には、子供たちの格好の遊び場である隠れ家がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「雨がひどくなってきたから、あそこの納屋で雨宿りさせてもらおう」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」為吉は納屋の隅から古鍬を出して来た。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は納屋の軒の柱に独楽の緒をかけ、両手に端を持って引っぱった。",
              "citation": {
                "source": "二銭銅貨",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この頃は、盗を働いて、鼠の番もせんせに、大分納屋の麦を鼠に食われよる。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫は、跛を引いて逃げ帰ると、納屋の隅にうずくまって、殴られた足をかばうようにねぶった。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、一段ひくい納屋の向う側にある便所から帰りに、石段をあがりかけると、僕は、ふと嫂が、窓から顔を出して、苦るしげに、食ったものを吐こうとしている声をきいた。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がじいっと耳を澄ますと、納屋で蓆や空俵を置き換えている気配がした。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は、やはり反物をかえさずに持って帰って、納屋の蓆か空俵の下に隠したんだな、と彼は思った。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お里は小便をすますと、また納屋へ行って、こそ／＼していた。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、納屋の蓆の下にでもかくしてあると思っていたものを、誰れの目にもつき易い台所に置いてあるのが、どういう訳か、清吉には一寸不審だった。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は家のぐるりを一周して納屋へ這入って見た。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "納屋の蓆の下に置いて忘れているような気もした。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "納屋へ行って探して見た。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見る間に水を離れて、すれ違って、背後なる木納屋に立てかけた数百本の材木の中に消えた、トタンに認めたのは、緑青で塗ったような面、目の光る、口の尖った、手足は枯木のような異人であった。",
              "citation": {
                "source": "木精（三尺角拾遺）",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "淋い、森とした中に手拍子が揃って、コツコツコツコツと、鉄槌の音のするのは、この小屋に並んだ、一棟、同一材木｜納屋の中で、三個の石屋が、石を鑿るのである。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央の木目から渦いて出るのが、池の小波のひたひたと寄する音の中に、隣の納屋の石を切る響に交って、繁った葉と葉が擦合うようで、たとえば時雨の降るようで、又無数の山蟻が谷の中を歩行く跫音のようである。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と普請小屋、材木納屋の前で叫び足らず、与吉は狂気の如く大声で、この家の前をも呼わって歩行いたのである。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧しげなる家の頽れかゝりたる納屋のほとり、荒れたる籬の傍などに咲きたる、春の物としも無く悲し。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎道を歩いていると道わきの農家の納屋の二階のような所から、この綿弓の弦の音が聞こえてくることがあった。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸の佐々木さんの納屋で、事実、音高く釘を打ちはじめたのです。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛と豚とは、飼主の納屋に移轉したのである。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛と豚とは、飼主の納屋に移転したのである。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちには木小屋がついたり、大きな納屋が出来たりしました。",
              "citation": {
                "source": "狼森と笊森、盗森",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある霜の一面に置いた朝納屋のなかの粟が、みんな無くなっていました。",
              "citation": {
                "source": "狼森と笊森、盗森",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなはあっけにとられてがやがや家に帰って見ましたら、粟はちゃんと納屋に戻っていました。",
              "citation": {
                "source": "狼森と笊森、盗森",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「清作が　納屋にしまった葡萄酒は　順序ただしく　みんなはじけてなくなった。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして納屋から唐鍬を持ち出してぽくりぽくりと芝を起して杉苗を植ゑる穴を掘りはじめました。",
              "citation": {
                "source": "虔十公園林",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが次の日虔十は納屋で虫喰ひ大豆を拾ってゐましたら林の方でそれはそれは大さわぎが聞えました。",
              "citation": {
                "source": "虔十公園林",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "納屋の小さな窓から射し込んで来る黄いろな光をながめながら、一日一杯眼をこすつて泣いてゐました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして納屋から唐鍬を持ち出してぽくりぽくりと芝を起して杉苗を植える穴を掘りはじめました。",
              "citation": {
                "source": "虔十公園林",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが次の日虔十は納屋で虫喰い大豆を拾っていましたら林の方でそれはそれは大さわぎが聞えました。",
              "citation": {
                "source": "虔十公園林",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
