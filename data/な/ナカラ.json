        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "從テ何等カ不穩矯激ナル者ノ伏在セルカニ感ジテ草案者ニ質問照會スル等ノナカラムコトヲ望ム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "都市ハ其ノ借地料ノ莫大ナル收入ヲ以テ市ノ經濟ヲ遺憾ナカラシムルヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞働的株券ノ發言權ハ勞働爭議ヲ株主會議内ニ於テ決定シ、一切ノ社會的不安ナカラシムベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切ノ地主ナカラシメント叫ブ前世紀ノ舊革命論ヲ、私有限度内ノ小地主對小作人ノ間ニ巣ハシム可カラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな地球の上ではからずも貴方と邂逅したことは因果を説かなくても当然の事ですよ人間万事タナカラボタモチ主義思切れば数へ切れない程の主義がありますねそれも皆善魔と悪魔の戦ひです。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ノ如クナルヲ以テ、芋ヲ焦焼スルコトナク（僕はいささか焦げた方が好きです）、蒸焼シ得ルノミナラズ蒸焼ヲ二回ニ順次行ウヲ以テ塩ノ浸滲ハ良好ニ行ワレ（とてもタマランです）、更ニ蓋ニ保温室ヲ設クルコトニヨリ之ヲ焼冷シトナスコトナカラシメ、常ニ保温シ得ル等ノ効果ヲ有ス。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド之ヲ愛玩スルニ就テ、論ズ可キコト亦鮮ナカラズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ人諡号墓銘等ニ於テ諛媚誣罔、毫モ其ノ人ニ倫セザルノ標目ヲ以テスル者徃々少ナカラズ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日ノ内一月ノ間ニシテ物入リ少ナカラズ、芸妓幇間役者話家、媚ヲ献ジ気ニ入ラントシテ争ツテ邸ニ来ル。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ニ其一類ヲ写シテ望蜀ノ念ナカラシム。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「我等ハタトヘカヽル設備ヲ有スルモ、コレヲ利用スル暇ナカラン」ト。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、ミンナカラタイソウ　ホメラレテヲリマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウ　トウトムガ　オホキナカラダデ、アンマリアバレタ　　　ノデ、フネガヒックリ　カヘッテ、シマイ　　マシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ知ル者ハ恐ラクハ弟ニ若クハナカラン。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬流へんのドン百姓が、コナカラ酒にくらい酔やがって、てっ、やかましいぞっ！",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歌の結句は、原文、「僧半甘」と書いてあり、旧訓ナカラカモ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "代匠記初稿本に、「なからにならんといふ心なり」、考に「法師引かされ半分にならんと云」と解し、略解でホフシ・ナカラカムと訓み（古義同訓）、「なからは半分の意にて、なからにならんと戯れ言ふ也」と解した。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "太子ハ深厚ナル哀悼ノ意ヲ直チニ在ヴィルプール王宮並ニ政庁ニ送達、尚御遺骸移送｜其ノ他ニ際シテハ万遺漏ナカランガ為メ在米英国大使館ハ在桑港総領事ニ電命ノ旨唯今通知ニ接ス。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ四国ハ、二十年余ノ兵乱ニ因ツテ、民屋ハ兵火ニ罹リ、村里ノ業ハ破レ、田野ハ芒草ニ蔽ハレ、五年三年ノ間ハ、猶、耕農モ整ハズ、五穀ノ満ツル日モナカラン。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏シテ望ムラクハ、丞相ノ謀リ遠キヲ慮リテ、早ク良図ヲ施シテ怠リヲ欲スルコトナカランコトヲ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
