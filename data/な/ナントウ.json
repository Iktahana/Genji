    "definitions": [
      {
        "index": 1,
        "gloss": "southeast",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「南東から暖かい風が吹き込み、今日は初夏のような陽気になるとの予報だ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「コンパスを確認すると、目指すキャンプ場はここから南東の方向にあるようだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「私の部屋は南東向きなので、午前中は日差しがたっぷりと入ってとても気持ちいい」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "静岡の南東｜久能山の麓をめぐる二、三の村落や清水市の一部では相当｜潰家もあり人死もあった。",
              "citation": {
                "source": "静岡地震被害見学記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して東京の夏には地方的季節風が相当強い南東風として発達しているためにそれが海陸風と合成され、もしこれがなければべた凪になるはずの夕方の時刻に涼しい南東がかった風を吹かせるらしい。",
              "citation": {
                "source": "夕凪と夕風",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "低気圧による北西風が丁度この南東風を打消すようになる場合には海陸風だけが幅を利かせて、従って夕凪が顔を出す。",
              "citation": {
                "source": "夕凪と夕風",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月ごろの東京の風の一日じゅうの変化を調べてみると、やはり海陸風に相当する規則正しい風の周期的変化があるが、ただ東京では日々変化の位相が著しくくずれているのと、夏期の南東の季節風がかなりよく発達しているために、夕なぎに相当する時刻にはこの季節風のほうが著しく現われて来るのである。",
              "citation": {
                "source": "海陸風と夕なぎ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手の方の空間で何かキラキラ光るものがあると思ってよく見ると、日本橋の南東側の河岸に聳え立つあるビルディングの壁面を方一尺くらいの光の板があちらこちらと這い廻っている。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿耨達池やすべて葱嶺から南東の山の上の湖は多くは鏡のように青く平らだ。",
              "citation": {
                "source": "学者アラムハラドの見た着物",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあたり川は南東に向つて流れ、水は西岸の方深く、安宅町地先に至つては川の東部に洲を見はすに及ぶ。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "明暦三年より明治十四年までの間に大火九十三度ありて、中二十二三度のほかは、雲南の方へ走り、若くは南東南東西の方へ走りたる時なり。",
              "citation": {
                "source": "雲のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八九九年の探険でスウェン・ヘディンがタリム川の流路を追跡して行った時、川がある点から急角度で南東に曲がって、そうして砂漠の南のほうに湖水を作っているのを見いだし、それがプルジェワルスキーの見たのと同じものだとわかった。",
              "citation": {
                "source": "ロプ・ノールその他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち、東軍は只京都の北部一角に陣するに反し、西軍は南東の二方面を扼して居る訳だ。",
              "citation": {
                "source": "応仁の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "Chichester はサセックスのロンドンの南東にある都市。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "アジア大陸の南方および南東にあるスマトラ、ジャヴァ、ボルネオ、セレベス、以下の諸島を言う。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして沼津あたりの海岸から見ればこの山の麓からまた直ちに富士の裾野と調子を合はせて西南東の三方にゆるやかに拡がつてゐる。",
              "citation": {
                "source": "村住居の秋",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "八時四十分観測員は北極星より南東十度の方角に当って、奇怪なるロケット艦を発見せり、その後引続き観測の結果、該ロケット艦の進路は、まさしく吾がミルキ国に向って直進中なることを知りたり。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "方向は、東南東、距離不明なれども、極めて接近せるものと認む」　発信符号をしらべてあるから、無電の主は何者だと、すぐに分かるのだ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「艦隊ハ午後九時二十分北緯四十度東経百三十七度ノ洋上ニ於テ、高度約二千｜米ヲ保チ、南東ニ飛行中ノ敵超重爆撃機四機ヲ発見セリ、直チニ艦上機ヲ以テ急追攻撃セシメタルモ、天暗ク敵影ヲ逸スルオソレアリ」　これで敵機の強さがわかった。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "南東の藻洲氏の家では子供二人で唱歌を謳ふて居る。",
              "citation": {
                "source": "夏の夜の音",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "南東の家で戸じまりの音がする。",
              "citation": {
                "source": "夏の夜の音",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "南東の釣殿へ続いた廊の室を奏楽室にして、山の南のほうから舞い人が前庭へ現われて来る間は「仙遊霞」という楽が奏されていた。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（下）",
                "note": "青空文庫"
              }
            },
            {
              "text": "天狗平の小屋は地図の鏡石から東南東八〇〇メートルほどのところと思われる。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それでも白山が見えるから、今に南東風になるかも知れん。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が沖を見ていたら、帆前船が一｜艘、南東風が吹いて来ると思うたか、一生懸命に福浦へ入って行った。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の北の方は小高い山を負い、南に海を受けているので、南東の風が吹くと、いつも海が荒れるのでした。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「白山が見えると、南東風が吹く、海が荒れる、船が難破する、そして人が死ぬ。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「矢張り南東風だったね？",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あ、大南東風だった。",
              "citation": {
                "source": "少年と海",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "・何か落ちたる音もしめやかな朝風　　　追加二句・なんとうつくしい日照雨ふるトマトの肌で・夾竹桃さいて彼女はみごもつてゐる　七月十七日夢のない眠り、千金にも値する快眠だつた。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとうまいこと言ふ奴ッちや、と、倶楽部の面々讃嘆時を久ふして、誰ひとり腹を立てる者がない。",
              "citation": {
                "source": "囲碁修業",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを聞こう」「しかし、饗庭様では鎧櫃を受け取らぬときっぱりおおせられましたが――」「それは、拙者が出て応対したことゆえ、本人の拙者がこうしてここへ正式に談じに参るまでは表向き受け取らぬということにしておいたのだ」　受け取ったのは影屋敷なのに、なんとうまい嘘をついている――文次は感心した。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "オコシヤさんからもみんな出て来て井戸からバケツのリレーなんだ花婆さんもみんなを呶鳴りつけながら水をくむなんとうまく行ったものかたちまち火は消しとめたんだそのころになって、やっと誰かが電話してくれたと見えて町の消防車が駆けつけてくれたけどもう用がなくて、やれやれさ！",
              "citation": {
                "source": "詩劇　水仙と木魚",
                "author": "――一少女の歌える――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
