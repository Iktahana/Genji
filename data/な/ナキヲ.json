        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "父母共ニナキ兒童ヲ孤兒院ニ收容セザル所以ハ、孤兒院ノ弊害甚ダシキト、兒童ノ保護者トシテ血族長者ノ保護ニ優ル者ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ヲ男子ト同一ニ教育スル所以ハ、國民教育ガ常識教育ニシテ或ル分科的專攻ヲ許スベキ年齡ニ非ルト共ニ、滿十六歳マデノ女子ハ男子ト差別スベキ必要モ理由モナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "數百年間ノ半亡國史ハ實ニ朝鮮人ノ道念ヲモ生活ヲモ腐敗シ盡シタルヲ以テ、眞ノ國家的覺醒アル鮮人ハ之ヲ現在新精神ニヨリテ教育セラレツツアル人々ノ生長ニ待ツノ外ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "比等ノ領土内ニ在郷軍人團ナキヲ以テ、國家任命ノ改造執行機關ヲシテ土地資本財産ノ調査徴集ニ當ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ニ白人ノ新移住者印度人支那人ノ移住者ガ取得スル所ヲ、已ニ早ク日本國民タリシ彼等ニ拒絶スベキ理由ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米支兩國ノ排日ニ省悟一番シテ日露戰爭ノ天道宣布ニ歸ル時、日本ハ排日ノ實ニ天寵限リナキヲ見ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國政ヲ執ツテ國ヲ亡ボサントスル斯クノ如キ者ニ加フベキ大逆罪ノ法文ナキヲ如何セン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去ニ歐米ノ思想ガ日本ノ表面ヲ洗ヒシトモ今後日本文明ノ大波濤ガ歐米ヲ振撼スルノ日ナキヲ斷ズルハ何タル非科學的態度ゾ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由トハ、一身ノ好ムマヽニ事ヲ為シテ、窮窟ナル思ナキヲ云フ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊ニ有隣舎所在ノ地ノ風土人物ニ関スルヤ予ハイマダカツテソノ地ニ抵リシ事ナキヲ以テ鄙著ノ遺脱｜謬誤最甚シキモノアルガ如シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "賢慮セヨ君、再ビ赤壁ノ愚ヲ繰返スコトナキヲ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
