        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "或る日ピアツツア、ナヲネ（大なる廣こうぢにて、夏の頃水を湛ふることあり）を漫歩して、積み疊ねたる柑子、地に委ねたる鐵の器、破衣、その外いろ／＼の骨董を列ねたる露肆の側に、古書古畫を賣るものあるを見き。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムライハ　コシカラ　カタナヲ　サヤグルミ　ヌイテ　下ニ　オキ、キモノノ　スソヲ　ハシヨリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ　カケツケタ　カゴカキガ、「ダンナ、カタナヲ　オワスレニ　ナリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　カゴノ　中ヘ　ステヽ　キタ　カタナヲ　ワタシマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　モウ　一ツキアマリ　カタナヲ　ヌカナイノデ、ウデガ　ムヅムヅスル。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　バシヤニ　フトイ　ツナヲ　ツケ、コドモタチハ　ソレヲ　エンヤ　エンヤト　ヒイテ　ユキマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オサムラヒニ　バケル　トキハ　マゲヲ　ツケテ、ヒゲヲ　ハヤシテ、カタナヲ　オコシニ　サシテネ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "父から「イサムトナヲツケヨ」と電報が来た。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ガココニ書イテオキタイコトハ、日本ノ活字カラヒラガナヲナクシタホウガヨイトイウ私見デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在ノ活字ハ、ソノ美シクナイヒラガナヲソノママ活字ニ移シタモノデ、活字ニ必要ナ様式化サエ行ワレテイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨロシク一千年ノ間シンボウ強ク今日ノ日ヲ待ツテイタカタカナヲ登用スベキ時期デアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシモコレヲ不調和ト感ジル人ガアツタラオソラクソノ人ガカタカナヲ見ナレナイセイカ、ソウデナカツタラ数学ノ本デ十分ニ痛メツケラレタ記憶ヲ持ツ人ニチガイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ理由ハマダ自分デモハツキリワカラナイガ、オソラクヒラガナヲ構成スル線ガアマリニ不規則ナタメ、一定ノ法則ニ従ツテ様式化スルコトガ困難ナセイダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、カタカナハヒラガナヲ書ク場合ニ比シテ、オソラク半分ノ労力デスム。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "七、活字ノヒラガナヲ廃止シテモ文化的ニ何ラノ損失モナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナノ好キナ人、ヒラガナヲ捨テ切レヌ人ハ好キナダケヒラガナヲ書ケバヨイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国ノ人タチナドモカナヲ一種類オボエレバイイコトニナレバ非常ニ助カルダロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "プクントフクレテ、オハナヲナラシ、今ニモナキサウナノデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オネコサンハ似合ヒモシナイ洋服ヲキテ得意デスシ、アヒルサンハアカダラケノクサイ洋服ヲキテ大ヨロコビナノデ、誰デモ二人ヲミルト、ワラツタリ、ハナヲツマンダリシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スフの切れで作つた鼻緒がぶつつり切れて困る事やら、川へ入つたり出たりして遊んで居たら、新しいハナヲが夕方は芯ばかりになつて居たといふやうなお話をよく聞きますので私は少しハナヲを作る事を研究して見ようと思ひたちまして、いろ／＼の機械に就て研究して見ました。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「延喜式」には賀茂斎院の忌詞とし、死をナホル　　病をナヲス　　泣くを塩垂る　　血を汗　　宍を※　　打つを撫づ　　墓を壌と言わしめることを規定してある。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトヨリ僕ハ彼女ニ都合ノヨイ、彼女ノ耳ニ痛イヨウナヲ書ク気ニナッタノハ、彼女ノアマリナ秘密主義、―――夫婦ノ間デ閨房ノトシテ聞キタガラズ、タマタマ僕ガ猥談メイタ話ヲシカケルトタチマチ耳ヲ蔽ウテシマウ彼女ノイワユル「身嗜ミ」、ア　偽善的ナ「女ノラシサ」、アノワザトラシイオ上品趣味ガ原因ナノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ彼女ハ（コンナヲ彼女ハ最モ忌ムノデアル）腺病質デシカモ心臓ガ弱イニモカカワラズ、アノ方ハ病的ニ強イ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ夫トシテ、彼女ニ十分ノ義務ヲ果タシ得ナイノハ申シワケガナイケレドモ、ソウカトイッテ、彼女ガソノ不足ヲ補ウタメニ、モシ仮リニ、―――コンナヲ考エテモ、アノ病的ナ慾求ニ幾分ノ制御ヲ加エタ方ガヨイノデハアルマイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ他アラユル様々ナヲシテミタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデイロイロ不自然ナ、無理ナ方法デ強イテ感情ニ刺戟ヲ与エ、辛ウジテアノ病的ニ絶倫ナ妻ニ対抗シテイル次第ダガ、コンナヲ覚エ、ブランデートイウ妙薬ヲ見ツケ出シタオ蔭デ、目下ノトコロ、僕ハ自分ニモ不思議ナクライ旺盛ナ慾望ニ駈ラレテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
