          "literary": [
            {
              "text": "ふんと笑って、満洲なら、クラスの相馬君も、それから辰ちゃんだって行くと言ってた、満洲なんて、あんなヘナチョコどもが行くのにちょうどよい所だ、神秘性が無いじゃないか、僕はなんでもチベットへ行くのだ、日本で最初の開拓者になるのだ、羊を一万頭も飼って、それから、などと幼い空想をとりとめもなく言い続ける。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の手に似せるために、わざとヘナチョコに曲げて書いたのよ。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなへナチョコ野郎をつれこんじゃいけないッて云ったじゃないか。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなヘナチョコピー、珍らしいよ、なア。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二投手でもあのヘナチョコの倍も速いや」「なるほど、速い。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらがヘナチョコでは、おくれをとって寿司はまずいかも知れない。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
