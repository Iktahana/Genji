          "literary": [
            {
              "text": "べこはナルコムプロス〔教育人民委員部〕へ行って、家へかえってから АОМС〔モスクワ・ソビエトの行政部〕へ出かけ огонёк〔雑誌『灯』社〕へ出かけ、チェホフのあまりをとってパッサージへ室をききに出かけ、かえりに大使館へよって箱をきいた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙはナルコムプロスから運送やをさがしてうろつき、かえった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからナルコムプロスへ行って又ステーションへ行った。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
