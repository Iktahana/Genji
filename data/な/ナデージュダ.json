        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だが、どこでこれが聖者ナデージュダだとわかるのだろう。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがすむと、重ねてある書類の一つをとり出して、「ナデージュダ・コンスタンチーノヴァ・ミチコヴァ」　呼びあげながら、一わたり室内の群集をゆっくり端から端へと見渡した。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水上救護協会書記の妻ワルワーラが同じ借室の、裁縫女ナデージュダに絹ブラウズを縫わせた。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "滑稽にハメをはずしながら、婆さんはワルワーラがナデージュダに唾をしっかけたことまで証言した。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう伝えて下さい」　そしてナデージュダと婆さんに、「おかけなさい」　場内に満足のざわめきが起った。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "席から立ち上って、ナデージュダが云った。",
              "citation": {
                "source": "ワーニカとターニャ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
