          "literary": [
            {
              "text": "サレド之ヲ愛玩スルニ就テ、論ズ可キコト亦鮮ナカラズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ人諡号墓銘等ニ於テ諛媚誣罔、毫モ其ノ人ニ倫セザルノ標目ヲ以テスル者徃々少ナカラズ。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日ノ内一月ノ間ニシテ物入リ少ナカラズ、芸妓幇間役者話家、媚ヲ献ジ気ニ入ラントシテ争ツテ邸ニ来ル。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            }
          ]
        }
