          "literary": [
            {
              "text": "ナウエンの無線電信塔の鉄骨構造の下端がガラスのボール・ソケット・ジョイントになっているのを見たときにも胆を冷やしたことであった。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルリンとナウエンとの間十六マイルの距離に試みて成効したという。",
              "citation": {
                "source": "無線電信の近状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時は世界第一であったナウエンの無線電信発信所を見物したのもこの見学団の一員としてであった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベラン氏もベルガー夫人の幼児も、無事ナウエンの受信局で元のとおり整形されたそうだ」「えっ、あれが成功したのですか」「そうなんだ。",
              "citation": {
                "source": "宇宙尖兵",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
