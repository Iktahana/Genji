        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "海デ沢山遊ビ黒クナリマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニハカニ　クラク　ナリマシタカゼガ　ゴウゴウ　フイテキテアメモ　ザアザア　フリマシタ　春の夕立ちは、珍しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマキチ　ハ、ソノ　ハナシヲ　キイテ、スグニ、ウミ　ト　イウトコロ　ヘ　ユキタクテ　タマラナク　ナリマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「北海道ハ秋モ晩クナリマシタ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　タウトウ　イチバン　イタダキニ　ヰタ　ツボミガ　オメメヲ　ヒライテ　花ニ　ナリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ　カケツケタ　カゴカキガ、「ダンナ、カタナヲ　オワスレニ　ナリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　ハナノ　下ニ　クロイ　ヒゲヲ　ツケテ　ヰタノデ、コドモタチハ　「ヒゲサン」ト　ヨンデ　ヰマシタガ、ヤガテ　タキクンノ　コトモ　「ヒゲサン」ト　ヨブヤウニ　ナリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　カナシク　ナリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コノ　タケノコハ　オホキク　カタク　ナツタ　トキ、リツパナ　ヨコブヱト　ナリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、コヒツジハ　コロサレルトハ　チツトモ　シラズニ　ヌスビトノ　カホヲ　ミアゲテ　ヰルノデ、ヌスビトハ　キウニ　カワイサウニ　ナリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンガ　リツパナ　タイシヨウニ　ナツテ、ムネニ　ヅラリト　クンシヨウヲ　ナラベ、ピカピカ　ヒカル　ケンヲ　モツテ、ウマノ　上ニ　ソリカヘツテ　ヰル　ユメヲ　ミテ　ヰルト、ヤガテ　ヨガ　アケテ　アサニ　ナリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　コノ　ヒトビトガ　キノドクニ　ナリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オニゴツコノ　トキハ　コノ　バシヤハ　ヤスミバト　ナリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル　ヒ、ムラヤクバカラ　デテ　キタ　ソンチヨウサンガ　バシヤヲ　ゴランニ　ナリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ、ソノ　ラツパヲ　ヨロコンデ　ツカツテ　ヰマシタガ、ミミハ　ドンドン　トホク　ナツテ、トウトウ　ツンボニ　ナリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチモ　ゴチソウニ　ナリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストハ　ウシロヲ　ミルト、ソコニ、ホントウニ　ブカツカウナ　ジブンノ　カゲガ　アリマシタノデ　アカク　ナリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コチラノオクサマガ、サクバンオナクナリニ、ナリマシタカラ、オシラセシマス』彼は、こうした文句から激動を受けながら、差出人の名を探ったが、夫は何処にも書いてなかった。",
              "citation": {
                "source": "大島が出来る話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "水産翁、轟雷雄先生ガ免職ニナリマシタ裡面ニハ、国家ノタメニナラヌ重大秘密ガアリマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ日ノ夜、二人ノ話デ確信スルヨウニナリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテカラ二人ノ様子ガオカシイト感ジテ居リマシタカラ、其ノ時何トナク気ニナリマシタノデ暫ク経テカラ私モ便所ニ行ッテクルカラト申シテ室外ニ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデ愛シニ愛シタ女ガ、ネマキ一ツデ顔ニ傷ヲ受ケテ倒レテイル姿ヲ見テ急ニ惨忍ナ気持デ一杯ニナリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ屍体ハ油倉庫ノ中ニ投ゲ入レラレ、放火サレタカラ灰ニナリマシタ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キノフノバン、私ノウチノ地下室ニトマツタ玉ネギサンガ、行方不明ニナリマシタ。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カヘルサンハ生レツキ色ガ青カツタノデスガ、コノ時バカリハ赤クナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
