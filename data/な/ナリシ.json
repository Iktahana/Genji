        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "朝鮮其者ノ歴史ガ示ス如ク、又清國ガ此レヲ屬國トセンガ爲ニ起リタル日清戰爭、及ビ滿洲ニ來タレル露西亞ガ其ヲ侵略セントセシガタメニ破レタル日露戰爭ニ示ス如ク、其ノ亡國タルベキ内外呼應ノ原因ハ統治者ガ日本タラザル時ハ露支兩國ノ焉レカナリシハ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈翁ノ世界統一主義ニ對シテ起レル民族主義ガ近世史ノ一大潮流ナリシハ言フノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ内外ヲ毒シテ終ニ大羅馬ヲモ亡ボシタル者ノ金權政治ナリシコトヲ忘ルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "徴兵制其者ガ直ニ所謂軍國主義ニ非ザル事ハ、徴兵制ナリシガ故ニ辛ウジテ獨逸ヲ防止スルヲ得タル佛蘭西ガ、會議ノ人々ヨリ軍國主義ナリシトテ攻撃セラレザリシガ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那ヲ併呑シ朝鮮ヲ領有セントシタル「ツアール」ノ利己ガ當時ノ状態ニ於テ不義ナリシ如ク、廣漠不毛ノ西比利亞ヲ獨占シテ他ノ利己ヲ無視セントスルナラバ「レニン」政府現在ノ状態亦正義ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ米國ノ獨立ヲ決定シタル者ガ佛蘭西海軍ナリシ如ク、印度獨立ノ能否ヲ決定スル者ハ一ニ只英國海軍ヲ撃破シ得ベキ日本及日本ノ同盟スベキ國家ノ海軍力如何ニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヴェルサイユ」宮殿ノ會議ガ世界ノ暗夜ナリシコトハ其レヲ主裁シタル米國ノ星旗ガ默示ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "見返りもせずに、裲襠の背中をクルリと見せながら、シャナリシャナリと人垣の間を遠ざかって行った。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サイコアナリシスの実例にはふさわしいものである。",
              "citation": {
                "source": "四月号の創作三つ",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダアクの操り人形然と妙な内鰐の足どりでシャナリシャナリと蓮歩を運ぶものもあったが、中には今よりもハイカラな風をして、その頃｜流行った横乗りで夫婦｜轡を駢べて行くものもあった。",
              "citation": {
                "source": "四十年前",
                "author": "――新文学の曙光――",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時ハ何処ノ国籍ニ属スルヤ全ク不明ナリシガ只今マデ数日間観察セルトコロニヨレバ○国人ナルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロッパの豊富さ、一方にこのような物語の書ける作家があり、サイコアナリシスの作家あり、モーランあり等。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "此比俄ニ日本古銭ヲ玩ブ人多クナリテ、其価ノ十年前ニ四五倍スル様ニナリシハ、泰西ノ風ニ化シタルナリト云フモ、失言ニハ非ザル可シ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ価ハ至テ廉ナリシト云ヘリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ニ先月初五月ナリシ長国下の関と申所ニ参り滞留致し候節、蔵に久しくあハぬ故たずね候所、夫ハ三日路も外遠き所に居候より其まゝニおき候所、ふと蔵ハ外の用事ニて私しのやどへまいり、たがいに手おうち候て、天なる哉／＼、きみよふ／＼と笑申候。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年九月九日　池内蔵太家族あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来ノ殺害目的者ニ対シテハ、殺害ノ予告ノミヲシテ方法及ビ期日ヲセザリシ為メ普通月並ナル脅迫状位ニ思フテ覚梧（死ノ）モセズ、遺言モセズ、不意ニ我党ノ手ニ掛リ、卑怯ナル不敏ナル最後トナリシ者アリシニ付キカク明ラカニセリ。",
              "citation": {
                "source": "編輯室より（一九一三年六月号）",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "石黒氏ノ近業ハソノ名ノ示スガ如ク往昔郷閭ノ私塾ナリシ有隣舎ノ沿革ヲ調査シソレガ師弟ノ伝ヲ述ベタルモノニシテコレスナハチ拙稿『下谷叢話』ノ記述スル所トホボソノ事ヲ同ジクスルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "※の厚い三枚重ねに三つ大の紋のついた小浜縮緬の紫の羽織をゾベリときかけ、天鵞絨の鼻緒のすがった雪駄の裏金をチャラめかしながら日本じゅうの役者をひとりで背負って立ったような気障なようすで、三津五郎のうしろからシャナリシャナリとついて行く。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "小鰭の鮨",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時代ノ人民ハ前時代ノ人民ニ比シテ氣質稍優等ナリシト云フ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○日本石器時代人民ハ幾種族ナリシカ容易ニ知ル事能ハズト雖モ、北海道ト本州ノ大部分トニ分布棲息セシモノハ一種族タリシ事種々ノ點ニ於テ遺物ノ一致スルヲ以テ知ルヲ得。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ガ筒袖ヲ着、股引ヲ穿チシ事、男女ノ服裝ニ稍異ル所有リシ事、結髮ノ樣々ナリシ事、男子ノ遮光器ヲ用ヰ、女子ノ覆面ヲ用ヰシ事、等ハ土偶ヲ以テ證スベシ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兩者關係ノ眞相果シテ如何ナリシカ未ダ明言スル事能ハズト雖モ、本州、北海道、其東北ニ横ハル諸島、北亞米利加ノ北端、「グリーンランド」、地理學的ニ連接シテ彼我交通ノ途有ルヲ思ヘバ、兩者ノ間ニ何等カノ親密ナル關係ノ存スベキハ實ニ疑ヒヲ容レザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この第四句は、原文「吾者生鹿」で、旧訓ワレハナリシカ、代匠記ワレハナレルカ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この句を旧訓に従って、ナリシカと訓み、解釈を「細砂になりたいものだ」とする説もある（新考）。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来和服、下駄等は、ひとりでブラブラなり、シャナリシャナリなり、往来を歩くには適しているだろうが、多数の人が乗る電車やバスに着て乗っては、他人は迷惑であり、当人にとっては危険である。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ト二人キリノ時ニモ、嘗テ愛情コマヤカナリシ時代ニハソンナ風ダッタデアロウガ、今デハソウデモナサソウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ニテ聞ケバ、柴田方ノ戸波隼人トテ由々シキ豪ノ者ナリシ由ニテ、其時ノ一番槍トモ称ハレタレ　と清正自身が噺していることになっている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "八代聞書の記載に依ると、武蔵ノ常ニ佩キシ刀ハ、伯耆安綱ナリシ由、然ルニ熊本ニ来リテ後、沢村友好（大学）ノ世話ニナリタリトテソノ刀ヲ礼トシテ贈リタリ。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トナレハ水死者ハ主家ノ金円ヲ多ク費消シ遺書ヲ残シテ家出セルモノナリシヲ知レハ也。",
              "citation": {
                "source": "陰獣",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
