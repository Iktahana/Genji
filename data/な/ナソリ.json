          "literary": [
            {
              "text": "「打毬楽」「納蘇利」などの奏楽がある上に、右も左も勝つたびに歓呼に代えて楽声をあげた。",
              "citation": {
                "source": "源氏物語",
                "author": "蛍",
                "note": "青空文庫"
              }
            },
            {
              "text": "『舞楽要録』によると、舞楽の最盛期であった藤原時代後半の数多い舞楽演奏は、二三の例外を除いてほとんど皆林邑楽の陵王（左）納蘇利（右）をプログラムの最後に置いている。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
