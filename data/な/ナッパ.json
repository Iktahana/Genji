[
  {
    "uuid": "bcc485b3-23e5-56eb-b748-d82ed7eb6650",
    "entry": "菜っ葉",
    "reading": {
      "primary": "なっぱ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
