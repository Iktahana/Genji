[
  {
    "uuid": "f5f93f3a-1cb6-556b-a2bc-ba4be689fbdf",
    "entry": "鳴子",
    "reading": {
      "primary": "なるこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
