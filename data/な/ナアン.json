        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……ナアンダイ……。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ナアンダイ……これあ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――私はその時にようやっと最前日暮れ方に見た事を思い出しまして……ナアンダ、そんな事だったか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "危くまた引っくり返るところであったが、そのうちに、ようようの思いで気を取り直して、どうしてここに……と抱き上げながら、その少女を頭のテッペンから、爪の先までヨクヨク見上げ見下してみると、何の事だ……それは黛夫人の妹で、双生児の片われの芬子嬢であった」「ナアンダ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、そのうちに長い煙管が眼に付くと、　……ナアンダ朝鮮公か……コンナ処まで浮かれて来るなんて呑気な奴も在るもんだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南ア無ウ阿ア弥イ陀ア仏ウ」「ナアン……マアイ……ダア――アア」「ナア――モオ――ダア――アア」",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、それがわかった時はビタミンの発見と同様、遠からず平々凡々な趣味によってしまうべき運命を持っているので、現在のように大衆を酔わせる力はなくなってしまうであろう――ナアンダ。",
              "citation": {
                "source": "ナンセンス",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、ホントの地下鉄はモウ一階下に在る事も、音響の工合でわかったので……ナアンダイ……と思ったが、しかし何となく心細くなったので、そのまま宿へ帰ってしまった。",
              "citation": {
                "source": "恐ろしい東京",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ナアンだ……伊奈子さんか……ちょうどよかった……今どこからかけているの……」「公園の中の自動電話よ」「フーン。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "然も悲しかつたことには私はヨカナアンではなくて、サロメの衣を引いて、次第にそれが裸身になつてゆく態を眺めて涎を流してゐるヘロデの※々大王であつた。",
              "citation": {
                "source": "サロメと体操",
                "author": "ヘツペル先生との挿話",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ、先生たら今夜は何うなすつたの、ヨカナアン役者の声色見たいに……」　彼女は、わらつて小生の胸の中に顔を伏せました。",
              "citation": {
                "source": "女優",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕影はいま山あひの虚の窪まで及んだが、むかうの阜は入日のはての光を浴びて、あのカナアンの國よりもなほ遠い神の誓の郷のやうに照りわたる。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ヨカナアンを覚え、オフェリヤを猿真似のように私は朗読する。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階の床には円屋根と同じ直径の穴があり、古めかしき手摺りがあり、その穴からヨカナアンの首が現れそうな気がした。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "君が、あの処女作の沸きかへるやうな評判の中で、毎日、ヨカナアンのやうに憂鬱な顔をしてゐた頃だ。",
              "citation": {
                "source": "序文",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、銀盆に盛られた長い髪を垂れたヨカナアンの首を前にして、舞ひ狂ふサロメの姿を見たとき、記憶の底からひとりでに浮びあがつて来たのは、例の膿盆にのつかつた真紅の扁桃腺であつた。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "この劇の主人公である詩人シヤナアンは国に並びない詩人で、今までは王宮の会議に軍人や法律家とならんで国事を議する一人であつた。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤナアンは詩がおとしめられ詩人全体の特権を取り上げられたのを憤がいして、その日から王宮の玄関に寝て絶食して死を待つのであつた。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕があくと、王宮の玄関の階段に詩人シヤナアンが寝てゐる。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口に垂れたカアテンの前、階段の一ばん上の段に王が立つてシヤナアンの一ばん弟子に話しかけるところで始まる。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟子は、王が詩人の特権を奪つてしまふのは無理だけれど、そのため死ぬのも馬鹿げてゐる、先生、夢を覚ましてあなたの弟子たちを見て下さい、とシヤナアンを呼び起こす。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤナアンは衰弱しきつてうとうと夢を見てゐた、むかしのアルヴインの都の大きな屋根の家で、英雄フィンやオスガアと一しよにゐる夢で、焼豚のにほひがその辺一ぱいにほつてゐた。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤナアンは少し起き上がつて、ゆめみるやうに前方を見ながら言ふ、燈火祭のときだつた。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤナアンはこの若い弟子に言ふ、お前に約束されたものは、詩人の悲しみではなかつたか？",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "侍従長はシヤナアンに、王も貴族も自分もこんなに好意を寄せてゐるのに、無理に物を食はず死んで、民衆を叛かせようとするのですかと愚痴を言ふ。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人が皿をもつて来て軍人に持たせるので、軍人はシヤナアンの前に皿を出す。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊さんは、シヤナアンよ、もうお別れする、生きてるあなたの顔もこれが見納めだ、何か最後の願ひは？",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お料理とお酒あがつて下さい、一人の王女が杯を出すとシヤナアンは片手にそれを取り、片手に王女の手を持つて暫らく見てゐる。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤナアンは立ち上がり、あなたたちの手はみんな駄目だ、みんなが癩病だ。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤナアンは月を指す、癩病が怖くなつてみんなが逃げてゆく時二人の跛が詩人の前にある皿の料理をねだる。",
              "citation": {
                "source": "「王の玄関」イエーツ戯曲",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
