        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ハ何々運動トイウヨウナコトハイツサイ虫ガ好カヌ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハソンナコトハシリマセンカラ大トクイデス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢丹ノ特選売場ヘ行ッタラ何カシラ見ツカルダロウ」実ハ外ニ少シ考ガアッタンダガ、ソンナコトハ口ニシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十台クライマデハ死ノ豫感ガ何ニモ増シテ恐シカッタガ、今デハソンナコトハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ恐ラクソウデハナイカト、心中デハ思ッテイルノダガ、ソンナコトハナイダロウト、婆サンノ前デハ否定シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハ溜リカネテソノコトヲ浄吉ニ訴エルコト再三ニ及ンダラシイガ、「ソンナコトハアリマセンヨ」ト、浄吉ハ笑イニマギラシテ相手ニシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今オ気持ガオ悪イヨウナコトハゴザイマセンカ」「気持ハドウモアリマセンガネ、血壓ガ高インデスカ」「二百ホドゴザイマス」彼女ガコンナ風ニ云ウ時ハ大概二百以上ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三年前マデハオ爺チャンモマダ足腰ガイクラカ達者グッタカラ、大キナ犬ニ飛ビ着カレテモ心配ナコトハナカッタガ、今日デハ事情ガ違ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ハ心臓ヲ何度モ打診シテ見、背中ヲ調ベ、深呼吸ヲサセ、携帯用ノ心電計デ心電図ヲ取リ、「格別御心配ナコトハナイト思イマスガ、帰リマシテカラ後程結果ヲ御報告申シマス」ト云ッテ帰ッテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロ／＼専門的ナ説明ガアッタガ、詳細ナコトハ予ニハ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "境内ノ幽邃ナコトハ真ニ五子ノ言ニ背カズ、前ニモ二三度杖ヲ曳イタコトハアルガ、コレデモ大都会ノ市内カト驚クバカリ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコトハ聞カナイデモイヽ、マア鱧ヲ食イナサイ」ソンナツモリモナク若イ時分ニ何気ナク見テ置イタコトガ、ドンナ時ニ役ニ立ツカ分ラナイモノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア颯チャン、何モ面倒ナコトハナインダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
