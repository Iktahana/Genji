          "literary": [
            {
              "text": "ネズミハチユウ　チユウナクモンヂヤ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "――忝ナクモ天子ヨリ御土器ヲ頂戴ナサレ、上古末代マデノ面目コレニ過グベカラズ　と彼の祐筆はその日の感激に最大なことばをもってもなお云い足りないように書いている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "端ナクモ、過グル頃ヨリ敵味方トワカレ、矢石ノアイダニ別ルルモ、旧情ハ一日トテ、忘レタコトハナイ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
