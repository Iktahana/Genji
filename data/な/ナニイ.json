          "literary": [
            {
              "text": "「……何だア……武雄から急報……何だア……犯人は何だア……税関……税関がどうしたんだア……ナニイ……マージャン……マアジャンたあ何だあ……朝の雀と書くウ……チューチューという雀かア……何だアサ違いだア……着物の麻だア……わかったわかった。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニイ、五十銭玉ばっかりだア。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "機械の音が八釜しいから……ナニイ……何だって……。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ナニイ知らん……知らんタア何じゃい……」「何でもええがッ……畜生メラ。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……エエわからん……まっとハッキリ云え……ナニイ……あの別荘の奴等がか……ウンウン……あの赤い鳥にバカタレと云わせたんか……ウンウン……それに違いないナ」　横に立っていた小さい児も、指を啣えたまま、大きい児と一緒にうなずいた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニイ……サイエン？",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウグイスとウグイ……カマスとカマ……ナニイ大違いじゃあ……大違いじゃとも。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニイのブリッジの相手はこの希臘人に一定していた。",
              "citation": {
                "source": "踊る地平線",
                "author": "白い謝肉祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニイは、多分、二、三日前にホテルへ来たらしい、見たこともない男と組んでしまって、ロジェル・エ・ギャレには、ほかの女が当った。",
              "citation": {
                "source": "踊る地平線",
                "author": "白い謝肉祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実彼は、じぶんに当った女をＮＡＮの相手に押しつけ、そして、彼からナニイを横取ることによって、つまり、簡単には、女を交換して、見事にこの危難を征服した。",
              "citation": {
                "source": "踊る地平線",
                "author": "白い謝肉祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナ黒人ノ俳優バカリ使ッテアルノ」「ソレガソンナニイヽノカネ」「ブレノ・メロッテノハサッカーノ選手上リデ、素人ナンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
