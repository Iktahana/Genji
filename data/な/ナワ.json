          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "捕り方が懐から取り出した縄が、逃げる下手人の足に鮮やかに絡みついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "時代劇のクライマックスで、御用提灯を持った役人たちが一斉に縄を投げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はかつて、捕縄術の達人として江戸の町で名を馳せた同心だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
