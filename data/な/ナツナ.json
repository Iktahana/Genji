        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ここで僕は、しばらく少年の行方をさがすことを止めて、ずっと南の、ボルネオ群島の北のはしにあるナツナ島のことを話さなければならない。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "南洋産業会社のナツナ島椰子林の監督である。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ナツナ島の関さん』といえば、土人たちの仲間では、ボルネオ総督閣下よりも偉いのである。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけも聞かずに生命を投げ出す　ナツナ島の海岸、岬の岩の上に建てられた白い小舎。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なつかしいナツナ島よ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "関矢一郎さんや、ナツナ島の土人たち、あの人たち、どうなったか行方不明だけれど、きっと、勇敢に戦って、戦死したのにちがいないんだ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
