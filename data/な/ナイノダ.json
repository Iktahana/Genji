        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユライ芸術トハ、コンナモノサ、譬噺デモナシ、修養ノ糧デモナシ、キザナ、メメシイ、売名ノ徒ノ仕事ニチガイナイノダ、ト言ワレテ、カエス言葉ナシ、素直ニ首肯、ソット爪サキ立チ、夕焼ノ雲ヲ見ツメル。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――オマエハ、バカダカラ、シラナイノダ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ガ病人ニナッテシマッタノダカラ残念デタマラナイノダガ、君ノ手紙ヲ見テ西洋ヘ往タヨウナ気ニナッテ愉快デタマラヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシバカリデハ　ナイノダ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イッタイ予ニハ Pederasty ノ趣味ハナイノダガ、最近不思議ニ歌舞伎俳優ノ若イ女形ニ性的魅力ヲ感ズルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコレ以上生キナガラエテイタトコロデ格別ノコトモナイノダカラ、モシ今ノ世ニオ伝ノヨウナ女ガ現ワレタラ、ムシロソノ女ノ手ニカヽッテ殺サレタ方ガ幸福カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿道ノ故障ハ今朝ハ一応良クナッタノデ、行ッテ行カレナイコトハナイノダガ、夜ノ外出ナド飛ンデモアリマセント云ッテ、佐々木ガ承知シナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨク考エルト、颯子ノ手前好キヲ装ッテイルニ過ギナイノダト云ウコトニ、自分デモ気ガ付クコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長崎人ノ木村モハナイノダガ、今日ハ始メカラ晩ノ食事ヲトモニスル底意ガアッタノデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たどたどしい女文字の片仮名文章は、「オマンサン、コンナコト、アナタニ知ラセタクハ、ナイノダケレド、ヨクヨクノコトト、承知ノ上、読ンデ下サイ」　と、始まる。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハタダ自己満足ヲ得ル以上ノコトハ何モシテハイナイノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッタラ何故オマエモ諦メテヲ体カラ生ヤソウトシナイノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
