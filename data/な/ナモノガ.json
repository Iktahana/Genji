          "literary": [
            {
              "text": "イロイロナモノガ私ノ心ヲオドラセマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒点ガ見エ、強イ光デ網膜ガヤケタトキノ感ジガアリ、且ツチラチラト電線ノ雑音ミタイナモノガ盛ンニ動クノデアル。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常ナ勢デ廻轉シテヰルコトハ何カ木片板片ノヤウナモノガ飛ビ交フ樣子デ分ツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "無關係ナモノガ間違ツテ入ツタノデス。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ馬鹿々々シイ真似ガ出来ルト云ウノガ、モウ気狂イニナリカケテル證拠ヨ」声ノ調子ニ、頭カラ水ヲ浴ビセルヨウナ皮肉ナモノガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテコノ白唐紙ノ色紙ノ上ニ朱デ足ノ裏ノ拓本ヲ作ル」「ソンナモノガ何ニナルノ」「ソノ拓本ニモトヅイテ、颯チャンノ足ノ佛足石ヲ作ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ彼女ハ、「ソンナモノガ何ニナルノ」ト、云ッタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ写真機ハレンズガ暗ク、レンジ・ファインダーガ付イテイナイノデ、目測デ写サナケレバナラズ、僕ノヨウナ未熟ナモノガ撮ッタノデハピンボケニナリヤスイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
