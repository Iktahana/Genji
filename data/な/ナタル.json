        "examples": {
          "standard": [
            {
              "text": "長崎の隠れキリシタンたちは、ナタルの祝日を密かに祝うために集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今年のナタルには、どんな御馳走を作ろうか」と、家族で相談し合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い洋館の図書室で、ナタルの夜を舞台にした幻想的な小説を読みふけった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それからナタル、ザンジバールをも見舞った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "土着した祖先「故郷（ペーイ・ナタル）を懷かしむ君の心持は吾々には珍しいことだ。",
              "citation": {
                "source": "浪",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
