[
  {
    "uuid": "6a610679-2553-5f8c-abbf-5f69d2a361cf",
    "entry": "泣き落とし",
    "reading": {
      "primary": "なきおとし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
