        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "第二十世紀ノ人類ハ聰明ト情意ヲ増進シテ「然リ然リ」「否ナ否ナ」ニテ足ル者ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テニ平等ナラザル個々人ハ其經濟的能力享樂及經濟的運命ニ於テモ劃一ナラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國語問題ハ文字又ハ單語ノミノ問題ニ非ズシテ言語ノ組織根底ヨリノ革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "終局ハ國民精神ノ神的革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國又實ニ其ノ謬説ノ誕生地ナルヲ以テ、今尚「ジヨンブル、ソサイテー」ト名クル如ク英帝國其者ヲ組合視シ會社視シテ悉ク社會契約説ニ基ク立法ナラザルナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ彼等ノ殆ド凡テハ今ノ大學教育ナル高等職業紹介所ニ入ルコトヲ以テ一種ノ特權階級ノ如ク考ヘ、心裏實ニ徴兵忌避ノ私ヲ包藏シテ其ノ猶豫ヲ求ムル者ナラザルハナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍隊ノ強盛ヲ念トスル軍事當局スラ此ノ強兵ヲナス根源ヲ提唱スル者無ク、凡テノ國民ハ國民ノ義務ナル道念ニ忍ビテ一ニ只忘却ニ封ジツツアルトキ、兵卒其者ガ憤恨ニ爆發スルノ日ハ則チ勞働者ト結合シタル勞兵會ノ出現ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ今次ノ大戰中ニ於テ日本ハ獨逸ノ青島ヲ領有シテ支那ニ還附セザランコトヲ企ツルト共ニ、獨逸ノ投資ヲ繼承シ更ニ北支那ニ投資的侵略ヲ學ビタルコト悉ク獨逸ノ跡ヲ追フ者ナラザルハナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "東西ヲ通ジタル歴史的進歩ニ於テ各々其ノ戰國時代ニ亞ギテ對建國家ノ集合的統一ヲ見タル如ク、現時マデノ國際的戰國時代ニ亞ギテ來ルベキ可能ナル世界ノ平和ハ、必ス世界ノ大小國家ノ上ニ君臨スル最強ナル國家ノ出現ニヨリテ維持サルル封建的平和ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしてもソノ画ク所｜花卉艶妍媚ナラザルハナク而モ用筆簡淡ニシテ一種ノ神韻アリとあるが如き余り杜撰なるべし。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "これというのも、この節は夜具屋が縫わなくなって、うちで人に手伝ってもらって夜具の綿入れをいたしましたから、それで、おそろしながら「綿入れ」と称するものが出来上ったのよ、あれこそブランカ特製品ですものね、アタタカナラザルヲエンヤ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳橋ニ涎ヲ垂ラスハ未ダ陰ナラザルニ何ノ雨ゾ、金春ヲ空ニ歩行クハ眠ラザルニ何ノ夢ゾ、大抵酩酊シテ東西ヲ知ラズ。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "之を小西湖佳話について見るに、「東台ノ一山処トシテ桜樹ナラザルハ無シ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "茗ハ甚シク精ナラザルモマタ以テ神ヲ澄スニ足リ、菓ハ甚シク美ナラザルモマタ以テ茗ヲ下スニ足ルベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "其我々日本人ノ祖先ナラザル事ハ、遺物及ビ遺跡發見ノ人骨ノ對照ニ由リテ知ルヲ得ベク、其「アイヌ」ノ祖先ナラザル事モ、骨骼及ビ風俗ノ比較ニ由リテ知ルヲ得ベシ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間誰カ母ノ子ナラザル者アランヤ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
