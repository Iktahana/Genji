    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こんな思ひ出に冷汗をかく氣がして、義雄は今夜の演奏會を小さくなつて見渡すと、あの夜、あの女や渠と共に、三味線につれて新｜工風の國風舞踏の一なる、「木曾の御嶽さん」を稽古し、トコセ、キナヨ、ドン／＼と云ふかけ聲などを擧げたりした連中は、すべてあちらこちらの椅子に陣取つてゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それで、この頃は不勉強、ね――トコセキナヨも、富本も。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "マケナヨマケナヨ、アスノ夜ハナイゾ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "文字トシテモ現今ノヒラガナヨリハ変態ガナノホウガ美シク、変態ガナヨリハ上代ガナノホウガ美シイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもまだかたくなっておどろいた様子をして、彼の女の萩のナヨナヨとした若芽で結んで居る髪を見つめた。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎の読本兎ノ学校ノ読本ハ意地ワル神ニダマサレタ因幡ノ国ノ白ウサギ泣イテヰタレバ泣クナヨトナサケノ深イ神サマニタスケテモラツタ物語リ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭の桐の木の葉崩れから、カサコソと捲きおこる秋風が呉子さんの襟脚にナヨナヨと生え並ぶ生毛を吹き倒しても、また釣瓶落ちに墜ちるという熟柿のように真赤な夕陽が長い睫をもった円らな彼女の双の眼を射当てても、呉子さんの姿は、たちどころに一抹の水蒸気と化して中空に消えゆきそうに考えられるのだった。",
              "citation": {
                "source": "振動魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、悪獣は四足を曲げナヨナヨと土へ膝を突き頤をタラリと垂れたのである。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痩せて蒼白くてナヨナヨしている、都会の女とは事変り、何んて素晴らしい体格なんだ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と悪罵が漸次高調に達したとき、傍らに寝ていた子どもが目を覚まし、「チャン、ヨシナヨ！",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "花活に入れるんだからと云われてナヨナヨとした孔雀草に青く光るはさみをあてた時も自分の心にそむいてあべこべの方に走るような苦しい心持でいたわるようにそろっと十本ばかりをきった、まるで草にうらまれて居るような心持で……。",
              "citation": {
                "source": "日記",
                "author": "一九一三年（大正二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナア、だから、村サヴェートで大会があるときは手を上げなさんナヨ。",
              "citation": {
                "source": "ペーチャの話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリザベト内親王のお散歩といった恰好で、裾をつまみながらナヨナヨと庭へ出てみたが、べつに変ったこともない。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ナヨナヨと扇をつかいながら、｜Bonjour Monsieur か。",
              "citation": {
                "source": "キャラコさん",
                "author": "鴎",
                "note": "青空文庫"
              }
            },
            {
              "text": "笹山の　山坂越えて山城の　瓜生の里に我は　瓜作る　瓜作りナヨヤ　ライシナヤ　サイシナヤ我は　瓜作る　瓜作り　瓜作り　ハレ。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "気が付くと路地の中へ、少し疲れたような山之助が、ナヨ／＼と入って来るのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "群盗",
                "note": "青空文庫"
              }
            },
            {
              "text": "「冗談云ウナヨ、マダソンナヨボ／＼ジャナイヨ」ソウハ云ッタガ、佐々木ガ腰ヲ押シテクレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナモノハ要ラナイガ、薬師寺ヘ行ッタラ佛足石ヲ拝ンデ来ルコトヲ忘レルナヨ」「ブッソクセキ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男のくせに、ナヨナヨとした大變な野郎で、一名は蟻地獄」「それが怪しいのか」「怪しいどころの騷ぎぢやありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "掏られた遺書",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
