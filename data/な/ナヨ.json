        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「帰り道、暗いから気をつけて行きなよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「せっかく作ったんだから、冷めないうちに食べなよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「疲れているみたいだし、今日は早く寝なよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「まあさう怒るなよツ」といつて彼は大声で笑ふのだつた。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "神が在れば、どんなよいことがあるかといふのが問題である。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "下田先生の所謂、女徳のなよよかなるいはれにて、宥さばゆるせよかし。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いなとよ、妾は柳は柳なれど、加賀の千代の句近し、おんみは河内の國玉越の里の柳、楊枝にけづりてもなよよかなり。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "表面は蛟龍雲を吐いて神有の祕密をそめて見るや裏面には伶人｜額をたれて物思ひ煩ふなよび姿才華悧悧たる眼ざしには工匠が怨みもこもりけんよ。",
              "citation": {
                "source": "古盃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "欲しいと思った皿を買ったのは愉快であるが、電車のゆれるにつれて腹の奥底の方に何処か不安なような念が動いていた。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼時の記憶には実に些末なような事柄が非常に強く印象に残っていることがある。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時｜颱風の話からそのエネルギーの莫大なこと、それをどうにかして人間に有益なように利用するようにしたいというようなことを話したら、大変にそれを面白がった。",
              "citation": {
                "source": "子規の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校へ行って文明を教わっている村の青年たちには、裃をつけて菅笠をかむって、無意味なような「ナーンモーンデー」を唱える事は、堪え難い屈辱であり、自己を野蛮化する所行のように思われたのである。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えてみると可哀相なような気がする。",
              "citation": {
                "source": "郷土的味覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とつぶやき、さうして何だか、胸の奧底から、妙なよろこばしさが湧いて出て來た。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「濱育ちのくせに、山奧の猿みたいな事を言ふなよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廢殘の御隱居、とでもいふのかしら、あなたのやうなよぼよぼの御老體は、かへらぬ昔の夢を、未來の希望と置きかへて、さうしてご自身を慰めてゐるんだわ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にいちど、井伏さんの事を書いて、そのとき、井伏さんに「もう書くなよ」と言はれ、私も「もう書きません」と約束をした事があつたのだ。",
              "citation": {
                "source": "小照",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに泰子、今こそはおまへの髪毛なよぶころ花は香炉に打薫じ、羊の歌羊の歌　　安原喜弘に※　祈り死の時には私が仰向かんことを！",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何て鬼だ」「船長ってえ鬼だったよ」「大笑いさすなよ。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そらバスケットを取ってくんなよ」「ほら。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "気をつけなよ」「お前の方が、気をつけろよ。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなってしまえば、もうジャーナリズム的批評の圏外に出てしまって土に根を下ろしたことになるであろうが、今のジャーナリズムの世界ではそういうことはちょっと困難なように見える。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなような考えから、私はいつぞや先ずこのＸＺ面の射影、すなわち唇の出方のいろいろと変る方だけを二、三十首の歌について画いてみた事がある。",
              "citation": {
                "source": "歌の口調",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギリシア人と中央アジア並びにインド人と交渉のあったことは確かであり、後者とシナ人、シナ人と日本人とそれぞれの交通のあったことも間違いないとすれば、歌謡のごときものが全く相互沒交渉に別々に発達したと断定するのも少し危険なような気がするのである。",
              "citation": {
                "source": "短歌の詩形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "同乘の小學生を注意して見ると、勿論みんな違つた顏であるが、其れで居て妙にみんなよく似た共通の表情がある。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い村落は永い間の自然淘汰によって、颱風の害の最小なような地の利のある地域に定着しているのに、新集落は、そうした非常時に対する考慮を抜きにして発達したものだとすれば、これはむしろ当然すぎるほど当然なことであると云わなければならない。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪が氷のように透明でないのはつまり雪片の中に空隙が沢山あるためで、丁度ガラスの粉が真白なようなわけである。",
              "citation": {
                "source": "雪の話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "真当の恋というものの本質も標準も私が必ず知って居るというわけではないけれど、とにかくより執拗なより永遠的なものということですの。",
              "citation": {
                "source": "新時代女性問答",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それなら、たかという名のついたことは不思議なようですが、これは、一つはよだかのはねが無暗に強くて、風を切って翔けるときなどは、まるで鷹のように見えたことと、も一つはなきごえがするどくて、やはりどこか鷹に似ていた為です。",
              "citation": {
                "source": "よだかの星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっちにもこっちにも子供が瓜に飛びついたときのやうなよろこびの声や何とも云ひやうない深いつゝましいためいきの音ばかりきこえました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからもう四粒ばかりぽろぽろっところがって来たと思うとあとは器械ばかりまるで今までとちがった楽なような音をたてながらまわりつづけました。",
              "citation": {
                "source": "耕耘部の時計",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
