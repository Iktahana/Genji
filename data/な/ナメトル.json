        "examples": {
          "standard": [
            {
              "text": "猫が指先に付いたチュールの残りを、ざらざらした舌で器用に舐め取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スプーンの裏側に残ったジャムを、勿体ないので綺麗に舐め取る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ほら、口の周りにケチャップがついてるよ」「あ、本当だ」と言って舐め取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "百貨店帰りの若い売子女の飲んだあとからは、兵卒達が口紅を舐め取るために先を争った。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            }
          ]
