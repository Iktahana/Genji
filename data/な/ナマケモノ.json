[
  {
    "uuid": "c6cc74e3-20c1-5ee7-9b49-4af04d9451b6",
    "entry": "怠け者",
    "reading": {
      "primary": "なまけもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
