        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから後が、また、お互い責任のなすり合いでたいへんです。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも互のなすり合い以上のところに原因があることを云っているのですが。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それは名ばかりのもので、責任のなすり合いに終ることが多い、と。",
              "citation": {
                "source": "あるニュウ・フェイスへの手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "………が、まあ、どっちがよいの悪いのと今さら責任のなすり合いをしたところでしょうがない。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
