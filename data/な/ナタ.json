  {
    "uuid": "7adbee97-6fdd-5637-9f96-2c1b81fd5c09",
    "entry": "ナタ",
    "reading": {
      "primary": "なた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヨク来タト申シタイアナタノ可愛イ手紙、今朝参リマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今アナタノ顔ヲ見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今アナタ忙ガシイデショウネ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今アナタノ顔見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに夢想的過程なるものは、表出されたとして人生的位置を、即ち meaning を持たない、つまりソナタにならないのだ。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "海ノカナタノ諸々ノ国ノ者ドモニモ知ラセテヤリタイ　ともおつしやつて居られました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六年前の建暦元年六月三日丑剋、将軍家御寝の際、高僧一人御夢の中にあらはれて、汝はもと宋朝医王山の長老たり、とお告げになつたのださうで、誰ニモ言ハズニ居リマシタガ、ソナタノ物語ト符合シテヰルトハ面白イ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからナタル、ザンジバールをも見舞った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、ナタリー、おまえおれの女房になってくれ。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　すると、ナタリーが眼脂をふいてこたえた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　赤い焔のように、一条の直線がナタリーの頬にふれた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時にナタリーの悲鳴が爆発して彼女の頬に紅色の液体がながれていた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うん、おれはナタリーが好きだ。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ、キットウマイ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "九唱　ナタアリヤさん、キスしましょう　その翌、翌日、まえの日の賤民とはちがって、これは又、帝国ホテルの食堂、本麻の蚊がすり、ろの袴、白｜足袋の、まごうかたなき、太宰治。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」『スズサン、リヨウジカンケイサツニコウリユウセラル、ドナタカスグゴライセイヲコウ――ハナカワヤ』「おや、すゞがあげられた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　騎者の荒々しい声を残して、馬は、丘を横ぎり、ナターリイの前を矢のように走り抜けてしまった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "異母妹のナターリイは、老人の死骸に打倒れて泣いた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等が口にする「アナタア」には、露骨にこびたアクセントがあった。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャーナタはうっとりその青くすこし朧ろな水を見た。",
              "citation": {
                "source": "龍と詩人",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　チャーナタはかなしくまた洞のなかをふりかへり見た。",
              "citation": {
                "source": "龍と詩人",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（敬ふべき老いた龍チャーナタよ。",
              "citation": {
                "source": "龍と詩人",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（わかもののスールダッタは、洞に封ぜられてゐるチャーナタ老龍の歌をぬすみ聞いて、それを今日歌の競べにうたひ、古い詩人のアルタを東の國に去らせた。",
              "citation": {
                "source": "龍と詩人",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで老いたる龍のチャーナタよ。",
              "citation": {
                "source": "龍と詩人",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍のチャーナタは洞の奧の深い水にからだを潛めてしづかに懺悔の偈をとなへはじめた。",
              "citation": {
                "source": "龍と詩人",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者が〔以下原稿数枚なし〕　それから「アナタ、タヾノオキャクサンゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると向ふが意外にも「アナタオ湯オハイリゴザイマセンカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタコノヘンノオテラ、ボンゾサン　シッテヰルゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
