    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕コソホントノ道子ノ愛人ナノダ、所有者ナノダ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋ニナッテ葉ヲ落スノハ、無益ナ消耗ヲ避ケテ樹液ヲ貯エ、春ニナッタラ大イニ伸ビテヤロウトイウ樹木ノ高イ意欲ノアラワレナノダ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ劇場内ハ冷房シテイタガ、コノ冷房ガ予ニハ禁物ナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガ婆サンニオ覚エノ悪イノハ、コンナ場合、婆サンヲ無視シテ予ノ気持ヲ迎エヨウトスルカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コリーノ方デハ戯レル積リナノダガ、思イモカケヌモノガ飛ビ着イテ来タノデ予ハ驚イタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ晩アンナ涙ガ出タノハ、ヤッパリ心ニ死ノ豫感ガ萌シテイタカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトヨリ僕ハ彼女ニ都合ノヨイ、彼女ノ耳ニ痛イヨウナヲ書ク気ニナッタノハ、彼女ノアマリナ秘密主義、―――夫婦ノ間デ閨房ノトシテ聞キタガラズ、タマタマ僕ガ猥談メイタ話ヲシカケルトタチマチ耳ヲ蔽ウテシマウ彼女ノイワユル「身嗜ミ」、ア　偽善的ナ「女ノラシサ」、アノワザトラシイオ上品趣味ガ原因ナノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正直ニ云ッテ、現在ノ僕ハ週ニ一回クライ、―――ムシロ十日ニ一回クライガ適当ナノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サシアタリ僕ガハナハダ当惑シ、参ッテイルノハ、コノ一事ナノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ニ酒ヲ仕込ンダノハ僕ダガ、モトモト彼女ハ行ケル口ナノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ僕ガ木村デアッタトシテ、ドッチニヨケイ惹キ付ケラレルカトイエバ、ソレハ、年ハ取ッテイルケレドモ母ノ方デアルヨリモ、僕自身ハドンナツモリナノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………　………今夜モ妻ハ中座シテ便所ニ隠レ、ソレカラ風呂場（風呂ハ一日置キナノダガ、当分毎日沸カス※ニスルト妻ハ婆ヤニ話シテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆ヤハ通イナノデ夕方水ダケ張ッテオイテ帰リ、瓦斯ニ火ヲ付ケルノハワレワレノウチノ誰カナノダガ、今夜ハ時分ヲ見計ラッテ郁子ガ付ケタ）ヘ行ッテ倒レタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "徒ラニ悲シミヲ増サセルニ過ギナイノナラ知ラセルノハ無駄ナノダカラ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガコレラハスベテ架空ノ出来事ナノダ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
