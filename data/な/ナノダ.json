        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼が来なかったのは、招待状が届かなかったからなのだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "プロジェクトが失敗したのは、予算不足だったからなのだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女が返信しないのは忙しいからなのだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
