        "examples": {
          "standard": [
            {
              "text": "彼は新しいナイキのランニングシューズを試着した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ナイキのロゴは、世界中でよく知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人はナイキの限定スニーカーを手に入れるために、夜から並んだそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そうして男が包丁を手に持っている時に、不意に親がナイキリー（縦に切れ）といったので、うっかり女房の戒めを忘れて、その瓜を縦に切ってしまった。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
