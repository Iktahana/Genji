[
  {
    "uuid": "a694f9b6-6e23-5da0-b516-3de28fca9214",
    "entry": "泣き止む",
    "reading": {
      "primary": "なきやむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
