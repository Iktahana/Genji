          "standard": [
            {
              "text": "部品加工のため、金属の中刳り作業が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大型機械の円筒形部品は、精密な中刳りが必要となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "中刳り加工は、材料の内部をくり抜く技術だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "お召の平生着に桃色の巻つけ帯、衣紋ゆるやかにぞろりとして、中ぐりの駒下駄、高いので丈もすらりと見え、洗髪で、濡手拭、紅絹の糠袋を口に銜えて、鬢の毛を掻上げながら、滝の湯とある、女の戸を、からりと出たのは、蝶吉で、仲之町からどこにか住替えようとして、しばらくこの近所にある知己の口入宿に遊んでいた。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "また同郡江崎村の条「うそ越の岬より六町ほど沖寅卯の方に当りて中ぐりと申す瀬ばえ、広さ竪横ともおよそ四五十間も御座候。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
