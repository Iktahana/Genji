          "literary": [
            {
              "text": "機械其他ノ設備ヲ資本トシテ鑛山其者ノ價格ガ資本ナルコトヲ忘レントスル誤解ヲ防グ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只獨逸ガ最後ニ破レタルガ故ニ徴兵制ノ價値ヲ疑フハ非常ナル妄斷ナルコトヲ注意ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑品倉庫ナルコトヲ知リ得タリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "無謀ナルコトヲヤメヨ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "此感覺ヨリ取リ得タル者ヲ記性ニ付シ、過去ノ事ヲ現在ヨリ未來ニ遺シ、保存シテ同一物ニ逢フ毎ニ、再ビ前時ニ認メ得タル者ナルコトヲ知ル上ニ在リ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯縁熏発シテ幸ヒニ信輩ノ熊野ニ詣ルモノヲ乗セタルガ為メニ、更ニ転生シテ第四生ニハ柴燈ヲ燃ヤスノ人身トナルコトヲ得タリ。",
              "citation": {
                "source": "覚海上人天狗になる事",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
