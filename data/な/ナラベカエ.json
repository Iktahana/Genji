        "examples": {
          "standard": [
            {
              "text": "データを日付順に並べ替えすることで、過去の推移が把握しやすくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "トランプのカードを数字の小さい順に並べ替えして、ゲームの準備を整える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "本棚の整理を兼ねて、作家の名前の五十音順に並べ替えを行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "アマチュアのパイロットの資格を持っていたドンピアは、低い周波数の電波を受信できる小さなトランジスターラジオで天気情報を聞きながら、入力した数値を大小の順に従って並べ替える、ソートと呼ばれる作業のためのプログラムをスイッチから入れていった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つは集めたデータをルールに従って並べ替えるためのスーパーソート。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからか古い雛段を出して来て順序よく並べ、暫くするとまた並べ替えるのでした。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがこれだけあれば証拠品としては十分過ぎる位だ」　明智は容器を一つ一つ、つまみ上げて、大切相に並べ替えて行った。",
              "citation": {
                "source": "一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "厚みも大きさも将棋の飛車角ぐらいに当る札を五六十枚ほど四人で分けて、それをいろいろに並べかえて勝負を決していた。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一度、もとどおりに並べかえるだけだ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "その警官は帆村へ何か合図を目で送ると、椅子を整頓し、二人の話しやすいように並べかえた。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "弾薬庫は開かれ、二十インチ砲弾をはじめ数々の砲弾が、それぞれの砲塔へおくりやすいように、改めて並べかえられた。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずありのままの形において写し、構図は人間の方で多少動いてよろしき位置を定めるのであるが、静物にあっては例えば卓上菜果の図を作るに、それらの題材は自由に画家の希望通り並べかえ取りかえることが出来る。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
