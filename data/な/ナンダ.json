        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "何だ、せっかく並んだのにお目当てのパンが売り切れちゃってるじゃないか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "何だ、このパソコン全然動かないぞ。さっきまで普通に使えていたのに。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "何だ、聞いていた話と全然違うじゃないか。これじゃあ詐欺と同じだよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
