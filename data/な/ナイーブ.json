          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はまだ若くて世間知らずなところがあり、とてもナイーブだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女のナイーブな性格が、時として傷つきやすい原因となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そのアーティストは、ナイーブな感性で繊細な作品を生み出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "全くの山の手のお嬢さん気質と、全くの下町の坊っちゃん気質と共通するところがあって彼女は国太郎にナイーブなところを見付けていた。",
              "citation": {
                "source": "とと屋禅譚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　いつまでもシムプルでありたい、ナイーブでありたい、少くとも、シムプルにナイーブに事物を味わいうるだけの心持を失いたくない。",
              "citation": {
                "source": "夜長ノート",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際私はどんな高い文化と教養との素地的な訓練にも応え得る玉のようなナイーブさと、鋭い感受性とを持った少年だったのだ。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナイーブな感性は、強烈な個性とともに、激しい敵愾心をさらけ出すこともあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナイーブな内面を持つジョブスにとって、このときの精神状況がその後の人生に少なからぬ影響を与えているように思える。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "素直な心は拗ねることを知らないから、それはまたナイーブで率直である。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆえに自分自身の利便を擲って恐れず、時には自己の身命をも棄てて顧みない人の心において初めて、素直なもしくはナイーブで率直な心は成立する。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "思うに私らはナイーブなままでは善くあることはできないらしい。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ナイーブな心がこれから始めて世の中に接觸しようとする際、俄に病氣に罹つた。",
              "citation": {
                "source": "「青白き夢」序",
                "author": "森田草平",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ナイーブなところがあって（写し方に）それが女優のそういう味と合い、一寸面白かった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○作家として自分の生活はナイーブすぎたと思う。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台装飾は、由来、脚本の上演に当つて屡々上演者のナイーブな誇示的欲望の道具に使はれたのであります。",
              "citation": {
                "source": "演劇一般講話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の詩を読むものは、何びともあの天才的奔蹤を思はせる未曾有のリズムと、その何物にも捉はれない嬰児のやうなナイーヴな感情とに、絶大な驚異を感ぜずには居られないであらう。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "之れに反して藤村の詩は、僕にとつてあまりにナイーヴで明るすぎ、陰影のない不滿さを感じさせた。",
              "citation": {
                "source": "永遠の詩人",
                "author": "宿命生涯を貫く",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の人物の本質には、何とも言語につくせないナイーヴさがある。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども君と千家とは、そのナイーヴさの特色に於て、非常にまた著るしくちがつたものが感じられる。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "否もつと丁寧には、趣味の深い教養と文明的禮節を有する所の、しかも性格の本質部分におけるナイーヴな子供である。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホイツトマンでも、ヱルレエヌでも、詩人の性格にはどこか皆純樸な子供らしさや、ナイーヴな野蠻めいた所や、エゴの強いお坊つちやんらしい所のある者だが、とりわけ室生にはさうした方面の傾向が烈しいやうだ。",
              "citation": {
                "source": "室生犀星の印象",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼の性格が、あまりにざつくばらんで、あまりにナイーヴでありすぎるからだ。",
              "citation": {
                "source": "室生犀星の印象",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいていの詩人は、皆ナイーヴな自然兒らしい一面と、非常に神經質な感覺的の一面とをもつてゐて、その兩方からリズムを組み立てて行くのだが、室生の如きも、この點で申し分のない詩人的天稟をもつた人間である。",
              "citation": {
                "source": "室生犀星の印象",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄は折角素直に生ひ立つた妹の愛すべき性格を知らない他人に、猥りに逆撫でさせたくないといふ真意から、また勇吉は自分が自分とはまつたく性格の反対なこのナイーヴなロマン性の娘を兄に代つて護り育てられる資格と自信を持つたものだから歳子の授受の内容には極めて親切で緊密な了解が働いてゐた。",
              "citation": {
                "source": "夏の夜の夢",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この声の耳触りはわたしの永年世俗に従うための克己努力によって殻に殻を重ねてしまった松株のような心に容易く浸透してわたし自身の中なる本質のナイーヴなものをわたし自身に気付かせる。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "よれよれの五十銭札みたいに使い古された陳腐な言葉の助けを借りて、何もかも既知の事実にしてしまうという観念の衣裳をまとわぬナイーヴな子供の感受性を、京吉は馴々しく図太い神経の中に持っているのだ。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はもうその時の実感を呼び起すだけのナイーヴな神経を失っているし、音楽でも聴かぬ限り、めったと想いだすこともないが、つまらない女から別れ話を持ち出されて、オイオイ泣きだしたのは、あとにもさきにもこの一度きりで、親が死んだ時もこんなにも取り乱さなかった。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "出ている連中はみんな転向しているよ」「なるほど、しかし、本当に転向しているんですか」　名前は信吉だが、いかなる思想も信じたことのない信吉は、転向者の心理というものが判らず、皮肉のつもりではなく、ナイーヴな気持から、きいてみたかった。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、ものを書く人間は、どんな目立たぬことにも一応驚くナイーヴな感受性を持っていますがね。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "この場合、一般人間性の解放というところに力点をおいたり、男女平等というところにだけ力点をおくものとすれば、幾等かのナイーヴであろう。",
              "citation": {
                "source": "デスデモーナのハンカチーフ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "比較的に見るとき、レディにはそのナイーヴさ、素純さ、処女性の新鮮さにおいて、玄人にはとうてい見出されない肌ざわりがあるのだ。",
              "citation": {
                "source": "学生と生活",
                "author": "――恋愛――",
                "note": "青空文庫"
              }
            },
            {
              "text": "感情が豊富で幾らかませていること、しかも感覚的にナイーヴですれていないこと。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おひささんはナイーヴですから、対手のそういうクラーク気質を素直に反映するのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
