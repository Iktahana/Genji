    "definitions": [
      {
        "index": 1,
        "gloss": "to throw down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "強風が吹き荒れ、屋根の瓦が次々と地面に投げ落とされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "怒りに任せて、彼は持っていたコップを床に投げ落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "高層ビルから物を投げ落とす行為は、非常に危険だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それもそろそろと動くのではなく、谷間に石を投げ落とすときのように加速度をくわえて飛んでいったかも知れない。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのためこのみじめな、実際みじめな生を延引して、この不安定な肉体を――ほんのちょっとした変化によっても私を最善の状態から最悪の状態へ投げ落とすことのあるこの肉体をひきずって生きて来た！",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "法律が投げ落とすすべてのものの陥る大洋！",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれが相手を投げ落とすであろうか？",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "市郎も流石に肝を冷して、愈よ小さくなっていると、又もや石をがらがらと投げ落す奴がある。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠茂怒って自ら陣頭に立って戦うが、城中では予てよりの用意充分で、弓鉄砲の上に大石を投げ落すので、寄手の討たれる者忽ち算を乱した。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタ・アリは、マッチを擦って手早く覆の小穴から投げ落す。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「宇津木様、この下に何かいますぜ、熊か猪か、それとも鹿か人間か、ひとつ探りを入れてみましょう」　手頃の石を拾って谷底へ投げ落すと、「危ない、誰だい石を投げるのは」　谷底から子供の声。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白根山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "目よりも高く差しあげて、投げ落す。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "投げ落すのと違って、一つ十五貫もある石を担ぎだすのは大仕事であったが、彼は翌朝、疲れた色も見せなかった。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　和尚はソノ子を投げ落すと、うしろをまくりあげて、ズロースをひきはいだ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "身の生命と陣營と舟とを守り防ぐため、アカイア軍は壁の上其堅牢の塔により、　155石投げ落す。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "半島のわが舷の上に投げ落すものは、亞麻いろの眼をしたる怪鳥の爭、怪鳥の糞、かくて波のまにまに浮き行く時、わが細綱をよこぎりて、水死の人はのけざまに眠にくだる……入江の底の丈長髮に道迷ふわれは小舟ぞ、あらし颶風によつて鳥もゐぬ空に投げられ、甲鐵艦もハンザの帆船も水に醉ひたるわがむくろ、いかでひろはむ。",
              "citation": {
                "source": "醉ひどれ船",
                "author": "LE BATEAU IVRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "２．大地が搖ぎその上にある全てを投げ落す、この現象を地震と稱す。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "幽霊であれば飛んで帰つても聞くのだが、然しどうも仕方が無い、肉が付いて居る幽霊ぢや、と思つて居る時にザアと烈しく雨が降つて来る……あちらの屋根こちらの軒に、そしてまた栄一が持つて居る番傘の上に小石を投げ落す様に降る。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
