          "literary": [
            {
              "text": "門内の楽声更に壮んになる。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其声更に一段の寂寥を添ふ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "階砌は掃うに人なければ青苔雨なきも亦滑かに、虫声更に昼夜をわかつ事なし。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おとつゝあは何ちんだんべな」おつぎは齒痒相にいつて一｜聲更に「おとつゝあ」と力を入れて「盜らねえつて云へよ、おとつゝあ」　おつぎは熱心に勘次を見た。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
