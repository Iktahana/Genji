[
  {
    "uuid": "673fd323-2d75-5a4b-8336-8dcbad7d6122",
    "entry": "小松",
    "reading": {
      "primary": "こまつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
