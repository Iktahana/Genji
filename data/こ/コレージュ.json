        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いつだったかコレージュ・ド・フランスでデュアメルが名演説をしたとき、アベル・ボナールが感激してデュアメルを抱擁した。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "リセーは皆コレージュと呼ばれていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレージュ（高等中学校）の生徒らはえりに金の百合の花をつけ、ローマの王（訳者注　ナポレオン一世の子の称号）の問題について互いに争論していた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "1554年に彼はコレージュ・サン・コムの外科医長に任じられた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして六歳ばかりの時に、私を当時最も隆盛でフランス第一といわれたコレージュ・ド・ギュイエンヌに入れたのでございます。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく私は、まだ年もゆかないのに、年わずかに十二にして、（ウェルギリウス）当時我々のコレージュ・ド・ギュイエンヌで盛大に行われた、ブカナンやゲラントやミュレのラテン悲劇＊に出て、その主要人物を演じたのでございます。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "一五五〇年、コレージュ・ロワイヤルの教授となる。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼には尊敬する人物がいて、それはコレージュ・ド・フランスの教授だったりする。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
