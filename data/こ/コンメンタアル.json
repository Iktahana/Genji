          "literary": [
            {
              "text": "コンメンタアルの類も多少持っている。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ疑わしい処をコンメンタアルで調べて見ただけである。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルテが一老女だと云うことは、どのコンメンタアルにもある。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのコンメンタアルにも役者とことわってある。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で諸家のコンメンタアルに異説のある難句が、枚挙するに遑あらぬ程である。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
