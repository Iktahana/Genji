          "literary": [
            {
              "text": "――迦陵※伽の馴れ馴れし、声今更に僅かなる、雁の帰り行く。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "百樹曰、我が幼年の頃は元日のあしたより扇々と市中をうりありく声、あるひは白酒々の声も春めきて心も朗なりしが此声今はなし。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "450われの尊む姑の聲今聞ゆ、自らの胸裏心は口までも躍り、わが膝今しびる、プリアモス王生める子ら、彼らに危害迫るらし。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
