          "literary": [
            {
              "text": "欷歔の声漸次大きくなる。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治二十五年芳年は多数の門人を残して能くその終を全うせしが、その同門なる芳幾は依然として浮世絵在来の人物画を描きしの故か名声漸く地に落ち遂に錦絵を廃して陋巷に窮死せり（明治三十七年七十三歳を以て歿す）。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "唖に生じ虫声漸く多し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
