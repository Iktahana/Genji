          "literary": [
            {
              "text": "実際感情を害することもあれば、用事がひどくこんがらかって、おしまひはいくら禿鷲コルドンさまのご裁判でも、解けないやうになるのだったと申します。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その柔い生乾きの煎餅に似たものを、食後の客の前に出してアルコールランプの皿鍋が程よく焼けると、その中でシャンパンとリキールグラシ、マルニエ、コルドン、ルージュを注ぎ込んだオレンジのバタで、料理人が揚げる。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "果樹整枝法その四、又その一、水平コルドン。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "」大将「次はその又二、直立コルドン。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "」兵卒八「直立コルドンであります。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "果樹整枝法、その四、又その二、直立コルドン、はじめっ、一、二、一、二、一、二、一、二、一、やめい。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベースピラミッド　カンデラブルまたパルメット　エーベンタールことにも二つの　コルドンと棚の仕立に　　　いたりしにひかりのごとく　降り来し天の果実を　　　いかにせん。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
