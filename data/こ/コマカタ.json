          "literary": [
            {
              "text": "駒形は僕の小学時代には大抵「コマカタ」と呼んでゐたものである。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君は今｜駒形あたりほとゝぎす」を作つた遊女も或は「コマカタ」と澄んだ音を「ほとゝぎす」の声に響かせたかつたかも知れない。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒形は僕の小学時代には大抵「コマカタ」と呼んでいたものである。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君は今駒形あたりほとゝぎす」を作った遊女も或いは「コマカタ」と澄んだ音を「ほとゝぎす」の声に響かせたかったかも知れない。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アキハバラ」「タカダノババ」の今日では、今夏、あるところへ書いた私の小説など、校正注意と欄外へ朱書までしておいたのに、「駒形堂」を「こまんどう」とはルビしてくれず、むざんや、標準語で「コマカタドウ」でアリマシタ。",
              "citation": {
                "source": "寄席行燈",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
