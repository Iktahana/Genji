[
  {
    "uuid": "8a1d4f6b-5363-597b-94df-c04095ee79fd",
    "entry": "姑息",
    "reading": {
      "primary": "こそく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "underhanded",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ライバル会社に偽の情報を流して契約を横取りするなんて、そんな姑息な手段は許されない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は自分のミスを部下のせいにして責任を逃れようとする、実に姑息な男だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "姑息な根回しをして自分の有利な状況を作ろうとする政治家の姿に、国民は失望している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして科学者として立とうとしている以上、今後は文学などに未練を繋ぐ姑息を自分に許すまいと決心したのだった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを一時の愛着に牽かされて姑息にして置く法はない。",
              "citation": {
                "source": "An Incident",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども姑息の妥協は、政治、経済の上では勿論、学問の上にも屡々行はれて、それで大きな勃発もなしに流転して行く。",
              "citation": {
                "source": "計画",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども姑息の妥協は、政治、經濟の上では勿論、學問の上にも屡々行はれて、それで大きな勃發もなしに流轉して行く。",
              "citation": {
                "source": "計畫",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "感情をとやかくいうのは姑息です。",
              "citation": {
                "source": "外科室",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君が姑息の慈善心をもって、些少なりとも、ために御斟酌下さろうかと思う、父母も親類も何にもない。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "顧慮する勿れ、因循なる勿れ、姑息なる勿れ。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには郷里の因習や姑息に対してまだ燻っている父の改革の情熱を、違った他の問題に事寄せて先生に向って愛と共に訴えもし嘆きもするものゝように見えた。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モルヒネで痛を止めて置かうといふやうな、姑息な事には贊成が出來ない。",
              "citation": {
                "source": "半日",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "此際に於て、因循姑息の術中に民衆を愚弄したる過去の罪過を以て当局に責むるが如きは、吾人の遂に忍びざる所、たゞ如何にして勝ちたる後の甲の緒を締めむとするかの覚悟に至りては、心ある者｜宜しく挺身肉迫して叱咤督励する所なかるべからず候。",
              "citation": {
                "source": "渋民村より",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに比ぶれば、朝倉方は大将自身出馬せず、しかも大将義景の因循姑息の気が、おのずと将士の気持にしみ渡っていただろうから、浅井家の将士ほど真剣ではなかったであろう。",
              "citation": {
                "source": "姉川合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の語の真偽はとにかく、戦略上の要点を見付けるのに天才的な秀吉と、錚々たる土木家である増田長盛や、長束正家なんかが共同でやった仕事だから、姑息な小田原城の将士の度肝を抜くことなんか、易々たるものだったと思う。",
              "citation": {
                "source": "小田原陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「因循｜姑息な地味な商売より、当りさえすれば儲けのある水商売の方が、やはり女の人には向いていると、云わなくてはいけないでしょうな。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに事実のこれと反したるは、妾らの悲しみに堪えざる処なり、故にもし今大資本家に依りて製品の斉一を計り、かつ姑息の利を貪らずして品質の精良を致さば、その成功は期して待つべきなり。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時のつけ元気で苦しさをまぎらかしたのも、姑息の安を偸んでわずかに頭を休めたのも月末という事実問題でひとたまりもなく打ちこわされてしまう。",
              "citation": {
                "source": "去年",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "姑息政治を賢なりとする季世の政府が實力者に對する措置はいつも是の如きものであつた。",
              "citation": {
                "source": "道教に就いて",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "借方もかかる所業の不義なるを知るといへども、一は焦眉の急に迫り、一は期限内にだに返弁せば何事もあらじと姑息して、この術中には陥るなりけり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "相当の年齢に達してゐるにも関はらず彼は、幼稚を衒ふ婦のやうに姑息な心をもつてゐた。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、斯んな場合に、斯んな途方もない妥協心を持たうとする、姑息な弱さには辟易せずには居られなかつた。",
              "citation": {
                "source": "「或る日の運動」の続き",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そして彼は、「姑息！",
              "citation": {
                "source": "「或る日の運動」の続き",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの事についても僕は前からそういうふうにはっきり片づけてしまいたいと思っていたんですけれど、姑息な心からそれまでに行かずともいい結果が生まれて来はしないかと思ったりしてきょうまでどっちつかずで過ごして来たんです。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は手の平へ其袋を載せてやゝ姑らく眺めて居り升たから、私は今度限り勘弁してやるといつて、返して呉れるかと一寸は思ひ升た、併しそれほど姑息な父ではありませんから、懲めはつまり私の為と思切つて、其金を懐へ収め、これに懲て今度はモツト気をつけるが好い。",
              "citation": {
                "source": "黄金機会",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論、そんな姑息の方法では根深い誤解を除く事はとても出来ないかも知れんが、少くも彼我国際間の融和を計るには日本の文明を紹介するが有力なる一手段である。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は姑息な策を用いないで、正面から堂々と訪問の用向きを話した。",
              "citation": {
                "source": "或る探訪記者の話",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし元来が親藩であったし、因循姑息の藩士が多かったから、尊王撰夷などに、耳もかそうとはしないので、同志を募って、京洛に出でて、華々しい運動を起すというようなことはできなかった。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云つて他人の日誌から丹念に「天気」を写し取る程の汲々性で、正直な記録を作成して甘んじて当局の罰を負ふたならば、自分も寧ろ朗らかになり、党員等からも推賞されるに相違なかつたのであるが、彼はまた他の党員達と同じく姑息だつたのである。",
              "citation": {
                "source": "貧しき日録",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルジョア教育では、姑息に人生のこの興味ある時期をとり扱っている。",
              "citation": {
                "source": "砂遊場からの同志",
                "author": "――ソヴェト同盟の共学について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "曙覧、徳川時代の最後に出でて、始めて濶眼を開き、なるべく多くの新材料、新題目を取りて歌に入れたる達見は、趣味を千年の昔に求めてこれを目睫に失したる真淵、景樹を驚かすべく、進取の気ありて進み得ず逡巡として姑息に陥りたる諸平、文雄を圧するに足る。",
              "citation": {
                "source": "曙覧の歌",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは姑息にも馬、梅、蝶、菊、文等の語はいと古き代より用い来りたれば日本語と見做すべしなどいう人も可有之候えど、いと古き代の人はその頃新しく輸入したる語を用いたるものにてこの姑息論者が当時に生れ居らばそれをも排斥致し候いけん。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはじつにしずかで、あるいて行くじぶんの足音もきこえるくらいでしたし、足の下で枯れッ葉のかさこそくずれる音もきこえました。",
              "citation": {
                "source": "野のはくちょう",
                "author": "DE VILDE SVANER",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
