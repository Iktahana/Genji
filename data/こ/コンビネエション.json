          "literary": [
            {
              "text": "私はコンビネエション嵌めている。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "名優と天才作家――このコンビネエションがさほど明かでない場合でも、一時代或は一国の演劇文化は主として俳優を通じて、名作戯曲の出現に何等かの寄与をなしてゐる。",
              "citation": {
                "source": "なんとかせねばならぬ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "些細な単調な出来事のコンビネエションや、パアミテエションが、毎日単調に繰り返された。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
