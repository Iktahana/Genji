    },
    "definitions": [
      {
        "index": 1,
        "gloss": "anecdote",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "校長先生が朝礼で披露したちょっとした小話に、生徒たちは思わず吹き出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼のスピーチはいつもユーモア溢れる小話から始まり、聴衆の心を掴む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "酒の席で上司が語る失敗談という名の小話は、意外と教訓に満ちている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "昔ある所にね」という風にナイチンゲールが胸を棘にかき破られてその血で白の花弁を紅に染めたというオスカー・ワイルドの小話を語り始めた。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが読者のうちにも已に御承知の方もあらうが、古来の小説随筆類のうちから詐欺的犯罪行為に関する小話を原文のまゝに抜萃したもので、長短百種の物語を収めてある。",
              "citation": {
                "source": "赤膏薬",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "辰野隆先生訳、仏人リイル・アダン氏の小話であります。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度その頃、私達の使つてゐた國語讀本に「猫又」と云ふ小話が載つてゐた。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私には適当な材料の持ち合わせがないので、かつて父から聴かされた二、三種の怪談めいた小話をぽつぽつと弁じて、わずかに当夜の責任を逃がれることとした。",
              "citation": {
                "source": "父の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、エノツク・アヽデンや、モウパツサンの小話や、さういふものと同じに見せかけておいて、それをあの結末のところでひつくり返した形は、遉はこの作者だと思つた。",
              "citation": {
                "source": "三月の創作",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　もひとつをかしい小話がある。",
              "citation": {
                "source": "孟宗と七面鳥",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、それは芸術と云う一つの概念が感覚的なものか直感的なものか意志的なものであるかと云うことについて論証することと何ら変るところもない馬鹿馬鹿しい小話にすぎない。",
              "citation": {
                "source": "新感覚論",
                "author": "感覚活動と感覚的作物に対する非難への逆説",
                "note": "青空文庫"
              }
            },
            {
              "text": "小話数則４・８（夕）　米国の応募兵のなかに、脳の後頭部が削いで取つたやうに凹んだ頭をした兵卒の一人があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "男と女との胸釦の相異５・28サンデー毎日　今日は一ついつもとはぐつと趣向をかへて、変つた小話を幾つか書き集めてみることにする。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの新潮社から出されるトルストイの「人はどれだけ土地を要するか」という小話はかつておもしろく読みました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう紋切形字典――それを想像してみるだけでも、そして一寸でも自分自身を省みてみるならば猶更、おのずから人生の愚劣さに眉が顰めらるるのであるが、それに対抗するものの一つとして、反故に似た種々の小話が、至るところに散らばっている。",
              "citation": {
                "source": "話の屑籠",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々は日常、そういう小話をいくつも耳にしている。",
              "citation": {
                "source": "話の屑籠",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなことを細かく言っていたらば、一篇の、風俗史的な女性発展史になってしまうから、それこそ閑話休題であるが、面白いのは、新富座が越して来て間もない、明治八年ごろの、築地風俗に、こんな日常時｜小話がある。",
              "citation": {
                "source": "朱絃舎浜子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "金の時代とあるなかに「樹を伐る狐」といふ小話が興味が深かつたので、それから思ひ出したものと見える。",
              "citation": {
                "source": "春宵戲語",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "（15）私は茲に穗積重遠博士の「判例小話」（大正十四年一月『大阪朝日新聞』所載）から一事件を引用したい。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、少しの隙さへあれば好きな小話を作つたり、詩作に耽つたりしてゐた。",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、此小話では、そんな点迄かたづけて居る事は出来ぬ。",
              "citation": {
                "source": "村々の祭り",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この小話は、墺太利のカアル皇帝が、西班牙領の離れ小島で崩じた時と、同じような感銘を僕に与えたとおもうから、ここに書きしるしておこう。",
              "citation": {
                "source": "紙幣鶴",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の Basic で書かれた小話＊は「作用詞」に伴ふ「方向詞」の働きをよく示してゐる。",
              "citation": {
                "source": "ベーシック英語",
                "author": "高田力",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、秋おそい、山村の小話としては、捨て難い、私はそんな風にも思つた。",
              "citation": {
                "source": "猟人",
                "author": "津村信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　野々宮はこの小話に「悲しみの村の歴史」といふ題をつけてゐた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまらぬ評判はもうお聞きおよびのことでしょうから、ひとつ、小話になるような逸話を申し上げますじゃ。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたが貸して下すったトルストイ小話ね。",
              "citation": {
                "source": "掠奪せられたる男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど彼は、何か面白いものをという秀子の乞いに任せて、トルストイの小話の飜訳を貸してやったのであった。",
              "citation": {
                "source": "掠奪せられたる男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "山田自身もあの小話には心酔して読み耽ったものであった。",
              "citation": {
                "source": "掠奪せられたる男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの小話のうちで、あなたにはどれが一番面白かったのです。",
              "citation": {
                "source": "掠奪せられたる男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、ふと思い出して、トルストイの小話を頭の中に思い起そうとした。",
              "citation": {
                "source": "掠奪せられたる男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その横の琴を立てかけた違棚の上には、種々な画帖が乱雑に散らかっていて、山田が貸した五六冊のトルストイの小話集までが置いてあった。",
              "citation": {
                "source": "掠奪せられたる男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生さまにこんなうそっこばなしを申しあげてすみませんが……」「どうして、ほんとにおもしろかったよ。",
              "citation": {
                "source": "河口湖",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
