          "literary": [
            {
              "text": "又、先進日本の能・歌舞妓が、島の宮廷の式楽に飜作せられたものとも思はれない。",
              "citation": {
                "source": "組踊り以前",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥義抄に盗古歌として挙げてゐる類は、皆飜作である。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に長歌の形を以て、新しい叙事詩に飜作もした。",
              "citation": {
                "source": "万葉集研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから場合によつては、之を普遍化するのに、著しく低級な飜作を行ふことがある。",
              "citation": {
                "source": "街衢の戦死者",
                "author": "――中村魁車を誄す――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
