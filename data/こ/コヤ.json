[
  {
    "uuid": "4cd84788-10ea-5760-8163-2aa3123b62fa",
    "entry": "小屋",
    "reading": {
      "primary": "こや",
      "alternatives": [
        "しょうおく"
      ],
      "is_heteronym": false
    },
    "grammar": {
