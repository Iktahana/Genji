          "literary": [
            {
              "text": "午前六時、靴の音｜茶碗の音子を叱る声拍手の声善の声悪の声｜千声万響遂に余の苦痛の声を埋め終る。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナマキ村のリキ　　　　（満場の拍手）シラタマ村のゲン　　　　（遠い拍手歓声）タコツボ村のクマ　　　　（同じ）モモシキ村のヒヤク　　　（同じ）ウラシマ村のカメ　　　　（同じ）カグラ村のハチ　　　　　（同じ）ハナマキ村のタケ　　　　（歓声拍手）以上七名。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅草花月劇場へ、宇留木浩追悼の夕で、夢声・エノケンのあとへ出る、ワーッといふ歓声拍手、「ロッパ浅草を忘れたか」と言はれセンチになり、出来悪し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
