          "literary": [
            {
              "text": "コムプレス〔湿布〕をして自分一人先生にゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月六日　雪　体量、真綿入のどてらとコムプレスをつけたままで五七キロ・七＝ざっと十五貫ある。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三幕まで見てＹ苦しがるので二人でかえってＹにコムプレスをして、〔以下空白〕四月二十五日　金　今日Ｙ、大分工合わるく一日床に居た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝五時すぎ目をさまし、昨夜のコムプレスをとる。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史の人間的コムプレスはこういうようなところにある。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
