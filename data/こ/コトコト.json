[
  {
    "uuid": "ccf66e9a-16f0-5be3-8ebf-cc5e1ede2d8b",
    "entry": "コトコト",
    "reading": {
      "primary": "コトコト",
      "alternatives": [
        "ことこと"
      ],
      "is_heteronym": false
    },
    "grammar": {
