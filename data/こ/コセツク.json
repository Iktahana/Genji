    "definitions": [
      {
        "index": 1,
        "gloss": "to make a fuss (about nothing)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "どうでもいい瑣末なことにこせついている間に、大事なチャンスを逃してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そんなにこせつくなよ、なんとかなるさ」と友人が肩を叩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小さなミスをいつまでも気にしてこせつくのは、精神衛生上よくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "（ポポーフという男のくせだ）それは奇麗ずきで、目先をかえたがってこせつくことだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は女で、こせつくようにと女がするのだから可笑しい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "関守氏は、目的地に着いたからといって、驀直に目的に向ってこせつくような軽策を取らない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝てもおれ、覚めてもおれ、このおれが至るところにつけまつわっているから、人間の行為言動が人工的にコセつくばかり、自分で窮屈になるばかり、世の中が苦しくなるばかり、ちょうど見合をする若い男女の心持ちで朝から晩までくらさなければならない。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to be cramped",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "これだけ荷物が多いと、どんなに広い部屋でもこせついて見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "間取りが複雑なせいで、家全体がこせついた印象になってしまっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "窓が小さいと、光が入らなくて部屋がこせついて感じるものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
