  {
    "uuid": "ea5cb2af-5356-56c8-a292-b4b1e36d88be",
    "entry": "黒竜",
    "reading": {
      "primary": "こくりゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
