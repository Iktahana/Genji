        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ハ仕立屋デ、毎日、コヽデ着物ヲヌツテヰマシタノニ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽエ別ニ………」「ソウカイ、子供達モ大層元気ラシカッタネ」「有難ウゴザイマス、オ蔭様デ今年モ大喜ビデ」「不断メッタニ見ナイセイカ、三人トモ見違エルホド大キクナッタネ」コヽデ婆サンガ口ヲ挟ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト颯チャンノ石ダッテ餘程ノモノデショウネ」「ソンナモノヲ誰ガイツノ間ニ買ッテオヤリニナッタンデショウ」ト、コヽデ又婆サンガ一言シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手ハモウスッカリオ直リニナッタンデスカ」来ルトイキナリ気ヲ呑マレタ形デ眼ヲ白黒サセテイタ五子ハ、コヽデ辛ウジテ嘴ヲ入レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食堂ヘ行カナイデモイヽジャナイカ、コヽニ鮨ガコンナニ残ッテル、コヽデコレヲ食ベナサイ」「ソウ、デハソウスルワ」「君ト鱧ヲ食ベルノハ浜作以来ダナ」「ソウダッタワネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
