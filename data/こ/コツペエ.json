        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "指先に触つたのは煙草では無くて、矢張その頃の文士の一人フランソア・コツペエの詩集であつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者は先刻友達に出会つた時、コツペエの詩集を読みさしの儘、ポケツトに入れた事に気が注いた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその頃コツペエが風邪か何かで臥つてゐるのを思ひ出すと、覚えず小躍りして叫んだ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さうだ、コツペエさんの御厄介にならう。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして受附の男を見ると急に悲しさうな顔をして、「フランソア・コツペエが亡くなりました。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにコツペエが亡くなつたつて。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツペエさんはお風邪のやうには聞きましたが、お生命に別条は御座いません。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶衆客皆杯を挙げて主人の健康を祝するや、ユウゴオ傍なるフランソア・コツペエを顧みて云ふやう、「今この席上なる二詩人｜迭に健康を祝さんとす。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "意コツペエが為に乾杯せんとするにあり。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツペエ辞して云ふ、「否、否、座間詩人は唯｜一人あるのみ」と。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "意コツペエが言を翻しておのが仰損を示せるなり。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
