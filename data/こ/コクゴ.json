        "examples": {
          "standard": [
            {
              "text": "「明日の国語のテスト、漢字の書き取りが範囲だからしっかり復習しておかなきゃ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は子供の頃から本を読むのが大好きで、国語の成績はいつも学年でトップだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今日の国語の授業でやった『こころ』の読解、難しかったけど面白かったね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
