        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "恥ずかしながら、この方も若かりし頃は、夢を追いかけて単身海外へ渡ったことがございます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この方が長年大切にしてきたこのコレクションを、ぜひ次世代の方々にも見ていただきたいのです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "未熟なこの方ではございますが、精一杯務めさせていただきますので、何卒ご指導ご鞭撻のほどお願い申し上げます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
