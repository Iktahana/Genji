[
  {
    "uuid": "c9c8aa51-d82d-5d92-911d-c9b7a25f7b89",
    "entry": "今来",
    "reading": {
      "primary": "こんらい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
