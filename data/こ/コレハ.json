[
  {
    "uuid": "47b60bd2-684a-50eb-a2dd-0de007a03e37",
    "entry": "此れは",
    "reading": {
      "primary": "これは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
