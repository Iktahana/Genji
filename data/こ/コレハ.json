        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「此れは、田中さん！久しぶりですね、お元気でしたか？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「此れは、まさかあなたがこんなところにいるとは驚いた！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「此れは、可愛い子猫ですね。どこから来たんですか？」",
              "citation": {
