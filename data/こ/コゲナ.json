        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ンでも、こげなこと、一ぺんもごぜえませんもの。",
              "citation": {
                "source": "和太郎さんと牛",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こげな、あほくさいことは、ねえだ。",
              "citation": {
                "source": "百姓の足、坊さんの足",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "――こげな人もあるだ、こげな心のいい人も、とみんなは思つたのだつた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "こげな火打みてえな古くせえもなア、いざというとき間にあわねえだなア」　そういってしまって巳之助は、ふと自分の言葉をききとがめた。",
              "citation": {
                "source": "おじいさんのランプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧藩時代からの蘭学者の家柄とか申しておりましたが」「ウムウム、中々の物識りという話じゃが、あの男がこの間、避病院の落成式の時にこげな事を話しよった。",
              "citation": {
                "source": "骸骨の黒穂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の因果でこげな人間に生れ付いたか知らん。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こげな事にかけますと私はドウモ気の小さい方と見えまして……ヘイ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こげな品物ば下げておくと、喰うたお客の頭の毛が抜けるばい」「要らん世話たい。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こげな有難い物たあ知らんじゃった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとこげな風に（以下仁三郎｜懐手をして鯨の身振り）」「アハハハハ……」「イヒヒヒ」「オイ仁三郎……大概にせんかコラ……」「海の上じゃけに構わん。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こげな葬式で仁三郎が成仏出来るもんじゃない。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "腑に落ちぬにも何も、あの美しい娘御が……コ……こげな恐ろしい事になろうとは……事もあろうに胴切りの真二つなぞと……」　和尚の眼に初めて涙らしいものが湧いて来た。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは疑いもない向う鉢巻を致しました証跡で……つまり丁半や花札を引きまする場合には、男でも鬢の乱れを止めるために幅広う鉢巻を致しまする者が多いので、博奕打の朝髪と申しまするのはこげな髪の乱れを隠すために、綺麗に手を入れるからで御座りまする。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "何はともあれトックにも御見舞い伺わねばならぬ処へ、こげな御念の入りました御挨拶を受けましては、床の下へ這い込みたいくらいで……生憎、床の下が御座いませんが……」　半三郎は静かに顔を上げた。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "こげな歌……」「知らんかなあ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこげな山の中の素寒貧村には過ぎた学士様じゃ。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こげな式の時には見送りに立たぬものと昔からなっとるが、今の若い者は流儀が違うでのう。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしとはいわず、あたくしと、はやりどおりにいうこの女性は、どうしてこんなに賢こげな言葉をつらねてすべてまともであるべき問題を、はぐらかし、銀色に光っているとすれば、それは不潔のうちに棲息するなめくじの這い跡のようでなくてはならないのだろう。",
              "citation": {
                "source": "傷だらけの足",
                "author": "――ふたたび純潔について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こまやかに脂肪をひそめて光芒を放つような乳白色の皮膚、又は、非常にうすくて、さわると冷たそうで、滑らかで、賢こげなやっぱり白い皮膚。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人の行雄と云えば、戦争中、利益にありつく動きかたをする気がなかった通り、事情が急変したからと云って、急にどうという賢こげな動きかたもしなかった。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　兄はちよつと千種に笑ひかけた後、「こげな別嬪ひやんなら、なんも云ふこたなかつて云つたよ」「千種さん、今のおわかりになる？",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴見は、そこに、はからずも、畏しこげな御影を仰ぎ見たのである。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これだけの戦争をして、こげな屈辱外交をされたんじゃあ、国民が黙って居られるもんか。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしが甲斐性なしだもんで、玉井をこげな目に逢わせることになったとですよ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれの親父が、やっぱ、喧嘩で、こげな目に逢うたことがあるけん。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "角助の馬鹿たれ奴、バクチで、小倉監獄にかまうちょったけ、ええ厄介払いが出来たと思うとったのに、いつ出て来やがったのか、玉井さんにこげなことをしちょる。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤ン坊は色が白く、近所の人たちが、「ゴンゾの子に、よう、こげな可愛い子が出来たもんじゃ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「三十年近くになります」「それくらいにはなろうなあ、おれが、こげな、よぼよぼ爺になっちょるけ」「あたしも、こんなお婆さんになってしもうて……」　二人は顔見あわせて笑ったが、マンの眼には、うっすらと光るものがあった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
