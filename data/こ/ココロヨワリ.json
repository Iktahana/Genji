          "literary": [
            {
              "text": "自らその罪を責めて、甘んじて享くべき縲紲を、お鶴のために心弱り、獄の暗よりむしろつらい、身を暗黒に葬ったのを、秘に知るは夫人のみ。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "御身此頃、俄かに心弱り給へるは、左様の由無き事ども思ひ続け給へる故ぞかし。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
