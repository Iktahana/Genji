          "standard": [],
          "literary": [
            {
              "text": "そこで小熊座にあるという出版社は、この本を電子化して出すことに決めました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "出版元は、小熊座の会社ではありません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「進路は小熊座の北極星、出航始めッ」　ついに蜂谷艇長は、出発命令を下した。",
              "citation": {
                "source": "月世界探険記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時分、駒井は天体のある部分――たとえば大熊座と小熊座の間のあたりに、何か異状を認めたらしく――望遠鏡に吸いつけられて、茂太郎の歌も聞えない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
