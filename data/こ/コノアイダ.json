[
  {
    "uuid": "2f9637ef-8dbe-504d-b7ad-b31f8bf1fc91",
    "entry": "この間",
    "reading": {
      "primary": "このあいだ",
      "alternatives": [
        "このかん"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
