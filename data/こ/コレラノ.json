        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "博士ハ魏志文ヲ引クニ、伊都國ヨリ邪馬臺マデノ行程ヲバ略カレタレドモ、コレラノ行程ハ、國々ノ位置ヲ求ムルニ必要ナル者ナレバ、多少ノ誤謬ハ免レズトモ、全クハ棄ツベキ者ニアラズ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレラノ作アル所以ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレラノ婦人達ハ実際ニハ善良ナ婦人ナノカモ知レナイガ、モシ本当ニ悪人デアリ、ソレト同棲―――ハ出来ナイマデモ、セメテ身近ニ住ミ、接近スルコトガ出来タラドンナニ幸福デアロウカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレラノコトモ当時ノ日記ニ委シク書イタ筈デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシテモコレラノ二ツガ同ジ種類ノ生物ノモノトハ信ジラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
