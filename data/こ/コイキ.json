[
  {
    "uuid": "4ee41295-5ba8-55ec-945a-f7888b42c5a5",
    "entry": "小粋",
    "reading": {
      "primary": "こいき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
