        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ボーイが御茶を上げましょと云うて来たから室へはいると、前の商人はあわてて席を譲って「ドーゾコチラヘ」と言う。",
              "citation": {
                "source": "高知がえり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンドノ土ヨウ日ニ小サイオヂサント、コチラヘオイデ。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コチラヘキタアスユク』　シズオカ局發である。",
              "citation": {
                "source": "樹木とその葉",
                "author": "地震日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "「起キテコチラヘ来テ立ッテ戴キマショウ、ソノ方ガ注射シ易ウゴザイマス」「承知シマシタ」予ハ寝台ヲ下リ、特ニ勇マシク、シッカリシタ足ドリデ博士ノ立ッテイル明ルイ窓際ノ方ヘ歩ヲ運ビ、博士ト向イアッテ立ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレナラバナゼ抽出ニ鍵ヲ懸ケタリマタソノ鍵ヲアチラコチラヘ隠シタリシタノカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウゾ、コチラヘ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士邸のげんかんには、れいの黒んぼうの自動人形が待ちかまえていて、「ドウゾ、コチラヘ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妹より兄へ）　ウルシド、シンダ、サジ、ケイサツヘツレテユカレタ、コチラヘコラレヌカ。",
              "citation": {
                "source": "偽悪病患者",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
