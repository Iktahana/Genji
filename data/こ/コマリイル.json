          "literary": [
            {
              "text": "寒い、気分が重い、ぼんやりして道を横ぎらうとして、あはや自動車に轢かれんとした、危いことだつた、もつともそのまゝ死んでしまへば却つてよかつたのだが、半死半生では全く以て困り入る。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿の御性急には困り入る。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あれを売られては困り入る。",
              "citation": {
                "source": "鍋島甲斐守",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけて室のお局に侍く女たちが手不足で困り入る」　ということを、亘が老臣の口から聞いていたので、渡りに舟として、それへお菊をすすめた結果であった。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
