[
  {
    "uuid": "684a15de-9903-5cf3-bf03-d57c3d0c2a7f",
    "entry": "今度",
    "reading": {
      "primary": "こんど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "副詞"
      ],
