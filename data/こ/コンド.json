      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "this time",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「今度の旅行は北海道に行こう」と家族で話し合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今度こそ、試験に合格してみせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今度の週末は、久しぶりに家でゆっくり過ごすつもりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "此の我々の感性に近いもの、寧ろ民謡でさへある殉情詩が、此の殉情的な国で、今迄読まれなかつたなぞといふことは不思議だと、今度此の全集の第一巻が出た後では、諸君も必ずやさうお思ひになることと思ひます。",
              "citation": {
                "source": "宮沢賢治全集刊行に際して",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度出来て来た詩集をみると「浚渫船」とある。",
              "citation": {
                "source": "詩集　浚渫船",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今度はじめてさういふ気持を味はつた。",
              "citation": {
                "source": "詩壇への抱負",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、今度偶然にも、自分の無力をすつかり感じ、その時から、次第に、詩といふものゝ真義も分つて来るやうに思へ出した。",
              "citation": {
                "source": "詩壇への抱負",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "正直に云つて、だから辻野君の印象は私の中で、結局稀薄なものであつたのだが、今度訃報が来た時には、ハツと思つた。",
              "citation": {
                "source": "逝ける辻野君",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　右には文学だけを中心に話したのだが、人には文学だけではなく、生計といふこともあるから、今度はその生計を中心に話を進めてみよう。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶々今度は、「欲しいのは金よりも時間だよ」とＢが力説する。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本飲み終つた頃、また後から一人来た、今度は先のよりは少し綺麗、デツプリ太つて自信がおありだ。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに私だつて今度の事は彼に従はないでもないのだ。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度の事はその美事にやれさうな方の事のやうに思へるのだ。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度の此の家だつて、後で叔母の云ふ所によると、信者が家主であるさうで、その家主老夫婦が自分達の隠居のために建てたんださうで、値段に比べたら却々立派な家である。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "たつたそれつぽつちのものが無暗に異様に思ひ出されて、その後それはどうなつたか、今でも物置小屋の隅でも探せば抛り込んであるのではないか、さしあたり今度帰省した時には、母にでも訊いてみようと、突嗟には思つたりする、――が、なに、それほど殊勝でもなんでもない。",
              "citation": {
                "source": "一つの境涯",
                "author": "――世の母びと達に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんよが出来出す一寸前頃は、一寸の油断もならないので、行李の蓋底におしめを沢山敷いて、その中に入れといたものだが、するとそのおしめを一枚々々、行李の外へ出して、それを全部出し終ると、今度はまたそれを一枚々々、行李の中へ入れたものだよ。",
              "citation": {
                "source": "一つの境涯",
                "author": "――世の母びと達に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――あゝら、ぢやあたしコヽアの方が好いんだけれど今度来る時は紅茶の方買つて来るわ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "…………男　ぢや今度は俺も神剣だよ、さあ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "度々のことで面倒だから、今度から止めにして、先へ勝手に寝ることにしろと何度も言うが、妻は婦道に背くと言い、なかなか承知しないので困っている云々（大意）と。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "12　數日後、今度は自分の方から芥川君を訪ねて行つた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕は馬場さんを信じています」「はあ、そうですか」私の精一ぱいの言葉を、なんの表情もなく聞き流して、「今度の雑誌のことだって、僕は徹頭徹尾、信じていません。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに今度は、いよいよ令嬢の出現だ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとなると、今度はそのことは詩人にとつて辛いのである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」さう云つて今度は頭をのぞけた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "西日が後れ毛の少し垂れ下つたのを透してるそれをみると――「さあ云へ」――今度は医者の方がセカセカした。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、出しますよ、今度は出る、――揺らずにヂツと――さう／＼／＼……」彼は母親の肩に手を掛けて自分が仕事のしよい位置を取らせた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "両足を拡げ、反射鏡に手をかけると、今度こそ本調子に赤坊の口中を睨み込んだ。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だから今度田中さんが、その家には子供も大勢だし、誰も世話する者がないから自分が世話をしに、満洲のその家に世話に行くんだつて。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度はおまへの番だよ」つて眼で。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何気なしに今度××歌劇に投書しようと思つて書いた原稿を出して中程から読み始めた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハヽヽ、君はまだ前以上に、今度は大きい意味でこだはつたのだよ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「今度這入つて来た細つそりした女ねえ、横着なのよ。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さうか、今度の中にはおまへがをつたといふのか。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
