          "literary": [
            {
              "text": "「デ・モトゥ・コルディス」は医学の歴史において独特な一編の著作である。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "この問題についてのハーヴィの立場に疑問を持つ人たちには「デ・モトゥ・コルディス」そのものを読み次にアリストテレスからヴェサリウスに至るまでの循環に関係する部分を読むように勧める。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリ大学は「デ・モトゥ・コルディス」が出現した後で半世紀以上も血液循環に反対していた。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デ・モトゥ・コルディス」は近代の精神が古い慣習と最終的に分離することを示している。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
