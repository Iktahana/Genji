        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本帝国　東京　大関久五郎　地理学を修むる者　此宿ノ人ノ話ニ拠レバ、コレ迄吾日本帝国民ニシテコヽニ泊ッテ Jungfrau ニ登ツタ人ハ無イトノコトデス、本当カウソカハ私ハ知リマセンガ、兎ニ角コヽニ吾邦人ニシテコノ後コヽニ来リ宿ル方ニ対シ御免ヲ蒙ツテ私ノ名ヲ日本語デ書イテ置キマス。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言スレバ、諸君ハ知ラズ識ラズコヽニ永代不滅ノ資産ヲ確立スルコトヽナルノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、私ハコヽニヰナケレバナリマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ亜米利加合衆国ノ名代人タル我輩、其論説ノ正否ヲ世界中ノ公評ニ質サンガ為メ、コヽニ会同シテ、州内良民ノ名ニ代リ州内良民ノ権ヲ藉リ、謹テ次件ヲ布告ス。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根川ノ西岸ヨリ山東ヲ繞テ越後国ヘノ山道アリ、コヽニ謙信馬返シ岩ト云アリ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困ッタナ、僕ハトウニ食ベチャッタンデ、梅肉ヲ下ゲテ行ッチャッタンダ」「梅肉ダッテコヽニアルワ」ト、颯子ハ鱧ト一緒ニ自分ノ梅肉ヲ廻シテヨコシナガラ、「梅肉ダケ別ニ取リマショウカ」「ソレニハ及バナイ、コレデ結構」颯子ハタッタ二片ダケシカ食ベナイノニ、梅肉ガワリニ穢ラシク喰イ荒サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽニ鮎ノ腸モ取ットキマシタヨ」ト、婆サンガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヽニ同程度ニ美シイ、同程度ニ予ノ趣味ニ叶ッタ異性ガ二人イルトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハコノコトヲ少シ委シク書キ留メル必要ガ起ッタノデ、モウ一度コヽニ記ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手デコヽニ掴マッテラッシャイ」ソウ云ッテ彼女ハ左肩ヲ差出シタ、ステッキハ自分ガ受ケ取ッテ、萩ノ枝ヲ拂イ除ケナガラ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテソウ云ウ或ル一日ノ印象ガ、コヽニ蘇ッタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ノ奴、イツマデコヽニイヤガルンダ、サッサト二階ヘ行ッチマヤガレ、糞忌マ／＼シイ！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日一日ダケコヽニ入院シタ形式ニシテアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「佐々木ト二人ジャ心細イカラ、颯子ニ附キ合ッテ貰オウカ」予ノ京都行キノ主タル目的ハ実ハコヽニアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "城山家ハモト吉田山ニ住ンデオリ、当時ハシバ／＼来往シタ覚エガアルガ、主人桑造ノ死後遺族ガコヽニ移ッテカラハメッタニ訪ネナイヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、コヽニアノ爺サンノ墓ガアッタッケナ」ト、通リスガリニ立チ寄ッテ線香ノ一本モ手向ケテクレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヽニ決メテヨカッタト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ、コヽニ又一ツ別ナ考エガ予ノ胸ニアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ爺サンハ発狂シテルノデハナイカト、思ワレルダケデモ極マリガ悪イ）予ハコヽマデ思イ詰メテ、コヽニ一ツノ可能ナ方法ガアルカモ知レナイコトニ気ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食堂ヘ行カナイデモイヽジャナイカ、コヽニ鮨ガコンナニ残ッテル、コヽデコレヲ食ベナサイ」「ソウ、デハソウスルワ」「君ト鱧ヲ食ベルノハ浜作以来ダナ」「ソウダッタワネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽニアルコノ綿ノ丸ネ、コレハタンポト云ウモノナンダヨ」「何スルモノナノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヽニ於イテ予ハ、颯子ニ異存ガナイバカリカ、少クトモソレヲ面白ガル気持ガアルコトヲ認メタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
