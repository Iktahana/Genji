        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "指先に触つたのは煙草では無くて、矢張その頃の文士の一人フランソア・コツペエの詩集であつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者は先刻友達に出会つた時、コツペエの詩集を読みさしの儘、ポケツトに入れた事に気が注いた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその頃コツペエが風邪か何かで臥つてゐるのを思ひ出すと、覚えず小躍りして叫んだ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さうだ、コツペエさんの御厄介にならう。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして受附の男を見ると急に悲しさうな顔をして、「フランソア・コツペエが亡くなりました。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにコツペエが亡くなつたつて。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツペエさんはお風邪のやうには聞きましたが、お生命に別条は御座いません。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里をフランソア・コツペが書き、東京をピエル・ロチが書いて居た。",
              "citation": {
                "source": "一國の首都",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツペが巴里を書いたのも、この巴里風の純粹のフランス文で、美術の都を描いたのが面白いと思つたので覺えてゐる。",
              "citation": {
                "source": "一國の首都",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で本家本元と言つても好いフランス文学ではバルザツクあたりにその萠芽を発して、アルフオンス・ドウデエ、フランソア・コツペイ、ゾラ、それからモウパツサンの巨匠へと行つた。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　とコツペ・パンのやうな腕を突き出して詰め寄つた。",
              "citation": {
                "source": "日本橋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして街から届いてゐたコツペ・パンの棒と、一本の蜂ブドウ酒とを携へて納屋裏へ愛馬の厩を訪ねた。",
              "citation": {
                "source": "夜見の巻",
                "author": "「吾が昆虫採集記」の一節",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶衆客皆杯を挙げて主人の健康を祝するや、ユウゴオ傍なるフランソア・コツペエを顧みて云ふやう、「今この席上なる二詩人｜迭に健康を祝さんとす。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "意コツペエが為に乾杯せんとするにあり。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツペエ辞して云ふ、「否、否、座間詩人は唯｜一人あるのみ」と。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "意コツペエが言を翻しておのが仰損を示せるなり。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "よごれた上衣、古づぼん、血に染むやうな赤ちよつき、コツペが書いた詩の中の人を殺した老鍛冶が法官達の居ならんだ前に引かれる痛ましさ、足の運びもよろよろと……おお、ムネ・シユリイ、見るからに老優の芸の偉大さよ。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソワ、コツペーの『涙』と云ふ悲慘な詩を知つてゐるかね。",
              "citation": {
                "source": "歡樂",
                "author": "永井壯吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
