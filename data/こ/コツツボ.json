        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "葬儀の後、遺骨は骨壷に納められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "美しい絵付けがされた、年代物の骨壷が残されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この骨壷、おばあちゃんの形見なんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "秋子は押入の中の骨壷にに」］、清浄な灰となってはいっていた。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "音もしないですうっと襖が開いて、白い布がはらりと解け、白木の箱や骨壷がが」］まざまざと見えてきた。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち上って押入へ歩み寄り、骨壷をを」］開いて、中の白いやつを歯でかじった。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も居ないのを見定めて骨壷をを」］しまった。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「屹度あの骨壷がが」］いけないんですよ。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな所へ骨壷をを」］お置きなすって、どうなさるおつもりなんでしょう？",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨壷はは」］ちゃんと元の位置に在った。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい方の箱の書物を投り出して、その後へ骨壷をを」］しまった。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい骨壷をを」］しまったよ。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「土台、わしが死んだと誰がそんなばかげたことをいうたかしらんが、それをまた真に受けるお母さんもお母さんじゃ」　そんなこというたって現在お前の嫁のきみ子が、お前の骨壷を抱いて戻ってきて、私の膝に泣きくずれた。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
