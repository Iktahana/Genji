        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おまけに持つて生れた好古癖にまかせて、折角考証に考証を重ねて、在来のままの経籍とは違つたところのある異本を公にして、学界に寄与しようとすると、世間の人達は碌すつぽそれを読みもしないで、「あれは偽書ださうだよ。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は復古癖の人のように、徒らに言語の純粋性を主張して、強いて古き言語や語法によって今日の思想を言い表そうとするものに同意することはできない。",
              "citation": {
                "source": "国語の自在性",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "考古癖の夜光命が妙雲寺を間却せるは、不思議に非ずや。",
              "citation": {
                "source": "鹽原新七不思議",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は松火を振り立てながら、自分の考古癖に誘われて、石棺の方へ近寄って行った。",
              "citation": {
                "source": "木乃伊の耳飾",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それより立寄つた旅順博物館には、予が近年の考古癖を刺激する物が多く、少くも五六度の訪問を要する所を僅かに三十分の瞥見に終つたのは、予の学的良心を頗る痛ましめるのであつた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "近来煎茶家ノ好古癖有ル者、皆朱泥ヲ品賞シ、其ノ形ヲ論ズル極メテ喧シ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ／＼の古語・死語をば復活せしめようと努めるのは、単なる憬古癖を満足せしめる為にするのだと思うてはならぬ。",
              "citation": {
                "source": "古語復活論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "寿永だ、寿永だ、寿永にして措け、と寿永で納まって居ると、ある時｜好古癖の甥が来て寿永じゃありません宝永ですと云うた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "室町時代に於て見る四脚門のような形をして、古色もたいていそれに叶っているから、好古癖のあるお銀様でも来て見れば案外の掘出物を見つけるかも知れないが、米友には、少し変った門だなと思っただけのものでした。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "早手は急ピッチを変えず、島も大船も見えずなり、それにまたもや一陣の霧が、一むれ襲うて来たものですから、四辺は煙波浩渺たり、不破の関守氏の懐古癖が充分に昂上を見たと覚えて、大船の――かとりの海にいかりおろしいかなる人か物思はざらむ――　朗々たる名調子で、一種独得の朗詠が湖上の上に漂いました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お角さんには、お銀様の考古癖が全くわからないのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "畜生谷の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "気早の人｜紊にわれらを以て好古癖に捉はるるものとなす莫れ。",
              "citation": {
                "source": "一夕",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは徒らに感傷的な懐古癖からではゆめ／＼ない。",
              "citation": {
                "source": "寄席風流",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに數年前の正月清野君の家で、赤星青年と二人ジヤンケンを以て石鏃を分配し、私も二本ばかりを勝ち得たので、自分の家に歸つてから子供等に、ジヤンケンで頒けてやらうと云つても、一向欲しがらぬのには拍子拔けがしたと同時に、私の家に私同樣の考古癖者が居ないのに安心したことである。",
              "citation": {
                "source": "石鏃の思出話",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "思へば不思議な因縁であるが、しかし元来好古癖のある私は少青年時代から京阪の地に一種の憧れを抱いてゐたことは事実である。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クライスラーを採るのは一種の懐古癖だと思う人は、メニューインの若さを買うがよい。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "懐古癖緑波、古いこと幼い頃のことを書いてると実に味がある、と自ら思った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のマイクぎらひも悪くすると、サイレント映画を恋しがる、例の懐古癖のあらはれとなるのではなからうか。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
