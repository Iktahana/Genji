        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どうも恐ろしく犬ばかり集めたもんだと思ったが、よく見るとドレモコレモ見覚えのある犬ばかりだ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレモ　ユリコサン　ニアケマス　オトウサマカ　ナニヲシテ　イマスカ　オカアサマニ　オキキナサイ　オカシイデショウ　　　〇六・三・二六」　ロンドンから母宛に来た手紙の中に封じこめられたものであったのでしょう。",
              "citation": {
                "source": "写真に添えて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ、とあるのだから、きっと何かほかにも私にくれたものがあったのでしょうが、それが何であったか思い出せず、残念に思われます。",
              "citation": {
                "source": "写真に添えて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "穴　　　　　　　　５　　青四郎　　コレモ曲者５　　　　　　　６　　小林米紀　本命。",
              "citation": {
                "source": "安吾巷談",
                "author": "今日われ競輪す",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハコレモワザトデハナイカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ意味ガナクハナイヨウニ予ニハ取レル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ一種ノ嗜虐的傾向ト云エバ云エヨウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バッタリ婆サント出会ッタノデ、コレモ特別ニ馬鹿丁寧ナオ辞儀ヲシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ去年大改造ヲ施シ、水槽カラ何カラ何マデタイル張リニシ、シャワーノ設備ヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハ、浴槽ハ木製ニ限ル、タイルデハ冷メ易ク、冬ハツメタクテイケナイト云ウ説デアッタガ、コレモ颯子ノサジェッションニ従ッテ（婆サンニハ颯子ノ意見ト云ウコトヲ内證ニシテ）タイルニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ三十分ニ延ビテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ハ二日ニ関西方面ヘ出カケ、六日ニ帰京シテ七日ノ日曜カラ約十日間、コレモ軽井沢ニ行クト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "足気狂イノオ爺チャンニハ、コレモ魅力ジャナイ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浴室ハ「婆サンノ便利ノタメ」ト称シテ純日本式ノ木製ノモノヲ、コレモ別ニ婆サンノ寝室ニ隣接サセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外デハアンマリアンナ真似ハナサイマセン、旦那ガ御覧ニナッテイラッシャル時ニヨクアンナ真似ヲナサルンデス」ト野村ハ云ウガ、ソウダトスレバ、コレモ予ヲ揶揄スル積リナノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「吸イタクモナイケド、コレモアクセサリーノ一種ネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モヒデハナイガコレモ一種ノ麻薬デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デナケレバ綴喜郡宇治田原村禅定寺ノ五輪塔、コレハ吉野時代ノ典型的ナ遺品ダソウデ、コノ式ハ南方ノ大和文化圏ニ流行シタモノダソウダガ、コレモ悪クナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ川勝氏ノ著書ニ上京区紫野今宮町ノ今宮神社ノ線彫四面石佛ト云ウモノヲ載セテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ、ワタシノホシデ、コシラエタノデス。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
