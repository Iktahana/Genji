          "literary": [
            {
              "text": "以上デ私ノ言イ分ハホボ尽キタワケデアルガ、シカシコノヨウナコトヲ書イタカラトイツテ私ガカタカナ運動デモ開始シタヨウニ思ワレテハ迷惑デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ノ亡クナッタ昭和三年カラ数エテ三十三年後ニ、忰ガコノヨウナ狂人ニナリ、コノヨウナ嫁ガ我ガ家ニ入リ込ムニ至ッタコトヲ、夢ニモ考エタヾロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来レバ颯子ノ容貌姿体ヲコノヨウナ菩薩像ニ刻マセテ密カニ観音カ勢至ニ擬シ、ソレヲ予ノ墓石ニスル訳ニハ行カナイモノカト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
