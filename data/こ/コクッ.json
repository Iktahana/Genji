          "literary": [
            {
              "text": "先生はそれを別段気にかけるでもないらしく、コクッと呑んでしまって云いました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "松倉さんが黙りコクッて御座る処を見ると、一文にもならぬかも知れぬ」「呆れたなあ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "隅ッこに、そのままに積み重ねてある夜具蒲団の上から、鶏がコクッ、コクッと四囲を見廻わしながら下りて来た。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "布袋和尚のような原田雲井は、近眼鏡の奥から、細い眼で、眼前の青年の苦渋のありさまを、じっと見ていたが、コクッと、首の骨が鳴るほど、ひとつ、大きく、うなずいた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
