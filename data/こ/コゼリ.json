        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "絶えまない軍閥の小ぜり合いと、騒乱の連続は、その暗示をなお力強いものにした。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小ぜり合いは、おさまってしまった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの小さい小ぜりあひ、いがみあひ、絶望が生んだ蛮性。",
              "citation": {
                "source": "計画",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの小さい小ぜりあひ、いがみあひ、絶望が生んだ蠻性。",
              "citation": {
                "source": "計畫",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間に火のような夫人のひとみと、皮肉に落ち付き払った葉子のひとみとが、ぱったり出っくわして小ぜり合いをしたが、また同時に蹴返すように離れて事務長のほうに振り向けられた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵と対陣して小ぜりあいの絶えないようなものである。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "以後小ぜり合いが断続したが、大勢は東軍に有利である。",
              "citation": {
                "source": "応仁の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとさわったばかりじゃないか――」　お徳と三郎の間には、こんな小ぜり合いが絶えなかちった。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとさわったばかりじゃないか――」　お徳と三郎の間には、こんな小ぜり合いが絶えなかった。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが今後とも小ぜりあいはあろう。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり腕を組み合わせ、一生懸命な眉をあげて歌いつつ、それらの人々は時々警官と小ぜり合いしながら進んで行くのであった。",
              "citation": {
                "source": "メーデーに歌う",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の国境あらそいで、世界一の陸空軍国であるＳ国と小ぜりあいをしているって聞いてはいましたが、……いよいよ宣戦布告をして戦争でも始めたのですか」「さあ、何ともいえないが、とにかく穏かならぬ雲行だ。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "五反田の裏通では、闇の中に、防護団の少年と住民との間に、小ぜりあいが始まっていた。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜討ちなどということは、お前などの仲間の二十｜騎か三十｜騎でやるけんか同様の小ぜりあいならば知らぬこと、恐れ多くも天皇と上皇のお争いから、源氏と平家が敵味方に分かれて力くらべをしようという大いくさだ。",
              "citation": {
                "source": "鎮西八郎",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう汽車の中に、小母さまとＴさんが向いあいに席をとり、睦じいような、そうかと思うと小ぜり合いをしてフッと両方で気分のはぐれるような調子で発車を待っている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――○――　感情的な小ぜり合いの後、何で和解するのかと思う反省は、彼女を懐疑にしずませ、躊躇させた。",
              "citation": {
                "source": "日記",
                "author": "一九二〇年（大正九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "基督救世主寺院の大理石のいしだたみの上では群集のうちに小ぜり合いがあった。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻はいろんなものに手を出す子供をちよいちよい叱る子供も負けて居無いで小ぜり合ひをやる日は暖に天井で笑ひ室内に一杯になる（十一月二十日）夕暮夕暮、日はもう沈んで足の踏み場も無く亂雜な地上となる。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "離島方面では、島々の小ぜり合いに、こうした神意の戦争が、近年までくり返されていたことと思われる。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "離島方面では、島々の小ぜり合ひに、かうした神意の戦争が、近年までくり返されて居た事と思はれる。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾妻橋は一つの関門で、本所一円の旗本御家人が彰義隊に加勢をする恐れがあるので、此所へ官軍の一隊が固めていたのと、彰義隊の一部が落ちて来たためちょっと小ぜり合いがある。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "上野戦争当時のことなど",
                "note": "青空文庫"
              }
            },
            {
              "text": "先に出獄した山口義三を上野驛に迎へた吾々は同驛前で警官隊と小ぜり合ひをしました。",
              "citation": {
                "source": "浪",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある人たちのいうのには、これはヘッセからアメリカに渡った騎兵の幽霊であり、独立戦争のとき、どこかの小ぜりあいで、大砲の弾丸に頭をうちとばされたもので、ときたま村の人たちが見かけるときには、夜の闇のなかを疾走し、あたかも風の翼に乗っているようだということだ。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩や平手をぶつけ合う小ぜりあいが、さらにはじまった。",
              "citation": {
                "source": "なぐり合い",
                "author": "WIE JAPPE UND DO ESCOBAR SICH PRUGELTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、ひんぴんとして起る小ぜりあいの場合に、勝ち目は大抵農民の側にあったからである。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちこちにおける部下と賊兵の小ぜり合いは、らちゃくちゃもない。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天機と人　この冬中、国境の小ぜりあいはやや小康を得たかに見えたが、それはかえって大きな動きを取る時の力の準備期であった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "薑ヶ原では、先鋒隊と先鋒隊とのあいだに、二、三度、小ぜり合いがあっただけである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜来、折々湿っぽい小銃音の小ぜり合いはしていたが、このときのものは、「すわ！",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
