        "examples": {
          "standard": [
            {
              "text": "アイロンの温度を上げすぎて、大切にしていたシャツに焦げ跡をつけてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い机の端に、かつて誰かが置いたタバコの小さな焦げ跡が残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "火事の現場には、黒々と焼け焦げた柱や家具の焦げ跡が生々しく残っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "――あの板の、焦げ跡と白っぽい斑点とが不審だった。",
              "citation": {
                "source": "白血球",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどは　こげあとが　「タベテ」って　ことばに　なってて。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
