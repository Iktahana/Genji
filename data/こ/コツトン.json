          "literary": [
            {
              "text": "是程精工業に巧妙な者が今日コツトンに於て天下有數の地位を得たからと云つて少しも不思議はない。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、不思議なことに、そのベツドが少しづゝ、コツトン、コツトンと窓の方へ動き初めました。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠い水車の音が、コツトン、コツトン、コツトン、と野面を渡つてひびいて来た。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            }
          ]
        }
