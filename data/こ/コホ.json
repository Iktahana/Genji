    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こまかき雨ははら／＼と音して草村がくれ鳴こほろぎのふしをも乱さず、風｜一しきり颯と降くるは、あの葉にばかり懸るかといたまし。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ秋ふかみなめいしにこほろぎ鳴きええてるは玻璃をやぶれど再會のくちづけかたく凍りてふんすゐはみ空のすみにかすかなり。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こほる月にむせぶか千千の草の花。",
              "citation": {
                "source": "短歌",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬を待つひと萩原朔太郎こほれる利根のみなかみに、ひねもす銀の針を垂れ、しづかに水に針を垂れ、さしぐみきたる冬を待つ。",
              "citation": {
                "source": "冬を待つひと",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィンランド語の kuura（霜）は日本の「こほり」の音便読みに近い。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここほどけっこうな所はないと御主人様は思召すふうでしたが、東国ではこんな薫香を合わせてお作りになることはできませんでしたね。",
              "citation": {
                "source": "源氏物語",
                "author": "宿り木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここほんの暫くの間に、目立つて頭髮が白さを増したやうですが、健康です。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かなる精舎の庭にほのめきいでて紅の戦慄に盲ひたる※オロンの響はわが内心の旋律にして、赤き絶叫のなかにほのかに啼けるこほろぎの音はこれ亦わが情緒の一絃によりて密かに奏でらるる愁也。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十年十二月　　こほろぎ微にいまこほろぎ啼ける。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのなかにこほろぎ啼ける。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "微になほこほろぎ啼ける。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気は苦し……はや暗し……黄に……なほ青く……四十一年九月　　風のあと夕日はなやかに、こほろぎ啼く。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれ、ひと日、木の葉ちらし吹き荒みたる風も落ちて、夕日はなやかに、こほろぎ啼く。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあたり、だらだらの坂、赤楊高き小学校の柵尽きて、下は黍畑こほろぎぞ闇に鳴くなる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "こほろぎもすすりなけり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑道やうねり道こほろぎはこほろころ、やつこらさつさ、やつこらさ、やれ、蜻蛉が飛んだ、火が飛んだ。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあたり、だらだらの坂赤楊高き小学校の柵尽きて、下は黍畑こほろぎぞ闇に鳴くなる。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯ぞともる、支那｜床の玻璃に人見え、あかあかと末広に光凍れば、古煉瓦うづだかき原のくまぐま、ほそぼそとこほろぎの鳴く音洩れぬる。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "凍みこほる白き華、今朝、現なし。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "雀と雪陽は薄し、庭の雪、凍みこほり、こはばりぬ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちちら、ちち空のこゑ、まだ辛し、春は来ず、匂ひだつ畦の土、また、今朝は凍みこほりぬ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤がふります、灯のしたをこほろぎのやうに歩く煤。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾が秋まだ青いのは松笠、こんこ小松のしたぐさ、秋はただつかまへて見て、日に透かすこほろぎの黝朱いろです。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく在りて趺坐し一夜をありけらしその縁の端と思ふに我は天心居夜情岩の端にことりともこの家音せぬは人｜坐さぬらしすさぶ夜の潮潮ひびく君が館の跡どころ小夜ふけて聴くに磯は直ぐ下草塚にこもるこほろぎ潮騒のとどろ立つ夜を鋭声しきりに註、天心先生の墓あり。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
