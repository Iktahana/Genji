          "literary": [
            {
              "text": "男は座りながら、おびえた目でその告発人をじっと見つめる。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女及び告発人の宣誓証言を含む黄変した州紀は人間の経験の埒外にある事物について忌々しい迄に示唆的であり――彼女の使い魔として働く、毛皮を纏った小さく俊敏な物体についての信じ難いほど詳細に及ぶ記述は苦痛を覚えるくらいに現実的だった。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかさま告発人ですかい」　こう言って、アメリカ人の眼前で指を鳴らした。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
