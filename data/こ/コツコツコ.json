        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……大方眠りつこうとしていると、不意に土間の隅に設けてある鶏舎のミノルカがコツコツコと騒ぎだした。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仔牛はコツコツコツコツと葡萄のたねをかみ砕いてゐました。",
              "citation": {
                "source": "黒ぶだう",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "淋い、森とした中に手拍子が揃って、コツコツコツコツと、鉄槌の音のするのは、この小屋に並んだ、一棟、同一材木｜納屋の中で、三個の石屋が、石を鑿るのである。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白、コツコツコツ、白、白、コツコツ、ピー。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしきた、やっつけで、暗いうちからコツコツコツコツコツ、なにしろ、切り込みでも容易なこっちゃねえんで、やっと用意が出来て、さあいつでも来やがれとなったところで、たった八人、それもあまりものの。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツコツコツコツコツ……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツコツコツ……コトコトコトコト……コツンコツンコツンコツン……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……コツコツ……コツコツコツ……　とノックする音……。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして又ドクドクドク……コツコツコツコツと静まって行った。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その時、彼の寝ている厚い石畳の真下に当たって、コツコツコツコツと音がした。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツコツコツコツとその音は、次第次第に高くなったが、ザーッと土でも崩れるような騒がしい音が聞こえたとたん、グラグラと、石畳は左右に揺れ、そのままドーンと下へ落ちた。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の若者は、前後をソッと見廻した後で、潜り戸の上をコツコツコツと三つ叩いた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツコツコツコツ、玉太郎は信号を送る。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の奉行が聞いて呆れるよ」塩田の忠蔵身の上話　コツコツコツコツと部屋の襖を窃と指で打つ者がある。",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツコツコツコツと叫ぶのは餌を漁っている夜鷹であって、ギャッ――と鋭く喚くのは敵に襲われた鵜烏である。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツコツコツ、コツコツコツ、鸚鵡が煎餅をつつく音！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラコロ　カラコロ　冬の夜更けの下駄の音　コツコツコツ　石屋の職人　カチツカチツ　高天ヶ原　ポカポカポカ　あやまつた　あやまつた「二百みツつう、二百むツつう…………」　湯上りの　お神さんの銀煙管が　キラキラキラ　モールス符号　――ざ……ま……み……ろ……　タッチ……占めた。",
              "citation": {
                "source": "玉突の賦",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
