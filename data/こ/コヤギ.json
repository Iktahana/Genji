    "definitions": [
      {
        "index": 1,
        "gloss": "kid",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "牧場で生まれたばかりの子ヤギが、お母さんの後をトコトコと追いかけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "子ヤギの愛くるしい仕草を見ていたら、嫌なことも全部忘れてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "柵の中から子ヤギが顔を出して、私の服の裾をハムハムと噛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "このおかあさんヤギには、かわいい子ヤギが七ひきありました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかあさんヤギは、ちょうど人間のおかあさんがその子どもをかわいがるのとおなじように、七ひきの子ヤギたちをかわいがっていました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、七ひきの子ヤギたちをよびあつめて、こういいきかせました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　すると、子ヤギたちは、「おかあさん、だいじょうぶだよ。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、その声がしゃがれていましたので、子ヤギたちには、すぐオオカミだということがわかりました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、子ヤギたちはさけびました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを子ヤギたちが見つけて、「あけてなんかやらないよ。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、子ヤギたちはいっせいにさけびました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "子ヤギたちは、その足が白いのを見て、いまいったのはみんなほんとうのことにちがいない、と思いこみました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、時計の箱のなかにかくれていたいちばん小さい子ヤギだけは、見つからずにすみました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "このとき、おかあさんヤギが、かわいそうな子ヤギたちのことを思って、泣きかなしんだようすは、みなさんにも思いうかべることができましょう。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとう、おかあさんヤギは、いちばん下の子ヤギをつれて、泣くなく、そとへでていきました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "子ヤギはおかあさんにいいつかって、うちへかけていき、はさみと、針と、より糸とをもってきました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、おかあさんが、ひとはさみ切ったかと思うと、もうそこには、子ヤギが一ぴき頭をつきだしました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、おかあさんがずんずん切っていきますと、子ヤギたちが、あとからあとからとびだして、六ぴきとものこらずでてきました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜって、このばけものときたら、あんまりがつがつしていたものですから、子ヤギたちを、まるのまんま、のみこんでしまっていたのです。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "子ヤギたちはおかあさんの胸にだきついて、まるで、およめさんをもらうときの仕立屋さんみたいに、うれしがって、ピョンピョンはねまわりました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういわれて、七ひきの子ヤギたちは、おおいそぎで、石っころをたくさんひきずってきました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロゴロ　ガラガラ　なにがなるおれのはらんなかで　なにがなる子ヤギどもかと思ったがこんなあんばいじゃ石ころだ　それから、オオカミは泉のところまできました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "七ひきの子ヤギたちはこれを見て、そこへかけてきました。",
              "citation": {
                "source": "オオカミと七ひきの子ヤギ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　グレーテルはハンスに子ヤギを一ぴきやります。",
              "citation": {
                "source": "おりこうハンス",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は鷲が自分の領分の平原でまだ乳飲み子の白い子ヤギをくわえ取るように、悪魔的な力が自分を彼女の胸の中に運び込んで欲しいと願った。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、おおかみはまっ黒な前足を、窓のところにかけていたので、こやぎたちはそれをみつけて、「あけてはやらない。",
              "citation": {
                "source": "おおかみと七ひきのこどもやぎ",
                "author": "DER WOLF UND DIE SIEBEN JUNGEN GEISSLEIN",
                "note": "青空文庫"
              }
            },
            {
              "text": "六ぴきこやぎのなくこえか、こりゃ、そうじゃない、ごろた石、　おおかみは、こううたいました。",
              "citation": {
                "source": "おおかみと七ひきのこどもやぎ",
                "author": "DER WOLF UND DIE SIEBEN JUNGEN GEISSLEIN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
