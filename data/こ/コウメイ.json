        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「恐れ入りますが、高名をお聞かせいただけますでしょうか。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "高名の方々が多数ご出席されるとのこと、大変光栄です。",
              "citation": {
