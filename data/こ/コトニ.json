  {
    "uuid": "50c3a056-e24f-54f8-8a83-a5418cd659fe",
    "entry": "コトニ",
    "reading": {
      "primary": "ことに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "永久ニ、コレハ、許サヌコトニイタシマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "古今無双、マコトニ御神仏ノ御化身デス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、花タチノ　オドロイタ　コトニハ　ソレハ　花タチノヤウニ　キイロイ　キモノノ　カハリニ　マツシロイ　キモノヲ　キテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル　ヒ　ソノ　デンデンムシハ　タイヘンナ　コトニ　キガ　ツキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウサギハ、ソンナ　コトニハ　オカマヒ　ナシニ、ミチバタノ　クサヲ　タベテ　ヲリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレハ、イタチサンガ、オナラヲ　シタイノヲ　アマリ　ガマンシテ　ヰタノデ　コンナ　コトニ　ナツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、タイヘンナ　コトニ、コゾウサンガ　ピント　ヒゲヲ　ハヤシテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノ　カゲカラ　コノ　ヤウスヲ　ウカガツテ　ヰタ　オカアサンダヌキハ　タイヘンナ　コトニ　ナツタト、メヲ　マンマルクシテ　オドロキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地ノ國際的分配ニ於テ不法過多ナル所有者ノ存在スルコトニ革命的理論ヲ擴張セズシテハ、言論行動一瞥ノ價値ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シナガラ實ニ他ノ歐釆諸國ニ見ザル國字改良漢字廢止言文一致羅馬字採用等ノ議論百出ニ見ル如ク、國民全部ノ大苦惱ハ日本ノ言語文字ノ甚ダシク劣惡ナルコトニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ輕キ國家ノ制裁ヲ受クルコトニヨリテ、男子ハ家族ニ對スル權威ヲ失シ交友ニ於ケル信用ヲ損スル重大ナル苦痛ヲ受クルヲ以テ自ラ身ヲ愼ミ亦以テ婦人々權ノ擁護トナリ、全家族生括ノ保障ヲ加フルコトトナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ根本原因ハ日本資産家ノ侵略ガ官憲ト相結ビテ彼等ノ土地ヲ奪ヒ財産ヲ掠メテ不安ヲ生活ニ加ヘ怨恨ヲ糊口ノ資ニ結ビタルコトニ存スルヲ知ラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米國ノ十三洲獨立戰ハ其ノ始メ常ニ英兵ニ敗ラレツツ幾年ヲ經過シタル後、最キ有力ナル實力援助ヲ與ヘタル佛蘭西海軍ガ英國海軍ヲ「メーン」岬ニ決定的ニ撃破シテ陸兵輸送ヲ不可能ナラシメタルコトニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "只天寵ハコノ切開手術ニ於テ日本ノ健康體ナルコトニ在リトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "東西文明ノ融合トハ日本化シ世界化シタル亞細亞思想ヲ以テ今ノ低級ナル所謂文明國民ヲ啓蒙スルコトニ存ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシキハソコノ人ガタクサンアツマッテ、ドウニカヤッテクレルコトニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニヨルト、我国ニハ「シロウトハクロウトヲ支配ス」トイウ法則ガアルノデハナイカト思ウガマダ調ベテモミナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国ノ人タチナドモカナヲ一種類オボエレバイイコトニナレバ非常ニ助カルダロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "南はチセヌプリ、イワタヌシの山岳に圍まれ、その後方に、コトニプリ、オサツペヌプリ、サマツケヌプリの山々が流れてゐる。",
              "citation": {
                "source": "摩周湖紀行",
                "author": "――北海道の旅より――",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ探求シ、分析シ、整頓シ、再現スルコトニヨッテ、ワレワレハ自然界ノ新シキ神秘ニ触レルコトガ出来ルノデハナイカト思ウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ノ如クナルヲ以テ、芋ヲ焦焼スルコトナク（僕はいささか焦げた方が好きです）、蒸焼シ得ルノミナラズ蒸焼ヲ二回ニ順次行ウヲ以テ塩ノ浸滲ハ良好ニ行ワレ（とてもタマランです）、更ニ蓋ニ保温室ヲ設クルコトニヨリ之ヲ焼冷シトナスコトナカラシメ、常ニ保温シ得ル等ノ効果ヲ有ス。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚オ、余ハ無情ナル父親タリシコトニツイテ、彼ノ寛恕ヲ乞ウ。",
              "citation": {
                "source": "無駄骨",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "古物ヲ賞鑑スルニ於テ、内外ノ区別ヲ立ツルハ笑フ可キコトニテ、其ノ識量ノ狭隘ナルヲ奈何セン。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "時世ヲ徴シ風土ヲ察シ、工業ノ進歩如何ヲ考フル為メナレバ、泰西諸国ニハ殊ニ貴重スルコトニテ、博物館ノ如キハ観客日ニ麕集ス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノコトハ、交際上ニ於テハ毫モ論ズ可キコトニ有ラネド、尚古ノ道ニ取リテハ口惜キコトナラズヤ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "前ニモ言ヒシコトナレド、本邦ヲ始メ支那泰西ニ至ル迄、古代ノ物ハ如何程金銀ヲ惜マヌトテモ、多ク獲可キモノナラネバ、極メテ之ヲ愛護保存ス可キコトニテ、若シ放擲シ置ケバ尽ク外人ニ奪ヒ去ラルヽニ至ラン。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "有力者中好古ノ名有テ其ノ実無キ輩ハ、徒ラニ古クモ有ラヌ玉瓶瑶盃ニ千金ヲ費ヤシ、反故紙ニモ劣ル偽其昌贋徴明ナドニ流涎シテ、其嚢ヲ倒ニスルハ愚カナルコトニコソ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
