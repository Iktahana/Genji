        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は料理が上手な上、殊にパン作りが得意だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この問題は複雑で解決が難しい。殊に時間もない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は成績優秀で、殊にスポーツも万能だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
