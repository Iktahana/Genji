[
  {
    "uuid": "9727b800-1d0b-58c6-b67c-a4e0a7e9f1a3",
    "entry": "こう言う",
    "reading": {
      "primary": "こういう",
      "alternatives": [
        "こうゆう",
        "こーゆー",
        "こーいう"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "連体詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "such",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「こう言うとき、君ならどうする？」と、彼は真剣な眼差しで私に問いかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "私はこう言うシンプルなデザインの服が、一番自分に似合っている気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "こう言う些細な積み重ねが、後に大きな差を生むのだと先生は口癖のように言っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "儂はこう言う話が至って好きでね」　「爺っつあん、中々話せるね。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "又私を知っている人はこう言うかも知れぬ。",
              "citation": {
                "source": "線路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "小十郎は鉄砲を木へたてかけて注意深くそばへ寄って来てこう言うのだった。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから遠くでこう言うことばを聞いた。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人ともこう言うんだ。",
              "citation": {
                "source": "ありときのこ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、人の顔さえ見れば、返事はこう言うものと極めたようにほとんど機械的に言った。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう言う中にも、明さんの母さんが、花の梢と見紛うばかり、雲間を漏れる高楼の、虹の欄干を乗出して、叱りも睨みも遊ばさず、児の可愛さに、鬼とも言わず、私を拝んでいなさいます。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "孤独というものが感覚的に来るのは、こう言う時だろう。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたら、あなたは死ななければならないのよ」　こう言うと、おねえさまたちは、それはそれは悲しそうに、深いため息をついて、波間に沈みました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん、卵の中にいたときとは、まるでちがうのですから、こう言うのも、むりはありません。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、みんながみんな、こう言うのです。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そいつを説明しだしたら、とっても長くなっちまうよ」コウノトリはこう言うと、むこうへ行ってしまいました。",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふん、じゃあ、ごめんよ」ドブネズミたちは、こう言うと、さっさと、自分たちの仲間のところへ帰ってしまいました。",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こう言うと、カイは、はげしく箱をけとばしました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼくはね、みんなのあそんでいる広場で、そりに乗ってもいいって、言われたんだよ」こう言うと、カイは、さっさと、行ってしまいました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」女王は、こう言うと、カイを大きなそりに乗せて、自分のそばにすわらせました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなが、こう言うので、小さなゲルダも、しまいには、そうは思わなくなりました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」おばあさんは、こう言うと、水の中まではいってきて、撞木杖をボートにひっかけて、岸に引きよせてくれました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここには、バラの花がないわ」　こう言うと、花園の中へとびだしていって、いっしょうけんめい、バラの花をさがしました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あたしがここへ来たってことを、カイちゃんが聞けば、すぐ出てきて、あたしをむかえてくれるわよ」「あそこの生垣のそばで、待っててよ」カラスは、こう言うと、頭をふりながら、とんでいきました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはみんな、あたしのなんだよ」小さな山賊の娘は、こう言うと、いきなり、手近にいた一羽をつかまえました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、ここにいるのが、あたしの古い友だちのベーだよ」こう言うと、一ぴきのトナカイを、角をつかまえて、ひっぱり出してきました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、こいつ、とってもこわがるから」こう言うと、小さな娘は、かべのさけ目から長いナイフを取り出して、それでトナカイの首すじをなでました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」こう言うと、娘は寝床からはね起きて、おっかさんの首っ玉にとびつきました。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、かぞえかたが、ちがうだけですもの」　こう言うとカゲロウは、また、空にはねあがって、ダンスをしました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "――」　こう言うと、王子は、自分の国へ帰って、門をしめ、かんぬきをさしてしまいました。",
              "citation": {
                "source": "ブタ飼い",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」こう言うと、メンドリは泣きだしました。",
              "citation": {
                "source": "眠りの精",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――　こう言うと、オーレ・ルゲイエは、こうもりがさを持って、行ってしまいました。",
              "citation": {
                "source": "眠りの精",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、こう言うのです。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」こう言うと、ポケットをひっくりかえして、いきなり、書記長の顔にどろを投げつけました。",
              "citation": {
                "source": "のろまのハンス",
                "author": "――むかしばなしの再話――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
