  {
    "uuid": "20363858-4d01-5612-8dbd-dc4006f243da",
    "entry": "コウイウ",
    "reading": {
      "primary": "こういう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間ハコウイウベキデアル。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、疑イ深イ人ニ向ッテコウイウ※ヲ云ウトカエッテ疑イヲ深クサセル結果ニナルカラ、モウ云ウマイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ児玉氏ナラ差支エナイト思ッタケレドモ、ソレデモ妻ノコウイウ醜態ヲ見セルノハ好マシクナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ秋、書斎ノスタンドヲ螢光燈ニ改メタノモ、実ハイツカハコウイウ機会ガ来ルデアロウヲ理由ニ螢光燈ニ変エタノダッタガ、―――事実読書ノタメトイウヨリモ僕ハ、イツカハ螢光燈ノ明リノ下ニ妻ノ全裸体ヲ曝シテ見タイトイウ慾望ニ燃エテイタノダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然僕ハ舌ノ尖端ニハ今マデニナイヲ、………僕ノコウイウ不思議ナ心理ヲ、マサカソコマデハ気ガツカズニイルノデアロウガ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ニコウイウエキゾチックノ美ガアルガデキナイデ、他人ニ見ツケ出サレタノハ口惜シイケレドモ、夫トイウモノハ見馴レタ妻ノ見馴レタ姿ヲノミ見タガルモノデ、カエッテ他人ヨリモ迂濶ナノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コウイウ不思議ナナマメカシサハ、彼女ガ和服ヲ着テイタノデハ現ワレナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "友田親分ハ、金五郎サント、オ京サントガ、二人デ、ドコカニ行ツタ事ヲ知ルト、カンカンニ怒ツテ、ウチノニ、コウイウノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
