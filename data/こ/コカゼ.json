  {
    "uuid": "63182415-c34f-5879-8ce3-aa90c640471b",
    "entry": "児風",
    "reading": {
      "primary": "こかぜ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
