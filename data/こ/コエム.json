        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "仲蔵が、Ｔ「お光ちゃん」　二人相抱いて、暫時声無し。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪枝、暫く泣いていたが、涙の顔上げて、Ｔ「わたくし　ウウ嬉しゅうて……」　後は声無く又、大吉の膝に泣き伏した。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "律動的な音は子供でも野蛮人でも自然に踊り出させるのであるが、無声無伴楽映画のかなり律動的な場面を見ても、訓練されない観客はなかなか足拍子手拍子をとるような気分にはならないのである。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "天は昏※として睡り、海は寂寞として声無し。",
              "citation": {
                "source": "取舵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "他なし、深更人定まりて天に声無き時、道に如何なるか一人の女性に行逢たる機会｜是なり。",
              "citation": {
                "source": "黒壁",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それより寂として天地に声無し。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "源氏はうるさかった砧の音を思い出してもその夜が恋しくて、「八月九月｜正長夜、千声万声無止時」と歌っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "夕顔",
                "note": "青空文庫"
              }
            },
            {
              "text": "微笑は眼に湛へ、おのづから頬にのぼるもの、声無くして調ある声。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び闃として声無し。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、宛然大聖人の心の如く透徹な無辺際の碧穹窿の直下、広く静かな大逵を、この哀れ果敢なき葬列の声無く練り来るを見て、或る名状し難き衝動を心の底の底に感じた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち上るや否や、茨の髪をふり乱して、帯もしどけなく、片手に懐中の児を抱き、片手を高くさし上げ、裸足になつて駆け出した、駆け出したと見るや否や、疾風の勢を以て、かの声無く静かに練つて来る葬列に近づいた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "呀ツと思はず声を出した時、かの声無き葬列は礑と進行を止めて居た、そして、棺を担いだ二人の前の方の男は左の足を中有に浮して居た。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "イザヤは其慷慨｜凛凄なる舌を其「時」によりて得たり、而して其義奮猛烈なる精神をもて、次ぎの「時」の民を率ゐたり、カアライルの批評的眼光を以て覗へば、預言者は其精神を死骨と共に棺中に埋めず、巍然として他の「時」に霊活し、無声無言の舌を以て一世を号令するものなり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "他は絶対に無声無音！",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "室内｜寂として声無し。",
              "citation": {
                "source": "痴人と死と",
                "author": "ホフマンスタアル　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼に入るものは、二三の漁火の星の如く、遠くちらつくと、稀に、銚子行汽船の過ぐるに当り、船燈長く波面に揺き、金蛇の隠現する如きを見るのみにして、樹林無く、屋舎無く、人語馬声無く、一刻一刻、人間界より遠ざかる。",
              "citation": {
                "source": "大利根の大物釣",
                "author": "石井研堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は坐辺に声無き益友を持たないと言うことである。",
              "citation": {
                "source": "坐辺師友",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "否声無き悪友に同席を許していたともなる。",
              "citation": {
                "source": "坐辺師友",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとつには、岩松無心風来ッテ吟ズ　もうひとつの幅には、水元声無シ石ニ触レテ鳴ル「もや助。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "茲ニ至ツテ、北条天下ノ民土、全ク、旱天ノ亀裂ニ似タル危殆ヲ呈シ、民、雨ヲ待ツノ声、今ヤ地ニ満チテ、シカモ声無シ……。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "「水元声無シ、石に触レテ即チ鳴ル」あれですよ。",
              "citation": {
                "source": "小説のタネ",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び闃として聲無し。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は、宛然大聖人の心の如く透徹な無邊際の碧穹窿の直下、廣く靜な大逵を、この哀れ果敢なき葬列の聲無く練り來るを見て、或る名状し難き衝動を心の底の底に感じた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "驅け出したと見るや否や、疾風の勢を以て、かの聲無く靜かに練つて來る葬列に近づいた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "呀ツと思はず聲を出した時、かの聲無き葬列は礑と進行を止めて居た、そして棺を擔いだ二人の前の方の男は左の足を中有に浮して居た。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが嫁入た當夜、擧村聽きに往くと、久しく闃として聲無つたが、初夜過る頃、新婦の聲が明月と共に澄み渡つて、ハーヱーと聽え、さて曉近く成る迄も一聲を聞ず。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "溪、直徑｜大凡七八町、岩石の奇なるものを屏風岩、硯岩、烏帽子岩、蓮華石、浦島釣舟岩と爲し、其水の來るや、沈々として聲無く、其色の深碧にして急駛せる、座ろにわれの心を惹きぬ。",
              "citation": {
                "source": "秋の岐蘇路",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にも易の易象、易數の理など、中庸の中和の理、上天無聲無臭贊歎の理など、皆高妙なる理の説き法也。",
              "citation": {
                "source": "尚白箚記",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "※斗聲無く露落ちて旌旗は寒し風清し、三軍ひとしく聲呑みてつゝしみ迎ふ大軍師、羽扇綸巾膚寒みおもわやつれし病める身を知るや非情の小夜あらし。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "見よ、空舟を刳りて、殘る船板をアポロオンに彫り刻みし未開人の如く、かの唯、辯を辯ずる者どもは、形状言の剩餘をもて、實體もなき多くの怪物を造りつつ、童男童女を食とするモロックよりも虚誕にして又、殘忍なり醜惡なり、音ありて聲無し、名あれど體無し、荒野またすべて空なる物に住まふ不淨の氣ここに漂ふ。",
              "citation": {
                "source": "頌歌",
                "author": "ポオル・クロオデル　Paul Claudel",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
