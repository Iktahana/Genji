    "definitions": [
      {
        "index": 1,
        "gloss": "coffee",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎朝、淹れたての熱い珈琲を飲むのが日課だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人と久しぶりに会って、喫茶店でゆっくり珈琲を飲んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "疲れた時に飲む珈琲は、心身ともにリフレッシュさせてくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "僕は珈琲店の椅子で酒を飲み、大衆と共に「あなたと呼べば」を唄つた後で、自ら自分の髪の毛をむしりながら、自分に向つて「この大馬鹿野郎奴」と叫ぶのである。",
              "citation": {
                "source": "流行歌曲について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "珈琲店　醉月坂を登らんとして渇きに耐へず蹌踉として醉月の扉を開けば狼藉たる店の中より破れしレコードは鳴り響き場末の煤ぼけたる電氣の影に貧しき酒瓶の列を立てたり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "珈琲店　醉月　　醉月の如き珈琲店は、行くところの侘しき場末に實在すべし。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋一ぱいの男客、女客の姿態は珈琲の匂いと軽い酒の匂いに捩れ合って、多少醗酵しかけている。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "白絹襟巻の紳士は、涸裂れた唇に熱い珈琲のコップを思い切って押しつけた。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "買物をしても、珈琲店に行つても、彼は決して死金といふものを使はない。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭をいぢる時間も、子供と遊ぶ時間も、珈琲店を夜歩きする時間も、彼にとつては皆「頭腦の營養」のためであり、仕事への心がけた準備なのである。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし他の二つの點で、全くルレーヌの方ではでたらめであり、藝術道の意識など夢にもなく、生涯を通じて酒びたりで、珈琲店の音樂など聽いて悦んでゐたところの、徹底的小學一年生の子供であつた。",
              "citation": {
                "source": "室生犀星君の人物について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは巴里の珈琲店で、若い女と氣の輕い話をしつつ、靜かに時間を樂しんで吸ふべきものだ。",
              "citation": {
                "source": "ラムネ・他四編",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もつとひどいのは、或る夜行きつけの珈琲店に行つたら、女給が「昨夜遲くなつてお歸りが困つたでせう」といふ。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "珈琲店の軒には花樹が茂り、町に日蔭のある情趣を添えていた。",
              "citation": {
                "source": "猫町",
                "author": "散文詩風な小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして店々の飾窓には、いつもの流行おくれの商品が、埃っぽく欠伸をして並んでいるし、珈琲店の軒には、田舎らしく造花のアーチが飾られている。",
              "citation": {
                "source": "猫町",
                "author": "散文詩風な小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "画家は楽気に凭掛の椅子に掛り、莨を喫み、珈琲を飲み、スケッチの手帳を繰拡げ、見ている。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が彼女達を愛するのは女達の男道楽さめやすい色恋をシャム料理法と珈琲色の皮膚に刺繍した。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は花田君子柳の下に棄てて、カバレット銀座、未来の情婦、万国の血をみて狂うメイ・フレデリック、私を見るや彼女の情熱死物狂い（その頃喫茶店インタナショナルの芸術家は珈琲とフランス菓子に驚歎して昆虫類が今後人間に代ってエゴイズムと排他主義、実行する。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何をしに自分は来たのだ」　彼はそれが自分自身への口実の、珈琲や牛酪やパンや筆を買ったあとで、ときには憤怒のようなものを感じながら高価な仏蘭西香料を買ったりするのだった。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯を食べに行っても可、ちょいと珈琲に菓子でも可、何処か茶店で茶を飲むでも可、別にそれにも及ばぬ。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里へ行きますと、沢山ある珈琲店で、香り高い珈琲のコップを前に控え、人々はひと息、息を入れています。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "珈琲の容器が柄の付いた縦に細長いシークなコップで、それに吸管をつけて来ます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴里の珈琲店は給仕も男で、客は家族連れで行ける極めてさっぱりしたものです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イギリスの家庭の美風は、｜お茶時で維持されている」「フランス人の機智は、珈琲店（日本のカフェーとは違います）で培養される」。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "外はセーヌの暮れ近い水の色、食後の珈琲は新橋の夕陽の斜光を渡ってからだ。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「珈琲にいたしましょうか。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と彼は此時珈琲を一口飮んだが、悠々と鼻髯を捻りながら『何ね、實は旅立つ者があるので。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "』といふので、私は珈琲を一口飮んで、徐ろに語り出した。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば一｜皿の菓子、一｜盞の珈琲に、一円、二円と擲ちて、なおも冥加に余るとなし、我も我もと、入交り、立替る、随喜の輩数うるに勝うべからず。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　かう思つて、わたしはすぐ傍にある小さい珈琲店の硝子戸をあけて這入つた。",
              "citation": {
                "source": "赤い杭",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の友人に、寝る前に香り高い珈琲を飲まなければ（飲めばの――誤植ではない）眠れないという厄介な悪癖の持主がいる。",
              "citation": {
                "source": "大阪の憂鬱",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――可愛くもあり、面倒でもあり………さうだ可愛くもあり、面倒でもあり、可愛くもあり、面倒でもあり、可愛くも………（女コーヒーを立てゝ持つて来る）女　（優しく）お飲みなさいな。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたコーヒーが冷めますから。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
