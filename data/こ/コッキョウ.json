    "definitions": [
      {
        "index": 1,
        "gloss": "border (between countries)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "国境を越えるためには有効なパスポートが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "国境近くの町では複数の言語が飛び交っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "国境線の引き方をめぐって両国の対立が続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "国境に甲斐をまたいで、駿河の領内に入る。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人辻本工学士に拠ると信濃越中の国境に聳えている祖父ヶ岳は、「種蒔き爺さん」が笊を持った具合に現われるので、山腹雪解の頃、偃松が先ずその形に蔓って、出るのではないかという話である、偃松の仲間入は最もおもしろい。",
              "citation": {
                "source": "雪の白峰",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "三河と美濃の国境だという境橋を渡って、道はだんだん丘陵の間に入り、この辺が桶狭間の古戦場だという田圃みちを通った。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんはユニヴァーサルに国境を超越した存在だと思う。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の国を旅行して帰りにドイツの国境を超えると同時に、この緊張がいつも著しく眼についた、すべてのものがカイゼルの髭のように緊張していた。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば第一区には「敵騎兵国境に進入」第二区には「重甲兵来る」と云った風な、最も普通に起り得べき色々な場合を予想してそれに関する通信文を記入しておく。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はときをり寺院の脚高な縁側から国境山脈をゆめのやうに眺めながら此の友のゐる上野国や能く詩にかかれる利根川の堤防なぞを懐しく考へるやうになつたのである。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車がニースの駅を出て国境に近づくと、一行は網棚から荷物を下して、身支度をととのえましたが、彼はまるで精神のない人間のように、身動きもしないで、俯むいたまま一点を見詰めていました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "両耳の上の塹壕に宣戦をいどむと私たちの国境から突然逃げ出してしまった。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダの声音は印度の夜の国境、ヒンズークシ山脈の下をアフガニスタンに向って疾走する急行列車にもまして叡智がひらめくのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボスボロス海峡で過去の汚いものを洗い清めて東西の国境に足をまたげ、土耳古の空を見上げたときは現代の世界が実業家によって支配されるってことが非常に僕を得意にしてケマル・パシャが尻に錨をつけて黒海を泳ぐさまさえ可笑しかったのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "地下室の踊場では、タキシードの男と、夜会服から黄色い腕をだした踊子とが胸と胸の国境をデリケートな交錯で色どりながら踊った。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はサイゴンとプノンペンを往来する商権の保持と、為替ブローカーをやり、かたわらカンボジヤとシャムの国境に巨大なゴム園を経営していた。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "また彼はプノンペンから自動車に搭乗して国境のゴム園に車をカンボジヤの原野、白鷺の飛ぶ直線道路を、水田に遊ぶ水牛のなかを疾走させた。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏、彼等は、歩兵隊と共に、露支国境の近くへ移って行った。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロレタリア文学運動は、ゼイタクな菓子を食う少数階級でなく、一切のパンにも事欠いて飢え、かつ、闘争している労働者農民大衆の中にシッカリとした基礎を置き、しかも国境にも、海にも山にも妨げられず、国際的に結びつき、発展して行く。",
              "citation": {
                "source": "農民文学の問題",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "河は、海峡よりはもっと広いひろがりをもって海のように豊潤に、悠々と国境を流れている。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒竜江は、どこまでも海のような豊潤さと、悠々さをたたえて、遠く、ザバイガル州と呼倫湖から、シベリアと支那との、国境をうねうねとうねり二千里に渡って流れていた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "税関吏と、国境警戒兵は、そのころになると、毎年、一番骨が折れた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　北方の国境の冬は、夜が来るのが早かった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして国境外では、サヴエート同盟に物資が欠乏していると、でたらめを飛ばした。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅行者は、国境で円をルーブルに交換して行く、そして国外へ出る時には、ルーブルを円に交換してもらう。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからおもむろに、支那人の手によって、国境をくぐりぬけ、サヴエート国内へもぐりこんで行った。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在の日本はカラフト国境から台湾まで連なる島環の上にあって亜熱帯から亜寒帯に近いあらゆる気候風土を包含している。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ソヴェート同盟の国境にむかっての陣地を拡げた。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君達は、軍閥的国境を湮滅しそれよりもっと悪い経済的商業的障碍を取り除かねばならないのだ。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう皮相的科学教育が普及した結果として、あらゆる化け物どもは箱根はもちろん日本の国境から追放された。",
              "citation": {
                "source": "化け物の進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学と科学の国境　科学の世界には義理も人情もない。",
              "citation": {
                "source": "科学と文学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、科学の世界は国境の向こうから文学の世界に話しかける、その話はわれわれにいろいろのことを考えさせる。",
              "citation": {
                "source": "科学と文学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここはもうフランスの国境近くで、屋敷のベランダから牧場越しに国境の森が見え、またヴォルテールの住まっていたという家も見えます。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
