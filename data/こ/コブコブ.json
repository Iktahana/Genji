    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕はなにも職業的な観賞家じゃないのだからね、猟館や瘤々した自然橋などを持ち出してまで、君達に瞑想を促そうとする魂胆はない。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、樹疫のためか、皮が剥がれて、瘤々した赤い肌が露われている老樹が立ち並んでいた。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "気づくと私は、炎々と囲炉裡に炎えさかつてゐた三尺あまりの瘤々逞しい赤松の薪太棒を振りかぶつて、まんまるな月の光りを浴びつゝ、芋畑のふちで鬼と化してゐた。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "二抱えもある幹で、瘤々の根が赤土の上へ下へと四方に蔓り、根は更に数本の若木を育てゝ小さな林を成してゐた。",
              "citation": {
                "source": "肉桂樹",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄明の光線を細く鈍く反射させながら流れてゆく小川のふちに、数株のポプラの樹が並んで、年を経て瘤々の太くなっている幹から萌え出た勢のいい若枝が、灰色のまざった軽い浅緑の葉を繁らせている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "神社の境内をぬける道のほとりで、そこに大きな枯木があって、上方の枝は切り取られてる幹に、ところどころ、太い瘤々が盛り上っていた。",
              "citation": {
                "source": "絶縁体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤々の盛り上ってる樹幹が、幾つも写生してあった。",
              "citation": {
                "source": "絶縁体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝の痕がたがひちがひに瘤々になつてずつと上まで續いてゐる。",
              "citation": {
                "source": "五葉の松",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤々しくずっしりと太った体の鬼のことだから、すばらしく大きな瘤が膨れ出てもよいのだ。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ「顔じゅう一めん瘤々だらけ」の御面相だったからなので。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりかこの弟ぎみの顔は、一めんに瘤々だらけと来ているものですから、仮りにもそれを剃る段になったら、そこらじゅう切り疵だらけにせずには済まぬ始末だったのでした。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "棟を掩うて鬱蒼と繁った、高い杉の防風林も、玄関の前に瘤々の根を張った、百日紅の老樹も、また昔の庄屋時代から続いている、三棟四棟の崩れかかった土蔵も、奥庭の石灯籠や泉水も、一木一草に至るまで、昔となんの変りもありません。",
              "citation": {
                "source": "仁王門",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつらは大きくて肥えていた、なかには五寸よりもっと大きいらしい、頭のところが瘤々で、胴が毬みたいに肥えてひどくぶざまなのもいた。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さくて持ちのいいのは、栂の瘤々の角だ。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トシオは思わず躯を投げ出して海の高波の様に四方へこぶこぶに太くあらわに這って居る欅の根のひとところへ、うつぶして仕舞いました。",
              "citation": {
                "source": "トシオの見たもの",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四五日続いた曇天に、茅で葺かれた収穫蔵の屋根も、その前面から広くとって、ずっと奥庭との境の垣根まで続いて春や秋、の頃の収穫物を干し乾かす場所に宛ててある外庭の土も、皆一様に灰色に、いじけて下駄の歯で荒らされた地面の上などは、こぶこぶのまま、凍り固まって居るのであった。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、唐子の頭のようにこぶこぶだらけで何と愛嬌があるでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが先生の造ったバットはこぶこぶだらけなので、打った球はみんなファウルになり、チップになる。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "千三はボックスに立つ前にバットを一ふりふった、それは先生の手製のこぶこぶだらけのバットである。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして別な人間は脚が短かくて手が長く、筋肉はまるまると膨れてはいずに、筋張つてこぶこぶになつていた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋肉は消耗してこぶこぶの紐のようになり、肉附きは消え去つていたので、肋骨の一本一本、体中の骨の一本一本が、しわがよつて深いみぞができている弛んだ皮をとおして、はつきり輪廓をあらわしていた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "広い胸と太い前肢も、筋肉が固いこぶこぶになつて皮膚の下に見えている体の他の部分との釣合をこえていなかつた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
