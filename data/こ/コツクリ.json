        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あんまり夜ふかしして机の前でコツクリコツクリすると、皆んなに笑はれますから、もうお別れする事にいたしませう。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ときくと、冬子の夫はコツクリした。",
              "citation": {
                "source": "傘",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　……（コツクリをする）五郎　小母さん、すみませんが椅子の方を――（と美緒の肩と両脚の下に手を入れて、ソーツと抱きかゝへる。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（美緒がコツクリをする。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　……（うれしさうにコツクリ）母親　（美緒に）なんて言つたつけ、気胸療法とかも駄目だつたつて？",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　……（何度もコツクリをして見せる）小母　此処のお医者さまだけでは心細うてなあ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　（それにコツクリをして見せてから五郎に）ホントに純粋な科学者なのね？",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　……（コツクリ）小母　（ニコニコしながら）こうんな所までペトペトに白粉塗らはつて、（と京子の真似）さうですわよ！",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（美緒コツクリ）約束したよ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　……（三人から目を離さず、しきりとコツクリをして見せる。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　……（コツクリをしてゐる）少女二　私は先生には教はらなかつたけど、でも先生のことよく知つてゐます。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　……（コツクリ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（美緒コツクリ）……ぢや、なにも言はないで頂戴します。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてコツクリをするスミ。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頬を撫でる香はしい娘の息を感じて、八五郎は闇の中でコツクリコツクリうなづきます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "井戸端の逢引",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロツパ、フランスあたりのいゝ腕の作家に書かしたら、コツクリといゝものが書けると思ふんです。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
