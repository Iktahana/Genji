        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "沖のアメリカの艦隊のまわりをチョイサアや高速艇がいそがしく走りまわり、その上の空を哨戒機がいくつも旋回している。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがどうしたというの」　横あいから鼠色に塗った高速艇が消防自動車のようなサイレンを鳴らしながらすっ飛んできた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "高速艇がそばへすりよると、白い鉄兜をかぶった背の高い海兵がランチへ飛び移ってきて、運用長になにかいっている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈好寄心と野心を失ったものにとって、防波堤の上に肱をつき、旅するもののあわただしき運動を眺めやることは、一種、貴族的な快楽である〉　若い海兵隊は笑いながら高速艇へ帰って行き、ランチはまたゴトゴトと動きだし、十五分ほどののち長い斜堤の端にある古ぼけた浮桟橋へ横づけになった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "高速艇が抜いていく。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "防波堤のむこうから、白い高速艇が出てきた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "高速艇の発着する浮き桟橋にも、防波堤にも、どこにも、人が見えない。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹の下にとめたセリカまで歩いてきて、「あと十分で、高速艇が帰ってきて、折かえし出港するんだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、高速艇だと二十分、フェリーは五十分近くかかる。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺たちは高速艇でさきにいこう」　全員が、その意見に賛成した。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうこうするうちに、高速艇が入ってきた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったんひっこんだ小川が、高速艇のドアのところに出てきて、にやにやと笑っていた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
