        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私はおなかがペコペコなのだが、喫煙室のソーファに沈んで煙草を吹かしてゐるより他はなかつた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "後にコペルニカスの地動説が出て前説よりも遥かに簡単に天体の運動を説明し得る事が分り、ケプレル、ニュートンを経ていよいよ簡単な運動の方則で天体の諸現象を述べ尽す事が出来た。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も、警察の手を遁れようと必死になつて、海の彼方コペンハアゲンの或るホテルに妻との部屋の豫約までしてあつたが、先立つ物は何より金、結局若男爵夫妻は父の金を盜出さうとした。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は真面目に、ペコペコ頭を下げ、靴を磨くことが、阿呆らしくなった。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "社員に、おべっかを使うように、ペコペコ頭を下げた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まアザッとこんな苦しいわけで……けれどつかい込みの一件は、ごく内密にお願いします」と言って立ち上がり、石井翁が何も言い得ぬうちに、河田翁は辞儀をペコペコして去ってしまった。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ペコペコ頭をさげて、急いで自分の穴へもぐり込んで、子供のフウねずみを連れ出して、鳥箱先生の処へやって参りました。",
              "citation": {
                "source": "鳥箱先生とフウねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝楽屋の中では　定九郎の仲蔵や座長らしい大石役者や、其他がペコペコ謝っている。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "右門と伝六そッと覗いて見ると、　敬四郎、お兼の前にペコペコ頭を下げて、　「ワシが言い過ぎた。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）７９＝（Ｆ・Ｉ）街道　右門と伝六とおふみの前に何と敬四郎が道の真中で土下座して両手をついてペコペコ頼んで居る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方の宿場の混乱の中に遂に二人を捕えると、宿の二階を見上げて、敬四郎ペコペコ頭を下げて、Ｔ「これで嬶ァに威張れます」　浪之助とお類、上を見ると宿の二階の手摺りに右門と伝六おふみに伊吉。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）79＝（Ｆ・Ｉ）街道　右門と伝六とおふみの前に何と敬四郎が道の真中で土下座して両手をついてペコペコ頼んで居る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペコペコに減った腹に鰻飯！",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことを言うと、「風呂は入れてくれるけンど、お腹ペコペコやさかい、風呂の中で眼がまわりそうになっちゃった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おっちゃん、うちおなかペコペコや」「おっさんもペコペコや。",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "じつは恥かしいことだが、おなかが空いて、ペコペコだったのだ。",
              "citation": {
                "source": "天衣無縫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ああ、おなかペコペコや」　昼日散々、反吐が出るくらい豹吉に食べさせて貰ったのに、三郎はもう腹の皮がひっつきそうだった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹の皮がひっつくくらい、ペコペコになっていたせいか、涙が出るほど美味かった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "左翼思想よりも、腹をへらしている人間のペコペコの感覚の方が信ずるに足るというわけ。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおけに」　ペコペコ頭を下げながら、飛び込むようにはいり、手をこすっていた。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "諦めて元のコンクリートの上へ戻ったが、骨が千切れそうに寒くて、おまけにペコペコだ。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿倍野橋へ行くにはもう時間が遅いし、何よりも腹がペコペコだ。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
