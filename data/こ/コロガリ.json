[
  {
    "uuid": "b5b3f187-eede-55f3-aeb9-9d86e715aab2",
    "entry": "転がり",
    "reading": {
      "primary": "ころがり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
