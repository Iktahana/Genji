        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "分割センガ為メニ弾圧スル――コレガ支那ニ於ケル帝国主義者共ノ政策デアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガ　オホキク　ナル　シヨウコデス」　ミルト　ナルホド、ナガイ　ミミガ　フタツ、ニヨツキリ　ハエテ　ヰマス。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "“愛スルドレゴヨ、コレガ第二ノ警告！",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サア、皆サン、イッショニ読ミマショウ」　かくて、マドロスの音頭で、お松も、乳母も、茂太郎も、金椎だけは別、ワン、ツー、スリー、フォーア、ファイヴ、シキス、セヴン、エイト、ナイン――　幾度も繰返して、「コレガ日本ノ数字、一、二、三、四、五、六、七、八、九デス、ヨク覚エナサイ」「先生！",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コレガ　センソウト　イフモノカモ　シレナイ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガタメニ遂ニ加筆スル所ナクシテ止ミヌ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガタメニ悲感更ニ深シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "目コレガタメニ奪ハル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガタメニ竟夕寧カラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "独千仞ハ藩論反覆ノ日ニ当ツテ挺然トシテ正義ヲ持シ一時コレガタメニ獄ニ下リ幾ド死セントス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンペラ門兵衛ハ特ニ浅草ノ宮戸座カラ中村勘五郎ガ買ワレテ来テ演ジタガ、コレガ妙ニ印象ニ残ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガ自分ノ顔ナノカト呆レザルヲ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ己ハ実際気ガ狂ッタンジャナイカナ、コレガ気狂イト云ウモンジャナイカナ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアニ、明日日曜ナンデミンナ遊ンデイルンデスヨ」京都駅ハ下リノ時ハブリッジヲ沢山登ラナケレバナラナイノデ、コレガ甚ダ億劫デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヽソウヨ」「ソンナ石ガ何百萬圓モスルンデスカ」「ソンナ石トハ失礼ネ、コレガ三百萬圓ヨ」「オ爺チャンニ三百萬圓出サセルナンテ、叔母サンハ凄腕ダナア」「チョット菊太郎サン、オ願イダカラソノ『叔母サン』ハ止シテ頂戴。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガホントノ大往生ダ」７十七日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
