        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まだ腰糧（弁当）もあるし、疲れたら山寺の庫裡でも叩こう。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大急ぎで、腰糧（弁当）七人分ほど拵えてくれい」「ヘイヘイ。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐその後から、さっきの武士が、一同の腰糧を抱えて飛び込んで来た。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "「装備、腰糧など、午までに万端、発向の用意をおわること。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "午の腰糧もすませ、野営をもたたませると、「用意」　の号令が兵にくだる。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがすべて腰糧まで身につけて、宿を立つには、朝々一ト騒ぎであった。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "まずは腰糧を食うてよく寝ておけ」　と、これは物見隊へだけでなく、全軍の将士へも同様な令でつたえられた。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほどなく土地の内藤三郎兵衛｜道勝も来て大釜で粥を煮、兵の飢えはしのがれたが、尊氏はなお、腰糧三百人分を道勝の手に託して、「こよいは休み、ここは、明朝立つ」　と、ふれさせた。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
