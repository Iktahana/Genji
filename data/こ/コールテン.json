  {
    "uuid": "abe66c5d-8dbb-575f-88e1-31764d2113fd",
    "entry": "コールテン",
    "reading": {
      "primary": "こーるてん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コールテンの黒｜足袋を穿いているのまで釣合わない。",
              "citation": {
                "source": "家霊",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御飯はいくらか冷たいかも知れないわよ」　老人は見栄も外聞もない悦び方で、コールテンの足袋の裏を弾ね上げて受取り、仕出しの岡持を借りて大事に中へ入れると、潜り戸を開けて盗人のように姿を消した。",
              "citation": {
                "source": "家霊",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "袢天の下のコールテンのズボンのポケットに押しあてた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "垢でベタ／＼になつてゐるシヤツをコールテン地の服の下に着てゐた石田や齋藤は、直接に膚へ寒さを感じた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "口笛を吹きながら、コールテンのズボンに手をつツこんで、離れてみたり、近寄つてみたりした。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "技師だけがコールテンのズボンをはいていた。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "一廻りして帰りかけた時、コールテンの足袋を履いて居る足の指の先が痛くなって来た。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "厚いジヤケツにコールテンのズボン、頭には戦闘帽、肩には猟銃の代りに鶴嘴をかついでゐる。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "巽比良久、コールテンのズボン、メリヤスのシャツ、十七八の青年二人を連れて、右手より現はれる。",
              "citation": {
                "source": "かへらじと",
                "author": "日本移動演劇連盟のために",
                "note": "青空文庫"
              }
            },
            {
              "text": "継ぎはぎだらけの防水したカーキ色の上衣に、泥のなかをひきずりまわしたような布目もわからないコールテンのズボンをはき、採鉱用の鉄鎚を腰にさし、背中がすっかりかくれてしまうような大きな背嚢を背負っていた。",
              "citation": {
                "source": "キャラコさん",
                "author": "女の手",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の財産は、シャツ二枚半、襟巻き二本、毛糸の靴下が一、二足、コールテンの古半ズボン一着、銹びたかみそり一｜挺、あちこち折りこんだ讃美歌の本一冊、それから、こわれた調子笛が一つであった。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "間……不意に、開いたままになつてゐたドアから、ハンテン着や、ボロボロのコールテン服や、少しはましな洋服を着たりした、ルンペンとも暴力団とも附かない五人の男達がザザツと入つて来る。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に白木は外に出て、往来の奥の方へ手で合図をすると、コールテン服の男がスーツと出て来てペコ／＼する。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お辻は外に出て階段の方へ、白木も階段の方へ、コールテン服は往来へ消える。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い方はダブルの背広、年上の方は和服の着流し、――そこへ、不意にコールテン服の男がスツと近寄つて来る。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう頭髪が薄くなって、地肌が光りはじめているのに、真赤なシャツや派手なチェックの靴下などをもち、いつもだぶだぶのコールテンの上着を着て、低い声で私のことを、「アンタさん」と彼は呼んだ。",
              "citation": {
                "source": "軍国歌謡集",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
