[
  {
    "uuid": "9f022b25-cb4a-5099-8f62-06d8be3618c5",
    "entry": "国交",
    "reading": {
      "primary": "こっこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
