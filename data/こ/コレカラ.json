  {
    "uuid": "9ad13f0c-cf11-5ea0-ab08-d7bea95b5c95",
    "entry": "コレカラ",
    "reading": {
      "primary": "これから",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コレカラモアル事デス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハ　コレカラ　ドチラヘ　イクノデスカ」ト　シンセツナ　トシヨリハ　ワカイ　ヲトコニ　タヅネマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレカラ　センサウニ　イクノデス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシタチハ　コレカラ　ドウ　シタラ　ヨイデセウ」ト　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シロイ　テフテフハ　シンパイサウニ、「コレカラ　ドコヘ　イクノ」ト　フウセンニ　キキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コレカラソノ論証ヲシナケレバナラヌガ、アマリ十分ナ紙幅ガナイカラ箇条書ニシゴク簡単ニ書ク。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレカラ君ラ日本艦隊ヲ爆撃ニ行クノダ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "その者は……コレカラ二通話ニナリマス）　ガシャンと受話器を掛ける音が拡声器の中で鋭く跳ねかえる。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "サァ　コレカラドウシテ　オウチヘ　カヘロウカト、ミンナハ　シクシク　ナキダシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ハ夜デヨカッタケレドモ、コレカラダト時間ガ時間ダカラ、必ズドコカデデモ隊ニ打ツカリマス、米国大使館ト国会議事堂ト南平台ヲ結ブ線ヲドコカデ横切ラナケレバナリマセン、ソノ積リデ早目ニオ出カケニナッテ下サイト、運転手ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ五時ダネ、オ婆チャン、コレカラ銀座ヘ出テ晩飯ヲ喰ッテ帰ロウジャナイカ」「銀座ノドコヘ」「浜作ヘ行コウヨ、コノ間カラ鱧ガ喰イタクッテ仕様ガナインダ」颯子ヲ呼ンデ浜作ニ電話サセ、カウンターノ席ヲ三四人分取ッテオイテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツデモ来ルガイヽ」「有難ウ存ジマス、オ言葉ニ甘エテコレカラチョク／＼伺イマス、毎日ト云ウ訳ニモ参リマセンガ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――イヤ、コレハオ邪魔ヲイタシマシタ、コレカラ伯母サンニ御挨拶ヲシテ怱々退散イタシマス」「暑イノニ大変ダネ、ユックリ休ンデ行キナサイ」「有難ウ存ジマス、ナカ／＼ソウシテモオラレマセンデ」春久ガ出テ行ッテカラ暫クスルト、オ静ガ二人分ノ茶ト菓子ヲ盆ニ載セテ持ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレカラ四五十分間、予ハ鈴木氏ニ体ヲ預ケナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ同時ニ、コノ調子ナラコレカラ後モ気狂イ的行為ヲ繰リ返シテモ差支エアルマイ、颯子ノ好キナピンキー・スリラーデハナイガ、コノ程度ノ冒険ハ止メル訳ニ行カナイ、間違ッテ死ンダトシテモ構ウモンカ、ト云ウ気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレカラ何処ヘ出カケヨウトスルノカ、何処ノ部屋ヲ歩イテイルノカヨク分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシ彼方ヘ逃ゲテクカラ、一人デ勝手ニ泣イテラッシャイ」「ネエ颯子、コレカラ時々『颯チャン』ト呼バシテオクレヨ」「馬鹿ラシイ」「颯チャン」「甘ッタレ坊主ノ嘘ツキ坊主、誰ガソノ手ニ載ルモンデスカ」プリ／＼怒ッテ行ッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デハコレカライタシマス、別ニ痛クモ何トモゴザイマセンカラ御心配ナク」「心配ハシテオリマセン、ドウゾ御遠慮ナク」「ヨロシュウゴザイマスナ」針ガ頸部ニ射シ込マレルノガ感ジラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハオ爺チャンノ墓地捜シノオ供ヲシテモ詰マラナイカラ、アタシハ御免蒙リタイ、コレカラ四条通リヘ出カケテ「キリハタ」ヤ高島屋デ買物ヲシ、午後ハ高雄方面ヘ紅葉見物ニ行キタイノダガ一人ボッチデハ仕様ガナイ、誰カ案内ヲシテクレナイカシラト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテコレカラハドウナルカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
