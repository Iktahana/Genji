        "examples": {
          "standard": [
            {
              "text": "部長はいつも、昔の苦労話やこぼし話ばかりしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「もう、彼のこぼし話にはうんざりだよ。聞いているこっちまで疲れてくる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女のこぼし話を聞いていると、つい同情してしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "僕は人傳てにかういつたたぐひの奧さんのこぼし話を聞くたびに、今日になつて人にこぼしてゐるくらゐなら、比呂志君が十九でおとつつあんになつた當時、もう三年分の金をやつて葛卷を追出してしまへといつたときに、なぜ料簡をきめてはくれなかつたのかとつくづく情けなくなる。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
