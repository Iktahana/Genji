          "literary": [
            {
              "text": "ワルシャワから、コヴノ要塞にかけての戦場で、有名を轟かした士官候補生イワノウィッチの負傷も、もうまったく癒えていた。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワルシャワからコヴノに退却するまでに起った露軍の奇跡は、勇士イワノウィッチの五つの勲功である。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヴノの要塞にもう二十マイルという地点に接近した時であった。",
              "citation": {
                "source": "勲章を貰う話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「去年コヴノへ行った時の汽車の中の話だがね。",
              "citation": {
                "source": "接吻",
                "author": "ПОЦЕЛУЙ",
                "note": "青空文庫"
              }
            }
          ]
