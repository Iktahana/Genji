        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二声三声呼んでいるうちに自分の倒れているのを見付けて急いでやって来た。",
              "citation": {
                "source": "病中記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "城山の森から一羽のからすが羽をゆるやかに、二声三声鳴きながら飛んで、浜のほうへゆくや、白痴の親は急に話をやめて、茫然と我れをも忘れて見送っていました。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓮月の偈が唱声三昧に入るに従い、青年、箸と椀をさし置きしきりに涙を拭き出す。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰らずや、帰らずやと二声三声、引続きて聞こえけるに、一人の幼なき児、聞きつけて、母呼びたまえり、もはやうち捨て帰らんといい、たちまちかなたに走りゆけば、残りの童らまた、さなり、さなりと叫びつ、競うて砂山に駈けのぼりぬ。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と綾子は耳を欹てたり、戸外にて喨々と二声三声、犬は疾風のごとく駈出だして、「変だ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "福等は余衆を率いて営に入り、塁門を塞ぎて堅守しけるが、福｜此夜令を下して、明旦砲声三たびするを聞かば、囲を突いて出で、糧に淮河に就くべし、と示したり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、何処でかキャンキャンと二声三声犬の啼声がする……佶と耳を引立って見たが、もう其切で聞えない。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "産児は初めて風に触れた時、二声三声｜啼き立てたが、その時はもうぐったりしたようになっていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　火をかけられた黒鶫が、思ひ出したやうに、威勢よく二声三声続けざまに啼いた。",
              "citation": {
                "source": "籠の小鳥",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで背の上の主人共々、心地よげに水を浴びていた黒鹿毛が、突然高くふた声三声｜嘶くと、背に若者を乗せたまま、抑え切れぬ感興をでも覚えたかのように、さッと岸辺に躍り上がりながら、今し街道を東へ駈けぬけようとしている旅の二騎目ざして、まっしぐらに挑みかかりました。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎は、既に白く光を失った月を仰いで、二声三声｜咆哮したかと思うと、又、元の叢に躍り入って、再びその姿を見なかった。",
              "citation": {
                "source": "山月記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかでふた声三声、高く鷹が鳴いた。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の中から呼びとめたは狂人だつた・寝ころ□□はもう春蝉の二声三声四月廿六日　曇后晴、市街行乞、宿は同前。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、二時頃だつたらう、二声三声、ほとゝぎすが啼いたのはよかつた、私には初音だつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くほとゝぎすが二声三声啼いた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "士もさすがにうるさくなったので、太い筆をとってなぐり付けると、彼は地に墜ちてふた声三声叫んだかと思うと、たちまちにその姿は消えた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "酉陽雑爼（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "群れに離れた孤雁が何かの途惑いをして迷って来たのかも知れないと思っていると、雁は雨のなかにふた声三声つづけて叫んだ。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "群に離れた孤雁が何かの途惑いをして迷って来たのかも知れないと思っていると、雁は雨のなかに二声三声つづけて叫んだ。",
              "citation": {
                "source": "薬前薬後",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "袂から呼子の笛を探り出して、長次郎がふた声三声ふき立てると、それを合図に銀蔵が枯枝の大松明をふり照らして駈け付けた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "小女郎狐",
                "note": "青空文庫"
              }
            },
            {
              "text": "婢は命｜辛々迯了せけれども、目覚むると斉く頭面は一面の火なるに仰天し、二声三声奥を呼捨にして走り出でければ、主たちは如何になりけん、知らずと言ふ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二声三声鳴いた牛の声は耳に入らなかつた。",
              "citation": {
                "source": "海異志",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬はまだ二声三声吠えつづけたが家人が日本語の怒声を聞きつけると、初めてテラスへ出て来て犬を屋内へ引き摺り入れた。",
              "citation": {
                "source": "厨房日記",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに答えてどこからともなくウォーウォーと狼の声が二声三声聞こえて来た。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その裏門まで来た時である、内と外とで二声三声、問答をする声がした。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて門前まで行き着くとひたとばかりに止まったが、二声三声押し問答。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、ふた声三声くち走ったのが断末魔、地に長く寝て動かずなった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホーホケキョ　ホーホケキョ　うぐいすは梅の枝にとまって二声三声さえずりました。",
              "citation": {
                "source": "うぐいす",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "「乃信姫殿か」「主水様」　内と外とで二声三声。",
              "citation": {
                "source": "善悪両面鼠小僧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……スタスタと道を歩いて来て、この屋敷の前まで来て、トン、トン、トンと潜り門を打って、二声三声物をいったかと思うと、すぐに内から潜り門の扉があいて、あの女を内へ入れたのだからな。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふるへ聲で又、　もし／＼と、二聲三聲呼んで見たが、目ざとい老人も寐入ばな、分けて、罪も屈託も、山も町も何にもないから、雪の夜に靜まり返つて一層寐心の好ささうに、鼾も聞えずひツそりして居る。",
              "citation": {
                "source": "雪の翼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
