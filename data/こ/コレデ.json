  {
    "uuid": "1d346815-fbc1-5cb4-91d4-bd00caa6bab1",
    "entry": "コレデ",
    "reading": {
      "primary": "これで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コレデハ、モウ　ヂキ　コハレテ　シマフダラウ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア、チヒサイネ」「コドモデスカラネ」「コレデハ、オトナニ　ナツテモ　アマリ　オホキク　ナリマスマイ」「イヤイヤ　オトナニ　ナツタラ、コヤクラヰノ　オホキサニ　ナル」「ダマサウタツテ　ダメダヨ」「ホントウデスヨ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレデ、イタチサヘ　ヨンデ　クレバ、ミンナ　オキヤクガ　ソロフ　ワケデスガ、サテ、イタチハ　ドウ　シマセウ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の頃、ドイツのマルクが下がったと同時に、コレデはドイツは破産するかもしれないので、物価がズット上ったよ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドノ　シタニ　ニゲテ、コレデ　アンシント　ネコロンダ　トタンニ、　パタ　パタ、パン　パン。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "神様ハコレデ人間ヲゴマカサウト。",
              "citation": {
                "source": "骨片ニ関スル無題",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困ッタナ、僕ハトウニ食ベチャッタンデ、梅肉ヲ下ゲテ行ッチャッタンダ」「梅肉ダッテコヽニアルワ」ト、颯子ハ鱧ト一緒ニ自分ノ梅肉ヲ廻シテヨコシナガラ、「梅肉ダケ別ニ取リマショウカ」「ソレニハ及バナイ、コレデ結構」颯子ハタッタ二片ダケシカ食ベナイノニ、梅肉ガワリニ穢ラシク喰イ荒サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イ／＼人生モコレデイヨ／＼終ルノカナト、イクラカホットシタクライダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、コレデヨカッタ、ホントニ安心イタシマシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガスッカリ調ベテ来タンダ」「出来上ルト冬ニナリマスネ」「ダカラ格別急グコトハナイ、ユックリ取リカヽッテ来年ノ三四月頃ニ完成スレバイヽンダガ、チットデモ早ク完成サセテ喜ブ顔ガ見タインデネ」コレデ陸子モ黙ッテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレデハ風邪ヲオ引キニナリマス」佐々木ガ又這入ッテ来テ汗デ濡レテイルガーゼノ肌着ヲ着カエサセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サ、コレデイヽデショ、コレデイヤナラ勝手ニナサイ」「痛イ、痛イ、痛イコトハ本当ナンダヨ」「コレデイクラカ直ッタ筈ヨ」「痛イ、痛イ」「又ソンナ声ヲ出ス！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "境内ノ幽邃ナコトハ真ニ五子ノ言ニ背カズ、前ニモ二三度杖ヲ曳イタコトハアルガ、コレデモ大都会ノ市内カト驚クバカリ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンナモノデ宜シュウゴザイマショウカ」「結構々々、コレデ早速間ニ合イマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナモノハ戴キマセンヨ、コレデ宜シケレバマダゴザイマスカラ、イクラデモ仰ッシャッテ下サイ」佐々木ハ何ニ使ウノカ全ク見当ガツカナイラシク、呆気ニ取ラレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サ、コレデ済ンダンダ、サア帰ロウ」予ハサッサト自動車ニ乗リ込ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ時、僕ハ本気デ注射ヲスルノガ馬鹿気テイルノデ、カンフルヲ射ス真似ヲシテ、ヴィタミンヲ射シテヤル※ニシテイルノダガ、木村ガ気ガ付イテ、「先生、コレデイインデスカ」ト小声デ聞イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴクロウ○マ　スミタ○　ウエハ　コレデ　シツレイ　オチノ○ル　○ンセン」「うん……同じ暗号だな」「何かわかったかね」傍から博士が心配そうに覗きこむ。",
              "citation": {
                "source": "危し※　潜水艦の秘密",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴクロウサマ　スミタル　ウエハ　コレデ　シツレイ　オチノビル　ヤンセン」「そうだ牧師ヤンセン、メリケン壮太を雇ったのも牧師、まさに此奴だ※」　そう叫んだが――さてそれだけの文章では何がなにやら訳がわからない。",
              "citation": {
                "source": "危し※　潜水艦の秘密",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔々の話の終りはいずれもコレデドンドハレという語をもって結ぶなり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
