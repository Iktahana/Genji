          "literary": [
            {
              "text": "」「コノオレ……をかしな名前をいふな。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノオレといふのはお前か。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、コノオレの子供がゐません。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノオレが盗んでいつた。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノオレをふんじばつてしまへ。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノオレが、金の猫を盗んでしまつた。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノオレをひつとらへて、切りきざんでしまへ。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノオレをつかまへろ。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノオレを切りきざんでしまへ。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ばかども、あのコノオレだ。",
              "citation": {
                "source": "金の猫の鬼",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコノオバアサンハ、マイニチ、コンナフウニクラシテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「ハテナ、ドコノオ子サンダツタカシラン。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタグサ、ネコノオ、モウズイカ、ジョンスワート、ハードハック、メドースウィート、そのほかの丈夫な茎をもった植物――いちばん早い鳥をもてなす食べきれない穀倉――もある。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オバチャマ、コノオ洋服、アリーノママガネエエ、ミシンデヌッテクダサッタノオ」　自分のことを、アリー、アリーと呼んでいた。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タビ／＼申シ上ゲル通リ、コノオ痛ミハ脳中枢カラノ原因ガ二三分、他ノ六七分ハ頸椎ノ生理的変化ニ依ル神経痛ト云ウコトニ、レントゲン検査ノ結果診断ガツイテオリマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "純』『アノネ、コノオ店デタラネ、十カゾエルアイダニキスヲシテネ』『出発』『出発』　……筆談は、どうやらそこで終っていた。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
