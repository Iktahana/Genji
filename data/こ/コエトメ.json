          "literary": [
            {
              "text": "また小鳥の鳴声止み、陽が輝き始める。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "疾風は林を掠め、森を掠め、野を掠め、雲乱れて飛び、蜩の泣声止んで、寂寞として天地は静まりかえった。",
              "citation": {
                "source": "森の妖姫",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕下りて後も、アヌンチヤタ、アヌンチヤタと呼ぶ聲止まねば、歌女は面を幕の外にあらはして、謝することあまたゝびなりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "喝采の聲止まずして、幕の外に出でゝ謝すること再びなりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
