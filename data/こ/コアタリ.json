    "definitions": [
      {
        "index": 1,
        "gloss": "sounding someone out",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "部長は新入社員の様子を探るように、冗談交じりに小当たりを入れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は相手の反応を見るために、慎重に小当たりしてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あまり小当たりばかりしていると、相手に不信感を与えてしまうかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "じゃ、きさま、小当たりに当たってみたな」　すると、意外にも右門がちゃんとその事件を知っていて、あごを伝六にささえさせたまま話に乗ってまいりましたものでしたから、おしゃべり屋が急に活気づきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりあえず、小当たりにやって来たところさ」「なんだ、ねた洗いだったのですかい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "達磨を好く遊女",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ、小当たりに当たってみて貰おうか』　と言った。",
              "citation": {
                "source": "縁談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その癖心では内へ入れてもう一度｜懲りずまに小当たりに当たって見たいとも思うのであった。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめ、雲のために、いただきが見えず、私は、その裾の勾配から判断して、たぶん、あそこあたりが、いただきであらうと、雲の一点にしるしをつけて、そのうちに、雲が切れて、見ると、ちがつた。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこあたりにも、段々都会の女達が入つて行くやうになるであらうと思はれた。",
              "citation": {
                "source": "女の温泉",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここあたりによく見るタイプで、言葉には時々｜武州訛が交る。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふり返ると、暗い闇を通して、そこあたりと覚しきところにはたして火光があざやかに照って見えた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこあたりはもう芽を吹きだしてまいりました。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれほどの高貴の人々が、ここあたりをこの早暁に、何用あって歩いていたぞ」「思うところあって家を出で、加賀へ参る道程、ここあたりを通ったのじゃと、老人の方が申されました」「奇怪の奴らじゃ、いかに高貴とはいえ、小判一枚持たぬ身で、はるばる加賀まで参るとは、恐らく狂人か白痴であろうぞ！",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこあたりから商売を始めようと思って」「商売って、映画の？",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここあたりの物が、講談の宮本武勇伝の出所らしい。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "後でお小夜がなりひらに、Ｔ「雲霧主膳ッて何んな野郎か」　と言って、Ｔ「明日妾が小当りに当ってみらァね」　と言う。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角、人間中年過ぎになると、恋愛も結婚も露骨に打算的に形をとるのだろうが、言ってみれば、まあ一つ小当りに当ってやれ――そんな野次馬めいた気分から、ヘルグライン、止せばいいのに――ほんとによせば好いのに――この未知の「美貌の寡婦」宛てに早速一筆啓上したものだ。",
              "citation": {
                "source": "斧を持った夫人の像",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、戯け乍らオウオソ町北ヒッコリイ街九〇八番のホテリング方を訪れた刑事達は、それでも、念のため小当りに当ってみる気が、底にあったのだ。",
              "citation": {
                "source": "双面獣",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいか、小当りに当って下手にごてりやがったら、かまうことあねえ、ちっとばかり痛めてやれ。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "宇治の茶箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "この奇妙なる文献の山と、彼らのくそ真面目な顔とを見くらべて、もしや彼らが十二月八日をショックとして云いあわせたように気が変になったのではないかと疑念を抱かせるものがあるのであったが、二三の者に小当りに当ってみた結果によると、変になったわけでもないらしい。",
              "citation": {
                "source": "不沈軍艦の見本",
                "author": "――金博士シリーズ・10――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その苦手にさえ、ここでは小当りに当ってみたくなるような気分になったのみならず、「あのがんりきというやつ、あんな奴さえこのごろは音も沙汰もない」とつぶやきました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　女をくどくや先づ小当りに当つて見て駄目らしければ退いて様子を窺ふ気合、これ己を知るものなり。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとて気ざな咳払ひして据膳ならでは喰ひやせぬといふほどの自惚もなければ、まづ小当りに当つて出来やすきを取る。",
              "citation": {
                "source": "桑中喜語",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "小艶に小当りに当って、こっぴどくはね飛ばされた口ですから――あの女は玉の輿に乗る気でしたよ」　竹乗りの玉之助はそんなことまでツケツケ言うのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "吹矢の紅",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「直次郎はお絹に小当りに当ったが、ひどく嫌われた腹立ち紛れ、与之助に誘われて桟敷の一方の縄を切っただけさ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "鬼の面",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ガラッ八なんざ、小当りに当っても、口も利かないわけだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "八人芸の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「楊弓の巧い人間に心当りはないかえ」　平次が小当りに当ると、「芝の五郎、未磧なんてのは？",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "大村兵庫の眼玉",
                "note": "青空文庫"
              }
            },
            {
              "text": "小当りに当ってみても温順の如く鄭重に、或いは鄭重の如く温順に受流す許りで、短気なところなど爪の尖ほどもみつからなかった。",
              "citation": {
                "source": "評釈勘忍記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小当りにちょッと金蓮の“気”を引いてみたまでのことだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで嘘か実か、小当りに一当て襲せてみよというので、にわかな出陣なのだ」「はてな？",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "美濃への出陣は、去年の秋ぐちから再三のことであって、その都度、木曾川の国境を、衝いては引き、また越えては退り、彼の反撥を小当りにあたってみるような小競り合いを繰り返していたものである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし李典は、城内の空気に、なにか変な静寂を感じたので、「一応、われわれが、城門へぶつかって、小当りに探ってみますから、御大将には、暫時、進軍をお待ちください」と、忠言してみた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがし城外へまかり向って、およそ寄手の兵気虚実をさぐる程度に、小当りに当ってみましょう。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
