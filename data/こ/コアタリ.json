        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "パチンコでなかなか大当たりが出ないが、小当たりで少しずつ玉を増やしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今日はお金を使い果たしてしまったけど、最後に小当たりが出て少しだけ取り戻せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "小当たりでも、積み重なれば大きな勝ちに繋がることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
