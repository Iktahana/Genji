        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "雪のむら消えた砂浜には、けさと同様に女たちがかしこここにいくつかの固い群れになって、石ころのようにこちんと立っている。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪解時の泉のように、あらん限りの感情が目まぐるしくわき上がっていたその胸には、底のほうに暗い悲哀がこちんとよどんでいるばかりだった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "親身に持ちかけてみたり、よそよそしく取りなしてみたり、その時の気分気分で勝手な無技巧な事をしていながらも、どうしてものがれ出る事のできないのは倉地に対するこちんと固まった深い執着だった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "物の輪郭が円味を帯びずに、堅いままで黒ずんで行くこちんとした寒い晩秋の夜が来た。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は泣くにも泣かれないでかたくなったままこちんとお婆様の前に下を向いて坐りつづけていました。",
              "citation": {
                "source": "溺れかけた兄妹",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "円山さんというのがいったい西洋窓のついた日本座敷みたいに、こちんこちんした無愛想な男だ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は石ころのやうにこちんとした体と心とになつて自分の床に帰つた。",
              "citation": {
                "source": "An Incident",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の心は本当に石ころのやうに冷たく、冷えこむ冬の夜寒の中にこちんとしてゐた。",
              "citation": {
                "source": "An Incident",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お末はこちんと石のやうに押し黙つて、哲に添寝をして向うむきになつて居た。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "玻璃のふらすこちんたの酒はきらきら光る。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "脅えたように叫んだ一人はつと浮き腰になり、すぐ何かいすくめられたように身体をこちんと固くした。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思われるほど白く、こちんとかたまった顔をお爺さんのわきに並べた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはほんとうですか」「そうだ、そのとおりだ」　それを聞くと、黒人たちは、たちまち別の人間のようになり、たがいに、ばたばたこちんこちんと、機械の修理にかかりました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "近づくにつれて、彼等の顔には、この殺気立った空気と結びつくことのできないような、冷たくこちんとした感情が翳のように沁みついていることがハッキリわかった。",
              "citation": {
                "source": "早稲田大学",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それにもかかわらず、この狭苦しい生活の中で、こちんと心にふたをしたような独善的な感情だけが一日ごとに目立ってくる。",
              "citation": {
                "source": "十三夜",
                "author": "――マニラ籠城日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかするといま喰べたばかりの物が胃の中でこちんと凍ってしまいそうにさえ思った。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家々は、賢き陪臣、ニコチンに、汚れたる歯を押匿す。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "秩序ある生活と、アルコールやニコチンを抜いた清潔なからだを純白のシーツに横たえる事とを、いつも念願にしていながら、私は薄汚い泥酔者として場末の露地をうろつきまわっていたのである。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "匙を持つ手は、ヘロ中の結果、ニコチン中毒のひどい奴より、もっとひどくブル／＼ふるえた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニコチン中毒で冷たく乾燥した手の掌を頭の毛に摺りつけては、その触覚を取戻そうと努めながら口の中でいっている。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは支那戦のニコチン戦役にもらったのじゃ。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日四十本以上吸うのは、絶対のニコチン中毒だということだが、私の喫煙量は高等学校時代に、既にその限界を超えてしまったのだ。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時ホテルの受付へでも届けてやるという親切があなたにあれば、一生恩に着ますよ」「まア、そんなにマッチが……」「凄いニコチン中毒でね」「じゃ、届けてあげますわ、仕方がない」「何時頃……？",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術という料理の美味も時に人を酔わす、その酔わせる成分には前記の酒もあり、ニコチン、アトロピン、コカイン、モルフィンいろいろのものがあるようである。",
              "citation": {
                "source": "コーヒー哲学序説",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷々然として落着き澄まして、咳さえ高うはせず、そのニコチンの害を説いて、一吸の巻莨から生ずる多量の沈澱物をもって混濁した、恐るべき液体をアセチリンの蒼光に翳して、屹と試験管を示す時のごときは、何某の教授が理化学の講座へ立揚ったごとく、風采四辺を払う。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、公衆は、ただ僅に硝子の管へ煙草を吹込んで、びくびくと遣ると水が濁るばかりだけれども、技師の態度と、その口上のぱきぱきとするのに、ニコチンの毒の恐るべきを知って、戦慄に及んで、五割引が盛に売れる。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と面啖って我知らず口走って、ニコチンの毒を説く時のような真面目な態度になって、衣兜に手を突込んで、肩をもそもそと揺って、筒服の膝を不状に膨らましたなりで、のそりと立上ったが、忽ちキリキリとした声を出した。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "シイトの薄萠黄の――最も古ぼけては居たが――天鵝絨の劃を、コチンと窓へ上げると、紳士の作法にありなしは別問題だが、いゝ頃合の枕に成る。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎角コチンコチンコセコセとした奴らは市区改正の話しを聞くと直に日本が四角の国でないから残念だなどと馬鹿馬鹿しい事を考えるのサ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその時になつてはじめて、顏から手から胸のあたりまで、ニコチンでべとべとしてゐることに氣づいた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
