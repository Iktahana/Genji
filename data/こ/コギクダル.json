          "literary": [
            {
              "text": "二階の縁側に置いてある籐椅子の上に足を投出して、目の前の川を漕ぎ下るボートを見るのが楽しみだった。",
              "citation": {
                "source": "大人の眼と子供の眼",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は綾瀬口の渡しを越えて向う河岸の枯蘆の間に身を潜めながら、農科の艇の漕ぎ下るのを待っていた。",
              "citation": {
                "source": "競漕",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "大川を漕ぎ下る夜船の櫓音が泣くように軋んでゆく。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
