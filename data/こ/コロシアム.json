        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「わぁ、あのコロシアム、写真で見るよりずっと大きい！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ローマのコロシアムは紀元80年に完成した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "コロシアムの遺跡を観光した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "２　Palladian ――文芸復興期のイタリアの有名な建築家 Andrea Palladio（一五一八―八〇）が古代ローマのコロシアム、大浴堂、凱旋門、その他の非宗教的建築物の研究に基づいて創始した建築様式。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『コロシアムだ、大きな丼鉢のようだがあの容量は八万人だ。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人の日本人がコロシアムの壁上に立って、タマルパイの彼方に沈む紅い夕陽を眺めていると、六時の時報が高塔から響き出した。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
