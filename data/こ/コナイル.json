        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この時、勇士コナイル・カルナ及び彼の有名なる少年英雄クウフリンの二人だけはコノール王に信義を守って敵方に行かず、神々の御心に背いてまでも花々しく勇戦したのであった。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノール　コナイル・カルナはわしの味方だ……そしてあの驚くべき青年クウフリンも。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは、コナイル・カルナとクウフリンを連れて、お前たちの先頭に立とう。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日こそわしはお前等を従えて行こう――わしと、「必勝者」コナイルと、愛蘭一の勇士クウフリンとで！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
