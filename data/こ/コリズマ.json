        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "沈みしも忘れぬものを懲りずまに身も投げつべき宿の藤波　と歌いながら院はお悩ましいふうで戸口によりかかっておいでになるのを、中納言の君はお気の毒に思っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            },
            {
              "text": "身を投げん淵もまことの淵ならで懸けじやさらに懲りずまの波　と女は言った。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　庸三は懲りずまに、また葉子に逢いに行った。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "婚礼｜談が出るようになってから、作は懲りずまに善くお島の傍へ寄って来た。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "婚礼談が出るようになってから、作は懲りずまに善くお島の傍へ寄って来た。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死にはしないぞ」　不思議な事にはそのぶっ倒れた男を見るにつけて、また漁夫たちの不安げな様子を見るにつけて、君は懲りずまに薄気味悪くそう思いつづけた。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜平は番頭に叱られ、茂八は主人に叱られたのであるが、それが近所にも知れ渡って、自分たちが弱虫であるように云いはやされるのが、如何にも残念でならないので、どうかして自分たちをおびやかした獣の正体を見あらわしてくれようと、二人は相談の上でまた懲りずまに清水山探検を試みた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "柳原堤の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は猶懲りずまにこの目覚き美形の同伴をさへ暫く目送せり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのお前が懲りずまにまた人を思ふといふのかと自分に言つてきかせる歌のやうにもとれるが、ほんとうは人称がないので私には見当がつかない。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "懲りずまに、人影が一団となって追って来る。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーッとどよめいて敵は引いたが、懲りずまた箭をハラハラと射かけた。",
              "citation": {
                "source": "弓道中祖伝",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、懲りずまにもう一人が、刎ねるがように切り込んで来た。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっとこさで鉞を切り株から抜いて、懲りずまにそいつをまたふりかぶり、「おのれ――ッ」　と繰り返して刻み足して進んだ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日も翌々日もその翌日も、寄せ手は懲りずまに攻めよせたが、そのつど正成の奇計によって、退却させられる憂目ばかりを見た。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その癖心では内へ入れてもう一度｜懲りずまに小当たりに当たって見たいとも思うのであった。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、懲りずまた寄せ来る敵。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「峠道での手並みにも懲りずまたも掛かるとは身のほど知らず、見れば人数も三、四十人、蹴破って通るには手間暇はいらぬ。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また懲りずまに切り込んで来た。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「懐中も冷めてえが、浮世も冷めてえ」首を縮めてヒョロヒョロと歩くと、また懲りずまに門に立ち、河東節の三味線を弾き出した。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生死は知らず三人あまり、紀州藩士を斬って仆し、懲りずまに尚もかかって来る藩士を、刀上段に振りかぶり、睨みながらあしらっていた。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、懲りずまにまた追う藩士！",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浪子さん」　千々岩は懲りずまにあちこち逸らす浪子の目を追いつつ「浪子さん、一言いって置くが、秘密、何事も秘密に、な、武男君にも、御両親にも。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "案内はいらんです」　「だって」　「僕は一人で歩く方が勝手だ」　これほど手強く打ち払えばいかなる強敵も退散すべしと思いきや、なお懲りずまに追いすがりて　「そうお逃げなさらんでもいいわ」　武男はひたと当惑の眉をひそめぬ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "案内はいらんです」「だって」「僕は一人で歩く方が勝手だ」　これほど手強く打ち払えばいかなる強敵も退散すべしと思いきや、なお懲りずまに追いすがりて「そうお逃げなさらんでもいいわ」　武男はひたと当惑の眉をひそめぬ。",
              "citation": {
                "source": "小説　不如帰",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "米友が棒を振り廻せば犬は心得てそれを避け、棒を控えていれば懲りずまたすぐに傍へ寄って来て、吠えてみたり、鼻を鳴らしてみたり、身体を擦りつけようとしてみたり、ずいぶん人を食った犬としか思われません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "如法闇夜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらは丸う出直せし旦那の智恵｜嚢、かへつて直接談判で、曖昧の局を結んだ方が、どうやら身腹の痛まぬ訳と、そこは手練の好文句、山鳥の尾のながながしき手紙でのお呼び出しも、懲りずまに二度三度。",
              "citation": {
                "source": "今様夫婦気質",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと云うのもあなたを思う熱情が足りない證拠だと仰せになるかも知れませんが、去年以来どんなにあなたに嘲弄されてもなお懲りずまに通って来る私と云うものに、少しでも不憫をかけて下さるのであったら、せめてもう一度だけ、此の間の晩のような機会を恵んで下さらないであろうか。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
