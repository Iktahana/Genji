          "literary": [
            {
              "text": "長楽　宮中　雲気散じ、朝元　閣上　雨声収まる。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "アートレ，デース、おほいなる劍の鞘の傍に帶べる短刀引き拔きて、野猪の頭の一｜總の粗毛をさくと切り落し、双手を擧げて神明に祈凝せば、アカイアの衆軍ひとしく聲收め、　255皆蕭然と元戎に耳傾けて座に並ぶ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
