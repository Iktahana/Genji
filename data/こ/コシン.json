[
  {
    "uuid": "f0446d69-9451-51ff-a239-fd91944b8792",
    "entry": "湖心",
    "reading": {
      "primary": "こしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
