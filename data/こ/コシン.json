      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "center of a lake (centre)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ボートを漕いで湖心まで行くと、岸の喧騒が嘘のように消えて静寂に包まれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "湖心の正確な水深を測るため、最新の測定機器を搭載した調査船を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の寒さが厳しくなると、湖心まで分厚い氷に覆われてスケートができるようになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "食後の小憩を未醒氏渚の扁舟に棹さして湖心に出づ。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖心に櫓の音を聞くばかり、心耳自から清んだ、と思ふ。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨がやんで、夫は逃げるようにそそくさと出かけ、それから三日後に、あの諏訪湖心中の記事が新聞に小さく出ました。",
              "citation": {
                "source": "おさん",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "某日、太陽が湖心の真上を過ぎてから西岸の山毛欅の大樹の梢にかかるまでの間に、三度以上雷鳴が轟いたなら、シャクは、翌日、祖先伝来のしきたりに従って処分されるであろう。",
              "citation": {
                "source": "狐憑",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "某日、太陽が湖心の眞上を過ぎてから西岸の山毛欅の大樹の梢にかかる迄の間に、三度以上雷鳴が轟いたなら、シャクは、翌日、祖先傳來のしきたりに從つて處分されるであらう。",
              "citation": {
                "source": "狐憑",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖心と見るあたりに黒雲捲き騰り、娘の声として「自分はこの沼の主となった。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "卒爾に見ていると判りませんが、こまかく気をつけると、湖心から風上へ揺り戻る浪のはためきで渚の結氷は二寸三寸ずつ壊れて欠けて、湖心へ向け散って行きます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今や氷は、柔い雪をかぶったまゝ二坪三坪ほどの面積となって湖心へ向け漂い始めます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖心寺という寺が堤に沿うて湖の中にあった。",
              "citation": {
                "source": "牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一つを門へ貼り、一つを榻へ貼るがいい、そして、これから、二度と湖心寺へ行ってはならんよ」　喬生は家へ帰って、魏法師の言ったように朱符を門と榻へ貼ったところで、怪しい女はその晩から来なくなった。",
              "citation": {
                "source": "牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の体は湖心寺の前へ来ていた。",
              "citation": {
                "source": "牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろ考えた結果、湖心寺の棺桶のことを思いだして、付近の者を頼んでいっしょに湖心寺へ行って、棺桶のある室へ行ってみた。",
              "citation": {
                "source": "牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方になって湖の中に通じた路を帰っていると、そこに湖心寺と云う寺があったので、ちょっと休んで往こうと思って寺へ入り、東の廊下を通って西の廊下へ往ったところで、廊下の往き詰めに暗室があって、そこに棺桶があって紙を貼り、故の奉化府州判の女麗卿の柩と書いてあった。",
              "citation": {
                "source": "牡丹燈籠　牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "魏法師は喬生に二枚の朱符をくれて、一つを門に貼り一つを榻に貼るように云いつけ、そのうえで二度と湖心寺へ往ってはいけないと云って戒めた。",
              "citation": {
                "source": "牡丹燈籠　牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月あまりして袞繍橋に住んでいる友人の許へ往って酒を飲み、酔って帰ったが魏法師の戒を忘れて湖心寺のほうの路から帰って来た。",
              "citation": {
                "source": "牡丹燈籠　牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喬生の隣家の老人は喬生が帰らないので、あちらこちらと尋ねながら湖心寺へ来て、暗室へ往ってみると柩の間から喬生の衣服の裾が微に見えていた。",
              "citation": {
                "source": "牡丹燈籠　牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖心寺と云う寺が堤に沿うて湖の中にあった。",
              "citation": {
                "source": "牡丹燈籠　牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一つを門へ貼り、一つを榻へ張るが好い、そしてこれから、二度と湖心寺へ往ってはならんよ」　喬生は家に帰って魏法師の詞に従って朱符を門と榻に貼ったところで、怪しい女はその晩から来なくなった。",
              "citation": {
                "source": "牡丹燈籠　牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろ考えた結果、湖心寺の棺桶のことを思いだして、附近の者を頼んでいっしょに湖心寺へ往って、棺桶のある室へ往ってみた。",
              "citation": {
                "source": "牡丹燈籠　牡丹燈記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕照りうららかな四囲の若葉をその水面に写し、湖心寂然として人世以外に別天地の意味を湛えている。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖畔の路はわづか十五六町なれど、宿の舟あれば、乘りて湖心に出でて、眺望を縱まゝにするも亦一興と、舟を頼みおきしに、朝起き出づれば、『老人は舟を漕ぐことを知らず』とて斷り來たる。",
              "citation": {
                "source": "赤城山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸から二三寸の深さが汀から二三間ずつ相続き、さきは小波が輝いてよく見えぬが湖心でも三四尺どまりの深さだろうという。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "月はいつか、湖心を去って、うしろの山の端近く移っていた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初は、身を切るように感じていた水の冷たさが、いつの間にかわからなくなったと思うと、青く湖心にすんでいる月の光が、朦朧となり、両腕に抱えている倭文子の顔が微笑したと思うと、彼はこの愛すべき倭文子をどうしてもはなすまいと、もう一度決心し直すと同時に、自分自身を失ってしまった。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "朦朧とした月の光の射した水の上に岸を離れたばかりの小舟が浮んで、それが湖心のほうへ動いていた。",
              "citation": {
                "source": "ある神主の話",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが一種の神事となって今も廃れず、大祭当日には赤飯を入れた白木の唐櫃を舟にのせて湖心に漕ぎ出で、神官が祝詞を唱えてそれを水中に沈めるのを例とし、その前夜に燈籠流しを行なうことは前に云った通りである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「遠くからお出やして、こんなとこしんきだっしゃろ？",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「遠くからお出やして、こんなとこしんきだっしゃろ……。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
