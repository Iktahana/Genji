        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一雄ハ深イ所デ泳イデモ危イコトハアリマセン。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケサノコノ走リ書モマタ、純粋ノ主観的表白ニアラザルコトハ、皆様承知。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒトノ後ヲ尾行シタリ隣室ヘハイツテ散々俺ノ悪口ヲ言ツタリ、俺ノ生活ヲ覗イタリスルコトハ、今後絶対ニヤメテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ誰モ俺ニ構フコトハ出来ナイゾ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シコトハシメタカヘン」といふ電報を弟あてにして打つた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニシロ　オカネガ　アリマセンノデ、キシヤヤ　ジドウシヤニ　ノル　コトハ　デキマセン。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミズハ　フカイノデ　トテモ　ジブンデ　ヒロフ　コトハ　デキマセン。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ　グアヒデ　コドモノ　タヌキハ　ナカナカ　ウマク　バケル　コトハ　デキマセンデシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧富ヲ無視シタル劃一的平等ヲ考フルコトハ誠ニ社會萬能説ニ出發スルモノニシテ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ小地主ト小作人ノ存在スルコトハ神意トモ云フベク、且ツ社會ノ存立及發達ノ爲メニ必然的ニ經由シツツアル過程ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レニ反シテ、此ノ私有地限度超過ヲ徴集スルコトハ近代的所有權思想ノ變更ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ大地主ノ土地ヲ徴集スルコトハ最高ノ所有者タル國家ノ權利ニシテ國有ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ動カスベカラザル原理ハ、都市ノ住宅地ト異ナリテ農業者ノ土地ハ資本ト等シク其經濟生活ノ基本タルヲ以テ、資本ガ限度以内ニ於テ各人ノ所有權ヲ認メラルル如ク、土地亦其限度内ニ於テ確實ナル所有權ヲ設定サルルコトハ國民的人權ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人類ヲ公共的動物トノミ考フル革命論ノ偏向セルコトハ、私利的欲望ヲ經濟生活ノ動機ナリト立論スル舊派經濟學ト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大資本ガ社會的生産ノ蓄積ナリト云フコトハ社會主義ノ原理ニシテ明白ナルコト説明ヲ要セズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ大資本ガ私人ノ利益ノ爲ニ私人ノ經營ニ委セラルルコトハ、人命ヲ殺活シ得ベキ軍隊ガ大名ノ利益ノ爲ニ大名ニ私用セラルルコトト同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民膏血ノ貯金又ハ事業ノ運命ヲ決スベキ預金等ガ銀行ノ破産ニヨリテ消散スルコトハ國民生活ノ一大不安ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來臺灣ノ幾十倍ナル大領土ヲ南北滿州及ビ極東西比利亞ニ取得スベキ運命ニ於テ、同一ナル罪惡ヲ國家國民ノ責任ニ嫁セラルヽコトハ日本ノ國際的威嚴信用ヲ汚辱シ、土地ノ國際的分配ノ公正ノ爲メニ特ニ日本ノ享有セル領土擴張ノ生活權利ヲ損傷シ、如何ナル大帝國建設モ百年ノ壽ヲ全ウスル能ハザルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自己ノ私利ヲ目的トスル資本制度ニ依頼シテ晏如タルコトハ、今日及ビ今後日本ノ國際的危機ノ忍ブ能ハサル所ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ徴集シ得ベキ資本ノ概算ハ推想スルヲ得ベキモ、其眞實ヲ去ル甚ダ遠キコトハ○○○○○ノ調査徴集ヲ必要トスル所以ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ、勞働的株主ヲ併存セシムルコトハ内容的根本的ニ常ニ該事業ヲ健確ニ支持スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ其ノ女ガ他家ニ嫁シテ餘力アル者ト雖モ、其老親ノ扶養ヲ夫ノ資産勞働ニ依頼セシムルコトハ、父母ノ屈從不安ヲ招キ更ニ婦人ヲシテ夫ノ前ニ其ノ人格的尊重ヲ傷クルニ至ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民教育ニ於テ英語ヲ全廢スベキハ勿論、特殊ノ必要ナル專攻者ヲ除キテ全國ヨリ英語ヲ驅逐スルコトハ、國家改造ガ國民精神ノ復活的躍動タル根本義ニ於テ特ニ急務ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "成年者ガ三月又ハ半年ニテ足ル國際語ノ修得ガ、中學程度ノ兒童一二年ニシテ完成スベキコトハ、英語ガ五年間沒頭シテ尚何ノ實用ニ應ズル完成ヲ得ザル比ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語ノ統一ナクシテ大領土ヲ有スルコトハ只瓦解ニ至ルマデノ槿花一朝ノ榮ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ下掲ノ如ク日本國民ハ永久ニ兵役ノ義務ヲ有シ、且ツ一年志願兵特權ハ此等ノ訓練アルヲ一理由トナスヲ以テ其レヲモ廢止スルガ故ニ、兵役ニ於テスベキコトハ凡テ兵營ニ於テスベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ中學程度ノ男生徒ニ制服トシテ靴洋服ヲ強制スルコトハ實ニ門戸閉鎖ノ有力ナル一理由ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ノ姦通罪ヲ罰スルコトハ第一ニ一夫一婦タル國民道徳ノ大本ヲ明カニスルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
