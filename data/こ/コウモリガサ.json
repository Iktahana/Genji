[
  {
    "uuid": "b668ad9d-89e0-5091-a3d4-bdae081a787e",
    "entry": "こうもり傘",
    "reading": {
      "primary": "こうもりがさ",
      "alternatives": [
        "コウモリがさ"
      ],
      "is_heteronym": true
    },
    "grammar": {
