        "examples": {
          "standard": [
            {
              "text": "商店街には、昔ながらの雰囲気を持つ小売り店が軒を連ねている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しいスマートフォンは、大手家電量販店の小売り店で先行販売される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は自分で作ったアクセサリーを、地元の小売り店で販売している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いつもは美しく飾り立てた小売り店の表には、実に見すぼらしい明治時代の雨戸がしめてある。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
