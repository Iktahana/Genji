[
  {
    "uuid": "8b6c616a-2537-523f-9f21-0a668317e0b2",
    "entry": "項目",
    "reading": {
      "primary": "こうもく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
