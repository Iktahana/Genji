        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は初めての恋煩いで、すっかり食欲をなくしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人が恋煩いで元気がないので、心配して話を聞いてあげた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「恋煩いかあ、青春だね」と、先輩は笑いながら言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その貴下、うたゝ寝の歌を、其処へ書きました、婦人のために……まあ、言って見ますれば恋煩い、いや、こがれ死をなすったと申すものでございます。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "華族の金満家へ生れて出て、恋煩いで死ぬ、このくらいありがたい事はありますまい。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「じゃ、私が見ても恋煩いをしそうですね、危険、危険。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大町人の娘が、恋煩いをして、主治医が診察に見えたという有様。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそよは十八、おつぎは十六、どっちも年頃の若い娘であるから、世にいう恋煩いのたぐいではないかとも疑われたが、ひとりならず、姉妹揃っておなじ恋煩いというのも少しおかしい。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君だって恋煩いなんかした事はなさそうじゃないか」と主人も正面から細君に助太刀をする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんないまどき流行らない恋煩いをしている娘というのは。",
              "citation": {
                "source": "おじさんの話",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "山から帰ってから、親分は夜の稼ぎに身が入らずに、昼も、まるで腑が抜けたように考えこんでばっかり、青息吐息――十八島田の恋わずらいじゃアあるめえし、人は知らねえが、ぼんのう小僧ともあろうものが見ていて、あっしゃあ小じれってえよ親分。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物に来るうちはまだよかったのですが、だんだん自転車美人の評判が高くなるにつれて、付文をする者が出来て来たり、風雲堂という薬屋の息子さんは、私に恋わずらいをしてとうとう死んじまったとか、私がなんにも知らないのに、世間のうるさいったらお話にならないのです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋わずらいだ」　娘を背負って、スタスタ歩き去ってしまった。",
              "citation": {
                "source": "牛",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、わたしはそのような恋わずらいが男性にとっては致命的になることが稀れだと思う。",
              "citation": {
                "source": "傷心",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからと申すもの、兄はこの眼鏡の中の美しい娘が忘れられず、極々内気なひとでしたから、古風な恋わずらいをわずらい始めたのでございます。",
              "citation": {
                "source": "押絵と旅する男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
