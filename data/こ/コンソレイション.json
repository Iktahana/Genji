          "literary": [
            {
              "text": "苦痛の中にそのものが描かれてゆくことのなかに、大きい一つのコンソレイションがあるべきです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（哲学的に、ね）文学の面白さとこの人間精神のコンソレイションの関係は面白いこと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説の面白さと精神のコンソレイションの話。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
