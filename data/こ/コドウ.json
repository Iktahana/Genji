  {
    "uuid": "9862b3d2-4239-549c-ac0e-c3060dafdef2",
    "entry": "古銅",
    "reading": {
      "primary": "こどう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
