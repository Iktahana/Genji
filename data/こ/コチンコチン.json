        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "初めてのプレゼンで、彼は緊張のあまりこちんこちんになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験中、難しい問題に直面して頭がこちんこちんになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "人前で話すのが苦手で、いつも体がこちんこちんに固まってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
