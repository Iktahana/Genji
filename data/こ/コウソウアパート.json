          "literary": [
            {
              "text": "ハッピー・ヴァレーの住民たちがここを追い出されてから収容される予定になっている、高層アパートメントの写真から起こした絵だった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の部屋は、都心に近い高層アパートの、それも最上階にあった。",
              "citation": {
                "source": "メリイ・クリスマス",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が、どこからどうやってこの高層アパートの最上階に来たのか、彼女の正体はなにか、そんなことはどうでもいいと思った。",
              "citation": {
                "source": "メリイ・クリスマス",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
