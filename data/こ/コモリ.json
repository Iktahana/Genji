  {
    "uuid": "0cc26b67-fec2-52a3-8eae-ff288ca4f4a8",
    "entry": "籠もり",
    "reading": {
      "primary": "こもり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
