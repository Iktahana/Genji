    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "白糸は始めに口籠もりたりしが、直ちに心を定めたる気色にて、「処女のように羞ずかしがることもない、いい婆のくせにさ。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬籠もりをした汽船は、水上にぬぎ忘れられた片足の下駄のように、氷に張り閉されてしまった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころ猪野の詐欺横領事件は、大審院まで持ち込まれ、審理中であるらしく、猪野はいつも憂鬱そうに、奥の八畳に閉じ籠もり、酒ばかり呑んでいた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくては所詮、我｜業の進まむこと覚束なしと、旅店の二階に籠もりて、長椅子の覆革に穴あけむとせし頃もありしが、一朝大勇猛心を奮ひおこして、わがあらむ限の力をこめて、この花売の娘の姿を無窮に伝へむと思ひたちぬ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪に閉じ籠められて働けない冬｜籠もりの期間は、馬鈴薯と南瓜ばかり食っているために、春になると最早、顔が果物のように黄色を帯びて来て、人間の肌色を失っているのだった。",
              "citation": {
                "source": "熊の出る開墾地",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山路になりてよりは、二頭の馬｜喘ぎ喘ぎ引くに、軌幅極めて狭き車の震ること甚しく、雨さえ降りて例の帳閉じたれば息籠もりて汗の臭車に満ち、頭痛み堪えがたし。",
              "citation": {
                "source": "みちの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らが幾月も幾年もの間不自由な土窖に閉ぢ籠もり、あるかなきかの生活を繰り返してゐるうちに、彼らの見えざる眼は、絶えず渇けるもののやうに一滴の光明にもあくがれ、彼らの息苦しい呼吸は、飢ゑたるもののやうに、いつも新鮮な大気を欲しがつたのに相違ない。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりその薩州小判で、蓮池の自宅の奥に数寄を凝らいた茶室を造って、お八代に七代とかいう姉妹の遊女を知行所の娘と佯って、妾にして引籠もり、菖蒲のお節句にも病気と称して殿の御機嫌を伺わなんだ。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あなたは……まだ……助手を……お持ちに……ならないのでしょう……」　少年はこう言って急に口籠もりながらじっと私の顔を見た。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "口籠もり口籠もり云った。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "かゝる山間の、人の通ふとも見えぬ小径の奥に立て籠もり、禁断の像を祭り居る今の和尚は、よも一筋縄にかゝる曲者にはあらじ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて残りたる米を粥に作りて何の味ひも無く腹を満たし、梅干、塩、味噌なぞを嘗めながら、日もすがら為す事も無く方丈に閉て籠もり、前の和尚の使ひ残したる罫紙を綴ぢ、今までの事を斯様に書き綴り行く程に思ひの外に筆進まず。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆から顔を見られて、娘は恥かしそうに口籠もりましたが、とうとう思い切って、「その訳はこの書物にすっかり書いて御座います」　と云いながら、懐から黒い表紙の付いた一冊の書物を出しました。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて同年夏、会津の川上温泉に立て籠もり日本文の参考資料に熱心に目を通した。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "巣籠もり眠ったに相違ない。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処に筒井松蔵といふは、松太郎の実の弟なりしが、兄の仇を討たんずものと、主君因幡守に暇を乞ひ、ただ一人にて出立せしが、巡り巡つて三年越し、更科の郡｜姨捨山の、月見堂の傍まで来かかる折柄、人住めるとも思はれぬ荒れ廃たれたる茅屋ありて、人の呻く声の聞ゆるに、こは怪しと覗き見れば二人の男女籠もり居たり。",
              "citation": {
                "source": "高島異誌",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さあその後あのお二人、琢磨氏と葉末さんとは、どんなくらしをしているやら、参ったこともありませんので、とんと一向存じませんが、琢磨氏は学者で人格者、恐らく独身で書斎に籠もり、その西洋の学問なるものを、勉強していることでございましょう。",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳営｜絵所預りは法眼｜狩野融川であったが、命に応じて屋敷に籠もり近江八景を揮毫した。",
              "citation": {
                "source": "北斎と幽霊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　斯ういうことがあってから、天草、島原、長崎などで、「天童降来、教義布衍」こういう言葉が流行し圧迫され又虐げられていた切支丹宗徒に力を付けましたが、翌、寛永十四年に果然世に云う天草一揆が先ず天草に勃発し次いで島原の原ノ城に籠もり幕府に抗するようになりました。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は自分の家へ帰ると部屋の中へ閉じ籠もり何やら熱心に考え出した。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上ただ今も申しましたとおり、郷民の心に偽りなく、弓矢取ってはことごとく武夫、で大塔宮様ご一行など、この地にお籠もりあそばされて、関東討伐北条氏覆滅の、策源地なんどにいたしましたならば、まことに恰好と存ぜられまする。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それであらゆる遍歴をして、ながい間籠もりきりでもって幾らやっても通じない。",
              "citation": {
                "source": "生活と一枚の宗教",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五日と十六日とは、食事の外用事もないままに、書室へ籠りとおしていた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い女の人などが、すつかり上氣せ上つて、頬を眞赤にして、眼までうるませてゐるのを見たりすると、籠り切つたやうな重苦しい春の重壓が私の精神をまで襲つて來る。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――有島武郎 訳――●「或る女」あとがき　　　　書　　後　相変らず愚図々々していたけれども、もう如何しても余裕がなくなったので、私は四月の一日から、円覚寺の塔頭の一つの松嶺院という無住の寺に引籠りました。",
              "citation": {
                "source": "●「或る女」巻頭のホイットマンの詩",
                "author": "\"Not till the sun excludes you, do I exclude you;",
                "note": "青空文庫"
              }
            },
            {
              "text": "佳き文章とは、「情｜籠りて、詞舒び、心のままの誠を歌い出でたる」態のものを指していう也。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "情籠りて云々は上田敏、若きころの文章である。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくる承元四年には、ただいま私の記憶に残つてゐる事もあまりございませんが、将軍家の御日常はいよいよのどかに、昨年より更におからだも御丈夫になられた御様子で、御多病のお方でございましたが、このとしには、いちどもおひき籠りになつた事が無かつたやうに覚えて居ります。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりその頃の天災地變の哀れさを見て……」先生は口籠りながら云つた。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は雪籠りの許を受けようとして、たど／＼と近づきましたが、扉のしまつた中の樣子を、硝子窓越に、ふと見て茫然と立ちました。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
