  {
    "uuid": "b76ae99d-4bdf-5091-b526-e5fdbdce35b7",
    "entry": "木守",
    "reading": {
      "primary": "こもり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "person who tends to trees (e.g. in a garden)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "柿の収穫を終えたが、鳥たちのために枝先に一つだけ実を残して木守とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「全部獲っちゃだめだよ、来年もたくさん実るように木守を残しておくのが習わしなんだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬空の下、ポツンと取り残されたオレンジ色の木守が夕日に照らされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "これと始めのうちに同居していたたくさんの花瓶はだんだんに入り代わって行くのに、これだけは木守りの渋柿のように残っていた。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その最後の木守りの犬歯がとうとうひとりでふらふらと抜け出したときはさすがにさびしかった。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "心げさう霜月ひと日、朝戸出に、小野の木守は、※高膚の阿利襪樹の根に散りぼひし實のあり數に驚きて、つと立ちかへり、目無し籠を後ろ手にふた行くごとく、ただ目に人を見し時は、なよび姿の耀ひわたる清らさに、戀は退りて、ふくろ心の奧ぶかに隱るとせしが、落ちゐて、やがて花やかに穗に現はれぬ。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "『文学評論』（三六年七月）の「馬鹿野郎」（志木守豪）は少し安手だが珍しい風刺小説である。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "水部の線宮沢賢治きみがおもかげうかべんと夜を仰げばこのまひる蝋紙に描きし北上の水線青くひかるなれ竜や棲みしと伝へたるこのこもりぬの辺を来れば夜ぞらに泛ぶ水線の火花となりて青々と散る",
              "citation": {
                "source": "水部の線",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "表面は蛟龍雲を吐いて神有の祕密をそめて見るや裏面には伶人｜額をたれて物思ひ煩ふなよび姿才華悧悧たる眼ざしには工匠が怨みもこもりけんよ。",
              "citation": {
                "source": "古盃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものはいわでさめざめとぞ泣きたまえる、おん情手にこもりて抱かれたるわが胸絞らるるようなりき。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在の世界じゅうの科学者らは毎日各自の研究室に閉じこもり懸命にこれらの化け物と相撲を取りその正体を見破ろうとして努力している。",
              "citation": {
                "source": "化け物の進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩から、銀子は蘇生したような心持で、裏の家の二階に閉じこもり、磯貝の来そうな時刻になると、格子戸に固く鍵を差し、勝手口の戸締りもして、電気を消し蚊帳のなかへ入って寝てしまった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お父さん御自身が以前からよく、自分も僧侶になつて、山の中にでも、閉ぢこもりたいといつてをられましたから。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬鑵は顛倒して濛々たる湯気が部屋に立ちこもり、先生は、「あちちちちち。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "疱瘡が御平癒とは申しても、あれほどの御大病でございましたので、さすがに御余気が去らぬらしく時々わづかながらお熱も出ますので、そのとしは、鶴岳宮の一切経会、放生会、またその他のお祭りにも将軍家のおいでは無く、もつぱら御ところの御奥におひきこもりでございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども男子は一度言ひ出したからには、のつぴきならず、翌る朝さつそく庭の隅に一坪ほどの掛小屋を作つて、そこに引きこもり、寒さに震へながら正座してゐた。",
              "citation": {
                "source": "清貧譚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものはいはでさめざめとぞ泣きたまへる、おん情手にこもりて抱かれたるわが胸｜絞らるるやうなりき。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草のけむりが濛々と部屋に立ちこもり、誰か一こと言い出せば、どっと大勢のひとの笑いの浪が起って、和気あいあいの風景である。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草のけむりが濛々と部屋に立ちこもり、誰か一こと言ひ出せば、どつと大勢のひとの笑ひの浪が起つて、和気あいあいの風景である。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この容態で氏は、家庭に於て家人の些末な感情などから超然として、自分の室にたてこもり勝ちであります。",
              "citation": {
                "source": "岡本一平論",
                "author": "――親の前で祈祷",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの峠には、木鼠胴六といって、名高い石川五右衛門の一の子分が山賊となって、山塞にとじこもり、旅人を見れば、剥ぎ取って、殺してしまいます」「何ッ！",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "竈の煙が部屋いっぱいにこもりだすと、他吉は炬燵のなかから這いだして来る。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "また間の抜けて淫らなる支那学生のさへづりは氷室の看板かけるペンキのはこび眺むるごとく、印刷の音の中、色赤き草花｜凋え、ほどちかき外科病院の裏手の路次の門弾はげにいかがはしき病の臭気こもりたり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の蚊なにならぬつぶやきよ、ああ、篁の靄のこもりや。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "人や來て住みつきたらし、わがごとやこもり息づく。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌いつしかとなごみ来ぬらし向山の地震の壊え土萌えかすみつつ福寿草冬ごもり、こもりあかねど、寒き日は吾もちぢまりぬ。",
              "citation": {
                "source": "風隠集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌歌ふらくおのれ楽しむものならし楽しみてあらむひとりこもりて月光と魚爺が張る四つ手の網に、月さしていろくづ二つ。",
              "citation": {
                "source": "風隠集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "こもり啼く子ろも居るらし。",
              "citation": {
                "source": "海阪",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "こぬか雨笹にこもりて、香※けば香もしめりて、事もなし、ただ明るけし。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌いつしかとなごに来ぬらし向山の地震の壊え土萠えかすみつつ福寿草冬ごもり、こもりあかねど、寒き日は吾もちぢまりぬ。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌歌ふらくおのれ楽しむものならし楽しみてあらむひとりこもりて双柿舎　熱海遊草おもしろの春の小雨や、うら向けに羽織かぶりて、※かつぎ、石いくつ飛び、童さび、声うちあげて、翁こそ帰り来ましぬ。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "人や来て住みつきたらし、わがごとやこもり息づく。",
              "citation": {
                "source": "白南風",
