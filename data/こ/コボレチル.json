          "literary": [
            {
              "text": "蕾のころか零れ散るころかがわたくしの心に叶うてゐる。",
              "citation": {
                "source": "冬の庭",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたら一ぱいに溜つた涙があやうくこぼれ散るのでしたから……あなたは息を呑んで、そしてまた續ける。",
              "citation": {
                "source": "道",
                "author": "――ある妻の手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "西方一面に和ぎわたり、光いつとなく白んで薄れて、さながら、あまりに脆く美しい花束がちよいとのことにこぼれ散るやうだ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
