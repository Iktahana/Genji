          "literary": [
            {
              "text": "この場合では杏仁水が、陳腐なるものコンヴェンショナルなものの代表として現われたわけである。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はまず女のコンヴェンショナルなのに驚いた。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "現実の女はみな浅薄なコンヴェンショナルな女ばかりなのかもしれない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の目ざめの処女の身体の内部から、おのずから湧き出る恋心は、コンヴェンショナルな女をも自然児に変ずる力がある。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「劇的」といふ言葉の内容は、かくて「小説的」といふ言葉と同様、コンヴェンショナルな「境遇」を意味するに過ぎないやうになつたのであります。",
              "citation": {
                "source": "演劇一般講話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
