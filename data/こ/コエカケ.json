              }
            },
            {
              "text": "やがて余の真正面まで来て、「先生、先生」と二声掛けた。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "校長閣下の御声掛りである。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も弟は黙つて詰めて居たので、兄の方は焦躁しがつて、『貴様これへ入れろ――声掛けなくちや御年貢のやうで無くて不可。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貴様入れろ、声掛けなくちゃ御年貢のようで無くて不可」と辰さんは弟に言った。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "一髪の間に束を廻わし、「カーッ」と一声掛けると同時に胴切にしたのでござります。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「行くぞ」　と一声掛けて置いて紋太夫の様子を窺った。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢沢　お声掛りじゃ、久保殿。",
              "citation": {
                "source": "稲生播磨守",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "山城守は、簡単に出来るつもりで、係の者に話してみたのだが、係の者のいうには、それは簡単なことだけれど、ちょいと上役のお声掛りがなければならない。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが、御老中お声掛り武州清久の人戸崎熊太郎、当時俗に駿河台の老先生と呼ばれていた大師匠について神道無念流の奥儀をきわめたのだからたまらない。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "霙橋辻斬夜話",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　香具師の面々声掛け合わせ、ムラムラと民弥へ押し逼った。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――エーッ」　と裂帛の掛け声掛かるや、大いなる蝙蝠天井に向かって翩翻として飛んだかと見えたが、これぞ上州｜花隈の城主戸沢山城守直伝の秘法すなわち天狗飛切りの術。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "首相の御声掛りだったので、数十人の人々が、所定の時刻に参集した。",
              "citation": {
                "source": "外務大臣の死",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "登志子が階段を上ろうとすると、後から急ぎ足に来て声掛けた男がある、さっきの田島だ。",
              "citation": {
                "source": "わがまま",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "へいへい宜しうござりますると、とある門辺に声掛くれば。",
              "citation": {
                "source": "移民学園",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "気早き一人が声掛けて。",
              "citation": {
                "source": "したゆく水",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつと声掛け、斬る真似しても。",
              "citation": {
                "source": "したゆく水",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "役人や商人達が泊まるとき、お声掛りでサモル※ーラである。",
              "citation": {
                "source": "女房ども",
                "author": "БАБЫ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……お坊主の鴎硯様は、お光の方様のお声掛かりで、途中を護って下さいましたので。",
              "citation": {
                "source": "乳を刺す",
                "author": "黒門町伝七捕物帳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
