    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "暫く一室は、カサコソと賑つてゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "建物の背後の、ブランコのある所を見たいと思つて建物の横を廻りかけたが、何しろ休暇中だし、朝の五時半であつたし、小使の女房か女学部の舎監であつたか知らないが、炊事場の小窓から一寸顔をのぞけて、ケゲンさうにこちらを見たから、諦めてコソコソと引返した。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後当分、耕二は何時も裏庭でコソコソ一人遊んだ。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の外を、落葉がカサコソと風に音をたてさせられてる。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからはもうほんのコソコソ話になってわからんから、おれは障子に、指に唾をつけて、穴をあけてのぞいてやったんだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボースンは、とっつかまえられた、コソ泥棒みたいに、しきりに尻ごみしながら、ストキにつかまれ、励まされて待っていたのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれが、人間をこんなに、コソコソするように仕込んでしまったのか。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち人間が千載青史に列するを得んというのは、まことにこれは肉欲的、不信者的、heathen 的の考えである、クリスチャンなどは功名を欲することはなすべからざることである、われわれは後世に名を伝えるとかいうことは、根コソギ取ってしまわなければならぬ、というような考えが出てきました。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのような文学はわれわれのなかから根コソギに絶やしたい（拍手）。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "自省直ケレバ千万人ト言エドモ、――イヤ、握手ハマダマダ、ソノ楯ノウラノ言葉ヲコソ、「自省直カラザレバ、乞食ト会ッテモ、赤面狼狽、被告、罪人、酒屋ニ飛ビ込ム。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ斯ういふ風な處からラクダルの怠惰屋は國内一般の評判ものとなり、人々は何時この漢を仙人の一人にして了ひ、女は此庄園の傍を通る時など被面衣の下でコソ／＼と噂してゆく、男の中には脱帽して通るものすらあつた。",
              "citation": {
                "source": "怠惰屋の弟子入り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを拾って、コソコソと逃げる典六。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "カサコソと彼の坐っている前を、皺になった新聞紙が押されて行った。",
              "citation": {
                "source": "ある心の風景",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "容貌をかえた低地にはカサコソと枯葉が骸骨の踊りを鳴らした。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の学生はかの女の思わくも何も知らずにコソコソ話していたが、道筋が大通りに突き当って、映画館のある前の停留場へ来ると急いでバスから降りて行った。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからお前さんさえ開閉を厳重に仕ておくれなら先ア安心だが、お前さんも知ってるだろう此里はコソコソ泥棒や屑屋の悪い奴が漂行するから油断も間際もなりや仕ない。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "三好は君勇に今夜つき合えといったんだが、君勇はお座敷から呼ばれているし、別れた旦那とコソコソ会っているところを見られると、芸者としての立場が苦しくなるので断ったんですね。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな枝を張った木陰のベンチに人相の悪い雑種のマライ人が三人何かコソコソ話し合っていた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "室へ帰る時、二階へ通う梯子段の下の土間を通ったら、鳥屋の中で鶏がカサコソとまだ寝付かれぬらしく、ククーと淋しげに鳴いていた。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
