          "literary": [
            {
              "text": "「行くぞオォ――オオオ――」　健児社の健児十六名。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "目明し、橋場の仙右衛門が、同心佃三弥に指揮され、乾児十二人と一緒になって、捕り物をすべく囲んだのであった。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "必定、この小児十字軍は善い業で無い。",
              "citation": {
                "source": "法王の祈祷",
                "author": "RECIT DU PAPE INNOCENT 3",
                "note": "青空文庫"
              }
            },
            {
              "text": "樋口の電話、杉狂児十月出ると言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾來七八年して其女兒十四五歳になり、昨今の紅葉然と色付てきた時、其男復た同じ役目で、同じ所に宿つたとまで有て、跡は※が尻に留つた如く、闕文とは殘念だ。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            }
          ]
        }
