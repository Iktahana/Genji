        "examples": {
          "standard": [
            {
              "text": "コードを変更したら、必ずコミットして変更履歴を残しましょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "データベースへの変更は、トランザクションがコミットされるまで確定しない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今日の作業内容をGitにコミットしておくのを忘れてた！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
