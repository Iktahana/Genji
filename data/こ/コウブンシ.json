        "examples": {
          "standard": [
            {
              "text": "プラスチックは高分子の一種である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "タンパク質やDNAは生体高分子として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "高分子の構造を理解することは、新素材開発の鍵となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "入学と同時に、ある建築会社の研究所で働きはじめた松田は、大学でも建築用に使う高分子の接着剤を専攻した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "高分子などという言葉もまだ知らなかった時代の話である。",
              "citation": {
                "source": "雪の化石２",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリペプチドはタンパク質の分解産物のうちで比較的に高分子のものである。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
