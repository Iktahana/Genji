        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ゲームセンターでコインを借りて、クレーンゲームに挑戦した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "入場券の代わりに、このコインをゲートに入れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "遊園地の乗り物に乗るには、専用のコインが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
