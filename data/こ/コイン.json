[
  {
    "uuid": "9447b25b-b934-5b46-a67b-5811b84c4cd3",
    "entry": "コイン",
    "reading": {
      "primary": "コイン",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "coin",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "自販機にコインを入れると、好きなジュースが出てくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はポケットから数枚のコインを取り出して、お菓子を買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古いコインを集めるのが趣味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三つの「かゆい話」のぶつかったのは全く偶然のコインシデンスである。",
              "citation": {
                "source": "破片",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへいよいよ次の画面が現われて観者の頭脳の中の連続的なシーンと「コインシデンス」をする。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何度かあたりを行ったり来たりした挙げ句、ドンピアはマッサージパーラーとコインランドリーにはさまれた薄汚い小さな建物に、ＭＩＴＳの看板が出ているのに気付いた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の名前のどちらを先にして社名とするかは、コインを投げて決めた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "サニーベイルのビリヤード場にピンボールのマシンと並べてためしに置かせてもらうと、ポングには順番待ちの列ができ、コインボックスはたちまち硬貨でいっぱいになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "三二　判事ガスコイン、皇太子を禁獄す　判事総長ガスコイン(Chief Justice Gascoigne)が太子ヘンリー親王を禁錮に処した事は、古代の記録にも残っており、また往々英米の小学読本などにも載っている最も有名な話である。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "法廷に並びいる者はこれを見て愕然としてただ互に顔を見合せるのみであったが、裁判長ガスコインは徐かに太子に向って、「殿下―私は殿下が彼の近臣の王国の法律に依って処分せらるることに御満足あらせられんことを希望致します。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "親王はこの諫を耳にも掛けず、自ら被告の手を執ってこれを連れ去ろうとせられたから、ガスコインはこれを制止し、大喝一声、親王に向って退廷を命じた。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "三二　判事ガスコイン、皇太子を禁獄す　判事総長ガスコイン（Chief Justice Gascoigne）が太子ヘンリー親王を禁錮に処した事は、古代の記録にも残っており、また往々英米の小学読本などにも載っている最も有名な話である。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのいえの　すいじがかりは　はこびやさんに　はくどうの　コインを　１まい　わたしました。",
              "citation": {
                "source": "まちねずジョニーのはなし",
                "author": "THE TALE OF JOHNNY TOWN-MOUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でもパケット、ブリオン、ゴールド、シルバー、コイン、ダブリン、ソヴリン、ギルダー、ダラー、ダイム、セントといった名前が裏通りに残っている。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の例はナルヴァエス号の１人の黒人によってメキシコインディアンに天然痘が持ち込まれたときの激しい病原性である。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗濯はコイン・ランドリー。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コイン・パースとバンダナだけをジーンズのポケットに入れて、彼女は部屋を出た。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コインを投げて表なら、この町に一軒しかない映画館へいく。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コインを投げたら表とでたので、映画にいったのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "タバコの喫いがらを投げる、コインをぶつける、楽器を盗む、ピストルを射つ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そうなの」「じゃ、荷物もなにも、ないわけだ」「すこし持ってきた」「どこに」「コイン・ロッカー」　ミーヨは、新宿駅のほうを示した。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これ、さっきの二〇スーです」ラスチニャックは鬘をつけた謎めいた男にコインを一枚差し出した。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボタンから六リヤール・コインを二枚偽造しただけでギロチンにかけられた男がいるが、余りにも残酷ではないか？",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで老婦人がコインを献金皿に差し込むみたいに。",
              "citation": {
                "source": "親友たち",
                "author": "C. スミス　C. Smith",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
