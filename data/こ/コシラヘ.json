          "literary": [
            {
              "text": "又弍両寺内ヨリ、右短刀合口コシラヘ并研。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ、着物ヲコシラヘナケレバナリマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジラウハ　アツイスナノトコロヘ　モドツテ　スナトミヅヲ　マゼテ　オマンヂウヲ　コシラヘマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生ヅラが呆れらア、てんで小手先のコシラヘ物ぢやないか、殻を背負つて身動きもできないぢやないか、第一なんだい、自分の小説を朝昼晩朗読するなんて、あさましいことはやめなさい。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
