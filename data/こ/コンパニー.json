        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「うむ、あれはパーマーシップビルヂングの社員が二人と、マーカンテイル・マリン・コンパニーが一人だ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はゼネラル・エレクトリック・コンパニーのハロルド・クリーバーという社員ですが、あなたの方は？",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「われわれの尊敬の的、ゼネラル・エレクトリック・コンパニー万歳。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼネラル・エレクトリック・コンパニー、万歳、万歳、万歳。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれゼネラル・エレクトリック・コンパニー、マツダ・ランプ、万歳。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大倉コンパニーを知らねえか。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大倉コンパニーは、ロンドンで、ロンドンでちゃんと調印したんだぞ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
