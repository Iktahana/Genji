        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ネルラさんはコオフイイを一杯煮てさへ下されば好いのですよ。",
              "citation": {
                "source": "聖ニコラウスの夜",
                "author": "SANKT NIKOLAUS BEI DEN SCHIFFERN",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして部屋一ぱいにコオフイイの好い匂がして来た。",
              "citation": {
                "source": "聖ニコラウスの夜",
                "author": "SANKT NIKOLAUS BEI DEN SCHIFFERN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネルラ婆あさんがコオフイイの臼を膝頭の間に挾んで、黒いコオフイイ豆を磨りつぶしてゐるからである。",
              "citation": {
                "source": "聖ニコラウスの夜",
                "author": "SANKT NIKOLAUS BEI DEN SCHIFFERN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから六時頃までゐて、コオフイイを一杯飲ませて貰つて、チモフエイの所へ出掛けた。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレナはふわりとした寝巻を着て小さい長椅子に腰を掛けて、前に矢張小さい卓を構へて、矢張小さい茶碗でコオフイイを飲んでゐた。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "コオフイイの中へは小さいビスケツトの切をくづし入れて飲むのである。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてコオフイイでもお上がんなさい。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
