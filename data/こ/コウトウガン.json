          "standard": [],
          "literary": [
            {
              "text": "春田は十二三年前に五十余歳で喉頭癌のためにたおれた。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "院長の所へ行って話して見ると、あれはもう喉頭癌とか喉頭結核とかで（どちらだか今は忘れた）到底助かる見込は無いのだから、レンゲの所へ行くなり何なり、もう本人の好きなようにさせた方がよかろうという。",
              "citation": {
                "source": "南島譚",
                "author": "※",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の叔父は去年の十一月に喉頭癌のために故人になっていた。",
              "citation": {
                "source": "冬",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――岩田が喉頭癌を病んでから、矢島さんは費用を惜しまずその治療をさしてやった。",
              "citation": {
                "source": "過渡人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "葵の十五の春に、父が喉頭癌で死ぬと、分家を立てるという名目で、二十一歳の正明が、急遽、葵の家へおくだりになることになり、葵はその夜から、この阿呆と同室で、夫婦のように起居することを強いられるのだった。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "喉頭癌のようですけれど」「すると、お二人とも、もう大丈夫だと言えそうですね。",
              "citation": {
                "source": "落日の光景",
                "author": "外村繁",
                "note": "青空文庫"
              }
            }
          ]
        }
