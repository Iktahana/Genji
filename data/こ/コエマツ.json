          "literary": [
            {
              "text": "松の生の割木をこの地方では肥松と呼んでゐる。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓場のあちらこちらに、この肥松を焚く焔が赤々と燃え、脂の匂ひが鼻をついた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「肥松切り」である。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを合圖に肥松に火が點ぜられた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
