        "examples": {
          "standard": [
            {
              "text": "犬や猫などのペットであっても、愛情を持って接すれば心が通じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "初対面だったが、趣味の話で意気投合し、すぐに心が通じる仲になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この作品には、世代を超えて多くの人々の心が通じる力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "片言のように――切れ切れに、お経の文句を覚えていた漁夫が「それでいい、心が通じる」そう皆に云われて、お経をあげることになった。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "話せば心が通じるであろうと思い、ひそかに会見の日を愉しみにしておった。",
              "citation": {
                "source": "中庸",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "異性同士、心が通じるつてことは、やつぱりあるんだわ。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
