        "examples": {
          "standard": [
            {
              "text": "ペットショップで見かけた胡錦鳥は、宝石のように鮮やかな色をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "胡錦鳥のオスは、求愛のときに体を上下に揺らして踊るんだよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "オーストラリアの草原に、美しい胡錦鳥の群れを探しに行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "最近読んでみた『石川県｜珠洲郡誌』に依れば、同郡｜木郎村では収穫終りの休日をコキンテ、宝立村ではコキンチョ、直村ではコキンチョウと謂って、いずれもこの日を祝い牡丹餅などをこしらえて、神に供えまた自分たちも食べる。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
