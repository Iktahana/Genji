        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "異ったコムビなので、二人は行く先き先きで発見された。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガンジーのつよさ、力の諸源泉、そのコムビネーションについて。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、自分と云うものさえ局外から観察し、悲しむべき人間のコムビネイションから生じた人生の一ツの悲劇として、それから卒業出来ると思った。",
              "citation": {
                "source": "文字のある紙片",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、私が起き一緒に喋るのでよろこび「我々は実際よいコムビネーションだな」という。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コムビネーションという語は私が自分達につけたのが始り。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがては入れ乱れ、入れちがへ、手をとり、くゞり、寄り、離れ、コムビネーシヨンの妙を極む。",
              "citation": {
                "source": "燕尾服着初の記",
                "author": "徳富盧花",
                "note": "青空文庫"
              }
            },
            {
              "text": "中村メイコと僕のとり合せが、いともよろしい、もう二三本此のコムビで「お父ちゃん」物を押すべきだと思ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝村とは、今年中にもう三本、「兵隊」と、メイコとのコムビをもう一つ、正月物に長谷川一夫と組んで「大久保」続篇といふ打合せがついた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュと、ティンボール・アラスカ、コムビネーションサラダと、マロン・シャンティリーのアイスクリーム、それからアイスティーを飲み、程よき満腹で帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣＬ滝村来り、藤山でもう一本古賀政男とコムビのものを作りたいといふ、その原作をたのまれる、「君を想へば」と仮題しとく。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、今日初日の有楽座、漫才大会を見に行く、大満員、三亀松をきゝ、おめあてエンタツ・アチャコのコムビ、「親の子」といふのをやったが、やはりこれはよろしい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
