  {
    "uuid": "ed218e65-d5b5-5839-bb18-8462bb423682",
    "entry": "児三",
    "reading": {
      "primary": "こさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小児三　ああ、大なものを背負って、蹌踉々々来るねえ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　御覧よ、脊よりか高い、障子見たようなものを背負ってるから、凧が歩行いて来るようだ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　ああ、面白かったの。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　だって、兄さん怒るだろう。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　何だか知らないけれどね、今、向うから来る兄さんに、糸目をつけて手繰っていたんだぜ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　やあ、大凧だい、一人じゃ重い。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　凧は切れちゃった。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　でもね、気味が悪いんだもの。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　目を塞いでいるんだぜ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　そうだなあ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "女児三　だって、真紅なのだの、黄色い銀杏だの、故とだって懐へさ、入れる事よ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　そんなら可いけれど、皆木の葉だ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　あゝ、大なものを背負つて、蹌踉々々来るねえ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　御覧よ、脊よりか高い、障子見たやうなものを背負つてるから、凧が歩行いて来るやうだ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　あゝ、面白かつたの。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　だつて、兄さん怒るだらう。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　何だか知らないけれどね、今、向うから来る兄さんに、糸目をつけて手繰つて居たんだぜ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　やあ、大凧だい、一人ぢや重い。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　凧は切れ了つた。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児三　目を塞いで居るんだぜ。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その児三郎｜年紀十七、才名同族を圧して、後来多望の麟麟児なり。",
              "citation": {
                "source": "金時計",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後余は、ルスン島の土人港バグアイにおいて、以上の六人――すなわち青年二人男児三人女児一人を、本国に送還したのであったが、その間目撃した異常な秘密については、今でさえも狂わんばかりに夢中である。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月四日には幼児三郎が死んだ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮古島の漲水御嶽と言ふ拝処の由来には、女に通うた蛇が、女児三人孕ませて後、自分の種姓を明して去つた。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "※澗めぐり流るゝ水を　はる／″＼と　靡き　おくりてつゞく　竹かな※滑らかに露もつ苔路　風ありて、下陰ぐらき竹の奥かな※疎竹三禽図茂からぬ一もと竹の　細き枝に、乗りて親まつ　雀の児三（？",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻の富貴子は、焼け野原の屋敷町の一隅に、やつと半焼けのまゝ残つてゐる土蔵の中で、乳呑児三人を抱えて、彼の帰りを待つてゐる。",
              "citation": {
                "source": "秋の雲",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤森少参事以下随行員の中姓名の明なるものは、登米県少参事藤森脩蔵、同県権大属矢野児三郎、同県少属兼松修理之助名古屋人のみである。",
              "citation": {
                "source": "下谷叢話",
