[
  {
    "uuid": "08b15737-0713-57ee-a4d6-d34b07be36ec",
    "entry": "古参",
    "reading": {
      "primary": "こさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
