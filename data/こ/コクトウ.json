        "examples": {
          "standard": [
            {
              "text": "煮物にコクを出すために、白砂糖の代わりに沖縄産の黒糖を使った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "疲れた時には、黒糖の優しい甘さが体に染み渡る気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このお菓子は黒糖の風味が豊かで、お茶請けとして非常に人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "何を持って来たかというと、ヨウカンとか黒糖などの甘味品だ」　南下中の列車や軍用船で、いろいろ南方の話題が出る。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
