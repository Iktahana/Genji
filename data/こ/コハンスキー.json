          "literary": [
            {
              "text": "Ｍ、Ｈ山房はコハンスキーの隣りであつた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "レコードはたくさんあるが、ビクターのコハンスキー（ヴァイオリン）、ルービンシュタイン（ピアノ）などが第一位に置かれるだろう（ＪＤ四一―三）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "コハンスキーはこのレコードひと組だけを残して他界し、今は形見になってしまった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
