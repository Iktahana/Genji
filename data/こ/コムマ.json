        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何でも物が、あまり端的な売買関係にあると、全く人間的感興の欠けたものとなって仕舞う通り、「家」と云うものに対する我々の心持も、あまり、コムマアシャリズムに堕したくないものと思います。",
              "citation": {
                "source": "書斎を中心にした家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、米国人は一般からコムマーシャールの方を多く持ち、日本人は名人気質の方を持っているように私には思われました。",
              "citation": {
                "source": "アメリカ文士気質",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっかりコムマアシャライズして居るからではないか。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "◎二日に巴里についてから〔以下空白〕八月二十四日　Toynbee Hall　White Chapel Road からコムマーシャル・ストリートへ入ると、右に 6p. store あり。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "強くも弱くもならない平らな声が早口に、「二八七コムマ二六〇。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五九三〇三コムマ四二七……」　勤勉な紡※の唸りのようだ。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――大通からコムマアシャル街へ入ると人通りもへった。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
