        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "暫くすると、大きい鈍いコントルバスのような声でハルロオと答える。",
              "citation": {
                "source": "木精",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい時から聞き馴れた、大きい、鈍い、コントルバスのような木精の声である。",
              "citation": {
                "source": "木精",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "レリス・グジャット以来インテリのコントル・レボリューチー〔反革命〕技師はまだソヴェートのタイプだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはこれでもコントル・ダンスというのを知っている」「おどろきましたな。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "コントル・ダンスというのは女学校の遊戯じゃないですか」「かならずしもそうじゃない。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "コントル・ダンスどころのさわぎでない。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご迷惑でありませんでしたら、さっき艦長がおっしゃったコントル・ダンスで、きょうのパァティを終らせたいと思います」　艦長が笑いながらうなずいた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく、〈プルトン〉という二拍子の古風なコントル・ダンスの曲がはじまった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後のコントル・ダンスもめでたく舞いおさめ、歴史的な艦上舞踏会も終った。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれもかれもダンスを習った者はなかったが、アルキシーとバンジャメンは一度ミルコロンヌで婚礼の舞踏会へ行って、コントルダンスのしかただけ多少｜正確に記憶していた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "或晩、私はヴィユ・コロンビエ座の新劇を観に行くつもりで、宿の近くのコントル・スカルプの辻から乗合に乗った。",
              "citation": {
                "source": "二人のセルヴィヤ人",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリのパンテオンの裏の方にコントル・スカルプという汚らしい辻がある。",
              "citation": {
                "source": "パリの散策",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初のコントルダンス[15]の時、彼女に話しかけることが出来た。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、それはコントルダンス一曲とワルツが一曲だった。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は名簿の十二番目に名前が書かれていましたが、彼女はずっとコントルダンスを踊り続けていました。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "[15]  コントルダンス フランス風スクゥエア・ダンス、四人で方陣を組んで踊る。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
