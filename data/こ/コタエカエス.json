        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「とりうち」に答え返すつもりか、また独語か、何やら口の中でぶつぶつ云っていたが、ひょいと手の甲で眼をこすって、それからじっと相手を見つめた。",
              "citation": {
                "source": "在学理由",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はるに抱かしたらいいじゃないか、」と私は答え返す。",
              "citation": {
                "source": "理想の女",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは答え返すことができるのだった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ答え返すのがうまいばかりです。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "答え返すべきことが少ないからではなかった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなものに答え返す代わりに――（答え返そうとしても彼にはそれが果たしてできたろうか？",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その息は巨大なるラッパからのように百二十の砲門からいで、誇らかに雷電に対しても答え返す。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めは高く、次に低くなり、さらに低く、山彦が山彦を呼んで、しだいに遠く、かすかに、……それはまるで、眠っていた山々の精霊が、彼女の叫びに眼ざめて、互いに呼びあいながら、答え返すかのように思われた。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
