[
  {
    "uuid": "689a085d-9c82-5194-8fa3-5fe3f195fa56",
    "entry": "肥える",
    "reading": {
      "primary": "こえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
