    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "司令官、兵ニ破ッタ始末書ヲ渡シ、海ヘ捨テロト云フ　兵室ヲ出ル、消灯ラッパ聞コエル　兵戻ッテ来ル　司令官「遅レタ罪ダ」ト兵ヲ叱ル。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オオ　タイハウノ　オトガ　キコエル。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンダン　ミミガ　トホク　ナツタノデ、ミヤコニ　ヰル　ムスコノ　トコロヘ、「ミミガ　トホク　ナツタカラ、ヨク　キコエル　キカイヲ　カツテ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　オヂイサンハ、「アノ　ラツパデハ　キコエナク　ナツタカラ、モツト　ヨク　キコエルノヲ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「アア　キコエル　キコエル、ナツカシイ　ムスコノ　コヱガ　キコエル。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　わしの身ぢかにおるのは誰か？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　わしは聖僧コエル……盲目の老人の琴手コエルだ。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "琴手コエル、わしは至聖所がほしい！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　だれから隠れるために？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　ここにいればお前は無事だ。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（杖をあげて）お前は誰か？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "（しばらく沈黙）ああ、盲人コエル、日にかけて風にかけて言う、わしは、無道にもウスナの子たちを殺した者どもを刺すための、折れた槍だ……コノール王を狂気に突き煽る槍だ！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（怒って）愚かな狂人、かくさずに言え、お前はコノール王のおん子コルマック・コンリナスの怒を恐れて逃げたものではないか？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（怒って）なに！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "（不意に飛び退って又高く叫ぶ）ああ盲人コエル、わしは自分の砦に火をつけた、そして二人が寝ておる寝室に赤い火焔が迫った時わしは笑うた……二人は死んだのだ、コルマックとアイリイが、この琴手クレーヴシンのうれしい死の唄につれて！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　あれは、盲目の老琴手コエルでございましょう――あの名高い女王マカを愛して、あまりに深く愛した為に、女王の手で盲目にされたコエルでございます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう今夜で三晩、かれらは暗闇の中に立って、嘗てコエルが女王マカとその美しい都を讃美した唄を、王城の前でうたっております。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の中からコエルの高い唄の声が聞える。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（うたう）ああ、マカの城は、よきところ、うつくしき宮殿、もろびとにかしずかれ、そこにマカは楽しく住む、聖僧も、詩人も、楽人も、琴手も、騎士も、マカにかしずく家人の群も多くあり、そこに、麗しく珍しき奇観多くあれど、尊くうつくしきマカの顔ばかり珍しく美しきものは世にあらじ、ああ髪あかきマカよ！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（うたう）その王城のいろは白くかがやく光石灰、城中には、青藺のしきもの、白き榻あり、珍らかに柔かき絹、金の輪下げたる青衣も毛皮もあり、黄金と玻※の戸ある君が居室は陽のひかり輝き充てり、ああ、日中の女王、よるの女王、マカよ！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（うたう）みどりの門をくぐれば、赤と茶いろの羽毛もて葺きたる屋根あり、撃ちおとされたる無数の鳥の羽をうつくしき縞に並べたり、内に、輝けるひろき床は壁より壁に続き、不思議なる彫刻は銀の板にきざまれ、彫られたる剣は交叉してかがやく、数多き宝物の主人、言葉すくなきマカよ！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（うたう）君が臥榻はまことにうつくし、されど君が玉座はそれよりも美し、そは、目もまばゆき黄色の金ひかり輝くひとつの椅子。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（うたう）まことに君ときみが家には歓喜多くあり、その歌うつくしく日の暖き部屋部屋には、傷うけたる男らも眠りにおちて、心満ち足り眠り、ゆめみてあるべし、夢さめて、ただ折ふしにけだかく尊き君が顔を仰ぎ見るのみに心足りて。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（うたう）この奇観を知らむと望むものは行けよ、わが教えしことわが云いしことのまことなるを見極め得べし。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエル　（うたう）女王マカの楽しく住む彼の大きなる家には人の子の望む地の上の凡ての物備われり、神は知りたまう、わが言葉みじかきはわれ驚嘆を以てこころ遠くなり、ほめことばを知らざればなり、ただ我は云わむ、わが欲求マカよ、我はきみが眼の火の中に生きて死なむ、火の眼もてる人よ！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
