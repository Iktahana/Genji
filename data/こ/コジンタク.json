        "examples": {
          "standard": [
            {
              "text": "訪問販売員が個人宅を回って商品を販売している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "宅配業者が個人宅を一軒一軒回って荷物を届ける作業は、夏場は特に過酷だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その訪問販売員は個人宅を無断で撮影しており、後にトラブルになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "これは大きな個人宅において病人のために準備した部屋である。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "個人宅であってもポンプがあると分かれば人々が押し寄せ、あらゆる階層の見知らぬ人にも給水した。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
