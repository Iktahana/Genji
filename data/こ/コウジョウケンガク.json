        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "けれどあの懐かしきＰＡＳＯＰＩＡがマシンの温度テスト用恒温槽で今もけなげに働いているのを発見したり、基本ソフトの開発部門にＮｅＸＴのキューブが転がっているのを見つけたりと青梅工場見学ツアーを存分に満喫しているうちに、またまた、次なる疑問がむくむくと湧いてきた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場見学隊を組織し、集団農場視察団を組織して、生産の場所に在る大衆の中へ進出したソヴェト・プロレタリア作家たちは発見した。",
              "citation": {
                "source": "「鎌と鎚」工場の文学研究会",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」十一月十日　月「えー大安売　草ボーキの上等三本で十銭」十一月二十六日　水　二十一枚「ドン国営煙草工場見学」十一月二十九日　土「日本三週間」十枚十二月一日　月「プロ美術展を見る」、十五枚位。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日その煙草工場見学にどっかの外国人が三人やって来た。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場見学団の男女が、樺の木胴籠にスポーツシャツといういでたちで汽車につまれて出て行った。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まわりの村のピオニェールが突撃隊を組織して、その煉瓦工場見学兼手伝いに出かけた。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スターリングラードの耕作トラクトル工場見学に行って、ずうっとドンの炭山まで視察だ」　見学団も各工場から出る。",
              "citation": {
                "source": "ソヴェト労働者の夏休み",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば或る工場見学に小学校生徒の一級が出かけたとする。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一級が一冊の「××工場見学の印象」というものを制作するのに、教師は決して誰それサン、作文を書きなさいとは命じない。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は七月のある朝、ドイツからソヴェト同盟へやって来たドイツの労働者見学団といっしょにホテルを出て、ドン国営煙草工場見学に出かけた。",
              "citation": {
                "source": "明るい工場",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐘紡社長津田氏の家、東久邇宮殿下が、鐘紡工場見学の往途、寄って食事されるので、その余興にと、高島直三郎氏にたのまれたわけ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛行機を生み出すたのもしい力ちえの一太郎君の工場見学記　ちえの一太郎君は、五月のなかばごろ、陸軍航空本部の小父さんにつれられて、方々を旅行し、飛行機をつくる原料を生み出す工場などを、いくつも見学させてもらいました。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどの工場見学はほんとうに愉快だった。",
              "citation": {
                "source": "智恵の一太郎",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
