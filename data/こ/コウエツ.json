[
  {
    "uuid": "c38f7d84-2181-5484-8ea8-a6fc8fc4feae",
    "entry": "校閲",
    "reading": {
      "primary": "こうえつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
