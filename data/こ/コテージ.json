        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏休みには、湖畔のコテージを借りて家族で過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の夢は、海辺に小さなコテージを建てることだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このコテージは、薪ストーブがあって冬でも暖かい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "クラブというからなにをしているのかと思ったら、療養所の外気室のようなヴェランダのついたコテージの中へ、酒場だの、グリルだの、モンテ・カルロ式の鳩射場などをこしらえて、戦争中、毎日パァティをして遊んでいたというんですから」　ママがまたいった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはポートゥックストのコテージを購入してそこに科学上の一切を移動する時まで続いた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはアレン博士からそれほどの悪を感じず、彼を奇妙な陰の多いコテージの主導者と見なしていた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初の計画では、コテージをたくさんならべただけのものだったが、計画は次第に大きくなっていき、予算を五万ドルほど超過した上で、白い木造四階建ての美しい堂々たる建物となった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "家のぐるりの花壇に植えてある香りの高い花に包まれた、贅を尽くした立派な英国風の木造コッテージ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "その長く引いた裾根が蘆の湖の水に達かうとする稍諦め心地になりつゝ尚ほ凝乎と眺めてゐると、もしこのコッテージがなかつたならば、荒蓼として見えるべき箱根の風景が、寧ろそれあるがために自然の景致に一點の情味を加へて、却つて親しみのあるものに感じられて來るのである。",
              "citation": {
                "source": "箱根の山々",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "水谷、大場両氏とともに車行および歩行して、セント・ジャイルズ村落に至り、ミルトンコッテージを訪う。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィルソン先生はこの仕事でノーベル賞を貰い、その金でかどうかは知らないが、剣橋の郊外約二マイル位の所にコッテージ風の良い家を作って住んでおられた。",
              "citation": {
                "source": "英国の物理学界と物理学者",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
