[
  {
    "uuid": "ce2f3c24-df8e-5858-8f98-05a9ff3e76eb",
    "entry": "固有性",
    "reading": {
      "primary": "こゆうせい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
