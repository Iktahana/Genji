        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この時、人声静まりて、橋がかりを摺足して、膏薬練ぞ出で来れる。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨催の空濁江に映りて、堤下の杭に漣※寄するも、蘆荻の声静かなりし昔の様尋ぬるに由なく、渡番小屋にペンキ塗の広告看板かゝりては簑打ち払う風流も似合うべくもあらず。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうせ女でしょうよ」　妻はやけにそういえば、産婆は声静かに笑いながら、「えィお嬢さまでいらっしゃいますよ」　生まれる運をもって生まれて来たのだ。",
              "citation": {
                "source": "去年",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫓声静に我舟の行くまゝに、鴨が飛び、千鳥が飛ぶ。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "声静かに、名乗っていう。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋭い汽笛が一聲靜かな午後の空氣を振動せしめた。",
              "citation": {
                "source": "少年の死",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫓聲靜に我舟の行くまゝに、鴨が飛び、千鳥が飛ぶ。",
              "citation": {
                "source": "熊の足跡",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
