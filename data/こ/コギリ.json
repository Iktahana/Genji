[
  {
    "uuid": "55619b50-6f6d-5f39-afd6-6e8974897a39",
    "entry": "小錐",
    "reading": {
      "primary": "こぎり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
