          "literary": [
            {
              "text": "東西にならんでいたふたつの火山のうち、東側の火山は、いまのコオラウの山なみをつくった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コオラウ山脈の南、尾根の南側の険しいスロープの上空に、その雲はある。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コオラウとワイアナエのふたつの山塊を越え、東から昇って来たばかりの太陽を斜めに受けて、その波は太陽の光をさまざまに乱反射させながら、四フィートから五フィートほどの高さに盛りあがっては砕けた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
