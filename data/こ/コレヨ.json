          "literary": [
            {
              "text": "「コレヨ、誰ぞある――」　春藤幾久馬と丹ちゃんは、その間に、手酌でせっせと傾けている。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ワガ恐竜第六十戦隊ハ、コレヨリ敵艦隊ノユダンニツケイリ、ナルベク早ク所期ノ目的ヲハタシタ上デ、全艦海底要塞ヘヒキアゲント欲ス。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ（治ヲ）請フ者日ニ多シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ先母氏｜膈ヲ患ヒタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ先朝廷高崎藩ニ命ジテ仮ニ石巻ヲ鎮セシム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ以北ハ仙台藩ノ旧封域ニ係ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ南スルコト四里ニシテ多賀ノ城墟アリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヨリ以後数日間ハ執筆ニ堪エズ、数日後佐々木ノ病床日誌ニ依ッテ記入スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
