          "literary": [
            {
              "text": "従って鳥の地上高度によって第一声前半の反響とその後半とがいろいろの位相で重なり合って来る。",
              "citation": {
                "source": "疑問と空想",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時入り乱れた人声前よりも高く聞えて、次第に高くなり、やがてぱったり止む。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌ひ畢るとき、喝采の聲前に倍し、我膽力は漸く大に、我｜興會は漸く高し。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
