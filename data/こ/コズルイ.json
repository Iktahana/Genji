        "examples": {
          "standard": [
            {
              "text": "彼はいつも責任を逃れるために、小ずるい言い訳ばかり考えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "そんな小ずるい手を使ってまで勝ちたいなんて、スポーツマンシップに欠ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "あいつの小ずるい笑い方を見ていると、何か企んでいるのではないかと疑ってしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "東芝流ダイナブックの可能性と限界をアラン・ケイの微笑みの陰に見た　母親の証言によると、オレは寝小便をかました後、親が怒りだす前に必ず先回りして泣いてしまう、繊細かつこずるいガキであったという。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
