[
  {
    "uuid": "50ced579-1955-5978-b58d-bb005b6750ad",
    "entry": "細やか",
    "reading": {
      "primary": "こまやか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
