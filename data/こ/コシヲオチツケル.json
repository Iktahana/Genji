        "examples": {
          "standard": [
            {
              "text": "ようやく仕事が一段落したので、お気に入りのカフェで腰を落ち着けて本を読もう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "転勤続きの生活だったが、ようやくこの静かな町で腰を落ち着けて暮らせそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「立ち話もなんだから、中で温かいお茶でも飲みながら腰を落ち着けて話そう」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」とレストレードは腰を落ち着ける。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともとハシゴはやらないで腰を落ち着ける方なのであるが、にもかかわらず飲み屋を変えたのは、住所の転々に従ったからなのである。",
              "citation": {
                "source": "酒友列伝",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
