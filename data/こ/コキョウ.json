[
  {
    "uuid": "7b51900f-24be-57bd-a236-87f4b62b67e8",
    "entry": "故郷",
    "reading": {
      "primary": "こきょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
