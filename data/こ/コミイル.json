          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「火事の知らせを聞いた野次馬が現場に込み居り、消火活動の妨げになった。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「祭りの神輿を見ようと、人々が沿道の狭いスペースに込み居っている。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「狭い部屋にこれだけの人数が込み居ると、さすがに息苦しさを感じる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "天気あしければ、いつにても役人よりきびしく吟味して、もし入込み居る時は急に送り出すこととなり。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "路地の内なる或家に立寄るに、昨夜お尋者この土地に入り込みし樣子なりとて私服の刑事客にまじり張り込み居る故用心せらるべしと云ふ。",
              "citation": {
                "source": "荷風翁の發句",
                "author": "心猿",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
