        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "〔欄外に〕　汽車の中で、婆さん、コンムニストカ〔婦人共産党員〕おかっぱ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "等々の組合せについて彼女云うが、話しはちっともききてに芸術を理解させず、コンムニストしか感じさせない。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンムニストが孤立して、ベドニャークとの結合も何もないところ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ののこりものの親爺、先妻、コンムニストカを離別して今は若いメシチャンカの浮気女ターニャと暮してる。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペチカたきの男しかコンムニストはいなかったのだ。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンムニストだということは　　云ったげようか　　とても、陽気だ。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンムニストの労働者だけなんでしょう？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシアって何でもコンムニストだけでやっているっていう話があるのかしら。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっきりおぼえてはいないけれどもソヴェトのコンムニストは人口の一パーセントぐらいよ」「――ともかくここの社会民主党の政策は、こういう住宅をどんどんふやして、労働者の生活を向上させて行こうとしているんです」　黒川隆三は、「佐々島博士――御存じでしょう？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘエ、俺らコンムニストにだまされたんだ。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンムニストは鞭の代りに書付を出しくさる！",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンムニストでも決して善玉揃いではない。",
              "citation": {
                "source": "プロレタリア文学における国際的主題について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　コンムニストが善玉揃いでないということはその限りにおいて真実だ。",
              "citation": {
                "source": "プロレタリア文学における国際的主題について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
