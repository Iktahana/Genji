  {
    "uuid": "ef9007f8-58a1-5bc1-ab81-d55181a65bff",
    "entry": "コド",
    "reading": {
      "primary": "こど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一番心慶むのは乞食の文吉を呼んで新聞のコドモページの写真版の説明をしてやったりすることでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ナミ　ハ、ヤマ　ノ　コドモ　ガ　ウミ　ニ　クルナンテ　ナマイキダ　ト　オコッテ、ヤマキチ　ヲ　ヒトマキ　マイテ　イワ　ノ　ウエ　ヘ　タタキツケマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた数週間前に、彼はモラン大佐と組になって、コドフレー・ミルナー氏と、バルモーラル卿から、一開帳に四百二十｜磅も勝ったこともあったのであった。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "全山ウチワ太鼓に埋まっていると見えて、一歩々々と久遠寺の七｜堂伽藍が近づくに随い、ドンドンドドンコ、ドドンコドンと、一貫三百どうでもよいのあのあやに畏こい法蓮華囃子が、谷々に谺しながら伝わりました。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコドコドンドン、ヒュウヒョロヒョロと、朝ごとに角兵衛獅子の囃子がその柳原お馬場の近くの旅籠町からわびしく流れだして、西に東に江戸一円へ散らばっていくのでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "・ふるさとはみかんのはなのにほふとき・若葉かげよい顔のお地蔵さま　初夏の坊主頭で歩く　歩くところ花の匂ふところ　　　　□・コドモが泣いてハナが咲いてゐた五月廿五日　廿六日　雨、風、晴、発熱休養、宿は同前。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月十一日コドモ朝起会の掃除日ださうで、まだ明けきらないうちから騷々しい、やがてラヂオ体操がはじまる、いやはや賑やかな事であります。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウグヒスブエヲ　フケバ新美南吉　ムラノ　コドモタチガ　ウグヒスブエヲ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア　ウグヒスガ　アソビニ　ヤツテ　キタ」ト、イヒナガラ、コドモタチハ　テヲ　ウツテ　コロコビマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、ミンナト　ハナレテ、オカアサンヲ　ナクシタ　カアイサウナ　コドモガ　ヘイニ　モタレテ　ヰマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、コノ　ウグヒスハ、オカアサンヲ　ナクシタ　コドモノ　フク、カナシイ　ウグヒスブエノ　オトヲ　キクト、ナクシタ　ボウヤノ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘイニ　モタレテ、コドモハ、「ケキヨ、ヨ　ケキヨ、ヨ」ト　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　ハナノ　下ニ　クロイ　ヒゲヲ　ツケテ　ヰタノデ、コドモタチハ　「ヒゲサン」ト　ヨンデ　ヰマシタガ、ヤガテ　タキクンノ　コトモ　「ヒゲサン」ト　ヨブヤウニ　ナリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフガ　ミエナク　ナルト、コドモノ　デンデン蟲ハ、「アレ、ナアニ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガレボシ新美南吉　フユノ　サムイ　サムイ　ヨフケ、ヒユーン　ヒユーント　コガラシノ　フク　オソラノ　上ノ　ハウデ　三ツ　ナランダ　コドモノ　ホシガ、ケンクワヲ　シマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモタチハ　コノ　バシヤノ　ソバデ　ヨク　アソビマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コドモタチヤ、コノ　バシヤハネ、オマエタチガ　マダ　ウマレナカツタ　ジブン、マダ　ジドウシヤト　イフ　モノガ　ナカツタ　トキ、ムラカラ　マチノ　テイシヤバマデ　マイニチ　カヨツタ　モノダヨ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、コハレナイ　ウチニ、ムカシ、コノ　バシヤガ　マイニチ　カヨツタ　カイドウスヂヲ　ミセテ　ヤツテ、ソレカラ　モヤシテ　シマツタ　ハウガ　ヨイト　オモフ」　コドモタチハ　ミナ　サンセイイタシマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　バシヤニ　フトイ　ツナヲ　ツケ、コドモタチハ　ソレヲ　エンヤ　エンヤト　ヒイテ　ユキマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイドウニ　ソツタ　イエイエノ　ヒトタチハ、ムカシ　ジブンタチノ　ノツタ　バシヤガ　コドモタチニ　ヒカレテ　イクノヲ　ミルト、シゴトヲ　ヤメテ　オモテニ　デテ、バシヤヲ　ミオクルノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア、チヒサイネ」「コドモデスカラネ」「コレデハ、オトナニ　ナツテモ　アマリ　オホキク　ナリマスマイ」「イヤイヤ　オトナニ　ナツタラ、コヤクラヰノ　オホキサニ　ナル」「ダマサウタツテ　ダメダヨ」「ホントウデスヨ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンノキノ　シタデ　オカアサンノ　タヌキガ　コドモノ　タヌキニ　バケル　コトヲ　ヲシヘテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
