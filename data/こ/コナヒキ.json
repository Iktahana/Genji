          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "町の粉ひきは、毎日朝早くから働いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は粉ひきの仕事を通して、地域の食を支えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "粉ひき小屋の隣には、いつもたくさんの小麦が積まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
