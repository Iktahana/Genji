        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大正八年八月、わたしが欧洲から帰航の途中、三日ばかりは例のモンスーンに悩まされて、かなり難儀の航海をつづけた後、風雨もすっかり収まって、明日はインドのコロムボに着くという日の午後である。",
              "citation": {
                "source": "はなしの話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "珍書10・20（夕）　コロムビア大学のブランダー・マシウス教授が、ある時宴会の席上で一つの難しい問題を持出した。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、中には、目の醒める様な水色のビーチ・コートにパンツと、臙脂色の可愛い海水靴と、それから、コロムビアの手提蓄音器とが、窮屈そうに押込まれてあった。",
              "citation": {
                "source": "花束の虫",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十二月一日）コロムボ　ペナンから印度人の甲板旅客が殖えた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロムボに入港する晩僕は船長の許しを得て船橋に立つて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十｜哩前から見えたコロムボ市街の灯火は美しかつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロムボの防波堤の大規模にも驚くが、其れに曾て一千万円を投じた英人の遠大な経営に更に驚く。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "防波堤が無かつたら直ちに印度洋の荒海に面したコロムボは決して今日の如く多数の大船を引寄せ得る良港とは成らなかつたであらう。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三浦工学士の友人の弟の臼井｜清三と云ふ青年が、柔術の教師として招聘されて居るサラムと云ふ一家などはコロムボで第二流の富豪だと云ふが、椰子林の収入｜丈でも毎月一万円を越える相だ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロムボで名高い釈迦｜仏陀寺を訪ふたが、近年スマンガラ僧正の歿後は僧堂の清規も振はないらしく、大勢の黄袈裟を着けた修行僧は集まつて居るが、寺内の不潔に呆れる外は無かつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十二月八日）地中海　コロムボを立つてから数日の間海水は猶九十度の温を持つて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロムボ以来十三日目に土を踏むのである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大洋に向つて石垣の一｜横線を築いた新港の規模の偉大な事はコロムボの築港などの及ぶ所で無いと想はれる。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お茶の水の卒業後暫く目白の女子大学に学び、先年父の外遊に随って渡米、コロムビア大学に留まって社会学と英文学研究中、病気に罹り中途で退きましたが、その時、荒木と結婚することになり、大正九年に帰朝いたしまして、その後は家事のひまひまに筆にいそしんで居ります。",
              "citation": {
                "source": "処女作より結婚まで",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "亜米利加土人の煙を嗜みしは、コロムブスが新世界に至りし時、既に葉巻あり、刻みあり、嗅煙草ありしを見て知るべし。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロムブスの見かけたと云ふ鯨です。",
              "citation": {
                "source": "囈語",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十四年　五月八日）印度洋　夜、新聞で見ると、長谷川二葉亭氏が肺病で露西亜から帰国の船中、コロムボと新嘉坡の間で死んだとある。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本郵船のある水夫は、コロムボで気が変になり、春画など水夫部屋に飾って拝んだりして居たが、到頭印度洋の波を分けて水底深く沈んで了うた、と其船の人が余に語り聞かせた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペナンからコロムボの中間で、余は其思出の記を甲板から印度洋へ抛り込んだ。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、アメリカのコロムビア大学のユーリ博士によって、普通の水素と同位元素である、原子量２なる、いわゆる重水素が発見され、カリフォルニア大学ルーイス博士によって、重水素を含む水即ち重水が作られてから、この国でも重水の研究が各所でなされている。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻の名にちなみてアペイと呼びしこの家は、彼が「コロムバス」その他の詩を物せし所。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海上ではホーメロスの詩に見えて居る希臘軍の將帥のアガメムノーン、近世ではコロムブスの傳記、ラ・ベルイスの傳記、乃至カピテン・クツクの傳記に見えるやうな近代航海探檢者のやうなものでなくてはなりませぬ。",
              "citation": {
                "source": "金剛智三藏と將軍米准那",
                "author": "榊亮三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆議院議長が主祭者でありましたが、其發起人は廣東人で長く米國にあつて、コロムビヤ大學を卒業した陳煥章といふ人でありましたが、朝野の名士が皆之に贊成して出席者も非常に多かつたのであります。",
              "citation": {
                "source": "支那人心の新傾向",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "クゥシェ、エオン、コロム、バブレェ、ビュイッソン、ジェローム、パスカル、マルシャンディユ……ランドリュの手帳にある名に該当するものは、八人ともみな失踪中の女性の名だということになる。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダム・コロムの服、マドレェヌ・バブレェの戦時身分証明と絹の下着、金を充填したマダム・パスカルの義歯。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダム・コロムは保険会社に働いている四十二歳の未亡人で、七千五百フランの貯金があった。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういうわけか、ランドリュはコロムの死体を念入りに細分している。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八一三年にはフイラデルフイアのジヨージ・クライマーが「コロムビア・プレス」を作り、一八二一年には紐育のラストとスミスが「ワシントン・プレス」を作り、一八二〇年にはボストンのダニエル・トリードウエルが世界最初の足踏印刷機を發明した。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニッポノホンはいまのコロムビアレコードの前身で、レーベルは赤鷲印、他にこの会社には大仏さまが音楽に耳傾けてゐる姿の商標もあり、鷲と大仏さまとは町々の蓄音機店時計店を風靡してゐた。",
              "citation": {
                "source": "大正東京錦絵",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリエントとヒコーキは今日のコロムビア系で、リガールレコードの関西版というところである。",
              "citation": {
                "source": "わが寄席青春録",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
