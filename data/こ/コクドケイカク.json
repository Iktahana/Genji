        "examples": {
          "standard": [
            {
              "text": "将来の人口減少を見据えた国土計画を策定し、コンパクトシティの実現を目指す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このプロジェクトは、国のグランドデザインを描く国土計画の重要な柱となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "国土計画の段階で住民の意見を反映させるため、各地で公聴会が開かれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "徹底せる国土計画の下にその分配を定める。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　国土計画に基き文化の大都市集中主義の弊を打破すること。",
              "citation": {
                "source": "地方文化の新建設",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂防協会、河川協会、治山協会、国土計画協会、道路協会などと、いちいち数え上げればきりがないくらいである。",
              "citation": {
                "source": "亡び行く国土",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
