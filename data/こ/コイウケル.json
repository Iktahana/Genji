        "examples": {
          "standard": [
            {
              "text": "彼は家主に何度も頭を下げ、ようやく空き部屋を安く請い受けることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "戦火から逃れてきた貴重な古文書を、図書館が寄贈として請い受ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "名匠の手による茶器を譲ってほしいと頼み込み、やっとの思いで請い受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして一人が恵み手から銭を乞い受ける間、一人はあとに退っていて尋常に待っているのでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
