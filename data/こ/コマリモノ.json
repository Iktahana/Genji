[
  {
    "uuid": "4a9a6800-a983-5fad-8d94-ee174a23150a",
    "entry": "困り者",
    "reading": {
      "primary": "こまりもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
