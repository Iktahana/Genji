        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――南無大師遍照金剛――次第に声近づき、やがて村の老若男女十四五人、くりかえし唱えつつ来る。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声近くなる時猟夫虎の子一つを落す。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしみみづくの声近づきぬ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒川氏は三説を擧げ、一は鶴峰説に同じく、二は投を殺の譌りと見て、薩摩國とし、三は和名鈔、薩摩國麑島郡に都萬郷ありて、聲近しとし、更らに投を敏の譌りとしてミヌマと訓み、三潴郡とする説をも擧げたるが何れも穩當ならずといへり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
