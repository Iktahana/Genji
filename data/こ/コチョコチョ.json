        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「やめてよ、こちょこちょ！」と子供が笑いながら逃げ回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "猫がお腹をこちょこちょされると、気持ちよさそうに目を細める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "くすぐりっこでこちょこちょすると、赤ちゃんはすぐに笑顔になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "タキは、わらわさ、なにやらし、こちょこちょと言うつけたずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりわけて、得意の術というのは、尻尾の房毛の先で、相手の脇の下をこちょこちょとやる。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "乱視の奈翁　――アルル牛角力の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちょこちょと、台所へ、出ねえように」　きのうすでに、仕上げをすました十組の小柄を、卯黄木綿の端から巻いて、それを、腰帯のうえから、しっかりと背なかへ。",
              "citation": {
                "source": "野槌の百",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえ復讐を始めるにしても、こちょこちょと小出しにこっそりやるので、自分の復讐の権利もその成功も、まるで信じてはいないのだ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖母や女中が目を離すと、コチョコチョと人ごみにまぎれ込んで、屋台のものをつまむので、そのたびにお其はハラハラしたのだろう大きな声で祖母をよんだ。",
              "citation": {
                "source": "旧聞日本橋",
                "author": "町の構成",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭は、横の新道までぬけた広いのだのに、住居にしている中蔵の前に、コチョコチョと石を積上げた築山をつくり、風入れや、日光をわざと遮ってしまって、漆喰の池に金魚を入れ、夏は、硝子の管で吹きあげる噴水のおもちゃを釣るした。",
              "citation": {
                "source": "鉄くそぶとり",
                "author": "続旧聞日本橋・その二",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊び時間、アリーと私は校庭の隅っこでコチョコチョ話しこんだ。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "怖い顔をした刑事達に、柱にしばりつけられ、コチョコチョコチョコチョと、執拗にわきの下を擽られている、あさましい我身の姿が、幻の様に浮んで来る。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
