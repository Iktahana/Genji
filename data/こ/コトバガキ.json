          "standard": [],
          "literary": [
            {
              "text": "映画のタイトルに相当する詞書の長短の分布もいろいろ変化があって面白く、この点も研究に値いする。",
              "citation": {
                "source": "山中常盤双紙",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "全十二巻の詞書というものを売っていたので買ってみると、詞書の上段に若干の画面の写真版が並んでいて、その中には上記のカットされたもののうちの二、三があるので大抵の想像が出来る。",
              "citation": {
                "source": "山中常盤双紙",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような切れ切れの絵と絵をつなぐ詞書きがなかったら、これがただ一人の自分の事だとは自分自身にさえ分らないかもしれない。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年十二季の絵も平凡でない文学的価値のある詞書きをつけて帝のお目にかけた。",
              "citation": {
                "source": "源氏物語",
                "author": "絵合",
                "note": "青空文庫"
              }
            },
            {
              "text": "安部の多が大金で買った毛皮がめらめらと焼けたと書いてあったり、あれだけ蓬莱の島を想像して言える倉持の皇子が贋物を持って来てごまかそうとしたりするところがとてもいやです」　この竹取の絵は巨勢の相覧の筆で、詞書きは貫之がしている。",
              "citation": {
                "source": "源氏物語",
                "author": "絵合",
                "note": "青空文庫"
              }
            },
            {
              "text": "境涯の句、彼の生活が彼の句の詞書だ。",
              "citation": {
                "source": "行乞記",
                "author": "広島・尾道",
                "note": "青空文庫"
              }
            },
            {
              "text": "スキンナアは汽車中の二時間ばかしで、今度の持役の台詞を、すつかり記憶え込む積りで、外套の大きな隠しから台詞書きを引張り出した。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年の春の暮、そこの妓館の一遊女、美にして利口なりしも、男に惚れてはのろき女性のならはし、男の心かはれるを見て、誓詞書かせんとて、紙とりゆきたるひまに、男逃げゆきぬ。",
              "citation": {
                "source": "常磐の山水",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "との詞書ありて、武隈の松はこのたび跡もなし　　千歳をへてや我は來つらむと詠める能因法師の歌もあり。",
              "citation": {
                "source": "白河の關",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "この宴会は二月に開かれて居り、これらの歌の次にある作の詞書には二月十日とあるから、少くもこれらの歌は、二月初旬に作られたとしなければならぬが、馬酔木の花はそんなに早くは咲かないといふのだ。",
              "citation": {
                "source": "あしびの花",
                "author": "土田杏村",
                "note": "青空文庫"
              }
            },
            {
              "text": "古今集巻十の「物名」の籠め題に「二条后の東宮の御やすん所と申しける時に、めどにけづり花させりけるを詠ませたまひける」と言ふ詞書があつて、花の木にあらざらめども　咲きにけり。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "新葉集は、詞書きの殊に多く、長いものゝ沢山ある集である。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "此だけの詞書きでは、誰にも、それの出来た境涯は、完全には察せられまい。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ある時」の傾向の詞書きは、色々ある。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "詞書きと、即かず離れずのやうな形でよまれた剣の歌が、最後になつて、ぴつたり赤心報国の意を暗示してゐるのである。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「阿須波山に住みける頃」の歌の一続きと見るべき「汐ならで」の歌の詞書きの「世を遁れて後は、それとたのむべき生業もなく、貧しうものしければ、人も養はず、何わざも自らうちしつゝ、辛きめのみ見つゝ過ぎにけるを……。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し詞書きを思はせる境遇に対して、歌が如何にも凡俗の言ひさうな類型思想である。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵解きは絵は見せるが、詞書は自分で読み上げる。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌や俳句の上では、その形が短く小さいだけに、はしがき――また、詞書きともいふ――や、その歌を作つた事情などを知るといふことが、外の文學とは別で大事なことであります。",
              "citation": {
                "source": "歌の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "書写をしたのは物語類とおよびそれに類した絵巻の詞書であった。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳田君は右の連歌の詞書の中なる「さきくさ」を「人形芝居の一曲なるか」と解しておられるが、これは曲名ではなくて遊女の名であった。",
              "citation": {
                "source": "サンカ者名義考",
                "author": "――サンカモノは坂の者",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて散木集の家綱の連歌の詞書は、伏見に傀儡のシサムというものが来たので、遊女のサキクサに合せて歌を歌わせようと之を呼びに遣わしたところが、前に居た宿にサキクサは居ないと云って来なかったので　と解すべきものであろう。",
              "citation": {
                "source": "サンカ者名義考",
                "author": "――サンカモノは坂の者",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって右の連歌の詞書は、「傀儡師なるサムカ」ではなくて、「傀儡なるシサムが」と見るべきものであろう。",
              "citation": {
                "source": "サンカ者名義考",
                "author": "――サンカモノは坂の者",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も其の歌は、其の詞書きによると、みちの國名取の郡黒塚といふ所に、源重之の妾が大勢居るといふ噂を聞いて、其の妾を鬼に見立てゝ、からかつたに過ぎないので、安達ヶ原ではなかつたのだ。",
              "citation": {
                "source": "安達ヶ原の鬼婆々（餘白録）",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは内容は詞書に讓つて、歌は感慨をその儘あらはしたものになつた。",
              "citation": {
                "source": "愛國歌小觀",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しさういふ人間的、肉体的な要素が追々と奥の方に隠れ、辛うじて歌の詞書に拠つて知ることが出来るほどである。",
              "citation": {
                "source": "『さびし』の伝統",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歌の詞書は、「長皇子与志貴皇子於佐紀宮倶宴歌」とあり、左注、「右一首長皇子」で、「御歌」とは無い。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "万葉集の詞書には、「有間皇子自ら傷しみて松が枝を結べる歌二首」とあるのは、以上のような御事情だからであった。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "○人は縦し思ひ止むとも玉かづら影に見えつつ忘らえぬかも　〔巻二・一四九〕　倭姫皇后　これには、「天皇崩じ給ひし時、倭太后の御作歌一首」と明かな詞書がある。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
