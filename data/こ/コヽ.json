        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしてコヽアでも買つて来て立てゝあげるわ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――あゝら、ぢやあたしコヽアの方が好いんだけれど今度来る時は紅茶の方買つて来るわ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてわたくしが框に上るのをそのまゝ抱きかゝえるようにして炉端へ連れて行き、わたくしを炉に当らせながら、そこへ周章てゝ出て来た宿のおかみさんに、なるべく清潔な褞袍を選んで持って来さしたり、自分の預品を使ってコヽアを溶いて作るように命じたりしました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの宿へ二十年も馴染なのです」　葛岡はと言うと、私たちがこの宿へ入って来てから先生がわたくしにかまけ切ってばかりいるのを見て、結局その方が気楽とでもいうように勝手に褞袍に着換えたり、宿のおかみさんが持出した安ビスケットや山独活の漬ものを撮んだり、コヽアを飲んだり、一人で自分の身を犒っています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼飯をすましてから学校へゆく、樹明君が宿直だからである、コヽアをよばれる、コヽアそのものよりもミルクがおいしかつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "船のなかではコヽアを註文したきりである。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このロコヽ宮殿の脚を断て。",
              "citation": {
                "source": "熱情的なフーガ",
                "author": "富永太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本帝国　東京　大関久五郎　地理学を修むる者　此宿ノ人ノ話ニ拠レバ、コレ迄吾日本帝国民ニシテコヽニ泊ッテ Jungfrau ニ登ツタ人ハ無イトノコトデス、本当カウソカハ私ハ知リマセンガ、兎ニ角コヽニ吾邦人ニシテコノ後コヽニ来リ宿ル方ニ対シ御免ヲ蒙ツテ私ノ名ヲ日本語デ書イテ置キマス。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "弥「アハヽヽ驚いちまつたな……コヽ予々お招きになりました半田屋の長兵衛で。",
              "citation": {
                "source": "にゆう",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言スレバ、諸君ハ知ラズ識ラズコヽニ永代不滅ノ資産ヲ確立スルコトヽナルノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、私ハコヽニヰナケレバナリマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ仕立屋デ、毎日、コヽデ着物ヲヌツテヰマシタノニ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ亜米利加合衆国ノ名代人タル我輩、其論説ノ正否ヲ世界中ノ公評ニ質サンガ為メ、コヽニ会同シテ、州内良民ノ名ニ代リ州内良民ノ権ヲ藉リ、謹テ次件ヲ布告ス。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "李時珍の『本草綱目』によれば、仙茅の条下に「始メ西域ナル婆羅門ノ僧、方ヲ玄宗ニ献ズルニ因テノ故ニ、今江南ニテ呼ンデ婆羅門参卜為ス、言フコヽロハ其功ノ補スルコト人参ノ如ケレバナリ」（漢文）と述べている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根川ノ西岸ヨリ山東ヲ繞テ越後国ヘノ山道アリ、コヽニ謙信馬返シ岩ト云アリ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽマデ来タンダカラチョット伊勢丹ヘ寄ロウ」ト、婆サンノ反対ヲ豫期シテ云ウト、「又冷房デモイヽンデスカ、コノ暑イノニ早クオ帰リニナッタラドウ」ト果シテ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノ通リ」ト、予ハ持ッテイルスネークウッドノステッキノ石突ヲ示シ、「コヽントコロガ取レチマッタンダヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ヲ云ウト予モ彼女ノ食イ残シガ廻ッテ来ルコトヲ豫期シテ―――或ハソレガ今夜ノ目的デ―――コヽヘ来タノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困ッタナ、僕ハトウニ食ベチャッタンデ、梅肉ヲ下ゲテ行ッチャッタンダ」「梅肉ダッテコヽニアルワ」ト、颯子ハ鱧ト一緒ニ自分ノ梅肉ヲ廻シテヨコシナガラ、「梅肉ダケ別ニ取リマショウカ」「ソレニハ及バナイ、コレデ結構」颯子ハタッタ二片ダケシカ食ベナイノニ、梅肉ガワリニ穢ラシク喰イ荒サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽニ鮎ノ腸モ取ットキマシタヨ」ト、婆サンガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「オ爺チャン、………」コヽマデ書イタラ、不意ニ婆サンガ陸子ヲ連レテ這入ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヲグウット押シテ見テ」「ア、コヽ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "足バカリジャナイ、コヽノ脹脛ダッテフックラシタ肉ガナクナッチマッテ、労働者ノ脚ノヨウナグリ／＼ガ出来ルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヽニ同程度ニ美シイ、同程度ニ予ノ趣味ニ叶ッタ異性ガ二人イルトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシアレヲ思イ出シチャッタワ」「ボクシングハタッタ一ペンシカ見タコトガナイナ」コヽヘ婆サント看護婦トガ滑リ台ノ時間ガ来タコトヲ知ラセニ来タノデ、颯子ハ一層面当ガマシク誇張的ニ話シ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハコノコトヲ少シ委シク書キ留メル必要ガ起ッタノデ、モウ一度コヽニ記ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
