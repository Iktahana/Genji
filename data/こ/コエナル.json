        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "縄暖簾も居酒屋めく米屋の店に、コトンと音をさせて鶏が一羽｜歩行いていたが、通りかかった松崎を見ると、高らかに一声鳴いた。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母は此方を見も返らで、琵琶の行方を瞻りつつ、椽側に立ちたるが、あわれ消残る樹間の雪か、緑翠暗きあたり白き鸚鵡の見え隠れに、蜩一声鳴きける時、手をもって涙を拭いつつ徐に謙三郎を顧みたり。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "城山の森から一羽のからすが羽をゆるやかに、二声三声鳴きながら飛んで、浜のほうへゆくや、白痴の親は急に話をやめて、茫然と我れをも忘れて見送っていました。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "花田が枝木を振り上げ、投げようとするところへ他の一羽の烏が何処からか空中を滑って来て、「カア」と一声鳴きました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "初蛙が枯草の中で二声鳴いた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると縁側で文鳥がたちまち千代千代と二声鳴いた。",
              "citation": {
                "source": "文鳥",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "文鳥は箱から出ながら千代千代と二声鳴いた。",
              "citation": {
                "source": "文鳥",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "王族広間の上のはてに往着き玉ひて、国々の公使、またはその夫人などこれを囲むとき、かねて高廊の上に控へたる狙撃聯隊の楽人がひと声鳴らす鼓とともに「ポロネエズ」といふ舞はじまりぬ。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "王族広間の上のはてに往き着きたまいて、国々の公使、またはその夫人などこれを囲むとき、かねて高廊の上に控えたる狙撃連隊の楽人がひと声鳴らす鼓とともに「ポロネエズ」という舞はじまりぬ。",
              "citation": {
                "source": "文づかい",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬は一声鳴いて尾をふった。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて大きいのがひと声鳴くと、他の八匹もひと声鳴く。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "輟耕録",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋草を画いた几帳が昼の風に軽くゆれて、縁さきに置いてある美しい蒔絵の虫籠できりぎりすがひと声鳴いた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "こけこっこうと鶏がまた一声鳴いた。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨蛙は竹垣の端からその葉の上へひょいと飛び移るなり、自慢の咽喉で、「け、け、け……」と一声鳴いてみました。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ作の一つに、今しも蝉が一声鳴き出した。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "予は不案内だが、親友小鳥好きの人の話に、駒鳥は夜の九時になると必ずチーンと一声鳴き、爾後静まり返って朝まで音もせぬ由。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "二声三声鳴いた牛の声は耳に入らなかつた。",
              "citation": {
                "source": "海異志",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると僕が妙な手つきをして、「にゃあ」と一と声鳴いたんだそうだ。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くで鶏鳥が一声鳴いた。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャンと一声鳴く間もなくもんどり打ってその犬は一つの花の上へ落ち込んだ。",
              "citation": {
                "source": "物凄き人喰い花の怪",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間、俊夫君は呼子笛を取りだして「ピー」と一声鳴らしました。",
              "citation": {
                "source": "暗夜の格闘",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時もうそろそろ白みかかってきた大空の上を、ほととぎすが二声三声鳴いて通って行きました。",
              "citation": {
                "source": "鵺",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　乞食はとうとう二声鳴いた。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "村じゅうがひっそり閑として夕方近い西日に照らされているこういうひととき、停車場で汽車の汽笛が一声鳴ると、その音は西日のすきとおる明るさのなかに谺して、あっちからこっちの山へとまわって響いた。",
              "citation": {
                "source": "猫車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶺鴒は一声鳴いて高く舞い上った。",
              "citation": {
                "source": "現代小説展望",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の室の前に来て、にゃごう、にゃごう……と二声三声鳴くんだ。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮は、報徳神社といふ、彼の二宮尊徳翁を祭れるもの、石段の南北に畏くも、宮樣御手植の對の榊、四邊に塵も留めず、高きあたり靜に鳥の聲鳴きかはす。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピオウと復た鳴いた時は聲が遙かに遠くなつて、三聲鳴いた時はやつと聞き取れる程であつた。",
              "citation": {
                "source": "鉛筆日抄",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "後へ反つて嘴を開いて小さな喉が裂け相にして二聲三聲鳴いた。",
              "citation": {
                "source": "おふさ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "『一度は聞いて見たきものなり』と言ひ居りしことを思ひ出して、覺えず振向けば、また一聲鳴きぬ。",
              "citation": {
                "source": "鹽原新七不思議",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
