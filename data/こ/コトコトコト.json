        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……コトコトコトコトコトコトと扉をたたく音…………。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツコツコツ……コトコトコトコト……コツンコツンコツンコツン……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコトコトコトコと滴たる音。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコトコトコトコ、トコトコトコトコ……岩壁から滴たる水の音。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコトコトコトコと水の音！",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコトコトコトコと泉の音が、微妙な音楽を奏している。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると其時、船底に当たってコトコトコトコトコトコトという、不思議な物音が聞えました。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と庭に犬を叱る低声とともに、コトコトコトと秘めやかに雨戸が鳴って、「おい！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトコトコトコトと川瀬の囁き。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーン、カーンとその音が秋の空気へ響き渡り、湯槽へ落ちる湯の音が、トコトコトコトコと聞こえて来る。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スティーム・パイプのなかでコトコトコトと鳴る音がするばかりで、素子のベッドも、あっちの壁際で、ひっそりしている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（その水筒を受けとって、中年の女はコトコトコトと走って去る）金吾　（若い女に）どうもすまねえ、そいじゃその児を、おらが――若い女　そうですか、どうか、あの、大事にね。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "金太郎もお仙も黙りこんでしまって、コトコトコトとつづいて歩く――間。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "得意の小ツルは、れいのとおり篠で切ったような細い目を見はり、見はってもいっこうひろがらない目でみんなを見まわし、「小石先生な、あのな、エイコトコトコトコンペイト」　そしてマスノの耳にくしゃくしゃとささやいた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
