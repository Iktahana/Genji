        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十年前、藩侯執政たりしとき、外寇の議論を上り、船匠・を鋳、水戦を操し学を修め、事に遇えば輒ち論説する所あり、あるいはこれを声詩に発す。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロヴァンスのトルヴァドル派の詩人、十二世紀の後半の人、その名聲詩の實質よりもダンテの讚辭に負ふところ多しといふ一一八―一二〇【レモゼスの人】グイロー・ドゥ・ボルネイユ。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
