        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "几帳の紐が動いて触れた時に、十三｜絃の琴の緒が鳴った。",
              "citation": {
                "source": "源氏物語",
                "author": "明石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「初恋の日は帰らず」と、わたしの恋の琴の緒にその弾き歌は用が無い。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一方には動物学や植物学を修めて一々の動植物を精密に調べると、あまり非詩的になって自然を漠然と眺めている者に比べると、はるかにその美に感ずる力が鈍くなり、いかなる自然の美に触れても心の琴の緒が振動せぬようになると説く人もあるが、これもけっしてさような理由はない。",
              "citation": {
                "source": "いわゆる自然の美と自然の愛",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "くさぐさの、琴の緒にふれ、思ひも深く彼ぞ歌ひし、いにしへのドリヤのしらべ。",
              "citation": {
                "source": "リシダス",
                "author": "ジョン・ミルトン　John Milton",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
