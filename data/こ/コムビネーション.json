          "literary": [
            {
              "text": "ガンジーのつよさ、力の諸源泉、そのコムビネーションについて。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、私が起き一緒に喋るのでよろこび「我々は実際よいコムビネーションだな」という。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コムビネーションという語は私が自分達につけたのが始り。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュと、ティンボール・アラスカ、コムビネーションサラダと、マロン・シャンティリーのアイスクリーム、それからアイスティーを飲み、程よき満腹で帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
