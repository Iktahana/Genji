        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「しかし戸籍上の手続きをするというのは、お互いに縛ることだから、君にも不利益じゃないか。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆゑ蘭軒の男と書したのは戸籍上の身分、茶山の姪と書したのは血統上の身分である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も此辺では、戸籍上の名と家で呼ぶ名と違ふのがありますよ。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『戸籍上は兎も角、静子はモウ未亡人ぢやないか！",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『戸籍上は兎も角、靜子はもう未亡人ぢやないか！",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も此邊では、戸籍上の名と家で呼ぶ名と違ふのがありますよ。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼の前に坐つてゐる女は、戸籍上の妻ではあつたが、今夜の出逢ひに交はした、刺すやうな眼光は、妻でも良人でもない。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝大とよばれた時代でも学力と学資があれば、もちろん、士族、平民という戸籍上の差別が入学者の資格を左右するものではなかった。",
              "citation": {
                "source": "新しいアカデミアを",
                "author": "――旧き大学の功罪――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし武士の制度が廃せられて士族というのはただ戸籍上の称呼に止る今日には、かくの如き階級的道徳は踏襲すべくもない。",
              "citation": {
                "source": "平民道",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "三百年間親戚としての往来はおろか、敵視状態だったのが、明治元年に絶交を解いて、交際が復活したからとて、両方の法主――光尊、光瑩の両裏方を、お互いに養女としあって、戸籍上の姻戚関係をむすんだといっても、お宝娘の武子さんを、となると、惜んだもののあったのも、わからなくもない。",
              "citation": {
                "source": "九条武子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸籍上父のない子供だとか、世間に隠されて生れたのだとか、そういう事柄ではなく、先刻小野君の画面で見たように、魂の窓とも云うべき眼のあたりが空虚な、そして柔かな生々とした温い頬の、なんだか不具的な存在、可哀そうな存在……そういう風に胸に触れてくるんです。",
              "citation": {
                "source": "肉体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に平塚さん自身が「共同生活」の実行者であって、久しく戸籍上及び民法上の旧式な夫婦生活から解放されておられるのですが、今に及んでこの請願を提出されることは法律の保障する旧式な結婚生活へ逆戻りされることになるように思われますが、どうでしょう。",
              "citation": {
                "source": "新婦人協会の請願運動",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "儀式、同棲、戸籍上の屆出と云ふやうな形式關係に重きを置かれる結婚にどれ丈の權威があるでせうか。",
              "citation": {
                "source": "貞操は道徳以上に尊貴である",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また今日までの社會では結婚して同じ家に住むことが出來ましたけれど、今後は經濟上または其他の事情から戸籍上の屆もせず、同じ家にも住まないで夫婦關係を結ぶ男女が次第に殖えて行くでせう。",
              "citation": {
                "source": "貞操は道徳以上に尊貴である",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "依子は戸籍上私生児となってることを、彼は考えた。",
              "citation": {
                "source": "子を奪う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度それが明治の初めに当って徴兵制の敷かれた頃で、跡取りの長男は兵隊にいかないでもよい制度だったから、その当時の風習に倣って戸籍上名儀だけだったが、師匠の妹の高村エツという人の養嗣子となり、以後高村幸吉となった。",
              "citation": {
                "source": "回想録",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん年齡といつても、先天的な――いやつまり、戸籍上のそれぢやない。",
              "citation": {
                "source": "三島由紀夫",
                "author": "ナルシシスムの運命",
                "note": "青空文庫"
              }
            },
            {
              "text": "風守と光子は同じ父の子ではあるが、戸籍上では、風守は本家の養子、本家の後嗣で、すでに兄と妹ではないのである。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "光子が兄を（戸籍上ではイトコだか叔父だかに当るわけだが）を見たのは、兄が十八、自分が十二の時であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は何も妻にはないのだが、しかし、戸籍上、夫婦であり、人の認める夫婦でもある。",
              "citation": {
                "source": "華々しき瞬間",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして戸籍上は、謄本などを取るのに面倒だから、戦前まで住んだ東京都麻布富士見町に転籍した。",
              "citation": {
                "source": "丹波篠山",
                "author": "平野零児",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸籍上の家督は長男の隼太の子供が継いでいるとはいえ、その子は再婚した母親につれられて、九州の三池に暮しているし、長じてふたたび小豆島に帰り、祖先を祀ることになるかどうかは分らない。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
