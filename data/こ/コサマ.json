        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そうして若お師匠様、あなたもうお児様が出来ましたではございませんか。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがまた女の中で育ったというもので申分の無いお稚児様に出来ているもの。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お児様方は前からこの室にお出でになっておったのです。",
              "citation": {
                "source": "正夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おお其方は森宗意軒か」言葉迄も全然変り「私は宗旨を拡めるため天から遣わされた童児であるぞ」「尊い尊い天の童児様！",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尊い尊い天の童児様！",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "汪克児　敵にお尻を見せたことのない、成吉思汗様のお馬さま、ちょいとこの汪克児様に、お尻を拝ませては下さらぬか。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児様、殿に、進発の御催促を申し上げては。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "合撒児様、もはや一刻の猶予もならぬ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "えへん、大王さま第一のお気に入りの汪克児様々じゃ。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まるまる肥った、綺麗なお児様ですこと。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はいはい」「万松寺……なるほど」「稚児様の時分ですと、一段ですが、今はあんまり風情がございませんけれど」　そこで三人は、また天守の一層を下る。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくまで深いお二人の間でありながら、お児様としては、若建王と呼ばれる御方がただ一人――それも旅から旅へといつも御不在勝ちであった為めに、御自分の御手で御養育はできなかったと申すことでございました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしより六つほどもお年下でございましたろうか、御利発なお人なつこい稚児様で、ついお懐きくださるままに、わたくしも及ばずながら色々とお世話を申上げたことでございました。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしより六つほどもお年下でございましたらうか、御利発なお人なつこい稚児様で、ついお懐きくださるままに、わたくしも及ばずながら色々とお世話を申上げたことでございました。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷹見家にも、達夫児様という宛名の手紙があり、和蘭学者との文通の手紙も沢山遺っている。",
              "citation": {
                "source": "『雪華図説』の研究後日譚",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はお偉い関白様でも、妾の眼から見ますれば、可愛らしい和兒様でござります。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう可愛らしい和兒様に何で嘘など申しましょう」「行こう行こう、伏見へ行こう！",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
