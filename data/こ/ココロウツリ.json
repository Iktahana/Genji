        "examples": {
          "standard": [
            {
              "text": "新しいモデルのスマホが出ると、すぐに心移りしてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は一途だと思っていたが、あっさりと心移りしたらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "趣味がコロコロ変わるのは、ただの心移りなのだろうか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "考へて見れば冥加至極とも何とも云ひやうなき難有き若殿の思召とは思ふけれど、妙な心持の具合で何れ忍男に心移りがしない。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "基盛　どうしても遂げられないような恋ならば、早々に心移りしてしまえば、よいではないか。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
