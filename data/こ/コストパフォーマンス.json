        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "高価なブランド品だが、長く使えることを考えればコストパフォーマンスは高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "宣伝に頼らず口コミで広まったその商品は、コストパフォーマンスが抜群だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "投資した金額に見合う成果が得られたか、コストパフォーマンスを検証する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
