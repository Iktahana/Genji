        "examples": {
          "standard": [
            {
              "text": "小さなカフェは、コージーな雰囲気で、読書をするのに最適だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の部屋は、暖炉とたくさんのクッションで、とてもコージーに設えられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ああ、このブランケット、すごくコージーだね。眠くなってきたよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "非常にコージーでよろし。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥だらけの市場通りと深い轍がついてしまったタウン街を舗装するための籤を数多く購入し、そのおかげで道には大きな丸石が敷き詰められ、中央に煉瓦敷の歩道ないし「コージー」を持つようになった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
