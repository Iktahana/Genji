          "literary": [
            {
              "text": "私は、或る意味でコケテイシユなものではあるが、然し快い勝利を覚えましたので、照子と共にちよつと笑ひました。",
              "citation": {
                "source": "愚かな朝の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "諛ひに慣らされた彼の感情は、こゝで息の根を止めらるゝ程な高びしやな嘲笑を浴せられて、此方もそれに合せてコケテイシユな戯談でヘラヘラと笑つて了ふことの方に多くの肉体的の満足が想像出来た。",
              "citation": {
                "source": "坂道の孤独参昧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
