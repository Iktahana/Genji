          "literary": [
            {
              "text": "たいがいお寒いものか、デタラメか、コケオドカシである。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントに安心して目をつぶるか、シマッタとあわてふためくか、それとも死にぎわの一芝居というんでコケオドカシの大芝居を打つか。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうもそこにコケオドカシがあるように思われて、辛抱しかねた。",
              "citation": {
                "source": "庶民の食物",
                "author": "小泉信三",
                "note": "青空文庫"
              }
            }
          ]
        }
