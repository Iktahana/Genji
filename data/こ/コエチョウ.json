          "literary": [
            {
              "text": "ねぶたし、ただねぶくて早や識らず戦も、弾丸も、ねぶたし、眠らしめてつかのま母の声聴かしめ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "春さきの、あは雪の、消なば消ぬかの、声聴きてけり、そのしばらくは。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "春さきの夜のあは雪の消なば消ぬかの声聴きてけり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が声聴かせた時の親の喜び、親に代わってお礼申し上げまする。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねぶたし、ただねぶくて早や識らず戰も、彈丸もねぶたし、眠らしめてつかのま母の聲聽かしめ。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
