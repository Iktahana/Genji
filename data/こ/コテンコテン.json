        "examples": {
          "standard": [
            {
              "text": "昨日の試合で、うちのチームは相手にこてんこてんに打ち負かされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "徹夜で勉強したら、試験会場で頭がこてんこてんになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はあまりにも疲れていたので、あっという間にこてんこてんに眠ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "そのとき良寛さんの長頭が、こてんこてんと左右にかたぶくので、うしろから見てゐる下男は可笑しくなつて、つい、ぷつ、と噴き出してしまつた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
