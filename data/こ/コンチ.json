        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コンチャどうも結構なお天気ですな。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これから東京で生活して行くにはだね、コンチワァ、という軽薄きわまる挨拶が平気で出来るようでなければ、とても駄目だね。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーツァルトのフリュウト・コンチェルトに眼を細める。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここまで書いた時に宅のラジオが鳴り出して、バッハのト短調、チェンバロ・コンチェルトというのを聞かせてくれた。",
              "citation": {
                "source": "ラジオ雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故に、連句三十六景のコンチニュイティは容易に暗記が出来るが、レビューの二十八景の順序は到底覚えられそうもないのである。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして事情の許す限りは物質を空隙のないコンチニウムと見做す事によってその運動や変形を数学的に論じる事が出来た。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　ロバータ　前に見た「コンチネンタル」と同じく芸人フレッド・アステーアとジンジャー・ロジャースとの舞踊を主題とする音楽的喜劇である。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（コンコンチキチン、コンチキチン、コンチキチン、カラ、タッポッポ）摺鉦入れた後囃子が、遥に交って聞えたは、先駆すでに町を渡って、前囃子の間近な気勢。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "風間は真白い歯を出して笑って、コンチワ、と言う。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの狭い石段から眺めるシャトウ・モウトン・ロスチルドと名づけられた一八六九年のボルドウ酒やロマネー・コンチという一八七〇年のブルガンディ酒やはその名前の罎を見るだけでフランス人の飲食物に対する執拗な愛慾を観察するに役立つ。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大ありのコンコンチキ……」「ふーん。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ではコンチャといっている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "神戸からずっといっしょであった米国の老嬢二人も、コンチャーの家族も、いよいよここで下船して、ジェルサレムへ、エジプトへ、思い思いに別れて行くのであった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "じっさい、トーイズの〈ラヴァーズ・コンチェルト〉なんて、ギターコードでゴリゴリとは、およそ無関係な曲も好きだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの發音法は大部分大陸｜讀方（コンチネンタル・メソツド）を用ゐられた樣ですが、日本で云ひ慣らされたバツカスとか※ーナスとか云ふのは英吉利讀にされたと見えますから其邊は一寸讀者に注意して置いて遣らないと惡いだらうと思ひます。",
              "citation": {
                "source": "『傳説の時代』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕は、かつぎ屋だから……」と、あまりに近づく、美和子の肌を遠ざけながら立ち上って、片隅のビクトロラの蓋を払って、バッハのコンチェルトをかけた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、エレクトロラの蓋を払って、コンチタ・スペルビアのスペイン歌謡曲をかけると、自分も小声で共に和しながら、酒場の中を、一、二度行きつもどりつした。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そう云うと、美和子はエレクトロラにかけ寄って、コンチタのレコードを、アンコールした。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランドの『安南民俗迷信記』にコンチャニエンとて人に似て美しく年｜歴ると虎に化ける猴ありと。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸ッ子の「コンチワ」が「チヤア」で済むようなもんでげしょう。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンチワ……コンチワコンチワ……」　二人の子供はビックリして砂だらけの顔を見合わせた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ジャン、チェーコン、リウコン……コンリウ、コンジャン、チェーコンチェー……チェーリウコンコンジャンコンチェー……じゃんすいじゃんすい、ほうすいほう……すいすいじゃんすい、ほうすいほう……」　子供は又も黒い顔を見合わせた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなあるとき、自動車の中で自然に手の指の触れた肱つきのダイヤルを廻すと、突然バッハのコンチェルトが聴えて来たことがあった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大嘘吐きのコンコンチキさね。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで初めて神様コンチクショウと呶鳴りたくなります。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
