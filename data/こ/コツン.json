[
  {
    "uuid": "e49804e3-cb9f-5af4-890b-46fde3997ed8",
    "entry": "コツン",
    "reading": {
      "primary": "コツン",
      "alternatives": [
        "こつん"
      ],
      "is_heteronym": false
    },
    "grammar": {
