[
  {
    "uuid": "961cd66e-8d83-58fa-9aad-6de30c6f6d09",
    "entry": "こぎ着ける",
    "reading": {
      "primary": "こぎつける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
