[
  {
    "uuid": "c79d38b6-419d-52a8-ab8c-5041326e7967",
    "entry": "焦げ付く",
    "reading": {
      "primary": "こげつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
