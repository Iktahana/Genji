  {
    "uuid": "3156e601-67c8-5536-9dc6-2f157929d356",
    "entry": "香水",
    "reading": {
      "primary": "こうすい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "perfume",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女が通り過ぎた後、ふわりと上品な花の香水の匂いが残り、思わず振り返ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「香水のつけすぎは周りの迷惑になるから気をつけて」と、母からマナーを教わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大切なデートの日、彼は自分に一番似合うと思う爽やかなシトラス系の香水を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "適度の文明的人工物は、自然をして軽快ならしめ、森や林や山巒に、微かな香水の匂ひをあたへる。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "香水、麝香、油煙、マニラの臭氣相混じて一種縁日臭を作り、靄々然として、人自らそが上を蹈み、そが中を歩めり。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「春の香水、ヴィオレット・ド・バルム」気が利き過ぎて却って張り合いがない。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "白皙の肌の匂ひと、香水の匂ひとでぎつちりだつた。",
              "citation": {
                "source": "ラムネ・他四編",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬へばそれは憂鬱な香水に深く涵した剃刀である。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "洒落た切子細工や典雅なロココ趣味の浮模樣を持つた琥珀色やひすい色の香水壜。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "香水の壜にも煙管にも私の心はのしかかつてはゆかなかつた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そう云って、園子はそっと香水をにじませた手巾を鼻さきにあて、再び二階へ上った。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花から取った香水や、肌色のスメツ白粉や、小指のさきほどの大きさが六ルーブルに価する紅は、集団農場の組織や、労働者の学校や、突撃隊の活動などとは、およそ相反するものだ。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "香水、クリイム、ピン、水白粉、油、ヘアネット、摺り硝子の扇形の壜、ヘチマ形の壜。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これさえ抑えとけば、香水をつけたり、絹の靴下をはいたりして、封建時代の気分を呼び戻そうとするような、反動分子に何も手にはいれゃしなかったのだ！",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋でも花瓶に花卉を盛りバルコンにゼラニウムを並べ食堂に常緑樹を置くが、しかし、それは主として色のマッスとしてであり、あるいは天然の香水びんとしてであるように見える。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草の味もやはり甘ったるい、しつっこい、安香水のような香のするものであったような気がする。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "洒落た切子細工や典雅なロココ趣味の浮模様を持った琥珀色や翡翠色の香水壜。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "香水の壜にも煙管にも私の心はのしかかってはゆかなかった。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一びん百円の香水でもとにかく売れて行くのである。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くあなたの頭に瓶の中の香水をよく振りかけてください。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そして戸の前には金ピカの香水の瓶が置いてありました。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はその香水を、頭へぱちゃぱちゃ振りかけました。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその香水は、どうも酢のような匂がするのでした。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この香水はへんに酢くさい。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」アーティストは、私の頭に、金口の瓶から香水をかけながら答へました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうふうに考えてみると、書物という商品は、岐阜提灯や絹ハンケチや香水や白粉のようなものと同じ部類に属する商品であるように思われて来るのである。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "佳い香水のかをりより、病院の、あはい匂ひに慕ひよる。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱を差したように両人気はしっくり合ってるけれども、その為人は大いに違って、島野は、すべて、コスメチック、香水、巻莨、洋杖、護謨靴という才子肌。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私のとこのアーティストは、私の頭に、金口の瓶から香水をかけながら答えました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はその香水を、頭へぱちやぱちや振りかけました。",
              "citation": {
                "source": "注文の多い料理店",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
