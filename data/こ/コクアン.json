        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "インド神話に登場する黒闇は、災いを打ち払う力を持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "黒闇の像は、寺院の奥深くに静かに祀られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "瞑想中に黒闇の存在を感じ、畏敬の念に打たれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
