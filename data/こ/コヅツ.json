        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なんどき外国と戦争を始めるかも知れないというので、江戸近在の目黒、淀橋、板橋、そのほか数カ所に火薬製造所をこしらえて、盛んに大筒小筒の鉄砲玉を製造したんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "正雪の絵馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の石級の下に老いたる盲の乞兒ありて、往きかふ人の「バヨツコ」（我二錢｜許に當る銅貨）一つ投げ入れむを願ひて、薄葉鐵の小筒をさら／＼と鳴らし居たり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾耳はかけ樋の小筒。",
              "citation": {
                "source": "長塚節歌集　上",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "次は大井と庄司とで各小筒を持つ。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "押へは大筒一｜挺を挽かせ、小筒持の雑人二十人を随へた瀬田で、傍に若党｜植松周次、中間｜浅佶が附いてゐる。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し自分は矢張｜雪駄穿で、小筒も何も持たなかつた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには広瀬が京橋組の同心三十人に小筒を持たせて来てゐた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、打て」と云つて、坂本は待ち構へた部下と一しよに小筒をつるべかけた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂本の背後にゐた本多が金助を見付けて、自分の小筒で金助を狙ひながら、坂本に声を掛ける。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "四辻の辺に敵の遺棄した品々を拾ひ集めたのが、百目筒三挺車台付、木筒二挺内一挺車台付、小筒三挺、其外｜鑓、旗、太鼓、火薬｜葛籠、具足櫃、長持等であつた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "其内に小筒六十｜挺弓二十｜張がある。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "門内には番頭が控へ、門外北側には小筒を持つた足軽百人が北向に陣取つてゐる。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "海をゆく者は横濱の沖へ乘り出して、そこにかゝつてゐる黒船に大筒小筒を撃ちかける。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "隆景の士、佐世勘兵衛正勝はその儀然るべからずと諫めたから、四郎兵衛は左に、五郎兵衛は右に備を立てて対陣し、大筒小筒を打合ったが、四郎兵衛の手の内｜三吉太郎左衛門元高の旗持が弾に中って倒れた。",
              "citation": {
                "source": "碧蹄館の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "かゝれ、かゝれ、寄衆もつこてかゝれ、寄衆鉄砲の玉のあらん限りは、とんとと鳴るは、寄衆の大筒、ならすとみしらしよ、こちの小筒で、有りがたの利生や、伴天連様の御影で、寄衆の頭を、すんと切利支丹。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを打つ手の総大将田沼様の御手勢かれこれ三万余人、そのあらましを申さんに、先ず先手には切先手組、御徒組さては大砲組、小筒組、御持組、大御番には両御番と来た。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さても、戦の有様見てあれば、だ、利あらずと見て逃げるは天狗、追うは田沼勢、府中は小川のあたり、ドンドンパチパチ大砲小筒、鳴るは蜂の頭、引くは天狗の鼻、さあてこの次第如何相成りまするか、ただ今、ホコダ塚に於て合戦真最中！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、何しろ小川以来の難戦苦戦だ、大砲小筒で追い打ちかけられている最中だ、そこへからんで来たので、うるさくなって、やったらしい。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "加多　神勢館で砲学をやっていた人で、あれでも小筒にかけてはまず名人。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度その時、突然右手より、ターンと烈しい小筒の音が響いて、弾が仙太郎の腰の辺に命中したらしい、アッと倒れかかって、その辺をキリキリ舞いをする。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを打つ手の総大将田沼様のご手勢かれこれ三万余人、そのあらましを申さんに、まず先手には切先手組、御徒組さては大砲組、小筒組、御持組、大御番には両御番と来た。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利あらずと見て逃げるは天狗、追うは田沼勢、府中は小川のあたり、ドンドンパチパチ大砲小筒、鳴るは蜂の頭、引くは天狗の鼻、さあてこの次第如何相成りまするか、ただいま、ホコダ塚において合戦真最中！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、何しろ小川以来の難戦苦戦だ、大砲小筒で追い打ちをかけられている最中だ、そこへからんで来たので、うるさくなって、やったらしい。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（丁度その時、突然右手より、ターンと烈しい小筒の音が響いて、弾が仙太郎の腰の辺に命中したらしい。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏に環があって、それで壁に懸け、内部には水を入れる竹の小筒が入っている。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
