        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "併し謝源は少しも残念がる様子もなく或夜コツソリと一そうの小舟で首里からのがれて行つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜明方に起きて、一人でコツソリ山へ來て、大きな奴を採つたあとには落葉をかぶせて、根太を絶對に人には知られんやうにしておく。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アノ　コヒツジハ　ウマサウダ」ト　イツテ、ヌスビトハ　ソノ　コヒツジヲ　コツソリ　ヌスンデ　フトコロニ　イレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に青年が人目を忍ぶやうに、品川からたゞ一人、コツソリと乗つたことが、美奈子の心を、可なり傷けた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことをいふと古くさいと笑はれるかも知れないが、みじんまく――即ちおしやれは、人に知られず自分だけコツソリしてこそ引きたつ、同性だからかまはないといふのは違ひはしまいか。",
              "citation": {
                "source": "春",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ今日はムチに見舞はれると思つたので、その時は両手で耳と頭を抱へて、力一ぱい喚き上げようと、みんなコツソリ相談し合ひました。",
              "citation": {
                "source": "先生と生徒",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウンと出した、パラリと出した、チヨツキリ切つて――」　すると、この騒ぎを聞きつけて、先生の奥さんがコツソリやつて来て、心配さうに止めるのです。",
              "citation": {
                "source": "先生と生徒",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コツソリと抱付いて見る雑司ヶ谷空蝉つゝましく田端で降りる主婦の友雨吉大久保の青葉へ帰る小官吏同四谷駅公設へ来る妻と逢ひ同どうもよく焼けると高架線の窓也奈貴　なんとそのころ山の手の郊外のしづかすぎるほどしづかだつたことよ。",
              "citation": {
                "source": "大正東京錦絵",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて昭和十八年の暮近い網代で、釣果はあまりなかつたが、海の上でコツソリぶりを買つて上陸した事があつた。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
