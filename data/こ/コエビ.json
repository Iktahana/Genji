[
  {
    "uuid": "1c3257f8-718f-5748-9344-25fd6431d458",
    "entry": "小エビ",
    "reading": {
      "primary": "こエビ",
      "alternatives": [
        "こえび",
        "コエビ"
      ],
      "is_heteronym": true
    },
    "grammar": {
