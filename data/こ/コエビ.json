        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ここのかき揚げ、小エビがプリプリしていて美味しいわね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "たっぷりのオリーブオイルとニンニクで小エビを炒め、アヒージョを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "サラダのトッピングとして散らされた小エビが、彩りと食感のアクセントになっている。",
              "citation": {
                "source": "Illusions AI",
