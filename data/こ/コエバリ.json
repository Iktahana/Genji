        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "団九郎声張り上げて、Ｔ「拙者天下の浪人　宮本武蔵政名と申す」　で取次の侍、例の如く驚いた。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "賞められて一層声張りあげると、あちこちの部屋で、客や妓が笑った。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりようやく薄暗く工夫体の男｜甲走りたる声張り上げて歌い出せば商人の娘堪えかねてキヽと笑う。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "と唱い終ると、また他の一人が声張り上げて、桑を摘め摘め、爪紅さした　花洛女郎衆も、桑を摘め。",
              "citation": {
                "source": "雁坂越",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし今度は、前の日自分が腰掛けた岩としばらく隠れた大な岩とをやや久しく見ていたが、そのあげくに突然と声張り上げて、ちとおかしな調子で、「我は官軍、我が敵は」と叫び出して山手へと進んだ。",
              "citation": {
                "source": "雁坂越",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供が声張りあげて草津節をうたつてゐる、「草津よいとこ一度はおぢやれ、お湯の中にも花が咲く」チヨイナ／＼、ほんとうにうまいものである、私はぢつとそれに耳を傾けながら物思ひに耽つてゐるのである、――此間の年数五十年相経ち申し候だらうな。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "親に不孝な馬鹿声張り上げ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「“There's somebody waiting for me……」　鴎丸は樽野を厭がらせるために、声張りあげて歌つた。",
              "citation": {
                "source": "円卓子での話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇少年の輝いた胸と晴れやかな顔と、さうして少年の周囲で声張上て万歳を唱えてゐる少年達の表情をよく見て下さい。",
              "citation": {
                "source": "喜びと悲しみの熱涙",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋは栄輔君に誘はれて、その浴舎――浴舎と言つてもさう大して大きいものではないが、兎に角其処に一時は村の人々が集つていろ／＼義太夫なんか声張り上げて唄つたであらうと想像される家が、すつかり荒廃して、浴槽の中には、赤銅色をした水が一杯にさびしく湛えられてゐるのをＫは目にした。",
              "citation": {
                "source": "田舎からの手紙",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌てて追っても去りはしない、お捻りを献ずれば、じろりと流眄に見るばかり、また一段と声張り揚げて、「うらみ数え日家蔵とられた仇敵に近江屋――あれ、よしこの何だえお茶漬さらさら」　近江屋はほとほと困じ果ててしまった。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "お茶漬音頭",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪声張るＸ大使――白人種結社から派遣されたスパイ？",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "別れの歌だ唄ってくれ」「うん」というと甚三は、声張り上げて唄い出した。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」如来衛門は鼻の先で嘲るように笑ったが、声張り揚げて答えをした。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "由子は自分の肩をお千代ちゃんの肩にぴったりつけ、顔を上に向け、恍惚と声張り上げてうたった。",
              "citation": {
                "source": "毛の指環",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつはこのほどより乳房｜垂れて、常ならぬ身にしあれば、雄が非業の最期をば、目前見ながらも、救くることさへ成りがたく、独り心を悶へつつ、いとも哀れなる声張上げて、頻りに吠え立つるにぞ、人々漸く聞きつけて、凡事ならずと立出でて見れば。",
              "citation": {
                "source": "こがね丸",
                "author": "巌谷小波",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔法の歌手声張り上げれば、虚空に数千の火花が飛び散る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ほんのしばらくの間、ジッと師匠は考えていたが、やがてのことにさらにひとッ調子声張り上げて、「よせよせ今松、あの角のはよせ、三軒目のうちのほうがよっぽど美味えや」羊羹綺譚一　さすがに一方の大看板雷門助六。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "おととい剃ったも今道心、ただ道心では分り申さぬ、と同時にこんな張りのある訥弁の声いろが、あとから耳許へ聞こえてきた、木の葉の合方、山嵐や谺の鳴物も聞こえてきた、扇で半面隠して一生懸命声張り上げている小勝師匠の高座姿さえマザマザとして見えてきたのだった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "一段と声張り上げて、「黒鞣革の手綱を山形に通して後方に廻して鎧の上帯に結びつけ、しずしずと乗り出したり……」　カカカカカカカチン。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、傍できいていたひとりの女給さんが、ホーモーサーってなんのことかときいたり、琉球ってどこなのかときいたりするので、面倒くさくなって来て、ぼくは大声張りあげて、また枯すすきをうたい出すと、みんなもまたうたい出したのである。",
              "citation": {
                "source": "酒友列伝",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "連理の枝一　柴折戸の入口から、城太郎は声張りあげて、「お通さん、ただ今」　奥へ呶鳴っておいてから、彼は、そこの家を繞っているきれいな流れの側に坐りこみ、ざぶざぶと脛の泥を洗っていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と十五｜珊速射砲のほとり、後部艦橋の下に耳を濟ます、兵曹、此處ぞと琵琶おつ取り、翩飜と飄る艦尾帝國軍艦旗の下に膝を組んで、シヤシヤン、シヤラ／＼と彈き出す琵琶の曲、聲張上げて「雲に聳ゆる高山も。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "否、もう少し中に入つて行くと、室が奧から奧へと二つも四つも連つてゐて、その室毎にさうした女と狩衣の袖を亂した男とがゐて、たまには女が聲張上げて歌をうたひ、それにつれて傍にゐるやゝ年老いた女が琵琶を彈き、男は男でその頃流行る小曲を歌つた。",
              "citation": {
                "source": "道綱の母",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、聲張り上げて唱つた。",
              "citation": {
                "source": "父の婚禮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "朽ちにたる聲張りあげてわがおもひ叫ぶとすれど、空し、ただあざれしにほひ。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "派手なるそろひ肩ぬぎて聲張りあぐるこころ意氣、そのすがた見てくらぶれば戀にふさはぬわが思。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
