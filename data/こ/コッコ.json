    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それからもう何時だかもわからず弾いているかもわからずごうごうやっていますと誰か屋根裏をこっこっと叩くものがあります。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳳仙花や百日草が咲き、村の子が遊び、鶏がけけっこっこっこっである。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄が太い声でこけっこっこと云うと、雌が細い声でけけっこっこと云う。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、裏の納屋の方で、鶏が大きな声を出して、こけこっこううと鳴く。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると真闇な道の傍で、たちまちこけこっこうという鶏の声がした。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "こけこっこうと鶏がまた一声鳴いた。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「犬のことを云ったら、犬便、犬のおしっこ、一寸、こう片足を上げて、石の上へ――」　南玉は、軒下の石のところへ立って「しい、こっこっこ、しいっ、こっこっこ」　いくら経っても、南玉は、小便を止めなかった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼬こっこ鼠こっこ、実に馬鹿らしくて面白くない。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏は何も知らないで、こっこ、こっこと庭に遊んでいます。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うちのこっこちゃん、殺されるのいやね」　静子がさびしそうにして、とても気にしています。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、おじいさんとおばあさんは、お庭のまん中に、えんやら、えんやら、大きな臼を持ち出して、おじいさんがきねを取ると、おばあさんはこねどりをして、「ぺんたらこっこ、ぺんたらこっこ。",
              "citation": {
                "source": "桃太郎",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぺんたらこっこ、ぺんたらこっこ。",
              "citation": {
                "source": "桃太郎",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん山深く入っていって、ある村の中に入りますと、何かお祝い事があるとみえて、方々でぺんたらこっこ、ぺんたらこっこ、もちをつく音がしていました。",
              "citation": {
                "source": "しっぺい太郎",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとからあとから　どんぶりこっこ、ぶくぶくぶくぶく　おぼれて死んだ。",
              "citation": {
                "source": "魔法の笛",
                "author": "ロバアト・ブラウニング",
                "note": "青空文庫"
              }
            },
            {
              "text": "おんどりはこけこっこうと、ときをつくりました。",
              "citation": {
                "source": "ブレーメンの町楽隊",
                "author": "DIE BREMER STADTMUSIKANTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ところが　ぶちの　めんどりは　こっこっと　なきながら　なやのなかへ　かけこんで　――　「なっる、　はだし、　はだし、　はだし！",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道では、父と同じように「こっこ」という言葉はあるが、つづけて、「娘っこ、こつこ」とは云わないので、私たちは、そんなときには腹をかかえて笑った。",
              "citation": {
                "source": "おもしろい話",
                "author": "畔柳二美",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コケコッコウ」　遠くに競争者が現われる。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コケコッコウ」　一声――二声――三声――もう鳴かない。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケケコッコ――谺に響く鶏の声、浦の苫屋か、峠の茶屋か。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言い、「ただありうることは――」　その言葉は、内部屋の方から来る、鋭いコッコッという音で妨げられる。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "めんどりはびっくりして、コッコッコと鳴きながら、羽をひろげて、小さなひなどりたちをかばいました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニワトリは、たいへんかわいらしい、短い足をしているので、おばあさんは、「短い足のコッコちゃん」と、呼んでいました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「短い足のコッコちゃん」は、とってもよい卵を生むので、おばあさんは、まるで、自分の子供みたいに、かわいがっていました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコは、のどをゴロゴロ鳴らし、ニワトリは、コッコと鳴きだしました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなに知らせてやろう」「みんなに知らせてやろう」と、コウモリは、チーチー鳴き、メンドリはコッコと鳴き、オンドリはコケッコ、コケッコと鳴きました。",
              "citation": {
                "source": "ほんとにそのとおり！",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば、コケコッコーでも、カック・ア・ダッダルドウでも※の声だらうし、太鼓の音を、ドンドンドンと吾々の幼時から云ひ現はし慣れてはゐるが、ラッバダブ・ラツバダブでも別段に反対の称へようもない――まつたく私は藤村の寝言の叫びを“Hurrah!”と聞いたのである。",
              "citation": {
                "source": "環魚洞風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "椰子や芭蕉や棗の木などにこんもりと囲まれた広庭は彼ら土人達の会議所であったが、今や酋長のオンコッコは、一段高い岩の上に立って滔々と雄弁を揮っている。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　悠然と床几へ腰かけたままオンコッコ酋長はまず云った。",
              "citation": {
