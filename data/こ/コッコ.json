    "definitions": [
      {
        "index": 1,
        "gloss": "national treasury",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "没収された金塊は国庫に入れられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "政府は国庫の負担を減らすために増税を検討している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "災害復興のために国庫から多額の資金が拠出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "約一年余の時日を費やす予定で、その費用として一万六千ルーブル（約一万三千円）を国庫より支出することとなったそうである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今で云へば県庁を襲撃し、県令を生擒し、国庫に入る可き財物を掠奪したのに当るから、心を天位に掛けぬまでも大罪に相違無い。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「百五｜磅から百五｜磅四分ノ一まで」「では、ニュウジーランド国庫公債は？",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のごとく神林伐り尽されては、たとい合祀のため田畑少々開けて有税地多くなり、国庫の収入増加すとも、一方には鳥獣絶滅のため害虫の繁殖非常にて、ために要する駆虫費は田畑の収入で足らざるに至らん。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "『起世因本経』二に転輪聖王世に出づれば主蔵臣宝出でてこれに仕う、この者天眼を得地中を洞し見て有王無王主一切の伏蔵を識るとあるから、よほど古くより梵土で伏蔵を掘って国庫を満たす事が行われたので、『大乗大悲分陀利経』には〈諸大竜王伏蔵を開示す、伏蔵現ずる故、世に珍宝｜饒し〉という。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "文人の本来は感興を重んじて機械的に頭脳を働かすべき筈で無いが、幸いに印刷術の進歩が文人の頭脳の組織をも一変して、名什傑作が轆轤細工のようにドシ／＼出来たなら、今までのように実際家に軽蔑されないほどの収入を得て、貧乏な日本の国庫を富ますに足るほどの文学税を納める事が出来るかも知れない。",
              "citation": {
                "source": "駆逐されんとする文人",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "この旅客の落す金額は、国庫の最も重要な収入となっている。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し余が貴下に五百万マルクの支出を承諾するならば、穀物を国庫の損失補償の下に売却すると同じである。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "）「五ヵ年計画」の文化建設プランの中で、ソヴェト同盟は三十四億七千六百留を、全同盟の国庫負担四ヵ年義務教育実施のために支出している。",
              "citation": {
                "source": "砂遊場からの同志",
                "author": "――ソヴェト同盟の共学について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう経験をもっていて労働者農民の国ソヴェト同盟の暮しを見たのだから、プロレタリアートの国ソヴェト同盟では、国庫全額負担の失業手当があり、養老保険があり、小学校から大学まで労働者にとっては無料であると語る時、なみなみでない情熱が感じられ、私は自身失業の身ではあり、思わずのり出して聴き入りました。",
              "citation": {
                "source": "共産党公判を傍聴して",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校の入費の何割が国庫で負担されることになるのだろうか。",
              "citation": {
                "source": "国民学校への過程",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊豆地方の大震災　惨たる各地の被害　震源地は丹那盆地　死者二百三十二名　伊豆震災救済策　震災地方の納税減免　国庫負担法で業務教育費交付　両腕の動かしかたに共通の一種独特の職業的癖をもっている日本の列車ボーイが沈着な声で誰かに云ってる。",
              "citation": {
                "source": "ニッポン三週間",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "九年制にしてどの子供もその間は勉強出来るように国庫がその保証をしてやらなければこのインフレーションの中で月謝を払い御飯を食べさせ学用品を買ってやるということは益々貧困化して来ている親の多数にとって負担である。",
              "citation": {
                "source": "女性の歴史",
                "author": "――文学にそって――",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロレタリアート新文化建設の一進展として、文部省は五ヵ年計画の終りには完全な国庫負担による四年制の全国民教育を実施しようとしているのであります。",
              "citation": {
                "source": "三月八日は女の日だ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校、工場附属技術学校、いずれも国庫および職業組合の負担で、プロレタリアートの児童のために開放されている。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通は貴族か地主、軍人、技術家、大きな実業家の息子に限られていたが、今はプロレタリアート、働く者への教育は全部国庫負担にするということを理想でやっている。",
              "citation": {
                "source": "ソヴェト・ロシアの素顔",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、今度五ヵ年計画によって、すっかり国庫負担で全ソヴェト学齢児童就学ということになった。",
              "citation": {
                "source": "楽しいソヴェトの子供",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミーチャの母さんは、労働婦人は、産前産後四ヵ月の給料つき休暇の貰えること、赤坊の仕度金と九ヵ月の特別哺育費が国庫から支出されること、産院が無料であることなどを、その簡単な言葉の中で、タマーラに思い出させたのだ。",
              "citation": {
                "source": "楽しいソヴェトの子供",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴェト全同盟内の子供が国庫負担で四ヵ年の教育を受けることになるのだ。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "文化建設のために大きい予算をもって、例えば日本の教育費削減とは反対に、ソヴェトでは国庫負担の学校、托児所、教員がうんとこの二三年の間に増やされる。",
              "citation": {
                "source": "ひとごとではない",
                "author": "――ソヴェト勤労婦人の現状――",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラブ　　　　　七六四六（五ヵ年計画以前に比べ二四・九パーセント増）農民の家　　　　六八二〇（同　二五パーセント増）――国庫全額負担の小学校――　さて、一九一七年の十月のプロレタリア革命の後、ソヴェト同盟で、子供はどう教育されて行くかということが、世界各国からの、鋭い興味と観察の的だった。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このように有効に組織されている小学校へ、全同盟の学齢児童を経費国庫負担で包括しようというのがソヴェト同盟五ヵ年計画文化活動の一大事業だ。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五ヵ年計画で八歳からの全国学齢児童の国庫負担による就学は、勿論、各民族共和国、自治国を包含してのことだ。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、例えば、国庫負担の全学齢児童就学の問題が起った時、作家は決して引っこんで小説だけ書いて納ってはいなかった。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴェト同盟では全額国庫負担の小学教育を実行しようとしています。",
              "citation": {
                "source": "ソヴェト同盟の婦人と選挙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "国庫全額負担による小学校教育等が実現されたのである。",
              "citation": {
                "source": "ロシア革命は婦人を解放した",
                "author": "――口火を切った婦人デーの闘い――",
                "note": "青空文庫"
              }
            },
            {
              "text": "国庫予算の中でも終戦処理費があまり厖大であるためにわれわれ人民は各種各様の課税にくるしんで来ている。",
              "citation": {
                "source": "便乗の図絵",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの困難に加えて六・三制は全額国庫負担の義務教育として実行されていない。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからもう何時だかもわからず弾いているかもわからずごうごうやっていますと誰か屋根裏をこっこっと叩くものがあります。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳳仙花や百日草が咲き、村の子が遊び、鶏がけけっこっこっこっである。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
