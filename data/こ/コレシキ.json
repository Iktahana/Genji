  {
    "uuid": "b950f568-0ff1-59cc-bacd-104f6c653832",
    "entry": "此式",
    "reading": {
      "primary": "これしき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
