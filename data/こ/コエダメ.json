[
  {
    "uuid": "3ba2788f-d1f2-58ed-93a3-97b3e1e4586d",
    "entry": "肥溜め",
    "reading": {
      "primary": "こえだめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
