    "definitions": [
      {
        "index": 1,
        "gloss": "tank for holding human waste (used for fertilizer)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "田舎の畑の奥にある肥溜めには、絶対に近づくなときつく言われていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "うっかり足を踏み外して肥溜めに落ちそうになり、肝を冷やした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "肥溜めに溜まった肥料は、数ヶ月寝かせてから畑に撒くのがコツだという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "肥溜めさえ見えなければ、日本とは思えない」　といいながら、高志も慶一のとなりにきて、手すりにもたれかかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのフキやシダのあいだに、低い藁屋根をさしかけた肥溜めがひとつ、もうすこしいくと、炭焼き小屋もあるが、煙は出ていない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたの立っているところは、むかし、肥溜めがあったところだ」　まんざらウソではない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これなら、肥溜めのほうがましだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "樫の木の下の肥溜めに向って放尿しながら答えた。",
              "citation": {
                "source": "昔の火事",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "路地や拱門路からは、それだけの数の下肥溜めがあると同じように、疎らに家の立っている街上へ、胸の悪くなるような臭気と、塵埃と、生物とを吐き出していた。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻道傍にあった肥溜めなんかは原始的家屋の標本さ。",
              "citation": {
                "source": "好人物",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "付近に肥溜めなぞがあって、むろん若様がたの立ち入るところでない。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、眼の当り、子供が道傍の肥溜の中に逆さに落っこちて、死んでしまったのを見たり、なぜともなしに、瘠せ細って死んで行くのを、手の施しようもなく見せつけられたりしたら、それこそ、堪えられない事であろう。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかすると風呂場が肥溜と一つになっている。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちは黄いろの実習服を着て、くずれかかった煉瓦の肥溜のとこへあつまりました。",
              "citation": {
                "source": "イーハトーボ農学校の春",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（※‥‥‥　コロナは三十七万十九　※‥‥‥　※‥‥‥　　　　　　　　　　　　　　　　　　　　）　くずれかかった煉瓦の肥溜の中にはビールのように泡がもりあがっています。",
              "citation": {
                "source": "イーハトーボ農学校の春",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥溜は家の側に肥桶小屋があつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は桶を小屋へ持つて行つて、その内容物を少しづつ柄杓で抄つては、肥溜へあけた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "といふ風に動かして、「さうか、肥溜の中へでも、つまみ込んでしまへばよかつたのに。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬のデカは大正二年の二月自動車に轢かれて死に、猫のトラは正月行衛不明になり、ピンは五月肥溜に落ちて死んだ。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して此頃では、むッといきれの立つ堆肥の小山や、肥溜一ぱいに堆く膨れ上る青黒い下肥を見ると、彼は其処に千町田の垂穂を眺むる心地して、快然と豊かな気もちになるのである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而かも其の湯槽は肥溜でなく靈驗あらたかなる温泉である。",
              "citation": {
                "source": "温泉雜記",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼奴は鶏が食っても死にますから、肥溜へ棄てるより外ありません」「厄介ですな」「けれども面白いんですよ。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうだい、番人の代るたびにやる、あの手を野郎にも食わせておいちゃあ」「むむ肥溜の行水か。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを合図に、眼くばせ交わしたごろつき連は、智深をとり囲んで、なんのかんのと、次第に彼を大きな肥溜のある畦のはずれへ誘いだした。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊田一夫に、「続水戸」の中で、助さんが肥溜へ入浴の件を池に変えて貰ふことをたのむ、ウン水はどうもいかん。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スーパーＤＴＰ「大地」は肥えだめの哀れな編集者を救うのか　ジャストシステムが発表したデスクトップ・パブリッシング・システム（場所ふさぎなので、以下はＤＴＰと書く。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七九年にジャストシステムが設立されたころ、オレは編集プロダクションの屋根裏で、肥えだめに落ちたガキのように日本語にまみれていた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレが日本語処理の肥えだめで溺れかかっているころ、彼らは日本語処理の突破口を開きつつあった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけても若殿の時之助には、足を一本叩き折つて、肥だめへ投り込みたいほどの怨みがある」「默れツ」　孫三郎は我慢がなり兼ねました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "紅筆願文",
                "note": "青空文庫"
              }
            },
            {
              "text": "女が高荷を背負つてゐたために、馬が驚いて狂奔したといふのを理由に、氣の立つてゐた時之助は、怪我をして肥だめに落ちた女を見捨て、そのまゝ屋敷へ引揚げて來たのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "紅筆願文",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼弁慶　お肝試しの会は、書生の杉山が安斉先生にお裏山の畑の肥だめへ投げこまれて、おやしき中の評判になった。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
