        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかるところ、唯今申上げました（コンニチゴゴツク、ヨウイ）で、不意に故障が起りました、幾度も接続を試みますうちに、うかと記憶に残ったのです。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――嘘ついたら、エンマはんに舌抜かれるし」　そして、上ると、他吉はもう蒲団をかぶって寝ていて、枕元にコンニャクの形の空気草履が並べて置いてあった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一銭天婦羅屋は十五年、牛蒡、蓮根、コンニャクの天婦羅を揚げている。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは「コンニチワ」「オハヨオ」などというような種類のものであったが、あまり発音が変っているから、はじめは日本語だとは気が付かないくらいであった。",
              "citation": {
                "source": "異郷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめのうちはかなり白々しくて、うたう気にもなれなかったが、規制をうけるとコンニャロメってわけで『友よ』や『栄ちゃんの』などをうたいだした。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｊ村の道を歩いてゐると、突然コンニチハといふ幼い聲がする。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "思はず此方も笑つて了つて、コンニチハ、イイコダネといふと、子供達はもう一度コンニチハとゆつくり言つて大變叮嚀に頭を下げた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等と話を始めようとしたのだが、生憎、コンニチハの外、何にも日本語を知らないのである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人ともニコ／＼しながら何度もコンニチハと言つて頭を下げるだけだ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｊ村の道を歩いていると、突然コンニチハという幼い声がする。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "思わず此方も笑ってしまって、コンニチハ、イイコダネというと、子供たちはもう一度コンニチハとゆっくり言って大変｜叮嚀に頭を下げた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らと話を始めようとしたのだが、生憎、コンニチハの外、何にも日本語を知らないのである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人ともニコニコしながら何度もコンニチハと言って頭を下げるだけだ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "□コンニヤクのうまさも解つた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン　コンニチハ」「オヤ　テフテフサン　コンニチハ」「アカチヤンノ　オメメハ　アキマシタカ」「ケサ　ヤツト　アキマシタ」　ミルト　オウマノ　アカンボハ　ネワラノ　ナカデ　パツチリ　オメメヲ　アケテ　オトナシク　シテ　ヰマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コウでも駄目だと、あらゆる推理や想像を捏ねくりまわしたあげく、トウトウ悲鳴をあげ初めて『脳髄が、脳髄の事を考えるとはコレ如何に』なぞと、場末の寄席みたようなコンニャク問答の鉢合せを繰り返している現状ではないか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……結局、そんな連中で、寄ってタカって、一か八かのコンニャク押問答をフン詰まらせたあげく、僕がその評議のマン中に呼び出される事になったもんだ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは市の体面を傷つけるし、衛生上又は公園の本来の性質上立ち退かせねばならぬというので、市の方から八釜しく云っているが、酢のコンニャクのと云ってなかなか立ち退かない。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪漢の口にしていた舌はコンニャクであった。",
              "citation": {
                "source": "餅を喫う",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして朝から眞夜中まで、身體がコンニヤクのやうになる程馳けずり廻はされた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "学生の食堂の高利貸爺のこと、貧しい深見の父の一生、そして、貧しい大学生でコンニャクおでんのおとくいである主人公のこと。",
              "citation": {
                "source": "一九四六年の文壇",
                "author": "――新日本文学会における一般報告――",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンニャク、がんもどき、竹輪につみれ、辛子のひりりッとしたのに、口にふくむような酒をつかって、青々としたほうれん草のひたしですか、元気を出しましょう。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕御飯のおかずは、いつもの通りに、するめの煮たのに、コンニャク、そばでは、出前のカツレツが物々しい示威運動で黄いろく揚っている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "真黒いコンニャクの煮〆と、油揚げ、里芋、雑魚の煮つけ、これだけが祭の御馳走である。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンニャクとコロッケととろろ昆布のすまし汁。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――君、コンニヤクの粉をもとにした代用粉と云ふものを食つた事あるかね？",
              "citation": {
                "source": "愛する人達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私はやけに頬紅をはくと、大学生は薄いコンニャクのような手を合わせて、「怒った？",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
