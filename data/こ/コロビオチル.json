        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "音もない風が、梢から転び落ちると、恰度跼み込んだ女生徒のスカートを、ひらりと反したのです。",
              "citation": {
                "source": "足の裏",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳生は、物すごい叫びをあげて、どうと鞍から転び落ちる――「や、やっ」　張虎は、怖れて、にわかに逃げかけた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうっと、転び落ちる土煙とともに、袁紹以下、旗下達も、声をあわせて、御曹司袁尚の手柄をどっと賞めたたえた。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨露次は転び落ちるような恰好で、中へはいった。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
