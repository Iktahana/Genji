        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」声変りがしかけた市三だった。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "近き田のころころ蛙、よく聴けば声変り鳴く。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "声変り、一つ一つに、あなをかし、鳴けるさま見ゆ。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "声変り一つ一つに、あなをかし、鳴けるさま見ゆ。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の病中、奉公人どもの飼い方が悪かったので、あたら名鳥も声変りしたのではないかと、念のためにその鶉籠を枕もとへ取り寄せてみると、鳥はいつの間にか変っているのであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "一つ目小僧",
                "note": "青空文庫"
              }
            },
            {
              "text": "声変わりのした鴬――ゆく春と共に衰えゆく身の行く末を、雛吉はおそらく想像するに堪えなかったのであろうと、日頃の気性を知っている人びとからいたまれた。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "富裕なるロンドン市が世界に誇る、英国の暮し向よき中流層を拡大させつつ東端には一時的ならぬ貧を二代三代とかさねさせているうちに、この逆三角の顔を持ち七歳ですでに早老的声変りをした異様な小人間がおし出されて来たのである。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と声変のしている甲子の打消すのが聞えた。",
              "citation": {
                "source": "九月一日",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼にとつては、声変りの期間も過ぎ、芸に欲も出、最近お早を勤めようと言ふ頃まで居た人だから、同座した節だけも、目に留めて見ては居たであらう。",
              "citation": {
                "source": "街衢の戦死者",
                "author": "――中村魁車を誄す――",
                "note": "青空文庫"
              }
            },
            {
              "text": "声変りを通過したばかりの天星庄右衛門は、古風の役者としては、相当な舞台顔は持つてゐたが、二枚目和事役者として、家の芸技をついで、美貌の鴈治郎を凌駕するだけの修練を積んで行かねばならなかつたのである。",
              "citation": {
                "source": "実川延若讃",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "何事にも鴈治郎と対蹠の立ち場にゐた我当（十一代目仁左衛門）は、恩怨のない延若遺孤に好意を寄せて、声変りの彼に、丁稚役ばかりを宛てがつて、目を掛けたと言ふ。",
              "citation": {
                "source": "実川延若讃",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "咽喉が脂肪ぶくれに腫れふさがったせいだろうが、彼は声変りがして、ほそい甲高い声になった。",
              "citation": {
                "source": "イオーヌィチ",
                "author": "JONYCH",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいえ、寝なくちゃ駄目、寝なくちゃ駄目」と、カテリーナ・リヴォーヴナは又しても声変りのした、おどおど声でくり返しざま、少年の腋の下をかかえて、むりやり枕につかせた。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう言葉を用いるのが許されるならば、青年は声変わりの時期にあったのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "邪念の無い細面で、小柄で色白で、女の児のようですが、声変りのせいか、声は思いの外太く、態度に何んとなく人を喰ったところがあります。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "毒酒薬酒",
                "note": "青空文庫"
              }
            },
            {
              "text": "一七四九年、声変りがして教会の合唱隊から追い出され、十八歳の少年が着のみ着のままで街に彷徨しなければならなかった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六の時声変りがして、宮廷合唱隊を去ることになったシューベルトは、もう「第一交響曲」を書き上げているほどの飛躍ぶりであった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その埋み火が、新に薪を添えられて、燃えさかる情熱となったのは、綾麿が十七の年、声変りがして、鼻の下が薄黒くなって、理性と情慾と、信仰と迷信と、渦を巻いて五体を駈けめぐり始める頃でした。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "観音様の頬",
                "note": "青空文庫"
              }
            },
            {
              "text": "声変りだったのです。",
              "citation": {
                "source": "凡人凡語",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつならそろそろ声変りするのも当然だ」　その平和がどうもぼくにある種の感情を持っているらしい。",
              "citation": {
                "source": "凡人凡語",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は急き込んだ口調で、水に氷が入つてゐないぢやないか、お冷を持つて來いと云つたら、ブツカキを入れて持つて來るなあ、云はなくつたつてわかつてることなんだ、間拔け奴、と聲變りのした聲で怒鳴るのであつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、文吾は一晩のうちに聲變りがしたのか、大人のやうな調子で言つて、眞ツ先きに源右衞門の節くれ立つた手にある白く細い籤を摘まんだ。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "」田舍の少年の聲だまだ聲變り前とみえて少女のようなこわ音だ俺はびつくりして返事ができない少年はさして氣にかける樣子もなく再び笛を唇に運んで吹き始める俺は合掌小屋の中にこごみ入り少年と並んで坐つた少年は息のあるだけを吹きすましてから笛をわきに置きしばらく黙つていてから「さぶいなあ」「君は誰？",
              "citation": {
                "source": "捨吉",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聲はもう大人になりかけて、僅かに聲變りの響を留めてをります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美少年國",
                "note": "青空文庫"
              }
            },
            {
              "text": "邪念のない細面で、小柄で色白で、女の兒のやうですが、聲變りのせゐか、聲は思ひの外太く、態度になんとなく人を喰つたところがあります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "毒酒藥酒",
                "note": "青空文庫"
              }
            },
            {
              "text": "華奢で、聲變りで變な太い聲さへ出さなきや、女の子と間違へますよ」「それつきりか」「まだありますよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "毒酒藥酒",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
