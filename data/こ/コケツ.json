  {
    "uuid": "d3a34f61-eac6-5176-b3dd-e30144ebadb2",
    "entry": "コケツ",
    "reading": {
      "primary": "こけつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
