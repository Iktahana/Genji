  {
    "uuid": "b88dbb33-bfc0-5e6e-be3b-9e003b09ff49",
    "entry": "葫蘆",
    "reading": {
      "primary": "ころ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "calabash (Lagenaria siceraria)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夕顔の実が、見事な葫蘆の形に育っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の人は、葫蘆を水筒代わりに使っていたそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "縁側に吊るされた葫蘆が、夏の風物詩となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "地中海沿岸で知れ渡つた葫蘆科植物の一種、小さい胡瓜に肖たるその針ある果実は云ひ知れぬ活力と精力を賦与されてゐる。",
              "citation": {
                "source": "卓上演説",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "身には狐の皮衣をまとい、酒をいれた葫蘆を、お供の童子に持たせてくる。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、なお、「そこの葫蘆谷に、兵を伏せて相待たば、曹操はかならず南夷陵の道を避けて、北夷陵をさして逃げくるであろう。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中、葫蘆谷をこえてゆくと、非常に距離がみじかくなります」「さらば、南夷陵へ」と、すぐその道をとって急いだ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "午すぎた頃、すでに同勢は葫蘆谷へかかった。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "格別、先生の口唇が、鼻腔が可笑しいといふのぢやない、起立して、先生の後から歌ふ生徒等が可笑しいといふのでもない、それどころか、俺は大体、此の世に笑ふべきものがあらうとは思つちやゐなかつた。",
              "citation": {
                "source": "夏と悲運",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなむしろ邪魔されて欲しいくらゐのところへ、この挨拶は、一寸ツカないものであつた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシックはテンポが遅いどころか、「ああした深いことをもう云つてのけたのか」と、君が若しミュジックなるものの存在に耳を触れるに相応しければ当然感ずる次第なのであつたかも知れない。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで音楽批評家はといふと、「どうだ、夜の絵は――さう日光の御厄介ばかりならんで」なぞと画家に云ふ画家の叔父さんみたいな思ひ付きを並べるか、（まあその叔父さんなんざあ甥に親愛を感じて云つたのだからまあまんざら空無ではないがね。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが世間が、不景気だ、ボヤボヤしてはゐられないと云へば云ふ程、インテリにとつてその世間たるや住みにくい世間となる。",
              "citation": {
                "source": "作家と孤独",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々あるどころか無数にあつて、空気中のオゾンの量に因ると考へる人だつてないとは云へぬ。",
              "citation": {
                "source": "山羊の言",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはさて、今よりも、子供の時分の方が、よつぽど海は好きだつたやうだから、してみると今よりも、あの頃の方が「こころまゝ」だつたのだらうか？",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "なれは喜ぶなが影の、すがたの海に跳び入りて、眼に腕にかい抱き、それな固有のざはめきに、なれがこゝろはなごむなり、抑へがたなきはた荒き、浪の歎きのかの響き　もはや眺めてはゐられなくなつた、跳び込んで、眼に腕にかい抱き、それな固有のざわめきに、なれがこころはなごむのだ。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり彼は詩人として第一に大事な点に於ては決してころがりつこないのだ。",
              "citation": {
                "source": "草野心平詩集『母岩』",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜景萩原朔太郎高い家根の上で猫が寢てゐる猫の尻尾から月が顏を出し月が青白い眼鏡をかけて見てゐるだが泥棒はそれを知らないから近所の家根へひよつこりとび出しなにかまつくろの衣裝をきこんで煙突の窓から忍びこまうとするところ。",
              "citation": {
                "source": "夜景",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔まひるつとめにまぎらひて〕宮沢賢治まひるつとめにまぎらひてきみがおもかげ来ぬひまはこころやすらひはたらきしそのことなにかねたましき新月きみがおももちをつきの梢にかゝぐれば凍れる泥をうちふみてさびしく恋ふるこゝろかな",
              "citation": {
                "source": "〔まひるつとめにまぎらひて〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自力だけを恃み、方法を尽したところで舌鼓を打つて「あゝうまい」と思ふ境地は、絶対の力を俟つてこそ得られるのであつて自力をばかり恃んで、舌鼓を無理に打つてみても舌が荒れるくらゐのものである。",
              "citation": {
                "source": "詩壇への願ひ",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで現今精神的渇望だの信念だのの方は微々たるものであるので、所詮現今の社会たるや、卑俗なものといはねばならぬ。",
              "citation": {
                "source": "詩と現代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで萩原氏は文学的苦労人である。",
              "citation": {
                "source": "萩原朔太郎評論集　無からの抗争",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが著いてみると、恐ろしい当て外れだつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それどころか子供に関する温しきに過ぎる若干の詩篇なぞは、愚弄さへされたのであつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういふことを、都の人は、えてシラジラしいことのやうにも考へるやうですが、却々それどころでもないのです。",
              "citation": {
                "source": "感情喪失時代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と彼は思ふ、「あんなにアラがあるから、あのアラが契機となつて、却て奴等は仕事が出来るのであらう……」　ところでさういふ場合に彼のアラと云つてゐるものは、概ね処世的要領の稚拙の如きを指してゐるのである。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでＢは文学談を始めるとする。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、心理的生活（要するに一般生活）を営んでゐる者が、文学的生活（文学でなくもともあれ何かに打込んでゐる生活）を営んでゐる者に会つたつて、あんまり話のあるものではないのだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでＡでは、Ｂが「弁解をしだした」とか、「強がりだした」とかしか思へないのだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいどころかＢは別れたいのだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂといふ人間全体として何も無邪気ぢやないまでも、文学にしか頭が向かないところから、その他のことでは、尠くも不慣れくらゐのことはある。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでＡはいつになく和んでゐるのだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところでＢの方が不平を抱く時は、悲劇なのだが、Ａの不平は悲劇でもない。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
