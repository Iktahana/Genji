          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この辺りでは、夏から秋のころに祭りが開催される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "卒業のころになると、皆が将来について語り合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供が産まれるころには、新しい家に引っ越したいね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
