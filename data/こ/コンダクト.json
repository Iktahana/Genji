        "examples": {
          "standard": [
            {
              "text": "企業のコンダクトが社会に与える影響は大きい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この組織では、従業員に高い倫理的コンダクトを求めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のプロフェッショナルなコンダクトは、周囲から高く評価されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "）ひつさげて、大合唱のコンダクトを執つた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "始め、銀キラキラの真中に老コンダクターを出して一寸びっくりさせ、おわりに死んだ二人の若者を並べて又コンダクトするところなどいいメロドラマだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
