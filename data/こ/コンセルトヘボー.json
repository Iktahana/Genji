        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "メンゲルベルクが手慣れた管弦楽団アムステルダムのコンセルトヘボウを指揮している良さであろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第一シンフォニー＝ハ長調作品二一」は吹込みの新しいテレフンケンのメンゲルベルク指揮を採ろう（五三六二〇―二）、管弦楽団はアムステルダムのコンセルトヘボウだ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第三シンフォニー（英雄）変ホ長調作品五五」は重要作品で、レコードの数も夥しいが、最近ビクターからＮ・Ｂ・Ｃを指揮したトスカニーニと、コロムビアから米国の管弦楽団を指揮したワルターと、テレフンケンからコンセルトヘボウを指揮したメンゲルベルクと、三種のレコードが日本でプレスされることになっている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第四シンフォニー＝変ロ長調作品六〇」は、テレフンケンのコンセルトヘボウを指揮したメンゲルベルク（四三六〇八―一一）と、ビクターのＢ・Ｂ・Ｃを指揮したトスカニーニ（ＶＤ八〇八六―九）とあるが、管弦団の関係で、前者の方に魅力がある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第八シンフォニー＝へ長調作品九三」は、コンセルトヘボウをマスターする、テレフンケンのメンゲルベルクの老巧さを第一とするだろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コリオラン」序曲は少し古いがメンゲルベルク指揮コンセルトヘボウ管弦団以外に良いのはない（コロムビアＪ八〇四二）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボールト、ビーチャム、メンゲルベルクといろいろの人が指揮しているが、メンゲルベルク指揮コンセルトヘボウのレコードが良かろう（テレフンケン三三六一〇）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちで私は五年前の旧著「ロマン派の音楽」に書いたことをもう一度繰り返して、メンゲルベルクがコンセルトヘボウを指揮したレコードを名盤として挙げたい（コロムビアＪ七六一一―二）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "レコードは夥しく入っているが、吹込みは古くとも私はコロムビアのメンゲルベルク指揮、コンセルトヘボウ管弦団の壮麗さを推したい（Ｊ八〇九二―三）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは名演奏には相違なく、優雅で端麗でさえあるが、私は少し古いレコードではあるが、メンゲルベルクがコンセルトヘボウを指揮したレコード（コロムビアＪ八一五四―七）の愛情と覇気を忘れ難いものと思っている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つテレフンケンに入っているメンゲルベルクがコンセルトヘボウ管弦団を指揮したレコード（二三六八一―五）も、これに相並ぶ情熱的な名演奏だ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
