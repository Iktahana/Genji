[
  {
    "uuid": "79aaac83-b4ce-5ea4-aa7d-230d00ecf7cc",
    "entry": "古廟",
    "reading": {
      "primary": "こびょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
