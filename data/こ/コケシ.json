[
  {
    "uuid": "22187abd-8e0b-544f-a024-821ad0bfa645",
    "entry": "小芥子",
    "reading": {
      "primary": "こけし",
      "alternatives": [
        "コケシ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "limbless wooden doll",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "東北旅行の記念に、工人さんが一つずつ手描きした小芥子を買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女のぱっつん前髪と丸い顔立ちは、どこか可愛らしい小芥子を連想させる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "温泉街の売店に並ぶ、色とりどりの小芥子を眺めるのが楽しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "庄内の小芥子人形は遠い土地だけに余り世間に知られていないようですが、木製の至極粗末な人形で、赤ん坊のおしゃぶりのようなものですが、その裳の方を持って肩をたたくと、その人形の首が丁度いい工合に肩の骨にコツコツとあたります。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こけし」の作者も、しつかりした天分をもつてゐるやうに思はれる。",
              "citation": {
                "source": "珍重すべき国際感覚",
                "author": "――芥川賞（第二十六回）選後評――",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さなこけし人形や千代紙や、封筒や便箋を蒐集することが好きであった彼女は、それを少しずつ私にわけてくれた。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "郁子は三つ、綿入れの絆纏を着て、色は白く、こけし人形のようである。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのガラス窓には、料金表が掲げてあり、その下には男女のこけし人形が並んでいる。",
              "citation": {
                "source": "落日の光景",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "長坂ヨノ、廿歳……大きな子供の身丈ぐらいしかないおチビさんで、こけし人形とそっくりの顔をしている。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "千々子さまはニッコリ笑って、「こけしちゃん、あなたのいうこと、よくわかったわ……でもね、これはシュラー・ハークネスの二十八歳のお誕生日のプレゼントで、ＰＸなんかで売っているモノとはモノがちがうのよ」　ミドリさまが、すぐ、あとからいった。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいだけ遊んでいらっしゃい」　思わせぶりなことを言い、留守番にした気で、じぶんは、こけしちゃんという、チビの女中を連れて熱海か湯河原かへ遊びに行ってしまった。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたが百着もドレスをもっているとは、思っていませんよ」「じゃ、ここへ電蓄を運ばせましょう……お気になさらないで、音楽はサービスですから」　サト子は、こけしちゃんに言って、座敷に電蓄を運ばせた。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり訪問着を着たりすると、おみやげのこけしさんのようになるわね。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こけし」人形は方々で作られ、むしろ流行にすらなりました。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳴子温泉の「こけし」も名が聞えます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こけし」の語原は分りませんが、人形としては特色あるものであります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "北の国には「こけし」を土産物に作る所は多いのでありますが、鳴子のは絵が上手なように見受けられます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより「こけし」のみならず挽物で独楽だとか針入だとか様々な玩具も作ります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとうさんやおじさんたちが旅行のおみやげにくださった、いろいろの地方の人形が、こけし人形をはじめとして、ウジャウジャならんでいます。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠に月を吐き出だす雲　　　　　　　　夕菊秋山に荒山伏のいのる声　　　　　　　　翁　樵る人も無くこけし神の木　　　　　　友五　是などは鼠は頼豪阿闍梨などの聯想もあって、一つの物語風の作意であったかと思われるが、神木が自然に倒れたという風に、思い及んだのはこのころの常識であったろう。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
      "synonyms": [
        "芥子人形"
      ],
      "antonyms": [],
      "related": [
        "伝統工芸",
        "人形",
        "木工品"
      ]
    },
