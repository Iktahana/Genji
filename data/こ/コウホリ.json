          "literary": [
            {
              "text": "アンガウル島へ燐鉱掘りに狩出されて行く良人を浜に見送る島民の女は、舟の纜に縋ってよよと泣き崩れる。",
              "citation": {
                "source": "南島譚",
                "author": "※",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「芋掘も忌だが、鉱掘も忌だねえ。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラスカに金鉱掘りに行って雪に埋められて、一ぺんは凍死しとったげな。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンタ金鉱掘りより儲ける。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "家庭と學校との教育は、さかしき鑛掘、鑛鋳などのやうに、これを索め出だし、これを吹き分くるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
