      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to load (a gun, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "猟師は獲物の気配を感じ取ると、音を立てずに銃に弾を込めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "映画の主人公が、決死の覚悟で最後の一発をシリンダーに込めるシーンに息を呑んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "競技銃に弾を込める一連の動作には、茶道のような無駄のない美しさがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼らは、たがひに相手を澤山の新しい名でもつて呼びあひ、それからまた、耳環でもはづすやうに、そつとそれを引き込めるのだつた。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは遠慮なしに飲んで食って、踊りの家台の噂などをしていたが、雨はだんだん強くなるばかりで、家の老婢があわてて軒提灯や飾り花を引っ込めるようになって来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが自然の癖になって、紙で撫でられるとすぐに首を引っ込めるようになる。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "たよりない幼いものに対する愛憐の情の源泉がやはり本能的なものだということが、よくのみ込めるような気がする。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地下の百姓を見てもすぐと理屈でやり込めるところから敬して遠ざけられ、狭い田の畔でこの先生に出あう者はまず一丁｜前から避けてそのお通りを待っているという次第、先生ますます得意になり眼中人なく大手を振って村内を横行していた。",
              "citation": {
                "source": "初恋",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "花田　　そうつけつけやり込めるもんじゃないよ、女ってものは。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢本　　そうつけつけやり込めるものじゃないよ、女ってものは。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "慧鶴は折角、寝ても覚めても思索一途に嵌り込めるようになった心境の鍛錬を俗人との世間咄しに乱されてしまうのは惜しくて堪らなかった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、それと同時に、第一に吾等の胸を打つたのは、櫻木大佐等の乘込める海底戰鬪艇の安否である。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と慌しく引込める。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに野育ちの彼でも多少の理屈は呑込めるのである。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の主人は子供に物を言って聞かせるように、引金や、弾丸を込める所や、筒や、照尺をいちいち見せて、射撃の為方を教えた。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "弾丸を込める所は、一度射撃するたびに、おもちゃのように、くるりと廻るのである。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度森が歩哨を出して、それを引っ込めるのを忘れたように見える。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "虚子の作物を一括して、是は何派に属するものだと在来ありふれた範囲内に押し込めるのは余の好まぬ所である。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロック抜きも螺状をなしているから能く突込めるのだよ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とようよう膝去り出して、遠くから、背を円くして伸上って、腕を出して、巻莨に火を点けたが、お蔦が物指を当てた襦袢の袖が見えたので、気にして、慌てて、引込める。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "とくる／＼とりながら輪を卷いて、卷き／＼卷込めると見ると、忽ち凄じい渦に成つて、ひゆうと鳴りながら、舞上つて飛んで行く。",
              "citation": {
                "source": "雪靈記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけで手を引込める事もあるが、なおも黙って手を差し出したままでいる事もある。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当に良心をもって、情熱をぶち込める仕事は、この二つしか世の中に無いと思っている。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　熊本君は、私が佐伯をやり込めると、どういうわけか、実に嬉しい様子であった。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを汚すようだから、雁首で吹溜めの吸殻を隅の方へ掻こうとすると、頑固な鉄が、脇明の板じめ縮緬、緋の長襦袢に危く触ろうとするから、吃驚して引込める時、引っかけて灰が立った。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻りながら輪を巻いて、巻き巻き巻込めると見ると、たちまち凄じい渦になって、ひゅうと鳴りながら、舞上って飛んで行く。",
              "citation": {
                "source": "雪霊記事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "事物そのものに内在せる悲劇が作用いて救い難い暗さに迄私を塗込める。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし何といつても、現在身を打込める仕事を（或ひは、生活を）有つてゐないことが一番大きな原因に違ひない。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "祥子は、かわいそうな話と恐い話が好きで、アラビアン・ナイトの悪魔を壺へ封じ込める話など、幾度もくり返して聴きたがった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "散歩にも出かければ、好きなものを見にもゆく、はなはだ勝手気ままのやり方ではあるが、こうして好きなことをして一日遊ぶと今まで錯雑していた頭脳が新鮮になって、何を読んでもはっきりと心持ちよくのみ込める。",
              "citation": {
                "source": "わが中学時代の勉強法",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方になって池の面が薄い霧のヴェールに蔽われるころになると何かしらほのかな花の匂いが一面に立ちこめる。",
              "citation": {
                "source": "浅間山麓より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うの隅でも銃を取って立ちあがると、ガチッと遊底を鳴らして弾丸をこめる者があった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "道いかばかりなりけむ、漫々たる水面やみのなかに銀河のごとく横わりて、黒き、恐しき森四方をかこめる、大沼とも覚しきが、前途を塞ぐと覚ゆる蘆の葉の繁きがなかにわが身体倒れたる、あとは知らず。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to put into (e.g. emotion, effort)",
        "register": "standard",
