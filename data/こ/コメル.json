[
  {
    "uuid": "68981056-55d0-530f-ac06-a06999dced21",
    "entry": "込める",
    "reading": {
      "primary": "こめる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
