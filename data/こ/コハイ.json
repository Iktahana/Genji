          "literary": [
            {
              "text": "これがコハイし、面白いものである。",
              "citation": {
                "source": "小杉放庵",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "牝牛、騾馬、山羊と三段にわけたあたり、「鹿も四肢、馬も四肢」と叫んだ源氏の大将より、よほど動物学の知識はあるが、これ、少々コハイみたいな訓示である。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに波子も一緒だったから、別の上等なコハイ（旅館）にはいった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
