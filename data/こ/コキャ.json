          "literary": [
            {
              "text": "大蔵流本狂言『二人大名』に闘鶏の真似する声、コウ／＼／＼コキャコウ／＼／＼とある。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは闘う時声常に異なり劇しい故コキをコキャと変じたらしい。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "神道の人はコキャウ（古教か）と同じだという。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
