          "literary": [
            {
              "text": "「アノ　コヒツジハ　ウマサウダ」ト　イツテ、ヌスビトハ　ソノ　コヒツジヲ　コツソリ　ヌスンデ　フトコロニ　イレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、コヒツジハ　コロサレルトハ　チツトモ　シラズニ　ヌスビトノ　カホヲ　ミアゲテ　ヰルノデ、ヌスビトハ　キウニ　カワイサウニ　ナリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ　フトコロニ　コヒツジヲ　イレテ、「シカタガ　ナイカラ、コノ　コヒツジハ　オレガ　ソダテテ　ヤラウ」ト　ヒトリゴトヲ　イヒナガラ　ヤツテ　ユクウチ　トツプリ　ヒガ　クレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヒツジハ　オカアサンノ　オチチガ　コヒシク　ナツテ　キテ、「メイ　メイ、オカアチヤン　オカアチヤン　オチチ　ノミタイ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
