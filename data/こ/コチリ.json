          "standard": [
            {
              "text": "古地理の研究は、地球の過去の環境を知る上で重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地域の古地理は、地層の分析から明らかになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古地理の知識は、化石の分布を理解するのに役立つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "かんこちりめんといふ、これは苦労して働いた家刀自の愛のやうな感じのちりめんで、やはりその頃母の古着のなかにあつたやうに覚えてます。",
              "citation": {
                "source": "縮緬のこころ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
