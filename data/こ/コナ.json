        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は昔、悪い仲間に誘われて粉に手を出してしまったそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "街の裏社会では、粉の取引が横行していると噂されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "警察は大規模な粉の密輸組織を摘発したと発表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
