        "examples": {
          "standard": [
            {
              "text": "彼は上司に媚びへつらうことで、自分の立場を確立しようとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は誰に対しても媚びへつらうことなく、常に堂々としている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の言動からは、媚びへつらう姿勢が見え隠れしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "どこでも大きなものに媚びへつらう、卑屈な奴等がうまくやって行くのだ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたくしに媚びへつらう群と、あたくしを罵詈讒謗する群と……とても耐え切れませんわ」愛人「なるほど。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "利休は媚びへつらう佞人ではなかったから、恐ろしい彼の後援者と議論して、しばしば意見を異にするをもはばからなかった。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か物がほしい時には、にゃあにゃあじゃれついて、媚びへつらうが、用が無くなれば、知らん顔をして、そっぽ向いて、呼んでも返事をしない。",
              "citation": {
                "source": "猫先生の弁",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様も丞相から睨まれて、荀※や荀攸みたいな終りを遂げたいのか」　崔※も、負けていずに、「およそ、媚びへつらう輩ほど、主を害するものはない。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「宮方随一の元兇、日野朝臣の妻と憎んで、六波羅も意地わるく、また新たな朝廷に媚びへつらう公卿仲間も、みな冷ややかな眼であなたを見るのか」「世のつね。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
