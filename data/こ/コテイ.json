        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎月の収入が固定されているので、生活の計画が立てやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "為替レートを一定の範囲に固定する政策がとられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "予算の枠を固定せず、状況に応じて柔軟に対応する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "fixation (histology)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
