[
  {
    "uuid": "289e3a29-6438-5151-bae6-e176872b1197",
    "entry": "固定",
    "reading": {
      "primary": "こてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
