  {
    "uuid": "e80761ad-459c-579b-abce-5adb7ef5b3ff",
    "entry": "コトナシ",
    "reading": {
      "primary": "ことなし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
