        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "北原白秋氏も近頃の詩はコハばつてゐる。",
              "citation": {
                "source": "名詩集「思ひ出」の眞價",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　（クスグツタイ笑ひ）まあさう言はないで、俺の肩に手をかけて、――ポーランドの妻君は、自分の夫を膝にのせて、「コハーネ」つて言ふんだつて。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　あれはおまへ、「コハーネ」の話はおまへ、河島がしたんぢやないか。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の旅程――　１　横浜外交官の無線電信の費用見つもり処、グランドホテル・ド・ヨコハマに設計された硝子張りの円舞場でスパルタの女と根岸の外人ティームとの間で弓術試合が行われた。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無三膝を立直し、立ちもやらず坐りも果てで、魂宙に浮く処に、沈んで聞こゆる婦人の声、「山田山田」と我が名を呼ぶ、※呀と頭を掉傾け、聞けば聞くほど判然と疑も無き我が名の山田「山田山田」と呼立つるが、囁く如く近くなり、叫ぶが如くまた遠くなる、南無阿弥陀仏コハ堪らじ。",
              "citation": {
                "source": "妖怪年代記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰おぎ見ると、コハそもいかに。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを大阪の伝統だとはっきり断言することは敢てしないけれど、例えば日本橋筋四丁目の五会という古物露天店の集団で足袋のコハゼの片一方だけを売っているのを見ると、何かしら大阪の哀れな故郷を感ずるのである。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思いながら、足袋のコハゼを外したままの恰好で、玄関へ降りて行った。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、元の時代のかの地の三弦一名コフジ、一名コフシ、一名クヮフシ、一名コハシなど称するものと関係があるような、またないようなことも書いてある。",
              "citation": {
                "source": "日本楽器の名称",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこのコハシあるいはコフジに相当するものと思われる類似の楽器の類似の名前がヨーロッパ、アジア、アフリカ、南洋のところどころに散在しているのが目につく。",
              "citation": {
                "source": "日本楽器の名称",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ、イヤラシイ、オトコハ、オマエダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｍ、Ｈ山房はコハンスキーの隣りであつた。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻子には、トクトウニカハツタ、イマヨコハマヨリ二〇〇ノツト、イチロヘイアン、アア、ヒロイウミ、アヲイウミ　また、ある東京の友人にはこうも打った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "数日来、あんまり歩いたので（草鞋を穿いて歩くのには屈托しないが、下駄、殊に足駄穿きには降参降参）、足が腫れて、足袋のコハゼがはまらないやうになつた、しかし、それもぢきよくなるだらう。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｆ家のおばさんから、例のブチコハシをひやかされた、あゝいふ気分はとても彼女等には理解できぬらしい、喧嘩でもしたのだらうと思つてる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　コハゴハ、ホンヲ　トウサンニ　ワタシマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコ新美南吉　タケノコハ　ハジメ　ヂビタノ　シタニ　ヰテ、アツチ　コツチヘ　クグツテ　イク　モノデ　アリマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イクラ　シカラレテモ、ヒトツノ　タケノコハ　ドンドン　トホクヘ　モグツテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツチノ　ハウデ　ウツクシイ　ヤサシイ　コヱガ　ワタシヲ　ヨブカラデス」ト　ソノ　タケノコハ　コタヘマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　モウ　ナントモ　イハレヌ　ヨイ　コエデス」ト　ソノ　タケノコハ　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウトウ　コノ　タケノコハ　ホカノ　タケノコタチト　ワカレテ、カキネノ　ソトニ　アタマヲ　ダシテ　シマヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエイエ、ワタシハ、アナタノ　フイテ　イラツシヤツタ、ソノ　フエノ　コヱガ　アンマリ　ヨカツタノデ、コツチヘ　サソハレテ　キマシタ」ト　タケノコハ　コタヘマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コノ　タケノコハ　オホキク　カタク　ナツタ　トキ、リツパナ　ヨコブヱト　ナリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサツユハ　オツコチルト　コハレテ　シマフノヨ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　オ花バタケノ　ソバノ　アル　クサヤネノ　コヤニ　ハイツテ　グツスリ　ネムリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　ラツパヲ　ミルト　花ヲ　オコシテ　ヤル　コトモ　ワスレテ、「アア、コレダ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ、チヨウド　オナカガ　スイテ　キタ　コロ　マタ　ヒトツノ　ムラニ　ハイリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
