        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "易なんぞというものは感心な奴で、初爻と上爻とが首尾相呼んでぐるぐるとデングリカエシをやッて螺線を描いて六十四｜卦だけにコロガリころがッて実はまだいくらにでもコロガリ出すことが出来るのサ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、ミンナト　ハナレテ、オカアサンヲ　ナクシタ　カアイサウナ　コドモガ　ヘイニ　モタレテ　ヰマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、花タチノ　オドロイタ　コトニハ　ソレハ　花タチノヤウニ　キイロイ　キモノノ　カハリニ　マツシロイ　キモノヲ　キテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ミルト　カジヤノ　テニハ、カナヅチガ　ニギラレテ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、カネガ　ナツテ　キヨウシツノ　マエニ　ナラビニ　ユクト、ミツルクンハ　マダ　ナイテ　ヰマス。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ソレハ、オヂイサンノ　ミミガ　キイタノデハ　アリマセン、ココロガ　キイタノデス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ウサギノ　ハウハ　イクラ　ダイジニ　シテ　ヤツテモ、チツトモ　オホキク　ナリマセン。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ハンノキノ　シタニ　コロガツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ポストノ　ウシロニ　タツテ　ヰタ　ガイトウガ　カラ　カラト　ワラツテ、「ポストノ　カゲナラ、ポストノ　ウシロニ　コロガツテ　ヰル　ソノ　ブカツカウナノガ　サウヨ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ユウガタニ　ナツテ、タイヤウガ　オチテ　シマフト　ヒロツパノ　マンナカノ　マルイ　カゲハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓬頭垢面、襤褸を身に包み、妻子なく、家産なく、たゞ一ヶの大桶をコロガシ歩いて、飄遊風の如く、其処の花蔭、此処の樹下と、一夜一夜の宿りも定まらず。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "足ノ下ニ御社ノ新聞ノ、アノ写真ノトコロガ拡ゲテ置イテアリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、驚いて真蒼になって見ている豚吉の頭の処へ来て、イキナリ金槌をふり上げましたので、豚吉は床の上にコロガリ落ちたまま腰を抜かしてしまいました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそのチョンガレの頭蓋骨が掘り出されると、噛み締めた白い歯が自然と開いて、中から使いさしの猫イラズのチューブがコロガリ出たので皆ゾッとさせられた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オ母ッチャハソノツギノ日カラネテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、君チャンノオ母ッチャハ、ナカナカスグニヘンジヲシナクナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ、カイダンヲオチテ、ウチドコロガワルクテ、君チャンガネコンデシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃僕は大阪朝日新聞の記者をしていて、前項に書いたように、風見章さんなどと一緒に上福島の下宿屋にコロガッていた。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、大変ナコトニナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　イヂノワルイ　オサルサンガ、「ザウサンハ　タイヘン　オギヤウギガヨイトイッテ　ミンナガホメルケレドモ、バウシヲトルノニ　テデトラナイデ、ハナデトルデハナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　アル日、人参サンノ所ヘ、人参サント　ジヤガイモサンノオ友達ノ玉ネギサンガ　タヅネテキテ、「ボクモ、コンナニ大キクナツタノデ、トウトウ、アシタノアサ、六ジニ　キシヤデ　マチノイチバヘ行クコトニ　キマツタヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、皆サンゴゾンジナイカモ分リマセンガ、ジヤガイモサンハ大ヘンナオ寝坊サンデシタカラ、人参サンニゴツンゴツンタタカレテモ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、ボンコチヤンハモンコチヤンヲアマリスキマセンデシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハヤク　イツテ、ドロノ　ナカニ　コロガラナクチヤ　タマラナイ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドロノナカニ　コロガツテヰルト、ナニカ　ウチノナカデサワガシイ　オトガ　シハジメマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "前橋在の新堀の茂さんという漁師が昨年の或夜、鮎の瀬付のコロガシをやって居ると、ゴクンと鈎に掛ったものがある。",
              "citation": {
                "source": "河鱸遡上一考",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
