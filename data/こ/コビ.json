  {
    "uuid": "7766b433-af08-5334-b600-f997622ed2ce",
    "entry": "コビ",
    "reading": {
      "primary": "こび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「人間どもは、何だって、暑い暑いとぬかしながら、暑い処にコビリついているんだ。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、デッキへ洩れると、直ぐにカラカラに、出来の悪い浅草海苔のようにコビリついてしまった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人間が万物の霊長だなんて問題に、コビリつくことはもうよそう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマデハ　ヤマキチ　ノ　ナカヨシ　ノ　イロイロ　ノ、トリ　ヤ　ケモノ　ガ、ヤマキチ　ノ　カエリ　ヲ、タイソウ　ヨロコビマシテ、ウタ　ヲ　ウタウヤラ、オドリ　ヲ　オドルヤラシテ　カンゲイ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたいコビキ町で生れたのよ。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち此の鏡上に物のコビリ付いて居るところが氣の凝りなのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちこの鏡の上に物のコビリ付いているところが気の凝りなのである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア　ウグヒスガ　アソビニ　ヤツテ　キタ」ト、イヒナガラ、コドモタチハ　テヲ　ウツテ　コロコビマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　タイヘン　ウツクシク　ミエタノデ　花タチハ　コノヤウナ　セカイニ　ウマレテ　キタ　コトヲ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　五ニンノ　サムライハ　サルヲ　キラナクテ　ヨカツタ　コトヲ、メニ　ナミダヲ　タメテ　ヨロコビマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンハ　ラツパシユニ　ナラウ」ト　タイヘン　ヨロコビマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イツテ　ヨロコビマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ　オアシヲ　モラツタノデ　サツキノ　クルシサモ　ワスレテ、ヨロコビ　イサンデ　カヘツテ　イキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『千九百○六年……此年○月○日、Ｓ――村尋常高等小學校内の一教場に暴動起る』と後世の世界史が、よしや記さぬまでも、この一場の恐るべき光景は、自分並びに五十幾人のジャコビン黨の胸板には、恐らく「時」の破壞の激浪も消し難き永久不磨の金字で描かれるであらう。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "この不法なるクーデターの顛末が、自分の口から、生徒控處の一隅で、殘りなく我がジャコビン黨全員の耳に達せられた時、一團の暗雲あつて忽ちに五十幾個の若々しき天眞の顏を覆うた。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "一隊五人の健兒、先頭に立つたのは了輔と云つて村長の長男、背こそ高くないが校内第一の腕白者、成績も亦優等で、ジャコビン黨の内でも最も急進的な、謂はば爆彈派の首領である。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『千九百○六年……此年○月○日、Ｓ――村尋常高等小学校内の一教場に暴動起る』と後世の世界史が、よしや記さぬまでも、この一場の恐るべき光景は、自分並びに五十幾人のジヤコビン党の胸板には、恐らく「時」の破壊の激浪も消し難き永久不磨の金字で描かれるであらう。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "この不法なるクーデターの顛末が、自分の口から、生徒控処の一隅で、残りなく我がジヤコビン党全員の耳に達せられた時、一団の暗雲あつて忽ちに五十幾個の若々しき天真の顔を覆ふた。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "一隊五人の健児、先頭に立つたのは了輔と云つて村長の長男、背こそ高くないが校内第一の腕白者、成績も亦優等で、ジヤコビン党の内でも最も急進的な、謂はば爆弾派の首領である。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは台湾の※鯉、西大陸の食蟻獣、濠州のミルメコビウス（食蟻袋獣）、アフリカの地豚と等しく、長き舌に粘液あり、常に朽木の小孔に舌をさし込めば、白蟻輩大いに怒りてこれを螫さんと集まるところを引き上げ食い尽す。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "その額と頬は、僅かの間に生命を削り取られたかのように蒼白く骨張って、力ない皺の波が、彫刻のようにコビリ付いていた。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「精神は物質也」式の唯物科学的迷信が、まだ頭の隅のドコかにコビリ付いているせいだよ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことにミジメなのはその掌で、鍬を握っておりますから、よくは見えませぬが、その鍬の柄の処々に、黒い汚染がボツボツとコビリ付て見えましょう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の頭の中心にコビリ付いていた千万無数の……　？",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "実をいうと二日間の講演をタッタ三時間に値切られてしまった不平が、まだどこかにコビリ付いていたんだからね。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "骸骨を渋紙で貼り固めてワニスで塗上げたような黒いガッチリした凸額の下に、硝子球じみたギョロギョロする眼玉が二つコビリ付いている。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の船長の云うに云われぬ悲痛な、同時に冷え切った鋼鉄のような表情ばかりは、今でも眼の底にコビリ付いているがね。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "骸骨を渋紙で貼り固めてワニスで塗り上げたような黒光りする凸額の奥に、硝子玉じみたギラギラする眼球が二個コビリ付いている。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
