          "literary": [
            {
              "text": "手招きする彼女を追って行く庸三の目に、焦げ色に刷かれた青黛の肌の所々に、まだ白雪の残っている鳥海山の姿が、くっきりと間近に映るのであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はあまり明るい色、濃厚な色を見れば胸ぐるしい圧迫を感じるのが常であつたが、花でいへば百合の雄蕊の頭にこつとりとついてる焦げ色の花粉なぞがさうであつた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
