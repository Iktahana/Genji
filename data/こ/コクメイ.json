        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は非常に克明な性格で、どんな小さな約束も決して忘れることはない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "毎日欠かさず家計簿をつけるという克明な習慣が、彼の貯蓄を支えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "職人としての克明な仕事ぶりが評価され、彼はついに重要無形文化財に指定された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
