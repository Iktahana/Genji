[
  {
    "uuid": "3d1fa155-1a3d-5125-93e9-1bf6968079f7",
    "entry": "古墓",
    "reading": {
      "primary": "こぼ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "古墓あり、水道の殘礎あり、而して聖彼得寺の穹窿天に聳えたる羅馬の市は、既に目睫の中に在り。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣り寺、寺の古墓、日あたりは未だも暑けど、墓掃くとかがむ影すら、閼伽汲むと寄るすらも無し。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣り寺、寺の古墓、日あたりは未だも暑けど、墓掃くとかがむ影すら、阿閼汲むと寄るすらも無し。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "古墓石を有形の儘に移すこともあり、又別に合墓を立つることもある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "圉人驚異したが敢えて洩らさず、その後また事あったので、雨後のこと故圉人が馬の足跡をつけ行くと、南方十余里の一古墓の前まで足跡あり。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "対馬にやぼさと言うてゐるのは、岡の上の古墓で、より神とも言ふ相である。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "古墓の祖先の霊で、憑るからのより神であらう。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば、壱岐に数多いやぼさは元古墓で、祖霊のゐる処と考へてゐたのが、陰陽師の役霊として利用せられる様になつたり、其もとが段々、忘却せられて来たのだらう。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四七項　神木の祟　三州のある村にて社内の古墓を発掘したところが、村内一般に必ず神の祟あるべしと大いに恐れおりしが、その後間もなく、白昼風もなきに、境内の神木と称せし老大松が、突然一間以上の所よりたおれた。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中にて一種変わりたる異様の古墓が、最も奥の方に立っている。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六　上ン土の古墓　次の日は朝九時神田、福原二君などを加へて、名護の西方小一里にある上ン土の古墓を見に行く。",
              "citation": {
                "source": "沖繩の旅",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔、坊やんの家の菩提寺の所有であつた古墓地を、坊やんのおぢいさんが手に入れてだん／＼それを開墾し今は上等な桑畑になつて居る。",
              "citation": {
                "source": "秋風",
                "author": "飯田蛇笏",
                "note": "青空文庫"
              }
            },
            {
              "text": "召喚に当っては注意が必要だ、何故かというと古墓の墓碑銘は必ずしも正確ではないからだ。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "エズラ・ウィードンの古墓に加えられた陵辱、続くポートゥックストでの叫び声――復讐と忌避された古き※神の座の再発見とを企てたのは誰の精神だろうか？",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "その兇行では古墓が取り去られ墓石が暴力的に破壊してあった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
