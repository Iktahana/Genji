    "definitions": [
      {
        "index": 1,
        "gloss": "endurance contest",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちは、どちらが長く地面に立っていられるか根比べを始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このプロジェクトは、関係者全員にとってまさに根比べだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「さあ、どちらが先に根負けするか、根比べしよう！」と彼は挑発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "平太郎は運を天に任して妖怪と根比べをするより他に手段がないと思った。",
              "citation": {
                "source": "魔王物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こうなったら根比べだ。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　根比べのやうに三田は默つて居るので、おりかは爲方が無く口を切つた。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "執念の根比べでは如水に勝つ者はめつたにゐない。",
              "citation": {
                "source": "黒田如水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "大原談義の時聖道浄土の議論があったが、法門に就ては互角の議論であったが、気根比べにはわしが勝ったのじゃ。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり二人の根比べだ。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっちの気が倒れるか、自分こそは勝つ気で、両方で根比べをする気。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根の上と根比べなら、負けっこはねえ」　八五郎は有頂天になって、籠城の支度に塔を降りようという時でした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "小唄の師匠のお栄というのは、二十五六の下谷中で騒がれている年増で、平次の峻烈な問にも、最初は容易に応えませんでしたが、半刻あまりの根比べで、とうとう兜を脱いでしまいます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "雪の足跡",
                "note": "青空文庫"
              }
            },
            {
              "text": "警視庁では、Ｋ刑事の上役の捜査係長が取調を担当して、終日ゴリラ男と根比べをして見たが、結局何の得る所もなかった。",
              "citation": {
                "source": "恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ぢやあ根くらべと行くとしようか。",
              "citation": {
                "source": "一過程",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　よろしい、根くらべでもなんでも、と昂然として杉村は答へたい氣持であつた。",
              "citation": {
                "source": "一過程",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "言わば根くらべで根がつきて出て来たようなしまつ、面白い話もできかねます。",
              "citation": {
                "source": "おはなし",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "根くらべだ」「そう言っても、もし相手の方で三百人の人間を散らし髪にして、赭い着物をきせて、朱い糸でこの樹を巻かせて、斧を入れた切り口へ灰をかけさせたら、お前はどうする」　樹の中では黙ってしまった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "たがいに根くらべを幾日もつづけているうちに、ある夜かの女は俄かに歯が痛むと言い出して、夜通し唸って苦しんでいたが、朝になってみると、その歯が三重に生えて、さながら鬼のような形相になったので、主人は勿論、一家内の者がみな怖れた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "夷堅志",
                "note": "青空文庫"
              }
            },
            {
              "text": "この幽霊のために再三再四妨害されて、実に腹が立ってたまらないので、もうこうなったら根くらべ意地くらべの決心で、来年も重ねて試験を受けようと思っていたところが、二、三日前に郷里の父から手紙が来て、今度こそはどうしても帰れというんです。",
              "citation": {
                "source": "白髪鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "根くらべならやっぱり強い者の方が勝つわ。",
              "citation": {
                "source": "蟹満寺縁起",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうこうなると、役人と罪人の根くらべである。",
              "citation": {
                "source": "拷問の話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "このおそろしい根くらべにも打ち勝って、かれは無事に牢内へ戻って来て、他の囚人どもを驚かした。",
              "citation": {
                "source": "拷問の話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "言わば根くらべで根がつきて出て来たようなしまつであります。",
              "citation": {
                "source": "無題",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は別に根くらべをするつもりではないから、また長押の方へ視線を反らせた。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それじゃ今日っから蛇に見込まれた蛙がうまくにげ失うせるか見込んだ蛇の根がつきるか根くらべをして見ようかしら。",
              "citation": {
                "source": "お女郎蜘蛛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "根くらべを致いて居るも、そうあきの来るほど長い事ではござらぬじゃ。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互に千年とは生きられぬ事じゃほどにのう、土面の中で、うつろになった眼を見はって機嫌のよい娘の様に明けても暮れても歯をむき出いた口で云いあいながら根くらべを致す事はござらぬじゃろうからのう。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼奴ら、われわれとの根くらべに負け、押し出されるがごとく一時道場をあけて、かような片田舎へ逃げこんだものに相違ござらぬが、もとより、対策がたちしだい、いついかなる謀計をもって道場へ引っ返してまいるやもはかりしれませぬ。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "十方斎先生なきあとの司馬道場にがんばって、居すわりの根くらべをしている連中。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄蔵は、根くらべをする気になって居た。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯うなると、菊太と祖母は只｜根くらべである。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこまで彼奴等の無茶が通るか、こうなったら、根くらべじゃよ」　死の谷を抜けて来て、金五郎には、自分でもよくわからぬ、なにかの新しい力が、自分に附与された思いがしていた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、二十面相のほうも、まるで根くらべのように、少しも身動きをせず、笑いつづけているのです。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
