        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コンチャどうも結構なお天気ですな。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ではコンチャといっている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "神戸からずっといっしょであった米国の老嬢二人も、コンチャーの家族も、いよいよここで下船して、ジェルサレムへ、エジプトへ、思い思いに別れて行くのであった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランドの『安南民俗迷信記』にコンチャニエンとて人に似て美しく年｜歴ると虎に化ける猴ありと。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたレーピンやコンチャロフスキーの絵のエハガキ見たことおありんならないの？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンチャウダーに、ツルネード。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンチャウダー、ソセヂサワクラウト、挽肉のもの。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンチャウダーと、肉の刻んだのを食ったが、うまくない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
