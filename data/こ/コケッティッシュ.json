          "literary": [
            {
              "text": "りん子はコケッティッシュにうそぶいて――草刈さんは、わたしの亭主。",
              "citation": {
                "source": "託児所をつくれ",
                "author": "小熊秀雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると水島さんは、そんなことはない、子供のない細君は処女と同じ位にコケッティッシュだと仰しゃる。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると横田が云うには、保子の態度はコケッティッシュだが、心はヒロイックだって。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
