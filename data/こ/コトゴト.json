[
  {
    "uuid": "1017f92a-d1a7-5b35-80a2-8d5979feb445",
    "entry": "事々",
    "reading": {
      "primary": "ことごと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
