        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "数年も便りのない恋人を待ち続け、彼女は焦がれ死にする寸前だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「君に会えないなんて、僕は焦がれ死にしてしまいそうだよ」とおどけて見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古典の授業で、愛に悩み焦がれ死にした悲劇の姫君の物語を読んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "焦がれ死にするくれえに片思いの娘っ子たちが幾人いるかわからねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらは焦がれ死にゝ死ぬまでも片思ひに思うて思ひ抜いて見せる。",
              "citation": {
                "source": "斑鳩物語",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……おい、姐や、丸煮を二人前に、鬼菱を一升持って来まっせ、急ぎだ急ぎだ、焦がれ死にをしそうなのが、ここに二人いる。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "初春狸合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しその熱き風胸より吹かば、中なる鳥の埃及人の火紅鳥ならぬが、焦がれ死するなるべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとひ焦がれ死をするにもせよ、この筐の蓋だけは取らずに置かうか？",
              "citation": {
                "source": "好色",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
