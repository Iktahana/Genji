          "literary": [
            {
              "text": "「フレンチロールですかコッペーですか。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ああ、そのコッペーだ。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」やがてそのコッペーを皿に入れて持って来たら「ああやっぱり焼いて持って来てくれ」といってその皿をつきだした。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "思い浮ぶままに一例を挙げれば、「歓楽」のなかにフランソア・コッペーの「涙」の訳があるように先生のお作をもっとたんねんに捜したらまだほかにも出て来そうな気もする。",
              "citation": {
                "source": "「珊瑚集」解説",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
