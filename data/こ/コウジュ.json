  {
    "uuid": "f5c9b109-5d80-5af4-9afd-ec208ca0fcf6",
    "entry": "皇寿",
    "reading": {
      "primary": "こうじゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
