[
  {
    "uuid": "e8e3bc65-7bc1-5a66-be35-cd86b36aa9a8",
    "entry": "坑儒",
    "reading": {
      "primary": "こうじゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "burying Confucian scholars alive",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "秦の始皇帝が行った焚書坑儒により、多くの貴重な文献が失われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "思想統制のために儒学者を生き埋めにするという坑儒の蛮行が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史の授業で、坑儒という言葉が持つ残酷な響きに衝撃を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "焚書坑儒が昔だけあつたと思ふと、大きに違ひます。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "焚書坑儒が昔だけあったと思うと、大きに違います。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　〔焚書〕　始皇帝の施政中、尤も後世の不評を招いたのは、いはゆる焚書・坑儒の二點である。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何にも焚書・坑儒は、多少亂暴であつたかも知れぬ。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　〔坑儒〕　始皇帝は挾書の禁令發布の翌年に、諸生四百六十餘人を咸陽に坑殺した。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "世に所謂坑儒事件である。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが所謂坑儒事件の實相である。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "坑儒事件に就いてのみ、無情過酷であつた譯ではない。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等の事件を坑儒事件と對比すると、始皇の主義も自から理會することが出來る。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し坑儒事件の當時に、四百六十餘人の諸生中に、一人でも男子らしい者があつて、自からその犯罪を名乘り出で、一同の犧牲となつたならば、決して彼が如き大事を惹き起さなんだに相違ない。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "坑儒事件に就いては、始皇の暴戻を責めんより、むしろ諸生の卑怯を憫むべきことと思ふ。",
              "citation": {
                "source": "秦始皇帝",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
