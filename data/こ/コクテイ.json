    "definitions": [
      {
        "index": 1,
        "gloss": "state-sponsored",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "富士山周辺の美しい自然景観を守るため、その一帯は国定公園に指定されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "戦前の日本では、子供たちは国定の教科書を使って一斉に同じ内容を学んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "地元の古い駅舎が国定の重要文化財に登録され、観光客が少しずつ増え始めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "国定教科書の内容に間違いのある場合とはよほどわけがちがうのではないかと思われる。",
              "citation": {
                "source": "随筆難",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車で逢った背広服の老子のどの言葉を国定教科書の中に入れていけないといういわれを見出すことが出来なかった。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "国定教科書にあったのか小学唱歌にあったのか、少年の時に歌った歌の文句が憶い出された。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "国定教科書の肉筆めいた楷書の活字。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのなんとか権所有の、これもそう思えば国定教科書に似つかわしい、手紙の文例の宛名のような、人の名。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな国定教科書風な感傷のなかに、彼は彼の営むべき生活が示唆されたような気がした。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もと自分が日本橋の裏通りの居酒屋へは入つた事があつたが、その時、親子づれの浪花節語が門口で国定忠次を語つて行つたあとで、居酒屋の内でもてんでんに調子づいて、いろいろの歌を歌ひ出したのに遭遇した。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "国定忠次が追われて、その中に病を養ったと伝えられる忠次の窟も、この道の下の滝不動の近くで、他の窟同様、もとは行者の修道の場に使われていたそうです。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が妹等と行く寄席の内部をお話すると、客は殆ど男ばかり、そして其行儀の悪いのは驚くばかりで、十人の二三は身体を横にして居るのです、中にはすや／＼と眠つて居て、時々張扇の音に目を覚し夢現に宮本武蔵、国定忠次の伝記を聞いて居るのです。",
              "citation": {
                "source": "夜の赤坂",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "順平は国定教科書の「作太郎は父に連れられて峠を……」という文句を何となく想出したが、後の文句がどうしても頭に泛んで来なかった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "武田信玄と国定忠次という奇異な恰好でである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "国定忠治の映画の影響かも知れない。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤城山が利根川の谿谷へと、緩い勾配を作っている一帯の高原には、彼の故郷の国定村も、彼が売出しの当時、島村伊三郎を斬った境の町も、彼が一月前に代官を斬った岩鼻の町もあった。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の目算通に、信州｜追分の今井小藤太の家に、ころがり込むにしたところが、国定村の忠次とも云われた貸元が、乾児の一人も連れずに、顔を出すことは、沽券にかかわることだった。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ましてこれから、知らねえ土地を遍歴って、上州の国定忠次で御座いと云って歩くには、駈引万端の軍師がついていねえ事には、どうにもならねえのだ。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして、これから知らねえ土地を遍めくって、上州の国定忠次でございといって歩くには、駆引き万端の軍師がついていねえことには、動きはとれねえのだ。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ縄抜けをするくらいですから、唯の芸人じゃあないと睨んで、庄太にだんだん調べさせると、この三八というのは以前は上州の長脇指、国定忠治の子分であったが、親分の忠治が嘉永三年にお仕置になったので、江戸へ出て来て太鼓持になったという奴。",
              "citation": {
                "source": "半七捕物帳",
                "author": "川越次郎兵衛",
                "note": "青空文庫"
              }
            },
            {
              "text": "読者は今度国定教科書の插絵が大変かわったことに気づいていられるだろうか？",
              "citation": {
                "source": "今日の文化の諸問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "両替は国定相場で一円が九十三｜哥。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "云わば、芸術労働者の俸給も、ソヴェトではパンと同じに国定相場で支払われているわけだ。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校令が行われ、国定教科書で教えるという方法がきまったのは明治何年であったか知らない。",
              "citation": {
                "source": "『くにのあゆみ』について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "国定教科書から上る利益は無責任な単行本出版から上る利益よりも遙かに低い。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "海苔ようかんを売っている若い男は国定忠治の講談本を声高く読んでいたりした。",
              "citation": {
                "source": "貸家探し",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も四人の所化は勿論、近眼鏡をかけた住職は国定教科書を諳誦するように提婆品か何かを読み上げている。",
              "citation": {
                "source": "文章",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "石川五右衛門も国定忠治も、死刑となった。",
              "citation": {
                "source": "死刑の前",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ルーブリはお前、国定相場と暗黒相場ってえのと二通りあるんだ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "国定で行きゃあ一ルーブリは一円がちょいと足を出すのよ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「畫は、まだるつこくていかんな。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京の人たちは、あれを油つこくていやだと言つてゐるやうだけれど、私たちには非常に淡泊な味のものに感ぜられる。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたは、たいそう、かしこくていらっしゃいますね。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
