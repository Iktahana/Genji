          "standard": [],
          "literary": [
            {
              "text": "（コンコンチキチン、コンチキチン、コンチキチン、カラ、タッポッポ）摺鉦入れた後囃子が、遥に交って聞えたは、先駆すでに町を渡って、前囃子の間近な気勢。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大ありのコンコンチキ……」「ふーん。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "大嘘吐きのコンコンチキさね。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大違えのコンコンチキだろうて！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いやもう親分、大笑いのコンコンチキさ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "「岡惚れどころじゃない、大熱々のコンコンチキよ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "単に迷子と名づけた場合でも、やはり鉦太鼓の叩き方は、コンコンチキチコンチキチの囃子で、芝居で「釣狐」などというものの外には出でなかった。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
