    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　子狐紺三郎はなるほどといふ顔をして、「えゝ、さうかもしれません。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　子狐の紺三郎が嬉しがってみじかい腕をばたばたして云ひました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると子狐紺三郎が云ひました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　子狐紺三郎はなるほどという顔をして、「ええ、そうかもしれません。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　子狐の紺三郎が嬉しがってみじかい腕をばたばたして云いました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると子狐紺三郎が云いました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると突然、うしろで、「どたどた、ざーっ」と物凄い音がして、パン粉のような粉雪が、ふわーっと子狐におっかぶさって来ました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子狐はびっくりして、雪の中にころがるようにして十｜米も向こうへ逃げました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく洞穴へ帰って来た子狐は、「お母ちゃん、お手々が冷たい、お手々がちんちんする」と言って、濡れて牡丹色になった両手を母さん狐の前にさしだしました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転車の看板や、眼鏡の看板やその他いろんな看板が、あるものは、新しいペンキで画かれ、或るものは、古い壁のようにはげていましたが、町に始めて出て来た子狐にはそれらのものがいったい何であるか分らないのでした。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子狐は教えられた通り、トントンと戸を叩きました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子狐はその光がまばゆかったので、めんくらって、まちがった方の手を、――お母さまが出しちゃいけないと言ってよく聞かせた方の手をすきまからさしこんでしまいました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子狐はすなおに、握って来た白銅貨を二つ帽子屋さんに渡しました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "帽子屋さんはそれを人差指のさきにのっけて、カチ合せて見ると、チンチンとよい音がしましたので、これは木の葉じゃない、ほんとのお金だと思いましたので、棚から子供用の毛糸の手袋をとり出して来て子狐の手に持たせてやりました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子狐は、お礼を言ってまた、もと来た道を帰り始めました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど子狐はいったい人間なんてどんなものか見たいと思いました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねむれ　ねむれ母の胸に、ねむれ　ねむれ母の手に――」　子狐はその唄声は、きっと人間のお母さんの声にちがいないと思いました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって、子狐が眠る時にも、やっぱり母さん狐は、あんなやさしい声でゆすぶってくれるからです。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「母ちゃん、こんな寒い夜は、森の子狐は寒い寒いって啼いてるでしょうね」　すると母さんの声が、「森の子狐もお母さん狐のお唄をきいて、洞穴の中で眠ろうとしているでしょうね。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の子狐と坊やとどっちが早くねんねするか、きっと坊やの方が早くねんねしますよ」　それをきくと子狐は急にお母さんが恋しくなって、お母さん狐の待っている方へ跳んで行きました。",
              "citation": {
                "source": "手袋を買いに",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにしろ子狐を責め殺したのが悪かったんですよ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "小女郎狐",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐釣り釣ろか　釣ろか　サーラ　コンコン　サーラ　コンコン子狐を釣ろか。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "すすきの　蔭で　サーラ　コンコン　サーラ　コンコン子狐を釣ろか。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "すすきの　蔭に　サーラ　コンコン　サーラ　コンコン子狐が寝てる。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣ろか　釣ろか　サーラ　コンコン　サーラ　コンコン子狐を釣ろか。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その時ここら辺に住む、親子狐であるのであろう、三匹の狐が縁の上へ、ノッソリと姿を現わして、開けられてある雨戸の隙から、屋内を覗き窺った。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏に向いた雨戸が開いていて、枯れ芒、枯れ萩に蔽われた崖が、破れ腐ちた縁のすぐの向こうに、壁かのように立っていたが、その崖を背にし縁の上に、先刻の三匹の親子狐が、鼻面を並べ蹲居して、この屋内を覗いていた。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三味線の音色に引かされて、裏縁の方へ出て行ったとたん、親子狐が三匹ながら、ノソリとばかり立ち上がった。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　すると小狐紺三郎が笑って云ひました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　すると小狐紺三郎が笑って云いました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
