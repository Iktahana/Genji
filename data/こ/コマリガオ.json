        "examples": {
          "standard": [
            {
              "text": "彼は、どうしたらいいか分からず、困り顔でこちらを見ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "失敗した子供の困り顔を見て、母親は思わず微笑んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あらあら、どうしたの？そんな困り顔して。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「ほんとに、机の上に坐るなんて、そんな子供は知りません」と、家内はほとほと困り顔だ。",
              "citation": {
                "source": "打出の小槌",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "杯攻めに会っている蒋幹の困り顔をながめながら、周瑜はまた、「今夜、ここにいるのは、みな呉の英傑ばかりで、群英の会とわれわれは称している。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
