    "definitions": [
      {
        "index": 1,
        "gloss": "exerting care",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "相手への細やかな心配りは、円滑な人間関係を築く上で不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「いつも温かい心配り、本当にありがとうございます！」と参加者は感謝を伝えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女の心配りは、まるでプロのコンシェルジュのようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "内心恐れをなしながらよく見ると、これも主人翁の心配りであったろうか。",
              "citation": {
                "source": "お茶の湯満腹談",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが同じ家庭内で、相当の歳（独立する年齢）までともに暮すのですから、互いの間によほどしっかりした心配りがないと、易きについて堕落してしまいます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷物の中には何んでもないことで、然し妻でなかったら、やはり気付かないような細かい心配りの分るものが入っていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "年末などはことに対の女王が忙しくていっさいの心配りのほかに、女御、宮たちのための春の仕度に追われて、「春ののどかな気分になった夕方などにこの琴の音をよくお聞きしたい」　などと言っていたが年も変わった。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（下）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん、エレクトロニクスにもコンピューターにも素人同然のタケシがどうにかこうにか『マイコン基礎講座』を読み進むことができたのは、著者の能力と細かな心配り、そして何よりもＴＫ―80がコンピューターとして見れば超貧弱なマシンであったことにつきよう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「今日はお父様珍しいのね」「ああ」　泰造は宏子の片方の腕をとって自身は道の外側を暫くだまって歩いていたが、やがて、「丁度いいところで逢ったから話すがね」　おだやかな、圧しつけるところのない、寧ろ心配りで愁わしげな調子さえ響く声で云った。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこういう表現をとる生活への心配りが、やはりこの天分ゆたかな婦人画家の努力の一面となって、今日あらしめているところに女の生活への伝統の力がうかがわれる。",
              "citation": {
                "source": "「青眉抄」について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう心配りはしかし実際は不必要なのである。",
              "citation": {
                "source": "実験室の記憶",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "床のながめとならぬ間に、どこぞへ移し植ゑたしの、心配りや、気配りも、空に過ぎるも小半歳。",
              "citation": {
                "source": "したゆく水",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちん餅一つにしてもこれだけの心配りを要するのである。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "万事この調子で、いろいろ心配りが多くて行きとどかぬ勝ちの私を扶けて、それはよくしてくれたものでした。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬は四季を通じての庭のはらわたを見せるときである、庭の持主の心づかひが此の季節にすつかり表はれ、春夏秋の手入れや心配りの程が解るやうである。",
              "citation": {
                "source": "冬の庭",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上のようなものがヘーゲルの道徳理論（「法の哲学」）の輪郭の単なる紹介であるが、之が道徳に関して従来普通有たれたような諸観念を、如何に理解と心配りとの行き届いた仕方で取り上げたか、如何に之が道徳に包括的な観念を提供するものであるか、吾々はこの点をまず何より先に認めねばならない。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "熟慮と絶妙の心配りをもって書いた。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈍重で奴隷的な肉体的諸機能を虐待し麻痺させて、霊魂にそれらを理性に従って導く心配りをさせまいとするなどは、大きな卑怯背信であると思う。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはこれで訣れるとしよう』おくみ『何から何まで御心くばり、有難うて涙がこぼれます』蓮如『では、まめに暮しなさい』（蓮如行きかける。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来、母親贔屓の慶太郎は、医学生らしい細かい心くばりをして、母を病人とよりは、子供のようにして世話をやく。",
              "citation": {
                "source": "女心拾遺",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、この人生に真理と美とをもたらそうとする人々の、其々の心くばりというものが、どんなにこまやかにまめで、うむことをしらぬ多様さ、堅忍、己を持することの高さの故の親しみ易さがいるかということも痛感します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、たまだったときには、その次の時までの私の生活の全内容というものを最も中心的なものに総括して、その印象を貴方につたえるしか方法がなかったから、私が自身の弛緩を警戒する敏感さ、あなたの知ることの出来ない部分にゴミをつけまいとする心くばりは、随分神経質でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じことであっても、きのうからきょう、きょうから明日へと流れつづくと、その流れは自然で、その心くばりにおいても一緒の感じでくつろげる。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は閑散な正月であるわけですがはたの連中に何とか正月らしくしてやるために、やはりそれぞれ心くばりがあるものです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の心くばり、いろいろのお伴、皆甲斐あった、本当にうれしゅうございます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆いろいろ心くばりしてくれます、そして、呉々もあなたにお大切にということでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めてのがああだったと市の関係者や校長仲間の男らしさに抵触しないための心くばりです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからあなたの此上の御心くばりはいりません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごく若い娘だから、留守番のことや何かこれまでとちがう心くばりがいりますが、それはようございます、では又明朝。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、一般的な場合としていうとき、そこにある人間の高さ、美しさ、こまやかさ、絶え間のない心くばりの交流について、そのほんの一部分のことしかふれ得ないのですものね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この何年かの間のそんな心くばりは、何の実質にも吸収されていないのね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "書評は好意をもってかいていて、それは勿論いいのですが、いろいろごたついたあと、そんなことへの全く私だけの心くばりがあってつとめてよく見たというところが、あとから見ると、文芸評論書評として不満になったわけです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではもう出来たのね、やっぱり高く出来たのね、人間の生活の常態というものに対して親切な心くばりの欠けた強引プランというものは、いつの時代にもどんな場合にでも人々の心に舌ざわりの荒い滓をのこすものです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
