        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしＮ君が一言二言問答したら、それでよかったと見えてそのまま階段を上がって行った。",
              "citation": {
                "source": "議会の印象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "言問の曲角で、天道是か非か、又一組、之は又念入な、旦那樣は洋服の高帽子で、而して若樣をお抱き遊ばし、奧樣は深張の蝙蝠傘澄して押並ぶ後から、はれやれお乳の人がついて手ぶらなり。",
              "citation": {
                "source": "彌次行",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "言問橋から遊び仲間を隅田川へ突き落したのである。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "言問まで行くつもりであったが隅田川の水の臭気にあきたので吾妻橋から上がって地下鉄で銀座まで出てニューグランドでお茶をのんだ。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを聞いた時の作、山がつの庵に焚けるしばしばも言問ひ来なむ恋ふる里人　冬になって雪の降り荒れる日に灰色の空をながめながら源氏は琴を弾いていた。",
              "citation": {
                "source": "源氏物語",
                "author": "須磨",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の気の神処の澄み、岩が根の言問ひ止み、かいかがむ荒素膚の荒魂の神魂び、神つどへる水上は思ふべきかな。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "言問岩が根に言問はむ、いにしへもかかりしやと。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "草に木に言問はむ、いにしへもかかりしやと。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さき日に言問はむ、いにしへもかかりしやと。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神神に言問はむ、いにしへもかかりしやと。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ほうたるよ）言問ひぬ、遠つ神代は青水沫、石根、木の立。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "言問はず、立ち舞はず、日のくれぐれ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "言問はむ、ウインネツケよ、月のごと大きなる、その在処を。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "海豹と雲汐首岬たうたうと波｜騒ぐ汐首岬、鮮やけし、雑草の青、さみどり、　　ああ、げに、いにしへのアイヌ・モシリ、　　言問へよ、今にして辺の岬岬。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、げに、いにしへのアイヌ・モシリ、　　言問へよ、今にして辺の岬岬。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "月に寄せて言問はむ、鉄塔の上に坐す円かなる月読の神、二三すぢ細み引く茜の雲。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "空なりや、雲に行く日のまぼろし、ゆゑわかず、うつつなし、女童は言問へども。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさにまさしく、こりゃ墨田の言問ですよ」「偉い！",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえにしちゃ大できだが、どうしてまたこのだんごを言問と判じたんだよ」「つがもねえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お江戸にだんご屋は何軒あるか知らねえが、どこのだんごでも一くしの数は五つと決まっているのに、言問だんごばかりゃ昔から三つと限っているんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、この絵のところへ来いとあるからにゃ、墨田の言問へ来いとのなぞに決まっているんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "言問とことが決まりゃ、七年めえからのかたきをいっぺんに討つんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "駕籠をすてて、言問までは渡し。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれが言問だんごですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "道がまた言問から浅草までへは目と鼻の近さなのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おめえでさえも判じのつく言問だんごを、今まで食わなかったのが運の分かれめなんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "時折、言問橋を自動車のヘッドライトが明滅して、行き過ぎます。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃」「いいえ、でも行く前に一遍来たいと思ったんです」　堤を行くとき、「言問いでこの頃洋食をやっているんですってね」と網野さんが云った。",
              "citation": {
                "source": "九月の或る日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
