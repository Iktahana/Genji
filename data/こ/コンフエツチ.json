        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "横街といふ横街には「コンフエツチイ」の丸賣る浮鋪簷を列べて、その卓の上には美しき貨物を盛り上げたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "（「コンフエツチイ」の丸は石灰を豌豆豆」］の大さに煉りたるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "假面をば被りたらねど、「コンフエツチイ」の粒｜擲ぐることは、人々に劣らざりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫し避けて佇む程に、さきの車又かへり路に我を見て、再び「コンフエツチイ」を投げかけたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "老紳士は又娘の火に近づくものありと見るごとに、容赦なく「コンフエツチイ」の霰を迸らせたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "又孫の一人も有らうと想はれる老夫人が済ました顔をし乍ら若い男と見ればコンフエツチを振撒いて行く。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "巡査や憲兵までがコンフエツチの攻撃に遇つて莞爾して居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は梅原、九里の二人と伴立つて歩いたが、行きちがひざまに僕の頬つぺたへ頗る野蛮なコンフエツチの投げ方をする者があるから、振返つて応戦しようと思ふと其れは滿谷、徳永、柚木などの日本人であつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎｜夜珈琲店に夜｜更かしをして帰つて寝巻に着｜替へようとする度、襯衣の下から迄コンフエツチがほろほろと飜れて部屋中に五｜色の花を降らせた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けばミカレエム祭や謝肉祭のやうに人が皆仮装をして歩いたり、コンフエツチと云ふ色紙の細かく切つた物を投げ合つたりする事はこの日の祭にはないのである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けばミカレエム祭や謝肉祭のやうに人が皆假裝をして歩いたり、コンフエツチと云ふ色紙の細かく切つた物を投げ合つたりする事はこの日の祭にはないのである。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
