          "literary": [
            {
              "text": "凶徒ジヤン・バルジヤンが一人の可愛い少女コセツトをわが児のやうに恋人のやうに愛してゐたことを思ひ出したのであります。",
              "citation": {
                "source": "ザボンの実る木のもとに",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が警吏に絶えず追ひつめられてゐる間も此コセツトを愛したのであります。",
              "citation": {
                "source": "ザボンの実る木のもとに",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "警吏の包囲をのがれるために尼寺の塀を乗り越えて小さなコセツトを縄で塀の上から吊り上げて逃げ去ることなぞをも端なく思ひ出されたのであります。",
              "citation": {
                "source": "ザボンの実る木のもとに",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
