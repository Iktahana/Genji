        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "黒球の中までも赤くにじんで、ただれてゐるやうに見えた。",
              "citation": {
                "source": "外に出た友",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし民衆が黒球を投ずれば、その観念はむだ花となり、反乱は無謀の挙となる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "白球百三十四、黒球百二十五、ついにこの議員買収案は九票の差で衆議院を通過した。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
