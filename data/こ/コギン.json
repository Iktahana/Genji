          "literary": [
            {
              "text": "津軽を中心として作られたものを土地では「こぎん」といいます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こぎん」の方はもうほとんど絶えましたが、近頃それを惜しんで再び立ち直ろうと試みられております。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い地域の中にも自から特長があって、「東こぎん」「西こぎん」「三縞こぎん」などと名を附けて区別します。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
