        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「今年の冬のコミケに参加するために、数ヶ月前から準備を進めてきた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「コミケの会場は熱気に包まれており、全国から多くのアニメファンが集まる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「欲しかった同人誌を手に入れるために、早朝からコミケの待機列に並んだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
