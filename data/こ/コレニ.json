          "literary": [
            {
              "text": "以上ノ三種類ノ場合モコレニ準ズ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "惟フニ日本貴族ノコノ傲慢ナル風習ヲ改メシムルノ道ハ、耶蘇教ノ恩沢ヲコレニ蒙ラシムルノ外アルベカラズ」　そこで、なるほど、外国人の眼から見た時は、階級制度の烈しい日本の国では、貴族と、平民との関係が、こうも見えるのかしら、これでは野蛮人扱いだ、と思いました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレニ反シテ、閤竜ヲ先頭トスルすぺいん流ノ渡航者ハ、僧侶ト軍人ヲ以テホトンド全部ヲ占メヰタルガ、コノ信神渡航者ニハ、僧侶ナク、軍人ナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレニハ私モホントニコマツテシマヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」コレニハ玉ネギサンモコマリマシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ノ妓妾ヲ蓄フルヲ視ルモナホコレニ唾セント欲ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "昌卿ハケダシコレニ肖タリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷菰葦叢然トシテコレニ植ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余｜安ゾ欣然トシテコレニ叙セザルヲ得ンヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルイハコレニ基クカ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩ヲ賦シテコレニ贈ツテ曰ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖天子｜コレニ処セント欲ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "律詩の題言に「伊賀中将公名士ヲ本邸ニ招飲ス余モマタコレニ与ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余コレニイツテ曰ク二親｜在ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余コノ言ヲ聞キテ甚コレニ感ズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ノコレニ銘スルニ非ラザレバ誰カ与カランヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "また「弁事十人ハ公卿諸侯大夫士庶人ヲ以テコレニ充ツ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "権弁事モマタコレニ倣フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "部署既ニ畢ルヤ出デヽ朝廷｜頒ツ所ノ府県奉職規則ヲ示シカツコレニ告ゲテ曰ク、余東京ヲ発スルノ前幾日、皇上｜便殿ニ宣光ラヲ引見シ詔シテ曰ク民ハ国ノ本ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ文ノ簡浄｜紆余ナルコト殆コレニ過グ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "蠣殻等ノ化石モ亦コレアリ」、「石炭亦コレニ属ス。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャンハ早寝ダケレド、アタシハ当分寝ラレナイカラ、コレニ腰掛ケテ本デモ読ムワ」彼女ハ籐椅子ヲ二段ニ伸バシテ長椅子ニシ、ソレニ臥コロンデ持ッテ来タ本ヲ廣ゲタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハ帝国ホテルノアーケードノ店ニアルノヲ見付ケテアルノヨ、ドウシテモコレニシヨウト思ッテ」「イクラダ」「三百萬圓」「何ダッテ」「三百萬圓」「冗談ジャナイ」「冗談ジャナイワヨ」「差当リソンナ金ハナイ」「知ッテルワヨアタシ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "楯彦ハヨク漢詩ヤ和歌ヲ書キ添エル癖ガアルガ、コレニモ萬葉ノ和歌ガ一首縦ニ一行ニ添エテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コレニ墨ヤ朱ヲ滲マセテ、石ノ表面ヲパタ／＼叩イテ拓本ヲ作ルノサ、僕ハ朱色デ拓本ヲ作ルノガトテモ好キナンダ」「石ナンカナイジャナイノ」「今日ハ石ハ使ワナイ、石ノ代リニ或ル物ヲ使ウ」「何ヲ使ウノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――各※、龍ノ如キ馬ニ騎リ、士卒雲ノ如ク、コレニ従フ。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――忝ナクモ天子ヨリ御土器ヲ頂戴ナサレ、上古末代マデノ面目コレニ過グベカラズ　と彼の祐筆はその日の感激に最大なことばをもってもなお云い足りないように書いている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "再四｜慎ンデコレニ負クコトアルナカレ。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
