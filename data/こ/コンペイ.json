        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もし国内の戦争が日につぎやむ時なく、ここに終わってかしこに始まるというふうに、強大な諸大名が互いに争闘を事としたら、国勢は窮蹙し、四民は困弊するばかりであろう。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "將軍治世十年、輔導その宜しきを得ず、權臣威福を弄し、天下困弊して、怨聲海内に充滿せり。",
              "citation": {
                "source": "宗吾靈堂",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "光ヲシテ絶無ナラシメバ聴覚ノ困弊果シテ如何。",
              "citation": {
                "source": "呉秀三先生",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "人民がいかに困弊に陥るとも農商務大臣はすこしも目に見えない。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
