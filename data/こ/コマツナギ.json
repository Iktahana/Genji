        "examples": {
          "standard": [
            {
              "text": "駒繋ぎは昔から日本の民間療法で使われてきた植物である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "山野に自生する駒繋ぎは青紫色の小さな花を咲かせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "駒繋ぎを家の近くで見かけることは珍しくなってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "駒繋ぎで、空馬が跳ねている。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「儂が参る時に、そちの乗馬によう似た栗毛が、駒繋ぎにつないであったが――やはりそちのものであったか」「はッ……。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒繋ぎの前で、ひらと降り、手綱を扈従の手へ渡した後、一瞬、無量な感慨を面にして、城内を見ていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "この数日のあいだに、旅客の去る者はすくなく、留る者は多く、どこの旅舎もいっぱいで、旅籠の前には必ずある駒繋ぎの棒杭さえ、馬と馬で混み合っていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれもそのままがよい、そのままが」　彼はもうそとへ出て、駒繋ぎ桜を通りこしていた。",
              "citation": {
                "source": "私本太平記",
                "author": "筑紫帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "えのころ、おひしば、ひよどりそう、おとぎりそう、こまつなぎ、なでしこなどがあった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
