          "standard": [
            {
              "text": "工場では、昼夜の交代員がスムーズに引き継ぎを行っています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新しい交代員は、ベテランから丁寧に指導を受けていました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人手不足のため、交代員の確保が急務となっています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "係りの者は、沿岸警備出張所のそばに泊っているブラウンという交代員にも手紙をだし、土曜日の朝、出張所の船で燈台へゆけと命令し、また出張所にも手紙を出して、ブラウンという男を燈台まで送りとどけてくれといってやった。",
              "citation": {
                "source": "歌う白骨",
                "author": "THE ECHO OF A MUTINY",
                "note": "青空文庫"
              }
            }
          ]
        }
