        "examples": {
          "standard": [
            {
              "text": "国家多事の折、閣僚たちは連日深夜まで対策会議に追われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "国家多事な時期にあって、外交と内政の両面で指導力を発揮できる人材が求められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "記者は社説に「国家多事の今こそ、政治家は私利私欲を捨てるべきだ」と書いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "当年は不景気でもあり、国家多事の際でもあるので、山車も屋台もできなかったが、それでも近在から人が出て、紅い半襟や浅黄の袖口やメリンスの帯などがぞろぞろと町を通った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "国家多事の際、能く為し難きの事を為し、能く立て難きの功を立つるは、過を償うの大なるものなり」と。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "魏の曹真は、「国家多事の秋。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
