    "definitions": [
      {
        "index": 1,
        "gloss": "this year",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今年こそは、長年の夢だったフルマラソン完走を達成したい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今年は冷夏になると予想されていたが、実際は例年より暑かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今年の冬は、家族で温泉旅行に行く計画を立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "今年、「宮沢が死んだ」と聞いた時には、大変気の毒に思ひました。",
              "citation": {
                "source": "宮沢賢治全集刊行に際して",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が今年になつて「新生」を受取るやうになつてから、漸く出たなとおもつた。",
              "citation": {
                "source": "感想",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ハ一度モ夜ノ海ニ行キマセン。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年私ハ、小サイタライノオ風呂ニ二三日ゴトニ入リマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "大隅君が渡支して五年目、すなわち今年の四月中旬、突然、彼から次のような電報が来た。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は今年七ツになる、先達小学校に入学したばかりだつた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　父と今年小学に這入つたばかりの弟の声だ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の夏、荒物屋には幼い可愛い顔が一つ増した。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の秋祭はわが帰省中にとの両親の考えで少し繰り上げて八月某日にする事ときめてあったが、数日来のしけで御供物肴がないため三日延びた。",
              "citation": {
                "source": "祭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年は例年の事を思えば楽な暮であるが、去年や一昨年の苦しかった暮には、却って覚えなかった一種の不安と淋しさを覚えて、膝の上のまじょりか皿と、老い増さる母の顔とを思い比べた。",
              "citation": {
                "source": "まじょりか皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "平一は今年の夏妹夫婦と姪とで夜の会場へ遊びに来た事があった。",
              "citation": {
                "source": "障子の落書",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理人篠村宇三郎、かご入りの青海苔を持って来て、「これは今年始めて取れましたので差上げます。",
              "citation": {
                "source": "高知がえり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の文官試験にも残念ながら落第してしまった。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、今年三十三の厄年だといふ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年も旅をするであらう。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年は多分日向に赴く。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏中釣りをしたため、今年は私の健康はいゝ。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、家を出る時に、小学校に今年上つた女の児が、「お母あさん。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒い間は休んで今年若葉の出る頃から此の秋迄に十五六枚か、事によると二十枚程の畫布を塗り潰した。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の秋になつて病氣の工合が大分よくなつたし、醫者も許し又すゝめてくれたので、何處かへ試しに行つて見ようと思ふと、生憎なもので時候外れの霖雨がしばらくつゞいて、中々適當な日は來なかつた。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが今年の凶作で急に焼木杭に火がついた形である。",
              "citation": {
                "source": "新春偶語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "数年前よりドイツのコルン氏が研究を重ねた末今年に至ってほぼ成効した、いわゆるコルン式写真電送機の事は既に我邦の諸新聞雑誌に掲載せられた事があるので事新しく述べる必要もないが、簡単に云ってみれば先ず次のような仕掛けである。",
              "citation": {
                "source": "写真電送の新法",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者も今年初夏頃の某誌にもはや充分意を尽したつもりの恋愛論を発表しました故、論筆として諸氏に見える余裕のものを多く持ちません。",
              "citation": {
                "source": "恋愛といふもの",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年十七の春父が急いで国元へ引返す際、彼はすぐに騒ぎを打ち鎮めて京へ帰れる見込みで、留守の館には姫の従者として男女一人ずつ残しておきました。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だって今朝の新聞に今年は北の方の漁は大へんよかったと書いてあったよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうです、今年の渡り鳥の景気は。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年は二｜疋目だな。",
              "citation": {
                "source": "耕耘部の時計",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは今年三｜度目、イギリス海岸へ行きました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけにあの瀬の処では、早くにも溺れた人もあり、下流の救助区域でさえ、今年になってから二人も救ったというのです。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年も、もう空に、透き徹った秋の粉が一面散り渡るようになりました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
