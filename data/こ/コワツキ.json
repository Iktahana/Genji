        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "冷酷な眼が、感情のない声つきが、そしてぞっとするような微笑が。",
              "citation": {
                "source": "めおと蝶",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでもない仲にしては、あの声つきや、なまめかしいそぶりは、（誇張とみせつけはあるにしても）ちょっと度が過ぎている。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三四になるまで、いつもひとりで、べそをかいているというふうだったが、やがて背丈の伸びるにしたがって、顔だちも明るく身ぶり声つきも、きわだって美しくなった。",
              "citation": {
                "source": "蘭",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お石はその音を聞きすましでもするように、ながいあいだ黙って俯向いていたが、やがて内へひくような声つきでこう云った。",
              "citation": {
                "source": "日本婦道記",
                "author": "墨丸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
