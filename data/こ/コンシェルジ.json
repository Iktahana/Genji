          "literary": [
            {
              "text": "窓が明いてコンシェルジの伯母さんが現われる。",
              "citation": {
                "source": "映画雑感（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おこうさんの妹おりゅうさんはかつて剞※氏某に嫁し、後未亡人となって、浅草｜聖天横町の基督教会堂のコンシェルジェになっていた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段を登つて、コンシェルジュの教へたまゝに戸を叩くと、一人の老婦人が戸を開けた。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            }
          ]
        }
