[
  {
    "uuid": "9c6b4982-5f15-5f76-8651-e4510533811c",
    "entry": "孤絶",
    "reading": {
      "primary": "こぜつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
