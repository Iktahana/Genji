        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四方樹木にかこまれた、すり鉢形の小盆地で、その真ん中に宏大な屋敷、里の長の住居がある。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、さのみ気が乗ったでもない様にして、枕元の小盆の傍に小寒く伏せてあった雑誌を取りあげた。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小盆の上に「粥」と「梅びしお」といり卵の乗ったお君の食事を見て栄蔵は、あの卵は今日だけなんだろうなどと思った。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その辺は平地と云つても、直径にして一里足らずの小盆地で、奥地から平凡になだらかに低まつて来た山々は一面の雑木山で、盆地の端に立つと向ふ側の山も殆ど手の届くやうな感じに近く見える。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その連丘にはさまれた小盆地をコマ川が精一パイ蛇行している。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけて夫人が、良人の死後、一族もみな討たれて少ない中に、よく三、四千の小勢をもって、河内の小盆地にたてこもり、正行、正時の成人を待っていた十二年間の苦節を語るだんになると、涙に顔もよごしていった。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわば日本国の歌の景は、ことごとくこの山城の一小盆地の、風物にほかならぬのであった。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その峠を越えた下が真弓で、そこまで市川がずっと曲って入り、生野の小盆地に続いている。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "十数万人にのぼる人間が、敵味方にわかれ、京都という一小盆地の底で、夏じゅう、明けても暮れても、喚き合い、殺しあっていたのであった。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
