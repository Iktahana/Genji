[
  {
    "uuid": "a3a04c3a-18f7-5c37-9b6e-600b29420617",
    "entry": "熟し",
    "reading": {
      "primary": "こなし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
