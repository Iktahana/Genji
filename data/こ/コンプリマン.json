          "literary": [
            {
              "text": "慣例のコンプリマンは簾を得て書を得ざる※斎、茶山の詩を見せてもらふ石田梧堂の外、蘭軒の妻妾に宛ててある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に笛の彦七と云ふものと、坂東彦三郎とのコンプリマンを取り次いでゐる。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に※堂の親戚及同驛の知人に宛てたコンプリマンが書き添へてある。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "（手を差出す）一寿　　メ・コンプリマン・ア・マダム。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
