    "definitions": [
      {
        "index": 1,
        "gloss": "snugly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "都会の喧騒から離れた、小じんまりとしたカフェで読書を楽しむのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "居酒屋の奥にある小じんまりとした部屋に案内された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の部屋は家具を小じんまり配置してある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「ゆうべのへやは、わたしひとりには広すぎるから、ほかにもっと、小じんまりしたへやがあったら、うつらせてください。",
              "citation": {
                "source": "名なし指物語",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋上の眺めは左右に岸壁を見、白沫立つてたぎり流るゝ川に臨むのであるから、緑蔭水聲、おのづから兩袖に清風を湧かす概があつて、名も餘り高く無いところだが、小じんまりして溪谷美のあることを感じさせられる。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その家の小じんまりしてゐるやうに、またその家具や身じまひの小ざつぱりしてゐるやうに、すべてが感じが好かつた。",
              "citation": {
                "source": "島の唄",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯槽は小じんまりとしたコンクリートで出来ていて、お湯につかっていながら、スウイッチをひねると、ガチャン、ガタン、ガチャン、ガタン、ゴボン、ゴボンとスチームが入ってくるようになっていた。",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "家は○万楼から四五丁位の処でその辺は花柳街で、小奴の家は格子戸のはまつた、下が三畳に六畳の二間、二階も一間位はあつたらしい、小じんまりした家であつたやうに記憶してゐる。",
              "citation": {
                "source": "石川啄木と小奴",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、見え隠れに又その後を尾けて行くと、女は今戸橋を渡って、八幡さまの先を曲がって、称福寺という寺の近所の小じんまりした二階家へはいる。",
              "citation": {
                "source": "半七捕物帳",
                "author": "河豚太鼓",
                "note": "青空文庫"
              }
            },
            {
              "text": "おころの家には格子がなく、入口は明け放しの土間になっていたが、それでもふた間くらいの小じんまりした住居で、家内も綺麗に片付いているらしかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "菊人形の昔",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間も馬車はとめどなく駈けていたが、まもなく道路に面して立っている軒の長くつき出た小じんまりとした赤煉瓦の別荘風の家の前へ停められた。",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "允男を高等二年生にした二十年の歳月は、公荘と允子との生活をもいつしかかえ、彼等は郊外に木造の小じんまりした洋館を新築した。",
              "citation": {
                "source": "山本有三氏の境地",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて二人は、浅井が行きつけの小じんまりした一軒の料理屋の上り口に靴をぬぐと、堅い身装をした女に案内されて、しゃれた二階の小室へ通った。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い畑と、静かな林を後ろにして小さな牧場とが二階の欄干から眺められる小じんまりした、感じのいいところです。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　お光は、初めて乘つた汽動車といふものゝ惡い臭ひに顏を顰めて、縞絹のハンケチで鼻を掩ふてゐたが、この時｜漸く斯う言つて、其の小じんまりとした、ツンと高い鼻を見せた。",
              "citation": {
                "source": "東光院",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のすぐ傍を、小じんまりした形の好い形を左右に揺りながら、さも嬉しそうについて来る雌鴨を、目を大きくしてながめると、一杯にこみあげて来る満足を押え切れない様に、若い雄鴨は大羽ばたきをして、笛の様に喉をならした。",
              "citation": {
                "source": "一条の繩",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見たところは、いかにも小じんまりしてゐる。",
              "citation": {
                "source": "日本の女",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "小じんまりとした美しい昼の様だつた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "田原屋の小じんまりとしているに反して、やや散漫の感じがないではないが、それだけ気楽は気楽だ。",
              "citation": {
                "source": "早稲田神楽坂",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの行かない理由さえきかして呉れれば私一人でだって行くわ」　短い沈黙の後、戸のこっち側で聞いていてさえその瞬間杉の小じんまりした顔がパッと赧らんだのがわかるような調子で云った。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮膚が蝋色に透き通って見えて、それでなくても、顔の輪廓が小さく、柔和な緩い円ばかりで、小じんまりと作られている。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤煉瓦の小じんまりした二階建が気に入ったので、割合に高い一週二｜磅の宿料を払って、裏の部屋を一間借り受けた。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤煉瓦の小じんまりした二階建が気に入ったので、割合に高い一週二磅の宿料を払って、裏の部屋を一間借り受けた。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "下りて見ると、小さい柱廊があり、その先は美しいモザイクの敷石で中庭になって居り、いかにも小じんまりして、高貴な人の邸宅とは思えないほどの単純な構造がまず意外だった。",
              "citation": {
                "source": "パラティーノ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏はまことに質素な襟飾りを着けた敬虔な哲学者であり、その体系は小じんまりと整頓した研究室をぼんやりと照らす蒼ざめたランプのように典雅な上品なものである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　志村鈴江の代々木の家は、やつと接収を免れた洋風の小じんまりした住宅で、もともと兄のために建てたこの家を、兄が父の亡くなつた後の本宅へ移つたので、彼女はいくらかの動産と共にこれを貰ひうけ、自由気儘な生活をしてゐるのである。",
              "citation": {
                "source": "ある夫婦の歴史",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん大きな博物館の建て物は立派であつて、その國や町の飾り物としては結構でありますが、これを見物する人や勉強する人達には不便が多いのですから、それよりも小じんまりとした博物館で、内容の整つたものゝ方がよいといふことになるのであります。",
              "citation": {
                "source": "博物館",
                "author": "濱田青陵",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はまたこういう静な坂の中途に小じんまりした貸家を見付ると用もないのに必ず立止っては仔細らしく貼札を読む。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで竜子は小石川茗荷谷の小じんまりした土蔵付の家に母と二人ぎり姉妹のようにくらして来た。",
              "citation": {
                "source": "寐顔",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそ小じんまりした家の方がよいかも知れません。",
              "citation": {
                "source": "春雨の夜",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがての果てに、さらに部屋を幾つも幾つも通り抜けてから、ラッベク第二世と将校たちが小じんまりした一室へはいると、そこには球突台が据えてあった。",
              "citation": {
                "source": "接吻",
                "author": "ПОЦЕЛУЙ",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとがひは小じんまりと、先の方がくくれてゐる。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうあんな辛い奉公はさせへんぜ」　種吉は蝶子に言い言いしたが、間もなく所望されるままに女中奉公させた先は、ところもあろうに北新地のお茶屋で、蝶子は長屋の子に似ず、顔立ちがこじんまり整い、色も白く、口入屋はさすがに烱眼だった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
