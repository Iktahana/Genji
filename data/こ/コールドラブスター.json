        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "食堂で、久し振りでうまいコールドラブスターをつつきながら私はすつかり安心して藤枝の先見に感服してしまつた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリルで、オルドヴルとオニオングラタン、コールドラブスターを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コールドラブスターとキャビネットプディング二つ食ひ、コーヒーのみ、二人で九円半は高い。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューグランドに寄り、ポタアジュ、コールドラブスター、スパゲティと、ローストビーフにヨークシャイヤプディングとアイスクリーム。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "コールドラブスターとミンスビーフトースト。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "日比谷映画へ涼みに入る、ニュースと一本見て、丁度逢った徳山とホテルのグリルへ行き、夕食、コールコンソメ、コールドラブスター、カネロニー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "バアでマンハッタンをのみ、食堂へ、ポタアジュ、コールドラブスター、肉に七面鳥、アイスクリームにウイスキソーダ一杯のみ、いゝ心持になり、自動車で宿へ帰ると又入浴。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食はホテ・グリで一人でオニグラ、コールドラブスター、アスパラ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋井とホテ・グリの食事、ポタアジュ、コールドラブスター、ハンバーグとアプルパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二十五日（火曜）　招魂社の臨時大祭で特別マチネー、入りは七分位か、まあみっともなくないだけ、走れよ／＼で昼の終り四時十分、急げば外で食事出来るからと、ホテ・グリで食事、スープ抜いてコールドラブスターとハンバーク。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブロスにコールドラブスター、肉の煮込み、バゞロアとプディング。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "上山が来たので三人でニットーで紅茶、ホテ・グリへ行って食事、オルドヴル、コールドラブスター、シャリアピン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
