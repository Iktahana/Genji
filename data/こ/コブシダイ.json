        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地震で落ちてきた岩は、こぶし大の大きさで、もし頭に当たったら大変なことになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はポケットからこぶし大のリンゴを取り出し、美味しそうに丸かじりした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "こぶし大の石を拾い上げ、力いっぱい水面に投げると、大きな水しぶきが上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "こぶし大の石ころを一秒に三四ぐらいのテンポで続けざまにたたき合わせるような音である。",
              "citation": {
                "source": "軽井沢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
