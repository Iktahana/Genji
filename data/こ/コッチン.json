          "literary": [
            {
              "text": "これを聞いて帰宅して晩に寝ようとすると、枕もとの時計の音が「カッチン、コッチン、カッチン、コッチン、ナッシン・バッタテーラ」というふうに聞こえたくらいである。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『スイート・ロレーン』の歌がかかり、それが終わって語りとなり、続く歌は『スコッチング・ウィズ・ザ・ソーダ』だった。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
