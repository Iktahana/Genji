        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夜ごとのお屋敷勤めにきょうばかりは世間晴れての無礼講とあってか、下町好みのその姿のごとくに、歌も踊りもずっといきに砕けて、三味線太鼓に合わせながら、エイサッサ、コラサノサッサと婉になまめかしく舞い狂っているのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "コラサノサアのさあこいだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃ君、自分一人や自分のうちだけの問題じゃない、国ぜんたいが、ノルかソルかのさかい目に来ているんだから、そこを君――明　（歌う）米は百円する、ヤッコラサノサってんだ！",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これだけ手を廻して駄目だとすれば、連中が歌うちゃちゃらかちゃんの唄の文句じゃないけれど、思いおくことサッコラサノサ皿になしサイサイサイだ。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
