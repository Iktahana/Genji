        "examples": {
          "standard": [
            {
              "text": "彼女は神に、失われた愛を請い求めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は真実を請い求めるかのように、その古文書を読み込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私たちは、平和な世界を心から請い求める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "栗本も同様に、憐れみを乞い求める眼と、弱々しげな恰好をして、軍医の前へやって行った。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう諦めてはいるものの、彼女は、また何かを乞い求めるように見えた。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "粗暴な向う気の強い彼には珍しく、おとなしいというよりはなにか乞い求めるような表情だった。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五年ごとに彼らはこの神の許にその仲間の誰かを送り、その代りにもろもろの必要な物を乞い求める。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
