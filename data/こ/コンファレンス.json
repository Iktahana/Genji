        "examples": {
          "standard": [
            {
              "text": "来月、東京で国際的な学術コンファレンスが開催されます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今回のコンファレンスでは、新しい技術動向について活発な議論が交わされました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「明日のコンファレンス、資料はもう準備できた？」 「はい、完璧です！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これをコンファレンスという。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "エイチャイピーラの唄＝事務所の茶＝クベルパルトコンフェレンスのトリビューンにもさじのついた茶のコップの写真が出た。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○ РМ でロマン・ガゼートの作家、出版者、読者のコンフェレンスを催した。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これをコンフェレンスという。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの「バルガン」の問題というものが列国の「コンフェレンス」の上に成立っているが、列国の利害関係が何時でも同一ではない。",
              "citation": {
                "source": "東亜の平和を論ず",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に巴里の「コンフェレンス」に於て「ボスフォラス」海峡の通行を止め黒海艦隊を制限したと同様に、支那海、日本海に優勢の艦隊を置くという事はよほど危険である。",
              "citation": {
                "source": "東亜の平和を論ず",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
