        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "和英の辞典はコンサイズよりもすこし大きくて目のつかれないひきいいのが林町にあったから、それと同じのを入れましょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪ビルから電車で三省堂へゆき、そこで和英コンサイズを二冊買って、速達に出せるように包んで貰い、松田という人の和露も見ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三省堂のコンサイズよりもよいと思います。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○三省堂で、コンサイズ和英二冊買って光子さん夫婦に送る。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
