          "literary": [
            {
              "text": "美しさがあつても、輝きがあつても、それは大理石の刻像のやうに血がない熱がない。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし能の彫刻像にろくなものはない。",
              "citation": {
                "source": "能の彫刻美",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
