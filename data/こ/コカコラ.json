        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ぼくは勿論、一生懸命で、隅から隅まで、草の根を押しわけて探してみましたが、処々に遺っているコカコラの空瓶、チュウインガムの食滓などのほかには、水滴をつづった青草が、どこまでも意地悪く、羅列しているばかりです。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "コカコラなどをのんでいる。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ食堂ノバアノ方ヘ捜シニ行コウトシタ時、食堂ノ廊下ノ方カラコカコラノ壜トコップヲ二ツ盆ニ載セテ、オ静ガ二階ノ階段ヲ上ッテ行コウトスルノト、パッタリ出会ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイ、オ帰リニナッタコトヽ存ジテオリマシタラ………」「アヽソウカイ」「………オ二階デ涼ンデイラッシャイマシタンデ、………」コップガ二ツトコカコラノ壜ガ二ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コカコラヲ飲ムト間モナク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、僕等が中学生になった頃だと思うんだが、コカコラが、アメリカから渡来したのは。",
              "citation": {
                "source": "清涼飲料",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまのコカコラとコカコラが違った。",
              "citation": {
                "source": "清涼飲料",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、名前も、コカコーラと、引っぱらずに、コカコラと縮めて発音していた（日本ではの話ですよ）。",
              "citation": {
                "source": "清涼飲料",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "コカコラの中に、コカインが入っていたってのは、その頃の奴じゃないだろうか。",
              "citation": {
                "source": "清涼飲料",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く、コカコラの赤は、あくどい。",
              "citation": {
                "source": "清涼飲料",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "コカコラばっかりじゃあない。",
              "citation": {
                "source": "清涼飲料",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔はコカコラの広告にしたって、真っ赤な消防ポンプじゃなかった。",
              "citation": {
                "source": "清涼飲料",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
