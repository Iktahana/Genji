[
  {
    "uuid": "608249c0-a2bd-5c7f-bd00-ba59e17f6c0d",
    "entry": "心がけ",
    "reading": {
      "primary": "こころがけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "(mental) attitude",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日頃の心がけ次第で、運勢はいくらでも変えられるものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "常に最悪の事態を想定しておく心がけが、いざという時に役立つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "感謝の気持ちを忘れない心がけが、良好な人間関係を築く鍵だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "これは人々の心がけによることであるが、しかし大体において学校の普通教育ないし中等教育の方法に重大な欠陥があるためであろうと想像される。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の職業をして居る人だったか忘れましたが、とにかく慈悲を心がけて暮らして居る或る男がありました。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭をいぢる時間も、子供と遊ぶ時間も、珈琲店を夜歩きする時間も、彼にとつては皆「頭腦の營養」のためであり、仕事への心がけた準備なのである。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の思想や、立場には勿論同感しないが、彼等のペンをとる態度は、僕は、どこまでも、手本として学びたいと心がけている。",
              "citation": {
                "source": "愛読した本と作家から",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一箇でもよけいにマッチを詰めて、たゞ金を儲けたいと心がけている。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　幹太郎は、悪党に対して純なものの正しさを譲るまいと心がけながら云った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おべっかを使って、落ちこぼれをめぐんで貰おうと心がけている手あいだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学の全×××宣伝力を挙げて、労働者農民に力強く喰い入ることを心がけねばならない。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことに殊勝の心がけの人だった。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "教育が悪かったのか、自分の心がけが悪かったのか、両方が悪かったかである。",
              "citation": {
                "source": "鎖骨",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の用心は今から心がけなければ間に合わない。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "不備に対して当事者を攻撃し誹謗する事よりもむしろ当事者の味方になり、そうして一般読者とともにその不備を除去する方法を講究する機関となる事を心がけたいものである。",
              "citation": {
                "source": "一つの思考実験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "正しい心がけで、そのほかは神様におまかせしておけば安心です。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もし私が知らずに渡瀬さんを誘惑しましたら、どうかどうかお許しくださいまし」「正しい心がけで、そのほかは神様におまかせしておけば安心です」……その母の言葉、それがまた思いだされた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学者なんて奴は、尾鰭をつけることがうまいですからね」　渡瀬さんはこだわりなさそうに笑ったが、やがていくらかまじめになって、「今日はお母さんは……お留守ですか」「診察に出かけました……よろしくと申していました」　正しい心がけで……おぬいは怖れることは露ほどもないと心を落ちつけた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルストイの作品のうちにあった例だと思います、何の職業をしている人だったか忘れましたが、とにかく慈悲を心がけて暮しているある男がありました。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "理解を広くしようと心がけている人が世の中を最も広く愛し得るわけなのでありますが……しかし、ここに、感覚というものがあります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現世の執着の一つであるあなたの愛によって、わたくしを妨げず、そして因より備わって居るその世界の月の光を曇らせまいと心がける処に、はっきりとその道は開かれるのです。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのお心がけはよく分って居ます。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ほんとうにあんな心がけのいい子は今ごろあり……。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで舞台装置家はなるべく手のかからぬようにかからぬようにと心がける。",
              "citation": {
                "source": "久保田米斎君の思い出",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中に、伊豆あたりへ遠出するように心がけようじゃないか。",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　――それあそうだ」　なかなか心がけのよいファンである。",
              "citation": {
                "source": "牛込館",
                "author": "映画館めぐり（十）",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、つまり私はその時以来、このネクタイピンに対する相応の代価を、その女の子に遇ったならば返してやろうと心がけていたのだ。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあそうなるように心がけねばならん。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "影はいつも、つとめていちだん上に立つように心がけていました。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「実に立派な心がけです。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての易者と星占家（家相家や、人相見や、八卦師や）は、かうした彼等の所謂亡者どもを濟度するため、矛盾にも此處で前説を豹變し、逆に今度は、意志の自由が運命を支配すること、自覺と心がけとによつて、何人も意識的に人相を變へ、惡しき手相を善き手相にし、自由に運命を支配し得ることを辯解する。",
              "citation": {
                "source": "易者の哲理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての易者と星占家（家相家や、人相見や、八卦師や）は、かうした彼等の所謂亡者どもを済度するため、矛盾にも此処で前説を豹変し、逆に今度は、意志の自由が運命を支配すること、自覚と心がけとによつて、何人も意識的に人相を変へ、悪しき手相を善き手相にし、自由に運命を支配し得ることを弁解する。",
              "citation": {
                "source": "易者の哲理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二百俵取りでは、もとより裕福という身分でもなかったが、和田の家は代々こころがけのいい主人がつづいたので、その勝手元はあまり逼迫していなかった。",
              "citation": {
                "source": "鷲",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
