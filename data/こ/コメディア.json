        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私にはやがてコメディアというものの精神もわかるかもしれませんね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラゲディアとコメディアとの精神はまるであっちこっちとの極ではくっついていますもの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "文芸復興の初頭十五世紀、日本には足利義満がいて、能楽が発展していて、平家物語の出来た十三世紀にダンテは「コメディア」をかいているというようなこと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コメディアというものの内容の性質は、時代との関係で大したものね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コメディア、フィニタという文句は、パリアッチョ（道化師）という極めて近代風なオペラの終曲の主人公のアリアです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コメディア、エ、フィニタと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸々其でコメディア・フィニタ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故ならば考えても御覧なさい私はきのう　イリヤードと　ディビナ・コメディアをよむ。",
              "citation": {
                "source": "初夏（一九二二年）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンテ「ディビナ・コメディア」斯う云うものを楽しんでよめるには、或年が必要であると思う。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この女、ある朝、寝床の中で、コオヒイかなんか飲みながらコメディア（演芸新聞）をひろげると、二段抜きで、だれかの漫画が出てゐる。",
              "citation": {
                "source": "世界覗眼鏡",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あ、もしもし、あんた、今朝のコメディア見た？",
              "citation": {
                "source": "世界覗眼鏡",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋では、古典悲劇専門の俳優だけは、トラジェディアン、即ち悲劇俳優と呼んでいるけれども、その他の、一般の俳優は、コメディアンと称し、特に、「喜劇」のみをやらなくても、ただ「役者」という意味で通つていることも注意すべきである。",
              "citation": {
                "source": "演劇の様式――総論",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し、ここで、もし、これを「演劇」の一様式として、強いて、ジャンルの名を与えるとすれば、イタリアにその源を発した「コメディア・デルラルテ」であろう。",
              "citation": {
                "source": "演劇の様式――総論",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これよりかなり前にカラカラ帝の勅令は植民地の住民にローマ市民権を与えられたが現実にはローマの騎士たちはニコメディアやアウグスタ・トレウェロルム（＊ドイツ西部）と大きな違いが無くなり今日ボストンやニューヨークの共和党銀行家とオクラホマの民主党農民の間の違いと同じようになった。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "おじさんのコメディアンがやるギャグです」「ほんとだと、この私が言ってるじゃないですか」「信じませんね」「ナナエちゃんいますか、などと自宅に電話をしたら駄目よ」「なぜ？",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "口髭はボウボウ、身体に比べて馬鹿げたほど大きく、なんだか映画にでてくるコメディアンの髭のようだった。",
              "citation": {
                "source": "絞首刑",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばこれを書くちょっと前のこと、ＢＢＣを聴いていると、一組のコメディアンが九時のニュースの前のいつもの番組をやっていた。",
              "citation": {
                "source": "詩とマイクロホン",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
