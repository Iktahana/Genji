        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「わしは中心区あたりのコバーグ・スクエアで小さな質屋業を営んでおります。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サックス・コバーグ・スクエアの家へ帰りました。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく歩くと、サックス・コバーグ・スクエアに着いた。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "サックス・コバーグ広場のことはあらかたわかった。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　サックス・コバーグ広場を離れ、角を曲がるとすぐその通りはあった。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "コバーグ広場と比べると、画の表裏ほどの差だった。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここはモーティマー商店、煙草屋、新聞の小売店、シティ＆サバーバン銀行コバーグ支店、菜食料理店にマクファーレン馬車製作会社の倉庫。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "コバーグ・スクエアの事件は深刻だ。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "サックス・コバーグ・スクエアへの調査。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「建物の中を抜け、サックス・コバーグ・スクエアへ出る道のみ。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
