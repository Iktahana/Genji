[
  {
    "uuid": "0888f679-b3df-5af3-8c17-13a1dfca166a",
    "entry": "孤影",
    "reading": {
      "primary": "こえい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
