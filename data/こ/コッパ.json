        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "権力者の前では、私のような平社員は木っ端同然の存在でしかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼の圧倒的な実力を見せつけられ、それまで抱いていた自信が木っ端のように吹き飛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "そんな木っ端なプライドは捨てて、一からやり直す勇気を持つべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
