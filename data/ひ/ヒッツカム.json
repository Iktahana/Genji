[
  {
    "uuid": "fd325a12-09e8-543a-b461-87c034275700",
    "entry": "引っ掴む",
    "reading": {
      "primary": "ひっつかむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-マ行"
      ],
      "ctype": "五段-マ行",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to snatch (at)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は慌てて机の上の書類を引っ掴んで会議室へ向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "落としそうになった荷物を、とっさに手を伸ばして引っ掴んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「おい、待てよ！」と叫びながら、彼の腕を引っ掴んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それがまた喧嘩のはじまりで、気の早い富蔵は相手の横っ面をぽかりとなぐりつけると、藤吉はかっとなって富蔵の胸倉を引っ掴むと、そのはずみに喉を強く絞めたとみえて、富蔵はそのままぱったり倒れてしまったので、藤吉はびっくりして逃げ出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘドの出そうな建築の彩り、眼の玉を引っ掴む広告、耳にたたき込む音楽、魂を奪わねば止まぬ旗や、看板なぞが、押し合いヘシ合い競争をして、気も遠くなる程バラック気分を煽り立てている。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを付け入って更にかれの袖を引っ掴むと、男はもう絶体絶命になったらしく、着ている布子をするりと脱いで、素裸のままでまた駈け出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "松茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は肩を沈めて相手の腕を引っ掴むと同時に自分の爪先へ投げ出すと、その上を飛び越えて寅松が突いて来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "春の雪解",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊、早くあの野郎をしょびいて来い、逃がすな」　熊蔵はすぐに店から飛び出して、藤次郎の腕を引っ掴むと、かれは案外におとなしく引き摺られて来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "三つの声",
                "note": "青空文庫"
              }
            },
            {
              "text": "スウェターに首を突込んで、靴下を穿いて、帽子を引っ掴むと、梯子段の途中に引っかかっている女将の巨体を飛び越すようにして上り框から半靴を突かけると表の往来……千代町の電車通りに飛出した。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の脚は、墓石みたいに、動こうともしなかったが、ふと、その人の顔を見ると、柘植嘉兵衛であったので、はっと弛むと、『これッ――見苦しいっ』　嘉兵衛は、共に泣きながら、酔いどれでも引っ掴むように、無理無態に人混みから山門の方へ、彼を拉して行った。",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼はそこで必死に誰かを呼ぼうとしたが、追いついて来た自斎の猿臂が、ムズと彼の帯際を引っ掴む。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御名方神はすっかりこわくなっておずおずとしりごみをしかけますと、御雷神は、「さあ、こんどはおれの番だ」と言いながら、御名方神の手くびをぐいとひっつかむが早いか、まるではえたてのあしをでも扱うように、たちまち一｜握りに握りつぶして、ちぎれ取れた手先を、ぽうんと向こうへ投げつけました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "うむ、これはこうしていられないぞ」　帆村探偵は暗号の手紙をひっつかむと、館員には挨拶もソコソコにして、Ｗ大学を飛びだした。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ネズミをひっつかむがはやいか、ぐうっとのみこんでしまったのです。",
              "citation": {
                "source": "ネコとネズミのいっしょのくらし",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　おばあさんは、腹だちまぎれに、ラプンツェルの美しい髪の毛をひっつかむと、それを二巻き三巻き左の手にまきつけました。",
              "citation": {
                "source": "ラプンツェル",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕立屋さんはこれを見ますと、かんかんに腹をたてて、金の足台をひっつかむがはやいか、天国から地上のどろぼうばあさんめがけてなげつけました。",
              "citation": {
                "source": "天国へいった仕立屋さん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっこさんは耳輪を見ると、たちまちアパートのことも、ミトレイのことも忘れてしまって、帽子をひっつかむなり、ドゥーシュキンの所へ駆けつけたのさ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "この虫とり網を見るが早いか、少年は跳ねおきて、それをひっつかむと、長持のふたをさっとすくいました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、父親はそこらにあったものをひっつかむようにして、闇の中へ駈け出しました。",
              "citation": {
                "source": "縛られたあひる",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "やにわに彼は傍らに在った豚の生肉をひっつかむと、吉村巡査に追いすがりざま、それを無理矢理に口のなかにおしこもうとした。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっとワイングラスをひっつかむと、シャンパンの泡が床にこぼれた。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとこの時何者かが矢庭に背後から彼を引っつかむと、彼が抗う暇もなく兇暴なる腕は、彼の首をしめつけたまま忽ち壁に向って押し戻した。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし痛みに堪えられないように、すぐに横倒しに倒れかかったが、そのかたわらに両刀のあるのを、手に引っつかむと脇差しを帯び、刀を杖にまた立ち上がるや、スルスルと部屋を襖のほうへ歩き襖を蹴開くと廊下へ出た。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君、一緒に行こうじゃありませんか、見せるものがある……」　こう言って、巡査の手を引っつかむと、彼はベンチの方へ連れて行った。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と思わず引っつかむと、これは、冷たい雫にぬれた棹のさきだった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "義経は無造作な装立ちで、太刀だけを引っつかむと、中門の前に置かれた馬にひらりとまたがり、門を開けて、土佐房今や遅しと待ち構えていた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十二巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こやつッ」　と、跳びかかってきた男は、小泥棒でもあしらうように、ムズと孫兵衛の襟がみを引っつかむ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "で僕はむっとして、彼奴の肩をひっ掴むと、部屋から外へほうり出してやったんだよ。",
              "citation": {
                "source": "グロリア・スコット号",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、その刹那――間髪を入れず、ぱっと躍り上った門倉平馬、師匠から雪之丞へと、渡されようとする巻物を、傍からひっ掴むと、飛鳥のような素早さで道場外へと、飛び出した。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "拾うというより、あたまの上へ来たやつを、人より先に跳びあがり、伸びあがって、ひっ掴むんです。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀之丞の手首をひっ掴むと、「曲者｜捕った……鼓！",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柄をひっ掴むとグ――ッと振り上げ、「今度こそ遁がさぬ、乳臭児めが――ッ」　振り返って躍りかかった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒーッ」と呻くと野太刀を落とし、宗三郎の太刀をひっ掴む。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
