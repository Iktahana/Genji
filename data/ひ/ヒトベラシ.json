        "examples": {
          "standard": [
            {
              "text": "不況のあおりを受けて、工場では大規模な人減らしが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "効率化という名の人減らしに、現場の不満は爆発寸前だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "AIの導入が、結果として事務部門の人減らしに繋がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "デなくッて成程人減らしだッて罪も咎もない者をそう無暗に御免になさる筈がないやアネ……それとも何か御免になっても仕様がないようなわりい事をした覚えがお有りか」「イエ何にも悪い事をした覚えは有りませんが……」「ソレ御覧なネ」　両人とも暫らく無言。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "時局の推移につれて、海外貿易の仕事に変化が生じ、会社では事業を縮小したりそろそろ人減らしもはじまっていた。",
              "citation": {
                "source": "今朝の雪",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "技師ルイバコフは人減らしで三月前国立出版所をやめさせられた妻と子と自分の妹、女中、一組の下宿人とで、その協同家屋の室９に生活している。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事がひまになったので人べらしをする、おまえの病気は治りにくいようだし、先の見込みもあまりないから、この辺で身をひいてもらうことになった。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
