  {
    "uuid": "007daa71-dbbd-5288-a312-dbe42fdcd9b5",
    "entry": "表式",
    "reading": {
      "primary": "ひょうしき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この著者は文章にも一方ならぬ苦心と注意とを払っているのがわかりますが、文章の仮名づかいのこと（音表式でゆく）どうお思いになったでしょう。",
              "citation": {
                "source": "獄中への手紙",
