[
  {
    "uuid": "124fae6a-bf8b-59ff-a03b-103d669c0350",
    "entry": "ひとり子",
    "reading": {
      "primary": "ひとりご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
