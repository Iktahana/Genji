        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だから、一人頭二円ずつぐらい金を集めて置いてくれないか、それはボースンに頼もう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「一人頭、五十円の九一が出なけりゃ仕事をしねえといっとりますので……。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大官人中の大官人と覺しく、豪さうなる一人頭を擡げて、フレデリツクとは誰ぞと糺問せり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "道で出會ふ島民は誰一人頭を下げない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "道で出会う島民は誰一人頭を下げない。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人頭千円以上取れる会員が、少くとも二三十人は集まらなくちゃ、今まで貴様にかけた経費の算盤が取れんからな。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその燃えさしを懐中に突込まれたまま、燃えてしまうまで黙って奈良原少年の顔をマジリマジリと見ていたのが塾の中にタッタ一人頭山満少年であった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "月並能の後、一人頭二三十銭宛切り立てて舞台で御馳走を喰うのが習慣になっていたが、御馳走といっても、味飯に清汁、煮〆程度の極めて質素なものであった。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の座というのは自分が足を伸ばして寝るだけの広さで、同業の新聞記者が十一人頭を並べて居る。",
              "citation": {
                "source": "病",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその中で一人頭立った者の声で、「しっぺい太郎、今夜も来ないか。",
              "citation": {
                "source": "しっぺい太郎",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ただ無言のあいさつ」をする彼に対して、朝鮮農民が「たれ一人頭をあげるものも無かった」のは当然ではあるまいか。",
              "citation": {
                "source": "文芸時評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ、発起人が江戸で有名な金持のお医者さんで、それが道楽半分にすることだから、金銭に糸目をつけない、近頃での大きな催し物になる――　そうしてこの模擬戦に参加したものは、誰彼を問わず一人頭に百ずつくれる――それ行って見ろ、という評判が関ヶ原の東西南北に漏れなく伝わったものです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "物語りの筋がざっとできたら、その物語りをくみたてるために必要な人物を、こんどは、一人一人頭のなかで作りあげる。",
              "citation": {
                "source": "劇の好きな子供たちへ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "……すったもんだの末、では、われわれの頭数だけ、つまり、等分に四つに切って貰い、一人頭五十万円ずつならなんとか引受けましょうということになった。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（レマルク：西部戰線異常なし）10．だが一番有難たかつたのは一人頭の煙草の分配量が二倍になつたことだ。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人頭に葉卷が十本、紙卷が二十本、嚼み煙草が二切れ、こいつはどうして相當なもんだ。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてその一端の横穴から少年達は一人一人頭から這ひ込んで行つた。",
              "citation": {
                "source": "ある職工の手記",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり頭に小判を二枚ずつとかぎって、祝儀にしたところが、芯からの気違いじゃねえなによりの証拠だよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには林太郎はすっかりまいって、ひとり頭をかかえてべそ口をしているばかりでした。",
              "citation": {
                "source": "あたまでっかち",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その事情についてこゝで述べることは差控へるが、この作品はあくまでも文学座座員諸君をひとりひとり頭において書かれたものである以上、この劇団の存続する限り、或は、主なるメンバアが残留する限り、同一座のために捧げられたものである。",
              "citation": {
                "source": "「速水女塾」あとがき",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのなかにひとり頭目とおぼしきものがいた。",
              "citation": {
                "source": "リップ・ヴァン・ウィンクル",
                "author": "ディードリッヒ・ニッカボッカーの遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "信雄卿を世間知らずと思う前に、自分もまだ若いぞ若いぞ、とひとり頭を叩いて、自分を叱っていたところでござる」「思うに、奸智にたけたあの猿めに、うまうまたばかられたものでおざろう。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ肉体の濁りである」「…………」「さらに、その諸濁の心は、誰ひとり頭の抑え手もないままに、いつとなく思いあがって、遂には、反逆の心芽を育て、行く行くは、身みずからの荊棘を作るにいたる。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
