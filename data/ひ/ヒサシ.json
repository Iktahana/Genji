  {
    "uuid": "820ccf8b-2888-5cc4-a415-50c1ac33fde4",
    "entry": "永",
    "reading": {
      "primary": "ひさし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "予は又其空模様を永く見て居るに堪えないで家に入った。",
              "citation": {
                "source": "大雨の前日",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者たる自分は、どんな人間か判らなくなつて終つても、我作歌は永く人間界に存してあつてほしい。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "おんもといい、あっこといい、おっちゃんといったその悲しい声は永遠に父の耳を離れてしまった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ほど念を入れて聞いても、絶対の静かさは、とうてい永久の眠りである。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び動くということなき永久の静かさは、実に冷酷のきわみである。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "永久なる眠りも冷酷なる静かさも、なおこのままわが目にとどめ置くことができるならば、千重の嘆きに幾分の慰藉はあるわけなれど、残酷にして浅薄な人間は、それらの希望に何の工夫を費さない。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "母が永らくぶらぶらして居たから、市川の親類で僕には縁の従妹になって居る、民子という女の児が仕事の手伝やら母の看護やらに来て居った。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひた赤く赤いばかりで光線の出ない太陽が今その半分を山に埋めかけた処、僕は民子が一心入日を拝むしおらしい姿が永く眼に残ってる。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "互に手を取って後来を語ることも出来ず、小雨のしょぼしょぼ降る渡場に、泣きの涙も人目を憚り、一言の詞もかわし得ないで永久の別れをしてしまったのである。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんは永年お民さんをかわいがって御いでですから、お民さんの気質は解って居りましょう。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子のいやだという精神はよく判っているけれど、政夫さんの方は年も違い先の永いことだから、どうでも某の家へやりたいとは、戸村の人達は勿論親類までの希望であった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほどよい所の新墓が民子が永久の住家であった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（五）　クヮ（kwa）グヮ（gwa）は、カ・ガと混同する傾向が古くからあり、江戸初期の京都でも下層階級のものはカ・ガと発音したものがあったが、しかし標準的の音としては永く保たれた。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論昔のことでありますから、『万葉集』にしても寛永年間に刊行された版本を見ただけであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "汨羅の屈原ならざれば、恨みは何とかこつべき、大川の水清からぬ名を負ひて、永代よりの汽船に乘込みの歸國姿、まさしう見たりと言ふ物ありし。",
              "citation": {
                "source": "われから",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "永井荷風が『歓楽』のうちで「得ようとして、得た後の女ほど情無いものはない」といっているのは、異性の双方において活躍していた媚態の自己消滅によって齎らされた「倦怠、絶望、嫌悪」の情を意味しているに相違ない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "味覚としての「いき」は「けもの店の山鯨」よりも「永代の白魚」の方向に、「あなごの天麩羅」よりも「目川の田楽」の方向に索めて行かなければならない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "永遠に動きつつ永遠に交わらざる平行線は、二元性の最も純粋なる視覚的客観化である。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "永井荷風は『江戸芸術論』のうちで次のような観察をしている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            }
          ]
        }
