[
  {
    "uuid": "16614748-c01c-5b05-b27c-be28219755a1",
    "entry": "姫",
    "reading": {
      "primary": "ひめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
