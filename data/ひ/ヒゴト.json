          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日ごと寒さが増していく中、近所の公園の木々もようやく色づき始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女の病状が日ごと回復していく様子を見て、付き添いの家族は安堵の表情を浮かべた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "日ごと繰り返される単調なルーチンワークに、彼はいつしかやりがいを見失っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "わたしは來れる日ごとにここに來てそらを見、水を見、雲をながめ、新らしい世界の造營の方針をおまへと語り合はうと思ふ。",
              "citation": {
                "source": "龍と詩人",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またそういう人々がその生活の日ごとに、人類から彼等が負う負債を増しながら、同時に同胞に贈るべきものを増大して行った事が分るだろう。",
              "citation": {
                "source": "浅草紙",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "堯の窓からは、地盤の低い家々の庭や門辺に立っている木々の葉が、一日ごと剥がれてゆく様が見えた。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし花を生けて写生しようと思うとすぐにしおれたり、またこれに反して勢いのいいのは日ごとの変化があまりにはげしくて未熟なものの手に合わなかった。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　侵入者　郊外の田舎にわずかな地面を求めて、休日ごとにいい空気を吸って頭を養うための隠れ家を作った。",
              "citation": {
                "source": "路傍の草",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば、お雪が情人に貢ぐために行商する四季折々の花、美しく薫のあるのを、露も溢さず、日ごとにこの洞穴の口浅く貯えておくのは、かえって、滝太郎が盗利品に向って投げた、花束であることを、あらかじめここに断っておかねばならぬ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日ごとに桃いろのカードも緑のカードもだんだんつぶされて、泥沼に変わるのでした。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――故郷の大通りの辻に、老舗の書店の軒に、土地の新聞を、日ごとに額面に挿んで掲げた。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――私は夜も寝られないまで、翌日の日を待ちあぐみ、日ごとにその新聞の前に立って読み耽った。",
              "citation": {
                "source": "小春の狐",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か御覚悟がおありなさるそうで、熟と辛抱をしてはござるが、怪しい事が重なるかして、お顔の色も、日ごとに悪い。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日ごとに、王子は、お姫さまが好きになりました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "日曜日ごとに、いつも、おとうさんといっしょに、この教会へ行っては、讃美歌をうたったものでした。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに又この頃は、日ごとに軍服｜厳めしい兵隊さんが帰省して来るというので、急に村の注意を惹き出した。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が勇しき船頭は、波打際の崖をたよりに、お浪という、その美しき恋女房と、愛らしき乳児を残して、日ごとに、件の門の前なる細路へ、衝とその後姿、相対える猛獣の間に突立つよと見れば、直ちに海原に潜るよう、砂山を下りて浜に出て、たちまち荒海を漕ぎ分けて、飛ぶ鴎よりなお高く、見果てぬ雲に隠るるので。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私、十九歳より二十三歳まで、四年間土曜日ごとに逢っていたが、私はいちども、まじわりをしなかった。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日以来、ナブ・アヘ・エリバ博士は、日ごと問題の図書館（それは、その後二百年にして地下に埋没し、更に二千三百年にして偶然発掘される運命をもつものであるが）に通って万巻の書に目をさらしつつ研鑽に耽った。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "時は日ごとに定まらねど、垣根に彳めば姉上の直ちに見えたまう。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡き人となりたまいて後は、わが寂しがるを慰めむとや、伯母上は快よく日ごとに出だしたまう。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ごとに行きたれば顔を見識れるなりき。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お午の夜店というのは午の日ごとに、道頓堀の朝日座の角から千日前の金刀比羅通りまでの南北の筋に出る夜店で、私はふたたび夜の蛾のようにこの世界にあこがれてしまったのです。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は一と六の日ごとに平野町に夜店が出る灯ともしころになると、そわそわとして、そして店を抜けだすのでした。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ごとに日ごとにわかき姿して日ごとに歌ふわが族よ、日ごとに紅き実の乳房日ごとにすてて漁りゆく。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "七八月の炎熱はかうして平原の到るところの街々に激しい流行病を仲介し、日ごとに夕焼の赤い反照を浴びせかけるのである。",
              "citation": {
                "source": "水郷柳河",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間余はエリスを忘れざりき、否、彼は日ごとに書を寄せしかばえ忘れざりき。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間、日ごとに斥候を遠く派して敵状を探ったのはもちろん、附近の山川地形を剰すところなく図に写しとって都へ報告しなければならなかった。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だって、日曜日ごとに会おうって、約束しちまうんですもの。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か思ひごとのある時のお父さんから、邪慳な口のきき方で叱られるといつも栄蔵は、情けない気がするのだつた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑ひごとぢやないよ。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も前後に構ひごとはねえだよ。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんていふ悲鳴（笑ひごとぢやなかつたわ！",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
