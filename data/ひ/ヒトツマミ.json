[
  {
    "uuid": "969a567e-64e0-594d-a782-53f8a3a933d4",
    "entry": "一撮み",
    "reading": {
      "primary": "ひとつまみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
