        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その試合は、我がチームにとってまさに一撮みだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は今回の昇進を、一撮みで手に入れたかのように振る舞っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "優勝候補と言われたチームが、意外にも一撮みで敗れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
