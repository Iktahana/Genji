        "examples": {
          "standard": [
            {
              "text": "その曲は発売後すぐにヒットチャートの1位に輝いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は最新のヒットチャートをいつもチェックしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若者たちは、ラジオから流れるヒットチャートの曲に熱狂した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この曲はたちまちヒットチャートをかけ上がり、翌年二月七日に彼らがケネディー空港に降り立ってからは、すさまじいビートルズフィーバーが巻き起こります。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "エルヴィスのこの歌はあまり評判にはならなかったが、テリー・スタッフォードがエルヴィスそっくりに歌ったシングル盤は、ヒット・チャートの第三位に登場するほどのヒットになった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼のロックンロールは、当時の白人社会にはあまり競争相手がいなかったため、たとえば『ディム・ディム・ザ・ライツ』のように、リズム・アンド・ブルースのヒット・チャートに登場できるほどの力を持ったのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
