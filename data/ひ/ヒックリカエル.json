[
  {
    "uuid": "1fa8aece-46f4-5bcc-bd6b-0649b00a8e88",
    "entry": "ひっくり返る",
    "reading": {
      "primary": "ひっくりかえる",
      "alternatives": [
        "ひっくりがえる"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
