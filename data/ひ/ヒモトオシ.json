          "literary": [
            {
              "text": "あるいは猿股の紐通し機械を売る婆さんは猿股へ紐を通しては引き出し、また通しては引き出している。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に猛進したが、如何も思はしくなく、却つて玄子の方が成功して、鍋形の側面に小なる紐通しのある大土器が、殆ど完全で出た。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "馬籠と根方",
                "note": "青空文庫"
              }
            },
            {
              "text": "「猿股の紐通し機械を売る婆さんは、猿股へ紐を通しては引出し、また通しては引出している。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "紐通しの穴金具は、これは靴屋で買っておく。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
