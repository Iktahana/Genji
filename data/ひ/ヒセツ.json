  {
    "uuid": "9ca4430c-2df0-5e9d-a393-91e8a3870266",
    "entry": "飛節",
    "reading": {
      "primary": "ひせつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hock",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その馬はレース中に飛節を負傷した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "獣医は、その馬の飛節を跛行の兆候がないか診察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "獣医は、飛節の回復を促すために馬に休息を勧めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "併し文字の上の文学がなくとも、頭に文学を活して行くことが出来たから、わりあひせつなく感じなかつたかも知れぬ。",
              "citation": {
                "source": "鵠が音",
                "author": "島の消息",
                "note": "青空文庫"
              }
            }
          ]
        }
