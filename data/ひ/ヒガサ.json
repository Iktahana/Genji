[
  {
    "uuid": "b3bf751e-bb22-5477-bd98-95ff89475e2a",
    "entry": "日傘",
    "reading": {
      "primary": "ひがさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
