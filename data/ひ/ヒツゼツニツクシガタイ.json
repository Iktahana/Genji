        "examples": {
          "standard": [
            {
              "text": "その光景は、あまりに美しくて筆舌に尽くしがたかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の苦しみは、筆舌に尽くしがたいものがあっただろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの感動を筆舌に尽くしがたいと思うのは、私だけではないはずだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "どんな情動と共にそのキュクロプス式巨石建造物の断片と――客観的現実性を以て――直接に接触したかは筆舌に尽くしがたい。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで倒れて死ぬのは、愛と家庭と、真に優しい妻が待っているのに、余りにもむごいし、筆舌に尽くしがたい。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
