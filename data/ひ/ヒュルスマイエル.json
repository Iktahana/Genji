        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのうちに彼は、次第に周圍の人たちの話から、父親が森の中で死んでいたのを伯父のフランツ・ゼムレルと、ヒュルスマイエルとに發見されて、その死骸がついさっき臺所まで運びこまれたことを會得した。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おっ母、ヒュルスマイエルは盜ったんだって。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ヒュルスマイエルが。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒュルスマイエルは、昔から村に住んでいる、ちゃんとした人だし、ユダヤ人はみんなわるい奴ばかりだからね。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒュルスマイエルが、こないだやって來て、そういってたよ、奴はまるで子鹿のようだって。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここでフランツ伯父きとヒュルスマイエルが、お前の親父が醉っぱらって、＊８告白もせず、終油もうけないで死んでいるところを見つけたんだ。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒュルスマイエルのとこへ使いに來た、叔父さんとこの豚番さ。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒュルスマイエルのおかみさんは、何をいってたんだい。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども唯一人、ヴィルム・ヒュルスマイエルという若者だけが、自分の力量と境遇のよさを自覺して、彼と張りあっていた。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、フリードリヒの競爭者のヴィルム・ヒュルスマイエルが叫んだ。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なるほどね、」と、ヒュルスマイエルはいった。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜はまだヒュルスマイエルのところで泊めてくれるだろう。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
