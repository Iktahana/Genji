        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "中学進学を前にした新島の長女は、もう勉強を押しつける学校で学ぶことはいやだと彼に訴え、イギリスにあるサマーヒルスクールという名の寄宿学校に行かせてくれるよう願い出たのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "長女が入学を希望したサマーヒルスクールの日本版を作る。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはアフリカ産毒蛇ブルヒルス。",
              "citation": {
                "source": "奇賊は支払う",
                "author": "烏啼天駆シリーズ・１",
                "note": "青空文庫"
              }
            },
            {
              "text": "水色美とハヒルスという魚を自慢にしている。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中、栄一も大分店に落ち付いて来たので『イエス伝研究史』と云つたやうなものを書かうと、サンデーや、ヒルスや、シユワイチエルなどの著作を朝々読んで居た。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ドクター・ヒルスを呼びにやりました。",
              "citation": {
                "source": "予謀殺人",
                "author": "A CASE OF PREMEDITATION",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
