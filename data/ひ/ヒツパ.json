        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから握手するか、ヒツパタクか、分つたものか。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナデ　バシヤヲ　ヒロツパヂユウ　ヒツパリマハス　コトモ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "バシヤハ　キリキリト、キシリナガラ　ヒツパラレテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンチヨウサンモ　セントウニ　タツテ、エンヤ　エンヤト　ヒツパリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "バシヤハ、キリクルト　ナリナガラ、カイドウヲ　ヒツパラレテ、イキマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハウプトマンが始めに『日出前』や『さびしき人々』を出し、後に『沈鐘』や『ヒツパ、タンツト』や『ハンネレ』を出したのもそれがためである。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヘルサン、私ノ足ニ綱ヲツケテ上ヘヒツパリアゲテ下サイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方ガナク、人参サンハ顔ヲマツカニシテ、半分ネムツテヰルジヤガイモサンノ手ヲウン、ウンヒツパツテ、一里モ先ニアル村ノ停車場ヘカケ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしらの所でヒツパクさへしてゐなければ、どうせあんなボロ家だもん、家賃なんか半歳一年溜めて呉れたつて、こんな事言やあしねえよ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
