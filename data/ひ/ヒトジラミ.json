    "definitions": [
      {
        "index": 1,
        "gloss": "Pediculus humanus (species of louse that infests humans)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "衛生状態が悪かった時代、子供たちの間では人虱が流行することがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "人虱の卵が髪の毛に付着しているのを見つけ、母親は専用の櫛で丁寧に梳いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "寄生虫学の講義で、人虱の生態とその感染経路について詳しく学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "さらにアメリカミイラ型はファーレンホルツの「辺縁型ヒトジラミ」すなわち日本人型の雑種とも違うことを述べるべきであろう。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒトジラミはたぶん比較的に最近の宿主でありヒトよりも発疹チフス病原体に罹りやすい。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしヒトジラミの場合には同じような理屈によって相互関係の成立は比較的に遅いと考えさせられる。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしヒトジラミがヒトからヒトにこの病気を伝播できるような状態では集団感染すなわち流行の原因となる。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラットからラットへはラットシラミやラットノミによって運ばれヒトからヒトへはヒトジラミによる。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
