[
  {
    "uuid": "b6c5390a-ba19-5b34-af09-c8f5fb751fed",
    "entry": "平目",
    "reading": {
      "primary": "ひらめ",
      "alternatives": [
        "ヒラメ"
      ],
      "is_heteronym": false
    },
    "grammar": {
