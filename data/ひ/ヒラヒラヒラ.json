          "literary": [
            {
              "text": "ヒラヒラヒラヒラと動いている。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その背中がムクムクと動き、パックリ口をあけたかと思うと、ヒラヒラヒラヒラと気を吐いた。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルグルグルと渦が巻く、ヒラヒラヒラと手が上がる、そのつどそいつが飛んで来る。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗さんだから山影さん、真っ黒の女がグルグルグル、手が上がってヒラヒラヒラ、そこでお仙ちゃんの尋ね人が、キリキリキリとブン廻る、な、解ったか、助太刀助太刀！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "両々全然盤上から手をひっこめず、ヒラヒラヒラと手と手がもつれて動くうちに、十何手かすゝんでいる。",
              "citation": {
                "source": "将棋の鬼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
