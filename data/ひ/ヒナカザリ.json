        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしてどの段の上にも、雛飾りがならんでいた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "雛飾りというものを僕はこのとき初めて見た。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいへんに立派な作りの雛飾りであることは、僕にもわかった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕を雛飾りの前まで連れて来た中年の女性が、姿を消していた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪洞を左右にしたがえ、赤い布を被った雛壇とともに、すべての雛飾りが僕を追いかけて来る、と僕は思った。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "雛飾りのある大きな部屋までいっても、舞子は見つからなかった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "雛飾りの続きのような、艶やかに美しい、大きく豊かな布団だった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
