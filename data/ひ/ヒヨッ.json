        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「このひとたち、みんな、あたくしの可愛いヒヨッコですのよ」　車の中でも女史は弟子たちと巫山戯あった。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人民主クラブはまだやっとヒヨッコのあゆみだし、新聞が特別な性質のものである上に用紙の制限その他の理由で一躍商業新聞と競争してゆけようとも思えない。",
              "citation": {
                "source": "その人の四年間",
                "author": "――婦人民主クラブの生い立ちと櫛田ふきさん――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヨッコも大きくなったでせう。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "サト子が相手にしたいと望んでいるのは、中年以上のやつらで、こんな年ごろのヒヨッコではないが、遊んでもらいたいというのなら、交際ってやれないこともない。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年来た時もたしかお前しめていた――この美しかもんを、云われるまでは気がつかんとたい……人間なんてなんとまあ……およね　ヒヨッとお母さんば思い出すと、なつかしうて、なつかしうて、すると、この帯のしめとうごとなつとです。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
