[
  {
    "uuid": "8d8aa822-bef8-57ec-b69f-d735a2934ac7",
    "entry": "久方ぶり",
    "reading": {
      "primary": "ひさかたぶり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "形容動詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "long time (since the last time)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "卒業以来、地元の友人と久方ぶりに再会し、夜遅くまで昔話に花を咲かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大きなプロジェクトがようやく一段落したので、久方ぶりに温泉で羽を伸ばしたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "久方ぶりに手にとった筆ペンは、思いのほか滑らかに紙の上を走った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」　私は久方ぶりに友達に逢ったようにこう思って、その一つを取り上げてみた。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、或る夏のこと、先年、私が鋳物師大島氏の家にいた時分、その家で心やすくなっていた牧光弘という鋳物師があって、久方ぶり私の仕事をしている処へ訪ねて来られた。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "石川光明氏と心安くなったはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、手前も久方ぶりに揚心流を存分用いて見とうござりますゆえ、お助勢お許し下されませ」「ならぬ」「なぜでござります」「退屈男の名前が廃るわ。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "久方ぶりにずい分斬った。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからってえわけじゃござんせんが、せっかくの非番びよりに、生きのいいわけえ者がつくねんととぐろを巻いていたって、だれもほめてくれるわけじゃござんせんから、ひとつどうですかね、久方ぶりに浅草へのすなんてえのもあだにおつな寸法だと思うんだが、御意に召しませんかね」「…………」「ちぇッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "久方ぶりに、だんなも荒療治をおやんなさいましたな」「あたりめえだ」　吐き出すようにつぶやくと、毒手にかかった女たちをあわれむように、黙々と目をとじました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっとまた忙しくなったようだから、久方ぶりに右門流の虫干しでも始めようぜ」　いいつつ、珍しや今宵はすっぽりと紫覆面に姿をかくして、黒羽二重の着流しにりゅうとしながら立ち上がりましたものでしたから、ことごとくおどり上がったのはあいきょう者です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "曲芸三人娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことに久方ぶりの対面というのほかはない。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "よいよい、信徒を荒し霊地を荒す鼠賊めを、霊地を預かり信徒を預かる院代が匿もうて、五万石の寺格が立つと申さるるならば、久方ぶりに篠崎流の軍学大出し致してつかわそうぞ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ながらのお手並、久方ぶりで存分に拝見致しまするでござります」「なにッ」「いえ、さ、早く御前様、お引き遊ばせと申しただけでござります。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿の表に麗々と触れ看板を掲げたからには、早乙女主水之介と知っているに不審は起らないが、昔ながらのお手並久方ぶりに拝見とは、いかにも不審でした。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "久方ぶりの退屈払いには先ず頃合いじゃ。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズウズウ国の端侍共ッ、直参旗本早乙女主水之介、ちと久方ぶりに退屈払いしてつかわすぞッ！",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "木枯が江戸の名物とすれば、それにも劣らぬ江戸名物の退屈男が久方ぶりに帰って来たのであるから、眉間の三日月傷でその顔を見知り越しの駕籠人足共が、わが駕籠に乗せているのを自慢顔に、しきりと景気よく怒鳴りながら走ったからとて不思議のないことでした。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "久方ぶりでござりますもの、さぞかしおなつかしゅうござりましょう」「………」「お！",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "久方ぶりに帰って来た大江戸の灯も、そろそろ始まりかけた退屈ゆえに、一向なつかしくもないもののごとく、軽いまどろみをつづけたままなのでした。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "久方ぶりでござりますもの、今宵だけはこのまま御屋敷へ御帰り遊ばしましたがいいではござりませぬか」「真平じゃ。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "京町、江戸町、揚屋町と、曲輪五丁町の隅から隅をぐるりと廻って、そうして久方ぶりに長割下水へ帰りついたのは、木枯に星のまばたく五ツ半……。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、久方ぶりに篠崎流の軍学小出しに致して、ゆっくり化物屋敷の正体見届けてつかわそうぞ。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "久方ぶりでの道場荒し、では思いのままに門人共を稽古台に致しまするでござります」　ほんのりと両頬に上気させて、莞爾と美しく笑みを残すと、「頼もう。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、上州藤岡の劇場で、乗り込みを両三日中に控え、ちょうど千秋楽の日であったが、儀右衛門はひさかたぶりに、法水の来訪をうけた。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生か死か、覆面探偵　帝都の暗黒界からは鬼神のように恐れられている警視庁の大江山捜査課長は、その朝ひさかたぶりの快い目覚めを迎えた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま、巨船クイーン・メリー号はひさかたぶりに、なつかしい海上にぽっかり浮かんでいる。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "師と門下生とが、ひさかたぶりに水いらずで向きあっているのであった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "足の下にふんだのは、ひさかたぶりの火星の大地であった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの大名の壺にも、供の侍がおおぜいいることだから、ひさかたぶりにおれも、この濡れ燕も、思うさまあばれられようというものだ。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶筅、匙、柄杓、羽箒などが手ぢかにならんで、忠相はひさかたぶりの珍客泰軒に茶の馳走をしているのだった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "逼塞をゆるされて、源七郎がひさかたぶりに屋敷の門をひらいた日のことである、まえぶれもなく、竹岡兵庫がおとずれて来た。",
              "citation": {
                "source": "青竹",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
