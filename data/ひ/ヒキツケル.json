[
  {
    "uuid": "87ae115a-384b-52c9-9ae0-225a84f0e67f",
    "entry": "引きつける",
    "reading": {
      "primary": "ひきつける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
