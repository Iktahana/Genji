        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "主人は箱根の大平台で雲助と格闘して、断崖の底で最後を遂げた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ等がすべて外側の四十六本の白大理石の円柱に支えられて、三段に畳み上げられた石のステュボラテス（平台）の上に載っかったところを、碧玉を溶かしたような南欧の空を背景にして眺めた景観はどんなに華麗なものであっただろう！",
              "citation": {
                "source": "パルテノン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一秒五〇〇〇こまの超高速度フィルムが竪台と平台とで二本ある。",
              "citation": {
                "source": "音楽界の迷信",
                "author": "兼常清佐",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそのダンプァーは柔かなフェルトで出来ていて、平台ピアノではその重さで上から絃を押えるだけの仕掛になっている。",
              "citation": {
                "source": "音楽界の迷信",
                "author": "兼常清佐",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ハ夜デヨカッタケレドモ、コレカラダト時間ガ時間ダカラ、必ズドコカデデモ隊ニ打ツカリマス、米国大使館ト国会議事堂ト南平台ヲ結ブ線ヲドコカデ横切ラナケレバナリマセン、ソノ積リデ早目ニオ出カケニナッテ下サイト、運転手ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
