        "examples": {
          "standard": [
            {
              "text": "仕事のストレスを解消するため、週末は市民プールでひと泳ぎしてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "太陽が高く昇る前に、誰もいない静かな海でひと泳ぎ楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "温泉に入る前に、広い露天風呂の端から端まで軽くひと泳ぎしてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この日の午後もひと泳ぎし、三時からは音楽室でブラスバンドの練習だった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからひと泳ぎなんて、いいんじゃないか」「え？",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと泳ぎして、頭を冷やしてから話そう」　この時間でも、グラウンドから校舎うらに出る階段を照らす街灯や、プールの芝生の水銀灯はついているので、充分に明るい。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "プールでひと泳ぎしたいのを我慢して、夜になるまで待っていたが、シュラー氏は暑気あたりでもしたのか、とうとう顔をみせなかった。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと泳ぎして疑ひをやり過せば、鼻風邪なんか安い資本ですぜ」「それで何うした」「その小僧は何も彼もしやべつてしまひましたよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お吉お雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと泳ぎして疑いをやり過せば、鼻風邪なんか安い資本ですぜ」「それでどうした」「その小僧は何もかもしゃべってしまいましたよ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お吉お雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "なに屈竟の若者が四人もいるんだからこちらは大丈夫さ」不安の兆　志津子が祖父の用を果して浜へ出ると、四人の青年は既にひと泳ぎした後らしく、大きな海岸傘の蔭へ寝転んでいた。",
              "citation": {
                "source": "海浜荘の殺人",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウースター・ソースにまみれたクリーム・チーズを食べるまえに、ボディ・ガードに守られてプールでひと泳ぎするなら、それは大統領の朝食と言ってもいい、と友人はさらに言いかえしていた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後のひと泳ぎは、裕一とならんで百メートルの競争だった。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "目覚めて西瓜を食べ、ひと泳ぎし、そのあと長い海岸を端から端まで、波のなかを歩いた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カルピスを一杯飲んで、レコードを一枚聞いたから、あとはひと泳ぎしましょう。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
