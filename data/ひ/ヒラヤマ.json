        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "駿介が家庭教師として通つてゐる平山家の息子達、駿介が教へてゐる子の兄である二人の大學生やその仲間達はまた少し變つてゐた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "平山の家では、週末には親達は靜養のために別莊へ行つて留守である。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "平山の家にはまた年頃の娘もゐて、彼女等は物見遊山の時など、駿介をも一緒に連れて行かうとした。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間から云はれてゐる平山の家の莫大な富が、どのやうにして築き上げられたものであるかを、駿介は知らない。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう少し色々考へて見たいとの君の手紙であつたから、私もそのつもりでゐたが、東京の平山から、つい此頃も、非常に喧しく言つて來た。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――前には岡島さんとのこともありましたし、私のわがままからでしたが、その時もお叱りなく平山さんにお世話をいただいたのに、今度また御迷惑をおかけするといふのは心苦しいことですが。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「平山の家が不愉快だからといふわけぢやないんだね？",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡島にも平山にもわしにも、君の十年の過去にもすべて反撥した。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が東京で平山の家に家庭教師として通つてゐた時のことだつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "平山の息子を中心とするグループが、その家に集つて、いつものやうに取り止めない雜談に興じてゐるのに逢つた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "場所は朝鮮の、しかも京城から二十里位しか隔たっていない山の中、というと、今時そんな所に虎が出て堪るものかと云って笑われそうだが、何しろ今から二十年程前迄は、京城といっても、その近郊東小門外の平山牧場の牛や馬がよく夜中にさらわれて行ったものだ。",
              "citation": {
                "source": "虎狩",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "好々爺と道づれ、平山部落まで、ありがたかつた。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "咲かない馬酔木の芽のうつくしさ平山から瀬尻へ。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀬尻平山橋、それから架設中の大和橋、渡船で、大井橋、そして西ノ渡（三味線が鳴りラヂオが叫ぶ！",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るにきのふの御用日の朝、月番｜跡部の東町奉行所へ立会に往くと、其前日十七日の夜東組同心｜平山助次郎と云ふものの密訴の事を聞せられた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」東組与力瀬田｜済之助、同小泉｜淵次郎の二人が連判に加はつてゐると云ふことは、平山の口上にもあつたのである。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "東町奉行所へ訴へた平山は、今月十五日に渡辺良左衛門が来て、十九日の手筈を話し、翌十六日に同志一同が集まつた席で、首領が方略を打ち明けたと云つたさうである。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのふの御用日にわざと落ち着いて、平常の事務を片附けて、それから平山の密訴した陰謀に対する処置を、堀と相談して別れた後、堀が吉田を呼んだやうに、跡部は東組与力の中で、あれかこれかと慥なものを選り抜いて、とう／＼荻野勘左衛門、同人倅四郎助、磯矢頼母の三人を呼び出した。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "平山が訴はいかにも実事とは信ぜられない。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "跡部は荻野等の話を聞いてから考へて見て、平山に今一度一大事を聞いた前後の事を精しく聞いて置けば好かつたと後悔した。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "をとつひの夜平山が来て、用人野々村次平に取り次いで貰つて、所謂一大事の訴をした時、跡部は急に思案して、突飛な手段を取つた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "尋常なら平山を留め置いて、陰謀を鎮圧する手段を取るべきであるのに、跡部はその決心が出来なかつた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し平山を留め置いたら、陰謀者が露顕を悟つて、急に事を挙げはすまいかと懼れ、さりとて平山を手放して此土地に置くのも心許ないと思つたのである。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで江戸で勘定奉行になつてゐる前任西町奉行矢部｜駿河守定謙に当てた私信を書いて、平山にそれを持たせて、急に江戸へ立たせたのである。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "平山はきのふ暁七つ時に、小者多助、雇人弥助を連れて大阪を立つた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀の手紙には何一つ前に平山が訴へたより以上の事実を書いては無い。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀬田、小泉が陰謀の与党だと云ふことは、既に平山が云つたので、荻野等三人に内命を下すにも、跡部は綿密な警戒をした。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして見れば、堀の手紙によつて得た所は、今まで平山一人の訴で聞いてゐた事が、更に吉見と云ふものの訴で繰り返されたと云ふに過ぎない。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るにその決心が跡部には出来て、前には腫物に障るやうにして平山を江戸へ立たせて置きながら、今は目前の瀬田、小泉に手を着けようとする。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
