        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「濃姫のヒキデモノだ」　道三は呟いた。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが最愛の娘濃姫を与える大悪党のヒキデモノであった。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちの一軒の女郎屋と馬肉屋を妹のムコと弟へヒキデモノにやって自分はワリをかせいだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく、やってくれた」　長者とヒメはオレに数々のヒキデモノをくれた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレにヒキデモノを与えた元日には、ヒメの言葉に長者まで蒼ざめてしまった。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
