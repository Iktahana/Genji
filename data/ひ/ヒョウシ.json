        "examples": {
          "standard": [
            {
              "text": "その人気俳優は、来月号のファッション雑誌の表紙を飾ることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女のファーストアルバムは、音楽雑誌の表紙を飾る快挙を成し遂げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「まさか自分が、あの有名なスポーツ雑誌の表紙に載るなんて、夢みたい！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
