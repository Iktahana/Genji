[
  {
    "uuid": "2ccd3fe5-ac74-5272-94c5-3a5ac0ace3df",
    "entry": "広",
    "reading": {
      "primary": "ひろし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
