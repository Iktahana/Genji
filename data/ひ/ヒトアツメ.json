        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しいイベントの成功には、効果的な人集めが不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "週末のデパートは、セールで大変な人集めだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "広場で行われたコンサートには、予想をはるかに超える人集めがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それから水夫を二百人集めておもらいなさい。",
              "citation": {
                "source": "黄金鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは、叔父さんにも相談したが、叔父さんは、いまはそんな人集めの出来る時代では無いと言っていた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「紐育生れの御婦人が一人して持つてらつしやる色々な美点は、故郷の女では三人四人集めなければ得られないからなんですよ。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "莫愁湖の畔にもの寂びた堂があり、そこでは付近の子供を二、三十人集めて寺子屋のような学校がひらかれていた。",
              "citation": {
                "source": "中支遊記",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "美作守の御勘定奉行｜九津見吉左衞門を初め九里平馬、戸村九右衞門、秋元九兵衞其の他御城下に加賀から九谷焼を開店した九谷正助、菊橋九郎左衞門、年寄役村方で九の字の附いた人を合せて十八人集めまして、結構な御馳走を致し、善い道具ばかり出して、頻りに自慢を致します事で、実に名器ばかりゆえ、客は頻りに誉めます。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぜひとも男を五百人、女を五百人集めてくれ。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "門を出ると、「八、關口の子分衆と、下つ引を五六人集めて、あのお妾姉妹と、奉公人達の身許をすつかり洗つてくれ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "彦徳の面",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれだけありゃ宜いでしょう、親分」「何人集めた」「丁度十人です」「お前を勘定に入れると千十人か」「ヘエ？",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "下つ引を五六人集めて、叶屋の奉公人の身許をみんな洗つてくれ」　平次もよく／＼手に餘つた樣子です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "門を出ると、「八、関口の子分衆と、下っ引を五六人集めて、あのお妾姉妹と、奉公人達の身許をすっかり洗ってくれ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "彦徳の面",
                "note": "青空文庫"
              }
            },
            {
              "text": "下つ引を六七人集めて、安宅の辨吉と小人の三次郎と、俵右門とを見張らせてくれ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "髷切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "下っ引を五六人集めて、叶屋の奉公人の身許をみんな洗ってくれ」　平次もよくよく手に余った様子です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "仏敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "下っ引を六七人集めて、安宅の弁吉と小人の三次郎と、俵右門とを見張らせてくれ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "髷切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "その開拓時代に、彼等は恭順を示さない土人達を、百二三十人集めて斬殺し、その死体を例の沼地へ投込んだと云う。",
              "citation": {
                "source": "殺生谷の鬼火",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、男座頭を八人集めて土俵へのぼせ、それをおくら一人に取組ませるのだ、一方はめくらだからめくらさがしだが、狭い土俵の上で八人の男、十六本の手、足ともでは三十二本でやられるのだから、いくらめくらさがしだってたまらない、ついにおくらがつかまって手取り、足取り……それは見ていられたものじゃない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずっと役に立ちまさあ」　マーシは渋ったが、しぶしぶ人集めに行った。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「よし、それじゃあ、なるべく大きい強そうな団員を六―七人集めよう。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく彼がそうしているうちにその六畳の間は、いつでも夜になると、労働者が五、六人集まっていないことはなくなった」　　　　　一二　藤原は熱心に語った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うの真砂町の原は、真中あたり、火定の済んだ跡のように、寂しく中空へ立つ火気を包んで、黒く輪になって人集り。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この流に人集ひ葱を洗へり。",
              "citation": {
                "source": "彌次行",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの橋の上には村のもの四五人集まっていて、欄に倚って何事をか語り何事をか笑い、何事をか歌っていた。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつの間にか子供らが麻ばたけの中や岸の砂原やあちこちから七八人集って来ました。",
              "citation": {
                "source": "革トランク",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると運動場には小さな子供らがもう七八人集まっていて、棒かくしをしていましたが、その子はまだ来ていませんでした。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "道傍に小供が五六人集まって何か悪戯をして居る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "愚人集牛乳喩愚人は客が来るまで日々の牛乳を搾らないで女牛の体内にためて置くつもりだった。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟子が三人集つて、馬のからだをすつかりふいた。",
              "citation": {
                "source": "北守将軍と三人兄弟の医者",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころ私は女難の戒めをまるで忘れたのではありませんが、何を申すにも山里のことですから、若い者が二三人集まればすぐ娘の評判でございます。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手は原っぱで人夫が二三人集って塵埃の山を焼いていた。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の垣根の外には近所の子供が二、三人集まって、声高に何か云っているが、その声が遠くのように聞える。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の句がうまく適度に混入しているために一巻に特殊な色彩の律動を示していることは疑いもないことであるが、ただもし凡兆型の人物ばかりが四人集まって連句を作ったとしたらその成績はどんなものであるかと想像してみれば、おのずから前述の所論を支持することになるであろうと思われるのである。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
