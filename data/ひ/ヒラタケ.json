        "examples": {
          "standard": [
            {
              "text": "スーパーで買ったひら茸を、今夜はバター醤油炒めにして食べよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ひら茸は香りがよく、汁物に入れると良い出汁が出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "秋の森で立派なひら茸の群生を見つけたが、鑑別には注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "光る菌類には黴類、黒穗菌類、木耳類、ひらたけ類、菌絲類、惡臭菌類等があつて、世界各國を通じて確かに知れてるのは約二十四五種らしい。",
              "citation": {
                "source": "光る生物",
                "author": "神田左京",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
