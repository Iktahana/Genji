[
  {
    "uuid": "dc2ea18f-efe5-5a6f-bb68-2cce4478b4c2",
    "entry": "火かき",
    "reading": {
      "primary": "ひかき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
