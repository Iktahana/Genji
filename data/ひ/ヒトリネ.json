[
  {
    "uuid": "c632141b-f603-591e-b18e-d64abd55a867",
    "entry": "一人寝",
    "reading": {
      "primary": "ひとりね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": "サ行変格",
