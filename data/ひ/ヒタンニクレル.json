        "examples": {
          "standard": [
            {
              "text": "事故で最愛の妻を亡くし、彼は何日も悲嘆に暮れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "努力の結晶である作品が火事で焼け落ち、彼女はただ悲嘆に暮れるしかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "悲嘆に暮れる遺族に対して、どのような言葉をかければよいのか分からなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "燕楽ホテルの自分の室で、じっと悲嘆に暮れるのでなければ、北京の市街を夜昼となく、紅玉を探して彷徨うのであった。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
