        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "見事、福引の特賞を引き当てて、海外旅行を獲得した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は宝くじで一等の賞金を引き当てた幸運な男だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "抽選会で、私は欲しかった景品を引き当てることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "――誰がその富籤を引き当てるか。",
              "citation": {
                "source": "盲腸",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "運の好い奴が麗人を引き当てる。",
              "citation": {
                "source": "ロマンスと縁談",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "配給物の抽籤のとき彼はいつも一等を引きあてるが、どういうものか、それがまた人人の笑いを波立てる。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十万は実はこの恋人｜誘拐の謝礼に引きあてるのだと、サービスぶりを発揮する。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
