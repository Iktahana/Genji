        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "火点しが暗闇を切り裂き、神殿へと続く道を照らしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "夜警の火点しが、街の石畳をぼんやりと照らしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、儀式の火点しとして、松明を掲げて厳かに歩みを進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
