[
  {
    "uuid": "d37d67bd-2047-564a-809a-d228bb731c63",
    "entry": "日待ち",
    "reading": {
      "primary": "ひまち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
