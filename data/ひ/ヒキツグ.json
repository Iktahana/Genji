      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to take over (someone's duties, business, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "前任の先輩の仕事をすべて引き継ぐことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会社の事業を息子に引き継ぐ準備をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は伝統工芸の技術を若い世代に引き継ぐことに情熱を注いでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "要するにＡＣＥがやりたいのは、ＧＵＩを備え、これまでメインフレームを中心に組み上げられてきた大規模なネットワークを引き継ぐ速い機械を作るという話だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "先夫に死なれて、尠からざる遺産とともにこのホテル商売を引き継ぐと間もなく、当時巴里とアントワアプの間をダイヤモンドを持って始終往ったり来たりしていた常客の一人と出来合って、結婚したのだった。",
              "citation": {
                "source": "ロウモン街の自殺ホテル",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣ―８８０１やＰＣ―８００１と互換性を持ったベーシックを備え、これまでのアプリケーションをより速く動かせるほか、周辺機器も従来のものを引き継ぐことができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンピューター事業の大原則から言えば、本筋はＰＣ―９８０１のソフトウエアをそのまま引き継ぐことのできる強化機種だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがパソピア16は、勢いを引き継ぐべき八ビットの遺産に乏しかった★。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして同年の十月、日本電気は互換ベーシックによって八ビットの勢いを引き継ぐＰＣ―９８０１の発表を行った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この世を承けて引き継ぐ者は柔和なる者なりとは、柔順なる人は永久にこの世の継続者である。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、そういう夢を引き継ぐのは、私には楽しいことだった。",
              "citation": {
                "source": "新妻の手記",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリスト教がローマの国の公認宗教になったときに過去の文化的遺産を引き継ぐことによって必要上から妥協せざるを得なくなった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "客は充分にいる、女手ひとつでもやっていけると説明されて、裕美子はその喫茶店を引き継ぐことにした。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの喫茶店を引き継ぐきっかけになった、昔の演出家との再会なんて、ほんとに珍しい偶然なのよ」　そこまで喋って裕美子はひと区切りとした。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はそこで親父の後を引き継ぐだけさ。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "心は、一つの知覚から他の知覚へ容易に無理なく進むので、ほとんど変更を知覚せず、しかも、始めの活気の相当な分け前を、次の活気へ引き継ぐのである。",
              "citation": {
                "source": "人間本性論（人性論）",
                "author": "A Treatise of Human Nature",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは大事件になりつつあって、強制送還が適用され、そのあとは外国警察があとを引き継ぐと、ほのめかした。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい相続人が、爵位と荘園を引き継ぐ」「新相続人に話を戻してくれてありがとう。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが証明されれば邸宅と爵位を引き継ぐ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "グレイスには編集長から引き継ぐよう頼まれたと言うよ」「とても正当なことではないようですね」「ああそうだよ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "大部隊に仕事を引き継ぐまでに塞がねばならない。",
              "citation": {
                "source": "見えざる力",
                "author": "THE INVISIBLE FORCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてここには、鎌倉の下知状によって、隠岐ノ判官清高が、帝のお身がらを引き継ぐため、大小幾十そうの船を艤して、早くから待っていた。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろのいきさつから私への点はからいと見えて、私の態度が私にはよくわからない理由でよろしくないという書きつけが出来上り、書類はひきつぐし一昨年七月頃一寸別のかかりの検事のひとと論判めいたことがあり、リストは消されず十二月となったわけです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀次は明日から私がこの店を引継ぐように親分さんへも御挨拶して来ました。",
              "citation": {
                "source": "骸骨の黒穂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃあ少しばかり僕がやって、後は君に引継ぐから、十分やりたまえ」　検事はそういってから、やおら三津子の方に顔を向けた。",
              "citation": {
                "source": "地獄の使者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうこうするうち、明治五年となって、いよいよ旧藩庁が新設石鐵県へ事務を引継ぐ事となり、従って私どもの学資も出所がなくなった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやじが内地のガタクリ自動車にやられるはずもないが、警視庁へ聞いてみたら、昨日は無事故だといっていた」「それはどうも」　自分がやられたら、名簿類は克巳へ、克巳がやられたら、孝助が保護して代表へ引継ぐ、という段取を考えていたが、誤算になった。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あたしが死ねば、すぐお後が引継ぐ。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "捨公方",
                "note": "青空文庫"
              }
            },
            {
              "text": "一生懸命になって模倣をして、ほどなくこれを弟妹に引継ぐので、彼等はいつまでも留学生の如き感受性を以て、古い古臭い遊戯を学ぶのであります。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくに嫁に世帯を引継ぐことを、今でも東日本では「杓子をわたす」、または「へらを渡す」とも謂っている。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "家に伝わる米の種にも系統があり、これを次の年の生産に引継ぐにも、収穫期以後の幾つかの儀式はあったようで、祭はすなわち田植の始め終りの、短い日数を以て完成することが出来ないものだった。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の足代ろを引継ぐ外は、自分の左足の親指一本が頼りだった。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとをいままた女房に死なれた自分が引継ぐのもなにかの縁かも知れないと末吉は思った。",
              "citation": {
                "source": "日日の麺麭",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
