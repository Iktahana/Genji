        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "担当者が変わるため、顧客情報を新しい担当者に引き継いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "次のシフトの人に、今日の出来事を正確に引き継いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のプロジェクトは、無事に後輩に引き継がれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
