[
  {
    "uuid": "a4973ffa-28f9-50d6-83cf-149f1b9e53ce",
    "entry": "引き継ぐ",
    "reading": {
      "primary": "ひきつぐ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ガ行",
