          "literary": [
            {
              "text": "医者が臓躁病、一名ヒステリアと呼んでいる御婦人向きの情緒があるが、そいつにやられると観念の錯倒をひきおこし、殊更、不利な言論をはき、心にもない危険な行為をする。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月九日、ジョゼフ・Ｒ・マッカーシーがウエスト・ヴァージニアのホイーリングで、赤狩ヒステリアを全米的なものにするきっかけをつくった演説をおこなった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
