        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "広っぱがあって、それからが、プカプカドンドンだ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "八丁堀のごみごみしているところとは違って、この広っぱならしずかだぜ」「ちえッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその広っぱの寒いこと、外套のなくなっていることを感じて、わめきはじめたが、とうていその声が広場の端までとどくはずはなかった。",
              "citation": {
                "source": "外套",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "農場の広っぱに国立出版所の赤い星で飾った売店があって、本や雑誌をうっている。",
              "citation": {
                "source": "今にわれらも",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おや、あの木立もない広っぱに、大分かたまって蠢いていますね。",
              "citation": {
                "source": "対話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっかり緑いろの顔色になった磯五が、小石川の金剛寺坂へ急いで、若松屋の屋敷のある坂の中途にさしかかったところに、そこに、草のはえている広っぱがあって、付近の人が加宮跡と呼んでいた。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは交番の横の工場のモーターが唸っているきりで、がらんとした広っぱ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る日私は又その広っぱを通りかかって、子供たちに例によって、英語演説をしたり、赤んべやお化けの真似をしていたが、後ろで噴き出す者があるので振り返って見ると、粗末な洋装した少女がバケツに鶏にやる餌か何か入れたのを持ってさも可笑しそうに立ち止っていた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日はそれきりだったが、その後のある日私はやはり同じ広っぱで子供たちとふざけて、子供たちがついて来るので逃げ出したが、子供たちは浄土寺の境内までついて来た。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "金曜日は、出かけにうすら寒かったので、ああやってお目にかかったときはコートを着ていたが、ずっと広っぱの水たまり道を歩いているうちにすっかり暖くなってしまって、鋪道へ出たら、街路樹の支柱へハンドバッグなどのせて、コートを脱ぎたたんで持ってかえりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二時間十ゾロチ50　○スタールイ・ゴーロド街　幅狭くなった間をぬけて行くと、いきなり四角い広っぱへ出る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その広っぱに面した建物の 〔fac,ade〕〔正面〕はすべていろんな色模様で染ってある、赤地に黄の唐草、藍に黒、紫に緑、金に水色等、その建物は窓小さくびっしりつまって四角い空間に支那茶の箱のように並び、計らずハルピン風茶店の娼家の前をぐるぐるタクシーでのり廻した夕方の印象が甦って来た。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供達の遊び場になって居る広っぱに面して建って居る家だから、別にどうと云う程の事もなさそうなものだけれ共、やっぱり有難迷惑な、聞きたくもない兄弟喧嘩の泣声をきかされたり、うっかり垣根｜際に寄る事も遠慮しなけりゃあならないしするから、裏が明いて居た内は家中の者がのうのうとして居た。",
              "citation": {
                "source": "二十三番地",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋を移すと云っても只オイソレとするのではなく、水排けがどう云う風になってるかの、光線の射入が完全に出来てなく風の強くあたる処はいけないのと云って、到々自分共の遊び場になって居る広っぱの隅に建てる事になった。",
              "citation": {
                "source": "二十三番地",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏の広っぱではギラギラ光る碧い空へ向って起重機の黒い動かない腕が突出てる。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "信吉が指さした広っぱの端れには、荷馬車からはなされた馬がいる。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になると、トラクターの置いてある村ソヴェトの下の広っぱに焚火がたかれた。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビリンスキー村のどの家の中でも、今夜は、この広っぱに時々気をとられる。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "広っぱの低い焚火のまわりに、五六人集まっていた。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子が同じ路を二時間ばかり前に来た時には、その荒れた広っぱのひとところで数十人の白服が列をつくって並んだり、分列したり、動いていた。",
              "citation": {
                "source": "築地河岸",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅の横手の広っぱに井戸がある。",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、広っぱに出る。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは、真暗闇の広っぱを、その狂人が躍り上り、躍り上って狂い走ります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "小名路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "秩父連山雄脈、武蔵アルプスが西方に高く聳えて、その背後に夕映の空が金色にかがやいている、それから東南へ山も森も関東の平野には今ぞ秋が酣である、弥之助のいる建物は武蔵野の西端の広っぱの一戸建の構えになっている。",
              "citation": {
                "source": "百姓弥之助の話",
                "author": "第一冊　植民地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その普通の広っぱを一層効果を出す為に無際涯に見せたまでなのだ。",
              "citation": {
                "source": "パノラマ島綺譚",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前には、今、説明を聞いたあとでも、この大平原がたった五六町の広っぱに過ぎないなどとは、どうしても信じられないことだろう。",
              "citation": {
                "source": "パノラマ島綺譚",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "この裏の広っぱへ子供達が集まって仕様がないのですよ」　家主が腹立たしくいった。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その見通しの広っぱを、たった二三十秒の間に、どうして逃げ去ることが出来たのであろう。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "お化人形　何段返しとか称する、余興舞台の前の広っぱには、数百人の群集が、この館専属の少女達の素足踊りを見上げていた。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "文代の指図で車の止った所は、月島海岸の見渡す限り人気もない、淋しい広っぱであった。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
