[
  {
    "uuid": "a499b8a0-77eb-59ab-b149-b7cb15498fff",
    "entry": "人まね",
    "reading": {
      "primary": "ひとまね",
      "alternatives": [
        "ひとマネ"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "mimicry",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "自分独自のスタイルを見つけるまでは、誰かの人まねでも構わない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "人まねばかりしているようでは、決して一流にはなれないよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "弟は兄のしゃべり方を人まねして、周囲を笑わせている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ただ二人の似ているのは人まねでないということと、根気のいいという点だけである。",
              "citation": {
                "source": "時事雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリジナリティの無いと称せらるる国の昔話に人まねを戒める説話の多いのも興味のあることである。",
              "citation": {
                "source": "時事雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから学者が国へかえって、じぶんのじっさい出あった話をしても、きっとそれは人まねだといってしまわれるでしょう。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは鰻が火を起こしたわけじゃないかと、予が笑えば、木綿子までが人まねに高笑いをする。",
              "citation": {
                "source": "水籠",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうことになるんだから、人まねもして質屋へも行くもんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "手塚は器用で頓知がある、人まねがじょうずで、活動の弁士の仮声はもっとも得意とするところであり、かつ毎月多くの雑誌を読んであらゆる流行語を知っている。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、じいさんの優しい顔は急にむずかしそうな顔つきに変わって、「なんでも人まねをしようとすると、そういう損をするもんだ。",
              "citation": {
                "source": "どこで笛吹く",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると彼等は、いつも私のすぐ傍まで来て、ちょうどあの猿の人まねと同じように、しきりに私の恰好をまねますが、いつも憎々しげな顔つきで、それをやるのでした。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「からすは、人まねをするというが、こいつにちがいない。",
              "citation": {
                "source": "からすの唄うたい",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の独創を見せたがり、人まねと思われまいという用心にひきずられる。",
              "citation": {
                "source": "埋もれた日本",
                "author": "――キリシタン渡来文化前後における日本の思想的情況――",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥山は住みよきものを世に出でて立ち舞ふ猿や何の人まね　私の和歌の師松浦辰男先生の高弟に三田弥吉（葆光氏の妹婿）という人があった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分一流のでたらめを言うのは、人まねで一つ覚えの真理を語るより、ほとんどましなくらいです。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一度歌壇賞をとれと気合を入れられていますが僕には力がないのでただうそと人まねでないもののみでがんばっています。",
              "citation": {
                "source": "遺愛集",
                "author": "島秋人",
                "note": "青空文庫"
              }
            },
            {
              "text": "……これはあとでわかったことなのだが、甚太夫の「うるるん」は人まねであった。",
              "citation": {
                "source": "思い違い物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人まね、二人まね、チラホラと仮面見物が人の眼を惹くころには、機敏な商人が「レビュー仮面」と銘うって、商標登録を申請し、同一型のセルロイド面をドッと売り出したものである。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
