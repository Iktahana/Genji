        "examples": {
          "standard": [
            {
              "text": "秋の野山で、薄紫色の小さな花を密生させた鵯花が風に揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鵯花はアサギマダラという蝶の好物で、吸蜜のために多くの蝶が集まってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鵯花の茎を折ってみると、キク科植物に特有の青臭い香りが漂った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "河原撫子、女郎花、鵯花、何やら升麻、車百合などの花が露重たげに頸垂れている。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
