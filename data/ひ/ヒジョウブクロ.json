        "examples": {
          "standard": [
            {
              "text": "地震の揺れが収まったあと、玄関に置いておいた非常袋を担いで避難所へ向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "災害に備え、家族それぞれの体格に合わせた重さの非常袋を用意している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "非常袋の中に入れておいた携帯ラジオが、電池切れで動かないことに気づいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ベッドの上の衣服と、その脇に吊しておいた非常袋を掴むが早いか、部屋をとびだして、街路を駈けだした。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、非常袋の中へ手を入れて、五千｜元の法幣を掴みだした。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常袋の中に私は忘れず太郎用の本一冊大人用の本一冊入れておこう、もしやけ出され野宿するときそんな本を朗読してきくような場合が決してないとは云えなかろう、そういう心くばりがこの一家における私の独自性であり芸術のありがたみでもあるわけだと思う。",
              "citation": {
                "source": "日記",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
