    "definitions": [
      {
        "index": 1,
        "gloss": "to pull open",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "重い引き戸を両手で力いっぱい引き開けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カーテンを勢いよく引き開けて、外の景色を眺めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は窓を引き開け、新鮮な空気を取り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」とホームズは鎧戸を引き開ける。",
              "citation": {
                "source": "患者兼同居人",
                "author": "THE RESIDENT PATIENT",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホームズが飛びついて引き開ける。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした桟敷の後の板戸を、そっと引き開けるものがあった。",
              "citation": {
                "source": "鬼眼鏡と鉄屑ぶとり",
                "author": "続旧聞日本橋・その三",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑いながらパンの横腹を妾の方に向けて、そこについている切口を、すこしばかり引き開けるとその奥にテニスのゴム毬ぐらいの銀色に光る球が見えた。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段を上がると廻廊で、突き当たりは杉の大戸、手を掛けて引き開けると灯火のない闇の部屋、そこを通って奥へ行く。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "茜さんが、もの怯じしたような眼付きで、キャラコさんを見あげながら、「キャラコさん、いったい、何が始まったんですの」　キャラコさんは、襖のところまで戻って行って、そこを一杯に引き開ける。",
              "citation": {
                "source": "キャラコさん",
                "author": "新しき出発",
                "note": "青空文庫"
              }
            },
            {
              "text": "返事なし）ええと――（仕方なく、板戸をソッと引き開ける音。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また誰か引っ張って来たのよ」　と呟やきながら入口の方へ行ってドアを引き開けると、よろけるように入って来たのは果せるかな件の怪人物と古市加十の両人。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "両の掌をピタリと股につけ、擦り足をして窓の方へ行き窓掛けを引き開けると恭々しく加十の前に進み、「お目覚めでございますか」　という。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "力をこめて引き開けると、外は、眼も眩むばかりに白い雪と朝の月影だった。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が扉をひきあけると中年の婦人が、彼の前に飛び出して来て、通り道をふさごうとした。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、壁がしっかりしているばかりか、ひきあけるにも、何の穴もなかった。",
              "citation": {
                "source": "時計屋敷の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから机博士は、反って危険を抜けることができ、うれしさに胸をおどらせながら、下り口のところにはまっている揚げ戸をひきあけることができた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、浅間の煙は時に激しく吹きあげ、夜の巡回の重い瞼を、その豪快な火柱が一瞬にひきあけることはあつても、いまだかつて、住民の気風のなかに、ことに青年たちの言動を通じて、特別に彼の期待にそむかぬというような美点を感じとることはできなかつた。",
              "citation": {
                "source": "この握りめし",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉をひきあけると思いがけない光景が展開した。",
              "citation": {
                "source": "黒い手帳",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その屍をふみこえて、ついで下男部屋の戸をガラリとひきあけると、そこには、部屋のかたすみに仲間の茂助が、歯の根もあわずガタガタとふるえています。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　受話器を耳に當てたソオルの顏は忽ち眞青になり、あたふたと自席を飛び出して警視室の扉を荒々しく引きあけると、今耳にしたばかりの驚くべき報告を傳へた。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子戸を引きあけると、下は坂の、二階ではないが、斜めに土塀。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は片手に脇差をぬき持って、片手で戸を引きあけると、第一の戸も第二の戸も仔細なしにするりと開いた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭に面した次の室の扉をウラスマルがいんぎんに引きあけると、其処から快い風のやうに這入つて来たのは、年の頃、二十位とも見ゆる小柄な――然し、均斉の好く取れた――一個の女性であつた。",
              "citation": {
                "source": "アリア人の孤独",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、奥深い一室の布被を引きあけると、そこには、白い羽毛の蒲団に被われた卑弥呼が、卑狗の大兄の腕の中で眠っていた。",
              "citation": {
                "source": "日輪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これぞ天の助くるところと、甚内は突嗟に思案を決めると、パッと雨戸へ飛びかかり、引きあける間ももどかしく家内へはいって戸を立てた。",
              "citation": {
                "source": "三甚内",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "跫音が廊下を走ってきて、やにわにふすまを引きあける者があるので、振りかえってみると、どうだ！",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　戸を引きあける――とたんに、ゴウッ――と露路を渡る吹雪風。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と栄三郎、手を乾雲の柄に油障子を引きあけると……いたずらに躍る白羽落花の舞い。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガタガタガタンと、あわてて扉を引きあける音がして、とたんにヒイヒイと獣が泣くような気味の悪い声が近づいて来た。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "折々誰かゞ小便に立つとて土間の障子を引きあけると、捩ぢ切る様な霧がむく／＼とこの一座の上を襲うて来た。",
              "citation": {
                "source": "木枯紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして馬車の窓を引きあけると同時に、叫びました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨戸引きあけると、何ものか影の如く走せ去った。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、あちらこちらと部屋中をかき廻して、その最後が戸棚を引きあけると、その中をがらがらひっかき廻し、そうして見つけ出したのが、多分、西洋酒の一リットル入りばかりの小壜であります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
