        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ガードレールがひん曲がるほどの衝撃だったが、運転手は無事だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古びたアパートのドアは、建付けが悪くなってひん曲がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「見て、このスプーン、超能力じゃなくて力ずくでひん曲がっちゃった」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」「母上のことをあげつらうのはよせ、そちの幼少の折から眼をかけてつかわされた母上のことをあれこれと申すと、口もひんまがるぞ。",
              "citation": {
                "source": "野に臥す者",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔い声が少しでもここから洩れて来ると、どこの炉端の鼻もすぐその方へひん曲る。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "タングステンがなければ、すぐひん曲る大砲しか出来ない。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
