        "examples": {
          "standard": [
            {
              "text": "定年退職を機に、彼は人里離れた山小屋での一人住まいを始めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "一人住まいを始めてから、栄養バランスを考えた自炊を続けるのが意外と大変だと気づいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "娘が就職して家を出ていき、広すぎる一軒家で急に一人住まいになって戸惑っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "おとこの児の一人住まいなので作爺さんがいろいろ眼をかけてやると、ませた口をきくおもしろい子。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたに運が味方したのは私がロンドンでまあ一人住まいして偽名を使っていたからだ。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
