        "examples": {
          "standard": [
            {
              "text": "観覧車はゆっくりと左回りで上昇し、街の景色が一望できた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この遊園地のメリーゴーランドは、珍しく左回りになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あれ、この交差点は左回りに進むのが正解なの？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "また、「あなたは甚句おどりは御好きか御嫌いか、御好きならば左回りを御願い申します」といえば、好きなれば回転し、嫌いなれば依然たり。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "また「あなたは甚句おどりは御好きか御嫌いか、御好きならば左回りを御願い申します」といえば、好きなれば回転し、嫌いなれば依然たり。",
              "citation": {
                "source": "妖怪玄談",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "その三つまたを街灯の電球へおしつけ、竿を左まわりにねじると、電球がソケットからすこし抜けてもどるため、あかりが消える仕掛だった。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の左まわり右へは、さき頃のラジオ討論会、「宗教と科学は両立するか」の時の話し方で聴取者の腹の底までしみ渡りました。",
              "citation": {
                "source": "新しい抵抗について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「左まわりのカーブで、ブラインドなのに、おまえ、トラックに追いこしかけたんだ」「しませんよ、そんなこと」「まあいいから、オニオンを食え。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "左まわりのカーブに入るとき、ミーヨは、ギア・チェンジで横着をした。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
