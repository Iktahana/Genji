[
  {
    "uuid": "e40fb275-36d1-5c1f-9269-e6343646b17d",
    "entry": "ひぼ",
    "reading": {
      "primary": "ひぼ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして、そのうちにたった一つ、中がからになって、ひぼしになっているひょうたんがありました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "男ども密にいふなり「いひぼしてもてる」とや。",
              "citation": {
                "source": "土佐日記",
                "author": "紀貫之",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三日、六兵衞はひぼしにして、腹をきれいに干して、いっぺん狐汁でもしてみんなで食おうじゃないか。",
              "citation": {
                "source": "狐物語",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひぼしにならなかつたと云ふだけね……」　富岡は釘をさしこまれた気がして黙つて、ゆき子の顔を見た。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このままでいれば、ひぼしになるか、病気になるかして、白骨と化してしまうであろう。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そのわけは、お前がいなければわしは、地底戦車の中で、腹ぺこの揚句、ひぼしになって死んでしまったことだろう。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何い作法だ、おら餓鬼の時から坑夫になって、今日まで作法を知らねえなんて、ひぼをつけられたこたあねえんだ、うぬが作法を知らねえんだ」「よし、お前がそう言うなら、俺もこんだ高田の坑内を黙って歩いてやるからそう思え」「なにをっ、うぬらの雁首で歩けるものなら歩いてみろっ」と萩野は又一歩踏み出した。",
              "citation": {
                "source": "恨なき殺人",
                "author": "宮嶋資夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨又、あめのひぼこの齎した八種の神宝を惜しみ護つた出石人の妣が国は、新羅ではなくて、南方支那であつたことは、今では、討論が終結した。",
              "citation": {
                "source": "妣が国へ・常世へ",
                "author": "異郷意識の起伏",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つことが二つに分れたと見えるあめのひぼこ・つぬがのあらしとの話を比べて見ると、其辺の事情は、はつきりと心にうつる。",
              "citation": {
                "source": "妣が国へ・常世へ",
                "author": "異郷意識の起伏",
                "note": "青空文庫"
              }
            },
            {
              "text": "あめのひぼこは、朝鮮からやつて来た神だが、やはり卵の話に関聯して居る。",
              "citation": {
                "source": "霊魂の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして置けば、貴様たちは、一月とたたない中に、ひぼしになって死んでしまうぞ。",
              "citation": {
                "source": "犬と笛",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「候人」を音読もし、又「さむらひぼふし」とも言つた。",
              "citation": {
                "source": "春日若宮御祭の研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とインディアンは門を出ながらいった、「おれたちをひぼしにするつもりか？",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "文子を手もとにをきたかつたこの老ひぼれのかよはい希ひを、神も亦憎み給ふであらうか。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私のやうな老ひぼれが、時々ここへ遊びにきても、あなたは我慢して下さるかね」と、左門は生き生きとサチ子に言つた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「委員がまだ置かれない前、あの人一人きりで監督してゐました頃には、私たちをひぼしにいたしました。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな奴等あ、一日も早く放り出してしまわないと、フー公、今にお前達ぁひぼしになるよ。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしひぼしになるんだったら、みんな一緒になったらいいんだわ。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなことをいってりゃ、わたしたちゃ四人とも、ひぼしになって、死んじまうじゃないか。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "人込みのなかに揉まれつつ君とともに身搾らしく歩みたる時と既に人の世の父たることを思ひぼんやりとまなこ潤みいくたび寂しげにその包みを抱き換へしことぞ。",
              "citation": {
                "source": "忘春詩集",
                "author": "忘春詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "井手の蛙のひぼし哉とも評せられた、いわゆる角大師の像なども、中央では元三大師、良源という名僧の肖像の如く言われたが、奥羽の北端と北九州の一部とでは、これが霜月三夜の神であるが如く、思っていた者が多かったのである。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "落首は、ご新政をひぼうするものとして、検非違使ノ役人が見つけしだい取り払って捨て、また下手人は仮借なく挙げてもいたが、なお三条、七条河原などに、夜陰、落首をたてて世を皮肉る者がたえなかった。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
