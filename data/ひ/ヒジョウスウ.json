        "examples": {
          "standard": [
            {
              "text": "算数の時間に、被乗数の桁数が増えた時の計算のコツを教わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "コンピュータのレジスタに被乗数を読み込み、乗算処理を開始する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "複雑な数式の中で、どれが被乗数に当たるのかを慎重に特定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかるに被乗数を見ると、やはり三桁であり、百位の数字は９である。",
              "citation": {
                "source": "虫喰い算大会",
                "author": "佐野昌一",
                "note": "青空文庫"
              }
            },
            {
              "text": "９７□×　　　１８――――――　　□□□０　　９７□――――――　１７５□０　第二の手懸りは、乗数の一位の８を、被乗数の一位の□に掛けると、その答の一位は、８の字の下にあるとおり０となるのだ。",
              "citation": {
                "source": "虫喰い算大会",
                "author": "佐野昌一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで被乗数の一位の□は、５であらねばならぬと決定する。",
              "citation": {
                "source": "虫喰い算大会",
                "author": "佐野昌一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
