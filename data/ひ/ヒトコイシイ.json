[
  {
    "uuid": "6bab6b67-13f2-593d-87e0-e944dfb0ddd9",
    "entry": "人恋しい",
    "reading": {
      "primary": "ひとこいしい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
