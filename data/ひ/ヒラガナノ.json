          "literary": [
            {
              "text": "一、ヒラガナノ活字ハソレ自身ガ美シクナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナノ活字ガイカニ醜イカトイウコトハ初号クライノ活字ヲ見タラダレニモワカルダロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユエニ楷書ノ活字トヒラガナノ活字モマタ調和シナイノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来、ヒラガナノ構成単位ハ曲線デアリ、楷書トカタカナノ構成単位ハ直線デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナノ好キナ人、ヒラガナヲ捨テ切レヌ人ハ好キナダケヒラガナヲ書ケバヨイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            }
          ]
        }
