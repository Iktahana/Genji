        "examples": {
          "standard": [
            {
              "text": "小さな写真を大きく引き伸ばし、額に入れて飾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の家族写真の引き伸ばしを頼むために写真店に行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このイラストは、A3サイズに引き伸ばししても綺麗に見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
