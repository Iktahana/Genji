        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "殊にもこの髭男の場面は、ひどいと思った。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しそうな顔になって髭男は泣き出した。",
              "citation": {
                "source": "源氏物語",
                "author": "椎が本",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い時でさえそれでございましたから、今日になりましてはましてどこを頼みにして行く所がございましょう」　こんな話をするので、ますますみじめに見える髭男であった。",
              "citation": {
                "source": "源氏物語",
                "author": "椎が本",
                "note": "青空文庫"
              }
            },
            {
              "text": "見苦しいことであると薫は思ったのであるが、髭男を取り次ぎにして命じることだけを伝えさせた。",
              "citation": {
                "source": "源氏物語",
                "author": "椎が本",
                "note": "青空文庫"
              }
            },
            {
              "text": "薫は中の君の出京について心得ておくことを女房たちに言い、山荘の留守居にあの髭男の侍などが残るであろうことを思って、ここに近い領地の支配をする者を呼び寄せて、今後もここへそれらの人の生活に不足せぬほどの物を届けさせる用も命じた。",
              "citation": {
                "source": "源氏物語",
                "author": "早蕨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして人々は、この髭男の感傷に対して、一様に真面目な好感を抱く様になって来たんです。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりこの僕がネ」　髭男はニヤリと笑った。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "永く手錠をかけられていることは貴下の大不利ですからネ」といって髭男はジロリと青谷の顔を見た。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すると貴下は一体誰ですか」「僕ですか」と髭男が云った。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは赤い大きいドタ靴が、ビール樽のような恰好のシルクハットに金鎖の髭男を踏まえようとしている絵であった。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その大看板が車よせの庇の上で、うららかな冬日を満面にうけているところは、粗野だが真情のある大きな髭男がよろこび笑っているような印象を与えた。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て、戟を横へて、洛陽に源氏の白旄軍を破れる往年の髭男も、一朝にして、紅顔涅歯、徒に巾幗の姿を弄ぶ三月雛となり了ンぬ。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "全ての質問に対し、青年は丁寧に当たり障りなく、例の嗄れた囁き声で、アレン博士は過去の魂と巧みに交信しているらしく、この髭男が文通しているプラハ在住の相手も同様の霊能力を持っているのだろうと答えるだけだった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者の髭男でなかったことだけは断定しても差支はあるまい。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈や両膝抱て髭男　　　　散木　炭竈を守るためであろう、ぼうぼう髭を生した男が、両膝を抱いてそこにいる、というのである。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "炭竈の髭男はもともとそこに一人しかいない役者であろうが、これは鷹野における人数の中から、特に若衆役を持出した点に一種の技巧がある。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "勤務時間中は一意精励マイシンしている鼻ヒゲ男が昨日に限って二時ごろから七時までヒルネをしていたのは奇妙だが、ほんとにヒルネしていたのかしら。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            },
            {
              "text": "初老の鼻ヒゲ男は疑いもなくその時間には大イビキでねむっていた、と。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
