          "literary": [
            {
              "text": "ヒイーッ」　と豚吉は死ぬような声を出し初めました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と引き続いてヒイーッという人間の悲鳴が聞こえて来た。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、ヒイーッ、ヒイーッとすすり泣きが聞こえてきた。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒイーッと足もと近くにひとりすすり泣くもあり、遠く離れたところで数人寄り合っても泣いている。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒイーッ、ヒイーッ、すすり泣きはふたたび足もといちめんに起こった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "――どッと、孫兵衛の狂気じみた影が、十数｜間も先へ駆けぬけてから、うしろにあたって、今さらのように、ヒイーッとたまげる声がして、歓楽の人渦はぶっ掛けられたような血を見てさわぎあっていた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷底へでも突き落とされたような悲鳴が、ヒイーッと山の静寂を破った。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
