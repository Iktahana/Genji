        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あんな簡単な計算も間違えるなんて、本当にお前は表六玉だな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "せっかくのチャンスを台無しにするなんて、あの表六玉には呆れてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は愛すべき表六玉で、失敗ばかりしているがどこか憎めない男だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "いま思うと如何にもひょうろくだまな顔つきをしていた。",
              "citation": {
                "source": "安い頭",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの人は軽薄で、嘘つきで、浮気者で、信用のない兵六玉よ。",
              "citation": {
                "source": "華々しき一族",
                "author": "森本薫",
                "note": "青空文庫"
              }
            },
            {
              "text": "むっとした顔で、石田氏がひっこみかけると、後ろから、「兵六玉ァ」という痛快な声がかかった。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "――大馬鹿、阿呆、抜作、唐変木、兵六玉、低能……）　あらゆる言葉で、自分を罵倒した。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
