          "standard": [],
          "literary": [
            {
              "text": "――火食鳥の卵が好きだつてさ。",
              "citation": {
                "source": "夏の夜",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "――今に、南洋産火食鳥の卵の新鮮なのがありますと、銀座あたりで賣出すかも知れない。",
              "citation": {
                "source": "夏の夜",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、それに見向きもしない大鷲は、しずかに、宙へ舞いあがって、しばらく旋回していたが、やがて、ただ見る、一｜条の流星か、焔をくわえた火食鳥のごとく、松明の光をのせて、暗夜の空を一｜文字にかけり、いまや三｜角戦のまっ最中である人穴城の真上まで飛んできた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
