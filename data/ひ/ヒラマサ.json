        "examples": {
          "standard": [
            {
              "text": "釣り上げたばかりの平政を刺身にすると、コリコリとした歯ごたえがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "平政はブリによく似ているが、体側の黄色いラインがより鮮明だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "高級魚として知られる平政の塩焼きは、上品な脂が乗っていて絶品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "尼将軍になった平政子なども、そんなにして育て上げられたのである。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月から翌年の二月へかけて、伊豆方面のブリ、ブダイ、イズスミ、クシロなぞの竿釣が行われ、初夏にはクロダイ、夏にはメイジダイ、ヒラマサ、秋も略同様なものが、三間から四五間の長竿で釣れるのであるから、近代の釣人がその強引にあこがれて、遠く出釣するのも無理はない。",
              "citation": {
                "source": "荒磯の興味",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            }
          ]
        }
