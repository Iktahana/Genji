    "definitions": [
      {
        "index": 1,
        "gloss": "to stay indoors",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
