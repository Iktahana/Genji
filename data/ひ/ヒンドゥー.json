        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は熱心なヒンドゥーとして、毎日聖なる河で身を清めることを欠かさない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "複雑な神体系を持つヒンドゥーの神話は、多くの芸術家にインスピレーションを与えてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "旅先で偶然出会ったヒンドゥーの巡礼者と、束の間の交流を楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その階級の差別は極めてやかましく、たとえば、草ぶき小舎にすんでいるヒンドゥースの娘スンダーリは、自分の飲む水を、上の階級ブラマンのものたちが水を汲む泉から決して汲んではいけない。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "少数の神話は、人類以前の世界に関する他の朦朧たる伝説群、殊に、茫然とするような時間の深淵にまつわり現代の神智論者の教えの一部を成しているヒンドゥーの物語との間に重要な関連を持っていた。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "折りに触れてギルマンは無機物をプリズム、迷路、立方体と平面のクラスタ、キュクロプス式の建物になぞらえ、有機体からは、泡や鮹や百足やヒンドゥーの生ける偶像や蛇の如く縺れあうアラベスク模様の集合体という印象を受けた。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの森と下生えの中にヒンドゥー寺院風の神殿が無数にあった。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "「少なくとも一つは、ヒンドゥーめいていない像もあるのね。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "この後のすべてのヒンドゥーの書物は古い先生たちの後を追っており、オリジナルな業績の解説書であることで満足し、これらを新しい経験で完全にし改良していて、理論的な基礎や古代の形態に少しも手を入れようとしていない。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "男はヒンドゥー教徒で、痩せこけて弱々しく、剃髪しており、虚ろでしょぼついた目をしていた。",
              "citation": {
                "source": "絞首刑",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "カバレット・トアズンドルの舞台では、ターバンを巻いた印度人が、細腰のヒンズー女を抱いて、宗教的な怪奇な踊りを舞っていました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダの声音は印度の夜の国境、ヒンズークシ山脈の下をアフガニスタンに向って疾走する急行列車にもまして叡智がひらめくのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは新嘉坡の市中で、芭蕉の葉で入口を飾り、その上へ極端な性的の表象を翳しているヒンズー教の寺院を見た。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘はモデレートな夏の洋装をしているのだが、それは皮膚を覆う一重のものであって、中身はこの回教の寺院の中に置けば、この雰囲気に相応わしく、ヒンズー教の精力的な寺院の空気にも相応わしかった。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "北にパミール高原、西南にはヒンズークシ、南東にはカラコルム。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "慓悍無双といわれるヘタン人の人夫をそろえ、いよいよヒンズークシの嶮を越え「パミールの管」といわれる、英ソの緩衝地帯を「大地軸孔」へ進んだのである。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒンズー教を信ずる諸村で猴を害する事なし。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ラーマーヤナ』は誰も知った通りヒンズー教の二大長賦の一つで、ハヌマン猴王実にその骨髄というべき活動を現わす。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治二十六年予、故サー・ウォラストン・フランクス（『大英百科全書』十一版十一巻に伝あり）を助けて大英博物館の仏像整理中、本邦祀るところの庚申青面金剛像に必ず三猿を副える由話すと、氏はそれはヒンズー教のハヌマン崇拝の転入だろうと言われた。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代相承していわく、これ大天（ヒンズー教のシワ大神）の部属で、性三宝を愛し、五衆を護持し、損耗なからしむ。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "クベラすなわち毘沙門で、ヒンズー教の説に梵天王の子プラスチアの子たり、父を見棄て梵天王に帰した。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒンズー教仏教ともにこの神を北方の守護神とし、支那には古く子は北方でその獣は鼠としたるに融合して、インド以北の国で始めて鼠をクベラすなわち毘沙門の使い物としたのだ。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「知らない」「ヒンズー語みたいね。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒンズーに凝っている人が、友だちにいるのよ」「日本語だ」「そうなの」「おじいさんが口ぐせのように言っていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "四谷見附橋のところで民族衣装をまとったインド人の女性から輪廻転生を解いたヒンズー教布教のためのパンフレットを買ってほしいと言い寄られたが、浩はウォークマンを聞きながらそのせいで聞こえないふりをしてやり過ごし、上智大学の｜Ｈ・Ｈの部室に向かう。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "時がたち、白人とはほとんどつきあわず、ヒンズー行者とか、尊者とかの類と仲間になり、奴らの秘儀を学びました。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏教にも水で汚れを洗うということがあり、ヒンズー教ではインダス河に飛び込んで体を洗うことが重大な儀式となっている。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "セム人、ハム人、モンゴル人と同じように、生まれながらの天分はギリシャより悪くはなかったが、知的なインパルスはアーリアン・ヒンズー人種には不足していた。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "この言葉の語根（ペルシャ語でムイシ、ヒンドゥ語でムサやムシ、パーリ語でムシコ）はマウスが古代に世界全体で知られていたことを示している。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
