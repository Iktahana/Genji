          "literary": [
            {
              "text": "ひくりと口尻を動かして微笑んだ。",
              "citation": {
                "source": "熊の出る開墾地",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その口を開いたままの咽喉がひくりひくりと動き出し、やがてぐるぐると上下したと思うと、遠い凩に似た声が、氏の全身の力を絞って戦き出た。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあ、しっかりやってくれたまえよ、石井さんも行くんだ、よろしく頼むよ」「はあ、あの……」「はっは」　木曾は、笑った自分の頬が、ひくりと痙攣したのであわてて立上った。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
