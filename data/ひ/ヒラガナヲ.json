        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ガココニ書イテオキタイコトハ、日本ノ活字カラヒラガナヲナクシタホウガヨイトイウ私見デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在ノ活字ハ、ソノ美シクナイヒラガナヲソノママ活字ニ移シタモノデ、活字ニ必要ナ様式化サエ行ワレテイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ理由ハマダ自分デモハツキリワカラナイガ、オソラクヒラガナヲ構成スル線ガアマリニ不規則ナタメ、一定ノ法則ニ従ツテ様式化スルコトガ困難ナセイダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、カタカナハヒラガナヲ書ク場合ニ比シテ、オソラク半分ノ労力デスム。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "七、活字ノヒラガナヲ廃止シテモ文化的ニ何ラノ損失モナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナノ好キナ人、ヒラガナヲ捨テ切レヌ人ハ好キナダケヒラガナヲ書ケバヨイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
