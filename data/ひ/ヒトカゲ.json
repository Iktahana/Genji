        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "火蜥蜴（ひとかげ）の絵が描かれた古い本を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "雨上がりの庭で、小さな火蜥蜴（ひとかげ）が顔を出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "童話の世界では、火蜥蜴（ひとかげ）が不思議な力を持つ生き物として描かれることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ひらいたドアのむこうにも、ひとかげはありません。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
