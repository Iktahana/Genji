        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「どうだい、あの猿の夫婦は……」とフォン・コーレンは眼をつぶってマントにくるまりながら始めた、「ええ君、あの女は食うや食わずの人間がいる以上、甲虫や瓢虫にはかまっちゃおれんそうだ。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ瓢虫といふのがある。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓢虫は大変きれいだ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "放つておけば、一寸の間に世界中に蔓るかもしれない此の木虱を、あの金色の眼の蜻蛉や、小さい瓢虫や、いろんな雛鳥が食ひ尽してしまへようか。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それどころか、甲虫だのお天道虫だのに一所懸命になってる人の気が知れないわ。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「天道虫が問題なんじゃないよ。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "天道虫もいたし、青葉の裏には、青蛙の子もはりついていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "胡麻粒ほどな天道虫にでも、神の意志があると信じている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
