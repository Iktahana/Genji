        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして「失礼でございませうが、私は日本の酒は飲めないんで……」と言つて、「イヒヽヽヽ」と追従笑ひをした。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、云って、ヒヽヽヽヽと笑った。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからブドウ酒の壜を取りあげて、彼の口へ向けると、彼はヒヽヽヽヽと嗤ふが如き陰気な声をあげて大きな口腔を天井へ向けてあんぐりと開いた。",
              "citation": {
                "source": "夜見の巻",
                "author": "「吾が昆虫採集記」の一節",
                "note": "青空文庫"
              }
            },
            {
              "text": "親爺は牙をむきだして、ヒヽヽヽと笑ふ。",
              "citation": {
                "source": "古都",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、親爺は酒をのむ僕を見あげて、ヒヽヽヽと笑つた。",
              "citation": {
                "source": "古都",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒッヒヽヽヽヽヽ」　と青年詩人は何とも言えない奇怪な笑声を発した。",
              "citation": {
                "source": "朝起の人達",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは学生時代からの痼疾だから、もう快癒の見込はありません」　と国手は喝破して、「ヒッヒヽヽヽ、何うだい？",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
