    "definitions": [
      {
        "index": 1,
        "gloss": "having strings attached (of a loan, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その援助はひも付きで、使途が厳しく制限されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "無償の申し出かと思ったら、実はひも付きだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はひも付きの条件を嫌い、その提案を断った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三　まつりの語原今までのところでは、まつりの語原が、あまり説き散されて、よしあしの見さかひもつきかねる程になつてゐる。",
              "citation": {
                "source": "村々の祭り",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まア待ちねえ」と辰つアんは受けて、いが栗頭をぬつと周三の方へ突き出し、「お前さんといふ男が喰つついてるんで、おかみが文句をいやがるんだよ、ひもつきには懲々してるといやがるんだ。",
              "citation": {
                "source": "天國の記録",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからひもつきは大嫌ひさ！",
              "citation": {
                "source": "天國の記録",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "飾りひもつきの肩章がある、ぴっちりした軍服だ。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "having a string or cord attached (of a bag, clothing, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
