    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "）より始めよ〉式のマイコン勉強会は、来年度から部課長クラスにも実施させることにしており、マイコン操縦法をマスターし、プログラムまで組めることは、これからの日電マンの必須の条件となりそうだ」　一九八〇（昭和五十五）年十二月九日付けの日本経済新聞は「マイコン革命、まず幹部から」と題して右のように報じた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "６　一九七二（昭和四十七）年四月一日付け辞令。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七三（昭和四十八）年一月二十四日付け辞令。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月二十日付けの毎日新聞は、「中国研究の新島教授／突然の転身／早大を去り『山岸会』へ」の見出しで彼の決意をこう伝えている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九八二（昭和五十七）年の暮れぎりぎりまでマイクロソフトで作業を続けた山下は、十二月三十一日にシアトル空港発の飛行機に乗り、成田に降り立った翌年の一月一日付けで、社名をアスキーに変更したばかりの西の会社に入った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして十二月十二日付けの手紙で、彼らは資料を添えて一まず開発作業を完了したことを報告してきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本電気にパーソナルコンピューターの種をまいた渡辺和也は、一九九〇（平成二）年六月二十七日付けで同社を退社し、七月二日、ネットワーク用ソフトウエアの雄、ノベルの日本法人の社長に就任した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "『エキスパンドブックでつくる本』は、一九九四（平成六）年十月一日付けでまとめられた作品です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "出版社に任せていては、それは手遅れになってしまうでしょう」（一九九三年十一月二十七日付け、ボイジャーサロンへの書き込み。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九九九年五月九日付けの、ファイル取り扱いルールに関する「そらもよう」＊＊記事をきっかけに、六、七月にかけて進めた話し合いでは、商業利用にも青空文庫側の了解を求める必要はないと明示するか否かが焦点となった。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "著作権、著作隣接権をめぐる法的枠組みの見直し事項に関して、二〇〇四年七月一九日付けでまとめられた欧州委員会の報告書は、保護期間のさらなる延長に歯止めをかけた点で、注目に値する。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九九二年三月二十七日付けのシャープの発表によれば、両社は「次世代のパーソナル情報機器の開発から生産および販売について、長期的な事業提携を結ぶことに合意し、契約を締結」した。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マウスと呼ばれる簡単な入力用具を使い、実際に画用紙の上で絵を書くように手を動かすというもので、我が国でも珍しい」と書いてある日本経済新聞は三月二十日付けであるところを見ると、エイプリルフールの冗談というわけでもないらしい。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして日付けの所まで来ても格別な情緒を誘われはしなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "以下は彼の事件の草稿で、一八八五年の日付けになっていた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幻の人力車",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはやはり同じ日付けの夕刊の社会面であったが、誰かこのベンチに腰をかけた人が棄てて行ったものらしい。",
              "citation": {
                "source": "縊死体",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月三日付けのフィラデルフィア発行の諸新聞は、すべてこのロス氏の探人広告を大きく掲げている。",
              "citation": {
                "source": "チャアリイは何処にいる",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前のは二日の日付けであるから、間の週にはよそへおかきになったわけでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の日付け込んで車掌の怠業する時節は近づけり。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "懐中に、二月二十七日の日付けで吉原元海老屋から受取書が一通あった。",
              "citation": {
                "source": "『七面鳥』と『忘れ褌』",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "日記の第一項の日付けははっきりせず、その紙の上部は引き裂かれていたが、残った分には次のようなことが記されている。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "妖物",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙は短いもので、その日付けによると、あたかも三十五年前のものであった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "貸家",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、最後の日付けの手紙の終わりには、やはり同じ女文字で「六月四日、海に死す。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "貸家",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた、わたしが推測した通りに、かの手紙の受け取り人であるらしい老婆の身の上を念入りに調べはじめると、手紙の日付けの一年前、すなわち今から三十六年前に彼女は親族の意志にさからって結婚した。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "貸家",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっぱれな亭主は少なくとも三度くらいはくり返してクーリエ・フランセー紙をその日付けから印刷者の名前まで読み返したが、男は身を動かそうともしなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中には明らかな事実があり、確かな日付けがあり、疑うべからざる証拠があった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "日付けを入れとけよ。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十八日付けで退社、という辞表だった。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暗い扉に紙を貼って、昨日の日づけで、診療の都合により面会を謝絶いたし候――医局、とぴたりと貼ってある。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――日づけが当日、その日です。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
