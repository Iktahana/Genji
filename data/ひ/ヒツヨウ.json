[
  {
    "uuid": "f33fe79d-fcac-5ee2-ab39-3fe6ccc9a8ac",
    "entry": "必要",
    "reading": {
      "primary": "ひつよう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
