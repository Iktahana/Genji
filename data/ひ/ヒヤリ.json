[
  {
    "uuid": "b3862a94-2eba-5669-92d6-ded582f8f6ce",
    "entry": "冷やり",
    "reading": {
      "primary": "ひやり",
      "alternatives": [
        "ヒヤリ"
      ],
      "is_heteronym": false
    },
    "grammar": {
