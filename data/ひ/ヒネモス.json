        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "春としなれば山奧のふかい森の中でもくされた木株の中でもうごめくみみずのやうに私のたましひはぞくぞくとして菌を吹き出すたとへば毒だけ　へびだけ　べにひめぢのやうなものかかる菌の類はあやしげなる色香をはなちてひねもすさびしげに匂つてゐる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひねもす疲れて畔に居しに君はきやしやなる洋傘の先もて死にたる蛙を畔に指せり。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ故郷にあればいのち青ざめ手にも秋くさの香華おとろへ青らみ肢體に螢を點じひねもす墓石にいたみ感ず。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "懺悔あるみにうむの薄き紙片にすべての言葉はしるされたりゆきぐもる空のかなたに罪びとひとりひねもす齒がみなしいまはやいのち凍らんとするぞかし。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空に光るわが哀傷のはげしき日するどく齲齒を拔きたるにこの齲齒は昇天したちまち高原の上にうかびいでひねもす怒りに輝やけり。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なほもひねもすはしりゆく草むらふかく忘れつる洋銀の皿をたづね行く。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みよ、ひねもす、この重たい密房の扉から、私の青白い病氣の肉體が、影のやうに出入し、幽靈のやうに消滅する。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春の海｜終日のたりのたりかな　だれも知ってる名句であるが、のたりのたりという言葉の音韻が、浪の長閑な印象をよく表現し、ひねもすという語のゆったりとした語韻と合って、音象的に非常に強く利いてるのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば鶯のあちこちとするや小家がち　　　蕪村春の海ひねもすのたりのたり哉　　　蕪村　の如く、「あちこちとするや」の語韻から、鶯のチョコチョコとする動作を音象し、「のたりのたり」の音調から春の海の悠々とした印象を現わしているのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さびしや空はひねもす白金、はやわが手かたく合掌し、瞳はめしひ、腦ずゐは山路をくだる。",
              "citation": {
                "source": "偏狂",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬を待つひと萩原朔太郎こほれる利根のみなかみに、ひねもす銀の針を垂れ、しづかに水に針を垂れ、さしぐみきたる冬を待つ。",
              "citation": {
                "source": "冬を待つひと",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おのれと影とたゞふたり、　　あれと云はれし業なれば、ひねもす白き眼して、　　　　放牧の柵をつくろひぬ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "火の島宮沢賢治海鳴りのとゞろく日は船もより来ぬを火の山の燃え熾りて雲のながるゝ海鳴り寄せ来る椿の林にひねもす百合掘り今日もはてぬ",
              "citation": {
                "source": "火の島",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御最後川の岸辺に茂る葦の枯れて、吹く潮風に騒ぐ、その根かたには夜半の満汐に人知れず結びし氷、朝の退潮に破られて残り、ひねもす解けもえせず、夕闇に白き線を水ぎわに引く。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「見ずもあらず見もせぬ人の恋しくてひねもす今日はながめ暮らしつ」という古歌を引いて書いてある所を御覧になった時に、蹴鞠の日の御簾の端の上がっていたことを思い出すことがおできになり、お顔が赤くなった。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            },
            {
              "text": "心の中では昔のこと、昔にゆかりのある人のことばかりが思われて、昼はひねもす物思いに暮らして、夜になるとわが意志でもなく女二の宮をお訪ねに行くのも、そうした習慣のなかった人であるからおっくうで苦しく思われる薫は、御所から自邸へ宮をお迎えしようと考えついた。",
              "citation": {
                "source": "源氏物語",
                "author": "宿り木",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑の確定した被告は送られ、新らしい犯罪者がそれに入れかはる鍵と手錠のつめたい鐵のひゞきがひねもすきこえ、やがて夜になり、また朝が來、おなじことが毎日無限にくりかへされてゆく。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "金策に出でてひねもす歸らざる老父を思ひつつ夜の戸とざす柿の實の初生り賣りて得し金を神にそなへて額づくわが老父わがのぼる脚榻に昨夜の霜おけり高き小枝に柿の實ちぎる柿の實は乏しくなれり柿の落葉あつめて今宵火を焚きにけり　ほか二首であつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日彼媼さへ、ひねもす出でゝ歸らざりしかば、我は賊の一人とこの山寨の留守することゝなりぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてわがこころひねもす傷むともなくてくゆりぬ、あな、あはれ、汝が香の小鳥そらいろのもやのつばさに。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "曼陀羅このみきにうれひねもすへびにねらはる。",
              "citation": {
                "source": "聖三稜玻璃",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊立てる十字架立てるは胸の上ひねもすにくしんの蟲を刺し。",
              "citation": {
                "source": "聖三稜玻璃",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "主観的に云えば蝶は蜜を求めて飛びまわっているのであろうが、人間の眼に映ずる蝶の生活は、春のひねもすを舞い明かし舞い暮しているとも考えられる。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝はひねもす、乳酪の匙にまみれて、飛び超えて、卓子の上、椅子の上、ちんからころりと騷げども、騷げども、流石、寢室に瓦斯の火のシンと鳴る夜は氣が滅入ろ…いつか殺したいたいけな青い小鳥の翅の音。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十六蝉も鳴く、ひと日ひねもす、『かなし、かなし、ああかなし、今日なほひとり。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝のゆめ酒倉の強き臭を嗅ぐときは夏のさみしく、油屋の黄なる搾木をきくときは秋のかなしく、少年の感じ易さは、怪しさは、あはれ、ひねもす、金文字の古き蘭書に耳をあて黒猫の晝の瞳に見るごとく、冬もゆめみぬ、ゆゑわかぬ春のシムフオニイ。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　騎りつつ、騎りつつ、騎りつつ、日ねもす、夜もすがら、日ねもす。",
              "citation": {
                "source": "旗手クリストフ・リルケ抄",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "水夫が、輪切りにした椰子の実でよごれた甲板を単調にごし／＼ごし／＼とこする音が、時というものをゆるゆるすり減らすやすりのように日がな日ねもす聞こえていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻痺薬の酸ゆき香に日ねもす噎せて聾したる、はた、盲ひたる円頂閣か、壁の中風。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ず、暫時、――今はた浮きつ、淨まはる聖ごころのかひがひし、あな鳰の鳥、日ねもすに齋きゆくなり。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            }
          ]
        }
