        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この映画は、日本の戦国時代のヒストリーに基づいている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ゲームの途中で、彼のキャラクターの壮絶なヒストリーが語られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あのバンドは、長いヒストリーの中で多くのヒット曲を生み出してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「ヒストリー・オフ・インテレクチュアル・デベロップメント。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "真実には体系（システム）があり歴史（ヒストリー）がある。",
              "citation": {
                "source": "哲学の現代的意義",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが思想には体系（システム）と歴史（ヒストリー）とがあると云った。",
              "citation": {
                "source": "哲学の現代的意義",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒストリー、オフ、インテレクチユアル、デ※ロツプメント。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはシナの「史」という文字の意義の転化ばかりでなく、西洋のヒストリーという語についても同様である。",
              "citation": {
                "source": "日本における史前時代の歴史研究について",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを河野磐州自身のファミリーヒストリーについてみるなら、純封建的「豪族」河野氏の世系は、磐州の祖父の代にいたって、地主であり郷士であり、名目上の禄百石と五人口を給さるる藩士でさえあって、しかも呉服太物業・魚問屋・酒屋を経営していた。",
              "citation": {
                "source": "加波山",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "生徒の教科書をのぞくと、アメリカンヒストリーである。",
              "citation": {
                "source": "アラメダより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の頃丸善から出したヒストリアンスヒストリーの豫約廣告に依ると、最初手付として金五圓出しさえすれば、直ぐに定価百五六十圓の書物を全部送り届けてくれる。",
              "citation": {
                "source": "The Affair of Two Watches",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリティクス、タイラニー、デモクラシー、アナーキズム、フィロソフィー、フィジオロジー、ジオロジー、ヒストリー、はすべてギリシャの言葉である。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより前一五六四年死せるゲスネルの判断力、当時の学者輩に挺特せしも、なおその著『動物全誌』（ヒストリア・アニマリウス）に竜を載せたるにて、その頃竜の実在の信念深かりしを知るべしと。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい歴史学は「根本概念のイデーと創造的発展のイデー」とによつて古いヒストリスムスを破壊しました。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "発生的方法は現代では心理主義若しくはヒストリスムスの名のもとに非難されてゐます。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら私たちはなほ心理主義やヒストリスムスに陥ることなくして、しかもひとつの新しい発生的方法を考へ得ないでせうか。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナトルプの心理学の方法が心理主義でないならば、歴史的社会的世界に成立する事実をそれの歴史的起源に還元することによつて歴史的意識の根源的なる形を構成し、この意識のはたらきを純粋に記述する学問は――若しかかる学問があつたとすれば――あながちヒストリスムスとして排斥すべきでもないでせう。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「手前の中学時代の教科書に何んなフリ仮名がついてゐたかは知らないが、俺の斯んなにも厚い、大きな――」と私は手真似して「コリンスといふヒストリアン・デイクシヨナリイには、ちやあんとＫがサイレントになつてゐるんだア。",
              "citation": {
                "source": "歌へる日まで",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして傍らの「ヒストリイ・オヴ・デビルズ」の辞書は、「キクロウプス――古代ギリシヤ、ユーリピデスの悲歌に、はじめて引用されたる怪物の名称なるも、起原は、地中海に出没せるカレドニアの海賊の間に信仰されたるデモーネンの謂なり。",
              "citation": {
                "source": "鬼の門",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分であつめた本は、これまでの幾度かの嵐で大半あとかたもなかつたが、天井裏や長持の中からなど、誰のものかも知れないやうな、ヒストリアンズ・ヒストリイとか、ブリタニカとか、古典的な西洋料理全集といふやうなものまで、あらひざらひ掻きあつめて見ると、それでもトラツクに一台は十分の量だつた。",
              "citation": {
                "source": "裸虫抄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、もし読者がそれに多少の困難を感ずるとすれば、ペックがその著「ヒストリイ・オブ・スタンフォオド」の中で書いている「さまよえる猶太人」の服装を、大体ここに紹介するのも、読者の想像を助ける上において、あるいは幾分の効果があるかも知れない。",
              "citation": {
                "source": "さまよえる猶太人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたはむずかしいひとだから、お誘いしまいと思ったんですけど、これは日本にとって大きなヒストリカル・イヴェントなんですから、お見せするほうがいいと思って来ていただいたのよ」「あっさりやってくれよ、なんなの」「軍艦へお別れに行くパァティなのよ」「なんだ、そんなことか。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひとつおねがいしますかな」　山チイがヒストリカル・イヴェントといったのはほんとうだ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュタイン男爵はドイツ民族統一を悲願としてドイツ中世資料集モヌメンタ・ゲルマニアエ・ヒストリカの編集を開始した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
