        "examples": {
          "standard": [
            {
              "text": "組織の肥大化に伴い、部署間のコミュニケーション不足が深刻な問題となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ソフトウェアの機能追加を繰り返した結果、コードベースが肥大化してメンテナンスが難しくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "国家予算の肥大化に歯止めをかけるため、大規模な財政改革が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "と諦めて書き始めたところが、前項は「起」が肥大化して「続く」と相成った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこいつが肥大化すれば、やがて演奏はコンピューターのジェネレートするカラオケになる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "移植を試みるにしても、統制のとれないベーシックの肥大化は作業を困難なものにしていった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "作業の肥大化が、混乱と開発効率の低下につながることを恐れたハネウェルでは、ＯＳを小さなモジュール単位に切り分けてそれぞれの担当者に割り振っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
