    "definitions": [
      {
        "index": 1,
        "gloss": "travelling alone",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "次の連休を利用して、カメラを片手に京都の寺院を巡る一人旅に出かける予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "一人旅の最大の魅力は、その日の気分で自由に行き先や食事を決められることにある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は自分自身の人生を見つめ直すために、あえて言葉の通じない異国へ一人旅に出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "もう遅うござりますに因って、御一人旅の事ではありまするし、さようなお方は手前どもにおいでがないと申して断りましょうかとも存じましたなれども、たいせつなお客様、またどのような手落になりましても相成らぬ儀と、お伺いに罷出ましてござりまする。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　五｜分間停車と聞いて、昇降口を、峠の棧橋のやうな、雲に近い、夕月のしら／″＼とあるプラツトフオームへ下りた一人旅の旅客が、恍惚とした顏をして訪ねた時、立會せた驛員は、……恁う答へた。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度は、餘りの苦しさに、三國沿岸で……身を投げて……いや、此だと女性に近い、いきなり飛込んで死なうと思つた、と言ふほどであるから、一夏は一人旅で、山神を驚かし、蛇を蹈んで、今も人の恐るゝ、名代の天生峠を越して、あゝ降つたる雪かな、と山蛭を袖で拂つて、美人の孤家に宿つた事がある。",
              "citation": {
                "source": "麻を刈る",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "片山津（加賀）の温泉宿、半月館｜弓野屋の二階――だけれど、広い階子段が途中で一段大きく蜿ってＳ形に昇るので三階ぐらいに高い――取着の扉を開けて、一人旅の、三十ばかりの客が、寝衣で薄ぼんやりと顕れた。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがね、家元の弥次郎兵衛どの事も、伊勢路では、これ、同伴の喜多八にはぐれて、一人旅のとぼとぼと、棚からぶら下った宿屋を尋ねあぐんで、泣きそうになったとあるです。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "外へといっては、それこそ田舎の芝居一つ、めったに見に出た事もないのに、はるばる一人旅で逢いに来たんじゃありませんか、酷いよ、謹さんは。",
              "citation": {
                "source": "女客",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度朝からしとしととした五月雨、それが一人旅の侘びしさを一しほ誘ふ。",
              "citation": {
                "source": "女盗",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　――ところで旦那……その御婦人が、わざわざ木曾のこの山家へ一人旅をなされた、用事がでございまする。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡れた帽子を階段｜擬宝珠に預けて、瀬多の橋に夕暮れた一人旅という姿で、茫然としてしばらく彳む。",
              "citation": {
                "source": "第二菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "看板を書かえる隙もない、まだ出たてだという、新しさより、一人旅の木賃宿に、かよわい女が紙衾の可哀さが見えた。",
              "citation": {
                "source": "第二菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お待合わせを約束の仲｜町を出た、あの大時計が雪の塔、大吹雪の峠の下に、一人旅で消えそうに彳っていらっしゃるのが目さきに隠現くもんですから、一息に駆出すようにして来たんです。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもママと一緒に出かけて色々の事務を分担してやって来た私が今度は一人旅だったので荷物やら切符やら食料やら仲々厄介でした。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めて自分の娘を一人旅に送り出したママは旅先きで娘がどんな刺戟や感銘を受けるかをハラハラ身もやせる程案じて居ります。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女子の一人旅では、こんなに遅くなっては、旅籠に往っても泊めてくれませんし、ほんとうに困っております」「そうだ、どうかしなくてはならんが……」「どうか簷の下で宜しゅうございますから、今晩だけお泊めなさってくださいますまいか」と、女はきまり悪そうに云った。",
              "citation": {
                "source": "花の咲く比",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思い迫って約束した一年の短かい間に、どうしたら望み通りの金が稼げるかと……思案に暮るる一人旅。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪い感じのしない可哀そうに思われる女であったが、見ず知らずの一人旅の者を泊めることは憚られた。",
              "citation": {
                "source": "山姑の怪",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば一人旅らしい。",
              "citation": {
                "source": "悪魔の舌",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがさ、峠にただ一人で遣る挙動じゃ、我ながら攫われて魔道を一人旅の異変な体。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――折からのざんざ降で、一人旅の山道に、雨宿りをする蔭もない。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「八方、諸国、流転の末が、一頃、黒姫山の山家在の荒寺に、堂守坊主で居りました時、千箇寺まいり、一人旅の中年の美麗な婦人――町内の江戸絵の中と……先ず申して宜しい。",
              "citation": {
                "source": "菊あわせ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人旅の姿は悄然とする。",
              "citation": {
                "source": "貴婦人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "分けて恋のない――人を待つ思の絶えた――一人旅の奥山家、枕に音づるゝ風は我を襲はむとする殺気を含む。",
              "citation": {
                "source": "貴婦人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日正道は思案にくれながら、一人旅館を出て市中を歩いた。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、昔から一人旅を一度も行つたことがなく今に至つてゐる。",
              "citation": {
                "source": "秋晴れの日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "掃部も観音詣での一人旅であった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶲や鷦鷯などが、山から里へおとづれて来るには、頭を円めた遁世者のやうに、どんな時でも道連のない一人旅ときまつてゐるが、それとは打つて変つて鶺鴒は多くの場合公園の散歩客のやうに夫婦づれだ。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "松太郎は、二十四といふ齢こそ人並に喰つてはゐるが、生来の気弱者、経験のない一人旅に今朝から七里余の知らない路を辿つたので、心の膸までも疲れ切つてゐた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "松太郎は、二十四といふ齡こそ人並に喰つてはゐるが、生來の氣弱者、經驗のない一人旅に、今朝から七里餘の知らない路を辿つたので、心の膸までも疲れ切つてゐた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京からパリーまでは一人旅と云っても連れは多い。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
