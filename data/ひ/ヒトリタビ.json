[
  {
    "uuid": "415f757c-672b-5ced-bcb0-429ef03ba6bb",
    "entry": "一人旅",
    "reading": {
      "primary": "ひとりたび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
