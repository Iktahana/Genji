    "uuid": "8231f249-eaa0-5bb0-a599-a4be5a7532f3",
    "entry": "必置",
    "reading": {
      "primary": "ひっち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
