        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　それは又本当か、と膝乗り出す。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えゝ、ほんとうをいいましょう」　そう決心するもののように古藤はいってからひと膝乗り出した。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "剣を取っては江戸御免の退屈男も、馬術はまた畠違いでしたから、ひと膝乗り出して京弥に囁きました。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかで見たような顔だが、どうも思い出せねえ」「いや、それですよ」と、松吉もひと膝乗り出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "薄雲の碁盤",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、梶沢君は肩をゆすりながらひと膝乗り出した。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、侍従はひと膝乗り出して、いよいよ声を低めた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれがとこう申すは恐れあれど、殿下この頃の御行状は……」「それ、そのことじゃよ」と、頼長は待ちかねたようにひと膝乗り出した。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お店の人間ですよ」「店の者……」と、十右衛門は一と膝乗り出して来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "勘平の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は一膝乗り出した。",
              "citation": {
                "source": "近眼芸妓と迷宮事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　范増はこゝぞと一膝乗り出して、「力で圧へられてゐる者は力が弛めば必ずはね返します。",
              "citation": {
                "source": "悲しき項羽",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "抗弁をしようとして御面師は一膝乗り出したのだが、自分もやはり担がれる部の補欠になっているのかと気づくと、舌が吊って言葉が出せぬらしかった。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "抗弁をしようとして御面師は一膝乗り出したのだが、自分もやはり担がれる部の補欠になつてゐるのかと気づくと、舌が吊つて言葉が出せぬらしかつた。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さようでござりまする」と一膝乗り出した大作、「御前様に気のふれた女のちかづきがあろうとは、大作きょういままで夢にも……」「ハッハッハ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで、お駒ちゃんに似せた案山子みたようだ」　お駒が、ぎょっとすると、日本一太郎は、彼の所有物のなかで一番高価らしい、村田の銀張りをからりと投げ出すように置いて、ひと膝乗り出してきた。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「連れて綺麗にござりまする」「しからば貝十郎そちに訊くが」と冬次郎は一膝乗り出した。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、こんどは私がびっくりして一膝乗り出した。",
              "citation": {
                "source": "狂女と犬",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとつ、色よい返事をしちゃアくれめえか」　ぐっと一膝乗り出した歌麿の眼は、二十の男のような情熱に燃えて、ともすれば相手の返事も待たずに、その釣鐘型の乳房へ、手を触れまじき様子だった。",
              "citation": {
                "source": "歌麿懺悔",
                "author": "江戸名人伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウム」　受け取ってググググと息も吐かずに呑み干し、すぐまた圓生のほうへ返すと、ウーイとひとつげっぷをしたが、「じゃいおう、俺もいおう」「ウム聞こう」　微笑んで圓生、ひと膝乗りだした。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "膝乗り出して聴きいっている。",
              "citation": {
                "source": "圓朝花火",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗悦が返金を切りだす、もう少し待てと殿様が断る、そのときひと膝乗り出した宗悦が「私はこういう不自由な身体で根津から小日向まで、杖を引っ張って山坂を越してくるのでげすから」根津から小石川小日向へまでを「山坂」云々はいかにもそのころの辺陬の感じがあらわれていて、時代風景的におもしろい。",
              "citation": {
                "source": "我が圓朝研究",
                "author": "「怪談牡丹燈籠」「江島屋騒動」「怪談乳房榎」「文七元結」「真景累ヶ淵」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　この間に、支配人が一膝乗り出した。",
              "citation": {
                "source": "鳩つかひ",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "家政婦が火種を持って来て、瀬戸の大火鉢に炭をついでから、各自の前にお茶を運んでいるのを、夫人はいらいらしながら見ていたが、彼女の退くのを待って、急に一膝乗り出し、「先生、突然、こんな朝っぱらから伺って、御無理をお願いしてはすみませんが、実は私、大変な心配事が出来たんですの。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」理学士はきらりと眸を光らせながら、ひと膝乗りだした、「それは全体何ですか※」「これなんです！",
              "citation": {
                "source": "幽霊屋敷の殺人",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時、実盛の家で例の通り酒宴が行なわれた時、主人の実盛が一膝乗り出して声をひそめていった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第七巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さうでせうか、」と入道さまは頬にかすかな笑ひを浮べて一膝のり出しました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八王子の方で死んだ筈だ」　文字春はいよいよ身を固くして、ひと膝のり出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」熊吉は一膝のり出したが、すぐにまた物思はしげな樣子にかへつた。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "なら、手前が一つ――」　漸く主候の心中を察することが出来たと見えて、膝のり出したのは石川六四郎だった。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "聴かしてください」と、私は一と膝のり出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "蝶合戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それぢや、ここに一つ相談があるが――」晩花氏は一膝のり出して来た。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
