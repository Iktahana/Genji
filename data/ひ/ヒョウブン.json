[
  {
    "uuid": "097e488c-6a7e-550e-ada6-9c55c2bd7dc8",
    "entry": "表文",
    "reading": {
      "primary": "ひょうぶん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "発表文を読んでいて「ありゃりゃ」と驚かされたのは、役員の顔ぶれだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "康煕年間の動乱に当って、琉球の使節は清帝及び靖南王に奉る二通の上表文を持参していったとの事であります。",
              "citation": {
                "source": "琉球史の趨勢",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "明、清の代り目に当って支那に使した沖縄の使節の如き、清帝と明帝とに奉る二通りの上表文を持参して行ったとの事である。",
              "citation": {
                "source": "沖縄人の最大欠点",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは古来琉球政府の記録や上表文などを書いていた久米村人間で秘密に話されていた事である。",
              "citation": {
                "source": "沖縄人の最大欠点",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "東晉より宋、齊、梁の代に亙りて倭王讚珍濟興武等が朝貢の記事は宋梁各書に見えたるが、之を以て大和朝廷の正使にあらずして邊將の私使なりとするの説あるも、其の上表文によれば、大和朝廷の名を以て交通したる者なるは明白なり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "○音表文字も觀念の指表たるに止まる場合がある。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事實また音表文字も萬國音表文字さへ聲音の完全な寫眞ではない。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "他にもそのような音表文字を使用しているところは多いだろうが、支那がそうでないことだけは確かであろう。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに漢字は、もと象形文字に端を発したかも知れないが、やがて象形文字の直観的｜煩雑性を克服し、半ばは音表文字の作用をも勤めつつ、直接に意味を現わす形象として、異常な発達を示して来たのである。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代のシナにおいて、もし語られる通りに音表文字をもって現わしたならば、その言語の多様なることは現代のヨーロッパの比ではないであろう。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "またもしシナの古語が音表文字をもって記されていたならば、先秦や秦漢や唐宋などの言語が現代の言語と異なることは、ギリシア語やラテン語やゲルマン語が現代ヨーロッパ語と異なるに譲らないであろう。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆる仲次貿易の始めにおいては、蘇木・胡椒等の南方の産物のみが、表文の上には出ているが、是を調達するにも多くの宝貝を船に積んで、まず西南の諸国と交易してこなければならなかった。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
