[
  {
    "uuid": "c43b6b37-9cbb-51b6-87f9-3e4542997720",
    "entry": "ヒチ",
    "reading": {
      "primary": "ひち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
