        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「まだ仕事のいろはも知らないひよこのくせに、一人前の口を利くな」と叱られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は自分を謙遜して「業界ではまだひよこですので、ご指導お願いします」と言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "新米教師として教壇に立った初日は、ひよこ同然の自分に何ができるか不安だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
