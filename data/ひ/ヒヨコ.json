    "definitions": [
      {
        "index": 1,
        "gloss": "young bird",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "孵卵器の中で殻を破って出てきたばかりの雛が、弱々しく鳴き声を上げている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "養鶏場では、黄色い羽毛に包まれた数千羽の雛たちが元気に走り回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "母鶏の翼の下に潜り込み、温めてもらっている雛たちの姿に心が和む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一重筵の上にして蒔繪の盆や草雙紙さては廚の煤鍋が入り亂れたる狂態を水干やれし古雛のこは狼藉ととがめずや。",
              "citation": {
                "source": "煤掃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雛壇を遠くから眺めると、支那の壺の模樣のやうに見えます。",
              "citation": {
                "source": "國技館",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者は前にも述べた通り、シャスタとシャスチナの間の、鞍部に懸垂しているが、アルプスのベルニーズ・オーバアラント山地あたりの大氷河に比べると、恐らく雛形ぐらいの小さいものだろうが、それでも擬似氷河ではない。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッ、毛も生えないような、雛っ子じゃあるめえし、未だ、おいら泣き死にはしねえよ。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "（あの小僧奴、俺の子供位に雛っ子の癖してやがって！",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "先達てドイツのある科学雑誌に猫の宙返りの真似をする雛形が載せてあった。",
              "citation": {
                "source": "猫六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この糸で雛形を倒につるす。",
              "citation": {
                "source": "猫六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピタゴラス派の哲学というものはあるが、ピタゴラスという哲学者は実は架空の人物だとの説もあるそうで、いよいよ心細くなる次第であるが、しかしこのピタゴラスと豆の話は、現在のわれわれの周囲にも日常頻繁に起りつつある人間の悲劇や喜劇の原型であり雛形であるとも考えられなくはない。",
              "citation": {
                "source": "ピタゴラスと豆",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物置の前では十五になる梅子が、今｜鶏箱から雛を出して追い込みに入れている。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子もお児もいかにもおもしろそうに笑いながら雛を見ている。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈々子は満足の色を笑いにたたわして、雪子とお児の間にはさまりつつ雛を見る。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "カナリヤの雛　近頃英国で、ある学者が二軒の小鳥屋についてカナリヤが生む雛鳥の雌雄の数を調べてみた処、甲の家では雌百に対し雄が七十七であったが、これに反して乙の鳥屋では雌百に対する雄が三百五十三の大多数を占めていた。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで甲の家のカナリヤを一番選んで乙の家に移し、その後に孵化した雛について、雌雄の割合如何と調べてみると、面白い事には乙の家に来て以後は雄を多く生むようになった。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これから考えると、生れる雛の雌雄いずれが多いかという事はその親鳥の食餌や鳥屋の温度その他の周囲の状況できまるものだという事が分る。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが万一｜僥倖に助かって孵化しても、親に似て性の悪い杜鵑の雛鳥に鋭い嘴で啄き出されてしまうという。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "事件は今から七日前、娘のお春が三つの節句の雛を片附けた晩のことであつた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "小幡の家でも雛を飾つた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "緋桃白桃の影をおぼろに揺がせる雛段の夜の灯を、お道は悲しく見つめた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "來年も再來年も無事に雛祭が出來るであらうか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "小幡の家では五日の日に雛をかたづけた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "今更ではないが雛の別れは寂しかつた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし大きくなって、雛を捕ったり、魚を盗んだりしだすと、床板の下をくぐって人目を避けたり、寒い時には焚いたあとの火の消えたばかりの竈の中へにじりこんで寝たりするので、毛は黒く汚れていた。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おりくよ、旦那んとこにゃ、雛を捕られた云うて大モメをしよるが、また家の紋が捕ったんじゃないんか。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "棺の後ろには位牌を持つた跛足の哲が、力三とお末とのはき古した足駄をはいて、ひよこり／＼と高くなり低くなりして歩いて行くのがよく見えた。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピー、ピー、と、ひよこが鳴きながら、ころがり出てきました。",
              "citation": {
                "source": "みにくいアヒルの子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのようすが、なんとなく、中国のひよこに似ているように思われました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の親仁、破れ簑の毛を垂らして、しよぼりとした躰で、ひよこひよこと動いて来て、よたりと松の幹へ凭かゝつて、と其処へ立つて留まる。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "』とひよつこり、ひよこり、ひよつこりと歩行き出す……案山子どもの出向くのが、祠の方へ、雪枝の来た路の方角に当る。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『大儀ぢや』と正しく如意輪が仰せあつた……『はツ、』と云ふと一個、丁ど石高道の石※へ其の一本竹を踏掛けた真中のが、カタリと脚に音を立てると、乗上つたやうに、ひよい、と背が高く成つて、直に、ひよこりと又同じ丈に歩行き出す。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面に伸上つて見れば、向ふから、ひよこ／＼来る三個の案山子も、同じやうな坊主に見えた。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
