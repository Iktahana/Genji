        "examples": {
          "standard": [
            {
              "text": "古代中国語の四声である平上去入について、文献を読み解く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "漢詩の韻律を理解するには、平上去入の区別を知ることが不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "日本語の漢字の読みにも、平上去入の影響がわずかに残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "四聲と申しますのは、詩を作る方はどなたでも御存じですが、平上去入と云うて、平聲と云ふのは平らかな聲、上聲と云ふのは上げる聲、去聲と云ふのは下げる聲、入聲と云ふのは呑む聲、斯う云ふ四つに聲を分けて、有らゆる文字を其の四つの聲に嵌めて、さうして研究することになつて居ります。",
              "citation": {
                "source": "弘法大師の文藝",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
