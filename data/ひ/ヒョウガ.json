  {
    "uuid": "3d62399d-0512-5317-8757-94c29d94dccb",
    "entry": "馮河",
    "reading": {
      "primary": "ひょうが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
