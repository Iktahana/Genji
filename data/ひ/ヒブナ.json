          "literary": [
            {
              "text": "せいぜい五六年の緋鮒ぐらいが高価品で、全くの駄金魚屋だった。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そなたのけふ入れた緋鮒か、それとも陶器の金魚かしら、なにかしら寂しい力の薄い硝子に触るやうな……ほんとに睡ちやつたの。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお池には、鯰や鯉や緋めだか緋鮒の類もよかろう。",
              "citation": {
                "source": "夢の図",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯉や、鮒や、緋鯉や、緋鮒が活けてある。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
