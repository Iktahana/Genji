        "examples": {
          "standard": [
            {
              "text": "伝統的な職人が、屋根の材料となる桧皮を丁寧に一枚ずつ剥いでいく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この古い門の屋根には、雨風を凌ぐために何層にも重ねられた桧皮が使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "桧皮は耐久性に優れており、古くから日本の建築物において重宝されてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "で、細かい館の様子は、ほとんど見ることが出来なかったが、桧皮葺の門は傾き、門内に植えられた樹木の枝葉が、森のように繁っていた。",
              "citation": {
                "source": "弓道中祖伝",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
