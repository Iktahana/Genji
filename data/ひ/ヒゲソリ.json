        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎朝の髭剃りは、彼の日々のルーティンの一部である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新しい髭剃り機を試したところ、肌荒れが減少した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "出張先では髭剃りの時間が限られるため、電気シェーバーを使用している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "髭剃りのあとにつけるクリームを持たないことも知っている。",
              "citation": {
                "source": "憑きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後から、半蔵は宿のかみさんに自分の出先を断わって置いて、柳原の方にある床屋をさして髭剃りに出かけた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕尾服の手前もあれば、停車場前の理髪店に飛び込み、早く早くとせき立てながら、髪苅り、髭剃り、此れならば大丈夫と鏡を見れば、南無三、頭は仏蘭西流とやら額のあたりだけ長く後短につまれて、まんまと都風になりすましたれど、潮風に染めし顔の何処までも田舎らしきが笑止なる。",
              "citation": {
                "source": "燕尾服着初の記",
                "author": "徳富盧花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は可能な限り鏡を避け、髭剃りはもっぱら床屋ですませた。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめっから俺はそれでなけれゃあぶないといっていたのに――」　事務所へかえる前、泰造は丸ビルへよって髭剃りあとへつける化粧水を買った。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、時間のかかるこの髭剃りが引っかかってばかりいるのと、剃り落しがあちこちにあることから、こういうところに私の平常の健康がもはやなくなっていることが察しられた。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "散髪が終って、台の背が倒され、髭剃りが始まる。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "髭剃りの途中に伊作まで走り、父親にそのことを報告する。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには髭剃りに必要な物も全部入っていた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ早目に出て、楽屋でヒゲ剃り、洗髪。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十日（水曜）　十時半起き、顔の出きもの不快、ヒゲ剃りに苦労する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二十四日（水曜）　起きると十時、すぐ入浴、久々の入浴の嬉しさ、待望のヒゲ剃り、ジョリ／″＼と剃っちまふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴、ヒゲ剃り、今日は順天堂へは寄らない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒゲ剃り断行、ヴァレーでジョリ／″＼、鼻毛も切り、ヘチマコロンつけて、さっぱりした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂はやめて、ヒゲ剃りを行ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノートブックや万年筆、本、着替えのトランクスやシャツ、そして歯ブラシやひげ剃りなど、これさえあれば一日や二日はどこにいても間に合うだけのものが、鞄のなかには要領良く納まっていた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
