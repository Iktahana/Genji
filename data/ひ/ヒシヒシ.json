        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "満員電車の中で、乗客同士がひしひしと肩を寄せ合って立っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小さな箱の中に、色とりどりの宝石がひしひしと詰め込まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "港には漁船がひしひしと停泊しており、出港の時を待っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
