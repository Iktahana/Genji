[
  {
    "uuid": "e4cdb030-ca99-5082-9958-9a3a8f1b85ab",
    "entry": "犇々",
    "reading": {
      "primary": "ひしひし",
      "alternatives": [
        "ヒシヒシ"
      ],
      "is_heteronym": false
    },
    "grammar": {
