[
  {
    "uuid": "f3fdbff9-6d88-545d-998b-1a13ec9567fe",
    "entry": "火矢",
    "reading": {
      "primary": "ひや",
      "alternatives": [
        "かせん"
      ],
      "is_heteronym": true
    },
    "grammar": {
