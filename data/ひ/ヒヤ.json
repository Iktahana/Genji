        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古代中国の戦争では、火矢（ロケット）が強力な兵器として使われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この火矢は、推進剤を燃焼させて飛翔する、初期のロケットと言える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "敵の防御を突破するために、大型の火矢が次々と発射された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
