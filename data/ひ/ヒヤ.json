  {
    "uuid": "d09caad0-ac2c-5158-b1c0-68ed9b0d9a00",
    "entry": "火箭",
    "reading": {
      "primary": "ひや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
