        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "血刀を下げ、足もと定まらず、ヒョロヒョロヒョロと歩いて行く。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痣のある武士、ムーッと呻くと、ポタリと刀を落としたが、全身を弓のように蜒らせると、ヒョロヒョロヒョロヒョロと前へ出た。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち切られた左手の一人、得物を落とすとヒョロヒョロヒョロヒョロと、背後の方へよろめいたが、左肩を両手で押えると、二本の足を宙に刎ね、ドンと背後へぶっ倒れた。",
              "citation": {
                "source": "怪しの館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（はてな、悪酔いをしたらしいぞ）　ヒョロヒョロヒョロヒョロと先へ進んだ。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョロヒョロヒョロヒョロとよろめくのである。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、今度は右のほうへヒョロヒョロヒョロヒョロとよろめいた。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、またもや左のほうへ、ヒョロヒョロヒョロヒョロとよろめいた。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美作の刀を夢中でささえて、放心したように立っていた、非力の小次郎がささえる力に負けてヒョロヒョロヒョロヒョロと後ろへさがり、もたれるように兵馬の胸へ、体当たりめいたものをくれたからであった。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」ヒョロヒョロヒョロヒョロと先へ進んだ。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かろうじて受けて身をかわしたが、ヒョロヒョロヒョロヒョロとまた後へ下がって、一軒の家の雨戸へもたれ、ハッハッハッと大息をついた。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにわかにヒョロヒョロヒョロヒョロと、嘉門は二、三歩前へ出た。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お仙の肩によっかかりながら、ヒョロヒョロヒョロヒョロ歩いて行く。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョロヒョロヒョロヒョロと右へまわった。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウム」　満足そうにうなずいて、「では見せよう私の余興を」　ヒョロヒョロヒョロと立ち上がり、「アア、久し振りでよい心持ちになりました。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
