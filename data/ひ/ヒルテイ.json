          "literary": [
            {
              "text": "私たちは、船を下りると、すぐ旅装を調えて、ヒルテイの村に出発したのであります。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は私は日本から出ました際には、ニュウファウンドランドへさえ着いたら、誰の眼もみなそのヒルテイという村の方へ向いてるだろう、世界中から集った旅人が、ぞろぞろそっちへ行くのだろうから、もうすぐ路なんかわかるだろうと思って居りました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もうヒルテイの村が見える筈です。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれがヒルテイの村でしょうか。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれがヒルテイの村です。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "全くその蓮華のはなびらは、ニュウファウンドランド島、ヒルテイ村ビジテリアン大祭の、新鮮な朝のそらを、かすかに光って舞い降りて来るのでした。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
