[
  {
    "uuid": "160a8eca-a75e-5fc5-9f9d-108c68a5b550",
    "entry": "人当たり",
    "reading": {
      "primary": "ひとあたり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
