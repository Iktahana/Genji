    "definitions": [
      {
        "index": 1,
        "gloss": "manner (with others)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の穏やかな人当たりは、誰からも好かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "接客業では、良い人当たりが最も重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の人当たりが柔らかいので、初対面でもすぐに打ち解けられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "人当たりはいい方ですか？",
              "citation": {
                "source": "患者兼同居人",
                "author": "THE RESIDENT PATIENT",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅草の空に翻る旗差し物、鐘、太鼓、鳴り物の響き、鬨の声、矢叫びの音は、皆この一人当たり一円六十八銭弱の争奪戦のどよめきと見るべきである。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがため人口一人当たりの富は無論増加せしも、全国における資本増殖の速度は到底英国のごとく盛んなることあたわざりしものである。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "水戸から上野へ走る列車はがらがら空いていて、乗客一人当たり六席か七席もあった。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて、一人当たり一円くらいの勘定で払って置こうじゃないか。",
              "citation": {
                "source": "瀞",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一泊三食四十銭というから、十銭だけ増してやって、一人当たり五十銭宛の勘定にして支払ってやったのさ。",
              "citation": {
                "source": "瀞",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月上旬に転住してきて以来、ただ僅かに一回、一人当たり生鰊が半身とお茶の葉が少量だけ。",
              "citation": {
                "source": "食べもの",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるところ、配給制度になってからというもの、平野の農民と同じに、一人当たり二合以上の割りあてを受けることになったのだ。",
              "citation": {
                "source": "食べもの",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "人当たり良くしようという試みを放棄し、嗄れた、しかし妙に反感を抱かせる囁き声で、必要にかられた時にわずかに話すだけになった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "※章表３　サイデンストリッカー、ウィーラー、ゴールドバーガーの調査「南カロライナ州の７つの紡績工場村における障害と家族の収入の関係」(19)によると成年男子１人当たり半月間の家族の収入と1000人あたりの1916年５月から６月に見られた罹病率との関係は次のようであった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "村田は四十代後半の、ごく普通の体型の、人当たりの柔らかな男だった。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "事情により一人当たり五十キログラム袋が一袋から三袋ぐらい必要だ。",
              "citation": {
                "source": "四日白魔",
                "author": "THE FOUR WHITE DAYS",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかひとあたり当たって、この米びつにざくざくお米がたまるようにと、こんなところに祭っておいたにちげえねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る若い婦人記者でその記者の仕事をまだどれだけも経験していない人が、帰り際に靴を履くために腰をかがめ、そして靴を履いてしまった小さな支度を終った眼で、ひとあたり庭先の水のあるところを眺めて言った。",
              "citation": {
                "source": "蜜のあわれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついで、彼は全国の支店、直営店へ、肺病相談所の看板を揚げさせると同時に、全快写真を提供した支店、直営店に対しては、美人一人あたり二百円、多数の医師に治療を受けたる者二百円、普通百円の割にて報酬を与える旨、通告した。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝元は宗全とは異って、人あたりの柔らかな、分別も道理はずれをせぬ、感情も細かに、智慧も行届く人であったが、さすがに大乱の片棒をかついだ人だけに、やはり※いところがあったと見えて、愛宕山権現に願掛けした。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "待ちかねていた酒はやがて出るには出たが、一人あたり冷酒一合五勺にも満たなかった。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あんたと余計な掛引をするまでのことはないから、あっさり言いますが、一人あたり百ルーブリですな。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人あたり八十カペーカ――これがもう、精一杯ぎりぎりの値段ですよ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "調査簿に載っとる農奴なら、一人あたり五百ルーブリが相場でがすからな。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、一人あたり二十五カペーカだしましょう。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだのに、どうして一人あたり五百ルーブリぐらい差上げないことがありましょう。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、お愛想に五カペーカだけ奮発させて頂きましょう、そうすると、農奴は一人あたり三十カペーカの勘定になりますねえ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「七十八人、七十八人と、それが一人あたり三十二カペーカだから、こうっと……。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "窕子は自分等の平生目にしてゐる殿上人あたりの自墮落な生活をかうした靜かな學問にのみ精進して來た人だちの生活に比較して考ヘずにはゐられなかつた。",
              "citation": {
                "source": "道綱の母",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "六台に一人あたり、班長が休みなしに見廻っているのでくさめをするまもない。",
              "citation": {
                "source": "鴻ノ巣女房",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は自分の金で二人を養育したのであるが、いうまでもなく、それは一人あたり千ルーブルよりはずっと多くかかっていた。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一件にしてからが、お角としては最初から、金助のようなおっちょこちょいを使わずに、七兵衛なり或いはがんりきの百蔵なりに頼むべきはずのところを、なにしろ、あの二人あたりは役に立つ代りに、役に立ち過ぎる憂いがある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、芝の三田の四国町の薩摩屋敷の浪人あたりのやりそうなことだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人あたり一日五十銭の食費の中から、こうした場合のおやつ代をひねり出すのは、炊事部に任された権限なのであった。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
