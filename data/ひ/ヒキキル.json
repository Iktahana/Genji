    "definitions": [
      {
        "index": 1,
        "gloss": "to saw off",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭に生い茂った邪魔な木を引き切って片付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大工は、正確に板を引き切るために慎重に作業した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭の伸びすぎた木の枝を、ノコギリで最後まで引き切るのに苦労した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この場合は重量を加えて糸を引き切る場合に類す。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "単に糸を引き切る場合ならば簡単なれども、地殻のごとき場合には破壊の起り方には種々の等級あるべし。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "出どころの判らない匂いと笑いと唄とを引き切るように掻き分けて、物売りと、分別顔のギャルソンが皿を運んだり斡旋したりしている。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰ぞ、また、けたたましくも、朱の息引き切るるごと、狂気なす自動車駆るは。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを両腕鮮血にまみれながら、鋸でごそごそひき切る。",
              "citation": {
                "source": "首を失った蜻蛉",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくすると、煙の中で、かんかんと、金属をたたくような音がし、それから次には、ぎりぎりごしごしと、金属をひき切るような音がした。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一本切れば、なんとか入れるだろう」　ふたたび、きいきいと鉄格子をひき切る音がはじまった。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "似鯉は、仲間の一つがつかまると、その糸を自分たちの背中にあてがい、鋸のように歯形のついた背鰭でそれをひき切る。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to interrupt",
        "register": "standard",
