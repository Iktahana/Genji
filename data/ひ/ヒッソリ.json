[
  {
    "uuid": "78247340-1a3a-53f4-8858-348ce674abd1",
    "entry": "ひっそり",
    "reading": {
      "primary": "ひっそり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞-と",
