        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と云って風雅がって汽車の線路の傍をポクポク歩くなんぞという事は、ヒネクレ過ぎて狂気じみて居ますから、とても出来る事では有りません。",
              "citation": {
                "source": "旅行の今昔",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙な人間が来た、彼は唖だつた、頭髪だけはキチンと分けて古オーヴアを着てゐる、彼に対して、私は何となく不愉快を感じた、悲しい事実だが、私は此頃多少ヒネクレて浮かないのである。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "正宗白鳥へ右といへば左といふ山といへば川といふ行かうといへば帰るといふ御老体は天邪鬼人生をかうヒネクレるまでには相当修業を積んだことでせう、歳月があなたの心を冷え症にしてしまつたのか痛ましいことですあなたの正気からは真実がきけさうもないちよいと旦那酔はして聞きたいことがあるわよ。",
              "citation": {
                "source": "小熊秀雄全集-12",
                "author": "詩集（11）文壇諷刺詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮渡来の木像じみた表情で、眼をショボショボさせながら、片手で吾輩の名刺をヒネクリまわしているキリである。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなような超常識的な常識……犯罪者特有の低能な、ヒネクレた理智が、一時に彼の中に蘇ったのであった。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……時々思い出したように、ねばっこい、ヒネクレたわななきを見せる……。",
              "citation": {
                "source": "涙のアリバイ",
                "author": "――手先表情映画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇悪人の手…………その名刺を裏返したりヒネクッタリして困惑した表情の後「こちらへお通し申せ」という手つきをする。",
              "citation": {
                "source": "涙のアリバイ",
                "author": "――手先表情映画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "話の内容がアンマリ凄いのと、思い切りヒネクレた友吉｜親仁の、平気な話ぶりに打たれたんだね。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "当り前なら法律と算盤の前には頭を下げる事にきめている吾輩だったが、あの時には、前の日に死んだ友吉おやじのヒネクレ根性が、爆薬の臭気とゴッチャになって、吾輩の鼻の穴から臓腑へ染み渡っていたらしいね。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾れながら感心するくらい頭がヒネクレて来たもんだからね……ところが流石は商売柄だ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒネクレた事件のアトをコツコツと探りまわるんだから碌な事はないんだ。",
              "citation": {
                "source": "近眼芸妓と迷宮事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙にヒネクレて歪んでいるじゃないか」「ところが実を申しますとこの花の方が問題なんで……とても凄いお話なんで……ヘエ」　と云ううちに貫七爺は眼の球を奥の方へ引込まして支那扇を畳んだ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな風にヒネクレていた奴なら遣りかねないだろう。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ってどことなく言葉癖が違っている上に、根性のヒネクレた人間が珍らしくない。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでも若い時分は弁護士になろうてんで、神田の東洋法律学校へ通いまして六法全書なんかをヒネクリまわしていたもんですが、生れ付きのナマクラでね。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒネクレた瀬戸物の灰落しまで、何が何やらわからなくて仕合わせ。",
              "citation": {
                "source": "お茶の湯満腹談",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "神経質な、根性のヒネクレタ老人や、ヤンチャな過敏な子供までも、モウ一から十まで姫草さん姫草さんと持ち切りで、ほかの二名の看護婦はあれどもなきが如き状態であった。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "精神的に悪い境遇に育ったもの、生れ付きヒネクレたもの、又は、良心欠乏、無智なぞいう先天的の犯罪性を帯びたものも、静かな地方を嫌って東京に出て来る。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "通りかかりの労働者、学生、紳士などは勿論、人通りのすくない雨の日なぞは、女子学生らしいのまで硝子窓の外から穴のあく程品物をのぞいては鉛筆をヒネクッていた。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は、どんなことがあっても、自分の性質だけは曲げたくないと思いますわ……でも、ヒネクレて了やしないか、とそればかり心配しているんですけれど……」　と言って、ややしばらく沈思した後で、「しかし、私が今まで遭遇って来たことの中で、唯一つだけ叔父さんに話しましょうか」　こんなことを言出した。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒネクレ者で、口が悪く、見たところはごぞんじのとおり、使いふるした棕櫚箒に土用干しの古着をひっかけたような姿。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　田山白雲は、そのうまそうな一つをヒネクり廻すと、駒井が説明して、「うまいというものじゃないが、滋養に富んでいて常食にもなります」「米の代りになりますか？",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、シキリニアタマヲヒネクツテ考ヘマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママ母にいじめられて、ヒネクレ、陰険になり、無口になったと解釈する。",
              "citation": {
                "source": "無毛談",
                "author": "――横山泰三にさゝぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんという強情、ヒネクレモノ、可愛げのない奴だろう、ブンナグッてやりたいような気持だが、天性、私は女の子をブツことのできないたちで、ネチ／＼ブス／＼と根にもっている。",
              "citation": {
                "source": "無毛談",
                "author": "――横山泰三にさゝぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつはヒネクレ根性の、悪党なんだ。",
              "citation": {
                "source": "無毛談",
                "author": "――横山泰三にさゝぐ――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
