          "literary": [
            {
              "text": "万事その年に行はれた不思議な事どもにかこつけたもので、善童とあるのは言ふまでもなく益田甚兵衛の子、ヒエロニモ四郎のことであつた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "レシイナは彼の妻でありヒエロニモ四郎の姉であつた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "金鍔次兵衛は長崎の二官の店でヒエロニモ四郎に洗礼を授けた当の神父であつた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は九ツのそして十のヒエロニモの目覚めるやうな可憐さを忘れる筈はなかつたが、今眼前に再会した十三のヒエロニモは処女よりも清く美姫よりもなまめかしく、そして全ての効果を意識した利巧さが娼婦の本能であることをどうして次兵衛が見逃さう。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのヒエロニモまで。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ヒエロニモよ。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
