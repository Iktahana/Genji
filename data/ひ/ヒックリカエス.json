          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "選挙の結果、政権がひっくり返った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このプロジェクトの計画は、彼のアイデアでひっくり返された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試合の流れがひっくり返り、まさかの大逆転勝利となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
