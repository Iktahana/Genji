        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "駿介はそこに何匹かの鰺と、三四本の章魚の太い足とを盛つた大きな平鉢を見た。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "四畳半の床の間には、白い平鉢に、こってりした生花がしてあって、軸や雲板もそうひどいものではなかった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "陶器製のカナダライに相違ない平鉢の中へ、高句麗の古墳の模型をつくって少女が運んでくる。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "二番目の老人が平鉢を前にすすめて、生作りの鯉の眼に醤油を注ぐ。",
              "citation": {
                "source": "加波山",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯉が正気をとり戻して平鉢の中で一はねすると、背中の割目から一寸大のさしみがこぼれ出るという仕組である。",
              "citation": {
                "source": "加波山",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれにしても、貝そのものを鉢代りに使い、貝ごと平鉢に盛って、銘々取り分けて食する風情は、老いも若きも楽しめるものであると推奨する。",
              "citation": {
                "source": "東京で自慢の鮑",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "長型丸型の水甕、片口、飯鉢、平鉢、土だらい、切立等いう名は地方窯に相応わしい。",
              "citation": {
                "source": "現在の日本民窯",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりは　うえきばちと　なえばこと　ひらばちの　ならんだところへ　やってきました。",
              "citation": {
                "source": "ばにばにベンジャミンのはなし",
                "author": "THE TALE OF BENJAMIN BUNNY",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
