    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「お馬ヒンヒン」という語はいつ頃からあるかまだ確かめないが、一九の『東海道中膝栗毛』初編には「ヒイン／＼」または「ヒヽヒン／＼」など見えている。",
              "citation": {
                "source": "駒のいななき",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と言いやす、馬がヒインヒインと嘶う。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "へい、今朝旦那様をお役所へ送ってね、それからでさ、獣を引張って総曲輪まで帰って来ると、何に驚いたんだか、評判の榎があるって朝っぱらから化けもしめえに、畜生｜棹立になって、ヒイン、え、ヒインてんで。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "万寿と茶々は、このおじさん与し易しとみて、垣のあいだから、ヒインと、馬がくちびるを剥くように、歯を出して見せた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
