        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一つ、やってみよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "まあ、一つ、落ち着いて話そうじゃないか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ちょっと一つ、お願いがあるんだけど。",
              "citation": {
