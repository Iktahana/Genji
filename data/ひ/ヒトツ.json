        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一つ何か面白いことがないかと探している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の発言は、一つ引っかかる点がある。",
              "citation": {
