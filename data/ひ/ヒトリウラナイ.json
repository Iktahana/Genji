        "examples": {
          "standard": [
            {
              "text": "大晦日には、こたつに入ってひとり占いをするのが恒例だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "暇な時に、タロットカードでひとり占いをして気分転換している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供の頃、友達と「鏡を見てひとり占い」とかやったな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "客間の長椅子で、子供らしく片方の脚を折り、片方を床にたらしたつや子が、カルタのひとり占いでもしているように、ロンドンで集めて来た船のエハガキを幾枚も並べて、ひとり遊びしている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
