          "literary": [
            {
              "text": "「だって叔父さんが一人で引き被るわけのものでもあるまいがね。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦へば勝つ人も眠る間無し、小床無し、せめて今、銃叉むとひきかぶるものも無し。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "戰へば勝つ人も眠る間無し、小床無し、せめて今、銃叉むとひきかぶるものも無し。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲団をひきかぶるようにして、外は、霜柱が鋭いことであろうと思った。",
              "citation": {
                "source": "遠藤（岩野）清子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "より安らかに眠ろうと、夜具でもひきかぶるかのように。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、画中の人物が蒲団を引っかぶる。",
              "citation": {
                "source": "耳と目",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そんなら泊れと、私はソファの一つに寝て毛布を引っかぶる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「以夷制夷でございますよ」「ふふん天草とかみ合わせるんだね」「こいつ成功疑いない」「それじゃあ腕を振るおうか」「どうぞね、一つ、すごいところを」「ではそろそろ出かけよう」「まず天蓋、おかぶりなせえまし」「あいよ」　といって引っかぶる。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "服を脱ぐと、へとへとに追い使われた馬のように、全身をわなわなふるわせながら、長椅子の上へ横になって、外套を引っかぶると、たちまちなんにもわからなくなった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
