          "literary": [
            {
              "text": "親爺は、薄暗い廊下で、脚が引きつるものゝようにひょくひょくした。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶩は、ぶさいくな水かきのある脚を、破れるばかりにかわして、ひょくひょくした。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "組んだ指の一二本だけ、組み堅め方を緩めて、ひょくひょく蠢めかしているのは、娘が何を言い出すことやらと、まだ、親振った軽蔑の念と好奇心と混ったものを山の祖神がいささか心に蓄えていることの現れと見れば見られる。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "茸がひょくひょく煮えくりかえる。",
              "citation": {
                "source": "島守",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
