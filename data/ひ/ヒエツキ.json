        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ヒエツキ唄」で有名な椎葉は高千穂から山越えして十八里の隣村であるが、ここは女の里として名高いところ。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第一回　高千穂に冬雨ふれり≪宮崎県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒエツキ唄」は流行歌では哀調切々だが、実はアイビキの唄だ。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第一回　高千穂に冬雨ふれり≪宮崎県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヤを切りながら土地の農民が唄うもので椎葉のヒエツキ唄にやや似ているが、非常に唄い方がむずかしくて、バスガールもこれを唄うのが非常に困難な様子であった。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第一回　高千穂に冬雨ふれり≪宮崎県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてヒエツキ節はそこで昔から歌はれてゐた歌だといふことでありました。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その悲戀を歌つたのがヒエツキ節であります。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
