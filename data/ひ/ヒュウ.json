    "definitions": [
      {
        "index": 1,
        "gloss": "whizzing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一陣の風がひゅうと吹き抜け、枯葉が道路の上を舞い上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "弓から放たれた矢がひゅうと空を切り、標的のど真ん中に突き刺さった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の隙間風がひゅうと音を立てて部屋に入り込み、火鉢の火を揺らした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "風までひゅうひゅう吹きだした。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにせいが高いので、教室でもいちばん火に遠いこわれた戸のすきまから風のひゅうひゅう入って来る北東の隅だったのです。",
              "citation": {
                "source": "イーハトーボ農学校の春",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "風がひゅうと鳴って雪がぱっとつめたいけむりをあげますと、一郎は少し立ちどまるやうにし楢夫は小刻みに走って兄に追ひすがりました。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "別当がこんどは、革鞭を二三べん、ひゅうぱちっ、ひゅう、ぱちっと鳴らしました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　別当がむちをひゅうぱちっとならしましたのでどんぐりどもは、やっとしずまりました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　別当が、むちをひゅうぱちっと鳴らしました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　別当が、むちをひゅうぱちっと鳴らし、どんぐりはみんなしずまりました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "別当も大よろこびで、五六ぺん、鞭をひゅうぱちっ、ひゅうぱちっ、ひゅうひゅうぱちっと鳴らしました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪童子はわらって革むちを一つひゅうと鳴らしました。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その裂くような吼えるような風の音の中から、「ひゅう、なにをぐずぐずしているの。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひゅうひゅうひゅう、ひゅひゅう、降らすんだよ、飛ばすんだよ、なにをぐずぐずしているの。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひゅう、ひゅう、向うからさえわざと三人連れてきたじゃないか。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひゅう、ひゅう、さあしっかりやるんだよ。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひゅう、ひゅう、なまけちゃ承知しないよ。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひゅう、ひゅう、ひゅう、ひゅうひゅう。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "むちがヒューッと鳴りました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、この息子が錠をおすと、トランクは息子を乗せたなり、ヒューッ、と、えんとつの中をつきぬけて、高く高く雲の上までとびあがってしまったのです。",
              "citation": {
                "source": "空とぶトランク",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そうして一斉に弓を引き、ヒューッヒューッと矢を飛ばせる。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嵐の勢いが強まったと見えてヒューッヒューッと鞭を振るような物凄い唸り声が聞こえて来る。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ヒューッ」　と口笛で犬をあやす。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューッ、ヒューッと弦音高く的を目掛けて切って放す。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思った一刹那、女がクルリとこっちを向き、ヒューッと何か投げつけた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューッ、ヒューッと風の音がする。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　間髪を入れず風を切って、物を投げる音がヒューッとした。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューッと小束が飛んで来る。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューッとはいる下座の笛、ドンドンと打ち込む太鼓つづみ、嫋々と咽ぶ三弦の音、まず音楽で魅せられる。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "裸蝋燭を片手に持って、ヒューッ、ヒューッと口笛を吹いて、檻からえて物を呼び出すのをね。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所の硝子戸にドタンと風のあたる音がして、遠くの方にヒューッと唸る凩の音がする。",
              "citation": {
                "source": "冬日記",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一陣の風が、ヒューッと物悲しげな音をたて、舗道の上を吹いてきた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒューッ、ヒューッ――、廊下を飛ぶように走ってゆく僕の耳許を掠めて、銃丸がとおりすぎた。",
              "citation": {
                "source": "鍵から抜け出した女",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
