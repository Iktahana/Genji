          "literary": [
            {
              "text": "泄謨觚、柄渠觚、馬觚もみなシマコ、即ち島子と訓むべきに似たり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "柄渠觚はヒココ即ち彦子などゝや訓むべき。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "東南陸行五百里、到伊都國、官曰爾支、副曰泄謨觚・柄渠觚、有千餘戸、世有王、皆統屬女王國、郡使往來常所駐。",
              "citation": {
                "source": "魏志倭人傳",
                "author": "陳壽",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
