          "literary": [
            {
              "text": "テフテフハ　花トハ　チガヒマス、オハネガ　アツテ　アチラ　コチラ　トビマワル　コトガ　デキマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ウシロデ　イヒマス。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ウシロノ　ハウガ　イヒマスト、マヘノ　ハウガ、「モウ　スコシ　サキノ　ガケノ　上カラ　タニ川ヘ　ホリコンデ　ヤラウ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "地久節チキユウセツハメデタイナクワウゴウサマノオウマレ日ガツカウモ　ヤクバモイハヒマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ノ　上カラ見テヰルトハタモ　ヒラヒラヒルガヘリケフノ　ヨキ日ヲイハヒマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキツト私ヲ返スダラウト思ヒマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノウチニワタシハ、コタンヘカヘリマスガ、マタ、コンド、アガリマスカラ、ドウカ、ヨロシクネガヒマス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イヒマスト　カメコオバサンハ「イイエ、ハデデスワ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　マイニチマイニチ　フタリハ　カウシテ　コウラヲ　ホシナガラ　ネムツテシマヒマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
