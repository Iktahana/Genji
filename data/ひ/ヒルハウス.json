          "literary": [
            {
              "text": "予定時刻を少し過ぎたが、エスター・ウォルターズ役を演ずるヒルハウス嬢が到着していない。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたはヒルハウス嬢じゃない。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒルハウス嬢は土壇場で来られなくなりました。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはヒルと申します」「ヒルハウスに似た名前ですね。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒルハウス嬢の囚人服があつらえたようにぴったりだ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつてヒルハウス嬢は役をやや大げさな程に上品ぶって、淑女らしく演じていた。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒルハウスさん、どういうことですか」　とトレナー氏が息をのんだ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒルハウス嬢が弱々しく、「聞いてちょうだい。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒルハウス嬢の上着を引っかけて、囚人服のまま実際にここへ来ている。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
