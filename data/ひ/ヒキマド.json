        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "天井の引き窓から、柔らかな自然光が部屋いっぱいに差し込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "寝室に引き窓を設けたことで、夜空の星を眺められるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "雨が降ってきた！引き窓を閉めて！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "短夜の明けやすく、四時半には弁公引き窓をあけて飯をたきはじめた。",
              "citation": {
                "source": "窮死",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "家内はもう薄暗いので、雨戸を明け払って更に引き窓をあけた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "青山の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩くことが激しいから、下駄は後の方が直ぐ減ってしまうので、師匠は工夫をして下駄の後歯へ引き窓の戸の鉄車を仕掛けて、それを穿いて歩かれたものです。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "東雲師逝去のこと",
                "note": "青空文庫"
              }
            },
            {
              "text": "………三　或雪の晴れ上った午後、二十四五の女が一人、か細い男の子の手を引いたまま、引き窓越しに青空の見える堀越家の台所へ顔を出した。",
              "citation": {
                "source": "玄鶴山房",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い板の間を塞いだ竈、蓋のない水瓶の水光り、荒神の松、引き窓の綱、――そんな物も順々に見えるやうになつた。",
              "citation": {
                "source": "お富の貞操",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "引き窓の綱、流し元の水瓶、――そんな物も一つづつ見えなくなつた。",
              "citation": {
                "source": "お富の貞操",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にもとある一村では、羊飼のわらんべが行き方知れずになつた折から、夜さりそのわらんべの親が家の引き窓を推し開くものがあつたれば、驚きまどうて上を見たに、箕ほどな「れぷろぼす」の掌が、よく眠入つたわらんべをかいのせて、星空の下から悠々と下りて来たこともおぢやると申す。",
              "citation": {
                "source": "きりしとほろ上人伝",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにも、引き窓があって、半開きになっている。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、投げこむことが出来るように、引き窓が半開きになっているとは都合の良い話である。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "引き窓のガラス戸は、いつか閉められました。",
              "citation": {
                "source": "雲と子守歌",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「昨夜引き窓を閉め忘れたんぢやないか」　平次は矢張りかう訊く外はなかつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "槍の折れ",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬に乗った勢で、小庭を縁側へ飛上って、ちょん、ちょん、ちょんちょんと、雀あるきに扉を抜けて台所へ入って、お竈の前を廻るかと思うと、上の引窓へパッと飛ぶ。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、こちらへ、」　と裾を捌くと、何と思ったか空を望み、破風から出そうにきりりと手繰って、引窓をカタリと閉めた。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだそれよりも内証なのは、引窓を閉めたため、勝手の暗い……その……誰だか。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　とお源は飛上って、慌てて引窓を、くるり、かたり。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三味線も弾けず、踊りも出来ぬ、座敷で衣物が脱げないなら、内で脱げ、引剥ぐと、な、帯も何も取られた上、台所で突伏せられて、引窓をわざと開けた、寒いお月様のさす影で、恥かしいなあ、柄杓で水を立続けて乳へも胸へもかけられましたの。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐内坂の崖下、大溝通りを折込んだ細路地の裏長屋、棟割で四軒だちの尖端で……崖うらの畝々坂が引窓から雪頽れ込みそうな掘立一室。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "轆轤首さ、引窓から刎ねて出る、見越入道がくわつと目を開く、姉様の顔は莞爾笑ふだ、――切支丹宗門で、魔法を使ふと言ふて、お城の中で殺されたとも言へば、行方知れずに成つたとも言ふ。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなら、四つ手場を留めにして、小家で草鞋でも造れば可が、因果と然うは断念められず、日が暮れると、そゝ髪立つまで、早や魂は引窓から出て、城ヶ｜沼を差してふわ／＼と白い蝙蝠のやうにひ行く。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と言懸けて、頷く小宮山の顔を見て、てかてかとした天窓を掻き、「かような頭を致しまして、あてこともない、化物｜沙汰を申上げまするばかりか、譫言の薬にもなりませんというは、誠に早やもっての外でござりますが、自慢にも何にもなりません、生得大の臆病で、引窓がぱたりといっても箒が仆れても怖な喫驚。",
              "citation": {
                "source": "湯女の魂",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫が屋根を渡り切って、その白い影がおまきの家の引窓のなかに隠れたのを見とどけると、彼女は娘の手を強く握って転げるように自分の家へかけ込んで、引窓や雨戸を厳重に閉めてしまった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "引窓がばた／＼と暗い口を開く。",
              "citation": {
                "source": "夜釣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "引窓に射す、何の影か、薄あかりに一目見ると、唇がひツつツた。",
              "citation": {
                "source": "夜釣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "臺所を出れば引窓から、縁に立てば沓脱へ、見返れば障子へ、壁へ、屏風へかけて映ります。",
              "citation": {
                "source": "三人の盲の話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "引窓に射す、何の影か、薄あかりに一目見ると、唇がひッつゝた。",
              "citation": {
                "source": "夜釣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばたりと煽って自から上に吹開く、引窓の板を片手に擡げて、倒に内を覗き、おくの、おくのとて、若き妻の名を呼ぶ。",
              "citation": {
                "source": "一景話題",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっと袖で囲ってお縫は屋根裏を仰ぐと、引窓が開いていたので、煤で真黒な壁へ二条引いた白い縄を、ぐいと手繰ると、かたり。",
              "citation": {
                "source": "葛飾砂子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "引窓の閉まる拍子に、物音もせず、五｜分ばかりの丸い灯は、口金から根こそぎ殺いで取ったように火屋の外へふッとなくなる。",
              "citation": {
                "source": "葛飾砂子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "履物が無かったばかり、髪も壊れず七兵衛が船に助けられて、夜があけると、その扱帯もその帯留も、お納戸の袷も、萌黄と緋の板締の帯も、荒縄に色を乱して、一つも残らず、七兵衛が台所にずらりと懸って未だ雫も留まらないで、引窓から朝霧の立ち籠む中に、しとしとと落ちて、一面に朽ちた板敷を濡しているのは潮の名残。",
              "citation": {
                "source": "葛飾砂子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "可惜、鼓のしらべの緒にでも干す事か、縄をもって一方から引窓の紐にかけ渡したのは無慙であるが、親仁が心は優しかった。",
              "citation": {
                "source": "葛飾砂子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
