[
  {
    "uuid": "d92db7c2-4dc4-5f17-869b-02624d195d81",
    "entry": "蟇目",
    "reading": {
      "primary": "ひきめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
