  {
    "uuid": "d373c0d3-d04a-5666-9e17-71fea00a2b94",
    "entry": "ヒタシ",
    "reading": {
      "primary": "ひたし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十七日　シヲヒタシ温泉ニ至ル。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月大　シヲヒタシ温泉所ニ帰ル。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭山の様にこれをタビラコだと信ずる人はマー一たびこれを煮てヒタシモノにでもして食って見たまえ。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅行好きの饗庭篁村翁も旅先から持ち帰った凡草を、いろいろ並べての御自慢、誰も一向珍しがらぬので躍起となり、「珍草通」の一文を草し、「こんど一本選りの珍草をうんととって来て、諸君に珍草のヒタシ物てえのを振舞おう」。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の言によると絶大と言ってもいいほど栄養のある植物だそうで、彼はそれをオヒタシにしたり、飯にたきこんだり、乾かしてお茶みたいにして飲んでいます。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
