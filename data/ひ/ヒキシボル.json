        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は怒りに声を震わせ、最後の言葉を引き絞るように言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は悲しみをこらえ、絞り出すように声を引き絞った。",
              "citation": {
