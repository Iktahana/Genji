  {
    "uuid": "0f144898-cc7e-57dd-b002-54e1b5532eb5",
    "entry": "引き出",
    "reading": {
      "primary": "ひきで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
