      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「天の一方に」は、「天一方望美人」というような漢詩から、解釈の聯想を引き出して来る人があるけれども、むしろ漠然たる心象の幻覚として、天の一方に何物かの幻像が実在するという風に解するのが、句の構想を大きくする見方であろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父も母も祖母も、耕二の話の時には兄が級長をしてゐた小学時代を引き出した。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんなところが登れようかね」と、岩壁の白い薙を指しながら、話の緒を引き出したところが、あすこは嘉門次が、つい去年、山葵取りに入りこんで、始めて登ったところで、未だ誰もその外に、入ったものはないと言うので、私はふと聞き耳を立てた。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "君のその論調でやられたのならば、今まで、一時の入用のために、自分の預金を引き出すために、どのくらい多くの労働者を、君は馘首したことになるだろう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はただ大きな腕が、自分をその牢獄から引き出してくれるのを待つばかりだった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の苦言もただヨブより哀哭の反覆を引き出したのみに終った。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝｜昴宿の鏈索を結ぶや、参宿の繋縄を解くや、汝十二宮をその時に従いて引き出だすや、また北斗とその子星を導くや。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当に、私はその時はじめて、この火事騒ぎは、私が夕方、お風呂のかまどの燃え残りの薪を、かまどから引き出して消したつもりで、薪の山の傍に置いた事から起ったのだ、という事に気づいたのだ。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "メロスは、王の前に引き出された。",
              "citation": {
                "source": "走れメロス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑場に引き出されても、平気でいました。",
              "citation": {
                "source": "走れメロス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか私が、貯金帳をいれてある書棚の引き出しの鍵を、かけるのを忘れていたら、あなたは、それを見つけて、困るね、と、しんから不機嫌に、私におこごとを言うので、私は、げっそり致しました。",
              "citation": {
                "source": "きりぎりす",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "集めた卵は綿でくるんで机の引き出しに一杯しまつて置いた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは本箱の右の引き出しに隠して在る。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにも用心深く徐々と身体を曲げて頭の見えなくなるまで挿し入れた、と思うと間もなく引き出した。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "行員に質してみますと、その時格別の大金などは引き出さなかつたさうですが、をかしいのは銀行へはいつて來た時非常に苛立つてゐたといふ事實です。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものその術で、背負引き出して、お前様｜天窓から塩よ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と嬉しそうにつと寄って、両手でがさがさと引き出して、立直って持って出て、縁側を背後に、端然と坐った、お君のふっくりした衣紋つきの帯の処へ、中腰になって舁据えて置直すと、正面を避けて、お君と互違いに肩を並べたように、どっかと坐って、「これだ。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「秋について」という注文が来れば、よし来た、と「ア」の部の引き出しを開いて、愛、青、赤、アキ、いろいろのノオトがあって、そのうちの、あきの部のノオトを選び出し、落ちついてそのノオトを調べるのである。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗い電気の下で兄は、私にあちこちの引き出しをあけさせ、いろいろの手紙や、ノオトブックを破り棄てさせ、私が、言いつけられたとおり、それをばりばり破りながらめそめそ泣いているのを、兄は不思議そうに眺めているのでした。",
              "citation": {
                "source": "兄たち",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは全部、むかし母から送られ、或る種の倉庫にあずけていたものを必要に応じて引き出して着ているのである。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖母を、あかるみに引き出すな！",
              "citation": {
                "source": "母",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
