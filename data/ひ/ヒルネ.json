[
  {
    "uuid": "a16d1efe-77b6-5256-b265-eb624bdc9dbd",
    "entry": "昼寝",
    "reading": {
      "primary": "ひるね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "(afternoon) nap",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お腹がいっぱいになると、ついウトウトして昼寝をしたくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "休日にたっぷり昼寝をしたら、夜に眠れなくなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "子供たちが昼寝をしている間に、たまっていた家事を一気に片付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "二階に昼寝してゐた汚ない顔の女給が、目をこすりながらいやみつたらしく出て来たのだ。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬢やはと聞くと、さっきから昼寝と答えたきり、元の無言に帰る。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は「五月蠅」と書いて「うるさい」と読み、昼寝の顔をせせるいたずらもの、ないしは臭いものへの道しるべと考えられていた。",
              "citation": {
                "source": "蛆の効用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後は奈々子が一昼寝してからであった、雪子もお児もぶらんこに飽き、寝覚めた奈々子を連れて、表のほうにいるようすであったが、格子戸をからりあけてかけ上がりざまに三児はわれ勝ちと父に何か告げんとするのである。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この会のエキスペジションで彼はインディアンの国土を見舞い、シカゴで始めて電車を見、またマイケルソンやローランドと親しく言葉を交わし、またエジソンの有名な昼寝を驚かした。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――僕はバルチックの軍艦に結婚を申込む、アンナ・ニコロ、今頃はモスクワの政治委員もアンナ・スラビナも昼寝をむさぼってる時間なのです。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "峻がここへ来る時によく見る、亭の中で昼寝をしたり海を眺めたりする人がまた来ていて、今日は子守娘と親しそうに話をしている。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど近所の百姓家が昼寝の時だったので、自分がその時起きてゆかなければどんなに危険だったかとも言った。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は五月蠅と書いてうるさいと読み昼寝の顔をせせるいたずらものないしは臭いものへの道しるべと考えられていた。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "神の昼寝の美事な寝顔までも、これ、この眼で、たしかに覗き見してまいりましたぞ。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "九天たかく存します神は、来る日も来る日も昼寝のみ、まったくの怠慢。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きょうはね、ちょっと重いものを背負ったから、少し疲れて、いままで昼寝をしていたの。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑休に先生から郷里へ帰省中の自分によこされたはがきに、足を投げ出して仰向けに昼寝している人の姿を簡単な墨絵にかいて、それに俳句が一句書いてあった。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとかで「たぬきの昼寝かな」というのであった。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このころからやはり昼寝の習慣があったと見える。",
              "citation": {
                "source": "夏目漱石先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん亜弗利加内地旅行だの、両極探検だのに比すれば、まるで猫の額を蚤がマゴついているようなものであるが、それでも、口をアングリ開けて昼寝をしているよりは、千倍も万倍も愉快に相違ない。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの家を覗いてみても、一人か二人昼寝をしておらぬ家は殆んど一軒もない。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴロゴロ昼寝ばかりしていずに、ドシドシ草鞋でも筵でも作って売ったらどうだ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "御褒美に遣わさるる石臼なれば可けれども＝＝この坊主を輪切りにして、スッポン煮を賞翫あれ、姫、お昼寝の御目覚ましに＝＝と記してあろうも計られぬ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "落人のそれならで、そよと鳴る風鈴も、人は昼寝の夢にさえ、我名を呼んで、讃美し、歎賞する、微妙なる音響、と聞えて、その都度、ハッと隠れ忍んで、微笑み微笑み通ると思え。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、炎天、人影も絶えた折から、父母の昼寝の夢を抜出した、神官の児であろうと紫玉は視た。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、勝手に通抜けの出来る茶屋は、昼寝の半ばらしい。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛍にはまだ暮れ果てず、立帰り候が、いかに逗子の風の、そよとも御あたりにかよひ候はば、お昼寝におつかひ下され度候。",
              "citation": {
                "source": "逗子より",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼寝はよいかな、まさに一刻千金に値する（二刻は百金！",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "今宵は十五夜である、月がうつくしかつた、昼寝したゝめに、そして多少興奮してゐるために、いつまでもねむれなかつた。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼寝は長すぎたが、連日のつかれをすつかり解消した。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝蝉はよいな、敬坊いふ『こゝは極楽浄土だ』山は答へる、『さびしい浄土だ』樹明君来庵、なが／＼と寝た、私はなるだけ昼寝をしないやうにしてゐる、それでなくても夜中寝覚勝だから。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕立がやつてきた、折よく観音堂で昼寝。",
              "citation": {
                "source": "行乞記",
                "author": "仙崎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――仙崎まで三里の間、行乞しつゞけた、中途で橋の下の草の上で昼寝などして。",
              "citation": {
                "source": "行乞記",
                "author": "仙崎",
                "note": "青空文庫"
              }
            },
            {
              "text": "追加・おべんとうをひらく雀も何やら食べてゐる・昼寝覚の夕立の水音が鳴りだした　八月十八日昨夜は二人共安眠熟睡だつた。",
              "citation": {
                "source": "行乞記",
                "author": "仙崎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
