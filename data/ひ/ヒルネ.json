        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "するとこれが案外親切な巡査で戸籍簿のようなものを引っくり返して小首を傾けながら見ておったが後を見かえって内に昼ねしていた今一人のを呼び起した。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その木の皮を石でたたきつぶすと、いいにおいがしたので、おとなたちが、昼ねをしている昼さがりなど、三人で、まるできつつきのように、木のみきをコツコツとたたいていたりしました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼ねから醒めて、体を洗って、新しい仕事を考えながら二階で風にふかれていたら、不図思いついて狭い濡縁の左の端れまで出てみたら、そこから四つばかりの屋根を越してあなたも御存じのもとの私の家の二階の裏が見えました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "健坊がおきたら参りましょう、今二時、昼ねよ、健坊はね、さっきわたしに抱かれて体をじかに撫でられているうちにトロンコになって眠ってしまったのよ、笑い乍ら。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼ねふる青鷺の身のたふとさよ　　　蕉　しよろしよろ水に藺のそよくらん　兆　これは凡兆の付け方、未しきやうなり。",
              "citation": {
                "source": "雑筆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅太郎昼ねしたり、小谷耕蔵面会ス。",
              "citation": {
                "source": "坂本龍馬手記",
                "author": "イロハ丸航海日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお姉さま、「ほんと長々としたお昼ねだこと。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお姉さま、「もう、長々としたお昼ねだこと。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "めしものは　きたない、　お昼ねのときにも　いつも　くつを　はいたまま　ベッドに　入る、　しかも　もぐりこむ　ねどこは　だいたい　きつねめさんの　ものでした。",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "若者の強力ひとり　昼ねして居り霊まつりこの宵や　祖々のみ霊来ますなり。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
