        "examples": {
          "standard": [
            {
              "text": "「法隆寺の回廊など、都の歴史的な寺院の多くが飛騨の匠の手によって建てられた」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「飛騨の匠は釘を一本も使わずに木材を組み上げる高度な技術を持っていた」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「租税の代わりに大工仕事を担うべく、毎年多くの男たちが飛騨の匠として都へ送られた」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "遣戸というものをしめ、声の通うだけの隙があけてある所で、「飛騨の匠が恨めしくなる隔てですね。",
              "citation": {
                "source": "源氏物語",
                "author": "東屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "新室のほかひに来た神と神に仮装した後代の番匠との聯絡が忘れられて、飛騨の匠や竹田の番匠など言ふ、建築の名人の名を神に代入したのである。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            }
          ]
        }
