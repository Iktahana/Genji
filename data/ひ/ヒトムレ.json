    },
    "definitions": [
      {
        "index": 1,
        "gloss": "group",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一群れの渡り鳥が、夕焼けに染まる空を北に向かって飛んでいく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "駅のホームで、一群れの観光客が大きなスーツケースを持って右往左往していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "海面に一群れの小魚が跳ねて、キラキラと銀色に輝いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "唯、達沢が教頭席に腰を下した儘、前方のゴタゴタした一群れ――それは何か分らぬ――に向つて、その太い腕を得意気に振廻してゐる光景のみが、彼の目に見えてゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "田はその昔、ある大名の下屋敷の池であったのを埋めたのでしょう、まわりは築山らしいのがいくつか凸起しているので、雁にはよき隠れ場であるので、そのころ毎晩のように一群れの雁がおりたものです。",
              "citation": {
                "source": "あの時分",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩を転じてかしこなる躑躅の丘に上らんとて、池に添いつつ歩めるとき、かなたより来たりたる、一群れの観客あり。",
              "citation": {
                "source": "外科室",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一群れの迹に残りて語合う女あり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどこれのみにては、なおわが地位を覆すに足らざりけんを、日ごろ伯林の留学生のうちにて、ある勢力ある一群れと余との間に、おもしろからぬ関係ありて、かの人々は余を猜疑し、またついに余を讒誣するに至りぬ。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "近い道を物詣りにでも歩くのなら、ふさわしくも見えそうな一群れであるが、笠やら杖やらかいがいしい出立ちをしているのが、誰の目にも珍らしく、また気の毒に感ぜられるのである。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一群れはしばらく黙って歩いた。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "――――――――――――　荒川にかけ渡した応化橋の袂に一群れは来た。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから一群れは河原に降りた。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一群れは石垣に沿うて材木の下へくぐってはいった。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一群れの客を舟に載せて纜を解いている船頭がある。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子の目から見た親類という一群れはただ貪欲な賤民としか思えなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どや／＼と乗り込んだ一群れの人に交つて二人は明るい車の中にその姿を置いた。",
              "citation": {
                "source": "散歩",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて暇を告げた医師は、ちょうどそこに酸漿提灯を篠竹の先につけた一群れの行列が、子供や若者に取り巻かれてわいわい通って行くのに会った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一群れと数間を隔てて、朱舜水の一行が歩いて行く。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先を歩いている君尾の一群れ、そこから笑い声が聞こえてきた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時君尾の一群れでは、面白い話がはじまっていた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "北窓から眺めると欅の大木が一群れ秋空に色づきかかっていて、おりおり郊外電車の音がそっちの方から聞えてくる。",
              "citation": {
                "source": "新しい婦人の職場と任務",
                "author": "――明日の婦人へ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば焚火をかこんでゐるのは一群れの妖怪で、そのみつともいい御面相といつたら、これが他の場合だつたら、何を犠牲にしたつて、こんな化物とちかづきになるのは真平だつたらう。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥えた尻に短く切つた尾の凜々しく垂れてゐる栗毛と鹿毛とを怖さうに遠くから取り圍んで、わい／＼囃してゐる子供等の中には、大人もだいぶゐた、其の一群れの中から、お光は今年始めて學校へ通ひ出した娘のお勝を見出して、お梅に連れ戻らした。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "將校の朗かな號令の聲が、鎭守の方に聞えてから暫くすると、ドヤ／＼ガチヤ／＼と、靴の音、サーベルの音を立てゝ、一群れの子供等に附き纏はれつゝ、十人あまりの兵隊がお光の店へ入つて來た。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、由吉や塩野らの一団の上を見廻しながら、これらの人人も何らかの病根を抱いてそれぞれ苦しんでいる一群れだが、果して存命のうちにその病いは取り去ることが出来るかどうか、疑わしいことだと思った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かな湖を包む蒼い山々の襞、その手前に一群れの人家は、目的の元箱根の街に違いない。",
              "citation": {
                "source": "箱根の山",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "一群れになって、中空をさーっと飛んで、近くの木立へ遊びに行きました。",
              "citation": {
                "source": "椎の木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一群れが飛びたつ羽風に、椎の古葉がいくつも散って、はらはらとまい落ちました。",
              "citation": {
                "source": "椎の木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊190　創作に、生き甲斐を見いだす、あの詩人の一群れを、そのままにしておこう。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一群れは足並揃えて粛々とこっちへ近寄って来る。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一群れの家並を通り過ぎ辻に付いてグルリと廻ると突然広い空地へ出たが、その空地の遙か彼方にあたかも大名の下邸のような宏荘な建物が立っていた。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　庭のかなた、百日紅の白っぽい幹を交えて椿がこんもりと茂ってるのを背景に、大きな自然石が配置され、その石のたもとに、黄色い葉が僅か散り残ってる一群れの山吹があった。",
              "citation": {
                "source": "無法者",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝日の光りがさしてくると、ぱっぱっと、一群れずつ飛び立ち、四散して、どこかへ行ってしまう。",
              "citation": {
                "source": "小さき花にも",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
