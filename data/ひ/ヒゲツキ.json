          "literary": [
            {
              "text": "「なるほど、ヒゲツキ節ですなあ」　はに子、よろこびの余りに、トラになり、社長さんとまちがえて、やたらにぼくへ杯をもってくる。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｈさんは、昨夜御紹介いたしたヒゲツキ節の宗家で、別名、無尽会社の社長さん。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒゲツキ節は、本社が近すぎるせいか、今夕はお休み。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
