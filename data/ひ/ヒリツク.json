    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「ひりつくようです。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "咽喉がひりつくやうに痛んだ。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "のどが、ひりつくやうに渇く。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭が割れるように痛み、咽喉はひりつくような激しい渇きをおぼえた。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その眼路のはるかつきるまで、咽喉のひりつくような白くかわいた道がつづいていた。",
              "citation": {
                "source": "白い道",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうノドが、ひりつくようで――花岡　（村子の方へ寄ってゆく）よしよし、俺という男は、そういった人間だ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争でもあると、お父様は喉のひりつくようなこともあるし、深傷を負うことだってないとはいえないでしょう。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "苛立ちながら、また北東への不可解かつ畏敬を交えた記憶を揺り動かすような渇望という笞によってある種の捻くれた熱意へと追い込まれながら、邪悪な、ひりつくような月光の下、私は重い足を進めていた。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "おせんは静かに身を起こした、足がわなわなと震えだし、喉がひりつくように渇いた。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
