[
  {
    "uuid": "2cdf5912-c892-5d16-8d0f-6c3977b49668",
    "entry": "婢女",
    "reading": {
      "primary": "ひじょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
