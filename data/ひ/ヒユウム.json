        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "むかし英吉利にダヴヰツド・ヒユウムといふ懐疑派の哲学者があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒユウムは蛙のやうな恰好をして、泥濘のなかを泳ぎまはつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒユウムは人生問題の研究も、何もかも忘れてしまつて、身体ぢゆう泥だらけになつて※いたが、さて何うする事も出来なかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前さんはヒユウムさんぢやないかね。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、婆さんはやつと安心したやうに手を出してヒユウムを引張り上げてくれた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
