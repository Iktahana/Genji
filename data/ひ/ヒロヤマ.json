        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「上戸も死ねば下戸も死ぬ風邪」で、毒酒の美さに跡引上戸となつた将門も大酔淋漓で島広山に打倒れゝば、「番茶に笑んで世を軽う視る」といつた調子の洒落れた将平も何様なつたか分らない。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の中にどん／＼と路を走り、葉広山まで担いで駈上ります。",
              "citation": {
                "source": "敵討札所の霊験",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
