          "literary": [
            {
              "text": "また尾張の連等の祖先のオホシの連の妹のメコの郎女と結婚してお生みになつた御子はヒロクニオシタケカナヒの命・タケヲヒロクニオシタテの命のお二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にヒロクニオシタケカナヒの命も天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "安閑天皇　御子のヒロクニオシタケカナヒの王（安閑天皇）、大和の勾の金箸の宮においでになつて、天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
