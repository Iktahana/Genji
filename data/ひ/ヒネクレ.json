[
  {
    "uuid": "896eda07-3a44-5ae4-b7c2-b2f2efd56347",
    "entry": "ヒネクレ",
    "reading": {
      "primary": "ひねくれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
