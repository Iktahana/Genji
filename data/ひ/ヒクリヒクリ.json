          "literary": [
            {
              "text": "すぐに安物らしい白地の博多帯をさぐってみると……どうだ……ムクリムクリ……ヒクリヒクリと蠢く胎動がわかるではないか……たしかに姙娠五箇月以上である。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "頬の肉をヒクリヒクリと引釣らせながら、哀願するように女将の顔を見上げた。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……と見るうちに下唇を深く噛んで、白い小さな腮を、ヒクリヒクリとシャクリ上げはじめた。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
