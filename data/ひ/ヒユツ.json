          "literary": [
            {
              "text": "草津から二里あまり登つて芳ヶ平、ヒユツテーがある、スキーの盛んなことだらうなどゝ思ひつゝ歩いた。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、ヒユツ、ヒユツといふ音を立てて、潮煙を立てた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれ等あらゆる物は一つになつて、革紐か何かのやうに、ヒユツ、ヒユツいひ、打つかり、傷つけた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "闇を剪つて一枚、二枚、三枚、ヒユツ、ヒユツと飛びます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "濡れた千兩箱",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
