          "literary": [
            {
              "text": "アイロニイという一つの知的性質はギリシア人のいわゆるヒュブリス（驕り）に対応する。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギリシア人のヒュブリスは彼等の怒り易い性質を離れて存しなかったであろう。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイロニイといふ一つの知的性質はギリシア人のいはゆるヒュブリス（驕り）に對應する。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギリシア人のヒュブリスは彼等の怒り易い性質を離れて存しなかつたであらう。",
              "citation": {
                "source": "人生論ノート",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "然らざれば、単なる道徳的自尊として一種のヒュブリスたるに過ぎない。",
              "citation": {
                "source": "絶対矛盾的自己同一",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
