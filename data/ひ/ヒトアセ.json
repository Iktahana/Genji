[
  {
    "uuid": "22b43cb7-c8ea-53fd-b194-b67d4157ec81",
    "entry": "一汗",
    "reading": {
      "primary": "ひとあせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
