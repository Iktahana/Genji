    },
    "definitions": [
      {
        "index": 1,
        "gloss": "doing a job",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大掃除の前に、まずは部屋の片付けで一汗かこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重い荷物を運んで、やっと一汗かいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "週末は庭の手入れで一汗かくのが、彼の趣味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "途中で日の出温泉というのが目についたので、一汗流して行こうとなった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬でも朝食前に一汗かかぬと気持ちが悪かったらしい。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎鮫どもが、一汗入れているうちに、五十人のキャメラマンによって海底から撮影されたただいまの猛攻撃のフィルムは、ただちに上にはこばれ、まず第一に現像工場内にベルトでおくられ、わずか一分間で反転現像された。",
              "citation": {
                "source": "軍用鮫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめ彼女は、私の弁解を素直にきいて、では少しの間待つてゐておくれ、一汗絞つて清々としてから今度こそは面白く相手になつて遊ぶからといふ約束だつた。",
              "citation": {
                "source": "海棠の家",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一汗小母さんがかいて自分の賞品のわきへどくと、音楽は一寸止み、今度は火花の散るような急調な舞踏曲がはじまった。",
              "citation": {
                "source": "ソヴェト同盟の三月八日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……まずもって船を向こう岸へ着けてよ、上総屋あたりへ引っ張り込んでよ、介抱申し上げて一汗かけば、女ってやつ他愛はねえ、九十郎さんへと云ってたやつが団八さんへと変わってしまう）　都合のいいことを考えていた。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「此馬に一汗かかせてくれよう」　源三郎は大声に、「つづけっ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はこの野郎と一汗掻く」「何を無禮」「御用だぞツ」　平次はパツと石卷左陣に飛びかゝつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "紅い扱帶",
                "note": "青空文庫"
              }
            },
            {
              "text": "一汗かくことや、疲れることにも何かしら美徳があったんだ。",
              "citation": {
                "source": "ＲＵＲ――ロッサム世界ロボット製作所",
                "author": "R.U.R. (ROSSUM'S UNIVERSAL ROBOTS)",
                "note": "青空文庫"
              }
            },
            {
              "text": "「駕屋、一汗拭け」「ありがとう存じます。",
              "citation": {
                "source": "無宿人国記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして何かの運動でこれに一汗かかせた後でなければ、決して食べ物をやらなかった。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "五階で「女夫」を動きをつけ、一汗。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべは一晩じゅう、よく眠れなかったのである、あんなに悶えたり泣き悲しんでいた朱実のほうは、暖かい蕎麦湯をすすると、一汗かいて、深々と眠りに落ちてしまったが、丹左のほうは、明け方まで、まんじりともしなかった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "人も駒も、一汗かいて、野から帰って来る頃に、陽は朝霧を破って山のうえに昇っていた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで燕作さまは、このへんでじゅうぶん一息いれてゆくとしようか」　腰の手拭をとって風車にまわしながら、一汗ふいて、またもやあとからかけだした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、ほっと一汗、肱でこすったが、果たして弾が思うように飛ぶか否か――は、まだ十分に自信がない顔だった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏だし、道は嶮岨だし、具足着ではあるし、追う方も追うほうだったが、逃げまわる天蔵の同勢も、逃げつかれて来たものとみえ、道々、荷を捨て、馬を捨て、だんだん身軽になって百月川の谿谷で、空腹へ川の水を入れ、ぐったり一汗ふいていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うう、暑い」「こんな日もめずらしいて」　一汗拭いて、「見てくれ、俺の汗を。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "一汗ぬぐって、「九右衛門」　と、よび、「石井山の山鼻から、この門前までの距離は」「一里足らず。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "何のかのと駄々をこねるんで、大の男が一汗かいてしまいましたよ。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はて、何処へ隠れたのだろうか」　くずれた土塀の根石へ腰をおろして、一汗ふいていた時であります。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝も的場で一汗しぼって、本丸の道灌堀からお駕台の附近へ、早咲きの梅を見ながら歩いてきた吉宗、ごつい木綿の平服に結城の袴をつけ、「源次郎、そちの歩き方を見ると、まるで締まりがないぞ。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご高家仕えのご用人さんだから荒っぽい痛み吟味もできねえし、どうしたもんだろうとひと汗絞るところだったが、万事がおあつらえ向きだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "――昼湯にでもいってひと汗流してきたばかりらしく、青ざおとした月代に、ふた筋三筋散りかかるほつれ毛を風になぶらせながら、夏なおりりしくすがすがしい姿をにこやかにぬっと現わしたので、すっかりめんくらったのは伝六親方でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、養玉院にある高尾の碁盤と将棋盤、これは今日まで別条無しに保存されているのですが、一方の薄雲の方は大いに別条ありで、それが為にわたくし共もひと汗かくような事件が出来しました」　ここまで話して来た以上、どうで聞き流しにする相手でないと覚悟しているらしく、老人はひと息ついて又話しつづけた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "薄雲の碁盤",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹ができたら、ひと汗かこか。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "しょうがねえ、ひと汗かきに行くとするか」　と言って、もう一度、三階のほうを見あげ、「前後の模様から推すと、おもんは別れてからも、藤五郎の留守にチョクチョク吉兵衛をひっぱりこんでいたんだと見えるな」　十吉はうなずいて、「まず、そのへんの見当で。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "永代経",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひと汗ながしたいんだが」と直衛は云った、「誰か相手にならないか」　岡倉がすぐに「私がお相手しましょう」と云って、表道場のほうへ走ってゆき、竹刀を持って戻った。",
              "citation": {
                "source": "改訂御定法",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふしぎなほど鈍っていないね」彼がひと汗かいて道具をぬいだとき、眺めていた市蔵が笑いながらこう云った。",
              "citation": {
                "source": "葦",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――と、思われると、「止めよ」　と、駒を抑え、前後の旗本たちを顧みて、「ひと汗、拭おうぞ」　と、いった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
