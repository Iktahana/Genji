[
  {
    "uuid": "a5c6589d-fd79-592a-b33f-11f4c48fbc5b",
    "entry": "一騒ぎ",
    "reading": {
      "primary": "ひとさわぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
