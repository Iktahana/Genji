        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのプロレタリア街の、製材所の切屑見たいなバラックの一固まりの向うに、運河があった。",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "百人位一固まりになった労働者が「武藤奪還」のために警官達と競合いながら、橇の後を追った。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "旗本は、一固まりになって、小さく、無言で俯いていた。",
              "citation": {
                "source": "近藤勇と科学",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "外は寒かったが、暖かい土の中に埋もれていた死体は、外からも、内部からも腐敗しかけていて、髪の毛は、一固まりになって、剥け落ちていたし、脣は、黒くなって腐り、歯が剥き出していて、人々へ怨恨を訴えているように見える。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな溝を隔てて（この町は至るところ溝川が縦横に貫通しているので）、大通りと並行しているミハイロフ通りへ出ようと思って、広場を通り抜けて横町へ曲がったとき、小さな橋の手前で一固まりになっている、小学生が眼にはいったのである。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "…………………………　ひとかたまりの童児、広い野はらに火三昧して遊びふけっていたずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "兇暴の風雨に対して、小さい家々が、ひしとひとかたまりになつて互ひに庇護し合つて立つてゐるのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "村のひとたちは毎夜毎夜あちこちの家にひとかたまりずつになって相談し合った。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで注意を集注していた研究事項の内容がひとかたまりになって頭の中にへばりついたようなぐあいになってそれがなかなか消散しない。",
              "citation": {
                "source": "映画と生理",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十人、八十人、百何人、ひとかたまりの若い衆の顏は、目が据り、色は血走り、脣は青く成つて、前向き、横向き、うしろ向。",
              "citation": {
                "source": "祭のこと",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の夜秋の夜など、雨もたぬ空の晴れたるに、ひとかたまりの雲のゐのこの如く丸く肥えて見ゆるが、月のあたり走り行くは人々の知るところなるが、これもまた風情ある雲なり。",
              "citation": {
                "source": "雲のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧師は何やら二人をいさめているようで、三人ともひとかたまりになり祭壇の前に立っていた。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "」我々一同が表の間へぞろぞろ入り、中央の卓を囲んで席に着くなか、警部は小さなブリキの角箱を開けて、ひとかたまりの色々な物品を面前に並べて見せた。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "足なえのこじきがひとかたまり、そこの入口に陣取っていました。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとかたまりの大きな雲が、すぐうしろにぬっとあらわれましたが、それはどこからみても、ほんとうの山でした。",
              "citation": {
                "source": "野のはくちょう",
                "author": "DE VILDE SVANER",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人の心は、ひとかたまりの氷のようになってしまうのです。",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸にひとかたまりになって船を見送る女たちの群れはもう命のない黒い石ころのようにしか見えない。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しひとかたまりの霧は幾千年の人間の努力を塵の如くにふみにじつてしまつたのではないか。",
              "citation": {
                "source": "潮霧",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は彼女の飛び越えた所にひとかたまり落ち散った花を、気ぜわしく拾い上げた。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "追っ手かと三人は屹と見かえると、それは十四五人であるらしく、この木枯しに松明を奪われたのか、但しはわざと灯を持たせないのか、暗い中をただひとかたまりになって、葬列のようにひそひそと歩んで来た。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを抜こうとする腕の上に新九郎が又乗しかかって来たので、三人はひとかたまりになって再びころげた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "小坂部は彼に扶けられながら、その水甕を踏台にして高い窓から覗いて見ると、秋の青空の果てに唯ひとかたまりのうす黒い雲が小さく浮かんでいた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "外の嵐はまだ吹きつづけて、黒い雲のひとかたまりが家根の上へ低く舞いさがってきた。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "集団して生きる部族の政治は、ひとかたまりに生きてゆくやりかた、としてはじまって、やがて階級分化を行った人の集団と集団間のいきさつとなっていった。",
              "citation": {
                "source": "作家の経験",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのために、うちすてられた開拓団のいくつかは、数百名をひとかたまりとして女から子供まで、絶滅させられた。",
              "citation": {
                "source": "ことの真実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「家」は、家庭を単位として扱われることになり、そこには夫と妻と子供たちとのひとかたまりが、基本として考えられるようになった。",
              "citation": {
                "source": "離婚について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "町角に、近所の人達がひとかたまりになって、ワイワイ話しあっている。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いけだしと白いふくらっぱぎ、群集も舞台もひとかたまりになって何かワンワン唸りあっている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいわいにも、針目博士の家は、曾祖父の代からずっと医学者がつづいており、曾祖父の針目｜逸斎、祖父の針目｜寛斎、父の針目｜豹馬と、みんな医学者であり、そして邸内に、古めかしい煉瓦建ではあるが、ひじょうにりっぱな研究室や標本室、図書室、実験室、手術室などがひとかたまりになった別棟の建物があったのである。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりは、まっくろなけむりでおおわれ、まるで夕立雲がひとかたまりになって下りてきたようなありさまです。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
