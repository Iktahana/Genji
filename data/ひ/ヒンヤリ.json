  {
    "uuid": "0babf2f6-2043-5181-bfa0-49bd5cb8fd3c",
    "entry": "ひんやり",
    "reading": {
      "primary": "ひんやり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "苔はまことに、ひんやりいたし、いはうやうなき、今日の麗日。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、ひんやり寒い。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲団が冷いので、背中がほどよくひんやりして、ついうっとりなる。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひんやりした夜氣が急に體にぞくぞく感じられて來た。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとびとが宵の寝苦しい暑さをそのまま、夢に結んでいるときに、私はひんやりした風を肌に感じている。",
              "citation": {
                "source": "秋の暈",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "この邊の地は、山に圍まれた高地なので、夏の夜も十一時頃になると、空氣は肌にひんやりとして來た。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "当然日本橋から先に探って須田町湯島下と、七つの捨て駕籠を順々に追いながら見調べていくだろうと思われたのに、ひんやりとえり首に冷たい朝風を縫いながら、すいすいとやっていったところは、意外や土橋ご門の方角なのでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "高崎あたりから、うすぐもりの空となり、熊の平では、かしこの峰、ここの谷に、うす白い霧がまい下りて、ひんやりと浮世ばなれのした風が、窓から出した頬を吹きわたるのだった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "新子の屋根裏に近い部屋は、電燈の灯ったままで、ひんやりと、明方の空気が肌寒かった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "地面が絶えずジメジメして、しだが生えており、空気がひんやりしていた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "峠道にかかると、楓や樅やぶなの樹などが、空もかくれるほど枝を交していて、一そう空気がひんやりとして陽の色も暗くなった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その外套の裏側に滲み込んでくるひんやりした感じを、はっきり指先で味わって見た彼は小林を顧みた。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "石炭庫の口が半開きになって、ひんやりした真暗な内を、無気味に覗かせていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "何十人かのあかのついた鯣のやうな夜具の襟が、ひんやりと氣持わるく頬に觸つた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "快晴にめぐまれた日で、秋の木の葉がサラサラとさやぎ、外気はひんやりと……。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "閨　もうこの部屋にはないはずのおまへの柩がふと仄暗い片隅にあるし、妖しい胸のときめきで目が覚めかけたが、あれは鼠のしわざ、たしか鼠のあばれた音だとうとうと思ふと、いつの間にやらおまへの柩もなくなつてゐて、ひんやりと閨の闇にかへつた。",
              "citation": {
                "source": "小さな庭",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はときどき、走り廻った揚句など、火照る感覚の向に、ひんやりした西空の翳をおもい出すことがあった。",
              "citation": {
                "source": "雲の裂け目",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "急に嵐のないだあとの様になった部屋の中に居られない様にはだしのまんま千世子は裏から砂をすべって浜に出てなめらかにひんやりする砂に座った。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄の手帳　雪こそなけれ、一造兄さんのこもっていた穴は、ひんやりと肌さむい。",
              "citation": {
                "source": "雪魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の冷気がひんやりとはだえに迫る。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌の中に、ひんやりとした感じがつたわる。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝過ごしたのが気恥ずかしくて、いそいで、起きようとすると、夢で泣いたものか、枕紙がひんやり湿っている。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけに、ここでこうして、浴衣を着てくつろぎ、ひんやりした座布団に座り、よろしき声の女中たちのもてなしを受けて、美しい調度品に囲まれているのは、一九世紀西洋のあらゆる不満足さから解放される気分で、ほっと安堵した。",
              "citation": {
                "source": "夏の日の夢",
                "author": "THE DREAM OF A SUMMER DAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは薄暗くて、ひんやりとした静寂な場所でした。",
              "citation": {
                "source": "男子の本懐",
                "author": "A WISH FULFILLED",
                "note": "青空文庫"
              }
            },
            {
