        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は海外から飛行機で飛来し、空港で家族と再会した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "国賓が専用機で飛来するたびに、空港周辺は厳重な警備が敷かれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は遠い国から、最新の技術を携えて飛来した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
