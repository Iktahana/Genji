[
  {
    "uuid": "aff25ed2-b682-5f30-a540-fd43b4a608f2",
    "entry": "飛来",
    "reading": {
      "primary": "ひらい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
