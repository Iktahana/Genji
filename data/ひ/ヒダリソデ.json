        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「上着の左袖に七つも泥の跳ねがございます。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お金は……」　万平は左袖に抱えていたタイルの褌包みを差出した。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅の鮮血がジュパーンの左袖を真赤に染めた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎が近づいて行くと、恭一は、梯子段をおりたところで、自分のからだをぴったりと次郎のからだにこすりつけて、ふところにしていた右手を、すばやく次郎の左袖に突っこんだ。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ダラリとさがっている左袖をゆすって見せる）炭車のウインチに持ってかれて、こうだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左袖に花をつけたおそ桜二、三本。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "村道は本舞台にかかるとすぐ二つに分れて、一方は左袖へ消え、一方は右に曲って、水田の中を斜めに断って、右奥へ曲って消えている。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "学生服の左腕が肩の所から無く、上着の左袖はポケットの中に突込んでいる。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "村道は本舞台にかかるとすぐ二つに分れて、一方は左袖へ消え、一方は右に曲って、水田の中を斜に断って、右奥へ曲って消えている。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、破れたシャツの左袖から、龍と花とがのぞいているのに気づくと、あわてて着物を左肌だけ着た。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "救急隊員の一人は赤毛、もう一人は左袖に赤チンのシミがある。",
              "citation": {
                "source": "最愛の君",
                "author": "Ｈ・ビーム・パイパー　H. Beam Piper",
                "note": "青空文庫"
              }
            },
            {
              "text": "激戦の後と見え、緒もゆるんだのか兜もあみだになり、鎧の左袖を春風になびかせ、白旗をさっと押し立てて、砂煙黒く蹴立てて飛ばしてくる。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第九巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
