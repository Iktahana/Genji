        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕はただ彼のことをヒサイダさんと称していた。",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はこのヒサイダさんに社会主義の信条を教えてもらった。",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、日露戦争中の非戦論者に悪意を持たなかったのは確かにヒサイダさんの影響だった。",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒサイダさんは五、六年前に突然僕を訪問した。",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "（僕に白柳秀湖氏や上司小剣氏の名を教えたものもあるいはヒサイダさんだったかもしれない）それはまだ中学生の僕には僕自身同じことを見ていたせいか、感銘の深いものに違いなかった。",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
