    "definitions": [
      {
        "index": 1,
        "gloss": "mounting (a picture)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代の貴重な掛け軸を手に入れたので、技術に定評のある馴染みの職人に表具の修理を依頼した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "表具の仕上がり一つで、中身の書画の持つ気品や力強さが何倍にも引き立てられるから不思議だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "秋の展覧会に向けて、寺院に所蔵されている古い涅槃図の表具を新しく作り直すプロジェクトが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "作楽井は器用な男だったので、表具やちょっとした建具左官の仕事は出来る。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどの談は永助に来て、先方は表具屋の娘だったから、これも永助の意嚮を訊かぬうちに有耶無耶になった。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "拓本職人は石刷りを法帖に仕立てる表具師のようなこともやれば、石刷りを版木に模刻して印刷をする彫版師のような仕事もした。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから自ずから彼は表具もやれば刀を採って、木彫｜篆刻の業もした。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その目的の為めでもなかつたが、私は偶然少女の茶店の隣の表具店に写経の巻軸の表装を誂へに行つて店先に腰かけてゐた。",
              "citation": {
                "source": "蔦の門",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "表具店の主人は表装の裂地の見本を奥へ探しに行つて手間取つてゐた。",
              "citation": {
                "source": "蔦の門",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんどの談は敬吉に来て、先方は表具屋の娘だったから、これも敬吉の意見をきかぬうちに有耶無耶になった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "引越し道具のほか、家具屋、表具屋、仏壇屋などから持ちこまれる品物の配達をしているのだが、小型トラックがなくなった上に近頃は手不足で折角の依頼を断ることが多いと聴いていたので、君枝は早速掛け合ってみた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手は表具屋の息子で、それ、あんたも知ってるやろ、昆布茶一杯でねばって、その代りチップは三円も呉れてた人や。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの馬の骨か分らんようなでん公の種を宿して、認知もしてもらえんで、子供に肩身の狭い想いをさせるより、表具屋の息子が一寸間アが抜けてるのを倖い、しつこく持ちかけて逐電し、表具屋の子やと否応はいわせず、晴れて夫婦になれば、お腹の子もなんぼう幸せや分らへん。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが道具屋や表具屋や骨董屋の多い八幡筋。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "圖畫の老教師Ｈが表具屋、繪具屋等と生徒との間でえらくサヤを取つてゐること。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手は表具屋の息子で、それ、あんたも知ってるやろ、タンチー一杯でねばって、その代りチップは三円も呉れてた人や。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの馬の骨か分らんようなでん公の種を宿して、認知もしてもらえんで、子供に肩身の狭い想いをさせるより、表具屋の息子が一寸間ァが抜けてるのを倖い、しつこくもちかけて逐電し、表具屋の子やと否応はいわせず、晴れて夫婦になれば、お腹の子もなんぼう倖せや分らへん。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "引越し道具のほか、家具屋、表具屋、仏壇屋などから持ちこまれる品物の配達をしているのだが、近頃は手不足で折角の注文を断ることが多いときいていたので、君枝は早速掛け合ってみた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、父は、その天神様の絵を表具屋にやって、表装してくれた。",
              "citation": {
                "source": "再度生老人",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは十三四歳の茶坊主で、待たせてある喜右衛門に茶でも運んで来たのかと思うと、かれは一向に見向きもしないで、床の間にかけてある紙表具の山水の掛物に手をかけた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "一つ目小僧",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃ふと思い出して、ああしておいては転宅の際などにどこへ散逸するかも知れないから、今のうちに表具屋へやって懸物にでも仕立てさせようと云う気が起った。",
              "citation": {
                "source": "子規の画",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には、階下へ降りて、亭主が襷掛で弟子を相手に働いて居る方へ行つて、大きな板の上に裏打される表具を眺めたり、高い壁に添うて下張されてある絵を見せて貰つたり、二年越もしくは三年越に貯へてあるといふ古い糊の講釈を聞いたりして、復た二階へ戻つて来て見ると、何時でも病人の顔色が悪かつた。",
              "citation": {
                "source": "死の床",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃｜不圖思ひ出して、あゝして置いては轉宅の際などに何處へ散逸するかも知れないから、今のうちに表具屋へ遣つて懸物にでも仕立てさせやうと云ふ氣が起つた。",
              "citation": {
                "source": "子規の畫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
