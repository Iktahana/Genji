[
  {
    "uuid": "68b650cf-fa92-5321-babd-08c6c1f44118",
    "entry": "人肌",
    "reading": {
      "primary": "ひとはだ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
