        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "色の青白い、瘠せた、胸の薄い、頭の大きいのと反比例に首筋の小さい、ヒョロヒョロした深谷であった。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "野球のチャンが二人でようやく載っけることができた、仮の墓石を、深谷のヒョロヒョロな手が軽々と持ち上げた。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "三上は波止場に来て、昨夜つないだ船の伝馬にヒョイッと飛び乗った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "下手な田舎芝居の女形を思わせる色の黒い、やせたヒョロヒョロの、南瓜のしなびた花のような、女郎上がりのおばさんだった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、すぐにヒョコリと現われた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな、ヒョットコの鼻つまりみたいな顔をしていても、案外、天才なのかも知れない。",
              "citation": {
                "source": "渡り鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩くとき、身体全体がヒョク／＼した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかしいヒョウキンな奴だ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「中尉殿、ヒョウキンな話をして居るだけであります。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒョウキンな奴でもなんでもいかん！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョク／＼して、外見は、えげつない歩き方をしていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "番人が、番人小屋の方へ行ってしまうと、僕等は、どこからか、一人ずつヒョッコリと現われて来た。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時赭土の家からヒョイと一人の中山服が顔を出した。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は鰯のようなヒョロヒョロの星やめだかのような黒い隕石はみんなパクパク呑んでしまうんだ。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな甲蟲がまっすぐに飛んで來て私の額に突き當りヒョロヒョロ危く墮ちようとして途方もない方へ飛び戻る。",
              "citation": {
                "source": "うろこ雲",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョコヒョコ二人の前へやって来た。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがここのヒョロクタ老ぼれ番頭、玄関へ出て来てジロリ、ジロリ一行の身装を上から下まで見上げ見下ろし、十分も経ってから初めて口を開いて曰く、「どうも只今満員で、お気の毒様でございます」　足は痛くなる、夜は更ける、洋服はグショ濡れになってゾクゾク寒い事ひと通りではない。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ商売の林芙美子さんですら五尺八寸のヒョロ長い私に会うまでは、五尺そこそこのチンチクリンの前垂を掛けた番頭姿を想像していたくらいだから、読者は私の小説を読んで、どんなけがらわしい私を想像していたか、知れたものではない。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "豹吉の（ヒョウ）は氷河の氷（ヒョウ）に通じ、意表の表（ヒョウ）に通ずる、といえば洒落になるが、彼は氷のような冷やかな魂を持ち、つねにひとびとの意表を突くことにのみ、唯一の生甲斐を感じている、風変りな少年だった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十前後の、ヒョロヒョロと痩せて背の高い、放心したような表情の男だったが、眉には神経質らしい翳があり、こういう男はえてして皮肉なのだろうか。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘はヒョロヒョロした足で、ついて行った。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
