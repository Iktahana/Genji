        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母はひ孫の誕生を心から喜び、目を細めて赤ちゃんの顔を眺めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "家族写真には、ひ孫まで含めた四世代が笑顔で写っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はひ孫に囲まれて、昔話をするのが何よりも楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "幸ひ孫右衞門の發作も止んでスヤスヤと眠るのを、お春は辛抱強く眺めてゐたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鬼女",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに　こいつらみんな　ちょびひげサミュエルの　ししそんそん　――　子どもに　まごに　ひまごまで。",
              "citation": {
                "source": "ちょびひげサミュエルのはなし",
                "author": "まきまきパンのまき",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
