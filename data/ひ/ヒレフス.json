[
  {
    "uuid": "46f97ec2-fb6e-5374-a0eb-9c2c79351bd8",
    "entry": "ひれ伏す",
    "reading": {
      "primary": "ひれふす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
