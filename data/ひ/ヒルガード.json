          "literary": [
            {
              "text": "「まるでジョン・ヒルガードそっくりだ。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ジョン・ヒルガードって何です。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもヒルガードには眉間にあんな傷痕がありません。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おやおやみんな改宗しましたね、あんまりあっけない、おや椅子も丁度いい、はてな一つあいてる、そうだ、さっきのヒルガードに似た人だけまだ頑張ってる。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は或はご承知でしょう、ニュウヨウク座のヒルガードです。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヒルガードは一礼して脱兎のように壇を下りただ一つあいた席にぴたっと座ってしまいました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
