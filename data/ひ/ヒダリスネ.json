          "literary": [
            {
              "text": "十九年孫左脛に疔を生じ、十月四日四十九歳にして歿した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "謙信は、川中島の一騎討などから考えるとどんな偉丈夫かと思われるが、「輝虎、体短小にして左脛に気腫あり、攣筋なり」と云うから、小男で少しびっこと云うわけであるから、その烈々たる気魄が、短躯に溢れて、人を威圧した有様が想像される。",
              "citation": {
                "source": "川中島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "左脛骨及｜左胸の諸肋骨は粉砕せられたり。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            }
          ]
        }
