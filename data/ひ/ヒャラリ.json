        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "張扇をバタバタと叩いて「ソラソラ」と云う時は軽い時で、笛の笙歌を「オヒャラリヒウヤ」とタタキ附けるように云う時は筆者の気が抜けているのを呼び醒ますためであった。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大望　タラン、タン、タン、タン　ドン、ドドン、ドン　ヒュウー、ヒャラリ……と横笛や大鼓の音につれて、長閑にもまた悠長な太鼓や鈴の交響楽――お神楽囃子が聞こえます。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもヒャラリコドンツク、百姓の合間に、神楽囃子をやッていれば、すぐ五十年の年貢納めが済んでしまう。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
