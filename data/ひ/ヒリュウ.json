    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかれども唯｜飛流の白雲の中より落るを見るのみ、真に奇観なり。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝより溪を上に徒渉して、數十丈の絶壁の間を二三町も行けば、川水一落して、僅に五六尺の飛流となる。",
              "citation": {
                "source": "赤城山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "一溪に沿うて右折し、不動堂の前を過ぎて溪に下り、四五町ゆけば、溪窮まりて、飛流絶壁を走る。",
              "citation": {
                "source": "足柄の山水",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "山市場にいたりて、向ひの山に一條の飛流を見る。",
              "citation": {
                "source": "足柄の山水",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "下り舟岩に松ありつゝじあり　或は千仭の山峰雲間に突出して翠鬟鏡影に映じ或は一道の飛流銀漢より瀉ぎて白竜樹間に躍る。",
              "citation": {
                "source": "かけはしの記",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
