  {
    "uuid": "cec72452-1fa6-565b-8cc7-172a6c07839a",
    "entry": "ヒョット",
    "reading": {
      "primary": "ひょっと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こんな、ヒョットコの鼻つまりみたいな顔をしていても、案外、天才なのかも知れない。",
              "citation": {
                "source": "渡り鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "縄というのは長い縄へ短い糸の著いた鉤が著いたもので、此鉤というのは「ヒョットコ鉤」といって、絵に書いたヒョットコの口のようにオツに曲って居る鉤です。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しヒョット彼の前で厭味なんぞを言われちゃア困る。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、玄關の方角に指ざし乍ら、左の目を閉ぢ、口を歪め、ヒョットコの眞似をして見せて、『變な奴でがす。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠太がヒョットコの眞似をして見せたのも、「アンナ奴」と馬鈴薯の叫んだのも、自身の顏の見えぬ故でもあらうが、然し左程當を失して居ない樣にも思はれる。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハッ……でもヒョット支那人の泥棒か何かが這入りやがって……あっちでは泥棒といったら大抵チャンチャンなんで、それも旧の師走頃が一番多いんですが、そんな奴がコイツを見付けたら、胆っ玉をデングリ返すだろうと思いましてね。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョットしたら貴方じゃあるめえかと思ってね、アハハハハハ。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしていらっしゃる中にはヒョットしたらあの女だって、お兄様をお好きにならないとも限らないわ」「タヨリないなあ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョットすると鯨の若夫婦が云うたのかも知れません。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬鹿囃子　　　　　　　――鼻の動的表現（四）　昔から認められている「鼻の表現」の数々をここまで研究して参りますと、どうしても問題にしない訳に参りませぬのは、「おかめ」と「ヒョットコ」と「天狗」のお面であります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに「ヒョットコ」となると、その高慢も謙遜もありませぬ。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてに対して驚いております、不思議がっております、ビクビクしております、うろたえております、ヒョットコヒョットコしております。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方に依りまして「ヒョットコ」の一名を「モグラ」というのは、土から顔を出して眼をパチクリさせるなり慌ててもとの土にもぐり込む※鼠の鼻の表現に似た表現だからではありますまいか。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「天狗」の自慢が消え、「おかめ」の無知無能が眼覚め、「ヒョットコ」がその色気と喰気から救われるのであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界はどこまで行っても、おかめとヒョットコと天狗の踊りに過ぎないものでしょうか。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでおかめとヒョットコと天狗様とが飛び出して、馬鹿囃子を初めなければならぬ事になります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその中からヒョットコとおかめと天狗様が生れたのではないかと思われる位、スフィンクスと馬鹿囃子の関係は密接なものがあるのであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "突放された人間がヒョットコでありました。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョットコは見る物毎に驚きました、呆れました。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方がないのでヒョットコは、遂に色気と喰い気に逆もどりをしました。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸ヒョットコさん、御覧なさいよ。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……………………………………………………　――おかめとヒョットコと天狗様――この三つはこうして人間の無自覚――スフィンクスの鼻の表現から生まれました。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
