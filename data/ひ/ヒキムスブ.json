        "examples": {
          "standard": [
            {
              "text": "途切れた二本のロープをしっかりと引き結んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の日本では、婚姻関係を通じて家同士が引き結ばれることが多かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は過去と現在を引き結ぶ重要な証人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "……暇だの」　引きむすぶと、隠れてしまいそうな薄い唇を歪めて、陰気に、ふ、ふ、ふと笑うと、書見台を押しやり、手を鳴らして酒を命じ、「やしきでお前と飲むのも、ずいぶんと久しい。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "三人目",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
