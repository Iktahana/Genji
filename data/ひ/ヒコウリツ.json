          "standard": [
            {
              "text": "手作業で大量のデータを入力するのはあまりに非効率なので、専用のソフトを導入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "無駄な会議を繰り返す今の体制は非効率だと、若手社員たちが声を上げ始めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い設備を使い続けることで維持費がかさむのは、経営の観点から見て極めて非効率だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この処理のコストの大きさに悩んでいた出版社の賢明な経営者は、ある日、煩雑な作業の要員を社員としてかかえることの非効率に気がついた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
