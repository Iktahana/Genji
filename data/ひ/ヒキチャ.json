        "index": 1,
        "gloss": "powdered green tea (steamed and dried before being stone-ground)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
