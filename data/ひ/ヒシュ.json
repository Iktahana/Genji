          "literary": [
            {
              "text": "半日考へた揚句、隣町の道尊坊に頼みました」「何だ、あの似非修驗者か」「でも他に頼る人もありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "九百九十兩",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の半狂亂に氣を揉み乍らも、母の目論見の底を割り兼ねて、默つてしばらく樣子を見てゐるうちに、多の市は似非修驗者の道尊坊を頼んで來て、大袈裟な祈祷を始めました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "九百九十兩",
                "note": "青空文庫"
              }
            },
            {
              "text": "半日考えた挙句、隣町の道尊坊に頼みました」「何だ、あの似非修験者か」「でも他に頼る人もありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "九百九十両",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の半狂乱に気を揉みながらも、母の目論見の底を割り兼ねて、黙ってしばらく様子を見ているうちに、多の市は似非修験者の道尊坊を頼んで来て、大袈裟な祈祷を始めました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "九百九十両",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
