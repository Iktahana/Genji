        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しらくも頭の児一人目に着きぬ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の小路で一人目の男のひとに逢った。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスのように多くの古典を伝統として持っている国ですら、つねに古典への反逆が行われ、老大家のオルソドックスに飽き足らぬアヴァンギャルド運動から二百一人目の新人が飛び出すのではあるまいか。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　火の盛なる頃なれば、大膚脱ぎを誰一人目に留る者も無く、のさのさと蟇の歩行みに一町隣りの元大工町へ、ずッと入ると、火の番小屋が、あっけに取られた体に口を開けてポカンとして、散敷いた桜の路を、人の影は流るるよう。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして最初の小さな時間の枠を利用して、一人目のユーザーの求めてくる仕事をこなす。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "松本吉彦は、同社の一人目の社員となった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして北国の晴涼な、静寂な、夏休の第一日目の暁を、少女は常のように楽しい安らかな夢から、白い床の上に一人目覚めた。",
              "citation": {
                "source": "咲いてゆく花",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貴女も一人目つけるのよ。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一人目の乳母が虚弱な私を育てた。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人目が承諾すると、一人目が拒絶する。",
              "citation": {
                "source": "『鉢の子』から『其中庵』まで",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして次ぎから次ぎへと結婚と葬式とを繰り返して、十一人目のお葬ひを出したのは、丁度八十四の夏だつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、切腹を実行して十一人目になりますと、そこに出張していたフランスの士官から助命の申し出がありました。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "家来を一人目附の処へ帳簿を取りにやれ、その取調べを照し合せてみせる』　女中がこんな言葉を口走った時、居合せたものは一同驚いてしまった、彼女の声や態度は、野本彌治衞門の声や態度であったから。",
              "citation": {
                "source": "死霊",
                "author": "SHIRYO",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆は、ほんとに誰一人目をさまさず声も聞かなかった事を、此上なくよろこび合った。",
              "citation": {
                "source": "盗難",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "常盤津で並んだ女の中に一人目立って美しい女が居たが何だか、その顔の美くしいことにさまたげられて居るようで思い切ってうたえなかった。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "みのるは今日の式塲で義男の縞の洋服がたつた一人目立つてゐた事を考へながら默つて笑つた。",
              "citation": {
                "source": "木乃伊の口紅",
                "author": "田村俊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何處へか、誰も知らず、まつ暗な野原の眞ん中をひた走りに走つてゐる夜汽車のなかに、一人目覺めて、哲學の本を讀んでゐる、或者の姿！",
              "citation": {
                "source": "二三の追憶",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ブラアミイすなわち第一位の婚礼による妻の息子は、徳行をなせば、十人の祖先、十人の子孫、及び二十一人目たる自己を、罪障から贖う。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩焼王も殺され、押勝の妻子も斬られ、その姫は絶世の美貌をうたはれた少女であつたが、千人の兵士に犯され、千一人目の兵士の土足の陰に、むくろとなつて、冷えてゐた。",
              "citation": {
                "source": "道鏡",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩焼王も殺され、押勝の妻子も斬られ、その姫は絶世の美貌をうたわれた少女であったが、千人の兵士に犯され、千一人目の兵士の土足の陰に、むくろとなって、冷えていた。",
              "citation": {
                "source": "道鏡",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝静まった家の中にただ一人目ざめて闇の中にそうしている彼の姿は、もし見る人があったら確かに不気味な思いをしたであろう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "山なら山で、人つ子一人目につかないやうな山の奧へ入つて、木の實でも食べて、谷の清水を手で掬つて飮んでゐたら、汚らしい世の中の事なんか忘れて、どんなに心が奇麗になつて、神樣のお姿が、あたしにも拜めるかも知れない。",
              "citation": {
                "source": "新婚旅行",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さう仰しやらずに同町内の誼み、御面倒でもございませうが、人一人目鼻を明けてやつて下さい。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "捕物仁義",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうおっしゃらずに同町内の誼、御面倒でもございましょうが、人一人目鼻を明けてやって下さい。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "捕物仁義",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしがぞくぞくっとする寒さに身ぶるいしたとき、いよいよ十一人目のあのひとが看守にみちびかれて入ってきたのでございます。",
              "citation": {
                "source": "蜜柑の皮",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人目が答えて「私は石積工であり、仕事道具を運んでいる。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そこで一人目が言いました。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "再びそれをあげた時、三十秒も経っていなかったのだが、人っ子一人目に入らなかった。",
              "citation": {
                "source": "盗聴者",
                "author": "Ａ. ブラックウッド　A. Blackwood",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人目が、「ボリス大公は昔の大公と違うぞ。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人目はトリガーセン、二人目はトリタイアです。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
