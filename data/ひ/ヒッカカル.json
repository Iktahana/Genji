        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "駅前のカフェに引っかかって、つい長居してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "帰り道、友人の家に引っかかって夕食をご馳走になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ちょっと本屋に引っかかってから帰るよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to get mixed up in (trouble)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
