        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "検査の結果、前立腺の肥大が見られるため、早急な治療が必要だと告げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "長時間の立ち仕事のせいで、足の血管が不自然に肥大している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "扁桃腺が肥大して呼吸が苦しくなったため、昨夜は救急外来を受診した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ワールブルヒは腎臓でもわるいかと思われるように顔色が悪く肥大していて一向に元気がなかったが、ゴールトシュタインは高年にかかわらず顔色も若々しく明るい上品な感じのする人であった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾は案内された部屋に、レジオン・ド・ヌウルの勲一等の赤い略章をつけた肥大した肉体の恰好の好い一人の老人を見出すのでした。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥大した男の恋愛のつづきを受理する女のように頑健な裸な腕を寝床からさしだすと、受話器を整形された小さな耳にあてた。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ふたたびミサコは肥大した女を威喝するように女記者に云った。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、よく肥大した種のいゝ豚を二十頭ばかり持っていた。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山高帽を少し阿弥陀に冠った中年の肥大った男などが大きな葉巻をくわえて車掌台に凭れている姿は、その頃のベルリン風俗画の一景であった。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは無数の小さいものを犠牲にして、大きい奴だけが肥大して行くことだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら逃げても追い駆けて来る体内の敵をまくつもりで最後の奥の手を出してま近な二つの氷盤の間隙にもぐり込もうとするが、割れ目は彼女の肥大な体躯を容れるにはあまりに狭い。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、はち切れそうに肥大した子房の尻に敷かれて哀れをとどめているのである。",
              "citation": {
                "source": "沓掛より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんとん拍子に乗が来て、深川夫人は嫣然顔、人いきりに面｜熱りて、瞼ほんのり、生際に膏を浮べ、四十｜有余の肥大紳士に御給仕をしたまいながら、「あら貴下、よくってよ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の葉盛りには鬱青の石壁にも譬へられるほど、蔦はその肥大な葉を鱗状に積み合せて門を埋めた。",
              "citation": {
                "source": "蔦の門",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "きびらの洗いざらし、漆紋の兀げたのを被たが、肥って大いから、手足も腹もぬっと露出て、ちゃんちゃんを被ったように見える、逞ましい肥大漢の柄に似合わず、おだやかな、柔和な声して、「何か、おとしものでもなされたか、拾ってあげましょうかな。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……島田髷の艶々しい、きゃしゃな、色白な女が立って手伝って、――肥大漢と二人して、やがて焜炉を縁側へ。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "畚褌の肥大裸体で、「それ、貴方。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そういえば、余りと言えば見馴れない風俗だから、見た目をさえ疑うけれども、肥大漢は、はじめから、裸体になってまで、烏帽子のようなものをチョンと頭にのせていた。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄駝は肥大、福相の唐人。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの肥大な虫の汁気という汁気はことごとく吸い尽くされなめ尽くされて、ただ一つまみの灰殻のようなものしか残っていなかった。",
              "citation": {
                "source": "簔虫と蜘蛛",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫の肥大なからだはその十分の一にも足りない小さな蜘蛛の腹の中に消えてしまっている。",
              "citation": {
                "source": "簔虫と蜘蛛",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがあなたへの歪んだ愛、狂おしいまでに肥大した愛であるだけに、いっそう苦しいものです。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "と諦めて書き始めたところが、前項は「起」が肥大化して「続く」と相成った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこいつが肥大化すれば、やがて演奏はコンピューターのジェネレートするカラオケになる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "大森君は職員中第一の肥大漢で、教授の時間でもボールドの前に立つて居るのを太儀だといつて止むを得ぬ外は椅子へかゝつて居る。",
              "citation": {
                "source": "教師",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "女にも娘のうちは、内気で、きゃしゃで、一向目にも立たなかったのが、人の妻となって、子供でも産むと、急にはしゃいで、おしゃべりな肥大婦になり、どうかすると亭主の頭に手をやりかねないようになるのがあるものだ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻咽腔肥大ってことが……」「ホホ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と肥大漢は言葉をつづけた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝、イワン・フョードロ※ッチが目覚めた時には、肥大漢の地主の姿はもうなかつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "東泉先生は其肥大の躯を白毛布の上にドシリと下して、心安げに本を見始める。",
              "citation": {
                "source": "雪中行",
                "author": "小樽より釧路まで",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥大婦11・２（夕）　亜米利加のある田舎に居酒屋があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏は夫人の財布から二十銭銀貨を一枚借り出したが、それを渡さうとすると、肥大婦の下女がどうしても言ふ事を肯かなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとうにお母さん、長いあひだいろいろ御心配をおかけして、……」　言葉はそこでぷつつりときれ彼はおもはずこゑをのんだ。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "hypertrophy",
