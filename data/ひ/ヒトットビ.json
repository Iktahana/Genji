        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この仕事をひとっ飛びで終わらせよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "問題解決のため、彼はひとっ飛びで解決策を思いついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "疲れていたので、家に着くや否やひとっ飛びでベッドに倒れ込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
