        "examples": {
          "standard": [
            {
              "text": "彼の家まで、ひとっ飛びで行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "バスに乗れば、目的地までひとっ飛びだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの鳥は、ひとっ飛びで向こう岸まで渡っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「てんとう虫、てんとう虫、家までひとっ飛び。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことにもうひとっ飛びで、評判のおでん屋を土手先で見つけたのはそれからまもなくでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとっ飛びで、リッチフォードのそばに来て、両手をもぎ取った。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
