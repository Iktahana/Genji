          "literary": [
            {
              "text": "アル　ヒ　ミチバタデ　カナヅチヲ　一ツ　ヒロヒマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンデ　オヒロヒナサイ」　ヲンナノ　コハ　コマツテ　シマヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らくヒロヒト天皇という偶像が、天皇の名に於て自分の意志を通したのは、この時が一度であったかも知れないが、これをもっと早い時期に主張するだけの決断と勇気があれば、彼は善良な人間であると同時に、さらに聡明な、と附け加えうる人間であったであろう。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨベコといふのも喚び寄せることであり、ヒジョッコはヒロヒ子の轉訛であらう。",
              "citation": {
                "source": "私生兒を意味する方言",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
