[
  {
    "uuid": "e7c4fd44-8491-5cae-9796-32b8dbe50a8a",
    "entry": "罷免",
    "reading": {
      "primary": "ひめん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
