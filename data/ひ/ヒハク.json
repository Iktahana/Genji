  {
    "uuid": "74fdf688-1f41-5b63-953a-0ae423392bee",
    "entry": "菲薄",
    "reading": {
      "primary": "ひはく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
