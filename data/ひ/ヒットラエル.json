    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "確かに油断ならないかもしれませんが、ワショーの狩人を引っ捕らえるほど凄くはありません。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "この身ある限りすべからく一味を引っ捕らえるべし。",
              "citation": {
                "source": "橙の種五粒",
                "author": "THE FIVE ORANGE PIPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここにおられる友人は狩猟がとてもうまいから、追いつめた後に、引っ捕らえるだけの老犬がいればいいんですと。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま行ったクーペを直ぐにひっ捕えるように。",
              "citation": {
                "source": "白妖",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう気がつくと同時に一層猛烈に藻掻きまわって、嬢次少年を一刻も早く引っ捕えるべく、焦躁りまわらずにはいられなくなった事がある。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "天狗を酔いつぶさして引っ捕えるつもりだったのが、自分の方も酔っぱらって、天狗と一緒に眠ってしまったのでした。",
              "citation": {
                "source": "天狗の鼻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし上のほうでは、革命の陰謀団の中から、一人の外国人を――おまけにドイツ人を――引っ捕えるのは、そう嫌なことでもないからね。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "女かと思って引っ捕えるとその男だ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "御落胤殺し",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
