        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "非常に根は虔しやかであるくせに、ヒヨツトした場合に突発的なイタヅラの出来る女だつた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おゝよしよしよし――お母さんが悪かつた悪かつた、今先生様がよくして下さる――おゝ悪かつた悪かつた」　それまでいふとヒヨツと母親は医者の方へ眼を上げた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヨツト机の上の箸のやうなものが兄の目にとまつた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」彼女はヒヨツト星を見上げた。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヨツト葉巻を手に取り、マークをみてゐる）女の声　（ドアの辺りより）お帰りなつてるのね。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だつて君そこに浮気があります浮気は悲しい音楽をヒヨツと忘れさせること度々です空　空　空やつぱり壁は土で造つたものでした。",
              "citation": {
                "source": "不可入性",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前十｜時※になると、武村兵曹丈け一人ヒヨツコリと皈つて來て『サア、之から獅子狩だ／＼。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "『私も今、左樣考へて居つた處だ、大佐閣下だつて私共が、其樣に早く歸らうとは思つて居なさるまいし、それにね、約束の五日目の晩には、海岸の家では、水兵共が澤山の御馳走を作へて待つて居る筈だから、其以前にヒヨツコリと皈つては興が無い、行く可し／＼。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と武骨なる武村兵曹は、此時ヒヨツコリと顏を突出した。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "食後、夕べの散歩がてら樹明居へ推参、案の如く不在、一時間ばかり待つたが、待ちきれないで帰る、途中ヒヨツコリ樹明さんと逢ふ、樹明さんは私の所で私を待つてゐて、待ちきれないで帰つて来たのだといふ、二人が別々に二人を待つてゐたのだつた、これも人生の一興たるを失はない。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、君などが、さうヒヨツクリ本物を持つて来ようなどとは、思はないけれども、ハヽヽヽヽ。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人に逢へると思つた場所では、逢へないで、悄然と帰つて来る電車の中で、ヒヨツクリ乗り合はす。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、玄関の方角に指さし乍ら、左の目を閉ぢ、口を歪め、ヒヨツトコの真似をして見せて、『変な奴でがす。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠太がヒヨツトコの真似をして見せたのも、「アンナ奴」と馬鈴薯の叫んだのも、自身の顔の見えぬ故でもあらうが、然し左程当を失して居ない様にも思はれる。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声で孔雀はヒヨツコリと立ち上りました。",
              "citation": {
                "source": "嘆きの孔雀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ丸でめゝず見たやうですわ、活版やで知つてるのかしら、ヒヨツト知らないで、そんなめゝずの絵を入れてしまつたらどうでせう？",
              "citation": {
                "source": "黄金機会",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十年も前の話、戸川残花がヒヨツコリやつて来て曰く、数寄屋橋外に頗る上手な人相見がある、百発百中で数寄屋橋教会の会員は皆信じてゐるんで坪内君と一緒に実験に出掛ける筈になつてるが、君も一緒に行かないかといふ話で、約束の日を打合はして当日三人して出掛けた。",
              "citation": {
                "source": "人相見",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、向からヒヨツクリやつて來て、急になれ／＼しく話を始める。",
              "citation": {
                "source": "恐怖について",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐづぐづしてゐるうちに、ヒヨツと若し姉が死んで了ひでもしたらどうしよう。",
              "citation": {
                "source": "イボタの虫",
                "author": "中戸川吉二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒヨツとすると今時分、姉さんは死にかかつてゐるのぢやないかしら……」　一歩一歩今自分が、姉の家とは反対の方向へ歩いてゐるのだといふ意識が、そんな風に思はせるのだつた。",
              "citation": {
                "source": "イボタの虫",
                "author": "中戸川吉二",
                "note": "青空文庫"
              }
            },
            {
              "text": "取り残された子供の話によると、とほうもなく大きなマントを頭からかぶつた、えたいの知れないものが、どこからかヒヨツクリ飛び出して、自分たちの仲間の一人を引つさらつて森の中へ走つてにげたといふのでした。",
              "citation": {
                "source": "虹猫の大女退治",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「翁の文」の序文などから考へますると、ヒヨツとするとこの人の先祖は播州から出たのではないかと考へられます。",
              "citation": {
                "source": "大阪の町人學者富永仲基",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本文化は、この二種の出來上り方の中、どちらで出來上つたものかといふことが一の問題であらうと思ふ、而もこれが中々むつかしい問題で、私はヒヨツとすると後の方の方法で出來上つたのでないかと思ふのです。",
              "citation": {
                "source": "日本文化とは何ぞや（其二）",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヨツコリソコヘ、洋服ヲキタ、ジヤガイモ紳士ガキマシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "新一　ううん、俺あ野辺山でおりて、オサキの追分の地蔵さんとこまで来て休んでたら、次郎がヒヨツクり。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美緒　でもヒヨツとそんな気がする事があつてよ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、あんな豊富な色を、あんなに繰返されると、美しいと思つて見てゐる間はいゝけど、ヒヨツと鼻についてトタンにヘドが出さうになるわ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内に、ヒヨツと、そいつは若しかすると、今言つた、あの時代に鍛へ上げて来た本質的なもののためぢやないかと思つたんだ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、今此処に五郎さんがヒヨツコリやつて来ると、なんだか面白いわね。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小母　（真青なおびえた顔でついて来て、眼を据ゑて空鑵ばかり見てゐる）……なにや知らん思うて、ヒヨツと開けたら、ホンマにわては！",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
