        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "空き缶を素手で捻り潰す彼の怪力を見て、周囲の友人たちは絶句した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小さな悩み事など、強靭な精神力で捻り潰して前に進むしかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "道端に落ちていたタバコの吸い殻を、靴の先で無造作に捻り潰した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "蚤、虱、バツタ、カマキリ、百足蟲、――蟲と名のつくものにろくなものがない」「目障りだつたら、捻り潰すだけの事だ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お局お六",
                "note": "青空文庫"
              }
            },
            {
              "text": "蚤、虱、バッタ、カマキリ、百足虫、――虫と名のつくものにろくなものがない」「目障りだったら、捻り潰すだけの事だ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お局お六",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラスビイユ、さようなら、しかし、今後もし現場で君を捕まえたらば、御気の毒ながら、捻り潰すよ。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "むろん腕力じまんのかれらには、モコウをひねりつぶすくらいは朝｜飯まえのことである。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "「小僧め、ひねりつぶすぞ」「なにをッ」　せまい船内で、はげしい無茶苦茶な格闘がはじまった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほか、母親だとか、とにかくそこらに居る人間を、みんな、蟲けらをひねりつぶすように。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫ケラをひねりつぶすように私はお前をやれるだろう今となって完全にお前の命は私の手の平の中のオモチャだよ。",
              "citation": {
                "source": "殺意（ストリップショウ）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、大きな鶏どもめ、一羽一羽、ひねりつぶすから逃げるなよ」　張飛はいった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "薔薇の花でも何でも虫のためには必要なる栄養物質であるのを、人間が無用な娯楽のために独占しようとして虫をひねり潰すのは、虫から見ればかなり暴虐な事かもしれない。",
              "citation": {
                "source": "蜂が団子をこしらえる話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖母の言うのには、棚田の何代目かの先祖に――確か四代目とかいったようでしたが、癇癖の強い、とても残忍な性質の家老があって、人を殺すことなぞ、虫ケラ一匹ひねり潰すほどにも感じてはいなかったというのです。",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、早まって強いて賢彌を誘い出すような不心得のことをやれば相俣の岩魚めはひと捻りに捻りつぶす。",
              "citation": {
                "source": "岩魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しようと思えば人間の一人や二人訳もなくひねりつぶせる、そういう感じが自然と表面にも出て、傲然と周囲を見廻した。",
              "citation": {
                "source": "狐火",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体それがしは宝物などいうものは大嫌い、鼻汁かんだら鼻が黒もうばかりの古臭い書画や、二本指で捻り潰せるような持遊び物を宝物呼ばわりをして、立派な侍の知行何年振りの価をつけ居る、苦々しい阿房の沙汰じゃ。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
