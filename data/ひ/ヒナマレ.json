          "literary": [
            {
              "text": "さっと引き下ったあとで――「君、とても、ヒナマレだね。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あのヒナマレのお酌で鮎の塩焼か。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　間もなくさっきのヒナマレ――鄙には稀なるの意味である――が朱塗のお膳を二つ運んで来た。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
