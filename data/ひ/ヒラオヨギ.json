        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は得意な平泳ぎで、スイミングレースの記録を更新した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "平泳ぎは他の泳法に比べて、ゆっくりと長く泳ぐのに適している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、プールで初めて平泳ぎができるようになった時の喜びは忘れられない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ここのところをわが青海流では、死屍水かかずしてよく浮くといって、平泳ぎのこころだ」「それは、よくおとうさんがおっしゃる、あの渾沌未分の兄弟か何かなの」　小初は食後の小楊枝を使いながら父親を弥次った。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "平泳ぎ、背泳ぎ、両抜手、片抜手、競泳、立ち泳ぎ――等を悉く試みた。",
              "citation": {
                "source": "「或る日の運動」の続き",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆるやかな平泳ぎで、沖を見渡したり、渚を顧みたりしながら、人魚のやうに呑気に游泳した。",
              "citation": {
                "source": "「或る日の運動」の続き",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の足は、いつの間にか平泳ぎの型で水をかいていた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一はゆっくりと、平泳ぎで高志のほうに向かいかけたが、高志のほうは、軽く抜き手をきって、スタートラインにたどりつくと、水中でターンし、二コースのあたりを、なかば本気で泳ぎはじめた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大丈夫で御座います」　小虎は然う云いながら、傘を捨て、平泳ぎに掛った。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「案外、近いぞ」　富士男はゆっくりと、得意の平泳ぎをはじめた。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方がないから僕はもう立っていることを諦めて平泳ぎをはじめた。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（なるほど、海水だな）　平泳ぎから立泳ぎになったり、また平泳ぎにかえったり、僕は二十分間ぐらい泳いだ。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方なく僕は平泳ぎをしながら、顔だけは横に寝かして、辛うじて息をつくことが出来た。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒いふんどしの子供たちは、犬かきや、蛙泳ぎや、平泳ぎを、唇が青くなつてガタ／＼ふるへるまで、練習します。",
              "citation": {
                "source": "プールと犬",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真赤な毛糸の帽子をかぶり、上品な顔立ちのまだ若い女は、笑うような顔でゆっくりと平泳ぎをしていた。",
              "citation": {
                "source": "はやい秋",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて浮かび上がってきた女はかなり沖まで進んでおり、平泳ぎでさらに先へ進もうとしている。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めのうち、僕は平泳ぎをしている。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "平泳ぎのままペースを上げていき、やがて抜き手へと変えていく。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "平泳ぎで縦に何往復かしてみることを、裕一は亜紀子に提案した。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の底を平泳ぎで進みながら、ふたりは手をつないでみた。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "プウルを村川と二人、平泳の競泳をしながら、日本へ帰ったらうんと遊ぼうや、とつまらない約束をし、プウルから上がり、脱衣場に戻って行ったら、まんまと五｜弗入りの財布を盗まれていました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "プウルを村川と二人、平泳の競泳をしながら、日本へ帰ったらうんと遊ぼうや、とつまらない約束をし、プウルから上がり、脱衣場に戻って行ったら、まんまと五弗入りの財布を盗まれていました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、早く帰ってみんなでくおうじゃないか」　二人はくるりと向きを変えると、肩をならべて平泳で海岸の方へ泳ぎだした。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして平泳ときては論外で、一哩だけ切り離して全速で泳いだつて世界一の選手でも三十分では危いだらう。",
              "citation": {
                "source": "わが戦争に対処せる工夫の数々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここ十数年、日本水泳は長距離王国を誇っているが、高石の自由型短距離につゞいては鶴田の平泳。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルリンのオリムピックの放送で、女子平泳の予選の時、支那のヤン嬢（多分さういふ名であつたと思ふが）がひどく派手な緑の水着をきて、外の選手がみんな水へ飛び込んでウォームアップをしてゐるのに、このお嬢さんだけはどこを風が吹くかといふやうにスタート台に悠々腰を下して水面を眺めてゐるだけである。",
              "citation": {
                "source": "相撲の放送",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠い沖のほうから、ピカピカ光る金髪が、平泳でゆっくりこちらへ泳いで来る。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            },
            {
              "text": "芳衛さんだけは途中で棄権して、ゆっくりと平泳で泳いで来る。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもは、ゆっくり過ぎるくらいゆっくり平泳で泳いで来るのに、今日はどうしたというのか、まるで癇癪でも起こしたように、ひどい飛沫をあげて泳いでいる。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎は平泳で前進し、そして背泳ぎに移り、やがて手足の動きを中止した。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校では水泳部に入り、二百米平泳を三分十秒台で泳いでいた。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
