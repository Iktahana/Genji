          "literary": [
            {
              "text": "◇悪人の手…………その名刺を裏返したりヒネクッタリして困惑した表情の後「こちらへお通し申せ」という手つきをする。",
              "citation": {
                "source": "涙のアリバイ",
                "author": "――手先表情映画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "通りかかりの労働者、学生、紳士などは勿論、人通りのすくない雨の日なぞは、女子学生らしいのまで硝子窓の外から穴のあく程品物をのぞいては鉛筆をヒネクッていた。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一部に専門的に、どれだけヒネクッた批評があるにしても、いつの世にも愛読されるということより大いなる、又、真実の批評がある筈はない。",
              "citation": {
                "source": "ヤミ論語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
