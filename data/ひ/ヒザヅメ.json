    "definitions": [
      {
        "index": 1,
        "gloss": "(sitting) knee-to-knee",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "二人は膝詰めの距離で向き合い、周囲には聞こえない低い声で密談を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "社長と膝詰めで話し合ったことで、現場の切実な悩みを理解してもらえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "膝詰めの対話こそが、互いの誤解を解くための最も近道であると彼は信じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "膝詰めで買収にかかってみた。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして、今日は伯母様が膝詰めの掛合いである。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとみそのが膝詰めで教育論を弁じることがあつた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、それが悪ければどうともしてくれと膝詰めで談判したんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "春の雪解",
                "note": "青空文庫"
              }
            },
            {
              "text": "と言って、膝詰めで来たものもあれば、ビタちゃんのお袖にすがって、ぜっぴ、お刺身のツマになりともありつきたい、と歎願に及んで来た奴もある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大挙して、具足屋東兵衛に膝詰め談判をした。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはお前が帰ったあと、おせい様の家へ出かけて行って、膝詰め談判をしてみた。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しそれが實行されないならわたくしはこの屋敷から出て行かないと、かんさんはななえに膝詰めで言ひ寄つた。",
              "citation": {
                "source": "渚",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉三郎は河豚で死んだんぢやねえ、立派に毒害されたんだ」　通夜の人數を追つ拂つて、八五郎に見張らせた平次は、吉三郎の死骸を中に、お由と膝詰め談判を始めたのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鉄砲汁",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉三郎は河豚で死んだんじゃねえ、立派に毒害されたんだ」　通夜の人数を追っ払って、八五郎に見張らせた平次は、吉三郎の死骸を中に、お由と膝詰め談判を始めたのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "鉄砲汁",
                "note": "青空文庫"
              }
            },
            {
              "text": "膝詰めである、うっかりすれば腋の下を擽りかねない。",
              "citation": {
                "source": "百足ちがい",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みつ枝のように含みやほのめかしぬきの、いってみれば膝詰め談判であった。",
              "citation": {
                "source": "百足ちがい",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "選挙事務長の大石が、金五郎の前に正坐して、悲憤の面持で、膝詰めしているだけだ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は米谷（柴田外記）どのから事情を聞いたのだが、年が明けると一ノ関が帰国する、そのとき大学は、一ノ関に膝詰めで六カ条の申しいれをするといきまいているそうだ」「六カ条とは」甲斐が眼をあげた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその沢庵は、武蔵の処置をしてから姫路藩の家来たちと何か客間で膝詰めの相談事をしていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪しからん」　と丞相府へやってきて、孔明に膝詰めで談じつけたのである。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おつぎは奥のひと間へ呼び入れられて、両親が膝づめで詮議すると、最初は強情に口をつぐんでいたが、いろいろに責められてとうとう白状した。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれは娘が膝づめの談判に余儀なくされたので、心の底からよろこんで承諾したのでないらしいことは、小坂部にもよく判っていたが、その以上にこの約束をたしかめる方法もないので、かれは仮りに父の詞を信用して、しばらくその成り行きを見ているよりほかはなかった。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳の早い新兵衛はもうその一件のあらましを何処からか聞き込んでいたらしかったが、軍右衛門は更にくわしい説明をあたえた上で、なんとかしてかの娘の身許を洗い出してくれないかと膝づめで頼んだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "広重と河獺",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧弗同盟軍に対し砲門を開くかどうか”　Ｘ大使の、膝づめの談判だった。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今私は煩悶中です、というのはね、この部屋、スケッチで御覧のとおりで、入ると、サア仕事するか、それとも寝るか、どっちか、と膝づめに会っているような室内の配置のゆとりなさです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "部分的な力の入れかたではなく、内容にもっとぴったり迫ったところ、ね、膝づめのところ、それが不足している。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、この通り、人を払ってお前さんと膝づめの対談をつけるつもりで出直して来たんだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　膝づめ談判で、作文競争のやうなこともさせられた編輯当番の寝言以上の如し。",
              "citation": {
                "source": "文学界後記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ関係になつてゐたから、はからざる終戦、母とトキ子は二人の男の膝づめ談判に困却して、なすところが分らない。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も商才にぬかりのない土居光一のことで、即坐に一馬と膝づめの商談、女郎だってミウケの三万や五万は今時かかるんだから二十万円でミウケしろという、私が間に立って十万に値切って出たが、十五万円でケリをつけた。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あたしは女だから口出しはしなかったけれど」と母は云った、「差配さんは膝づめでかなり強いことを云ったらしい、それからずっと飲み続けで、あのとおりどなりちらしているんだよ」　乱暴をしそうで怖いというから、おひさと増吉は母が預かった。",
              "citation": {
                "source": "落葉の隣り",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "病家の迎えか、患者でも来ない間は、この医者は、隣家に入り浸りで、碁を打ち、世事を語り、時にはひそひそと何事か膝づめで密談していた。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹をわって、篤と、御方寸を洩らされい」　膝づめに、こう問い寄られて、家康はやっと顔を上げた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "石川主殿は、娘を殺したのは、庄次郎じゃと、半蔵殿とこのほうへ、膝づめの懸合い」「ああッ……」　庄次郎は、髪の毛をむしッて、慚愧の眼をつりあげた。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
