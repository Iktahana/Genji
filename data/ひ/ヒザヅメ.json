[
  {
    "uuid": "cbc471b9-ba6b-538b-be2a-47e4bbc7ded3",
    "entry": "膝詰め",
    "reading": {
      "primary": "ひざづめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
