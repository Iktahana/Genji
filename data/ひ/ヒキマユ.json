    "definitions": [
      {
        "index": 1,
        "gloss": "painted eyebrows",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "平安時代の貴族は、顔に引き眉を描くのが一般的だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は時代劇の役で、見事な引き眉を再現していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "引き眉は、当時の美意識を象徴する化粧の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "オールバックに濃化粧、漆のような引き眉に毒々しい頬紅口紅をつけ、青地か紫色の綿紗に黒手袋、白絹模様入りの靴下に白鞣の靴の踵を思い切り高くして、虹のようなショールを波打たせながら八方に眼を配って行く……といったような女学生をいきなり不良とは断定できぬ。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、隣りの家の格子窓から、凄い引き眉毛をした、やっと肩あげの取れたばかりのような若い女が巻煙草を口に銜えて、こっちを見ていた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "７　狭い路地を抜けて、灰色の空の下にある大通りまで出ると、僕はもう、家に残して来た年増女お照のことも、昨夜｜隣家に越して来た凄い引き眉毛の洋装少女のことも、共にすっかり忘れてしまわねばならなかった。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下から、引き眉毛の、思いの外大人っぽい顔が現われた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お千代は細い引き眉毛をしかめながら何か思い出そうとしているようだったが「ふうちゃんの首のところには、おできも傷もなかったようですわ、あの日のおひるっころ、ふうちゃんと蛇骨湯へ一緒に入ったんですがそのときお互様に、洗しっくらをしたんですのよ。",
              "citation": {
                "source": "電気看板の神経",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「先ず美人の方でございましょう」「引き眉でもしていらっしゃるんでしょう？",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋装、和装、頬紅、口紅、引眉毛取り取りにニタニタ、ヘラヘラと笑い傾けながら、荘厳を極めたロココ式の応接間に押し並んだところは、どう見ても妖怪だ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十とはトテモ見えない襟化粧、引眉、口紅、パッチリと女だてらのお召の丹前に櫛巻頭。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時頃まで私はあの人のかつら下地に結ったかお、引眉毛の目つき、を思って居た。",
              "citation": {
                "source": "つぼみ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "京の女は厚化粧、白粉を頸筋にまで用いて、べには唇にばかりではなく、目じり目がしら、引眉にもこれを加うとぞいうが、江戸ッ児は女でも瀟洒たるもの、好んで多摩川の水にみがき上げた素顔素肌を誇り、強ては白粉を用いず、ただ紅のみは下唇にチョと目立たぬくらい、それも態とらしきは吾から避けて用いぬようにしている。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜餅ふくみえくぼや話しあく　　　みさ子夏瘠や粧り濃すぎし引眉毛　　　和香女夏瘠や頬もいろどらず束ね髪　　　久女　桜餅をふくみ靨を頬にきざむあどけなさ。",
              "citation": {
                "source": "大正女流俳句の近代的特色",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に引眉毛の濃い粧りは夏やせの顔をややけわしく見せ、頬も色彩らぬつかね髪の年増女。",
              "citation": {
                "source": "大正女流俳句の近代的特色",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "折角の引眉毛が眼尻の方へ八の字に流れ、ギリシャ劇の悲劇の仮面のような莫迦々々しい面になっている。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一節に曰く、「店先へ腰をかけて駒下駄のうしろでとんとんと土間を蹴るは二十の上を七つか十か引眉毛に作り生際、白粉べつたりとつけて唇は人喰ふ犬の如く、かくては紅も厭らしきものなり。",
              "citation": {
                "source": "桑中喜語",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は引眉毛に白粉口紅。",
              "citation": {
                "source": "にぎり飯",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "笠ははね飛ばされて、月代の青い地頭が出て居りますが、白粉を塗つて、引眉毛、眼張りまで入れ、手甲、脚絆から、笈摺まで、芝居の巡禮をそのまゝ、此上もない念入りの扮裝です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "花見の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "笠ははね飛ばされて、月代の青い地頭が出ておりますが、白粉を塗って、引眉毛、眼張りまで入れ、手甲、脚絆から、笈摺まで、芝居の巡礼をそのまま、この上もない念入りの扮装です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "花見の仇討",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
