          "literary": [
            {
              "text": "ヒローたちの自然さ、逞しさと、云いようない優雅さの流れあった姿。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、詩集をくりひろげるごとに、ヒローの優雅な気品への傾倒を深めます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "作品と作家とのいきさつについての物語、それから詩のヒローに単純な呼び名がつけられる面白さ、可愛さ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            }
