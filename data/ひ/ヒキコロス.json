    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼はそこを去り馬車を駆って街々を驀進し、平民どもを蜘蛛の子のように散らし、その挙句ガスパールという男の子供を轢き殺す。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の楽しみのために、子供を二人轢き殺すようなことをされては、一般の善良な庶民は、たまったものではない。",
              "citation": {
                "source": "無知",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やい、わきへ寄せろ」「ぼろ馬車」「轢き殺すぞ」と、後ろの方でごうごうと喧しい。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車が頻りに人を轢殺すからといつて泣く程の是公氏でもないと思つた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
