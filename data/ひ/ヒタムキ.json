[
  {
    "uuid": "96835aad-f9ad-5403-8061-2ba47887178c",
    "entry": "直向き",
    "reading": {
      "primary": "ひたむき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
