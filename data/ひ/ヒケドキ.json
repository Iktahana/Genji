        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "株式市場の引け時になると、多くのトレーダーが最後の駆け引きを行う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「今日の引け時までに、このレポートを完成させます」と彼は宣言した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "引け時が近づくにつれて、取引所の熱気が増していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "引け時だからたまらない。",
              "citation": {
                "source": "「鎌と鎚」工場の文学研究会",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　それで恋愛の表現等でも、パリとモスクワと違うところは、例えばパリは引け時間、地下電車の入口に立って見て居ると、女が先に来て改札口で待って居る。",
              "citation": {
                "source": "ソヴェトに於ける「恋愛の自由」に就て",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで恋愛の表現等でも、パリとモスクワと違うところは、例えばパリは引け時間、地下電車の入口に立って見ていると、女が先に来て改札口で待っている。",
              "citation": {
                "source": "ソヴェト・ロシアの素顔",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方会社の引け時頃になると、省電を越えて郊外に待つわが家庭のために人々は争って出来たてのパンを求めている。",
              "citation": {
                "source": "新古細句銀座通",
                "author": "岸田劉生",
                "note": "青空文庫"
              }
            },
            {
              "text": "事務所の引け時がすぎても帰らず、夕食にも戻ってこなかった。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暗い銀行の金網の外は、証券取引所の前場の引け時とて、金を出す人預け入れる人々でごった返していた。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄昏れて霧が立ちこめ、会社のひけどきの混雑。",
              "citation": {
                "source": "犯人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "例のようにすぐと訴訟箱をひっかきまわしてみたが、いっこう目ぼしい事件もございませんので、屈託げにあごのひげをまさぐっていると、かれこれもうひけどきに近いお昼ごろのことです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "なぞの八卦見",
                "note": "青空文庫"
              }
            },
            {
              "text": "口わる烏いつも學校のひけどきに口わる烏がやつて來る。",
              "citation": {
                "source": "歌時計",
                "author": "童謠集",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度そこがひけどきで、小さい銀杏がえしや束髪にした少女の女工たちが、伸子のゆく細い道を群れて来てすれちがった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子の眼をひいたのは、その雨上りの並木道を来るひけどきの通行人のなかで、その人ひとりがすきとおるコバルト色のきれいな絹防水の雨外套を着ていたからだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自身も職業を持つならば、退け時刻の早い方が遅く帰る方を待ちうける用意をして置きなさい。",
              "citation": {
                "source": "良人教育十四種",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "退け時の工場の門をあふれる勞働者の波にもまじつた。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度なぞは、Ａの役所の退け時に、さも偶然らしく役所の前を通りかかって、一緒に散歩してお茶を飲んだり、自動車に乗ったりして帰って来た。",
              "citation": {
                "source": "花嫁の訂正",
                "author": "――夫婦哲学――",
                "note": "青空文庫"
              }
            },
            {
              "text": "燐寸工場に出てゐるウメ子は娘らしくなく、退け時が来ても帰つて来ぬことがあつたのだ。",
              "citation": {
                "source": "反逆の呂律",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう退け時に近かったので、隆夫はしばらく待ってから、博士と連れ立って、わが家へ向った。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方、方々の工場の退け時になると、彼女は街へ出て、堅気女らしい風でそぞろ歩きをした。",
              "citation": {
                "source": "フェリシテ",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の行列は、てんでんばらばらになってしまって、丁度退け時の人波の間にもまれ、羽織着の中爺さんが気のない日やけ顔で大きいこしらえものの矛だの、※だのをかついで通る。",
              "citation": {
                "source": "日記",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときく者もいなかったし、退け時におくれまいとして熱心に打っている彼女のタイプライタアの前へ立ち止るものもない。",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　ちょうど退け時間が迫ってシトシト薄ら寒い小雨が降り出した夕暮のことだ。",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "折悪しく近所の工場の退け時で、Ｋ町の狭い通りは浅葱色の職工服や空の荷車で夕闇も溢れるほどの混雑をしている。",
              "citation": {
                "source": "加護",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝子供をつれて出勤し、退け時まで、女医と保姆の手もとにある子について何の心配がいろう。",
              "citation": {
                "source": "子供・子供・子供のモスクワ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の退け時ほど工場の出入口が陽気だったことはない。",
              "citation": {
                "source": "ソヴェト同盟の三月八日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の手を両わきに曳いて、退け時になるとヴェランダの下まで来て待つてゐる。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうでなくても大概｜退け時には一度丸ビルを通過して東京駅に来るのである。",
              "citation": {
                "source": "丸の内",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸ビルの下の十字街が雑踏するのは、正午の食事時とこの退け時である。",
              "citation": {
                "source": "丸の内",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところが、船渠の退け時間になって帰ろうと思うと、警察の私服が来やがって、おれが、初めて商売に連れて行ったうちの近所の亀田さんて人を、いきなり泥棒だといって捕えやがッた。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "常とはお早いお退け時のようでございますが」　出迎えると、「いやいや、またすぐお城へ引っ返さねばならぬ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "西日の射す退けどきの渋谷のプラットは、車内から流れ出る客と乗り込む客とで渦巻いていた。",
              "citation": {
                "source": "微笑",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校の退けどき、賑やかな一団にまぎれ込んで歩いて見ると、小さい級の子供は男の子も女の子もゴチャゴチャだ。",
              "citation": {
                "source": "砂遊場からの同志",
                "author": "――ソヴェト同盟の共学について――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
