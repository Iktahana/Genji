          "literary": [
            {
              "text": "またイナビの大郎女の妹、イナビの若郎女と結婚してお生みになつた御子は、マワカの王・ヒコヒトノオホエの王です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またオキナガノマテの王の女のヒロ姫の命と結婚してお生みになつた御子はオサカノヒコヒトの太子、またの名はマロコの王・サカノボリの王・ウヂの王のお三方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天皇の御子たち合わせて十七王おいでになつた中に、ヒコヒトの太子は庶妹タムラの王、またの名はヌカデ姫の命と結婚してお生みになつた御子が、岡本の宮においでになつて天下をお治めなさいました天皇（舒明天皇）・ナカツ王・タラの王のお三方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
