        "examples": {
          "standard": [
            {
              "text": "ひまし油は、古くから便秘薬や化粧品の原料として使われてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "髪にツヤを与えるために、シャンプーに少量のひまし油を混ぜて使う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "医薬品の製造過程で、ひまし油が重要な役割を果たすことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」「いえ、そうでもございません」「なあに、そうだよ、便秘に相違ない」「これはまたなぜでございますな」「便秘だと頭が悪くなる」「あッ、やっぱり、そこへ行きますので」「ひまし油を飲めよ。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひまし油を」「仕方がありません、飲むことにしましょう」「アッハハハ、それがいい」　面白そうに笑ったが、にわかに北山は真面目になり、「これは少しく秘密だが、お前にだけ話すことにしよう。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この建物の地階には、套靴やひまし油まで売る荒物屋がある。",
              "citation": {
                "source": "トビアス・ミンデルニッケル",
                "author": "TOBIAS MINDERNICKEL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
