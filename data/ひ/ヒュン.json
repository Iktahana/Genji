          "literary": [
            {
              "text": "ひゅん、ひゅん、ひゅん。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩陰からひゅんと音がして、火のついた麻束が飛んできた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒュンヒュンと頭上を掠め飛ぶ弾丸は、まもなく、シュッシュッと身近かに迫り、水煙りを立てるようになった。",
              "citation": {
                "source": "渡舟場",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒュン、と澄んだ弓弦の音がし、弓から離れた矢は、矢羽根をキラキラ光らせながら、糸を引いたように真っ直ぐに※のほうへ飛んでゆく。",
              "citation": {
                "source": "キャラコさん",
                "author": "新しき出発",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、あなたの御主人は現に一流の銀行屋でさ、マネエのモデルをしていたあなたと結婚して、ぜいたくさせて着飾らして絵画を描かして、膝の上にのせて、撫でまわして、ヒュンヒュン言わして、おしあわせそうだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
