        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "尤も、君などが、さうヒヨツクリ本物を持つて来ようなどとは、思はないけれども、ハヽヽヽヽ。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人に逢へると思つた場所では、逢へないで、悄然と帰つて来る電車の中で、ヒヨツクリ乗り合はす。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、向からヒヨツクリやつて來て、急になれ／＼しく話を始める。",
              "citation": {
                "source": "恐怖について",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "取り残された子供の話によると、とほうもなく大きなマントを頭からかぶつた、えたいの知れないものが、どこからかヒヨツクリ飛び出して、自分たちの仲間の一人を引つさらつて森の中へ走つてにげたといふのでした。",
              "citation": {
                "source": "虹猫の大女退治",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四「親分」　何處からか、ヒヨツクリ出て來たのは、八五郎の腑に落ちない顏でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "綾の鼓",
                "note": "青空文庫"
              }
            },
            {
              "text": "「其處でヒヨツクリお品さんに逢つたのだよ」　平次は巧みに誤魔化してしまひました、三つの手紙のことは、人に知られたくなかつたのでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "匕首の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなものはあるでせうか、親分」　人間が不意に見えなくなつて、何日か何年かの後、ヒヨツクリ現はれるのを、昔は羽黒や秋葉の天狗のせゐにして、これを神隱しと言つたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "九つになる弟の信太郎と八つになる妹のお光と、二人一緒に行方不明になつて、母親と散々心配してゐると、一昨日の晩ヒヨツクリ信太郎が歸つて來て――」「何？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "お國や奉公人達から、いろ／＼話を聞いて、驚きに驚きを重ねて居ると、先刻水天宮樣からぼんやり歸つて來た勇吉が庭口からヒヨツクリ顏を出して、「旦那樣、今思ひ出しましたが、水天宮樣の水茶屋へ、お靜さんを誘ひ入れた男が判りましたよ」　妙な事を言ひ出します。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "復讐鬼の姿",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
