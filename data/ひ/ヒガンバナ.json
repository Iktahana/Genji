        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "田んぼのあぜ道に沿って、真っ赤な彼岸花が燃えるように咲き誇っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "子供の頃、彼岸花を家に持ち帰ると火事になると言われて怖かったのを覚えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "秋の夕日に照らされた彼岸花の群生は、息を呑むほど美しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "稲田や芋畑のあいだを縫いながら、雨後のぬかるみを右へ幾曲りして登ってゆくと、その間には紅い彼岸花がおびただしく咲いていた。",
              "citation": {
                "source": "秋の修善寺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "△犬ころ草がやたらにはびこる、その穂花が犬ころのやうな感じで好きな草だ、其中庵の三雑草として、冬から春はぺん／＼草、春から夏は犬ころ草、秋はお彼岸花をあげなければなるまい、そのほかに、草苺、青萱、車前草、蒲公英。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "芙蓉、紫苑、彼岸花が咲いてゐた、芙蓉はとりわけうつくしかつた、日本のうつくしさとおごそかさとを持つてゐる。",
              "citation": {
                "source": "行乞記",
                "author": "大田から下関",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸花が咲いてゐる、旅の破法衣と調和するだらう。",
              "citation": {
                "source": "行乞記",
                "author": "広島・尾道",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸花憎い男の心臓を針で突かうとした女、それは何時かのたはむれ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ、湿地の彼岸花、蛇がからめば身は細そる。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い、湿地の彼岸花、午後の三時の鐘が鳴る。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の国では彼岸花といふが、その方が好い。",
              "citation": {
                "source": "秋草と虫の音",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひしひしと植ゑつめられし蝦夷菊の花ところどころ咲きほころべり蝦夷菊の花畑のくろにかいかがみ美しみ見ればみな揺れてをる蝦夷菊の花をいやしと言ふもいはぬも眼のかぎりなるえぞ菊の花　彼岸花も水辺に多いが、みぞ萩もまたさうである。",
              "citation": {
                "source": "秋草と虫の音",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "稲田や芋畑のあいだを縫いながら、雨後のぬかるみを右へ幾曲がりして登ってゆくと、その間には紅い彼岸花がおびただしく咲いていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "・がちやがちやよ鳴きたいだけ鳴け・お彼岸のお彼岸花をみ仏に・何だか腹の立つ秋雨のふる・秋雨の一人で踊る・雨がふるので柿がおちるので　九月十三日雨、よく降つた、井戸がいつぱいになつてあふれたほど。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・わらやしづくする朝の虫のなく・しんかんとして熟柿はおちる・つく／＼ぼうしもをはりの声の雨となり・夜のふかくこほろぎがたたみのうへに・灯火一つ虫がとんできては死ぬる・彼岸花さくふるさとは墓のあるばかり　九月十八日晴、まつたく秋だ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……・柿の葉や実やおしみなくふる・みごもつていそがしい虫でまさに秋風・お彼岸花もをはりのいろのきたない雨・ヱスもわたしも腹をへらして高い空△糸瓜（随筆）△犬と遊ぶ（雑文）　九月廿五日晴、曇、そして雨、私の気分もそんなだつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちらほら彼岸花が咲きだしてゐる、なるほど彼岸が近づいてきた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・咲きつづく彼岸花みんな首を斬られてゐる　うつくしい着物を干しならべ秋晴れ・百舌鳥が鋭くなつてアンテナのてつぺん・風のつめたくうらがへる草の葉・秋晴れて草の葉のかげ　九月廿七日　晴。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸ちかくなつて彼岸花がそこらに咲いてゐる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚釣にいつたが一尾も釣れなかつた、彼岸花を初めて見た。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸花も多く咲いてゐる、家のまはりはそこもこゝも赤い。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝もたわわに柿の実の地へとどき　彼岸花の赤さがあるだけ・つかれてもどるに月ばかりの大空　九月廿日　小郡町｜矢足　其中庵。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・移つてきてお彼岸花の花ざかり　　　　□・蠅も移つてきてゐる近隣の井本老人来庵、四方山話一時間あまり、ついで神保夫妻来庵、子供を連れて（此家此地の持主）。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前中、秋晴半里を逍遙した、彼岸花はすつかりすがれた、法師蝉もあまり鳴かなくなつた、たゞ柿が累々として赤くうれてゆく。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸花のことですか、あの赤い花の咲く。",
              "citation": {
                "source": "北国の人",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸花という名のあるのはそのためである。",
              "citation": {
                "source": "曼珠沙華",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸花と云う曼珠沙華は、此辺に少ない。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此あたりの彼岸花は、萩、女郎花、嫁菜の花、何よりも初秋の栄を見せるのが、紅く白く沢々と絹総を靡かす様な花薄である。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それによると、藤園池辺氏が丹波に遊んで大江山あたりを歩いたとき、九州辺で彼岸花というものを、土地の人に聞けばきつねばなと答えたといって、「姫百合のおもかげ見せてあきの野に人たぶらかすきつね花かも」とある。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて石蒜即ち彼岸花の球根が英国に伝播し栽培されて頗る珍重がられた事については、別にあの博聞強記を以て鳴らした南方翁に記述の一文があってその由来を詳にしている。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで砕かれた物件に雑って彼岸花の球根があったと見える。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼岸花、天蓋花、死人花、幽霊花、狐花などという、あまり好ましくない和名が民間に行われている故以であろう。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で穏かなのは彼岸花というのだけである。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
